g_content\": value}))\n3218:def on_tool_trace(_event: dict) -> bool:\n3221:return True\n3223:def keepalive() -> bool:\n3224:return self._emit(\": keepalive\\n\\n\")\n3226:if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n3227:return\n3228:out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n3229:if out.get(\"state\") == \"client_gone\":\n3230:_log(\"client gone mid-stream, child killed\")\n3231:return\n3232:err = self._error_body(out)\n3233:if err is None:\n3234:conv_id = str(out.get(\"conversation_id\") or \"\")\n3235:self._emit(chunk({}, \"stop\", conversation_id=conv_id))\n3240:usage = self._usage_payload(out.get(\"usage\") or {})\n3241:if usage[\"prompt_tokens\"] or usage[\"completion_tokens\"]:\n3242:self._emit(chunk({}, \"stop\", usage, conversation_id=conv_id))\n3243:else:\n3244:self._emit(\n3245:\"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\"\n3246:)\n3247:self._emit(\"data: [DONE]\\n\\n\")\n3250:class Server(ThreadingHTTPServer):\n3253:daemon_threads = True\n3254:request_queue_size = 64\n3255:allow_reuse_address = True\n```\n\n### 4.8. Реестр всех 97 тестовых методов в `tests/test_agy_bridge_resilience.py` (с номерами строк)\n```python\nL80:class _FakeClock:\nL93:class _TickQueue:\nL112:class _SpyController:\nL172:class _Sock:\nL221:class IdleDetectionTests(unittest.TestCase):\nL223:def test_idle_timeout_detected_for_sleeping_process(self) -> None:\nL244:def test_cpu_delta_resets_idle_timer(self) -> None:\nL261:def test_on_activity_resets_idle_timer(self) -> None:\nL283:def test_ps_degraded_fail_closed(self) -> None:\nL315:def test_ps_degraded_stub_metrics_never_count_as_progress(self) -> None:\nL328:class ExecuteLoopTests(unittest.TestCase):\nL342:def test_check_throttled_in_execute(self) -> None:\nL363:def test_all_activity_kinds_reach_controller(self) -> None:\nL379:def test_idle_timeout_returns_state_in_execute(self) -> None:\nL387:def test_child_exited_is_not_error(self) -> None:\