off seen_cap), _compat_promote читает _agy_binary_identity() под _sqlite_guard_lock; тесты ao03 (полное окно 0.35 с, exit=window) и test_seen_cap_evicts_oldest_when_no_finalized_below_watermark. ruff check/format, basedpyright (0 errors, 0 new warnings vs e00da06), pytest (97 passed) и unittest discover — exit 0.\",\"changed_files\":[\"bridges/agy-bridge/server.py\",\"tests/test_agy_bridge_resilience.py\"],\"commands\":[{\"command\":\"uvx ruff@0.17.3 check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\"exit_code\":0},{\"command\":\"uvx ruff@0.17.3 format --check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\"exit_code\":0},{\"command\":\"PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider tests/test_agy_bridge_resilience.py\",\"exit_code\":0},{\"command\":\"set -e; B=\\\"$(mktemp -d)\\\"; H=\\\"$(mktemp)\\\"; S=\\\"$(mktemp)\\\"; git worktree add -q --detach \\\"$B/base\\\" e00da0621fc95f7c63cd1565f4a5d1fd490c8d66; uvx basedpyright@1.40.2 --outputjson bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py > \\\"$H\\\" || true; (cd \\\"$B/base\\\" && uvx basedpyright@1.40.2 --outputjson bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py > \\\"$S\\\" || true); git worktree remove --force \\\"$B/base\\\"; python3 -I - \\\"$H\\\" \\\"$S\\\" <<'PY'\\nimport json,sys,collections\\nh=json.load(open(sys.argv[1])); s=json.load(open(sys.argv[2]))\\ndef ms(x,sev): return collections.Counter((d['file'].rsplit('/',1)[-1],d.get('rule'),d['message']) for d in x['generalDiagnostics'] if d['severity']==sev)\\nerr=h['summary']['errorCount']; new_w=ms(h,'warning')-ms(s,'warning')\\nprint('version',h['version'],'errors',err,'warnings',h['summary']['warningCount'],'new_warnings',sum(new_w.values()))\\n[print('NEW',k) for k in sorted(new_w)]\\nsys.exit(0 if err==0 and not new_w and h['version'].startswith('1.40.2') else 1)\\nPY\",\"exit_code\":0},{\"command\":\"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. /usr/bin/python3 -B -m unittest discover -s tests -p \\\"test_*agy*.py\\\" && PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider tests/test_agy_bridge_resilience.py\",\"exit_code\":0},{\"command\":\"test \\\"$(git diff --unified=0 e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- tests/test_agy_bridge_resilience.py | grep -cE '^-[^-]')\\\" = 0 && test -z \\\"$(git diff --name-only e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- tests/ core/ | grep -vx 'tests/test_agy_bridge_resilience.py')\\\" && echo OK\",\"exit_code\":0},{\"command\":\"python3 -I - <<'PY'\\nimport ast,re,sys,pathlib\\ns=pathlib.Path('tests/test_agy_bridge_resilience.py').read_text(encoding='utf-8')\\nt=ast.parse(s)\\nneed={'tc%02d'%i for i in list(range(1,13))+[20,21,23,24,30,31,32,33,40,41,42,43,44,50,51,60,61,62,63,70,71,72,80,81,82,91,92]}|{'ao%02d'%i for i in range(1,13)}\\ndef asserted(f):\\n    for n in ast.walk(f):\\n        if isinstance(n,ast.Assert): return True\\n        if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr.startswith('assert'): return True\\n    return False\\ngot=set(); noassert=[]\\nfor f in ast.walk(t):\\n    if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith('test_'):\\n        ids=set(re.findall(r'(tc\\\\d{2}|ao\\\\d{2})',f.name))&need\\n        if not ids: continue\\n        if asserted(f): got|=ids\\n        else: noassert.append(f.name)\\nmiss=sorted(need-got)\\nerrs=(['MISSING '+' '.join(miss)] if miss else [])+(['NO_ASSERT '+' '.join(sorted(noassert))] if noassert else [])\\nprint('; '.join(errs) if errs else 'OK %d ids, all asserted'%len(need)); sys.exit(1 if errs else 0)\\nPY\",\"exit_code\":0},{\"command\":\"test \\\"$(git diff --name-only e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- . ':(exclude).ai-team' ':(exclude)analysis' | sort | tr '\\\\n' ' ')\\\" = \\\"bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py \\\" && test -z \\\"$(git ls-files bridges/agy-bridge/dynamic_config.json)\\\" && printf '%s  %s\\\\n' 81dffc06ac79c490968e7efb8321f464d5963f414fcc6bd67a278a99d5985e32 analysis/agy-realtime-reasoning/research-plan.md e9c8afb2684a7621e9fdb0455640e86f972aab600989142119fb440397842ff1 analysis/agy-realtime-reasoning/evidence-ledger.md 47b16bab51b31bb06c35fb02d08dbd3409a9cfb057a52e828d079054a20d9202 analysis/agy-realtime-reasoning/open-questions.md cb1ecde9e00f06d72b75e43f973add3ab93ca27433d7145cbf8ec4f4800b17cd analysis/agy-realtime-reasoning/handoff-architect.md 5ed84fc039f7fea5983404442461e734ec9dae03f57359e2bb441dfae6cb7afe analysis/agy-realtime-reasoning/handoff-qa.md | shasum -a 256 -c --status - && echo OK\",\"exit_code\":0},{\"command\":\"python3 -I - <<'PY'\\nimport ast,sys,pathlib\\nsrc=pathlib.Path('bridges/agy-bridge/server.py').read_text(encoding='utf-8')\\nt=ast.parse(src)\\nallowed={'__future__','hashlib','json','os','queue','re','select','shutil','signal','socket','subprocess','sys','threading','time','uuid','http','pathlib','typing','core','sqlite3','random'}\\nroots=set()\\nfor n in ast.walk(t):\\n    if isinstance(n,ast.Import):\\n        roots|={a.name.split('.')[0] for a in n.names}\\n    elif isinstance(n,ast.ImportFrom) and n.level==0:\\n        roots.add((n.module or '').split('.')[0])\\ncalls=[n for n in ast.walk(t) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='connect' and isinstance(n.func.value,ast.Name) and n.func.value.id=='sqlite3']\\nnouri=[c.lineno for c in calls if not any(k.arg=='uri' and isinstance(k.value,ast.Constant) and k.value.value is True for k in c.keywords)]\\nrw=[n.lineno for n in ast.walk(t) if isinstance(n,ast.Constant) and isinstance(n.value,str) and ('mode=rw' in n.value or 'immutable' in n.value)]\\nneed=[x for x in ('AGY_SQLITE_REASONING_ENABLED','SQLITE_REASONING_ENABLED','AGY_BRIDGE_CONVERSATIONS','mode=ro','query_only','busy_timeout') if x not in src]\\nerrs=[]\\nif sorted(roots-allowed): errs.append('non-stdlib imports %s'%