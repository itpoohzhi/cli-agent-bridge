and req.get(\"reasoning\") is not None:\n1352\t                self._reject(400, \"unsupported_parameter\",\n1353\t                             \"reasoning parameter is not supported\", model_id, model_len)\n1354\t                return\n1355\t            messages = req.get(\"messages\") if isinstance(req.get(\"messages\"), list) else []\n1356\t            if _has_image_parts(messages):\n1357\t                self._reject(400, \"image_input_not_supported\",\n1358\t                             \"image rejected: image_input_not_supported\",\n1359\t                             model_id, model_len)\n1360\t                return\n1361\t            try:\n1362\t                _launcher()\n1363\t            except LauncherUnavailable:\n1364\t                self._reject(503, \"launcher_unavailable\",\n1365\t                             \"canonical launcher is missing or not executable\",\n1366\t                             model_id, model_len)\n1367\t                return\n1368\t            raw_tools = req.get(\"tools\")\n1369\t            tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n1370\t            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n1371\t            full_prompt = _messages_to_prompt(messages)\n1372\t            extra = req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n1373\t            cwd = str(extra.get(\"cwd\") or \"\")\n1374\t            if len(cwd) > CWD_MAX_LEN:\n1375\t                cwd = \"\"\n1376\t            conversation_id = str(extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\")\n1377\t            sess_key = (model_id, cwd, effort)\n1378\t            is_resumed = False\n1379\t            prompt = full_prompt\n1380\t            if not conversation_id:\n1381\t                use_cid = _session_claim(sess_key)\n1382\t                if use_cid:\n1383\t                    conversation_id = use_cid\n1384\t                    is_resumed = True\n1385\t                    prompt = _get_resumed_turn_prompt(messages)\n1386\t            ctx = {\n1387\t                \"sess_key\": sess_key,\n1388\t                \"hot_resumed\": is_resumed,\n1389\t                \"full_prompt\": full_prompt,\n1390\t                \"model\": model_id,\n1391\t                \"model_len\": model_len,\n1392\t                \"effort\": effort,\n1393\t                \"effort_source\": effort_source,\n1394\t                \"prompt\": prompt,\n1395\t                \"cwd\": cwd,\n1396\t                \"tools_count\": tools_count,\n1397\t                \"conversation_id\": conversation_id,\n1398\t                \"tag\": (f\"client={self._client_tag()} \"\n1399\t                        f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"),\n1400\t                \"stream\": bool(req.get(\"stream\")),\n1401\t            }\n1402\t            if ctx[\"stream\"]:\n1403\t                self._serve_sse(ctx)\n1404\t            else:\n1405\t                self._serve_json(ctx)\n1406\t        finally:\n1407\t            if use_cid:\n1408\t                with _session_store_lock:\n1409\t                    _in_flight_cids.discard(use_cid)\n1410\t            if reserved and budget is not None:\n1411\t                budget.release(reserved)\n1412\t\n1413\t    def _serve_json(self, ctx: dict) -> None:\n1414\t        out = self._run_once(ctx, lambda _v: True, lambda _e: True, lambda _r: True, None)\n1415\t        if out.get(\"state\") == \"client_gone\":\n1416\t            return\n1417\t        err = self._error_body(out)\n1418\t        if err is not None:\n1419\t            self._send(err[\"code\"], {\"error\": err})\n1420\t            return\n1421\t        usage = out.get(\"usage\") or {}\n1422\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n1423\t        reasoning = out.get(\"reasoning\") or \"\"\n1424\t        if reasoning:\n1425\t            # OpenAI-совместимое поле мышления: Harness читает его из сообщения\n1426\t            # ассистента так же, как из дельты потока.\n1427\t            message[\"reasoning_content\"] = reasoning\n1428\t        payload = {\n1429\t            \"id\": f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n1430\t            \"created\": int(time.time()), \"model\": ctx[\"model\"],\n1431\t            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": \"stop\"}],\n1432\t            \"usage\": self._usage_payload(usage),\n1433\t        }\n1434\t        if out.get(\"conversation_id\"):\n1435\t            payload[\"conversation_id\"] = out[\"conversation_id\"]\n1436\t        self._send(200, payload)\n1437\t\n1438\t    def _serve_sse(self, ctx: dict) -> None:\n1439\t        completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n1440\t        created = int(time.time())\n1441\t        shown_model = ctx[\"model\"]\n1442\t        try:\n1443\t            self.send_response(200)\n1444\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n1445\t            self.send_header(\"Cache-Control\", \"no-cache\")\n1446\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n1447\t            self.end_headers()\n1448\t            self.close_connection = True\n1449\t        except (BrokenPipeError, ConnectionResetError, OSError):\n1450\t            _log(\"client gone before headers\")\n1451\t            return\n1452\t\n1453\t        def chunk(delta: dict, finish=None, usage: dict | None = None,\n1454\t                  conversation_id: str = \"\") -> str:\n1455\t            body: dict = {\n1456\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n1457\t                \"model\": shown_model,\n1458\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n1459\t            }\n1460\t            if usage is not None:\n1461\t                body[\"usage\"] = usage\n1462\t            if conversation_id:\n1463\t                body[\"conversation_id\"] = conversation_id\n1464\t            return \"data: \" + json.dumps(body, ensure_ascii=False) + \"\\n\\n\"\n1465\t\n1466\t        def on_text(value: str) -> bool:\n1467\t            return self._emit(chunk({\"content\": value}))\n1468\t\n1469\t        def on_reasoning(value: str) -> bool:\n1470\t            # Мышление шага: Harness читает первое непустое из\n1471\t            # reasoning_content|reasoning|reasoning_text — отдаём только первое.\n1472\t            return self._emit(chunk({\"reasoning_content\": value}))\n1473\t\n1474\t        def on_tool_trace(_event: dict) -> bool:\n1475\t            # Нативный инструмент agy исполняется внутри CLI и наружу не транслируется:\n1476\t            # клиенту нечего добавлять к его же истории вызовов. Трассировка — в stderr.\n1477\t            return True\n1478\t\n1479\t        def keepalive() -> bool:\n1480\t            return self._emit(\": keepalive\\n\\n\")\n1481\t\n1482\t        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n1483\t            return\n1484\t        out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n1485\t        if out.get(\"state\") == \"client_gone\":\n1486\t            _log(\"client gone mid-stream, child killed\")\n1487\t            return\n1488\t        err = self._error_body(out)\n1489\t        if err is None:\n1490\t            conv_id = str(out.get(\"conversation_id\") or \"\")\n1491\t            self._emit(chunk({}, \"stop\", conversation_id=conv_id))\n1492\t            # Harness считает tok/s и % контекста только из usage в потоке\n1493\t            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage).\n1494\t            # Шлём только при ненулевых токенах, чтобы пустой usage от agy\n1495\t            # не превращался в ложные «0 tok/s / 0%».\n1496\t            usage = self._usage_payload(out.get(\"usage\") or {})\n1497\t            if usage[\"prompt_tokens\"] or usage[\"completion_tokens\"]:\n1498\t                self._emit(chunk({}, \"stop\", usage, conversation_id=conv_id))\n1499\t        else:\n1500\t            self._emit(\"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\")\n1501\t        self._emit(\"data: [DONE]\\n\\n\")\n1502\t\n1503\t\n1504\tclass Server(ThreadingHTTPServer):\n1505\t    \"\"\"HTTP-сервер с семафором числа соединений на уровне приёма.\"\"\"\n1506\t\n1507\t    daemon_threads = True\n1508\t    request_queue_size = 64\n1509\t    allow_reuse_address = True\n1510\t\n1511\t    def __init__(self, *args: Any, **kwargs: Any):\n1512\t        super().__init__(*args, **kwargs)\n1513\t        self._conn_sem = threading.BoundedSemaphore(\n1514\t            int(FLEET[\"admission\"][\"max_http_connections\"]))\n1515\t\n1516\t    def _send_raw_503(self, request: socket.socket) -> None:\n1517\t        body = json.dumps({\n1518\t            \"error\": {\"message\": \"bridge overloaded: connection limit\",\n1519\t                      \"type\": \"overloaded\", \"code\": 503},\n1520\t        }).encode(\"utf-8\")\n1521\t        head = (\n1522\t            b\"HTTP/1.1 503 Service Unavailable\\r\\n\"\n1523\t            b\"Content-Type: application/json; charset=utf-8\\r\\n\"\n1524\t            b\"Content-Length: \" + str(len(body)).encode() + b\"\\r\\n\"\n1525\t            b\"Connection: close\\r\\n\\r\\n\"\n1526\t        )\n1527\t        request.sendall(head + body)\n1528\t\n1529\t    def process_request(self, request: socket.socket, client_address: Any) -> None:\n1530\t        if not self._conn_sem.acquire(blocking=False):\n1531\t            try:\n1532\t                peer = f\"{client_address[0]}:{client_address[1]}\"\n1533\t            except (TypeError, IndexError):\n1534\t                peer = \"unknown\"\n1535\t            _log(f\"reject reason=overloaded model=unknown model_len=0 client={peer}\")\n1536\t            try:\n1537\t                self._send_raw_503(request)\n1538\t            except OSError:\n1539\t                pass\n1540\t            self.shutdown_request(request)\n1541\t            return\n1542\t        super().process_request(request, client_address)\n1543\t\n1544\t    def process_request_thread(self, request: socket.socket, client_address: Any) -> None:\n1545\t        try:\n1546\t            super().process_request_thread(request, client_address)\n1547\t        finally:\n1548\t            self._conn_sem.release()\n1549\t\n1550\t\n1551\tdef _sweep_workspace() -> None:\n1552\t    \"\"\"Удалить временные каталоги ходов старше часа (наследие упавших ходов).\"\"\"\n1553\t    cutoff = time.time() - 3600\n1554\t    for path in WORKSPACE.glob(\"run-*\"):\n1555\t        try:\n1556\t            if path.is_dir() and path.stat().st_mtime < cutoff:\n1557\t                shutil.rmtree(str(path), ignore_errors=True)\n1558\t        except OSError:\n1559\t            pass\n1560\t\n1561\t\n1562\tdef main() -> None:\n1563\t    global _budget\n1564\t    if not AUTH_KEY:\n1565\t        sys.stderr.write(\"AGY_BRIDGE_KEY is required; refusing to start\\n\")\n1566\t        raise SystemExit(1)\n1567\t    _budget = _ByteBudget(int(FLEET[\"admission\"][\"max_inflight_body_bytes\"]))\n1568\t    WORKSPACE.mkdir(parents=True, exist_ok=True)\n1569\t    _sweep_workspace()\n1570\t    _log(f\"fleet_sha256={FLEET['sha256']} models={len(FLEET['order'])}\")\n1571\t    try:\n1572\t        _launcher()\n1573\t    except LauncherUnavailable:\n1574\t        _log(f\"launcher_missing path={LAUNCHER} (requests will fail with 503)\")\n1575\t    signal.signal(signal.SIGTERM, _kill_all)\n1576\t    signal.signal(signal.SIGINT, _kill_all)\n1577\t    api_key_present = \"yes\" if AUTH_KEY else \"no\"\n1578\t    server = Server((HOST, PORT), Handler)\n1579\t    _log(f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\n1580\t         f\"queue_timeout={QUEUE_TIMEOUT_S}s timeout={TIMEOUT_S}s keepalive={KEEPALIVE_S}s \"\n1581\t         f\"api_key={api_key_present}\")\n1582\t    print(f\"[agy-bridge] listening on http://{HOST}:{PORT}/v1\", flush=True)\n1583\t    server.serve_forever()\n1584\t\n1585\t\n1586\tif __name__ == \"__main__\":\n1587\t    main()\n1588\t"}]},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"a9196b68-1696-4d0b-9c4a-0387b79dd583","timestamp":"2026-10-29T08:10:20.414Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/tmp/cli-agent-bridge/agy-realtime-reasoning/bridges/agy-bridge/server.py","content":"                return\n            length = int(values[0])\n        if length > int((FLEET.get(\"image_limits\") or {}).get(\"max_body_bytes\") or 0):\n            self._reject(413, \"payload_too_large\", \"request body exceeds the bridge limit\")\n            return\n        reserved = 0\n        budget = _budget\n        if budget is not None and length:\n            if not budget.reserve(length):\n                self._reject(503, \"overloaded\", \"bridge overloaded: body budget exhausted\")\n                return\n            reserved = length\n        use_cid = \"\"\n        try:\n            raw = self.rfile.read(length) if length else b\"\"\n            if len(raw) < length:\n                self._reject(400, \"invalid_request\", \"request body truncated\")\n                return\n            try:\n                req = json.loads(raw.decode(\"utf-8\"))\n            except (ValueError, UnicodeDecodeError):\n                self._reject(400, \"invalid_request\", \"invalid json\")\n                return\n            if not isinstance(req, dict):\n                self._reject(400, \"invalid_request\", \"request must be a JSON object\")\n                return\n            path = self.path.split(\"?\", 1)[0]\n            if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n                self.close_connection = True\n                self._send(404, {\"error\": {\"message\": f\"not found: {path}\",\n                                           \"type\": \"not_found\", \"code\": 404}})\n                return\n            raw_model = req.get(\"model\")\n            model_len = len(raw_model) if isinstance(raw_model, str) else 0\n            if raw_model is None:\n                model_id = MODEL_ID\n            elif isinstance(raw_model, str):\n                candidate = raw_model.strip()\n                model_id = candidate if candidate else MODEL_ID\n            else:\n                self._reject(400, \"model_not_allowed\",\n                             \"model must be a string from the catalogue\", \"unknown\", model_len)\n                return\n            if model_id not in FLEET[\"models\"]:\n                self._reject(400, \"model_not_allowed\", \"model is not in the catalogue\",\n                             \"unknown\", model_len)\n                return\n            model = FLEET[\"models\"][model_id]\n            raw_effort = req.get(\"reasoning_effort\")\n            if raw_effort is None:\n                effort = model[\"default_effort\"]\n                effort_source = \"default\"\n            elif isinstance(raw_effort, str):\n                candidate = raw_effort.strip()\n                if not candidate:\n                    effort = model[\"default_effort\"]\n                    effort_source = \"default\"\n                elif candidate in model[\"efforts\"]:\n                    effort = candidate\n                    effort_source = \"request\"\n                else:\n                    self._reject(400, \"unsupported_reasoning_effort\",\n                                 \"reasoning_effort is not allowed for this model\",\n                                 model_id, model_len)\n                    return\n            else:\n                self._reject(400, \"unsupported_reasoning_effort\",\n                             \"reasoning_effort must be a string\", model_id, model_len)\n                return\n            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n                self._reject(400, \"unsupported_parameter\",\n                             \"reasoning parameter is not supported\", model_id, model_len)\n                return\n            messages = req.get(\"messages\") if isinstance(req.get(\"messages\"), list) else []\n            if _has_image_parts(messages):\n                self._reject(400, \"image_input_not_supported\",\n                             \"image rejected: image_input_not_supported\",\n                             model_id, model_len)\n                return\n            try:\n                _launcher()\n            except LauncherUnavailable:\n                self._reject(503, \"launcher_unavailable\",\n                             \"canonical launcher is missing or not executable\",\n                             model_id, model_len)\n                return\n            raw_tools = req.get(\"tools\")\n            tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n            full_prompt = _messages_to_prompt(messages)\n            extra = req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            cwd = str(extra.get(\"cwd\") or \"\")\n            if len(cwd) > CWD_MAX_LEN:\n                cwd = \"\"\n            conversation_id = str(extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\")\n            sess_key = (model_id, cwd, effort)\n            is_resumed = False\n            prompt = full_prompt\n            if not conversation_id:\n                use_cid = _session_claim(sess_key)\n                if use_cid:\n                    conversation_id = use_cid\n                    is_resumed = True\n                    prompt = _get_resumed_turn_prompt(messages)\n            ctx = {\n                \"sess_key\": sess_key,\n                \"hot_resumed\": is_resumed,\n                \"full_prompt\": full_prompt,\n                \"model\": model_id,\n                \"model_len\": model_len,\n                \"effort\": effort,\n                \"effort_source\": effort_source,\n                \"prompt\": prompt,\n                \"cwd\": cwd,\n                \"tools_count\": tools_count,\n                \"conversation_id\": conversation_id,\n                \"tag\": (f\"client={self._client_tag()} \"\n                        f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"),\n                \"stream\": bool(req.get(\"stream\")),\n            }\n            if ctx[\"stream\"]:\n                self._serve_sse(ctx)\n            else:\n                self._serve_json(ctx)\n        finally:\n            if use_cid:\n                with _session_store_lock:\n                    _in_flight_cids.discard(use_cid)\n            if reserved and budget is not None:\n                budget.release(reserved)\n\n    def _serve_json(self, ctx: dict) -> None:\n        out = self._run_once(ctx, lambda _v: True, lambda _e: True, lambda _r: True, None)\n        if out.get(\"state\") == \"client_gone\":\n            return\n        err = self._error_body(out)\n        if err is not None:\n            self._send(err[\"code\"], {\"error\": err})\n            return\n        usage = out.get(\"usage\") or {}\n        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n        reasoning = out.get(\"reasoning\") or \"\"\n        if reasoning:\n            # OpenAI-совместимое поле мышления: Harness читает его из сообщения\n            # ассистента так же, как из дельты потока.\n            message[\"reasoning_content\"] = reasoning\n        payload = {\n            \"id\": f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n            \"created\": int(time.time()), \"model\": ctx[\"model\"],\n            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": \"stop\"}],\n            \"usage\": self._usage_payload(usage),\n        }\n        if out.get(\"conversation_id\"):\n            payload[\"conversation_id\"] = out[\"conversation_id\"]\n        self._send(200, payload)\n\n    def _serve_sse(self, ctx: dict) -> None:\n        completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n        created = int(time.time())\n        shown_model = ctx[\"model\"]\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            self.end_headers()\n            self.close_connection = True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            _log(\"client gone before headers\")\n            return\n\n        def chunk(delta: dict, finish=None, usage: dict | None = None,\n                  conversation_id: str = \"\") -> str:\n            body: dict = {\n                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n                \"model\": shown_model,\n                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n            }\n            if usage is not None:\n                body[\"usage\"] = usage\n            if conversation_id:\n                body[\"conversation_id\"] = conversation_id\n            return \"data: \" + json.dumps(body, ensure_ascii=False) + \"\\n\\n\"\n\n        def on_text(value: str) -> bool:\n            return self._emit(chunk({\"content\": value}))\n\n        def on_reasoning(value: str) -> bool:\n            # Мышление шага: Harness читает первое непустое из\n            # reasoning_content|reasoning|reasoning_text — отдаём только первое.\n            return self._emit(chunk({\"reasoning_content\": value}))\n\n        def on_tool_trace(_event: dict) -> bool:\n            # Нативный инструмент agy исполняется внутри CLI и наружу не транслируется:\n            # клиенту нечего добавлять к его же истории вызовов. Трассировка — в stderr.\n            return True\n\n        def keepalive() -> bool:\n            return self._emit(\": keepalive\\n\\n\")\n\n        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            return\n        out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n        if out.get(\"state\") == \"client_gone\":\n            _log(\"client gone mid-stream, child killed\")\n            return\n        err = self._error_body(out)\n        if err is None:\n            conv_id = str(out.get(\"conversation_id\") or \"\")\n            self._emit(chunk({}, \"stop\", conversation_id=conv_id))\n            # Harness считает tok/s и % контекста только из usage в потоке\n            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage).\n            # Шлём только при ненулевых токенах, чтобы пустой usage от agy\n            # не превращался в ложные «0 tok/s / 0%».\n            usage = self._usage_payload(out.get(\"usage\") or {})\n            if usage[\"prompt_tokens\"] or usage[\"completion_tokens\"]:\n                self._emit(chunk({}, \"stop\", usage, conversation_id=conv_id))\n        else:\n            self._emit(\"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\")\n        self._emit(\"data: [DONE]\\n\\n\")\n\n\nclass Server(ThreadingHTTPServer):\n    \"\"\"HTTP-сервер с семафором числа соединений на уровне приёма.\"\"\"\n\n    daemon_threads = True\n    request_queue_size = 64\n    allow_reuse_address = True\n\n    def __init__(self, *args: Any, **kwargs: Any):\n        super().__init__(*args, **kwargs)\n        self._conn_sem = threading.BoundedSemaphore(\n            int(FLEET[\"admission\"][\"max_http_connections\"]))\n\n    def _send_raw_503(self, request: socket.socket) -> None:\n        body = json.dumps({\n            \"error\": {\"message\": \"bridge overloaded: connection limit\",\n                      \"type\": \"overloaded\", \"code\": 503},\n        }).encode(\"utf-8\")\n        head = (\n            b\"HTTP/1.1 503 Service Unavailable\\r\\n\"\n            b\"Content-Type: application/json; charset=utf-8\\r\\n\"\n            b\"Content-Length: \" + str(len(body)).encode() + b\"\\r\\n\"\n            b\"Connection: close\\r\\n\\r\\n\"\n        )\n        request.sendall(head + body)\n\n    def process_request(self, request: socket.socket, client_address: Any) -> None:\n        if not self._conn_sem.acquire(blocking=False):\n            try:\n                peer = f\"{client_address[0]}:{client_address[1]}\"\n            except (TypeError, IndexError):\n                peer = \"unknown\"\n            _log(f\"reject reason=overloaded model=unknown model_len=0 client={peer}\")\n            try:\n                self._send_raw_503(request)\n            except OSError:\n                pass\n            self.shutdown_request(request)\n            return\n        super().process_request(request, client_address)\n\n    def process_request_thread(self, request: socket.socket, client_address: Any) -> None:\n        try:\n            super().process_request_thread(request, client_address)\n        finally:\n            self._conn_sem.release()\n\n\ndef _sweep_workspace() -> None:\n    \"\"\"Удалить временные каталоги ходов старше часа (наследие упавших ходов).\"\"\"\n    cutoff = time.time() - 3600\n    for path in WORKSPACE.glob(\"run-*\"):\n        try:\n            if path.is_dir() and path.stat().st_mtime < cutoff:\n                shutil.rmtree(str(path), ignore_errors=True)\n        except OSError:\n            pass\n\n\ndef main() -> None:\n    global _budget\n    if not AUTH_KEY:\n        sys.stderr.write(\"AGY_BRIDGE_KEY is required; refusing to start\\n\")\n        raise SystemExit(1)\n    _budget = _ByteBudget(int(FLEET[\"admission\"][\"max_inflight_body_bytes\"]))\n    WORKSPACE.mkdir(parents=True, exist_ok=True)\n    _sweep_workspace()\n    _log(f\"fleet_sha256={FLEET['sha256']} models={len(FLEET['order'])}\")\n    try:\n        _launcher()\n    except LauncherUnavailable:\n        _log(f\"launcher_missing path={LAUNCHER} (requests will fail with 503)\")\n    signal.signal(signal.SIGTERM, _kill_all)\n    signal.signal(signal.SIGINT, _kill_all)\n    api_key_present = \"yes\" if AUTH_KEY else \"no\"\n    server = Server((HOST, PORT), Handler)\n    _log(f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\n         f\"queue_timeout={QUEUE_TIMEOUT_S}s timeout={TIMEOUT_S}s keepalive={KEEPALIVE_S}s \"\n         f\"api_key={api_key_present}\")\n    print(f\"[agy-bridge] listening on http://{HOST}:{PORT}/v1\", flush=True)\n    server.serve_forever()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":307,"startLine":1282,"totalLines":1588}},"tool_result_meta":[{"id":"toolu_01CwJe1u1tKp71b7eZc3RHwF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
