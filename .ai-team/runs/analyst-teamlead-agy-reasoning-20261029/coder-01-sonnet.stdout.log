", {\n                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n                            \"duration_s\": step.get(\"duration_seconds\"),\n                        }))\n                elif etype == \"result\":\n                    result = ev.get(\"result\") if isinstance(ev.get(\"result\"), dict) else {}\n                    result_ev = result\n                    final_text = str(result.get(\"response\") or \"\")\n                    self.q.put((\"result\", {\n                        \"conversation_id\": result.get(\"conversation_id\") or \"\",\n                        \"status\": str(result.get(\"status\") or \"\"),\n                        \"error\": str(result.get(\"error\") or \"\"),\n                        \"duration_s\": result.get(\"duration_seconds\"),\n                        \"num_turns\": result.get(\"num_turns\"),\n                        \"usage\": result.get(\"usage\") or {},\n                    }))\n            rc: Optional[int]\n            try:\n                rc = self.proc.wait(timeout=PROC_EXIT_WAIT_S)\n            except subprocess.TimeoutExpired:\n                rc = None  # процесс ещё жив после EOF: добьёт Run.close\n            time.sleep(0.05)  # дать стоку stderr дозавершиться\n            t_exit = time.monotonic()\n            self._tail.drain_deadline = t_exit + DRAIN_WINDOW_S\n            self._proc_done.set()\n            self._join_source(t_exit)\n            if rc is None:\n                failed = not result_ev or str(result_ev.get(\"status\") or \"\").upper() == \"ERROR\"\n                rc = 1 if failed else 0\n            terminal = (\"done\", (rc, final_text, result_ev))\n        except Exception as exc:  # noqa: BLE001 — читатель не должен умирать молча\n            self._stop_watch.set()\n            terminal = (\"pump_error\", repr(exc))\n        finally:\n            self._proc_done.set()\n            self._close_and_put_done(terminal[0], terminal[1])\n\n    def _join_source(self, t_exit: float) -> None:\n        \"\"\"Дождаться потока источника мышления в бюджете окна drain, затем прервать SELECT.\"\"\"\n        thread = self._tail.thread\n        thread.join(timeout=max(0.0, t_exit + DRAIN_WINDOW_S - time.monotonic()))\n        if not thread.is_alive():\n            return\n        self._tail.interrupt_active_query()\n        thread.join(timeout=JOIN_TIMEOUT_S)\n        if thread.is_alive():\n            _count_drain_deadline()\n            _log(f\"drain-timeout cid={self._tail.cid[:8] or '-'}\")\n\n    def close(self) -> None:\n        self._stop_watch.set()\n        self._proc_done.set()\n        self._tail.interrupt_active_query()\n        self.controller.close()\n        # Группа зачищается всегда: лидер мог выйти, оставив потомков (фоновые задачи agy).\n        _kill_group(self.proc)\n        with _active_lock:\n            _active.pop(self.proc.pid, None)\n        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n                pass\n        thread = self._tail.thread\n        if thread.is_alive() and thread is not threading.current_thread():\n            thread.join(timeout=JOIN_TIMEOUT_S)\n\n\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8678,"cache_read_input_tokens":282562,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8678},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"aca6ee02-4a92-4c56-8606-478ca477ecb3","timestamp":"2026-10-29T08:21:45.071Z","request_id":"req_011CgWCm7QB8Lc2Pe24uWZaJ"}
