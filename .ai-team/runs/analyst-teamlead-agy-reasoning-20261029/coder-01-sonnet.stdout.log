{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015s4g6FeYHR57T3Hegutjbn","type":"tool_result","content":"PASS: coder role plan is valid for before; sha256=76072d3f139afedfb41bbaef1ec64ad8d46c2396eeb9c1d2ffca630490352ac2\n#!/usr/bin/env python3\n\"\"\"Validate structured handoffs for the Coder → Reviewer dev-cycle pipeline.\n\nSummarizer исключён из dev-цикла: PR-текст собирает родитель, rework после\nпанели техлидов — teamlead-gate/panel-rework-summarizer. Роль ``summarizer``\nподдерживается только как legacy-валидатор исторических handoff'ов.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom validate_role_plan import RolePlanError, validate_role_plan\n\n\nclass ValidationError(ValueError):\n    \"\"\"Raised when a handoff violates its contract.\"\"\"\n\n\ndef require_object(value: Any, label: str) -> dict[str, Any]:\n    if not isinstance(value, dict):\n        raise ValidationError(f\"{label}: expected object\")\n    return value\n\n\ndef require_list(value: Any, label: str) -> list[Any]:\n    if not isinstance(value, list):\n        raise ValidationError(f\"{label}: expected array\")\n    return value\n\n\ndef require_string(data: dict[str, Any], key: str, *, nonempty: bool = True) -> str:\n    value = data.get(key)\n    if not isinstance(value, str):\n        raise ValidationError(f\"{key}: expected string\")\n    if nonempty and not value.strip():\n        raise ValidationError(f\"{key}: must not be empty\")\n    return value\n\n\ndef require_int(data: dict[str, Any], key: str, *, minimum: int = 0) -> int:\n    value = data.get(key)\n    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:\n        raise ValidationError(f\"{key}: expected integer >= {minimum}\")\n    return value\n\n\ndef require_enum(data: dict[str, Any], key: str, allowed: set[str]) -> str:\n    value = require_string(data, key)\n    if value not in allowed:\n        raise ValidationError(\n            f\"{key}: expected one of {sorted(allowed)}, got {value!r}\"\n        )\n    return value\n\n\ndef validate_common(data: dict[str, Any], role: str) -> None:\n    version = require_string(data, \"schema_version\")\n    if version not in {\"1.0\", \"1.1\"}:\n        raise ValidationError(\"schema_version: only '1.0' or '1.1' is supported\")\n    if require_string(data, \"role\") != role:\n        raise ValidationError(f\"role: expected {role!r}\")\n    require_string(data, \"task_id\")\n    role_plan = require_object(data.get(\"role_plan\"), \"role_plan\")\n    plan_path = require_string(role_plan, \"path\")\n    safe_relative_path(plan_path, \"role_plan.path\")\n    if \"plans\" not in Path(plan_path).parts or not plan_path.endswith(\".json\"):\n        raise ValidationError(\"role_plan.path: expected a JSON file inside plans/\")\n    plan_hash = require_string(role_plan, \"sha256\")\n    if re.fullmatch(r\"[0-9a-f]{64}\", plan_hash) is None:\n        raise ValidationError(\"role_plan.sha256: expected 64 lowercase hex characters\")\n\n\ndef validate_bound_role_plan(","is_error":false}]},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"9c3bfb6c-ab33-43ab-aa89-b0d06c253be6","timestamp":"2026-10-29T08:11:03.874Z","tool_use_result":{"stdout":"PASS: coder role plan is valid for before; sha256=76072d3f139afedfb41bbaef1ec64ad8d46c2396eeb9c1d2ffca630490352ac2\n#!/usr/bin/env python3\n\"\"\"Validate structured handoffs for the Coder → Reviewer dev-cycle pipeline.\n\nSummarizer исключён из dev-цикла: PR-текст собирает родитель, rework после\nпанели техлидов — teamlead-gate/panel-rework-summarizer. Роль ``summarizer``\nподдерживается только как legacy-валидатор исторических handoff'ов.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom validate_role_plan import RolePlanError, validate_role_plan\n\n\nclass ValidationError(ValueError):\n    \"\"\"Raised when a handoff violates its contract.\"\"\"\n\n\ndef require_object(value: Any, label: str) -> dict[str, Any]:\n    if not isinstance(value, dict):\n        raise ValidationError(f\"{label}: expected object\")\n    return value\n\n\ndef require_list(value: Any, label: str) -> list[Any]:\n    if not isinstance(value, list):\n        raise ValidationError(f\"{label}: expected array\")\n    return value\n\n\ndef require_string(data: dict[str, Any], key: str, *, nonempty: bool = True) -> str:\n    value = data.get(key)\n    if not isinstance(value, str):\n        raise ValidationError(f\"{key}: expected string\")\n    if nonempty and not value.strip():\n        raise ValidationError(f\"{key}: must not be empty\")\n    return value\n\n\ndef require_int(data: dict[str, Any], key: str, *, minimum: int = 0) -> int:\n    value = data.get(key)\n    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:\n        raise ValidationError(f\"{key}: expected integer >= {minimum}\")\n    return value\n\n\ndef require_enum(data: dict[str, Any], key: str, allowed: set[str]) -> str:\n    value = require_string(data, key)\n    if value not in allowed:\n        raise ValidationError(\n            f\"{key}: expected one of {sorted(allowed)}, got {value!r}\"\n        )\n    return value\n\n\ndef validate_common(data: dict[str, Any], role: str) -> None:\n    version = require_string(data, \"schema_version\")\n    if version not in {\"1.0\", \"1.1\"}:\n        raise ValidationError(\"schema_version: only '1.0' or '1.1' is supported\")\n    if require_string(data, \"role\") != role:\n        raise ValidationError(f\"role: expected {role!r}\")\n    require_string(data, \"task_id\")\n    role_plan = require_object(data.get(\"role_plan\"), \"role_plan\")\n    plan_path = require_string(role_plan, \"path\")\n    safe_relative_path(plan_path, \"role_plan.path\")\n    if \"plans\" not in Path(plan_path).parts or not plan_path.endswith(\".json\"):\n        raise ValidationError(\"role_plan.path: expected a JSON file inside plans/\")\n    plan_hash = require_string(role_plan, \"sha256\")\n    if re.fullmatch(r\"[0-9a-f]{64}\", plan_hash) is None:\n        raise ValidationError(\"role_plan.sha256: expected 64 lowercase hex characters\")\n\n\ndef validate_bound_role_plan(","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015s4g6FeYHR57T3Hegutjbn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
