{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0185uoDAbyua9GxACAjyETF7","type":"tool_result","content":"1\t\"\"\"Тесты отказоустойчивости agy-bridge (ADR-0007, arch-spec r2 §6, RW-008).\n2\t\n3\tПокрыто 15 сценариев: детекция неактивности группы, сброс таймера по CPU и по\n4\tпротокольным событиям, fail-closed при деградации `ps`, троттлинг `check()` в\n5\t`_execute`, `child_exited` как штатное завершение, `absolute_cap` -> `timeout`,\n6\tkill-switch, контракт ошибки `idle_timeout` (HTTP 504 / SSE), зачистка группы\n7\tпроцессов и reap лидера, изоляция таймаута источника в `fetch_via_playwright.py`.\n8\t\n9\tМост `bridges/agy-bridge/server.py` лежит в каталоге с дефисом, поэтому грузится\n10\tчерез `importlib`. Таймауты малые (`idle_timeout_s=0.2`) либо мок-часы; процессы\n11\tсоздаются с `start_new_session=True` и убираются в `finally`.\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport asyncio\n17\timport importlib.util\n18\timport json\n19\timport os\n20\timport queue\n21\timport signal\n22\timport socket\n23\timport subprocess\n24\timport sys\n25\timport tempfile\n26\timport time\n27\timport unittest\n28\tfrom pathlib import Path\n29\tfrom types import SimpleNamespace\n30\tfrom typing import Any\n31\tfrom unittest import mock\n32\t\n33\t_REPO_ROOT = Path(__file__).resolve().parents[1]\n34\tif str(_REPO_ROOT) not in sys.path:\n35\t    sys.path.insert(0, str(_REPO_ROOT))\n36\t\n37\tfrom core.watchdog import (  # noqa: E402\n38\t    AdaptiveTimeoutController,\n39\t    ProcessWatchdog,\n40\t    WatchdogMetrics,\n41\t)\n42\t\n43\t_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n44\t_FETCH_SCRIPT = Path(\n45\t    os.environ.get(\"AIBUNKER_FETCH_SCRIPT\")\n46\t    or \"~/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py\"\n47\t).expanduser()\n48\t\n49\t_POSIX = sys.platform != \"win32\"\n50\t_DARWIN = sys.platform == \"darwin\"\n51\t\n52\t\n53\tdef _load_bridge() -> Any:\n54\t    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-agy-resilience\")\n55\t    os.environ.pop(\"AGY_BRIDGE_FLEET\", None)\n56\t    spec = importlib.util.spec_from_file_location(\n57\t        \"agy_bridge_server_under_test\", _BRIDGE_PY\n58\t    )\n59\t    assert spec is not None and spec.loader is not None\n60\t    module = importlib.util.module_from_spec(spec)\n61\t    sys.modules[spec.name] = module\n62\t    spec.loader.exec_module(module)\n63\t    return module\n64\t\n65\t\n66\tsrv = _load_bridge()\n67\t\n68\t\n69\tclass _FakeClock:\n70\t    \"\"\"Ручные часы: время движется только через advance().\"\"\"\n71\t\n72\t    def __init__(self, now: float = 1000.0) -> None:\n73\t        self.now = now\n74\t\n75\t    def __call__(self) -> float:\n76\t        return self.now\n77\t\n78\t    def advance(self, seconds: float) -> None:\n79\t        self.now += seconds\n80\t\n81\t\n82\tclass _TickQueue:\n83\t    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n84\t\n85\t    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n86\t        self.clock = clock\n87\t        self.empty_ticks = empty_ticks\n88\t        self.events = list(events)\n89\t\n90\t    def get(self, timeout: float = 0.0) -> Any:\n91\t        if self.empty_ticks > 0:\n92\t            self.empty_ticks -= 1\n93\t            self.clock.advance(float(timeout))\n94\t            raise queue.Empty\n95\t        if self.events:\n96\t            return self.events.pop(0)\n97\t        self.clock.advance(float(timeout))\n98\t        raise queue.Empty\n99\t\n100\t\n101\tclass _SpyController:\n102\t    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n103\t\n104\t    def __init__(\n105\t        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n106\t    ) -> None:\n107\t        self.inner = inner\n108\t        self.forced = forced\n109\t        self.check_calls = 0\n110\t        self.activity: list[str] = []\n111\t\n112\t    def on_activity(self, kind: str = \"protocol\") -> None:\n113\t        self.activity.append(kind)\n114\t        self.inner.on_activity(kind)\n115\t\n116\t    def check(self, pgid: int | None = None) -> tuple:\n117\t        self.check_calls += 1\n118\t        if self.forced is not None:\n119\t            return self.forced\n120\t        return self.inner.check(pgid)\n121\t\n122\t\n123\tdef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n124\t    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n125\t\n126\t\n127\tdef _hard_kill(proc: subprocess.Popen) -> None:\n128\t    try:\n129\t        os.killpg(proc.pid, signal.SIGKILL)\n130\t    except (ProcessLookupError, PermissionError, OSError):\n131\t        pass\n132\t    try:\n133\t        proc.wait(timeout=5)\n134\t    except (subprocess.TimeoutExpired, OSError):\n135\t        pass\n136\t\n137\t\n138\tdef _ps_stat(pid: int) -> str:\n139\t    out = subprocess.run(\n140\t        [\"ps\", \"-o\", \"stat=\", \"-p\", str(pid)],\n141\t        capture_output=True,\n142\t        text=True,\n143\t        check=False,\n144\t    )\n145\t    return out.stdout.strip()\n146\t\n147\t\n148\tdef _group_gone(pgid: int, within_s: float = 2.0) -> bool:\n149\t    deadline = time.monotonic() + within_s\n150\t    while time.monotonic() < deadline:\n151\t        try:\n152\t            os.killpg(pgid, 0)\n153\t        except ProcessLookupError:\n154\t            return True\n155\t        except PermissionError:\n156\t            pass\n157\t        time.sleep(0.05)\n158\t    return False\n159\t\n160\t\n161\tclass _Sock:\n162\t    \"\"\"Пара сокетов для Handler.connection: пир открыт, данных нет -> клиент «на месте».\"\"\"\n163\t\n164\t    def __enter__(self) -> socket.socket:\n165\t        self.a, self.b = socket.socketpair()\n166\t        return self.a\n167\t\n168\t    def __exit__(self, *_exc: Any) -> None:\n169\t        self.a.close()\n170\t        self.b.close()\n171\t\n172\t\n173\tdef _make_handler(connection: socket.socket) -> Any:\n174\t    handler = srv.Handler.__new__(srv.Handler)\n175\t    handler.connection = connection\n176\t    return handler\n177\t\n178\t\n179\tdef _fake_run(\n180\t    clock: _FakeClock, controller: Any, events: list, empty_ticks: int\n181\t) -> SimpleNamespace:\n182\t    return SimpleNamespace(\n183\t        q=_TickQueue(clock, empty_ticks, events),\n184\t        controller=controller,\n185\t        proc=SimpleNamespace(pid=424242),\n186\t        got_event=True,\n187\t        started=clock(),\n188\t        err_box=[],\n189\t    )\n190\t\n191\t\n192\tdef _fake_time(clock: _FakeClock) -> SimpleNamespace:\n193\t    return SimpleNamespace(\n194\t        monotonic=clock, sleep=lambda _s: None, strftime=time.strftime, time=time.time\n195\t    )\n196\t\n197\t\n198\tdef _execute_with_clock(clock: _FakeClock, run: SimpleNamespace) -> dict:\n199\t    \"\"\"Прогнать Handler._execute на мок-часах без реальных ожиданий.\"\"\"\n200\t    with _Sock() as sock, mock.patch.object(srv, \"time\", _fake_time(clock)):\n201\t        handler = _make_handler(sock)\n202\t        return handler._execute(\n203\t            run, lambda _t: True, lambda _e: True, lambda _r: True, None\n204\t        )\n205\t\n206\t\n207\tclass IdleDetectionTests(unittest.TestCase):\n208\t    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n209\t    def test_idle_timeout_detected_for_sleeping_process(self) -> None:\n210\t        proc = _spawn([\"sleep\", \"100\"])\n211\t        try:\n212\t            ctrl = AdaptiveTimeoutController(\n213\t                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n214\t            )\n215\t            ctrl.register_pgid(proc.pid)\n216\t            result: tuple = (False, \"\", None)\n217\t            deadline = time.monotonic() + 2.0\n218\t            while time.monotonic() < deadline:\n219\t                result = ctrl.check(proc.pid)\n220\t                if result[0]:\n221\t                    break\n222\t                time.sleep(0.05)\n223\t            self.assertTrue(result[0])\n224\t            self.assertEqual(result[1], \"idle_timeout\")\n225\t            ctrl.close()\n226\t        finally:\n227\t            _hard_kill(proc)\n228\t\n229\t    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n230\t    def test_cpu_delta_resets_idle_timer(self) -> None:\n231\t        proc = _spawn([sys.executable, \"-I\", \"-c\", \"while True: pass\"])\n232\t        try:\n233\t            ctrl = AdaptiveTimeoutController(\n234\t                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n235\t            )\n236\t            ctrl.register_pgid(proc.pid)\n237\t            end = time.monotonic() + 0.9  # заметно больше idle_timeout_s\n238\t            while time.monotonic() < end:\n239\t                should_stop, reason, _m = ctrl.check(proc.pid)\n240\t                self.assertFalse(should_stop, f\"ложный {reason}: CPU растёт\")\n241\t                time.sleep(0.05)\n242\t            self.assertEqual(ctrl.last_activity_kind, \"cpu_delta\")\n243\t            ctrl.close()\n244\t        finally:\n245\t            _hard_kill(proc)\n246\t\n247\t    def test_on_activity_resets_idle_timer(self) -> None:\n248\t        for kind in (\"text\", \"reasoning\", \"tool_trace\", \"init\"):\n249\t            with self.subTest(kind=kind):\n250\t                clock = _FakeClock()\n251\t                ctrl = AdaptiveTimeoutController(\n252\t                    idle_timeout_s=0.2,\n253\t                    safety_cap_s=60.0,\n254\t                    finish_reserve_s=0.0,\n255\t                    watchdog_enabled=False,\n256\t                    clock=clock,\n257\t                )\n258\t                for _ in range(5):\n259\t                    clock.advance(0.15)\n260\t                    ctrl.on_activity(kind)\n261\t                    self.assertEqual(ctrl.check(), (False, \"\", None))\n262\t                self.assertEqual(ctrl.last_activity_kind, kind)\n263\t                clock.advance(0.25)\n264\t                should_stop, reason, _m = ctrl.check()\n265\t                self.assertTrue(should_stop)\n266\t                self.assertEqual(reason, \"idle_timeout\")\n267\t\n268\t    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n269\t    def test_ps_degraded_fail_closed(self) -> None:\n270\t        class _DegradedPs(ProcessWatchdog):\n271\t            def _run_ps(self, pgid: int) -> Any:\n272\t                raise subprocess.TimeoutExpired(cmd=\"ps\", timeout=2.0)\n273\t\n274\t        logs: list[str] = []\n275\t        proc = _spawn([\"sleep\", \"100\"])\n276\t        try:\n277\t            clock = _FakeClock()\n278\t            ctrl = AdaptiveTimeoutController(\n279\t                idle_timeout_s=0.2,\n280\t                safety_cap_s=60.0,\n281\t                finish_reserve_s=0.0,\n282\t                watchdog=_DegradedPs(log_fn=logs.append),\n283\t                clock=clock,\n284\t                log_fn=logs.append,\n285\t            )\n286\t            ctrl.register_pgid(proc.pid)\n287\t            self.assertEqual(ctrl.check(proc.pid)[:2], (False, \"\"))\n288\t            marker = ctrl.last_activity_ts\n289\t            clock.advance(0.25)\n290\t            should_stop, reason, metrics = ctrl.check(proc.pid)\n291\t            self.assertTrue(should_stop)\n292\t            self.assertEqual(reason, \"idle_timeout\")\n293\t            self.assertTrue(metrics is not None and metrics.ps_degraded)\n294\t            self.assertEqual(\n295\t                ctrl.last_activity_ts, marker, \"fail-closed: таймер не сбрасывается\"\n296\t            )\n297\t            self.assertTrue(any(\"watchdog_ps_degraded\" in line for line in logs), logs)\n298\t        finally:\n299\t            _hard_kill(proc)\n300\t\n301\t    def test_ps_degraded_stub_metrics_never_count_as_progress(self) -> None:\n302\t        degraded = WatchdogMetrics(\n303\t            pgid=1,\n304\t            alive=True,\n305\t            descendant_pids=(),\n306\t            new_descendants=(),\n307\t            cpu_time_s=9.0,\n308\t            cpu_delta_s=5.0,\n309\t            ps_degraded=True,\n310\t        )\n311\t        self.assertFalse(degraded.has_progress)\n312\t\n313\t\n314\tclass ExecuteLoopTests(unittest.TestCase):\n315\t    def _controller(\n316\t        self, clock: _FakeClock, **kwargs: Any\n317\t    ) -> AdaptiveTimeoutController:\n318\t        params: dict[str, Any] = dict(\n319\t            idle_timeout_s=1000.0,\n320\t            safety_cap_s=1800.0,\n321\t            finish_reserve_s=0.0,\n322\t            watchdog_enabled=False,\n323\t            clock=clock,\n324\t        )\n325\t        params.update(kwargs)\n326\t        return AdaptiveTimeoutController(**params)\n327\t\n328\t    def test_check_throttled_in_execute(self) -> None:\n329\t        # (а) 100 событий за 1 с реального времени: check() не вызывается чаще 1 раза.\n330\t        clock = _FakeClock()\n331\t        spy = _SpyController(self._controller(clock))\n332\t        events = [(\"text\", \"x\")] * 100 + [(\"done\", (0, \"\", {}))]\n333\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n334\t        self.assertEqual(out[\"state\"], \"done\")\n335\t        self.assertLessEqual(spy.check_calls, 1)\n336\t        self.assertEqual(spy.activity, [\"text\"] * 100)\n337\t\n338\t        # (б) пустая очередь 12 тиков по 1 с: проверка идёт раз в WATCHDOG_INTERVAL_S.\n339\t        clock = _FakeClock()\n340\t        spy = _SpyController(self._controller(clock))\n341\t        out = _execute_with_clock(\n342\t            clock, _fake_run(clock, spy, [(\"done\", (0, \"ok\", {}))], empty_ticks=12)\n343\t        )\n344\t        self.assertEqual(out[\"state\"], \"done\")\n345\t        self.assertGreaterEqual(spy.check_calls, 1)\n346\t        self.assertLess(spy.check_calls, 12)\n347\t        self.assertEqual(spy.check_calls, 2)  # на 5-й и 10-й секундах\n348\t\n349\t    def test_all_activity_kinds_reach_controller(self) -> None:\n350\t        clock = _FakeClock()\n351\t        spy = _SpyController(self._controller(clock))\n352\t        events = [\n353\t            (\"init\", {\"conversation_id\": \"c1\", \"tools\": 0, \"permission_mode\": \"\"}),\n354\t            (\"reasoning\", \"r\"),\n355\t            (\"text\", \"t\"),\n356\t            (\"tool_trace\", {\"name\": \"run_command\"}),\n357\t            (\"result\", {\"status\": \"OK\", \"usage\": {}}),\n358\t            (\"done\", (0, \"t\", {})),\n359\t        ]\n360\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n361\t        self.assertEqual(out[\"state\"], \"done\")\n362\t        # result/done — терминальные события и активностью не считаются.\n363\t        self.assertEqual(spy.activity, [\"init\", \"reasoning\", \"text\", \"tool_trace\"])\n364\t\n365\t    def test_idle_timeout_returns_state_in_execute(self) -> None:\n366\t        clock = _FakeClock()\n367\t        ctrl = self._controller(clock, idle_timeout_s=8.0)\n368\t        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n369\t        self.assertEqual(out[\"state\"], \"idle_timeout\")\n370\t        self.assertEqual(out[\"rc\"], 124)\n371\t        self.assertIn(\"idle timeout\", out[\"err\"])\n372\t\n373\t    def test_child_exited_is_not_error(self) -> None:\n374\t        clock = _FakeClock()\n375\t        spy = _SpyController(\n376\t            self._controller(clock), forced=(True, \"child_exited\", None)\n377\t        )\n378\t        events = [(\"text\", \"hi\"), (\"done\", (0, \"hi\", {}))]\n379\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=7))\n380\t        self.assertGreaterEqual(spy.check_calls, 1)\n381\t        self.assertEqual(out[\"state\"], \"done\")\n382\t        self.assertEqual(out[\"rc\"], 0)\n383\t        self.assertEqual(out[\"text\"], \"hi\")\n384\t\n385\t    def test_absolute_cap_maps_to_timeout(self) -> None:\n386\t        clock = _FakeClock()\n387\t        pure = AdaptiveTimeoutController(\n388\t            idle_timeout_s=1000.0,\n389\t            safety_cap_s=0.2,\n390\t            finish_reserve_s=0.0,\n391\t            watchdog_enabled=False,\n392\t            clock=clock,\n393\t        )\n394\t        clock.advance(0.25)\n395\t        self.assertEqual(pure.check()[:2], (True, \"absolute_cap\"))\n396\t\n397\t        clock = _FakeClock()\n398\t        ctrl = self._controller(clock, safety_cap_s=7.0)\n399\t        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n400\t        self.assertEqual(out[\"state\"], \"timeout\")\n401\t        self.assertEqual(out[\"rc\"], 124)\n402\t        self.assertEqual(srv.Handler._error_body(out)[\"type\"], \"timeout\")\n403\t\n404\t\n405\tclass KillSwitchTests(unittest.TestCase):\n406\t    def test_flag_values(self) -> None:\n407\t        for value in (\"0\", \"false\", \"no\", \"off\", \"False\", \"OFF\"):\n408\t            with (\n409\t                self.subTest(value=value),\n410\t                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n411\t            ):\n412\t                self.assertFalse(srv._is_watchdog_enabled())\n413\t        for value in (\"1\", \"true\", \"yes\", \"on\"):\n414\t            with (\n415\t                self.subTest(value=value),\n416\t                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n417\t            ):\n418\t                self.assertTrue(srv._is_watchdog_enabled())\n419\t        with mock.patch.dict(os.environ):\n420\t            os.environ.pop(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", None)\n421\t            self.assertTrue(srv._is_watchdog_enabled())\n422\t\n423\t    def test_idle_timeout_env_validation(self) -> None:\n424\t        for raw in (\"abc\", \"-5\", \"0\", \"nan\", \"inf\"):\n425\t            with (\n426\t                self.subTest(raw=raw),\n427\t                mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": raw}),\n428\t                mock.patch.object(srv, \"_log\") as log,\n429\t            ):\n430\t                self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n431\t                log.assert_called_once()\n432\t        with mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": \"12.5\"}):\n433\t            self.assertEqual(srv._idle_timeout_from_env(), 12.5)\n434\t        with mock.patch.dict(os.environ):\n435\t            os.environ.pop(\"AGY_BRIDGE_IDLE_TIMEOUT\", None)\n436\t            self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n437\t\n438\t    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n439\t    def test_killswitch_disables_watchdog(self) -> None:\n440\t        with tempfile.TemporaryDirectory() as tmp:\n441\t            launcher = Path(tmp) / \"fake-launcher.sh\"\n442\t            launcher.write_text(\"#!/bin/sh\\nexec sleep 100\\n\", encoding=\"utf-8\")\n443\t            launcher.chmod(0o755)\n444\t            runs: list[Any] = []\n445\t\n446\t            def make_run() -> Any:\n447\t                run = srv.Run(\"ping\", \"m\", \"low\", \"default\", \"\", \"tag\")\n448\t                runs.append(run)\n449\t                return run\n450\t\n451\t            try:\n452\t                with (\n453\t                    mock.patch.object(srv, \"_launcher\", return_value=str(launcher)),\n454\t                    mock.patch.object(srv, \"WORKSPACE\", Path(tmp) / \"ws\"),\n455\t                    mock.patch.object(ProcessWatchdog, \"_run_ps\") as run_ps,\n456\t                ):\n457\t                    with mock.patch.dict(\n458\t                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"0\"}\n459\t                    ):\n460\t                        off = make_run()\n461\t                        self.assertEqual(\n462\t                            off.controller.idle_timeout_s, float(srv.TIMEOUT_S)\n463\t                        )\n464\t                        self.assertIs(off.controller.watchdog_enabled, False)\n465\t                        self.assertEqual(\n466\t                            off.controller.safety_cap_s, float(srv.TIMEOUT_S)\n467\t                        )\n468\t                        self.assertEqual(off.controller.finish_reserve_s, 0.0)\n469\t                        off.controller.check(off.proc.pid)\n470\t                        run_ps.assert_not_called()  # ни seed, ни check не зовут ps\n471\t                    with mock.patch.dict(\n472\t                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"1\"}\n473\t                    ):\n474\t                        on = make_run()\n475\t                        self.assertEqual(\n476\t                            on.controller.idle_timeout_s, srv.IDLE_TIMEOUT_S\n477\t                        )\n478\t                        self.assertIs(on.controller.watchdog_enabled, True)\n479\t                        self.assertEqual(\n480\t                            on.controller.safety_cap_s, float(srv.TIMEOUT_S)\n481\t                        )\n482\t            finally:\n483\t                for run in runs:\n484\t                    run.close()\n485\t\n486\t\n487\tclass ErrorContractTests(unittest.TestCase):\n488\t    def test_error_body_idle_timeout_http_504(self) -> None:\n489\t        body = srv.Handler._error_body({\"state\": \"idle_timeout\", \"rc\": 124})\n490\t        self.assertEqual(body[\"code\"], 504)\n491\t        self.assertEqual(body[\"type\"], \"idle_timeout\")\n492\t        self.assertIn(f\"idle timeout after {srv.IDLE_TIMEOUT_S:g}s\", body[\"message\"])\n493\t        self.assertIn(\"idle timeout after 300s\", body[\"message\"])\n494\t\n495\t    def _out(self) -> dict:\n496\t        return {\n497\t            \"state\": \"idle_timeout\",\n498\t            \"rc\": 124,\n499\t            \"text\": \"\",\n500\t            \"usage\": {},\n501\t            \"result\": {},\n502\t            \"err\": \"x\",\n503\t            \"tool_calls\": [],\n504\t            \"tool_events\": 0,\n505\t            \"conversation_id\": \"\",\n506\t        }\n507\t\n508\t    def test_sse_error_chunk_idle_timeout(self) -> None:\n509\t        frames: list[str] = []\n510\t        handler = srv.Handler.__new__(srv.Handler)\n511\t        handler.send_response = lambda *_a, **_k: None\n512\t        handler.send_header = lambda *_a, **_k: None\n513\t        handler.end_headers = lambda: None\n514\t        handler._emit = lambda data: frames.append(data) or True\n515\t        handler._run_once = lambda *_a, **_k: self._out()\n516\t        handler._serve_sse({\"model\": \"m\"})\n517\t        self.assertGreaterEqual(len(frames), 3)\n518\t        self.assertEqual(frames[-1], \"data: [DONE]\\n\\n\")\n519\t        error_frame = frames[-2]\n520\t        self.assertTrue(\n521\t            error_frame.startswith(\"data: \") and error_frame.endswith(\"\\n\\n\")\n522\t        )\n523\t        payload = json.loads(error_frame[len(\"data: \") :])\n524\t        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n525\t        self.assertEqual(payload[\"error\"][\"code\"], 504)\n526\t        # ни finish_reason=stop, ни usage-кадра после ошибки быть не должно\n527\t        self.assertFalse(any('\"finish_reason\": \"stop\"' in f for f in frames))\n528\t\n529\t    def test_json_mode_idle_timeout_is_504(self) -> None:\n530\t        sent: list[tuple] = []\n531\t        handler = srv.Handler.__new__(srv.Handler)\n532\t        handler._send = lambda code, payload: sent.append((code, payload))\n533\t        handler._run_once = lambda *_a, **_k: self._out()\n534\t        handler._serve_json({\"model\": \"m\"})\n535\t        self.assertEqual(len(sent), 1)\n536\t        code, payload = sent[0]\n537\t        self.assertEqual(code, 504)\n538\t        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n539\t\n540\t\n541\t@unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n542\tclass KillGroupTests(unittest.TestCase):\n543\t    def test_kill_group_cleans_descendants_and_reaps_zombie(self) -> None:\n544\t        proc = _spawn([\"sh\", \"-c\", \"sleep 100 & sleep 100 & wait\"])\n545\t        try:\n546\t            deadline = time.monotonic() + 3.0\n547\t            while time.monotonic() < deadline:\n548\t                out = subprocess.run(\n549\t                    [\"ps\", \"-o\", \"pid=\", \"-g\", str(proc.pid)],\n550\t                    capture_output=True,\n551\t                    text=True,\n552\t                    check=False,\n553\t                )\n554\t                if len(out.stdout.split()) >= 3:  # лидер + два sleep\n555\t                    break\n556\t                time.sleep(0.05)\n557\t            self.assertGreaterEqual(len(out.stdout.split()), 3, \"потомки не стартовали\")\n558\t            srv._kill_group(proc)\n559\t            self.assertIsNotNone(proc.returncode)\n560\t            self.assertTrue(\n561\t                _group_gone(proc.pid), \"потомки группы пережили _kill_group\"\n562\t            )\n563\t            self.assertEqual(_ps_stat(proc.pid), \"\", \"лидер остался зомби\")\n564\t        finally:\n565\t            _hard_kill(proc)\n566\t\n567\t    def test_kill_group_reaps_when_group_already_gone(self) -> None:\n568\t        proc = _spawn([\"true\"])\n569\t        try:\n570\t            deadline = time.monotonic() + 3.0\n571\t            while _ps_stat(proc.pid) != \"Z\" and time.monotonic() < deadline:\n572\t                time.sleep(0.05)  # лидер завершён и ещё не собран\n573\t            with (\n574\t                mock.patch.object(srv.os, \"killpg\", side_effect=ProcessLookupError),\n575\t                mock.patch.object(proc, \"wait\", wraps=proc.wait) as wait,\n576\t            ):\n577\t                srv._kill_group(proc)  # не должен падать\n578\t            wait.assert_called()\n579\t            self.assertEqual(proc.returncode, 0)\n580\t            self.assertEqual(_ps_stat(proc.pid), \"\", \"зомби не собран\")\n581\t        finally:\n582\t            _hard_kill(proc)\n583\t\n584\t    def test_kill_group_escalates_to_sigkill(self) -> None:\n585\t        self.assertEqual(srv.KILL_TERM_GRACE_S, 2.0)\n586\t        self.assertEqual(srv.KILL_WAIT_S, 5.0)\n587\t        proc = _spawn(\n588\t            [\"sh\", \"-c\", \"trap '' TERM; echo ready; while :; do sleep 1; done\"],\n589\t            stdout=subprocess.PIPE,\n590\t        )\n591\t        try:\n592\t            self.assertEqual(\n593\t                proc.stdout.readline().strip(), b\"ready\"\n594\t            )  # trap уже установлен\n595\t            started = time.monotonic()\n596\t            with mock.patch.object(srv, \"KILL_TERM_GRACE_S\", 0.4):\n597\t                srv._kill_group(proc)\n598\t            elapsed = time.monotonic() - started\n599\t            self.assertEqual(proc.returncode, -signal.SIGKILL)\n600\t            self.assertGreaterEqual(\n601\t                elapsed, 0.35, \"SIGKILL раньше окончания grace-периода\"\n602\t            )\n603\t            self.assertLess(elapsed, 2.0 + 5.0)\n604\t            self.assertTrue(_group_gone(proc.pid))\n605\t        finally:\n606\t            _hard_kill(proc)\n607\t            if proc.stdout is not None:\n608\t                proc.stdout.close()\n609\t\n610\t\n611\tdef _load_fetch_script() -> Any:\n612\t    if not _FETCH_SCRIPT.is_file():\n613\t        raise unittest.SkipTest(f\"нет {_FETCH_SCRIPT}\")\n614\t    scripts_dir = str(_FETCH_SCRIPT.parent)\n615\t    spec = importlib.util.spec_from_file_location(\n616\t        \"fetch_via_playwright_under_test\", _FETCH_SCRIPT\n617\t    )\n618\t    assert spec is not None and spec.loader is not None\n619\t    module = importlib.util.module_from_spec(spec)\n620\t    sys.modules[spec.name] = module\n621\t    added = scripts_dir not in sys.path\n622\t    if added:\n623\t        sys.path.insert(\n624\t            0, scripts_dir\n625\t        )  # `from _paths import ...` при пустом __package__\n626\t    try:\n627\t        spec.loader.exec_module(module)\n628\t    finally:\n629\t        if added and scripts_dir in sys.path:\n630\t            sys.path.remove(scripts_dir)\n631\t    return module\n632\t\n633\t\n634\tclass FetchViaPlaywrightHotfixTests(unittest.TestCase):\n635\t    @classmethod\n636\t    def setUpClass(cls) -> None:\n637\t        cls.fetch = _load_fetch_script()\n638\t\n639\t    def setUp(self) -> None:\n640\t        with self.fetch._progress[\"lock\"]:\n641\t            self.fetch._progress[\"pending\"].clear()\n642\t            self.fetch._progress[\"completed\"] = 0\n643\t\n644\t    def test_fetch_one_timeout_isolated(self) -> None:\n645\t        fetch = self.fetch\n646\t        cancelled: list[str] = []\n647\t\n648\t        async def fetch_one(src: dict, ctx: Any, ctx_r: Any, cutoff: Any) -> tuple:\n649\t            try:\n650\t                await asyncio.sleep(30)\n651\t            finally:\n652\t                cancelled.append(src[\"id\"])\n653\t            return src[\"id\"], [\"never\"], None\n654\t\n655\t        async def fetch_one_no_rss(src: dict, ctx: Any, cutoff: Any) -> tuple:\n656\t            return src[\"id\"], [\"ok\"], None\n657\t\n658\t        async def scenario() -> list:\n659\t            return await asyncio.gather(\n660\t                fetch._track_fetch_one({\"id\": \"hung\"}, None, None, None, fetch_one),\n661\t                fetch._track_fetch_one(\n662\t                    {\"id\": \"good\"}, None, None, None, fetch_one_no_rss\n663\t                ),\n664\t            )\n665\t\n666\t        self.assertEqual(fetch.FETCH_ONE_TIMEOUT_S, 60.0)\n667\t        started = time.monotonic()\n668\t        with mock.patch.object(fetch, \"FETCH_ONE_TIMEOUT_S\", 0.1):\n669\t            results = asyncio.run(scenario())\n670\t        self.assertLess(time.monotonic() - started, 2.0)\n671\t        self.assertEqual(results[0], (\"hung\", [], \"timeout after 60s\"))\n672\t        self.assertEqual(results[1], (\"good\", [\"ok\"], None))\n673\t        self.assertEqual(cancelled, [\"hung\"], \"зависший источник должен быть отменён\")\n674\t        self.assertEqual(fetch._progress[\"pending\"], set())\n675\t        self.assertEqual(fetch._progress[\"completed\"], 2)\n676\t\n677\t    def test_page_close_bounded(self) -> None:\n678\t        fetch = self.fetch\n679\t        self.assertEqual(fetch.PAGE_CLOSE_TIMEOUT_S, 5.0)\n680\t\n681\t        class _HungPage:\n682\t            async def close(self) -> None:\n683\t                await asyncio.sleep(30)\n684\t\n685\t        class _BrokenPage:\n686\t            async def close(self) -> None:\n687\t                raise RuntimeError(\"Target closed\")\n688\t\n689\t        async def scenario() -> None:\n690\t            await fetch._safe_close_page(_HungPage())\n691\t            await fetch._safe_close_page(_BrokenPage())\n692\t\n693\t        started = time.monotonic()\n694\t        with mock.patch.object(fetch, \"PAGE_CLOSE_TIMEOUT_S\", 0.1):\n695\t            asyncio.run(scenario())  # исключения подавлены\n696\t        self.assertLess(time.monotonic() - started, 2.0)\n697\t\n698\t    def test_no_bare_page_close_left(self) -> None:\n699\t        text = _FETCH_SCRIPT.read_text(encoding=\"utf-8\")\n700\t        bare = [\n701\t            n\n702\t            for n, line in enumerate(text.splitlines(), 1)\n703\t            if line.strip() == \"await page.close()\"\n704\t        ]\n705\t        self.assertEqual(bare, [], f\"голые await page.close(): строки {bare}\")\n706\t\n707\t\n708\tif __name__ == \"__main__\":\n709\t    unittest.main()\n710\t"}]},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"534632a5-9933-47ac-9932-737257328f87","timestamp":"2026-10-29T08:10:17.408Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/tmp/cli-agent-bridge/agy-realtime-reasoning/tests/test_agy_bridge_resilience.py","content":"\"\"\"Тесты отказоустойчивости agy-bridge (ADR-0007, arch-spec r2 §6, RW-008).\n\nПокрыто 15 сценариев: детекция неактивности группы, сброс таймера по CPU и по\nпротокольным событиям, fail-closed при деградации `ps`, троттлинг `check()` в\n`_execute`, `child_exited` как штатное завершение, `absolute_cap` -> `timeout`,\nkill-switch, контракт ошибки `idle_timeout` (HTTP 504 / SSE), зачистка группы\nпроцессов и reap лидера, изоляция таймаута источника в `fetch_via_playwright.py`.\n\nМост `bridges/agy-bridge/server.py` лежит в каталоге с дефисом, поэтому грузится\nчерез `importlib`. Таймауты малые (`idle_timeout_s=0.2`) либо мок-часы; процессы\nсоздаются с `start_new_session=True` и убираются в `finally`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport importlib.util\nimport json\nimport os\nimport queue\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any\nfrom unittest import mock\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\nfrom core.watchdog import (  # noqa: E402\n    AdaptiveTimeoutController,\n    ProcessWatchdog,\n    WatchdogMetrics,\n)\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n_FETCH_SCRIPT = Path(\n    os.environ.get(\"AIBUNKER_FETCH_SCRIPT\")\n    or \"~/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py\"\n).expanduser()\n\n_POSIX = sys.platform != \"win32\"\n_DARWIN = sys.platform == \"darwin\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-agy-resilience\")\n    os.environ.pop(\"AGY_BRIDGE_FLEET\", None)\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass _FakeClock:\n    \"\"\"Ручные часы: время движется только через advance().\"\"\"\n\n    def __init__(self, now: float = 1000.0) -> None:\n        self.now = now\n\n    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass _TickQueue:\n    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n\n    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n        self.clock = clock\n        self.empty_ticks = empty_ticks\n        self.events = list(events)\n\n    def get(self, timeout: float = 0.0) -> Any:\n        if self.empty_ticks > 0:\n            self.empty_ticks -= 1\n            self.clock.advance(float(timeout))\n            raise queue.Empty\n        if self.events:\n            return self.events.pop(0)\n        self.clock.advance(float(timeout))\n        raise queue.Empty\n\n\nclass _SpyController:\n    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n\n    def __init__(\n        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n    ) -> None:\n        self.inner = inner\n        self.forced = forced\n        self.check_calls = 0\n        self.activity: list[str] = []\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n        self.inner.on_activity(kind)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.check_calls += 1\n        if self.forced is not None:\n            return self.forced\n        return self.inner.check(pgid)\n\n\ndef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n\n\ndef _hard_kill(proc: subprocess.Popen) -> None:\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        pass\n    try:\n        proc.wait(timeout=5)\n    except (subprocess.TimeoutExpired, OSError):\n        pass\n\n\ndef _ps_stat(pid: int) -> str:\n    out = subprocess.run(\n        [\"ps\", \"-o\", \"stat=\", \"-p\", str(pid)],\n        capture_output=True,\n        text=True,\n        check=False,\n    )\n    return out.stdout.strip()\n\n\ndef _group_gone(pgid: int, within_s: float = 2.0) -> bool:\n    deadline = time.monotonic() + within_s\n    while time.monotonic() < deadline:\n        try:\n            os.killpg(pgid, 0)\n        except ProcessLookupError:\n            return True\n        except PermissionError:\n            pass\n        time.sleep(0.05)\n    return False\n\n\nclass _Sock:\n    \"\"\"Пара сокетов для Handler.connection: пир открыт, данных нет -> клиент «на месте».\"\"\"\n\n    def __enter__(self) -> socket.socket:\n        self.a, self.b = socket.socketpair()\n        return self.a\n\n    def __exit__(self, *_exc: Any) -> None:\n        self.a.close()\n        self.b.close()\n\n\ndef _make_handler(connection: socket.socket) -> Any:\n    handler = srv.Handler.__new__(srv.Handler)\n    handler.connection = connection\n    return handler\n\n\ndef _fake_run(\n    clock: _FakeClock, controller: Any, events: list, empty_ticks: int\n) -> SimpleNamespace:\n    return SimpleNamespace(\n        q=_TickQueue(clock, empty_ticks, events),\n        controller=controller,\n        proc=SimpleNamespace(pid=424242),\n        got_event=True,\n        started=clock(),\n        err_box=[],\n    )\n\n\ndef _fake_time(clock: _FakeClock) -> SimpleNamespace:\n    return SimpleNamespace(\n        monotonic=clock, sleep=lambda _s: None, strftime=time.strftime, time=time.time\n    )\n\n\ndef _execute_with_clock(clock: _FakeClock, run: SimpleNamespace) -> dict:\n    \"\"\"Прогнать Handler._execute на мок-часах без реальных ожиданий.\"\"\"\n    with _Sock() as sock, mock.patch.object(srv, \"time\", _fake_time(clock)):\n        handler = _make_handler(sock)\n        return handler._execute(\n            run, lambda _t: True, lambda _e: True, lambda _r: True, None\n        )\n\n\nclass IdleDetectionTests(unittest.TestCase):\n    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n    def test_idle_timeout_detected_for_sleeping_process(self) -> None:\n        proc = _spawn([\"sleep\", \"100\"])\n        try:\n            ctrl = AdaptiveTimeoutController(\n                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n            )\n            ctrl.register_pgid(proc.pid)\n            result: tuple = (False, \"\", None)\n            deadline = time.monotonic() + 2.0\n            while time.monotonic() < deadline:\n                result = ctrl.check(proc.pid)\n                if result[0]:\n                    break\n                time.sleep(0.05)\n            self.assertTrue(result[0])\n            self.assertEqual(result[1], \"idle_timeout\")\n            ctrl.close()\n        finally:\n            _hard_kill(proc)\n\n    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n    def test_cpu_delta_resets_idle_timer(self) -> None:\n        proc = _spawn([sys.executable, \"-I\", \"-c\", \"while True: pass\"])\n        try:\n            ctrl = AdaptiveTimeoutController(\n                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n            )\n            ctrl.register_pgid(proc.pid)\n            end = time.monotonic() + 0.9  # заметно больше idle_timeout_s\n            while time.monotonic() < end:\n                should_stop, reason, _m = ctrl.check(proc.pid)\n                self.assertFalse(should_stop, f\"ложный {reason}: CPU растёт\")\n                time.sleep(0.05)\n            self.assertEqual(ctrl.last_activity_kind, \"cpu_delta\")\n            ctrl.close()\n        finally:\n            _hard_kill(proc)\n\n    def test_on_activity_resets_idle_timer(self) -> None:\n        for kind in (\"text\", \"reasoning\", \"tool_trace\", \"init\"):\n            with self.subTest(kind=kind):\n                clock = _FakeClock()\n                ctrl = AdaptiveTimeoutController(\n                    idle_timeout_s=0.2,\n                    safety_cap_s=60.0,\n                    finish_reserve_s=0.0,\n                    watchdog_enabled=False,\n                    clock=clock,\n                )\n                for _ in range(5):\n                    clock.advance(0.15)\n                    ctrl.on_activity(kind)\n                    self.assertEqual(ctrl.check(), (False, \"\", None))\n                self.assertEqual(ctrl.last_activity_kind, kind)\n                clock.advance(0.25)\n                should_stop, reason, _m = ctrl.check()\n                self.assertTrue(should_stop)\n                self.assertEqual(reason, \"idle_timeout\")\n\n    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n    def test_ps_degraded_fail_closed(self) -> None:\n        class _DegradedPs(ProcessWatchdog):\n            def _run_ps(self, pgid: int) -> Any:\n                raise subprocess.TimeoutExpired(cmd=\"ps\", timeout=2.0)\n\n        logs: list[str] = []\n        proc = _spawn([\"sleep\", \"100\"])\n        try:\n            clock = _FakeClock()\n            ctrl = AdaptiveTimeoutController(\n                idle_timeout_s=0.2,\n                safety_cap_s=60.0,\n                finish_reserve_s=0.0,\n                watchdog=_DegradedPs(log_fn=logs.append),\n                clock=clock,\n                log_fn=logs.append,\n            )\n            ctrl.register_pgid(proc.pid)\n            self.assertEqual(ctrl.check(proc.pid)[:2], (False, \"\"))\n            marker = ctrl.last_activity_ts\n            clock.advance(0.25)\n            should_stop, reason, metrics = ctrl.check(proc.pid)\n            self.assertTrue(should_stop)\n            self.assertEqual(reason, \"idle_timeout\")\n            self.assertTrue(metrics is not None and metrics.ps_degraded)\n            self.assertEqual(\n                ctrl.last_activity_ts, marker, \"fail-closed: таймер не сбрасывается\"\n            )\n            self.assertTrue(any(\"watchdog_ps_degraded\" in line for line in logs), logs)\n        finally:\n            _hard_kill(proc)\n\n    def test_ps_degraded_stub_metrics_never_count_as_progress(self) -> None:\n        degraded = WatchdogMetrics(\n            pgid=1,\n            alive=True,\n            descendant_pids=(),\n            new_descendants=(),\n            cpu_time_s=9.0,\n            cpu_delta_s=5.0,\n            ps_degraded=True,\n        )\n        self.assertFalse(degraded.has_progress)\n\n\nclass ExecuteLoopTests(unittest.TestCase):\n    def _controller(\n        self, clock: _FakeClock, **kwargs: Any\n    ) -> AdaptiveTimeoutController:\n        params: dict[str, Any] = dict(\n            idle_timeout_s=1000.0,\n            safety_cap_s=1800.0,\n            finish_reserve_s=0.0,\n            watchdog_enabled=False,\n            clock=clock,\n        )\n        params.update(kwargs)\n        return AdaptiveTimeoutController(**params)\n\n    def test_check_throttled_in_execute(self) -> None:\n        # (а) 100 событий за 1 с реального времени: check() не вызывается чаще 1 раза.\n        clock = _FakeClock()\n        spy = _SpyController(self._controller(clock))\n        events = [(\"text\", \"x\")] * 100 + [(\"done\", (0, \"\", {}))]\n        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n        self.assertEqual(out[\"state\"], \"done\")\n        self.assertLessEqual(spy.check_calls, 1)\n        self.assertEqual(spy.activity, [\"text\"] * 100)\n\n        # (б) пустая очередь 12 тиков по 1 с: проверка идёт раз в WATCHDOG_INTERVAL_S.\n        clock = _FakeClock()\n        spy = _SpyController(self._controller(clock))\n        out = _execute_with_clock(\n            clock, _fake_run(clock, spy, [(\"done\", (0, \"ok\", {}))], empty_ticks=12)\n        )\n        self.assertEqual(out[\"state\"], \"done\")\n        self.assertGreaterEqual(spy.check_calls, 1)\n        self.assertLess(spy.check_calls, 12)\n        self.assertEqual(spy.check_calls, 2)  # на 5-й и 10-й секундах\n\n    def test_all_activity_kinds_reach_controller(self) -> None:\n        clock = _FakeClock()\n        spy = _SpyController(self._controller(clock))\n        events = [\n            (\"init\", {\"conversation_id\": \"c1\", \"tools\": 0, \"permission_mode\": \"\"}),\n            (\"reasoning\", \"r\"),\n            (\"text\", \"t\"),\n            (\"tool_trace\", {\"name\": \"run_command\"}),\n            (\"result\", {\"status\": \"OK\", \"usage\": {}}),\n            (\"done\", (0, \"t\", {})),\n        ]\n        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n        self.assertEqual(out[\"state\"], \"done\")\n        # result/done — терминальные события и активностью не считаются.\n        self.assertEqual(spy.activity, [\"init\", \"reasoning\", \"text\", \"tool_trace\"])\n\n    def test_idle_timeout_returns_state_in_execute(self) -> None:\n        clock = _FakeClock()\n        ctrl = self._controller(clock, idle_timeout_s=8.0)\n        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n        self.assertEqual(out[\"state\"], \"idle_timeout\")\n        self.assertEqual(out[\"rc\"], 124)\n        self.assertIn(\"idle timeout\", out[\"err\"])\n\n    def test_child_exited_is_not_error(self) -> None:\n        clock = _FakeClock()\n        spy = _SpyController(\n            self._controller(clock), forced=(True, \"child_exited\", None)\n        )\n        events = [(\"text\", \"hi\"), (\"done\", (0, \"hi\", {}))]\n        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=7))\n        self.assertGreaterEqual(spy.check_calls, 1)\n        self.assertEqual(out[\"state\"], \"done\")\n        self.assertEqual(out[\"rc\"], 0)\n        self.assertEqual(out[\"text\"], \"hi\")\n\n    def test_absolute_cap_maps_to_timeout(self) -> None:\n        clock = _FakeClock()\n        pure = AdaptiveTimeoutController(\n            idle_timeout_s=1000.0,\n            safety_cap_s=0.2,\n            finish_reserve_s=0.0,\n            watchdog_enabled=False,\n            clock=clock,\n        )\n        clock.advance(0.25)\n        self.assertEqual(pure.check()[:2], (True, \"absolute_cap\"))\n\n        clock = _FakeClock()\n        ctrl = self._controller(clock, safety_cap_s=7.0)\n        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n        self.assertEqual(out[\"state\"], \"timeout\")\n        self.assertEqual(out[\"rc\"], 124)\n        self.assertEqual(srv.Handler._error_body(out)[\"type\"], \"timeout\")\n\n\nclass KillSwitchTests(unittest.TestCase):\n    def test_flag_values(self) -> None:\n        for value in (\"0\", \"false\", \"no\", \"off\", \"False\", \"OFF\"):\n            with (\n                self.subTest(value=value),\n                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n            ):\n                self.assertFalse(srv._is_watchdog_enabled())\n        for value in (\"1\", \"true\", \"yes\", \"on\"):\n            with (\n                self.subTest(value=value),\n                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n            ):\n                self.assertTrue(srv._is_watchdog_enabled())\n        with mock.patch.dict(os.environ):\n            os.environ.pop(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", None)\n            self.assertTrue(srv._is_watchdog_enabled())\n\n    def test_idle_timeout_env_validation(self) -> None:\n        for raw in (\"abc\", \"-5\", \"0\", \"nan\", \"inf\"):\n            with (\n                self.subTest(raw=raw),\n                mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": raw}),\n                mock.patch.object(srv, \"_log\") as log,\n            ):\n                self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n                log.assert_called_once()\n        with mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": \"12.5\"}):\n            self.assertEqual(srv._idle_timeout_from_env(), 12.5)\n        with mock.patch.dict(os.environ):\n            os.environ.pop(\"AGY_BRIDGE_IDLE_TIMEOUT\", None)\n            self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n\n    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n    def test_killswitch_disables_watchdog(self) -> None:\n        with tempfile.TemporaryDirectory() as tmp:\n            launcher = Path(tmp) / \"fake-launcher.sh\"\n            launcher.write_text(\"#!/bin/sh\\nexec sleep 100\\n\", encoding=\"utf-8\")\n            launcher.chmod(0o755)\n            runs: list[Any] = []\n\n            def make_run() -> Any:\n                run = srv.Run(\"ping\", \"m\", \"low\", \"default\", \"\", \"tag\")\n                runs.append(run)\n                return run\n\n            try:\n                with (\n                    mock.patch.object(srv, \"_launcher\", return_value=str(launcher)),\n                    mock.patch.object(srv, \"WORKSPACE\", Path(tmp) / \"ws\"),\n                    mock.patch.object(ProcessWatchdog, \"_run_ps\") as run_ps,\n                ):\n                    with mock.patch.dict(\n                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"0\"}\n                    ):\n                        off = make_run()\n                        self.assertEqual(\n                            off.controller.idle_timeout_s, float(srv.TIMEOUT_S)\n                        )\n                        self.assertIs(off.controller.watchdog_enabled, False)\n                        self.assertEqual(\n                            off.controller.safety_cap_s, float(srv.TIMEOUT_S)\n                        )\n                        self.assertEqual(off.controller.finish_reserve_s, 0.0)\n                        off.controller.check(off.proc.pid)\n                        run_ps.assert_not_called()  # ни seed, ни check не зовут ps\n                    with mock.patch.dict(\n                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"1\"}\n                    ):\n                        on = make_run()\n                        self.assertEqual(\n                            on.controller.idle_timeout_s, srv.IDLE_TIMEOUT_S\n                        )\n                        self.assertIs(on.controller.watchdog_enabled, True)\n                        self.assertEqual(\n                            on.controller.safety_cap_s, float(srv.TIMEOUT_S)\n                        )\n            finally:\n                for run in runs:\n                    run.close()\n\n\nclass ErrorContractTests(unittest.TestCase):\n    def test_error_body_idle_timeout_http_504(self) -> None:\n        body = srv.Handler._error_body({\"state\": \"idle_timeout\", \"rc\": 124})\n        self.assertEqual(body[\"code\"], 504)\n        self.assertEqual(body[\"type\"], \"idle_timeout\")\n        self.assertIn(f\"idle timeout after {srv.IDLE_TIMEOUT_S:g}s\", body[\"message\"])\n        self.assertIn(\"idle timeout after 300s\", body[\"message\"])\n\n    def _out(self) -> dict:\n        return {\n            \"state\": \"idle_timeout\",\n            \"rc\": 124,\n            \"text\": \"\",\n            \"usage\": {},\n            \"result\": {},\n            \"err\": \"x\",\n            \"tool_calls\": [],\n            \"tool_events\": 0,\n            \"conversation_id\": \"\",\n        }\n\n    def test_sse_error_chunk_idle_timeout(self) -> None:\n        frames: list[str] = []\n        handler = srv.Handler.__new__(srv.Handler)\n        handler.send_response = lambda *_a, **_k: None\n        handler.send_header = lambda *_a, **_k: None\n        handler.end_headers = lambda: None\n        handler._emit = lambda data: frames.append(data) or True\n        handler._run_once = lambda *_a, **_k: self._out()\n        handler._serve_sse({\"model\": \"m\"})\n        self.assertGreaterEqual(len(frames), 3)\n        self.assertEqual(frames[-1], \"data: [DONE]\\n\\n\")\n        error_frame = frames[-2]\n        self.assertTrue(\n            error_frame.startswith(\"data: \") and error_frame.endswith(\"\\n\\n\")\n        )\n        payload = json.loads(error_frame[len(\"data: \") :])\n        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n        self.assertEqual(payload[\"error\"][\"code\"], 504)\n        # ни finish_reason=stop, ни usage-кадра после ошибки быть не должно\n        self.assertFalse(any('\"finish_reason\": \"stop\"' in f for f in frames))\n\n    def test_json_mode_idle_timeout_is_504(self) -> None:\n        sent: list[tuple] = []\n        handler = srv.Handler.__new__(srv.Handler)\n        handler._send = lambda code, payload: sent.append((code, payload))\n        handler._run_once = lambda *_a, **_k: self._out()\n        handler._serve_json({\"model\": \"m\"})\n        self.assertEqual(len(sent), 1)\n        code, payload = sent[0]\n        self.assertEqual(code, 504)\n        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n\n\n@unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\nclass KillGroupTests(unittest.TestCase):\n    def test_kill_group_cleans_descendants_and_reaps_zombie(self) -> None:\n        proc = _spawn([\"sh\", \"-c\", \"sleep 100 & sleep 100 & wait\"])\n        try:\n            deadline = time.monotonic() + 3.0\n            while time.monotonic() < deadline:\n                out = subprocess.run(\n                    [\"ps\", \"-o\", \"pid=\", \"-g\", str(proc.pid)],\n                    capture_output=True,\n                    text=True,\n                    check=False,\n                )\n                if len(out.stdout.split()) >= 3:  # лидер + два sleep\n                    break\n                time.sleep(0.05)\n            self.assertGreaterEqual(len(out.stdout.split()), 3, \"потомки не стартовали\")\n            srv._kill_group(proc)\n            self.assertIsNotNone(proc.returncode)\n            self.assertTrue(\n                _group_gone(proc.pid), \"потомки группы пережили _kill_group\"\n            )\n            self.assertEqual(_ps_stat(proc.pid), \"\", \"лидер остался зомби\")\n        finally:\n            _hard_kill(proc)\n\n    def test_kill_group_reaps_when_group_already_gone(self) -> None:\n        proc = _spawn([\"true\"])\n        try:\n            deadline = time.monotonic() + 3.0\n            while _ps_stat(proc.pid) != \"Z\" and time.monotonic() < deadline:\n                time.sleep(0.05)  # лидер завершён и ещё не собран\n            with (\n                mock.patch.object(srv.os, \"killpg\", side_effect=ProcessLookupError),\n                mock.patch.object(proc, \"wait\", wraps=proc.wait) as wait,\n            ):\n                srv._kill_group(proc)  # не должен падать\n            wait.assert_called()\n            self.assertEqual(proc.returncode, 0)\n            self.assertEqual(_ps_stat(proc.pid), \"\", \"зомби не собран\")\n        finally:\n            _hard_kill(proc)\n\n    def test_kill_group_escalates_to_sigkill(self) -> None:\n        self.assertEqual(srv.KILL_TERM_GRACE_S, 2.0)\n        self.assertEqual(srv.KILL_WAIT_S, 5.0)\n        proc = _spawn(\n            [\"sh\", \"-c\", \"trap '' TERM; echo ready; while :; do sleep 1; done\"],\n            stdout=subprocess.PIPE,\n        )\n        try:\n            self.assertEqual(\n                proc.stdout.readline().strip(), b\"ready\"\n            )  # trap уже установлен\n            started = time.monotonic()\n            with mock.patch.object(srv, \"KILL_TERM_GRACE_S\", 0.4):\n                srv._kill_group(proc)\n            elapsed = time.monotonic() - started\n            self.assertEqual(proc.returncode, -signal.SIGKILL)\n            self.assertGreaterEqual(\n                elapsed, 0.35, \"SIGKILL раньше окончания grace-периода\"\n            )\n            self.assertLess(elapsed, 2.0 + 5.0)\n            self.assertTrue(_group_gone(proc.pid))\n        finally:\n            _hard_kill(proc)\n            if proc.stdout is not None:\n                proc.stdout.close()\n\n\ndef _load_fetch_script() -> Any:\n    if not _FETCH_SCRIPT.is_file():\n        raise unittest.SkipTest(f\"нет {_FETCH_SCRIPT}\")\n    scripts_dir = str(_FETCH_SCRIPT.parent)\n    spec = importlib.util.spec_from_file_location(\n        \"fetch_via_playwright_under_test\", _FETCH_SCRIPT\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    added = scripts_dir not in sys.path\n    if added:\n        sys.path.insert(\n            0, scripts_dir\n        )  # `from _paths import ...` при пустом __package__\n    try:\n        spec.loader.exec_module(module)\n    finally:\n        if added and scripts_dir in sys.path:\n            sys.path.remove(scripts_dir)\n    return module\n\n\nclass FetchViaPlaywrightHotfixTests(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls) -> None:\n        cls.fetch = _load_fetch_script()\n\n    def setUp(self) -> None:\n        with self.fetch._progress[\"lock\"]:\n            self.fetch._progress[\"pending\"].clear()\n            self.fetch._progress[\"completed\"] = 0\n\n    def test_fetch_one_timeout_isolated(self) -> None:\n        fetch = self.fetch\n        cancelled: list[str] = []\n\n        async def fetch_one(src: dict, ctx: Any, ctx_r: Any, cutoff: Any) -> tuple:\n            try:\n                await asyncio.sleep(30)\n            finally:\n                cancelled.append(src[\"id\"])\n            return src[\"id\"], [\"never\"], None\n\n        async def fetch_one_no_rss(src: dict, ctx: Any, cutoff: Any) -> tuple:\n            return src[\"id\"], [\"ok\"], None\n\n        async def scenario() -> list:\n            return await asyncio.gather(\n                fetch._track_fetch_one({\"id\": \"hung\"}, None, None, None, fetch_one),\n                fetch._track_fetch_one(\n                    {\"id\": \"good\"}, None, None, None, fetch_one_no_rss\n                ),\n            )\n\n        self.assertEqual(fetch.FETCH_ONE_TIMEOUT_S, 60.0)\n        started = time.monotonic()\n        with mock.patch.object(fetch, \"FETCH_ONE_TIMEOUT_S\", 0.1):\n            results = asyncio.run(scenario())\n        self.assertLess(time.monotonic() - started, 2.0)\n        self.assertEqual(results[0], (\"hung\", [], \"timeout after 60s\"))\n        self.assertEqual(results[1], (\"good\", [\"ok\"], None))\n        self.assertEqual(cancelled, [\"hung\"], \"зависший источник должен быть отменён\")\n        self.assertEqual(fetch._progress[\"pending\"], set())\n        self.assertEqual(fetch._progress[\"completed\"], 2)\n\n    def test_page_close_bounded(self) -> None:\n        fetch = self.fetch\n        self.assertEqual(fetch.PAGE_CLOSE_TIMEOUT_S, 5.0)\n\n        class _HungPage:\n            async def close(self) -> None:\n                await asyncio.sleep(30)\n\n        class _BrokenPage:\n            async def close(self) -> None:\n                raise RuntimeError(\"Target closed\")\n\n        async def scenario() -> None:\n            await fetch._safe_close_page(_HungPage())\n            await fetch._safe_close_page(_BrokenPage())\n\n        started = time.monotonic()\n        with mock.patch.object(fetch, \"PAGE_CLOSE_TIMEOUT_S\", 0.1):\n            asyncio.run(scenario())  # исключения подавлены\n        self.assertLess(time.monotonic() - started, 2.0)\n\n    def test_no_bare_page_close_left(self) -> None:\n        text = _FETCH_SCRIPT.read_text(encoding=\"utf-8\")\n        bare = [\n            n\n            for n, line in enumerate(text.splitlines(), 1)\n            if line.strip() == \"await page.close()\"\n        ]\n        self.assertEqual(bare, [], f\"голые await page.close(): строки {bare}\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":710,"startLine":1,"totalLines":710}},"tool_result_meta":[{"id":"toolu_0185uoDAbyua9GxACAjyETF7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
