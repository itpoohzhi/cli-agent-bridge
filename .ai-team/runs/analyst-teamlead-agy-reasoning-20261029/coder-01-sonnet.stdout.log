{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vc2ejefUCUK7mnJ6VmTLbc","type":"tool_result","content":"80\tdef validate_bound_role_plan(\n81\t    handoff: dict[str, Any], role: str, plan_path: Path\n82\t) -> None:\n83\t    \"\"\"Bind a handoff to the completed plan that produced it.\"\"\"\n84\t    try:\n85\t        raw = plan_path.read_bytes()\n86\t        plan = json.loads(raw.decode(\"utf-8\"))\n87\t        if not isinstance(plan, dict):\n88\t            raise RolePlanError(\"plan root must be an object\")\n89\t        validate_role_plan(plan, \"after\")\n90\t    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RolePlanError) as exc:\n91\t        raise ValidationError(f\"role_plan: invalid completed plan: {exc}\") from exc\n92\t\n93\t    if plan.get(\"role\") != role:\n94\t        raise ValidationError(\n95\t            f\"role_plan.role: expected {role!r}, got {plan.get('role')!r}\"\n96\t        )\n97\t    handoff_iteration = handoff.get(\"iteration\")\n98\t    if handoff_iteration is not None and plan.get(\"iteration\") != handoff_iteration:\n99\t        raise ValidationError(\"role_plan.iteration does not match handoff iteration\")\n100\t\n101\t    role_plan = require_object(handoff.get(\"role_plan\"), \"role_plan\")\n102\t    referenced_path = Path(require_string(role_plan, \"path\"))\n103\t    if referenced_path.name != plan_path.name:\n104\t        raise ValidationError(\"role_plan.path does not match supplied plan file\")\n105\t    actual_hash = hashlib.sha256(raw).hexdigest()\n106\t    if require_string(role_plan, \"sha256\") != actual_hash:\n107\t        raise ValidationError(\"role_plan.sha256 does not match supplied plan file\")\n108\t\n109\t    blocked = any(step.get(\"status\") == \"BLOCKED\" for step in plan[\"steps\"])\n110\t    outcome = handoff.get(\"status\", handoff.get(\"verdict\", handoff.get(\"decision\")))\n111\t    if blocked and outcome != \"BLOCKED\":\n112\t        raise ValidationError(\n113\t            \"role_plan contains BLOCKED step but handoff is not BLOCKED\"\n114\t        )\n115\t\n116\t\n117\tdef safe_relative_path(raw: str, label: str) -> Path:\n118\t    path = Path(raw)\n119\t    if path.is_absolute() or \"..\" in path.parts:\n120\t        raise ValidationError(f\"{label}: path must stay inside repository: {raw!r}\")\n121\t    return path\n122\t\n123\t\n124\tdef validate_commands(value: Any, label: str) -> None:\n125\t    for index, item in enumerate(require_list(value, label)):\n126\t        command = require_object(item, f\"{label}[{index}]\")\n127\t        require_string(command, \"command\")\n128\t        require_int(command, \"exit_code\", minimum=0)\n129\t\n130\t\n131\tdef validate_coder(data: dict[str, Any]) -> None:\n132\t    validate_common(data, \"coder\")\n133\t    require_int(data, \"iteration\", minimum=1)\n134\t    status = require_enum(data, \"status\", {\"DONE\", \"BLOCKED\"})\n135\t    require_string(data, \"summary\")\n136\t    changed_files = require_list(data.get(\"changed_files\"), \"changed_files\")\n137\t    for index, item in enumerate(changed_files):\n138\t        if not isinstance(item, str) or not item.strip():\n139\t            raise ValidationError(f\"changed_files[{index}]: expected non-empty string\")\n140\t        safe_relative_path(item, f\"changed_files[{index}]\")\n141\t    validate_commands(data.get(\"commands\"), \"commands\")\n142\t    require_list(data.get(\"acceptance_coverage\"), \"acceptance_coverage\")\n143\t    require_list(data.get(\"assumptions\"), \"assumptions\")\n144\t    require_list(data.get(\"risks\"), \"risks\")\n145\t    open_questions = require_list(data.get(\"open_questions\"), \"open_questions\")\n146\t    next_role = require_enum(data, \"next_role\", {\"reviewer\", \"orchestrator\"})\n147\t    if status == \"DONE\" and next_role != \"reviewer\":\n148\t        raise ValidationError(\"DONE coder handoff must set next_role='reviewer'\")\n149\t    if status == \"BLOCKED\" and not open_questions:\n150\t        raise ValidationError(\"BLOCKED coder handoff must explain open_questions\")\n151\t\n152\t\n153\tdef validate_finding(item: Any, index: int, root: Path | None) -> tuple[bool, str]:\n154\t    finding = require_object(item, f\"findings[{index}]\")\n155\t    finding_id = require_string(finding, \"id\")\n156\t    require_enum(finding, \"severity\", {\"critical\", \"major\", \"minor\"})\n157\t    require_string(finding, \"category\")\n158\t    blocking = finding.get(\"blocking\")\n159\t    if not isinstance(blocking, bool):\n160\t        raise ValidationError(f\"findings[{index}].blocking: expected boolean\")\n161\t    status = require_enum(finding, \"status\", {\"CONFIRMED\", \"INCONCLUSIVE\"})\n162\t    require_string(finding, \"problem\")\n163\t    require_string(finding, \"requested_change\")\n164\t\n165\t    if blocking and status != \"CONFIRMED\":\n166\t        raise ValidationError(f\"{finding_id}: INCONCLUSIVE finding cannot block\")\n167\t\n168\t    if status == \"CONFIRMED\":\n169\t        raw_file = require_string(finding, \"file\")\n170\t        relative = safe_relative_path(raw_file, f\"{finding_id}.file\")\n171\t        require_int(finding, \"line\", minimum=1)\n172\t        evidence = require_string(finding, \"evidence\")\n173\t        if root is not None:\n174\t            target = (root / relative).resolve()\n175\t            try:\n176\t                target.relative_to(root)\n177\t            except ValueError as exc:\n178\t                raise ValidationError(f\"{finding_id}: file escapes repository\") from exc\n179\t            if not target.is_file():\n180\t                raise ValidationError(\n181\t                    f\"{finding_id}: evidence file does not exist: {raw_file}\"\n182\t                )\n183\t            content = target.read_text(encoding=\"utf-8\", errors=\"replace\")\n184\t            if evidence not in content:\n185\t                raise ValidationError(\n186\t                    f\"{finding_id}: evidence is not present in {raw_file}\"\n187\t                )\n188\t    return blocking, status\n189\t\n190\t\n191\tdef validate_reviewer(\n192\t    data: dict[str, Any],\n193\t    root: Path | None,\n194\t    *,\n195\t    entry_override: str | None = None,\n196\t) -> None:\n197\t    validate_common(data, \"reviewer\")\n198\t    require_int(data, \"iteration\", minimum=1)\n199\t    verdict = require_enum(data, \"verdict\", {\"MERGE\", \"CHANGES_REQUESTED\", \"BLOCKED\"})\n200\t    spec_verdict = require_enum(data, \"spec_verdict\", {\"PASS\", \"FAIL\", \"INCONCLUSIVE\"})\n201\t    quality_verdict = require_enum(\n202\t        data, \"quality_verdict\", {\"PASS\", \"FAIL\", \"INCONCLUSIVE\"}\n203\t    )\n204\t    require_string(data, \"summary\")\n205\t    findings = require_list(data.get(\"findings\"), \"findings\")\n206\t    confirmed_blockers = 0\n207\t    for index, item in enumerate(findings):\n208\t        blocking, status = validate_finding(item, index, root)\n209\t        confirmed_blockers += int(blocking and status == \"CONFIRMED\")\n210\t    validate_commands(data.get(\"checks\"), \"checks\")\n211\t    require_list(data.get(\"residual_risks\"), \"residual_risks\")\n212\t    # Summarizer удалён из dev-цикла: MERGE ведёт к Orchestrator (Verifier →\n213\t    # FINAL_GATE), 'summarizer' остаётся только legacy-ролью validate_summarizer.\n214\t    next_role = require_enum(data, \"next_role\", {\"coder\", \"orchestrator\"})\n215\t    # Вход прогона (entry): review-only не возвращает к Coder; неизвестное\n216\t    # значение — fail-closed. Явный --entry (из state.json) действует, даже\n217\t    # когда поля entry в handoff нет; расхождение handoff и --entry — тоже\n218\t    # fail-closed.\n219\t    handoff_entry = data.get(\"entry\")\n220\t    if handoff_entry is not None and handoff_entry not in {\"full\", \"review-only\"}:\n221\t        raise ValidationError(\"entry: expected 'full' or 'review-only'\")\n222\t    if entry_override is not None and entry_override not in {\"full\", \"review-only\"}:\n223\t        raise ValidationError(\"entry: expected 'full' or 'review-only'\")\n224\t    if (\n225\t        entry_override is not None\n226\t        and handoff_entry is not None\n227\t        and entry_override != handoff_entry\n228\t    ):\n229\t        raise ValidationError(\n230\t            f\"entry mismatch: handoff={handoff_entry!r}, --entry={entry_override!r}\"\n231\t        )\n232\t    entry = entry_override or handoff_entry or \"full\"\n233\t\n234\t    if verdict == \"MERGE\":\n235\t        if spec_verdict != \"PASS\" or quality_verdict != \"PASS\":\n236\t            raise ValidationError(\n237\t                \"MERGE requires spec_verdict=PASS and quality_verdict=PASS\"\n238\t            )\n239\t        if confirmed_blockers:\n240\t            raise ValidationError(\n241\t                \"MERGE reviewer handoff contains confirmed blocking findings\"\n242\t            )\n243\t        if next_role != \"orchestrator\":\n244\t            raise ValidationError(\n245\t                \"MERGE reviewer handoff must set next_role='orchestrator'\"\n246\t            )\n247\t    elif verdict == \"CHANGES_REQUESTED\":\n248\t        if spec_verdict != \"FAIL\" and quality_verdict != \"FAIL\":\n249\t            raise ValidationError(\"CHANGES_REQUESTED requires FAIL on spec or quality\")\n250\t        if not confirmed_blockers:\n251\t            raise ValidationError(\n252\t                \"CHANGES_REQUESTED requires a confirmed blocking finding\"\n253\t            )\n254\t        if entry == \"review-only\":\n255\t            # review-only: Coder не стартует (REVIEW_CHANGES → ESCALATE,\n256\t            # findings уходят родителю) — handoff ведёт к orchestrator.\n257\t            if next_role != \"orchestrator\":\n258\t                raise ValidationError(\n259\t                    \"CHANGES_REQUESTED on review-only must set next_role='orchestrator'\"\n260\t                )\n261\t        elif next_role != \"coder\":\n262\t            raise ValidationError(\"CHANGES_REQUESTED must set next_role='coder'\")\n263\t    else:\n264\t        if spec_verdict != \"INCONCLUSIVE\" and quality_verdict != \"INCONCLUSIVE\":\n265\t            raise ValidationError(\"BLOCKED requires INCONCLUSIVE on spec or quality\")\n266\t        if next_role != \"orchestrator\":\n267\t            raise ValidationError(\n268\t                \"BLOCKED reviewer handoff must set next_role='orchestrator'\"\n269\t            )\n270\t\n271\t\n272\tdef validate_string_list(\n273\t    data: dict[str, Any], key: str, *, nonempty: bool = False\n274\t) -> None:\n275\t    values = require_list(data.get(key), key)\n276\t    if nonempty and not values:\n277\t        raise ValidationError(f\"{key}: must not be empty\")\n278\t    for index, item in enumerate(values):\n279\t        if not isinstance(item, str) or not item.strip():\n280\t            raise ValidationError(f\"{key}[{index}]: expected non-empty string\")\n281\t\n282\t\n283\tdef _resolve_evidence_text(\n284\t    *,\n285\t    claim_id: str,\n286\t    evidence_type: str,\n287\t    evidence_ref: str,\n288\t    root: Path | None,\n289\t    artifacts_dir: Path | None,\n290\t) -> str | None:\n291\t    \"\"\"Return file text to search for evidence_span, or None if not checking on disk.\"\"\"\n292\t    if root is None and artifacts_dir is None:\n293\t        return None\n294\t\n295\t    relative = safe_relative_path(evidence_ref, f\"{claim_id}.evidence_ref\")\n296\t\n297\t    if evidence_type == \"file\":\n298\t        if root is None:\n299\t            return None\n300\t        base = root\n301\t    elif evidence_type in {\"log\", \"gate\", \"diff\"}:\n302\t        # Prefer run artifacts dir; fall back to repo-relative path under root.\n303\t        if artifacts_dir is not None:\n304\t            base = artifacts_dir\n305\t        elif root is not None:\n306\t            base = root\n307\t        else:\n308\t            return None\n309\t    else:\n310\t        raise ValidationError(f\"{claim_id}: unknown evidence_type {evidence_type!r}\")\n311\t\n312\t    target = (base / relative).resolve()\n313\t    try:\n314\t        target.relative_to(base.resolve())\n315\t    except ValueError as exc:\n316\t        raise ValidationError(\n317\t            f\"{claim_id}: evidence_ref escapes base: {evidence_ref}\"\n318\t        ) from exc\n319\t    if not target.is_file():\n320\t        raise ValidationError(\n321\t            f\"{claim_id}: evidence file does not exist: {evidence_ref}\"\n322\t        )\n323\t    return target.read_text(encoding=\"utf-8\", errors=\"replace\")\n324\t\n325\t\n326\tdef validate_claim_ledger(\n327\t    data: dict[str, Any],\n328\t    *,\n329\t    root: Path | None,\n330\t    artifacts_dir: Path | None,\n331\t    require_all_grounded: bool,\n332\t) -> None:\n333\t    ledger = require_list(data.get(\"claim_ledger\"), \"claim_ledger\")\n334\t    if not ledger:\n335\t        raise ValidationError(\"claim_ledger: must not be empty\")\n336\t\n337\t    changes = require_list(data.get(\"changes\"), \"changes\")\n338\t    change_texts = {item.strip() for item in changes if isinstance(item, str)}\n339\t    claim_texts: set[str] = set()\n340\t    seen_ids: set[str] = set()\n341\t    ungrounded = 0\n342\t\n343\t    for index, item in enumerate(ledger):\n344\t        claim = require_object(item, f\"claim_ledger[{index}]\")\n345\t        claim_id = require_string(claim, \"claim_id\")\n346\t        if claim_id in seen_ids:\n347\t            raise ValidationError(f\"claim_ledger: duplicate claim_id {claim_id!r}\")\n348\t        seen_ids.add(claim_id)\n349\t        text = require_string(claim, \"text\")\n350\t        claim_texts.add(text.strip())\n351\t        evidence_type = require_enum(\n352\t            claim, \"evidence_type\", {\"file\", \"diff\", \"log\", \"gate\"}\n353\t        )\n354\t        evidence_ref = require_string(claim, \"evidence_ref\")\n355\t        evidence_span = require_string(claim, \"evidence_span\")\n356\t        status = require_enum(\n357\t            claim, \"status\", {\"GROUNDED\", \"UNGROUNDED\", \"INCONCLUSIVE\"}\n358\t        )\n359\t\n360\t        content = _resolve_evidence_text(\n361\t            claim_id=claim_id,\n362\t            evidence_type=evidence_type,\n363\t            evidence_ref=evidence_ref,\n364\t            root=root,\n365\t            artifacts_dir=artifacts_dir,\n366\t        )\n367\t        if content is not None:\n368\t            present = evidence_span in content\n369\t            if status == \"GROUNDED\" and not present:\n370\t                raise ValidationError(\n371\t                    f\"{claim_id}: status=GROUNDED but evidence_span not found in {evidence_ref}\"\n372\t                )\n373\t            if status == \"UNGROUNDED\" and present:\n374\t                raise ValidationError(\n375\t                    f\"{claim_id}: status=UNGROUNDED but evidence_span is present in {evidence_ref}\"\n376\t                )\n377\t\n378\t        if status == \"UNGROUNDED\":\n379\t            ungrounded += 1\n380\t\n381\t    missing = change_texts - claim_texts\n382\t    if missing:\n383\t        sample = sorted(missing)[:3]\n384\t        raise ValidationError(\n385\t            \"claim_ledger: every changes[] bullet must appear as claim text; \"\n386\t            f\"missing e.g. {sample}\"\n387\t        )\n388\t\n389\t    if require_all_grounded and ungrounded:\n390\t        raise ValidationError(\n391\t            \"READY_FOR_PR requires all claim_ledger statuses GROUNDED \"\n392\t            f\"(found {ungrounded} UNGROUNDED); use decision=REWORK\"\n393\t        )\n394\t    if require_all_grounded:\n395\t        for index, item in enumerate(ledger):\n396\t            claim = require_object(item, f\"claim_ledger[{index}]\")\n397\t            if claim.get(\"status\") == \"INCONCLUSIVE\":\n398\t                raise ValidationError(\n399\t                    f\"{claim['claim_id']}: READY_FOR_PR forbids INCONCLUSIVE claims; \"\n400\t                    \"use REWORK or move to residual risks / follow_ups\"\n401\t                )\n402\t\n403\t\n404\tdef validate_summarizer(\n405\t    data: dict[str, Any],\n406\t    *,\n407\t    root: Path | None = None,\n408\t    artifacts_dir: Path | None = None,\n409\t) -> None:\n410\t    validate_common(data, \"summarizer\")\n411\t    decision = require_enum(data, \"decision\", {\"READY_FOR_PR\", \"REWORK\", \"BLOCKED\"})\n412\t    source_verdict = require_enum(\n413\t        data, \"source_review_verdict\", {\"MERGE\", \"CHANGES_REQUESTED\", \"BLOCKED\"}\n414\t    )\n415\t    require_string(data, \"title\")\n416\t    require_string(data, \"why\")\n417\t    validate_string_list(data, \"changes\", nonempty=True)\n418\t    test_plan = require_list(data.get(\"test_plan\"), \"test_plan\")\n419\t    if not test_plan:\n420\t        raise ValidationError(\"test_plan: must include deterministic gate evidence\")\n421\t    for index, item in enumerate(test_plan):\n422\t        check = require_object(item, f\"test_plan[{index}]\")\n423\t        require_string(check, \"command\")\n424\t        require_string(check, \"result\")\n425\t    validate_string_list(data, \"risks\")\n426\t    require_string(data, \"rollback\")\n427\t    validate_string_list(data, \"follow_ups\")\n428\t    validate_string_list(data, \"evidence_files\", nonempty=True)\n429\t\n430\t    next_role = data.get(\"next_role\")\n431\t    if next_role is not None:\n432\t        require_enum(data, \"next_role\", {\"coder\", \"orchestrator\", \"final_gate\"})\n433\t\n434\t    # Claim ledger is mandatory for summarizer (schema 1.1 contract; also required on 1.0).\n435\t    require_all_grounded = decision == \"READY_FOR_PR\"\n436\t    validate_claim_ledger(\n437\t        data,\n438\t        root=root,\n439\t        artifacts_dir=artifacts_dir,\n440\t        require_all_grounded=require_all_grounded,\n441\t    )\n442\t\n443\t    if decision == \"READY_FOR_PR\":\n444\t        if source_verdict != \"MERGE\":\n445\t            raise ValidationError(\"READY_FOR_PR requires source_review_verdict='MERGE'\")\n446\t        if next_role is not None and next_role != \"final_gate\":\n447\t            raise ValidationError(\n448\t                \"READY_FOR_PR next_role must be 'final_gate' when set\"\n449\t            )\n450\t    elif decision == \"REWORK\":\n451\t        if source_verdict not in {\"MERGE\", \"CHANGES_REQUESTED\"}:\n452\t            raise ValidationError(\n453\t                \"REWORK requires source_review_verdict MERGE or CHANGES_REQUESTED\"\n454\t            )\n455\t        if next_role is not None and next_role != \"coder\":\n456\t            raise ValidationError(\"REWORK next_role must be 'coder' when set\")\n457\t        rework_reason = data.get(\"rework_reason\")\n458\t        if not isinstance(rework_reason, str) or not rework_reason.strip():\n459\t            raise ValidationError(\"REWORK requires non-empty rework_reason\")\n460\t    else:  # BLOCKED\n461\t        if next_role is not None and next_role != \"orchestrator\":\n462\t            raise ValidationError(\"BLOCKED next_role must be 'orchestrator' when set\")\n463\t        open_questions = data.get(\"open_questions\")\n464\t        if not isinstance(open_questions, list) or not open_questions:\n465\t            raise ValidationError(\"BLOCKED requires non-empty open_questions\")\n466\t\n467\t\n468\tdef main(argv: list[str] | None = None) -> int:\n469\t    parser = argparse.ArgumentParser(description=__doc__)\n470\t    parser.add_argument(\"role\", choices=(\"coder\", \"reviewer\", \"summarizer\"))\n471\t    parser.add_argument(\"handoff\", type=Path)\n472\t    parser.add_argument(\n473\t        \"--role-plan\",\n474\t        type=Path,\n475\t        required=True,\n476\t        help=\"Completed ROLE PLAN referenced by the handoff\",\n477\t    )\n478\t    parser.add_argument(\n479\t        \"--root\",\n480\t        type=Path,\n481\t        help=\"Repository root for reviewer evidence / summarizer file claims\",\n482\t    )\n483\t    parser.add_argument(\n484\t        \"--artifacts-dir\",\n485\t        type=Path,\n486\t        help=\"Run artifacts dir for summarizer diff/log/gate claim checks\",\n487\t    )\n488\t    parser.add_argument(\n489\t        \"--entry\",\n490\t        choices=(\"full\", \"review-only\"),\n491\t        default=None,\n492\t        help=(\n493\t            \"Run entry from state.json (reviewer checks): review-only forbids \"\n494\t            \"next_role='coder' and must match handoff entry when both are set\"\n495\t        ),\n496\t    )\n497\t    args = parser.parse_args(argv)\n498\t\n499\t    try:\n500\t        raw = args.handoff.read_text(encoding=\"utf-8\")\n501\t        data = require_object(json.loads(raw), \"handoff\")\n502\t        root = args.root.resolve() if args.root else None\n503\t        artifacts_dir = args.artifacts_dir.resolve() if args.artifacts_dir else None\n504\t        if args.role == \"coder\":\n505\t            validate_coder(data)\n506\t        elif args.role == \"reviewer\":\n507\t            validate_reviewer(data, root, entry_override=args.entry)\n508\t        else:\n509\t            validate_summarizer(data, root=root, artifacts_dir=artifacts_dir)\n510\t        validate_bound_role_plan(data, args.role, args.role_plan)\n511\t    except (OSError, json.JSONDecodeError, ValidationError) as exc:\n512\t        print(f\"INVALID: {exc}\", file=sys.stderr)\n513\t        return 1\n514\t\n515\t    print(f\"VALID: role={args.role} file={args.handoff}\")\n516\t    return 0\n517\t\n518\t\n519\tif __name__ == \"__main__\":"}]},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"1d58dedf-a45e-452c-af25-ece99e7249ca","timestamp":"2026-10-29T08:11:07.367Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/orchestrate-coder-reviewer-summarizer/scripts/validate_handoff.py","content":"def validate_bound_role_plan(\n    handoff: dict[str, Any], role: str, plan_path: Path\n) -> None:\n    \"\"\"Bind a handoff to the completed plan that produced it.\"\"\"\n    try:\n        raw = plan_path.read_bytes()\n        plan = json.loads(raw.decode(\"utf-8\"))\n        if not isinstance(plan, dict):\n            raise RolePlanError(\"plan root must be an object\")\n        validate_role_plan(plan, \"after\")\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RolePlanError) as exc:\n        raise ValidationError(f\"role_plan: invalid completed plan: {exc}\") from exc\n\n    if plan.get(\"role\") != role:\n        raise ValidationError(\n            f\"role_plan.role: expected {role!r}, got {plan.get('role')!r}\"\n        )\n    handoff_iteration = handoff.get(\"iteration\")\n    if handoff_iteration is not None and plan.get(\"iteration\") != handoff_iteration:\n        raise ValidationError(\"role_plan.iteration does not match handoff iteration\")\n\n    role_plan = require_object(handoff.get(\"role_plan\"), \"role_plan\")\n    referenced_path = Path(require_string(role_plan, \"path\"))\n    if referenced_path.name != plan_path.name:\n        raise ValidationError(\"role_plan.path does not match supplied plan file\")\n    actual_hash = hashlib.sha256(raw).hexdigest()\n    if require_string(role_plan, \"sha256\") != actual_hash:\n        raise ValidationError(\"role_plan.sha256 does not match supplied plan file\")\n\n    blocked = any(step.get(\"status\") == \"BLOCKED\" for step in plan[\"steps\"])\n    outcome = handoff.get(\"status\", handoff.get(\"verdict\", handoff.get(\"decision\")))\n    if blocked and outcome != \"BLOCKED\":\n        raise ValidationError(\n            \"role_plan contains BLOCKED step but handoff is not BLOCKED\"\n        )\n\n\ndef safe_relative_path(raw: str, label: str) -> Path:\n    path = Path(raw)\n    if path.is_absolute() or \"..\" in path.parts:\n        raise ValidationError(f\"{label}: path must stay inside repository: {raw!r}\")\n    return path\n\n\ndef validate_commands(value: Any, label: str) -> None:\n    for index, item in enumerate(require_list(value, label)):\n        command = require_object(item, f\"{label}[{index}]\")\n        require_string(command, \"command\")\n        require_int(command, \"exit_code\", minimum=0)\n\n\ndef validate_coder(data: dict[str, Any]) -> None:\n    validate_common(data, \"coder\")\n    require_int(data, \"iteration\", minimum=1)\n    status = require_enum(data, \"status\", {\"DONE\", \"BLOCKED\"})\n    require_string(data, \"summary\")\n    changed_files = require_list(data.get(\"changed_files\"), \"changed_files\")\n    for index, item in enumerate(changed_files):\n        if not isinstance(item, str) or not item.strip():\n            raise ValidationError(f\"changed_files[{index}]: expected non-empty string\")\n        safe_relative_path(item, f\"changed_files[{index}]\")\n    validate_commands(data.get(\"commands\"), \"commands\")\n    require_list(data.get(\"acceptance_coverage\"), \"acceptance_coverage\")\n    require_list(data.get(\"assumptions\"), \"assumptions\")\n    require_list(data.get(\"risks\"), \"risks\")\n    open_questions = require_list(data.get(\"open_questions\"), \"open_questions\")\n    next_role = require_enum(data, \"next_role\", {\"reviewer\", \"orchestrator\"})\n    if status == \"DONE\" and next_role != \"reviewer\":\n        raise ValidationError(\"DONE coder handoff must set next_role='reviewer'\")\n    if status == \"BLOCKED\" and not open_questions:\n        raise ValidationError(\"BLOCKED coder handoff must explain open_questions\")\n\n\ndef validate_finding(item: Any, index: int, root: Path | None) -> tuple[bool, str]:\n    finding = require_object(item, f\"findings[{index}]\")\n    finding_id = require_string(finding, \"id\")\n    require_enum(finding, \"severity\", {\"critical\", \"major\", \"minor\"})\n    require_string(finding, \"category\")\n    blocking = finding.get(\"blocking\")\n    if not isinstance(blocking, bool):\n        raise ValidationError(f\"findings[{index}].blocking: expected boolean\")\n    status = require_enum(finding, \"status\", {\"CONFIRMED\", \"INCONCLUSIVE\"})\n    require_string(finding, \"problem\")\n    require_string(finding, \"requested_change\")\n\n    if blocking and status != \"CONFIRMED\":\n        raise ValidationError(f\"{finding_id}: INCONCLUSIVE finding cannot block\")\n\n    if status == \"CONFIRMED\":\n        raw_file = require_string(finding, \"file\")\n        relative = safe_relative_path(raw_file, f\"{finding_id}.file\")\n        require_int(finding, \"line\", minimum=1)\n        evidence = require_string(finding, \"evidence\")\n        if root is not None:\n            target = (root / relative).resolve()\n            try:\n                target.relative_to(root)\n            except ValueError as exc:\n                raise ValidationError(f\"{finding_id}: file escapes repository\") from exc\n            if not target.is_file():\n                raise ValidationError(\n                    f\"{finding_id}: evidence file does not exist: {raw_file}\"\n                )\n            content = target.read_text(encoding=\"utf-8\", errors=\"replace\")\n            if evidence not in content:\n                raise ValidationError(\n                    f\"{finding_id}: evidence is not present in {raw_file}\"\n                )\n    return blocking, status\n\n\ndef validate_reviewer(\n    data: dict[str, Any],\n    root: Path | None,\n    *,\n    entry_override: str | None = None,\n) -> None:\n    validate_common(data, \"reviewer\")\n    require_int(data, \"iteration\", minimum=1)\n    verdict = require_enum(data, \"verdict\", {\"MERGE\", \"CHANGES_REQUESTED\", \"BLOCKED\"})\n    spec_verdict = require_enum(data, \"spec_verdict\", {\"PASS\", \"FAIL\", \"INCONCLUSIVE\"})\n    quality_verdict = require_enum(\n        data, \"quality_verdict\", {\"PASS\", \"FAIL\", \"INCONCLUSIVE\"}\n    )\n    require_string(data, \"summary\")\n    findings = require_list(data.get(\"findings\"), \"findings\")\n    confirmed_blockers = 0\n    for index, item in enumerate(findings):\n        blocking, status = validate_finding(item, index, root)\n        confirmed_blockers += int(blocking and status == \"CONFIRMED\")\n    validate_commands(data.get(\"checks\"), \"checks\")\n    require_list(data.get(\"residual_risks\"), \"residual_risks\")\n    # Summarizer удалён из dev-цикла: MERGE ведёт к Orchestrator (Verifier →\n    # FINAL_GATE), 'summarizer' остаётся только legacy-ролью validate_summarizer.\n    next_role = require_enum(data, \"next_role\", {\"coder\", \"orchestrator\"})\n    # Вход прогона (entry): review-only не возвращает к Coder; неизвестное\n    # значение — fail-closed. Явный --entry (из state.json) действует, даже\n    # когда поля entry в handoff нет; расхождение handoff и --entry — тоже\n    # fail-closed.\n    handoff_entry = data.get(\"entry\")\n    if handoff_entry is not None and handoff_entry not in {\"full\", \"review-only\"}:\n        raise ValidationError(\"entry: expected 'full' or 'review-only'\")\n    if entry_override is not None and entry_override not in {\"full\", \"review-only\"}:\n        raise ValidationError(\"entry: expected 'full' or 'review-only'\")\n    if (\n        entry_override is not None\n        and handoff_entry is not None\n        and entry_override != handoff_entry\n    ):\n        raise ValidationError(\n            f\"entry mismatch: handoff={handoff_entry!r}, --entry={entry_override!r}\"\n        )\n    entry = entry_override or handoff_entry or \"full\"\n\n    if verdict == \"MERGE\":\n        if spec_verdict != \"PASS\" or quality_verdict != \"PASS\":\n            raise ValidationError(\n                \"MERGE requires spec_verdict=PASS and quality_verdict=PASS\"\n            )\n        if confirmed_blockers:\n            raise ValidationError(\n                \"MERGE reviewer handoff contains confirmed blocking findings\"\n            )\n        if next_role != \"orchestrator\":\n            raise ValidationError(\n                \"MERGE reviewer handoff must set next_role='orchestrator'\"\n            )\n    elif verdict == \"CHANGES_REQUESTED\":\n        if spec_verdict != \"FAIL\" and quality_verdict != \"FAIL\":\n            raise ValidationError(\"CHANGES_REQUESTED requires FAIL on spec or quality\")\n        if not confirmed_blockers:\n            raise ValidationError(\n                \"CHANGES_REQUESTED requires a confirmed blocking finding\"\n            )\n        if entry == \"review-only\":\n            # review-only: Coder не стартует (REVIEW_CHANGES → ESCALATE,\n            # findings уходят родителю) — handoff ведёт к orchestrator.\n            if next_role != \"orchestrator\":\n                raise ValidationError(\n                    \"CHANGES_REQUESTED on review-only must set next_role='orchestrator'\"\n                )\n        elif next_role != \"coder\":\n            raise ValidationError(\"CHANGES_REQUESTED must set next_role='coder'\")\n    else:\n        if spec_verdict != \"INCONCLUSIVE\" and quality_verdict != \"INCONCLUSIVE\":\n            raise ValidationError(\"BLOCKED requires INCONCLUSIVE on spec or quality\")\n        if next_role != \"orchestrator\":\n            raise ValidationError(\n                \"BLOCKED reviewer handoff must set next_role='orchestrator'\"\n            )\n\n\ndef validate_string_list(\n    data: dict[str, Any], key: str, *, nonempty: bool = False\n) -> None:\n    values = require_list(data.get(key), key)\n    if nonempty and not values:\n        raise ValidationError(f\"{key}: must not be empty\")\n    for index, item in enumerate(values):\n        if not isinstance(item, str) or not item.strip():\n            raise ValidationError(f\"{key}[{index}]: expected non-empty string\")\n\n\ndef _resolve_evidence_text(\n    *,\n    claim_id: str,\n    evidence_type: str,\n    evidence_ref: str,\n    root: Path | None,\n    artifacts_dir: Path | None,\n) -> str | None:\n    \"\"\"Return file text to search for evidence_span, or None if not checking on disk.\"\"\"\n    if root is None and artifacts_dir is None:\n        return None\n\n    relative = safe_relative_path(evidence_ref, f\"{claim_id}.evidence_ref\")\n\n    if evidence_type == \"file\":\n        if root is None:\n            return None\n        base = root\n    elif evidence_type in {\"log\", \"gate\", \"diff\"}:\n        # Prefer run artifacts dir; fall back to repo-relative path under root.\n        if artifacts_dir is not None:\n            base = artifacts_dir\n        elif root is not None:\n            base = root\n        else:\n            return None\n    else:\n        raise ValidationError(f\"{claim_id}: unknown evidence_type {evidence_type!r}\")\n\n    target = (base / relative).resolve()\n    try:\n        target.relative_to(base.resolve())\n    except ValueError as exc:\n        raise ValidationError(\n            f\"{claim_id}: evidence_ref escapes base: {evidence_ref}\"\n        ) from exc\n    if not target.is_file():\n        raise ValidationError(\n            f\"{claim_id}: evidence file does not exist: {evidence_ref}\"\n        )\n    return target.read_text(encoding=\"utf-8\", errors=\"replace\")\n\n\ndef validate_claim_ledger(\n    data: dict[str, Any],\n    *,\n    root: Path | None,\n    artifacts_dir: Path | None,\n    require_all_grounded: bool,\n) -> None:\n    ledger = require_list(data.get(\"claim_ledger\"), \"claim_ledger\")\n    if not ledger:\n        raise ValidationError(\"claim_ledger: must not be empty\")\n\n    changes = require_list(data.get(\"changes\"), \"changes\")\n    change_texts = {item.strip() for item in changes if isinstance(item, str)}\n    claim_texts: set[str] = set()\n    seen_ids: set[str] = set()\n    ungrounded = 0\n\n    for index, item in enumerate(ledger):\n        claim = require_object(item, f\"claim_ledger[{index}]\")\n        claim_id = require_string(claim, \"claim_id\")\n        if claim_id in seen_ids:\n            raise ValidationError(f\"claim_ledger: duplicate claim_id {claim_id!r}\")\n        seen_ids.add(claim_id)\n        text = require_string(claim, \"text\")\n        claim_texts.add(text.strip())\n        evidence_type = require_enum(\n            claim, \"evidence_type\", {\"file\", \"diff\", \"log\", \"gate\"}\n        )\n        evidence_ref = require_string(claim, \"evidence_ref\")\n        evidence_span = require_string(claim, \"evidence_span\")\n        status = require_enum(\n            claim, \"status\", {\"GROUNDED\", \"UNGROUNDED\", \"INCONCLUSIVE\"}\n        )\n\n        content = _resolve_evidence_text(\n            claim_id=claim_id,\n            evidence_type=evidence_type,\n            evidence_ref=evidence_ref,\n            root=root,\n            artifacts_dir=artifacts_dir,\n        )\n        if content is not None:\n            present = evidence_span in content\n            if status == \"GROUNDED\" and not present:\n                raise ValidationError(\n                    f\"{claim_id}: status=GROUNDED but evidence_span not found in {evidence_ref}\"\n                )\n            if status == \"UNGROUNDED\" and present:\n                raise ValidationError(\n                    f\"{claim_id}: status=UNGROUNDED but evidence_span is present in {evidence_ref}\"\n                )\n\n        if status == \"UNGROUNDED\":\n            ungrounded += 1\n\n    missing = change_texts - claim_texts\n    if missing:\n        sample = sorted(missing)[:3]\n        raise ValidationError(\n            \"claim_ledger: every changes[] bullet must appear as claim text; \"\n            f\"missing e.g. {sample}\"\n        )\n\n    if require_all_grounded and ungrounded:\n        raise ValidationError(\n            \"READY_FOR_PR requires all claim_ledger statuses GROUNDED \"\n            f\"(found {ungrounded} UNGROUNDED); use decision=REWORK\"\n        )\n    if require_all_grounded:\n        for index, item in enumerate(ledger):\n            claim = require_object(item, f\"claim_ledger[{index}]\")\n            if claim.get(\"status\") == \"INCONCLUSIVE\":\n                raise ValidationError(\n                    f\"{claim['claim_id']}: READY_FOR_PR forbids INCONCLUSIVE claims; \"\n                    \"use REWORK or move to residual risks / follow_ups\"\n                )\n\n\ndef validate_summarizer(\n    data: dict[str, Any],\n    *,\n    root: Path | None = None,\n    artifacts_dir: Path | None = None,\n) -> None:\n    validate_common(data, \"summarizer\")\n    decision = require_enum(data, \"decision\", {\"READY_FOR_PR\", \"REWORK\", \"BLOCKED\"})\n    source_verdict = require_enum(\n        data, \"source_review_verdict\", {\"MERGE\", \"CHANGES_REQUESTED\", \"BLOCKED\"}\n    )\n    require_string(data, \"title\")\n    require_string(data, \"why\")\n    validate_string_list(data, \"changes\", nonempty=True)\n    test_plan = require_list(data.get(\"test_plan\"), \"test_plan\")\n    if not test_plan:\n        raise ValidationError(\"test_plan: must include deterministic gate evidence\")\n    for index, item in enumerate(test_plan):\n        check = require_object(item, f\"test_plan[{index}]\")\n        require_string(check, \"command\")\n        require_string(check, \"result\")\n    validate_string_list(data, \"risks\")\n    require_string(data, \"rollback\")\n    validate_string_list(data, \"follow_ups\")\n    validate_string_list(data, \"evidence_files\", nonempty=True)\n\n    next_role = data.get(\"next_role\")\n    if next_role is not None:\n        require_enum(data, \"next_role\", {\"coder\", \"orchestrator\", \"final_gate\"})\n\n    # Claim ledger is mandatory for summarizer (schema 1.1 contract; also required on 1.0).\n    require_all_grounded = decision == \"READY_FOR_PR\"\n    validate_claim_ledger(\n        data,\n        root=root,\n        artifacts_dir=artifacts_dir,\n        require_all_grounded=require_all_grounded,\n    )\n\n    if decision == \"READY_FOR_PR\":\n        if source_verdict != \"MERGE\":\n            raise ValidationError(\"READY_FOR_PR requires source_review_verdict='MERGE'\")\n        if next_role is not None and next_role != \"final_gate\":\n            raise ValidationError(\n                \"READY_FOR_PR next_role must be 'final_gate' when set\"\n            )\n    elif decision == \"REWORK\":\n        if source_verdict not in {\"MERGE\", \"CHANGES_REQUESTED\"}:\n            raise ValidationError(\n                \"REWORK requires source_review_verdict MERGE or CHANGES_REQUESTED\"\n            )\n        if next_role is not None and next_role != \"coder\":\n            raise ValidationError(\"REWORK next_role must be 'coder' when set\")\n        rework_reason = data.get(\"rework_reason\")\n        if not isinstance(rework_reason, str) or not rework_reason.strip():\n            raise ValidationError(\"REWORK requires non-empty rework_reason\")\n    else:  # BLOCKED\n        if next_role is not None and next_role != \"orchestrator\":\n            raise ValidationError(\"BLOCKED next_role must be 'orchestrator' when set\")\n        open_questions = data.get(\"open_questions\")\n        if not isinstance(open_questions, list) or not open_questions:\n            raise ValidationError(\"BLOCKED requires non-empty open_questions\")\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"role\", choices=(\"coder\", \"reviewer\", \"summarizer\"))\n    parser.add_argument(\"handoff\", type=Path)\n    parser.add_argument(\n        \"--role-plan\",\n        type=Path,\n        required=True,\n        help=\"Completed ROLE PLAN referenced by the handoff\",\n    )\n    parser.add_argument(\n        \"--root\",\n        type=Path,\n        help=\"Repository root for reviewer evidence / summarizer file claims\",\n    )\n    parser.add_argument(\n        \"--artifacts-dir\",\n        type=Path,\n        help=\"Run artifacts dir for summarizer diff/log/gate claim checks\",\n    )\n    parser.add_argument(\n        \"--entry\",\n        choices=(\"full\", \"review-only\"),\n        default=None,\n        help=(\n            \"Run entry from state.json (reviewer checks): review-only forbids \"\n            \"next_role='coder' and must match handoff entry when both are set\"\n        ),\n    )\n    args = parser.parse_args(argv)\n\n    try:\n        raw = args.handoff.read_text(encoding=\"utf-8\")\n        data = require_object(json.loads(raw), \"handoff\")\n        root = args.root.resolve() if args.root else None\n        artifacts_dir = args.artifacts_dir.resolve() if args.artifacts_dir else None\n        if args.role == \"coder\":\n            validate_coder(data)\n        elif args.role == \"reviewer\":\n            validate_reviewer(data, root, entry_override=args.entry)\n        else:\n            validate_summarizer(data, root=root, artifacts_dir=artifacts_dir)\n        validate_bound_role_plan(data, args.role, args.role_plan)\n    except (OSError, json.JSONDecodeError, ValidationError) as exc:\n        print(f\"INVALID: {exc}\", file=sys.stderr)\n        return 1\n\n    print(f\"VALID: role={args.role} file={args.handoff}\")\n    return 0\n\n\nif __name__ == \"__main__\":","numLines":440,"startLine":80,"totalLines":521}},"tool_result_meta":[{"id":"toolu_01Vc2ejefUCUK7mnJ6VmTLbc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
