uvx --from pytest==9.0.3), кэш uvx прогрет; без сети, без ~/.gemini и ~/.dsh владельца: фикстурные AGY_BRIDGE_BRAIN/AGY_BRIDGE_CONVERSATIONS/AGY_BRIDGE_AGY_BIN/фейковый AGY_LAUNCHER во временном каталоге раннера; процессные guard'ы сбрасываются хелпером между тестами\",\n142\t      \"owner\": \"Verifier\"\n143\t    },\n144\t    {\n145\t      \"id\": \"VER-004\",\n146\t      \"requirement_ids\": [\n147\t        \"REQ-010\",\n148\t        \"RISK-011\"\n149\t      ],\n150\t      \"kind\": \"command\",\n151\t      \"command\": \"set -e; B=\\\"$(mktemp -d)\\\"; H=\\\"$(mktemp)\\\"; S=\\\"$(mktemp)\\\"; git worktree add -q --detach \\\"$B/base\\\" e00da0621fc95f7c63cd1565f4a5d1fd490c8d66; uvx basedpyright@1.40.2 --outputjson bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py > \\\"$H\\\" || true; (cd \\\"$B/base\\\" && uvx basedpyright@1.40.2 --outputjson bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py > \\\"$S\\\" || true); git worktree remove --force \\\"$B/base\\\"; python3 -I - \\\"$H\\\" \\\"$S\\\" <<'PY'\\nimport json,sys,collections\\nh=json.load(open(sys.argv[1])); s=json.load(open(sys.argv[2]))\\ndef ms(x,sev): return collections.Counter((d['file'].rsplit('/',1)[-1],d.get('rule'),d['message']) for d in x['generalDiagnostics'] if d['severity']==sev)\\nerr=h['summary']['errorCount']; new_w=ms(h,'warning')-ms(s,'warning')\\nprint('version',h['version'],'errors',err,'warnings',h['summary']['warningCount'],'new_warnings',sum(new_w.values()))\\n[print('NEW',k) for k in sorted(new_w)]\\nsys.exit(0 if err==0 and not new_w and h['version'].startswith('1.40.2') else 1)\\nPY\",\n152\t      \"expected\": \"exit 0; строка «errors 0 … new_warnings 0»: errorCount кандидата == 0 на target-scope (порог Teamlead basedpyright_errors=0 сохранён; 12 baseline-ошибок EVD-060 в target-файлах (точный список и исправления — EVD-076) устраняются в этом MR типизацией без изменения поведения, inline-подавления `# pyright: ignore`/`# type: ignore` запрещены); 0 новых предупреждений — мультимножество (файл, правило, сообщение) предупреждений кандидата ⊆ baseline e00da06 на той же версии 1.40.2, поэтому новая диагностика ловится даже при неизменном общем числе\",\n153\t      \"environment\": \"Clean-room clone кандидата с доступным e00da0621fc95f7c63cd1565f4a5d1fd490c8d66, cwd=repo_root, basedpyright 1.40.2 строго (uvx basedpyright@1.40.2), pyrightconfig.json репозитория, python3 -I для сравнения; временный git worktree базы удаляется командой\",\n154\t      \"owner\": \"Verifier\"\n155\t    },\n156\t    {\n157\t      \"id\": \"VER-005\",\n158\t      \"requirement_ids\": [\n159\t        \"AD-001\",\n160\t        \"REQ-001\",\n161\t        \"REQ-002\",\n162\t        \"REQ-003\",\n163\t        \"REQ-004\",\n164\t        \"REQ-005\",\n165\t        \"REQ-006\",\n166\t        \"REQ-008\",\n167\t        \"REQ-009\",\n168\t        \"REQ-010\",\n169\t        \"RISK-002\",\n170\t        \"RISK-012\"\n171\t      ],\n172\t      \"kind\": \"command\",\n173\t      \"command\": \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. /usr/bin/python3 -B -m unittest discover -s tests -p \\\"test_*agy*.py\\\" && PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider tests/test_agy_bridge_resilience.py\",\n174\t      \"expected\": \"exit 0; unittest «OK» на боевом /usr/bin/python3 3.9.6 (SQLite 3.54.x) и pytest 0 failed — 0 падений в обоих прогонах (baseline EVD-074: Ran 22 tests OK); зелёный прогон только на Python 3.14 не засчитывается\",\n175\t      \"environment\": \"macOS /usr/bin/python3 3.9.6 (CommandLineTools) + pytest 9.0.3, cwd=repo_root, PYTHONDONTWRITEBYTECODE=1\",\n176\t      \"owner\": \"Verifier\"\n177\t    },\n178\t    {\n179\t      \"id\": \"VER-006\",\n180\t      \"requirement_ids\": [\n181\t        \"REQ-010\",\n182\t        \"QA-006\"\n183\t      ],\n184\t      \"kind\": \"command\",\n185\t      \"command\": \"test \\\"$(git diff --unified=0 e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- tests/test_agy_bridge_resilience.py | grep -cE '^-[^-]')\\\" = 0 && test -z \\\"$(git diff --name-only e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- tests/ core/ | grep -vx 'tests/test_agy_bridge_resilience.py')\\\" && echo OK\",\n186\t      \"expected\": \"exit 0 и «OK»: в tests/test_agy_bridge_resilience.py нет удалённых/изменённых строк относительно e00da06 (только добавления), другие файлы tests/ и core/ не изменены\",\n187\t      \"environment\": \"git clone кандидата с доступным base e00da0621fc95f7c63cd1565f4a5d1fd490c8d66, HEAD = коммит кандидата\",\n188\t      \"owner\": \"Teamlead\"\n189\t    },\n190\t    {\n191\t      \"id\": \"VER-007\",\n192\t      \"requirement_ids\": [\n193\t        \"AD-005\",\n194\t        \"REQ-001\",\n195\t        \"REQ-002\",\n196\t        \"REQ-003\",\n197\t        \"REQ-004\",\n198\t        \"REQ-005\",\n199\t        \"REQ-006\",\n200\t        \"REQ-007\",\n201\t        \"REQ-008\",\n202\t        \"REQ-009\",\n203\t        \"REQ-010\",\n204\t        \"REQ-011\",\n205\t        \"REQ-012\",\n206\t        \"THREAT-001\",\n207\t        \"THREAT-002\",\n208\t        \"THREAT-003\",\n209\t        \"THREAT-004\",\n210\t        \"THREAT-005\"\n211\t      ],\n212\t      \"kind\": \"command\",\n213\t      \"command\": \"python3 -I - <<'PY'\\nimport ast,re,sys,pathlib\\ns=pathlib.Path('tests/test_agy_bridge_resilience.py').read_text(encoding='utf-8')\\nt=ast.parse(s)\\nneed={'tc%02d'%i for i in list(range(1,13))+[20,21,23,24,30,31,32,33,40,41,42,43,44,50,51,60,61,62,63,70,71,72,80,81,82,91,92]}|{'ao%02d'%i for i in range(1,13)}\\ndef asserted(f):\\n    for n in ast.walk(f):\\n        if isinstance(n,ast.Assert): return True\\n        if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr.startswith('assert'): return True\\n    return False\\ngot=set(); noassert=[]\\nfor f in ast.walk(t):\\n    if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith('test_'):\\n        ids=set(re.findall(r'(tc\\\\d{2}|ao\\\\d{2})',f.name))&need\\n        if not ids: continue\\n        if asserted(f): got|=ids\\n        else: noassert.append(f.name)\\nmiss=sorted(need-got)\\nerrs=(['MISSING '+' '.join(miss)] if miss else [])+(['NO_ASSERT '+' '.join(sorted(noassert))] if noassert else [])\\nprint('; '.join(errs) if errs else 'OK %d ids, all asserted'%len(need)); sys.exit(1 if errs else 0)\\nPY\",\n214\t      \"expected\": \"exit 0; «OK 51 ids, all asserted»: имена тестовых функций покрывают TC-01..12, 20, 21, 23, 24, 30..33, 40..44, 50, 51, 60..63, 70..72, 80..82, 91, 92 и архитектурные оракулы AO-01..AO-12 (в имени test_..._tcNN / _aoNN, допускается несколько id в одном имени), и каждая тестовая функция с требуемым id содержит в AST ≥1 оператор assert или вызов *.assert*(...) (self.assertEqual, self.assertTrue, …); функция без проверок → FAIL «NO_ASSERT <имя>», непокрытый id → «MISSING <id>»\",\n215\t      \"environment\": \"cwd=repo_root, python3 -I\",\n216\t      \"owner\": \"Teamlead\"\n217\t    },\n218\t    {\n219\t      \"id\": \"VER-008\",\n220\t      \"requirement_ids\": [\n221\t        \"REQ-010\",\n222\t        \"RISK-011\",\n223\t        \"AD-006\"\n224\t      ],\n225\t      \"kind\": \"command\",\n226\t      \"command\": \"test \\\"$(git diff --name-only e00da0621fc95f7c63cd1565f4a5d1fd490c8d66 HEAD -- . ':(exclude).ai-team' ':(exclude)analysis' | sort | tr '\\\\n' ' ')\\\" = \\\"bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py \\\" && test -z \\\"$(git ls-files bridges/agy-bridge/dynamic_config.json)\\\" && printf '%s  %s\\\\n' 81dffc06ac79c490968e7efb8321f464d5963f414fcc6bd67a278a99d5985e32 analysis/agy-realtime-reasoning/research-plan.md e9c8afb2684a7621e9fdb0455640e86f972aab600989142119fb440397842ff1 analysis/agy-realtime-reasoning/evidence-ledger.md 47b16bab51b31bb06c35fb02d08dbd3409a9cfb057a52e828d079054a20d9202 analysis/agy-realtime-reasoning/open-questions.md cb1ecde9e00f06d72b75e43f973add3ab93ca27433d7145cbf8ec4f4800b17cd analysis/agy-realtime-reasoning/handoff-architect.md 5ed84fc039f7fea5983404442461e734ec9dae03f57359e2bb441dfae6cb7afe analysis/agy-realtime-reasoning/handoff-qa.md | shasum -a 256 -c --status - && echo OK\",\n227\t      \"expected\": \"exit 0 и «OK»: изменены ровно bridges/agy-bridge/server.py и tests/test_agy_bridge_resilience.py (вне .ai-team и analysis); bridges/agy-bridge/dynamic_config.json не в git; нет правок fleet.json/start.sh/ruff.toml/core/зависимостей; 5 замороженных входов аналитика analysis/agy-realtime-reasoning/{research-plan.md, evidence-ledger.md, open-questions.md, handoff-architect.md, handoff-qa.md} побайтово совпадают с sha256 EVD-077 (любое расхождение или отсутствие файла → exit ≠ 0)\",\n228\t      \"environment\": \"worktree кандидата (HEAD = коммит кандидата) с доступным base e00da06 и каталогом analysis/agy-realtime-reasoning/ (из коммита MR или рабочего worktree прогона), shasum (macOS)\",\n229\t      \"owner\": \"Teamlead\"\n230\t    },\n231\t    {\n232\t      \"id\": \"VER-009\",\n233\t      \"requirement_ids\": [\n234\t        \"AD-001\",\n235\t        \"AD-006\",\n236\t        \"BND-003\",\n237\t        \"REQ-002\",\n238\t        \"REQ-004\",\n239\t        \"REQ-011\",\n240\t        \"THREAT-003\"\n241\t      ],\n242\t      \"kind\": \"command\",\n243\t      \"command\": \"python3 -I - <<'PY'\\nimport ast,sys,pathlib\\nsrc=pathlib.Path('bridges/agy-bridge/server.py').read_text(encoding='utf-8')\\nt=ast.parse(src)\\nallowed={'__future__','hashlib','json','os','queue','re','select','shutil','signal','socket','subprocess','sys','threading','time','uuid','http','pathlib','typing','core','sqlite3','random'}\\nroots=set()\\nfor n in ast.walk(t):\\n    if isinstance(n,ast.Import):\\n        roots|={a.name.split('.')[0] for a in n.names}\\n    elif isinstance(n,ast.ImportFrom) and n.level==0:\\n        roots.add((n.module or '').split('.')[0])\\ncalls=[n for n in ast.walk(t) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='connect' and isinstance(n.func.value,ast.Name) and n.func.value.id=='sqlite3']\\nnouri=[c.lineno for c in calls if not any(k.arg=='uri' and isinstance(k.value,ast.Constant) and k.value.value is True for k in c.keywords)]\\nrw=[n.lineno for n in ast.walk(t) if isinstance(n,ast.Constant) and isinstance(n.value,str) and ('mode=rw' in n.value or 'immutable' in n.value)]\\nneed=[x for x in ('AGY_SQLITE_REASONING_ENABLED','SQLITE_REASONING_ENABLED','AGY_BRIDGE_CONVERSATIONS','mode=ro','query_only','busy_timeout') if x not in src]\\nerrs=[]\\nif sorted(roots-allowed): errs.append('non-stdlib imports %s'%sorted(roots-allowed))\\nif not calls: errs.append('no sqlite3.connect call')\\nif nouri: errs.append('sqlite3.connect without uri=True at %s'%nouri)\\nif rw: errs.append('write-mode or immutable URI literal at %s'%rw)\\nif 'immutable' in src: errs.append('substring immutable present in server.py')\\nif need: errs.append('missing %s'%need)\\nprint('FAIL: '+'; '.join(errs) if errs else 'OK'); sys.exit(1 if errs else 0)\\nPY\",\n244\t      \"expected\": \"exit 0 и «OK»: корни импортов ⊆ stdlib baseline ∪ {sqlite3, random}; каждый sqlite3.connect с uri=True; нет URI mode=rw/rwc и подстроки immutable нигде в server.py (F-007); присутствуют AGY_SQLITE_REASONING_ENABLED, SQLITE_REASONING_ENABLED, AGY_BRIDGE_CONVERSATIONS, mode=ro, query_only, busy_timeout\",\n245\t      \"environment\": \"cwd=repo_root, python3 -I (ast)\",\n246\t      \"owner\": \"Verifier\"\n247\t    },\n248\t    {\n249\t      \"id\": \"VER-010\",\n250\t      \"requirement_ids\": [\n251\t        \"QA-001\",\n252\t        \"QA-002\",\n253\t        \"QA-003\",\n254\t        \"QA-008\",\n255\t        \"QA-010\",\n256\t        \"QA-012\",\n257\t        \"REQ-001\",\n258\t        \"REQ-003\",\n259\t        \"REQ-005\",\n260\t        \"REQ-006\",\n261\t        \"REQ-007\",\n262\t        \"REQ-010\",\n263\t        \"REQ-012\",\n264\t        \"RISK-005\",\n265\t        \"RISK-006\",\n266\t        \"RISK-007\"\n267\t      ],\n268\t      \"kind\": \"command\",\n269\t      \"command\": \"PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider tests/test_agy_bridge_resilience.py -k \\\"tc93 or l2_harness\\\" && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. /usr/bin/python3 -B -m unittest discover -s tests -p \\\"test_agy_bridge_resilience.py\\\" -k tc93 -k l2_harness\",\n270\t      \"expected\": \"exit 0 в обоих прогонах; pytest выбрал ≥1 тест (0 выбранных → rc 5 = FAIL). Детерминированный L2-харнесс (test_..._tc93 и test_..._l2_harness): мост из кандидата в процессе теста с фейковым AGY_LAUNCHER (подпроцесс-писатель), фикстурами AGY_BRIDGE_BRAIN/AGY_BRIDGE_CONVERSATIONS/AGY_BRIDGE_AGY_BIN во временном каталоге и dynamic_config.json {\\\"SQLITE_REASONING_ENABLED\\\": true} рядом с server.py (env-форсирования нет); canary пройден прогревочным ходом; писатель многоходово обновляет WAL-БД 523→810→1088→1419→2156 байт. PASS только если одновременно: 8 параллельных ходов; RSS — resource.getrusage(RUSAGE_SELF).ru_maxrss (байты на macOS, KiB на Linux, нормализуется) ≤ 112 MiB; CPU — Δtime.process_time() / (Δwall · 8) ≤ 0.01 ядра на ход на минимальном SQLITE_POLL_S=0.5; задержка коммит снимка → сокет ≤ SQLITE_POLL_S + 0.5 с на каждом снимке; TC-20 ≥2 чанка до status=3; TC-60/TC-61 100/100; EOF→stop ≤0.65 с при дефолтах и ≤0.85 с при AGY_BRIDGE_TRANSCRIPT_GRACE=0.5, AGY_BRIDGE_DRAIN_JOIN=0.2, AGY_BRIDGE_DRAIN_MIN=0.25 (≤1.0 с гейт); kill-switch: запись false посреди хода → SELECT прекращаются и соединение закрыто ≤2.0 с (дизайн 1.30 с) при SQLITE_POLL_S 0.5 и 2.0; outcome=window_complete или complete в каждой строке drain; resumed-ход с внешним writer'ом — 0 переотданных шагов прошлых ходов, 0 SQLITE_CORRUPT/SQLITE_BUSY у писателя; 0 строк sqlite_snapshot_divergence; /health содержит 4 аддитивных поля; в stderr нет текста мышления фикстуры. Квитанция — вывод обеих команд в run_dir/teamlead/execution-evidence.md + evidence-manifest.sha256\",\n271\t      \"environment\": \"Clean-room worktree кандидата, cwd=repo_root, времен