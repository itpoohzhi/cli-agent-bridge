{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A3jft7dqm229dVDYUpoqbv","type":"tool_result","content":"     164 validate_role_plan.py\n     520 validate_handoff.py\n     684 total\n#!/usr/bin/env python3\n\"\"\"Проверка плана роли до и после её работы.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\n\nROLES = {\"explorer\", \"architect\", \"coder\", \"reviewer\", \"verifier\", \"summarizer\"}\nSTEP_KINDS = {\"inspect\", \"decide\", \"change\", \"verify\", \"report\"}\nBEFORE_STATUSES = {\"PENDING\", \"IN_PROGRESS\"}\nAFTER_STATUSES = {\"DONE\", \"BLOCKED\"}\nGENERIC_ACTIONS = {\n    \"выполнить задачу\",\n    \"изучить код\",\n    \"написать код\",\n    \"проанализировать задачу\",\n    \"проверить результат\",\n    \"запустить тесты\",\n    \"сделать работу\",\n}\nREQUIRED_KINDS = {\n    \"explorer\": {\"inspect\", \"report\"},\n    \"architect\": {\"inspect\", \"decide\", \"report\"},\n    \"coder\": {\"change\", \"verify\"},\n    \"reviewer\": {\"inspect\", \"report\"},\n    \"verifier\": {\"verify\", \"report\"},\n    \"summarizer\": {\"inspect\", \"report\"},\n}\n\n\nclass RolePlanError(ValueError):\n    \"\"\"Ошибка контракта ROLE PLAN.\"\"\"\n\n\ndef require_string(data: dict[str, Any], key: str, prefix: str = \"\") -> str:\n    value = data.get(key)\n    if not isinstance(value, str) or not value.strip():\n        raise RolePlanError(f\"{prefix}{key}: expected non-empty string\")\n    return value.strip()\n\n\ndef require_string_list(data: dict[str, Any], key: str) -> list[str]:\n    value = data.get(key)\n    if not isinstance(value, list) or not value:\n        raise RolePlanError(f\"{key}: expected non-empty array\")\n    if any(not isinstance(item, str) or not item.strip() for item in value):\n        raise RolePlanError(f\"{key}: every item must be a non-empty string\")\n    return value\n\n\ndef validate_step(step: dict[str, Any], index: int, role: str, phase: str) -> None:\n    prefix = f\"steps[{index}].\"\n    step_id = require_string(step, \"id\", prefix)\n    if step_id != f\"RP-{index + 1:02d}\":\n        raise RolePlanError(f\"{prefix}id: expected RP-{index + 1:02d}\")\n\n    kind = require_string(step, \"kind\", prefix)\n    if kind not in STEP_KINDS:\n        raise RolePlanError(f\"{prefix}kind: expected one of {sorted(STEP_KINDS)}\")\n\n    action = require_string(step, \"action\", prefix)\n    normalized_action = \" \".join(action.lower().rstrip(\".\").split())\n    if len(action) < 18 or normalized_action in GENERIC_ACTIONS:\n        raise RolePlanError(\n            f\"{prefix}action: too generic; name a target and observable result\"\n        )\n\n    evidence = require_string(step, \"expected_evidence\", prefix)\n    if len(evidence) < 8 or evidence.lower() in {\"результат\", \"evidence\", \"лог\"}:\n        raise RolePlanError(f\"{prefix}expected_evidence: too generic\")\n\n    if role == \"verifier\" and kind == \"verify\":\n        require_string(step, \"command\", prefix)\n\n    status = step.get(\"status\")\n    allowed_statuses = BEFORE_STATUSES if phase == \"before\" else AFTER_STATUSES\n    if status not in allowed_statuses:\n        raise RolePlanError(\n            f\"{prefix}status: expected one of {sorted(allowed_statuses)}\"\n        )\n\n    actual_evidence = step.get(\"actual_evidence\")\n    if phase == \"before\" and actual_evidence not in (None, \"\"):\n        raise RolePlanError(f\"{prefix}actual_evidence: must be empty before execution\")\n    if phase == \"after\":\n        if not isinstance(actual_evidence, str) or not actual_evidence.strip():\n            raise RolePlanError(f\"{prefix}actual_evidence: required for {status}\")\n\n\ndef validate_role_plan(data: dict[str, Any], phase: str) -> None:\n    if data.get(\"schema_version\") != \"1.0\":\n        raise RolePlanError(\"schema_version: expected '1.0'\")\n    require_string(data, \"run_id\")\n    role = require_string(data, \"role\")\n    if role not in ROLES:\n        raise RolePlanError(f\"role: expected one of {sorted(ROLES)}\")\n    iteration = data.get(\"iteration\")\n    if not isinstance(iteration, int) or isinstance(iteration, bool) or iteration < 1:\n        raise RolePlanError(\"iteration: expected integer >= 1\")\n    require_string(data, \"objective\")\n    require_string_list(data, \"inputs_read\")\n    require_string_list(data, \"stop_conditions\")\n\n    plan_kind = data.get(\"plan_kind\")\n    if plan_kind not in {\"full\", \"delta\"}:\n        raise RolePlanError(\"plan_kind: expected full or delta\")\n    if plan_kind == \"delta\":\n        require_string(data, \"parent_plan\")\n        require_string_list(data, \"trigger_ids\")\n\n    steps = data.get(\"steps\")\n    max_steps = 5 if plan_kind == \"delta\" else 7\n    if not isinstance(steps, list) or not 2 <= len(steps) <= max_steps:\n        raise RolePlanError(f\"steps: expected 2..{max_steps} items\")\n    for index, step in enumerate(steps):\n        if not isinstance(step, dict):\n            raise RolePlanError(f\"steps[{index}]: expected object\")\n        validate_step(step, index, role, phase)\n\n    kinds = {str(step.get(\"kind\")) for step in steps}\n    missing_kinds = REQUIRED_KINDS[role] - kinds\n    if missing_kinds:\n        raise RolePlanError(f\"steps: {role} plan misses kinds {sorted(missing_kinds)}\")\n\n    deviations = data.get(\"deviations\")\n    if not isinstance(deviations, list):\n        raise RolePlanError(\"deviations: expected array\")\n    if phase == \"before\" and deviations:\n        raise RolePlanError(\"deviations: must be empty before execution\")\n    if phase == \"after\" and any(\n        not isinstance(item, str) or not item.strip() for item in deviations\n    ):\n        raise RolePlanError(\"deviations: every item must be a non-empty string\")\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"plan\", type=Path)\n    parser.add_argument(\"--phase\", required=True, choices=(\"before\", \"after\"))\n    args = parser.parse_args()\n\n    try:\n        raw = args.plan.read_bytes()\n        data = json.loads(raw.decode(\"utf-8\"))\n        if not isinstance(data, dict):\n            raise RolePlanError(\"plan root must be an object\")\n        validate_role_plan(data, args.phase)\n    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RolePlanError) as exc:\n        print(f\"FAIL: {exc}\", file=sys.stderr)\n        return 1\n\n    digest = hashlib.sha256(raw).hexdigest()\n    print(f\"PASS: {data['role']} role plan is valid for {args.phase}; sha256={digest}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nShell cwd was reset to /Users/aazhiry1/tmp/cli-agent-bridge/agy-realtime-reasoning","is_error":false}]},"parent_tool_use_id":null,"session_id":"fe4f5eee-4845-48b4-bacd-c6e86d15ebd7","uuid":"a085f578-84dd-4645-ac7f-3b0da9f686c0","timestamp":"2026-10-29T08:10:48.065Z","tool_use_result":{"stdout":"     164 validate_role_plan.py\n     520 validate_handoff.py\n     684 total\n#!/usr/bin/env python3\n\"\"\"Проверка плана роли до и после её работы.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\n\nROLES = {\"explorer\", \"architect\", \"coder\", \"reviewer\", \"verifier\", \"summarizer\"}\nSTEP_KINDS = {\"inspect\", \"decide\", \"change\", \"verify\", \"report\"}\nBEFORE_STATUSES = {\"PENDING\", \"IN_PROGRESS\"}\nAFTER_STATUSES = {\"DONE\", \"BLOCKED\"}\nGENERIC_ACTIONS = {\n    \"выполнить задачу\",\n    \"изучить код\",\n    \"написать код\",\n    \"проанализировать задачу\",\n    \"проверить результат\",\n    \"запустить тесты\",\n    \"сделать работу\",\n}\nREQUIRED_KINDS = {\n    \"explorer\": {\"inspect\", \"report\"},\n    \"architect\": {\"inspect\", \"decide\", \"report\"},\n    \"coder\": {\