iry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py:1085:    def test_s1_data_ticks_before_done_preserve_content_and_tools(self) -> None:\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py:1086:        install_protocol_wrapper(self, {\"terminal\": \"completed\"}, delay=0.2)\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py:1087:        self.mod.KEEPALIVE_S = 0.05\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:218:    text = _redact_secrets(text)\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:219:    parts = _prompt_reflected_parts(prompt)\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:995:                err_thread.join(timeout=5)\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:1367:            err_thread.join(timeout=5)\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:1412:                err_thread.join(timeout=5)\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:1877:        diagnostic = _redact_secrets(str(out.get(\"err\") or \"\"))\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:1882:                reflected = _flatten_content(message.get(\"content\")).strip()\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:1890:                        diagnostic = diagnostic.replace(normalized[:160], \"[REDACTED]\")\n","exit_code":0,"status":"completed"}}
