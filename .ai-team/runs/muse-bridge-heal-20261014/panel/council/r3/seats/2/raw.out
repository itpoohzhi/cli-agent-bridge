{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1405,1630p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1740,2058p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py\"","aggregated_output":"                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n            if not stderr_joined:\n                err_thread.join(timeout=5)\n            self.close()\n\n\nclass Handler(BaseHTTPRequestHandler):\n    protocol_version = \"HTTP/1.1\"\n    timeout = 300\n\n    def log_message(self, format: str, *args: Any) -> None:\n        _log(\"http \" + (format % args))\n\n    def handle_error(self, request: Any, client_address: Any) -> None:\n        _log(f\"http accept error from {client_address}\")\n\n    # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n    _client_gone: bool = False\n    _current_run: Run | ServeRun | None = None\n    # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n    _sse_open: bool = False\n    _sse_id: str = \"\"\n    _sse_created: int = 0\n    _sse_model: str = \"\"\n    _wlock: threading.Lock = threading.Lock()\n    _sse_phase: str = \"OPEN\"\n    _keepalive_stop: threading.Event | None = None\n    _ka_thread: threading.Thread | None = None\n\n    def setup(self) -> None:\n        # Состояние обрыва клиента и ссылка на текущий ход — на каждое соединение.\n        self._client_gone = False\n        self._current_run = None\n        self._sse_open = False\n        self._sse_id = \"\"\n        self._sse_created = 0\n        self._sse_model = \"\"\n        self._wlock = threading.Lock()\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self._keepalive_stop: threading.Event | None = None\n        self._ka_thread: threading.Thread | None = None\n        super().setup()\n\n    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n        \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n        try:\n            with self._wlock:\n                if self._sse_phase == \"CLOSED\" or self._client_gone:\n                    return False\n                if keepalive and (\n                    self._sse_phase != \"OPEN\"\n                    or (\n                        self._keepalive_stop is not None\n                        and self._keepalive_stop.is_set()\n                    )\n                ):\n                    return False\n                try:\n                    self.wfile.write(text.encode(\"utf-8\"))\n                    self.wfile.flush()\n                finally:\n                    if text == \"data: [DONE]\\n\\n\":\n                        self._sse_phase = \"CLOSED\"\n            return True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            if not self._client_gone:\n                self._client_gone = True\n                _log(\"client gone mid-stream\")\n                self._kill_current_run()\n            return False\n\n    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n        return {\n            \"id\": self._sse_id,\n            \"object\": \"chat.completion.chunk\",\n            \"created\": self._sse_created,\n            \"model\": self._sse_model,\n            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n        }\n\n    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n        return self._sse_write(\n            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n        )\n\n    def _sse_begin(self, model: str) -> bool:\n        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n        self._sse_created = int(time.time())\n        self._sse_model = model\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self.close_connection = True\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"close\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            self.end_headers()\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before headers\")\n            return False\n        self._sse_open = True\n        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            return False\n        stop = threading.Event()\n        self._keepalive_stop = stop\n        self._ka_thread = threading.Thread(\n            target=self._keepalive_loop, args=(stop,), daemon=True\n        )\n        self._ka_thread.start()\n        return True\n\n    def _keepalive_loop(self, stop: threading.Event) -> None:\n        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n        while not stop.wait(KEEPALIVE_S):\n            if self._client_gone or stop.is_set():\n                return\n            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                return\n\n    def _sse_stop_keepalive(self) -> None:\n        if self._keepalive_stop is not None:\n            self._keepalive_stop.set()\n        with self._wlock:\n            if self._sse_phase == \"OPEN\":\n                self._sse_phase = \"FINALIZING\"\n        if self._ka_thread is not None:\n            self._ka_thread.join(timeout=2)\n        self._keepalive_stop = None\n        self._ka_thread = None\n\n    def _client_gone_probe(self) -> bool:\n        \"\"\"Обрыв клиента: FIN даёт пустой peek; ошибки сокета считаем обрывом.\n\n        Режим сокета (timeout/blocking) не меняется: сокет общий с _sse_write\n        в соседних потоках, смена режима из пробы ломала бы их запись. Peek идёт\n        флагом MSG_DONTWAIT; select(0) заранее отсекает случай «данных нет».\n        \"\"\"\n        conn = self.connection\n        if conn is None:\n            return False\n        try:\n            ready, _, _ = select.select([conn], [], [], 0)\n        except (OSError, ValueError):\n            return True\n        if not ready:\n            return False\n        try:\n            data = conn.recv(1, socket.MSG_PEEK | getattr(socket, \"MSG_DONTWAIT\", 0))\n        except (BlockingIOError, InterruptedError):\n            return False\n        except OSError:\n            return True\n        return data == b\"\"\n\n    def _kill_current_run(self) -> None:\n        \"\"\"Убить группу текущего хода: призраки не переживают обрыв клиента.\"\"\"\n        run = self._current_run\n        if run is not None:\n            run.close()\n\n    def _watch_client(self, stop: threading.Event) -> None:\n        \"\"\"Надзор за клиентом во время хода: обрыв -> флаг + killpg группы хода.\n\n        Не выходит после первого убийства: ход может зарегистрироваться (или запустить\n        процесс) уже после обрыва — kill идемпотентен и повторяется каждый тик до stop.\n        \"\"\"\n        reported = False\n        while not stop.wait(0.25):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                if not reported:\n                    reported = True\n                    _log(\"client gone during run — killing process group\")\n                self._kill_current_run()\n\n    def _send(self, code: int, payload: dict) -> None:\n        if self._sse_open:\n            # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n            self._sse_stop_keepalive()\n            error = payload.get(\"error\") if isinstance(payload, dict) else None\n            if isinstance(error, dict):\n                error = dict(error)\n                error.setdefault(\"code\", int(code))\n            self._sse_emit({\"error\": error or payload})\n            self._sse_write(\"data: [DONE]\\n\\n\")\n            return\n        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n        try:\n            self.send_response(int(code))\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before response\")\n            self._kill_current_run()\n\n    def _send_sse(\n        self,\n        model: str,\n        content: str,\n        tool_calls: list[dict],\n        prompt_tokens: int,\n        completion_tokens: int,\n        reasoning_tokens: int,\n        summaries: list[str] | None = None,\n    ) -> None:\n        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n\n        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n        \"\"\"\n        finish = \"tool_calls\" if tool_calls else \"stop\"\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n\n    def _serve_json(self, req: dict) -> None:\n        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n        if model not in ALLOWED_MODELS:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n                        \"type\": \"invalid_request_error\",\n                        \"code\": \"model_not_found\",\n                    }\n                },\n            )\n            return\n\n        raw_tools = req.get(\"tools\")\n        tools = (\n            [t for t in raw_tools if isinstance(t, dict)]\n            if isinstance(raw_tools, list)\n            else []\n        )\n        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        system_text, prompt = _messages_to_prompt(req.get(\"messages\") or [])\n        if not prompt:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n        head: list[str] = []\n        if system_text:\n            head.append(f\"[system]\\n{system_text}\")\n        if emulate_tools:\n            head.append(_tools_section(tools, tool_choice))\n        elif raw_tools and not system_text:\n            head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n        if head:\n            prompt = \"\\n\\n\".join(head) + f\"\\n\\n{prompt}\"\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        waited = time.monotonic()\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n                return\n            if time.monotonic() - waited > TIMEOUT_S:\n                self._send(\n                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n                )\n                return\n        if self._client_gone or self._client_gone_probe():\n            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n            self._client_gone = True\n            _log(\"client gone while waiting for a slot\")\n            _slots.release()\n            return\n        watch_stop = threading.Event()\n        watcher = threading.Thread(\n            target=self._watch_client, args=(watch_stop,), daemon=True\n        )\n        watcher.start()\n        runs: list = []\n        try:\n            # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n            # транспортной неполадке — тихий fallback на проверенный exec.\n            out: dict[str, Any] | None = None\n            via = \"exec\"\n            try:\n                serve_run = ServeRun(model, prompt, effort, WORKSPACE)\n                runs.append(serve_run)\n                self._current_run = serve_run\n                out = serve_run.execute()\n                via = \"serve\"\n            except ServeUnavailable as exc:\n                if self._client_gone:\n                    # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                    _log(\"client gone during serve — exec fallback skipped\")\n                    out = {\n                        \"rc\": -1,\n                        \"text\": \"\",\n                        \"err\": \"client gone\",\n                        \"state\": \"client_gone\",\n                    }\n                    via = \"aborted\"\n                else:\n                    _log(f\"serve unavailable ({exc}), fallback exec model={model}\")\n                    exec_run = Run(model, prompt, effort, WORKSPACE)\n                    runs.append(exec_run)\n                    self._current_run = exec_run\n                    out = exec_run.execute()\n                    via = \"exec-after-serve-fallback\"\n                    if (\n                        out.get(\"rc\") != 0\n                        and not self._client_gone\n                        and NETWORK_RETRY_MARKER in str(out.get(\"err\") or \"\")\n                    ):\n                        _log(\"exec hit network marker, single retry\")\n                        retry_run = Run(model, prompt, effort, WORKSPACE)\n                        runs.append(retry_run)\n                        self._current_run = retry_run\n                        out = retry_run.execute()\n                        via = \"exec-retry\"\n        finally:\n            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n            watch_stop.set()\n            watcher.join(timeout=2)\n            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n            # между Popen и собственным finally execute().\n            for run in runs:\n                run.close()\n            if all(run.dead_confirmed for run in runs):\n                _slots.release()\n            else:\n                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n\n        if self._client_gone:\n            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n            _log(\"client gone — response skipped\")\n            return\n        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n        out = dict(out)\n        diagnostic = _redact_secrets(str(out.get(\"err\") or \"\"))\n        if len(prompt.strip()) >= 8:\n            diagnostic = diagnostic.replace(prompt, \"[REDACTED]\")\n        for message in req.get(\"messages\") or []:\n            if isinstance(message, dict):\n                reflected = _flatten_content(message.get(\"content\")).strip()\n                if len(reflected) >= 8:\n                    diagnostic = diagnostic.replace(reflected, \"[REDACTED]\")\n                    normalized = re.sub(\n                        r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\", \" \", reflected\n                    )\n                    diagnostic = diagnostic.replace(normalized, \"[REDACTED]\")\n                    if len(normalized) >= 160:\n                        diagnostic = diagnostic.replace(normalized[:160], \"[REDACTED]\")\n        out[\"err\"] = _redact_secrets(diagnostic)\n        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(\n                            f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n                        ),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        content = out[\"text\"]\n        tool_calls: list[dict] = []\n        if emulate_tools and content:\n            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n        if not content and not tool_calls:\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(\n                _format_err_log(\n                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(\n                            f\"muse exec produced no text (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n                        ),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n\n        prompt_tokens = _estimate_tokens(prompt)\n        completion_tokens = _estimate_tokens(out[\"text\"])\n        # Serve даёт настоящие токены (session/tokenUsage); exec — оценку.\n        # tokenUsage serve не даёт promptTokens — фолбэк на оценку по каждому\n        # полю отдельно (раньше общий if занулял prompt при пустом поле).\n        ru = out.get(\"usage\") if isinstance(out.get(\"usage\"), dict) else {}\n        ru_prompt = ru.get(\"promptTokens\") or ru.get(\"prompt_tokens\") or 0\n        ru_output = ru.get(\"outputTokens\") or ru.get(\"output_tokens\") or 0\n        try:\n            ru_prompt = int(ru_prompt)\n        except (TypeError, ValueError):\n            ru_prompt = 0\n        try:\n            ru_output = int(ru_output)\n        except (TypeError, ValueError):\n            ru_output = 0\n        if ru_prompt > 0:\n            prompt_tokens = ru_prompt\n        if ru_output > 0:\n            completion_tokens = ru_output\n        ru_reasoning = ru.get(\"reasoningTokens\") or ru.get(\"reasoning_tokens\") or 0\n        try:\n            reasoning_tokens = int(ru_reasoning)\n        except (TypeError, ValueError):\n            reasoning_tokens = 0\n        if reasoning_tokens < 0:\n            reasoning_tokens = 0\n        raw_summaries = out.get(\"summaries\")\n        summaries: list[str] = (\n            [s for s in raw_summaries if isinstance(s, str)]\n            if isinstance(raw_summaries, list)\n            else []\n        )\n        sum_chars = sum(len(s) for s in summaries)\n        if summaries:\n            preview = next((s for s in summaries if s), \"\")[:300]\n            _log(\n                f\"reasoning summaries={len(summaries)} chars={sum_chars} \"\n                f\"reasoning_tokens={reasoning_tokens} preview={preview!r}\"\n            )\n        message: dict[str, Any] = {\"role\": \"assistant\", \"content\": content}\n        finish = \"stop\"\n        if tool_calls:\n            message[\"tool_calls\"] = tool_calls\n            finish = \"tool_calls\"\n        _log(\n            f\"done model={model} via={via} rc={out.get('rc')} state={out.get('state')} \"\n            f\"tools={len(tool_calls)} out_chars={len(out['text'])} \"\n            f\"stream={req.get('stream') is True}\"\n        )\n        if req.get(\"stream\") is True:\n            self._send_sse(\n                model,\n                content,\n                tool_calls,\n                prompt_tokens,\n                completion_tokens,\n                reasoning_tokens,\n                summaries,\n            )\n            return\n        self._send(\n            200,\n            {\n                \"id\": f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\",\n                \"object\": \"chat.completion\",\n                \"created\": int(time.time()),\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n                \"usage\": {\n                    \"prompt_tokens\": prompt_tokens,\n                    \"completion_tokens\": completion_tokens,\n                    \"total_tokens\": prompt_tokens + completion_tokens,\n                    \"reasoning_tokens\": reasoning_tokens,\n                },\n                \"reasoning_summaries\": summaries,\n            },\n        )\n\n\nclass Server(ThreadingHTTPServer):\n    daemon_threads = True\n    allow_reuse_address = True\n\n\ndef main() -> int:\n    if not AUTH_KEY:\n        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n        return 2\n    try:\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n    except OSError as exc:\n        _log(f\"workspace mkdir failed: {exc}\")\n    _log(\n        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n    )\n    server = Server((HOST, PORT), Handler)\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        server.server_close()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '175,310p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1080,1410p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py\"","aggregated_output":"\n\ndef _redact_secrets(text: str) -> str:\n    \"\"\"Удалить отражённые ключи до обрезки диагностики; повторный вызов безопасен.\"\"\"\n    if AUTH_KEY:\n        text = text.replace(AUTH_KEY, \"[REDACTED]\")\n    text = re.sub(\n        r\"Authorization\\s*:\\s*[^\\r\\n]+\",\n        \"Authorization: [REDACTED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    text = re.sub(r\"Bearer\\s+\\S+\", \"Bearer [REDACTED]\", text, flags=re.IGNORECASE)\n    text = re.sub(\n        r\"\"\"([\"']?(?:api[_-]?key|token|secret|password|bridge[_-]?key)[\"']?\\s*[:=]\\s*)(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^\\s,;}\"']+)\"\"\",\n        lambda match: match[1] + \"[REDACTED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    return re.sub(r\"sk-[A-Za-z0-9_-]{12,}\", \"[REDACTED]\", text)\n\n\ndef _clip_diagnostic(text: str, limit: int) -> str:\n    \"\"\"Ограничить поле, убрав его целиком при разрезании маркера редакции.\"\"\"\n    for marker in re.finditer(re.escape(\"[REDACTED]\"), text):\n        if marker.start() < limit < marker.end():\n            return \"\"\n    return text[:limit]\n\n\ndef _prompt_reflected_parts(prompt: str) -> list[str]:\n    \"\"\"Выделить длинные отражённые реплики, начиная с самых полных совпадений.\"\"\"\n    parts = {prompt} if len(prompt.strip()) >= 8 else set()\n    for part in prompt.split(\"\\n\\n\") + prompt.splitlines():\n        for candidate in (part, re.sub(r\"^(?:User|Assistant|System):\\s*\", \"\", part)):\n            if len(candidate.strip()) >= 8:\n                parts.add(candidate)\n    return sorted(parts, key=len, reverse=True)\n\n\ndef _diagnostic_text(value: Any, prompt: str = \"\") -> str:\n    \"\"\"Санитизировать свободное поле и нормализовать управляющие переводы строк.\"\"\"\n    text = str(value) if value is not None else \"\"\n    text = _redact_secrets(text)\n    parts = _prompt_reflected_parts(prompt)\n    for part in parts:\n        text = text.replace(part, \"[REDACTED]\")\n    control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n    text = re.sub(control_chars, \" \", text).strip()\n    for part in parts:\n        normalized = re.sub(control_chars, \" \", part).strip()\n        text = text.replace(normalized, \"[REDACTED]\")\n    return text\n\n\ndef _redact_quota(value: Any) -> Any:\n    \"\"\"Удалить значения чувствительных ключей quota до JSON-сериализации.\"\"\"\n    if isinstance(value, dict):\n        return {\n            key: \"[REDACTED]\"\n            if re.sub(r\"[_-]\", \"\", str(key)).lower()\n            in {\"token\", \"secret\", \"password\", \"apikey\", \"bridgekey\", \"authorization\"}\n            else _redact_quota(item)\n            for key, item in value.items()\n        }\n    if isinstance(value, list):\n        return [_redact_quota(item) for item in value]\n    if isinstance(value, str):\n        return _redact_secrets(value)\n    return value\n\n\ndef _turn_diagnostics(params: dict[str, Any], prompt: str) -> list[str]:\n    \"\"\"Собрать приоритетный блок MSP с покомпонентными лимитами и бюджетом 300.\"\"\"\n    error = params.get(\"error\")\n    kind = message = quota = retryable = \"\"\n    if isinstance(error, dict):\n        kind = _diagnostic_text(error.get(\"kind\"), prompt)\n        message = _diagnostic_text(error.get(\"message\"), prompt)\n        if isinstance(error.get(\"retryable\"), bool):\n            retryable = f\" retryable={error['retryable']}\"\n        if error.get(\"quota\") is not None:\n            try:\n                quota = json.dumps(\n                    _redact_quota(error[\"quota\"]),\n                    ensure_ascii=False,\n                    sort_keys=True,\n                    default=str,\n                    separators=(\",\", \":\"),\n                )\n            except (TypeError, ValueError, RecursionError):\n                quota = str(error[\"quota\"])\n            quota = _diagnostic_text(quota, prompt)\n    elif error is not None:\n        message = _diagnostic_text(error, prompt)\n    reason = _diagnostic_text(params.get(\"reason\"), prompt)\n    if reason == message:\n        reason = \"\"\n    fields = {\n        \"kind\": _clip_diagnostic(kind, 64),\n        \"message\": _clip_diagnostic(message, 160),\n        \"quota\": _clip_diagnostic(quota, 120),\n        \"reason\": _clip_diagnostic(reason, 160),\n    }\n\n    def lines() -> list[str]:\n        primary = \": \".join(fields[key] for key in (\"kind\", \"message\") if fields[key])\n        primary += retryable\n        if fields[\"quota\"]:\n            primary += \" quota=\" + fields[\"quota\"]\n        result = [primary.strip()] if primary.strip() else []\n        if fields[\"reason\"]:\n            result.append(\"reason: \" + fields[\"reason\"])\n        return result\n\n    for key in (\"quota\", \"reason\", \"message\", \"kind\"):\n        excess = len(\"\\n\".join(lines())) - 300\n        if excess <= 0:\n            break\n        minimum = min(16, len(fields[key])) if key == \"reason\" else 0\n        fields[key] = _clip_diagnostic(\n            fields[key], max(minimum, len(fields[key]) - excess)\n        )\n    return lines()\n\n\ndef _format_err_log(\n    model: str, via: str, out: dict[str, Any], stream: bool, state: str | None = None\n) -> str:\n    \"\"\"Единая однострочная запись финального отказа без промпта и секретов.\"\"\"\n    return (\n        f\"error model={model} via={via} rc={out.get('rc')} state={state or out.get('state')} \"\n        f\"err={_redact_secrets(str(out.get('err') or ''))[:300]!r} stream={stream}\"\n    )\n\n\n    ) -> int:\n        assert self.proc is not None and self.proc.stdin is not None\n        self._rid += 1\n        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n        if not notify:\n            msg[\"id\"] = self._rid\n        if params is not None:\n            msg[\"params\"] = params\n        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n        try:\n            fd = self.proc.stdin.fileno()\n            view = memoryview(data)\n            sent = 0\n            while sent < len(data):\n                remaining = self._write_until - time.time()\n                if remaining <= 0:\n                    raise ServeUnavailable(\n                        \"serve stdin write timed out: child does not read\"\n                    )\n                _, writable, _ = select.select([], [fd], [], min(0.5, remaining))\n                if not writable:\n                    continue\n                try:\n                    sent += os.write(fd, view[sent:])\n                except BlockingIOError:\n                    continue\n        except (OSError, ValueError) as exc:\n            raise ServeUnavailable(f\"stdio write failed: {exc}\")\n        return self._rid\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\"META_API_KEY\", None)\n        cmd = [\n            MUSE_WRAPPER,\n            \"serve\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--no-session-log\",\n            \"--trust-workspace\",\n            \"--disable-write\",\n            \"--disable-shell\",\n        ]\n        try:\n            self.proc = subprocess.Popen(\n                cmd,\n                cwd=str(self.workdir),\n                env=env,\n                stdin=subprocess.PIPE,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n                encoding=\"utf-8\",\n                errors=\"replace\",\n                bufsize=1,\n                start_new_session=True,\n            )\n        except OSError as exc:\n            raise ServeUnavailable(f\"serve spawn failed: {exc}\")\n        assert self.proc.stdout is not None and self.proc.stdin is not None\n        # stdin неблокирующий: запись идёт срезами с дедлайном (см. _send).\n        os.set_blocking(self.proc.stdin.fileno(), False)\n\n        err_lines: list[str] = []\n        turn_diag_lines: list[str] = []\n        stderr_joined = False\n\n        def drain_stderr() -> None:\n            try:\n                assert self.proc is not None and self.proc.stderr is not None\n                for line in self.proc.stderr:\n                    line = line.strip()\n                    if line:\n                        err_lines.append(line)\n            except (OSError, ValueError):\n                pass\n\n        err_thread = threading.Thread(target=drain_stderr, daemon=True)\n        err_thread.start()\n        deadline = time.time() + TIMEOUT_S\n        setup_deadline = time.time() + SERVE_SPAWN_TIMEOUT_S\n        self._write_until = setup_deadline\n\n        # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n        # уже вычитанные в буфер TextIOWrapper (пачка строк за один write зависала бы).\n        rbuf = bytearray()\n\n        def read_msg(timeout_at: float) -> dict[str, Any]:\n            while time.time() < min(timeout_at, deadline):\n                if self.proc is None or self.proc.stdout is None:\n                    raise ServeUnavailable(\"serve stdout closed\")\n                newline = rbuf.find(b\"\\n\")\n                if newline < 0:\n                    ready, _, _ = select.select([self.proc.stdout], [], [], 0.5)\n                    if not ready:\n                        if self.proc.poll() is not None:\n                            raise ServeUnavailable(\n                                f\"serve exited rc={self.proc.returncode}: \"\n                                + \" \".join(err_lines[-3:])\n                            )\n                        continue\n                    chunk = os.read(self.proc.stdout.fileno(), 65536)\n                    if not chunk:\n                        raise ServeUnavailable(\n                            f\"serve stdout EOF rc={self.proc.poll()}: \"\n                            + \" \".join(err_lines[-3:])\n                        )\n                    rbuf.extend(chunk)\n                    continue\n                line = bytes(rbuf[:newline]).decode(\"utf-8\", \"replace\").strip()\n                del rbuf[: newline + 1]\n                if not line:\n                    continue\n                try:\n                    msg = json.loads(line)\n                except ValueError:\n                    continue\n                if isinstance(msg, dict):\n                    return msg\n            raise ServeUnavailable(\"serve read timeout\")\n\n        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n            while True:\n                msg = read_msg(timeout_at)\n                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n                    if \"error\" in msg:\n                        raise ServeUnavailable(f\"serve RPC error: {msg['error']}\")\n                    result = msg.get(\"result\")\n                    return result if isinstance(result, dict) else {}\n                self._handle_event(msg, None)\n\n        kinds: dict[str, str] = {}\n        deltas: list[str] = []\n        summary_parts: dict[int, str] = {}\n        summaries: list[str] = []\n        final_text: str | None = None\n        usage: dict[str, Any] = {}\n        turn_id: str | None = None\n        session_id: str | None = None\n\n        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n            nonlocal final_text\n            method = msg.get(\"method\")\n            params = msg.get(\"params\") if isinstance(msg.get(\"params\"), dict) else {}\n            if method in (\"approval/request\", \"userInput/request\"):\n                raise ServeUnavailable(f\"serve needs interaction ({method})\")\n            if method in (\"item/started\", \"item/completed\"):\n                raw_item = params.get(\"item\")\n                item: dict[str, Any] = raw_item if isinstance(raw_item, dict) else {}\n                iid = str(item.get(\"itemId\") or \"\")\n                kind = str(item.get(\"kind\") or \"\")\n                if iid:\n                    kinds[iid] = kind\n                if (\n                    method == \"item/completed\"\n                    and turn_id is not None\n                    and item.get(\"turnId\") == turn_id\n                ):\n                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n                        final_text = item[\"text\"]\n                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n                        summaries.extend(\n                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n                        )\n            elif method == \"item/delta\":\n                iid = str(params.get(\"itemId\") or \"\")\n                field = str(params.get(\"field\") or \"text\")\n                piece = params.get(\"delta\")\n                if not isinstance(piece, str) or not piece:\n                    return\n                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n                    try:\n                        idx = int(field.split(\".\", 1)[1])\n                    except (IndexError, ValueError):\n                        idx = len(summary_parts)\n                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n                elif (\n                    kinds.get(iid, \"agentMessage\") == \"agentMessage\" and field == \"text\"\n                ):\n                    deltas.append(piece)\n            elif method == \"session/tokenUsage\":\n                raw = params.get(\"usage\")\n                if isinstance(raw, dict):\n                    usage.update(raw)\n\n        self._handle_event = _handle_event\n\n        try:\n            init_rid = self._send(\n                \"initialize\", {\"clientInfo\": {\"name\": \"muse_bridge\", \"version\": \"1\"}}\n            )\n            init = await_result(init_rid, setup_deadline)\n            schema = init.get(\"schema\") if isinstance(init.get(\"schema\"), dict) else {}\n            _log(\n                f\"serve init server={init.get('serverInfo', {}).get('version') if isinstance(init.get('serverInfo'), dict) else '?'} \"\n                f\"schema_fp={str(schema.get('fingerprint', ''))[:19]}\"\n            )\n            self._send(\"initialized\", {}, notify=True)\n            sess_rid = self._send(\n                \"session/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"workspaceRoot\": str(self.workdir),\n                    \"providerId\": \"meta\",\n                    \"modelId\": self.model_id,\n                },\n            )\n            # approvalMode намеренно НЕ передаём: любое явное значение\n            # (allowAll, onRequest) отвергается sealed startup ceiling\n            # неинтерактивного serve (commandRejected/approval_mode_ceiling),\n            # а без ключа сервер назначает свой дефолт (promptUnmatched — так\n            # было в офлайн-пробе на echo). Запрос approval/userInput по ходу\n            # хода ведёт в ServeUnavailable -> fallback на exec.\n            sess = await_result(sess_rid, setup_deadline)\n            session = (\n                sess.get(\"session\") if isinstance(sess.get(\"session\"), dict) else {}\n            )\n            session_id = str(session.get(\"sessionId\") or \"\")\n            if not session_id:\n                raise ServeUnavailable(\"session/start gave no sessionId\")\n            tier = _MSP_EFFORT.get(self.effort, \"max\")\n            turn_rid = self._send(\n                \"turn/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"sessionId\": session_id,\n                    \"reasoningEffort\": tier,\n                    \"input\": [{\"type\": \"text\", \"text\": self.prompt}],\n                },\n            )\n            turn = await_result(turn_rid, setup_deadline)\n            if turn.get(\"status\") != \"accepted\":\n                raise ServeUnavailable(f\"turn/start not accepted: {turn}\")\n            turn_id = str(turn.get(\"turnId\") or \"\")\n            _log(\n                f\"serve turn session={session_id[:8]} turn={turn_id[:8]} effort={tier}\"\n            )\n            terminal: str | None = None\n            while time.time() < deadline:\n                # Смерть serve здесь не проверяется: события и completed, уже лежащие в буфере\n                # чтения или pipe, разбираются первыми; read_msg сам поднимет ServeUnavailable\n                # на EOF/выходе процесса, когда разбирать больше нечего.\n                msg = read_msg(deadline)\n                if msg.get(\"method\") == \"turn/completed\" and isinstance(\n                    msg.get(\"params\"), dict\n                ):\n                    p = msg[\"params\"]\n                    if turn_id is not None and p.get(\"turnId\") not in (turn_id, None):\n                        _handle_event(msg, None)\n                        continue\n                    terminal = str(p.get(\"terminal\") or \"unknown\")\n                    if terminal != \"completed\":\n                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                    break\n                if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                    continue  # чужой/дублированный ack — игнор, не разрываем ход\n                _handle_event(msg, None)\n            else:\n                raise ServeUnavailable(\"serve turn deadline exceeded\")\n            serve_rc: int | None = None\n            if terminal == \"completed\":\n                # D-A3-1: после completed — тот же грейс, что у exec: serve вышел сам с rc != 0 ->\n                # ошибка; жив -> мост закрывает группу (сигнал моста rc не определяет).\n                try:\n                    self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                except subprocess.TimeoutExpired:\n                    pass\n                self.close()\n                serve_rc = self.proc.returncode\n            ordered = [\n                summary_parts[i] for i in sorted(summary_parts) if summary_parts[i]\n            ]\n            for part in ordered:\n                if part not in summaries:\n                    summaries.append(part)\n            text = final_text if final_text is not None else \"\".join(deltas)\n            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n            err_thread.join(timeout=5)\n            stderr_joined = True\n            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n            if self.prompt:\n                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n            err = \"\\n\".join(turn_diag_lines)\n            if err:\n                if stderr_tail:\n                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n            else:\n                err = stderr_tail\n            if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                return {\n                    \"rc\": serve_rc,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": \"nonzero_exit\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            if terminal != \"completed\":\n                return {\n                    \"rc\": 1,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": f\"terminal_{terminal}\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            return {\n                \"rc\": 0,\n                \"text\": text,\n                \"chunks\": [text] if text else [],\n                \"err\": err,\n                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1405,1630p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1740,2058p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1340,1410p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1405,1630p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1740,2058p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '1340,1410p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py\"","aggregated_output":"                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n            if not stderr_joined:\n                err_thread.join(timeout=5)\n            self.close()\n\n\nclass Handler(BaseHTTPRequestHandler):\n    protocol_version = \"HTTP/1.1\"\n    timeout = 300\n\n    def log_message(self, format: str, *args: Any) -> None:\n        _log(\"http \" + (format % args))\n\n    def handle_error(self, request: Any, client_address: Any) -> None:\n        _log(f\"http accept error from {client_address}\")\n\n    # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n    _client_gone: bool = False\n    _current_run: Run | ServeRun | None = None\n    # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n    _sse_open: bool = False\n    _sse_id: str = \"\"\n    _sse_created: int = 0\n    _sse_model: str = \"\"\n    _wlock: threading.Lock = threading.Lock()\n    _sse_phase: str = \"OPEN\"\n    _keepalive_stop: threading.Event | None = None\n    _ka_thread: threading.Thread | None = None\n\n    def setup(self) -> None:\n        # Состояние обрыва клиента и ссылка на текущий ход — на каждое соединение.\n        self._client_gone = False\n        self._current_run = None\n        self._sse_open = False\n        self._sse_id = \"\"\n        self._sse_created = 0\n        self._sse_model = \"\"\n        self._wlock = threading.Lock()\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self._keepalive_stop: threading.Event | None = None\n        self._ka_thread: threading.Thread | None = None\n        super().setup()\n\n    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n        \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n        try:\n            with self._wlock:\n                if self._sse_phase == \"CLOSED\" or self._client_gone:\n                    return False\n                if keepalive and (\n                    self._sse_phase != \"OPEN\"\n                    or (\n                        self._keepalive_stop is not None\n                        and self._keepalive_stop.is_set()\n                    )\n                ):\n                    return False\n                try:\n                    self.wfile.write(text.encode(\"utf-8\"))\n                    self.wfile.flush()\n                finally:\n                    if text == \"data: [DONE]\\n\\n\":\n                        self._sse_phase = \"CLOSED\"\n            return True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            if not self._client_gone:\n                self._client_gone = True\n                _log(\"client gone mid-stream\")\n                self._kill_current_run()\n            return False\n\n    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n        return {\n            \"id\": self._sse_id,\n            \"object\": \"chat.completion.chunk\",\n            \"created\": self._sse_created,\n            \"model\": self._sse_model,\n            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n        }\n\n    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n        return self._sse_write(\n            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n        )\n\n    def _sse_begin(self, model: str) -> bool:\n        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n        self._sse_created = int(time.time())\n        self._sse_model = model\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self.close_connection = True\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"close\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            self.end_headers()\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before headers\")\n            return False\n        self._sse_open = True\n        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            return False\n        stop = threading.Event()\n        self._keepalive_stop = stop\n        self._ka_thread = threading.Thread(\n            target=self._keepalive_loop, args=(stop,), daemon=True\n        )\n        self._ka_thread.start()\n        return True\n\n    def _keepalive_loop(self, stop: threading.Event) -> None:\n        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n        while not stop.wait(KEEPALIVE_S):\n            if self._client_gone or stop.is_set():\n                return\n            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                return\n\n    def _sse_stop_keepalive(self) -> None:\n        if self._keepalive_stop is not None:\n            self._keepalive_stop.set()\n        with self._wlock:\n            if self._sse_phase == \"OPEN\":\n                self._sse_phase = \"FINALIZING\"\n        if self._ka_thread is not None:\n            self._ka_thread.join(timeout=2)\n        self._keepalive_stop = None\n        self._ka_thread = None\n\n    def _client_gone_probe(self) -> bool:\n        \"\"\"Обрыв клиента: FIN даёт пустой peek; ошибки сокета считаем обрывом.\n\n        Режим сокета (timeout/blocking) не меняется: сокет общий с _sse_write\n        в соседних потоках, смена режима из пробы ломала бы их запись. Peek идёт\n        флагом MSG_DONTWAIT; select(0) заранее отсекает случай «данных нет».\n        \"\"\"\n        conn = self.connection\n        if conn is None:\n            return False\n        try:\n            ready, _, _ = select.select([conn], [], [], 0)\n        except (OSError, ValueError):\n            return True\n        if not ready:\n            return False\n        try:\n            data = conn.recv(1, socket.MSG_PEEK | getattr(socket, \"MSG_DONTWAIT\", 0))\n        except (BlockingIOError, InterruptedError):\n            return False\n        except OSError:\n            return True\n        return data == b\"\"\n\n    def _kill_current_run(self) -> None:\n        \"\"\"Убить группу текущего хода: призраки не переживают обрыв клиента.\"\"\"\n        run = self._current_run\n        if run is not None:\n            run.close()\n\n    def _watch_client(self, stop: threading.Event) -> None:\n        \"\"\"Надзор за клиентом во время хода: обрыв -> флаг + killpg группы хода.\n\n        Не выходит после первого убийства: ход может зарегистрироваться (или запустить\n        процесс) уже после обрыва — kill идемпотентен и повторяется каждый тик до stop.\n        \"\"\"\n        reported = False\n        while not stop.wait(0.25):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                if not reported:\n                    reported = True\n                    _log(\"client gone during run — killing process group\")\n                self._kill_current_run()\n\n    def _send(self, code: int, payload: dict) -> None:\n        if self._sse_open:\n            # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n            self._sse_stop_keepalive()\n            error = payload.get(\"error\") if isinstance(payload, dict) else None\n            if isinstance(error, dict):\n                error = dict(error)\n                error.setdefault(\"code\", int(code))\n            self._sse_emit({\"error\": error or payload})\n            self._sse_write(\"data: [DONE]\\n\\n\")\n            return\n        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n        try:\n            self.send_response(int(code))\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before response\")\n            self._kill_current_run()\n\n    def _send_sse(\n        self,\n        model: str,\n        content: str,\n        tool_calls: list[dict],\n        prompt_tokens: int,\n        completion_tokens: int,\n        reasoning_tokens: int,\n        summaries: list[str] | None = None,\n    ) -> None:\n        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n\n        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n        \"\"\"\n        finish = \"tool_calls\" if tool_calls else \"stop\"\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n\n    def _serve_json(self, req: dict) -> None:\n        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n        if model not in ALLOWED_MODELS:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n                        \"type\": \"invalid_request_error\",\n                        \"code\": \"model_not_found\",\n                    }\n                },\n            )\n            return\n\n        raw_tools = req.get(\"tools\")\n        tools = (\n            [t for t in raw_tools if isinstance(t, dict)]\n            if isinstance(raw_tools, list)\n            else []\n        )\n        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        system_text, prompt = _messages_to_prompt(req.get(\"messages\") or [])\n        if not prompt:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n        head: list[str] = []\n        if system_text:\n            head.append(f\"[system]\\n{system_text}\")\n        if emulate_tools:\n            head.append(_tools_section(tools, tool_choice))\n        elif raw_tools and not system_text:\n            head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n        if head:\n            prompt = \"\\n\\n\".join(head) + f\"\\n\\n{prompt}\"\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        waited = time.monotonic()\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n                return\n            if time.monotonic() - waited > TIMEOUT_S:\n                self._send(\n                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n                )\n                return\n        if self._client_gone or self._client_gone_probe():\n            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n            self._client_gone = True\n            _log(\"client gone while waiting for a slot\")\n            _slots.release()\n            return\n        watch_stop = threading.Event()\n        watcher = threading.Thread(\n            target=self._watch_client, args=(watch_stop,), daemon=True\n        )\n        watcher.start()\n        runs: list = []\n        try:\n            # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n            # транспортной неполадке — тихий fallback на проверенный exec.\n            out: dict[str, Any] | None = None\n            via = \"exec\"\n            try:\n                serve_run = ServeRun(model, prompt, effort, WORKSPACE)\n                runs.append(serve_run)\n                self._current_run = serve_run\n                out = serve_run.execute()\n                via = \"serve\"\n            except ServeUnavailable as exc:\n                if self._client_gone:\n                    # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                    _log(\"client gone during serve — exec fallback skipped\")\n                    out = {\n                        \"rc\": -1,\n                        \"text\": \"\",\n                        \"err\": \"client gone\",\n                        \"state\": \"client_gone\",\n                    }\n                    via = \"aborted\"\n                else:\n                    _log(f\"serve unavailable ({exc}), fallback exec model={model}\")\n                    exec_run = Run(model, prompt, effort, WORKSPACE)\n                    runs.append(exec_run)\n                    self._current_run = exec_run\n                    out = exec_run.execute()\n                    via = \"exec-after-serve-fallback\"\n                    if (\n                        out.get(\"rc\") != 0\n                        and not self._client_gone\n                        and NETWORK_RETRY_MARKER in str(out.get(\"err\") or \"\")\n                    ):\n                        _log(\"exec hit network marker, single retry\")\n                        retry_run = Run(model, prompt, effort, WORKSPACE)\n                        runs.append(retry_run)\n                        self._current_run = retry_run\n                        out = retry_run.execute()\n                        via = \"exec-retry\"\n        finally:\n            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n            watch_stop.set()\n            watcher.join(timeout=2)\n            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n            # между Popen и собственным finally execute().\n            for run in runs:\n                run.close()\n            if all(run.dead_confirmed for run in runs):\n                _slots.release()\n            else:\n                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n\n        if self._client_gone:\n            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n            _log(\"client gone — response skipped\")\n            return\n        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n        out = dict(out)\n        diagnostic = _redact_secrets(str(out.get(\"err\") or \"\"))\n        if len(prompt.strip()) >= 8:\n            diagnostic = diagnostic.replace(prompt, \"[REDACTED]\")\n        for message in req.get(\"messages\") or []:\n            if isinstance(message, dict):\n                reflected = _flatten_content(message.get(\"content\")).strip()\n                if len(reflected) >= 8:\n                    diagnostic = diagnostic.replace(reflected, \"[REDACTED]\")\n                    normalized = re.sub(\n                        r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\", \" \", reflected\n                    )\n                    diagnostic = diagnostic.replace(normalized, \"[REDACTED]\")\n                    if len(normalized) >= 160:\n                        diagnostic = diagnostic.replace(normalized[:160], \"[REDACTED]\")\n        out[\"err\"] = _redact_secrets(diagnostic)\n        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(\n                            f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n                        ),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        content = out[\"text\"]\n        tool_calls: list[dict] = []\n        if emulate_tools and content:\n            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n        if not content and not tool_calls:\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(\n                _format_err_log(\n                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(\n                            f\"muse exec produced no text (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n                        ),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n\n        prompt_tokens = _estimate_tokens(prompt)\n        completion_tokens = _estimate_tokens(out[\"text\"])\n        # Serve даёт настоящие токены (session/tokenUsage); exec — оценку.\n        # tokenUsage serve не даёт promptTokens — фолбэк на оценку по каждому\n        # полю отдельно (раньше общий if занулял prompt при пустом поле).\n        ru = out.get(\"usage\") if isinstance(out.get(\"usage\"), dict) else {}\n        ru_prompt = ru.get(\"promptTokens\") or ru.get(\"prompt_tokens\") or 0\n        ru_output = ru.get(\"outputTokens\") or ru.get(\"output_tokens\") or 0\n        try:\n            ru_prompt = int(ru_prompt)\n        except (TypeError, ValueError):\n            ru_prompt = 0\n        try:\n            ru_output = int(ru_output)\n        except (TypeError, ValueError):\n            ru_output = 0\n        if ru_prompt > 0:\n            prompt_tokens = ru_prompt\n        if ru_output > 0:\n            completion_tokens = ru_output\n        ru_reasoning = ru.get(\"reasoningTokens\") or ru.get(\"reasoning_tokens\") or 0\n        try:\n            reasoning_tokens = int(ru_reasoning)\n        except (TypeError, ValueError):\n            reasoning_tokens = 0\n        if reasoning_tokens < 0:\n            reasoning_tokens = 0\n        raw_summaries = out.get(\"summaries\")\n        summaries: list[str] = (\n            [s for s in raw_summaries if isinstance(s, str)]\n            if isinstance(raw_summaries, list)\n            else []\n        )\n        sum_chars = sum(len(s) for s in summaries)\n        if summaries:\n            preview = next((s for s in summaries if s), \"\")[:300]\n            _log(\n                f\"reasoning summaries={len(summaries)} chars={sum_chars} \"\n                f\"reasoning_tokens={reasoning_tokens} preview={preview!r}\"\n            )\n        message: dict[str, Any] = {\"role\": \"assistant\", \"content\": content}\n        finish = \"stop\"\n        if tool_calls:\n            message[\"tool_calls\"] = tool_calls\n            finish = \"tool_calls\"\n        _log(\n            f\"done model={model} via={via} rc={out.get('rc')} state={out.get('state')} \"\n            f\"tools={len(tool_calls)} out_chars={len(out['text'])} \"\n            f\"stream={req.get('stream') is True}\"\n        )\n        if req.get(\"stream\") is True:\n            self._send_sse(\n                model,\n                content,\n                tool_calls,\n                prompt_tokens,\n                completion_tokens,\n                reasoning_tokens,\n                summaries,\n            )\n            return\n        self._send(\n            200,\n            {\n                \"id\": f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\",\n                \"object\": \"chat.completion\",\n                \"created\": int(time.time()),\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n                \"usage\": {\n                    \"prompt_tokens\": prompt_tokens,\n                    \"completion_tokens\": completion_tokens,\n                    \"total_tokens\": prompt_tokens + completion_tokens,\n                    \"reasoning_tokens\": reasoning_tokens,\n                },\n                \"reasoning_summaries\": summaries,\n            },\n        )\n\n\nclass Server(ThreadingHTTPServer):\n    daemon_threads = True\n    allow_reuse_address = True\n\n\ndef main() -> int:\n    if not AUTH_KEY:\n        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n        return 2\n    try:\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n    except OSError as exc:\n        _log(f\"workspace mkdir failed: {exc}\")\n    _log(\n        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n    )\n    server = Server((HOST, PORT), Handler)\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        server.server_close()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n                    if terminal != \"completed\":\n                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                    break\n                if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                    continue  # чужой/дублированный ack — игнор, не разрываем ход\n                _handle_event(msg, None)\n            else:\n                raise ServeUnavailable(\"serve turn deadline exceeded\")\n            serve_rc: int | None = None\n            if terminal == \"completed\":\n                # D-A3-1: после completed — тот же грейс, что у exec: serve вышел сам с rc != 0 ->\n                # ошибка; жив -> мост закрывает группу (сигнал моста rc не определяет).\n                try:\n                    self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                except subprocess.TimeoutExpired:\n                    pass\n                self.close()\n                serve_rc = self.proc.returncode\n            ordered = [\n                summary_parts[i] for i in sorted(summary_parts) if summary_parts[i]\n            ]\n            for part in ordered:\n                if part not in summaries:\n                    summaries.append(part)\n            text = final_text if final_text is not None else \"\".join(deltas)\n            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n            err_thread.join(timeout=5)\n            stderr_joined = True\n            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n            if self.prompt:\n                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n            err = \"\\n\".join(turn_diag_lines)\n            if err:\n                if stderr_tail:\n                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n            else:\n                err = stderr_tail\n            if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                return {\n                    \"rc\": serve_rc,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": \"nonzero_exit\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            if terminal != \"completed\":\n                return {\n                    \"rc\": 1,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": f\"terminal_{terminal}\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            return {\n                \"rc\": 0,\n                \"text\": text,\n                \"chunks\": [text] if text else [],\n                \"err\": err,\n                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"Хеши пакета, кода и тестов совпали с заявленными. Запечатывание SSE использует один замок для проверки фазы и записи; новые регрессии покрывают оба примера из R2. Проверяю сочетание отражённой реплики с секретом и границы обрезки диагностики.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,135p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py; sed -n '180,281p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py; sed -n '641,880p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,135p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py; sed -n '180,281p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py; sed -n '641,880p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py\"","aggregated_output":"\"\"\"Regression-тесты утечки слотов muse-bridge: killpg группы и обрыв клиента.\n\n2026-10-09: close() Run/ServeRun бил только прямого ребёнка (proc.kill),\nsleep-«внук» в группе хода выживал; обрыв клиента во время exec/serve ход не\nпрерывал — слот держался всю длительность прогона (до TIMEOUT_S), /health\nпоказывал active=1. Тесты гоняют зеркальную копию моста\nbridges/muse-bridge/server.py без живого muse-bin: вместо CLI — фейк-обёртка\nна sh (serve сразу rc=42 → безусловный fallback на exec, exec держит ход:\nлидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\nкоторый проходит handshake и держит turn/start без завершения.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport http.client\nimport io\nimport itertools\nimport json\nimport os\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any, Callable\nfrom unittest import mock\n\nBRIDGE_PY = (\n    Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n)\n\n_LOAD_SEQ = itertools.count()\nDISCONNECT_AFTER_S = 1.0\nSCENARIO_DEADLINE_S = 5.0\nGROUP_EXIT_WAIT_S = 5.0\n\n# Фейк muse-cli.sh: транспорт serve «недоступен» (мост уходит в fallback exec),\n# exec пишет pid лидера группы и держит ход 30 с.\nFAKE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exit 42\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Фейк muse-cli.sh для serve-хода: serve принимает turn/start и держит ход (без\n# turn/completed), exec-fallback отмечается отдельным pid-файлом — его появление\n# означает, что сценарий serve не удался.\nSERVE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exec \"{python}\" \"{script}\" \"{servepid}\"\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Python-скрипт serve: handshake по NDJSON JSON-RPC, после turn/start — «внук» sleep\n# в той же группе и pid-файл лидера (сигнал «serve удерживает ход»), дальше тишина.\nFAKE_SERVE_SCRIPT = \"\"\"import json, os, subprocess, sys, time\n\npidfile = sys.argv[1]\nRESULTS = {\n    \"session/start\": {\"session\": {\"sessionId\": \"sess-1\"}},\n    \"turn/start\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"},\n}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    rid = msg.get(\"id\")\n    if rid is None:\n        continue\n    reply = {\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": RESULTS.get(msg[\"method\"], {})}\n    sys.stdout.write(json.dumps(reply) + \"\\\\n\")\n    sys.stdout.flush()\n    if msg[\"method\"] == \"turn/start\":\n        subprocess.Popen([\"sleep\", \"30\"])\n        with open(pidfile, \"w\") as fh:\n            fh.write(str(os.getpid()))\n        while True:\n            time.sleep(1)\n\"\"\"\n\n\ndef load_bridge() -> Any:\n    \"\"\"Свежий экземпляр модуля моста: изолированные _slots/_active на каждый тест.\"\"\"\n    spec = importlib.util.spec_from_file_location(\n        f\"muse_bridge_server_{next(_LOAD_SEQ)}\", BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (сигнал 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef wait_until(predicate: Callable[[], bool], timeout: float) -> bool:\n    \"\"\"Опрос predicate каждые 50 мс до timeout (замер и на последней границе).\"\"\"\n    deadline = time.monotonic() + timeout\n    while True:\n        if predicate():\n            return True\n        if time.monotonic() >= deadline:\n            return predicate()\n        time.sleep(0.05)\n\n\n\nclass _BridgeScenario(unittest.TestCase):\n    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n\n    # Значения инициализируются в setUp() каждого теста.\n    tmp: Path = Path()\n    mod: Any = None\n    pidfile: Path = Path()\n    servepid: Path = Path()\n    server: Any = None\n\n    def wrapper_text(self) -> str:\n        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n\n    def setUp(self) -> None:\n        self.tmp = Path(tempfile.mkdtemp(prefix=\"muse-bridge-killpg-\"))\n        self.addCleanup(shutil.rmtree, str(self.tmp), True)\n        self.mod = load_bridge()\n        # Работаем только во временном каталоге: workspace и лог моста — не в репо.\n        self.mod.WORKSPACE = self.tmp / \"workspace\"\n        self.mod.LOG_PATH = self.tmp / \"bridge.log\"\n        # Один слот: при двух утечка одного не видна неблокирующей пробой семафора.\n        self.mod._slots = threading.Semaphore(1)\n        self.pidfile = self.tmp / \"run.pid\"\n        self.servepid = self.tmp / \"serve.pid\"\n        wrapper = self.tmp / \"muse-cli.sh\"\n        wrapper.write_text(self.wrapper_text(), encoding=\"utf-8\")\n        wrapper.chmod(0o755)\n        self.mod.MUSE_WRAPPER = str(wrapper)\n        self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n        threading.Thread(target=self.server.serve_forever, daemon=True).start()\n        self.addCleanup(self._teardown_scenario)\n\n    def _teardown_scenario(self) -> None:\n        \"\"\"Стоп сервера + добивание своих мок-групп (только свои PGID).\"\"\"\n        self.server.shutdown()\n        self.server.server_close()\n        for pidfile in (self.pidfile, self.servepid):\n            if pidfile.exists():\n                try:\n                    os.killpg(\n                        int(pidfile.read_text(encoding=\"utf-8\").strip()),\n                        signal.SIGKILL,\n                    )\n                except (ProcessLookupError, OSError, ValueError):\n                    pass\n\n    def _open_request(self) -> socket.socket:\n        \"\"\"POST /v1/chat/completions; соединение остаётся открытым (закрывает вызывающий).\"\"\"\n        body = json.dumps(\n            {\n                \"model\": \"muse-spark-1.3\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}],\n            }\n        ).encode(\"utf-8\")\n        head = (\n            \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n            \"Host: 127.0.0.1\\r\\n\"\n            \"Content-Type: application/json\\r\\n\"\n            f\"Content-Length: {len(body)}\\r\\n\"\n            \"Connection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n        sock.sendall(head + body)\n        return sock\n\n    def _post_request_disconnect(self) -> None:\n        \"\"\"POST /v1/chat/completions и обрыв соединения через DISCONNECT_AFTER_S.\"\"\"\n        sock = self._open_request()\n        try:\n            time.sleep(DISCONNECT_AFTER_S)\n        finally:\n            sock.close()\n\n    def _slot_free(self) -> bool:\n        \"\"\"Неблокирующая проба семафора слотов (сразу возвращаем взятую ячейку).\"\"\"\n        sem = self.mod._slots\n        if sem.acquire(blocking=False):\n            sem.release()\n            return True\n        return False\n\n    def _health_json(self) -> dict[str, Any]:\n        \"\"\"Тело ответа GET /health.\"\"\"\n        head = (\n            \"GET /health HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        with socket.create_connection(\n            self.server.server_address[:2], timeout=5\n        ) as sock:\n            sock.sendall(head)\n            chunks = []\n            while True:\n                chunk = sock.recv(65536)\n                if not chunk:\n                    break\n                chunks.append(chunk)\n        body = b\"\".join(chunks).split(b\"\\r\\n\\r\\n\", 1)[1]\n        return json.loads(body.decode(\"utf-8\"))\n\n\n\ndef bridge_request(\n    scenario: Any, payload: dict | None = None, path: str = \"/v1/chat/completions\"\n) -> tuple[int, bytes]:\n    \"\"\"Прочитать полный ответ локального стенда, включая терминальный SSE-кадр.\"\"\"\n    conn = http.client.HTTPConnection(*scenario.server.server_address[:2], timeout=5)\n    try:\n        conn.request(\n            \"POST\" if payload is not None else \"GET\",\n            path,\n            json.dumps(payload) if payload is not None else None,\n            {\"Content-Type\": \"application/json\", \"Connection\": \"close\"},\n        )\n        response = conn.getresponse()\n        return response.status, response.read()\n    finally:\n        conn.close()\n\n\ndef turn_request(stream: bool = False) -> dict:\n    \"\"\"Минимальный клиентский запрос без живого провайдера.\"\"\"\n    return {\n        \"model\": \"muse-spark-1.3\",\n        \"messages\": [{\"role\": \"user\", \"content\": \"prompt-canary-private\"}],\n        \"stream\": stream,\n    }\n\n\nclass ErrorLoggingTest(_BridgeScenario):\n    \"\"\"AD-001/F-001: все выходы журналируются и не раскрывают отражённые секреты.\"\"\"\n\n    def _error_response(\n        self, state: str, err: Any, stream: bool = False, rc: int = 1\n    ) -> tuple[dict, str]:\n        out = {\"rc\": rc, \"state\": state, \"text\": \"\", \"err\": err}\n        with mock.patch.object(self.mod.ServeRun, \"execute\", return_value=out):\n            status, body = bridge_request(self, turn_request(stream))\n        self.assertEqual(status, 200 if stream else 502)\n        if stream:\n            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n            frames = [\n                json.loads(line[6:])\n                for line in body.decode().splitlines()\n                if line.startswith(\"data: {\")\n            ]\n            error = next(frame[\"error\"] for frame in frames if \"error\" in frame)\n        else:\n            error = json.loads(body)[\"error\"]\n        logs = self.mod.LOG_PATH.read_text()\n        lines = [line for line in logs.splitlines() if \" error model=\" in line]\n        self.assertTrue(lines, \"нет итогового error-лога\")\n        return error, lines[-1]\n\n    def test_all_error_branches_log_once_and_success_stays_done(self) -> None:\n        for stream in (False, True):\n            for state in (\"launcher_missing\", \"spawn_failed\", \"terminal_failed\", \"ok\"):\n                with self.subTest(stream=stream, state=state):\n                    self.mod.LOG_PATH.unlink(missing_ok=True)\n                    error, line = self._error_response(\n                        state, \"line1\\nline2\", stream, 0 if state == \"ok\" else 1\n                    )\n                    self.assertIn(\n                        \"state=\" + (\"empty_output\" if state == \"ok\" else state), line\n                    )\n                    self.assertIn(\"via=serve\", line)\n                    self.assertIn(f\"stream={stream}\", line)\n                    self.assertIn(\"line1\\\\nline2\", line)\n                    self.assertEqual(error[\"detail\"], \"line1\\nline2\")\n                    self.assertEqual(\n                        sum(\n                            \" error model=\" in x\n                            for x in self.mod.LOG_PATH.read_text().splitlines()\n                        ),\n                        1,\n                    )\n        with mock.patch.object(\n            self.mod.ServeRun,\n            \"execute\",\n            return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n        ):\n            self.mod.LOG_PATH.unlink()\n            self.assertEqual(bridge_request(self, turn_request())[0], 200)\n        self.assertEqual(\n            sum(\n                \" done model=\" in x for x in self.mod.LOG_PATH.read_text().splitlines()\n            ),\n            1,\n        )\n        self.assertNotIn(\" error model=\", self.mod.LOG_PATH.read_text())\n\n    def test_secret_canaries_masked_in_log_json_and_sse(self) -> None:\n        samples = [\n            \"Bearer secret-canary-token-123\",\n            \"Authorization: super-private-value\",\n            \"api_key=canary_secret_val\",\n            '{\"token\":\"canary_secret_val\"}',\n            \"{'password': 'canary_secret_val'}\",\n            'password=\"alpha beta gamma\"',\n            \"TOKEN: canary_secret_val\",\n            \"bridge-key=canary_secret_val\",\n            \"secret=canary_secret_val\",\n            \"sk-abcdefghijklmnop1234\",\n            \"bare-bridge-canary\",\n        ]\n        # Подмена только локальной конфигурации модуля, окружение не меняется.\n        self.mod.AUTH_KEY = \"bare-bridge-canary\"\n        for stream in (False, True):\n            for sample in samples:\n                for prefix in (\"\", \"x\" * 285 + \" \", \"x\" * 485 + \" \"):\n                    with self.subTest(stream=stream, sample=sample, prefix=len(prefix)):\n                        # Аутентификация запроса не нужна: модульный mock не меняет тестируемую редакцию.\n                        with mock.patch.object(self.mod, \"_auth_ok\", return_value=True):\n                            error, line = self._error_response(\n                                \"terminal_failed\", prefix + sample, stream\n                            )\n                        combined = json.dumps(error) + line\n                        for secret in (\n                            \"secret-canary-token-123\",\n                            \"super-private-value\",\n                            \"canary_secret_val\",\n                            \"alpha beta gamma\",\n                            \"abcdefghijklmnop1234\",\n                            \"bare-bridge-canary\",\n                        ):\n                            self.assertNotIn(secret, combined)\n                        if not prefix:\n                            self.assertIn(\"[REDACTED]\", error[\"detail\"])\n                            self.assertIn(\"[REDACTED]\", line)\n                        self.assertLessEqual(len(error[\"detail\"]), 500)\n                        self.assertNotIn(\"prompt-canary-private\", combined)\n\n    def test_none_diagnostic_is_empty(self) -> None:\n        for state in (\"spawn_failed\", \"terminal_failed\", \"ok\"):\n            error, _ = self._error_response(state, None, rc=0 if state == \"ok\" else 1)\n            self.assertEqual(error[\"detail\"], \"\")\n\n    def test_r2_escaped_quotes_mask_entire_secret_in_all_sinks(self) -> None:\n        samples = (\n            (\n                r'{\"password\": \"alpha \\\" suffix-canary-27182\"}',\n                '{\"password\": [REDACTED]}',\n            ),\n            (r'{\"token\":\"alpha\\\" beta gamma\"}', '{\"token\":[REDACTED]}'),\n        )\n        for stream in (False, True):\n            for sample, expected in samples:\n                with self.subTest(stream=stream, sample=sample):\n                    error, _ = self._error_response(\"terminal_failed\", sample, stream)\n                    self.assertEqual(error[\"detail\"], expected)\n                    logs = self.mod.LOG_PATH.read_text()\n                    self.assertNotIn(\"suffix-canary-27182\", logs)\n                    self.assertNotIn(\"beta gamma\", logs)\n\n    def _protocol_error_detail(self, content: str, message: str, stream: bool) -> str:\n        \"\"\"Проверить все выходы ошибки реального протокольного стенда.\"\"\"\n        install_protocol_wrapper(\n            self, {\"terminal\": \"failed\", \"error\": {\"message\": message}}\n        )\n        payload = turn_request(stream)\n        payload[\"messages\"][0][\"content\"] = content\n        status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200 if stream else 502)\n        if stream:\n            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n            frames = [\n                json.loads(line[6:])\n                for line in body.decode().splitlines()\n                if line.startswith(\"data: {\")\n            ]\n            return next(\n                frame[\"error\"][\"detail\"] for frame in frames if \"error\" in frame\n            )\n        return json.loads(body)[\"error\"][\"detail\"]\n\n    def test_r2_long_reflected_message_redacted_before_clipping(self) -> None:\n        content = \"private-owner-content-\" + \"Q\" * 220\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                detail = self._protocol_error_detail(content, content, stream)\n                self.assertEqual(detail, \"[REDACTED]\")\n                combined = detail + self.mod.LOG_PATH.read_text()\n                self.assertNotIn(\"private-owner-content-\", combined)\n                self.assertNotIn(\"Q\" * 20, combined)\n\n    def test_r2_short_messages_preserve_error_words(self) -> None:\n        expected = \"this turn failed upstream\"\n        for stream in (False, True):\n            for content in (\"hi\", \"e\"):\n                with self.subTest(stream=stream, content=content):\n                    detail = self._protocol_error_detail(content, expected, stream)\n                    self.assertEqual(detail, expected)\n                    self.assertIn(expected, self.mod.LOG_PATH.read_text())\n\n    def test_quota_secrets_do_not_reach_any_error_sink(self) -> None:\n        samples = (\n            \"api_key=canary_secret_val\",\n            '{\"token\":\"canary_secret_val\"}',\n            \"{'password': 'canary_secret_val'}\",\n            'password=\"alpha beta gamma\"',\n        )\n        for stream in (False, True):\n            for sample in samples:\n                with self.subTest(stream=stream, sample=sample):\n                    params = {\n                        \"terminal\": \"failed\",\n                        \"error\": {\n                            \"kind\": \"quota\",\n                            \"message\": sample,\n                            \"quota\": {\n                                \"token\": \"canary_secret_val\",\n                                \"note\": sample,\n                            },\n                        },\n                        \"stderr\": sample,\n                    }\n                    install_protocol_wrapper(self, params)\n                    status, body = bridge_request(self, turn_request(stream))\n                    self.assertEqual(status, 200 if stream else 502)\n                    logs = self.mod.LOG_PATH.read_text()\n                    for secret in (\"canary_secret_val\", \"alpha beta gamma\"):\n                        self.assertNotIn(secret, body.decode() + logs)\n                    self.assertIn(\"[REDACTED]\", body.decode())\n                    self.assertIn(\"[REDACTED]\", logs)\n        for key in (\n            \"token\",\n            \"secret\",\n            \"password\",\n            \"api_key\",\n            \"bridge_key\",\n            \"authorization\",\n        ):\n            quota = {\"outer\": [{key: \"alpha beta gamma\"}]}\n            install_protocol_wrapper(\n                self, {\"terminal\": \"failed\", \"error\": {\"quota\": quota}}\n            )\n            _, body = bridge_request(self, turn_request())\n            self.assertIn(\"[REDACTED]\", body.decode())\n            self.assertNotIn(\n                \"alpha beta gamma\", body.decode() + self.mod.LOG_PATH.read_text()\n            )\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1620,1743p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '800,885p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; cat receipts/verifier-receipt.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1620,1743p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; sed -n '800,885p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py; cat receipts/verifier-receipt.json\"","aggregated_output":"        completion_tokens: int,\n        reasoning_tokens: int,\n        summaries: list[str] | None = None,\n    ) -> None:\n        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n\n        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n        \"\"\"\n        finish = \"tool_calls\" if tool_calls else \"stop\"\n        if not self._sse_open and not self._sse_begin(model):\n            return\n        self._sse_stop_keepalive()\n        chunk = self._sse_chunk\n        reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n        if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n            return\n        for tc in tool_calls:\n            fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n            delta = {\n                \"tool_calls\": [\n                    {\n                        \"index\": tc.get(\"index\", 0),\n                        \"id\": tc.get(\"id\", \"\"),\n                        \"type\": \"function\",\n                        \"function\": {\n                            \"name\": fn.get(\"name\", \"\"),\n                            \"arguments\": fn.get(\"arguments\", \"\"),\n                        },\n                    }\n                ]\n            }\n            if not self._sse_emit(chunk(delta)):\n                return\n        for piece in _split_sse_chunks(content):\n            if not self._sse_emit(chunk({\"content\": piece})):\n                return\n            if SSE_CHUNK_DELAY_S > 0:\n                time.sleep(SSE_CHUNK_DELAY_S)\n        final = chunk({}, finish)\n        final[\"usage\"] = {\n            \"prompt_tokens\": prompt_tokens,\n            \"completion_tokens\": completion_tokens,\n            \"total_tokens\": prompt_tokens + completion_tokens,\n            \"reasoning_tokens\": reasoning_tokens,\n        }\n        if self._sse_emit(final):\n            self._sse_write(\"data: [DONE]\\n\\n\")\n\n    def do_GET(self) -> None:  # noqa: N802\n        path = self.path.split(\"?\", 1)[0]\n        if path in (\"/health\", \"/v1/health\"):\n            with _active_lock:\n                active = len(_active)\n                quarantined = len(_quarantined_slots)\n            self._send(\n                200,\n                {\n                    \"ok\": True,\n                    \"transport\": \"muse-cli\",\n                    \"wrapper\": MUSE_WRAPPER,\n                    \"models\": sorted(ALLOWED_MODELS),\n                    \"default_model\": DEFAULT_MODEL,\n                    \"default_effort\": DEFAULT_EFFORT,\n                    \"active\": active,\n                    \"quarantined\": quarantined,\n                    \"max_concurrent\": MAX_CONCURRENT,\n                    \"stream\": True,\n                    \"tool_emulation\": True,\n                    \"uptime_s\": int(time.time() - _started),\n                },\n            )\n            return\n        if not _auth_ok(self):\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        if path in (\"/v1/models\", \"/models\"):\n            self._send(\n                200,\n                {\n                    \"object\": \"list\",\n                    \"data\": [\n                        {\n                            \"id\": mid,\n                            \"object\": \"model\",\n                            \"owned_by\": \"meta-muse\",\n                            \"created\": 0,\n                            \"context_length\": meta[\"context_length\"],\n                        }\n                        for mid, meta in ALLOWED_MODELS.items()\n                    ],\n                },\n            )\n            return\n        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n\n    def do_POST(self) -> None:  # noqa: N802\n        if not _auth_ok(self):\n            self.close_connection = True\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        path = self.path.split(\"?\", 1)[0]\n        length = int(self.headers.get(\"Content-Length\") or \"0\")\n        raw = self.rfile.read(length) if length else b\"{}\"\n        try:\n            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n        except ValueError:\n            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n            return\n        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n            return\n        try:\n            self._serve_json(req)\n        finally:\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n\n    def _serve_json(self, req: dict) -> None:\n        self.effort = effort\n        self.workdir = workdir\n        self.proc: subprocess.Popen | None = None\n        self._closed = False\n        self._cleanup_lock = threading.Lock()\n        self.dead_confirmed = (\n            True  # False — группа не подтверждена мёртвой (карантин слота)\n        )\n\n    def close(self) -> None:\n        \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n\n        Идемпотентно: повторный вызов (таймер, надзор обрыва, finally) — no-op,\n        поэтому поздний killpg не может попасть в переиспользованный pid.\n        \"\"\"\n        proc = self.proc\n        if proc is None:\n            return\n        _terminate_run(self, (proc.stdout, proc.stderr))\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"muse wrapper not executable: {MUSE_WRAPPER}\",\n                \"state\": \"launcher_missing\",\n            }\n\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\n            \"META_API_KEY\", None\n        )  # обёртка тоже вычищает; двойная страховка (flat-подписка, не PAYG)\n\n        fd, prompt_path = tempfile.mkstemp(\n            prefix=\"muse-prompt-\", suffix=\".txt\", dir=str(self.workdir)\n        )\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(self.prompt)\n        except OSError as exc:\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"prompt file write failed: {exc}\",\n                \"state\": \"spawn_failed\",\n            }\n\n        cmd = [\n            MUSE_WRAPPER,\n            \"exec\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--reasoning-effort\",\n            self.effort,\n            \"--yolo\",\n            \"--trust-workspace\",\n            \"--workspace\",\n            str(self.workdir),\n            \"--json\",\n            \"--no-session-log\",\n            \"--disable-write\",\n            \"--disable-shell\",\n            \"--disable-web-tools\",\n            \"--disable-reminders\",\n            \"--prompt-file\",\n            prompt_path,\n        ]\n        _log(\n            f\"exec model={self.model_id} effort={self.effort} prompt_chars={len(self.prompt)} ws={self.workdir}\"\n        )\n\n        run_id = uuid.uuid4().hex[:8]\n        deltas: list[str] = []\n        final_text: str | None = None\n        terminal: str | None = None\n        reason: str | None = None\n        err_lines: list[str] = []\n        state = \"ok\"\n{\n  \"schema_version\": \"1.0\",\n  \"gate\": \"VERIFIER\",\n  \"status\": \"PASS\",\n  \"run_id\": \"muse-bridge-heal-20261014\",\n  \"checks\": [\n    {\n      \"id\": \"VER-001\",\n      \"command\": \"python3 -B -m unittest -v tests.test_muse_bridge_killpg\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-002\",\n      \"command\": \"python3 -B -m py_compile bridges/muse-bridge/server.py tests/test_muse_bridge_killpg.py\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-003-ruff-fmt\",\n      \"command\": \".venv/bin/ruff format --check bridges/muse-bridge/server.py tests/test_muse_bridge_killpg.py\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-003-ruff-chk\",\n      \"command\": \".venv/bin/ruff check bridges/muse-bridge/server.py tests/test_muse_bridge_killpg.py\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-003-pyright-err\",\n      \"command\": \".venv/bin/basedpyright --level error bridges/muse-bridge/server.py tests/test_muse_bridge_killpg.py\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-004-serve-help\",\n      \"command\": \"/Users/aazhiry1/.local/bin/muse serve --help\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"VER-004-exec-help\",\n      \"command\": \"/Users/aazhiry1/.local/bin/muse exec --help\",\n      \"exit_code\": 0\n    },\n    {\n      \"id\": \"git-diff-check\",\n      \"command\": \"git diff --check -- bridges/muse-bridge/server.py tests/test_muse_bridge_killpg.py\",\n      \"exit_code\": 0\n    }\n  ],\n  \"server_py_sha256\": \"7d02f13c475c5b205198a268ee9407539c27e9a6e26b45cd25c644e3e66af846\",\n  \"test_py_sha256\": \"5ef6d3cd155347e7ea9f84d3040d592d67569a87567ad53a2ceac314d4fb7378\",\n  \"verified_at\": \"2026-10-14T09:57:11.938734+00:00\",\n  \"modified_files\": {\n    \"bridges/muse-bridge/server.py\": \"084089ce29bacd8c248735473a5fea8f50c5fff9f73ee29746e60ed836cfc5b5\",\n    \"tests/test_muse_bridge_killpg.py\": \"1dcb4a0861bfe149bda9e64aa9b3b5a500fbcc830c723ad96a30d686b01a9a7f\"\n  },\n  \"test_summary\": \"Ran 37 tests in clean-room L2 verifier (18 baseline + 19 new, including 4 regressions for F-001 escaped quotes and F-002 reflected user message scrubbing before truncation + short message protection): OK (exit 0)\"\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport importlib.util, io, json, threading\nfrom unittest.mock import patch\np='/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py'\ns=importlib.util.spec_from_file_location('review_probe',p)\nm=importlib.util.module_from_spec(s);s.loader.exec_module(m)\nm.AUTH_KEY=''\nfor label, content in [('r2-long','private-owner-content-'+'Q'*220),('mixed-secret','private-owner-content-canary api_key=[REDACTED_SECRET]'),('mixed-long','private-owner-content-canary api_key=[REDACTED_SECRET] '+'Q'*220)]:\n    logs=[]\n    class FakeRun:\n        dead_confirmed=True\n        def __init__(self,*args): self.prompt=args[1]\n        def execute(self):\n            return {'rc':1,'state':'terminal_failed','text':'','err':'\\\\n'.join(m._turn_diagnostics({'error':{'message':content}},self.prompt))}\n        def close(self): pass\n    for stream in [False,True]:\n        h=m.Handler.__new__(m.Handler);h._wlock=threading.Lock();h.wfile=io.BytesIO()\n        h.send_response=lambda *args:None;h.send_header=lambda *args:None;h.end_headers=lambda:None\n        h._client_gone_probe=lambda:False;h._watch_client=lambda stop:None\n        with patch.object(m,'ServeRun',FakeRun),patch.object(m,'_log',logs.append):\n            h._serve_json({'model':'muse-spark-1.3','messages':[{'role':'user','content':content}],'stream':stream})\n        body=h.wfile.getvalue().decode()\n        if stream:\n            detail=next(json.loads(x[6:])['error']['detail'] for x in body.splitlines() if x.startswith('data: {') and 'error' in json.loads(x[6:]))\n        else: detail=json.loads(body)['error']['detail']\n        print(json.dumps({'label':label,'stream':stream,'detail':detail,'prompt_canary_in_body':'private-owner-content-canary' in body,'prompt_canary_in_log':any('private-owner-content-canary' in x for x in logs),'done_count':body.count('data: [DONE]')},ensure_ascii=False))\nprint('escaped_quote',m._redact_secrets(r'{\\\"password\\\": \\\"alpha \\\\\\\" suffix-canary-27182\\\"}'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
