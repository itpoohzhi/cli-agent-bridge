{"type":"tool_call","subtype":"started","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-15\nfc_147f52a8-d0f9-9b57-8331-436714925110_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/tests/test_lenient_tool_call.py"}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-15\nfc_147f52a8-d0f9-9b57-8331-436714925110_3","startedAtMs":"1792866720633"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866720818}
{"type":"tool_call","subtype":"completed","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-12\nfc_147f52a8-d0f9-9b57-8331-436714925110_0","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/server.py","offset":1698,"limit":220},"result":{"success":{"content":"    return _SECRET.sub(keep_model_ids, text)\n\n\n_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n\n\ndef _recover_trailing_braces(text: str, strict: bool, quiet: bool = False) -> dict[str, Any] | None:\n    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n    body = text.lstrip()\n    try:\n        obj, end = json.JSONDecoder(strict=strict).raw_decode(body)\n    except (ValueError, RecursionError):\n        return None\n    tail = body[end:]\n    extra = tail.count(\"}\")\n    if isinstance(obj, dict) and 1 <= extra <= _MAX_EXTRA_BRACES and not tail.strip(\" \\t\\r\\n}\"):\n        if not quiet:\n            _log(f\"tool_call_recovered extra_braces={extra}\")\n        return obj\n    return None\n\n\ndef _loads_lenient(text: str, *, quiet: bool = False) -> Any:\n    \"\"\"json.loads с допуском сырых управляющих символов (\\\\n, \\\\t) внутри строк и лишних `}` в хвосте.\n\n    Порт из droid-bridge (08.10): модели кладут многострочные команды в JSON-строку\n    без экранирования переводов строк; строгий json.loads их отвергает, и вызов\n    утекал в content текстом. Сначала строгий разбор, затем strict=False, затем\n    полный объект с хвостом из пробелов и `}` (модель закрыла скобок больше нужного).\n    Слишком глубокая вложенность (RecursionError) — это тоже невалидный JSON (ValueError).\n    \"\"\"\n    try:\n        return json.loads(text)\n    except (ValueError, RecursionError):\n        pass\n    try:\n        return json.loads(text, strict=False)\n    except (ValueError, RecursionError) as exc:\n        recovered = _recover_trailing_braces(text, strict=False, quiet=quiet)\n        if recovered is None:\n            if isinstance(exc, RecursionError):\n                raise ValueError(\"JSON is nested too deeply\") from exc\n            raise\n        return recovered\n\n\ndef _normalize_arguments(value: Any) -> dict[str, Any] | None:\n    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n\n    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n    и запускать инструмент с пустыми аргументами.\n    \"\"\"\n    if isinstance(value, dict):\n        return value\n    if isinstance(value, str):\n        text = value.strip()\n        if text:\n            try:\n                parsed = _loads_lenient(text)\n            except ValueError:\n                return None\n            if isinstance(parsed, dict):\n                return parsed\n    return None\n\n\ndef _normalize_tool_call(item: Any) -> dict[str, Any]:\n    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n\n    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n    с конкретным вызовом при нескольких одинаковых инструментах.\n    \"\"\"\n    if not isinstance(item, dict):\n        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n    fn = _dict_or_empty(item.get(\"function\"))\n    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n    args = fn.get(\"arguments\")\n    if args is None:\n        args = item.get(\"arguments\")\n    normalized = _normalize_arguments(args)\n    return {\n        \"id\": str(item.get(\"id\") or \"\"),\n        \"name\": str(name),\n        \"arguments\": normalized if normalized is not None else {},\n    }\n\n\ndef _render_tool_call(item: Any) -> str:\n    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n\n\ndef _tool_choice_none(tool_choice: Any) -> bool:\n    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n\n\ndef _tool_choice_name(tool_choice: Any) -> str:\n    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n    if not isinstance(tool_choice, dict):\n        return \"\"\n    fn = _dict_or_empty(tool_choice.get(\"function\"))\n    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n    return str(name) if name else \"\"\n\n\ndef _tools_section(tools: list[Any], tool_choice: Any, model_id: str = \"\") -> str:\n    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n    open_tag, close_tag = _tool_tags_for_model(model_id)\n    # у GLM подстрока `tool_call` в промпте провоцирует нативный спец-токен\n    block_name = \"tool_invoke\" if _uses_alt_tool_tag(model_id) else \"tool_call\"\n    lines = [\n        \"[system]\",\n        \"# Tool calling protocol\",\n        \"You may call the external tools listed below.\",\n        \"When you need a tool, output ONLY blocks exactly in this form:\",\n        f'{open_tag}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{close_tag}',\n        \"You may output several such blocks in a row. Do not narrate around them.\",\n        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n        \"If no tool is needed, reply normally in plain text.\",\n        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n        f\"Do not run shell commands or edit files yourself: emit a {block_name} block instead.\",\n        (\n            f\"If a tool is needed, you MUST emit the {block_name} block in this reply; prose claims \"\n            \"like \\\"I'll check...\\\" without a block are forbidden and end the turn with no action.\"\n        ),\n        \"The block itself changes nothing: the caller executes the tool and sends back the result.\",\n    ]\n    if tool_choice == \"required\":\n        lines.append(\"You MUST call at least one tool now.\")\n    else:\n        forced = _tool_choice_name(tool_choice)\n        if forced:\n            lines.append(f'You MUST call the tool \"{forced}\" now.')\n    lines.append(\"\")\n    lines.append(\"Available tools:\")\n    for item in tools:\n        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n        if not isinstance(fn, dict):\n            continue\n        name = str(fn.get(\"name\") or \"\")\n        desc = str(fn.get(\"description\") or \"\")\n        params = _dict_or_empty(fn.get(\"parameters\"))\n        lines.append(f\"- {name}: {desc}\")\n        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n    return \"\\n\".join(lines)\n\n\ndef _render_turn(msg: dict[str, Any]) -> tuple[str, str]:\n    \"\"\"Одна реплика истории -> (role, текст); пустой текст = пропустить.\n\n    assistant.tool_calls и role:\"tool\" рендерятся в те же блоки, что протокол.\n    \"\"\"\n    role = str(msg.get(\"role\") or \"user\").strip().lower()\n    text = _flatten_content(msg.get(\"content\"))\n    if role == \"tool\":\n        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n        name = str(msg.get(\"name\") or \"\")\n        header = f\"[tool result {call_id}]\"\n        if name:\n            header += f\" ({name})\"\n        return role, f\"{header}\\n{text}\" if text.strip() else header\n    if role == \"assistant\":\n        text = _sanitize_assistant_text(text)\n        parts = [text] if text.strip() else []\n        calls = msg.get(\"tool_calls\")\n        if isinstance(calls, list):\n            parts.extend(_render_tool_call(tc) for tc in calls)\n        return role, \"\\n\".join(parts)\n    return role, text\n\n\ndef _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"История OpenAI -> (system_text, размеченный текст реплик).\"\"\"\n    systems: list[str] = []\n    turns: list[str] = []\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        if role in (\"system\", \"developer\"):\n            systems.append(text)\n        elif role == \"assistant\":\n            turns.append(f\"Assistant: {text}\")\n        elif role == \"tool\":\n            turns.append(text)\n        else:\n            turns.append(f\"User: {text}\")\n    return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n\n\ndef _strip_code_fence(text: str) -> str:\n    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n    body = text.strip()\n    if body.startswith((\"```\", \"~~~\")):\n        newline = body.find(\"\\n\")\n        body = body[newline + 1 :] if newline != -1 else body[3:]\n    if body.rstrip().endswith((\"```\", \"~~~\")):\n        body = body.rstrip()[:-3]\n    return body.strip()\n\n\ndef _parse_tool_call_block(inner: str, *, quiet: bool = False) -> dict[str, Any] | None:\n    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n\n    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n    OpenAI-обёртка {\"id\",\"type\",\"function\":{\"name\",\"arguments\"}} разворачивается,\n    только если name верхнего уровня отсутствует (он всегда побеждает).\n    \"\"\"\n    try:\n        obj = _loads_lenient(_strip_code_fence(inner), quiet=quiet)\n    except ValueError:\n        return None\n    if not isinstance(obj, dict):","isEmpty":false,"exceededLimit":false,"totalLines":4022,"fileSize":200835,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1698,"endLine":1917},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-12\nfc_147f52a8-d0f9-9b57-8331-436714925110_0","startedAtMs":"1792866720409","completedAtMs":"1792866720759"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866721105}
{"type":"tool_call","subtype":"started","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-13\nfc_147f52a8-d0f9-9b57-8331-436714925110_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/server.py","offset":2030,"limit":220}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-13\nfc_147f52a8-d0f9-9b57-8331-436714925110_1","startedAtMs":"1792866720762"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866721106}
{"type":"tool_call","subtype":"completed","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-14\nfc_147f52a8-d0f9-9b57-8331-436714925110_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/tests/test_step_interruption.py","offset":450,"limit":180},"result":{"success":{"content":"        self.assertIn(\"Available tools: job_output, bash\", tail)\n        self.assertIn(\"<tool_call>\", tail)\n        self.assertTrue(prompt.rstrip().endswith(tail.rstrip()))\n\n\n    # --- Битый блок вызова (2026-10-24): не в SSE/JSON content и не в повторный промпт --------------------\n\n    def _assert_reprompt_clean(self) -> None:\n        reprompt = self._prompts()[1]\n        self.assertIn(PREAMBLE, reprompt)\n        self.assertNotIn(BROKEN_FRAGMENT, reprompt)\n\n    def test_stream_broken_block_not_in_sse_nor_reprompt(self) -> None:\n        os.environ[\"FAKE_OC_MODE\"] = \"raw_then_calls\"\n        os.environ[\"FAKE_OC_RAW\"] = BROKEN_INVOKE\n        os.environ[\"FAKE_OC_CALLS\"] = INVOKE_CALLS\n        content, finishes, names = self._stream(model=GLM_MODEL)\n        self.assertEqual(self._runs(), 2)\n        self.assertNotIn(\"<tool_invoke>\", content)\n        self.assertNotIn(BROKEN_FRAGMENT, content)\n        self.assertIn(\"забираю вывод\", content)\n        self.assertEqual(names, [\"job_output\", \"bash\"])\n        self.assertEqual(finishes, [\"tool_calls\"])\n        self._assert_reprompt_clean()\n\n    def test_json_broken_block_not_in_content_nor_reprompt(self) -> None:\n        os.environ[\"FAKE_OC_MODE\"] = \"raw_then_calls\"\n        os.environ[\"FAKE_OC_RAW\"] = BROKEN_INVOKE\n        os.environ[\"FAKE_OC_CALLS\"] = INVOKE_CALLS\n        out = json.loads(self._post(stream=False, model=GLM_MODEL))\n        message = out[\"choices\"][0][\"message\"]\n        self.assertEqual(self._runs(), 2)\n        self.assertNotIn(\"<tool_invoke>\", message[\"content\"])\n        self.assertNotIn(BROKEN_FRAGMENT, message[\"content\"])\n        self.assertEqual([c[\"function\"][\"name\"] for c in message[\"tool_calls\"]], [\"job_output\", \"bash\"])\n        self._assert_reprompt_clean()\n\n    def test_stream_recovered_trailing_braces_single_spawn(self) -> None:\n        os.environ[\"FAKE_OC_CALLS\"] = OVERCLOSED_INVOKE\n        content, finishes, names = self._stream(model=GLM_MODEL)\n        self.assertEqual(self._runs(), 1)\n        self.assertEqual(names, [\"bash\"])\n        self.assertEqual(finishes, [\"tool_calls\"])\n        self.assertNotIn(\"<tool_invoke>\", content)\n\n    def test_json_recovered_trailing_braces_single_spawn(self) -> None:\n        os.environ[\"FAKE_OC_CALLS\"] = OVERCLOSED_INVOKE\n        out = json.loads(self._post(stream=False, model=GLM_MODEL))\n        self.assertEqual(self._runs(), 1)\n        self.assertEqual([c[\"function\"][\"name\"] for c in out[\"choices\"][0][\"message\"][\"tool_calls\"]], [\"bash\"])\n\n    def test_stream_notice_when_only_broken_block(self) -> None:\n        os.environ[\"FAKE_OC_MODE\"] = \"emit_raw\"\n        os.environ[\"FAKE_OC_RAW\"] = BROKEN_INVOKE\n        content, finishes, names = self._stream(model=GLM_MODEL)\n        self.assertLessEqual(self._runs(), 3)\n        self.assertEqual(names, [])\n        self.assertEqual(content, server._BROKEN_BLOCK_NOTICE)\n        self.assertEqual(finishes, [\"stop\"])\n\n    def test_serve_json_broken_block_stripped_and_notice(self) -> None:\n        os.environ[\"FAKE_OC_MODE\"] = \"emit_raw\"\n        os.environ[\"FAKE_OC_RAW\"] = BROKEN_INVOKE\n        out = json.loads(self._post(stream=False, model=GLM_MODEL))\n        choice = out[\"choices\"][0]\n        self.assertLessEqual(self._runs(), 3)\n        self.assertEqual(choice[\"message\"][\"content\"], server._BROKEN_BLOCK_NOTICE)\n        self.assertNotIn(\"tool_calls\", choice[\"message\"])\n        self.assertEqual(choice[\"finish_reason\"], \"stop\")\n\n    def test_serve_json_mixed_valid_and_broken(self) -> None:\n        os.environ[\"FAKE_OC_MODE\"] = \"emit_raw\"\n        os.environ[\"FAKE_OC_RAW\"] = BROKEN_INVOKE + INVOKE_CALLS\n        out = json.loads(self._post(stream=False, model=GLM_MODEL))\n        message = out[\"choices\"][0][\"message\"]\n        self.assertEqual(self._runs(), 1)\n        self.assertEqual([c[\"function\"][\"name\"] for c in message[\"tool_calls\"]], [\"job_output\", \"bash\"])\n        self.assertNotIn(\"<tool_invoke>\", message[\"content\"])\n        self.assertNotIn(BROKEN_FRAGMENT, message[\"content\"])\n        self.assertNotIn(server._BROKEN_BLOCK_NOTICE, message[\"content\"])\n\n\nclass TestStripBrokenBlocks(unittest.TestCase):\n    BROKEN = \"<tool_invoke>{broken</tool_invoke>\"\n    VALID = '<tool_invoke>{\"name\": \"a\", \"arguments\": {}}</tool_invoke>'\n\n    def test_strip_broken_blocks_helper(self) -> None:\n        strip = server._strip_broken_tool_blocks\n        plain = \"Просто текст без тегов.\"\n        out, dropped = strip(plain)\n        self.assertIs(out, plain)\n        self.assertEqual(dropped, 0)\n        self.assertEqual(strip(f\"до {self.BROKEN} после\"), (\"до  после\", 1))\n        self.assertEqual(strip(\"до <tool_call>{broken</tool_call> после\"), (\"до  после\", 1))\n        # незакрытый хвост отбрасывается целиком\n        self.assertEqual(strip('Текст <tool_call>{\"name\": \"read\", \"arguments\": {\"f'), (\"Текст \", 1))\n        # валидные блоки (одиночный, пачка без промежуточных закрытий) — те же байты, тот же объект\n        batch = ('<tool_call>{\"name\": \"a\", \"arguments\": {}}\\n<tool_call>{\"name\": \"b\", \"arguments\": {}}'\n                 '</tool_call>')\n        for kept in (self.VALID, batch, f\"x {self.VALID} y\"):\n            with self.subTest(kept=kept[:30]):\n                out, dropped = strip(kept)\n                self.assertIs(out, kept)\n                self.assertEqual(dropped, 0)\n        # валидный блок с лишней `}` разбирается и сохраняется\n        overclosed = '<tool_invoke>{\"name\": \"a\", \"arguments\": {}}}</tool_invoke>'\n        self.assertEqual(strip(overclosed), (overclosed, 0))\n        # смешанный текст: битый уходит, валидный остаётся\n        self.assertEqual(strip(f\"{self.BROKEN}{self.VALID}\"), (self.VALID, 1))\n        # цитаты markdown (inline и fenced) — не вызовы\n        quoted = (\"Блок `<tool_call>` открывает вызов, а пример `x <tool_call>{broken</tool_call>` - код.\\n\"\n                  \"```\\n<tool_invoke>{broken</tool_invoke>\\n```\\n\")\n        self.assertEqual(strip(quoted), (quoted, 0))\n        # слишком глубокая вложенность — «не разбирается», а не исключение\n        deep = \"<tool_invoke>\" + '{\"a\":' * 100000 + \"}</tool_invoke>\"\n        self.assertEqual(strip(deep), (\"\", 1))\n\n    def test_strip_cap_is_fail_closed(self) -> None:\n        text = \"\".join(\"a\" + self.BROKEN for _ in range(20))\n        err = io.StringIO()\n        with contextlib.redirect_stderr(err):\n            out, dropped = server._strip_broken_tool_blocks(text)\n        self.assertIn(\"tool_strip_cap_hit\", err.getvalue())  # метка не должна маскироваться как секрет\n        quiet = io.StringIO()\n        with contextlib.redirect_stderr(quiet):\n            server._strip_broken_tool_blocks(text, quiet=True)\n        self.assertNotIn(\"tool_strip_cap_hit\", quiet.getvalue())\n        self.assertEqual(out, \"a\" * (server._STRIP_SCAN_MAX_TAGS + 1))\n        self.assertEqual(dropped, server._STRIP_SCAN_MAX_TAGS + 1)\n        self.assertNotIn(\"<tool_invoke>\", out)\n\n    def test_sanitize_strips_malformed_closed_tool_invoke(self) -> None:\n        text = f\"Смотрю.\\n{self.BROKEN}\\nДальше.\"\n        out = server._sanitize_assistant_text(text)\n        self.assertNotIn(\"<tool_invoke>\", out)\n        self.assertNotIn(\"{broken\", out)\n        self.assertIn(\"Смотрю.\", out)\n        self.assertIn(\"Дальше.\", out)\n        overclosed = '<tool_invoke>{\"name\": \"a\", \"arguments\": {}}}</tool_invoke>'\n        self.assertEqual(server._sanitize_assistant_text(overclosed), overclosed)\n\n    def test_incomplete_prompt_has_no_broken_block(self) -> None:\n        prompt = server._incomplete_tool_step_prompt(\n            \"PROMPT\", f\"Статус: собираю. {self.BROKEN}\", TOOLS, None, GLM_MODEL)\n        self.assertIn(\"Статус: собираю.\", prompt)\n        self.assertNotIn(\"{broken\", prompt)\n\n    def test_strip_scan_is_bounded_broken_block(self) -> None:\n        import time\n        cases = {\n            \"closed_invoke\": self.BROKEN * 1000,\n            \"closed_call\": \"<tool_call>{broken</tool_call>\" * 1000,\n            \"unclosed\": \"<tool_invoke>{\" * 1000,\n            \"mixed\": (\"x\" + self.VALID + self.BROKEN) * 500,\n        }\n        for label, text in cases.items():\n            with self.subTest(case=label):\n                started = time.perf_counter()\n                out, dropped = server._strip_broken_tool_blocks(text)\n                elapsed = time.perf_counter() - started\n                self.assertLess(elapsed, 0.05)\n                self.assertGreater(dropped, 0)\n                self.assertNotIn(\"{broken\", out)\n                self.assertNotIn(\"<tool_call>{\", out.replace(self.VALID, \"\"))\n                self.assertNotIn(\"<tool_invoke>{broken\", out)\n\n\nclass TestIsIncompleteToolStep(unittest.TestCase):\n    def check(self, text: str = \"\", reasoning: str = \"\", **kw: Any) -> bool:\n        return server._is_incomplete_tool_step(text, reasoning, kw.pop(\"tools\", TOOLS), **kw)\n\n    def test_no_tools_never_incomplete(self) -> None:\n        self.assertFalse(self.check(\"Собираю факты\", \"let me batch\", tools=[], tool_choice=\"required\"))\n\n    def test_tool_choice_required_or_named(self) -> None:\n        self.assertTrue(self.check(\"Привет\", tool_choice=\"required\"))\n        self.assertTrue(self.check(\"Привет\", tool_choice={\"type\": \"function\", \"function\": {\"name\": \"bash\"}}))\n\n    def test_provider_error_with_partial_output(self) -> None:\n        self.assertTrue(self.check(\"Фетч был завершён\", had_error=True))","isEmpty":false,"exceededLimit":false,"totalLines":1027,"fileSize":55625,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/tests/test_step_interruption.py","readRange":{"startLine":450,"endLine":629},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-14\nfc_147f52a8-d0f9-9b57-8331-436714925110_2","startedAtMs":"1792866720630","completedAtMs":"1792866720835"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866721249}
{"type":"tool_call","subtype":"completed","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-15\nfc_147f52a8-d0f9-9b57-8331-436714925110_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/tests/test_lenient_tool_call.py"},"result":{"success":{"content":"#!/usr/bin/env python3\n\"\"\"Regression (порт из droid-bridge, 2026-10-08): блок <tool_call> с СЫРЫМИ переводами\nстрок/табами внутри JSON-строк. Строгий json.loads падал («Invalid control character»),\nблок утекал в content текстом, finish_reason \"stop\" — DSH заканчивал ход.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport contextlib\nimport io\nimport json\nimport unittest\nfrom pathlib import Path\n\nimport server\nfrom tests._fixtures import install_test_models\n\ninstall_test_models(server)\n\nO, C = server.TOOL_CALL_OPEN, server.TOOL_CALL_CLOSE\nRAW_BLOCK = (O + '{\"name\": \"bash\", \"arguments\": {\"command\": \"python3 -c \\\\\"\\nimport os\\nprint(1)\\n\\\\\"\", '\n             '\"description\": \"Run multi-line python\"}}' + C)\n\n\nclass TestLenientToolCall(unittest.TestCase):\n    def test_tests_never_write_to_live_bridge_log(self) -> None:\n        live = Path(server.__file__).resolve().parent / \"logs\" / \"bridge.log\"\n        self.assertNotEqual(Path(server.LOG_PATH).resolve(), live)\n\n    def test_raw_newlines_in_block_parsed_as_call(self) -> None:\n        content, calls = server._split_tool_calls([\"Запускаю.\\n\", RAW_BLOCK])\n        self.assertEqual(len(calls), 1)\n        args = json.loads(calls[0][\"function\"][\"arguments\"])\n        self.assertEqual(args[\"command\"], 'python3 -c \"\\nimport os\\nprint(1)\\n\"')\n        self.assertNotIn(O, content)\n\n    def test_raw_control_chars_in_string_arguments(self) -> None:\n        inner = '{\"name\": \"bash\", \"arguments\": \"{\\\\\"command\\\\\": \\\\\"a\\nb\\\\tc\\\\\"}\"}'\n        self.assertEqual(server._parse_tool_call_block(inner),\n                         {\"name\": \"bash\", \"arguments\": {\"command\": \"a\\nb\\tc\"}})\n\n    def test_normalize_arguments_lenient(self) -> None:\n        self.assertEqual(server._normalize_arguments('{\"c\": \"a\\tb\"}'), {\"c\": \"a\\tb\"})\n\n    def test_negative_control_garbage_still_text_and_logged(self) -> None:\n        err = io.StringIO()\n        with contextlib.redirect_stderr(err):\n            content, calls = server._split_tool_calls([O + '{\"name\": \"bash\", \"arguments\": {broken' + C])\n        self.assertEqual(calls, [])\n        self.assertIn(\"{broken\", content)\n        self.assertIn(\"tool_call_unparsed\", err.getvalue())\n\n\n# Боевой вызов (2026-10-24): лишняя `}` после объекта, bash-heredoc с экранированными/сырыми переводами строк.\n_PROD_ESCAPED = ('{\"id\": \"call_1\", \"name\": \"bash\", \"arguments\": {\"command\": \"cat > a.py <<\\'EOF\\'\\\\nprint({1: 2})'\n                 '\\\\nEOF\", \"description\": \"write\"}}}')\n_PROD_RAW = _PROD_ESCAPED.replace(\"\\\\n\", \"\\n\")\n_PROD_ARGS = {\"command\": \"cat > a.py <<'EOF'\\nprint({1: 2})\\nEOF\", \"description\": \"write\"}\n_BASE = '{\"name\": \"bash\", \"arguments\": {\"command\": \"ls\"}}'\n_BASH_LS = {\"name\": \"bash\", \"arguments\": {\"command\": \"ls\"}}\n\n\nclass TestTrailingBraceRecovery(unittest.TestCase):\n    def test_trailing_braces_recovered(self) -> None:\n        for tail in (\"}\", \"}}\", \"} }\\n}\", \"}}}\\n\", \"}\" * 16):\n            with self.subTest(tail=tail):\n                self.assertEqual(server._parse_tool_call_block(_BASE + tail), _BASH_LS)\n                self.assertEqual(server._parse_tool_call_blocks(_BASE + tail), [_BASH_LS])\n\n    def test_production_payload_single_call(self) -> None:\n        for label, payload in ((\"escaped\", _PROD_ESCAPED), (\"raw_newlines\", _PROD_RAW)):\n            for open_tag, close_tag in ((O, C), (server.ALT_TOOL_CALL_OPEN, server.ALT_TOOL_CALL_CLOSE)):\n                with self.subTest(payload=label, tag=open_tag):\n                    content, calls = server._split_tool_calls([\"Запускаю.\\n\", open_tag + payload + close_tag])\n                    self.assertEqual(len(calls), 1)\n                    self.assertEqual(calls[0][\"function\"][\"name\"], \"bash\")\n                    self.assertEqual(json.loads(calls[0][\"function\"][\"arguments\"]), _PROD_ARGS)\n                    self.assertEqual(content, \"Запускаю.\\n\")\n\n    def test_trailing_garbage_not_recovered(self) -> None:\n        bad = (\n            '{\"name\": \"bash\", \"arguments\": {}}}, \"x\": 1}',\n            _BASE + '}, \"x\": 1}',\n            _BASE + \"}x\",\n            \"[1]}\",\n            '{\"name\": \"bash\", \"arguments\": {\"command\": \"ls\"}',  # недозакрыт\n            \"{broken\",\n            _BASE + \"}\" * 20,  # больше предела лишних скобок\n            \"[\" * 100000,\n            '{\"a\":' * 100000 + \"}\",  # RecursionError не утекает наружу\n        )\n        for text in bad:\n            with self.subTest(text=text[:40]):\n                self.assertIsNone(server._parse_tool_call_block(text))\n                self.assertIsNone(server._parse_tool_call_blocks(text))\n\n    def test_recovered_logged_unless_quiet(self) -> None:\n        err = io.StringIO()\n        with contextlib.redirect_stderr(err):\n            server._parse_tool_call_blocks(_BASE + \"}}\")\n        self.assertIn(\"tool_call_recovered extra_braces=2\", err.getvalue())\n        quiet = io.StringIO()\n        with contextlib.redirect_stderr(quiet):\n            self.assertEqual(server._parse_tool_call_blocks(_BASE + \"}}\", quiet=True), [_BASH_LS])\n        self.assertNotIn(\"tool_call_recovered\", quiet.getvalue())\n\n    def test_openai_function_wrapper(self) -> None:\n        wrapper = json.dumps({\"id\": \"call_1\", \"type\": \"function\",\n                              \"function\": {\"name\": \"bash\", \"arguments\": json.dumps({\"command\": \"ls\"})}})\n        self.assertEqual(server._parse_tool_call_block(wrapper), _BASH_LS)\n        self.assertEqual(server._parse_tool_call_block(wrapper + \"}\"), _BASH_LS)\n        as_object = json.dumps({\"function\": {\"name\": \"bash\", \"arguments\": {\"command\": \"ls\"}}})\n        self.assertEqual(server._parse_tool_call_block(as_object), _BASH_LS)\n        # name верхнего уровня всегда побеждает\n        both = json.dumps({\"name\": \"bash\", \"function\": {\"name\": \"other\", \"arguments\": {\"z\": 1}}})\n        self.assertEqual(server._parse_tool_call_block(both), {\"name\": \"bash\", \"arguments\": {}})\n        # присутствующее, но пустое/не-строковое name — не повод разворачивать обёртку\n        for name in (\"\", \"  \", None, 5):\n            blank = json.dumps({\"name\": name, \"function\": {\"name\": \"other\", \"arguments\": {}}})\n            with self.subTest(name=name):\n                self.assertIsNone(server._parse_tool_call_block(blank))\n        for text in ('{\"function\": \"bash\"}', '{\"function\": [\"bash\"]}', '{\"function\": {\"arguments\": {}}}'):\n            with self.subTest(text=text):\n                self.assertIsNone(server._parse_tool_call_block(text))\n\n    def test_batch_segment_with_extra_brace(self) -> None:\n        second = '{\"name\": \"read\", \"arguments\": {\"file_path\": \"/etc/hosts\"}}}'\n        content, calls = server._split_tool_calls([O + _BASE + \" \" + O + second + C])\n        self.assertEqual([c[\"function\"][\"name\"] for c in calls], [\"bash\", \"read\"])\n        self.assertEqual(content, \"\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","isEmpty":false,"exceededLimit":false,"totalLines":135,"fileSize":7086,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/tests/test_lenient_tool_call.py","readRange":{"startLine":1,"endLine":135},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-15\nfc_147f52a8-d0f9-9b57-8331-436714925110_3","startedAtMs":"1792866720633","completedAtMs":"1792866720893"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866721331}
{"type":"tool_call","subtype":"completed","call_id":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-13\nfc_147f52a8-d0f9-9b57-8331-436714925110_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/server.py","offset":2030,"limit":220},"result":{"success":{"content":"    while index < end:\n        if doc[index] != \"`\":\n            index += 1\n            continue\n        run_start = index\n        while index < end and doc[index] == \"`\":\n            index += 1\n        if index - run_start == ticks:\n            return index\n    return -1\n\n\ndef _is_atx_heading(line: str) -> bool:\n    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n    stripped = line.lstrip(\" \")\n    if len(line) - len(stripped) > 3:\n        return False\n    rest = stripped.lstrip(\"#\")\n    return 1 <= len(stripped) - len(rest) <= 6 and (\n        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n    )\n\n\ndef _code_context(doc: str, pos: int, final: bool) -> str:\n    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n\n    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n    \"\"\"\n    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n    fence_char, fence_len, para, index = \"\", 0, 0, 0\n    while index < line_start:\n        eol = doc.index(\"\\n\", index)\n        line = doc[index:eol]\n        char, run, rest = _fence_run(line)\n        if fence_len:\n            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n                fence_len, para = 0, eol + 1\n        elif _is_fence_open(char, run, rest):\n            fence_char, fence_len = char, run\n        elif not line.strip() or _is_atx_heading(line):\n            para = eol + 1\n        index = eol + 1\n    if fence_len:\n        return \"code\"\n    eol = doc.find(\"\\n\", pos)\n    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n        return \"code\" if eol != -1 or final else \"wait\"\n    para_end, decided = len(doc), final\n    index = len(doc) if eol == -1 else eol + 1\n    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n        para = line_start  # заголовок — отдельный однострочный блок\n        if eol != -1:\n            para_end, decided, index = eol, True, len(doc)\n    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n        nxt = doc.find(\"\\n\", index)\n        line = doc[index : len(doc) if nxt == -1 else nxt]\n        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n        if (\n            nxt == -1\n            and not final\n            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n        ):\n            break\n        char, run, rest = _fence_run(line)\n        if not line.strip() or _is_fence_open(char, run, rest) or _is_atx_heading(line):\n            para_end, decided = index, True\n            break\n        if nxt == -1:\n            break\n        index = nxt + 1\n    index = para\n    while index < pos:\n        char = doc[index]\n        if char == \"\\\\\":\n            index += 2\n        elif char != \"`\":\n            index += 1\n        else:\n            open_start = index\n            while index < para_end and doc[index] == \"`\":\n                index += 1\n            close_end = _find_closing_run(doc, index, para_end, index - open_start)\n            if close_end == -1:\n                if not decided:  # пара может прийти позже\n                    return \"wait\"\n            elif close_end > pos:\n                return \"wait\" if close_end == len(doc) and not final else \"code\"\n            else:\n                index = close_end\n    return \"text\"\n\n\ndef _find_close_in(text: str, start: int, close_tag: str = TOOL_CALL_CLOSE) -> int:\n    \"\"\"Позиция закрывающего тега вне строковых литералов JSON в `text[start:]`, или -1.\n\n    Закрывающий тег внутри JSON-строки (например, значение аргумента содержит\n    `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n    строку не закрывают.\n    \"\"\"\n    index = start\n    length = len(text)\n    in_string = False\n    escaped = False\n    while index < length:\n        char = text[index]\n        if in_string:\n            if escaped:\n                escaped = False\n            elif char == \"\\\\\":\n                escaped = True\n            elif char == '\"':\n                in_string = False\n        elif char == '\"':\n            in_string = True\n        elif text.startswith(close_tag, index):\n            return index\n        index += 1\n    return -1\n\n\n_STRIP_SCAN_MAX_TAGS = 16  # граница CPU: `_code_context` — O(len) на кандидата\n_BROKEN_BLOCK_NOTICE = \"[opencode-zen-bridge: невалидный блок вызова инструмента отброшен]\"\n\n\ndef _strip_broken_tool_blocks(text: str, *, quiet: bool = False) -> tuple[str, int]:\n    \"\"\"Вырезать сырые блоки вызова, которые не разбираются; (текст, число вырезанных).\n\n    Валидные блоки (одиночный, пачка без промежуточных закрытий), теги в markdown-коде\n    и текст без тегов остаются как есть (тот же объект, если ничего не вырезано).\n    Незакрытый хвост и закрытый невалидный блок отбрасываются. После `_STRIP_SCAN_MAX_TAGS`\n    кандидатов остаток отбрасывается целиком (fail-closed): битый тег не утекает ни при каком вводе.\n    \"\"\"\n    match = _RAW_CALL_RE.search(text)\n    if match is None:\n        return text, 0\n    parts: list[str] = []\n    cursor = 0\n    dropped = 0\n    scanned = 0\n    while match is not None:\n        start = match.start()\n        pair = _open_tag_at(text, start)\n        if pair is None:  # недостижимо: _RAW_CALL_RE начинается с тега\n            break\n        open_tag, close_tag = pair\n        pos = start + len(open_tag)\n        if _code_context(text, start, True) == \"text\":\n            if scanned >= _STRIP_SCAN_MAX_TAGS:\n                if not quiet:\n                    _log(f\"tool_strip_cap_hit max={_STRIP_SCAN_MAX_TAGS} dropping tail\")\n                parts.append(text[cursor:start])\n                cursor = len(text)\n                dropped += 1\n                break\n            scanned += 1\n            end = _find_close_in(text, pos, close_tag)\n            if end == -1:  # незакрытый хвост\n                parts.append(text[cursor:start])\n                cursor = len(text)\n                dropped += 1\n                break\n            try:\n                calls = _parse_tool_call_blocks(text[pos:end], quiet=True)\n            except RecursionError:\n                calls = None\n            pos = end + len(close_tag)\n            if calls is None:\n                parts.append(text[cursor:start])\n                cursor = pos\n                dropped += 1\n        match = _RAW_CALL_RE.search(text, pos)\n    if not dropped:\n        return text, 0\n    parts.append(text[cursor:])\n    return \"\".join(parts), dropped\n\n\nclass ToolCallParser:\n    \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n\n    Тег <tool_call> (или <tool_invoke>) может прийти разорванным между дельтами: хвост, который может\n    оказаться началом тега, удерживается и не уходит в content до разрешения.\n    \"\"\"\n\n    def __init__(self, on_content, on_tool_call):\n        self._buf = \"\"\n        self._on_content = on_content\n        self._on_tool_call = on_tool_call\n        self._history = \"\"  # весь текст, ушедший в content\n        self.tool_calls_count = 0\n        self.trailing_chars_after_tool = 0\n        self._tail_after_tool = \"\"  # весь текст после последнего вызова (для инварианта к чанкам)\n\n    def feed(self, text: str) -> None:\n        self._buf += text\n        self._drain(final=False)\n\n    def finish(self) -> None:\n        self._drain(final=True)\n\n    def has_open_tool_call(self) -> bool:\n        \"\"\"Тег открыт и ждёт закрытия (или его начало может прийти следующей дельтой).\"\"\"\n        return any(open_tag in self._buf for open_tag, _ in TOOL_CALL_TAGS) or self._pending_prefix() > 0\n\n    def _classify_open(self, after: int, final: bool) -> str:\n        \"\"\"`<tool_call>` в буфере: \"real\" | \"quoted\" (inline-код markdown) | \"wait\" (нужен следующий символ).\"\"\"\n        context = _code_context(\n            self._history + self._buf, len(self._history), final\n        )\n        if context != \"text\":\n            return \"quoted\" if context == \"code\" else \"wait\"\n        tail = self._buf[after:after + 3]\n        if not tail:\n            return \"real\" if final else \"wait\"","isEmpty":false,"exceededLimit":false,"totalLines":4022,"fileSize":200835,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2030,"endLine":2249},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-0a76aa34-d627-463f-9354-326bd7a2ea5c-13\nfc_147f52a8-d0f9-9b57-8331-436714925110_1","startedAtMs":"1792866720762","completedAtMs":"1792866721276"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-5-cdwl","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866721620}
