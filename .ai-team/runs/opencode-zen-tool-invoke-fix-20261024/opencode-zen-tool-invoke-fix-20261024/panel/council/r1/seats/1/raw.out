p_code_fence(inner))\n    except ValueError:\n        return None","isEmpty":false,"exceededLimit":false,"totalLines":4658,"fileSize":199016,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/opencode-zen-tool-invoke-fix/bridges/muse-bridge/server.py","readRange":{"startLine":830,"endLine":879},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-40598627-dd92-48bc-8ae1-eab96c945e86-24\nfc_b9f187c4-8e49-90cd-a631-1e4b91695567_3","startedAtMs":"1792866821514","completedAtMs":"1792866821901"},"model_call_id":"306f7807-0e37-4b19-beb8-40541a588c90-7-k2lb","session_id":"81f4d8b7-02cf-45e0-8b1e-62e9a8ce8268","timestamp_ms":1792866822075}
