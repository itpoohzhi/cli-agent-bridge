    in_string = False\n153|+    escaped = False\n154|+    while index < length:\n155|+        char = text[index]\n156|+        if in_string:\n157|+            if escaped:\n158|+                escaped = False\n159|+            elif char == \"\\\\\":\n160|+                escaped = True\n161|+            elif char == '\"':\n162|+                in_string = False\n163|+        elif char == '\"':\n164|+            in_string = True\n165|+        elif text.startswith(close_tag, index):\n166|+            return index\n167|+        index += 1\n168|+    return -1\n169|+\n170|+\n171|+_STRIP_SCAN_MAX_TAGS = 16  # граница CPU: `_code_context` — O(len) на кандидата\n172|+_BROKEN_BLOCK_NOTICE = \"[opencode-zen-bridge: невалидный блок вызова инструмента отброшен]\"\n173|+\n174|+\n175|+def _strip_broken_tool_blocks(text: str, *, quiet: bool = False) -> tuple[str, int]:\n176|+    \"\"\"Вырезать сырые блоки вызова, которые не разбираются; (текст, число вырезанных).\n177|+\n178|+    Валидные блоки (одиночный, пачка без промежуточных закрытий), теги в markdown-коде\n179|+    и текст без тегов остаются как есть (тот же объект, если ничего не вырезано).\n180|+    Незакрытый хвост и закрытый невалидный блок отбрасываются. После `_STRIP_SCAN_MAX_TAGS`\n181|+    кандидатов остаток отбрасывается целиком (fail-closed): битый тег не утекает ни при каком вводе.\n182|+    \"\"\"\n183|+    match = _RAW_CALL_RE.search(text)\n184|+    if match is None:\n185|+        return text, 0\n186|+    parts: list[str] = []\n187|+    cursor = 0\n188|+    dropped = 0\n189|+    scanned = 0\n190|+    while match is not None:\n191|+        start = match.start()\n192|+        pair = _open_tag_at(text, start)\n193|+        if pair is None:  # недостижимо: _RAW_CALL_RE начинается с тега\n194|+            break\n195|+        open_tag, close_tag = pair\n196|+        pos = start + len(open_tag)\n197|+        if _code_context(text, start, True) == \"text\":\n198|+            if scanned >= _STRIP_SCAN_MAX_TAGS:\n199|+                if not quiet:\n200|+                    _log(f\"tool_strip_cap_hit max={_STRIP_SCAN_MAX_TAGS} dropping tail\")\n201|+                parts.append(text[cursor:start])\n202|+                cursor = len(text)\n203|+                dropped += 1\n204|+                break\n205|+            scanned += 1\n206|+            end = _find_close_in(text, pos, close_tag)\n207|+            if end == -1:  # незакрытый хвост\n208|+                parts.append(text[cursor:start])\n209|+                cursor = len(text)\n210|+                dropped += 1\n211|+                break\n212|+            try:\n213|+                calls = _parse_tool_call_blocks(text[pos:end], quiet=True)\n214|+            except RecursionError:\n215|+                calls = None\n216|+            pos = end + len(close_tag)\n217|+            if calls is None:\n218|+                parts.append(text[cursor:start])\n219|+                cursor = pos\n220|+                dropped += 1\n221|+        match = _RAW_CALL_RE.search(text, pos)\n222|+    if not dropped:\n223|+        return text, 0\n224|+    parts.append(text[cursor:])\n225|+    return \"\".join(parts), dropped\n226|+\n227|+\n228| class ToolCallParser:\n229|     \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n230| \n231|@@ -2190,31 +2309,8 @@\n232|         return best\n233| \n234|     def _find_close_outside_string(self, start: int, close_tag: str = TOOL_CALL_CLOSE) -> int:\n235|-        \"\"\"Позиция закрывающего тега вне строковых литералов JSON, или -1.\n236|-\n237|-        Закрывающий тег внутри JSON-строки (например, значение аргумента содержит\n238|-        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n239|-        строку не закрывают.\n240|-        \"\"\"\n241|-        index = start\n242|-        length = len(self._buf)\n243|-        in_string = False\n244|-        escaped = False\n245|-        while index < length:\n246|-            char = self._buf[index]\n247|-       