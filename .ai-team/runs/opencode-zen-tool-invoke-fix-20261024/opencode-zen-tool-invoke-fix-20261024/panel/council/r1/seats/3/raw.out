al(self.muse.TOOL_CALL_CLOSE, TOOL_CALL_CLOSE)\n530| \n531| \n532|+class TestTrailingBraceRecovery(unittest.TestCase):\n533|+    \"\"\"Лишние `}` после полного объекта вызова и OpenAI-обёртка `function`: core и muse-bridge.\"\"\"\n534|+\n535|+    OPENAI = json.dumps(\n536|+        {\n537|+            \"id\": \"call_1\",\n538|+            \"type\": \"function\",\n539|+            \"function\": {\"name\": \"a\", \"arguments\": json.dumps({\"x\": 1})},\n540|+        }\n541|+    )\n542|+    A_X1 = {\"name\": \"a\", \"arguments\": {\"x\": 1}}\n543|+\n544|+    @classmethod\n545|+    def setUpClass(cls):\n546|+        cls.impls = {\"core\": core_emulation, \"muse\": _load_muse_bridge()}\n547|+\n548|+    def test_trailing_braces_recovered(self):\n549|+        base = '{\"name\":\"a\",\"arguments\":{\"x\":1}}'\n550|+        for impl, mod in self.impls.items():\n551|+            for tail in (\"}\", \"}}}\", \"}}}}\\n\", \"} }\\n}\", \"\\n}\\n\", \"}\" * 16):\n552|+                with self.subTest(impl=impl, tail=tail):\n553|+                    self.assertEqual(mod._parse_tool_call_block(base + tail), self.A_X1)\n554|+                    self.assertEqual(\n555|+                        mod._parse_tool_call_blocks(base + tail), [self.A_X1]\n556|+                    )\n557|+\n558|+    def test_valid_block_untouched(self):\n559|+        for impl, mod in self.impls.items():\n560|+            with self.subTest(impl=impl):\n561|+                self.assertEqual(\n562|+                    mod._parse_tool_call_block('{\"name\":\"a\",\"arguments\":{\"x\":1}}'),\n563|+                    self.A_X1,\n564|+                )\n565|+\n566|+    def test_trailing_garbage_not_recovered(self):\n567|+        base = '{\"name\":\"a\",\"arguments\":{\"x\":1}}'\n568|+        bad = (\n569|+            \"{broken\",\n570|+            '{\"name\":\"a\",\"arguments\":{}}, \"x\": 1}',\n571|+            base + '}, \"x\": 1}',\n572|+            base + \"}\" + \"x\",\n573|+            '{\"name\":\"a\",\"arguments\":{\"x\":1}',  # недозакрыт\n574|+            \"[1]}\",  # не объект\n575|+            base + \"}\" * 17,  # больше предела лишних скобок\n576|+            \"[\" * 100000,  # RecursionError не должен утекать\n577|+            \"{\" * 100000,\n578|+        )\n579|+        for impl, mod in self.impls.items():\n580|+            for text in bad:\n581|+                with self.subTest(impl=impl, text=text[:40]):\n582|+                    self.assertIsNone(mod._parse_tool_call_block(text))\n583|+                    self.assertIsNone(mod._parse_tool_call_blocks(text))\n584|+\n585|+    def test_openai_function_wrapper(self):\n586|+        for impl, mod in self.impls.items():\n587|+            with self.subTest(impl=impl):\n588|+                self.assertEqual(mod._parse_tool_call_block(self.OPENAI), self.A_X1)\n589|+                self.assertEqual(\n590|+                    mod._parse_tool_call_block(self.OPENAI + \"}\"), self.A_X1\n591|+                )\n592|+                # arguments как объект внутри function\n593|+                obj = {\"function\": {\"name\": \"a\", \"arguments\": {\"x\": 1}}}\n594|+                self.assertEqual(mod._parse_tool_call_block(json.dumps(obj)), self.A_X1)\n595|+\n596|+    def test_name_wins_over_function(self):\n597|+        text = '{\"name\":\"a\",\"function\":{\"name\":\"b\",\"arguments\":{\"y\":2}}}'\n598|+        for impl, mod in self.impls.items():\n599|+            with self.subTest(impl=impl):\n600|+                self.assertEqual(\n601|+                    mod._parse_tool_call_block(text), {\"name\": \"a\", \"arguments\": {}}\n602|+                )\n603|+\n604|+    def test_present_but_blank_name_is_not_unwrapped(self):\n605|+        for impl, mod in self.impls.items():\n606|+            for name in (\"\", \"  \", None, 5):\n607|+                text = json.dumps(\n608|+                    {\"name\": name, \"function\": {\"name\": \"b\", \"arguments\": {}}}\n609|+                )\n610|+                with self.subTest(impl=impl, name=name):\n611|+                    self.assertIsNone(mod._parse_tool_call_block(text))\n612|+\n613|+    def test_function_not_dict_is_rejected(self):\n614|+        for impl, mod in self.impls.items():\n615|+            for text in (\n616|+                '{\"function\": \"a\"}',\n617|+                '{\"function\": [\"a\"]}',\n618|+                '{\"function\": {\"arguments\": {}}}',\n619|+            ):\n620|+                with self.subTest(impl=impl, text=text):\n621|+                    self.assertIsNone(mod._parse_tool_call_block(text))\n622|+\n623|+    def test_batch_segment_with_extra_brace(self):\n624|+        o, cl = TOOL_CALL_OPEN, TOOL_CALL_CLOSE\n625|+        inner = '{\"name\":\"a\"} ' + o + '{\"name\":\"b\",\"arguments\":{\"x\":1}}}'\n626|+        for impl, mod in self.impls.items():\n627|+            with self.subTest(impl=impl):\n628|+                self.assertEqual(\n629|+                    mod._parse_tool_call_blocks(inner),\n630|+                    [\n631|+                        {\"name\": \"a\", \"arguments\": {}},\n632|+                        {\"name\": \"b\", \"arguments\": {\"x\": 1}},\n633|+                    ],\n634|+                )\n635|+        self.assertEqual(cl, \"</tool_call>\")\n636|+\n637|+\n638| class TestToolsSection(unittest.TestCase):\n639|     def test_protocol_and_schema_present(self):\n640|         section = _tools_section(TOOLS, None)\n641|\n642|```","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
