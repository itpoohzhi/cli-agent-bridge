-> str:\n412|     return body.strip()\n413| \n414| \n415|+_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n416|+\n417|+\n418|+def _recover_trailing_braces(text: str) -> dict | None:\n419|+    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n420|+    body = text.lstrip()\n421|+    try:\n422|+        obj, end = json.JSONDecoder().raw_decode(body)\n423|+    except (ValueError, RecursionError):\n424|+        return None\n425|+    tail = body[end:]\n426|+    if (\n427|+        isinstance(obj, dict)\n428|+        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n429|+        and not tail.strip(\" \\t\\r\\n}\")\n430|+    ):\n431|+        return obj\n432|+    return None\n433|+\n434|+\n435|+def _loads_tolerant(text: str) -> Any:\n436|+    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n437|+\n438|+    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n439|+    \"\"\"\n440|+    try:\n441|+        return json.loads(text)\n442|+    except (ValueError, RecursionError) as exc:\n443|+        recovered = _recover_trailing_braces(text)\n444|+        if recovered is None:\n445|+            if isinstance(exc, RecursionError):\n446|+                raise ValueError(\"JSON is nested too deeply\") from exc\n447|+            raise\n448|+        return recovered\n449|+\n450|+\n451| def _parse_tool_call_block(inner: str) -> dict | None:\n452|     \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n453| \n454|@@ -256,11 +292,14 @@ def _parse_tool_call_block(inner: str) -> dict | None:\n455|     отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n456|     \"\"\"\n457|     try:\n458|-        obj = json.loads(_strip_code_fence(inner))\n459|+        obj = _loads_tolerant(_strip_code_fence(inner))\n460|     except ValueError:\n461|         return None\n462|     if not isinstance(obj, dic