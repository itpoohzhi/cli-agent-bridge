 END_TURN: раннего planner_final нет, полное окно.\ntests/test_agy_bridge_resilience.py:3094:                        \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:3114:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 2, \"thinking\": \"новый шаг\"}\ntests/test_agy_bridge_resilience.py:3244:            {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 3, \"thinking\": text}, cid\ntests/test_agy_bridge_resilience.py:3300:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:3347:                        \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:3443:    fx.append_record({\"type\": \"PLANNER_RESPONSE\", \"step_index\": idx, \"thinking\": text})\ntests/test_agy_bridge_resilience.py:3525:    def test_seen_cap_evicts_oldest_when_no_finalized_below_watermark(self) -> None:\ntests/test_agy_bridge_resilience.py:3541:    def test_ao12_seen_is_bounded_and_split_utf8_is_emitted_whole(self) -> None:\ntests/test_agy_bridge_resilience.py:3740:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:4092:        \"_text_seen\": {},\ntests/test_agy_bridge_resilience.py:4215:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:4315:        reconcile = _ofn(arb, \"reconcile_result\")\ntests/test_agy_bridge_resilience.py:4326:            _ofn(empty, \"reconcile_result\")(\"только result\"), \"только result\"\ntests/test_agy_bridge_resilience.py:4330:        self.assertEqual(_ofn(broken, \"reconcile_result\")(\"xyz\"), \"\")  # несовместим\ntests/test_agy_bridge_resilience.py:4367:        # Проверка reconcile_result и fallback доставки финального ответа\ntests/test_agy_bridge_resilience.py:4368:        reconciled = _str(_ofn(run, \"reconcile_result\")(final_text))\ntests/test_agy_bridge_resilience.py:4433:        offer = _ofn(run, \"offer_content\")\ntests/test_agy_bridge_resilience.py:4447:        run_result = _ofn(run, \"reconcile_result\")\ntests/test_agy_bridge_resilience.py:4460:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 2, \"content\": \"история\"}\ntests/test_agy_bridge_resilience.py:4464:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:4471:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 7, \"content\": \"\"}\ntests/test_agy_bridge_resilience.py:4474:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 8, \"content\": \"  \"}\ntests/test_agy_bridge_resilience.py:4476:            fx.append_record({\"type\": \"PLANNER_RESPONSE\", \"content\": \"без индекса\"})\ntests/test_agy_bridge_resilience.py:4478:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 9, \"content\": \"финал\"}\ntests/test_agy_bridge_resilience.py:5306:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 0, \"thinking\": \"h0\"},\ntests/test_agy_bridge_resilience.py:5307:                {\"type\": \"PLANNER_RESPONSE\", \"step_index\": 1, \"thinking\": \"h1\"},\ntests/test_agy_bridge_resilience.py:5322:            fx.append_record({\"type\": \"PLANNER_RESPONSE\", \"step_index\": 2})\ntests/test_agy_bridge_resilience.py:5993:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:6338:    def test_silent_f004_reconcile_result_divergence_is_retained(self) -> None:\ntests/test_agy_bridge_resilience.py:6341:        self.assertEqual(_ofn(arb, \"reconcile_result\")(\"совсем другое\"), \"\")\ntests/test_agy_bridge_resilience.py:6398:            run.reconcile_result = reconcile\ntests/test_agy_bridge_resilience.py:8682:    \"\"\"PLANNER_RESPONSE с верхнеуровневыми счётчиками; `_OMIT` убирает ключ.\"\"\"\ntests/test_agy_bridge_resilience.py:8684:        \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:8753:            \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:13615:        offer = _ofn(run, \"offer_content\")\ntests/test_agy_bridge_resilience.py:13691:                True,  # isolate_tool_preambles=True\ntests/test_agy_bridge_resilience.py:13698:                    \"type\": \"PLANNER_RESPONSE\",\ntests/test_agy_bridge_resilience.py:13707:                    \"type\": \"PLANNER_RESPONSE\",\n    всей истории на каждый чанк нет. При исчерпании лимитов приём прекращается с\n    явным `overflow` (accepted-текст молча не отбрасывается и не переотдаётся).\n    \"\"\"\n\n    def __init__(self, turn_id: str) -> None:\n        self.turn_id = turn_id\n        self.by_key: dict[tuple[str, str, int], _ArbStep] = {}\n        self.step_count = 0\n        self.eq_index: dict[str, list[_ArbStep]] = {}\n        self.sorted_texts: list[str] = []\n        # Те же индексы в разрезе источника-создателя: кандидат с валидным idx\n        # сверяется только с шагами ДРУГИХ источников, без скана одноимённых.\n        self._eq_by_source: dict[str, dict[str, list[_ArbStep]]] = {}\n        self._sorted_by_source: dict[str, list[str]] = {}\n        self.retained_divergent: list[str] = []\n        self.retained_divergent_bytes = 0\n        self.last_step: _ArbStep | None = None\n        self.last_by_source: dict[str, _ArbStep] = {}\n        self.chunks: list[str] = []\n        self.bytes_total = 0\n        self.overflow = False\n        self.divergences = 0\n        self.probes = 0\n        self.last_result_diverged = False\n\n    def _set_overflow(self, why: str) -> None:\n        if not self.overflow:\n            self.overflow = True\n            _log(f\"content-overflow turn={self.turn_id[:8] or '-'} why={why}\")\n\n    def _retain_divergent(self, text: str) -> None:\n        \"\"\"Удержать расходящийся текст (до MAX_RETAINED_DIVERGENT_BYTES суммарно).\"\"\"\n        room = MAX_RETAINED_DIVERGENT_BYTES - self.retained_divergent_bytes\n        if room <= 0 or not text:\n            return\n        data = text.encode(\"utf-8\")\n        if len(data) > room:\n            text = data[:room].decode(\"utf-8\", \"ignore\")\n            data = text.encode(\"utf-8\")\n        if text:\n            self.retained_divergent.append(text)\n            self.retained_divergent_bytes += len(data)\n\n    def retained_divergent_text(self) -> str:\n        return \"\".join(self.retained_divergent)\n\n    @staticmethod\n    def _drop(\n        eq: dict[str, list[_ArbStep]],\n        texts: list[str],\n        step: _ArbStep,\n        old: str,\n    ) -> None:\n        bucket = eq.get(old)\n        if bucket is None:\n            return\n        bucket.remove(step)\n        if not bucket:\n            del eq[old]\n            pos = bisect.bisect_left(texts, old)\n            if pos < len(texts) and texts[pos] == old:\n                del texts[pos]\n\n    @staticmethod\n    def _put(\n        eq: dict[str, list[_ArbStep]], texts: list[str], step: _ArbStep, text: str\n    ) -> None:\n        bucket = eq.setdefault(text, [])\n        if not bucket:\n            bisect.insort(texts, text)\n        bucket.append(step)\n\n    def _unindex(self, step: _ArbStep) -> None:\n        old = step.emitted\n        if not old:\n            return\n        self._drop(self.eq_index, self.sorted_texts, step, old)\n        self._drop(\n            self._eq_by_source.setdefault(step.origin, {}),\n            self._sorted_by_source.setdefault(step.origin, []),\n            step,\n            old,\n        )\n\n    def _index(self, step: _ArbStep, text: str) -> None:\n        self._put(self.eq_index, self.sorted_texts, step, text)\n        self._put(\n            self._eq_by_source.setdefault(step.origin, {}),\n            self._sorted_by_source.setdefault(step.origin, []),\n            step,\n            text,\n        )\n\n    def _eligible(self, step: _ArbStep, source: str, idx: int | None) -> bool:\n        self.probes += 1\n        return idx is None or step.origin != source\n\n    def _match(self, source: str, idx: int | None, text: str) -> _ArbStep | None:\n        \"\"\"Шаг, к которому относится кандидат без прямого ключа (уровень 2).\"\"\"\n        if idx is None:\n            found = self._scan(self.eq_index, self.sorted_texts, source, idx, text)\n        else:\n            # Валидный idx: подходят только шаги других источников; одноимённые\n            # (N одинаковых шагов одного источника) не просматриваются вовсе.\n            found = None\n            for other, eq in self._eq_by_source.items():\n                if other == source:\n                    continue\n                found = self._scan(eq, self._sorted_by_source[other], source, idx, text)\n                if found is not None:\n                    break\n        if found is not None:\n            return found\n        refs: list[_ArbStep] = []\n        if self.last_step is not None:\n            refs.append(self.last_step)\n        for other, step in self.last_by_source.items():\n            if other != source and step not in refs:\n                refs.append(step)\n        for step in refs:\n            if (\n                step.emitted\n                and text.startswith(step.emitted)\n                and self._eligible(step, source, idx)\n            ):\n                return step\n        return None\n\n    def _scan(\n        self,\n        eq: dict[str, list[_ArbStep]],\n        texts: list[str],\n        source: str,\n        idx: int | None,\n        text: str,\n    ) -> _ArbStep | None:\n        for step in eq.get(text, ()):\n            if self._eligible(step, source, idx):\n                return step\n        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\n        if candidates:\n            candidates.sort(key=len, reverse=True)\n            for cand in candidates:\n                for step in eq[cand]:\n                    if self._eligible(step, source, idx):\n                        return step\n        if idx is None:\n            pos = bisect.bisect_left(texts, text)\n            while pos < len(texts) and texts[pos].startswith(text):\n                for step in eq[texts[pos]]:\n                    if step.origin != source and self._eligible(step, source, idx):\n                        return step\n                pos += 1\n        return None\n\n    def _advance(self, step: _ArbStep, source: str, text: str) -> str:\n        if step.frozen:\n            return \"\"\n        prefix = step.emitted\n        if text == prefix or (len(text) < len(prefix) and prefix.startswith(text)):\n            return \"\"\n        if not text.startswith(prefix):\n            step.frozen = True\n            self._retain_divergent(text)\n            self.divergences += 1\n            _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source={source}\")\n            return \"\"\n        suffix = text[len(prefix) :]\n        size = len(suffix.encode(\"utf-8\"))\n        if self.bytes_total + size > MAX_CONTENT_BYTES_PER_TURN:\n            self._set_overflow(\"bytes\")\n            return \"\"\n        self._unindex(step)\n        step.emitted = text\n        self._index(step, text)\n        self.chunks.append(suffix)\n        self.bytes_total += size\n        self.last_step = step\n        self.last_by_source[source] = step\n        return suffix\n\n    def offer(self, source: str, step_index: object, text: str, cid: str = \"\") -> str:\n        \"\"\"Кумулятивный снимок -> новый суффикс ('' — дубль, префикс или заморозка).\"\"\"\n        if self.overflow or not text:\n            return \"\"\n        idx = (\n            step_index\n            if isinstance(step_index, int)\n            and not isinstance(step_index, bool)\n            and step_index >= 0\n            else None\n        )\n        key = (self.turn_id, cid, idx) if idx is not None else None\n        step = self.by_key.get(key) if key is not None else None\n        if step is None:\n            step = self._match(source, idx, text)\n            if step is None:\n                if self.step_count >= MAX_CONTENT_STEPS:\n                    self._set_overflow(\"steps\")\n                    return \"\"\n                step = _ArbStep(source)\n                self.step_count += 1\n            if key is not None:\n                if len(self.by_key) >= 4 * MAX_CONTENT_STEPS:\n                    self._set_overflow(\"aliases\")\n                    return \"\"\n                self.by_key[key] = step\n        return self._advance(step, source, text)\n\n    def reconcile_result(self, text: str) -> str:\n        \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n        self.last_result_diverged = False\n        if self.overflow or not text:\n            return \"\"\n        emitted = \"\".join(self.chunks)\n        if not emitted:\n            if self.step_count >= MAX_CONTENT_STEPS:\n                self._set_overflow(\"steps\")\n                return \"\"\n            self.step_count += 1\n            return self._advance(_ArbStep(\"result\"), \"result\", text)\n        if text == emitted or emitted.startswith(text):\n            return \"\"\n        if text.startswith(emitted):\n            if self.step_count >= MAX_CONTENT_STEPS:\n                self._set_overflow(\"steps\")\n                return \"\"\n            self.step_count += 1\n            return self._advance(_ArbStep(\"result\"), \"result\", text[len(emitted) :])\n        if text in self.eq_index:\n            self.probes += 1\n            return \"\"\n        pos = bisect.bisect_left(self.sorted_texts, text)\n        if pos < len(self.sorted_texts) and self.sorted_texts[pos].startswith(text):\n            self.probes += 1\n            return \"\"\n        last = self.last_step\n        if last is not None and last.emitted and text.startswith(last.emitted):\n            return self._advance(last, \"result\", text)\n        self._retain_divergent(text)\n        self.divergences += 1\n        self.last_result_diverged = True\n        _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n        return \"\"\n\n\ndef _safe_tool_name(raw: object) -> str:\n    \"\"\"Имя инструмента для маркера: только закрытый список, всё остальное -> `tool`.\"\"\"\n    if not isinstance(raw, str):\n        return \"tool\"\n    name = raw.strip()\n    if (\n        not name\n        or len(name) > 128\n        or name[0] in \"/.\"\n        or \"..\" in name\n        or re.fullmatch(r\"[A-Za-z0-9_:./-]+\", name) is None\n    ):\n        return \"tool\"\n    bare = re.split(r\"[:./]\", name)[-1]\n    if bare in TOOL_NAME_ALLOWLIST or _SAFE_MCP_TOOL_RE.fullmatch(bare) is not None:\n        return bare\n    return \"tool\"\n\n\ndef _format_tool_marker(safe_name: str) -> str:\n    def _transcript_file(self) -> Path | None:\n        \"\"\"Файл транскрипта: прежний путь; при usage_enabled — закреплённый на попытку.\n\n        Приоритет `transcript_full.jsonl`, при ENOENT — `transcript.jsonl`; пока ни\n        одного файла нет, проверка повторяется, а найденный путь не меняется до конца\n        попытки (появившийся позже full не подменяет смещение другого файла).\n        \"\"\"\n        if not self.usage_enabled:\n            return _transcript_path(self.cid)\n        if self._path is None:\n            self._path = _select_transcript_path(self.cid)\n        return self._path\n\n    # ---- счётчики usage ------------------------------------------------------------\n    def _record_usage(self, rec: dict[str, object]) -> None:\n        \"\"\"Учесть счётчики `PLANNER_RESPONSE` текущего хода за O(1) без хранения текста.\"\"\"\n        records = self.step_records_by_index\n        if records is None:\n            return\n        self._usage_dirty = True\n        idx = rec.get(\"step_index\")\n        if (\n            not isinstance(idx, int)\n            or isinstance(idx, bool)\n            or idx < 0\n            or idx < self.base_idx\n        ):\n            self._usage_invalid += 1  # шаг без пригодного индекса не атрибутируется\n            return\n        inp = _count_or_none(rec.get(\"input_tokens\"))\n        out = _count_or_none(rec.get(\"output_tokens\"))\n        cache_raw = rec.get(\"cache_read_tokens\")\n        cache = _count_or_none(cache_raw)\n        counts: tuple[int, int | None, int] | None = None\n        if (\n            inp is not None\n            and out is not None\n            and (cache_raw is None or cache is not None)\n        ):\n            counts = (inp, cache, out)\n        if idx in records:\n            if counts is not None:\n                old = records[idx]\n                self._usage_out_sum += counts[2] - (old[2] if old is not None else 0)\n                records[idx] = counts\n        elif len(records) < USAGE_STEP_CAP:\n            records[idx] = counts\n            if counts is not None:\n                self._usage_out_sum += counts[2]\n        else:\n            # Насыщение: ключ не вставляется, сумма output считается неполной.\n            self.observed_planner_steps_saturated = True\n        if counts is None:\n            self._usage_invalid += 1\n            return\n        last = self.last_valid_step_index\n        if last is None or idx >= last:\n            self.last_valid_step_index = idx\n            self.last_step_usage = (idx, counts[0], counts[1], counts[2])\n\n    def _publish_usage(self) -> None:\n        \"\"\"Опубликовать неизменяемый снимок под коротким замком (без I/O под замком).\"\"\"\n        records = self.step_records_by_index\n        if records is None:\n            return\n        observed = len(records)\n        snap = _UsageSnapshot(\n            last_step_usage=self.last_step_usage,\n            turn_output_tokens_sum=self._usage_out_sum,\n            observed_planner_steps=observed,\n            observed_planner_steps_saturated=self.observed_planner_steps_saturated,\n            completeness=(\n                observed > 0\n                and not self.observed_planner_steps_saturated\n                and self._usage_invalid == 0\n            ),\n            invalid_records_count=self._usage_invalid,\n        )\n        self._usage_dirty = False\n        with self._usage_lock:\n            self._usage_snapshot = snap\n\n    def usage_snapshot(self) -> _UsageSnapshot:\n        with self._usage_lock:\n            return self._usage_snapshot\n\n    def _emit_record(self, raw: bytes) -> None:\n        line = raw.strip()\n        if not line:\n            return\n        if (\n            b\"PLANNER_RESPONSE\" not in line\n            and b\"END_TURN\" not in line\n            and b\"TURN_COMPLETE\" not in line\n        ):\n            return  # быстрый отсев служебных записей без разбора JSON\n        try:\n            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n        except ValueError:\n            return\n        if not isinstance(parsed, dict):\n            return\n        rec = cast(\"dict[str, object]\", parsed)\n        rtype = str(rec.get(\"type\") or \"\")\n        idx = _as_int(rec.get(\"step_index\"))\n        if idx is not None and idx < self.base_idx:\n            return  # история прошлых ходов\n        if self._in_rewrite:\n            self._note_activity()\n        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n            self.end_marker = True\n            return\n        if rtype != \"PLANNER_RESPONSE\":\n            return\n        if self.usage_enabled:\n            self._record_usage(rec)\n        content = rec.get(\"content\")\n        emit_content = self.emit_content\n        has_tools = bool(rec.get(\"tool_calls\"))\n        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n        if emit_content is not None and isinstance(content, str) and content.strip():\n            if has_tools and isolate_tools:\n                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n            else:\n                _ = emit_content(\n                    idx, content\n                )  # live planner-текст, независимо от tool_calls\n        if idx is None:\n            return\n        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n            self.final_planner = True\n        thinking = rec.get(\"thinking\")\n        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n\n    # ---- состояние шагов -----------------------------------------------------------\n    def _state(self, idx: int) -> _StepState:\n        state = self.seen.get(idx)\n        if state is not None:\n            return state\n        if len(self.seen) >= MAX_STEPS_TRACKED:\n            evictable = [\n                k\n                for k, s in self.seen.items()\n                if s.finalized and k < self.poll_watermark\n            ]\n            if evictable:\n                del self.seen[min(evictable)]\n            else:\n                self._sqlite_off(\"seen_cap\")\n                del self.seen[min(self.seen)]\n        state = _StepState()\n        self.seen[idx] = state\n        return state\n\n    def _step_done(self, state: _StepState) -> bool:\n        return state.sql_done or (\n            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n        )\n\n    def _advance_watermark(self) -> None:\n        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n        mark = self.poll_watermark\n        for key in sorted(self.seen):\n            if key < mark:\n                continue\n            if not self._step_done(self.seen[key]):\n                break\n            mark = key + 1\n        self.poll_watermark = mark\n\n    def _emit_delta(self, idx: int, state: _StepState, delta: str, source: str) -> bool:\n        def delivered() -> None:\n            state.delivered_len += len(delta)\n            state.delivered_sha.update(delta.encode(\"utf-8\"))\n\n        ok = self.emit(idx, delta, delivered)\n        if not ok:\n            self.dead = True\n            return False\n        self.emitted += 1\n        self._note_activity()\n                self._cap_logged = True\n            else:\n                self._reasoning_bytes += size\n                self.q.put((\"reasoning\", delta))\n                if on_delivered is not None:\n                    on_delivered()\n                return True\n            total = self._reasoning_bytes\n        cid8 = self._tail.cid[:8] or \"-\"\n        if outcome == \"late\":\n            _log(f\"reasoning-late-drop cid={cid8} step={idx} len={len(delta)}\")\n        elif log_cap:\n            _log(f\"reasoning-cap cid={cid8} bytes={total}\")\n        return False\n\n    def _close_and_put_done(self, kind: str, payload: object) -> None:\n        \"\"\"Атомарно закрыть выдачу мышления и поставить терминальное событие (один раз).\"\"\"\n        with self._emit_lock:\n            if self._done_put:\n                return\n            self._done_put = True\n            self.drain_closed = True\n            self.q.put((kind, payload))\n\n    def note_producer_activity(self, source: str) -> None:\n        \"\"\"Новый прогресс producer'а (stdout/transcript): продлевает idle, не зависит от CPU.\"\"\"\n        now = time.monotonic()\n        with self._activity_lock:\n            self.last_producer_activity_ts = now\n            if source == \"transcript\":\n                self.transcript_activity_ts = now\n\n    def _on_tail_activity(self) -> None:\n        self.note_producer_activity(\"transcript\")\n\n    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n        \"\"\"Кандидат planner-текста в арбитр; новый суффикс уходит в очередь под _emit_lock.\n\n        Сокетного ввода-вывода здесь нет: потребитель (`_execute`) пишет в сокет сам.\n        False — выдача уже закрыта terminal barrier'ом.\n        \"\"\"\n        with self._emit_lock:\n            if self.drain_closed:\n                return False\n            suffix = self._arbiter.offer(\n                source, step_index, text, self._tail.cid or self.run_cid\n            )\n            if suffix:\n                sep = \"\"\n                last_idx = getattr(self, \"_last_step_index\", None)\n                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n                if last_idx is not None and last_idx != step_index and emitted_wire:\n                    if not emitted_wire.endswith(\"\\n\"):\n                        sep = (\n                            \"\\n\\n\"\n                            if not suffix.startswith(\"\\n\")\n                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n                        )\n                    elif not emitted_wire.endswith(\"\\n\\n\"):\n                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n                self._last_step_index = step_index\n                self._content_emitted_wire = emitted_wire + sep + suffix\n                self.q.put((\"text\", sep + suffix))\n        return True\n\n    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n        return self.offer_content(\"transcript\", step_index, text)\n\n    def reconcile_result(self, text: str) -> str:\n        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром.\"\"\"\n        with self._emit_lock:\n            return self._arbiter.reconcile_result(text)\n\n    def retained_divergent_text(self) -> str:\n        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n        with self._emit_lock:\n            return self._arbiter.retained_divergent_text()\n\n    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n        заморозка выдачи и остаток очереди ДО terminal marker'а.\n\n        Процесс при этом ещё жив: окно дренирования хвоста открывает `_proc_done`.\n        Возвращает необработанные потребителем события (\"text\"/\"reasoning\"/\"tool_trace\").\n        \"\"\"\n        started = time.monotonic()\n        join_budget = budget_s\n        if getattr(self, \"usage_enabled\", False):\n            # Один монотонный дедлайн попытки от EOF/первого drain: content-drain и\n            # usage-drain делят его, второго окна нет.\n            t0 = getattr(self, \"_drain_t0\", None)\n            t0 = started if t0 is None else t0\n            self._drain_t0 = t0\n            limit = t0 + min(budget_s, DRAIN_MAX_S)\n            if not getattr(self._tail, \"drain_deadline\", 0.0):\n                self._tail.drain_deadline = min(limit, t0 + DRAIN_WINDOW_S)\n            join_budget = max(0.0, limit - started)\n        else:\n            self._tail.drain_deadline = started + min(budget_s, DRAIN_WINDOW_S)\n        self._proc_done.set()\n        thread = self._tail.thread\n        if thread is not threading.current_thread():\n            thread.join(timeout=max(0.0, join_budget - (time.monotonic() - started)))\n        with self._emit_lock:\n            self.drain_closed = True\n            self._done_put = True\n        events: list[tuple[str, object]] = []\n        while True:\n            try:\n                kind, payload = self.q.get_nowait()\n            except queue.Empty:\n                break\n            if kind in (\"text\", \"reasoning\", \"tool_trace\"):\n                events.append((kind, payload))\n        return events\n\n    def usage_snapshot(self) -> _UsageSnapshot:\n        \"\"\"Снимок счётчиков хода; пока поток tail жив, полнота суммы не гарантируется.\"\"\"\n        getter = getattr(self._tail, \"usage_snapshot\", None)\n        snap = getter() if callable(getter) else _EMPTY_USAGE_SNAPSHOT\n        thread = getattr(self._tail, \"thread\", None)\n        if (\n            snap.completeness\n            and thread is not None\n            and thread is not threading.current_thread()\n            and thread.is_alive()\n        ):\n            return replace(snap, completeness=False)\n        return snap\n\n    def _feed_stdin(self) -> None:\n        \"\"\"Отдать промпт на stdin и закрыть поток: agy читает stdin до EOF.\"\"\"\n        try:\n            self.proc.stdin.write(self.stdin_line.encode(\"utf-8\"))\n            self.proc.stdin.flush()\n        except (BrokenPipeError, OSError, ValueError):\n            pass\n        finally:\n            try:\n                self.proc.stdin.close()\n            except (BrokenPipeError, OSError, ValueError):\n                pass\n            self.proc.stdin = None\n\n    def _drain_stderr(self) -> None:\n        \"\"\"Читать stderr построчно, держать только хвост: он идёт в error-ответ.\"\"\"\n        head: list = []\n        try:\n            for raw in iter(self.proc.stderr.readline, b\"\"):\n                line = raw.decode(\"utf-8\", \"replace\").rstrip()\n                if not line or _NOISE.search(line):\n    \"\"\"Число для лога; всё остальное — `missing` (исходная строка не печатается).\"\"\"\n    count = _count_or_none(value)\n    return \"missing\" if count is None else str(count)\n\n\ndef _resolve_step_usage(\n    out: dict, snap: _UsageSnapshot, window: int | None, resume: bool\n) -> dict[str, object]:\n    \"\"\"Один неизменяемый wire-`usage` попытки; сырой `out[\"usage\"]` не мутируется.\n\n    Порядок: валидный последний шаг транскрипта (измеренное окно, без clamp) ->\n    ограниченная оценка для успешного хода с накопительным raw выше окна ->\n    result-only (input + cache, без clamp).\n    \"\"\"\n    raw_obj = out.get(\"usage\")\n    raw = cast(\"dict[str, object]\", raw_obj) if isinstance(raw_obj, dict) else {}\n    raw_in = _count_or_none(raw.get(\"input_tokens\"))\n    raw_out = _count_or_none(raw.get(\"output_tokens\"))\n    raw_th = _count_or_none(raw.get(\"thinking_tokens\"))\n    raw_cache, conflict = _raw_cache_tokens(raw)\n    details: dict[str, int] | None\n    inconsistent = False\n    reason = \"\"\n    step_idx: int | None = None\n    last = snap.last_step_usage\n    if last is not None:\n        source = \"last_step\"\n        step_idx, last_in, last_cache, _last_out = last\n        prompt = last_in + (last_cache if last_cache is not None else 0)\n        details, inconsistent = normalize_prompt_cache_details(prompt, last_cache)\n        if snap.completeness:\n            completion = snap.turn_output_tokens_sum\n        else:\n            completion = 0\n            reason = \"ledger_incomplete\"\n            _log(\n                \"usage-step-ledger-incomplete observed_steps=%d saturated=%d \"\n                \"invalid_records=%d raw_output=%s raw_thinking=%s\"\n                % (\n                    snap.observed_planner_steps,\n                    int(snap.observed_planner_steps_saturated),\n                    snap.invalid_records_count,\n                    _num_text(raw_out),\n                    _num_text(raw_th),\n                )\n            )\n    else:\n        result_obj = out.get(\"result\")\n        result = (\n            cast(\"dict[str, object]\", result_obj)\n            if isinstance(result_obj, dict)\n            else {}\n        )\n        success = (\n            out.get(\"rc\") == 0\n            and out.get(\"state\") == \"done\"\n            and str(result.get(\"status\") or \"\").upper() != \"ERROR\"\n            and not result.get(\"error\")\n        )\n        cache_sum = raw_cache if raw_cache is not None else 0\n        over_window = (\n            window is not None\n            and raw_in is not None\n            and (raw_in >= window or raw_in + cache_sum > window)\n        )\n        if success and window is not None and raw_in is not None and over_window:\n            source = \"cumulative_estimate\"\n            turns = _count_or_none(out.get(\"num_turns\")) or 0\n            tools = _count_or_none(out.get(\"tool_events\")) or 0\n            divisor = max(2, turns + tools, snap.observed_planner_steps)\n            prompt = min(raw_in // divisor, window - 1)\n            reason = \"over_window\"\n        else:\n            source = \"result\"\n            prompt = (raw_in or 0) + cache_sum\n            reason = (\n                \"alias_conflict\"\n                if conflict\n                else \"not_success\"\n                if not success\n                else \"no_window\"\n                if window is None\n                else \"within_window\"\n            )\n        details, inconsistent = normalize_prompt_cache_details(prompt, raw_cache)\n        # Без ledger область raw output известна только у свежего разговора.\n        if not resume and snap.observed_planner_steps == 0:\n            completion = (raw_out or 0) + (raw_th or 0)\n        else:\n            completion = 0\n        if source == \"cumulative_estimate\":\n            _log(\n                \"usage-cumulative-fallback raw_in=%s raw_cache=%s window=%d n=%d \"\n                \"prompt=%d turns=%d tools=%d observed_steps=%d inconsistent=%d \"\n                \"raw_output=%s raw_thinking=%s\"\n                % (\n                    _num_text(raw_in),\n                    _num_text(raw_cache),\n                    cast(int, window),\n                    divisor,\n                    prompt,\n                    turns,\n                    tools,\n                    snap.observed_planner_steps,\n                    int(inconsistent),\n                    _num_text(raw_out),\n                    _num_text(raw_th),\n                )\n            )\n    wire: dict[str, object] = {\n        \"prompt_tokens\": prompt,\n        \"completion_tokens\": completion,\n        \"total_tokens\": prompt + completion,\n    }\n    if details is not None:\n        wire[\"prompt_tokens_details\"] = details\n    return {\n        \"wire\": wire,\n        \"source\": source,\n        \"reason\": reason,\n        \"step_idx\": step_idx,\n        \"completeness\": snap.completeness,\n        \"inconsistent\": inconsistent,\n        \"cached\": details[\"cached_tokens\"] if details is not None else None,\n        \"raw_in\": raw_in,\n        \"raw_out\": raw_out,\n        \"raw_thinking\": raw_th,\n        \"raw_total\": _count_or_none(raw.get(\"total_tokens\")),\n        \"raw_cache\": raw_cache,\n    }\n\n\ndef _usage_log_fields(resolved: object) -> str:\n    \"\"\"Числовая диагностика usage для строки done; пусто, если usage не нормализовался.\"\"\"\n    if not isinstance(resolved, dict):\n        return \"\"\n    info = cast(\"dict[str, object]\", resolved)\n    wire = cast(\"dict[str, object]\", info.get(\"wire\") or {})\n    return (\n        \" usage_source=%s reason=%s step_idx=%s prompt=%s cached=%s completion=%s \"\n        \"total=%s completeness=%d inconsistent=%d raw_in=%s raw_out=%s \"\n                        return finish(\n                            \"timeout\",\n                            124,\n                            f\"proxy timeout after {TIMEOUT_S}s\",\n                            float(TIMEOUT_S),\n                        )\n                    # wd_reason == \"child_exited\": штатно, \"done\"/\"pump_error\" придут из очереди\n                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n                    last_ka = time.monotonic()\n                    if not keepalive():\n                        return state(\"client_gone\", 1)\n                continue\n            if kind in _ACTIVITY_KINDS:\n                run.controller.on_activity(kind)\n            if kind == \"init\":\n                conversation_id = str(payload.get(\"conversation_id\") or \"\")\n                _log(\n                    f\"init conversation={conversation_id[:8] or '-'} \"\n                    f\"tools={payload.get('tools')} \"\n                    f\"permission_mode={payload.get('permission_mode')}\"\n                )\n            elif kind == \"reasoning\":\n                add_reasoning(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"text\":\n                add_content(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"tool_trace\":\n                tool_events += 1\n                if not on_tool_trace(payload):\n                    gone[0] = True\n                    return state(\"client_gone\", 1)\n            elif kind == \"result\":\n                result_ev = payload\n                usage = payload.get(\"usage\") or {}\n                conversation_id = str(payload.get(\"conversation_id\") or conversation_id)\n                if str(payload.get(\"status\") or \"\").upper() == \"ERROR\":\n                    # Не выходим по result ERROR: мышление последнего шага ещё в очереди\n                    # перед done, и оно обязано попасть в out до решения о повторе.\n                    message = str(payload.get(\"error\") or \"agy reported an error\")\n                    result_error = message[:500]\n                    result_error_at = time.monotonic()\n            elif kind == \"pump_error\":\n                return finish(\"pump_error\", 1, str(payload))\n            elif kind == \"done\":\n                rc, final_text, raw_result = payload\n                if result_error:\n                    return state(\"agy_error\", 1, result_error)\n                if not result_ev and raw_result:\n                    result_ev = raw_result\n                if content_streaming or usage_enabled:\n                    # Хвост транскрипта, записанный прямо перед done, дренируется\n                    # ДО reconcile: result.response — агрегат, досылается лишь недостающее.\n                    # При usage_enabled тот же drain — барьер счётчиков шагов (единый\n                    # дедлайн попытки <= T_DRAIN_MAX_S, второго окна нет).\n                    drain = getattr(run, \"terminal_drain\", None)\n                    if callable(drain):\n                        deliver(list(drain(T_DRAIN_MAX_S)))\n                if content_streaming:\n                    delta = run.reconcile_result(final_text)\n                    if delta:\n                        add_content(delta)\n                    elif final_text and getattr(run._arbiter, \"last_result_diverged\", False):\n                        full_emitted = \"\".join(pieces)\n                        sep = (\n                            \"\\n\\n\"\n                            if full_emitted and not full_emitted.endswith(\"\\n\")\n                            else (\n                                \"\\n\"\n                                if full_emitted and not full_emitted.endswith(\"\\n\\n\")\n                                else \"\"\n                            )\n                        )\n                        _log(\n                            f\"content-reconcile-fallback \"\n                            f\"turn={getattr(run, 'turn_id', '')[:8] or '-'} \"\n                            f\"len={len(final_text)}\"\n                        )\n                        add_content(sep + final_text if full_emitted else final_text)\n                elif not pieces and final_text:\n                    add_content(final_text)\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n                time.sleep(0.05)\n                err = \"\".join(run.err_box).strip()\n                status = str(result_ev.get(\"status\") or \"\").upper()\n                if rc != 0 and (status == \"ERROR\" or not pieces):\n                    return state(\n                        \"agy_error\",\n                        rc,\n                        (str(result_ev.get(\"error\") or \"\") or err)[:500],\n                    )\n                return state(\"done\", rc, err)\n\n    @staticmethod\n    def _attach_resolved_usage(run: object, out: dict, model: object) -> None:\n        \"\"\"Финальный выбор формы usage один раз на попытку, после terminal drain.\n\n        Флаг выключен на финализации — usage остаётся прежним (legacy). Иначе\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"Проверяю отдельно два практических риска: повторную выдачу текста при реконсиляции и обход изоляции через stdout. Для L3 также сверю, что именно измеряет раннер и что означает его PASS.\n"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba bridges/agy-bridge/server.py | sed -n '4510,4600p'; nl -ba bridges/agy-bridge/server.py | sed -n '5430,5520p'; nl -ba tests/test_agy_bridge_resilience.py | sed -n '4330,4390p'; nl -ba tests/test_agy_bridge_resilience.py | sed -n '13590,13750p'; nl -ba bridges/agy-bridge/server.py | sed -n '3995,4038p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba bridges/agy-bridge/server.py | sed -n '4510,4600p'; nl -ba bridges/agy-bridge/server.py | sed -n '5430,5520p'; nl -ba tests/test_agy_bridge_resilience.py | sed -n '4330,4390p'; nl -ba tests/test_agy_bridge_resilience.py | sed -n '13590,13750p'; nl -ba bridges/agy-bridge/server.py | sed -n '3995,4038p'\"","aggregated_output":"  4510\t            self._usage_snapshot = snap\n  4511\t\n  4512\t    def usage_snapshot(self) -> _UsageSnapshot:\n  4513\t        with self._usage_lock:\n  4514\t            return self._usage_snapshot\n  4515\t\n  4516\t    def _emit_record(self, raw: bytes) -> None:\n  4517\t        line = raw.strip()\n  4518\t        if not line:\n  4519\t            return\n  4520\t        if (\n  4521\t            b\"PLANNER_RESPONSE\" not in line\n  4522\t            and b\"END_TURN\" not in line\n  4523\t            and b\"TURN_COMPLETE\" not in line\n  4524\t        ):\n  4525\t            return  # быстрый отсев служебных записей без разбора JSON\n  4526\t        try:\n  4527\t            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n  4528\t        except ValueError:\n  4529\t            return\n  4530\t        if not isinstance(parsed, dict):\n  4531\t            return\n  4532\t        rec = cast(\"dict[str, object]\", parsed)\n  4533\t        rtype = str(rec.get(\"type\") or \"\")\n  4534\t        idx = _as_int(rec.get(\"step_index\"))\n  4535\t        if idx is not None and idx < self.base_idx:\n  4536\t            return  # история прошлых ходов\n  4537\t        if self._in_rewrite:\n  4538\t            self._note_activity()\n  4539\t        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n  4540\t            self.end_marker = True\n  4541\t            return\n  4542\t        if rtype != \"PLANNER_RESPONSE\":\n  4543\t            return\n  4544\t        if self.usage_enabled:\n  4545\t            self._record_usage(rec)\n  4546\t        content = rec.get(\"content\")\n  4547\t        emit_content = self.emit_content\n  4548\t        has_tools = bool(rec.get(\"tool_calls\"))\n  4549\t        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n  4550\t        if emit_content is not None and isinstance(content, str) and content.strip():\n  4551\t            if has_tools and isolate_tools:\n  4552\t                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n  4553\t            else:\n  4554\t                _ = emit_content(\n  4555\t                    idx, content\n  4556\t                )  # live planner-текст, независимо от tool_calls\n  4557\t        if idx is None:\n  4558\t            return\n  4559\t        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n  4560\t            self.final_planner = True\n  4561\t        thinking = rec.get(\"thinking\")\n  4562\t        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n  4563\t\n  4564\t    # ---- состояние шагов -----------------------------------------------------------\n  4565\t    def _state(self, idx: int) -> _StepState:\n  4566\t        state = self.seen.get(idx)\n  4567\t        if state is not None:\n  4568\t            return state\n  4569\t        if len(self.seen) >= MAX_STEPS_TRACKED:\n  4570\t            evictable = [\n  4571\t                k\n  4572\t                for k, s in self.seen.items()\n  4573\t                if s.finalized and k < self.poll_watermark\n  4574\t            ]\n  4575\t            if evictable:\n  4576\t                del self.seen[min(evictable)]\n  4577\t            else:\n  4578\t                self._sqlite_off(\"seen_cap\")\n  4579\t                del self.seen[min(self.seen)]\n  4580\t        state = _StepState()\n  4581\t        self.seen[idx] = state\n  4582\t        return state\n  4583\t\n  4584\t    def _step_done(self, state: _StepState) -> bool:\n  4585\t        return state.sql_done or (\n  4586\t            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n  4587\t        )\n  4588\t\n  4589\t    def _advance_watermark(self) -> None:\n  4590\t        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n  4591\t        mark = self.poll_watermark\n  4592\t        for key in sorted(self.seen):\n  4593\t            if key < mark:\n  4594\t                continue\n  4595\t            if not self._step_done(self.seen[key]):\n  4596\t                break\n  4597\t            mark = key + 1\n  4598\t        self.poll_watermark = mark\n  4599\t\n  4600\t    def _emit_delta(self, idx: int, state: _StepState, delta: str, source: str) -> bool:\n  5430\t        \"\"\"Разбор NDJSON agy 1.3.1.\n  5431\t\n  5432\t        `step_update.agent_response` несёт накопительный `text_delta` — наружу\n  5433\t        уходит только хвост. `step_update.tool` — трассировка нативного\n  5434\t        инструмента (в stderr моста). `result` — финальный текст, usage, ошибка.\n  5435\t\n  5436\t        После EOF: ждём выход процесса не дольше PROC_EXIT_WAIT_S, затем даём\n  5437\t        источнику мышления дренировать окно DRAIN_WINDOW_S (join с бюджетом) и\n  5438\t        только потом ставим (\"done\", …). Терминальное событие кладётся ровно один\n  5439\t        раз в `finally`, поэтому очередь закрывается при любом исходе.\n  5440\t        \"\"\"\n  5441\t        final_text = \"\"\n  5442\t        result_ev = {}\n  5443\t        tool_ordinal = 0\n  5444\t        tool_ordinal_by_id: dict[str, int] = {}\n  5445\t        term_kind = \"pump_error\"\n  5446\t        term_payload: object = \"pump terminated\"\n  5447\t        try:\n  5448\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n  5449\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n  5450\t                if not line.startswith(\"{\"):\n  5451\t                    continue\n  5452\t                try:\n  5453\t                    ev = json.loads(line)\n  5454\t                except ValueError:\n  5455\t                    continue\n  5456\t                self.got_event = True\n  5457\t                self.note_producer_activity(\"stdout\")\n  5458\t                etype = ev.get(\"event\")\n  5459\t                if etype == \"init\":\n  5460\t                    init = ev.get(\"init\") if isinstance(ev.get(\"init\"), dict) else {}\n  5461\t                    tools_raw = cast(object, init.get(\"tools\"))\n  5462\t                    tools = (\n  5463\t                        cast(\"list[object]\", tools_raw)\n  5464\t                        if isinstance(tools_raw, list)\n  5465\t                        else []\n  5466\t                    )\n  5467\t                    self.q.put(\n  5468\t                        (\n  5469\t                            \"init\",\n  5470\t                            {\n  5471\t                                \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n  5472\t                                \"tools\": len(tools),\n  5473\t                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n  5474\t                            },\n  5475\t                        )\n  5476\t                    )\n  5477\t                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n  5478\t                elif etype == \"step_update\":\n  5479\t                    step = (\n  5480\t                        ev.get(\"step_update\")\n  5481\t                        if isinstance(ev.get(\"step_update\"), dict)\n  5482\t                        else {}\n  5483\t                    )\n  5484\t                    kind = step.get(\"step_type\")\n  5485\t                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n  5486\t                        if self.content_streaming:\n  5487\t                            _ = self.offer_content(\n  5488\t                                \"stdout\",\n  5489\t                                _as_int(step.get(\"step_index\")),\n  5490\t                                str(step[\"text_delta\"]),\n  5491\t                            )\n  5492\t                        else:\n  5493\t                            suffix = _reasoning_suffix(\n  5494\t                                self._text_seen,\n  5495\t                                str(step.get(\"step_index\", \"\")),\n  5496\t                                str(step[\"text_delta\"]),\n  5497\t                            )\n  5498\t                            if suffix:\n  5499\t                                self.q.put((\"text\", suffix))\n  5500\t                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n  5501\t                        step_idx = _as_int(step.get(\"step_index\"))\n  5502\t                        trace: dict[str, object] = {\n  5503\t                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n  5504\t                            \"duration_s\": step.get(\"duration_seconds\"),\n  5505\t                            \"step_index\": step_idx,\n  5506\t                        }\n  5507\t                        if step_idx is None:\n  5508\t                            # Идентичность DONE без step_index: монотонный ordinal хода,\n  5509\t                            # назначается один раз и переживает повторную доставку события.\n  5510\t                            raw_id = (\n  5511\t                                step.get(\"call_id\")\n  5512\t                                or step.get(\"tool_call_id\")\n  5513\t                                or step.get(\"id\")\n  5514\t                            )\n  5515\t                            call_id = (\n  5516\t                                str(raw_id).strip()\n  5517\t                                if isinstance(raw_id, (str, int))\n  5518\t                                else \"\"\n  5519\t                            )\n  5520\t                            if call_id:\n  4330\t        self.assertEqual(_ofn(broken, \"reconcile_result\")(\"xyz\"), \"\")  # несовместим\n  4331\t        self.assertEqual(_oval(broken, \"divergences\"), 1)\n  4332\t\n  4333\t    def test_status_streaming_multi_step_no_freeze_and_final_text_delivered(\n  4334\t        self,\n  4335\t    ) -> None:\n  4336\t        statuses = [\n  4337\t            \"[статус: чтение канона AGENTS.md]\",\n  4338\t            \"[статус: дочитывание канона]\",\n  4339\t            \"[статус: поиск информации]\",\n  4340\t        ]\n  4341\t        final_text = \"### Детальный анализ переезда...\"\n  4342\t        lines: list[dict[str, object]] = []\n  4343\t        for status in statuses:\n  4344\t            lines.append(_stdout_text(None, status))\n  4345\t            lines.append(_stdout_tool(_MISSING))\n  4346\t        lines.append(\n  4347\t            {\n  4348\t                \"event\": \"result\",\n  4349\t                \"result\": {\n  4350\t                    \"status\": \"success\",\n  4351\t                    \"response\": final_text,\n  4352\t                },\n  4353\t            }\n  4354\t        )\n  4355\t\n  4356\t        run, items = _pump_queue(lines, content=True)\n  4357\t        text_chunks = [\n  4358\t            str(payload)\n  4359\t            for kind, payload in items\n  4360\t            if kind == \"text\"\n  4361\t        ]\n  4362\t        self.assertEqual(text_chunks, statuses)\n  4363\t        arb = _oval(run, \"_arbiter\")\n  4364\t        self.assertEqual(_oval(arb, \"divergences\"), 0)\n  4365\t        self.assertFalse(_oval(arb, \"overflow\"))\n  4366\t\n  4367\t        # Проверка reconcile_result и fallback доставки финального ответа\n  4368\t        reconciled = _str(_ofn(run, \"reconcile_result\")(final_text))\n  4369\t        retained = _str(_ofn(arb, \"retained_divergent_text\")())\n  4370\t        self.assertEqual(retained, final_text)\n  4371\t        delivered = reconciled if reconciled else (\"\\n\\n\" + final_text)\n  4372\t        self.assertEqual(\n  4373\t            \"\".join(text_chunks) + delivered,\n  4374\t            \"\".join(statuses) + \"\\n\\n\" + final_text,\n  4375\t        )\n  4376\t\n  4377\t    def test_content_scan_matches_saved_prefix_not_longer_snapshot(self) -> None:\n  4378\t        arb = _arb()\n  4379\t        old_text = \"[статус: чтение канона AGENTS.md]\"\n  4380\t        short_text = \"[статус: \"\n  4381\t        new_text = \"[статус: дочитывание канона]\"\n  4382\t\n  4383\t        self.assertEqual(_offer(arb, \"stdout\", 1, old_text), old_text)\n  4384\t\n  4385\t        # Короткий снимок другого шага не должен стать alias старого.\n  4386\t        self.assertEqual(_offer(arb, \"transcript\", 2, short_text), short_text)\n  4387\t        self.assertEqual(\n  4388\t            _offer(arb, \"transcript\", 2, new_text),\n  4389\t            \"дочитывание канона]\",\n  4390\t        )\n 13590\t        with _Fixture() as fx:\n 13591\t            fx.set_env(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", None)\n 13592\t            clock = _clocked(fx)\n 13593\t            flag = _bfn(\"_new_flag\")\n 13594\t            self.assertTrue(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13595\t            _write_cfg(fx, {\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\": False}, 1_000)\n 13596\t            clock.advance(2)\n 13597\t            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13598\t            _write_cfg(fx, '{\"stream_resilience_enabled\":\"false\"}', 2_000)\n 13599\t            clock.advance(2)\n 13600\t            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13601\t            _write_cfg(fx, {\"stream_resilience_enabled\": True}, 3_000)\n 13602\t            clock.advance(2)\n 13603\t            self.assertTrue(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13604\t\n 13605\t\n 13606\tclass StreamFormattingAndReasoningIsolationTests(unittest.TestCase):\n 13607\t    \"\"\"Детерминированные тесты L1 на разграничение строк, сопоставление префиксов и изоляцию reasoning.\"\"\"\n 13608\t\n 13609\t    def test_step_boundary_newline_separation(self) -> None:\n 13610\t        \"\"\"VER-001 / REQ-001: Текст независимых шагов планировщика разделяется \\\\n\\\\n без склеивания слов.\"\"\"\n 13611\t        run = _bare_run()\n 13612\t        setattr(run, \"_arbiter\", _arb())\n 13613\t        setattr(run, \"turn_id\", \"turn-fmt-1\")\n 13614\t        setattr(run, \"run_cid\", _CID)\n 13615\t        offer = _ofn(run, \"offer_content\")\n 13616\t\n 13617\t        # Шаг 1: завершается точкой без перевода строки\n 13618\t        self.assertTrue(offer(\"stdout\", 1, \"Завершаю поиск данных.\"))\n 13619\t        # Шаг 2: начинается со слова с заглавной буквы\n 13620\t        self.assertTrue(offer(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\"))\n 13621\t        # Шаг 3: завершается с переводом строки\n 13622\t        self.assertTrue(offer(\"stdout\", 3, \"Следующее действие.\\n\"))\n 13623\t        # Шаг 4: начинается без перевода строки\n 13624\t        self.assertTrue(offer(\"stdout\", 4, \"Финальный результат.\"))\n 13625\t\n 13626\t        q = cast(\"queue.Queue[tuple[str, object]]\", _oval(run, \"q\"))\n 13627\t        chunks = [cast(str, q.get_nowait()[1]) for _ in range(q.qsize())]\n 13628\t        combined = \"\".join(chunks)\n 13629\t\n 13630\t        # Проверяем, что нет слитного \"данных.Проверяю\"\n 13631\t        self.assertNotIn(\"данных.Проверяю\", combined)\n 13632\t        self.assertIn(\"Завершаю поиск данных.\\n\\nПроверяю вывод лога задачи 349.\", combined)\n 13633\t        self.assertIn(\"Следующее действие.\\n\\nФинальный результат.\", combined)\n 13634\t\n 13635\t    def test_arbiter_no_prefix_repetition_on_divergence(self) -> None:\n 13636\t        \"\"\"VER-002 / REQ-002: Короткие префиксы новых шагов не вызывают лавины повторов [гейт...\"\"\"\n 13637\t        arb = _arb()\n 13638\t        step1_text = \"[гейт оркестрации: активен | роль: explorer] Читаю канон AGENTS.md\"\n 13639\t        step2_prefix = \"[гейт оркестрации: активен\"\n 13640\t        step2_full = \"[гейт оркестрации: активен | роль: worker] Запускаю тесты pytest\"\n 13641\t\n 13642\t        # Шаг 1\n 13643\t        self.assertEqual(_offer(arb, \"transcript\", 1, step1_text), step1_text)\n 13644\t\n 13645\t        # Шаг 2 начинается с префикса, совпадающего с шагом 1\n 13646\t        delta_prefix = _offer(arb, \"transcript\", 2, step2_prefix)\n 13647\t        self.assertEqual(delta_prefix, step2_prefix)\n 13648\t        self.assertEqual(_oval(arb, \"divergences\"), 0)\n 13649\t\n 13650\t        # Шаг 2 досылает полный текст\n 13651\t        delta_full = _offer(arb, \"transcript\", 2, step2_full)\n 13652\t        self.assertEqual(delta_full, step2_full[len(step2_prefix):])\n 13653\t        self.assertEqual(_oval(arb, \"divergences\"), 0)\n 13654\t\n 13655\t        # Проверяем, что в chunks нет зацикленного повтора\n 13656\t        chunks = _oval(arb, \"chunks\")\n 13657\t        joined = \"\".join(chunks)\n 13658\t        self.assertEqual(joined.count(\"[гейт оркестрации: активен\"), 2)\n 13659\t\n 13660\t    def test_tool_preamble_isolated_to_reasoning(self) -> None:\n 13661\t        \"\"\"VER-003 / REQ-003: Сервисная преамбула шага с tool_calls изолируется в reasoning, сохраняя <Think>.\"\"\"\n 13662\t        with _Fixture() as fx:\n 13663\t            content_emitted: list[tuple[int | None, str]] = []\n 13664\t            reasoning_emitted: list[tuple[int, str]] = []\n 13665\t\n 13666\t            def emit_content(idx: int | None, text: str) -> bool:\n 13667\t                content_emitted.append((idx, text))\n 13668\t                return True\n 13669\t\n 13670\t            def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n 13671\t                reasoning_emitted.append((idx, delta))\n 13672\t                if on_del is not None:\n 13673\t                    on_del()\n 13674\t                return True\n 13675\t\n 13676\t            plan = _bfn(\"_TurnPlan\")()\n 13677\t            setattr(plan, \"mode\", \"OFF\")\n 13678\t            setattr(plan, \"base_idx\", 0)\n 13679\t            setattr(plan, \"offset\", 0)\n 13680\t\n 13681\t            tail = _bfn(\"_TranscriptTail\")(\n 13682\t                emit_reasoning,\n 13683\t                threading.Event(),\n 13684\t                threading.Event(),\n 13685\t                False,\n 13686\t                plan,\n 13687\t                \"turn-reasoning-1\",\n 13688\t                emit_content,\n 13689\t                None,\n 13690\t                False,\n 13691\t                True,  # isolate_tool_preambles=True\n 13692\t            )\n 13693\t            setattr(tail, \"cid\", _CID)\n 13694\t\n 13695\t            # Шаг 1: содержит tool_calls и преамбулу в content\n 13696\t            fx.append_record(\n 13697\t                {\n 13698\t                    \"type\": \"PLANNER_RESPONSE\",\n 13699\t                    \"step_index\": 1,\n 13700\t                    \"content\": \"Ищу скилл analyst-teamlead и проверяю базу знаний\",\n 13701\t                    \"tool_calls\": [{\"name\": \"read_file\", \"args\": {\"Path\": \"/tmp/test\"}}],\n 13702\t                }\n 13703\t            )\n 13704\t            # Шаг 2: финальный ответ пользователю (без tool_calls)\n 13705\t            fx.append_record(\n 13706\t                {\n 13707\t                    \"type\": \"PLANNER_RESPONSE\",\n 13708\t                    \"step_index\": 2,\n 13709\t                    \"content\": \"Вот согласованный ответ для пользователя.\",\n 13710\t                }\n 13711\t            )\n 13712\t\n 13713\t            _ = _ofn(tail, \"_read_transcript\")()\n 13714\t\n 13715\t            # В content должен попасть ТОЛЬКО финальный ответ шага 2\n 13716\t            self.assertEqual(len(content_emitted), 1)\n 13717\t            self.assertEqual(content_emitted[0], (2, \"Вот согласованный ответ для пользователя.\"))\n 13718\t\n 13719\t            # В reasoning должна попасть сервисная преамбула шага 1\n 13720\t            reasoning_texts = [delta for _, delta in reasoning_emitted]\n 13721\t            self.assertTrue(any(\"Ищу скилл analyst-teamlead\" in t for t in reasoning_texts))\n 13722\t\n  3995\t                    return \"\"\n  3996\t                self.by_key[key] = step\n  3997\t        return self._advance(step, source, text)\n  3998\t\n  3999\t    def reconcile_result(self, text: str) -> str:\n  4000\t        \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n  4001\t        self.last_result_diverged = False\n  4002\t        if self.overflow or not text:\n  4003\t            return \"\"\n  4004\t        emitted = \"\".join(self.chunks)\n  4005\t        if not emitted:\n  4006\t            if self.step_count >= MAX_CONTENT_STEPS:\n  4007\t                self._set_overflow(\"steps\")\n  4008\t                return \"\"\n  4009\t            self.step_count += 1\n  4010\t            return self._advance(_ArbStep(\"result\"), \"result\", text)\n  4011\t        if text == emitted or emitted.startswith(text):\n  4012\t            return \"\"\n  4013\t        if text.startswith(emitted):\n  4014\t            if self.step_count >= MAX_CONTENT_STEPS:\n  4015\t                self._set_overflow(\"steps\")\n  4016\t                return \"\"\n  4017\t            self.step_count += 1\n  4018\t            return self._advance(_ArbStep(\"result\"), \"result\", text[len(emitted) :])\n  4019\t        if text in self.eq_index:\n  4020\t            self.probes += 1\n  4021\t            return \"\"\n  4022\t        pos = bisect.bisect_left(self.sorted_texts, text)\n  4023\t        if pos < len(self.sorted_texts) and self.sorted_texts[pos].startswith(text):\n  4024\t            self.probes += 1\n  4025\t            return \"\"\n  4026\t        last = self.last_step\n  4027\t        if last is not None and last.emitted and text.startswith(last.emitted):\n  4028\t            return self._advance(last, \"result\", text)\n  4029\t        self._retain_divergent(text)\n  4030\t        self.divergences += 1\n  4031\t        self.last_result_diverged = True\n  4032\t        _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n  4033\t        return \"\"\n  4034\t\n  4035\t\n  4036\tdef _safe_tool_name(raw: object) -> str:\n  4037\t    \"\"\"Имя инструмента для маркера: только закрытый список, всё остальное -> `tool`.\"\"\"\n  4038\t    if not isinstance(raw, str):\n","exit_code":0,"status":"completed"}}
