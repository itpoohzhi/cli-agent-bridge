744156d891ddcb534ff1a4a0649bd371f21de5b66657e6a35bb72c\",\"setup\":\"default\",\"stage\":\"council\",\"status\":\"READY\",\"triplet_rule\":\"A\",\"unavailable_evidence\":{}}\ndiff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\nindex f876e36..2179ca1 100644\n--- a/bridges/agy-bridge/server.py\n+++ b/bridges/agy-bridge/server.py\n@@ -2953,6 +2953,7 @@ class _RuntimeFlags(NamedTuple):\n     graceful_timeout_on_partial: bool = False\n     step_scoped_usage_enabled: bool = False\n     stream_resilience_enabled: bool = True\n+    isolate_tool_preambles_to_reasoning: bool = True\n     graceful_timeout_finish_reason: str = \"stop\"\n \n \n@@ -2963,6 +2964,7 @@ _NEW_FLAG_ENV = {\n     \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n     \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n     \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n+    \"isolate_tool_preambles_to_reasoning\": \"AGY_ISOLATE_TOOL_PREAMBLES_TO_REASONING\",\n }\n _ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n _ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n@@ -2989,10 +2991,22 @@ def _parse_runtime_flags(text: str) -> _RuntimeFlags:\n         default = getattr(_COLD_FLAGS, name)\n         if name == \"stream_resilience_enabled\":\n             default = raw.get(_NEW_FLAG_ENV[name], default)\n-        value = raw.get(name, default)\n         if name == \"graceful_timeout_finish_reason\":\n-            finish_reason = value if isinstance(value, str) else \"stop\"\n+            raw_val = raw.get(\"graceful_timeout_finish_reason\")\n+            if raw_val is None:\n+                raw_val = raw.get(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", default)\n+            if isinstance(raw_val, str):\n+                s = raw_val.strip().lower()\n+                if s in (\"length\", \"max_tokens\"):\n+                    finish_reason = \"length\"\n+                elif s == \"stop\":\n+                    finish_reason = \"stop\"\n+                else:\n+                    finish_reason = \"stop\"\n+            else:\n+                finish_reason = \"stop\"\n             continue\n+        value = raw.get(name, default)\n         if not isinstance(value, bool):\n             raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n         values[name] = value\n@@ -3065,12 +3079,14 @@ def _graceful_finish_reason() -> str:\n \n     Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\n     graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\n-    Значение 'max_tokens' нормализуется в 'length'.\n+    Значение 'max_tokens' нормализуется в 'length'. Невалидный непустой env\n+    переопределяет конфиг и даёт 'stop'.\n     \"\"\"\n-    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", \"\").strip().lower()\n-    if raw_env in (\"length\", \"max_tokens\"):\n-        return \"length\"\n-    if raw_env == \"stop\":\n+    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\")\n+    if raw_env is not None and raw_env.strip():\n+        s = raw_env.strip().lower()\n+        if s in (\"length\", \"max_tokens\"):\n+            return \"length\"\n         return \"stop\"\n     snap = _runtime_snapshot()\n     val = snap.graceful_timeout_finish_reason.strip().lower()\n@@ -3794,6 +3810,7 @@ class _ContentArbiter:\n         self.overflow = False\n         self.divergences = 0\n         self.probes = 0\n+        self.last_result_diverged = False\n \n     def _set_overflow(self, why: str) -> None:\n         if not self.overflow:\n@@ -3909,12 +3926,20 @@ class _ContentArbiter:\n         for step in eq.get(text, ()):\n             if self._eligible(step, source, idx):\n                 return step\n-        pos = bisect.bisect_left(texts, text)\n-        while pos < len(texts) and texts[pos].startswith(text):\n-            for step in eq[texts[pos]]:\n-                if self._eligible(step, source, idx):\n-                    return step\n-            pos += 1\n+        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\n+        if candidates:\n+            candidates.sort(key=len, reverse=True)\n+            for cand in candidates:\n+                for step in eq[cand]:\n+                    if self._eligible(step, source, idx):\n+                        return step\n+        if idx is None:\n+            pos = bisect.bisect_left(texts, text)\n+            while pos < len(texts) and texts[pos].startswith(text):\n+                for step in eq[texts[pos]]:\n+                    if step.origin != source and self._eligible(step, source, idx):\n+                        return step\n+                pos += 1\n         return None\n \n     def _advance(self, step: _ArbStep, source: str, text: str) -> str:\n@@ -3973,6 +3998,7 @@ class _ContentArbiter:\n \n     def reconcile_result(self, text: str) -> str:\n         \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n+        self.last_result_diverged = False\n         if self.overflow or not text:\n             return \"\"\n         emitted = \"\".join(self.chunks)\n@@ -4002,6 +4028,7 @@ class _ContentArbiter:\n             return self._advance(last, \"result\", text)\n         self._retain_divergent(text)\n         self.divergences += 1\n+        self.last_result_diverged = True\n         _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n         return \"\"\n \n@@ -4157,10 +4184,12 @@ class _TranscriptTail:\n         emit_content: Callable[[int | None, str], bool] | None = None,\n         on_activity: Callable[[], None] | None = None,\n         usage_enabled: bool = False,\n+        isolate_tool_preambles: bool = False,\n     ) -> None:\n         self.emit = emit\n         # PLANNER_RESPONSE.content -> арбитр (AD-001); None — прежнее поведение.\n         self.emit_content = emit_content\n+        self.isolate_tool_preambles = isolate_tool_preambles\n         # Реальный прогресс транскрипта/SQLite текущего хода -> producer activity (AD-003).\n         self.on_activity = on_activity\n         # Дедлайн потока: синхронизируется с effective_max_timeout_s политики (AD-003).\n@@ -4516,10 +4545,15 @@ class _TranscriptTail:\n             self._record_usage(rec)\n         content = rec.get(\"content\")\n         emit_content = self.emit_content\n+        has_tools = bool(rec.get(\"tool_calls\"))\n+        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n         if emit_content is not None and isinstance(content, str) and content.strip():\n-            _ = emit_content(\n-                idx, content\n-            )  # live planner-текст, независимо от tool_calls\n+            if has_tools and isolate_tools:\n+                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n+            else:\n+                _ = emit_content(\n+                    idx, content\n+                )  # live planner-текст, независимо от tool_calls\n         if idx is None:\n             return\n         if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n@@ -5188,6 +5222,8 @@ class Run:\n         # Арбитр planner-контента двух источников (AD-001): работает под _emit_lock.\n         self.content_streaming = _new_flag(\"planner_content_streaming_enabled\")\n         self._arbiter = _ContentArbiter(self.turn_id)\n+        self._last_step_index: object = None\n+        self._content_emitted_wire: str = \"\"\n         # Реальная активность producer'ов (stdout/transcript), независимо от cpu_delta.\n         self._activity_lock = threading.Lock()\n         self.last_producer_activity_ts: float = self.started\n@@ -5203,6 +5239,7 @@ class Run:\n             emit_content=self._offer_transcript if self.content_streaming else None,\n             on_activity=self._on_tail_activity,\n             usage_enabled=self.usage_enabled,\n+            isolate_tool_preambles=_new_flag(\"isolate_tool_preambles_to_reasoning\", True),\n         )\n         if policy is not None:\n             self._tail.deadline_s = policy.effective_max_timeout_s + 60.0\n@@ -5278,7 +5315,21 @@ class Run:\n                 source, step_index, text, self._tail.cid or self.run_cid\n             )\n             if suffix:\n-                self.q.put((\"text\", suffix))\n+                sep = \"\"\n+                last_idx = getattr(self, \"_last_step_index\", None)\n+                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n+                if last_idx is not None and last_idx != step_index and emitted_wire:\n+                    if not emitted_wire.endswith(\"\\n\"):\n+                        sep = (\n+                            \"\\n\\n\"\n+                            if not suffix.startswith(\"\\n\")\n+                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n+                        )\n+                    elif not emitted_wire.endswith(\"\\n\\n\"):\n+                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n+                self._last_step_index = step_index\n+                self._content_emitted_wire = emitted_wire + sep + suffix\n+                self.q.put((\"text\", sep + suffix))\n         return True\n \n     def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n@@ -6207,7 +6258,26 @@ class Handler(BaseHTTPRequestHandler):\n                     if callable(drain):\n                         deliver(list(drain(T_DRAIN_MAX_S)))\n                 if content_streaming:\n-                    add_content(run.reconcile_result(final_text))\n+                    delta = run.reconcile_result(final_text)\n+                    if delta:\n+                        add_content(delta)\n+                    elif final_text and getattr(run._arbiter, \"last_result_diverged\", False):\n+                        full_emitted = \"\".join(pieces)\n+                        sep = (\n+                            \"\\n\\n\"\n+                            if full_emitted and not full_emitted.endswith(\"\\n\")\n+                            else (\n+                                \"\\n\"\n+                                if full_emitted and not full_emitted.endswith(\"\\n\\n\")\n+                                else \"\"\n+                            )\n+                        )\n+                        _log(\n+                            f\"content-reconcile-fallback \"\n+                            f\"turn={getattr(run, 'turn_id', '')[:8] or '-'} \"\n+                            f\"len={len(final_text)}\"\n+                        )\n+                        add_content(sep + final_text if full_emitted else final_text)\n                 elif not pieces and final_text:\n                     add_content(final_text)\n                 if gone[0]:\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n     3\t\n     4\tПозволяет автоматически проверять доступность и работоспособность моделей из\n     5\tканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n     6\t\n     7\tИспользование:\n     8\t    python3 scripts/smoke_models.py --dry-run\n     9\t    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n    10\t    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport os\n    18\tfrom pathlib import Path\n    19\timport re\n    20\timport sys\n    21\timport time\n    22\timport urllib.error\n    23\timport urllib.request\n    24\tfrom typing import Any, NamedTuple\n    25\t\n    26\t\n    27\tDEFAULT_MODELS_MD = Path(\n    28\t    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n    29\t).expanduser()\n    30\tDEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n    31\t\n    32\t\n    33\tclass ModelEntry(NamedTuple):\n    34\t    role: str\n    35\t    model_id: str\n    36\t    effort: str\n    37\t    family: str\n    38\t\n    39\t\n    40\tdef parse_models_md(path: Path) -> list[ModelEntry]:\n    41\t    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    42\t    if not path.is_file():\n    43\t        # Fallback на локальный список, если файл канона недоступен\n    44\t        return [\n    45\t            ModelEntry(\"Coder\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n    46\t            ModelEntry(\"Coder\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n    47\t            ModelEntry(\"Coder\", \"gemini-4-argon-high\", \"high\", \"Google\"),\n    48\t            ModelEntry(\"Coder\", \"muse-wonder-full-1.0\", \"xhigh\", \"Meta\"),\n    49\t            ModelEntry(\"Architect\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n    50\t            ModelEntry(\"Reviewer\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n    51\t        ]\n    52\t\n    53\t    content = path.read_text(encoding=\"utf-8\")\n    54\t    entries: list[ModelEntry] = []\n    55\t    current_role = \"General\"\n    56\t\n    57\t    # Регулярное выражение для строк вида:\n    58\t    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    59\t    row_pattern = re.compile(\n    60\t        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    61\t    )\n    62\t\n    63\t    for line in content.splitlines():\n    64\t        line = line.strip()\n    65\t        if line.startswith(\"### \"):\n    66\t            header = line[4:].strip()\n    67\t            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n    68\t            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n    69\t            continue\n    70\t\n    71\t        match = row_pattern.match(line)\n    72\t        if match:\n    73\t            model_id = match.group(1).strip()\n    74\t            effort = match.group(2).strip()\n    75\t            family = match.group(3).strip()\n    76\t            # Пропускаем заголовки таблиц\n    77\t            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n    78\t                continue\n    79\t            entries.append(ModelEntry(current_role, model_id, effort, family))\n    80\t\n    81\t    # Дедупликация по паре (role, model_id)\n    82\t    seen = set()\n    83\t    unique_entries = []\n    84\t    for e in entries:\n    85\t        key = (e.role, e.model_id)\n    86\t        if key not in seen:\n    87\t            seen.add(key)\n    88\t            unique_entries.append(e)\n    89\t\n    90\t    return unique_entries\n    91\t\n    92\t\n    93\tdef mask_secret(text: str) -> str:\n    94\t    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n    95\t    return re.sub(\n    96\t        r\"(Bearer\\s+)[a-zA-Z0-9_\\-\\.]{8,}\",\n    97\t        r\"\\1[MASKED]\",\n    98\t        text,\n    99\t        flags=re.IGNORECASE,\n   100\t    )\n   101\t\n   102\t\n   103\tdef smoke_test_model(\n   104\t    hub_url: str,\n   105\t    model_id: str,\n   106\t    timeout_s: float = 15.0,\n   107\t    api_key: str = \"test-smoke-key\",\n   108\t) -> tuple[bool, str, float]:\n   109\t    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n   110\t    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n   111\t    payload = {\n   112\t        \"model\": model_id,\n   113\t        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n   114\t        \"max_tokens\": 10,\n   115\t        \"stream\": False,\n   116\t    }\n   117\t    data_bytes = json.dumps(payload).encode(\"utf-8\")\n   118\t    req = urllib.request.Request(\n   119\t        endpoint,\n   120\t        data=data_bytes,\n   121\t        headers={\n   122\t            \"Content-Type\": \"application/json\",\n   123\t            \"Authorization\": f\"Bearer {api_key}\",\n   124\t        },\n   125\t        method=\"POST\",\n   126\t    )\n   127\t\n   128\t    t0 = time.monotonic()\n   129\t    try:\n   130\t        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n   131\t            elapsed = time.monotonic() - t0\n   132\t            status_code = resp.getcode()\n   133\t            if status_code != 200:\n   134\t                return False, f\"HTTP {status_code}\", elapsed\n   135\t            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n   136\t            res_json = json.loads(raw_body)\n   137\t            choices = res_json.get(\"choices\") or []\n   138\t            if not choices:\n   139\t                return False, \"Empty choices\", elapsed\n   140\t            return True, \"OK\", elapsed\n   141\t    except urllib.error.HTTPError as e:\n   142\t        elapsed = time.monotonic() - t0\n   143\t        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n   144\t        return False, err_msg, elapsed\n   145\t    except Exception as e:\n   146\t        elapsed = time.monotonic() - t0\n   147\t        return False, mask_secret(f\"Error: {e}\"), elapsed\n   148\t\n   149\t\n   150\tdef main() -> int:\n   151\t    parser = argparse.ArgumentParser(\n   152\t        description=\"Smoke test runner for models defined in models.md\"\n   153\t    )\n   154\t    parser.add_argument(\n   155\t        \"--models-md\",\n   156\t        type=Path,\n   157\t        default=DEFAULT_MODELS_MD,\n   158\t        help=\"Path to Context/models.md\",\n   159\t    )\n   160\t    parser.add_argument(\n   161\t        \"--hub-url\",\n   162\t        type=str,\n   163\t        default=DEFAULT_HUB_URL,\n   164\t        help=\"URL of the bridge hub endpoint\",\n   165\t    )\n   166\t    parser.add_argument(\n   167\t        \"--model\",\n   168\t        type=str,\n   169\t        default=\"\",\n   170\t        help=\"Filter by specific model ID\",\n   171\t    )\n   172\t    parser.add_argument(\n   173\t        \"--dry-run\",\n   174\t        action=\"store_true\",\n   175\t        help=\"Validate configuration and parse models without sending network requests\",\n   176\t    )\n   177\t    parser.add_argument(\n   178\t        \"--live\",\n   179\t        action=\"store_true\",\n   180\t        help=\"Execute live HTTP smoke requests against the hub\",\n   181\t    )\n   182\t    parser.add_argument(\n   183\t        \"--timeout\",\n   184\t        type=float,\n   185\t        default=15.0,\n   186\t        help=\"Request timeout in seconds\",\n   187\t    )\n   188\t\n   189\t    args = parser.parse_args()\n   190\t\n   191\t    models = parse_models_md(args.models_md)\n   192\t    if args.model:\n   193\t        models = [m for m in models if m.model_id == args.model]\n   194\t\n   195\t    if not models:\n   196\t        print(\"FAIL: No models found matching criteria.\")\n   197\t        return 1\n   198\t\n   199\t    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n   200\t    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n   201\t    print(\"-\" * 88)\n   202\t\n   203\t    all_ok = True\n   204\t    for entry in models:\n   205\t        if args.dry_run or not args.live:\n   206\t            status = \"CONFIGURED\"\n   207\t            latency_str = \"-\"\n   208\t        else:\n   209\t            ok, status, lat = smoke_test_model(\n   210\t                args.hub_url, entry.model_id, timeout_s=args.timeout\n   211\t            )\n   212\t            latency_str = f\"{lat:.2f}s\"\n   213\t            if not ok:\n   214\t                all_ok = False\n   215\t\n   216\t        print(\n   217\t            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n   218\t        )\n   219\t\n   220\t    if args.dry_run:\n   221\t        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n   222\t        return 0\n   223\t\n   224\t    if not args.live:\n   225\t        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n   226\t        return 0\n   227\t\n   228\t    return 0 if all_ok else 1\n   229\t\n   230\t\n   231\tif __name__ == \"__main__\":\n   232\t    sys.exit(main())\n     1\t\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n     2\t\n     3\tПроверяет:\n     4\t1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n     5\t2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n     6\t3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n     7\t4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n     8\t\"\"\"\n     9\t\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport importlib.util\n    13\timport json\n    14\timport os\n    15\tfrom pathlib import Path\n    16\timport queue\n    17\timport re\n    18\timport sys\n    19\timport threading\n    20\timport unittest\n    21\tfrom types import SimpleNamespace\n    22\tfrom typing import Any, cast\n    23\t\n    24\t_REPO_ROOT = Path(__file__).resolve().parents[1]\n    25\tif str(_REPO_ROOT) not in sys.path:\n    26\t    sys.path.insert(0, str(_REPO_ROOT))\n    27\t\n    28\t_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n    29\t\n    30\t\n    31\tdef _load_bridge() -> Any:\n    32\t    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n    33\t    spec = importlib.util.spec_from_file_location(\n    34\t        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n    35\t    )\n    36\t    assert spec is not None and spec.loader is not None\n    37\t    module = importlib.util.module_from_spec(spec)\n    38\t    sys.modules[spec.name] = module\n    39\t    spec.loader.exec_module(module)\n    40\t    return module\n    41\t\n    42\t\n    43\tsrv = _load_bridge()\n    44\t\n    45\t\n    46\tclass SyntheticE2EAgentStreamTests(unittest.TestCase):\n    47\t    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n    48\t\n    49\t    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n    50\t        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n    51\t        run = object.__new__(srv.Run)\n    52\t        setattr(run, \"_emit_lock\", threading.Lock())\n    53\t        setattr(run, \"q\", queue.Queue())\n    54\t        setattr(run, \"drain_closed\", False)\n    55\t        setattr(run, \"_done_put\", False)\n    56\t        setattr(run, \"_reasoning_bytes\", 0)\n    57\t        setattr(run, \"_cap_logged\", False)\n    58\t        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n    59\t        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n    60\t        setattr(run, \"turn_id\", \"turn-e2e-1\")\n    61\t        setattr(run, \"run_cid\", \"cid-test-e2e\")\n    62\t        setattr(run, \"_last_step_index\", None)\n    63\t        setattr(run, \"_content_emitted_wire\", \"\")\n    64\t\n    65\t        # Эмулируем шаги из скриншота пользователя:\n    66\t        # Шаг 1: \"Ищу в базе знаний и git посл\"\n    67\t        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n    68\t        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n    69\t        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n    70\t        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n    71\t        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n    72\t        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n    73\t        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n    74\t\n    75\t        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n    76\t        emitted_chunks: list[str] = []\n    77\t        while not q.empty():\n    78\t            item = q.get_nowait()\n    79\t            if item[0] == \"text\":\n    80\t                emitted_chunks.append(str(item[1]))\n    81\t\n    82\t        full_stream = \"\".join(emitted_chunks)\n    83\t\n    84\t        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n    85\t        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n    86\t        self.assertIsNone(\n    87\t            glued_pattern.search(full_stream),\n    88\t            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n    89\t        )\n    90\t\n    91\t        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n    92\t        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n    93\t        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n    94\t\n    95\t    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n    96\t        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n    97\t        arb = srv._ContentArbiter(\"turn-orch-1\")\n    98\t\n    99\t        # Агент меняет статусы оркестрации на протяжении 5 шагов\n   100\t        statuses = [\n   101\t            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n   102\t            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n   103\t            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n   104\t            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n   105\t            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n   106\t        ]\n   107\t\n   108\t        emitted_deltas: list[str] = []\n   109\t        for idx, status in enumerate(statuses, 1):\n   110\t            # Эмулируем приход короткого префикса, затем полного текста\n   111\t            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n   112\t            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n   113\t            if d1:\n   114\t                emitted_deltas.append(d1)\n   115\t            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n   116\t            if d2:\n   117\t                emitted_deltas.append(d2)\n   118\t\n   119\t        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n   120\t        self.assertEqual(arb.divergences, 0)\n   121\t\n   122\t        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n   123\t        full_text = \"\".join(emitted_deltas)\n   124\t        count = full_text.count(\"[гейт оркестрации: активен\")\n   125\t        self.assertEqual(\n   126\t            count,\n   127\t            len(statuses),\n   128\t            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n   129\t        )\n   130\t\n   131\t    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n   132\t        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n   133\t        emitted_events: list[tuple[str, str]] = []\n   134\t\n   135\t        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n   136\t            emitted_events.append((\"reasoning\", delta))\n   137\t            if on_del is not None:\n   138\t                on_del()\n   139\t            return True\n   140\t\n   141\t        def emit_content(idx: int | None, text: str) -> bool:\n   142\t            emitted_events.append((\"content\", text))\n   143\t            return True\n   144\t\n   145\t        plan = srv._TurnPlan()\n   146\t        plan.mode = \"OFF\"\n   147\t        plan.base_idx = 0\n   148\t        plan.offset = 0\n   149\t\n   150\t        tail = srv._TranscriptTail(\n   151\t            emit=emit_reasoning,\n   152\t            stop_event=threading.Event(),\n   153\t            done_event=threading.Event(),\n   154\t            resumed=False,\n   155\t            plan=plan,\n   156\t            turn_id=\"turn-subagent-1\",\n   157\t            emit_content=emit_content,\n   158\t            on_activity=None,\n   159\t            usage_enabled=False,\n   160\t            isolate_tool_preambles=True,\n   161\t        )\n   162\t\n   163\t        # Эмулируем транскрипт мультиагентного цикла:\n   164\t        # Шаг 1: Оркестратор запускает сабагента Coder\n   165\t        record_step1 = {\n   166\t            \"type\": \"PLANNER_RESPONSE\",\n   167\t            \"step_index\": 1,\n   168\t            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n   169\t            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n   170\t            \"tool_calls\": [\n   171\t                {\n   172\t                    \"name\": \"invoke_subagent\",\n   173\t                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n   174\t                }\n   175\t            ],\n   176\t        }\n   177\t        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n   178\t\n   179\t        # Шаг 2: Финальный ответ после завершения сабагента\n   180\t        record_step2 = {\n   181\t            \"type\": \"PLANNER_RESPONSE\",\n   182\t            \"step_index\": 2,\n   183\t            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   184\t            \"thinking\": \"Формирую итоговый статус для владельца.\",\n   185\t        }\n   186\t        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n   187\t\n   188\t        # Проверяем распределение:\n   189\t        # 1. Преамбула шага 1 ушла в reasoning\n   190\t        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n   191\t        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n   192\t\n   193\t        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n   194\t        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n   195\t        self.assertEqual(len(content_pieces), 1)\n   196\t        self.assertEqual(\n   197\t            content_pieces[0],\n   198\t            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   199\t        )\n   200\t\n   201\t\n   202\tif __name__ == \"__main__\":\n   203\t    unittest.main()\n","exit_code":0,"status":"completed"}}
