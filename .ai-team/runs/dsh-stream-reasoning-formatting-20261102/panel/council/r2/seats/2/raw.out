 2948\t    \"\"\"Неизменяемый валидированный снимок флагов новой политики.\"\"\"\n  2949\t\n  2950\t    planner_content_streaming_enabled: bool = False\n  2951\t    emit_tool_trace: bool = False\n  2952\t    extended_timeout_enabled: bool = False\n  2953\t    graceful_timeout_on_partial: bool = False\n  2954\t    step_scoped_usage_enabled: bool = False\n  2955\t    stream_resilience_enabled: bool = True\n  2956\t    isolate_tool_preambles_to_reasoning: bool = True\n  2957\t    graceful_timeout_finish_reason: str = \"stop\"\n  2958\t\n  2959\t\n  2960\t_NEW_FLAG_ENV = {\n  2961\t    \"planner_content_streaming_enabled\": \"AGY_PLANNER_CONTENT_STREAMING_ENABLED\",\n  2962\t    \"emit_tool_trace\": \"AGY_BRIDGE_EMIT_TOOL_TRACE\",\n  2963\t    \"extended_timeout_enabled\": \"AGY_EXTENDED_TIMEOUT_ENABLED\",\n  2964\t    \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n  2965\t    \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n  2966\t    \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n  2967\t    \"isolate_tool_preambles_to_reasoning\": \"AGY_ISOLATE_TOOL_PREAMBLES_TO_REASONING\",\n  2968\t}\n  2969\t_ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n  2970\t_ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n  2971\t_COLD_FLAGS = _RuntimeFlags()\n  2972\t_cfg_lock = threading.Lock()\n  2973\t_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS\n  2974\t_cfg_key: tuple[int, int] | None = None\n  2975\t_cfg_checked_at: float | None = None\n  2976\t_cfg_generation: int = 0\n  2977\t\n  2978\t\n  2979\tdef _parse_runtime_flags(text: str) -> _RuntimeFlags:\n  2980\t    \"\"\"Разобрать флаги; нестроковый finish_reason заменяется дефолтом 'stop'.\n  2981\t\n  2982\t    ValueError для не-bool флагов отвергает файл целиком.\n  2983\t    \"\"\"\n  2984\t    data = cast(object, json.loads(text))\n  2985\t    if not isinstance(data, dict):\n  2986\t        raise ValueError(\"dynamic_config: not an object\")\n  2987\t    raw = cast(\"dict[str, object]\", data)\n  2988\t    values: dict[str, bool] = {}\n  2989\t    finish_reason = _COLD_FLAGS.graceful_timeout_finish_reason\n  2990\t    for name in _RuntimeFlags._fields:\n  2991\t        default = getattr(_COLD_FLAGS, name)\n  2992\t        if name == \"stream_resilience_enabled\":\n  2993\t            default = raw.get(_NEW_FLAG_ENV[name], default)\n  2994\t        if name == \"graceful_timeout_finish_reason\":\n  2995\t            raw_val = raw.get(\"graceful_timeout_finish_reason\")\n  2996\t            if raw_val is None:\n  2997\t                raw_val = raw.get(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", default)\n  2998\t            if isinstance(raw_val, str):\n  2999\t                s = raw_val.strip().lower()\n  3000\t                if s in (\"length\", \"max_tokens\"):\n  3001\t                    finish_reason = \"length\"\n  3002\t                elif s == \"stop\":\n  3003\t                    finish_reason = \"stop\"\n  3004\t                else:\n  3005\t                    finish_reason = \"stop\"\n  3006\t            else:\n  3007\t                finish_reason = \"stop\"\n  3008\t            continue\n  3009\t        value = raw.get(name, default)\n  3010\t        if not isinstance(value, bool):\n  3011\t            raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n  3012\t        values[name] = value\n  3013\t    return _RuntimeFlags(**values, graceful_timeout_finish_reason=finish_reason)\n  3014\t\n  3015\t\n  3016\tdef _runtime_snapshot() -> _RuntimeFlags:\n  5230\t        self.transcript_activity_ts: float | None = None\n  5231\t        _decide_turn_mode(plan)\n  5232\t        self._tail = _TranscriptTail(\n  5233\t            emit=self._emit_reasoning,\n  5234\t            stop_event=self._stop_watch,\n  5235\t            done_event=self._proc_done,\n  5236\t            resumed=bool(self.run_cid),\n  5237\t            plan=plan,\n  5238\t            turn_id=self.turn_id,\n  5239\t            emit_content=self._offer_transcript if self.content_streaming else None,\n  5240\t            on_activity=self._on_tail_activity,\n  5241\t            usage_enabled=self.usage_enabled,\n  5242\t            isolate_tool_preambles=_new_flag(\"isolate_tool_preambles_to_reasoning\", True),\n  5243\t        )\n  5244\t        if policy is not None:\n  5245\t            self._tail.deadline_s = policy.effective_max_timeout_s + 60.0\n  5246\t        if self.run_cid:\n  5247\t            self._tail.bind(self.run_cid)\n  5248\t        threading.Thread(target=self._feed_stdin, daemon=True).start()\n  5249\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n  5250\t        threading.Thread(target=self._pump, daemon=True).start()\n  5251\t        self._tail.start()\n  5252\t\n  5253\t    def _emit_reasoning(\n  5254\t        self, idx: int, delta: str, on_delivered: Callable[[], None] | None = None\n  5255\t    ) -> bool:\n  5256\t        \"\"\"Поставить дельту мышления в очередь; False — очередь закрыта или потолок.\n  5257\t\n  5258\t        Закрытие очереди, счётчик байт и учёт выданного (`on_delivered`) идут под\n  5259\t        одним `_emit_lock`: после (\"done\", …) ни одно (\"reasoning\", …) не попадает.\n  5260\t        \"\"\"\n  5261\t        size = len(delta.encode(\"utf-8\"))\n  5262\t        outcome = \"\"\n  5263\t        log_cap = False\n  5264\t        with self._emit_lock:\n  5265\t            if self.drain_closed:\n  5266\t                outcome = \"late\"\n  5267\t            elif self._reasoning_bytes + size > MAX_REASONING_BYTES_PER_TURN:\n  5268\t                outcome = \"cap\"\n  5269\t                log_cap = not self._cap_logged\n  5270\t                self._cap_logged = True\n  5271\t            else:\n  5272\t                self._reasoning_bytes += size\n  5273\t                self.q.put((\"reasoning\", delta))\n  5274\t                if on_delivered is not None:\n  5275\t                    on_delivered()\n  5276\t                return True\n  5277\t            total = self._reasoning_bytes\n  5278\t        cid8 = self._tail.cid[:8] or \"-\"\n  5279\t        if outcome == \"late\":\n  5280\t            _log(f\"reasoning-late-drop cid={cid8} step={idx} len={len(delta)}\")\n  5281\t        elif log_cap:\n  5282\t            _log(f\"reasoning-cap cid={cid8} bytes={total}\")\n  5283\t        return False\n  5284\t\n  5285\t    def _close_and_put_done(self, kind: str, payload: object) -> None:\n  5286\t        \"\"\"Атомарно закрыть выдачу мышления и поставить терминальное событие (один раз).\"\"\"\n","exit_code":0,"status":"completed"}}
