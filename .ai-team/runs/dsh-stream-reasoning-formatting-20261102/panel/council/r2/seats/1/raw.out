      isolate_tool_preambles: bool = False,\\n4192:        self.isolate_tool_preambles = isolate_tool_preambles\\n4424:                self._emit_record(line)\\n4516:    def _emit_record(self, raw: bytes) -> None:\\n4549:        isolate_tools = getattr(self, \\\"isolate_tool_preambles\\\", False)\\n4551:            if has_tools and isolate_tools:\\n5101:    \\\"\\\"\\\"Один процесс `agy`; поток-читатель превращает stdout NDJSON в события очереди.\\n5177:                stdout=subprocess.PIPE,\\n5203:        self.got_event = False  # True после первого валидного JSON-события stdout\\n5227:        # Реальная активность producer'ов (stdout/transcript), независимо от cpu_delta.\\n5239:            emit_content=self._offer_transcript if self.content_streaming else None,\\n5242:            isolate_tool_preambles=_new_flag(\\\"isolate_tool_preambles_to_reasoning\\\", True),\\n5295:        \\\"\\\"\\\"Новый прогресс producer'а (stdout/transcript): продлевает idle, не зависит от CPU.\\\"\\\"\\\"\\n5305:    def offer_content(self, source: str, step_index: object, text: str) -> bool:\\n5335:    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\\n5336:        return self.offer_content(\\\"transcript\\\", step_index, text)\\n5338:    def reconcile_result(self, text: str) -> str:\\n5341:            return self._arbiter.reconcile_result(text)\\n5448:            for raw in iter(self.proc.stdout.readline, b\\\"\\\"):\\n5457:                self.note_producer_activity(\\\"stdout\\\")\\n5487:                            _ = self.offer_content(\\n5488:                                \\\"stdout\\\",\\n5596:        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\\n6014:        idle (по реальной активности producer'ов stdout/transcript, независимо от\\n6144:                        \\\"(no stdout/transcript progress)\\\",\\n6261:                    delta = run.reconcile_result(final_text)\\n6264:                    elif final_text and getattr(run._a