{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b5","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":53,"recorded_at":1780531400000101,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c17-53cf-74f3-917c-e8f55748432c"},"task_id":"01a19c17-53cf-74f3-917c-e8f55748432c","event":{"kind":"output","task_id":"01a19c17-53cf-74f3-917c-e8f55748432c","chunk":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && git diff -- bridges/agy-bridge/server.py | head -n 400; echo \\\"===SMOKE===\\\"; ls -l scripts/smoke_models.py tests/test_stream_formatting_and_subagents.py 2>&1; wc -l bridges/agy-bridge/server.py scripts/smoke_models.py tests/test_stream_formatting_and_subagents.py\",\n  \"description\": \"Show server diff and file sizes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"diff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\\nindex f876e36..2179ca1 100644\\n--- a/bridges/agy-bridge/server.py\\n+++ b/bridges/agy-bridge/server.py\\n@@ -2953,6 +2953,7 @@ class _RuntimeFlags(NamedTuple):\\n     graceful_timeout_on_partial: bool = False\\n     step_scoped_usage_enabled: bool = False\\n     stream_resilience_enabled: bool = True\\n+    isolate_tool_preambles_to_reasoning: bool = True\\n     graceful_timeout_finish_reason: str = \\\"stop\\\"\\n \\n \\n@@ -2963,6 +2964,7 @@ _NEW_FLAG_ENV = {\\n     \\\"graceful_timeout_on_partial\\\": \\\"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\\\",\\n     \\\"step_scoped_usage_enabled\\\": \\\"AGY_STEP_SCOPED_USAGE_ENABLED\\\",\\n     \\\"stream_resilience_enabled\\\": \\\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\\\",\\n+    \\\"isolate_tool_preambles_to_reasoning\\\": \\\"AGY_ISOLATE_TOOL_PREAMBLES_TO_REASONING\\\",\\n }\\n _ENV_TRUE = frozenset({\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"})\\n _ENV_FALSE = frozenset({\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\"})\\n@@ -2989,10 +2991,22 @@ def _parse_runtime_flags(text: str) -> _RuntimeFlags:\\n         default = getattr(_COLD_FLAGS, name)\\n         if name == \\\"stream_resilience_enabled\\\":\\n             default = raw.get(_NEW_FLAG_ENV[name], default)\\n-        value = raw.get(name, default)\\n         if name == \\\"graceful_timeout_finish_reason\\\":\\n-            finish_reason = value if isinstance(value, str) else \\\"stop\\\"\\n+            raw_val = raw.get(\\\"graceful_timeout_finish_reason\\\")\\n+            if raw_val is None:\\n+                raw_val = raw.get(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\", default)\\n+            if isinstance(raw_val, str):\\n+                s = raw_val.strip().lower()\\n+                if s in (\\\"length\\\", \\\"max_tokens\\\"):\\n+                    finish_reason = \\\"length\\\"\\n+                elif s == \\\"stop\\\":\\n+                    finish_reason = \\\"stop\\\"\\n+                else:\\n+                    finish_reason = \\\"stop\\\"\\n+            else:\\n+                finish_reason = \\\"stop\\\"\\n             continue\\n+        value = raw.get(name, default)\\n         if not isinstance(value, bool):\\n             raise ValueError(\\\"dynamic_config: %s is not boolean\\\" % name)\\n         values[name] = value\\n@@ -3065,12 +3079,14 @@ def _graceful_finish_reason() -> str:\\n \\n     Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\\n     graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\\n-    Значение 'max_tokens' нормализуется в 'length'.\\n+    Значение 'max_tokens' нормализуется в 'length'. Невалидный непустой env\\n+    переопределяет конфиг и даёт 'stop'.\\n     \\\"\\\"\\\"\\n-    raw_env = os.getenv(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\", \\\"\\\").strip().lower()\\n-    if raw_env in (\\\"length\\\", \\\"max_tokens\\\"):\\n-        return \\\"length\\\"\\n-    if raw_env == \\\"stop\\\":\\n+    raw_env = os.getenv(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\")\\n+    if raw_env is not None and raw_env.strip():\\n+        s = raw_env.strip().lower()\\n+        if s in (\\\"length\\\", \\\"max_tokens\\\"):\\n+            return \\\"length\\\"\\n         return \\\"stop\\\"\\n     snap = _runtime_snapshot()\\n     val = snap.graceful_timeout_finish_reason.strip().lower()\\n@@ -3794,6 +3810,7 @@ class _ContentArbiter:\\n         self.overflow = False\\n         self.divergences = 0\\n         self.probes = 0\\n+        self.last_result_diverged = False\\n \\n     def _set_overflow(self, why: str) -> None:\\n         if not self.overflow:\\n@@ -3909,12 +3926,20 @@ class _ContentArbiter:\\n         for step in eq.get(text, ()):\\n             if self._eligible(step, source, idx):\\n                 return step\\n-        pos = bisect.bisect_left(texts, text)\\n-        while pos < len(texts) and texts[pos].startswith(text):\\n-            for step in eq[texts[pos]]:\\n-                if self._eligible(step, source, idx):\\n-                    return step\\n-            pos += 1\\n+        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\\n+        if candidates:\\n+            candidates.sort(key=len, reverse=True)\\n+            for cand in candidates:\\n+                for step in eq[cand]:\\n+                    if self._eligible(step, source, idx):\\n+                        return step\\n+        if idx is None:\\n+            pos = bisect.bisect_left(texts, text)\\n+            while pos < len(texts) and texts[pos].startswith(text):\\n+                for step in eq[texts[pos]]:\\n+                    if step.origin != source and self._eligible(step, source, idx):\\n+                        return step\\n+     