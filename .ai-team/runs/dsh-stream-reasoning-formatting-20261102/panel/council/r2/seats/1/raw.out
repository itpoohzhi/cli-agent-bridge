{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c491","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":163,"recorded_at":1780531400000321,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c18-4e73-71a0-b324-8e62d5687e77"},"task_id":"01a19c18-4e73-71a0-b324-8e62d5687e77","event":{"kind":"output","task_id":"01a19c18-4e73-71a0-b324-8e62d5687e77","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4515 line(s) above)\n4516|    def _emit_record(self, raw: bytes) -> None:\n4517|        line = raw.strip()\n4518|        if not line:\n4519|            return\n4520|        if (\n4521|            b\"PLANNER_RESPONSE\" not in line\n4522|            and b\"END_TURN\" not in line\n4523|            and b\"TURN_COMPLETE\" not in line\n4524|        ):\n4525|            return  # быстрый отсев служебных записей без разбора JSON\n4526|        try:\n4527|            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n4528|        except ValueError:\n4529|            return\n4530|        if not isinstance(parsed, dict):\n4531|            return\n4532|        rec = cast(\"dict[str, object]\", parsed)\n4533|        rtype = str(rec.get(\"type\") or \"\")\n4534|        idx = _as_int(rec.get(\"step_index\"))\n4535|        if idx is not None and idx < self.base_idx:\n4536|            return  # история прошлых ходов\n4537|        if self._in_rewrite:\n4538|            self._note_activity()\n4539|        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n4540|            self.end_marker = True\n4541|            return\n4542|        if rtype != \"PLANNER_RESPONSE\":\n4543|            return\n4544|        if self.usage_enabled:\n4545|            self._record_usage(rec)\n4546|        content = rec.get(\"content\")\n4547|        emit_content = self.emit_content\n4548|        has_tools = bool(rec.get(\"tool_calls\"))\n4549|        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n4550|        if emit_content is not None and isinstance(content, str) and content.strip():\n4551|            if has_tools and isolate_tools:\n4552|                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n4553|            else:\n4554|                _ = emit_content(\n4555|                    idx, content\n4556|                )  # live planner-текст, независимо от tool_calls\n4557|        if idx is None:\n4558|            return\n4559|        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n4560|            self.final_planner = True\n4561|        thinking = rec.get(\"thinking\")\n4562|        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n4563|\n4564|    # ---- состояние шагов -----------------------------------------------------------\n4565|    def _state(self, idx: int) -> _StepState:\n4566|        state = self.seen.get(idx)\n4567|        if state is not None:\n4568|            return state\n4569|        if len(self.seen) >= MAX_STEPS_TRACKED:\n4570|            evictable = [\n4571|                k\n4572|                for k, s in self.seen.items()\n4573|                if s.finalized and k < self.poll_watermark\n4574|            ]\n4575|            if evictable:\n4576|                del self.seen[min(evictable)]\n4577|            else:\n4578|                self._sqlite_off(\"seen_cap\")\n4579|                del self.seen[min(self.seen)]\n4580|        state = _StepState()\n4581|        self.seen[idx] = state\n4582|        return state\n4583|\n4584|    def _step_done(self, state: _StepState) -> bool:\n4585|        return state.sql_done or (\n4586|            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n4587|        )\n4588|\n4589|    def _advance_watermark(self) -> None:\n4590|        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n4591|        mark = self.poll_watermark\n4592|        for key in sorted(self.seen):\n4593|            if key < mark:\n4594|                continue\n4595|            if not self._step_done(self.seen[key]):\n(more lines below)","final_result":true}}}
