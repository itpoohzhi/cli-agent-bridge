{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f3","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":84,"recorded_at":1780531400000163,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3"},"task_id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3","event":{"kind":"output","task_id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n3|\n4|Позволяет автоматически проверять доступность и работоспособность моделей из\n5|канонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n6|\n7|Использование:\n8|    python3 scripts/smoke_models.py --dry-run\n9|    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n10|    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n11|\"\"\"\n12|\n13|from __future__ import annotations\n14|\n15|import argparse\n16|import json\n17|import os\n18|from pathlib import Path\n19|import re\n20|import sys\n21|import time\n22|import urllib.error\n23|import urllib.request\n24|from typing import Any, NamedTuple\n25|\n26|\n27|DEFAULT_MODELS_MD = Path(\n28|    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n29|).expanduser()\n30|DEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n31|\n32|\n33|class ModelEntry(NamedTuple):\n34|    role: str\n35|    model_id: str\n36|    effort: str\n37|    family: str\n38|\n39|\n40|def parse_models_md(path: Path) -> list[ModelEntry]:\n41|    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n42|    if not path.is_file():\n43|        # Fallback на локальный список, если файл канона недоступен\n44|        return [\n45|            ModelEntry(\"Coder\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n46|            ModelEntry(\"Coder\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n47|            ModelEntry(\"Coder\", \"gemini-4-argon-high\", \"high\", \"Google\"),\n48|            ModelEntry(\"Coder\", \"muse-wonder-full-1.0\", \"xhigh\", \"Meta\"),\n49|            ModelEntry(\"Architect\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n50|            ModelEntry(\"Reviewer\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n51|        ]\n52|\n53|    content = path.read_text(encoding=\"utf-8\")\n54|    entries: list[ModelEntry] = []\n55|    current_role = \"General\"\n56|\n57|    # Регулярное выражение для строк вида:\n58|    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n59|    row_pattern = re.compile(\n60|        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n61|    )\n62|\n63|    for line in content.splitlines():\n64|        line = line.strip()\n65|        if line.startswith(\"### \"):\n66|            header = line[4:].strip()\n67|            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n68|            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n69|            continue\n70|\n71|        match = row_pattern.match(line)\n72|        if match:\n73|            model_id = match.group(1).strip()\n74|            effort = match.group(2).strip()\n75|            family = match.group(3).strip()\n76|            # Пропускаем заголовки таблиц\n77|            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n78|                continue\n79|            entries.append(ModelEntry(current_role, model_id, effort, family))\n80|\n81|    # Дедупликация по паре (role, model_id)\n82|    seen = set()\n83|    unique_entries = []\n84|    for e in entries:\n85|        key = (e.role, e.model_id)\n86|        if key not in seen:\n87|            seen.add(key)\n88|            unique_entries.append(e)\n89|\n90|    return unique_entries\n91|\n92|\n93|def mask_secret(text: str) -> str:\n94|    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n95|    return re.sub(\n96|        r\"(Bearer\\s+)[a-zA-Z0-9_\\-\\.]{8,}\",\n97|        r\"\\1[MASKED]\",\n98|        text,\n99|        flags=re.IGNORECASE,\n100|    )\n101|\n102|\n103|def smoke_test_model(\n104|    hub_url: str,\n105|    model_id: str,\n106|    timeout_s: float = 15.0,\n107|    api_key: str = \"test-smoke-key\",\n108|) -> tuple[bool, str, float]:\n109|    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n110|    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n111|    payload = {\n112|        \"model\": model_id,\n113|        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n114|        \"max_tokens\": 10,\n115|        \"stream\": False,\n116|    }\n117|    data_bytes = json.dumps(payload).encode(\"utf-8\")\n118|    req = urllib.request.Request(\n119|        endpoint,\n120|        data=data_bytes,\n121|        headers={\n122|            \"Content-Type\": \"application/json\",\n123|            \"Authorization\": f\"Bearer {api_key}\",\n124|        },\n125|        method=\"POST\",\n126|    )\n127|\n128|    t0 = time.monotonic()\n129|    try:\n130|        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n131|            elapsed = time.monotonic() - t0\n132|            status_code = resp.getcode()\n133|            if status_code != 200:\n134|                return False, f\"HTTP {status_code}\", elapsed\n135|            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n136|            res_json = json.loads(raw_body)\n137|            choices = res_json.get(\"choices\") or []\n138|            if not choices:\n139|                return False, \"Empty choices\", elapsed\n140|            return True, \"OK\", elapsed\n141|    except urllib.error.HTTPError as e:\n142|        elapsed = time.monotonic() - t0\n143|        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n144|        return False, err_msg, elapsed\n145|    except Exception as e:\n146|        elapsed = time.monotonic() - t0\n147|        return False, mask_secret(f\"Error: {e}\"), elapsed\n148|\n149|\n150|def main() -> int:\n151|    parser = argparse.ArgumentParser(\n152|        description=\"Smoke test runner for models defined in models.md\"\n153|    )\n154|    parser.add_argument(\n155|        \"--models-md\",\n156|        type=Path,\n157|        default=DEFAULT_MODELS_MD,\n158|        help=\"Path to Context/models.md\",\n159|    )\n160|    parser.add_argument(\n161|        \"--hub-url\",\n162|        type=str,\n163|        default=DEFAULT_HUB_URL,\n164|        help=\"URL of the bridge hub endpoint\",\n165|    )\n166|    parser.add_argument(\n167|        \"--model\",\n168|        type=str,\n169|        default=\"\",\n170|        help=\"Filter by specific model ID\",\n171|    )\n172|    parser.add_argument(\n173|        \"--dry-run\",\n174|        action=\"store_true\",\n175|        help=\"Validate configuration and parse models without sending network requests\",\n176|    )\n177|    parser.add_argument(\n178|        \"--live\",\n179|        action=\"store_true\",\n180|        help=\"Execute live HTTP smoke requests against the hub\",\n181|    )\n182|    parser.add_argument(\n183|        \"--timeout\",\n184|        type=float,\n185|        default=15.0,\n186|        help=\"Request timeout in seconds\",\n187|    )\n188|\n189|    args = parser.parse_args()\n190|\n191|    models = parse_models_md(args.models_md)\n192|    if args.model:\n193|        models = [m for m in models if m.model_id == args.model]\n194|\n195|    if not models:\n196|        print(\"FAIL: No models found matching criteria.\")\n197|        return 1\n198|\n199|    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n200|    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n201|    print(\"-\" * 88)\n202|\n203|    all_ok = True\n204|    for entry in models:\n205|        if args.dry_run or not args.live:\n206|            status = \"CONFIGURED\"\n207|            latency_str = \"-\"\n208|        else:\n209|            ok, status, lat = smoke_test_model(\n210|                args.hub_url, entry.model_id, timeout_s=args.timeout\n211|            )\n212|            latency_str = f\"{lat:.2f}s\"\n213|            if not ok:\n214|                all_ok = False\n215|\n216|        print(\n217|            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n218|        )\n219|\n220|    if args.dry_run:\n221|        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n222|        return 0\n223|\n224|    if not args.live:\n225|        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n226|        return 0\n227|\n228|    return 0 if all_ok else 1\n229|\n230|\n231|if __name__ == \"__main__\":\n232|    sys.exit(main())","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f5","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":85,"recorded_at":1780531400000165,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3"},"task_id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3","event":{"kind":"completed","task_id":"01a19c18-0f8d-7f81-a5cf-54f9679059a3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f7","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":86,"recorded_at":1780531400000167,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80"},"task_id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80","event":{"kind":"output","task_id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py`.\n1|\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n2|\n3|Проверяет:\n4|1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n5|2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n6|3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n7|4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n8|\"\"\"\n9|\n10|from __future__ import annotations\n11|\n12|import importlib.util\n13|import json\n14|import os\n15|from pathlib import Path\n16|import queue\n17|import re\n18|import sys\n19|import threading\n20|import unittest\n21|from types import SimpleNamespace\n22|from typing import Any, cast\n23|\n24|_REPO_ROOT = Path(__file__).resolve().parents[1]\n25|if str(_REPO_ROOT) not in sys.path:\n26|    sys.path.insert(0, str(_REPO_ROOT))\n27|\n28|_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n29|\n30|\n31|def _load_bridge() -> Any:\n32|    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n33|    spec = importlib.util.spec_from_file_location(\n34|        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n35|    )\n36|    assert spec is not None and spec.loader is not None\n37|    module = importlib.util.module_from_spec(spec)\n38|    sys.modules[spec.name] = module\n39|    spec.loader.exec_module(module)\n40|    return module\n41|\n42|\n43|srv = _load_bridge()\n44|\n45|\n46|class SyntheticE2EAgentStreamTests(unittest.TestCase):\n47|    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n48|\n49|    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n50|        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n51|        run = object.__new__(srv.Run)\n52|        setattr(run, \"_emit_lock\", threading.Lock())\n53|        setattr(run, \"q\", queue.Queue())\n54|        setattr(run, \"drain_closed\", False)\n55|        setattr(run, \"_done_put\", False)\n56|        setattr(run, \"_reasoning_bytes\", 0)\n57|        setattr(run, \"_cap_logged\", False)\n58|        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n59|        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n60|        setattr(run, \"turn_id\", \"turn-e2e-1\")\n61|        setattr(run, \"run_cid\", \"cid-test-e2e\")\n62|        setattr(run, \"_last_step_index\", None)\n63|        setattr(run, \"_content_emitted_wire\", \"\")\n64|\n65|        # Эмулируем шаги из скриншота пользователя:\n66|        # Шаг 1: \"Ищу в базе знаний и git посл\"\n67|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n68|        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n69|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n70|        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n71|        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n72|        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n73|        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n74|\n75|        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n76|        emitted_chunks: list[str] = []\n77|        while not q.empty():\n78|            item = q.get_nowait()\n79|            if item[0] == \"text\":\n80|                emitted_chunks.append(str(item[1]))\n81|\n82|        full_stream = \"\".join(emitted_chunks)\n83|\n84|        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n85|        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n86|        self.assertIsNone(\n87|            glued_pattern.search(full_stream),\n88|            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n89|        )\n90|\n91|        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n92|        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n93|        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n94|\n95|    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n96|        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n97|        arb = srv._ContentArbiter(\"turn-orch-1\")\n98|\n99|        # Агент меняет статусы оркестрации на протяжении 5 шагов\n100|        statuses = [\n101|            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n102|            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n103|            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n104|            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n105|            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n106|        ]\n107|\n108|        emitted_deltas: list[str] = []\n109|        for idx, status in enumerate(statuses, 1):\n110|            # Эмулируем приход короткого префикса, затем полного текста\n111|            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n112|            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n113|            if d1:\n114|                emitted_deltas.append(d1)\n115|            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n116|            if d2:\n117|                emitted_deltas.append(d2)\n118|\n119|        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n120|        self.assertEqual(arb.divergences, 0)\n121|\n122|        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n123|        full_text = \"\".join(emitted_deltas)\n124|        count = full_text.count(\"[гейт оркестрации: активен\")\n125|        self.assertEqual(\n126|            count,\n127|            len(statuses),\n128|            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n129|        )\n130|\n131|    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n132|        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n133|        emitted_events: list[tuple[str, str]] = []\n134|\n135|        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n136|            emitted_events.append((\"reasoning\", delta))\n137|            if on_del is not None:\n138|                on_del()\n139|            return True\n140|\n141|        def emit_content(idx: int | None, text: str) -> bool:\n142|            emitted_events.append((\"content\", text))\n143|            return True\n144|\n145|        plan = srv._TurnPlan()\n146|        plan.mode = \"OFF\"\n147|        plan.base_idx = 0\n148|        plan.offset = 0\n149|\n150|        tail = srv._TranscriptTail(\n151|            emit=emit_reasoning,\n152|            stop_event=threading.Event(),\n153|            done_event=threading.Event(),\n154|            resumed=False,\n155|            plan=plan,\n156|            turn_id=\"turn-subagent-1\",\n157|            emit_content=emit_content,\n158|            on_activity=None,\n159|            usage_enabled=False,\n160|            isolate_tool_preambles=True,\n161|        )\n162|\n163|        # Эмулируем транскрипт мультиагентного цикла:\n164|        # Шаг 1: Оркестратор запускает сабагента Coder\n165|        record_step1 = {\n166|            \"type\": \"PLANNER_RESPONSE\",\n167|            \"step_index\": 1,\n168|            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n169|            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n170|            \"tool_calls\": [\n171|                {\n172|                    \"name\": \"invoke_subagent\",\n173|                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n174|                }\n175|            ],\n176|        }\n177|        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n178|\n179|        # Шаг 2: Финальный ответ после завершения сабагента\n180|        record_step2 = {\n181|            \"type\": \"PLANNER_RESPONSE\",\n182|            \"step_index\": 2,\n183|            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n184|            \"thinking\": \"Формирую итоговый статус для владельца.\",\n185|        }\n186|        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n187|\n188|        # Проверяем распределение:\n189|        # 1. Преамбула шага 1 ушла в reasoning\n190|        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n191|        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n192|\n193|        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n194|        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n195|        self.assertEqual(len(content_pieces), 1)\n196|        self.assertEqual(\n197|            content_pieces[0],\n198|            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n199|        )\n200|\n201|\n202|if __name__ == \"__main__\":\n203|    unittest.main()","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f9","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":87,"recorded_at":1780531400000169,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"task_stream":{"kind":"task","id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80"},"task_id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80","event":{"kind":"completed","task_id":"01a19c18-0fbb-7bf3-9f2d-0c6faf155f80"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3fb","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":88,"recorded_at":1780531400000171,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c180d0472a794dec6db256192ce","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n3|\n4|Позволяет автоматически проверять доступность и работоспособность моделей из\n5|канонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n6|\n7|Использование:\n8|    python3 scripts/smoke_models.py --dry-run\n9|    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n10|    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n11|\"\"\"\n12|\n13|from __future__ import annotations\n14|\n15|import argparse\n16|import json\n17|import os\n18|from pathlib import Path\n19|import re\n20|import sys\n21|import time\n22|import urllib.error\n23|import urllib.request\n24|from typing import Any, NamedTuple\n25|\n26|\n27|DEFAULT_MODELS_MD = Path(\n28|    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n29|).expanduser()\n30|DEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n31|\n32|\n33|class ModelEntry(NamedTuple):\n34|    role: str\n35|    model_id: str\n36|    effort: str\n37|    family: str\n38|\n39|\n40|def parse_models_md(path: Path) -> list[ModelEntry]:\n41|    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n42|    if not path.is_file():\n43|        # Fallback на локальный список, если файл канона недоступен\n44|        return [\n45|            ModelEntry(\"Coder\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n46|            ModelEntry(\"Coder\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n47|            ModelEntry(\"Coder\", \"gemini-4-argon-high\", \"high\", \"Google\"),\n48|            ModelEntry(\"Coder\", \"muse-wonder-full-1.0\", \"xhigh\", \"Meta\"),\n49|            ModelEntry(\"Architect\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n50|            ModelEntry(\"Reviewer\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n51|        ]\n52|\n53|    content = path.read_text(encoding=\"utf-8\")\n54|    entries: list[ModelEntry] = []\n55|    current_role = \"General\"\n56|\n57|    # Регулярное выражение для строк вида:\n58|    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n59|    row_pattern = re.compile(\n60|        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n61|    )\n62|\n63|    for line in content.splitlines():\n64|        line = line.strip()\n65|        if line.startswith(\"### \"):\n66|            header = line[4:].strip()\n67|            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n68|            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n69|            continue\n70|\n71|        match = row_pattern.match(line)\n72|        if match:\n73|            model_id = match.group(1).strip()\n74|            effort = match.group(2).strip()\n75|            family = match.group(3).strip()\n76|            # Пропускаем заголовки таблиц\n77|            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n78|                continue\n79|            entries.append(ModelEntry(current_role, model_id, effort, family))\n80|\n81|    # Дедупликация по паре (role, model_id)\n82|    seen = set()\n83|    unique_entries = []\n84|    for e in entries:\n85|        key = (e.role, e.model_id)\n86|        if key not in seen:\n87|            seen.add(key)\n88|            unique_entries.append(e)\n89|\n90|    return unique_entries\n91|\n92|\n93|def mask_secret(text: str) -> str:\n94|    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n95|    return re.sub(\n96|        r\"(Bearer\\s+)[a-zA-Z0-9_\\-\\.]{8,}\",\n97|        r\"\\1[MASKED]\",\n98|        text,\n99|        flags=re.IGNORECASE,\n100|    )\n101|\n102|\n103|def smoke_test_model(\n104|    hub_url: str,\n105|    model_id: str,\n106|    timeout_s: float = 15.0,\n107|    api_key: str = \"test-smoke-key\",\n108|) -> tuple[bool, str, float]:\n109|    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n110|    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n111|    payload = {\n112|        \"model\": model_id,\n113|        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n114|        \"max_tokens\": 10,\n115|        \"stream\": False,\n116|    }\n117|    data_bytes = json.dumps(payload).encode(\"utf-8\")\n118|    req = urllib.request.Request(\n119|        endpoint,\n120|        data=data_bytes,\n121|        headers={\n122|            \"Content-Type\": \"application/json\",\n123|            \"Authorization\": f\"Bearer {api_key}\",\n124|        },\n125|        method=\"POST\",\n126|    )\n127|\n128|    t0 = time.monotonic()\n129|    try:\n130|        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n131|            elapsed = time.monotonic() - t0\n132|            status_code = resp.getcode()\n133|            if status_code != 200:\n134|                return False, f\"HTTP {status_code}\", elapsed\n135|            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n136|            res_json = json.loads(raw_body)\n137|            choices = res_json.get(\"choices\") or []\n138|            if not choices:\n139|                return False, \"Empty choices\", elapsed\n140|            return True, \"OK\", elapsed\n141|    except urllib.error.HTTPError as e:\n142|        elapsed = time.monotonic() - t0\n143|        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n144|        return False, err_msg, elapsed\n145|    except Exception as e:\n146|        elapsed = time.monotonic() - t0\n147|        return False, mask_secret(f\"Error: {e}\"), elapsed\n148|\n149|\n150|def main() -> int:\n151|    parser = argparse.ArgumentParser(\n152|        description=\"Smoke test runner for models defined in models.md\"\n153|    )\n154|    parser.add_argument(\n155|        \"--models-md\",\n156|        type=Path,\n157|        default=DEFAULT_MODELS_MD,\n158|        help=\"Path to Context/models.md\",\n159|    )\n160|    parser.add_argument(\n161|        \"--hub-url\",\n162|        type=str,\n163|        default=DEFAULT_HUB_URL,\n164|        help=\"URL of the bridge hub endpoint\",\n165|    )\n166|    parser.add_argument(\n167|        \"--model\",\n168|        type=str,\n169|        default=\"\",\n170|        help=\"Filter by specific model ID\",\n171|    )\n172|    parser.add_argument(\n173|        \"--dry-run\",\n174|        action=\"store_true\",\n175|        help=\"Validate configuration and parse models without sending network requests\",\n176|    )\n177|    parser.add_argument(\n178|        \"--live\",\n179|        action=\"store_true\",\n180|        help=\"Execute live HTTP smoke requests against the hub\",\n181|    )\n182|    parser.add_argument(\n183|        \"--timeout\",\n184|        type=float,\n185|        default=15.0,\n186|        help=\"Request timeout in seconds\",\n187|    )\n188|\n189|    args = parser.parse_args()\n190|\n191|    models = parse_models_md(args.models_md)\n192|    if args.model:\n193|        models = [m for m in models if m.model_id == args.model]\n194|\n195|    if not models:\n196|        print(\"FAIL: No models found matching criteria.\")\n197|        return 1\n198|\n199|    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n200|    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n201|    print(\"-\" * 88)\n202|\n203|    all_ok = True\n204|    for entry in models:\n205|        if args.dry_run or not args.live:\n206|            status = \"CONFIGURED\"\n207|            latency_str = \"-\"\n208|        else:\n209|            ok, status, lat = smoke_test_model(\n210|                args.hub_url, entry.model_id, timeout_s=args.timeout\n211|            )\n212|            latency_str = f\"{lat:.2f}s\"\n213|            if not ok:\n214|                all_ok = False\n215|\n216|        print(\n217|            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n218|        )\n219|\n220|    if args.dry_run:\n221|        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n222|        return 0\n223|\n224|    if not args.live:\n225|        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n226|        return 0\n227|\n228|    return 0 if all_ok else 1\n229|\n230|\n231|if __name__ == \"__main__\":\n232|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3fd","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":89,"recorded_at":1780531400000173,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c180d0573b6ab7e1258da1f85c8","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py`.\n1|\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n2|\n3|Проверяет:\n4|1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n5|2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n6|3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n7|4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n8|\"\"\"\n9|\n10|from __future__ import annotations\n11|\n12|import importlib.util\n13|import json\n14|import os\n15|from pathlib import Path\n16|import queue\n17|import re\n18|import sys\n19|import threading\n20|import unittest\n21|from types import SimpleNamespace\n22|from typing import Any, cast\n23|\n24|_REPO_ROOT = Path(__file__).resolve().parents[1]\n25|if str(_REPO_ROOT) not in sys.path:\n26|    sys.path.insert(0, str(_REPO_ROOT))\n27|\n28|_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n29|\n30|\n31|def _load_bridge() -> Any:\n32|    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n33|    spec = importlib.util.spec_from_file_location(\n34|        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n35|    )\n36|    assert spec is not None and spec.loader is not None\n37|    module = importlib.util.module_from_spec(spec)\n38|    sys.modules[spec.name] = module\n39|    spec.loader.exec_module(module)\n40|    return module\n41|\n42|\n43|srv = _load_bridge()\n44|\n45|\n46|class SyntheticE2EAgentStreamTests(unittest.TestCase):\n47|    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n48|\n49|    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n50|        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n51|        run = object.__new__(srv.Run)\n52|        setattr(run, \"_emit_lock\", threading.Lock())\n53|        setattr(run, \"q\", queue.Queue())\n54|        setattr(run, \"drain_closed\", False)\n55|        setattr(run, \"_done_put\", False)\n56|        setattr(run, \"_reasoning_bytes\", 0)\n57|        setattr(run, \"_cap_logged\", False)\n58|        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n59|        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n60|        setattr(run, \"turn_id\", \"turn-e2e-1\")\n61|        setattr(run, \"run_cid\", \"cid-test-e2e\")\n62|        setattr(run, \"_last_step_index\", None)\n63|        setattr(run, \"_content_emitted_wire\", \"\")\n64|\n65|        # Эмулируем шаги из скриншота пользователя:\n66|        # Шаг 1: \"Ищу в базе знаний и git посл\"\n67|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n68|        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n69|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n70|        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n71|        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n72|        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n73|        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n74|\n75|        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n76|        emitted_chunks: list[str] = []\n77|        while not q.empty():\n78|            item = q.get_nowait()\n79|            if item[0] == \"text\":\n80|                emitted_chunks.append(str(item[1]))\n81|\n82|        full_stream = \"\".join(emitted_chunks)\n83|\n84|        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n85|        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n86|        self.assertIsNone(\n87|            glued_pattern.search(full_stream),\n88|            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n89|        )\n90|\n91|        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n92|        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n93|        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n94|\n95|    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n96|        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n97|        arb = srv._ContentArbiter(\"turn-orch-1\")\n98|\n99|        # Агент меняет статусы оркестрации на протяжении 5 шагов\n100|        statuses = [\n101|            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n102|            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n103|            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n104|            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n105|            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n106|        ]\n107|\n108|        emitted_deltas: list[str] = []\n109|        for idx, status in enumerate(statuses, 1):\n110|            # Эмулируем приход короткого префикса, затем полного текста\n111|            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n112|            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n113|            if d1:\n114|                emitted_deltas.append(d1)\n115|            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n116|            if d2:\n117|                emitted_deltas.append(d2)\n118|\n119|        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n120|        self.assertEqual(arb.divergences, 0)\n121|\n122|        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n123|        full_text = \"\".join(emitted_deltas)\n124|        count = full_text.count(\"[гейт оркестрации: активен\")\n125|        self.assertEqual(\n126|            count,\n127|            len(statuses),\n128|            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n129|        )\n130|\n131|    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n132|        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n133|        emitted_events: list[tuple[str, str]] = []\n134|\n135|        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n136|            emitted_events.append((\"reasoning\", delta))\n137|            if on_del is not None:\n138|                on_del()\n139|            return True\n140|\n141|        def emit_content(idx: int | None, text: str) -> bool:\n142|            emitted_events.append((\"content\", text))\n143|            return True\n144|\n145|        plan = srv._TurnPlan()\n146|        plan.mode = \"OFF\"\n147|        plan.base_idx = 0\n148|        plan.offset = 0\n149|\n150|        tail = srv._TranscriptTail(\n151|            emit=emit_reasoning,\n152|            stop_event=threading.Event(),\n153|            done_event=threading.Event(),\n154|            resumed=False,\n155|            plan=plan,\n156|            turn_id=\"turn-subagent-1\",\n157|            emit_content=emit_content,\n158|            on_activity=None,\n159|            usage_enabled=False,\n160|            isolate_tool_preambles=True,\n161|        )\n162|\n163|        # Эмулируем транскрипт мультиагентного цикла:\n164|        # Шаг 1: Оркестратор запускает сабагента Coder\n165|        record_step1 = {\n166|            \"type\": \"PLANNER_RESPONSE\",\n167|            \"step_index\": 1,\n168|            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n169|            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n170|            \"tool_calls\": [\n171|                {\n172|                    \"name\": \"invoke_subagent\",\n173|                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n174|                }\n175|            ],\n176|        }\n177|        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n178|\n179|        # Шаг 2: Финальный ответ после завершения сабагента\n180|        record_step2 = {\n181|            \"type\": \"PLANNER_RESPONSE\",\n182|            \"step_index\": 2,\n183|            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n184|            \"thinking\": \"Формирую итоговый статус для владельца.\",\n185|        }\n186|        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n187|\n188|        # Проверяем распределение:\n189|        # 1. Преамбула шага 1 ушла в reasoning\n190|        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n191|        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n192|\n193|        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n194|        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n195|        self.assertEqual(len(content_pieces), 1)\n196|        self.assertEqual(\n197|            content_pieces[0],\n198|            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n199|        )\n200|\n201|\n202|if __name__ == \"__main__\":\n203|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
