ntimeFlags()\n2972|_cfg_lock = threading.Lock()\n2973|_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS\n2974|_cfg_key: tuple[int, int] | None = None\n2975|_cfg_checked_at: float | None = None\n2976|_cfg_generation: int = 0\n2977|\n2978|\n2979|def _parse_runtime_flags(text: str) -> _RuntimeFlags:\n2980|    \"\"\"Разобрать флаги; нестроковый finish_reason заменяется дефолтом 'stop'.\n2981|\n2982|    ValueError для не-bool флагов отвергает файл целиком.\n2983|    \"\"\"\n2984|    data = cast(object, json.loads(text))\n2985|    if not isinstance(data, dict):\n2986|        raise ValueError(\"dynamic_config: not an object\")\n2987|    raw = cast(\"dict[str, object]\", data)\n2988|    values: dict[str, bool] = {}\n2989|    finish_reason = _COLD_FLAGS.graceful_timeout_finish_reason\n(more lines below)","final_result":true}}}
