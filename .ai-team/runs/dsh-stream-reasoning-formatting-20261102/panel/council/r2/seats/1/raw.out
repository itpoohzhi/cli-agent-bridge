{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c525","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":237,"recorded_at":1780531400000469,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c1914c9717988f3e47c48c4b8ed","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4641 line(s) above)\n4642|    def _apply_final(self, idx: int, final_text: str) -> None:\n4643|        \"\"\"Финал шага из транскрипта: докинуть хвост или заморозить при расхождении.\"\"\"\n4644|        state = self._state(idx)\n4645|        if state.finalized:\n4646|            return\n4647|        state.final_len = len(final_text)\n4648|        state.final_sha = _sha(final_text) if final_text else \"\"\n4649|        sent = state.delivered_len\n4650|        if state.diverged:\n4651|            pass\n4652|        elif sent == 0:\n4653|            if final_text:\n4654|                _ = self._emit_delta(idx, state, final_text, \"tail\")\n4655|        elif (\n4656|            len(final_text) >= sent\n4657|            and _sha(final_text[:sent]) == state.delivered_sha.hexdigest()\n4658|        ):\n4659|            if len(final_text) > sent:\n4660|                _ = self._emit_delta(idx, state, final_text[sent:], \"tail\")\n4661|        else:\n4662|            self._diverge(idx, state, \"transcript\", sent, len(final_text))\n4663|        state.finalized = True\n4664|        self._judge_canary(idx, state)\n4665|        self._advance_watermark()\n4666|\n4667|    def _judge_canary(self, idx: int, state: _StepState) -> None:\n4668|        \"\"\"Семантический canary: финал транскрипта против status=3 снимка того же шага.\"\"\"\n4669|        if (\n4670|            state.canary_done\n4671|            or not state.finalized\n4672|            or not state.observed_final\n4673|            or state.final_len == 0\n4674|            or state.diverged\n4675|        ):\n4676|            return\n4677|        state.canary_done = True\n4678|        if state.observed_len == 0:\n4679|            _compat_demote()\n4680|            _log(f\"sqlite-live-loss cid={self._cid8()} step={idx}\")\n4681|        elif state.observed_sha == state.final_sha:\n4682|            if self.mode == \"SHADOW\" and _compat_promote(self.plan.identity):\n4683|                _log(\"compat state=LIVE\")\n4684|        elif self.mode == \"SHADOW\":\n4685|            state.diverged = True\n4686|            self.failed = True\n4687|            _count_divergence()\n4688|            _log(\n4689|                f\"sqlite_transcript_divergence cid={self._cid8()} step={idx} len_prev={state.observed_len} len_new={state.final_len}\"\n4690|            )\n4691|            self._sqlite_off(\"divergence\")\n4692|\n4693|    # ---- SQLite --------------------------------------------------------------------\n4694|    def _poll_sqlite(self) -> tuple[int, int] | None:\n4695|        \"\"\"Один опрос: свой connect mode=ro, один SELECT, close в finally.\n4696|\n4697|        Возвращает (число строк, число строк status=8) после успешного SELECT.\n4698|        \"\"\"\n4699|        self.last_poll = \"skip\"\n4700|        if not self._sqlite_permitted() or self._db_path is None:\n4701|            return None\n4702|        if not self.bucket.take():\n4703|            return None\n4704|        conn: sqlite3.Connection | None = None\n4705|        result: tuple[int, int] | None = None\n4706|        try:\n4707|            conn = _sqlite_open_ro(self._db_path)\n4708|            with self._conn_lock:\n4709|                self._active_conn = conn\n4710|            result = self._select_rows(conn)\n4711|            self.last_poll = \"ok\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c1918c4712e989ed2c71dec0eab","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4379 line(s) above)\n4380|        callback = self.on_activity\n4381|        if callback is not None:\n4382|            try:\n4383|                callback()\n4384|            except Exception:\n4385|                pass\n4386|\n4387|    # ---- транскрипт ----------------------------------------------------------------\n4388|    def _read_transcript(self) -> None:\n4389|        \"\"\"Дочитать файл с offset; неполный хвост строки ждёт следующего прохода.\"\"\"\n4390|        if not self.cid or not self._transcript_ok:\n4391|            return\n4392|        path = self._transcript_file()\n4393|        if path is None:\n4394|            return\n4395|        try:\n4396|            size = path.stat().st_size\n4397|        except OSError:\n4398|            return\n4399|        rewritten = False\n4400|        if size < self._offset:  # файл переписан с нуля — читаем заново\n4401|            _log(\n4402|                f\"tail-rewrite cid={self._cid8()}: size {size} < offset {self._offset}\"\n4403|            )\n4404|            self._offset, self._buf = 0, b\"\"\n4405|            rewritten = True\n4406|        if size == self._offset:\n4407|            return\n4408|        try:\n4409|            with open(path, \"rb\") as fh:\n4410|                _ = fh.seek(self._offset)\n4411|                chunk = fh.read(TRANSCRIPT_READ_MAX)\n4412|        except OSError:\n4413|            return\n4414|        self._buf += chunk\n4415|        # Рост файла хода — активность producer (и неполная строка). При перезаписи\n4416|        # перечитывается старая история: активностью считаются только записи хода.\n4417|        self._in_rewrite = rewritten\n4418|        if chunk and not rewritten:\n4419|            self._note_activity()\n4420|        while b\"\\n\" in self._buf:\n4421|            line, self._buf = self._buf.split(b\"\\n\", 1)\n4422|            self._offset += len(line) + 1\n4423|            try:\n4424|                self._emit_record(line)\n4425|            except Exception:\n4426|                pass\n4427|        if self._usage_dirty:\n4428|            self._publish_usage()\n4429|\n4430|    def _transcript_file(self) -> Path | None:\n4431|        \"\"\"Файл транскрипта: прежний путь; при usage_enabled — закреплённый на попытку.\n4432|\n4433|        Приоритет `transcript_full.jsonl`, при ENOENT — `transcript.jsonl`; пока ни\n4434|        одного файла нет, проверка повторяется, а найденный путь не меняется до конца\n4435|        попытки (появившийся позже full не подменяет смещение другого файла).\n4436|        \"\"\"\n4437|        if not self.usage_enabled:\n4438|            return _transcript_path(self.cid)\n4439|        if self._path is None:\n4440|            self._path = _select_transcript_path(self.cid)\n4441|        return self._path\n4442|\n4443|    # ---- счётчики usage ------------------------------------------------------------\n4444|    def _record_usage(self, rec: dict[str, object]) -> None:\n4445|        \"\"\"Учесть счётчики `PLANNER_RESPONSE` текущего хода за O(1) без хранения текста.\"\"\"\n4446|        records = self.step_records_by_index\n4447|        if records is None:\n4448|            return\n4449|        self._usage_dirty = True\n4450|        idx = rec.get(\"step_index\")\n4451|        if (\n4452|            not isinstance(idx, int)\n4453|            or isinstance(idx, bool)\n4454|            or idx < 0\n4455|            or idx < self.base_idx\n4456|        ):\n4457|            self._usage_invalid += 1  # шаг без пригодного индекса не атрибутируется\n4458|            return\n4459|        inp = _count_or_none(rec.get(\"input_tokens\"))\n4460|        out = _count_or_none(rec.get(\"output_tokens\"))\n4461|        cache_raw = rec.get(\"cache_read_tokens\")\n4462|        cache = _count_or_none(cache_raw)\n4463|        counts: tuple[int, int | None, int] | None = None\n4464|        if (\n4465|            inp is not None\n4466|            and out is not None\n4467|            and (cache_raw is None or cache is not None)\n4468|        ):\n4469|            counts = (inp, cache, out)\n4470|        if idx in records:\n4471|            if counts is not None:\n4472|                old = records[idx]\n4473|                self._usage_out_sum += counts[2] - (old[2] if old is not None else 0)\n4474|                records[idx] = counts\n4475|        elif len(records) < USAGE_STEP_CAP:\n4476|            records[idx] = counts\n4477|            if counts is not None:\n4478|                self._usage_out_sum += counts[2]\n4479|        else:\n4480|            # Насыщение: ключ не вставляется, сумма output считается неполной.\n4481|            self.observed_planner_steps_saturated = True\n4482|        if counts is None:\n4483|            self._usage_invalid += 1\n4484|            return\n4485|        last = self.last_valid_step_index\n4486|        if last is None or idx >= last:\n4487|            self.last_valid_step_index = idx\n4488|            self.last_step_usage = (idx, counts[0], counts[1], counts[2])\n4489|\n4490|    def _publish_usage(self) -> None:\n4491|        \"\"\"Опубликовать неизменяемый снимок под коротким замком (без I/O под замком).\"\"\"\n4492|        records = self.step_records_by_index\n4493|        if records is None:\n4494|            return\n4495|        observed = len(records)\n4496|        snap = _UsageSnapshot(\n4497|            last_step_usage=self.last_step_usage,\n4498|            turn_output_tokens_sum=self._usage_out_sum,\n4499|            observed_planner_steps=observed,\n4500|            observed_planner_steps_saturated=self.observed_planner_steps_saturated,\n4501|            completeness=(\n4502|                observed > 0\n4503|                and not self.observed_planner_steps_saturated\n4504|                and self._usage_invalid == 0\n4505|            ),\n4506|            invalid_records_count=self._usage_invalid,\n4507|        )\n4508|        self._usage_dirty = False\n4509|        with self._usage_lock:\n4510|            self._usage_snapshot = snap\n4511|\n4512|    def usage_snapshot(self) -> _UsageSnapshot:\n4513|        with self._usage_lock:\n4514|            return self._usage_snapshot\n4515|\n4516|    def _emit_record(self, raw: bytes) -> None:\n4517|        line = raw.strip()\n4518|        if not line:\n4519|            return\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
