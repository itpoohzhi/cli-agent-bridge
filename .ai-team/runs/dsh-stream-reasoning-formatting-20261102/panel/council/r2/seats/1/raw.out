tattr(run, 'turn_id', '')[:8] or '-'} \"\n6278|                            f\"len={len(final_text)}\"\n6279|                        )\n6280|                        add_content(sep + final_text if full_emitted else final_text)\n6281|                elif not pieces and final_text:\n6282|                    add_content(final_text)\n6283|                if gone[0]:\n6284|                    return state(\"client_gone\", 1)\n6285|                time.sleep(0.05)\n6286|                err = \"\".join(run.err_box).strip()\n6287|                status = str(result_ev.get(\"status\") or \"\").upper()\n6288|                if rc != 0 and (status == \"ERROR\" or not pieces):\n6289|                    return state(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
