texts, text)\n4023|        if pos < len(self.sorted_texts) and self.sorted_texts[pos].startswith(text):\n4024|            self.probes += 1\n4025|            return \"\"\n4026|        last = self.last_step\n4027|        if last is not None and last.emitted and text.startswith(last.emitted):\n4028|            return self._advance(last, \"result\", text)\n4029|        self._retain_divergent(text)\n4030|        self.divergences += 1\n4031|        self.last_result_diverged = True\n4032|        _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n4033|        return \"\"\n4034|\n4035|\n4036|def _safe_tool_name(raw: object) -> str:\n4037|    \"\"\"Имя инструмента для маркера: только закрытый список, всё остальное -> `tool`.\"\"\"\n4038|    if not isinstance(raw, str):\n4039|        return \"tool\"\n4040|    name = raw.strip()\n4041|    if (\n4042|        not name\n4043|        or len(name) > 128\n4044|        or name[0] in \"/.\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a3","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":172,"recorded_at":1780531400000339,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c183f1b720e9cb2d6276dcf30e9","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4515 line(s) above)\n4516|    def _emit_record(self, raw: bytes) -> None:\n4517|        line = raw.strip()\n4518|        if not line:\n4519|            return\n4520|        if (\n4521|            b\"PLANNER_RESPONSE\" not in line\n4522|            and b\"END_TURN\" not in line\n4523|            and b\"TURN_COMPLETE\" not in line\n4524|        ):\n4525|            return  # быстрый отсев служебных записей без разбора JSON\n4526|        try:\n4527|            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n4528|        except ValueError:\n4529|            return\n4530|        if not isinstance(parsed, dict):\n4531|            return\n4532|        rec = cast(\"dict[str, object]\", parsed)\n4533|        rtype = str(rec.get(\"type\") or \"\")\n4534|        idx = _as_int(rec.get(\"step_index\"))\n4535|        if idx is not None and idx < self.base_idx:\n4536|            return  # история прошлых ходов\n4537|        if self._in_rewrite:\n4538|            self._note_activity()\n4539|        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n4540|            self.end_marker = True\n4541|            return\n4542|        if rtype != \"PLANNER_RESPONSE\":\n4543|            return\n4544|        if self.usage_enabled:\n4545|            self._record_usage(rec)\n4546|        content = rec.get(\"content\")\n4547|        emit_content = self.emit_content\n4548|        has_tools = bool(rec.get(\"tool_calls\"))\n4549|        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n4550|        if emit_content is not None and isinstance(content, str) and content.strip():\n4551|            if has_tools and isolate_tools:\n4552|                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n4553|            else:\n4554|                _ = emit_content(\n4555|                    idx, content\n4556|                )  # live planner-текст, независимо от tool_calls\n4557|        if idx is None:\n4558|            return\n4559|        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n4560|            self.final_planner = True\n4561|        thinking = rec.get(\"thinking\")\n4562|        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n4563|\n4564|    # ---- состояние шагов -----------------------------------------------------------\n4565|    def _state(self, idx: int) -> _StepState:\n4566|        state = self.seen.get(idx)\n4567|        if state is not None:\n4568|            return state\n4569|        if len(self.seen) >= MAX_STEPS_TRACKED:\n4570|            evictable = [\n4571|                k\n4572|                for k, s in self.seen.items()\n4573|                if s.finalized and k < self.poll_watermark\n4574|            ]\n4575|            if evictable:\n4576|                del self.seen[min(evictable)]\n4577|            else:\n4578|                self._sqlite_off(\"seen_cap\")\n4579|                del self.seen[min(self.seen)]\n4580|        state = _StepState()\n4581|        self.seen[idx] = state\n4582|        return state\n4583|\n4584|    def _step_done(self, state: _StepState) -> bool:\n4585|        return state.sql_done or (\n4586|            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n4587|        )\n4588|\n4589|    def _advance_watermark(self) -> None:\n4590|        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n4591|        mark = self.poll_watermark\n4592|        for key in sorted(self.seen):\n4593|            if key < mark:\n4594|                continue\n4595|            if not self._step_done(self.seen[key]):\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a5","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":173,"recorded_at":1780531400000341,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c184220773ebf1d6b08b3d0a858","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(5299 line(s) above)\n5300|                self.transcript_activity_ts = now\n5301|\n5302|    def _on_tail_activity(self) -> None:\n5303|        self.note_producer_activity(\"transcript\")\n5304|\n5305|    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n5306|        \"\"\"Кандидат planner-текста в арбитр; новый суффикс уходит в очередь под _emit_lock.\n5307|\n5308|        Сокетного ввода-вывода здесь нет: потребитель (`_execute`) пишет в сокет сам.\n5309|        False — выдача уже закрыта terminal barrier'ом.\n5310|        \"\"\"\n5311|        with self._emit_lock:\n5312|            if self.drain_closed:\n5313|                return False\n5314|            suffix = self._arbiter.offer(\n5315|                source, step_index, text, self._tail.cid or self.run_cid\n5316|            )\n5317|            if suffix:\n5318|                sep = \"\"\n5319|                last_idx = getattr(self, \"_last_step_index\", None)\n5320|                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5321|                if last_idx is not None and last_idx != step_index and emitted_wire:\n5322|                    if not emitted_wire.endswith(\"\\n\"):\n5323|                        sep = (\n5324|                            \"\\n\\n\"\n5325|                            if not suffix.startswith(\"\\n\")\n5326|                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n5327|                        )\n5328|                    elif not emitted_wire.endswith(\"\\n\\n\"):\n5329|                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n5330|                self._last_step_index = step_index\n5331|                self._content_emitted_wire = emitted_wire + sep + suffix\n5332|                self.q.put((\"text\", sep + suffix))\n5333|        return True\n5334|\n5335|    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n5336|        return self.offer_content(\"transcript\", step_index, text)\n5337|\n5338|    def reconcile_result(self, text: str) -> str:\n5339|        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром.\"\"\"\n5340|        with self._emit_lock:\n5341|            return self._arbiter.reconcile_result(text)\n5342|\n5343|    def retained_divergent_text(self) -> str:\n5344|        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n5345|        with self._emit_lock:\n5346|            return self._arbiter.retained_divergent_text()\n5347|\n5348|    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n5349|        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a7","stream":{"kind":"session","id":"01a19c16-8193-74b1-8cb9-7d3fda4a4cbb"},"sequence":174,"recorded_at":1780531400000343,"record_type":"event","durability":"durable","causation_id":"01a19c16-a64d-72f0-998d-b36676443e71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c16-a64d-72f0-998d-b36676443e71","run_stream":{"kind":"run","id":"01a19c16-a64d-72f0-998d-b36676443e71"},"call_id":"call_01a19c18456b71d48c160ed86f2aa9fa","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(5439 line(s) above)\n5440|        \"\"\"\n5441|        final_text = \"\"\n5442|        result_ev = {}\n5443|        tool_ordinal = 0\n5444|        tool_ordinal_by_id: dict[str, int] = {}\n5445|        term_kind = \"pump_error\"\n5446|        term_payload: object = \"pump terminated\"\n5447|        try:\n5448|            for raw in iter(self.proc.stdout.readline, b\"\"):\n5449|                line = raw.decode(\"utf-8\", \"replace\").strip()\n5450|                if not line.startswith(\"{\"):\n5451|                    continue\n5452|                try:\n5453|                    ev = json.loads(line)\n5454|                except ValueError:\n5455|                    continue\n5456|                self.got_event = True\n5457|                self.note_producer_activity(\"stdout\")\n5458|                etype = ev.get(\"event\")\n5459|                if etype == \"init\":\n5460|                    init = ev.get(\"init\") if isinstance(ev.get(\"init\"), dict) else {}\n5461|                    tools_raw = cast(object, init.get(\"tools\"))\n5462|                    tools = (\n5463|                        cast(\"list[object]\", tools_raw)\n5464|                        if isinstance(tools_raw, list)\n5465|                        else []\n5466|                    )\n5467|                    self.q.put(\n5468|                        (\n5469|                            \"init\",\n5470|                            {\n5471|                                \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n5472|                                \"tools\": len(tools),\n5473|                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n5474|                            },\n5475|                        )\n5476|                    )\n5477|                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n5478|                elif etype == \"step_update\":\n5479|                    step = (\n5480|                        ev.get(\"step_update\")\n5481|                        if isinstance(ev.get(\"step_update\"), dict)\n5482|                        else {}\n5483|                    )\n5484|                    kind = step.get(\"step_type\")\n5485|                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n5486|                        if self.content_streaming:\n5487|                            _ = self.offer_content(\n5488|                                \"stdout\",\n5489|                                _as_int(step.get(\"step_index\")),\n5490|                                str(step[\"text_delta\"]),\n5491|                            )\n5492|                        else:\n5493|                            suffix = _reasoning_suffix(\n5494|                                self._text_seen,\n5495|                                str(step.get(\"step_index\", \"\")),\n5496|                                str(step[\"text_delta\"]),\n5497|                            )\n5498|                            if suffix:\n5499|                                self.q.put((\"text\", suffix))\n5500|                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n5501|                        step_idx = _as_int(step.get(\"step_index\"))\n5502|                        trace: dict[str, object] = {\n5503|                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n5504|                            \"duration_s\": step.get(\"duration_seconds\"),\n5505|                            \"step_index\": step_idx,\n5506|                        }\n5507|                        if step_idx is None:\n5508|                            # Идентичность DONE без step_index: монотонный ordinal хода,\n5509|                            # назначается один раз и переживает повторную доставку события.\n5510|                            raw_id = (\n5511|                                step.get(\"call_id\")\n5512|                                or step.get(\"tool_call_id\")\n5513|                                or step.get(\"id\")\n5514|                            )\n5515|                            call_id = (\n5516|                                str(raw_id).strip()\n5517|                                if isinstance(raw_id, (str, int))\n5518|                                else \"\"\n5519|                            )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
