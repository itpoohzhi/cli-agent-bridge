{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ZBtF3R5x3puQMX1CU42nc","type":"tool_result","content":"100\t    )\n101\t\n102\t\n103\tdef smoke_test_model(\n104\t    hub_url: str,\n105\t    model_id: str,\n106\t    timeout_s: float = 15.0,\n107\t    api_key: str = \"test-smoke-key\",\n108\t) -> tuple[bool, str, float]:\n109\t    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n110\t    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n111\t    payload = {\n112\t        \"model\": model_id,\n113\t        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n114\t        \"max_tokens\": 10,\n115\t        \"stream\": False,\n116\t    }\n117\t    data_bytes = json.dumps(payload).encode(\"utf-8\")\n118\t    req = urllib.request.Request(\n119\t        endpoint,\n120\t        data=data_bytes,\n121\t        headers={\n122\t            \"Content-Type\": \"application/json\",\n123\t            \"Authorization\": f\"Bearer {api_key}\",\n124\t        },\n125\t        method=\"POST\",\n126\t    )\n127\t\n128\t    t0 = time.monotonic()\n129\t    try:\n130\t        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n131\t            elapsed = time.monotonic() - t0\n132\t            status_code = resp.getcode()\n133\t            if status_code != 200:\n134\t                return False, f\"HTTP {status_code}\", elapsed\n135\t            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n136\t            res_json = json.loads(raw_body)\n137\t            choices = res_json.get(\"choices\") or []\n138\t            if not choices:\n139\t                return False, \"Empty choices\", elapsed\n140\t            return True, \"OK\", elapsed\n141\t    except urllib.error.HTTPError as e:\n142\t        elapsed = time.monotonic() - t0\n143\t        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n144\t        return False, err_msg, elapsed\n145\t    except Exception as e:\n146\t        elapsed = time.monotonic() - t0\n147\t        return False, mask_secret(f\"Error: {e}\"), elapsed\n148\t\n149\t\n150\tdef main() -> int:\n151\t    parser = argparse.ArgumentParser(\n152\t        description=\"Smoke test runner for models defined in models.md\"\n153\t    )\n154\t    parser.add_argument(\n155\t        \"--models-md\",\n156\t        type=Path,\n157\t        default=DEFAULT_MODELS_MD,\n158\t        help=\"Path to Context/models.md\",\n159\t    )\n160\t    parser.add_argument(\n161\t        \"--hub-url\",\n162\t        type=str,\n163\t        default=DEFAULT_HUB_URL,\n164\t        help=\"URL of the bridge hub endpoint\",\n165\t    )\n166\t    parser.add_argument(\n167\t        \"--model\",\n168\t        type=str,\n169\t        default=\"\",\n170\t        help=\"Filter by specific model ID\",\n171\t    )\n172\t    parser.add_argument(\n173\t        \"--dry-run\",\n174\t        action=\"store_true\",\n175\t        help=\"Validate configuration and parse models without sending network requests\",\n176\t    )\n177\t    parser.add_argument(\n178\t        \"--live\",\n179\t        action=\"store_true\",\n180\t        help=\"Execute live HTTP smoke requests against the hub\",\n181\t    )\n182\t    parser.add_argument(\n183\t        \"--timeout\",\n184\t        type=float,\n185\t        default=15.0,\n186\t        help=\"Request timeout in seconds\",\n187\t    )\n188\t\n189\t    args = parser.parse_args()\n190\t\n191\t    models = parse_models_md(args.models_md)\n192\t    if args.model:\n193\t        models = [m for m in models if m.model_id == args.model]\n194\t\n195\t    if not models:\n196\t        print(\"FAIL: No models found matching criteria.\")\n197\t        return 1\n198\t\n199\t    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n200\t    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n201\t    print(\"-\" * 88)\n202\t\n203\t    all_ok = True\n204\t    for entry in models:\n205\t        if args.dry_run or not args.live:\n206\t            status = \"CONFIGURED\"\n207\t            latency_str = \"-\"\n208\t        else:\n209\t            ok, status, lat = smoke_test_model(\n210\t                args.hub_url, entry.model_id, timeout_s=args.timeout\n211\t            )\n212\t            latency_str = f\"{lat:.2f}s\"\n213\t            if not ok:\n214\t                all_ok = False\n215\t\n216\t        print(\n217\t            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n218\t        )\n219\t\n220\t    if args.dry_run:\n221\t        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n222\t        return 0\n223\t\n224\t    if not args.live:\n225\t        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n226\t        return 0\n227\t\n228\t    return 0 if all_ok else 1\n229\t\n230\t\n231\tif __name__ == \"__main__\":\n232\t    sys.exit(main())"}]},"parent_tool_use_id":null,"session_id":"5d0617cf-9fec-4e2f-8c90-ae2267543739","uuid":"4929b234-3374-4e7f-a423-2737fc5dfc5e","timestamp":"2026-11-02T11:54:12.986Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py","content":"    )\n\n\ndef smoke_test_model(\n    hub_url: str,\n    model_id: str,\n    timeout_s: float = 15.0,\n    api_key: str = \"test-smoke-key\",\n) -> tuple[bool, str, float]:\n    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n    payload = {\n        \"model\": model_id,\n        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n        \"max_tokens\": 10,\n        \"stream\": False,\n    }\n    data_bytes = json.dumps(payload).encode(\"utf-8\")\n    req = urllib.request.Request(\n        endpoint,\n        data=data_bytes,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"Authorization\": f\"Bearer {api_key}\",\n        },\n        method=\"POST\",\n    )\n\n    t0 = time.monotonic()\n    try:\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n            elapsed = time.monotonic() - t0\n            status_code = resp.getcode()\n            if status_code != 200:\n                return False, f\"HTTP {status_code}\", elapsed\n            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n            res_json = json.loads(raw_body)\n            choices = res_json.get(\"choices\") or []\n            if not choices:\n                return False, \"Empty choices\", elapsed\n            return True, \"OK\", elapsed\n    except urllib.error.HTTPError as e:\n        elapsed = time.monotonic() - t0\n        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n        return False, err_msg, elapsed\n    except Exception as e:\n        elapsed = time.monotonic() - t0\n        return False, mask_secret(f\"Error: {e}\"), elapsed\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Smoke test runner for models defined in models.md\"\n    )\n    parser.add_argument(\n        \"--models-md\",\n        type=Path,\n        default=DEFAULT_MODELS_MD,\n        help=\"Path to Context/models.md\",\n    )\n    parser.add_argument(\n        \"--hub-url\",\n        type=str,\n        default=DEFAULT_HUB_URL,\n        help=\"URL of the bridge hub endpoint\",\n    )\n    parser.add_argument(\n        \"--model\",\n        type=str,\n        default=\"\",\n        help=\"Filter by specific model ID\",\n    )\n    parser.add_argument(\n        \"--dry-run\",\n        action=\"store_true\",\n        help=\"Validate configuration and parse models without sending network requests\",\n    )\n    parser.add_argument(\n        \"--live\",\n        action=\"store_true\",\n        help=\"Execute live HTTP smoke requests against the hub\",\n    )\n    parser.add_argument(\n        \"--timeout\",\n        type=float,\n        default=15.0,\n        help=\"Request timeout in seconds\",\n    )\n\n    args = parser.parse_args()\n\n    models = parse_models_md(args.models_md)\n    if args.model:\n        models = [m for m in models if m.model_id == args.model]\n\n    if not models:\n        print(\"FAIL: No models found matching criteria.\")\n        return 1\n\n    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n    print(\"-\" * 88)\n\n    all_ok = True\n    for entry in models:\n        if args.dry_run or not args.live:\n            status = \"CONFIGURED\"\n            latency_str = \"-\"\n        else:\n            ok, status, lat = smoke_test_model(\n                args.hub_url, entry.model_id, timeout_s=args.timeout\n            )\n            latency_str = f\"{lat:.2f}s\"\n            if not ok:\n                all_ok = False\n\n        print(\n            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n        )\n\n    if args.dry_run:\n        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n        return 0\n\n    if not args.live:\n        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n        return 0\n\n    return 0 if all_ok else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","numLines":133,"startLine":100,"totalLines":233}},"tool_result_meta":[{"id":"toolu_014ZBtF3R5x3puQMX1CU42nc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
