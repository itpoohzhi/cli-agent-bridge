{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f3","stream":{"kind":"session","id":"01a19c0c-21fa-7fe3-a67c-0ddbd4537ca0"},"sequence":84,"recorded_at":1780531400000163,"record_type":"event","durability":"durable","causation_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","run_stream":{"kind":"run","id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f"},"task_stream":{"kind":"task","id":"01a19c12-1d99-7bf2-8887-440ef5283481"},"task_id":"01a19c12-1d99-7bf2-8887-440ef5283481","event":{"kind":"output","task_id":"01a19c12-1d99-7bf2-8887-440ef5283481","chunk":"{\n  \"chunk_id\": \"exec-3-1\",\n  \"command\": \"cat /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py; echo \\\"=====SMOKE=====\\\"; cat /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py\",\n  \"description\": \"Прочитать новые тесты и смоук\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\\"\\\"\\\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\\n\\nПроверяет:\\n1. Разграничение шагов Markdown (\\\\\\\\n\\\\\\\\n, отсутствие склейки слов вида \\\"данных.Проверяю\\\").\\n2. Исключение зацикливания префиксов оркестрации (\\\"[гейт оркестрации: активен...\\\").\\n3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\\n4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport queue\\nimport re\\nimport sys\\nimport threading\\nimport unittest\\nfrom types import SimpleNamespace\\nfrom typing import Any, cast\\n\\n_REPO_ROOT = Path(__file__).resolve().parents[1]\\nif str(_REPO_ROOT) not in sys.path:\\n    sys.path.insert(0, str(_REPO_ROOT))\\n\\n_BRIDGE_PY = _REPO_ROOT / \\\"bridges\\\" / \\\"agy-bridge\\\" / \\\"server.py\\\"\\n\\n\\ndef _load_bridge() -> Any:\\n    os.environ.setdefault(\\\"AGY_BRIDGE_KEY\\\", \\\"test-key-stream-e2e\\\")\\n    spec = importlib.util.spec_from_file_location(\\n        \\\"agy_bridge_server_e2e_under_test\\\", _BRIDGE_PY\\n    )\\n    assert spec is not None and spec.loader is not None\\n    module = importlib.util.module_from_spec(spec)\\n    sys.modules[spec.name] = module\\n    spec.loader.exec_module(module)\\n    return module\\n\\n\\nsrv = _load_bridge()\\n\\n\\nclass SyntheticE2EAgentStreamTests(unittest.TestCase):\\n    \\\"\\\"\\\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\\\"\\\"\\\"\\n\\n    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: шаги агента разделяются \\\\\\\\n\\\\\\\\n, слова на стыках не склеиваются.\\\"\\\"\\\"\\n        run = object.__new__(srv.Run)\\n        setattr(run, \\\"_emit_lock\\\", threading.Lock())\\n        setattr(run, \\\"q\\\", queue.Queue())\\n        setattr(run, \\\"drain_closed\\\", False)\\n        setattr(run, \\\"_done_put\\\", False)\\n        setattr(run, \\\"_reasoning_bytes\\\", 0)\\n        setattr(run, \\\"_cap_logged\\\", False)\\n        setattr(run, \\\"_tail\\\", SimpleNamespace(cid=\\\"cid-test-e2e\\\"))\\n        setattr(run, \\\"_arbiter\\\", srv._ContentArbiter(\\\"turn-e2e-1\\\"))\\n        setattr(run, \\\"turn_id\\\", \\\"turn-e2e-1\\\")\\n        setattr(run, \\\"run_cid\\\", \\\"cid-test-e2e\\\")\\n        setattr(run, \\\"_last_step_index\\\", None)\\n        setattr(run, \\\"_content_emitted_wire\\\", \\\"\\\")\\n\\n        # Эмулируем шаги из скриншота пользователя:\\n        # Шаг 1: \\\"Ищу в базе знаний и git посл\\\"\\n        run.offer_content(\\\"stdout\\\", 1, \\\"Ищу в базе знаний и git посл\\\")\\n        # Шаг 1 (продолжение): \\\"Проверяю результаты поиска по переезду базы данных.\\\"\\n        run.offer_content(\\\"stdout\\\", 1, \\\"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\\\")\\n        # Шаг 2: \\\"Проверяю вывод лога задачи 349.\\\" (начинается с заглавной буквы)\\n        run.offer_content(\\\"stdout\\\", 2, \\\"Проверяю вывод лога задачи 349.\\\")\\n        # Шаг 3: \\\"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\\\"\\n        run.offer_content(\\\"stdout\\\", 3, \\\"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\\\")\\n\\n        q = cast(\\\"queue.Queue[tuple[str, object]]\\\", getattr(run, \\\"q\\\"))\\n        emitted_chunks: list[str] = []\\n        while not q.empty():\\n            item = q.get_nowait()\\n            if item[0] == \\\"text\\\":\\n                emitted_chunks.append(str(item[1]))\\n\\n        full_stream = \\\"\\\".join(emitted_chunks)\\n\\n        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\\n        glued_pattern = re.compile(r\\\"[а-яёa-z]\\\\.[А-ЯЁA-Z]\\\")\\n        self.assertIsNone(\\n            glued_pattern.search(full_stream),\\n            f\\\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\\\",\\n        )\\n\\n        # 2. Проверяем наличие разделителя \\\\n\\\\n между шагами 1, 2 и 3\\n        self.assertIn(\\\"базы данных.\\\\n\\\\nПроверяю вывод\\\", full_stream)\\n        self.assertIn(\\\"задачи 349.\\\\n\\\\nОстанавливаю фоновую\\\", full_stream)\\n\\n    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\\\"\\\"\\\"\\n        arb = srv._ContentArbiter(\\\"turn-orch-1\\\")\\n\\n        # Агент меняет статусы оркестрации на протяжении 5 шагов\\n        statuses = [\\n            \\\"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\\\",\\n            \\\"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\\\",\\n            \\\"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\\\",\\n            \\\"[гейт оркестрации: активен | роль: worker] Запуск pytest\\\",\\n            \\\"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\\\",\\n        ]\\n\\n        emitted_deltas: list[str] = []\\n        for idx, status in enumerate(statuses, 1):\\n            # Эмулируем приход короткого префикса, затем полного текста\\n            short_prefix = status[:27]  # \\\"[гейт оркестрации: активен\\\"\\n            d1 = arb.offer(\\\"transcript\\\", idx, short_prefix, \\\"cid-orch\\\")\\n            if d1:\\n                emitted_deltas.append(d1)\\n            d2 = arb.offer(\\\"transcript\\\", idx, status, \\\"cid-orch\\\")\\n            if d2:\\n                emitted_deltas.append(d2)\\n\\n        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\\n        self.assertEqual(arb.divergences, 0)\\n\\n        # Полный текст не должен содержать патологического зацикливания \\\"[гейт оркестрации: активен\\\"\\n        full_text = \\\"\\\".join(emitted_deltas)\\n        count = full_text.count(\\\"[гейт оркестрации: активен\\\")\\n        self.assertEqual(\\n            count,\\n            len(statuses),\\n            f\\\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\\\",\\n        )\\n\\n    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\\\"\\\"\\\"\\n        emitted_events: list[tuple[str, str]] = []\\n\\n        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\\n            emitted_events.append((\\\"reasoning\\\", delta))\\n            if on_del is not None:\\n                on_del()\\n            return True\\n\\n        def emit_content(idx: int | None, text: str) -> bool:\\n            emitted_events.append((\\\"content\\\", text))\\n            return True\\n\\n        plan = srv._TurnPlan()\\n        plan.mode = \\\"OFF\\\"\\n        plan.base_idx = 0\\n        plan.offset = 0\\n\\n        tail = srv._TranscriptTail(\\n            emit=emit_reasoning,\\n            stop_event=threading.Event(),\\n            done_event=threading.Event(),\\n            resumed=False,\\n            plan=plan,\\n            turn_id=\\\"turn-subagent-1\\\",\\n            emit_content=emit_content,\\n            on_activity=None,\\n            usage_enabled=False,\\n            isolate_tool_preambles=True,\\n        )\\n\\n        # Эмулируем транскрипт мультиагентного цикла:\\n        # Шаг 1: Оркестратор запускает сабагента Coder\\n        record_step1 = {\\n            \\\"type\\\": \\\"PLANNER_RESPONSE\\\",\\n            \\\"step_index\\\": 1,\\n            \\\"content\\\": \\\"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\\\",\\n            \\\"thinking\\\": \\\"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\\\",\\n            \\\"tool_calls\\\": [\\n                {\\n                    \\\"name\\\": \\\"invoke_subagent\\\",\\n                    \\\"args\\\": {\\\"Role\\\": \\\"Coder\\\", \\\"Prompt\\\": \\\"Fix test\\\"},\\n                }\\n            ],\\n        }\\n        tail._emit_record(json.dumps(record_step1).encode(\\\"utf-8\\\"))\\n\\n        # Шаг 2: Финальный ответ после завершения сабагента\\n        record_step2 = {\\n            \\\"type\\\": \\\"PLANNER_RESPONSE\\\",\\n            \\\"step_index\\\": 2,\\n            \\\"content\\\": \\\"Сабагент Coder завершил работу. Все тесты успешно пройдены.\\\",\\n            \\\"thinking\\\": \\\"Формирую итоговый статус для владельца.\\\",\\n        }\\n        tail._emit_record(json.dumps(record_step2).encode(\\\"utf-8\\\"))\\n\\n        # Проверяем распределение:\\n        # 1. Преамбула шага 1 ушла в reasoning\\n        reasoning_pieces = [text for kind, text in emitted_events if kind == \\\"reasoning\\\"]\\n        self.assertTrue(any(\\\"Запускаю сабагента Coder\\\" in r for r in reasoning_pieces))\\n\\n        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\\n        content_pieces = [text for kind, text in emitted_events if kind == \\\"content\\\"]\\n        self.assertEqual(len(content_pieces), 1)\\n        self.assertEqual(\\n            content_pieces[0],\\n            \\\"Сабагент Coder завершил работу. Все тесты успешно пройдены.\\\",\\n        )\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n=====SMOKE=====\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\\n\\nПозволяет автоматически проверять доступность и работоспособность моделей из\\nканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\\n\\nИспользование:\\n    python3 scripts/smoke_models.py --dry-run\\n    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\\n    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport re\\nimport sys\\nimport time\\nimport urllib.error\\nimport urllib.request\\nfrom typing import Any, NamedTuple\\n\\n\\nDEFAULT_MODELS_MD = Path(\\n    os.environ.get(\\\"MODELS_MD_PATH\\\") or \\\"~/Мой диск/Context/models.md\\\"\\n).expanduser()\\nDEFAULT_HUB_URL = os.environ.get(\\\"HUB_BRIDGE_URL\\\", \\\"http://127.0.0.1:9882/v1\\\")\\n\\n\\nclass ModelEntry(NamedTuple):\\n    role: str\\n    model_id: str\\n    effort: str\\n    family: str\\n\\n\\ndef parse_models_md(path: Path) -> list[ModelEntry]:\\n    \\\"\\\"\\\"Извлечь уникальные модели и роли из models.md.\\\"\\\"\\\"\\n    if not path.is_file():\\n        # Fallback на локальный список, если файл канона недоступен\\n        return [\\n            ModelEntry(\\\"Coder\\\", \\\"claude-sonnet-5-5\\\", \\\"high\\\", \\\"Anthropic\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"gpt-6.1-sol\\\", \\\"high\\\", \\\"OpenAI\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"gemini-4-argon-high\\\", \\\"high\\\", \\\"Google\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"muse-wonder-full-1.0\\\", \\\"xhigh\\\", \\\"Meta\\\"),\\n            ModelEntry(\\\"Architect\\\", \\\"gpt-6.1-sol\\\", \\\"high\\\", \\\"OpenAI\\\"),\\n            ModelEntry(\\\"Reviewer\\\", \\\"claude-sonnet-5-5\\\", \\\"high\\\", \\\"Anthropic\\\"),\\n        ]\\n\\n    content = path.read_text(encoding=\\\"utf-8\\\")\\n    entries: list[ModelEntry] = []\\n    current_role = \\\"General\\\"\\n\\n    # Регулярное выражение для строк вида:\\n    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\\n    row_pattern = re.compile(\\n        r\\\"^\\\\|\\\\s*`?([a-zA-Z0-9.\\\\-_]+)`?\\\\s*\\\\|\\\\s*`?([a-zA-Z0-9]+)`?\\\\s*\\\\|\\\\s*([a-zA-Z0-9.\\\\s]+)\\\\s*\\\\|\\\"\\n    )\\n\\n    for line in content.splitlines():\\n        line = line.strip()\\n        if line.startswith(\\\"### \\\"):\\n            header = line[4:].strip()\\n            # Извлекаем роль из заголовка (например \\\"### Coder — пул разработки...\\\")\\n            current_role = header.split(\\\"—\\\")[0].split(\\\"-\\\")[0].strip()\\n            continue\\n\\n        match = row_pattern.match(line)\\n        if match:\\n            model_id = match.group(1).strip()\\n            effort = match.group(2).strip()\\n            family = match.group(3).strip()\\n            # Пропускаем заголовки таблиц\\n            if model_id.lower() in (\\\"модель\\\", \\\"слот\\\", \\\"пакет\\\", \\\"№\\\", \\\"роль\\\"):\\n                continue\\n            entries.append(ModelEntry(current_role, model_id, effort, family))\\n\\n    # Дедупликация по паре (role, model_id)\\n    seen = set()\\n    unique_entries = []\\n    for e in entries:\\n        key = (e.role, e.model_id)\\n        if key not in seen:\\n            seen.add(key)\\n            unique_entries.append(e)\\n\\n    return unique_entries\\n\\n\\ndef mask_secret(text: str) -> str:\\n    \\\"\\\"\\\"Маскирование токенов и авторизационных заголовков.\\\"\\\"\\\"\\n    return re.sub(\\n        r\\\"(Bearer\\\\s+)[a-zA-Z0-9_\\\\-\\\\.]{8,}\\\",\\n        r\\\"\\\\1[MASKED]\\\",\\n        text,\\n        flags=re.IGNORECASE,\\n    )\\n\\n\\ndef smoke_test_model(\\n    hub_url: str,\\n    model_id: str,\\n    timeout_s: float = 15.0,\\n    api_key: str = \\\"test-smoke-key\\\",\\n) -> tuple[bool, str, float]:\\n    \\\"\\\"\\\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\\\"\\\"\\\"\\n    endpoint = hub_url.rstrip(\\\"/\\\") + \\\"/chat/completions\\\"\\n    payload = {\\n        \\\"model\\\": model_id,\\n        \\\"messages\\\": [{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"ping\\\"}],\\n        \\\"max_tokens\\\": 10,\\n        \\\"stream\\\": False,\\n    }\\n    data_bytes = json.dumps(payload).encode(\\\"utf-8\\\")\\n    req = urllib.request.Request(\\n        endpoint,\\n        data=data_bytes,\\n        headers={\\n            \\\"Content-Type\\\": \\\"application/json\\\",\\n            \\\"Authorization\\\": f\\\"Bearer {api_key}\\\",\\n        },\\n        method=\\\"POST\\\",\\n    )\\n\\n    t0 = time.monotonic()\\n    try:\\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\\n            elapsed = time.monotonic() - t0\\n            status_code = resp.getcode()\\n            if status_code != 200:\\n                return False, f\\\"HTTP {status_code}\\\", elapsed\\n            raw_body = resp.read().decode(\\\"utf-8\\\", \\\"replace\\\")\\n            res_json = json.loads(raw_body)\\n            choices = res_json.get(\\\"choices\\\") or []\\n            if not choices:\\n                return False, \\\"Empty choices\\\", elapsed\\n            return True, \\\"OK\\\", elapsed\\n    except urllib.error.HTTPError as e:\\n        elapsed = time.monotonic() - t0\\n        err_msg = mask_secret(f\\\"HTTP {e.code}: {e.reason}\\\")\\n        return False, err_msg, elapsed\\n    except Exception as e:\\n        elapsed = time.monotonic() - t0\\n        return False, mask_secret(f\\\"Error: {e}\\\"), elapsed\\n\\n\\ndef main() -> int:\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Smoke test runner for models defined in models.md\\\"\\n    )\\n    parser.add_argument(\\n        \\\"--models-md\\\",\\n        type=Path,\\n        default=DEFAULT_MODELS_MD,\\n        help=\\\"Path to Context/models.md\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--hub-url\\\",\\n        type=str,\\n        default=DEFAULT_HUB_URL,\\n        help=\\\"URL of the bridge hub endpoint\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--model\\\",\\n        type=str,\\n        default=\\\"\\\",\\n        help=\\\"Filter by specific model ID\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--dry-run\\\",\\n        action=\\\"store_true\\\",\\n        help=\\\"Validate configuration and parse models without sending network requests\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--live\\\",\\n        action=\\\"store_true\\\",\\n        help=\\\"Execute live HTTP smoke requests against the hub\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--timeout\\\",\\n        type=float,\\n        default=15.0,\\n        help=\\\"Request timeout in seconds\\\",\\n    )\\n\\n    args = parser.parse_args()\\n\\n    models = parse_models_md(args.models_md)\\n    if args.model:\\n        models = [m for m in models if m.model_id == args.model]\\n\\n    if not models:\\n        print(\\\"FAIL: No models found matching criteria.\\\")\\n        return 1\\n\\n    print(f\\\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\\\")\\n    print(f\\\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\\\")\\n    print(\\\"-\\\" * 88)\\n\\n    all_ok = True\\n    for entry in models:\\n        if args.dry_run or not args.live:\\n            status = \\\"CONFIGURED\\\"\\n            latency_str = \\\"-\\\"\\n        else:\\n            ok, status, lat = smoke_test_model(\\n                args.hub_url, entry.model_id, timeout_s=args.timeout\\n            )\\n            latency_str = f\\\"{lat:.2f}s\\\"\\n            if not ok:\\n                all_ok = False\\n\\n        print(\\n            f\\\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\\\"\\n        )\\n\\n    if args.dry_run:\\n        print(\\\"\\\\nPASS: Configuration is valid (dry-run mode).\\\")\\n        return 0\\n\\n    if not args.live:\\n        print(\\\"\\\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\\\")\\n        return 0\\n\\n    return 0 if all_ok else 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\n  \"original_output_bytes\": 18161,\n  \"original_output_tokens\": 4541,\n  \"truncated\": false\n}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f5","stream":{"kind":"session","id":"01a19c0c-21fa-7fe3-a67c-0ddbd4537ca0"},"sequence":85,"recorded_at":1780531400000165,"record_type":"event","durability":"durable","causation_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","run_stream":{"kind":"run","id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f"},"task_stream":{"kind":"task","id":"01a19c12-1d99-7bf2-8887-440ef5283481"},"task_id":"01a19c12-1d99-7bf2-8887-440ef5283481","event":{"kind":"completed","task_id":"01a19c12-1d99-7bf2-8887-440ef5283481"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f7","stream":{"kind":"session","id":"01a19c0c-21fa-7fe3-a67c-0ddbd4537ca0"},"sequence":86,"recorded_at":1780531400000167,"record_type":"event","durability":"durable","causation_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","run_stream":{"kind":"run","id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f"},"call_id":"call_01a19c12120074a9bac0527490d6a3db","text":"{\n  \"chunk_id\": \"exec-3-1\",\n  \"command\": \"cat /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py; echo \\\"=====SMOKE=====\\\"; cat /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py\",\n  \"description\": \"Прочитать новые тесты и смоук\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\\"\\\"\\\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\\n\\nПроверяет:\\n1. Разграничение шагов Markdown (\\\\\\\\n\\\\\\\\n, отсутствие склейки слов вида \\\"данных.Проверяю\\\").\\n2. Исключение зацикливания префиксов оркестрации (\\\"[гейт оркестрации: активен...\\\").\\n3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\\n4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport queue\\nimport re\\nimport sys\\nimport threading\\nimport unittest\\nfrom types import SimpleNamespace\\nfrom typing import Any, cast\\n\\n_REPO_ROOT = Path(__file__).resolve().parents[1]\\nif str(_REPO_ROOT) not in sys.path:\\n    sys.path.insert(0, str(_REPO_ROOT))\\n\\n_BRIDGE_PY = _REPO_ROOT / \\\"bridges\\\" / \\\"agy-bridge\\\" / \\\"server.py\\\"\\n\\n\\ndef _load_bridge() -> Any:\\n    os.environ.setdefault(\\\"AGY_BRIDGE_KEY\\\", \\\"test-key-stream-e2e\\\")\\n    spec = importlib.util.spec_from_file_location(\\n        \\\"agy_bridge_server_e2e_under_test\\\", _BRIDGE_PY\\n    )\\n    assert spec is not None and spec.loader is not None\\n    module = importlib.util.module_from_spec(spec)\\n    sys.modules[spec.name] = module\\n    spec.loader.exec_module(module)\\n    return module\\n\\n\\nsrv = _load_bridge()\\n\\n\\nclass SyntheticE2EAgentStreamTests(unittest.TestCase):\\n    \\\"\\\"\\\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\\\"\\\"\\\"\\n\\n    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: шаги агента разделяются \\\\\\\\n\\\\\\\\n, слова на стыках не склеиваются.\\\"\\\"\\\"\\n        run = object.__new__(srv.Run)\\n        setattr(run, \\\"_emit_lock\\\", threading.Lock())\\n        setattr(run, \\\"q\\\", queue.Queue())\\n        setattr(run, \\\"drain_closed\\\", False)\\n        setattr(run, \\\"_done_put\\\", False)\\n        setattr(run, \\\"_reasoning_bytes\\\", 0)\\n        setattr(run, \\\"_cap_logged\\\", False)\\n        setattr(run, \\\"_tail\\\", SimpleNamespace(cid=\\\"cid-test-e2e\\\"))\\n        setattr(run, \\\"_arbiter\\\", srv._ContentArbiter(\\\"turn-e2e-1\\\"))\\n        setattr(run, \\\"turn_id\\\", \\\"turn-e2e-1\\\")\\n        setattr(run, \\\"run_cid\\\", \\\"cid-test-e2e\\\")\\n        setattr(run, \\\"_last_step_index\\\", None)\\n        setattr(run, \\\"_content_emitted_wire\\\", \\\"\\\")\\n\\n        # Эмулируем шаги из скриншота пользователя:\\n        # Шаг 1: \\\"Ищу в базе знаний и git посл\\\"\\n        run.offer_content(\\\"stdout\\\", 1, \\\"Ищу в базе знаний и git посл\\\")\\n        # Шаг 1 (продолжение): \\\"Проверяю результаты поиска по переезду базы данных.\\\"\\n        run.offer_content(\\\"stdout\\\", 1, \\\"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\\\")\\n        # Шаг 2: \\\"Проверяю вывод лога задачи 349.\\\" (начинается с заглавной буквы)\\n        run.offer_content(\\\"stdout\\\", 2, \\\"Проверяю вывод лога задачи 349.\\\")\\n        # Шаг 3: \\\"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\\\"\\n        run.offer_content(\\\"stdout\\\", 3, \\\"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\\\")\\n\\n        q = cast(\\\"queue.Queue[tuple[str, object]]\\\", getattr(run, \\\"q\\\"))\\n        emitted_chunks: list[str] = []\\n        while not q.empty():\\n            item = q.get_nowait()\\n            if item[0] == \\\"text\\\":\\n                emitted_chunks.append(str(item[1]))\\n\\n        full_stream = \\\"\\\".join(emitted_chunks)\\n\\n        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\\n        glued_pattern = re.compile(r\\\"[а-яёa-z]\\\\.[А-ЯЁA-Z]\\\")\\n        self.assertIsNone(\\n            glued_pattern.search(full_stream),\\n            f\\\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\\\",\\n        )\\n\\n        # 2. Проверяем наличие разделителя \\\\n\\\\n между шагами 1, 2 и 3\\n        self.assertIn(\\\"базы данных.\\\\n\\\\nПроверяю вывод\\\", full_stream)\\n        self.assertIn(\\\"задачи 349.\\\\n\\\\nОстанавливаю фоновую\\\", full_stream)\\n\\n    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\\\"\\\"\\\"\\n        arb = srv._ContentArbiter(\\\"turn-orch-1\\\")\\n\\n        # Агент меняет статусы оркестрации на протяжении 5 шагов\\n        statuses = [\\n            \\\"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\\\",\\n            \\\"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\\\",\\n            \\\"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\\\",\\n            \\\"[гейт оркестрации: активен | роль: worker] Запуск pytest\\\",\\n            \\\"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\\\",\\n        ]\\n\\n        emitted_deltas: list[str] = []\\n        for idx, status in enumerate(statuses, 1):\\n            # Эмулируем приход короткого префикса, затем полного текста\\n            short_prefix = status[:27]  # \\\"[гейт оркестрации: активен\\\"\\n            d1 = arb.offer(\\\"transcript\\\", idx, short_prefix, \\\"cid-orch\\\")\\n            if d1:\\n                emitted_deltas.append(d1)\\n            d2 = arb.offer(\\\"transcript\\\", idx, status, \\\"cid-orch\\\")\\n            if d2:\\n                emitted_deltas.append(d2)\\n\\n        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\\n        self.assertEqual(arb.divergences, 0)\\n\\n        # Полный текст не должен содержать патологического зацикливания \\\"[гейт оркестрации: активен\\\"\\n        full_text = \\\"\\\".join(emitted_deltas)\\n        count = full_text.count(\\\"[гейт оркестрации: активен\\\")\\n        self.assertEqual(\\n            count,\\n            len(statuses),\\n            f\\\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\\\",\\n        )\\n\\n    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\\n        \\\"\\\"\\\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\\\"\\\"\\\"\\n        emitted_events: list[tuple[str, str]] = []\\n\\n        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\\n            emitted_events.append((\\\"reasoning\\\", delta))\\n            if on_del is not None:\\n                on_del()\\n            return True\\n\\n        def emit_content(idx: int | None, text: str) -> bool:\\n            emitted_events.append((\\\"content\\\", text))\\n            return True\\n\\n        plan = srv._TurnPlan()\\n        plan.mode = \\\"OFF\\\"\\n        plan.base_idx = 0\\n        plan.offset = 0\\n\\n        tail = srv._TranscriptTail(\\n            emit=emit_reasoning,\\n            stop_event=threading.Event(),\\n            done_event=threading.Event(),\\n            resumed=False,\\n            plan=plan,\\n            turn_id=\\\"turn-subagent-1\\\",\\n            emit_content=emit_content,\\n            on_activity=None,\\n            usage_enabled=False,\\n            isolate_tool_preambles=True,\\n        )\\n\\n        # Эмулируем транскрипт мультиагентного цикла:\\n        # Шаг 1: Оркестратор запускает сабагента Coder\\n        record_step1 = {\\n            \\\"type\\\": \\\"PLANNER_RESPONSE\\\",\\n            \\\"step_index\\\": 1,\\n            \\\"content\\\": \\\"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\\\",\\n            \\\"thinking\\\": \\\"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\\\",\\n            \\\"tool_calls\\\": [\\n                {\\n                    \\\"name\\\": \\\"invoke_subagent\\\",\\n                    \\\"args\\\": {\\\"Role\\\": \\\"Coder\\\", \\\"Prompt\\\": \\\"Fix test\\\"},\\n                }\\n            ],\\n        }\\n        tail._emit_record(json.dumps(record_step1).encode(\\\"utf-8\\\"))\\n\\n        # Шаг 2: Финальный ответ после завершения сабагента\\n        record_step2 = {\\n            \\\"type\\\": \\\"PLANNER_RESPONSE\\\",\\n            \\\"step_index\\\": 2,\\n            \\\"content\\\": \\\"Сабагент Coder завершил работу. Все тесты успешно пройдены.\\\",\\n            \\\"thinking\\\": \\\"Формирую итоговый статус для владельца.\\\",\\n        }\\n        tail._emit_record(json.dumps(record_step2).encode(\\\"utf-8\\\"))\\n\\n        # Проверяем распределение:\\n        # 1. Преамбула шага 1 ушла в reasoning\\n        reasoning_pieces = [text for kind, text in emitted_events if kind == \\\"reasoning\\\"]\\n        self.assertTrue(any(\\\"Запускаю сабагента Coder\\\" in r for r in reasoning_pieces))\\n\\n        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\\n        content_pieces = [text for kind, text in emitted_events if kind == \\\"content\\\"]\\n        self.assertEqual(len(content_pieces), 1)\\n        self.assertEqual(\\n            content_pieces[0],\\n            \\\"Сабагент Coder завершил работу. Все тесты успешно пройдены.\\\",\\n        )\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n=====SMOKE=====\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\\n\\nПозволяет автоматически проверять доступность и работоспособность моделей из\\nканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\\n\\nИспользование:\\n    python3 scripts/smoke_models.py --dry-run\\n    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\\n    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport re\\nimport sys\\nimport time\\nimport urllib.error\\nimport urllib.request\\nfrom typing import Any, NamedTuple\\n\\n\\nDEFAULT_MODELS_MD = Path(\\n    os.environ.get(\\\"MODELS_MD_PATH\\\") or \\\"~/Мой диск/Context/models.md\\\"\\n).expanduser()\\nDEFAULT_HUB_URL = os.environ.get(\\\"HUB_BRIDGE_URL\\\", \\\"http://127.0.0.1:9882/v1\\\")\\n\\n\\nclass ModelEntry(NamedTuple):\\n    role: str\\n    model_id: str\\n    effort: str\\n    family: str\\n\\n\\ndef parse_models_md(path: Path) -> list[ModelEntry]:\\n    \\\"\\\"\\\"Извлечь уникальные модели и роли из models.md.\\\"\\\"\\\"\\n    if not path.is_file():\\n        # Fallback на локальный список, если файл канона недоступен\\n        return [\\n            ModelEntry(\\\"Coder\\\", \\\"claude-sonnet-5-5\\\", \\\"high\\\", \\\"Anthropic\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"gpt-6.1-sol\\\", \\\"high\\\", \\\"OpenAI\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"gemini-4-argon-high\\\", \\\"high\\\", \\\"Google\\\"),\\n            ModelEntry(\\\"Coder\\\", \\\"muse-wonder-full-1.0\\\", \\\"xhigh\\\", \\\"Meta\\\"),\\n            ModelEntry(\\\"Architect\\\", \\\"gpt-6.1-sol\\\", \\\"high\\\", \\\"OpenAI\\\"),\\n            ModelEntry(\\\"Reviewer\\\", \\\"claude-sonnet-5-5\\\", \\\"high\\\", \\\"Anthropic\\\"),\\n        ]\\n\\n    content = path.read_text(encoding=\\\"utf-8\\\")\\n    entries: list[ModelEntry] = []\\n    current_role = \\\"General\\\"\\n\\n    # Регулярное выражение для строк вида:\\n    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\\n    row_pattern = re.compile(\\n        r\\\"^\\\\|\\\\s*`?([a-zA-Z0-9.\\\\-_]+)`?\\\\s*\\\\|\\\\s*`?([a-zA-Z0-9]+)`?\\\\s*\\\\|\\\\s*([a-zA-Z0-9.\\\\s]+)\\\\s*\\\\|\\\"\\n    )\\n\\n    for line in content.splitlines():\\n        line = line.strip()\\n        if line.startswith(\\\"### \\\"):\\n            header = line[4:].strip()\\n            # Извлекаем роль из заголовка (например \\\"### Coder — пул разработки...\\\")\\n            current_role = header.split(\\\"—\\\")[0].split(\\\"-\\\")[0].strip()\\n            continue\\n\\n        match = row_pattern.match(line)\\n        if match:\\n            model_id = match.group(1).strip()\\n            effort = match.group(2).strip()\\n            family = match.group(3).strip()\\n            # Пропускаем заголовки таблиц\\n            if model_id.lower() in (\\\"модель\\\", \\\"слот\\\", \\\"пакет\\\", \\\"№\\\", \\\"роль\\\"):\\n                continue\\n            entries.append(ModelEntry(current_role, model_id, effort, family))\\n\\n    # Дедупликация по паре (role, model_id)\\n    seen = set()\\n    unique_entries = []\\n    for e in entries:\\n        key = (e.role, e.model_id)\\n        if key not in seen:\\n            seen.add(key)\\n            unique_entries.append(e)\\n\\n    return unique_entries\\n\\n\\ndef mask_secret(text: str) -> str:\\n    \\\"\\\"\\\"Маскирование токенов и авторизационных заголовков.\\\"\\\"\\\"\\n    return re.sub(\\n        r\\\"(Bearer\\\\s+)[a-zA-Z0-9_\\\\-\\\\.]{8,}\\\",\\n        r\\\"\\\\1[MASKED]\\\",\\n        text,\\n        flags=re.IGNORECASE,\\n    )\\n\\n\\ndef smoke_test_model(\\n    hub_url: str,\\n    model_id: str,\\n    timeout_s: float = 15.0,\\n    api_key: str = \\\"test-smoke-key\\\",\\n) -> tuple[bool, str, float]:\\n    \\\"\\\"\\\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\\\"\\\"\\\"\\n    endpoint = hub_url.rstrip(\\\"/\\\") + \\\"/chat/completions\\\"\\n    payload = {\\n        \\\"model\\\": model_id,\\n        \\\"messages\\\": [{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"ping\\\"}],\\n        \\\"max_tokens\\\": 10,\\n        \\\"stream\\\": False,\\n    }\\n    data_bytes = json.dumps(payload).encode(\\\"utf-8\\\")\\n    req = urllib.request.Request(\\n        endpoint,\\n        data=data_bytes,\\n        headers={\\n            \\\"Content-Type\\\": \\\"application/json\\\",\\n            \\\"Authorization\\\": f\\\"Bearer {api_key}\\\",\\n        },\\n        method=\\\"POST\\\",\\n    )\\n\\n    t0 = time.monotonic()\\n    try:\\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\\n            elapsed = time.monotonic() - t0\\n            status_code = resp.getcode()\\n            if status_code != 200:\\n                return False, f\\\"HTTP {status_code}\\\", elapsed\\n            raw_body = resp.read().decode(\\\"utf-8\\\", \\\"replace\\\")\\n            res_json = json.loads(raw_body)\\n            choices = res_json.get(\\\"choices\\\") or []\\n            if not choices:\\n                return False, \\\"Empty choices\\\", elapsed\\n            return True, \\\"OK\\\", elapsed\\n    except urllib.error.HTTPError as e:\\n        elapsed = time.monotonic() - t0\\n        err_msg = mask_secret(f\\\"HTTP {e.code}: {e.reason}\\\")\\n        return False, err_msg, elapsed\\n    except Exception as e:\\n        elapsed = time.monotonic() - t0\\n        return False, mask_secret(f\\\"Error: {e}\\\"), elapsed\\n\\n\\ndef main() -> int:\\n    parser = argparse.ArgumentParser(\\n        description=\\\"Smoke test runner for models defined in models.md\\\"\\n    )\\n    parser.add_argument(\\n        \\\"--models-md\\\",\\n        type=Path,\\n        default=DEFAULT_MODELS_MD,\\n        help=\\\"Path to Context/models.md\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--hub-url\\\",\\n        type=str,\\n        default=DEFAULT_HUB_URL,\\n        help=\\\"URL of the bridge hub endpoint\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--model\\\",\\n        type=str,\\n        default=\\\"\\\",\\n        help=\\\"Filter by specific model ID\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--dry-run\\\",\\n        action=\\\"store_true\\\",\\n        help=\\\"Validate configuration and parse models without sending network requests\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--live\\\",\\n        action=\\\"store_true\\\",\\n        help=\\\"Execute live HTTP smoke requests against the hub\\\",\\n    )\\n    parser.add_argument(\\n        \\\"--timeout\\\",\\n        type=float,\\n        default=15.0,\\n        help=\\\"Request timeout in seconds\\\",\\n    )\\n\\n    args = parser.parse_args()\\n\\n    models = parse_models_md(args.models_md)\\n    if args.model:\\n        models = [m for m in models if m.model_id == args.model]\\n\\n    if not models:\\n        print(\\\"FAIL: No models found matching criteria.\\\")\\n        return 1\\n\\n    print(f\\\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\\\")\\n    print(f\\\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\\\")\\n    print(\\\"-\\\" * 88)\\n\\n    all_ok = True\\n    for entry in models:\\n        if args.dry_run or not args.live:\\n            status = \\\"CONFIGURED\\\"\\n            latency_str = \\\"-\\\"\\n        else:\\n            ok, status, lat = smoke_test_model(\\n                args.hub_url, entry.model_id, timeout_s=args.timeout\\n            )\\n            latency_str = f\\\"{lat:.2f}s\\\"\\n            if not ok:\\n                all_ok = False\\n\\n        print(\\n            f\\\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\\\"\\n        )\\n\\n    if args.dry_run:\\n        print(\\\"\\\\nPASS: Configuration is valid (dry-run mode).\\\")\\n        return 0\\n\\n    if not args.live:\\n        print(\\\"\\\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\\\")\\n        return 0\\n\\n    return 0 if all_ok else 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\n  \"original_output_bytes\": 18161,\n  \"original_output_tokens\": 4541,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
