{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3c5","stream":{"kind":"session","id":"01a19c0c-21fa-7fe3-a67c-0ddbd4537ca0"},"sequence":61,"recorded_at":1780531400000117,"record_type":"event","durability":"durable","causation_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f","run_stream":{"kind":"run","id":"01a19c0c-2d03-71e2-a901-49777fcf0d2f"},"call_id":"call_01a19c11cc7f7480a451c8caa656fd8c","text":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"git -C /Users/aazhiry1/work/src/cli-agent-bridge diff bridges/agy-bridge/server.py | head -n 400; echo \\\"===AGENTS===\\\"; git -C /Users/aazhiry1/work/src/cli-agent-bridge diff AGENTS.md; echo \\\"===NEW FILES===\\\"; ls -la /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py 2>&1; wc -l /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py /Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py\",\n  \"description\": \"Проверить диффы заявляемых файлов\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"diff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\\nindex f876e36..2179ca1 100644\\n--- a/bridges/agy-bridge/server.py\\n+++ b/bridges/agy-bridge/server.py\\n@@ -2953,6 +2953,7 @@ class _RuntimeFlags(NamedTuple):\\n     graceful_timeout_on_partial: bool = False\\n     step_scoped_usage_enabled: bool = False\\n     stream_resilience_enabled: bool = True\\n+    isolate_tool_preambles_to_reasoning: bool = True\\n     graceful_timeout_finish_reason: str = \\\"stop\\\"\\n \\n \\n@@ -2963,6 +2964,7 @@ _NEW_FLAG_ENV = {\\n     \\\"graceful_timeout_on_partial\\\": \\\"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\\\",\\n     \\\"step_scoped_usage_enabled\\\": \\\"AGY_STEP_SCOPED_USAGE_ENABLED\\\",\\n     \\\"stream_resilience_enabled\\\": \\\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\\\",\\n+    \\\"isolate_tool_preambles_to_reasoning\\\": \\\"AGY_ISOLATE_TOOL_PREAMBLES_TO_REASONING\\\",\\n }\\n _ENV_TRUE = frozenset({\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"})\\n _ENV_FALSE = frozenset({\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\"})\\n@@ -2989,10 +2991,22 @@ def _parse_runtime_flags(text: str) -> _RuntimeFlags:\\n         default = getattr(_COLD_FLAGS, name)\\n         if name == \\\"stream_resilience_enabled\\\":\\n             default = raw.get(_NEW_FLAG_ENV[name], default)\\n-        value = raw.get(name, default)\\n         if name == \\\"graceful_timeout_finish_reason\\\":\\n-            finish_reason = value if isinstance(value, str) else \\\"stop\\\"\\n+            raw_val = raw.get(\\\"graceful_timeout_finish_reason\\\")\\n+            if raw_val is None:\\n+                raw_val = raw.get(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\", default)\\n+            if isinstance(raw_val, str):\\n+                s = raw_val.strip().lower()\\n+                if s in (\\\"length\\\", \\\"max_tokens\\\"):\\n+                    finish_reason = \\\"length\\\"\\n+                elif s == \\\"stop\\\":\\n+                    finish_reason = \\\"stop\\\"\\n+                else:\\n+                    finish_reason = \\\"stop\\\"\\n+            else:\\n+                finish_reason = \\\"stop\\\"\\n             continue\\n+        value = raw.get(name, default)\\n         if not isinstance(value, bool):\\n             raise ValueError(\\\"dynamic_config: %s is not boolean\\\" % name)\\n         values[name] = value\\n@@ -3065,12 +3079,14 @@ def _graceful_finish_reason() -> str:\\n \\n     Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\\n     graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\\n-    Значение 'max_tokens' нормализуется в 'length'.\\n+    Значение 'max_tokens' нормализуется в 'length'. Невалидный непустой env\\n+    переопределяет конфиг и даёт 'stop'.\\n     \\\"\\\"\\\"\\n-    raw_env = os.getenv(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\", \\\"\\\").strip().lower()\\n-    if raw_env in (\\\"length\\\", \\\"max_tokens\\\"):\\n-        return \\\"length\\\"\\n-    if raw_env == \\\"stop\\\":\\n+    raw_env = os.getenv(\\\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\\\")\\n+    if raw_env is not None and raw_env.strip():\\n+        s = raw_env.strip().lower()\\n+        if s in (\\\"length\\\", \\\"max_tokens\\\"):\\n+            return \\\"length\\\"\\n         return \\\"stop\\\"\\n     snap = _runtime_snapshot()\\n     val = snap.graceful_timeout_finish_reason.strip().lower()\\n@@ -3794,6 +3810,7 @@ class _ContentArbiter:\\n         self.overflow = False\\n         self.divergences = 0\\n         self.probes = 0\\n+        self.last_result_diverged = False\\n \\n     def _set_overflow(self, why: str) -> None:\\n         if not self.overflow:\\n@@ -3909,12 +3926,20 @@ class _ContentArbiter:\\n         for step in eq.get(text, ()):\\n             if self._eligible(step, source, idx):\\n                 return step\\n-        pos = bisect.bisect_left(texts, text)\\n-        while pos < len(texts) and texts[pos].startswith(text):\\n-            for step in eq[texts[pos]]:\\n-                if self._eligible(step, source, idx):\\n-                    return step\\n-            pos += 1\\n+        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\\n+        if candidates:\\n+            candidates.sort(key=len, reverse=True)\\n+            for cand in candidates:\\n+                for step in eq[cand]:\\n+                    if self._eligible(step, source, idx):\\n+                        return step\\n+        if idx is None:\\n+            pos = bisect.bisect_left(texts, text)\\n+            while pos < len(texts) and texts[pos].startswith(text):\\n+                for step in eq[texts[pos]]:\\n+                    if step.origin != source and self._eligible(step, source, idx):\\n+                        return step\\n+                pos += 1\\n         return None\\n \\n     def _advance(self, step: _ArbStep, source: str, text: str) -> str:\\n@@ -3973,6 +3998,7 @@ class _ContentArbiter:\\n \\n     def reconcile_result(self, text: str) -> str:\\n         \\\"\\\"\\\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\\\"\\\"\\\"\\n+        self.last_result_diverged = False\\n         if self.overflow or not text:\\n             return \\\"\\\"\\n         emitted = \\\"\\\".join(self.chunks)\\n@@ -4002,6 +4028,7 @@ class _ContentArbiter:\\n             return self._advance(last, \\\"result\\\", text)\\n         self._retain_divergent(text)\\n         self.divergences += 1\\n+        self.last_result_diverged = True\\n         _log(f\\\"content-divergence turn={self.turn_id[:8] or '-'} source=result\\\")\\n         return \\\"\\\"\\n \\n@@ -4157,10 +4184,12 @@ class _TranscriptTail:\\n         emit_content: Callable[[int | None, str], bool] | None = None,\\n         on_activity: Callable[[], None] | None = None,\\n         usage_enabled: bool = False,\\n+        isolate_tool_preambles: bool = False,\\n     ) -> None:\\n         self.emit = emit\\n         # PLANNER_RESPONSE.content -> арбитр (AD-001); None — прежнее поведение.\\n         self.emit_content = emit_content\\n+        self.isolate_tool_preambles = isolate_tool_preambles\\n         # Реальный прогресс транскрипта/SQLite текущего хода -> producer activity (AD-003).\\n         self.on_activity = on_activity\\n         # Дедлайн потока: синхронизируется с effective_max_timeout_s политики (AD-003).\\n@@ -4516,10 +4545,15 @@ class _TranscriptTail:\\n             self._record_usage(rec)\\n         content = rec.get(\\\"content\\\")\\n         emit_content = self.emit_content\\n+        has_tools = bool(rec.get(\\\"tool_calls\\\"))\\n+        isolate_tools = getattr(self, \\\"isolate_tool_preambles\\\", False)\\n         if emit_content is not None and isinstance(content, str) and content.strip():\\n-            _ = emit_content(\\n-                idx, content\\n-            )  # live planner-текст, независимо от tool_calls\\n+            if has_tools and isolate_tools:\\n+                _ = self.emit(idx if idx is not None else 0, content + \\\"\\\\n\\\\n\\\", None)\\n+            else:\\n+                _ = emit_content(\\n+                    idx, content\\n+                )  # live planner-текст, независимо от tool_calls\\n         if idx is None:\\n             return\\n         if isinstance(content, str) and content.strip() and not rec.get(\\\"tool_calls\\\"):\\n@@ -5188,6 +5222,8 @@ class Run:\\n         # Арбитр planner-контента двух источников (AD-001): работает под _emit_lock.\\n         self.content_streaming = _new_flag(\\\"planner_content_streaming_enabled\\\")\\n         self._arbiter = _ContentArbiter(self.turn_id)\\n+        self._last_step_index: object = None\\n+        self._content_emitted_wire: str = \\\"\\\"\\n         # Реальная активность producer'ов (stdout/transcript), независимо от cpu_delta.\\n         self._activity_lock = threading.Lock()\\n         self.last_producer_activity_ts: float = self.started\\n@@ -5203,6 +5239,7 @@ class Run:\\n             emit_content=self._offer_transcript if self.content_streaming else None,\\n             on_activity=self._on_tail_activity,\\n             usage_enabled=self.usage_enabled,\\n+            isolate_tool_preambles=_new_flag(\\\"isolate_tool_preambles_to_reasoning\\\", True),\\n         )\\n         if policy is not None:\\n             self._tail.deadline_s = policy.effective_max_timeout_s + 60.0\\n@@ -5278,7 +5315,21 @@ class Run:\\n                 source, step_index, text, self._tail.cid or self.run_cid\\n             )\\n             if suffix:\\n-                self.q.put((\\\"text\\\", suffix))\\n+                sep = \\\"\\\"\\n+                last_idx = getattr(self, \\\"_last_step_index\\\", None)\\n+                emitted_wire = getattr(self, \\\"_content_emitted_wire\\\", \\\"\\\")\\n+                if last_idx is not None and last_idx != step_index and emitted_wire:\\n+                    if not emitted_wire.endswith(\\\"\\\\n\\\"):\\n+                        sep = (\\n+                            \\\"\\\\n\\\\n\\\"\\n+                            if not suffix.startswith(\\\"\\\\n\\\")\\n+                            else (\\\"\\\\n\\\" if not suffix.startswith(\\\"\\\\n\\\\n\\\") else \\\"\\\")\\n+                        )\\n+                    elif not emitted_wire.endswith(\\\"\\\\n\\\\n\\\"):\\n+                        sep = \\\"\\\\n\\\" if not suffix.startswith(\\\"\\\\n\\\") else \\\"\\\"\\n+                self._last_step_index = step_index\\n+                self._content_emitted_wire = emitted_wire + sep + suffix\\n+                self.q.put((\\\"text\\\", sep + suffix))\\n         return True\\n \\n     def _offer_transcript(self, step_index: int | None, text: str) -> bool:\\n@@ -6207,7 +6258,26 @@ class Handler(BaseHTTPRequestHandler):\\n                     if callable(drain):\\n                         deliver(list(drain(T_DRAIN_MAX_S)))\\n                 if content_streaming:\\n-                    add_content(run.reconcile_result(final_text))\\n+                    delta = run.reconcile_result(final_text)\\n+                    if delta:\\n+                        add_content(delta)\\n+                    elif final_text and getattr(run._arbiter, \\\"last_result_diverged\\\", False):\\n+                        full_emitted = \\\"\\\".join(pieces)\\n+                        sep = (\\n+                            \\\"\\\\n\\\\n\\\"\\n+                            if full_emitted and not full_emitted.endswith(\\\"\\\\n\\\")\\n+                            else (\\n+                                \\\"\\\\n\\\"\\n+                                if full_emitted and not full_emitted.endswith(\\\"\\\\n\\\\n\\\")\\n+                                else \\\"\\\"\\n+                            )\\n+                        )\\n+                        _log(\\n+                            f\\\"content-reconcile-fallback \\\"\\n+                            f\\\"turn={getattr(run, 'turn_id', '')[:8] or '-'} \\\"\\n+                            f\\\"len={len(final_text)}\\\"\\n+                        )\\n+                        add_content(sep + final_text if full_emitted else final_text)\\n                 elif not pieces and final_text:\\n                     add_content(final_text)\\n                 if gone[0]:\\n===AGENTS===\\ndiff --git a/AGENTS.md b/AGENTS.md\\nindex de8d3af..a612b1f 100644\\n--- a/AGENTS.md\\n+++ b/AGENTS.md\\n@@ -8,6 +8,10 @@\\n 2. **Запрет на правку вендорского исходного кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи в исходный код и бинарные сборки внешних вендорских приложений и сред (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену исполняемых модулей. **Правка пользовательских конфигураций и профилей РАЗРЕШЕНА:** редактирование пользовательских настроек, профилей интеграции и переменных окружения (например, `~/.dsh/profiles/*/cordis.patch.yml`, `~/.dsh/.env`, `~/.dsh/.credentials.yaml`) является штатным методом настройки и полностью разрешено.\\n 3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\\n 4. **Запрет на хардкод параметров (полная конфигурируемость):** категорически запрещено зашивать в коде константами любые эксплуатационные параметры — таймауты, интервалы опроса, пороги активности, лимиты шагов и размеры буферов памяти (текста ответа, reasoning и т.д.). Любые такие параметры просто переносим в настройки: они должны быть полностью настраиваемыми через переменные окружения и конфигурационные файлы с безопасными значениями по умолчанию в качестве fallback.\\n+5. **Системное, агент-агностическое решение по умолчанию:** все архитектурные задачи, расхождения форматов сообщений, санитизация вызовов инструментов (tool calls), дефекты стриминга, управление сессиями, восстановление контекста и протокольные краевые случаи решаются **на системном (агент-агностик) уровне шлюза** — в универсальном ядре (`core/`) и общих механизмах эмуляции API, а не на уровне конкретного агента. Решение должно опираться на семантику протокола и контракт шлюза, а не на имя подключаемого агента.\\n+   - **Запрещено переносить общую логику на уровень конкретного агента:** если проблему можно решить агент-агностически, категорически недопустимы отдельные заплатки, хаки, ветвления по имени агента и дублирование исправлений для Droid, Muse, Codex, Claude Code и других подключаемых CLI-бэкендов. Системное исправление реализуется один раз в модулях ядра (`core/`) и работает единообразно для всех интеграций.\\n+   - **Адаптеры агентов — только тонкие трансляторы транспорта:** их ответственность ограничивается управлением жизненным циклом CLI-процесса, подключением к транспорту и двусторонней трансляцией специфичного CLI-ввода/вывода в единый внутренний контракт шлюза. Общая нормализация, санитизация, управление контекстом, восстановление после сбоев и протокольная эмуляция не должны оседать в адаптерах в виде ad-hoc логики.\\n+   - **Специфичная логика допускается только как доказанное исключение:** прежде чем добавлять частную обработку в адаптер, необходимо доказать невозможность системного решения в общем слое и зафиксировать непреодолимое ограничение внешнего CLI-транспорта. Такая логика должна быть строго изолирована внутри адаптера и не нарушать инварианты универсального ядра.\\n \\n ## О проекте cli-agent-bridge\\n \\n@@ -30,3 +34,26 @@\\n pytest tests/ -v\\n ```\\n Код должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.\\n+\\n+## Регламент комплексного тестирования мостов и стриминга (L1 / L2 / L3)\\n+\\n+Каждая доработка мостов обязана сопровождаться трехуровневым контролем качества:\\n+\\n+1. **Уровень L1 (Детерминированные Unit-тесты):**\\n+   - Все изменения логики дедупликации (`_ContentArbiter`), сканирования префиксов (`_scan`) и разбора рантайм-флагов (`_parse_runtime_flags`) покрываются тестами в `tests/test_agy_bridge_resilience.py`.\\n+   - Запрещено сдавать код, если хотя бы один тест арбитража или graceful-таймаута завершается с ошибкой.\\n+   - Инвариант `_scan`: входящий фрагмент другого шага сопоставляется со старым шагом ТОЛЬКО при условии `text == candidate` или `text.startswith(candidate)`. Короткий префикс нового шага с валидным индексом (`idx is not None`) никогда не должен становиться алиасом длинного старого шага.\\n+\\n+2. **Уровень L2 (Сквозные синтетические E2E-тесты и валидация протокола SSE):**\\n+   - Набор `tests/test_stream_formatting_and_subagents.py` обязателен к прогону перед любым мержем.\\n+   - **Инвариант разграничения строк Markdown:** любые последовательные шаги в потоке `content` обязаны разделяться переводом строки `\\\\n\\\\n`. Склейка слов на границах шагов (паттерн `[а-яёa-z]\\\\.[А-ЯЁA-Z]`) категорически запрещена.\\n+   - **Инвариант защиты от циклов префиксов:** многократная смена статусов агента и скиллов оркестрации (`[гейт оркестрации: активен...`) не должна вызывать лавину повторов префикса и `content-divergence`.\\n+   - **Инвариант изоляции блока мышления (<Think>):** при наличии вызовов инструментов (`tool_calls`) сервисные преамбулы шагов направляются в `choices[0].delta.reasoning_content`. В `choices[0].delta.content` разрешается отдавать только финальный ответ пользователю (шаг без инструментов) либо результат реконсиляции, предотвращая досрочное закрытие аккордеона мышления в UI DeepSeek Harness.\\n+   - **Мультиагентный цикл:** обязательна эмуляция сессий с порождением сабагентов (`invoke_subagent` / `launch_seat.py`) с контролем непрерывности стрима родительского агента.\\n+   - **Инвариант скользящего окна активности (Sliding Activity Window):** любой стрим и адаптер обязан сбрасывать таймер неактивности при получении каждого полезного чанка (`content`, `reasoning_content`, `tool_calls`) и сдвигать дедлайн вперёд (`deadline = now + idle_timeout_s`). Категорически запрещено обрывать активный поток по статическому настенному таймеру при наличии входящих данных; аварийный `safety_cap_s` допустим только как предохранитель от бесконечного зацикливания.\\n+\\n+3. **Уровень L3 (Универсальный смоук-раннер моделей):**\\n+   - Для валидации готовности моделей и транспортов из `~/Мой диск/Context/models.md` используется скрипт `scripts/smoke_models.py`.\\n+   - Проверка конфигурации: `python3 scripts/smoke_models.py --dry-run`.\\n+   - Сквозной смоук-тест реальных бэкендов: `python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1`.\\n+   - Санитизация: все токены и секреты в смоук-логах и отчётах обязательно маскируются.\\n===NEW FILES===\\n-rwxr-xr-x@ 1 aazhiry1  staff   7652 Nov  2 14:31 /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py\\n-rw-r--r--@ 1 aazhiry1  staff  10493 Nov  2 14:30 /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py\\n     203 /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py\\n     232 /Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py\\n    7761 /Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py\\n    8196 total\\n\",\n  \"original_output_bytes\": 22143,\n  \"original_output_tokens\": 5536,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
