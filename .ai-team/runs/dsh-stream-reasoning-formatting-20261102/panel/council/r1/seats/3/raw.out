{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4295,4440p' bridges/agy-bridge/server.py; rg -n 'reconcile.*fallback|last_result_diverged|content_emitted_wire|boundary|isolated_to_reasoning' tests/test_agy_bridge_resilience.py; nl -ba scripts/smoke_models.py | sed -n '102,141p;199,222p'; cat /tmp/panel-visioner-4db6e0dc/tests-venv.log /tmp/panel-visioner-4db6e0dc/tests-venv.rc\"","aggregated_output":"                    conn.interrupt()\n                except (sqlite3.ProgrammingError, sqlite3.OperationalError):\n                    pass\n\n    def _run(self) -> None:\n        try:\n            self._run_loop()\n        except Exception as exc:\n            _log(f\"tail-error cid={self._cid8()} err={type(exc).__name__}\")\n        finally:\n            self._finish()\n\n    def _run_loop(self) -> None:\n        # Файл и БД появляются только после первого шага — ждём привязки к разговору,\n        # но не дольше, чем ждали бы первого события agy; выход процесса или stop\n        # прерывают ожидание сразу (поток не висит до FIRST_TOKEN_TIMEOUT_S).\n        waited = 0.0\n        while not self._ready.wait(timeout=0.05):\n            waited += 0.05\n            if self.stop_event.is_set() or self.done_event.is_set():\n                return\n            if waited >= FIRST_TOKEN_TIMEOUT_S:\n                _log(\n                    f\"tail-timeout cid={self._cid8()}: no bind within {FIRST_TOKEN_TIMEOUT_S:g}s\"\n                )\n                return\n        started = time.monotonic()\n        while time.monotonic() - started < self.deadline_s:\n            if self.stop_event.is_set():\n                return\n            if self.done_event.is_set():\n                self._drain_post_eof()\n                return\n            self.tick()\n            _ = self.done_event.wait(TRANSCRIPT_POLL_S)\n\n    def _finish(self) -> None:\n        \"\"\"Закрыть соединение, вернуть исход breaker'у и снять владение cid (один раз).\"\"\"\n        if self._finished:\n            return\n        self._finished = True\n        with self._conn_lock:\n            conn = self._active_conn\n            self._active_conn = None\n            if conn is not None:\n                _sqlite_close(conn)\n        if self.plan.mode in (\"LIVE\", \"SHADOW\"):\n            _breaker_report(self.probe_gen, self.selects_ok, self.failed)\n        if self._owned_cid:\n            _cid_release(self._owned_cid, self.turn_id)\n\n    # ---- один проход ---------------------------------------------------------------\n    def tick(self) -> None:\n        \"\"\"Транскрипт каждый тик; SQLite — не чаще SQLITE_POLL_S (и по токенам bucket).\"\"\"\n        self._read_transcript()\n        if self.dead:\n            return\n        _ = self._sqlite_permitted()\n        now = time.monotonic()\n        if self.sqlite_active and now >= self._next_poll_at:\n            self._next_poll_at = now + SQLITE_POLL_S\n            _ = self._poll_sqlite()\n\n    def _sqlite_off(self, reason: str) -> None:\n        \"\"\"Выключить SQLite-опрос до конца хода; транскрипт продолжает работу.\"\"\"\n        if not self.sqlite_active:\n            return\n        self.sqlite_active = False\n        self.interrupt_active_query()\n        _log(f\"sqlite-off cid={self._cid8()} reason={reason}\")\n\n    def _sqlite_permitted(self) -> bool:\n        \"\"\"Флаг, breaker и режим хода на каждую итерацию и перед каждой строкой.\"\"\"\n        if not self.sqlite_active or self.dead:\n            return False\n        disabled = _sqlite_disabled_reason()\n        if disabled:\n            self._sqlite_off(disabled)\n            return False\n        if not _breaker_permits(self.probe_gen):\n            self._sqlite_off(\"breaker\" if self.probe_gen is None else \"probe_stale\")\n            return False\n        return True\n\n    def _note_activity(self) -> None:\n        callback = self.on_activity\n        if callback is not None:\n            try:\n                callback()\n            except Exception:\n                pass\n\n    # ---- транскрипт ----------------------------------------------------------------\n    def _read_transcript(self) -> None:\n        \"\"\"Дочитать файл с offset; неполный хвост строки ждёт следующего прохода.\"\"\"\n        if not self.cid or not self._transcript_ok:\n            return\n        path = self._transcript_file()\n        if path is None:\n            return\n        try:\n            size = path.stat().st_size\n        except OSError:\n            return\n        rewritten = False\n        if size < self._offset:  # файл переписан с нуля — читаем заново\n            _log(\n                f\"tail-rewrite cid={self._cid8()}: size {size} < offset {self._offset}\"\n            )\n            self._offset, self._buf = 0, b\"\"\n            rewritten = True\n        if size == self._offset:\n            return\n        try:\n            with open(path, \"rb\") as fh:\n                _ = fh.seek(self._offset)\n                chunk = fh.read(TRANSCRIPT_READ_MAX)\n        except OSError:\n            return\n        self._buf += chunk\n        # Рост файла хода — активность producer (и неполная строка). При перезаписи\n        # перечитывается старая история: активностью считаются только записи хода.\n        self._in_rewrite = rewritten\n        if chunk and not rewritten:\n            self._note_activity()\n        while b\"\\n\" in self._buf:\n            line, self._buf = self._buf.split(b\"\\n\", 1)\n            self._offset += len(line) + 1\n            try:\n                self._emit_record(line)\n            except Exception:\n                pass\n        if self._usage_dirty:\n            self._publish_usage()\n\n    def _transcript_file(self) -> Path | None:\n        \"\"\"Файл транскрипта: прежний путь; при usage_enabled — закреплённый на попытку.\n\n        Приоритет `transcript_full.jsonl`, при ENOENT — `transcript.jsonl`; пока ни\n        одного файла нет, проверка повторяется, а найденный путь не меняется до конца\n        попытки (появившийся позже full не подменяет смещение другого файла).\n        \"\"\"\n        if not self.usage_enabled:\n            return _transcript_path(self.cid)\n        if self._path is None:\n            self._path = _select_transcript_path(self.cid)\n4367:        # Проверка reconcile_result и fallback доставки финального ответа\n6973:    def test_img04_single_image_boundary_for_every_base64_padding(self) -> None:\n7000:    def test_img06_total_limit_boundary(self) -> None:\n7011:    def test_img07_http_body_limit_boundary(self) -> None:\n9086:    def test_step_scoped_usage_l2_resume_prespawn_boundary_sqlite_off(self) -> None:\n9392:    def test_usage_fallback_window_boundary_and_not_over_window(self) -> None:\n13609:    def test_step_boundary_newline_separation(self) -> None:\n13660:    def test_tool_preamble_isolated_to_reasoning(self) -> None:\n   102\t\n   103\tdef smoke_test_model(\n   104\t    hub_url: str,\n   105\t    model_id: str,\n   106\t    timeout_s: float = 15.0,\n   107\t    api_key: str = \"test-smoke-key\",\n   108\t) -> tuple[bool, str, float]:\n   109\t    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n   110\t    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n   111\t    payload = {\n   112\t        \"model\": model_id,\n   113\t        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n   114\t        \"max_tokens\": 10,\n   115\t        \"stream\": False,\n   116\t    }\n   117\t    data_bytes = json.dumps(payload).encode(\"utf-8\")\n   118\t    req = urllib.request.Request(\n   119\t        endpoint,\n   120\t        data=data_bytes,\n   121\t        headers={\n   122\t            \"Content-Type\": \"application/json\",\n   123\t            \"Authorization\": f\"Bearer {api_key}\",\n   124\t        },\n   125\t        method=\"POST\",\n   126\t    )\n   127\t\n   128\t    t0 = time.monotonic()\n   129\t    try:\n   130\t        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n   131\t            elapsed = time.monotonic() - t0\n   132\t            status_code = resp.getcode()\n   133\t            if status_code != 200:\n   134\t                return False, f\"HTTP {status_code}\", elapsed\n   135\t            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n   136\t            res_json = json.loads(raw_body)\n   137\t            choices = res_json.get(\"choices\") or []\n   138\t            if not choices:\n   139\t                return False, \"Empty choices\", elapsed\n   140\t            return True, \"OK\", elapsed\n   141\t    except urllib.error.HTTPError as e:\n   199\t    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n   200\t    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n   201\t    print(\"-\" * 88)\n   202\t\n   203\t    all_ok = True\n   204\t    for entry in models:\n   205\t        if args.dry_run or not args.live:\n   206\t            status = \"CONFIGURED\"\n   207\t            latency_str = \"-\"\n   208\t        else:\n   209\t            ok, status, lat = smoke_test_model(\n   210\t                args.hub_url, entry.model_id, timeout_s=args.timeout\n   211\t            )\n   212\t            latency_str = f\"{lat:.2f}s\"\n   213\t            if not ok:\n   214\t                all_ok = False\n   215\t\n   216\t        print(\n   217\t            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n   218\t        )\n   219\t\n   220\t    if args.dry_run:\n   221\t        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n   222\t        return 0\ncat: /tmp/panel-visioner-4db6e0dc/tests-venv.rc: No such file or directory\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport runpy,threading,queue\nfrom types import SimpleNamespace\ns=runpy.run_path('tests/test_stream_formatting_and_subagents.py')['srv']\nr=object.__new__(s.Run)\nfor k,v in {'_emit_lock':threading.Lock(),'q':queue.Queue(),'drain_closed':False,'_tail':SimpleNamespace(cid='reconcile'),'_arbiter':s._ContentArbiter('reconcile'),'turn_id':'reconcile','run_cid':'reconcile','_last_step_index':None,'_content_emitted_wire':''}.items():setattr(r,k,v)\nr.offer_content('stdout',1,'Первый шаг.');r.offer_content('stdout',2,'Второй шаг.')\nfinal='Первый шаг.\\\\n\\\\nВторой шаг.'\npieces=[v for k,v in r.q.queue if k=='text']\ndelta=r.reconcile_result(final)\nif delta: pieces.append(delta)\nelif final and r._arbiter.last_result_diverged:\n    full=''.join(pieces)\n    sep='\\\\n\\\\n' if full and not full.endswith('\\\\n') else ('\\\\n' if full and not full.endswith('\\\\n\\\\n') else '')\n    pieces.append(sep+final if full else final)\nprint('RAW_ARBITER:',repr(''.join(r._arbiter.chunks)))\nprint('WIRE_BEFORE_RECONCILE:',repr(r._content_emitted_wire))\nprint('RESULT_DIVERGED:',r._arbiter.last_result_diverged)\nprint('WIRE_AFTER_HANDLER_FALLBACK:',repr(''.join(pieces)))\nPY\nps -p 85358 -o pid,ppid,etime,stat,command; cat /tmp/panel-visioner-4db6e0dc/tests-venv.log; test \"'! -f /tmp/panel-visioner-4db6e0dc/tests-venv.rc || cat /tmp/panel-visioner-4db6e0dc/tests-venv.rc; sed -n '\"'4340,4405p' tests/test_agy_bridge_resilience.py; sed -n '13595,13740p' tests/test_agy_bridge_resilience.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport runpy,threading,queue\nfrom types import SimpleNamespace\ns=runpy.run_path('tests/test_stream_formatting_and_subagents.py')['srv']\nr=object.__new__(s.Run)\nfor k,v in {'_emit_lock':threading.Lock(),'q':queue.Queue(),'drain_closed':False,'_tail':SimpleNamespace(cid='reconcile'),'_arbiter':s._ContentArbiter('reconcile'),'turn_id':'reconcile','run_cid':'reconcile','_last_step_index':None,'_content_emitted_wire':''}.items():setattr(r,k,v)\nr.offer_content('stdout',1,'Первый шаг.');r.offer_content('stdout',2,'Второй шаг.')\nfinal='Первый шаг.\\\\n\\\\nВторой шаг.'\npieces=[v for k,v in r.q.queue if k=='text']\ndelta=r.reconcile_result(final)\nif delta: pieces.append(delta)\nelif final and r._arbiter.last_result_diverged:\n    full=''.join(pieces)\n    sep='\\\\n\\\\n' if full and not full.endswith('\\\\n') else ('\\\\n' if full and not full.endswith('\\\\n\\\\n') else '')\n    pieces.append(sep+final if full else final)\nprint('RAW_ARBITER:',repr(''.join(r._arbiter.chunks)))\nprint('WIRE_BEFORE_RECONCILE:',repr(r._content_emitted_wire))\nprint('RESULT_DIVERGED:',r._arbiter.last_result_diverged)\nprint('WIRE_AFTER_HANDLER_FALLBACK:',repr(''.join(pieces)))\nPY\nps -p 85358 -o pid,ppid,etime,stat,command; cat /tmp/panel-visioner-4db6e0dc/tests-venv.log; test \"'! -f /tmp/panel-visioner-4db6e0dc/tests-venv.rc || cat /tmp/panel-visioner-4db6e0dc/tests-venv.rc; sed -n '\"'4340,4405p' tests/test_agy_bridge_resilience.py; sed -n '13595,13740p' tests/test_agy_bridge_resilience.py\"","aggregated_output":"[agy-bridge] 14:40:05 content-divergence turn=reconcil source=result\nRAW_ARBITER: 'Первый шаг.Второй шаг.'\nWIRE_BEFORE_RECONCILE: 'Первый шаг.\\n\\nВторой шаг.'\nRESULT_DIVERGED: True\nWIRE_AFTER_HANDLER_FALLBACK: 'Первый шаг.\\n\\nВторой шаг.\\n\\nПервый шаг.\\n\\nВторой шаг.'\nzsh:21: operation not permitted: ps\n        ]\n        final_text = \"### Детальный анализ переезда...\"\n        lines: list[dict[str, object]] = []\n        for status in statuses:\n            lines.append(_stdout_text(None, status))\n            lines.append(_stdout_tool(_MISSING))\n        lines.append(\n            {\n                \"event\": \"result\",\n                \"result\": {\n                    \"status\": \"success\",\n                    \"response\": final_text,\n                },\n            }\n        )\n\n        run, items = _pump_queue(lines, content=True)\n        text_chunks = [\n            str(payload)\n            for kind, payload in items\n            if kind == \"text\"\n        ]\n        self.assertEqual(text_chunks, statuses)\n        arb = _oval(run, \"_arbiter\")\n        self.assertEqual(_oval(arb, \"divergences\"), 0)\n        self.assertFalse(_oval(arb, \"overflow\"))\n\n        # Проверка reconcile_result и fallback доставки финального ответа\n        reconciled = _str(_ofn(run, \"reconcile_result\")(final_text))\n        retained = _str(_ofn(arb, \"retained_divergent_text\")())\n        self.assertEqual(retained, final_text)\n        delivered = reconciled if reconciled else (\"\\n\\n\" + final_text)\n        self.assertEqual(\n            \"\".join(text_chunks) + delivered,\n            \"\".join(statuses) + \"\\n\\n\" + final_text,\n        )\n\n    def test_content_scan_matches_saved_prefix_not_longer_snapshot(self) -> None:\n        arb = _arb()\n        old_text = \"[статус: чтение канона AGENTS.md]\"\n        short_text = \"[статус: \"\n        new_text = \"[статус: дочитывание канона]\"\n\n        self.assertEqual(_offer(arb, \"stdout\", 1, old_text), old_text)\n\n        # Короткий снимок другого шага не должен стать alias старого.\n        self.assertEqual(_offer(arb, \"transcript\", 2, short_text), short_text)\n        self.assertEqual(\n            _offer(arb, \"transcript\", 2, new_text),\n            \"дочитывание канона]\",\n        )\n        self.assertEqual(_oval(arb, \"divergences\"), 0)\n\n        # Расширение сохранённого префикса сопоставляется и тогда, когда\n        # соответствующий шаг уже не является последним.\n        other = _arb()\n        self.assertEqual(_offer(other, \"stdout\", 1, \"alpha\"), \"alpha\")\n        self.assertEqual(_offer(other, \"stdout\", 2, \"beta\"), \"beta\")\n        self.assertEqual(\n            _offer(other, \"transcript\", 3, \"alpha extended\"),\n            \" extended\",\n        )\n        self.assertEqual(_oval(other, \"divergences\"), 0)\n\n    def test_silent_planner_content_lookup_work_does_not_scan_history(self) -> None:\n        arb = _arb()\n            _write_cfg(fx, {\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\": False}, 1_000)\n            clock.advance(2)\n            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n            _write_cfg(fx, '{\"stream_resilience_enabled\":\"false\"}', 2_000)\n            clock.advance(2)\n            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n            _write_cfg(fx, {\"stream_resilience_enabled\": True}, 3_000)\n            clock.advance(2)\n            self.assertTrue(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n\n\nclass StreamFormattingAndReasoningIsolationTests(unittest.TestCase):\n    \"\"\"Детерминированные тесты L1 на разграничение строк, сопоставление префиксов и изоляцию reasoning.\"\"\"\n\n    def test_step_boundary_newline_separation(self) -> None:\n        \"\"\"VER-001 / REQ-001: Текст независимых шагов планировщика разделяется \\\\n\\\\n без склеивания слов.\"\"\"\n        run = _bare_run()\n        setattr(run, \"_arbiter\", _arb())\n        setattr(run, \"turn_id\", \"turn-fmt-1\")\n        setattr(run, \"run_cid\", _CID)\n        offer = _ofn(run, \"offer_content\")\n\n        # Шаг 1: завершается точкой без перевода строки\n        self.assertTrue(offer(\"stdout\", 1, \"Завершаю поиск данных.\"))\n        # Шаг 2: начинается со слова с заглавной буквы\n        self.assertTrue(offer(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\"))\n        # Шаг 3: завершается с переводом строки\n        self.assertTrue(offer(\"stdout\", 3, \"Следующее действие.\\n\"))\n        # Шаг 4: начинается без перевода строки\n        self.assertTrue(offer(\"stdout\", 4, \"Финальный результат.\"))\n\n        q = cast(\"queue.Queue[tuple[str, object]]\", _oval(run, \"q\"))\n        chunks = [cast(str, q.get_nowait()[1]) for _ in range(q.qsize())]\n        combined = \"\".join(chunks)\n\n        # Проверяем, что нет слитного \"данных.Проверяю\"\n        self.assertNotIn(\"данных.Проверяю\", combined)\n        self.assertIn(\"Завершаю поиск данных.\\n\\nПроверяю вывод лога задачи 349.\", combined)\n        self.assertIn(\"Следующее действие.\\n\\nФинальный результат.\", combined)\n\n    def test_arbiter_no_prefix_repetition_on_divergence(self) -> None:\n        \"\"\"VER-002 / REQ-002: Короткие префиксы новых шагов не вызывают лавины повторов [гейт...\"\"\"\n        arb = _arb()\n        step1_text = \"[гейт оркестрации: активен | роль: explorer] Читаю канон AGENTS.md\"\n        step2_prefix = \"[гейт оркестрации: активен\"\n        step2_full = \"[гейт оркестрации: активен | роль: worker] Запускаю тесты pytest\"\n\n        # Шаг 1\n        self.assertEqual(_offer(arb, \"transcript\", 1, step1_text), step1_text)\n\n        # Шаг 2 начинается с префикса, совпадающего с шагом 1\n        delta_prefix = _offer(arb, \"transcript\", 2, step2_prefix)\n        self.assertEqual(delta_prefix, step2_prefix)\n        self.assertEqual(_oval(arb, \"divergences\"), 0)\n\n        # Шаг 2 досылает полный текст\n        delta_full = _offer(arb, \"transcript\", 2, step2_full)\n        self.assertEqual(delta_full, step2_full[len(step2_prefix):])\n        self.assertEqual(_oval(arb, \"divergences\"), 0)\n\n        # Проверяем, что в chunks нет зацикленного повтора\n        chunks = _oval(arb, \"chunks\")\n        joined = \"\".join(chunks)\n        self.assertEqual(joined.count(\"[гейт оркестрации: активен\"), 2)\n\n    def test_tool_preamble_isolated_to_reasoning(self) -> None:\n        \"\"\"VER-003 / REQ-003: Сервисная преамбула шага с tool_calls изолируется в reasoning, сохраняя <Think>.\"\"\"\n        with _Fixture() as fx:\n            content_emitted: list[tuple[int | None, str]] = []\n            reasoning_emitted: list[tuple[int, str]] = []\n\n            def emit_content(idx: int | None, text: str) -> bool:\n                content_emitted.append((idx, text))\n                return True\n\n            def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n                reasoning_emitted.append((idx, delta))\n                if on_del is not None:\n                    on_del()\n                return True\n\n            plan = _bfn(\"_TurnPlan\")()\n            setattr(plan, \"mode\", \"OFF\")\n            setattr(plan, \"base_idx\", 0)\n            setattr(plan, \"offset\", 0)\n\n            tail = _bfn(\"_TranscriptTail\")(\n                emit_reasoning,\n                threading.Event(),\n                threading.Event(),\n                False,\n                plan,\n                \"turn-reasoning-1\",\n                emit_content,\n                None,\n                False,\n                True,  # isolate_tool_preambles=True\n            )\n            setattr(tail, \"cid\", _CID)\n\n            # Шаг 1: содержит tool_calls и преамбулу в content\n            fx.append_record(\n                {\n                    \"type\": \"PLANNER_RESPONSE\",\n                    \"step_index\": 1,\n                    \"content\": \"Ищу скилл analyst-teamlead и проверяю базу знаний\",\n                    \"tool_calls\": [{\"name\": \"read_file\", \"args\": {\"Path\": \"/tmp/test\"}}],\n                }\n            )\n            # Шаг 2: финальный ответ пользователю (без tool_calls)\n            fx.append_record(\n                {\n                    \"type\": \"PLANNER_RESPONSE\",\n                    \"step_index\": 2,\n                    \"content\": \"Вот согласованный ответ для пользователя.\",\n                }\n            )\n\n            _ = _ofn(tail, \"_read_transcript\")()\n\n            # В content должен попасть ТОЛЬКО финальный ответ шага 2\n            self.assertEqual(len(content_emitted), 1)\n            self.assertEqual(content_emitted[0], (2, \"Вот согласованный ответ для пользователя.\"))\n\n            # В reasoning должна попасть сервисная преамбула шага 1\n            reasoning_texts = [delta for _, delta in reasoning_emitted]\n            self.assertTrue(any(\"Ищу скилл analyst-teamlead\" in t for t in reasoning_texts))\n\n","exit_code":0,"status":"completed"}}
