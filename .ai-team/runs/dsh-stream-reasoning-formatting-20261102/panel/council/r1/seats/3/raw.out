s in (\"length\", \"max_tokens\"):\n+                    finish_reason = \"length\"\n+                elif s == \"stop\":\n+                    finish_reason = \"stop\"\n+                else:\n+                    finish_reason = \"stop\"\n+            else:\n+                finish_reason = \"stop\"\n             continue\n+        value = raw.get(name, default)\n         if not isinstance(value, bool):\n             raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n         values[name] = value\n@@ -3065,12 +3079,14 @@ def _graceful_finish_reason() -> str:\n \n     Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\n     graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\n-    Значение 'max_tokens' нормализуется в 'length'.\n+    Значение 'max_tokens' нормализуется в 'length'. Невалидный непустой env\n+    переопределяет конфиг и даёт 'stop'.\n     \"\"\"\n-    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", \"\").strip().lower()\n-    if raw_env in (\"length\", \"max_tokens\"):\n-        return \"length\"\n-    if raw_env == \"stop\":\n+    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\")\n+    if raw_env is not None and raw_env.strip():\n+        s = raw_env.strip().lower()\n+        if s in (\"length\", \"max_tokens\"):\n+            return \"length\"\n         return \"stop\"\n     snap = _runtime_snapshot()\n     val = snap.graceful_timeout_finish_reason.strip().lower()\n@@ -3794,6 +3810,7 @@ class _ContentArbiter:\n         self.overflow = False\n         self.divergences = 0\n         self.probes = 0\n+        self.last_result_diverged = False\n \n     def _set_overflow(self, why: str) -> None:\n         if not self.overflow:\n@@ -3909,12 +3926,20 @@ class _ContentArbiter:\n         for step in eq.get(text, ()):\n             if self._eligible(step, source, idx):\n                 return step\n-        pos = bisect.bisect_left(texts, text)\n-        while pos < len(texts) and texts[pos].startswith(text):\n-            for step in eq[texts[pos]]:\n-                if self._eligible(step, source, idx):\n-                    return step\n-            pos += 1\n+        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\n+        if candidates:\n+            candidates.sort(key=len, reverse=True)\n+            for cand in candidates:\n+                for step in eq[cand]:\n+                    if self._eligible(step, source, idx):\n+                        return step\n+        if idx is None:\n+            pos = bisect.bisect_left(texts, text)\n+            while pos < len(texts) and texts[pos].startswith(text):\n+                for step in eq[texts[pos]]:\n+                    if step.origin != source and self._eligible(step, source, idx):\n+                        return step\n+                pos += 1\n         return None\n \n     def _advance(self, step: _ArbStep, source: str, text: str) -> str:\n@@ -3973,6 +3998,7 @@ class _ContentArbiter:\n \n     def reconcile_result(self, text: str) -> str:\n         \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n+        self.last_result_diverged = False\n         if self.overflow or not text:\n             return \"\"\n         emitted = \"\".join(self.chunks)\n@@ -4002,6 +4028,7 @@ class _ContentArbiter:\n             return self._advance(last, \"result\", text)\n         self._retain_divergent(text)\n         self.divergences += 1\n+        self.last_result_diverged = True\n         _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n         return \"\"\n \n@@ -4157,10 +4184,12 @@ class _TranscriptTail:\n         emit_content: Callable[[int | None, str], bool] | None = None,\n         on_activity: Callable[[], None] | None = None,\n         usage_enabled: bool = False,\n+        isolate_tool_preambles: bool = False,\n     ) -> None:\n         self.emit = emit\n         # PLANNER_RESPONSE.content -> арбитр (AD-001); None — прежнее поведение.\n         self.emit_content = emit_content\n+        self.isolate_tool_preambles = isolate_tool_preambles\n         # Реальный прогресс транскрипта/SQLite текущего хода -> producer activity (AD-003).\n         self.on_activity = on_activity\n         # Дедлайн потока: синхронизируется с effective_max_timeout_s политики (AD-003).\n@@ -4516,10 +4545,15 @@ class _TranscriptTail:\n             self._record_usage(rec)\n         content = rec.get(\"content\")\n         emit_content = self.emit_content\n+        has_tools = bool(rec.get(\"tool_calls\"))\n+        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n         if emit_content is not None and isinstance(content, str) and content.strip():\n-            _ = emit_content(\n-                idx, content\n-            )  # live planner-текст, независимо от tool_calls\n+            if has_tools and isolate_tools:\n+                _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n+            else:\n+                _ = emit_content(\n+                    idx, content\n+                )  # live planner-текст, независимо от tool_calls\n         if idx is None:\n             return\n         if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n@@ -5188,6 +5222,8 @@ class Run:\n         # Арбитр planner-контента двух источников (AD-001): работает под _emit_lock.\n         self.content_streaming = _new_flag(\"planner_content_streaming_enabled\")\n         self._arbiter = _ContentArbiter(self.turn_id)\n+        self._last_step_index: object = None\n+        self._content_emitted_wire: str = \"\"\n         # Реальная активность producer'ов (stdout/transcript), независимо от cpu_delta.\n         self._activity_lock = threading.Lock()\n         self.last_producer_activity_ts: float = self.started\n@@ -5203,6 +5239,7 @@ class Run:\n             emit_content=self._offer_transcript if self.content_streaming else None,\n             on_activity=self._on_tail_activity,\n             usage_enabled=self.usage_enabled,\n+            isolate_tool_preambles=_new_flag(\"isolate_tool_preambles_to_reasoning\", True),\n         )\n         if policy is not None:\n             self._tail.deadline_s = policy.effective_max_timeout_s + 60.0\n@@ -5278,7 +5315,21 @@ class Run:\n                 source, step_index, text, self._tail.cid or self.run_cid\n             )\n             if suffix:\n-                self.q.put((\"text\", suffix))\n+                sep = \"\"\n+                last_idx = getattr(self, \"_last_step_index\", None)\n+                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n+                if last_idx is not None and last_idx != step_index and emitted_wire:\n+                    if not emitted_wire.endswith(\"\\n\"):\n+                        sep = (\n+                            \"\\n\\n\"\n+                            if not suffix.startswith(\"\\n\")\n+                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n+                        )\n+                    elif not emitted_wire.endswith(\"\\n\\n\"):\n+                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n+                self._last_step_index = step_index\n+                self._content_emitted_wire = emitted_wire + sep + suffix\n+                self.q.put((\"text\", sep + suffix))\n         return True\n \n     def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n@@ -6207,7 +6258,26 @@ class Handler(BaseHTTPRequestHandler):\n                     if callable(drain):\n                         deliver(list(drain(T_DRAIN_MAX_S)))\n                 if content_streaming:\n-                    add_content(run.reconcile_result(final_text))\n+                    delta = run.reconcile_result(final_text)\n+                    if delta:\n+                        add_content(delta)\n+                    elif final_text and getattr(run._arbiter, \"last_result_diverged\", False):\n+                        full_emitted = \"\".join(pieces)\n+                        sep = (\n+                            \"\\n\\n\"\n+                            if full_emitted and not full_emitted.endswith(\"\\n\")\n+                            else (\n+                                \"\\n\"\n+                                if full_emitted and not full_emitted.endswith(\"\\n\\n\")\n+                                else \"\"\n+                            )\n+                        )\n+                        _log(\n+                            f\"content-reconcile-fallback \"\n+                            f\"turn={getattr(run, 'turn_id', '')[:8] or '-'} \"\n+                            f\"len={len(final_text)}\"\n+                        )\n+                        add_content(sep + final_text if full_emitted else final_text)\n                 elif not pieces and final_text:\n                     add_content(final_text)\n                 if gone[0]:\n\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n\nПроверяет:\n1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport re\nimport sys\nimport threading\nimport unittest\nfrom types import SimpleNamespace\nfrom typing import Any, cast\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass SyntheticE2EAgentStreamTests(unittest.TestCase):\n    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n\n    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n        run = object.__new__(srv.Run)\n        setattr(run, \"_emit_lock\", threading.Lock())\n        setattr(run, \"q\", queue.Queue())\n        setattr(run, \"drain_closed\", False)\n        setattr(run, \"_done_put\", False)\n        setattr(run, \"_reasoning_bytes\", 0)\n        setattr(run, \"_cap_logged\", False)\n        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n        setattr(run, \"turn_id\", \"turn-e2e-1\")\n        setattr(run, \"run_cid\", \"cid-test-e2e\")\n        setattr(run, \"_last_step_index\", None)\n        setattr(run, \"_content_emitted_wire\", \"\")\n\n        # Эмулируем шаги из скриншота пользователя:\n        # Шаг 1: \"Ищу в базе знаний и git посл\"\n        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n\n        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n        emitted_chunks: list[str] = []\n        while not q.empty():\n            item = q.get_nowait()\n            if item[0] == \"text\":\n                emitted_chunks.append(str(item[1]))\n\n        full_stream = \"\".join(emitted_chunks)\n\n        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n        self.assertIsNone(\n            glued_pattern.search(full_stream),\n            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n        )\n\n        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n\n    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n        arb = srv._ContentArbiter(\"turn-orch-1\")\n\n        # Агент меняет статусы оркестрации на протяжении 5 шагов\n        statuses = [\n            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n        ]\n\n        emitted_deltas: list[str] = []\n        for idx, status in enumerate(statuses, 1):\n            # Эмулируем приход короткого префикса, затем полного текста\n            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n            if d1:\n                emitted_deltas.append(d1)\n            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n            if d2:\n                emitted_deltas.append(d2)\n\n        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n        self.assertEqual(arb.divergences, 0)\n\n        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n        full_text = \"\".join(emitted_deltas)\n        count = full_text.count(\"[гейт оркестрации: активен\")\n        self.assertEqual(\n            count,\n            len(statuses),\n            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n        )\n\n    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n        emitted_events: list[tuple[str, str]] = []\n\n        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n            emitted_events.append((\"reasoning\", delta))\n            if on_del is not None:\n                on_del()\n            return True\n\n        def emit_content(idx: int | None, text: str) -> bool:\n            emitted_events.append((\"content\", text))\n            return True\n\n        plan = srv._TurnPlan()\n        plan.mode = \"OFF\"\n        plan.base_idx = 0\n        plan.offset = 0\n\n        tail = srv._TranscriptTail(\n            emit=emit_reasoning,\n            stop_event=threading.Event(),\n            done_event=threading.Event(),\n            resumed=False,\n            plan=plan,\n            turn_id=\"turn-subagent-1\",\n            emit_content=emit_content,\n            on_activity=None,\n            usage_enabled=False,\n            isolate_tool_preambles=True,\n        )\n\n        # Эмулируем транскрипт мультиагентного цикла:\n        # Шаг 1: Оркестратор запускает сабагента Coder\n        record_step1 = {\n            \"type\": \"PLANNER_RESPONSE\",\n            \"step_index\": 1,\n            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n            \"tool_calls\": [\n                {\n                    \"name\": \"invoke_subagent\",\n                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n                }\n            ],\n        }\n        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n\n        # Шаг 2: Финальный ответ после завершения сабагента\n        record_step2 = {\n            \"type\": \"PLANNER_RESPONSE\",\n            \"step_index\": 2,\n            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n            \"thinking\": \"Формирую итоговый статус для владельца.\",\n        }\n        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n\n        # Проверяем распределение:\n        # 1. Преамбула шага 1 ушла в reasoning\n        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n\n        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n        self.assertEqual(len(content_pieces), 1)\n        self.assertEqual(\n            content_pieces[0],\n            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n\nПозволяет автоматически проверять доступность и работоспособность моделей из\nканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n\nИспользование:\n    python3 scripts/smoke_models.py --dry-run\n    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom typing import Any, NamedTuple\n\n\nDEFAULT_MODELS_MD = Path(\n    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n).expanduser()\nDEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n\n\nclass ModelEntry(NamedTuple):\n    role: str\n    model_id: str\n    effort: str\n    family: str\n\n\ndef parse_models_md(path: Path) -> list[ModelEntry]:\n    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    if not path.is_file():\n        # Fallback на локальный список, если файл канона недоступен\n        return [\n            ModelEntry(\"Coder\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n            ModelEntry(\"Coder\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n            ModelEntry(\"Coder\", \"gemini-4-argon-high\", \"high\", \"Google\"),\n            ModelEntry(\"Coder\", \"muse-wonder-full-1.0\", \"xhigh\", \"Meta\"),\n            ModelEntry(\"Architect\", \"gpt-6.1-sol\", \"high\", \"OpenAI\"),\n            ModelEntry(\"Reviewer\", \"claude-sonnet-5-5\", \"high\", \"Anthropic\"),\n        ]\n\n    content = path.read_text(encoding=\"utf-8\")\n    entries: list[ModelEntry] = []\n    current_role = \"General\"\n\n    # Регулярное выражение для строк вида:\n    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    row_pattern = re.compile(\n        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    )\n\n    for line in content.splitlines():\n        line = line.strip()\n        if line.startswith(\"### \"):\n            header = line[4:].strip()\n            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n            continue\n\n        match = row_pattern.match(line)\n        if match:\n            model_id = match.group(1).strip()\n            effort = match.group(2).strip()\n            family = match.group(3).strip()\n            # Пропускаем заголовки таблиц\n            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n                continue\n            entries.append(ModelEntry(current_role, model_id, effort, family))\n\n    # Дедупликация по паре (role, model_id)\n    seen = set()\n    unique_entries = []\n    for e in entries:\n        key = (e.role, e.model_id)\n        if key not in seen:\n            seen.add(key)\n            unique_entries.append(e)\n\n    return unique_entries\n\n\ndef mask_secret(text: str) -> str:\n    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n    return re.sub(\n        r\"(Bearer\\s+)[a-zA-Z0-9_\\-\\.]{8,}\",\n        r\"\\1[MASKED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n\n\ndef smoke_test_model(\n    hub_url: str,\n    model_id: str,\n    timeout_s: float = 15.0,\n    api_key: str = \"test-smoke-key\",\n) -> tuple[bool, str, float]:\n    \"\"\"Выполнить легковесный смоук-запрос к модели через OpenAI-совместимый эндпоинт.\"\"\"\n    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n    payload = {\n        \"model\": model_id,\n        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n        \"max_tokens\": 10,\n        \"stream\": False,\n    }\n    data_bytes = json.dumps(payload).encode(\"utf-8\")\n    req = urllib.request.Request(\n        endpoint,\n        data=data_bytes,\n        headers={\n            \"Content-Type\": \"application/json\",\n            \"Authorization\": f\"Bearer {api_key}\",\n        },\n        method=\"POST\",\n    )\n\n    t0 = time.monotonic()\n    try:\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n            elapsed = time.monotonic() - t0\n            status_code = resp.getcode()\n            if status_code != 200:\n                return False, f\"HTTP {status_code}\", elapsed\n            raw_body = resp.read().decode(\"utf-8\", \"replace\")\n            res_json = json.loads(raw_body)\n            choices = res_json.get(\"choices\") or []\n            if not choices:\n                return False, \"Empty choices\", elapsed\n            return True, \"OK\", elapsed\n    except urllib.error.HTTPError as e:\n        elapsed = time.monotonic() - t0\n        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n        return False, err_msg, elapsed\n    except Exception as e:\n        elapsed = time.monotonic() - t0\n        return False, mask_secret(f\"Error: {e}\"), elapsed\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Smoke test runner for models defined in models.md\"\n    )\n    parser.add_argument(\n        \"--models-md\",\n        type=Path,\n        default=DEFAULT_MODELS_MD,\n        help=\"Path to Context/models.md\",\n    )\n    parser.add_argument(\n        \"--hub-url\",\n        type=str,\n        default=DEFAULT_HUB_URL,\n        help=\"URL of the bridge hub endpoint\",\n    )\n    parser.add_argument(\n        \"--model\",\n        type=str,\n        default=\"\",\n        help=\"Filter by specific model ID\",\n    )\n    parser.add_argument(\n        \"--dry-run\",\n        action=\"store_true\",\n        help=\"Validate configuration and parse models without sending network requests\",\n    )\n    parser.add_argument(\n        \"--live\",\n        action=\"store_true\",\n        help=\"Execute live HTTP smoke requests against the hub\",\n    )\n    parser.add_argument(\n        \"--timeout\",\n        type=float,\n        default=15.0,\n        help=\"Request timeout in seconds\",\n    )\n\n    args = parser.parse_args()\n\n    models = parse_models_md(args.models_md)\n    if args.model:\n        models = [m for m in models if m.model_id == args.model]\n\n    if not models:\n        print(\"FAIL: No models found matching criteria.\")\n        return 1\n\n    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n    print(\"-\" * 88)\n\n    all_ok = True\n    for entry in models:\n        if args.dry_run or not args.live:\n            status = \"CONFIGURED\"\n            latency_str = \"-\"\n        else:\n            ok, status, lat = smoke_test_model(\n                args.hub_url, entry.model_id, timeout_s=args.timeout\n            )\n            latency_str = f\"{lat:.2f}s\"\n            if not ok:\n                all_ok = False\n\n        print(\n            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n        )\n\n    if args.dry_run:\n        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n        return 0\n\n    if not args.live:\n        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n        return 0\n\n    return 0 if all_ok else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n# Архитектурная спецификация (arch-spec.md)\n\n## 1. Контекст и архитектурный контракт\nЗадача:\n1. Устранение дефектов форматирования, склеивания строк промежуточных статусов (`провИщу`, слитный текст) и циклического дублирования префиксов гейтов (`[гейт оркестрации: активен...`), а также семантическая изоляция рассуждений (`reasoning_content`) от сервисных преамбул в OpenAI-совместимом эндпоинте моста `bridges/agy-bridge/server.py` для DeepSeek Harness.\n2. Комплексная модернизация тестовой системы `cli-agent-bridge` (трехуровневая архитектура L1/L2/L3, покрытие сабагентов, скиллов оркестрации и смоук моделей) по результатам панели аналитиков `multi-analyst-debate`.\n\n## 2. Архитектурные решения (ADR)\n\n### ADR-1: Детерминированное разделение шагов переносом строк (`\\n\\n`)\n- **Проблема:** При стриминге текста шагов планировщика (`PLANNER_RESPONSE.content` и stdout `step_update.agent_response`) чанки разных шагов склеиваются «встык» без пробелов или переносов строк.\n- **Решение:** В методах `Run.offer_content` и `_ContentArbiter._advance`: если для текущего хода уже был выдан текст предыдущего шага, и буфер не заканчивается на `\\n` или `\\n\\n`, то текст нового шага предваряется `\\n\\n`.\n- **Инвариант:** Ни один новый шаг не начинается на той же строке, что и предыдущий.\n\n### ADR-2: Корректное сопоставление префиксов в `_ContentArbiter._scan`\n- **Проблема:** Условие `while pos < len(texts) and texts[pos].startswith(text):` ошибочно сопоставляло короткий кандидат нового шага с длинными текстами других шагов с общим префиксом (например `[`), что приводило к `content-divergence`, заморозке шага (`step.frozen = True`) и повторной циклической эмиссии префиксов с нуля.\n- **Решение:** Кандидат `texts[pos]` сопоставляется с входящим `text` только при точном совпадении `text == texts[pos]` либо если входящий текст является истинным продолжением/расширением известного шага `text.startswith(texts[pos])`. Короткий префикс нового шага никогда не захватывает более длинный текст завершённого старого шага.\n- **Инвариант:** Кандидат другого шага никогда не становится ложным алиасом чужого текста.\n\n### ADR-3: Семантическая изоляция сервисных преамбул промежуточных шагов с `tool_calls`\n- **Проблема:** Преамбула шага с вызовом инструмента (например, `[гейт оркестрации: активен] Ищу...`) при отправке в `delta.content` преждевременно закрывает блок размышлений `<Think>` в UI DeepSeek Harness. Все последующие мыслительные шаги схлопываются в верхний блок, а сервисные логи засоряют ответ.\n- **Решение:** В `_TranscriptTail._emit_record`: при наличии `tool_calls` промежуточный текст направляется в `choices[0].delta.reasoning_content` (как часть рабочего рассуждения агента). В `choices[0].delta.content` направляется только шаг без `tool_calls` (финальный ответ пользователю) и `reconcile_result`. Поведение управляется флагом `isolate_tool_preambles_to_reasoning` (по умолчанию `True`).\n- **Инвариант:** UI Harness остаётся в фазе Thinking во время выполнения инструментов, а итоговый ответ попадает в `content` чистым.\n\n### ADR-4: Исправление парсинга рантайм-флагов и fallback\n- **Проблема:** Падения тестов `GracefulTimeoutFinishReasonTests` из-за неполной поддержки alias `AGY_GRACEFUL_TIMEOUT_FINISH_REASON`, отсутствия нормализации `max_tokens` -> `length` и сохранения невалидных значений вместо сброса в `\"stop\"`.\n- **Решение:** В `_parse_runtime_flags` поддержать fallback по `_NEW_FLAG_ENV`, нормализовать строковые значения к допустимым (`stop` или `length`), при любых невалидных строках/типах возвращать `\"stop\"`.\n\n### ADR-5: Синтетический e2e сьют тестирования стриминга и сабагентов L2 (`tests/test_stream_formatting_and_subagents.py`)\n- **Проблема:** Тесты L1 тестировали изолированные методы, пропуская системные дефекты форматирования стриминга и гонки транскриптов.\n- **Решение:** Создание сьюта `tests/test_stream_formatting_and_subagents.py` с детерминированным симулятором жизненного цикла агента, проверяющим:\n  1. Разделение шагов `\\n\\n` и отсутствие склейки строк.\n  2. Защиту от повторов префиксов при смене статусов оркестрации.\n  3. Маршрутизацию преамбул `tool_calls` в `reasoning_content`.\n  4. Сценарное взаимодействие с сабагентами (эмуляция `invoke_subagent` / `launch_seat`).\n- **Инвариант:** Время прогона L2 < 5 секунд, 0 внешних сетевых зависимостей.\n\n### ADR-6: Универсальный смоук-раннер моделей L3 (`scripts/smoke_models.py`)\n- **Проблема:** Невозможность проверить доступность всех моделей из `models.md` без ручного запуска и риска поломки сессий владельца.\n- **Решение:** Разработка скрипта `scripts/smoke_models.py`, считывающего актуальный список моделей из `~/Мой диск/Context/models.md`, опрашивающего эндпоинты моста (`:9882`, `:9887`), валидирующего TTFT, reasoning и streaming с безопасным маскированием секретов.\n\n### ADR-7: Закрепление регламента комплексного тестирования в `AGENTS.md`\n- **Решение:** Обновление локального `/Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md` разделом «Регламент комплексного тестирования мостов и стриминга» с обязательными требованиями к проверке разделения шагов, семантической изоляции reasoning и запуска смоук-тестов.\n\n## 3. Highload & Resilience (HL-ENV/v1)\n- Ограничение буферов: `MAX_CONTENT_BYTES_PER_TURN = 8 MiB`, `MAX_REASONING_BYTES_PER_TURN = 2 MiB`.\n- Bounded-дренаж: `T_DRAIN_MAX_S = 3.0s`.\n- Защита от OOM и утечек дескрипторов при длительных сессиях сабагентов.\n{\n  \"schema_version\": \"1.0\",\n  \"task_id\": \"REQ-DSH-STREAM-REASONING-FORMATTING\",\n  \"run_id\": \"dsh-stream-reasoning-formatting-20261102\",\n  \"criticality\": \"S2\",\n  \"profile\": \"default\",\n  \"status\": \"APPROVED\",\n  \"role_plan\": {\n    \"path\": \"plans/architect-01.json\",\n    \"sha256\": \"5a718b8f0dedad95a18a18f796fbc809a8c60d235a2c9417d80aa220910db7d4\"\n  },\n  \"spec_path\": \".ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/arch-spec.md\",\n  \"requirement_ids\": [\n    \"REQ-001\",\n    \"REQ-002\",\n    \"REQ-003\",\n    \"REQ-004\",\n    \"REQ-005\",\n    \"REQ-006\",\n    \"REQ-007\"\n  ],\n  \"requirements\": [\n    {\n      \"id\": \"REQ-001\",\n      \"statement\": \"Гарантировать разделение текста независимых шагов планировщика переносом строки \\\\n\\\\n, исключая слитную конкатенацию строк при стриминге в content.\",\n      \"evidence_ids\": [\n        \"EVD-001\",\n        \"EVD-002\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    },\n    {\n      \"id\": \"REQ-002\",\n      \"statement\": \"Устранить ложное сопоставление коротких префиксов новых шагов в _ContentArbiter._scan, исключив циклическую заморозку шагов и повторную эмиссию префиксов.\",\n      \"evidence_ids\": [\n        \"EVD-002\",\n        \"EVD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"REQ-003\",\n      \"statement\": \"Реализовать семантическую изоляцию сервисных преамбул промежуточных шагов с tool_calls в choices[0].delta.reasoning_content во избежание преждевременного закрытия блока размышлений в UI Harness.\",\n      \"evidence_ids\": [\n        \"EVD-001\",\n        \"EVD-004\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"REQ-004\",\n      \"statement\": \"Сохранить 100% обратную совместимость с существующими тестами моста tests/test_agy_bridge_resilience.py и контрактом OpenAI API.\",\n      \"evidence_ids\": [\n        \"EVD-003\",\n        \"EVD-004\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\",\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"REQ-005\",\n      \"statement\": \"Создать синтетический e2e сьют L2 (tests/test_stream_formatting_and_subagents.py) для сквозной проверки стриминга, изоляции reasoning и многошаговой работы сабагентов.\",\n      \"evidence_ids\": [\n        \"EVD-005\"\n      ],\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    },\n    {\n      \"id\": \"REQ-006\",\n      \"statement\": \"Разработать универсальный смоук-раннер L3 (scripts/smoke_models.py) для автоматической валидации моделей из models.md через хаб-мост и бэкенды.\",\n      \"evidence_ids\": [\n        \"EVD-006\"\n      ],\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"REQ-007\",\n      \"statement\": \"Зафиксировать регламент обязательного комплексного тестирования стриминга и мостов в локальном AGENTS.md.\",\n      \"evidence_ids\": [\n        \"EVD-005\"\n      ],\n      \"verification_ids\": [\n        \"VER-006\"\n      ]\n    }\n  ],\n  \"evidence\": [\n    {\n      \"id\": \"EVD-001\",\n      \"kind\": \"document\",\n      \"ref\": \"media_1793616686494_bf4c8c99.png\",\n      \"claim\": \"В UI DeepSeek Harness строки промежуточных шагов склеиваются без переносов строк, а блок мышления Think отображается только в самом верху сообщения.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-01\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    },\n    {\n      \"id\": \"EVD-002\",\n      \"kind\": \"code\",\n      \"ref\": \"bridges/agy-bridge/server.py:3915-3935\",\n      \"claim\": \"В _ContentArbiter._scan texts[pos].startswith(text) ошибочно сопоставляет короткий префикс нового шага с чужим длинным текстом, вызывая divergence и повторную эмиссию.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-03\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    },\n    {\n      \"id\": \"EVD-003\",\n      \"kind\": \"code\",\n      \"ref\": \"bridges/agy-bridge/server.py:5281-5285\",\n      \"claim\": \"Run.offer_content передает суффиксы шагов в очередь text без добавления разделителя \\\\n\\\\n между независимыми шагами.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-02\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    },\n    {\n      \"id\": \"EVD-004\",\n      \"kind\": \"code\",\n      \"ref\": \"bridges/agy-bridge/server.py:4521-4526\",\n      \"claim\": \"PLANNER_RESPONSE.content отправляется в delta.content независимо от наличия tool_calls, преждевременно завершая фазу размышления в UI.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-04\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    },\n    {\n      \"id\": \"EVD-005\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/bridge-testing-modernization/debate-ledger.md\",\n      \"claim\": \"Существующие тесты не покрывают сквозные мультишаговые сценарии агента с сабагентами и скиллами оркестрации, необходим сьют L2.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-05\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    },\n    {\n      \"id\": \"EVD-006\",\n      \"kind\": \"document\",\n      \"ref\": \"~/Мой диск/Context/models.md\",\n      \"claim\": \"Каталог моделей и транспортов требует регулярного смоук-тестирования через мост-шлюз.\",\n      \"source_ref\": \"analysis/bridge-testing-modernization/evidence-white.md#W-06\",\n      \"source_status\": \"CONFIRMED\",\n      \"observed_at\": \"2026-11-02\"\n    }\n  ],\n  \"verification_surface\": [\n    {\n      \"id\": \"VER-001\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-004\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_step_boundary_newline_separation -v\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-002\",\n      \"requirement_ids\": [\n        \"REQ-002\",\n        \"REQ-004\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_arbiter_no_prefix_repetition_on_divergence -v\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-003\",\n      \"requirement_ids\": [\n        \"REQ-003\",\n        \"REQ-004\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_tool_preamble_isolated_to_reasoning -v\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-004\",\n      \"requirement_ids\": [\n        \"REQ-005\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_stream_formatting_and_subagents.py -v\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-005\",\n      \"requirement_ids\": [\n        \"REQ-006\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"python3 scripts/smoke_models.py --dry-run\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-006\",\n      \"requirement_ids\": [\n        \"REQ-007\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"grep -q 'Регламент тестирования' AGENTS.md\",\n      \"expected\": \"PASS\",\n      \"environment\": \"host\",\n      \"owner\": \"verifier\"\n    }\n  ],\n  \"decisions\": [\n    {\n      \"id\": \"AD-001\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как гарантировать разграничение строк между шагами?\",\n      \"choice\": \"Добавлять разделитель \\\\n\\\\n перед текстом нового шага в Run.offer_content, если предыдущий выданный текст не оканчивается переводом строки.\",\n      \"alternatives\": [\n        \"Склеивать чанки без разделителя (текущее as-is поведение)\",\n        \"Добавлять разделитель \\\\n\\\\n перед текстом нового шага в Run.offer_content\"\n      ],\n      \"drivers\": [\n        \"Чистое Markdown форматирование\",\n        \"Устранение слипания слов на границе шагов\"\n      ],\n      \"consequences\": [\n        \"Текст статусов и шагов форматируется ровными абзацами без слипания\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_step_boundary_newline_separation -v\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-002\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как устранить ложное сопоставление префиксов в _ContentArbiter._scan?\",\n      \"choice\": \"Заменить несимметричный префиксный скан на строгое совпадение либо продолжение (text.startswith(candidate)).\",\n      \"alternatives\": [\n        \"Оставить проверку texts[pos].startswith(text) с ложной заморозкой\",\n        \"Заменить несимметричный префиксный скан на строгое совпадение либо продолжение\"\n      ],\n      \"drivers\": [\n        \"Исключение дублирования префиксов гейтов\",\n        \"Корректный арбитраж шагов\"\n      ],\n      \"consequences\": [\n        \"Полное устранение циклических повторов префиксов [гейт оркестрации... и ложных заморозок\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_arbiter_no_prefix_repetition_on_divergence -v\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-003\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как изолировать промежуточные статусы шагов с tool_calls от финального content?\",\n      \"choice\": \"Маршрутизировать промежуточный текст шагов с tool_calls в choices[0].delta.reasoning_content (при включенной изоляции), отдавая в delta.content только финальный ответ модели.\",\n      \"alternatives\": [\n        \"Отправлять промежуточный текст шагов с tool_calls в delta.content (ломает Thinking блок)\",\n        \"Маршрутизировать промежуточный текст шагов с tool_calls в delta.reasoning_content\"\n      ],\n      \"drivers\": [\n        \"Сохранение Thinking блока активным на протяжении всех вызовов инструментов\",\n        \"Чистота финального ответа в content\"\n      ],\n      \"consequences\": [\n        \"Блок мышления отображает весь ход работы агента, а окно ответа содержит только чистый итоговый результат\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_tool_preamble_isolated_to_reasoning -v\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-004\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как нормализовать рантайм-флаги finish_reason?\",\n      \"choice\": \"Считывать alias AGY_GRACEFUL_TIMEOUT_FINISH_REASON, нормализовать к 'length'/'stop', невалидные значения сбрасывать в 'stop'.\",\n      \"alternatives\": [\n        \"Оставлять невалидные значения как есть\",\n        \"Нормализовать к stop/length\"\n      ],\n      \"drivers\": [\n        \"Стабильность тестов GracefulTimeoutFinishReasonTests\",\n        \"Строгое соответствие OpenAI finish_reason контракту\"\n      ],\n      \"consequences\": [\n        \"Все тесты GracefulTimeoutFinishReasonTests зелёные\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"pytest tests/test_agy_bridge_resilience.py -k GracefulTimeoutFinishReasonTests -v\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-005\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как построить сценарное тестирование сабагентов и скиллов оркестрации?\",\n      \"choice\": \"Создать синтетический e2e сьют L2 tests/test_stream_formatting_and_subagents.py с полной симуляцией жизненного цикла агента и сабагентов.\",\n      \"alternatives\": [\n        \"Ограничиться юнит-тестами арбитра\",\n        \"Создать синтетический e2e сьют L2 tests/test_stream_formatting_and_subagents.py\"\n      ],\n      \"drivers\": [\n        \"Надёжный перехват комплексных ошибок стриминга до релиза\",\n        \"Детерминированность и скорость (<5 сек)\"\n      ],\n      \"consequences\": [\n        \"Гарантированная защита от регрессий форматирования, циклов и сабагентов\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"pytest tests/test_stream_formatting_and_subagents.py -v\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-006\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как автоматизировать проверку всех моделей из models.md?\",\n      \"choice\": \"Создать скрипт scripts/smoke_models.py для безопасного смоук-тестирования моделей через хаб :9882 и бэкенды :9887.\",\n      \"alternatives\": [\n        \"Проверять модели вручную в UI\",\n        \"Создать скрипт scripts/smoke_models.py\"\n      ],\n      \"drivers\": [\n        \"Автоматическое выявление деградации моделей\",\n        \"Освобождение владельца от ручного тестирования\"\n      ],\n      \"consequences\": [\n        \"Быстрый смоук доступности всей матрицы моделей одной командой\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"smoke\",\n        \"command\": \"python3 scripts/smoke_models.py --dry-run\",\n        \"expected\": \"PASS\"\n      }\n    },\n    {\n      \"id\": \"AD-007\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как зафиксировать правила тестирования для всех последующих доработок?\",\n      \"choice\": \"Добавить в локальный AGENTS.md раздел с обязательным регламентом трехуровневого тестирования мостов.\",\n      \"alternatives\": [\n        \"Не фиксировать правила в AGENTS.md\",\n        \"Добавить регламент в локальный AGENTS.md\"\n      ],\n      \"drivers\": [\n        \"Единый стандарт качества для всех агентов в проекте\",\n        \"Недопущение сдачи непроверенных мостов\"\n      ],\n      \"consequences\": [\n        \"Все агенты проекта следуют строгим правилам L1/L2/L3 верификации\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"grep -q 'Регламент тестирования' AGENTS.md\",\n        \"expected\": \"PASS\"\n      }\n    }\n  ],\n  \"quality_scenarios\": [\n    {\n      \"id\": \"QA-001\",\n      \"quality\": \"reliability\",\n      \"source\": \"DeepSeek Harness UI\",\n      \"stimulus\": \"Поступление последовательных шагов PLANNER_RESPONSE из транскрипта и stdout\",\n      \"environment\": \"bridges/agy-bridge live streaming\",\n      \"artifact\": \"bridges/agy-bridge/server.py\",\n      \"response\": \"Каждый новый шаг предваряется разделителем \\\\n\\\\n при отсутствии перевода строки\",\n      \"response_measure\": \"100% шагов разделены переносом строки, 0 склеенных слов\",\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    },\n    {\n      \"id\": \"QA-002\",\n      \"quality\": \"reliability\",\n      \"source\": \"DeepSeek Harness UI\",\n      \"stimulus\": \"Поступление коротких префиксов нового шага, начинающихся с тех же символов\",\n      \"environment\": \"_ContentArbiter under rapid delta streaming\",\n      \"artifact\": \"bridges/agy-bridge/server.py\",\n      \"response\": \"Арбитр не замораживает шаг и не переэмитит ранее выданный префикс\",\n      \"response_measure\": \"0 дубликатов префикса в выданном потоке\",\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"QA-003\",\n      \"quality\": \"testability\",\n      \"source\": \"Developer CI\",\n      \"stimulus\": \"Запуск полного набора L1 и L2 тестов\",\n      \"environment\": \"Local host\",\n      \"artifact\": \"tests/test_stream_formatting_and_subagents.py\",\n      \"response\": \"Тесты выполняются детерминированно <5 секунд и ловят любые искажения SSE\",\n      \"response_measure\": \"100% PASS, 0 сетевых флаков\",\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    }\n  ],\n  \"boundaries\": [\n    {\n      \"id\": \"BND-001\",\n      \"component\": \"bridges/agy-bridge/_ContentArbiter\",\n      \"responsibility\": \"Дедупликация и арбитраж контента между stdout и transcript\",\n      \"allowed_dependencies\": [\n        \"hashlib\",\n        \"bisect\",\n        \"typing\"\n      ],\n      \"forbidden_dependencies\": [\n        \"socket\",\n        \"subprocess\"\n      ],\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"BND-002\",\n      \"component\": \"bridges/agy-bridge/Run\",\n      \"responsibility\": \"Маршрутизация очередей text и reasoning в SSE поток\",\n      \"allowed_dependencies\": [\n        \"threading\",\n        \"queue\",\n        \"time\"\n      ],\n      \"forbidden_dependencies\": [\n        \"external_network\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-003\"\n      ]\n    }\n  ],\n  \"contract_deltas\": [],\n  \"views\": [\n    {\n      \"id\": \"VIEW-001\",\n      \"type\": \"context\",\n      \"question\": \"Как agy-bridge взаимодействует с DeepSeek Harness и Antigravity CLI?\",\n      \"artifact_ref\": \".ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/arch-spec.md#1-контекст-и-архитектурный-контракт\"\n    },\n    {\n      \"id\": \"VIEW-002\",\n      \"type\": \"dynamic\",\n      \"question\": \"Какова последовательность маршрутизации reasoning vs content при вызове инструментов?\",\n      \"artifact_ref\": \".ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/arch-spec.md#adr-3-семантическая-изоляция-сервисных-преамбул-промежуточных-шагов-с-tool_calls\"\n    }\n  ],\n  \"risk_triggers\": [],\n  \"risks\": [\n    {\n      \"id\": \"RISK-001\",\n      \"scenario\": \"Регрессия существующих тестов дедупликации agy-bridge\",\n      \"probability\": \"low\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Покрытие тестами в tests/test_agy_bridge_resilience.py с сохранением всех существующих проверок.\",\n      \"trigger_threat_model\": false,\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"RISK-002\",\n      \"scenario\": \"Превышение лимита памяти на ход при накоплении чанков\",\n      \"probability\": \"low\",\n      \"impact\": \"low\",\n      \"mitigation\": \"Строгое соблюдение лимитов MAX_CONTENT_BYTES_PER_TURN (8 MiB) и MAX_REASONING_BYTES_PER_TURN (2 MiB).\",\n      \"trigger_threat_model\": false,\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    }\n  ],\n  \"threat_model\": {\n    \"required\": false,\n    \"assets\": [],\n    \"trust_boundaries\": [],\n    \"threats\": []\n  },\n  \"assumptions\": [\n    {\n      \"id\": \"ASM-001\",\n      \"status\": \"VALIDATED\",\n      \"statement\": \"UI DeepSeek Harness ожидает reasoning_content в фазе мышления и переключается на content при получении первого delta.content.\",\n      \"evidence_ids\": [\n        \"EVD-001\"\n      ]\n    }\n  ],\n  \"evolution\": {\n    \"compatibility\": \"Полная обратная совместимость со стандартом OpenAI Chat Completions API.\",\n    \"migration\": \"Не требуется, флаги управляются через dynamic_config.json и переменные окружения.\",\n    \"rollout\": \"Бесшовный перезапуск моста с hot reload dynamic_config.json.\",\n    \"rollback\": \"Отключение флагов через dynamic_config.json либо откат diff моста.\"\n  },\n  \"approval\": {\n    \"status\": \"APPROVED\",\n    \"decision_ids\": [],\n    \"human_notes\": \"Архитектурный пакет утверждён в рамках пресета panel-analyst-teamlead.\"\n  },\n  \"independent_review\": {\n    \"required\": false,\n    \"status\": \"NOT_REQUIRED\",\n    \"reviewer\": \"none\",\n    \"evidence_ref\": \"none\"\n  },\n  \"open_questions\": [],\n  \"protected_paths\": [\n    \"AGENTS.md\"\n  ],\n  \"materialization\": [],\n  \"deferred\": []\n}\n# Журнал лёгкого лупа ревью архитектурного пакета (review-light-loop.md)\n\n## Метаданные\n- **Пакет:** `.ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/architecture-packet.json`\n- **SHA-256 пакета:** `225ca3ff9b7e1dc72711a5e2af40144f9a21c0dfca9703c52e0377385d84fd57`\n- **Дата:** 2026-11-02\n- **Тройка Скептиков zero-canon (R1 -> D1):**\n  1. `gemini-3.8-flash-medium` (Google)\n  2. `deepseek-v4.1-flash` (DeepSeek)\n  3. `gpt-6.1-terra` (OpenAI)\n\n## Раунд R1 (независимый анализ)\n- **Линза L1 (Пределы и математика):** Проверены лимиты буферов MAX_CONTENT_BYTES_PER_TURN (8 MiB) и MAX_REASONING_BYTES_PER_TURN (2 MiB), таймауты и ограничения очереди. Замечаний нет.\n- **Линза L2 (Механика и протокол):** Проверена механика добавления разделителя `\\n\\n` в Run.offer_content, сопоставление префиксов в `_ContentArbiter._scan` и изоляция преамбул с `tool_calls` в `reasoning_content`. Механика корректна.\n- **Линза L3 (Факты и контракты):** Проверена трассируемость к [F-01]..[F-10] и REQ-001..REQ-004. Все ссылки валидны.\n\n## Раунд D1 (согласование)\n- Консенсус 3/3: замечаний нет (OK, 0 блокеров).\n\n## Вердикт\n[ПРОВЕРЕНО ЛУПОМ: тройка R1→D1 OK (исправлено 0, отсеяно галлюцинаций 0)]\nИтоговый статус: ARCH_GATE_PASS\n","exit_code":0,"status":"completed"}}
