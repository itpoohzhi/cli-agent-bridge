{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44b","stream":{"kind":"session","id":"01a19b83-abd9-7033-80d9-6ad722f3ce98"},"sequence":128,"recorded_at":1780531400000251,"record_type":"event","durability":"durable","causation_id":"01a19b83-cf84-7971-9890-ac76024eba17","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19b83-cf84-7971-9890-ac76024eba17","run_stream":{"kind":"run","id":"01a19b83-cf84-7971-9890-ac76024eba17"},"task_stream":{"kind":"task","id":"01a19b84-7794-7702-982d-8006d634cc83"},"task_id":"01a19b84-7794-7702-982d-8006d634cc83","event":{"kind":"output","task_id":"01a19b84-7794-7702-982d-8006d634cc83","chunk":"{\n  \"chunk_id\": \"exec-5-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && sed -n '335,430p' bridges/opencode-zen-bridge/server.py; echo ===SERVE===; grep -n \\\"has_active\\\\|_zen_idle_expired\\\\|split_timeout\\\\|subagent_started_at\\\" bridges/opencode-zen-bridge/server.py | head -n 40\",\n  \"description\": \"Чтение хелперов таймаутов\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\\\", \\\"1800\\\"))\\n\\n\\ndef _zen_positive_float(name: str, default: float) -> float:\\n    \\\"\\\"\\\"Нечисловое, неконечное и неположительное значение заменяется default.\\\"\\\"\\\"\\n    try:\\n        value = float(os.environ.get(name, str(default)))\\n        return value if 0 < value < float(\\\"inf\\\") else default\\n    except ValueError:\\n        return default\\n\\n\\ndef _zen_targeted(model: str, prompt: str) -> bool:\\n    \\\"\\\"\\\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\\\"\\\"\\\"\\n    models = {\\n        \\\"deepseek-v4.1-flash-free\\\",\\n        *filter(\\n            None, re.split(r\\\"[,\\\\s]+\\\", os.environ.get(\\\"BRIDGE_ZEN_TIMEOUT_MODELS\\\", \\\"\\\"))\\n        ),\\n    }\\n    threshold = _positive_int(os.environ.get(\\\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\\\"), 8192)\\n    return model in models and len(prompt.encode(\\\"utf-8\\\")) > threshold\\n\\n\\ndef _zen_ttft_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\\\"\\\"\\\"\\n    if _zen_targeted(model, prompt):\\n        return min(\\n            TIMEOUT_S,\\n            _zen_positive_float(\\n                \\\"BRIDGE_ZEN_TTFT_TIMEOUT_S\\\",\\n                _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0),\\n            ),\\n        )\\n    return TIMEOUT_S\\n\\n\\ndef _zen_idle_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\\\"\\\"\\\"\\n    if not _zen_targeted(model, prompt):\\n        return TIMEOUT_S\\n    return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_IDLE_TIMEOUT_S\\\", 15.0))\\n\\n\\ndef _zen_total_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\\\"\\\"\\\"\\n    if not _zen_targeted(model, prompt):\\n        return TIMEOUT_S\\n    return min(\\n        TIMEOUT_S,\\n        _zen_positive_float(\\\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\\\", min(180.0, TIMEOUT_S)),\\n    )\\n\\n\\ndef _zen_execution_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\\\"\\\"\\\"\\n    return _zen_ttft_timeout(model, prompt)\\n\\n\\ndef _zen_idle_expired(\\n    now: float, last_token_at: float, idle_timeout: float, tools_active: bool\\n) -> bool:\\n    \\\"\\\"\\\"Idle-таймаут между чанками; не применяется, пока исполняется tool/сабагент (остаются stall и total).\\\"\\\"\\\"\\n    return not tools_active and now - last_token_at >= idle_timeout\\n\\n\\nclass _ToolActivity:\\n    \\\"\\\"\\\"Активные tool/сабагент по событиям `opencode run`: единое условие освобождения от Idle.\\\"\\\"\\\"\\n\\n    def __init__(self) -> None:\\n        self._running: set[str] = set()\\n        self._anonymous = 0\\n\\n    def observe(self, etype: str, event: object) -> None:\\n        \\\"\\\"\\\"Учесть tool_use/tool_call: pending/running — активен, иной статус — завершён.\\\"\\\"\\\"\\n        if etype not in (\\\"tool_use\\\", \\\"tool_call\\\"):\\n            return\\n        part = _as_dict(_as_dict(event).get(\\\"part\\\"))\\n        call_id = str(part.get(\\\"callID\\\") or part.get(\\\"id\\\") or \\\"\\\")\\n        status = _as_dict(part.get(\\\"state\\\")).get(\\\"status\\\")\\n        running = status in (\\\"pending\\\", \\\"running\\\")\\n        if call_id:\\n            if running:\\n                self._running.add(call_id)\\n            else:\\n                self._running.discard(call_id)\\n            return\\n        # Без callID/id параллельные вызовы одного tool не схлопываем: ведём счётчик активных.\\n        if running:\\n            self._anonymous += 1\\n        elif self._anonymous:\\n            self._anonymous -= 1\\n\\n    def __bool__(self) -> bool:\\n        return bool(self._running) or self._anonymous > 0\\n\\n===SERVE===\\n394:def _zen_idle_expired(\\n3859:    def has_active(self) -> bool:\\n4874:                and not tool_state.has_active()\\n4878:                and _zen_idle_expired(\\n4879:                    now, last_token_at, idle_timeout, tool_state.has_active()\\n6751:        split_timeout = [False]\\n6755:        subagent_started_at: dict[str, float] = {}\\n6782:            if watchdog_reason or split_timeout[0]:\\n6789:                and not subagent_started_at\\n6790:                and _zen_idle_expired(\\n6794:                split_timeout[0] = True\\n6810:                and not subagent_started_at\\n6865:                            subagent_started_at[task_id] = now_ev\\n6867:                            _ = subagent_started_at.pop(task_id, None)\\n6943:            elif self.feed.timed_out or split_timeout[0]:\\n8403:                split_timeout = [False]\\n8427:                    # Остановка процесса приводит к EOF в feed, а split_timeout даёт тот же исход, что и дедлайн (504).\\n8434:                        and _zen_idle_expired(\\n8441:                        split_timeout[0] = True\\n8678:                timed_out = feed.timed_out or split_timeout[0]\\n\",\n  \"original_output_bytes\": 5351,\n  \"original_output_tokens\": 1338,\n  \"truncated\": false\n}","final_result":true}}}
