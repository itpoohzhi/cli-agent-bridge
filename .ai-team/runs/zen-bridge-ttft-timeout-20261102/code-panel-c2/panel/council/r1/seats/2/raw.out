\n4856-        while time.monotonic() < deadline:\n4857-            if is_client_gone is not None and is_client_gone():\n4858-                result[\"exit_reason\"] = \"client_gone\"\n4859-                return result\n4860-            if prompt_status.get(\"protocol_error\"):\n4861-                result[\"exit_reason\"] = \"invalid_serve_event\"\n4862-                return result\n4863-            now = time.monotonic()\n--\n5032-                continue\n5033-            if result[\"step_closed\"] and etype in (\"reasoning\", \"text\"):\n5034-                continue\n5035-            accumulated_bytes = _serve_accumulated_bytes(\n5036-                accumulated_bytes, etype, payload, tool_state\n5037-            )\n5038-            if etype == \"reasoning\":\n5039-                text_value = str(payload.get(\"reasoning_content\") or \"\")\n5040-                if text_value:\n5041-                    if result[\"first_token_at\"] is None:\n5042:                        result[\"first_token_at\"] = time.monotonic()\n5043-                        result[\"ttft_ms\"] = int(\n5044-                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n5045-                        )\n5046-                    result[\"reasonings\"].append(text_value)\n5047:                    last_token_at = time.monotonic()\n5048-                    on_reasoning(text_value)\n5049-            elif etype == \"text\":\n5050-                text_value = str(payload.get(\"content\") or \"\")\n5051-                if text_value:\n5052-                    if result[\"first_token_at\"] is None:\n5053:                        result[\"first_token_at\"] = time.monotonic()\n5054-                        result[\"ttft_ms\"] = int(\n5055-                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n5056-                        )\n5057-                    result[\"texts\"].append(text_value)\n5058:                    last_token_at = time.monotonic()\n5059-                 