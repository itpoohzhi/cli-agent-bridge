mpt_status.get(\"protocol_error\"):\n4861|                result[\"exit_reason\"] = \"invalid_serve_event\"\n4862|                return result\n4863|            now = time.monotonic()\n4864|            # Раздельные таймауты: TTFT до первого токена, Idle между чанками после него.\n4865|            if (\n4866|                result[\"first_token_at\"] is None\n4867|                and now - prompt_send_start >= ttft_timeout\n4868|            ) or (\n4869|                result[\"first_token_at\"] is not None\n4870|                and _zen_idle_expired(\n4871|                    now, last_token_at, idle_timeout, tool_state.has_active()\n4872|                )\n4873|            ):\n4874|                result[\"exit_reason\"] = \"timeout\"\n4875|                result[\"delivered\"] = _is_delivered()\n4876|                break\n4877|            if prompt_status.get(\"aux_exhausted\") or (\n4878|                result[\"first_event_at\"] is None and now >= first_event_deadline\n4879|            ):\n4880|                result[\"exit_reason\"] = (\n4881|                    \"timeout\"\n4882|                    if prompt_status.get(\"aux_exhausted\")\n4883|                    or first_event_deadline < first_event_limit\n4884|                    else \"first_event_timeout\"\n4885|                )\n4886|                result[\"delivered\"] = _is_delivered()\n4887|                return result\n4888|            if (\n4889|                result[\"first_event_at\"] is not None\n4890|                and result[\"first_token_at\"] is None\n4891|                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\n4892|            ):\n4893|                result[\"exit_reason\"] = \"first_token_timeout\"\n4894|                result[\"delivered\"] = True\n4895|                return result\n4896|            if result[\"first_token_at\"] is not None and now - last_token_at > float(\n4897|                STALL_TIMEOUT_S\n4898|            ):\n4899|                result[\"exit_reason\"] = \"stall_timeout\"\n4900|                result[\"delivered\"] = True\n4901|                return result\n4902|            # Классификация HTTP-статуса prompt по FALLBACK_DECISION_TABLE до ожидания SSE-события.\n4903|            _ps = prompt_status.get(\"status\")\n4904|            if isinstance(_ps, int) and _ps != 200 and result[\"prompt_status\"] is None:\n4905|                result[\"prompt_status\"] = _ps\n4906|                if _ps in (401, 403):\n4907|                    raise ServeSecurityError(f\"serve prompt HTTP {_ps}\")\n4908|                if _ps in (400, 404, 422):\n4909|                    raise ServeSecurityError(f\"serve prompt HTTP {_ps}\")\n4910|                _delivered_now = _is_delivered()\n4911|                result[\"delivered\"] = _delivered_now\n4912|                if _ps == 429:\n4913|                    result[\"exit_reason\"] = \"prompt_status_429\"\n4914|                    result[\"transient_error\"] = True\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
