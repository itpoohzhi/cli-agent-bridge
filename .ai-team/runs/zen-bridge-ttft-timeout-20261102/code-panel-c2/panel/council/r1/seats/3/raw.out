{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c421","stream":{"kind":"session","id":"01a19b66-d676-7122-b505-10fbb8f7801f"},"sequence":107,"recorded_at":1780531400000209,"record_type":"event","durability":"durable","causation_id":"01a19b66-deff-7220-b388-dc203ae11b11","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19b66-deff-7220-b388-dc203ae11b11","run_stream":{"kind":"run","id":"01a19b66-deff-7220-b388-dc203ae11b11"},"call_id":"call_01a19b677e637755a3d8384ece0febab","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(8369 line(s) above)\n8370|                )\n8371|                watchdog_state: _WatchdogState = {\n8372|                    \"reason\": \"\",\n8373|                    \"first_event_at\": None,\n8374|                    \"first_token_at\": None,\n8375|                    \"last_token_at\": attempt_start,\n8376|                    \"status_next\": (\n8377|                        first_status_due\n8378|                        if attempts.total_spawns <= 1 and not status_fired_at[0]\n8379|                        else attempt_start + FIRST_STATUS_DELAY_S\n8380|                    ),\n8381|                    \"last_keepalive\": attempt_start,\n8382|                    \"last_reasoning\": \"\",\n8383|                }\n8384|                thinking_enabled = effort.strip().lower() not in (\"\", \"off\", \"none\")\n8385|                tool_activity = _ToolActivity()\n8386|                ttft_timeout = _zen_ttft_timeout(model, prompt)\n8387|                idle_timeout = _zen_idle_timeout(model, prompt)\n8388|                split_timeout = [False]\n8389|\n8390|                def emit_synthetic(text: str) -> None:\n8391|                    \"\"\"Синтетический статус отдельной reasoning-дельтой.\"\"\"\n8392|                    tail = str(watchdog_state.get(\"last_reasoning\") or \"\")\n8393|                    prefix = \"\\n\" if tail and not tail.endswith(\"\\n\") else \"\"\n8394|                    chunk_s = format_sse_chunk(\n8395|                        resp_id,\n8396|                        created,\n8397|                        shown_model,\n8398|                        {\"reasoning_content\": prefix + text},\n8399|                    )\n8400|                    first_visible.set()\n8401|                    _ = self.wfile.write(chunk_s.encode(\"utf-8\"))\n8402|                    self.wfile.flush()\n8403|\n8404|                def send_keepalive(proc: subprocess.Popen[str] = proc) -> None:\n8405|                    \"\"\"Надзор: статусы, watchdog и обнаружение ухода клиента.\"\"\"\n8406|                    now_s = time.monotonic()\n8407|                    if self._client_gone_check():\n8408|                        _log(\"stream client gone, killing proc group\")\n8409|                        _stop_proc(proc)\n8410|                        raise BrokenPipeError(\"client gone\")\n8411|                    # Раздельные таймауты: TTFT до первого токена запроса, Idle между чанками после него.\n8412|                    # Остановка процесса приводит к EOF в feed, а split_timeout даёт тот же исход, что и дедлайн (504).\n8413|                    # TTFT считается от начала текущей попытки, Idle не применяется, пока исполняется tool.\n8414|                    if (\n8415|                        watchdog_state[\"first_token_at\"] is None\n8416|                        and now_s - attempt_start > ttft_timeout\n8417|                    ) or (\n8418|                        watchdog_state[\"first_token_at\"] is not None\n8419|                        and _zen_idle_expired(\n8420|                            now_s,\n8421|                            float(watchdog_state[\"last_token_at\"]),\n8422|                            idle_timeout,\n8423|                            bool(tool_activity),\n8424|                        )\n8425|                    ):\n8426|                        split_timeout[0] = True\n8427|                        _stop_proc(proc)\n8428|                        return\n8429|                    if watchdog_state[\n8430|                        \"first_event_at\"\n8431|                    ] is None and now_s - attempt_start > float(FIRST_EVENT_TIMEOUT_S):\n8432|                        watchdog_state[\"reason\"] = \"first_event_timeout\"\n8433|                        _stop_proc(proc)\n8434|                        return\n8435|                    if (\n8436|                        watchdog_state[\"first_event_at\"] is not None\n8437|                        and watchdog_state[\"first_token_at\"] is None\n8438|                        and now_s - attempt_start > float(FIRST_TOKEN_TIMEOUT_S)\n8439|                    ):\n8440|                        watchdog_state[\"reason\"] = \"first_token_timeout\"\n8441|                        _stop_proc(proc)\n8442|                        return\n8443|                    if watchdog_state[\"first_token_at\"] is not None and now_s - float(\n8444|                        watchdog_state[\"last_token_at\"]\n8445|                    ) > float(STALL_TIMEOUT_S):\n8446|                        watchdog_state[\"reason\"] = \"stall_timeout\"\n8447|                        _stop_proc(proc)\n8448|                        return\n8449|                    try:\n8450|                        if thinking_enabled and now_s >= float(\n8451|                            watchdog_state[\"status_next\"]\n8452|                        ):\n8453|                            if watchdog_state[\"first_token_at\"] is None:\n8454|                                if (\n8455|                                    not first_visible.is_set()\n8456|                                    and not status_fired_at[0]\n8457|                                ):\n8458|                                    _initial_status()\n8459|                                    watchdog_state[\"status_next\"] = (\n8460|                                        now_s + STATUS_WAITING_INTERVAL_S\n8461|                                    )\n8462|                                elif (\n8463|                                    status_fired_at[0]\n8464|                                    and now_s - status_fired_at[0]\n8465|                                    < STATUS_WAITING_INTERVAL_S\n8466|                                ):\n8467|                                    # Защитный таймер уже отдал STATUS_INITIAL: без дубля.\n8468|                                    watchdog_state[\"status_next\"] = (\n8469|                                        status_fired_at[0] + STATUS_WAITING_INTERVAL_S\n8470|                                    )\n8471|                                else:\n8472|                                    emit_synthetic(STATUS_WAITING)\n8473|                                    watchdog_state[\"status_next\"] = (\n8474|                                        now_s + STATUS_WAITING_INTERVAL_S\n8475|                                    )\n8476|                            elif now_s - float(\n8477|                                watchdog_state[\"last_token_at\"]\n8478|                            ) >= float(STALL_HEARTBEAT_INTERVAL_S):\n8479|                                emit_synthetic(STATUS_CONTINUATION)\n8480|                                watchdog_state[\"status_next\"] = now_s + float(\n8481|                                    STALL_HEARTBEAT_INTERVAL_S\n8482|                                )\n8483|                        if (\n8484|                            now_s - float(watchdog_state[\"last_keepalive\"])\n8485|                            >= KEEPALIVE_INTERVAL_S\n8486|                        ):\n8487|                            watchdog_state[\"last_keepalive\"] = now_s\n8488|                            keepalive = format_sse_chunk(\n8489|                                resp_id, created, shown_model, {\"content\": \"\"}\n8490|                            )\n8491|                            _ = self.wfile.write(keepalive.encode(\"utf-8\"))\n8492|                            self.wfile.flush()\n8493|                    except (BrokenPipeError, ConnectionResetError, OSError):\n8494|                        _log(\"stream client gone during keepalive, killing proc group\")\n8495|                        _stop_proc(proc)\n8496|                        raise\n8497|\n8498|                feed = _StdoutFeed(proc)\n8499|                for raw in feed.lines(deadline, 0.25, send_keepalive):\n8500|                    gate.release()\n8501|                    raw = raw.strip()\n8502|                    if not raw:\n8503|                        continue\n8504|                    try:\n8505|                        event = json.loads(raw)\n8506|                    except ValueError:\n8507|                        _log(f\"non-json stdout line: {raw[:100]}\")\n8508|                        continue\n8509|\n8510|                    etype, payload = parse_opencode_event(event)\n8511|                    if etype:\n8512|                        tool_activity.observe(etype, event)\n8513|                        if etype in (\"tool_use\", \"tool_call\"):\n8514|                            # Событие tool — активность: Idle отсчитывается от него, как в Run.\n8515|                            watchdog_state[\"last_token_at\"] = time.monotonic()\n8516|                            if watchdog_state[\"first_token_at\"] is None:\n8517|                                watchdog_state[\"first_token_at\"] = time.monotonic()\n8518|                        if watchdog_state[\"first_event_at\"] is None:\n8519|                            watchdog_state[\"first_event_at\"] = time.monotonic()\n8520|                            if (\n8521|                                \"first_event_ms\" not in xs\n8522|                                or xs.get(\"first_event_ms\") is None\n8523|                            ):\n8524|                                xs[\"first_event_ms\"] = int(\n8525|                                    (\n8526|                                        time.monotonic()\n8527|                                        - (\n8528|                                            _attempts_t0(attempts, model, prompt)\n8529|                                        )\n8530|                                    )\n8531|                                    * 1000\n8532|                                )\n8533|                        _token_text = str(\n8534|                            payload.get(\"reasoning_content\")\n8535|                            or payload.get(\"content\")\n8536|                            or \"\"\n8537|                        )\n8538|                        if _token_text.strip():\n8539|                            if watchdog_state[\"first_token_at\"] is None:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
