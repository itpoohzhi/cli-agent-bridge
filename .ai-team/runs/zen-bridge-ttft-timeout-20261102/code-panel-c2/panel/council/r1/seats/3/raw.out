{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67f","stream":{"kind":"session","id":"01a19b66-d676-7122-b505-10fbb8f7801f"},"sequence":410,"recorded_at":1780531400000815,"record_type":"event","durability":"durable","causation_id":"01a19b66-deff-7220-b388-dc203ae11b11","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19b66-deff-7220-b388-dc203ae11b11","run_stream":{"kind":"run","id":"01a19b66-deff-7220-b388-dc203ae11b11"},"task_stream":{"kind":"task","id":"01a19b69-9070-73e2-bf01-0199d615faf9"},"task_id":"01a19b69-9070-73e2-bf01-0199d615faf9","event":{"kind":"output","task_id":"01a19b69-9070-73e2-bf01-0199d615faf9","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(3834 line(s) above)\n3835|        \"\"\"Запомнить фрагмент native вызова.\"\"\"\n3836|        call_id = str(data.get(\"id\") or \"\")\n3837|        if not call_id:\n3838|            return\n3839|        if call_id not in self.tools and len(self.tools) >= _MAX_SERVE_NATIVE_TOOLS:\n3840|            raise ServeProtocolError(\"serve native tool calls count exceeded cap\")\n3841|        item = self.tools.setdefault(call_id, {\"name\": \"\", \"text\": \"\", \"input\": None})\n3842|        name = data.get(\"name\")\n3843|        if isinstance(name, str) and name:\n3844|            item[\"name\"] = name\n3845|        text_value = data.get(\"text\")\n3846|        if isinstance(text_value, str):\n3847|            item[\"text\"] = text_value\n3848|        input_value = data.get(\"input\")\n3849|        if isinstance(input_value, dict):\n3850|            item[\"input\"] = _as_dict(input_value)\n3851|\n3852|    def has_active(self) -> bool:\n3853|        \"\"\"Есть вызов, начатый (feed), но ещё не завершённый (complete): tool исполняется.\"\"\"\n3854|        return any(call_id not in self.emitted for call_id in self.tools)\n3855|\n3856|    def complete(\n3857|        self, call_id: str, event_type: str = \"\"\n3858|    ) -> tuple[str, dict[str, object]] | None:\n3859|        \"\"\"Готовый вызов из called.input или input.ended.text; статус — из типа события.\"\"\"\n3860|        if call_id in self.emitted:\n3861|            return None\n3862|        item = self.tools.get(call_id)\n3863|        if item is None or not item[\"name\"]:\n3864|            return None\n3865|        args = item[\"input\"]\n3866|        if not isinstance(args, dict):\n3867|            text_value = item[\"text\"]\n3868|            try:\n3869|                parsed: object = json.loads(text_value) if text_value else None\n3870|            except ValueError:\n3871|                return None\n3872|            if not isinstance(parsed, dict):\n3873|                return None\n3874|            args = _as_dict(_combine_surrogates(parsed))\n(more lines below)","final_result":true}}}
