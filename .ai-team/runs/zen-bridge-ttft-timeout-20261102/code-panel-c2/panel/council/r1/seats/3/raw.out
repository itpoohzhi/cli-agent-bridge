e is not None and is_client_gone():\n4858|                result[\"exit_reason\"] = \"client_gone\"\n4859|                return result\n4860|            if prompt_status.get(\"protocol_error\"):\n4861|                result[\"exit_reason\"] = \"invalid_serve_event\"\n4862|                return result\n4863|            now = time.monotonic()\n4864|            # Раздельные таймауты: TTFT до первого токена, Idle между чанками после него.\n4865|            if (\n4866|                result[\"first_token_at\"] is None\n4867|                and now - prompt_send_start >= ttft_timeout\n4868|            ) or (\n4869|                result[\"first_token_at\"] is not None\n4870|                and _zen_idle_expired(\n4871|                    now, last_token_at, idle_timeout, tool_state.has_active()\n4872|                )\n4873|            ):\n4874|                result[\"exit_reason\"] = \"timeout\"\n4875|                result[\"delivered\"] = _is_delivered()\n4876|                break\n4877|            if prompt_status.get(\"aux_exhausted\") or (\n4878|                result[\"first_event_at\"] is None and now >= first_event_deadline\n4879|            ):\n4880|                result[\"exit_reason\"] = (\n4881|                    \"timeout\"\n4882|                    if prompt_status.get(\"aux_exhausted\")\n4883|                    or first_event_deadline < first_event_limit\n4884|                    else \"first_event_timeout\"\n4885|                )\n4886|                result[\"delivered\"] = _is_delivered()\n4887|                return result\n4888|            if (\n4889|                result[\"first_event_at\"] is not None\n4890|                and result[\"first_token_at\"] is None\n4891|                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\n4892|            ):\n4893|                result[\"exit_reason\"] = \"first_token_timeout\"\n4894|                result[\"delivered\"] = True\n4895|                return result\n4896|            if re