{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c41b","stream":{"kind":"session","id":"01a19b66-d676-7122-b505-10fbb8f7801f"},"sequence":104,"recorded_at":1780531400000203,"record_type":"event","durability":"durable","causation_id":"01a19b66-deff-7220-b388-dc203ae11b11","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19b66-deff-7220-b388-dc203ae11b11","run_stream":{"kind":"run","id":"01a19b66-deff-7220-b388-dc203ae11b11"},"call_id":"call_01a19b677b4f767cb7bea667cf832c3a","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(329 line(s) above)\n330|\n331|HOST = os.environ.get(\"OPENCODE_ZEN_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\n332|PORT = _positive_int(os.environ.get(\"OPENCODE_ZEN_BRIDGE_PORT\"), 9883)\n333|AUTH_KEY = os.environ.get(\"OPENCODE_ZEN_BRIDGE_KEY\", \"\").strip()\n334|\n335|TIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\n336|\n337|\n338|def _zen_positive_float(name: str, default: float) -> float:\n339|    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\n340|    try:\n341|        value = float(os.environ.get(name, str(default)))\n342|        return value if 0 < value < float(\"inf\") else default\n343|    except ValueError:\n344|        return default\n345|\n346|\n347|def _zen_targeted(model: str, prompt: str) -> bool:\n348|    \"\"\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\"\"\"\n349|    models = {\n350|        \"deepseek-v4.1-flash-free\",\n351|        *filter(\n352|            None, re.split(r\"[,\\s]+\", os.environ.get(\"BRIDGE_ZEN_TIMEOUT_MODELS\", \"\"))\n353|        ),\n354|    }\n355|    threshold = _positive_int(os.environ.get(\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\"), 8192)\n356|    return model in models and len(prompt.encode(\"utf-8\")) > threshold\n357|\n358|\n359|def _zen_ttft_timeout(model: str, prompt: str) -> float:\n360|    \"\"\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\"\"\"\n361|    if _zen_targeted(model, prompt):\n362|        return min(\n363|            TIMEOUT_S,\n364|            _zen_positive_float(\n365|                \"BRIDGE_ZEN_TTFT_TIMEOUT_S\",\n366|                _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0),\n367|            ),\n368|        )\n369|    return TIMEOUT_S\n370|\n371|\n372|def _zen_idle_timeout(model: str, prompt: str) -> float:\n373|    \"\"\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\"\"\"\n374|    if not _zen_targeted(model, prompt):\n375|        return TIMEOUT_S\n376|    return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_IDLE_TIMEOUT_S\", 15.0))\n377|\n378|\n379|def _zen_total_timeout(model: str, prompt: str) -> float:\n380|    \"\"\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\"\"\"\n381|    if not _zen_targeted(model, prompt):\n382|        return TIMEOUT_S\n383|    return min(\n384|        TIMEOUT_S,\n385|        _zen_positive_float(\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\", min(180.0, TIMEOUT_S)),\n386|    )\n387|\n388|\n389|def _zen_execution_timeout(model: str, prompt: str) -> float:\n390|    \"\"\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\"\"\"\n391|    return _zen_ttft_timeout(model, prompt)\n392|\n393|\n394|def _zen_idle_expired(\n395|    now: float, last_token_at: float, idle_timeout: float, tools_active: bool\n396|) -> bool:\n397|    \"\"\"Idle-таймаут между чанками; не применяется, пока исполняется tool/сабагент (остаются stall и total).\"\"\"\n398|    return not tools_active and now - last_token_at >= idle_timeout\n399|\n400|\n401|class _ToolActivity:\n402|    \"\"\"Активные tool/сабагент по событиям `opencode run`: единое условие освобождения от Idle.\"\"\"\n403|\n404|    def __init__(self) -> None:\n405|        self._running: set[str] = set()\n406|\n407|    def observe(self, etype: str, event: object) -> None:\n408|        \"\"\"Учесть tool_use/tool_call: pending/running — активен, иной статус — завершён.\"\"\"\n409|        if etype not in (\"tool_use\", \"tool_call\"):\n410|            return\n411|        part = _as_dict(_as_dict(event).get(\"part\"))\n412|        call_id = str(\n413|            part.get(\"callID\") or part.get(\"id\") or part.get(\"tool\") or \"tool\"\n414|        )\n415|        status = _as_dict(part.get(\"state\")).get(\"status\")\n416|        if status in (\"pending\", \"running\"):\n417|            self._running.add(call_id)\n418|        else:\n419|            self._running.discard(call_id)\n420|\n421|    def __bool__(self) -> bool:\n422|        return bool(self._running)\n423|\n424|\n425|def _attempts_t0(attempts: Any, model: str, prompt: str) -> float:\n426|    \"\"\"Момент старта запроса: attempts.t0, а для совместимых заглушек — выводим из deadline.\"\"\"\n427|    if hasattr(attempts, \"t0\"):\n428|        return attempts.t0\n429|    return attempts.deadline - _zen_total_timeout(model, prompt)\n430|\n431|\n432|def _zen_error(status: int) -> dict[str, Any]:\n433|    \"\"\"Согласованный контракт ошибок zen, одинаковый для JSON и terminal SSE.\"\"\"\n434|    message, kind = (\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
