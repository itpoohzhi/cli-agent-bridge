{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a19b66-d676-7122-b505-10fbb8f7801f"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"01a19b66-deff-7220-b388-dc203ae11b11","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19b66-deff-7220-b388-dc203ae11b11","run_stream":{"kind":"run","id":"01a19b66-deff-7220-b388-dc203ae11b11"},"call_id":"call_01a19b685bdf7348b5f37fb046c7b9f5","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_bridges_speedup_resilience.py`.\n1|\"\"\"Поведенческие регрессии ADR-0021: дедлайны, replay и честные ошибки.\"\"\"\n2|\n3|from __future__ import annotations\n4|\n5|import importlib.util\n6|import io\n7|import json\n8|import sys\n9|import threading\n10|import time\n11|from pathlib import Path\n12|from typing import Any\n13|\n14|import pytest\n15|\n16|from adapters.passthrough_adapter import PassthroughLimits\n17|\n18|ROOT = Path(__file__).resolve().parents[1]\n19|\n20|\n21|@pytest.fixture\n22|def agy(monkeypatch: pytest.MonkeyPatch) -> Any:\n23|    return load_bridge(\"agy-bridge\", monkeypatch)\n24|\n25|\n26|@pytest.fixture\n27|def zen(monkeypatch: pytest.MonkeyPatch) -> Any:\n28|    return load_bridge(\"opencode-zen-bridge\", monkeypatch)\n29|\n30|\n31|def load_bridge(name: str, monkeypatch: pytest.MonkeyPatch) -> Any:\n32|    spec = importlib.util.spec_from_file_location(\n33|        \"speedup_\" + name.replace(\"-\", \"_\"), ROOT / \"bridges\" / name / \"server.py\"\n34|    )\n35|    assert spec and spec.loader\n36|    module = importlib.util.module_from_spec(spec)\n37|    monkeypatch.setitem(sys.modules, spec.name, module)\n38|    monkeypatch.setattr(sys, \"path\", list(sys.path))\n39|    spec.loader.exec_module(module)\n40|    monkeypatch.setattr(module, \"_log\", lambda *_args: None)\n41|    return module\n42|\n43|\n44|def test_passthrough_deadline_env() -> None:\n45|    limits = PassthroughLimits.from_env(\n46|        {\n47|            \"BRIDGE_CONNECT_TIMEOUT_S\": \"2\",\n48|            \"BRIDGE_IDLE_TIMEOUT_S\": \"3\",\n49|            \"BRIDGE_TOTAL_TIMEOUT_S\": \"4\",\n50|            \"BRIDGE_SSE_HEARTBEAT_INTERVAL_S\": \"0.05\",\n51|        }\n52|    )\n53|    assert (\n54|        limits.connect_timeout_s,\n55|        limits.idle_timeout_s,\n56|        limits.total_timeout_s,\n57|        limits.heartbeat_interval_s,\n58|    ) == (2, 3, 4, 0.05)\n59|    defaults = PassthroughLimits.from_env({})\n60|    assert (\n61|        defaults.connect_timeout_s,\n62|        defaults.idle_timeout_s,\n63|        defaults.total_timeout_s,\n64|        defaults.heartbeat_interval_s,\n65|    ) == (10, 300, 420, 12)\n66|\n67|\n68|@pytest.mark.parametrize(\n69|    \"req,mode\",\n70|    [\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
