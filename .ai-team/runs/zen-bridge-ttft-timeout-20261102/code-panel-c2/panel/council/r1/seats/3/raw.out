atchdog_reason.append(reason)\n6801|                state = reason\n6802|                _log(f\"opencode run watchdog: {reason}\")\n6803|                if self.proc is not None:\n6804|                    _stop_proc(self.proc)\n6805|\n6806|        try:\n6807|            self.feed = _StdoutFeed(self.proc)\n6808|            for raw in self.feed.lines(\n6809|                deadline, idle_s=_STDOUT_POLL_S, on_idle=on_idle\n6810|            ):\n6811|                gate.release()\n6812|                raw = raw.strip()\n6813|                if not raw:\n6814|                    continue\n6815|                try:\n6816|                    event = json.loads(raw)\n6817|                except ValueError:\n6818|                    _log(f\"non-json stdout line: {_clean_err(raw)[:100]}\")\n6819|                    err_lines.append(raw[:200])\n6820|                    continue\n6821|\n6822|                etype, payload = parse_opencode_event(event)\n6823|                if isinstance(event, dict):\n6824|                    now_ev = time.monotonic()\n6825|                    if first_event_at is None:\n6826|                        first_event_at = now_ev\n6827|                    tool_activity.observe(etype, event)\n6828|                    frame = _as_dict(cast(object, payload))\n6829|                    token = (\n6830|                        frame.get(\"content\")\n6831|                        if etype == \"text\"\n6832|                        else frame.get(\"reasoning_content\")\n6833|                    )\n6834|                    if (\n6835|                        etype in (\"text\", \"reasoning\")\n6836|                        and isinstance(token, str)\n6837|                        and token\n6838|                    ) or etype in (\"tool_use\", \"tool_call\"):\n6839|                        if first_token_at is None:\n6840|                            first_token_at = now_ev\n6841|                        last_token_at = now_ev\n6842|                    part = _as_dic