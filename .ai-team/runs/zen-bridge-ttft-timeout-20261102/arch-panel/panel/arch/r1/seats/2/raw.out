{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QXR3pGpDpPaYir3bbiyysg","type":"tool_result","content":"HOST = os.environ.get(\"OPENCODE_ZEN_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\nPORT = _positive_int(os.environ.get(\"OPENCODE_ZEN_BRIDGE_PORT\"), 9883)\nAUTH_KEY = os.environ.get(\"OPENCODE_ZEN_BRIDGE_KEY\", \"\").strip()\n\nTIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\n\n\ndef _zen_positive_float(name: str, default: float) -> float:\n    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\n    try:\n        value = float(os.environ.get(name, str(default)))\n        return value if 0 < value < float(\"inf\") else default\n    except ValueError:\n        return default\n\n\ndef _zen_execution_timeout(model: str, prompt: str) -> float:\n    \"\"\"Сужение execution deadline только для явно выбранных моделей и большого UTF-8 входа.\"\"\"\n    models = {\n        \"deepseek-v4.1-flash-free\",\n        *filter(\n            None, re.split(r\"[,\\s]+\", os.environ.get(\"BRIDGE_ZEN_TIMEOUT_MODELS\", \"\"))\n        ),\n    }\n    threshold = _positive_int(os.environ.get(\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\"), 8192)\n    if model in models and len(prompt.encode(\"utf-8\")) > threshold:\n        return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0))\n    return TIMEOUT_S\n\n\ndef _zen_error(status: int) -> dict[str, Any]:\n    \"\"\"Согласованный контракт ошибок zen, одинаковый для JSON и terminal SSE.\"\"\"\n---\n335:TIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\n338:def _zen_positive_float(name: str, default: float) -> float:\n1862:FIRST_EVENT_TIMEOUT_S = float(\n1865:FIRST_TOKEN_TIMEOUT_S = float(\n1868:STALL_TIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\", \"60.0\"))\n1871:STALL_HEARTBEAT_INTERVAL_S = 15.0\n4365:def _serve_one_attempt(\n7380:                result = _serve_one_attempt(\n8967:                result = _serve_one_attempt(\n---\n                    \"timeout\"\n                    if prompt_status.get(\"aux_exhausted\")\n                    or first_event_deadline < first_event_limit\n                    else \"first_event_timeout\"\n                )\n                result[\"delivered\"] = _is_delivered()\n                return result\n            if (\n                result[\"first_event_at\"] is not None\n                and result[\"first_token_at\"] is None\n                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\n            ):\n                result[\"exit_reason\"] = \"first_token_timeout\"\n                result[\"delivered\"] = True\n                return result\n            if result[\"first_token_at\"] is not None and now - last_token_at > float(\n                STALL_TIMEOUT_S\n            ):\n                result[\"exit_reason\"] = \"stall_timeout\"\n                result[\"delivered\"] = True\n                return result\n            # Классификация HTTP-статуса prompt по FALLBACK_DECISION_TABLE до ожидания SSE-события.\n            _ps = prompt_status.get(\"status\")\n            if isinstance(_ps, int) and _ps != 200 and result[\"prompt_status\"] is None:\n                result[\"prompt_status\"] = _ps\n                if _ps in (401, 403):\n---\n                    _stop_proc(self.proc)\n                return\n            if watchdog_reason:\n                return\n            now = time.monotonic()\n            reason = \"\"\n            if first_event_at is None and now - attempt_start > float(\n                FIRST_EVENT_TIMEOUT_S\n            ):\n                reason = \"first_event_timeout\"\n            elif first_token_at is None and now - attempt_start > float(\n                FIRST_TOKEN_TIMEOUT_S\n            ):\n                reason = \"first_token_timeout\"\n            elif (\n                last_token_at is not None\n                and not subagent_started_at\n                and now - last_token_at > float(STALL_TIMEOUT_S)\n            ):\n                reason = \"stall_timeout\"\n            if reason:\n                watchdog_reason.append(reason)\n                state = reason\n                _log(f\"opencode run watchdog: {reason}\")\n                if self.proc is not None:\n                    _stop_proc(self.proc)\n---\n                    if self._client_gone_check():\n                        _log(\"stream client gone, killing proc group\")\n                        _stop_proc(proc)\n                        raise BrokenPipeError(\"client gone\")\n                    if watchdog_state[\n                        \"first_event_at\"\n                    ] is None and now_s - attempt_start > float(FIRST_EVENT_TIMEOUT_S):\n                        watchdog_state[\"reason\"] = \"first_event_timeout\"\n                        _stop_proc(proc)\n                        return\n                    if (\n                        watchdog_state[\"first_event_at\"] is not None\n                        and watchdog_state[\"first_token_at\"] is None\n                        and now_s - attempt_start > float(FIRST_TOKEN_TIMEOUT_S)\n                    ):\n                        watchdog_state[\"reason\"] = \"first_token_timeout\"\n                        _stop_proc(proc)\n                        return\n                    if watchdog_state[\"first_token_at\"] is not None and now_s - float(\n                        watchdog_state[\"last_token_at\"]\n                    ) > float(STALL_TIMEOUT_S):\n                        watchdog_state[\"reason\"] = \"stall_timeout\"\n                        _stop_proc(proc)\n                        return\n                    try:\n                        if thinking_enabled and now_s >= float(\n---\n27:def zen(monkeypatch: pytest.MonkeyPatch) -> Any:\n28:    return load_bridge(\"opencode-zen-bridge\", monkeypatch)\n126:def test_zen_byte_timeout_selection(zen: Any, monkeypatch: pytest.MonkeyPatch) -> None:\n129:    assert zen._zen_execution_timeout(\"deepseek-v4.1-flash-free\", \"я\" * 5) == 0.1\n131:        zen._zen_execution_timeout(\"deepseek-v4.1-flash-free\", \"я\" * 4) == zen.TIMEOUT_S\n133:    assert zen._zen_execution_timeout(\"unrelated-free\", \"x\" * 100) == zen.TIMEOUT_S\n135:    assert zen._zen_execution_timeout(\"explicit-model\", \"x\" * 9) == 0.1\n138:def test_zen_short_content_and_pong(zen: Any) -> None:\n139:    assert zen._zen_short_response(\"x\" * 100, \"short\", [])\n140:    assert not zen._zen_short_response(\"ping\", \"PONG\", [])\n141:    assert not zen._zen_short_response(\n144:    assert not zen._zen_short_response(\"x\" * 100, \"я\" * 16, [])\n159:    assert server._parse_blocked_models(text) == frozenset(\n243:def test_slow_ttft_gets_heartbeats_before_content(\n485:def zen_handler(zen: Any) -> tuple[Any, list[int]]:\n486:    handler = object.__new__(zen.Handler)\n496:def test_zen_timeout_error_before_and_after_headers(\n497:    zen: Any, monkeypatch: pytest.MonkeyPatch\n500:    handler, statuses = zen_handler(zen)\n501:    handler._set_zen_policy(\"deepseek-v4.1-flash-free\", \"x\" * 9)\n505:    assert json.loads(handler.wfile.getvalue()) == zen._zen_error(504)\n510:    assert json.loads(frames.split(b\"\\n\\n\")[0][6:]) == zen._zen_error(504)\n522:def test_zen_json_short_filter(\n523:    zen: Any, content: str, calls: list, expected: int\n525:    handler, statuses = zen_handler(zen)\n526:    handler._set_zen_policy(\"other\", \"x\" * 100)\n532:        assert json.loads(handler.wfile.getvalue()) == zen._zen_error(502)\n535:def test_zen_stream_short_filter_and_tool_only(zen: Any) -> None:\n544:    filtered = zen._ZenSseFilter(raw, \"x\" * 100, False)\n552:    filtered = zen._ZenSseFilter(raw, \"x\" * 100, False)\n     903 tests/test_bridges_speedup_resilience.py\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/zen-bridge-ttft-timeout-20261102/arch-panel/panel/arch/r1","is_error":false}]},"parent_tool_use