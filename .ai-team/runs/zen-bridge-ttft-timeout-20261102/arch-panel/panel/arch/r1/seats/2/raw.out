{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QvzdnAhXnYivj2Y63XbJfo","type":"tool_result","content":"    monkeypatch.setattr(module, \"_log\", lambda *_args: None)\n    return module\n\n\ndef test_passthrough_deadline_env() -> None:\n    limits = PassthroughLimits.from_env(\n        {\n            \"BRIDGE_CONNECT_TIMEOUT_S\": \"2\",\n            \"BRIDGE_IDLE_TIMEOUT_S\": \"3\",\n            \"BRIDGE_TOTAL_TIMEOUT_S\": \"4\",\n            \"BRIDGE_SSE_HEARTBEAT_INTERVAL_S\": \"0.05\",\n        }\n    )\n    assert (\n        limits.connect_timeout_s,\n        limits.idle_timeout_s,\n        limits.total_timeout_s,\n        limits.heartbeat_interval_s,\n    ) == (2, 3, 4, 0.05)\n    defaults = PassthroughLimits.from_env({})\n    assert (\n        defaults.connect_timeout_s,\n        defaults.idle_timeout_s,\nE       assert (10.0, 300.0, 420.0, 12.0) == (10, 60, 420, 12)\nE         \nE         At index 1 diff: 300.0 != 60\nE         Use -v to get more diff\nM  adapters/passthrough_adapter.py\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/zen-bridge-ttft-timeout-20261102/arch-panel/panel/arch/r1","is_error":false}]},"parent_tool_use_id":null,"session_id":"59fb1cd6-4360-409a-b0eb-cea27f78051a","uuid":"2a8b2a26-a886-4489-8842-0e543c7a935a","timestamp":"2026-11-02T07:03:27.547Z","tool_use_result":{"stdout":"    monkeypatch.setattr(module, \"_log\", lambda *_args: None)\n    return module\n\n\ndef test_passthrough_deadline_env() -> None:\n    limits = PassthroughLimits.from_env(\n        {\n            \"BRIDGE_CONNECT_TIMEOUT_S\": \"2\",\n            \"BRIDGE_IDLE_TIMEOUT_S\": \"3\",\n            \"BRIDGE_TOTAL_TIMEOUT_S\": \"4\",\n            \"BRIDGE_SSE_HEARTBEAT_INTERVAL_S\": \"0.05\",\n        }\n    )\n    assert (\n        limits.connect_timeout_s,\n        limits.idle_timeout_s,\n        limits.total_timeout_s,\n        limits.heartbeat_interval_s,\n    ) == (2, 3, 4, 0.05)\n    defaults = Passthrough