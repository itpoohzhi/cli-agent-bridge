ype in (\"tool_use\", \"tool_call\"):\n6799:                        last_token_at = now_ev\n6802:                        etype in (\"tool_use\", \"tool_call\")\n6844:                elif etype == \"tool_use\":\n6886:            elif self.feed.timed_out or split_timeout[0]:\n8333:                    \"last_token_at\": attempt_start,\n8345:                idle_timeout = _zen_idle_timeout(model, prompt)\n8346:                split_timeout = [False]\n8370:                    # Остановка процесса приводит к EOF в feed, а split_timeout даёт тот же исход, что и дедлайн (504).\n8382:                        and now_s - float(watchdog_state[\"last_token_at\"])\n8383:                        > idle_timeout\n8385:                        split_timeout[0] = True\n8403:                        watchdog_state[\"last_token_at\"]\n8436:                                watchdog_state[\"last_token_at\"]\n8504:                            watchdog_state[\"last_token_at\"] = time.monotonic()\n8588:                    elif etype == \"tool_use\":\n8616:                timed_out = feed.timed_out or split_timeout[0]\n","exit_code":0,"status":"completed"}}
