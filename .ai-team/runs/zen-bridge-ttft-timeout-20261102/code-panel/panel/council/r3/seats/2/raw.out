\n6701|        )\n6702|        subagent_started_at: dict[str, float] = {}\n6703|        run_id = uuid.uuid4().hex[:8]\n6704|\n6705|        with _active_lock:\n6706|            _active[run_id] = time.time()\n6707|\n6708|        def drain_stderr() -> None:\n6709|            try:\n6710|                assert self.proc is not None and self.proc.stderr is not None\n6711|                for line in self.proc.stderr:\n6712|                    line = line.strip()\n6713|                    if line:\n6714|                        err_lines.append(line)\n6715|            except (OSError, ValueError):\n6716|                pass\n6717|\n6718|        err_thread = threading.Thread(target=drain_stderr, daemon=True)\n6719|        err_thread.start()\n6720|\n6721|        def on_idle() -> None:\n6722|            \"\"\"Прервать молчащий JSON-прогон при закрытии клиентского сокета.\"\"\"\n6723|            nonlocal state\n6724|            if self.is_client_gone is not None and self.is_client_gone():\n6725|                state = \"client_gone\"\n6726|                if self.proc is not None:\n6727|                    _stop_proc(self.proc)\n6728|                return\n6729|            if watchdog_reason or split_timeout[0]:\n6730|                return\n6731|            now = time.monotonic()\n6732|            # Раздельные таймауты: TTFT до первого токена, Idle между токенами после него.\n6733|            if (first_token_at is None and now - ttft_origin > ttft_timeout) or (\n6734|                last_token_at is not None\n6735|                and not subagent_started_at\n6736|                and now - last_token_at > idle_timeout\n6737|            ):\n6738|                split_timeout[0] = True\n6739|                _log(\"opencode run split timeout (ttft/idle)\")\n6740|                if self.proc is not None:\n6741|                    _stop_proc(self.proc)\n6742|                return\n6743|            reason = \"\"\n6744|            if first_event_at is None and now - attempt_start > float(\n6745|                FIRST_EVENT_TIMEOUT_S\n6746|            ):\n6747|                reason = \"first_event_timeout\"\n6748|            elif first_token_at is None and now - attempt_start > float(\n6749|                FIRST_TOKEN_TIMEOUT_S\n6750|            ):\n6751|                reason = \"first_token_timeout\"\n6752|            elif (\n6753|                last_token_at is not None\n6754|                and not subagent_started_at\n6755|                and now - last_token_at > float(STALL_TIMEOUT_S)\n6756|            ):\n6757|                reason = \"stall_timeout\"\n6758|            if reason:\n6759|                watchdog_reason.append(reason)\n6760|                state = reason\n6761|                _log(f\"opencode run watchdog: {reason}\")\n6762|                if self.proc is not None:\n6763|                    _stop_proc(self.proc)\n6764|\n6765|        try:\n6766|            self.feed = _StdoutFeed(self.proc)\n6767|            for raw in self.feed.lines(\n6768|                deadline, idle_s=_STDOUT_POLL_S, on_idle=on_idle\n6769|            ):\n6770|                gate.release()\n6771|                raw = raw.strip()\n6772|                if not raw:\n6773|                    continue\n6774|                try:\n6775|                    event = json.loads(raw)\n6776|                except ValueError:\n6777|                    _log(f\"non-json stdout line: {_clean_err(raw)[:100]}\")\n6778|                    err_lines.append(raw[:200])\n6779|                    continue\n6780|\n6781|                etype, payload = parse_opencode_event(event)\n6782|                if isinstance(event, dict):\n6783|                    now_ev = time.monotonic()\n6784|                    if first_event_at is None:\n6785|                        first_event_at = now_ev\n6786|                    frame = _as_dict(cast(object, payload))\n6787|                    token = (\n6788|                        frame.get(\"content\")\n6789|                        if etype == \"text\"\n6790|                        else frame.get(\"reasoning_content\")\n6791|                    )\n6792|                    if (\n6793|                        etype in (\"text\", \"reasoning\")\n6794|                        and isinstance(token, str)\n6795|                        and token\n6796|                    ) or etype in (\"tool_use\", \"tool_call\"):\n6797|                        if first_token_at is None:\n6798|                            first_token_at = now_ev\n6799|                        last_token_at = now_ev\n6800|                    part = _as_dict(_as_dict(cast(object, event)).get(\"part\"))\n6801|                    if (\n6802|                        etype in (\"tool_use\", \"tool_call\")\n6803|                        and part.get(\"tool\") == \"task\"\n6804|                    ):\n6805|                        task_id = str(part.get(\"id\") or \"task\")\n6806|                        task_status = _as_dict(part.get(\"state\")).get(\"status\")\n6807|                        if task_status in (\"pending\", \"running\"):\n6808|                            subagent_started_at[task_id] = now_ev\n6809|                        else:\n6810|                            _ = subagent_started_at.pop(task_id, None)\n6811|                if etype == \"text\":\n6812|                    ttext = payload.get(\"content\")\n6813|                    if isinstance(ttext, str):\n6814|                        ttext = _strip_interrupted(ttext)\n6815|                    if isinstance(ttext, str) and ttext:\n6816|                        text_pieces.append(ttext)\n6817|                elif etype == \"reasoning\":\n6818|                    rtext = payload.get(\"reasoning_content\")\n6819|                    if isinstance(rtext, str) and rtext:\n6820|                        reasoning_pieces.append(rtext)\n6821|                elif etype == \"step_finish\":\n6822|                    if payload:\n6823|                        for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n6824|                            usage[key] = int(usage.get(key) or 0) + int(\n6825|                                payload.get(key) or 0\n6826|                            )\n6827|                    if self.tools is not None and (\n6828|                        any(\n6829|                            _native_to_tool_calls(\n6830|                                nc.get(\"tool\"), nc.get(\"input\"), self.tools\n6831|                            )\n6832|                            for nc in native_calls\n6833|                        )\n6834|                        or any(\n6835|                            close_tag in \"\".join(text_pieces)\n6836|                            for _, close_tag in TOOL_CALL_TAGS\n6837|                        )\n6838|                    ):\n6839|                        _log(\n6840|                            \"exec: step with tool call finished, stopping opencode run\"\n6841|                        )\n6842|                        _stop_proc(self.proc)\n6843|                        break\n6844|                elif etype == \"tool_use\":\n6845|                    tpart = _dict_or_empty(event.get(\"part\"))\n6846|                    tstate = _dict_or_empty(tpart.get(\"state\"))\n6847|                    native_calls.append(\n6848|                        {\n6849|                            \"tool\": tpart.get(\"tool\"),\n6850|                            \"input\": tstate.get(\"input\"),\n6851|                            \"status\": tstate.get(\"status\"),\n6852|                        }\n6853|                    )\n6854|                elif etype == \"error\":\n6855|                    state = \"provider_error\"\n6856|                    if isinstance(payload.get(\"statusCode\"), int):\n6857|                        provider_status = payload[\"statusCode\"]\n6858|                    err_lines.append(\n6859|                        f\"HTTP {payload.get('statusCode')}: {payload.get('message')}\"\n(more lines below)","final_result":true}}}
