le_timeout(model, prompt)\n8346|                split_timeout = [False]\n8347|\n8348|                def emit_synthetic(text: str) -> None:\n8349|                    \"\"\"Синтетический статус отдельной reasoning-дельтой.\"\"\"\n8350|                    tail = str(watchdog_state.get(\"last_reasoning\") or \"\")\n8351|                    prefix = \"\\n\" if tail and not tail.endswith(\"\\n\") else \"\"\n8352|                    chunk_s = format_sse_chunk(\n8353|                        resp_id,\n8354|                        created,\n8355|                        shown_model,\n8356|                        {\"reasoning_content\": prefix + text},\n8357|                    )\n8358|                    first_visible.set()\n8359|                    _ = self.wfile.write(chunk_s.encode(\"utf-8\"))\n8360|                    self.wfile.flush()\n8361|\n8362|                def send_keepalive(proc: subprocess.Popen[str] = proc) -> None:\n8363|                    \"\"\"Надзор: статусы, watchdog и обнаружение ухода клиента.\"\"\"\n8364|                    now_s = time.monotonic()\n8365|                    if self._client_gone_check():\n8366|                        _log(\"stream client gone, killing proc group\")\n8367|                        _stop_proc(proc)\n8368|                        raise BrokenPipeError(\"client gone\")\n8369|                    # Раздельные таймауты: TTFT до первого токена запроса, Idle между чанками после него.\n8370|                    # Остановка процесса приводит к EOF в feed, а split_timeout даёт тот же исход, что и дедлайн (504).\n8371|                    if (\n8372|                        watchdog_state[\"first_token_at\"] is None\n8373|                        and now_s\n8374|                        - (\n8375|                            attempt_start\n8376|                            if collected_texts or tool_calls\n8377|                            else request_t0\n8378|                        )\n8379|                        > ttft_timeout\n8380|                    ) or (\n8381|                        watchdog_state[\"first_token_at\"] is not None\n8382|                        and now_s - float(watchdog_state[\"last_token_at\"])\n8383|                        > idle_timeout\n8384|                    ):\n8385|                        split_timeout[0] = True\n8386|                        _stop_proc(proc)\n8387|                        return\n8388|                    if watchdog_state[\n8389|                        \"first_event_at\"\n8390|                    ] is None and now_s - attempt_start > float(FIRST_EVENT_TIMEOUT_S):\n8391|                        watchdog_state[\"reason\"] = \"first_event_timeout\"\n8392|                        _stop_proc(proc)\n8393|                        return\n8394|                    if (\n8395|                        watchdog_state[\"first_event_at\"] is not None\n8396|                        and watchdog_state[\"first_token_at\"] is None\n8397|                        and now_s - attempt_start > float(FIRST_TOKEN_TIMEOUT_S)\n8398|                    ):\n8399|                        watchdog_state[\"reason\"] = \"first_token_timeout\"\n8400|                        _stop_proc(proc)\n8401|                        return\n8402|                    if watchdog_state[\"first_token_at\"] is not None and now_s - float(\n8403|                        watchdog_state[\"last_token_at\"]\n8404|                    ) > float(STALL_TIMEOUT_S):\n8405|                        watchdog_state[\"reason\"] = \"stall_timeout\"\n8406|                        _stop_proc(proc)\n8407|                        return\n8408|                    try:\n8409|                        if thinking_enabled and now_s >= float(\n8410|                            watchdog_state[\"status_next\"]\n8411|                        ):\n8412|                            if watchdog_state[\"first_token_at\"] is None:\n8413|                                if (\n8414|                                    not first_visible.is_set()\n8415|          