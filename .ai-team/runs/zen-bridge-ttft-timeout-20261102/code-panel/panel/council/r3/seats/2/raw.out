en_at\"] is None\n4827|                and now - prompt_send_start >= ttft_timeout\n4828|            ) or (\n4829|                result[\"first_token_at\"] is not None\n4830|                and now - last_token_at >= idle_timeout\n4831|            ):\n4832|                result[\"exit_reason\"] = \"timeout\"\n4833|                result[\"delivered\"] = _is_delivered()\n4834|                break\n4835|            if prompt_status.get(\"aux_exhausted\") or (\n4836|                result[\"first_event_at\"] is None and now >= first_event_deadline\n4837|            ):\n4838|                result[\"exit_reason\"] = (\n4839|                    \"timeout\"\n4840|                    if prompt_status.get(\"aux_exhausted\")\n4841|                    or first_event_deadline < first_event_limit\n4842|                    else \"first_event_timeout\"\n4843|                )\n4844|                result[\"delivered\"] = _is_delivered()\n4845|                return result\n4846|            if (\n4847|                result[\"first_event_at\"] is not None\n4848|                and result[\"first_token_at\"] is None\n4849|                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\n4850|            ):\n4851|                result[\"exit_reason\"] = \"first_token_timeout\"\n4852|                result[\"delivered\"] = True\n4853|                return result\n4854|            if result[\"first_token_at\"] is not None and now - last_token_at > float(\n4855|                STALL_TIMEOUT_S\n4856|            ):\n4857|                result[\"exit_reason\"] = \"stall_timeout\"\n4858|                result[\"delivered\"] = True\n4859|                return result\n4860|            # Классификация HTTP-статуса prompt по FALLBACK_DECISION_TABLE до ожидания SSE-события.\n4861|            _ps = prompt_status.get(\"status\")\n4862|            if isinstance(_ps, int) and _ps != 200 and result[\"prompt_status\"] is None:\n4863|                result[\"prompt_status\"] = _ps\n4864|                if _ps in (401, 403):\n4865|                    raise ServeSecurityError(f\"serve prompt HTTP {_ps}\")\n4866|                if _ps in (400, 404, 422):\n4867|                    raise ServeSecurityError(f\"serve prompt HTTP {_ps}\")\n4868|                _delivered_now = _is_delivered()\n4869|                result[\"delivered\"] = _delivered_now\n4870|                if _ps == 429:\n4871|                    result[\"exit_reason\"] = \"prompt_status_429\"\n4872|                    result[\"transient_error\"] = True\n4873|                    return result\n4874|                if 500 <= _ps <= 599:\n4875|                    result[\"exit_reason\"] = f\"prompt_status_{_ps}\"\n4876|                    return result\n4877|            _prompt_err = prompt_status.get(\"error\")\n4878|            if isinstance(_prompt_err, str):\n4879|                _has_delivery = _is_delivered()\n4880|                if not _has_delivery:\n4881|                    raise ServeUnavailable(f\"serve prompt failed: {_prompt_err}\")\n4882|                result[\"delivered\"] = True\n4883|                result[\"exit_reason\"] = \"prompt_error\"\n4884|                result[\"transient_error\"] = True\n4885|                return result\n4886|            if thinking_enabled and on_status is not None and now >= status_next:\n4887|                if result[\"first_token_at\"] is None:\n4888|                    on_status(\n4889|                        STATUS_INITIAL if _status_emitted[0] == 0 else STATUS_WAITING\n4890|                    )\n4891|                    _status_emitted[0] += 1\n4892|                    status_next = now + STATUS_WAITING_INTERVAL_S\n4893|                elif now - last_token_at >= float(STALL_HEARTBEAT_INTERVAL_S):\n4894|                    on_status(STATUS_CONTINUATION)\n4895|                    status_next = now + float(STALL_HEARTBEAT_INTERVAL_S)\n4896|            try:\n4897|                event = events.get(timeout=0.02)\n4898|            except queue.Empty:\n4899|                continue\n4900|            if event is None:\n4901|                if not result[\"terminal\"]:\n4902|                    result[\"exit_reason\"] = \"invalid_serve_event\"\n4903|                    result[\"delivered\"] = _is_delivered()\n4904|                break\n4905|            if subscribe_wait_started is not None:\n4906|                aux.debit_elapsed(subscribe_wait_started)\n4907|                subscribe_wait_started = None\n4908|            _release_event(event)\n4909|            etype_raw = str(event.get(\"type\") or \"\")\n4910|            if etype_raw == \"__invalid_json__\":\n4911|                result[\"exit_reason\"] = \"invalid_serve_event\"\n4912|                result[\"delivered\"] = _is_delivered()\n4913|                return result\n4914|            data_raw = _as_dict(event.get(\"data\"))\n4915|            _raw_sid = data_raw.get(\"sessionID\")\n4916|            if (\n4917|                etype_raw not in (\"server.connected\", \"form.created\")\n4918|                and isinstance(_raw_sid, str)\n4919|                and _raw_sid\n4920|                and _raw_sid != session_id\n4921|            ):\n4922|                continue\n4923|            current_step_msg_id = _serve_step_message_id(\n4924|                data_raw, session_id, result[\"step_closed\"], current_step_msg_id\n4925|            )\n4926|            # form.created: безопасность до любой проверки title/fields/схемы.\n4927|            if etype_raw == \"form.created\":\n4928|                form = _as_dict(data_raw.get(\"form\"))\n4929|                form_session = form.get(\"sessionID\")\n4930|                form_id = form.get(\"id\")\n4931|                if form_session == session_id and isinstance(form_id, str) and form_id:\n4932|                    result[\"step_closed\"] = True\n4933|                    _reject_and_interrupt(\n4934|                        f\"/api/session/{session_id}/form/{form_id}/cancel\",\n4935|                        None,\n4936|                        \"form cancel\",\n4937|                    )\n4938|                    result[\"terminal\"] = \"cancelled\"\n4939|                    break\n4940|                if form_session == session_id:\n4941|                    raise ServeSecurityError(\"form.created without id\")\n4942|                continue\n4943|            if prompt_status.get(\"security\"):\n4944|                raise ServeSecurityError(\"serve prompt auth failed\")\n4945|            try:\n4946|                _mapped = _map_serve_event(event)\n4947|            except ServeProtocolError:\n4948|                result[\"exit_reason\"] = \"invalid_serve_event\"\n4949|                result[\"delivered\"] = _is_delivered()\n4950|                return result\n4951|            if _mapped is None:\n4952|                continue\n4953|            etype, payload = _mapped\n4954|            event_session = (\n4955|                payload.get(\"sessionID\") if isinstance(payload, dict) else None\n4956|            )\n4957|            if etype_raw not in (\"server.connected\",) and event_session not in (\n4958|                None,\n4959|                session_id,\n4960|            ):\n4961|                continue\n4962|            is_execution = etype_raw in (\n4963|                \"session.execution.started\",\n4964|                \"session.step.started\",\n4965|                \"session.reasoning.started\",\n4966|                \"session.reasoning.delta\",\n4967|                \"session.text.delta\",\n4968|                \"session.step.ended\",\n4969|            ) or etype in (\"reasoning\", \"text\", \"tool_event\", \"step_finish\")\n4970|            if is_execution and result[\"first_event_at\"] is None:\n4971|                result[\"first_event_at\"] = time.monotonic()\n4972|                _finish_prompt_aux(time.monotonic())\n4973|                result[\"first_event_ms\"] = int(\n4974|                    ((result[\"first_event_at\"] or 0.0) - t0) * 100