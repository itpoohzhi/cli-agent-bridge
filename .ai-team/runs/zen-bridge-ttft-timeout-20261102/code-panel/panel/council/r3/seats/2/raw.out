\n5014|                        )\n5015|                    result[\"texts\"].append(text_value)\n5016|                    last_token_at = time.monotonic()\n5017|                    on_text(text_value)\n5018|            elif etype == \"tool_event\":\n5019|                if etype_raw == \"session.tool.input.delta\":\n5020|                    last_token_at = time.monotonic()\n5021|                tool_state.feed(payload)\n5022|                accumulated_bytes = _serve_accumulated_bytes(\n5023|                    accumulated_bytes, etype, payload, tool_state\n5024|                )\n5025|                call_id = str(payload.get(\"id\") or \"\")\n5026|                if etype_raw in (\n5027|                    \"session.tool.called\",\n5028|                    \"session.tool.failed\",\n5029|                    \"session.tool.success\",\n5030|                ):\n5031|                    done = tool_state.complete(call_id, etype_raw)\n5032|                    if done is not None:\n5033|                        last_token_at = time.monotonic()\n5034|                        pending_step_calls.append(done[1])\n5035|                        if result[\"first_token_at\"] is None:\n5036|                            result[\"first_token_at\"] = time.monotonic()\n5037|                            result[\"ttft_ms\"] = int(\n5038|                                ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n5039|                            )\n5040|                        if emulate_tools:\n5041|                            _acc_box = [accumulated_bytes]\n5042|                            _ = _finish_serve_tool_step(\n5043|                                events,\n5044|                                session_id,\n5045|                                data_raw.get(\"assistantMessageID\")\n5046|                                or current_step_msg_id\n5047|                                or None,\n5048|                                min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\n5049|                                tool_state,\n5050|                                result,\n5051|                                on_tool,\n5052|                                _release_event,\n5053|                                attempt_deadline=deadline,\n5054|                                is_client_gone=is_client_gone,\n5055|                                pending_calls=pending_step_calls,\n5056|                                ctrl_http=_drain_ctrl,\n5057|                                reasoning_cb=on_reasoning,\n5058|                                text_cb=on_text,\n5059|                                emulate_tools=emulate_tools,\n5060|                                accumulated_bytes=_acc_box,\n5061|                                t0=t0,\n5062|                                replied_permissions=replied_permissions,\n5063|                                cascade_reject_state=cascade_reject_state,\n5064|                            )\n5065|                            accumulated_bytes = _acc_box[0]\n5066|                            break\n5067|            elif etype == \"step_finish\":\n5068|                step_key = str(\n5069|                    _as_dict(payload).get(\"assistantMessageID\")\n5070|                    or data_raw.get(\"assistantMessageID\")\n5071|                    or \"\"\n5072|                )\n5073|                if step_key and step_key in seen_steps:\n5074|                    continue\n5075|                if step_key:\n5076|                    seen_steps.add(step_key)\n5077|                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n5078|                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n5079|                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n5080|                        payload.get(key)\n5081|                    )\n5082|                # Завершить native вызовы без called: аргументы из input.ended.text.\n5083|                for