                )\n8483|                                    )\n8484|                                    * 1000\n8485|                                )\n8486|                        _token_text = str(\n8487|                            payload.get(\"reasoning_content\")\n8488|                            or payload.get(\"content\")\n8489|                            or \"\"\n8490|                        )\n8491|                        if _token_text.strip():\n8492|                            if watchdog_state[\"first_token_at\"] is None:\n8493|                                watchdog_state[\"first_token_at\"] = time.monotonic()\n8494|                                if \"ttft_ms\" not in xs or xs.get(\"ttft_ms\") is None:\n8495|                                    xs[\"ttft_ms\"] = int(\n8496|                                        (\n8497|                                            time.monotonic()\n8498|                                            - (\n8499|                                                _attempts_t0(attempts, model, prompt)\n8500|                                            )\n8501|                                        )\n8502|                                        * 1000\n8503|                                    )\n8504|                            watchdog_state[\"last_token_at\"] = time.monotonic()\n8505|                            if etype == \"reasoning\":\n8506|                                watchdog_state[\"last_reasoning\"] = _token_text\n8507|                    if etype == \"reasoning\":\n8508|                        rtext = payload.get(\"reasoning_content\")\n8509|                        if isinstance(rtext, str):\n8510|                            if rtext:\n8511|                                payload[\"reasoning_content\"] = rtext\n8512|                            else:\n8513|                                del payload[\"reasoning_content\"]\n8514|                        if payload:\n8515|                            attempt_output = True\