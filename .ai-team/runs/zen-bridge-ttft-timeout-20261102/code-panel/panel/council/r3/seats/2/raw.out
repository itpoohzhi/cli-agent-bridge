r current_step_msg_id\n5047|                                or None,\n5048|                                min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\n5049|                                tool_state,\n5050|                                result,\n5051|                                on_tool,\n5052|                                _release_event,\n5053|                                attempt_deadline=deadline,\n5054|                                is_client_gone=is_client_gone,\n5055|                                pending_calls=pending_step_calls,\n5056|                                ctrl_http=_drain_ctrl,\n5057|                                reasoning_cb=on_reasoning,\n5058|                                text_cb=on_text,\n5059|                                emulate_tools=emulate_tools,\n5060|                                accumulated_bytes=_acc_box,\n5061|                                t0=t0,\n5062|                                replied_permissions=replied_permissions,\n5063|                                cascade_reject_state=cascade_reject_state,\n5064|                            )\n5065|                            accumulated_bytes = _acc_box[0]\n5066|                            break\n5067|            elif etype == \"step_finish\":\n5068|                step_key = str(\n5069|                    _as_dict(payload).get(\"assistantMessageID\")\n5070|                    or data_raw.get(\"assistantMessageID\")\n5071|                    or \"\"\n5072|                )\n5073|                if step_key and step_key in seen_steps:\n5074|                    continue\n5075|                if step_key:\n5076|                    seen_steps.add(step_key)\n5077|                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n5078|                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n5079|                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n5080|                        payload.get(key)\n5081|                    )\n5082|                # Завершить native вызовы без called: аргументы из input.ended.text.\n5083|                for call_id in list(tool_state.tools):\n5084|                    done = tool_state.complete(call_id, etype_raw)\n5085|                    if done is not None:\n5086|                        last_token_at = time.monotonic()\n5087|                        pending_step_calls.append(done[1])\n5088|                # step_finish — это session.step.ended: pending публикуется один раз.\n5089|                for pending_call in pending_step_calls:\n5090|                    result[\"native_calls\"].append(pending_call)\n5091|                    on_tool(pending_call)\n5092|                pending_step_calls.clear()\n5093|                if result[\"native_calls\"] or (\n5094|                    emulate_tools and _split_tool_calls([\"\".join(result[\"texts\"])])[1]\n5095|                ):\n5096|                    if result[\"first_token_at\"] is None and result[\"native_calls\"]:\n5097|                        result[\"first_token_at\"] = time.monotonic()\n5098|                        result[\"ttft_ms\"] = int(\n5099|                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n5100|                        )\n5101|                    result[\"terminal\"] = \"tool_calls\"\n5102|                    break\n5103|            elif etype == \"error\":\n5104|                result[\"error\"] = payload\n(more lines below)","final_result":true}}}
