\n  6740\t                if self.proc is not None:\n  6741\t                    _stop_proc(self.proc)\n  6742\t                return\n  6743\t            reason = \"\"\n  6744\t            if first_event_at is None and now - attempt_start > float(\n  6745\t                FIRST_EVENT_TIMEOUT_S\n  6746\t            ):\n  6747\t                reason = \"first_event_timeout\"\n  6748\t            elif first_token_at is None and now - attempt_start > float(\n  6749\t                FIRST_TOKEN_TIMEOUT_S\n  6750\t            ):\n  6751\t                reason = \"first_token_timeout\"\n  6752\t            elif (\n  6753\t                last_token_at is not None\n  6754\t                and not subagent_started_at\n  6755\t                and now - last_token_at > float(STALL_TIMEOUT_S)\n  6756\t            ):\n  6757\t                reason = \"stall_timeout\"\n  6758\t            if reason:\n  6759\t                watchdog_reason.append(reason)\n  6760\t                state = reason\n  6761\t                _log(f\"opencode run watchdog: {reason}\")\n  6762\t                if self.proc is not None:\n  6763\t                    _stop_proc(self.proc)\n  6764\t\n  6765\t        try:\n  6766\t            self.feed = _StdoutFeed(self.proc)\n  6767\t            for raw in self.feed.lines(\n  6768\t                deadline, idle_s=_STDOUT_POLL_S, on_idle=on_idle\n  6769\t            ):\n  6770\t                gate.release()\n  6771\t                raw = raw.strip()\n  6772\t                if not raw:\n  6773\t                    continue\n  6774\t                try:\n  6775\t                    event = json.loads(raw)\n  6776\t                except ValueError:\n  6777\t                    _log(f\"non-json stdout line: {_clean_err(raw)[:100]}\")\n  6778\t                    err_lines.append(raw[:200])\n  6779\t                    continue\n  6780\t\n  6781\t                etype, payload = parse_opencode_event(event)\n  6782\t                if isinstance(event, dict):\n  6783\t                    now_ev = time.monotonic()\n  6784\t                    if first_event_at is None:\n  6785\t                        first_event_at = now_ev\n  6786\t                    frame = _as_dict(cast(object, payload))\n  6787\t                    token = (\n  6788\t                        frame.get(\"content\")\n  6789\t                        if etype == \"text\"\n  6790\t                        else frame.get(\"reasoning_content\")\n  6791\t                    )\n  6792\t                    if (\n  6793\t                        etype in (\"text\", \"reasoning\")\n  6794\t                        and isinstance(token, str)\n  6795\t                        and token\n  6796\t                    ) or etype in (\"tool_use\", \"tool_call\"):\n  6797\t                        if first_token_at is None:\n  6798\t                            first_token_at = now_ev\n  6799\t                        last_token_at = now_ev\n  6800\t                    part = _as_dict(_as_dict(cast(object, event)).get(\"part\"))\n  6801\t                    if (\n  6802\t                        etype in (\"tool_use\", \"tool_call\")\n  6803\t                        and part.get(\"tool\") == \"task\"\n  6804\t                    ):\n  6805\t                        task_id = str(part.get(\"id\") or \"task\")\n  6806\t                        task_status = _as_dict(part.get(\"state\")).get(\"status\")\n  6807\t                        if task_status in (\"pending\", \"running\"):\n  6808\t                            subagent_started_at[task_id] = now_ev\n  8320\t                    if incomplete_retry and prior_text\n  8321\t                    else None\n  8322\t                )\n  8323\t\n  8324\t                attempt_start = time.monotonic()\n  8325\t                first_status_due = (\n  8326\t                    _attempts_t0(attempts, model, prompt)\n  8327\t                    + FIRST_STATUS_DELAY_S\n  8328\t                )\n  8329\t                watchdog_state: _WatchdogState = {\n  8330\t                    \"reason\": \"\",\n  8331\t                    \"first_event_at\": None,\n  8332\t                    \"first_token_at\": None,\n  8333\t                    \"last_token_at\": attempt_start,\n  8334\t                    \"status_next\": (\n  8335\t                        first_status_due\n  8336\t                        if attempts.total_spawns <= 1 and not status_fired_at[0]\n  8337\t                        else attempt_start + FIRST_STATUS_DELAY_S\n  8338\t                    ),\n  8339\t                    \"last_keepalive\": attempt_start,\n  8340\t                    \"last_reasoning\": \"\",\n  8341\t                }\n  8342\t                thinking_enabled = effort.strip().lower() not in (\"\", \"off\", \"none\")\n  8343\t                request_t0 = _attempts_t0(attempts, model, prompt)\n  8344\t                ttft_timeout = _zen_ttft_timeout(model, prompt)\n  8345\t                idle_timeout = _zen_idle_timeout(model, prompt)\n  8346\t                split_timeout = [False]\n  8347\t\n  8348\t                def emit_synthetic(text: str) -> None:\n  8349\t                    \"\"\"Синтетический статус отдельной reasoning-дельтой.\"\"\"\n  8350\t                    tail = str(watchdog_state.get(\"last_reasoning\") or \"\")\n  8351\t                    prefix = \"\\n\" if tail and not tail.endswith(\"\\n\") else \"\"\n  8352\t                    chunk_s = format_sse_chunk(\n  8353\t                        resp_id,\n  8354\t                        created,\n  8355\t                        shown_model,\n  8356\t                        {\"reasoning_content\": prefix + text},\n  8357\t                    )\n  8358\t                    first_visible.set()\n  8359\t                    _ = self.wfile.write(chunk_s.encode(\"utf-8\"))\n  8360\t                    self.wfile.flush()\n  8361\t\n  8362\t                def send_keepalive(proc: subprocess.Popen[str] = proc) -> None:\n  8363\t                    \"\"\"Надзор: статусы, watchdog и обнаружение ухода клиента.\"\"\"\n  8364\t                    now_s = time.monotonic()\n  8365\t                    if self._client_gone_check():\n  8366\t                        _log(\"stream client gone, killing proc group\")\n  8367\t                        _stop_proc(proc)\n  8368\t                        raise BrokenPipeError(\"client gone\")\n  8369\t                    # Раздельные таймауты: TTFT до первого токена запроса, Idle между чанками после него.\n  8370\t                    # Остановка процесса приводит к EOF в feed, а split_timeout даёт тот же исход, что и дедлайн (504).\n  8371\t                    if (\n  8372\t                        watchdog_state[\"first_token_at\"] is None\n  8373\t                        and now_s\n  8374\t                        - (\n  8375\t                            attempt_start\n  8376\t                            if collected_texts or tool_calls\n  8377\t                            else request_t0\n  8378\t                        )\n  8379\t                        > ttft_timeout\n  8380\t                    ) or (\n  8381\t                        watchdog_state[\"first_token_at\"] is not None\n  8382\t                        and now_s - float(watchdog_state[\"last_token_at\"])\n  8383\t                        > idle_timeout\n  8384\t                    ):\n  8385\t                        split_timeout[0] = True\n  8386\t                        _stop_proc(proc)\n  8387\t                        return\n  8388\t                    if watchdog_state[\n  8389\t                        \"first_event_at\"\n  8390\t                    ] is None and now_s - attempt_start > float(FIRST_EVENT_TIMEOUT_S):\n  8391\t                        watchdog_state[\"reason\"] = \"first_event_timeout\"\n  8392\t                        _stop_proc(proc)\n  8393\t                        return\n  8394\t                    if (\n  8395\t                        watchdog_state[\"first_event_at\"] is not None\n  8396\t                        and watchdog_state[\"first_token_at\"] is None\n  8397\t                        and now_s - attempt_start > float(FIRST_TOKEN_TIMEOUT_S)\n  8398\t                    ):\n  8399\t                        watchdog_state[\"reason\"] = \"first_token_timeout\"\n  8400\t                        _stop_proc(proc)\n  8401\t                        return\n  8402\t                    if watchdog_state[\"first_token_at\"] is not None and now_s - float(\n  8403\t                        watchdog_state[\"last_token_at\"]\n  8404\t                    ) > float(STALL_TIMEOUT_S):\n  8405\t                        watchdog_state[\"reason\"] = \"stall_timeout\"\n  8406\t                        _stop_proc(proc)\n  8407\t                        return\n  8408\t                    try:\n  8409\t                        if thinking_enabled and now_s >= float(\n  8410\t                            watchdog_state[\"status_next\"]\n  8460\t                    raw = raw.strip()\n  8461\t                    if not raw:\n  8462\t                        continue\n  8463\t                    try:\n  8464\t                        event = json.loads(raw)\n  8465\t                    except ValueError:\n  8466\t                        _log(f\"non-json stdout line: {raw[:100]}\")\n  8467\t                        continue\n  8468\t\n  8469\t                    etype, payload = parse_opencode_event(event)\n  8470\t                    if etype:\n  8471\t                        if watchdog_state[\"first_event_at\"] is None:\n  8472\t                            watchdog_state[\"first_event_at\"] = time.monotonic()\n  8473\t                            if (\n  8474\t                                \"first_event_ms\" not in xs\n  8475\t                                or xs.get(\"first_event_ms\") is None\n  8476\t                            ):\n  8477\t                                xs[\"first_event_ms\"] = int(\n  8478\t                                    (\n  8479\t                                        time.monotonic()\n  8480\t                                        - (\n  8481\t                                            _attempts_t0(attempts, model, prompt)\n  8482\t                                        )\n  8483\t                                    )\n  8484\t                                    * 1000\n  8485\t                                )\n  8486\t                        _token_text = str(\n  8487\t                            payload.get(\"reasoning_content\")\n  8488\t                            or payload.get(\"content\")\n  8489\t                            or \"\"\n  8490\t                        )\n  8491\t                        if _token_text.strip():\n  8492\t                            if watchdog_state[\"first_token_at\"] is None:\n  8493\t                                watchdog_state[\"first_token_at\"] = time.monotonic()\n  8494\t                                if \"ttft_ms\" not in xs or xs.get(\"ttft_ms\") is None:\n  8495\t                                    xs[\"ttft_ms\"] = int(\n  8496\t                                        (\n  8497\t                                            time.monotonic()\n  8498\t                                            - (\n  8499\t                                                _attempts_t0(attempts, model, prompt)\n  8500\t                                            )\n  8501\t                                        )\n  8502\t                                        * 1000\n  8503\t                                    )\n  8504\t                            watchdog_state[\"last_token_at\"] = time.monotonic()\n  8505\t                            if etype == \"reasoning\":\n  8506\t                                watchdog_state[\"last_reasoning\"] = _token_text\n  8507\t                    if etype == \"reasoning\":\n  8508\t                        rtext = payload.get(\"reasoning_content\")\n  8509\t                        if isinstance(rtext, str):\n  8510\t                            if rtext:\n  8511\t                                payload[\"reasoning_content\"] = rtext\n  8512\t                            else:\n  8513\t                                del payload[\"reasoning_content\"]\n  8514\t                        if payload:\n  8515\t                            attempt_output = True\n  8516\t                            if isinstance(rtext, str) and rtext:\n  8517\t                                xs[\"reason_chars\"] = int(\n  8518\t                                    xs.get(\"reason_chars\") or 0\n  8519\t                                ) + len(rtext)\n  8520\t                                attempt_reasonings.append(rtext)\n# RECHECK после R1\n\n- F-001 [BLOCKER-OPINION] origin=seat_1\n- F-002 [BLOCKER-OPINION] origin=seat_1\n- F-003 [BLOCKER-OPINION] origin=seat_1\n- F-004 [NON_BLOCKING] origin=seat_1\n- F-005 [NON_BLOCKING] origin=seat_1\n- F-006 [NON_BLOCKING] origin=seat_1\n- F-007 [NON_BLOCKING] origin=seat_1\n     1\t# Teamlead Council Code Review Package — `zen-bridge-ttft-timeout-20261102`\n     2\t\n     3\t## 1. Метаданные и контекст\n     4\t- **Задача:** Пресет `analyst-teamlead`, замена жесткого монолитного таймаута 25с в `bridges/opencode-zen-bridge/server.py` на раздельные таймауты: `ttft_timeout = 25s` (до первого токена) и `idle_timeout = 15s` (между чанками стрима), с предоставлением полного дедлайна `total_timeout = 180s` активному стриму для ликвидации 13.5% ложных отказов.\n     5\t- **Инварианты владельца:**\n     6\t  - Полная конфигурируемость параметров без хардкода через переменные окружения: `BRIDGE_ZEN_TTFT_TIMEOUT_S`, `BRIDGE_ZEN_IDLE_TIMEOUT_S`, `BRIDGE_ZEN_TOTAL_TIMEOUT_S` с безопасными fallback-значениями (`BRIDGE_ZEN_TIMEOUT_S`).\n     7\t  - Изменения производятся исключительно в нашем коде `cli-agent-bridge` без модификации вендорских пакетов.\n     8\t  - Сохранение 100% обратной совместимости API: честный возврат HTTP 504 Gateway Timeout / terminal SSE error при превышении TTFT или Idle дедлайнов.\n     9\t- **Архитектурный пакет:** `.ai-team/runs/zen-bridge-ttft-timeout-20261102/architecture/architecture-packet.json` (status: `APPROVED`, `ARCH_GATE_PASS` получен: `sha256=e5290e3ab9d3e9da69dd6620e18a9cb1f9baa1b7725c24499b0b06041ae298f1`).\n    10\t- **Исполнитель Coder:** Сабагент роли `Coder` (`claude-sonnet-5-5-high` через `claude -p`).\n    11\t\n    12\t---\n    13\t\n    14\t## 2. Закрытие архитектурных требований\n    15\t\n    16\t### REQ-001: Раздельный таймаут первого токена (TTFT 25s)\n    17\t- **Реализация:** Функция `_zen_ttft_timeout(model, prompt)` возвращает `min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_TTFT_TIMEOUT_S\", _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0)))` для целевых моделей (`deepseek-v4.1-flash-free` и моделей из `BRIDGE_ZEN_TIMEOUT_MODELS` при длине UTF-8 промпта > `BRIDGE_ZEN_LARGE_PROMPT_BYTES`, default 8192). Для остальных — `TIMEOUT_S`.\n    18\t- В цикле `_serve_one_attempt` и потоковом `watchdog`: если `result[\"first_token_at\"] is None` и прошло `>= ttft_timeout`, запрос прерывается с `exit_reason = \"timeout\"`, возвращая клиенту честный HTTP 504 Gateway Timeout.\n    19\t\n    20\t### REQ-002: Раздельный таймаут неактивности стрима (Idle 15s)\n    21\t- **Реализация:** Функция `_zen_idle_timeout(model, prompt)` возвращает `min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_IDLE_TIMEOUT_S\", 15.0))` для целевых моделей.\n    22\t- При поступлении каждого токена (reasoning, content, tool events) фиксируется `last_token_at = time.monotonic()`.\n    23\t- В цикле `_serve_one_attempt`: если `result[\"first_token_at\"] is not None` и пауза `now - last_token_at >= idle_timeout`, запрос прерывается с `exit_reason = \"timeout\"` (504).\n    24\t- В потоковом watchdog-режиме: при тишине дольше `idle_timeout` флаг `split_timeout[0] = True` останавливает дочерний процесс и завершает генерацию с 504.\n    25\t\n    26\t### REQ-003: Снятие искусственного монолитного дедлайна 25s (Total 180s)\n    27\t- **Реализация:** Функция `_zen_total_timeout(model, prompt)` возвращает общий дедлайн генерации `min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\", min(180.0, TIMEOUT_S)))`.\n    28\t- При создании `_RequestAttempts` дедлайн устанавливается как `time.monotonic() + _zen_total_timeout(...)`, что позволяет активному непрерывному стримингу успешно завершаться без обрыва на 25-й секунде.\n    29\t- В `_RequestAttempts` добавлено поле `self.t0 = time.monotonic()` и функция-хелпер `_attempts_t0(attempts, model, prompt)` для корректного вычисления времени старта и интервалов статусов без вычитания старого 25с дедлайна.\n    30\t\n    31\t### Обратная совместимость\n    32\t- Функция `_zen_execution_timeout(model, prompt)` сохранена как синоним `_zen_ttft_timeout(model, prompt)`.\n    33\t- Тест `test_zen_byte_timeout_selection` проходит 100% зелёным без изменений.\n    34\t\n    35\t---\n    36\t\n    37\t## 3. Изменённые файлы и статистика\n    38\t```\n    39\t bridges/opencode-zen-bridge/server.py    | 129 ++++++++++++++++++++++-----\n    40\t tests/test_bridges_speedup_resilience.py | 146 ++++++++++++++++++++++++++++++-\n    41\t 2 files changed, 253 insertions(+), 22 deletions(-)\n    42\t```\n    43\t\n    44\t---\n    45\t\n    46\t## 4. Матрица верификации (L1/L2 Execution Gate)\n    47\t\n    48\t| Сьют | Тестов | Результат | Время | Описание |\n    49\t|---|---|---|---|---|\n    50\t| `tests/test_bridges_speedup_resilience.py` | 38 | **38 PASSED (100%)** | 4.08s | Проверка TTFT, Idle, Total, byte-selection, стриминга сквозь 0.3s и отсечки зависшего стрима |\n    51\t| `tests/test_request_attribution.py` | 43 | **43 PASSED (100%)** | 2.11s | Корректность атрибуции запросов, сквозных request_id и хедеров |\n    52\t| `tests/test_bridge_strict.py` | 41 | **41 PASSED (100%)** | 11.91s | Строгий контракт каталога, health-эндпоинтов, журналов и бюджетов admission |\n    53\t\n    54\t**Итого:** 122 теста, 0 ошибок, 100% успешных прогонов.\n    55\t\n    56\t---\n    57\t\n    58\t## 5. Полный Git Diff\n    59\t\n    60\t```diff\n    61\tdiff --git a/bridges/opencode-zen-bridge/server.py b/bridges/opencode-zen-bridge/server.py\n    62\tindex fd1d4c9..ce4fbbf 100755\n    63\t--- a/bridges/opencode-zen-bridge/server.py\n    64\t+++ b/bridges/opencode-zen-bridge/server.py\n    65\t@@ -344,8 +344,8 @@ def _zen_positive_float(name: str, default: float) -> float:\n    66\t         return default\n    67\t \n    68\t \n    69\t-def _zen_execution_timeout(model: str, prompt: str) -> float:\n    70\t-    \"\"\"Сужение execution deadline только для явно выбранных моделей и большого UTF-8 входа.\"\"\"\n    71\t+def _zen_ttft_timeout(model: str, prompt: str) -> float:\n    72\t+    \"\"\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\"\"\"\n    73\t     models = {\n    74\t         \"deepseek-v4.1-flash-free\",\n    75\t         *filter(\n    76\t@@ -354,10 +354,45 @@ def _zen_execution_timeout(model: str, prompt: str) -> float:\n    77\t     }\n    78\t     threshold = _positive_int(os.environ.get(\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\"), 8192)\n    79\t     if model in models and len(prompt.encode(\"utf-8\")) > threshold:\n    80\t-        return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0))\n    81\t+        return min(\n    82\t+            TIMEOUT_S,\n    83\t+            _zen_positive_float(\n    84\t+                \"BRIDGE_ZEN_TTFT_TIMEOUT_S\",\n    85\t+                _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0),\n    86\t+            ),\n    87\t+        )\n    88\t     return TIMEOUT_S\n    89\t \n    90\t \n    91\t+def _zen_idle_timeout(model: str = \"\", prompt: str = \"\") -> float:\n    92\t+    \"\"\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\"\"\"\n    93\t+    if _zen_ttft_timeout(model, prompt) >= TIMEOUT_S:\n    94\t+        return TIMEOUT_S\n    95\t+    return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_IDLE_TIMEOUT_S\", 15.0))\n    96\t+\n    97\t+\n    98\t+def _zen_total_timeout(model: str = \"\", prompt: str = \"\") -> float:\n    99\t+    \"\"\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\"\"\"\n   100\t+    if _zen_ttft_timeout(model, prompt) >= TIMEOUT_S:\n   101\t+        return TIMEOUT_S\n   102\t+    return min(\n   103\t+        TIMEOUT_S,\n   104\t+        _zen_positive_float(\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\", min(180.0, TIMEOUT_S)),\n   105\t+    )\n   106\t+\n   107\t+\n   108\t+def _zen_execution_timeout(model: str, prompt: str) -> float:\n   109\t+    \"\"\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\"\"\"\n   110\t+    return _zen_ttft_timeout(model, prompt)\n   111\t+\n   112\t+\n   113\t+def _attempts_t0(attempts: Any, model: str, prompt: str) -> float:\n   114\t+    \"\"\"Момент старта запроса: attempts.t0, а для совместимых заглушек — выводим из deadline.\"\"\"\n   115\t+    return getattr(\n   116\t+        attempts, \"t0\", attempts.deadline - _zen_total_timeout(model, prompt)\n   117\t+    )\n   118\t+\n   119\t+\n   120\t def _zen_error(status: int) -> dict[str, Any]:\n   121\t     \"\"\"Согласованный контракт ошибок zen, одинаковый для JSON и terminal SSE.\"\"\"\n   122\t     message, kind = (\n   123\t@@ -2946,6 +2981,7 @@ class _RequestAttempts:\n   124\t         max_quota_rotations: int | None = None,\n   125\t     ) -> None:\n   126\t         self.res = res\n   127\t+        self.t0 = time.monotonic()\n   128\t         self.deadline = deadline\n   129\t         self.use_breaker = (\n   130\t             use_breaker  # False: прямой Google-маршрут без `opencode run`\n   131\t@@ -4775,6 +4811,8 @@ def _serve_one_attempt(\n   132\t         status_next = max(t0 + FIRST_STATUS_DELAY_S, prompt_send_start + 0.25)\n   133\t         _status_emitted = [0]\n   134\t         last_token_at = prompt_send_start\n   135\t+        ttft_timeout = _zen_ttft_timeout(model, prompt)\n   136\t+        idle_timeout = _zen_idle_timeout(model, prompt)\n   137\t         while time.monotonic() < deadline:\n   138\t             if is_client_gone is not None and is_client_gone():\n   139\t                 result[\"exit_reason\"] = \"client_gone\"\n   140\t@@ -4783,6 +4821,17 @@ def _serve_one_attempt(\n   141\t                 result[\"exit_reason\"] = \"invalid_serve_event\"\n   142\t                 return result\n   143\t             now = time.monotonic()\n   144\t+            # Раздельные таймауты: TTFT до первого токена, Idle между чанками после него.\n   145\t+            if (\n   146\t+                result[\"first_token_at\"] is None\n   147\t+                and now - prompt_send_start >= ttft_timeout\n   148\t+            ) or (\n   149\t+                result[\"first_token_at\"] is not None\n   150\t+                and now - last_token_at >= idle_timeout\n   151\t+            ):\n   152\t+                result[\"exit_reason\"] = \"timeout\"\n   153\t+                result[\"delivered\"] = _is_delivered()\n   154\t+                break\n   155\t             if prompt_status.get(\"aux_exhausted\") or (\n   156\t                 result[\"first_event_at\"] is None and now >= first_event_deadline\n   157\t             ):\n   158\t@@ -7021,7 +7070,7 @@ class Handler(BaseHTTPRequestHandler):\n   159\t \n   160\t     def _set_zen_policy(self, model: str, prompt: str) -> None:\n   161\t         self._zen_prompt = prompt\n   162\t-        self._zen_targeted = _zen_execution_timeout(model, prompt) < TIMEOUT_S\n   163\t+        self._zen_targeted = _zen_ttft_timeout(model, prompt) < TIMEOUT_S\n   164\t         self._zen_short_bypass = (\n   165\t             self._zen_probe\n   166\t             or getattr(self, \"headers\", {}).get(\"X-Bypass-Short-Filter\") == \"1\"\n   167\t@@ -7377,7 +7426,7 @@ class Handler(BaseHTTPRequestHandler):\n   168\t                     _orig_reasoning,\n   169\t                     _text_seen,\n   170\t                     on_tool,\n   171\t-                    attempts.deadline - _zen_execution_timeout(model, prompt),\n   172\t+                    _attempts_t0(attempts, model, prompt),\n   173\t                     is_client_gone=self._client_gone_check,\n   174\t                     on_status=attempt_status,\n   175\t                     thinking_enabled=thinking,\n   176\t@@ -7887,7 +7936,7 @@ class Handler(BaseHTTPRequestHandler):\n   177\t         if not self._acquire_slot(res):\n   178\t             return\n   179\t         attempts = _RequestAttempts(\n   180\t-            res, time.monotonic() + _zen_execution_timeout(model, prompt)\n   181\t+            res, time.monotonic() + _zen_total_timeout(model, prompt)\n   182\t         )\n   183\t         xs[\"attempts\"] = attempts\n   184\t \n   185\t@@ -7994,8 +8043,7 @@ class Handler(BaseHTTPRequestHandler):\n   186\t                 status_timer = threading.Timer(\n   187\t                     max(\n   188\t                         0.0,\n   189\t-                        attempts.deadline\n   190\t-                        - _zen_execution_timeout(model, prompt)\n   191\t+                        _attempts_t0(attempts, model, prompt)\n   192\t                         + FIRST_STATUS_DELAY_S\n   193\t                         - time.monotonic(),\n   194\t                     ),\n   195\t@@ -8248,8 +8296,7 @@ class Handler(BaseHTTPRequestHandler):\n   196\t                 attempt_start = time.monotonic()\n   197\t                 first_status_due = (\n   198\t-                    attempts.deadline\n   199\t-                    - _zen_execution_timeout(model, prompt)\n   200\t+                    _attempts_t0(attempts, model, prompt)\n   201\t                     + FIRST_STATUS_DELAY_S\n   202\t                 )\n   203\t                 watchdog_state: _WatchdogState = {\n   204\t@@ -8274,6 +8321,10 @@ class Handler(BaseHTTPRequestHandler):\n   205\t                     \"last_reasoning\": \"\",\n   206\t                 }\n   207\t                 thinking_enabled = effort.strip().lower() not in (\"\", \"off\", \"none\")\n   208\t+                request_t0 = _attempts_t0(attempts, model, prompt)\n   209\t+                ttft_timeout = _zen_ttft_timeout(model, prompt)\n   210\t+                idle_timeout = _zen_idle_timeout(model, prompt)\n   211\t+                split_timeout = [False]\n   212\t \n   213\t                 def emit_synthetic(text: str) -> None:\n   214\t                     \"\"\"Синтетический статус отдельной reasoning-дельтой.\"\"\"\n   215\t@@ -8296,6 +8347,25 @@ class Handler(BaseHTTPRequestHandler):\n   216\t                         _log(\"stream client gone, killing proc group\")\n   217\t                         _stop_proc(proc)\n   218\t                         raise BrokenPipeError(\"client gone\")\n   219\t+                    # Раздельные таймауты: TTFT до первого токена запроса, Idle между чанками после него.\n   220\t+                    if (\n   221\t+                        watchdog_state[\"first_token_at\"] is None\n   222\t+                        and now_s\n   223\t+                        - (\n   224\t+                            attempt_start\n   225\t+                            if collected_texts or tool_calls\n   226\t+                            else request_t0\n   227\t+                        )\n   228\t+                        > ttft_timeout\n   229\t+                    ) or (\n   230\t+                        watchdog_state[\"first_token_at\"] is not None\n   231\t+                        and now_s - float(watchdog_state[\"last_token_at\"])\n   232\t+                        > idle_timeout\n   233\t+                    ):\n   234\t+                        split_timeout[0] = True\n   235\t+                        _stop_proc(proc)\n   236\t+                        return\n   237\t                     if watchdog_state[\n   238\t                         \"first_event_at\"\n   239\t                     ] is None and now_s - attempt_start > float(FIRST_EVENT_TIMEOUT_S):\n   240\t@@ -8526,7 +8596,7 @@ class Handler(BaseHTTPRequestHandler):\n   241\t                     had_provider_error = True\n   242\t                     stopped_on_error = True\n   243\t                     err_lines.append(\"stdout queue overflow\")\n   244\t-                timed_out = feed.timed_out\n   245\t+                timed_out = feed.timed_out or split_timeout[0]\n   246\t                 if timed_out:\n   247\t                     _log(f\"stream timeout after {TIMEOUT_S:.0f}s, killing proc group\")\n   248\t                     _stop_proc(proc)\n   249\t@@ -8972,7 +9042,7 @@ class Handler(BaseHTTPRequestHandler):\n   250\t                     reasonings.append,\n   251\t                     texts.append,\n   252\t                     natives.append,\n   253\t-                    attempts.deadline - _zen_execution_timeout(model, prompt),\n   254\t+                    _attempts_t0(attempts, model, prompt),\n   255\t                     is_client_gone=self._client_gone_check,\n   256\t                     on_status=lambda _t: None,\n   257\t                     thinking_enabled=thinking,\n   258\t@@ -9284,7 +9354,7 @@ class Handler(BaseHTTPRequestHandler):\n   259\t             return\n   260\t         attempts = _RequestAttempts(\n   261\t             res,\n   262\t-            time.monotonic() + _zen_execution_timeout(model, prompt),\n   263\t+            time.monotonic() + _zen_total_timeout(model, prompt),\n   264\t             use_breaker=not _is_google_direct_model(model),\n   265\t         )\n   266\t         xs[\"attempts\"] = attempts\n   267\t```\n","exit_code":0,"status":"completed"}}
