{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b5","stream":{"kind":"session","id":"01a19b3c-c7a4-77f3-be37-70213f9a9248"},"sequence":53,"recorded_at":1780531400000101,"record_type":"event","durability":"durable","causation_id":"01a19b3c-d010-7283-81d6-72f067b54f03","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19b3c-d010-7283-81d6-72f067b54f03","run_stream":{"kind":"run","id":"01a19b3c-d010-7283-81d6-72f067b54f03"},"task_stream":{"kind":"task","id":"01a19b3d-d125-70c2-bade-0bba2902eb3e"},"task_id":"01a19b3d-d125-70c2-bade-0bba2902eb3e","event":{"kind":"output","task_id":"01a19b3d-d125-70c2-bade-0bba2902eb3e","chunk":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"grep -n \\\"TIMEOUT_S\\\\s*=\\\" /Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py | head -20; echo ===; sed -n '340,400p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py\",\n  \"description\": \"Inspect timeout helpers and TIMEOUTS\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"335:TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\\\", \\\"1800\\\"))\\n810:SLOT_WAIT_TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_SLOT_WAIT_S\\\", \\\"15.0\\\"))\\n1897:FIRST_EVENT_TIMEOUT_S = float(\\n1900:FIRST_TOKEN_TIMEOUT_S = float(\\n1903:STALL_TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\\\", \\\"60.0\\\"))\\n1951:_DOWNSTREAM_WRITE_TIMEOUT_S = 5.0\\n===\\n    try:\\n        value = float(os.environ.get(name, str(default)))\\n        return value if 0 < value < float(\\\"inf\\\") else default\\n    except ValueError:\\n        return default\\n\\n\\ndef _zen_ttft_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\\\"\\\"\\\"\\n    models = {\\n        \\\"deepseek-v4.1-flash-free\\\",\\n        *filter(\\n            None, re.split(r\\\"[,\\\\s]+\\\", os.environ.get(\\\"BRIDGE_ZEN_TIMEOUT_MODELS\\\", \\\"\\\"))\\n        ),\\n    }\\n    threshold = _positive_int(os.environ.get(\\\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\\\"), 8192)\\n    if model in models and len(prompt.encode(\\\"utf-8\\\")) > threshold:\\n        return min(\\n            TIMEOUT_S,\\n            _zen_positive_float(\\n                \\\"BRIDGE_ZEN_TTFT_TIMEOUT_S\\\",\\n                _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0),\\n            ),\\n        )\\n    return TIMEOUT_S\\n\\n\\ndef _zen_idle_timeout(model: str = \\\"\\\", prompt: str = \\\"\\\") -> float:\\n    \\\"\\\"\\\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\\\"\\\"\\\"\\n    if _zen_ttft_timeout(model, prompt) >= TIMEOUT_S:\\n        return TIMEOUT_S\\n    return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_IDLE_TIMEOUT_S\\\", 15.0))\\n\\n\\ndef _zen_total_timeout(model: str = \\\"\\\", prompt: str = \\\"\\\") -> float:\\n    \\\"\\\"\\\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\\\"\\\"\\\"\\n    if _zen_ttft_timeout(model, prompt) >= TIMEOUT_S:\\n        return TIMEOUT_S\\n    return min(\\n        TIMEOUT_S,\\n        _zen_positive_float(\\\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\\\", min(180.0, TIMEOUT_S)),\\n    )\\n\\n\\ndef _zen_execution_timeout(model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\\\"\\\"\\\"\\n    return _zen_ttft_timeout(model, prompt)\\n\\n\\ndef _attempts_t0(attempts: Any, model: str, prompt: str) -> float:\\n    \\\"\\\"\\\"Момент старта запроса: attempts.t0, а для совместимых заглушек — выводим из deadline.\\\"\\\"\\\"\\n    return getattr(\\n        attempts, \\\"t0\\\", attempts.deadline - _zen_total_timeout(model, prompt)\\n    )\\n\\n\\ndef _zen_error(status: int) -> dict[str, Any]:\\n    \\\"\\\"\\\"Согласованный контракт ошибок zen, одинаковый для JSON и terminal SSE.\\\"\\\"\\\"\\n    message, kind = (\\n        (\\\"Gateway Timeout in zen-bridge\\\", \\\"timeout_error\\\")\\n        if status == 504\\n\",\n  \"original_output_bytes\": 2997,\n  \"original_output_tokens\": 750,\n  \"truncated\": false\n}","final_result":true}}}
