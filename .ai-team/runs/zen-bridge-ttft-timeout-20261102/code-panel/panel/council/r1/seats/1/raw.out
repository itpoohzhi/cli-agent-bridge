{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4af","stream":{"kind":"session","id":"01a19b3c-c7a4-77f3-be37-70213f9a9248"},"sequence":178,"recorded_at":1780531400000351,"record_type":"event","durability":"durable","causation_id":"01a19b3c-d010-7283-81d6-72f067b54f03","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19b3c-d010-7283-81d6-72f067b54f03","run_stream":{"kind":"run","id":"01a19b3c-d010-7283-81d6-72f067b54f03"},"task_stream":{"kind":"task","id":"01a19b40-9ade-7d92-8d2a-ced716015786"},"task_id":"01a19b40-9ade-7d92-8d2a-ced716015786","event":{"kind":"output","task_id":"01a19b40-9ade-7d92-8d2a-ced716015786","chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"R=/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py; sed -n '4990,5095p' $R; echo ===; grep -n 'watchdog_state\\\\[\\\"last_token_at\\\"\\\\]\\\\|watchdog_state: _WatchdogState' $R | head; sed -n '8315,8342p' $R; echo ===TESTS===; git -C /Users/aazhiry1/work/src/cli-agent-bridge diff -- tests/test_bridges_speedup_resilience.py | grep -n \\\"def test\\\\|ttft\\\\|idle\\\\|total\\\" | head -40\",\n  \"description\": \"Inspect token updates and watchdog state\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"                continue\\n            if result[\\\"step_closed\\\"] and etype in (\\\"reasoning\\\", \\\"text\\\"):\\n                continue\\n            accumulated_bytes = _serve_accumulated_bytes(\\n                accumulated_bytes, etype, payload, tool_state\\n            )\\n            if etype == \\\"reasoning\\\":\\n                text_value = str(payload.get(\\\"reasoning_content\\\") or \\\"\\\")\\n                if text_value:\\n                    if result[\\\"first_token_at\\\"] is None:\\n                        result[\\\"first_token_at\\\"] = time.monotonic()\\n                        result[\\\"ttft_ms\\\"] = int(\\n                            ((result[\\\"first_token_at\\\"] or 0.0) - t0) * 1000\\n                        )\\n                    result[\\\"reasonings\\\"].append(text_value)\\n                    last_token_at = time.monotonic()\\n                    on_reasoning(text_value)\\n            elif etype == \\\"text\\\":\\n                text_value = str(payload.get(\\\"content\\\") or \\\"\\\")\\n                if text_value:\\n                    if result[\\\"first_token_at\\\"] is None:\\n                        result[\\\"first_token_at\\\"] = time.monotonic()\\n                        result[\\\"ttft_ms\\\"] = int(\\n                            ((result[\\\"first_token_at\\\"] or 0.0) - t0) * 1000\\n                        )\\n                    result[\\\"texts\\\"].append(text_value)\\n                    last_token_at = time.monotonic()\\n                    on_text(text_value)\\n            elif etype == \\\"tool_event\\\":\\n                if etype_raw == \\\"session.tool.input.delta\\\":\\n                    last_token_at = time.monotonic()\\n                tool_state.feed(payload)\\n                accumulated_bytes = _serve_accumulated_bytes(\\n                    accumulated_bytes, etype, payload, tool_state\\n                )\\n                call_id = str(payload.get(\\\"id\\\") or \\\"\\\")\\n                if etype_raw in (\\n                    \\\"session.tool.called\\\",\\n                    \\\"session.tool.failed\\\",\\n                    \\\"session.tool.success\\\",\\n                ):\\n                    done = tool_state.complete(call_id, etype_raw)\\n                    if done is not None:\\n                        last_token_at = time.monotonic()\\n                        pending_step_calls.append(done[1])\\n                        if result[\\\"first_token_at\\\"] is None:\\n                            result[\\\"first_token_at\\\"] = time.monotonic()\\n                            result[\\\"ttft_ms\\\"] = int(\\n                                ((result[\\\"first_token_at\\\"] or 0.0) - t0) * 1000\\n                            )\\n                        if emulate_tools:\\n                            _acc_box = [accumulated_bytes]\\n                            _ = _finish_serve_tool_step(\\n                                events,\\n                                session_id,\\n                                data_raw.get(\\\"assistantMessageID\\\")\\n                                or current_step_msg_id\\n                                or None,\\n                                min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\\n                                tool_state,\\n                                result,\\n                                on_tool,\\n                                _release_event,\\n                                attempt_deadline=deadline,\\n                                is_client_gone=is_client_gone,\\n                                pending_calls=pending_step_calls,\\n                                ctrl_http=_drain_ctrl,\\n                                reasoning_cb=on_reasoning,\\n                                text_cb=on_text,\\n                                emulate_tools=emulate_tools,\\n                                accumulated_bytes=_acc_box,\\n                                t0=t0,\\n                                replied_permissions=replied_permissions,\\n                                cascade_reject_state=cascade_reject_state,\\n                            )\\n                            accumulated_bytes = _acc_box[0]\\n                            break\\n            elif etype == \\\"step_finish\\\":\\n                step_key = str(\\n                    _as_dict(payload).get(\\\"assistantMessageID\\\")\\n                    or data_raw.get(\\\"assistantMessageID\\\")\\n                    or \\\"\\\"\\n                )\\n                if step_key and step_key in seen_steps:\\n                    continue\\n                if step_key:\\n                    seen_steps.add(step_key)\\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\\n                for key in (\\\"input\\\", \\\"output\\\", \\\"cached\\\", \\\"reasoning\\\"):\\n                    result[\\\"usage\\\"][key] = result[\\\"usage\\\"].get(key, 0) + _as_int(\\n                        payload.get(key)\\n                    )\\n                # Завершить native вызовы без called: аргументы из input.ended.text.\\n                for call_id in list(tool_state.tools):\\n                    done = tool_state.complete(call_id, etype_raw)\\n                    if done is not None:\\n                        last_token_at = time.monotonic()\\n                        pending_step_calls.append(done[1])\\n                # step_finish — это session.step.ended: pending публикуется один раз.\\n                for pending_call in pending_step_calls:\\n                    result[\\\"native_calls\\\"].append(pending_call)\\n                    on_tool(pending_call)\\n                pending_step_calls.clear()\\n                if result[\\\"native_calls\\\"] or (\\n                    emulate_tools and _split_tool_calls([\\\"\\\".join(result[\\\"texts\\\"])])[1]\\n                ):\\n===\\n8329:                watchdog_state: _WatchdogState = {\\n8382:                        and now_s - float(watchdog_state[\\\"last_token_at\\\"])\\n8403:                        watchdog_state[\\\"last_token_at\\\"]\\n8436:                                watchdog_state[\\\"last_token_at\\\"]\\n8504:                            watchdog_state[\\\"last_token_at\\\"] = time.monotonic()\\n                )\\n                stopped_on_error = False\\n                prior_text = \\\"\\\".join(collected_texts)\\n                dedup[0] = (\\n                    _PrefixDedup(prior_text)\\n                    if incomplete_retry and prior_text\\n                    else None\\n                )\\n\\n                attempt_start = time.monotonic()\\n                first_status_due = (\\n                    _attempts_t0(attempts, model, prompt)\\n                    + FIRST_STATUS_DELAY_S\\n                )\\n                watchdog_state: _WatchdogState = {\\n                    \\\"reason\\\": \\\"\\\",\\n                    \\\"first_event_at\\\": None,\\n                    \\\"first_token_at\\\": None,\\n                    \\\"last_token_at\\\": attempt_start,\\n                    \\\"status_next\\\": (\\n                        first_status_due\\n                        if attempts.total_spawns <= 1 and not status_fired_at[0]\\n                        else attempt_start + FIRST_STATUS_DELAY_S\\n                    ),\\n                    \\\"last_keepalive\\\": attempt_start,\\n                    \\\"last_reasoning\\\": \\\"\\\",\\n                }\\n                thinking_enabled = effort.strip().lower() not in (\\\"\\\", \\\"off\\\", \\\"none\\\")\\n===TESTS===\\n5:@@ -62,7 +62,7 @@ def test_passthrough_deadline_env() -> None:\\n6:         defaults.idle_timeout_s,\\n7:         defaults.total_timeout_s,\\n14:@@ -135,6 +135,39 @@ def test_zen_byte_timeout_selection(zen: Any, monkeypatch: pytest.MonkeyPatch) -\\n18:+def test_zen_split_timeouts(zen: Any, monkeypatch: pytest.MonkeyPatch) -> None:\\n28:+    assert zen._zen_ttft_timeout(model, big) == 25.0\\n29:+    assert zen._zen_idle_timeout(model, big) == 15.0\\n30:+    assert zen._zen_total_timeout(model, big) == 180.0\\n32:+    assert zen._zen_ttft_timeout(\\\"unrelated-free\\\", big) == zen.TIMEOUT_S\\n33:+    assert zen._zen_idle_timeout(\\\"unrelated-free\\\", big) == zen.TIMEOUT_S\\n34:+    assert zen._zen_total_timeout(\\\"unrelated-free\\\", big) == zen.TIMEOUT_S\\n37:+    assert zen._zen_ttft_timeout(model, big) == 7.0\\n41:+    assert zen._zen_ttft_timeout(model, big) == 3.0\\n42:+    assert zen._zen_idle_timeout(model, big) == 2.0\\n43:+    assert zen._zen_total_timeout(model, big) == 60.0\\n46:+    assert zen._zen_id