\n112:+            else time.monotonic() + _zen_total_timeout(self.model_id, self.prompt)\\n116:@@ -6642,6 +6691,14 @@ class Run:\\n124:+            _attempts_t0(self.attempts, self.model_id, self.prompt)\\n131:@@ -6669,9 +6726,20 @@ class Run:\\n153:@@ -6815,7 +6883,7 @@ class Run:\\n162:@@ -7029,7 +7097,7 @@ class Handler(BaseHTTPRequestHandler):\\n171:@@ -7385,7 +7453,7 @@ class Handler(BaseHTTPRequestHandler):\\n176:+                    _attempts_t0(attempts, model, prompt),\\n180:@@ -7895,7 +7963,7 @@ class Handler(BaseHTTPRequestHandler):\\n183:         attempts = _RequestAttempts(\\n185:+            res, time.monotonic() + _zen_total_timeout(model, prompt)\\n189:@@ -8002,8 +8070,7 @@ class Handler(BaseHTTPRequestHandler):\\n195:+                        _attempts_t0(attempts, model, prompt)\\n199:@@ -8256,8 +8323,7 @@ class Handler(BaseHTTPRequestHandler):\\n205:+                    _attempts_t0(attempts, model, prompt)\\n209:@@ -8274,6 +8340,10 @@ class Handler(BaseHTTPRequestHandler):\\n213:+                request_t0 = _attempts_t0(attempts, model, prompt)\\n220:@@ -8296,6 +8366,25 @@ class Handler(BaseHTTPRequestHandler):\\n246:@@ -8389,8 +8478,7 @@ class Handler(BaseHTTPRequestHandler):\\n252:+                                            _attempts_t0(attempts, model, prompt)\\n256:@@ -8408,8 +8496,7 @@ class Handler(BaseHTTPRequestHandler):\\n262:+                                                _attempts_t0(attempts, model, prompt)\\n266:@@ -8526,7 +8613,7 @@ class Handler(BaseHTTPRequestHandler):\\n275:@@ -8972,7 +9059,7 @@ class Handler(BaseHTTPRequestHandler):\\n280:+                    _attempts_t0(attempts, model, prompt),\\n284:@@ -9284,7 +9371,7 @@ class Handler(BaseHTTPRequestHandler):\\n286:         attempts = _RequestAttempts(\\n289:+            time.monotonic() + _zen_total_timeout(model, prompt),\\n===\\n            return {\\n                \\\"rc\\\": -1,\\n                \\\"text\\\": \\\"\\\",\\n                \\\"reasoning\\\": \\\"\\\",\\n                \\\"usage\\\": {},\\n                \\\"err\\\": f\\\"opencode launcher not executable: {launcher}\\\",\\n                \\\"state\\\": \\\"launcher_missing\\\",\\n                \\\"finish\\\": \\\"error\\\",\\n            }\\n\\n        self.workdir.mkdir(parents=True, exist_ok=True)\\n        env = _emulation_env(_run_env(self.model_id), bool(self.tools))\\n        model_route = _model_route(self.model_id)\\n\\n        cmd, shown = _build_cmd(launcher, self.model_id, self.effort)\\n        _log(\\n            f\\\"exec model={model_route} {shown} prompt_chars={len(self.prompt)} cwd={self.workdir}\\\"\\n        )\\n        deadline = (\\n            self.attempts.deadline\\n            if self.attempts is not None\\n            else time.monotonic() + _zen_total_timeout(self.model_id, self.prompt)\\n        )\\n        gate = _StartupGate()\\n        gate.acquire(deadline=deadline, is_client_gone=self.is_client_gone)\\n        if not self.res.spawn_limiter.acquire(\\n            max_wait_s=min(SPAWN_WAIT_MAX_S, max(0.0, deadline - time.monotonic())),\\n            deadline=deadline,\\n            is_client_gone=self.is_client_gone,\\n        ):\\n            gate.release()\\n            if self.attempts is not None:\\n                self.attempts.attempt_done(False, False)\\n            return {\\n                \\\"rc\\\": -1,\\n                \\\"text\\\": \\\"\\\",\\n                \\\"reasoning\\\": \\\"\\\",\\n                \\\"usage\\\": {},\\n                \\\"err\\\": \\\"spawn rate limit: deadline exceeded\\\",\\n                \\\"state\\\": \\\"client_gone\\\"\\n                if self.is_client_gone is not None and self.is_client_gone()\\n                else \\\"timeout\\\",\\n                \\\"finish\\\": \\\"error\\\",\\n            }\\n        if (\\n            self.is_client_gone is not None and self.is_client_gone()\\n        ) or time.monotonic() >= deadline:\\n            self.res.spawn_limiter.refund()\\n            gate.release()\\n            if self.attempts is not None:\\n                self.attempts.attempt_done(False, False)\\n            return {\\n                \\\"rc\\\": -1,\\n                \\\"text\\\": \\\"\\\",\\n                \\\"reasoning\\\": \\\"\\\",\\n                \\\"usage\\\": {},\\n                \\\"err\\\": \\\"request cancelled or deadline exceeded\\\",\\n                \\\"state\\\": \\\"client_gone\\\"\\n                if self.is_client_gone is not None and self.is_client_gone()\\n                else \\\"timeout\\\",\\n                \\\"finish\\\": \\\"error\\\",\\n            }\\n        try:\\n            self.proc = _spawn_with_stdin(cmd, self.prompt, self.workdir, env)\\n        except OSError as exc:\\n            self.res.spawn_limiter.refund()\\n            gate.release()\\n            return {\\n                \\\"rc\\\": -1,\\n                \\\"text\\\": \\\"\\\",\\n                \\\"reasoning\\\": \\\"\\\",\\n                \\\"usage\\\": {},\\n                \\\"err\\\": f\\\"spawn failed: {exc}\\\",\\n                \\\"state\\\": \\\"spawn_failed\\\",\\n                \\\"finish\\\": \\\"error\\\",\\n            }\\n        if self.attempts is not None:\\n            self.attempts.note_spawn()\\n\\n        text_pieces: list[str] = []\\n        reasoning_pieces: list[str] = []\\n        native_calls: list[dict[str, Any]] = []\\n        usage: dict[str, Any] = {}\\n        err_lines: list[str] = []\\n        provider_status: int | None = None\\n        had_error = False  # транзиентная ошибка провайдера посреди ответа (had_mid_stream_error)\\n        fatal_error = False  # детерминированная ошибка посреди ответа (400/401/403/404/422): без повтора\\n        stopped_on_error = False\\n        state = \\\"ok\\\"\\n        attempt_start = time.monotonic()\\n        first_event_at: float | None = None\\n        first_token_at: float | None = None\\n        last_token_at: float | None = None\\n        watchdog_reason: list[str] = []\\n        split_timeout = [False]\\n        ttft_timeout = _zen_ttft_timeout(self.model_id, self.prompt)\\n        idle_timeout = _zen_idle_timeout(self.model_id, self.prompt)\\n        ttft_origin = (\\n            _attempts_t0(self.attempts, self.model_id, self.prompt)\\n            if self.attempts is not None and self.attempts.total_spawns <= 1\\n            else attempt_start\\n        )\\n        subagent_started_at: dict[str, float] = {}\\n        run_id = uuid.uuid4().hex[:8]\\n\\n        with _active_lock:\\n            _active[run_id] = time.time()\\n\\n        def drain_stderr() -> None:\\n            try:\\n                assert self.proc is not None and self.proc.stderr is not None\\n                for line in self.proc.stderr:\\n                    line = line.strip()\\n                    if line:\\n                        err_lines.append(line)\\n            except (OSError, ValueError):\\n                pass\\n\\n        err_thread = threading.Thread(target=drain_stderr, daemon=True)\\n        err_thread.start()\\n\\n        def on_idle() -> None:\\n            \\\"\\\"\\\"Прервать молчащий JSON-прогон при закрытии клиентского сокета.\\\"\\\"\\\"\\n            nonlocal state\\n            if self.is_client_gone is not None and self.is_client_gone():\\n                state = \\\"client_gone\\\"\\n                if self.proc is not None:\\n                    _stop_proc(self.proc)\\n                return\\n            if watchdog_reason or split_timeout[0]:\\n                return\\n            now = time.monotonic()\\n            # Раздельные таймауты: TTFT до первого токена, Idle между токенами после него.\\n            if (first_token_at is None and now - ttft_origin > ttft_timeout) or (\\n                last_token_at is not None\\n                and not subagent_started_at\\n                and now - last_token_at > idle_timeout\\n            ):\\n                split_timeout[0] = True\\n                _log(\\\"opencode run split timeout (ttft/idle)\\\")\\n                if self.proc is not None:\\n                    _stop_proc(self.proc)\\n                return\\n            reason = \\\"\\\"\\n            if first_event_at is None and now - attempt_start > float(\\n                FIRST_EVENT_TIMEOUT_S\\n            ):\\n                reason = \\\"first_event_timeout\\\"\\n            elif first_token_at is None and now - attempt_start > float(\\n                FIRST_TOKEN_TIMEOUT_S\\n            ):\\n                reason = \\\"first_token_timeout\\\"\\n            elif (\\n                last_token_at is not None\\n                and not subagent_started_at\\n                and now - last_token_at > float(STALL_TIMEOUT_S)\\n            ):\\n                reason = \\\"stall_timeout\\\"\\n            if reason:\\n                watchdog_reason.append(reason)\\n                state = reason\\n\",\n  \"original_output_bytes\": 9108,\n  \"original_output_tokens\": 2277,\n  \"truncated\": false\n}","final_result":true}}}
