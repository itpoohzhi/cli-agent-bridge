нта: позитивные и негативные случаи для sniff, ротацию прокси и полный регресс.\n\nCONSENTS: 2/2\nVERDICT: ACCEPT","ttft_ms":7559,"type":"result","duration_ms":22620,"uuid":"4de7b73c-dd64-4972-bd47-81dd6ee17b99","ttft_stream_ms":2538,"time_to_request_ms":53,"first_content_frame_ms":2539,"queued_turn_count":0,"result_index":0}
