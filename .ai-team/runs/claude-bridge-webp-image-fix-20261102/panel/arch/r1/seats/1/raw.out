{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NnCE3Ko7YGM4EQytU9k74f","type":"tool_result","content":"def _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n\n    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n    \"\"\"\n    containers: list[dict[str, Any]] = [ev]\n    messages: list[str] = []\n    err = ev.get(\"error\")\n    if isinstance(err, dict):\n        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n    elif isinstance(err, str):\n        messages.append(err)\n    part = _dict_or_empty(ev.get(\"part\"))\n    if part:\n        part_err = _dict_or_empty(part.get(\"error\"))\n        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n    status: int | None = None\n    for container in containers:\n        if status is None:\n            for key in (\"statusCode\", \"status_code\", \"status\"):\n                value = container.get(key)\n                if isinstance(value, int) and not isinstance(value, bool):\n                    status = value\n                    break\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/claude-bridge-webp-image-fix-20261102/panel/arch/r1","is_error":false}]},"parent_tool_use_id":null,"session_id":"1c5a7848-d09e-4cae-870f-1c5ce71ad69d","uuid":"7dc1abeb-e1fb-44a5-a77e-20c2551b4566","timestamp":"2026-11-02T15:16:21.353Z","tool_use_result":{"stdout":"def _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n\n    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n    \"\"\"\n    containers: list[dict[str, Any]] = [ev]\n    messages: list[str] = []\n    err = ev.get(\"error\")\n    if isinstance(err, dict):\n        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n    elif isinstance(err, str):\n        messages.append(err)\n    part = _dict_or_empty(ev.get(\"part\"))\n    if part:\n        part_err = _dict_or_empty(part.get(\"error\"))\n        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n    status: int | None = None\n    for container in containers:\n        if status is None:\n            for key in (\"statusCode\", \"status_code\", \"status\"):\n                value = container.get(key)\n                if isinstance(value, int) and not isinstance(value, bool):\n                    status = value\n                    break","stderr":"\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/claude-bridge-webp-image-fix-20261102/panel/arch/r1","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NnCE3Ko7YGM4EQytU9k74f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
