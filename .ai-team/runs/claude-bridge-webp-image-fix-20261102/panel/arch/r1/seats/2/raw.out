{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c423","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":108,"recorded_at":1780531400000211,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"task_stream":{"kind":"task","id":"01a19cd5-9b59-7252-8e69-05ada8be16ed"},"task_id":"01a19cd5-9b59-7252-8e69-05ada8be16ed","event":{"kind":"output","task_id":"01a19cd5-9b59-7252-8e69-05ada8be16ed","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_images_strict.py`.\n1|\"\"\"Тесты image-пути моста (C-08…C-11): таксономия C-10, лимиты, хранение, proof.\"\"\"\n2|\n3|import json\n4|import os\n5|import sys\n6|import time\n7|import unittest\n8|from pathlib import Path\n9|\n10|sys.path.insert(0, str(Path(__file__).resolve().parent))\n11|sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n12|\n13|import server  # noqa: E402\n14|from bridge_testlib import (  # noqa: E402\n15|    BridgeCase,\n16|    JPEG_MAGIC,\n17|    GIF_MAGIC,\n18|    WEBP_MAGIC,\n19|    find_model,\n20|    image_part,\n21|    image_url_part,\n22|    make_png,\n23|    make_sig,\n24|    make_proof,\n25|    text_part,\n26|)\n27|\n28|\n29|def user_message(parts):\n30|    return {\"role\": \"user\", \"content\": parts}\n31|\n32|\n33|class ImageCase(BridgeCase):\n34|    \"\"\"Общие стенды: probe-модель и confirmed-модель с proof.\"\"\"\n35|\n36|    def probe_stand(self, model_id=\"claude-sonnet-5-5\", limits=None):\n37|        def mutate(data):\n38|            item = find_model(data, model_id)\n39|            item[\"input\"] = [\"text\", \"image\"]\n40|            item[\"images\"][\"status\"] = \"probe\"\n41|            item[\"images\"][\"method\"] = \"workspace-read\"\n42|            if limits:\n43|                data[\"image_limits\"].update(limits)\n44|\n45|        return self.stand(mutate, probe=True)\n46|\n47|    def confirmed_stand(\n48|        self,\n49|        model_id=\"deepseek-v4.1-flash\",\n50|        efforts_proven=None,\n51|        impl_version=1,\n52|        formats=(\"image/png\",),\n53|        binary_bytes=b\"stand-binary\",\n54|    ):\n55|        binary = Path(self._tmp.name) / (\"droid-\" + model_id)\n56|        binary.write_bytes(binary_bytes)\n57|        holder = {}\n58|\n59|        def mutate(data):\n60|            item = find_model(data, model_id)\n61|            item[\"input\"] = [\"text\", \"image\"]\n62|            item[\"images\"][\"status\"] = \"confirmed\"\n63|            item[\"images\"][\"method\"] = \"workspace-read\"\n64|            item[\"images\"][\"proof\"] = make_proof(\n65|                binary,\n66|                efforts_proven if efforts_proven is not None else item[\"efforts\"],\n67|                impl_version=impl_version,\n68|                formats=formats,\n69|            )\n70|            data[\"technical_ref\"][\"droid_binary_path\"] = str(binary)\n71|            holder[\"item\"] = item\n72|\n73|        self.stand(mutate)\n74|        return binary, holder\n75|\n76|\n77|class TestImagePositive(ImageCase):\n78|    \"\"\"Картинки идут в эфемерную RPC-сессию: проверяем фактический ввод и раскладку temp-файлов.\"\"\"\n79|\n80|    def _image_dir_prefix(self):\n81|        return os.path.realpath(str(server.WORKSPACE)) + \"/img-\"\n82|\n83|    def test_two_images_history_prompt_and_layout(self):\n84|        server.IMAGE_PROBE = True\n85|        self.probe_stand()\n86|        first, second = make_png(64), make_png(80)\n87|        messages = [\n88|            user_message([text_part(\"first\"), image_part(first)]),\n89|            {\"role\": \"assistant\", \"content\": \"ok\"},\n90|            user_message([image_part(second), text_part(\"second\")]),\n91|        ]\n92|        with self.capture_logs() as lines:\n93|            status, _ = self._post(\n94|                {\n95|                    \"model\": \"claude-sonnet-5-5\",\n96|                    \"reasoning_effort\": \"high\",\n97|                    \"messages\": messages,\n98|                }\n99|            )\n100|        self.assertEqual(status, 200)\n101|        spawn = self.hub.spawns()[-1]\n102|        self.assertEqual(spawn[\"cwd_mode\"], \"0o700\")\n103|        self.assertEqual(\n104|            spawn[\"cwd_files\"], {\"img-1.png\": \"0o600\", \"img-2.png\": \"0o600\"}\n105|        )\n106|        self.assertTrue(spawn[\"cwd\"].startswith(self._image_dir_prefix()))\n107|        execs = [ln for ln in lines if ln.startswith(\"exec model=\")]\n108|        self.assertIn(\n109|            \" images=2 image_bytes=%d image_types=image/png,image/png\"\n110|            % (len(first) + len(second)),\n111|            execs[0],\n112|        )\n113|        texts = self.hub.sent_texts()\n114|        self.assertEqual(\n115|            len(texts), 3\n116|        )  # история replay-ится по сообщениям, цикл запускает последнее\n117|        self.assertEqual(texts[0], \"first\\n[image 1]\")\n118|        self.assertEqual(texts[1], \"ok\")\n119|        self.assertTrue(texts[2].startswith(\"[image 2]\\nsecond\"))\n120|        self.assertIn(\n121|            \"- [image 1] ./img-1.png (image/png, %d bytes)\" % len(first), texts[2]\n122|        )\n123|        self.assertIn(\n124|            \"- [image 2] ./img-2.png (image/png, %d bytes)\" % len(second), texts[2]\n125|        )\n126|        self.assertIn(\"[attachments]\", texts[2])\n127|        self.assertIn(\n128|            \"Open each image with the Read tool on exactly these paths\", texts[2]\n129|        )\n130|        self.assertTrue(\n131|            self.hub.rpcs(\"droid.add_user_message\")[0][\"params\"][\"skipAgentLoop\"]\n132|        )\n133|        self.assertNotIn(\n134|            \"skipAgentLoop\", self.hub.rpcs(\"droid.add_user_message\")[2][\"params\"]\n135|        )\n136|        # Read остаётся доступным (нужен для чтения вложений), остальные нативные tools отключены.\n137|        disabled = self.hub.rpcs(\"droid.update_session_settings\")[0][\"params\"][\n138|            \"disabledToolIds\"\n139|        ]\n140|        self.assertNotIn(\"Read\", disabled)\n141|        self.assertIn(\"Execute\", disabled)\n142|        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n143|\n144|    def test_sixteen_images_at_the_limit(self):\n145|        server.IMAGE_PROBE = True\n146|        self.probe_stand()\n147|        parts = [image_part(make_png(64 + i)) for i in range(16)]\n148|        status, _ = self._post(\n149|            {\n150|                \"model\": \"claude-sonnet-5-5\",\n151|                \"reasoning_effort\": \"high\",\n152|                \"messages\": [user_message(parts)],\n153|            }\n154|        )\n155|        self.assertEqual(status, 200)\n156|        spawn = self.hub.spawns()[-1]\n157|        self.assertEqual(len(spawn[\"cwd_files\"]), 16)\n158|        prompt = self.hub.sent_texts()[-1]\n159|        for index in range(1, 17):\n160|            self.assertIn(\n161|                \"- [image %d] ./img-%d.png (image/png,\" % (index, index), prompt\n162|            )\n163|        self.assertEqual(prompt.count(\"[image 1]\"), 2)  # маркер и строка manifest\n164|\n165|    def test_image_only_message_is_not_pong(self):\n166|        server.IMAGE_PROBE = True\n167|        self.probe_stand()\n168|        status, _ = self._post(\n169|            {\n170|                \"model\": \"claude-sonnet-5-5\",\n171|                \"reasoning_effort\": \"high\",\n172|                \"messages\": [user_message([image_part(make_png(64))])],\n173|            }\n174|        )\n175|        self.assertEqual(status, 200)\n176|        prompt = self.hub.sent_texts()[-1]\n177|        self.assertNotIn(\"Reply with exactly: PONG\", prompt)\n178|        self.assertTrue(prompt.startswith(\"[image 1]\"))\n179|\n180|    def test_unknown_non_image_parts_are_skipped(self):\n181|        server.IMAGE_PROBE = True\n182|        self.probe_stand()\n183|        with self.capture_logs() as lines:\n184|            status, _ = self._post(\n185|                {\n186|                    \"model\": \"claude-sonnet-5-5\",\n187|                    \"reasoning_effort\": \"high\",\n188|                    \"messages\": [\n189|                        user_message(\n190|                            [\n191|                                text_part(\"hello\"),\n192|                                {\n193|                                    \"type\": \"input_audio\",\n194|                                    \"input_audio\": {\"data\": \"AAAA\", \"format\": \"wav\"},\n195|                                },\n196|                            ]\n197|                        )\n198|                    ],\n199|                }\n200|            )\n201|        self.assertEqual(status, 200)\n202|        execs = [ln for ln in lines if ln.startswith(\"exec model=\")]\n203|        self.assertNotIn(\" images=\", execs[0])\n204|        self.assertEqual(self.hub.sent_texts(), [\"hello\"])\n205|\n206|    def test_tools_get_read_exception_with_attachments(self):\n207|        server.IMAGE_PROBE = True\n208|        self.probe_stand()\n209|        tools = [\n210|            {\n211|                \"type\": \"function\",\n212|                \"function\": {\n213|                    \"name\": \"get_weather\",\n214|                    \"description\": \"Get weather\",\n215|                    \"parameters\": {\"type\": \"object\"},\n216|                },\n217|            }\n218|        ]\n219|        status, _ = self._post(\n220|            {\n221|                \"model\": \"claude-sonnet-5-5\",\n222|                \"reasoning_effort\": \"high\",\n223|                \"tools\": tools,\n224|                \"messages\": [\n225|                    user_message([text_part(\"weather?\"), image_part(make_png(64))])\n226|                ],\n227|            }\n228|        )\n229|        self.assertEqual(status, 200)\n230|        system = self.hub.inits()[-1][\"params\"][\"systemPrompt\"]\n231|        self.assertIn(\n232|            \"except Read on the attachment files listed under [attachments].\", system\n233|        )\n234|        self.assertIn(\"[attachments]\", self.hub.sent_texts()[-1])\n235|\n236|\n237|class TestImageRejections(ImageCase):\n238|    def test_unverified_and_unsupported_models_rejected(self):\n239|        server.IMAGE_PROBE = True\n240|        for model, expected in (\n241|            (\"gemini-3.8-flash\", \"image_input_not_supported\"),\n242|            (\"glm-5.3\", \"image_input_not_supported\"),\n243|        ):\n244|            before = len(self.hub.spawns())\n245|            status, body = self._post_json(\n246|                {\n247|                    \"model\": model,\n248|                    \"reasoning_effort\": \"max\" if model == \"glm-5.3\" else \"high\",\n249|                    \"messages\": [\n250|                        user_message([text_part(\"x\"), image_part(make_png(64))])\n251|                    ],\n252|                }\n253|            )\n254|            self.assertEqual(status, 400, model)\n255|            self.assertEqual(body[\"error\"][\"type\"], expected)\n256|            self.assertEqual(len(self.hub.spawns()), before)\n257|\n258|    def test_taxonomy(self):\n259|        server.IMAGE_PROBE = True\n260|        self.probe_stand()\n261|        png = make_png(64)\n262|        cases = [\n263|            (\"image_url_not_allowed\", image_url_part(\"http://127.0.0.1:19886/a.png\")),\n264|            (\"image_url_not_allowed\", image_url_part(\"file:///etc/hosts\")),\n265|            (\"image_url_not_allowed\", image_url_part(\"https://example.com/a.png\")),\n266|            (\"unsupported_image_type\", image_url_part(\"data:text/plain;base64,aGk=\")),\n267|            (\n268|                \"unsupported_image_type\",\n269|                image_url_part(\"data:image/svg+xml;base64,PHN2Zy8+\"),\n270|            ),\n271|            (\"invalid_image_base64\", image_url_part(\"data:image/png;base64,@@@@\")),\n272|            (\"invalid_image_base64\", image_url_part(\"data:image/png;base64,\")),\n273|            (\"image_type_mismatch\", image_part(make_sig(JPEG_MAGIC, 64), \"image/png\")),\n274|            (\"unsupported_image_type\", image_part(b\"\\x00\" * 64, \"image/png\")),\n275|            (\"invalid_image_content\", image_url_part(\"data:image/png,rawdata\")),\n276|            (\n277|                \"invalid_image_content\",\n278|                {\"type\": \"image_url\", \"image_url\": \"data:image/png;base64,AAAA\"},\n279|            ),\n280|            (\"invalid_image_content\", {\"type\": \"image_url\", \"image_url\": {}}),\n281|            (\n282|                \"unsupported_image_type\",\n283|                image_part(make_sig(JPEG_MAGIC, 64), \"image/jpeg\"),\n284|            ),\n285|            (\n286|                \"unsupported_image_type\",\n287|                image_part(make_sig(WEBP_MAGIC, 64), \"image/webp\"),\n288|            ),\n289|            (\n290|                \"unsupported_image_type\",\n291|                image_part(make_sig(GIF_MAGIC, 64), \"image/gif\"),\n292|            ),\n293|        ]\n294|        for expected, part in cases:\n295|            before = len(self.hub.spawns())\n296|            status, body = self._post_json(\n297|                {\n298|                    \"model\": \"claude-sonnet-5-5\",\n299|                    \"reasoning_effort\": \"high\",\n300|                    \"messages\": [user_message([text_part(\"x\"), part])],\n301|                }\n302|            )\n303|            self.assertEqual(status, 400, expected)\n304|            self.assertEqual(body[\"error\"][\"type\"], expected)\n305|            self.assertEqual(len(self.hub.spawns()), before)\n306|        for role in (\"assistant\", \"system\", \"tool\"):\n307|            messages = [\n308|                user_message([text_part(\"hi\")]),\n309|                {\"role\": role, \"content\": [image_part(png)]},\n310|            ]\n311|            status, body = self._post_json(\n312|                {\n313|                    \"model\": \"claude-sonnet-5-5\",\n314|                    \"reasoning_effort\": \"high\",\n315|                    \"messages\": messages,\n316|                }\n317|            )\n318|            self.assertEqual(status, 400, role)\n319|            self.assertEqual(body[\"error\"][\"type\"], \"invalid_image_content\")\n320|\n321|    def test_reject_line_for_image_is_strict(self):\n322|        server.IMAGE_PROBE = True\n323|        self.probe_stand()\n324|        with self.capture_logs() as lines:\n325|            self._post(\n326|                {\n327|                    \"model\": \"claude-sonnet-5-5\",\n328|                    \"reasoning_effort\": \"high\",\n329|                    \"messages\": [\n330|                        user_message(\n331|                            [\n332|                                text_part(\"x\"),\n333|                                image_url_part(\"http://127.0.0.1:19886/a.png\"),\n334|                            ]\n335|                        )\n336|                    ],\n337|                }\n338|            )\n339|        rejects = [ln for ln in lines if \"reject reason=\" in ln]\n340|        self.assertEqual(len(rejects), 1)\n341|        self.assertEqual(rejects[0], rejects[0].rstrip())\n342|        self.assertRegex(\n343|            rejects[0],\n344|            r\"^reject reason=image_url_not_allowed \"\n345|            r\"model=claude-sonnet-5-5 model_len=\\d+ client=[0-9.:]+$\",\n346|        )\n347|\n348|    def test_limits(self):\n349|        server.IMAGE_PROBE = True\n350|        self.probe_stand(\n351|            limits={\n352|                \"max_images\": 2,\n353|                \"max_image_bytes\": 1000,\n354|                \"max_total_image_bytes\": 1500,\n355|            }\n356|        )\n357|\n358|        def post(parts):\n359|            return self._post_json(\n360|                {\n361|                    \"model\": \"claude-sonnet-5-5\",\n362|                    \"reasoning_effort\": \"high\",\n363|                    \"messages\": [user_message(parts)],\n364|                }\n365|            )\n366|\n367|        status, body = post([image_part(make_png(64))] * 3)\n368|        self.assertEqual(body[\"error\"][\"type\"], \"too_many_images\")\n369|        status, body = post([image_part(make_png(1001))])\n370|        self.assertEqual(body[\"error\"][\"type\"], \"image_too_large\")\n371|        status, body = post([image_part(make_png(800)), image_part(make_png(800))])\n372|        self.assertEqual(body[\"error\"][\"type\"], \"images_too_large\")\n373|        status, _ = post([image_part(make_png(700)), image_part(make_png(700))])\n374|        self.assertEqual(status, 200)\n375|\n376|\n377|class TestImageCleanup(ImageCase):\n378|    def test_cleanup_after_success(self):\n379|        server.IMAGE_PROBE = True\n380|        self.probe_stand()\n381|        status, _ = self._post(\n382|            {\n383|                \"model\": \"claude-sonnet-5-5\",\n384|                \"reasoning_effort\": \"high\",\n385|                \"messages\": [user_message([image_part(make_png(64))])],\n386|            }\n387|        )\n388|        self.assertEqual(status, 200)\n389|        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n390|\n391|    def test_cleanup_after_exception(self):\n392|        # Сбой запуска (лончер умирает сразу): 502 и ни одного каталога картинок.\n393|        server.IMAGE_PROBE = True\n394|        self.probe_stand()\n395|        broken = Path(self._tmp.name) / \"broken-launcher\"\n396|        broken.write_text(\"#!/bin/sh\\nexit 1\\n\", encoding=\"utf-8\")\n397|        broken.chmod(0o755)\n398|        server.LAUNCHER = str(broken)\n399|        status, _ = self._post_json(\n400|            {\n401|                \"model\": \"claude-sonnet-5-5\",\n402|                \"reasoning_effort\": \"high\",\n403|                \"messages\": [user_message([image_part(make_png(64))])],\n404|            }\n405|        )\n406|        self.assertEqual(status, 502)\n407|        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n408|\n409|    def test_cleanup_after_retries(self) -> None:\n410|        \"\"\"Каждый явный повтор клиента запускает CLI один раз и очищает свои изображения.\"\"\"\n411|        from typing import Callable, cast\n412|\n413|        probe_stand = cast(Callable[[], object], getattr(self, \"probe_stand\"))\n414|        legacy = cast(\n415|            Callable[[list[list[tuple[str, object]]]], None],\n416|            getattr(self.hub, \"legacy\"),\n417|        )\n418|        admissions = cast(Callable[[], list[object]], getattr(self.hub, \"admissions\"))\n419|        spawns = cast(\n420|            Callable[[], list[dict[str, object]]], getattr(self.hub, \"spawns\")\n421|        )\n422|        post = cast(\n423|            Callable[[dict[str, object]], tuple[int, object]],\n424|            getattr(self, \"_post_json\"),\n425|        )\n426|        server.IMAGE_PROBE = True\n427|        _ = probe_stand()\n428|        legacy([[(\"stderr\", \"Exec failed\"), (\"done\", (1, \"\"))] for _ in range(3)])\n429|        request: dict[str, object] = {\n430|            \"model\": \"claude-sonnet-5-5\",\n431|            \"reasoning_effort\": \"high\",\n432|            \"messages\": [user_message([image_part(make_png(64))])],\n433|        }\n434|        for expected_calls in range(1, 4):\n435|            status, _ = post(request)\n436|            self.assertEqual(status, 502)\n437|            self.assertEqual(len(admissions()), expected_calls)\n438|            self.assertEqual(len(spawns()), expected_calls)\n439|            self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n440|        actual_spawns = spawns()\n441|        self.assertEqual(len(actual_spawns), 3)\n442|        for spawn in actual_spawns:  # права temp-файлов каждого запроса сохранены\n443|            self.assertEqual(spawn[\"cwd_files\"], {\"img-1.png\": \"0o600\"})\n444|        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n445|\n446|    def test_cleanup_after_client_gone(self):\n447|        server.IMAGE_PROBE = True\n448|        self.probe_stand()\n449|        real_gone = server._client_gone\n450|        server._client_gone = lambda sock: True\n451|        try:\n452|            raw = self._raw_request(\n453|                json.dumps(\n454|                    {\n455|                        \"model\": \"claude-sonnet-5-5\",\n456|                        \"reasoning_effort\": \"high\",\n457|                        \"messages\": [user_message([image_part(make_png(64))])],\n458|                    }\n459|                ).encode()\n460|            )\n461|            sock = __import__(\"socket\").create_connection(\n462|                (\"127.0.0.1\", self.port), timeout=5\n463|            )\n464|            sock.sendall(raw)\n465|            time.sleep(0.7)\n466|            sock.close()\n467|        finally:\n468|            server._client_gone = real_gone\n469|        deadline = time.time() + 5\n470|        while time.time() < deadline and list(server.WORKSPACE.glob(\"img-*\")):\n471|            time.sleep(0.1)\n472|        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n473|        # Клиент ушёл раньше хода: ход не доходит до модели, процесс не остаётся.\n474|        self.assertLessEqual(len(self.hub.spawns()), 1)\n475|        self.assertEqual(len(self.hub.admissions()), 0)\n476|\n477|\n478|class TestProofFailClosed(ImageCase):\n479|    def request(self, model, effort=\"high\"):\n480|        return self._post_json(\n481|            {\n482|                \"model\": model,\n483|                \"reasoning_effort\": effort,\n484|                \"messages\": [user_message([text_part(\"x\"), image_part(make_png(64))])],\n485|            }\n486|        )\n487|\n488|    def test_valid_proof_accepts_then_degrades_on_binary_change(self):\n489|        binary, _ = self.confirmed_stand()\n490|        status, _ = self.request(\"deepseek-v4.1-flash\", \"max\")\n491|        self.assertEqual(status, 200)\n492|        self.assertEqual(len(self.hub.admissions()), 1)\n493|        binary.write_bytes(b\"other-binary-content\")\n494|        with self.capture_logs() as lines:\n495|            status, body = self.request(\"deepseek-v4.1-flash\", \"max\")\n496|        self.assertEqual(status, 400)\n497|        self.assertEqual(body[\"error\"][\"type\"], \"image_input_not_supported\")\n498|        self.assertTrue(\n499|            any(\n500|                \"image_proof_invalid model=deepseek-v4.1-flash \"\n(more lines below)","final_result":true}}}
