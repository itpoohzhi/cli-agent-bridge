{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c487","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":158,"recorded_at":1780531400000311,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd5c29076f9958cfd9dbc13390f","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_opencode_zen_bridge.py`.\n(69 line(s) above)\n70|        \"proxy_url\": None,\n71|    }\n72|    result.update(overrides)\n73|    return result\n74|\n75|\n76|def _quota_result(**overrides: Any) -> dict[str, Any]:\n77|    return _result(\n78|        error={\n79|            \"type\": \"provider.free-limit\",\n80|            \"statusCode\": 429,\n81|            \"message\": \"Free usage limit reached for this IP\",\n82|        },\n83|        transient_error=True,\n84|        **overrides,\n85|    )\n86|\n87|\n88|def _install_attempts(\n89|    bridge: Any,\n90|    monkeypatch: pytest.MonkeyPatch,\n91|    results: list[dict[str, Any]],\n92|    *,\n93|    select_proxy: bool = False,\n94|) -> Mock:\n95|    queued = iter(results)\n96|\n97|    def serve(*args: Any, **kwargs: Any) -> dict[str, Any]:\n98|        result = next(queued)\n99|        if select_proxy:\n100|            result[\"proxy_url\"] = bridge._next_standalone_proxy()\n101|        kwargs[\"on_startup_ready\"]()\n102|        for index, key in ((4, \"reasonings\"), (5, \"texts\"), (6, \"native_calls\")):\n103|            for value in result[key]:\n104|                args[index](value)\n105|        return result\n106|\n107|    runner = Mock(side_effect=serve)\n108|    monkeypatch.setattr(bridge, \"_serve_one_attempt\", runner)\n109|    return runner\n110|\n111|\n112|def _configure_pool(\n113|    bridge: Any,\n114|    monkeypatch: pytest.MonkeyPatch,\n115|    tmp_path: Path,\n116|    offset: int = 0,\n117|) -> tuple[str, str]:\n118|    pool = tmp_path / \"pool.txt\"\n119|    pool.write_text(\"u:p@host:10001\\nu:p@host:10002\\n\", encoding=\"utf-8\")\n120|    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_STANDALONE_PROXY\", \"pool\")\n121|    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_FILE\", str(pool))\n122|    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_OFFSET\", str(offset))\n123|    monkeypatch.setattr(bridge, \"_resolve_proxyrack_gateway\", lambda: \"192.0.2.1\")\n124|    return \"http://u:p@192.0.2.1:10001\", \"http://u:p@192.0.2.1:10002\"\n125|\n126|\n127|def _stream(\n128|    handler: Any, attempts: Any, tools: list[dict[str, Any]]\n129|) -> tuple[bool, dict[str, Any], list[str]]:\n130|    texts: list[str] = []\n131|    xs: dict[str, Any] = {\"status\": 200}\n132|    done = handler._run_serve_stream_attempts(\n133|        \"deepseek-v4.1-flash-free\",\n134|        \"Ответь\",\n135|        \"high\",\n136|        bool(tools),\n137|        tools,\n138|        \"chatcmpl-test\",\n139|        1,\n140|        \"deepseek-v4.1-flash-free\",\n141|        texts.append,\n142|        texts.append,\n143|        Mock(),\n144|        attempts,\n145|        attempts.res,\n146|        xs,\n147|        texts,\n148|    )\n149|    attempts.commit()\n150|    return done, xs, texts\n151|\n152|\n153|def _json(handler: Any, attempts: Any) -> dict[str, Any]:\n154|    xs: dict[str, Any] = {}\n155|    assert handler._serve_json_serve(\n156|        \"deepseek-v4.1-flash-free\",\n157|        \"Ответь\",\n158|        \"high\",\n159|        False,\n160|        [],\n161|        None,\n162|        None,\n163|        attempts.res,\n164|        attempts,\n165|        xs,\n166|    )\n167|    attempts.commit()\n168|    assert handler._send.call_args.args[0] == 200\n169|    return handler._send.call_args.args[1][\"choices\"][0][\"message\"]\n170|\n171|\n172|def test_stream_serve_attempt2_free_quota_error_after_attempt1_reasoning_rotates_proxy(\n173|    bridge: Any,\n174|    monkeypatch: pytest.MonkeyPatch,\n175|    tmp_path: Path,\n176|) -> None:\n177|    handler = _handler(bridge)\n178|    attempts = _attempts(bridge)\n179|    p1, p2 = _configure_pool(bridge, monkeypatch, tmp_path, offset=1)\n180|    results = [\n181|        _result(reasonings=[\"Планирую вызов\"], terminal=\"incomplete_step\"),\n182|        _quota_result(),\n183|        _result(texts=[\"Ответ\"]),\n184|    ]\n185|    runner = _install_attempts(bridge, monkeypatch, results, select_proxy=True)\n186|    signal = Mock(side_effect=[2, 0])\n187|    monkeypatch.setattr(bridge, \"_incomplete_step_signal\", signal)\n188|    tools = [{\"type\": \"function\", \"function\": {\"name\": \"read\", \"parameters\": {}}}]\n189|    done, xs, texts = _stream(handler, attempts, tools)\n190|    assert done and xs[\"status\"] == 200\n191|    assert runner.call_count == 3\n192|    assert p1 in bridge._proxy_quarantine_until\n193|    assert [result[\"proxy_url\"] for result in results] == [p2, p1, p2]\n194|    assert \"\".join(texts) == \"Ответ\"\n195|    assert b'\"error\"' not in handler.wfile.getvalue()\n196|    assert attempts.quota_rotations == 1\n197|    attempts.res.breaker.record_failure.assert_not_called()\n198|    # Только incomplete_step расходует бюджет; смена выбитого порта — нет.\n199|    assert attempts.res.retry_budget.try_acquire_retry.call_count == 1\n200|\n201|\n202|def test_stream_serve_attempt_with_emitted_reasoning_does_not_duplicate_on_transient_error(\n203|    bridge: Any,\n204|    monkeypatch: pytest.MonkeyPatch,\n205|) -> None:\n206|    handler = _handler(bridge)\n207|    attempts = _attempts(bridge)\n208|    runner = _install_attempts(\n209|        bridge,\n210|        monkeypatch,\n211|        [\n212|            _quota_result(\n213|                reasonings=[\"Уникальное размышление\"], proxy_url=\"http://p1:10001\"\n214|            ),\n215|        ],\n216|    )\n217|    monkeypatch.setattr(bridge, \"_incomplete_step_signal\", Mock(return_value=0))\n218|    done, _, _ = _stream(handler, attempts, [])\n219|    assert done\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd5c6d9775d9325b58bdf7fbf95","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_claude_bridge.py`.\n1|\"\"\"Тесты claude-p-bridge (ADR 0014, AD-001..AD-005) и универсального слоя core.\n2|\n3|Покрытие: SSOT в репозитории и fail-closed импорт core (AD-002), изображения\n4|через workspace-read с правами 0700/0600 и cleanup в finally (AD-003),\n5|ALWAYS-ON санитизация ToolCallParser(strict_live=True) без утечки сырого XML и\n6|без result-fallback (AD-004), real-time reasoning в SSE\n7|(choices[0].delta.reasoning_content) и в JSON (message.reasoning_content)\n8|(AD-005), флаги --tools \"Read\"/--add-dir при вложениях (REQ-03).\n9|\"\"\"\n10|\n11|import base64\n12|import http.client\n13|import importlib.util\n14|import json\n15|import os\n16|import queue\n17|import stat\n18|import sys\n19|import threading\n20|from pathlib import Path\n21|\n22|import pytest\n23|\n24|sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n25|\n26|import core.tool_emulation as core_te  # noqa: E402\n27|\n28|REPO = Path(__file__).resolve().parent.parent\n29|BRIDGE_DIR = REPO / \"bridges\" / \"claude-p-bridge\"\n30|BRIDGE_SERVER = BRIDGE_DIR / \"server.py\"\n31|\n32|PNG_BYTES = b\"\\x89PNG\\r\\n\\x1a\\n\" + b\"\\x00\" * 16\n33|JPEG_BYTES = b\"\\xff\\xd8\\xff\\xe0\" + b\"\\x00\" * 16\n34|GIF_BYTES = b\"GIF89a\" + b\"\\x00\" * 16\n35|\n36|TOOLS = [\n37|    {\n38|        \"type\": \"function\",\n39|        \"function\": {\n40|            \"name\": \"get_weather\",\n41|            \"description\": \"Get current weather\",\n42|            \"parameters\": {\n43|                \"type\": \"object\",\n44|                \"properties\": {\n45|                    \"city\": {\"type\": \"string\"},\n46|                    \"note\": {\"type\": \"string\"},\n47|                },\n48|                \"required\": [\"city\"],\n49|            },\n50|        },\n51|    }\n52|]\n53|\n54|\n55|def _data_url(mime: str, data: bytes) -> str:\n56|    return f\"data:{mime};base64,{base64.b64encode(data).decode()}\"\n57|\n58|\n59|def _image_part(mime: str = \"image/png\", data: bytes = PNG_BYTES) -> dict:\n60|    return {\"type\": \"image_url\", \"image_url\": {\"url\": _data_url(mime, data)}}\n61|\n62|\n63|def _load_bridge():\n64|    spec = importlib.util.spec_from_file_location(\n65|        \"claude_p_bridge_server\", BRIDGE_SERVER\n66|    )\n67|    assert spec is not None and spec.loader is not None\n68|    mod = importlib.util.module_from_spec(spec)\n69|    spec.loader.exec_module(mod)\n70|    return mod\n71|\n72|\n73|@pytest.fixture()\n74|def bridge(monkeypatch):\n75|    mod = _load_bridge()\n76|    monkeypatch.setattr(mod, \"AUTH_KEY\", \"test-key\")\n77|    return mod\n78|\n79|\n80|class FakeRun:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
