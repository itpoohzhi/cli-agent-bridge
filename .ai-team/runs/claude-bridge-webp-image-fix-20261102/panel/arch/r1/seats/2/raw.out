ь кэш и индекс пула прокси.\"\"\"\n1880|    global _proxy_pool_key, _proxy_pool_entries, _proxy_pool_idx\n1881|    with _proxy_pool_lock:\n1882|        _proxy_pool_key = None\n1883|        _proxy_pool_entries = []\n1884|        _proxy_pool_idx = 0\n1885|        _proxy_quarantine_until.clear()\n1886|\n1887|\n1888|def _run_env(model_id: str = \"\") -> dict[str, str]:\n1889|    \"\"\"Окружение CLI с отдельным конфигом маршрута для Go-моделей и свежим каталогом для Zen.\"\"\"\n(more lines below)","final_result":true}}}
