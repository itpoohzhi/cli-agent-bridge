{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c427","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":110,"recorded_at":1780531400000215,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"task_stream":{"kind":"task","id":"01a19cd5-9af3-79d0-83ec-5f235b124141"},"task_id":"01a19cd5-9af3-79d0-83ec-5f235b124141","event":{"kind":"output","task_id":"01a19cd5-9af3-79d0-83ec-5f235b124141","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py`.\n(1354 line(s) above)\n1355|DEFAULT_MAX_IMAGE_BYTES = 10 * 1024 * 1024\n1356|DEFAULT_MAX_TOTAL_IMAGE_BYTES = 20 * 1024 * 1024\n1357|# Служебные теги протокола <tool_call>, не имеющие смысла вне настоящего блока.\n1358|_ORPHAN_SERVICE_TAGS = (\n1359|    TOOL_CALL_CLOSE,\n1360|    \"<arg_key>\",\n1361|    \"</arg_key>\",\n1362|    \"<arg_value>\",\n1363|    \"</arg_value>\",\n1364|)\n1365|# (MIME, магические байты, расширение файла) — принимаемые форматы вложений.\n1366|_IMAGE_FORMATS = (\n1367|    (\"image/png\", b\"\\x89PNG\\r\\n\\x1a\\n\", \"png\"),\n1368|    (\"image/jpeg\", b\"\\xff\\xd8\\xff\", \"jpg\"),\n1369|)\n1370|\n1371|\n1372|class ImageInputError(ValueError):\n1373|    \"\"\"Отказ валидации изображения запроса; `code` — машинный код причины.\"\"\"\n1374|\n1375|    def __init__(self, code: str):\n1376|        super().__init__(code)\n1377|        self.code = code\n1378|\n1379|\n1380|def _sniff_image_mime(data: bytes) -> str:\n1381|    \"\"\"MIME по магическим байтам ('' — сигнатура неизвестна).\"\"\"\n1382|    for mime, magic, _ext in _IMAGE_FORMATS:\n1383|        if data.startswith(magic):\n1384|            return mime\n1385|    return \"\"\n1386|\n1387|\n1388|def extract_data_url_images(\n1389|    messages: Any,\n1390|    *,\n1391|    max_images: int = DEFAULT_MAX_IMAGES,\n1392|    max_image_bytes: int = DEFAULT_MAX_IMAGE_BYTES,\n1393|    max_total_bytes: int = DEFAULT_MAX_TOTAL_IMAGE_BYTES,\n1394|) -> list[dict]:\n1395|    \"\"\"Все `image_url`-части истории -> [{\"name\", \"mime\", \"data\"}] в порядке появления.\n1396|\n1397|    Принимаются только data URI с base64 PNG/JPEG: строгая проверка кодировки и\n1398|    соответствия MIME сигнатуре; URL не скачиваются, `file://` не читается,\n1399|    пользовательские пути не используются (имена генерируются: `image_N.<ext>`).\n1400|    Любое нарушение — `ImageInputError` до запуска CLI (fail-closed).\n1401|    \"\"\"\n1402|    images: list[dict] = []\n1403|    total = 0\n1404|    if not isinstance(messages, list):\n1405|        return images\n1406|    for msg in messages:\n1407|        if not isinstance(msg, dict) or not isinstance(msg.get(\"content\"), list):\n1408|            continue\n1409|        for item in msg[\"content\"]:\n1410|            if not isinstance(item, dict) or item.get(\"type\") != \"image_url\":\n1411|                continue\n1412|            image_url = item.get(\"image_url\")\n1413|            url = image_url.get(\"url\") if isinstance(image_url, dict) else None\n1414|            if not isinstance(url, str):\n1415|                raise ImageInputError(\"invalid_image_content\")\n1416|            if not url.startswith(\"data:\"):\n1417|                raise ImageInputError(\"image_url_not_allowed\")\n1418|            comma = url.find(\",\")\n1419|            if comma == -1:\n1420|                raise ImageInputError(\"invalid_image_content\")\n1421|            fields = [f.strip().lower() for f in url[5:comma].split(\";\")]\n1422|            mime = fields[0] if fields else \"\"\n1423|            if not mime or \"base64\" not in fields[1:]:\n1424|                raise ImageInputError(\"invalid_image_content\")\n1425|            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\n1426|            if not ext:\n1427|                raise ImageInputError(\"unsupported_image_type\")\n1428|            if len(images) >= max_images:\n1429|                raise ImageInputError(\"too_many_images\")\n1430|            approx_bytes = (len(url) - comma - 1) * 3 // 4\n1431|            if approx_bytes > max_image_bytes:\n1432|                raise ImageInputError(\"image_too_large\")\n1433|            if total + approx_bytes > max_total_bytes:\n1434|                raise ImageInputError(\"images_too_large\")\n1435|            payload = url[comma + 1 :]\n1436|            if not payload:\n1437|                raise ImageInputError(\"invalid_image_base64\")\n1438|            try:\n1439|                data = base64.b64decode(payload, validate=True)\n1440|            except (binascii.Error, ValueError):\n1441|                raise ImageInputError(\"invalid_image_base64\") from None\n1442|            sniffed = _sniff_image_mime(data)\n1443|            if not sniffed:\n1444|                raise ImageInputError(\"unsupported_image_type\")\n1445|            if sniffed != mime:\n1446|                raise ImageInputError(\"image_type_mismatch\")\n1447|            if len(data) > max_image_bytes:\n1448|                raise ImageInputError(\"image_too_large\")\n1449|            total += len(data)\n1450|            if total > max_total_bytes:\n1451|                raise ImageInputError(\"images_too_large\")\n1452|            images.append(\n1453|                {\"name\": f\"image_{len(images) + 1}.{ext}\", \"mime\": mime, \"data\": data}\n1454|            )\n1455|    return images\n1456|\n1457|\n1458|def extract_thinking_delta(delta: Any) -> str:\n1459|    \"\"\"Текст нативной дельты размышления (`thinking_delta`) -> строка; иначе ''.\n1460|\n1461|    Транспортные адаптеры переводят свои события в общий словарь дельты; текст\n1462|    берётся из `thinking` (форма Claude stream-json) либо `thinking_delta`.\n1463|    \"\"\"\n1464|    if not isinstance(delta, dict) or delta.get(\"type\") != \"thinking_delta\":\n1465|        return \"\"\n1466|    value = delta.get(\"thinking\")\n1467|    if value is None:\n1468|        value = delta.get(\"thinking_delta\")\n1469|    return value if isinstance(value, str) else \"\"\n1470|\n1471|\n1472|class StreamNormalizer:\n1473|    \"\"\"Единый нормализатор живого потока: content / reasoning / tool_calls (AD-005).\n1474|\n1475|    Один лексический автомат на все выходы транспорта. В обычном тексте первая\n1476|    встреченная конструкция определяет контекст до своего закрытия: теги\n1477|    размышлений (`REASONING_TAGS`) уводят дельты в reasoning, блок `<tool_call>`\n1478|    непрозрачен и целиком уходит в `ToolCallParser` (тег размышления внутри\n1479|    JSON-строки аргумента канал не переключает; `<tool_call>` внутри размышления\n1480|    вызовом не становится). Теги в Markdown-коде каналом не являются (контекст —\n1481|    `_code_context`). Нативное thinking (`feed_thinking`) уже типизировано: в\n1482|    парсер не подаётся и не исполняется.\n1483|\n1484|    Каждое событие сначала добавляется в аккумуляторы (`content`,\n(more lines below)","final_result":true}}}
