IFF\" and data[8:12] == b\"WEBP\"`).\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py:291:from core.tool_emulation import (  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py:117:from core.watchdog import (  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py:122:from core.usage_wire import normalize_prompt_cache_details  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py:64:    from core.watchdog import AdaptiveTimeoutController\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py:69:    from core.stream_framing import format_stream_error_sse\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py:70:    from core.tool_emulation import (  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py:80:        extract_data_url_images,\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py:330:    return extract_data_url_images(\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:64:from core.backend_adapter import ToolCall, ToolFunction, TurnResult, Usage  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:65:from core.lifecycle import HubLifecycleManager  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:66:from core.tool_emulation import (  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py:70:from core.turn_session_manager import (  # noqa: E402\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/muse_adapter.py:50:from core.backend_adapter import (\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/muse_adapter.py:65:from core.watchdog import AdaptiveTimeoutController\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/droid_adapter.py:16:from core.backend_adapter import (\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:35:from core.backend_adapter import (\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:49:    from core.tool_emulation import (\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:60:    from core.tool_emulation import (  # type: ignore[no-redef]\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:70:from core.stream_framing import (","correlation_facts":{"tool_name":"search","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c545","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":253,"recorded_at":1780531400000501,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd6340077189f0ee51af1a08dd6","text":"/Users/aazhiry1/work/src/cli-agent-bridge/server.py:1230:    метода, форматы image_limits.types ⊆ proof.formats и применимый effort\n/Users/aazhiry1/work/src/cli-agent-bridge/server.py:1242:    formats = proof.get(\"formats\") or []\n/Users/aazhiry1/work/src/cli-agent-bridge/server.py:1244:    if not set(types).issubset(set(formats)):\n/Users/aazhiry1/work/src/cli-agent-bridge/server.py:1245:        return \"formats\"\n/Users/aazhiry1/work/src/cli-agent-bridge/server.py:1563:    allowed = [str(t).lower() for t in (limits.get(\"max_types\") or [])]","correlation_facts":{"tool_name":"search","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c547","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":254,"recorded_at":1780531400000503,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd638a376ad8533ec32093637ac","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/bridge_testlib.py`.\n1|\"\"\"Общая библиотека тестов моста droid-bridge (не собирается как тесты).\n2|\n3|Фейковый droid (настоящий subprocess со stream-jsonrpc, tests/fake_droid.py) и\n4|его хаб, базовый HTTP-класс на свободном порту и сборщики запросов к image-пути.\n5|Сеть — только петлевой сокет тестового сервера; реальный droid не вызывается.\n6|\"\"\"\n7|\n8|import base64\n9|import copy\n10|import http.client\n11|import json\n12|import os\n13|import socket\n14|import sys\n15|import tempfile\n16|import threading\n17|import time\n18|import unittest\n19|\n20|from contextlib import contextmanager\n21|from http.server import ThreadingHTTPServer\n22|from pathlib import Path\n23|\n24|sys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n25|\n26|import server  # noqa: E402\n27|\n28|TOOLS = [\n29|    {\n30|        \"type\": \"function\",\n31|        \"function\": {\n32|            \"name\": \"get_weather\",\n33|            \"description\": \"Get current weather\",\n34|            \"parameters\": {\n35|                \"type\": \"object\",\n36|                \"properties\": {\"city\": {\"type\": \"string\"}},\n37|            },\n38|        },\n39|    }\n40|]\n41|\n42|PNG_MAGIC = b\"\\x89PNG\\r\\n\\x1a\\n\"\n43|JPEG_MAGIC = b\"\\xff\\xd8\\xff\\xe0\"\n44|GIF_MAGIC = b\"GIF89a\"\n45|WEBP_MAGIC = b\"RIFF\\x00\\x00\\x00\\x00WEBPVP8 \"\n46|\n47|\n48|def make_png(size=64):\n49|    \"\"\"PNG-подобные байты (сигнатура + нули) заданного размера.\"\"\"\n50|    return PNG_MAGIC + b\"\\x00\" * max(0, size - len(PNG_MAGIC))\n51|\n52|\n53|def make_sig(magic, size=64):\n54|    return magic + b\"\\x00\" * max(0, size - len(magic))\n55|\n56|\n57|def data_url(raw, mime=\"image/png\"):\n58|    return \"data:%s;base64,%s\" % (mime, base64.b64encode(raw).decode())\n59|\n60|\n61|def text_part(text):\n62|    return {\"type\": \"text\", \"text\": text}\n63|\n64|\n65|def image_part(raw, mime=\"image/png\"):\n66|    return {\"type\": \"image_url\", \"image_url\": {\"url\": data_url(raw, mime)}}\n67|\n68|\n69|def image_url_part(url):\n70|    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n71|\n72|\n73|def chat_body(model=None, effort=None, content=None, messages=None, **extra):\n74|    body = {\n75|        \"messages\": messages\n76|        if messages is not None\n77|        else [{\"role\": \"user\", \"content\": content if content is not None else \"hi\"}]\n78|    }\n79|    if model is not None:\n80|        body[\"model\"] = model\n81|    if effort is not None:\n82|        body[\"reasoning_effort\"] = effort\n83|    body.update(extra)\n84|    return body\n85|\n86|\n87|def load_raw_fleet():\n88|    \"\"\"Сырой JSON каталога (без нормализации) для сборки стендовых каталогов.\"\"\"\n89|    return json.loads(Path(server.FLEET_PATH).read_text(encoding=\"utf-8\"))\n90|\n91|\n92|# Модели, которые стенд FakeDroid обслуживает через бэкенд droid (боевой fleet.json\n93|# переведён на единый мост :9882, Droid там выключен).\n94|_DROID_STAND_MODELS = (\"claude-sonnet-5-5\", \"deepseek-v4.1-flash\", \"gemini-3.8-flash\")\n95|_DROID_LEGACY_MODELS = (\n96|    {\n97|        \"id\": \"grok-4.7\",\n98|        \"backend\": \"droid\",\n99|        \"name\": \"Grok 4.7 (Droid test stand)\",\n100|        \"efforts\": [\"high\"],\n101|        \"default_effort\": \"high\",\n102|        \"context_window\": 256000,\n103|        \"max_tokens\": 32768,\n104|        \"input\": [\"text\"],\n105|        \"images\": {\n106|            \"cli_registry\": \"explicit_supported\",\n107|            \"status\": \"unverified\",\n108|            \"method\": None,\n109|            \"proof\": None,\n110|        },\n111|    },\n112|    {\n113|        \"id\": \"glm-5.3\",\n114|        \"backend\": \"droid\",\n115|        \"name\": \"GLM-5.3 (Droid test stand)\",\n116|        \"efforts\": [\"max\"],\n117|        \"default_effort\": \"max\",\n118|        \"context_window\": 1000000,\n119|        \"max_tokens\": 131072,\n120|        \"input\": [\"text\"],\n121|        \"images\": {\n122|            \"cli_registry\": \"explicit_unsupported\",\n123|            \"status\": \"unsupported\",\n124|            \"method\": None,\n125|            \"proof\": None,\n126|        },\n127|    },\n128|)\n129|\n130|\n131|_ORIG_CONTEXT_MAX_OUTPUT = server._context_max_output\n132|\n133|\n134|def _stand_context_max_output(model_id: str) -> int:\n135|    \"\"\"max_tokens стендовых legacy-моделей (в боевом fleet.json их уже нет).\"\"\"\n136|    for legacy in _DROID_LEGACY_MODELS:\n137|        if legacy[\"id\"] == model_id:\n138|            return legacy[\"max_tokens\"]\n139|    return _ORIG_CONTEXT_MAX_OUTPUT(model_id)\n140|\n141|\n142|def droidify_raw_fleet(data):\n143|    \"\"\"Сырой каталог -> стенд FakeDroid: droid включён, тестовые модели на droid.\"\"\"\n144|    data[\"backends\"][\"droid\"][\"enabled\"] = True\n145|    present = {m[\"id\"] for m in data[\"models\"]}\n146|    for m in data[\"models\"]:\n147|        if m[\"id\"] in _DROID_STAND_MODELS:\n148|            m[\"backend\"] = \"droid\"\n149|    for legacy in _DROID_LEGACY_MODELS:\n150|        if legacy[\"id\"] not in present:\n151|            data[\"models\"].append(copy.deepcopy(legacy))\n152|    return data\n153|\n154|\n155|def install_droid_stand(data=None):\n156|    \"\"\"Собрать стендовый каталог и пересоздать server.BACKENDS под него.\"\"\"\n157|    if data is None:\n158|        data = droidify_raw_fleet(load_raw_fleet())\n159|    catalog = server._build_catalog(data)\n160|    for key in (\"path\", \"sha256\"):  # метаданные загрузки живого fleet.json\n161|        if key in server.FLEET:\n162|            catalog.setdefault(key, server.FLEET[key])\n163|    server.FLEET = catalog\n164|    server._context_max_output = _stand_context_max_output\n165|    server.BACKENDS = server.AdapterRegistry.from_fleet(\n166|        server.FLEET, server.ADAPTER_KINDS, lambda: server.FLEET, server\n167|    )\n168|    return server.FLEET\n169|\n170|\n171|def find_model(data, model_id):\n172|    for item in data[\"models\"]:\n173|        if item[\"id\"] == model_id:\n174|            return item\n175|    raise KeyError(model_id)\n176|\n177|\n178|def make_proof(\n179|    binary_path,\n180|    efforts_proven,\n181|    impl_version=1,\n182|    method=\"workspace-read\",\n183|    formats=(\"image/png\",),\n184|    droid_version=\"0.0.0-test\",\n185|):\n186|    import hashlib\n187|\n188|    digest = hashlib.sha256(Path(binary_path).read_bytes()).hexdigest()\n189|    return {\n190|        \"droid_version\": droid_version,\n191|        \"droid_binary_sha256\": digest,\n192|        \"method\": method,\n193|        \"impl_version\": impl_version,\n194|        \"formats\": list(formats),\n195|        \"efforts_proven\": list(efforts_proven),\n196|        \"verified_at\": \"test\",\n197|        \"census_sha256\": \"0\" * 64,\n198|        \"census_ref\": \"test\",\n199|    }\n200|\n201|\n202|FAKE_DROID = Path(__file__).resolve().parent / \"fake_droid.py\"\n203|TEST_FACTORY_KEY = (\n204|    \"bridge-test-factory-key-not-real\"  # то же значение, что ждёт fake_droid\n205|)\n206|_MISSING = object()\n207|\n208|\n209|def legacy_scenario(events):\n210|    \"\"\"Старый сценарий FakeRun (text/reasoning/result/stderr/done) -> сценарий fake_droid.\"\"\"\n211|    steps = []\n212|    usage = {}\n213|    silent = not events\n214|    for ev in events:\n215|        kind = ev[0]\n216|        if kind == \"text\":\n217|            steps.append({\"op\": \"text\", \"text\": ev[1]})\n218|        elif kind == \"reasoning\":\n219|            steps.append({\"op\": \"thinking\", \"text\": ev[1]})\n220|        elif kind == \"result\":\n221|            raw = (ev[1] or {}).get(\"usage\") or {}\n222|            usage = {\n223|                \"inputTokens\": raw.get(\"input_tokens\", 0),\n224|                \"outputTokens\": raw.get(\"output_tokens\", 0),\n225|            }\n226|        elif kind == \"stderr\":\n227|            steps.append({\"op\": \"exit\", \"rc\": 1, \"stderr\": ev[1]})\n228|        elif (\n229|            kind == \"done\"\n230|            and ev[1][0] != 0\n231|            and not any(s[\"op\"] == \"exit\" for s in steps)\n232|        ):\n233|            steps.append({\"op\": \"exit\", \"rc\": ev[1][0]})\n234|    if silent:\n235|        steps.append({\"op\": \"hang\"})\n236|    return {\"steps\": steps, \"usage\": usage}\n237|\n238|\n239|def make_receipt(image_path, digest, **override):\n240|    \"\"\"Receipt schema 2 для fake_droid (протокол по умолчанию fake): тесты ломают по одному компоненту.\"\"\"\n241|    import fake_droid\n242|\n243|    ids = list(fake_droid.DEFAULT_TOOLS)\n244|    receipt = {\n245|        \"schema\": server.RECEIPT_SCHEMA,\n246|        \"image_path\": str(image_path),\n247|        \"image_sha256\": digest,\n248|        \"protocol\": {\n249|            \"api_version\": server.RPC_API_VERSION,\n250|            \"protocol_version\": fake_droid.PROTOCOL,\n251|        },\n252|        \"tools_policy\": {\n253|            \"policy\": server.TOOLS_POLICY,\n254|            \"disabled_tool_ids\": sorted(ids),\n255|            \"digest\": server.tools_policy_digest(ids),\n256|        },\n257|        \"settings_profile\": {\n258|            \"profile\": dict(server.SETTINGS_PROFILE),\n259|            \"digest\": server.settings_profile_digest(),\n260|        },\n261|        \"probes\": {name: \"ok\" for name in server.RECEIPT_PROBES},\n262|    }\n263|    receipt.update(override)\n264|    return receipt\n265|\n266|\n267|class FakeDroidHub:\n268|    \"\"\"Каталог управления fake_droid: конфиг, очередь сценариев, журнал процессов.\"\"\"\n269|\n270|    def __init__(self, base):\n271|        self.base = Path(base)\n272|        self.base.mkdir(parents=True, exist_ok=True)\n273|        self.config = {}\n274|        self.launcher = self.base / \"fake-launcher\"\n275|        self.launcher.write_text(\n276|            \"#!%s\\nimport sys\\nsys.path.insert(0, %r)\\nimport fake_droid\\nfake_droid.main(sys.argv[1:])\\n\"\n277|            % (sys.executable, str(FAKE_DROID.parent)),\n278|            encoding=\"utf-8\",\n279|        )\n280|        self.launcher.chmod(0o755)\n281|        self._flush()\n282|\n283|    def _flush(self):\n284|        (self.base / \"config.json\").write_text(\n285|            json.dumps(self.config), encoding=\"utf-8\"\n286|        )\n287|\n288|    def configure(self, **cfg):\n289|        self.config.update(cfg)\n290|        self._flush()\n291|\n292|    def script(self, scenarios):\n293|        \"\"\"Добавить сценарии ходов (по одному на запущенный цикл, глобально по очереди).\"\"\"\n294|        scripted = self.config.setdefault(\"scenarios\", [])\n295|        counter = self.base / \"turn.counter\"\n296|        claimed = int(counter.read_text() or 0) if counter.exists() else 0\n297|        while (\n298|            len(scripted) < claimed\n299|        ):  # ходы без сценария уже взяли значение по умолчанию\n300|            scripted.append(None)\n301|        scripted.extend(scenarios)\n302|        self._flush()\n303|\n304|    def legacy(self, scripts):\n305|        self.script([legacy_scenario(ev) for ev in scripts])\n306|\n307|    def records(self):\n308|        path = self.base / \"log.jsonl\"\n309|        if not path.exists():\n310|            return []\n311|        return [\n312|            json.loads(line)\n313|            for line in path.read_text(encoding=\"utf-8\").splitlines()\n314|            if line.strip()\n315|        ]\n316|\n317|    def spawns(self):\n318|        return [r for r in self.records() if r[\"ev\"] == \"spawn\"]\n319|\n320|    def rpcs(self, method=None):\n321|        return [\n322|            r\n323|            for r in self.records()\n324|            if r[\"ev\"] == \"rpc\" and (method is None or r[\"method\"] == method)\n325|        ]\n326|\n327|    def admissions(self):\n328|        \"\"\"Принятые циклы agent loop (add_user_message без skipAgentLoop): аналог Run.instances.\"\"\"\n329|        return [\n330|            r\n331|            for r in self.rpcs(\"droid.add_user_message\")\n332|            if not r[\"params\"].get(\"skipAgentLoop\")\n333|        ]\n334|\n335|    def inits(self):\n336|        return self.rpcs(\"droid.initialize_session\")\n337|\n338|    def sent_texts(self):\n339|        return [\n340|            r[\"params\"].get(\"text\", \"\") for r in self.rpcs(\"droid.add_user_message\")\n341|        ]\n342|\n343|    def exits(self):\n344|        return [r for r in self.records() if r[\"ev\"] == \"exit\"]\n345|\n346|\n347|def wait_until(predicate, timeout=10.0, step=0.05):\n348|    \"\"\"Ждать условие (закрытие процессов асинхронно).\"\"\"\n349|    end = time.time() + timeout\n350|    while time.time() < end:\n351|        if predicate():\n352|            return True\n353|        time.sleep(step)\n354|    return predicate()\n355|\n356|\n357|def pid_alive(pid):\n358|    try:\n359|        os.kill(pid, 0)\n360|    except ProcessLookupError:\n361|        return False\n362|    except PermissionError:\n363|        return True\n364|    return True\n365|\n366|\n367|class BridgeCase(unittest.TestCase):\n368|    \"\"\"Сервер на свободном порту с подменённым Run и временным workspace.\"\"\"\n369|\n370|    def setUp(self):\n371|        self._saved = {\n372|            name: getattr(server, name, _MISSING)\n373|            for name in (\n374|                \"AUTH_KEY\",\n375|                \"WORKSPACE\",\n376|                \"FLEET\",\n377|                \"IMAGE_PROBE\",\n378|                \"LAUNCHER\",\n379|                \"_budget\",\n380|                \"MODEL_ID\",\n381|                \"_sleep\",\n382|                \"INTERRUPT_GRACE_S\",\n383|                \"RPC_CALL_TIMEOUT_S\",\n384|                \"SILENCE_WATCHDOG_S\",\n385|                \"FIRST_TOKEN_TIMEOUT_S\",\n386|                \"TIMEOUT_S\",\n387|                \"_clock\",\n388|                \"IDLE_SECONDS\",\n389|                \"RECEIPT_REQUIRED\",\n390|                \"MAX_RPC_LINE_BYTES\",\n391|                \"MAX_STDERR_BYTES\",\n392|                \"MAX_INBOX_BYTES\",\n393|                \"MAX_TURN_TEXT_BYTES\",\n394|                \"MAX_CHATS\",\n395|                \"MAX_CONCURRENT\",\n396|                \"INSTR_BLOCK_LIMIT\",\n397|                \"FINISHED_TURNS_KEEP\",\n398|                \"DELIVERY_CHUNK_BYTES\",\n399|                \"ENTRY_OVERHEAD_BYTES\",\n400|                \"GUARD\",\n401|                \"GUARD_PROFILES_DIR\",\n402|                \"GUARD_CANON\",\n403|                \"INSTR_NONKB_MARGIN\",\n404|                \"MAX_JSON_STRUCT_TOKENS\",\n405|                \"BACKENDS\",\n406|                \"_context_max_output\",\n407|            )\n408|        }\n409|        server._canon_seen.clear()\n410|        # Реальный FACTORY_API_KEY рабочего окружения в тестах не используется: подставляем\n411|        # фиктивный sentinel; восстановление через addCleanup срабатывает и при падении теста.\n412|        self._env_factory_key = os.environ.get(\"FACTORY_API_KEY\")\n413|        self.addCleanup(self._restore_factory_key)\n414|        os.environ[\"FACTORY_API_KEY\"] = TEST_FACTORY_KEY\n415|        self._env_fake = os.environ.get(\"FAKE_DROID_DIR\")\n416|        self._tmp = tempfile.TemporaryDirectory()\n417|        self.hub = FakeDroidHub(Path(self._tmp.name) / \"fake\")\n418|        os.environ[\"FAKE_DROID_DIR\"] = str(self.hub.base)\n419|        server.LAUNCHER = str(self.hub.launcher)\n420|        server.AUTH_KEY = \"test-key\"\n421|        server.WORKSPACE = Path(self._tmp.name) / \"workspace\"\n422|        server.WORKSPACE.mkdir(parents=True, exist_ok=True)\n423|        server._budget = None\n424|        # Охранник B: реальные профили/канон владельца в тестах не читаются (пустые пути под tmp).\n425|        if hasattr(server, \"InstructionGuard\"):\n426|            server.GUARD = server.InstructionGuard()\n427|            server.GUARD_PROFILES_DIR = str(Path(self._tmp.name) / \"profiles-none\")\n428|            server.GUARD_CANON = str(Path(self._tmp.name) / \"canon-none.md\")\n429|            server._canon_cache.update(key=None, digest=\"\")\n430|        # Предел блока KB (ADR 0015: боевое умолчание 100 000 Б): сценарии отказа RW-009/RW-014\n431|        # проверяют границу 60 000 Б, поэтому предел фиксируется явно, а не берётся из окружения.\n432|        server.INSTR_BLOCK_LIMIT = 60000\n433|        server.RECEIPT_REQUIRED = (\n434|            False  # receipt квалификации образа: отдельные тесты RW-007 включают\n435|        )\n436|        server._sleep = lambda _seconds: None  # ретраи 2/4 с — без реального ожидания\n437|        server.INTERRUPT_GRACE_S = 1.0\n438|        server._reset_rpc_state()\n439|        install_droid_stand()\n440|        self.httpd = ThreadingHTTPServer((\"127.0.0.1\", 0), server.Handler)\n441|        self.httpd.daemon_threads = True\n442|        self.port = self.httpd.server_address[1]\n443|        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()\n444|\n445|    def tearDown(self):\n446|        self.httpd.shutdown()\n447|        self.httpd.server_close()\n448|        server._reset_rpc_state()\n449|        for name, value in self._saved.items():\n450|            if value is _MISSING:\n451|                if hasattr(server, name):\n452|                    delattr(server, name)\n453|            else:\n454|                setattr(server, name, value)\n455|        if self._env_fake is None:\n456|            os.environ.pop(\"FAKE_DROID_DIR\", None)\n457|        else:\n458|            os.environ[\"FAKE_DROID_DIR\"] = self._env_fake\n459|        self._tmp.cleanup()\n460|\n461|    def _restore_factory_key(self):\n462|        if self._env_factory_key is None:\n463|            os.environ.pop(\"FACTORY_API_KEY\", None)\n464|        else:\n465|            os.environ[\"FACTORY_API_KEY\"] = self._env_factory_key\n466|\n467|    # -- helpers ----------------------------------------------------------------\n468|    def _post(self, body: dict, timeout: float = 60.0):\n469|        conn = http.client.HTTPConnection(\"127.0.0.1\", self.port, timeout=timeout)\n470|        try:\n471|            conn.request(\n472|                \"POST\",\n473|                \"/v1/chat/completions\",\n474|                body=json.dumps(body),\n475|                headers={\n476|                    \"Authorization\": \"Bearer [REDACTED]\",\n477|                    \"Content-Type\": \"application/json\",\n478|                },\n479|            )\n480|            resp = conn.getresponse()\n481|            raw = resp.read().decode(\"utf-8\")\n482|            return resp.status, raw\n483|        finally:\n484|            conn.close()\n485|\n486|    def _post_json(self, body: dict, timeout: float = 60.0):\n487|        status, raw = self._post(body, timeout=timeout)\n488|        return status, (json.loads(raw) if raw else None)\n489|\n490|    def _get(self, path: str, auth: bool = True):\n491|        conn = http.client.HTTPConnection(\"127.0.0.1\", self.port, timeout=30)\n492|        try:\n493|            headers = {\"Authorization\": \"Bearer [REDACTED]\"} if auth else {}\n494|            conn.request(\"GET\", path, headers=headers)\n495|            resp = conn.getresponse()\n496|            raw = resp.read().decode(\"utf-8\")\n497|            return resp.status, (json.loads(raw) if raw else None)\n498|        finally:\n499|            conn.close()\n500|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
