{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"task_stream":{"kind":"task","id":"01a19cd5-f468-7c80-a351-65e477177eb6"},"task_id":"01a19cd5-f468-7c80-a351-65e477177eb6","event":{"kind":"output","task_id":"01a19cd5-f468-7c80-a351-65e477177eb6","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/server.py`.\n(1484 line(s) above)\n1485|    \"\"\"Отказ image-пути с типом из таксономии C-10.\"\"\"\n1486|\n1487|    def __init__(self, reason: str):\n1488|        super().__init__(reason)\n1489|        self.reason = reason\n1490|\n1491|\n1492|def _sniff_image(data: bytes) -> str:\n1493|    \"\"\"MIME по магическим байтам ('' — сигнатура неизвестна).\"\"\"\n1494|    for prefix, mime in IMAGE_SIGNATURES:\n1495|        if data.startswith(prefix):\n1496|            return mime\n1497|    if data[:4] == b\"RIFF\" and data[8:12] == b\"WEBP\":\n1498|        return \"image/webp\"\n1499|    return \"\"\n1500|\n1501|\n1502|def _collect_image_parts(messages: Any) -> list:\n1503|    \"\"\"Все image-части сообщений с их ролью, по порядку истории.\"\"\"\n1504|    found = []\n1505|    if not isinstance(messages, list):\n1506|        return found\n1507|    for msg in messages:\n1508|        if not isinstance(msg, dict):\n1509|            continue\n1510|        content = msg.get(\"content\")\n1511|        if not isinstance(content, list):\n1512|            continue\n1513|        for item in content:\n1514|            if isinstance(item, dict) and item.get(\"type\") == \"image_url\":\n1515|                found.append((str(msg.get(\"role\") or \"\"), item))\n1516|    return found\n1517|\n1518|\n1519|def _parse_data_url(url: str) -> tuple:\n1520|    \"\"\"data-URL -> (mime, bytes); ошибки — ImageReject из таксономии C-10.\"\"\"\n1521|    comma = url.find(\",\")\n1522|    if comma == -1:\n1523|        raise ImageReject(\"invalid_image_content\")\n1524|    head = url[5:comma]\n1525|    payload = url[comma + 1 :]\n1526|    fields = [f.strip().lower() for f in head.split(\";\")]\n1527|    mime = fields[0] if fields else \"\"\n1528|    if not mime or \"base64\" not in fields[1:]:\n1529|        raise ImageReject(\"invalid_image_content\")\n1530|    if mime not in KNOWN_IMAGE_MIMES:\n1531|        raise ImageReject(\"unsupported_image_type\")\n1532|    if not payload:\n1533|        raise ImageReject(\"invalid_image_base64\")\n1534|    try:\n1535|        data = base64.b64decode(payload, validate=True)\n1536|    except (binascii.Error, ValueError):\n1537|        raise ImageReject(\"invalid_image_base64\")\n1538|    return mime, data\n1539|\n1540|\n1541|def _collect_images(request: dict, model: dict, effort: str) -> list:\n1542|    \"\"\"Проверить изображения запроса (C-08); [] — изображений нет.\n1543|\n1544|    Порядок: применимость модели/proof (класс II) -> форма частей -> data-URL ->\n1545|    сигнатура -> формат -> лимиты (число, размер, сумма).\n1546|    \"\"\"\n1547|    messages = request.get(\"messages\")\n1548|    parts = _collect_image_parts(messages)\n1549|    if not parts:\n1550|        return []\n1551|    status = (model.get(\"images\") or {}).get(\"status\")\n1552|    capable = status == \"confirmed\" or (status == \"probe\" and IMAGE_PROBE)\n1553|    if not capable:\n1554|        raise ImageReject(\"image_input_not_supported\")\n1555|    reason = _image_proof_reason(model, effort)\n1556|    if reason:\n1557|        _log(f\"image_proof_invalid model={model.get('id')} reason={reason}\")\n1558|        raise ImageReject(\"image_input_not_supported\")\n1559|    limits = FLEET.get(\"image_limits\") or {}\n1560|    max_images = int(limits.get(\"max_images\") or 0)\n1561|    max_image_bytes = int(limits.get(\"max_image_bytes\") or 0)\n1562|    max_total = int(limits.get(\"max_total_image_bytes\") or 0)\n1563|    allowed = [str(t).lower() for t in (limits.get(\"max_types\") or [])]\n1564|    images = []\n(more lines below)","final_result":true}}}
