{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"task_stream":{"kind":"task","id":"01a19cd9-07d1-7410-a5c4-d3c7caeb2109"},"task_id":"01a19cd9-07d1-7410-a5c4-d3c7caeb2109","event":{"kind":"output","task_id":"01a19cd9-07d1-7410-a5c4-d3c7caeb2109","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(1224 line(s) above)\n1225|def _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n1226|    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n1227|\n1228|    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n1229|    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n1230|    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n1231|    \"\"\"\n1232|    containers: list[dict[str, Any]] = [ev]\n1233|    messages: list[str] = []\n1234|    err = ev.get(\"error\")\n1235|    if isinstance(err, dict):\n1236|        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n1237|    elif isinstance(err, str):\n1238|        messages.append(err)\n1239|    part = _dict_or_empty(ev.get(\"part\"))\n1240|    if part:\n1241|        part_err = _dict_or_empty(part.get(\"error\"))\n1242|        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n1243|    status: int | None = None\n1244|    for container in containers:\n1245|        if status is None:\n1246|            for key in (\"statusCode\", \"status_code\", \"status\"):\n1247|                value = container.get(key)\n1248|                if isinstance(value, int) and not isinstance(value, bool):\n1249|                    status = value\n1250|                    break\n1251|        for key in (\"message\", \"error\"):\n1252|            value = container.get(key)\n1253|            if isinstance(value, str):\n1254|                messages.append(value)\n1255|    if status in _FATAL_STREAM_STATUSES:\n1256|        return False\n1257|    if status is None or status in (0, 408, 429) or status >= 500:\n1258|        return True\n1259|    low = \" \".join(messages).lower()\n1260|    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n1261|\n1262|\n1263|def _step_recovery_disabled() -> bool:\n1264|    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n1265|    return not STEP_RECOVERY_ENABLED or os.environ.get(\n1266|        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n1267|    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n1268|\n1269|\n(more lines below)","final_result":true}}}
