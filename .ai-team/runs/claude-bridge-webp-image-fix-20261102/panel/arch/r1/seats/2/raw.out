               status = value\n1250|                    break\n1251|        for key in (\"message\", \"error\"):\n1252|            value = container.get(key)\n1253|            if isinstance(value, str):\n1254|                messages.append(value)\n1255|    if status in _FATAL_STREAM_STATUSES:\n1256|        return False\n1257|    if status is None or status in (0, 408, 429) or status >= 500:\n1258|        return True\n1259|    low = \" \".join(messages).lower()\n1260|    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n1261|\n1262|\n1263|def _step_recovery_disabled() -> bool:\n1264|    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n1265|    return not STEP_RECOVERY_ENABLED or os.environ.get(\n1266|        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n1267|    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n1268|\n1269|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
