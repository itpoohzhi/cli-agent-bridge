{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a1","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":427,"recorded_at":1780531400000849,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"task_stream":{"kind":"task","id":"01a19cd7-778c-7721-bcca-2e7dc09a57f4"},"task_id":"01a19cd7-778c-7721-bcca-2e7dc09a57f4","event":{"kind":"output","task_id":"01a19cd7-778c-7721-bcca-2e7dc09a57f4","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(3059 line(s) above)\n3060|        return self.total_spawns < limit\n3061|\n3062|    def remaining_s(self) -> float:\n3063|        return max(0.0, self.deadline - time.monotonic())\n3064|\n3065|    def begin_attempt(self) -> bool:\n3066|        \"\"\"Первичный запуск: потолок, deadline и Circuit Breaker (в HALF_OPEN резервирует единственную пробу).\"\"\"\n3067|        return (\n3068|            self.can_spawn()\n3069|            and time.monotonic() < self.deadline\n3070|            and (not self.use_breaker or self.res.breaker.allow())\n3071|        )\n3072|\n3073|    def allow_quota_rotation(self, reason: str = \"free_quota_proxy_rotate\") -> bool:\n3074|        \"\"\"Разрешить смену прокси без списания бюджета деградации апстрима.\"\"\"\n3075|        if self.quota_rotations >= self.max_quota_rotations:\n3076|            return False\n3077|        if (\n3078|            self.total_spawns\n3079|            >= min(MAX_TOTAL_SPAWNS, self.max_total) + self.quota_rotations\n3080|        ):\n3081|            return False\n3082|        if time.monotonic() >= self.deadline or self.aux_budget.exhausted():\n3083|            return False\n3084|        if self.use_breaker and self.res.breaker.is_blocking():\n3085|            return False\n3086|        if self.use_breaker and not self.res.breaker.allow():\n3087|            return False\n3088|        self.quota_rotations += 1\n3089|        self._next_spawn_reason = reason\n3090|        return True\n3091|\n3092|    def allow_retry(self, reason: str, charge_budget: bool = True) -> bool:\n3093|        \"\"\"Можно ли сделать повторный запуск: потолок, deadline, breaker, Retry Budget; затем Full Jitter пауза.\n3094|\n3095|        charge_budget=False — локальный отказ старта CLI без обращения к провайдеру («database is locked»):\n3096|        он не нагружает апстрим, ограничен FAIL_RETRY_LIMIT, MAX_TOTAL_SPAWNS и темпом запусков.\n3097|        \"\"\"\n3098|        if self.total_spawns >= self.max_total:\n3099|            _log(f\"retry denied ({reason}): MAX_TOTAL_SPAWNS={self.max_total} reached\")\n(more lines below)","final_result":true}}}
