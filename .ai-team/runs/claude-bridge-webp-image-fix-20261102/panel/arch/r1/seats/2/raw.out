pt_status_429\"\n4925|                    result[\"transient_error\"] = True\n4926|                    return result\n4927|                if 500 <= _ps <= 599:\n4928|                    result[\"exit_reason\"] = f\"prompt_status_{_ps}\"\n4929|                    return result\n4930|            _prompt_err = prompt_status.get(\"error\")\n4931|            if isinstance(_prompt_err, str):\n4932|                _has_delivery = _is_delivered()\n4933|                if not _has_delivery:\n4934|                    raise ServeUnavailable(f\"serve prompt failed: {_prompt_err}\")\n4935|                result[\"delivered\"] = True\n4936|                result[\"exit_reason\"] = \"prompt_error\"\n4937|                result[\"transient_error\"] = True\n4938|                return result\n4939|            if thinking_enabled and on_status is not None and now >= status_next:\n4940|                if result[\"first_token_at\"] is None:\n4941|                    on_status(\n4942|                        STATUS_INITIAL if _status_emitted[0] == 0 else STATUS_WAITING\n4943|                    )\n4944|                    _status_emitted[0] += 1\n4945|                    status_next = now + STATUS_WAITING_INTERVAL_S\n4946|                elif now - last_token_at >= float(STALL_HEARTBEAT_INTERVAL_S):\n4947|                    on_status(STATUS_CONTINUATION)\n4948|                    status_next = now + float(STALL_HEARTBEAT_INTERVAL_S)\n4949|            try:\n(more lines below)","final_result":true}}}
