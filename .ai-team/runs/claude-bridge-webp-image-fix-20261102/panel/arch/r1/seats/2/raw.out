ки — ImageReject из таксономии C-10.\"\"\"\n1521|    comma = url.find(\",\")\n1522|    if comma == -1:\n1523|        raise ImageReject(\"invalid_image_content\")\n1524|    head = url[5:comma]\n1525|    payload = url[comma + 1 :]\n1526|    fields = [f.strip().lower() for f in head.split(\";\")]\n1527|    mime = fields[0] if fields else \"\"\n1528|    if not mime or \"base64\" not in fields[1:]:\n1529|        raise ImageReject(\"invalid_image_content\")\n1530|    if mime not in KNOWN_IMAGE_MIMES:\n1531|        raise ImageReject(\"unsupported_image_type\")\n1532|    if not payload:\n1533|        raise ImageReject(\"invalid_image_base64\")\n1534|    try:\n1535|        data = base64.b64decode(payload, validate=True)\n1536|    except (binascii.Error, ValueError):\n1537|        raise ImageReject(\"invalid_image_base64\")\n1538|    return mime, data\n1539|\n1540|\n1541|def _collect_images(request: dict, model: dict, effort: str) -> list:\n1542|    \"\"\"Проверить изображения запроса (C-08); [] — изображений нет.\n1543|\n1544|    Порядок: применимость модели/proof (класс II) -> форма частей -> data-URL ->\n1545|    сигнатура -> формат -> лимиты (число, размер, сумма).\n1546|    \"\"\"\n1547|    messages = request.get(\"messages\")\n1548|    parts = _collect_image_parts(messages)\n1549|    if not parts:\n1550|        return []\n1551|    status = (model.get(\"images\") or {}).get(\"status\")\n1552|    capable = status == \"confirmed\" or (status == \"probe\" and IMAGE_PROBE)\n1553|    if not capable:\n1554|        raise ImageReject(\"image_input_not_supported\")\n1555|    reason = _image_proof_reason(model, effort)\n1556|    if reason:\n1557|        _log(f\"image_proof_invalid model={model.get('id')} reason={reason}\")\n1558|        raise ImageReject(\"image_input_not_supported\")\n1559|    limits = FLEET.get(\"image_limits\") or {}\n1560|    max_images = int(limits.get(\"max_images\") or 0)\n1561|    max_image_bytes = int(limits.get(\"max_image_bytes\") or 0)\n1562|    max_total = int(limits.get(\"max_total_image_bytes\") or 0)\n1563|    allowed = [str(t).lower() for t in (limits.get(\"max_types\") or [])]\n1564|    images = []\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ef","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":210,"recorded_at":1780531400000415,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd5eabc70f6a04340789e8f1343","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_opencode_zen_bridge.py`.\n(299 line(s) above)\n300|    now[0] = 120.0\n301|    assert bridge._next_standalone_proxy() == p1\n302|    assert not bridge._proxy_quarantine_until\n303|    bridge._quarantine_proxy(p1)\n304|    bridge._reset_proxy_pool_for_tests()\n305|    assert not bridge._proxy_quarantine_until\n306|\n307|\n308|@pytest.mark.parametrize(\n309|    \"err, expected\",\n310|    [\n311|        ({\"type\": \"provider.free-limit\", \"message\": \"Quota\"}, True),\n312|        ({\"message\": \"Free usage limit reached\"}, True),\n313|        (\"USAGE LIMIT REACHED\", True),\n314|        (\"provider.free-limit\", True),\n315|        ({\"message\": \"Connection lost\"}, False),\n316|        (None, False),\n317|    ],\n318|)\n319|def test_is_free_quota_error(bridge: Any, err: object, expected: bool) -> None:\n320|    assert bridge._is_free_quota_error(err) is expected\n321|\n322|\n323|def test_map_serve_event_preserves_quota_type(bridge: Any) -> None:\n324|    mapped = bridge._map_serve_event(\n325|        {\n326|            \"type\": \"session.execution.failed\",\n327|            \"data\": {\n328|                \"sessionID\": \"s1\",\n329|                \"error\": {\n330|                    \"type\": \"provider.free-limit\",\n331|                    \"message\": \"Quota\",\n332|                    \"status\": 429,\n333|                },\n334|            },\n335|        }\n336|    )\n337|    assert mapped == (\n338|        \"error\",\n339|        {\n340|            \"statusCode\": 429,\n341|            \"message\": \"Quota\",\n342|            \"type\": \"provider.free-limit\",\n343|            \"sessionID\": \"s1\",\n344|        },\n345|    )\n346|\n347|\n348|def test_quota_rotation_extends_spawn_limit_without_charging_retry_budget(\n349|    bridge: Any,\n350|) -> None:\n351|    attempts = _attempts(bridge, max_total=2, max_quota_rotations=1)\n352|    attempts.note_spawn()\n353|    assert attempts.allow_quota_rotation()\n354|    assert attempts.quota_rotations == 1 and attempts.retries == 0\n355|    attempts.res.retry_budget.try_acquire_retry.assert_not_called()\n356|    assert not attempts.allow_quota_rotation()\n357|    attempts.note_spawn()\n358|    assert attempts.can_spawn() and attempts.begin_attempt()\n359|    attempts.note_spawn()\n360|    assert not attempts.can_spawn() and not attempts.begin_attempt()\n361|\n362|\n363|@pytest.mark.parametrize(\"denial\", [\"limit\", \"deadline\", \"aux\", \"blocking\", \"probe\"])\n364|def test_denied_quota_rotation_does_not_change_counters(\n365|    bridge: Any, denial: str\n366|) -> None:\n367|    attempts = _attempts(bridge)\n368|    if denial == \"limit\":\n369|        attempts.total_spawns = bridge.MAX_TOTAL_SPAWNS\n370|    elif denial == \"deadline\":\n371|        attempts.deadline = 0\n372|    elif denial == \"aux\":\n373|        attempts.aux_budget = bridge._AuxIoBudget(budget_s=0)\n374|    elif denial == \"blocking\":\n375|        attempts.res.breaker.is_blocking = Mock(return_value=True)\n376|    else:\n377|        attempts.res.breaker.allow = Mock(return_value=False)\n378|    assert not attempts.allow_quota_rotation()\n379|    assert attempts.quota_rotations == 0 and attempts.retries == 0\n380|    attempts.res.retry_budget.try_acquire_retry.assert_not_called()\n381|\n382|\n383|@pytest.mark.parametrize(\"stream\", [True, False])\n384|def test_serve_quota_rotations_can_exceed_base_spawn_limit(\n385|    bridge: Any,\n386|    monkeypatch: pytest.MonkeyPatch,\n387|    stream: bool,\n388|) -> None:\n389|    handler = _handler(bridge)\n390|    attempts = _attempts(bridge, max_quota_rotations=3)\n391|    runner = _install_attempts(\n392|        bridge,\n393|        monkeypatch,\n394|        [\n395|            _quota_result(),\n396|            _quota_result(),\n397|            _quota_result(),\n398|            _result(texts=[\"Ответ\"]),\n399|        ],\n400|    )\n401|    if stream:\n402|        done, _, texts = _stream(handler, attempts, [])\n403|        assert done and \"\".join(texts) == \"Ответ\"\n404|        assert b'\"error\"' not in handler.wfile.getvalue()\n405|    else:\n406|        assert _json(handler, attempts)[\"content\"] == \"Ответ\"\n407|    assert runner.call_count == 4\n408|    assert attempts.quota_rotations == 3\n409|    attempts.res.retry_budget.try_acquire_retry.assert_not_called()\n410|    attempts.res.breaker.record_failure.assert_not_called()\n411|\n412|\n413|@pytest.mark.parametrize(\"explicit_proxy\", [None, \"http://explicit:10003\"])\n414|def test_serve_one_attempt_reports_proxy_and_overrides_all_proxy_vars(\n415|    bridge: Any,\n416|    monkeypatch: pytest.MonkeyPatch,\n417|    tmp_path: Path,\n418|    explicit_proxy: str | None,\n419|) -> None:\n420|    env = {name: \"http://inherited:10001\" for name in bridge._PROXY_VARS}\n421|    monkeypatch.setattr(bridge, \"_serve_env\", lambda _model: env)\n422|    spawn = Mock(side_effect=bridge.ServeStartupDeadlineExceeded(\"test\"))\n423|    monkeypatch.setattr(bridge, \"_spawn_serve\", spawn)\n424|    result = bridge._serve_one_attempt(\n425|        \"deepseek-v4.1-flash-free\",\n426|        \"Ответь\",\n427|        \"high\",\n428|        tmp_path,\n429|        Mock(),\n430|        Mock(),\n431|        Mock(),\n432|        time.monotonic(),\n433|        proxy_url=explicit_proxy,\n434|    )\n435|    assert result[\"proxy_url\"] == (explicit_proxy or \"http://inherited:10001\")\n436|    assert result[\"exit_reason\"] == \"timeout\"\n437|    assert {env[name] for name in bridge._PROXY_VARS} == {result[\"proxy_url\"]}\n438|    spawn.assert_called_once()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f1","stream":{"kind":"session","id":"01a19cd4-f141-76d2-b524-d58b1569914b"},"sequence":211,"recorded_at":1780531400000417,"record_type":"event","durability":"durable","causation_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808","run_stream":{"kind":"run","id":"01a19cd4-f68d-7f33-8c4c-3ce7c3538808"},"call_id":"call_01a19cd5ee6477409b7a6b4456f1eb54","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_claude_bridge.py`.\n(319 line(s) above)\n320|\n321|\n322|def test_image_extract_rejects_url_bad_base64_and_mismatch():\n323|    with pytest.raises(core_te.ImageInputError):\n324|        core_te.extract_data_url_images(\n325|            [\n326|                {\n327|                    \"role\": \"user\",\n328|                    \"content\": [\n329|                        {\"type\": \"image_url\", \"image_url\": {\"url\": \"https://x/y.png\"}}\n330|                    ],\n331|                }\n332|            ]\n333|        )\n334|    with pytest.raises(core_te.ImageInputError):\n335|        core_te.extract_data_url_images(\n336|            [\n337|                {\n338|                    \"role\": \"user\",\n339|                    \"content\": [\n340|                        {\n341|                            \"type\": \"image_url\",\n342|                            \"image_url\": {\"url\": \"data:image/png;base64,!!!\"},\n343|                        }\n344|                    ],\n345|                }\n346|            ]\n347|        )\n348|    with pytest.raises(core_te.ImageInputError):\n349|        core_te.extract_data_url_images(\n350|            [{\"role\": \"user\", \"content\": [_image_part(\"image/png\", GIF_BYTES)]}]\n351|        )\n352|    with pytest.raises(core_te.ImageInputError):\n353|        core_te.extract_data_url_images(\n354|            [{\"role\": \"user\", \"content\": [_image_part(), _image_part()]}], max_images=1\n355|        )\n356|\n357|\n358|def test_image_only_prompt_keeps_marker_not_pong():\n359|    messages = [{\"role\": \"user\", \"content\": [_image_part()]}]\n360|    images = core_te.extract_data_url_images(messages)\n361|    prompt = core_te._messages_to_prompt(messages, images=images)\n362|    assert \"[image 1]\" in prompt\n363|    assert \"[attachments]\" in prompt\n364|    assert \"PONG\" not in prompt\n365|\n366|\n367|# ---- AD-003/REQ-03: argv и workspace-read -----------------------------------------\n368|\n369|\n370|def test_workspace_cmd_read_and_add_dir_only_with_images(bridge):\n371|    cmd = bridge._build_claude_cmd(\n372|        \"claude-sonnet-5-5\", \"high\", Path(\"/tmp/claude-img-x\")\n373|    )\n374|    assert cmd[cmd.index(\"--tools\") + 1] == \"Read\"\n375|    assert cmd[cmd.index(\"--add-dir\") + 1] == \"/tmp/claude-img-x\"\n376|    plain = bridge._build_claude_cmd(\"claude-sonnet-5-5\", \"high\", None)\n377|    assert plain[plain.index(\"--tools\") + 1] == \"\"\n378|    assert \"--add-dir\" not in plain\n379|\n380|\n381|def test_workspace_image_staging_permissions_and_cleanup(http_bridge):\n382|    _bridge, port = http_bridge\n383|    FakeRun.script = _done_script((\"text\", \"вижу картинку\"))\n384|    status, body = _post(\n385|        port,\n386|        {\n387|            \"model\": \"claude-sonnet-5-5\",\n388|            \"stream\": False,\n389|            \"messages\": [\n390|                {\n391|                    \"role\": \"user\",\n392|                    \"content\": [{\"type\": \"text\", \"text\": \"что тут?\"}, _image_part()],\n393|                }\n394|            ],\n395|        },\n396|    )\n397|    assert status == 200, body\n398|    captured = FakeRun.captured\n399|    img_dir = captured[\"img_dir\"]\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
