ск/лончер проверяются до SSE и до любого запуска.\\n            adapter = BACKENDS.get(model[\\\"backend\\\"])\\n            ok, why = (\\n                (False, \\\"backend_disabled\\\") if adapter is None else adapter.preflight()\\n            )\\n            if not ok:\\n                self._reject(\\n                    503,\\n                    \\\"launcher_unavailable\\\",\\n\",\n  \"original_output_bytes\": 1332,\n  \"original_output_tokens\": 333,\n  \"truncated\": false\n}","final_result":true}}}
