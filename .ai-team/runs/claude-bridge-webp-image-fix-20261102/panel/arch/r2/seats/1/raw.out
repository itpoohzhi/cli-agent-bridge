.free-limit\\\",\\n80-            \\\"statusCode\\\": 429,\\n81-            \\\"message\\\": \\\"Free usage limit reached for this IP\\\",\\n82-        },\\n83-        transient_error=True,\\n84-        **overrides,\\n85-    )\\n86-\\n87-\\n88-def _install_attempts(\\n--\\n182:        _quota_result(),\\n183-        _result(texts=[\\\"Ответ\\\"]),\\n184-    ]\\n185-    runner = _install_attempts(bridge, monkeypatch, results, select_proxy=True)\\n186-    signal = Mock(side_effect=[2, 0])\\n187-    monkeypatch.setattr(bridge, \\\"_incomplete_step_signal\\\", signal)\\n188-    tools = [{\\\"type\\\": \\\"function\\\", \\\"function\\\": {\\\"name\\\": \\\"read\\\", \\\"parameters\\\": {}}}]\\n189-    done, xs, texts = _stream(handler, attempts, tools)\\n190-    assert done and xs[\\\"status\\\"] == 200\\n191-    assert runner.call_count == 3\\n192-    assert p1 in bridge._proxy_quarantine_until\\n193-    assert [result[\\\"proxy_url\\\"] for result in results] == [p2, p1, p2]\\n194-    assert \\\"\\\".join(texts) == \\\"Ответ\\\"\\n--\\n212:            _quota_result(\\n213-                reasonings=[\\\"Уникальное размышление\\\"], proxy_url=\\\"http://p1:10001\\\"\\n====\\n32:PNG_BYTES = b\\\"\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\\" + b\\\"\\\\x00\\\" * 16\\n33:JPEG_BYTES = b\\\"\\\\xff\\\\xd8\\\\xff\\\\xe0\\\" + b\\\"\\\\x00\\\" * 16\\n34:GIF_BYTES = b\\\"GIF89a\\\" + b\\\"\\\\x00\\\" * 16\\n59:def _image_part(mime: str = \\\"image/png\\\", data: bytes = PNG_BYTES) -> dict:\\n314:        {\\\"role\\\": \\\"user\\\", \\\"content\\\": [_image_part(\\\"image/jpeg\\\", JPEG_BYTES)]},\\n318:    assert images[0][\\\"data\\\"] == PNG_BYTES and images[0][\\\"mime\\\"] == \\\"image/png\\\"\\n319:    assert images[1][\\\"data\\\"] == JPEG_BYTES and images[1][\\\"mime\\\"] == \\\"image/jpeg\\\"\\n350:            [{\\\"role\\\": \\\"user\\\", \\\"content\\\": [_image_part(\\\"image/png\\\", GIF_BYTES)]}]\\n403:    assert captured[\\\"img_files\\\"][\\\"image_1.png\\\"][\\\"data\\\"] == PNG_BYTES\\n====\\n                    found.append((msg_index, number, part))\\n    return found\\n\\n\\ndef _sniff_image_type(raw: bytes) -> str | None:\\n    \\\"\\\"\\\"MIME по сигнатуре (не декодирование пикселей); None — формат неизвестен.\\\"\\\"\\\"\\n    if raw.startswith(b\\\"\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\\"):\\n        return \\\"image/png\\\"\\n    if raw.startswith(b\\\"\\\\xff\\\\xd8\\\\xff\\\"):\\n        return \\\"image/jpeg\\\"\\n    if raw.startswith((b\\\"GIF87a\\\", b\\\"GIF89a\\\")):\\n        return \\\"image/gif\\\"\\n    if raw[:4] == b\\\"RIFF\\\" and raw[8:12] == b\\\"WEBP\\\":\\n        return \\\"image/webp\\\"\\n    return None\\n\\n\\ndef _limit(name: str, default: int) -> int:\\n    value = IMAGE_LIMITS.get(name, default)\\n    return value if isinstance(value, int) and not isinstance(value, bool) else default\\n\\n\\ndef _new_img_dir() -> Path:\\n    \\\"\\\"\\\"Путь (без обращений к диску) каталога изображений одного хода.\\\"\\\"\\\"\\n    return Path(os.path.abspath(str(WORKSPACE))) / (\\\"img-\\\" + uuid.uuid4().hex)\\n\\n====\\n\\ndef _image_proof_reason(model: dict, effort: str = \\\"\\\") -> str:\\n    \\\"\\\"\\\"Применимость proof (класс II) -> '' (ок) или причина деградации.\\n\\n    Сверяются sha256 файла technical_ref.droid_binary_path, версия реализации\\n    метода, форматы image_limits.types ⊆ proof.formats и применимый effort\\n    запроса ∈ proof.efforts_proven. Ошибка чтения бинаря — тоже несовпадение.\\n    \\\"\\\"\\\"\\n    proof = (model.get(\\\"images\\\") or {}).get(\\\"proof\\\")\\n    if not proof:\\n        return \\\"\\\"\\n    ref = FLEET.get(\\\"technical_ref\\\") or {}\\n    path = os.path.expanduser(str(ref.get(\\\"droid_binary_path\\\") or \\\"\\\"))\\n    if not path or _file_sha256(path) != str(proof.get(\\\"droid_binary_sha256\\\") or \\\"\\\"):\\n        return \\\"droid_binary_sha\\\"\\n    if proof.get(\\\"impl_version\\\") != METHOD_IMPL_VERSION:\\n        return \\\"impl_version\\\"\\n    formats = proof.get(\\\"formats\\\") or []\\n    types = (FLEET.get(\\\"image_limits\\\") or {}).get(\\\"types\\\") or []\\n    if not set(types).issubset(set(formats)):\\n        return \\\"formats\\\"\\n    if effort and effort not in (proof.get(\\\"efforts_proven\\\") or []):\\n        return \\\"effort\\\"\\n    return \\\"\\\"\\n\\n\\ndef _extract_auth_token(handler: BaseHTTPRequestHandler) -> str:\\n    hdr = handler.headers.get(\\\"Authorization\\\", \\\"\\\")\\n    if hdr.startswith(\\\"Bearer \\\"):\\n        return hdr[7:].strip()\\n    return handler.headers.get(\\\"x-api-key\\\", \\\"\\\") or hdr.strip()\\n\\n\\ndef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\\n    expected = getattr(sys.modules[__name__], \\\"BRIDGE_KEY\\\", None) or AUTH_KEY\\n    if not expected:\\n\",\n  \"original_output_bytes\": 4736,\n  \"original_output_tokens\": 1184,\n  \"truncated\": false\n}","final_result":true}}}
