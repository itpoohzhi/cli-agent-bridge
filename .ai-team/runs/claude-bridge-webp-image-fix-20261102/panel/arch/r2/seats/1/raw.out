{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3c9","stream":{"kind":"session","id":"01a19cda-c94a-7470-9c90-503672e902d8"},"sequence":63,"recorded_at":1780531400000121,"record_type":"event","durability":"durable","causation_id":"01a19cda-ce57-7873-a80f-f68b7e7a1a4d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cda-ce57-7873-a80f-f68b7e7a1a4d","run_stream":{"kind":"run","id":"01a19cda-ce57-7873-a80f-f68b7e7a1a4d"},"task_stream":{"kind":"task","id":"01a19ce0-5376-72a1-b0e4-7c1f32f01582"},"task_id":"01a19ce0-5376-72a1-b0e4-7c1f32f01582","event":{"kind":"output","task_id":"01a19ce0-5376-72a1-b0e4-7c1f32f01582","chunk":"{\n  \"chunk_id\": \"exec-2-1\",\n  \"command\": \"sed -n '1360,1470p' /Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py; echo ====; grep -n \\\"_is_free_quota_error\\\\|allow_quota_rotation\\\\|_is_transient\\\\|TRANSIENT\\\\|_classify\\\" /Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py | head -n 60\",\n  \"description\": \"Читаю sniff и quota логику\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"    \\\"<arg_key>\\\",\\n    \\\"</arg_key>\\\",\\n    \\\"<arg_value>\\\",\\n    \\\"</arg_value>\\\",\\n)\\n# (MIME, магические байты, расширение файла) — принимаемые форматы вложений.\\n_IMAGE_FORMATS = (\\n    (\\\"image/png\\\", b\\\"\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\\", \\\"png\\\"),\\n    (\\\"image/jpeg\\\", b\\\"\\\\xff\\\\xd8\\\\xff\\\", \\\"jpg\\\"),\\n)\\n\\n\\nclass ImageInputError(ValueError):\\n    \\\"\\\"\\\"Отказ валидации изображения запроса; `code` — машинный код причины.\\\"\\\"\\\"\\n\\n    def __init__(self, code: str):\\n        super().__init__(code)\\n        self.code = code\\n\\n\\ndef _sniff_image_mime(data: bytes) -> str:\\n    \\\"\\\"\\\"MIME по магическим байтам ('' — сигнатура неизвестна).\\\"\\\"\\\"\\n    for mime, magic, _ext in _IMAGE_FORMATS:\\n        if data.startswith(magic):\\n            return mime\\n    return \\\"\\\"\\n\\n\\ndef extract_data_url_images(\\n    messages: Any,\\n    *,\\n    max_images: int = DEFAULT_MAX_IMAGES,\\n    max_image_bytes: int = DEFAULT_MAX_IMAGE_BYTES,\\n    max_total_bytes: int = DEFAULT_MAX_TOTAL_IMAGE_BYTES,\\n) -> list[dict]:\\n    \\\"\\\"\\\"Все `image_url`-части истории -> [{\\\"name\\\", \\\"mime\\\", \\\"data\\\"}] в порядке появления.\\n\\n    Принимаются только data URI с base64 PNG/JPEG: строгая проверка кодировки и\\n    соответствия MIME сигнатуре; URL не скачиваются, `file://` не читается,\\n    пользовательские пути не используются (имена генерируются: `image_N.<ext>`).\\n    Любое нарушение — `ImageInputError` до запуска CLI (fail-closed).\\n    \\\"\\\"\\\"\\n    images: list[dict] = []\\n    total = 0\\n    if not isinstance(messages, list):\\n        return images\\n    for msg in messages:\\n        if not isinstance(msg, dict) or not isinstance(msg.get(\\\"content\\\"), list):\\n            continue\\n        for item in msg[\\\"content\\\"]:\\n            if not isinstance(item, dict) or item.get(\\\"type\\\") != \\\"image_url\\\":\\n                continue\\n            image_url = item.get(\\\"image_url\\\")\\n            url = image_url.get(\\\"url\\\") if isinstance(image_url, dict) else None\\n            if not isinstance(url, str):\\n                raise ImageInputError(\\\"invalid_image_content\\\")\\n            if not url.startswith(\\\"data:\\\"):\\n                raise ImageInputError(\\\"image_url_not_allowed\\\")\\n            comma = url.find(\\\",\\\")\\n            if comma == -1:\\n                raise ImageInputError(\\\"invalid_image_content\\\")\\n            fields = [f.strip().lower() for f in url[5:comma].split(\\\";\\\")]\\n            mime = fields[0] if fields else \\\"\\\"\\n            if not mime or \\\"base64\\\" not in fields[1:]:\\n                raise ImageInputError(\\\"invalid_image_content\\\")\\n            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \\\"\\\")\\n            if not ext:\\n                raise ImageInputError(\\\"unsupported_image_type\\\")\\n            if len(images) >= max_images:\\n                raise ImageInputError(\\\"too_many_images\\\")\\n            approx_bytes = (len(url) - comma - 1) * 3 // 4\\n            if approx_bytes > max_image_bytes:\\n                raise ImageInputError(\\\"image_too_large\\\")\\n            if total + approx_bytes > max_total_bytes:\\n                raise ImageInputError(\\\"images_too_large\\\")\\n            payload = url[comma + 1 :]\\n            if not payload:\\n                raise ImageInputError(\\\"invalid_image_base64\\\")\\n            try:\\n                data = base64.b64decode(payload, validate=True)\\n            except (binascii.Error, ValueError):\\n                raise ImageInputError(\\\"invalid_image_base64\\\") from None\\n            sniffed = _sniff_image_mime(data)\\n            if not sniffed:\\n                raise ImageInputError(\\\"unsupported_image_type\\\")\\n            if sniffed != mime:\\n                raise ImageInputError(\\\"image_type_mismatch\\\")\\n            if len(data) > max_image_bytes:\\n                raise ImageInputError(\\\"image_too_large\\\")\\n            total += len(data)\\n            if total > max_total_bytes:\\n                raise ImageInputError(\\\"images_too_large\\\")\\n            images.append(\\n                {\\\"name\\\": f\\\"image_{len(images) + 1}.{ext}\\\", \\\"mime\\\": mime, \\\"data\\\": data}\\n            )\\n    return images\\n\\n\\ndef extract_thinking_delta(delta: Any) -> str:\\n    \\\"\\\"\\\"Текст нативной дельты размышления (`thinking_delta`) -> строка; иначе ''.\\n\\n    Транспортные адаптеры переводят свои события в общий словарь дельты; текст\\n    берётся из `thinking` (форма Claude stream-json) либо `thinking_delta`.\\n    \\\"\\\"\\\"\\n    if not isinstance(delta, dict) or delta.get(\\\"type\\\") != \\\"thinking_delta\\\":\\n        return \\\"\\\"\\n    value = delta.get(\\\"thinking\\\")\\n    if value is None:\\n        value = delta.get(\\\"thinking_delta\\\")\\n    return value if isinstance(value, str) else \\\"\\\"\\n\\n====\\n1151:_TRANSIENT_ERROR_MARKERS = (\\n1225:def _is_transient_stream_error(ev: dict[str, Any]) -> bool:\\n1260:    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\\n1741:def _is_free_quota_error(err: object) -> bool:\\n3073:    def allow_quota_rotation(self, reason: str = \\\"free_quota_proxy_rotate\\\") -> bool:\\n4210:            result[\\\"transient_error\\\"] = _is_transient_stream_error(payload)\\n5166:                result[\\\"transient_error\\\"] = _is_transient_stream_error(payload)\\n6927:                        if _is_transient_stream_error(payload):\\n7631:                    if _is_free_quota_error(err):\\n7635:                            if attempts.allow_quota_rotation(\\n8641:                            if _is_transient_stream_error(payload):\\n9220:                    is_free_quota = _is_free_quota_error(err)\\n9226:                            retry_allowed = attempts.allow_quota_rotation(\\n\",\n  \"original_output_bytes\": 5788,\n  \"original_output_tokens\": 1447,\n  \"truncated\": false\n}","final_result":true}}}
