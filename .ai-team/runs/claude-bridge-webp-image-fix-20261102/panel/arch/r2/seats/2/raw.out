ages(\n            [\n                {\n                    \"role\": \"user\",\n                    \"content\": [\n                        {\n                            \"type\": \"image_url\",\n                            \"image_url\": {\"url\": \"data:image/png;base64,!!!\"},\n                        }\n                    ],\n                }\n            ]\n        )\n    with pytest.raises(core_te.ImageInputError):\n        core_te.extract_data_url_images(\n            [{\"role\": \"user\", \"content\": [_image_part(\"image/png\", GIF_BYTES)]}]\n        )\n    with pytest.raises(core_te.ImageInputError):\n        core_te.extract_data_url_images(\n            [{\"role\": \"user\", \"content\": [_image_part(), _image_part()]}], max_images=1\n        )\n\n\n51-\n52-\n53:def _result(**overrides: Any) -> dict[str, Any]:\n54-    result = {\n55-        \"texts\": [],\n56-        \"reasonings\": [],\n57-        \"native_calls\": [],\n58-        \"usage\": {},\n59-        \"error\": None,\n60-        \"exit_reason\": \"ok\",\n61-        \"delivered\": False,\n62-        \"terminal\": \"completed\",\n63-        \"first_event_at\": None,\n64-        \"first_token_at\": None,\n65-        \"step_closed\": True,\n66-        \"first_event_ms\": None,\n67-        \"ttft_ms\": None,\n68-        \"prompt_status\": None,\n69-        \"transient_error\": False,\n70-        \"proxy_url\": None,\n71-    }\n72-    result.update(overrides)\n73-    return result\n74-\n75-\n76:def _quota_result(**overrides: Any) -> dict[str, Any]:\n77-    return _result(\n78-        error={\n79-            \"type\": \"provider.free-limit\",\n80-            \"statusCode\": 429,\n81-            \"message\": \"Free usage limit reached for this IP\",\n82-        },\n83-        transient_error=True,\n84-        **overrides,\n85-    )\n86-\n87-\n88-def _install_attempts(\n89-    bridge: Any,\n90-    monkeypatch: pytest.MonkeyPatch,\n91-    results: list[dict[str, Any]],\n92-    *,\n93-    select_proxy: bool = False,\n94-) -> Mock:\n95-    queued = iter(results)\n96-\n97-    def serve(*args: Any, **kwargs: Any) -> dict[str, Any]:\n98-        result = next(queued)\n99-        if select_proxy:\n100-            result[\"proxy_url\"] = bridge._next_standalone_proxy()\ntests/test_images_strict.py:17:    GIF_MAGIC,\ntests/test_images_strict.py:18:    WEBP_MAGIC,\ntests/test_images_strict.py:287:                image_part(make_sig(WEBP_MAGIC, 64), \"image/webp\"),\ntests/test_images_strict.py:291:                image_part(make_sig(GIF_MAGIC, 64), \"image/gif\"),\nserver.py:1541:def _collect_images(request: dict, model: dict, effort: str) -> list:\nserver.py:1563:    allowed = [str(t).lower() for t in (limits.get(\"max_types\") or [])]\nserver.py:6597:                images = _collect_images(req, model, effort)\n                        {\"decision\": \"reject\"},\n                    )\n                    if status in (200, 204):\n                        cascade_state[\"succeeded\"] = True\n                        replied_perms.add(request_id)\n                        reject_failed = False\n                    elif status == 404 and cascade_state.get(\"succeeded\"):\n                        # Идемпотентное подтверждение каскада после успешного reject.\n                        replied_perms.add(request_id)\n                        reject_failed = False\n                    else:\n                        reject_failed = True\n                except (\n                    OSError,\n                    http.client.HTTPException,\n                    ServeUnavailable,\n                    ServeProtocolError,\n                ):\n                    reject_failed = True\n            if reject_failed:\n                _ctrl_quiet(f\"/api/session/{session_id}/interrupt\")\n                raise ServeSecurityError(\"permission reject failed\")\n            continue\n        if mapped_kind == \"error\":\n            result[\"error\"] = payload\n            result[\"transient_error\"] = _is_transient_stream_error(payload)\n            result[\"terminal\"] = \"failed\"\n            return False\n        if mapped_kind in (\"reasoning\", \"text\"):\n            _check_bytes(mapped_kind, payload)\n            if mapped_kind == \"reasoning\":\n                text_value = str(payload.get(\"reasoning_content\") or \"\")\n                if text_value:\n                    if result[\"first_token_at\"] is None and t0:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                # step_finish — это session.step.ended: pending публикуется один раз.\n                for pending_call in pending_step_calls:\n                    result[\"native_calls\"].append(pending_call)\n                    on_tool(pending_call)\n                pending_step_calls.clear()\n                if result[\"native_calls\"] or (\n                    emulate_tools and _split_tool_calls([\"\".join(result[\"texts\"])])[1]\n                ):\n                    if result[\"first_token_at\"] is None and result[\"native_calls\"]:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"terminal\"] = \"tool_calls\"\n                    break\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"delivered\"] = _is_delivered()\n                result[\"transient_error\"] = _is_transient_stream_error(payload)\n                result[\"terminal\"] = \"failed\"\n                break\n            elif etype_raw == \"session.execution.succeeded\":\n                for pending_call in pending_step_calls:\n                    result[\"native_calls\"].append(pending_call)\n                    on_tool(pending_call)\n                pending_step_calls.clear()\n                result[\"terminal\"] = \"succeeded\"\n                break\n","exit_code":0,"status":"completed"}}
