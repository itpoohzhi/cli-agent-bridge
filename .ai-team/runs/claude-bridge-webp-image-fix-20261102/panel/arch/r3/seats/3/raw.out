{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c461","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":139,"recorded_at":1780531400000273,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"task_stream":{"kind":"task","id":"01a19cfe-7306-75c1-ba98-1d3ccb4772ab"},"task_id":"01a19cfe-7306-75c1-ba98-1d3ccb4772ab","event":{"kind":"output","task_id":"01a19cfe-7306-75c1-ba98-1d3ccb4772ab","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(1219 line(s) above)\n1220|            if isinstance(name, str) and name:\n1221|                names.append(name)\n1222|    return names\n1223|\n1224|\n1225|def _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n1226|    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n1227|\n1228|    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n1229|    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n1230|    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n1231|    \"\"\"\n1232|    containers: list[dict[str, Any]] = [ev]\n1233|    messages: list[str] = []\n1234|    err = ev.get(\"error\")\n1235|    if isinstance(err, dict):\n1236|        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n1237|    elif isinstance(err, str):\n1238|        messages.append(err)\n1239|    part = _dict_or_empty(ev.get(\"part\"))\n1240|    if part:\n1241|        part_err = _dict_or_empty(part.get(\"error\"))\n1242|        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n1243|    status: int | None = None\n1244|    for container in containers:\n1245|        if status is None:\n1246|            for key in (\"statusCode\", \"status_code\", \"status\"):\n1247|                value = container.get(key)\n1248|                if isinstance(value, int) and not isinstance(value, bool):\n1249|                    status = value\n1250|                    break\n1251|        for key in (\"message\", \"error\"):\n1252|            value = container.get(key)\n1253|            if isinstance(value, str):\n1254|                messages.append(value)\n1255|    if status in _FATAL_STREAM_STATUSES:\n1256|        return False\n1257|    if status is None or status in (0, 408, 429) or status >= 500:\n1258|        return True\n1259|    low = \" \".join(messages).lower()\n1260|    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n1261|\n1262|\n1263|def _step_recovery_disabled() -> bool:\n1264|    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n1265|    return not STEP_RECOVERY_ENABLED or os.environ.get(\n1266|        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n1267|    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n1268|\n1269|\n1270|def _visible_token_estimate(stripped: str) -> int:\n1271|    \"\"\"Грубая оценка токенов видимого текста (верхняя: не завышаем «проглоченные» токены).\"\"\"\n1272|    return max(len(stripped) // 2, _estimate_tokens(stripped)) if stripped else 0\n1273|\n1274|\n1275|def _swallowed_tokens(\n1276|    stripped: str, output_tokens: int, reasoning_tokens: int = 0\n1277|) -> int:\n1278|    \"\"\"Токены вывода, не объяснённые видимым текстом: output включает reasoning — вычитаем его.\"\"\"\n1279|    if reasoning_tokens > 0 and output_tokens >= reasoning_tokens:\n1280|        non_reasoning_output = max(0, output_tokens - reasoning_tokens)\n1281|    else:\n1282|        non_reasoning_output = output_tokens\n1283|    return non_reasoning_output - _visible_token_estimate(stripped)\n1284|\n1285|\n1286|def _is_status_preamble(stripped: str, names: list[str]) -> bool:\n1287|    \"\"\"Признак 5: короткая статусная преамбула с явным глаголом немедленного действия, без вывода/кода/таблиц.\"\"\"\n1288|    if not stripped or len(stripped) > PREAMBLE_MAX_CHARS or stripped.endswith(\"?\"):\n1289|        return False\n1290|    if len(stripped.splitlines()) > PREAMBLE_MAX_LINES:\n1291|        return False\n1292|    if \"```\" in stripped or \"~~~\" in stripped or _TABLE_SEP_RE.search(stripped):\n1293|        return False\n1294|    if _FINAL_CONCLUSION_RE.search(stripped) or not _ACTION_INTENT_RE.search(stripped):\n1295|        return False\n1296|    if stripped.endswith((\":\", \"...\", \"…\")):\n1297|        return True\n1298|    return len(stripped) <= PREAMBLE_SHORT_CHARS and _mentions_request_tool(\n1299|        stripped, names\n1300|    )\n1301|\n1302|\n1303|def _no_tools_overridden(body: str, thought: str, names: Iterable[str]) -> bool:\n1304|    \"\"\"Цитата «Rule 0 / no tools» в reasoning не отменяет вызовы, если дальше модель их планирует.\n1305|\n1306|    Да — когда видимый текст обещает действие, либо хвост reasoning содержит план вызовов\n1307|    (и там нет нового «no tools»).\n1308|    \"\"\"\n1309|    if _ACTION_INTENT_RE.search(body):\n1310|        return True\n1311|    if _NO_TOOLS_RE.search(thought[-200:]):\n1312|        return False\n1313|    tail = thought[-400:]\n1314|    return bool(_REASONING_TOOL_PLAN_RE.search(thought[-600:])) or (\n1315|        _mentions_request_tool(tail, names) and bool(_CALL_INTENT_RE.search(tail))\n1316|    )\n1317|\n1318|\n1319|def _detect_incomplete_tool_step_signal(\n1320|    text: str,\n1321|    reasoning: str,\n1322|    tools: Any,\n1323|    had_mid_stream_error: bool = False,\n1324|    output_tokens: int = 0,\n1325|    reasoning_tokens: int = 0,\n1326|    *,\n1327|    tool_choice: Any = None,\n1328|    had_error: bool = False,\n1329|) -> int:\n1330|    \"\"\"Номер сработавшего признака оборванного шага (1..5) или 0.\n1331|\n1332|    1 — транзиентная ошибка посреди ответа (или принудительный tool_choice без вызова); 2 — маркер\n1333|    «interrupted»/сырой неразобранный вызов; 3 — проглоченные токены; 4 — план вызовов в reasoning\n1334|    + обещание в тексте; 5 — узкая преамбула действия (_ACTION_INTENT_RE; голое «:» не триггерит).\n1335|    \"\"\"\n1336|    if _step_recovery_disabled():\n1337|        return 0\n1338|    names = _tool_name_list(tools)\n1339|    if not names or _tool_choice_none(tool_choice):\n(more lines below)","final_result":true}}}
