{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"task_stream":{"kind":"task","id":"01a19cff-3cf2-7643-b64c-a2132e31b372"},"task_id":"01a19cff-3cf2-7643-b64c-a2132e31b372","event":{"kind":"output","task_id":"01a19cff-3cf2-7643-b64c-a2132e31b372","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/server.py`.\n(6579 line(s) above)\n6580|            # (10) reasoning-объект не поддерживаем.\n6581|            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n6582|                self._reject(\n6583|                    400,\n6584|                    \"unsupported_parameter\",\n6585|                    \"reasoning parameter is not supported\",\n6586|                    model_id,\n6587|                    model_len,\n6588|                )\n6589|                return\n6590|            # (10a) отказоустойчивость контекста: история вмещается в окно модели до всего прочего.\n6591|            gated = self._context_gate(req, model_id, model, model_len)\n6592|            if gated is None:\n6593|                return\n6594|            req, self._context_pruned = gated\n6595|            # (11) изображения (C-08…C-11).\n6596|            try:\n6597|                images = _collect_images(req, model, effort)\n6598|            except ImageReject as exc:\n6599|                self._reject(\n6600|                    400,\n6601|                    exc.reason,\n6602|                    f\"image rejected: {exc.reason}\",\n6603|                    model_id,\n6604|                    model_len,\n6605|                )\n6606|                return\n6607|            # (12) бэкенд модели: допуск/лончер проверяются до SSE и до любого запуска.\n6608|            adapter = BACKENDS.get(model[\"backend\"])\n6609|            ok, why = (\n6610|                (False, \"backend_disabled\") if adapter is None else adapter.preflight()\n6611|            )\n6612|            if not ok:\n6613|                self._reject(\n6614|                    503,\n6615|                    \"launcher_unavailable\",\n6616|                    \"canonical launcher is missing or not executable\"\n6617|                    if why == \"launcher_unavailable\"\n6618|                    else f\"backend {model['backend']} is unavailable: {why}\",\n6619|                    model_id,\n6620|                    model_len,\n6621|                )\n6622|                return\n6623|            raw_messages = req.get(\"messages\")\n6624|            messages = raw_messages if isinstance(raw_messages, list) else []\n6625|            raw_tools = req.get(\"tools\")\n6626|            tools = (\n6627|                [t for t in raw_tools if isinstance(t, dict)]\n6628|                if isinstance(raw_tools, list)\n6629|                else []\n6630|            )\n6631|            tool_choice = req.get(\"tool_choice\")\n6632|            emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n6633|            prompt = _messages_to_prompt(messages, tools, tool_choice, images)\n6634|            extra = (\n6635|                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n6636|            )\n6637|            cwd = str(extra.get(\"cwd\") or \"\")\n6638|            fwd_env = self._forwarded_env(extra, model_id, model_len)\n6639|            if fwd_env is False:\n6640|                return\n6641|            req_turn_id = (\n6642|                self.headers.get(\"X-Turn-Id\") or str(extra.get(\"turn_id\") or \"\")\n6643|            ).strip()\n6644|            resume_turn_id = (\n6645|                self.headers.get(\"X-Resume-Turn-Id\")\n6646|                or str(extra.get(\"resume_turn_id\") or \"\")\n6647|            ).strip()\n6648|            for candidate_tid in (req_turn_id, resume_turn_id):\n6649|                if candidate_tid and not validate_turn_id(candidate_tid):\n6650|                    self._reject(\n6651|                        400,\n6652|                        \"invalid_request\",\n6653|                        \"invalid turn_id\",\n6654|                        model_id,\n6655|                        model_len,\n6656|                    )\n6657|                    return\n6658|            # Маршрут хода: нового 400 на ключ нет — плохой/отсутствующий ключ = холодная\n6659|            # изолированная сессия с replay истории запроса.\n(more lines below)","final_result":true}}}
