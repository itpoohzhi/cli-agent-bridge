{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c397","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":38,"recorded_at":1780531400000071,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"task_stream":{"kind":"task","id":"01a19cf9-e412-7352-9f5e-26553206c6f5"},"task_id":"01a19cf9-e412-7352-9f5e-26553206c6f5","event":{"kind":"output","task_id":"01a19cf9-e412-7352-9f5e-26553206c6f5","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py`.\n1|\"\"\"Общее ядро эмуляции OpenAI function calling (чистые функции, без I/O).\n2|\n3|Единый источник для всех бэкендов хаба: рендер истории и протокола инструментов в\n4|текстовый промпт, разбор блоков `<tool_call>…</tool_call>` из потока текстовых дельт.\n5|Модуль не импортирует `server` и адаптеры; `server.py` реэкспортирует имена для\n6|существующих тестов и совместимости.\n7|\"\"\"\n8|\n9|from __future__ import annotations\n10|\n11|import base64\n12|import binascii\n13|import json\n14|import re\n15|import uuid\n16|from dataclasses import replace\n17|from typing import Any, Callable\n18|from core.backend_adapter import ToolCall, ToolFunction, TurnEvent, TurnResult\n19|\n20|TOOL_CALL_OPEN = \"<tool_call>\"\n21|TOOL_CALL_CLOSE = \"</tool_call>\"\n22|\n23|# ADR-0020 (BND-001): ядро окружение не читает — здесь только умолчания\n24|# RepetitionGuard; эффективные значения передаёт владелец маршрута аргументами.\n25|DEFAULT_MAX_REPETITION_REPEATS = 20\n26|DEFAULT_MAX_REPETITION_TOKEN_LEN = 64\n27|REPETITION_MIN_REPEATS = 3\n28|REPETITION_MAX_REPEATS_CAP = 1000\n29|\n30|\n31|def _flatten_content(content: Any) -> str:\n32|    if content is None:\n33|        return \"\"\n34|    if isinstance(content, str):\n35|        return content\n36|    if isinstance(content, list):\n37|        parts = []\n38|        for item in content:\n39|            if isinstance(item, str):\n40|                parts.append(item)\n41|            elif isinstance(item, dict) and \"text\" in item:\n42|                parts.append(str(item[\"text\"]))\n43|        return \"\\n\".join(p for p in parts if p)\n44|    return str(content)\n45|\n46|\n47|def _render_content(content: Any, counter: list) -> str:\n48|    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\n49|\n50|    Нумерация сквозная по порядку появления во всей истории. Неизвестные\n51|    НЕ-image части (например input_audio) молча пропускаются, как раньше.\n52|    \"\"\"\n53|    if content is None:\n54|        return \"\"\n55|    if isinstance(content, str):\n56|        return content\n57|    if isinstance(content, list):\n58|        parts = []\n59|        for item in content:\n60|            if isinstance(item, str):\n61|                parts.append(item)\n62|            elif isinstance(item, dict):\n63|                if item.get(\"type\") == \"image_url\":\n64|                    counter[0] += 1\n65|                    parts.append(f\"[image {counter[0]}]\")\n66|                elif \"text\" in item and item.get(\"text\") is not None:\n67|                    parts.append(str(item[\"text\"]))\n68|        return \"\\n\".join(p for p in parts if p)\n69|    return str(content)\n70|\n71|\n72|def _normalize_arguments(value: Any) -> dict | None:\n73|    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n74|\n75|    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n76|    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n77|    и запускать инструмент с пустыми аргументами.\n78|    \"\"\"\n79|    if isinstance(value, dict):\n80|        return value\n81|    if isinstance(value, str):\n82|        text = value.strip()\n83|        if text:\n84|            try:\n85|                parsed = json.loads(text)\n86|            except ValueError:\n87|                return None\n88|            if isinstance(parsed, dict):\n89|                return parsed\n90|    return None\n91|\n92|\n93|def _normalize_tool_call(item: Any) -> dict:\n94|    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n95|\n96|    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n97|    с конкретным вызовом при нескольких одинаковых инструментах.\n98|    \"\"\"\n99|    if not isinstance(item, dict):\n100|        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n101|    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n102|    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n103|    args = fn.get(\"arguments\")\n104|    if args is None:\n105|        args = item.get(\"arguments\")\n106|    normalized = _normalize_arguments(args)\n107|    return {\n108|        \"id\": str(item.get(\"id\") or \"\"),\n109|        \"name\": str(name),\n110|        \"arguments\": normalized if normalized is not None else {},\n111|    }\n112|\n113|\n114|def _render_tool_call(item: Any) -> str:\n115|    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n116|    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n117|    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n118|\n119|\n120|def _tool_choice_none(tool_choice: Any) -> bool:\n121|    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n122|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n123|\n124|\n125|def _tool_choice_name(tool_choice: Any) -> str:\n126|    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n127|    if not isinstance(tool_choice, dict):\n128|        return \"\"\n129|    fn = (\n130|        tool_choice.get(\"function\")\n131|        if isinstance(tool_choice.get(\"function\"), dict)\n132|        else {}\n133|    )\n134|    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n135|    return str(name) if name else \"\"\n136|\n137|\n138|def _tools_section(tools: list, tool_choice: Any, has_attachments: bool = False) -> str:\n139|    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n140|    lines = [\n141|        \"[system]\",\n142|        \"# Tool calling protocol\",\n143|        \"You may call the external tools listed below.\",\n144|        \"When you need a tool, output ONLY blocks exactly in this form:\",\n145|        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n146|        \"You may output several such blocks in a row. Do not narrate around them.\",\n147|        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n148|        \"If no tool is needed, reply normally in plain text.\",\n149|        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n150|    ]\n151|    if has_attachments:\n152|        lines[-1] += \", except Read on the attachment files listed under [attachments].\"\n153|    if tool_choice == \"required\":\n154|        lines.append(\"You MUST call at least one tool now.\")\n155|    else:\n156|        forced = _tool_choice_name(tool_choice)\n157|        if forced:\n158|            lines.append(f'You MUST call the tool \"{forced}\" now.')\n159|    lines.append(\"\")\n160|    lines.append(\"Available tools:\")\n161|    for item in tools:\n162|        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n163|        if not isinstance(fn, dict):\n164|            continue\n165|        name = str(fn.get(\"name\") or \"\")\n166|        desc = str(fn.get(\"description\") or \"\")\n167|        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n168|        lines.append(f\"- {name}: {desc}\")\n169|        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n170|    return \"\\n\".join(lines)\n171|\n172|\n173|def _render_message(msg: Any, counter: list) -> str:\n174|    \"\"\"Одно сообщение истории -> текстовый блок (с рендером tool-вызовов/результатов).\"\"\"\n175|    if not isinstance(msg, dict):\n176|        return \"\"\n177|    role = str(msg.get(\"role\") or \"user\")\n178|    if role == \"tool\":\n179|        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n180|        name = str(msg.get(\"name\") or \"\")\n181|        text = _render_content(msg.get(\"content\"), counter)\n182|        header = f\"[tool result {call_id}]\"\n183|        if name:\n184|            header += f\" ({name})\"\n185|        return f\"{header}\\n{text}\" if text.strip() else header\n186|    text = _render_content(msg.get(\"content\"), counter)\n187|    if role == \"assistant\":\n188|        parts = []\n189|        if text.strip():\n190|            parts.append(text)\n191|        calls = msg.get(\"tool_calls\")\n192|        if isinstance(calls, list):\n193|            parts.extend(_render_tool_call(tc) for tc in calls)\n194|        body = \"\\n\".join(p for p in parts if p)\n195|        return f\"[assistant]\\n{body}\" if body.strip() else \"\"\n196|    if text.strip():\n197|        return f\"[{role}]\\n{text}\"\n198|    return \"\"\n199|\n200|\n201|def _attachments_section(images: list) -> str:\n202|    \"\"\"Хвост промпта метода workspace-read (эталон — kit/mkprompt.py).\"\"\"\n203|    lines = [\n204|        \"[attachments]\",\n205|        \"This request includes %d image(s) as local files in the working directory. \"\n206|        \"The markers [image N] in the conversation refer to them in order.\"\n207|        % len(images),\n208|    ]\n209|    for index, image in enumerate(images, 1):\n210|        lines.append(\n211|            \"- [image %d] ./%s (%s, %d bytes)\"\n212|            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\n213|        )\n214|    lines.append(\n215|        \"Open each image with the Read tool on exactly these paths before answering about it \"\n216|        \"(Read is the only built-in tool you may use, and only on these files). Do not claim to \"\n217|        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\n218|        \"instead of guessing.\"\n219|    )\n220|    return \"\\n\".join(lines)\n221|\n222|\n223|def _messages_to_prompt(\n224|    messages: list,\n225|    tools: list | None = None,\n226|    tool_choice: Any = None,\n227|    images: list | None = None,\n228|) -> str:\n229|    \"\"\"Собрать единый текстовый промпт; при наличии tools — с секцией протокола.\n230|\n231|    При наличии изображений в конец добавляется секция [attachments], а строка\n232|    протокола инструментов получает исключение для Read (C-09).\n233|    \"\"\"\n234|    tools = tools or []\n235|    counter = [0]\n236|    blocks = []\n237|    for msg in messages:\n238|        rendered = _render_message(msg, counter)\n239|        if rendered:\n240|            blocks.append(rendered)\n241|    head = []\n242|    if tools and not _tool_choice_none(tool_choice):\n243|        head.append(_tools_section(tools, tool_choice, bool(images)))\n244|    text = \"\\n\\n\".join(head + blocks).strip() or \"Reply with exactly: PONG\"\n245|    if images:\n246|        text = text + \"\\n\\n\" + _attachments_section(images)\n247|    return text\n248|\n249|\n250|def _strip_code_fence(text: str) -> str:\n251|    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n252|    body = text.strip()\n253|    if body.startswith((\"```\", \"~~~\")):\n254|        newline = body.find(\"\\n\")\n255|        body = body[newline + 1 :] if newline != -1 else body[3:]\n256|    if body.rstrip().endswith((\"```\", \"~~~\")):\n257|        body = body.rstrip()[:-3]\n258|    return body.strip()\n259|\n260|\n261|_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n262|\n263|\n264|def _recover_trailing_braces(text: str) -> dict | None:\n265|    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n266|    body = text.lstrip()\n267|    try:\n268|        obj, end = json.JSONDecoder().raw_decode(body)\n269|    except (ValueError, RecursionError):\n270|        return None\n271|    tail = body[end:]\n272|    if (\n273|        isinstance(obj, dict)\n274|        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n275|        and not tail.strip(\" \\t\\r\\n}\")\n276|    ):\n277|        return obj\n278|    return None\n279|\n280|\n281|def _loads_tolerant(text: str) -> Any:\n282|    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n283|\n284|    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n285|    \"\"\"\n286|    try:\n287|        return json.loads(text)\n288|    except (ValueError, RecursionError) as exc:\n289|        recovered = _recover_trailing_braces(text)\n290|        if recovered is None:\n291|            if isinstance(exc, RecursionError):\n292|                raise ValueError(\"JSON is nested too deeply\") from exc\n293|            raise\n294|        return recovered\n295|\n296|\n297|def _parse_tool_call_block(inner: str) -> dict | None:\n298|    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n299|\n300|    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n301|    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n302|    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n303|    \"\"\"\n304|    try:\n305|        obj = _loads_tolerant(_strip_code_fence(inner))\n306|    except ValueError:\n307|        return None\n308|    if not isinstance(obj, dict):\n309|        return None\n310|    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n311|        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n312|        obj = obj[\"function\"]\n313|    name = obj.get(\"name\")\n314|    if not isinstance(name, str) or not name.strip():\n315|        return None\n316|    if \"arguments\" not in obj:\n317|        arguments: dict = {}\n318|    else:\n319|        normalized = _normalize_arguments(obj.get(\"arguments\"))\n320|        if normalized is None:\n321|            return None\n322|        arguments = normalized\n323|    return {\"name\": name.strip(), \"arguments\": arguments}\n324|\n325|\n326|class LiveParserError(Exception):\n327|    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n328|\n329|    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n330|    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n331|    fail-close всего live-хода (сырой XML клиенту не уходит).\n332|    \"\"\"\n333|\n334|\n335|def _is_quoted_open(text: str, start: int) -> bool:\n336|    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n337|    if start > 0 and text[start - 1] == \"`\":\n338|        return True\n339|    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n340|    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n341|\n342|\n343|def _split_tool_call_inner(inner: str) -> list[str]:\n344|    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n345|\n346|    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n347|    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n348|    границей не считается (та же логика, что в `_find_close_outside_string`).\n349|    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n350|    \"\"\"\n351|    segments: list[str] = []\n352|    seg_start = 0\n353|    index = 0\n354|    length = len(inner)\n355|    in_string = False\n356|    escaped = False\n357|    while index < length:\n358|        char = inner[index]\n359|        if in_string:\n360|            if escaped:\n361|                escaped = False\n362|            elif char == \"\\\\\":\n363|                escaped = True\n364|            elif char == '\"':\n365|                in_string = False\n366|        elif char == '\"':\n367|            in_string = True\n368|        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n369|            inner, index\n370|        ):\n371|            segments.append(inner[seg_start:index])\n372|            index += len(TOOL_CALL_OPEN)\n373|            seg_start = index\n374|            continue\n375|        index += 1\n376|    segments.append(inner[seg_start:])\n377|    return segments\n378|\n379|\n380|def _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n381|    \"\"\"Содержимое блока -> список вызовов; None, если блок (или любой его член) невалиден.\n382|\n383|    Обычный блок даёт один вызов. Если он не разбирается, но внутри есть\n384|    несколько `<tool_call>` без промежуточных закрывающих тегов, блок делится на\n385|    сегменты; пачка принимается только целиком (все сегменты валидны).\n386|    \"\"\"\n387|    single = _parse_tool_call_block(inner)\n388|    if single is not None:\n389|        return [single]\n390|    if TOOL_CALL_OPEN not in inner:\n391|        return None\n392|    segments = _split_tool_call_inner(inner)\n393|    if len(segments) < 2:\n394|        return None\n395|    calls: list[dict] = []\n396|    for segment in segments:\n397|        call = _parse_tool_call_block(segment)\n398|        if call is None:\n399|            return None\n400|        calls.append(call)\n401|    return calls\n402|\n403|\n404|_OPAQUE_BLOCK = \"￼\"  # в `_history` на месте разобранного блока вызова\n405|\n406|\n407|def _fence_run(line: str) -> tuple[str, int, str]:\n408|    \"\"\"Строка -> (символ, длина серии, остаток), если это строка-забор fenced-блока.\n409|\n410|    Забор — серия от 3 одинаковых бэктиков или тильд после отступа до 3 пробелов;\n411|    (\"\", 0, \"\") — не забор.\n412|    \"\"\"\n413|    stripped = line.lstrip(\" \")\n414|    if len(line) - len(stripped) > 3 or stripped[:1] not in (\"`\", \"~\"):\n415|        return \"\", 0, \"\"\n416|    char = stripped[0]\n417|    rest = stripped.lstrip(char)\n418|    run = len(stripped) - len(rest)\n419|    return (char, run, rest) if run >= 3 else (\"\", 0, \"\")\n420|\n421|\n422|def _is_fence_open(char: str, run: int, rest: str) -> bool:\n423|    \"\"\"Строка-забор открывает блок: в info-строке бэктик-забора нет бэктиков.\"\"\"\n424|    return bool(run) and (char == \"~\" or \"`\" not in rest)\n425|\n426|\n427|def _find_closing_run(doc: str, start: int, end: int, ticks: int) -> int:\n428|    \"\"\"Конец первой серии ровно из `ticks` бэктиков в `doc[start:end]`, или -1.\"\"\"\n429|    index = start\n430|    while index < end:\n431|        if doc[index] != \"`\":\n432|            index += 1\n433|            continue\n434|        run_start = index\n435|        while index < end and doc[index] == \"`\":\n436|            index += 1\n437|        if index - run_start == ticks:\n438|            return index\n439|    return -1\n440|\n441|\n442|def _is_atx_heading(line: str) -> bool:\n443|    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n444|    stripped = line.lstrip(\" \")\n445|    if len(line) - len(stripped) > 3:\n446|        return False\n447|    rest = stripped.lstrip(\"#\")\n448|    return 1 <= len(stripped) - len(rest) <= 6 and (\n449|        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n450|    )\n451|\n452|\n453|def _code_context(\n454|    doc: str, pos: int, final: bool, *, code_end: list[int] | None = None\n455|) -> str:\n456|    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n457|\n458|    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n459|    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n460|    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n461|    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n462|    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n463|    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n464|    \"\"\"\n465|    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n466|    fence_char, fence_len, para, index = \"\", 0, 0, 0\n467|    while index < line_start:\n468|        eol = doc.index(\"\\n\", index)\n469|        line = doc[index:eol]\n470|        char, run, rest = _fence_run(line)\n471|        if fence_len:\n472|            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n473|                fence_len, para = 0, eol + 1\n474|        elif _is_fence_open(char, run, rest):\n475|            fence_char, fence_len = char, run\n476|        elif not line.strip() or _is_atx_heading(line):\n477|            para = eol + 1\n478|        index = eol + 1\n479|    if fence_len:\n480|        return \"code\"\n481|    eol = doc.find(\"\\n\", pos)\n482|    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n483|    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n484|        if code_end is not None:\n485|            code_end[:] = [len(doc) if eol == -1 else eol + 1]\n486|        return \"code\" if eol != -1 or final else \"wait\"\n487|    para_end, decided = len(doc), final\n488|    index = len(doc) if eol == -1 else eol + 1\n489|    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n490|        para = line_start  # заголовок — отдельный однострочный блок\n491|        if eol != -1:\n492|            para_end, decided, index = eol, True, len(doc)\n493|    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n494|        nxt = doc.find(\"\\n\", index)\n495|        line = doc[index : len(doc) if nxt == -1 else nxt]\n496|        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n497|        if (\n498|            nxt == -1\n499|            and not final\n500|            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c399","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":39,"recorded_at":1780531400000073,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"task_stream":{"kind":"task","id":"01a19cf9-e412-7352-9f5e-26553206c6f5"},"task_id":"01a19cf9-e412-7352-9f5e-26553206c6f5","event":{"kind":"completed","task_id":"01a19cf9-e412-7352-9f5e-26553206c6f5"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c39b","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":40,"recorded_at":1780531400000075,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"call_id":"call_01a19cf9df677532b966210d6c5a7b19","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py`.\n1|\"\"\"Общее ядро эмуляции OpenAI function calling (чистые функции, без I/O).\n2|\n3|Единый источник для всех бэкендов хаба: рендер истории и протокола инструментов в\n4|текстовый промпт, разбор блоков `<tool_call>…</tool_call>` из потока текстовых дельт.\n5|Модуль не импортирует `server` и адаптеры; `server.py` реэкспортирует имена для\n6|существующих тестов и совместимости.\n7|\"\"\"\n8|\n9|from __future__ import annotations\n10|\n11|import base64\n12|import binascii\n13|import json\n14|import re\n15|import uuid\n16|from dataclasses import replace\n17|from typing import Any, Callable\n18|from core.backend_adapter import ToolCall, ToolFunction, TurnEvent, TurnResult\n19|\n20|TOOL_CALL_OPEN = \"<tool_call>\"\n21|TOOL_CALL_CLOSE = \"</tool_call>\"\n22|\n23|# ADR-0020 (BND-001): ядро окружение не читает — здесь только умолчания\n24|# RepetitionGuard; эффективные значения передаёт владелец маршрута аргументами.\n25|DEFAULT_MAX_REPETITION_REPEATS = 20\n26|DEFAULT_MAX_REPETITION_TOKEN_LEN = 64\n27|REPETITION_MIN_REPEATS = 3\n28|REPETITION_MAX_REPEATS_CAP = 1000\n29|\n30|\n31|def _flatten_content(content: Any) -> str:\n32|    if content is None:\n33|        return \"\"\n34|    if isinstance(content, str):\n35|        return content\n36|    if isinstance(content, list):\n37|        parts = []\n38|        for item in content:\n39|            if isinstance(item, str):\n40|                parts.append(item)\n41|            elif isinstance(item, dict) and \"text\" in item:\n42|                parts.append(str(item[\"text\"]))\n43|        return \"\\n\".join(p for p in parts if p)\n44|    return str(content)\n45|\n46|\n47|def _render_content(content: Any, counter: list) -> str:\n48|    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\n49|\n50|    Нумерация сквозная по порядку появления во всей истории. Неизвестные\n51|    НЕ-image части (например input_audio) молча пропускаются, как раньше.\n52|    \"\"\"\n53|    if content is None:\n54|        return \"\"\n55|    if isinstance(content, str):\n56|        return content\n57|    if isinstance(content, list):\n58|        parts = []\n59|        for item in content:\n60|            if isinstance(item, str):\n61|                parts.append(item)\n62|            elif isinstance(item, dict):\n63|                if item.get(\"type\") == \"image_url\":\n64|                    counter[0] += 1\n65|                    parts.append(f\"[image {counter[0]}]\")\n66|                elif \"text\" in item and item.get(\"text\") is not None:\n67|                    parts.append(str(item[\"text\"]))\n68|        return \"\\n\".join(p for p in parts if p)\n69|    return str(content)\n70|\n71|\n72|def _normalize_arguments(value: Any) -> dict | None:\n73|    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n74|\n75|    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n76|    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n77|    и запускать инструмент с пустыми аргументами.\n78|    \"\"\"\n79|    if isinstance(value, dict):\n80|        return value\n81|    if isinstance(value, str):\n82|        text = value.strip()\n83|        if text:\n84|            try:\n85|                parsed = json.loads(text)\n86|            except ValueError:\n87|                return None\n88|            if isinstance(parsed, dict):\n89|                return parsed\n90|    return None\n91|\n92|\n93|def _normalize_tool_call(item: Any) -> dict:\n94|    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n95|\n96|    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n97|    с конкретным вызовом при нескольких одинаковых инструментах.\n98|    \"\"\"\n99|    if not isinstance(item, dict):\n100|        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n101|    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n102|    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n103|    args = fn.get(\"arguments\")\n104|    if args is None:\n105|        args = item.get(\"arguments\")\n106|    normalized = _normalize_arguments(args)\n107|    return {\n108|        \"id\": str(item.get(\"id\") or \"\"),\n109|        \"name\": str(name),\n110|        \"arguments\": normalized if normalized is not None else {},\n111|    }\n112|\n113|\n114|def _render_tool_call(item: Any) -> str:\n115|    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n116|    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n117|    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n118|\n119|\n120|def _tool_choice_none(tool_choice: Any) -> bool:\n121|    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n122|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n123|\n124|\n125|def _tool_choice_name(tool_choice: Any) -> str:\n126|    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n127|    if not isinstance(tool_choice, dict):\n128|        return \"\"\n129|    fn = (\n130|        tool_choice.get(\"function\")\n131|        if isinstance(tool_choice.get(\"function\"), dict)\n132|        else {}\n133|    )\n134|    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n135|    return str(name) if name else \"\"\n136|\n137|\n138|def _tools_section(tools: list, tool_choice: Any, has_attachments: bool = False) -> str:\n139|    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n140|    lines = [\n141|        \"[system]\",\n142|        \"# Tool calling protocol\",\n143|        \"You may call the external tools listed below.\",\n144|        \"When you need a tool, output ONLY blocks exactly in this form:\",\n145|        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n146|        \"You may output several such blocks in a row. Do not narrate around them.\",\n147|        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n148|        \"If no tool is needed, reply normally in plain text.\",\n149|        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n150|    ]\n151|    if has_attachments:\n152|        lines[-1] += \", except Read on the attachment files listed under [attachments].\"\n153|    if tool_choice == \"required\":\n154|        lines.append(\"You MUST call at least one tool now.\")\n155|    else:\n156|        forced = _tool_choice_name(tool_choice)\n157|        if forced:\n158|            lines.append(f'You MUST call the tool \"{forced}\" now.')\n159|    lines.append(\"\")\n160|    lines.append(\"Available tools:\")\n161|    for item in tools:\n162|        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n163|        if not isinstance(fn, dict):\n164|            continue\n165|        name = str(fn.get(\"name\") or \"\")\n166|        desc = str(fn.get(\"description\") or \"\")\n167|        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n168|        lines.append(f\"- {name}: {desc}\")\n169|        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n170|    return \"\\n\".join(lines)\n171|\n172|\n173|def _render_message(msg: Any, counter: list) -> str:\n174|    \"\"\"Одно сообщение истории -> текстовый блок (с рендером tool-вызовов/результатов).\"\"\"\n175|    if not isinstance(msg, dict):\n176|        return \"\"\n177|    role = str(msg.get(\"role\") or \"user\")\n178|    if role == \"tool\":\n179|        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n180|        name = str(msg.get(\"name\") or \"\")\n181|        text = _render_content(msg.get(\"content\"), counter)\n182|        header = f\"[tool result {call_id}]\"\n183|        if name:\n184|            header += f\" ({name})\"\n185|        return f\"{header}\\n{text}\" if text.strip() else header\n186|    text = _render_content(msg.get(\"content\"), counter)\n187|    if role == \"assistant\":\n188|        parts = []\n189|        if text.strip():\n190|            parts.append(text)\n191|        calls = msg.get(\"tool_calls\")\n192|        if isinstance(calls, list):\n193|            parts.extend(_render_tool_call(tc) for tc in calls)\n194|        body = \"\\n\".join(p for p in parts if p)\n195|        return f\"[assistant]\\n{body}\" if body.strip() else \"\"\n196|    if text.strip():\n197|        return f\"[{role}]\\n{text}\"\n198|    return \"\"\n199|\n200|\n201|def _attachments_section(images: list) -> str:\n202|    \"\"\"Хвост промпта метода workspace-read (эталон — kit/mkprompt.py).\"\"\"\n203|    lines = [\n204|        \"[attachments]\",\n205|        \"This request includes %d image(s) as local files in the working directory. \"\n206|        \"The markers [image N] in the conversation refer to them in order.\"\n207|        % len(images),\n208|    ]\n209|    for index, image in enumerate(images, 1):\n210|        lines.append(\n211|            \"- [image %d] ./%s (%s, %d bytes)\"\n212|            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\n213|        )\n214|    lines.append(\n215|        \"Open each image with the Read tool on exactly these paths before answering about it \"\n216|        \"(Read is the only built-in tool you may use, and only on these files). Do not claim to \"\n217|        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\n218|        \"instead of guessing.\"\n219|    )\n220|    return \"\\n\".join(lines)\n221|\n222|\n223|def _messages_to_prompt(\n224|    messages: list,\n225|    tools: list | None = None,\n226|    tool_choice: Any = None,\n227|    images: list | None = None,\n228|) -> str:\n229|    \"\"\"Собрать единый текстовый промпт; при наличии tools — с секцией протокола.\n230|\n231|    При наличии изображений в конец добавляется секция [attachments], а строка\n232|    протокола инструментов получает исключение для Read (C-09).\n233|    \"\"\"\n234|    tools = tools or []\n235|    counter = [0]\n236|    blocks = []\n237|    for msg in messages:\n238|        rendered = _render_message(msg, counter)\n239|        if rendered:\n240|            blocks.append(rendered)\n241|    head = []\n242|    if tools and not _tool_choice_none(tool_choice):\n243|        head.append(_tools_section(tools, tool_choice, bool(images)))\n244|    text = \"\\n\\n\".join(head + blocks).strip() or \"Reply with exactly: PONG\"\n245|    if images:\n246|        text = text + \"\\n\\n\" + _attachments_section(images)\n247|    return text\n248|\n249|\n250|def _strip_code_fence(text: str) -> str:\n251|    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n252|    body = text.strip()\n253|    if body.startswith((\"```\", \"~~~\")):\n254|        newline = body.find(\"\\n\")\n255|        body = body[newline + 1 :] if newline != -1 else body[3:]\n256|    if body.rstrip().endswith((\"```\", \"~~~\")):\n257|        body = body.rstrip()[:-3]\n258|    return body.strip()\n259|\n260|\n261|_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n262|\n263|\n264|def _recover_trailing_braces(text: str) -> dict | None:\n265|    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n266|    body = text.lstrip()\n267|    try:\n268|        obj, end = json.JSONDecoder().raw_decode(body)\n269|    except (ValueError, RecursionError):\n270|        return None\n271|    tail = body[end:]\n272|    if (\n273|        isinstance(obj, dict)\n274|        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n275|        and not tail.strip(\" \\t\\r\\n}\")\n276|    ):\n277|        return obj\n278|    return None\n279|\n280|\n281|def _loads_tolerant(text: str) -> Any:\n282|    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n283|\n284|    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n285|    \"\"\"\n286|    try:\n287|        return json.loads(text)\n288|    except (ValueError, RecursionError) as exc:\n289|        recovered = _recover_trailing_braces(text)\n290|        if recovered is None:\n291|            if isinstance(exc, RecursionError):\n292|                raise ValueError(\"JSON is nested too deeply\") from exc\n293|            raise\n294|        return recovered\n295|\n296|\n297|def _parse_tool_call_block(inner: str) -> dict | None:\n298|    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n299|\n300|    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n301|    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n302|    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n303|    \"\"\"\n304|    try:\n305|        obj = _loads_tolerant(_strip_code_fence(inner))\n306|    except ValueError:\n307|        return None\n308|    if not isinstance(obj, dict):\n309|        return None\n310|    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n311|        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n312|        obj = obj[\"function\"]\n313|    name = obj.get(\"name\")\n314|    if not isinstance(name, str) or not name.strip():\n315|        return None\n316|    if \"arguments\" not in obj:\n317|        arguments: dict = {}\n318|    else:\n319|        normalized = _normalize_arguments(obj.get(\"arguments\"))\n320|        if normalized is None:\n321|            return None\n322|        arguments = normalized\n323|    return {\"name\": name.strip(), \"arguments\": arguments}\n324|\n325|\n326|class LiveParserError(Exception):\n327|    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n328|\n329|    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n330|    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n331|    fail-close всего live-хода (сырой XML клиенту не уходит).\n332|    \"\"\"\n333|\n334|\n335|def _is_quoted_open(text: str, start: int) -> bool:\n336|    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n337|    if start > 0 and text[start - 1] == \"`\":\n338|        return True\n339|    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n340|    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n341|\n342|\n343|def _split_tool_call_inner(inner: str) -> list[str]:\n344|    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n345|\n346|    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n347|    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n348|    границей не считается (та же логика, что в `_find_close_outside_string`).\n349|    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n350|    \"\"\"\n351|    segments: list[str] = []\n352|    seg_start = 0\n353|    index = 0\n354|    length = len(inner)\n355|    in_string = False\n356|    escaped = False\n357|    while index < length:\n358|        char = inner[index]\n359|        if in_string:\n360|            if escaped:\n361|                escaped = False\n362|            elif char == \"\\\\\":\n363|                escaped = True\n364|            elif char == '\"':\n365|                in_string = False\n366|        elif char == '\"':\n367|            in_string = True\n368|        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n369|            inner, index\n370|        ):\n371|            segments.append(inner[seg_start:index])\n372|            index += len(TOOL_CALL_OPEN)\n373|            seg_start = index\n374|            continue\n375|        index += 1\n376|    segments.append(inner[seg_start:])\n377|    return segments\n378|\n379|\n380|def _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n381|    \"\"\"Содержимое блока -> список вызовов; None, если блок (или любой его член) невалиден.\n382|\n383|    Обычный блок даёт один вызов. Если он не разбирается, но внутри есть\n384|    несколько `<tool_call>` без промежуточных закрывающих тегов, блок делится на\n385|    сегменты; пачка принимается только целиком (все сегменты валидны).\n386|    \"\"\"\n387|    single = _parse_tool_call_block(inner)\n388|    if single is not None:\n389|        return [single]\n390|    if TOOL_CALL_OPEN not in inner:\n391|        return None\n392|    segments = _split_tool_call_inner(inner)\n393|    if len(segments) < 2:\n394|        return None\n395|    calls: list[dict] = []\n396|    for segment in segments:\n397|        call = _parse_tool_call_block(segment)\n398|        if call is None:\n399|            return None\n400|        calls.append(call)\n401|    return calls\n402|\n403|\n404|_OPAQUE_BLOCK = \"￼\"  # в `_history` на месте разобранного блока вызова\n405|\n406|\n407|def _fence_run(line: str) -> tuple[str, int, str]:\n408|    \"\"\"Строка -> (символ, длина серии, остаток), если это строка-забор fenced-блока.\n409|\n410|    Забор — серия от 3 одинаковых бэктиков или тильд после отступа до 3 пробелов;\n411|    (\"\", 0, \"\") — не забор.\n412|    \"\"\"\n413|    stripped = line.lstrip(\" \")\n414|    if len(line) - len(stripped) > 3 or stripped[:1] not in (\"`\", \"~\"):\n415|        return \"\", 0, \"\"\n416|    char = stripped[0]\n417|    rest = stripped.lstrip(char)\n418|    run = len(stripped) - len(rest)\n419|    return (char, run, rest) if run >= 3 else (\"\", 0, \"\")\n420|\n421|\n422|def _is_fence_open(char: str, run: int, rest: str) -> bool:\n423|    \"\"\"Строка-забор открывает блок: в info-строке бэктик-забора нет бэктиков.\"\"\"\n424|    return bool(run) and (char == \"~\" or \"`\" not in rest)\n425|\n426|\n427|def _find_closing_run(doc: str, start: int, end: int, ticks: int) -> int:\n428|    \"\"\"Конец первой серии ровно из `ticks` бэктиков в `doc[start:end]`, или -1.\"\"\"\n429|    index = start\n430|    while index < end:\n431|        if doc[index] != \"`\":\n432|            index += 1\n433|            continue\n434|        run_start = index\n435|        while index < end and doc[index] == \"`\":\n436|            index += 1\n437|        if index - run_start == ticks:\n438|            return index\n439|    return -1\n440|\n441|\n442|def _is_atx_heading(line: str) -> bool:\n443|    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n444|    stripped = line.lstrip(\" \")\n445|    if len(line) - len(stripped) > 3:\n446|        return False\n447|    rest = stripped.lstrip(\"#\")\n448|    return 1 <= len(stripped) - len(rest) <= 6 and (\n449|        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n450|    )\n451|\n452|\n453|def _code_context(\n454|    doc: str, pos: int, final: bool, *, code_end: list[int] | None = None\n455|) -> str:\n456|    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n457|\n458|    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n459|    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n460|    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n461|    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n462|    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n463|    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n464|    \"\"\"\n465|    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n466|    fence_char, fence_len, para, index = \"\", 0, 0, 0\n467|    while index < line_start:\n468|        eol = doc.index(\"\\n\", index)\n469|        line = doc[index:eol]\n470|        char, run, rest = _fence_run(line)\n471|        if fence_len:\n472|            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n473|                fence_len, para = 0, eol + 1\n474|        elif _is_fence_open(char, run, rest):\n475|            fence_char, fence_len = char, run\n476|        elif not line.strip() or _is_atx_heading(line):\n477|            para = eol + 1\n478|        index = eol + 1\n479|    if fence_len:\n480|        return \"code\"\n481|    eol = doc.find(\"\\n\", pos)\n482|    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n483|    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n484|        if code_end is not None:\n485|            code_end[:] = [len(doc) if eol == -1 else eol + 1]\n486|        return \"code\" if eol != -1 or final else \"wait\"\n487|    para_end, decided = len(doc), final\n488|    index = len(doc) if eol == -1 else eol + 1\n489|    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n490|        para = line_start  # заголовок — отдельный однострочный блок\n491|        if eol != -1:\n492|            para_end, decided, index = eol, True, len(doc)\n493|    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n494|        nxt = doc.find(\"\\n\", index)\n495|        line = doc[index : len(doc) if nxt == -1 else nxt]\n496|        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n497|        if (\n498|            nxt == -1\n499|            and not final\n500|            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
