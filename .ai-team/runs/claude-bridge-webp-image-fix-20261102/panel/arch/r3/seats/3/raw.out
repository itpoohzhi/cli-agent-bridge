ts\"]),\n7656|                        \"\".join(result[\"reasonings\"]),\n7657|                        tools or [],\n7658|                        True,\n7659|                        int(result[\"usage\"].get(\"output\") or 0),\n7660|                        int(result[\"usage\"].get(\"reasoning\") or 0),\n7661|                        tool_choice=tool_choice,\n7662|                    )\n7663|                    if signal_t and attempts.allow_retry(\"incomplete_step\"):\n7664|                        attempts.signal = signal_t\n7665|                        current_prompt = _rewrite_tool_tags_for_model(\n7666|                            _incomplete_tool_step_prompt(\n7667|                                prompt,\n7668|                                \"\".join(collected_texts),\n7669|                                tools or [],\n7670|                                tool_choice,\n7671|                                model,\n7672|                            ),\n7673|                            model,\n7674|                        )\n7675|                        continue\n7676|                xs[\"exit_reason\"] = \"upstream_failed\"\n7677|                self._sse_error(\n7678|                    _error_payload(\n7679|                        f\"serve error: {_clean_err(str(err.get('message') or ''))}\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
