{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c465","stream":{"kind":"session","id":"01a19cf4-850b-78e0-9498-8eeb101fb452"},"sequence":141,"recorded_at":1780531400000277,"record_type":"event","durability":"durable","causation_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a","run_stream":{"kind":"run","id":"01a19cf4-8edb-76e2-b26b-4e809cf7ef9a"},"task_stream":{"kind":"task","id":"01a19cfe-7336-7a10-922a-a0e1a764998a"},"task_id":"01a19cfe-7336-7a10-922a-a0e1a764998a","event":{"kind":"output","task_id":"01a19cfe-7336-7a10-922a-a0e1a764998a","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/opencode-zen-bridge/server.py`.\n(1734 line(s) above)\n1735|    os.environ.get(\"OPENCODE_ZEN_PROXY_QUOTA_COOLDOWN_S\", \"3600.0\")\n1736|)\n1737|QUOTA_ROTATION_LIMIT = int(os.environ.get(\"OPENCODE_ZEN_QUOTA_ROTATION_LIMIT\", \"3\"))\n1738|_proxy_quarantine_until: dict[str, float] = {}\n1739|\n1740|\n1741|def _is_free_quota_error(err: object) -> bool:\n1742|    \"\"\"Распознать исчерпанную квоту по типу или тексту ошибки провайдера.\"\"\"\n1743|    if isinstance(err, dict):\n1744|        if err.get(\"type\") == \"provider.free-limit\":\n1745|            return True\n1746|        message = str(err.get(\"message\") or err).lower()\n1747|    elif isinstance(err, str):\n1748|        message = err.lower()\n1749|    else:\n1750|        return False\n1751|    return any(\n1752|        marker in message\n1753|        for marker in (\n1754|            \"free usage limit reached\",\n1755|            \"usage limit reached\",\n1756|            \"provider.free-limit\",\n1757|        )\n1758|    )\n1759|\n1760|\n1761|def _quarantine_proxy(proxy_url: str | None, cooldown_s: float | None = None) -> None:\n1762|    \"\"\"Временно исключить порт с исчерпанной квотой из ротации.\"\"\"\n1763|    if not proxy_url or not str(proxy_url).strip():\n1764|        return\n1765|    proxy_url = str(proxy_url).strip()\n1766|    with _proxy_pool_lock:\n1767|        _proxy_quarantine_until[proxy_url] = time.monotonic() + (\n1768|            PROXY_QUOTA_COOLDOWN_S if cooldown_s is None else cooldown_s\n1769|        )\n1770|        _log(f\"proxy quarantined for quota limit: {_mask_secrets(proxy_url)}\")\n1771|\n1772|\n1773|def _resolve_proxyrack_gateway() -> str:\n1774|    \"\"\"IP живого шлюза ProxyRack: env -> последняя запись лога proxyrack-forward -> значение по умолчанию.\n1775|\n1776|    Прямой DNS global.rotating.proxyrack.net иногда отдаёт нерабочие 149.51.*; демон\n1777|    proxyrack-forward проверяет адреса пробой и пишет живой в лог (`gateway <old> -> <new>`).\n1778|    \"\"\"\n1779|    forced = os.environ.get(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_GATEWAY\", \"\").strip()\n1780|    if forced:\n1781|        return forced\n1782|    try:\n1783|        with _PROXYRACK_FORWARD_LOG.open(\"rb\") as fh:\n1784|            fh.seek(0, os.SEEK_END)\n1785|            fh.seek(max(0, fh.tell() - _PROXYRACK_LOG_TAIL_BYTES))\n1786|            tail = fh.read().decode(\"utf-8\", errors=\"replace\")\n1787|    except OSError:\n1788|        return _DEFAULT_PROXYRACK_GATEWAY\n1789|    for line in reversed(tail.splitlines()):\n1790|        if \"proxyrack-forward gateway \" not in line or \" -> \" not in line:\n1791|            continue\n1792|        candidate = line.rsplit(\" -> \", 1)[1].strip()\n1793|        if _IPV4_RE.match(candidate) and not candidate.startswith(\"149.51.\"):\n1794|            return candidate\n1795|        break\n1796|    return _DEFAULT_PROXYRACK_GATEWAY\n1797|\n1798|\n1799|def _parse_proxy_pool_line(line: str, gateway: str) -> str | None:\n1800|    \"\"\"`user:pass@host:port` или `host:port:user:pass` -> `http://user:pass@<gateway>:port` (host заменяется шлюзом).\"\"\"\n1801|    line = line.strip()\n1802|    if \"@\" in line:\n1803|        creds, _, hostport = line.rpartition(\"@\")\n1804|        user, sep, password = creds.partition(\":\")\n1805|        port = hostport.rpartition(\":\")[2]\n1806|    else:\n1807|        parts = line.split(\":\", 3)\n1808|        if len(parts) != 4:\n1809|            return None\n1810|        _, port, user, password = parts\n1811|        sep = \":\"\n1812|    if not (sep and user and password and port.isdigit()):\n1813|        return None\n1814|    return f\"http://{quote(user, safe='')}:{quote(password, safe='')}@{gateway}:{port}\"\n(more lines below)","final_result":true}}}
