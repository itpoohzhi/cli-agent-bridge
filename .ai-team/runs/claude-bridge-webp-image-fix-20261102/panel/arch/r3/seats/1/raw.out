ansient_error\"\n8641:                            if _is_transient_stream_error(payload):\n8646:                                f\"stream: provider error mid-response (transient={had_provider_error}), \"\n8717:                transient_failure = (\n8726:                    transient_failure, attempt_output and not transient_failure\n9219:                if result.get(\"transient_error\"):\n9220:                    is_free_quota = _is_free_quota_error(err)\n9222:                        _quarantine_proxy(result.get(\"proxy_url\"))\n9226:                            retry_allowed = attempts.allow_quota_rotation(\n9234:                                \"serve_transient_error\"\n1366:_IMAGE_FORMATS = (\n1380:def _sniff_image_mime(data: bytes) -> str:\n1382:    for mime, magic, _ext in _IMAGE_FORMATS:\n1388:def extract_data_url_images(\n1425:            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\n1442:            sniffed = _sniff_image_mime(data)\n","exit_code":0,"status":"completed"}}
