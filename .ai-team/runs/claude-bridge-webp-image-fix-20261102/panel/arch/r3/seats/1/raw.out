{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1200,1290p' bridges/opencode-zen-bridge/server.py; sed -n '1730,1770p' bridges/opencode-zen-bridge/server.py; sed -n '7590,7665p' bridges/opencode-zen-bridge/server.py; sed -n '9200,9255p' bridges/opencode-zen-bridge/server.py\"","aggregated_output":"            if (start == 0 or not _is_ident_char(text[start - 1])) and (\n                end == len(text) or not _is_ident_char(text[end])\n            ):\n                return True\n            start = text.find(name, start + 1)\n    return False\n\n\ndef _tool_name_list(tools: Any) -> list[str]:\n    \"\"\"Инструменты запроса (OpenAI-схемы или голые имена) -> список имён.\"\"\"\n    names: list[str] = []\n    for item in _list_or_empty(tools):\n        if isinstance(item, str):\n            if item:\n                names.append(item)\n        elif isinstance(item, dict):\n            fn = (\n                item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n            )\n            name = fn.get(\"name\") if isinstance(fn, dict) else None\n            if isinstance(name, str) and name:\n                names.append(name)\n    return names\n\n\ndef _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n\n    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n    \"\"\"\n    containers: list[dict[str, Any]] = [ev]\n    messages: list[str] = []\n    err = ev.get(\"error\")\n    if isinstance(err, dict):\n        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n    elif isinstance(err, str):\n        messages.append(err)\n    part = _dict_or_empty(ev.get(\"part\"))\n    if part:\n        part_err = _dict_or_empty(part.get(\"error\"))\n        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n    status: int | None = None\n    for container in containers:\n        if status is None:\n            for key in (\"statusCode\", \"status_code\", \"status\"):\n                value = container.get(key)\n                if isinstance(value, int) and not isinstance(value, bool):\n                    status = value\n                    break\n        for key in (\"message\", \"error\"):\n            value = container.get(key)\n            if isinstance(value, str):\n                messages.append(value)\n    if status in _FATAL_STREAM_STATUSES:\n        return False\n    if status is None or status in (0, 408, 429) or status >= 500:\n        return True\n    low = \" \".join(messages).lower()\n    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n\n\ndef _step_recovery_disabled() -> bool:\n    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n    return not STEP_RECOVERY_ENABLED or os.environ.get(\n        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n\n\ndef _visible_token_estimate(stripped: str) -> int:\n    \"\"\"Грубая оценка токенов видимого текста (верхняя: не завышаем «проглоченные» токены).\"\"\"\n    return max(len(stripped) // 2, _estimate_tokens(stripped)) if stripped else 0\n\n\ndef _swallowed_tokens(\n    stripped: str, output_tokens: int, reasoning_tokens: int = 0\n) -> int:\n    \"\"\"Токены вывода, не объяснённые видимым текстом: output включает reasoning — вычитаем его.\"\"\"\n    if reasoning_tokens > 0 and output_tokens >= reasoning_tokens:\n        non_reasoning_output = max(0, output_tokens - reasoning_tokens)\n    else:\n        non_reasoning_output = output_tokens\n    return non_reasoning_output - _visible_token_estimate(stripped)\n\n\ndef _is_status_preamble(stripped: str, names: list[str]) -> bool:\n    \"\"\"Признак 5: короткая статусная преамбула с явным глаголом немедленного действия, без вывода/кода/таблиц.\"\"\"\n    if not stripped or len(stripped) > PREAMBLE_MAX_CHARS or stripped.endswith(\"?\"):\n        return False\n    if len(stripped.splitlines()) > PREAMBLE_MAX_LINES:\n_proxy_pool_lock = threading.Lock()\n_proxy_pool_key: tuple[Any, ...] | None = None\n_proxy_pool_entries: list[str] = []\n_proxy_pool_idx = 0\nPROXY_QUOTA_COOLDOWN_S = float(\n    os.environ.get(\"OPENCODE_ZEN_PROXY_QUOTA_COOLDOWN_S\", \"3600.0\")\n)\nQUOTA_ROTATION_LIMIT = int(os.environ.get(\"OPENCODE_ZEN_QUOTA_ROTATION_LIMIT\", \"3\"))\n_proxy_quarantine_until: dict[str, float] = {}\n\n\ndef _is_free_quota_error(err: object) -> bool:\n    \"\"\"Распознать исчерпанную квоту по типу или тексту ошибки провайдера.\"\"\"\n    if isinstance(err, dict):\n        if err.get(\"type\") == \"provider.free-limit\":\n            return True\n        message = str(err.get(\"message\") or err).lower()\n    elif isinstance(err, str):\n        message = err.lower()\n    else:\n        return False\n    return any(\n        marker in message\n        for marker in (\n            \"free usage limit reached\",\n            \"usage limit reached\",\n            \"provider.free-limit\",\n        )\n    )\n\n\ndef _quarantine_proxy(proxy_url: str | None, cooldown_s: float | None = None) -> None:\n    \"\"\"Временно исключить порт с исчерпанной квотой из ротации.\"\"\"\n    if not proxy_url or not str(proxy_url).strip():\n        return\n    proxy_url = str(proxy_url).strip()\n    with _proxy_pool_lock:\n        _proxy_quarantine_until[proxy_url] = time.monotonic() + (\n            PROXY_QUOTA_COOLDOWN_S if cooldown_s is None else cooldown_s\n        )\n        _log(f\"proxy quarantined for quota limit: {_mask_secrets(proxy_url)}\")\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(reason):\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._sse_error(_error_payload(f\"serve {reason}\"))\n                return True\n            if result.get(\"prompt_status\") is not None:\n                _ps_code = int(result[\"prompt_status\"] or 0)\n                if _ps_code == 429 or 500 <= _ps_code <= 599:\n                    attempts.attempt_done(True, False)\n                if not _delivered_now and not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(f\"prompt_status_{_ps_code}\"):\n                    continue\n                xs[\"exit_reason\"] = f\"prompt_status_{_ps_code}\"\n                self._sse_error(_error_payload(f\"serve prompt HTTP {_ps_code}\"))\n                return True\n            if result.get(\"exit_reason\") in (\"prompt_status_429\",):\n                attempts.attempt_done(True, False)\n                if attempts.allow_retry(\"prompt_status_429\"):\n                    continue\n                xs[\"exit_reason\"] = \"prompt_status_429\"\n                self._sse_error(_error_payload(\"serve prompt HTTP 429\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                if result.get(\"transient_error\"):\n                    _has_attempt_output = bool(\n                        result[\"texts\"]\n                        or result[\"reasonings\"]\n                        or result.get(\"native_calls\")\n                        or emitted_tools_in_attempt[0]\n                    )\n                    _has_any_output = bool(\n                        collected_texts or collected_reasonings or _has_attempt_output\n                    )\n                    _delivered_err = _delivered_now or _has_any_output\n                    if _is_free_quota_error(err):\n                        _quarantine_proxy(result.get(\"proxy_url\"))\n                        if not _has_attempt_output:\n                            attempts.attempt_done(False, False)\n                            if attempts.allow_quota_rotation(\n                                \"serve_free_quota_proxy_rotate\"\n                            ) or attempts.allow_retry(\n                                \"serve_free_quota_retry\", charge_budget=False\n                            ):\n                                continue\n                        else:\n                            attempts.attempt_done(True, False)\n                    else:\n                        attempts.attempt_done(True, False)\n                        if not _has_attempt_output and attempts.allow_retry(\n                            \"serve_transient_error\"\n                        ):\n                            continue\n                    if not _delivered_err and not force_serve:\n                        xs[\"transport\"] = \"run\"\n                        xs[\"transport_history\"] = [\"serve\", \"run\"]\n                        return False\n                    # После частичной доставки: step-interruption recovery ниже по incomplete-сигналу.\n                    signal_t = _incomplete_step_signal(\n                        \"\".join(result[\"texts\"]),\n                        \"\".join(result[\"reasonings\"]),\n                        tools or [],\n                        True,\n                        int(result[\"usage\"].get(\"output\") or 0),\n                        int(result[\"usage\"].get(\"reasoning\") or 0),\n                        tool_choice=tool_choice,\n                    )\n                    if signal_t and attempts.allow_retry(\"incomplete_step\"):\n                        attempts.signal = signal_t\n                        current_prompt = _rewrite_tool_tags_for_model(\n                    _save_partial_output(texts, reasonings)\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._send(502, _error_payload(f\"serve {reason}\"))\n                return True\n            if result.get(\"prompt_status\") is not None:\n                _ps_j = int(result[\"prompt_status\"] or 0)\n                if _ps_j == 429 or 500 <= _ps_j <= 599:\n                    attempts.attempt_done(True, False)\n                if not _delivered_j and not force_serve:\n                    return False\n                if attempts.allow_retry(f\"prompt_status_{_ps_j}\"):\n                    _save_partial_output(texts, reasonings)\n                    continue\n                xs[\"exit_reason\"] = f\"prompt_status_{_ps_j}\"\n                self._send(502, _error_payload(f\"serve prompt HTTP {_ps_j}\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                if result.get(\"transient_error\"):\n                    is_free_quota = _is_free_quota_error(err)\n                    if is_free_quota:\n                        _quarantine_proxy(result.get(\"proxy_url\"))\n                    if not texts and not result.get(\"native_calls\"):\n                        if is_free_quota:\n                            attempts.attempt_done(False, False)\n                            retry_allowed = attempts.allow_quota_rotation(\n                                \"json_serve_free_quota_proxy_rotate\"\n                            ) or attempts.allow_retry(\n                                \"json_serve_free_quota_retry\", charge_budget=False\n                            )\n                        else:\n                            attempts.attempt_done(True, False)\n                            retry_allowed = attempts.allow_retry(\n                                \"serve_transient_error\"\n                            )\n                        if retry_allowed:\n                            _prior_content = \"\\n\\n\".join(c for c in contents if c)\n                            continue\n                    attempts.attempt_done(True, False)\n                    _save_partial_output(texts, reasonings)\n                    if not _delivered_j and not force_serve:\n                        return False\n                    _sig_j = _incomplete_step_signal(\n                        \"\".join(texts),\n                        \"\".join(reasonings),\n                        tools or [],\n                        True,\n                        int(result[\"usage\"].get(\"output\") or 0),\n                        int(result[\"usage\"].get(\"reasoning\") or 0),\n                        tool_choice=tool_choice,\n                    )\n                    if _sig_j and attempts.allow_retry(\"incomplete_step\"):\n                        _prior_content = \"\\n\\n\".join(c for c in contents if c)\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _incomplete_tool_step_prompt(\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1490,1640p' server.py; rg -n '_validate_image|_process_image|extract_images|_extract_images|_validate_and|sanitize.*image|validate.*image' server.py; sed -n '1360,1460p' core/tool_emulation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1490,1640p' server.py; rg -n '_validate_image|_process_image|extract_images|_extract_images|_validate_and|sanitize.*image|validate.*image' server.py; sed -n '1360,1460p' core/tool_emulation.py\"","aggregated_output":"\n\ndef _sniff_image(data: bytes) -> str:\n    \"\"\"MIME по магическим байтам ('' — сигнатура неизвестна).\"\"\"\n    for prefix, mime in IMAGE_SIGNATURES:\n        if data.startswith(prefix):\n            return mime\n    if data[:4] == b\"RIFF\" and data[8:12] == b\"WEBP\":\n        return \"image/webp\"\n    return \"\"\n\n\ndef _collect_image_parts(messages: Any) -> list:\n    \"\"\"Все image-части сообщений с их ролью, по порядку истории.\"\"\"\n    found = []\n    if not isinstance(messages, list):\n        return found\n    for msg in messages:\n        if not isinstance(msg, dict):\n            continue\n        content = msg.get(\"content\")\n        if not isinstance(content, list):\n            continue\n        for item in content:\n            if isinstance(item, dict) and item.get(\"type\") == \"image_url\":\n                found.append((str(msg.get(\"role\") or \"\"), item))\n    return found\n\n\ndef _parse_data_url(url: str) -> tuple:\n    \"\"\"data-URL -> (mime, bytes); ошибки — ImageReject из таксономии C-10.\"\"\"\n    comma = url.find(\",\")\n    if comma == -1:\n        raise ImageReject(\"invalid_image_content\")\n    head = url[5:comma]\n    payload = url[comma + 1 :]\n    fields = [f.strip().lower() for f in head.split(\";\")]\n    mime = fields[0] if fields else \"\"\n    if not mime or \"base64\" not in fields[1:]:\n        raise ImageReject(\"invalid_image_content\")\n    if mime not in KNOWN_IMAGE_MIMES:\n        raise ImageReject(\"unsupported_image_type\")\n    if not payload:\n        raise ImageReject(\"invalid_image_base64\")\n    try:\n        data = base64.b64decode(payload, validate=True)\n    except (binascii.Error, ValueError):\n        raise ImageReject(\"invalid_image_base64\")\n    return mime, data\n\n\ndef _collect_images(request: dict, model: dict, effort: str) -> list:\n    \"\"\"Проверить изображения запроса (C-08); [] — изображений нет.\n\n    Порядок: применимость модели/proof (класс II) -> форма частей -> data-URL ->\n    сигнатура -> формат -> лимиты (число, размер, сумма).\n    \"\"\"\n    messages = request.get(\"messages\")\n    parts = _collect_image_parts(messages)\n    if not parts:\n        return []\n    status = (model.get(\"images\") or {}).get(\"status\")\n    capable = status == \"confirmed\" or (status == \"probe\" and IMAGE_PROBE)\n    if not capable:\n        raise ImageReject(\"image_input_not_supported\")\n    reason = _image_proof_reason(model, effort)\n    if reason:\n        _log(f\"image_proof_invalid model={model.get('id')} reason={reason}\")\n        raise ImageReject(\"image_input_not_supported\")\n    limits = FLEET.get(\"image_limits\") or {}\n    max_images = int(limits.get(\"max_images\") or 0)\n    max_image_bytes = int(limits.get(\"max_image_bytes\") or 0)\n    max_total = int(limits.get(\"max_total_image_bytes\") or 0)\n    allowed = [str(t).lower() for t in (limits.get(\"max_types\") or [])]\n    images = []\n    total = 0\n    for role, item in parts:\n        if role != \"user\":\n            raise ImageReject(\"invalid_image_content\")\n        image_url = item.get(\"image_url\")\n        if not isinstance(image_url, dict):\n            raise ImageReject(\"invalid_image_content\")\n        url = image_url.get(\"url\")\n        if not isinstance(url, str):\n            raise ImageReject(\"invalid_image_content\")\n        if not url.startswith(\"data:\"):\n            raise ImageReject(\"image_url_not_allowed\")\n        mime, data = _parse_data_url(url)\n        sniffed = _sniff_image(data)\n        if not sniffed:\n            raise ImageReject(\"unsupported_image_type\")\n        if sniffed != mime:\n            raise ImageReject(\"image_type_mismatch\")\n        if mime not in allowed:\n            raise ImageReject(\"unsupported_image_type\")\n        if len(images) + 1 > max_images:\n            raise ImageReject(\"too_many_images\")\n        if len(data) > max_image_bytes:\n            raise ImageReject(\"image_too_large\")\n        total += len(data)\n        if total > max_total:\n            raise ImageReject(\"images_too_large\")\n        images.append({\"mime\": mime, \"data\": data})\n    for index, image in enumerate(images, 1):\n        image[\"name\"] = \"img-%d.%s\" % (\n            index,\n            IMAGE_EXTENSIONS.get(image[\"mime\"], \"bin\"),\n        )\n    return images\n\n\ndef _clean_err(text: str) -> str:\n    lines = [\n        ln for ln in (text or \"\").splitlines() if ln.strip() and not _NOISE.search(ln)\n    ]\n    return \"\\n\".join(lines).strip()\n\n\ndef shutdown_all(grace: float = SHUTDOWN_GRACE_S) -> int:\n    \"\"\"Закрыть детей параллельно после drain либо немедленно без drain.\n\n    При включённом drain ожиданием активных ходов управляет LIFECYCLE;\n    общий грейс здесь относится только к последующей очистке. Принудительно\n    убиваются ТОЛЬКО собственные процессные группы из реестра детей — чужие PID\n    никогда. Возвращает число закрывавшихся детей.\n    \"\"\"\n    global _shutting_down\n    _shutting_down = True\n    with _active_lock:\n        procs = list(_rpc_procs.values())\n    deadline = time.monotonic() + grace\n    threads = []\n    for proc in procs:\n        # interrupt и закрытие — в потоке процесса: зависшая запись одного ребёнка не\n        # задерживает остальных и не съедает общий грейс (RW-011).\n        thread = threading.Thread(\n            target=_shutdown_one,\n            args=(\n                proc,\n                {\n                    \"mode\": \"graceful\",\n                    \"graceful_wait\": grace * 0.45,\n                    \"term_wait\": grace * 0.2,\n                    \"kill_wait\": grace * 0.15,\n                },\n            ),\n            daemon=True,\n        )\n        try:\n            thread.start()\n        except RuntimeError:\n    \"<arg_key>\",\n    \"</arg_key>\",\n    \"<arg_value>\",\n    \"</arg_value>\",\n)\n# (MIME, магические байты, расширение файла) — принимаемые форматы вложений.\n_IMAGE_FORMATS = (\n    (\"image/png\", b\"\\x89PNG\\r\\n\\x1a\\n\", \"png\"),\n    (\"image/jpeg\", b\"\\xff\\xd8\\xff\", \"jpg\"),\n)\n\n\nclass ImageInputError(ValueError):\n    \"\"\"Отказ валидации изображения запроса; `code` — машинный код причины.\"\"\"\n\n    def __init__(self, code: str):\n        super().__init__(code)\n        self.code = code\n\n\ndef _sniff_image_mime(data: bytes) -> str:\n    \"\"\"MIME по магическим байтам ('' — сигнатура неизвестна).\"\"\"\n    for mime, magic, _ext in _IMAGE_FORMATS:\n        if data.startswith(magic):\n            return mime\n    return \"\"\n\n\ndef extract_data_url_images(\n    messages: Any,\n    *,\n    max_images: int = DEFAULT_MAX_IMAGES,\n    max_image_bytes: int = DEFAULT_MAX_IMAGE_BYTES,\n    max_total_bytes: int = DEFAULT_MAX_TOTAL_IMAGE_BYTES,\n) -> list[dict]:\n    \"\"\"Все `image_url`-части истории -> [{\"name\", \"mime\", \"data\"}] в порядке появления.\n\n    Принимаются только data URI с base64 PNG/JPEG: строгая проверка кодировки и\n    соответствия MIME сигнатуре; URL не скачиваются, `file://` не читается,\n    пользовательские пути не используются (имена генерируются: `image_N.<ext>`).\n    Любое нарушение — `ImageInputError` до запуска CLI (fail-closed).\n    \"\"\"\n    images: list[dict] = []\n    total = 0\n    if not isinstance(messages, list):\n        return images\n    for msg in messages:\n        if not isinstance(msg, dict) or not isinstance(msg.get(\"content\"), list):\n            continue\n        for item in msg[\"content\"]:\n            if not isinstance(item, dict) or item.get(\"type\") != \"image_url\":\n                continue\n            image_url = item.get(\"image_url\")\n            url = image_url.get(\"url\") if isinstance(image_url, dict) else None\n            if not isinstance(url, str):\n                raise ImageInputError(\"invalid_image_content\")\n            if not url.startswith(\"data:\"):\n                raise ImageInputError(\"image_url_not_allowed\")\n            comma = url.find(\",\")\n            if comma == -1:\n                raise ImageInputError(\"invalid_image_content\")\n            fields = [f.strip().lower() for f in url[5:comma].split(\";\")]\n            mime = fields[0] if fields else \"\"\n            if not mime or \"base64\" not in fields[1:]:\n                raise ImageInputError(\"invalid_image_content\")\n            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\n            if not ext:\n                raise ImageInputError(\"unsupported_image_type\")\n            if len(images) >= max_images:\n                raise ImageInputError(\"too_many_images\")\n            approx_bytes = (len(url) - comma - 1) * 3 // 4\n            if approx_bytes > max_image_bytes:\n                raise ImageInputError(\"image_too_large\")\n            if total + approx_bytes > max_total_bytes:\n                raise ImageInputError(\"images_too_large\")\n            payload = url[comma + 1 :]\n            if not payload:\n                raise ImageInputError(\"invalid_image_base64\")\n            try:\n                data = base64.b64decode(payload, validate=True)\n            except (binascii.Error, ValueError):\n                raise ImageInputError(\"invalid_image_base64\") from None\n            sniffed = _sniff_image_mime(data)\n            if not sniffed:\n                raise ImageInputError(\"unsupported_image_type\")\n            if sniffed != mime:\n                raise ImageInputError(\"image_type_mismatch\")\n            if len(data) > max_image_bytes:\n                raise ImageInputError(\"image_too_large\")\n            total += len(data)\n            if total > max_total_bytes:\n                raise ImageInputError(\"images_too_large\")\n            images.append(\n                {\"name\": f\"image_{len(images) + 1}.{ext}\", \"mime\": mime, \"data\": data}\n            )\n    return images\n\n\ndef extract_thinking_delta(delta: Any) -> str:\n    \"\"\"Текст нативной дельты размышления (`thinking_delta`) -> строка; иначе ''.\n\n","exit_code":0,"status":"completed"}}
