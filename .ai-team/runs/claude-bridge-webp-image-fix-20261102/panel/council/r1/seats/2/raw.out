> повтор шага, детерминированная\n                            # (401…) -> ошибка клиенту без повтора. Ошибка до первого токена — не трогаем:\n                            # opencode повторит сам или выйдет, и тогда флаг не должен «залипнуть».\n                            if _is_transient_stream_error(payload):\n                                had_provider_error = True\n                            else:\n                                fatal_mid_error = True\n                            _log(\n                                f\"stream: provider error mid-response (transient={had_provider_error}), \"\n                                \"stopping opencode run\"\n                            )\n                            stopped_on_error = True\n                            _stop_proc(proc)\n                            break\n                        _log(\"stream: early provider error (waiting for CLI recovery)\")\n                    elif etype == \"tool_use\":\n                        attempt_output = True\n                        part = _dict_or_empty(event.get(\"part\"))\n                        tstate = _dict_or_empty(part.get(\"state\"))\n                        calls = (\n                            _native_to_tool_calls(\n                                part.get(\"tool\"), tstate.get(\"input\"), tools or []\n                            )\n                            if emulate_tools\n                            else []\n                        )\n                        _log(\n                            f\"opencode built-in tool event: tool={part.get('tool')} status={tstate.get('status')} \"\n                            f\"mapped={bool(calls)} as={[c['name'] for c in calls]}\"\n                        )\n                        if calls:\n                            if parser is not None:\n    p1 = bridge._next_standalone_proxy()\n    p2 = bridge._next_standalone_proxy()\n    assert p1 != p2\n    bridge._quarantine_proxy(f\" {p1} \", 20)\n    assert bridge._next_standalone_proxy() == p2\n    bridge._quarantine_proxy(p2, 10)\n    assert bridge._next_standalone_proxy() == p2\n    now[0] = 110.0\n    assert bridge._next_standalone_proxy() == p2\n    assert p2 not in bridge._proxy_quarantine_until\n    now[0] = 120.0\n    assert bridge._next_standalone_proxy() == p1\n    assert not bridge._proxy_quarantine_until\n    bridge._quarantine_proxy(p1)\n    bridge._reset_proxy_pool_for_tests()\n    assert not bridge._proxy_quarantine_until\n\n\n@pytest.mark.parametrize(\n    \"err, expected\",\n    [\n        ({\"type\": \"provider.free-limit\", \"message\": \"Quota\"}, True),\n        ({\"message\": \"Free usage limit reached\"}, True),\n        (\"USAGE LIMIT REACHED\", True),\n        (\"provider.free-limit\", True),\n        (\"Request quota exhausted.\", True),\n        (\"Request quota exhausted. QUOTA\", True),\n        ({\"message\": \"subscription quota exhausted\"}, True),\n        (\"QUOTA EXHAUSTED\", True),\n        ({\"message\": \"Connection lost\"}, False),\n        (None, False),\n    ],\n)\ndef test_is_free_quota_error(bridge: Any, err: object, expected: bool) -> None:\n    assert bridge._is_free_quota_error(err) is expected\n\n\n@pytest.mark.parametrize(\n    \"ev\",\n    [\n        {\"statusCode\": 400, \"message\": \"Request quota exhausted.\"},\n        {\n            \"type\": \"error\",\n            \"error\": {\"statusCode\": 400, \"message\": \"subscription quota exhausted\"},\n        },\n        {\"type\": \"error\", \"error\": \"Request quota exhausted. QUOTA\", \"status\": 400},\n    ],\n)\ndef test_quota_stream_error_is_transient_despite_fatal_status(\n    bridge: Any, ev: dict[str, Any]\n) -> None:\n    assert bridge._is_transient_stream_error(ev) is True\n\n\ndef test_fatal_stream_error_without_quota_stays_fatal(bridge: Any) -> None:\n    assert (\n        bridge._is_transient_stream_error(\n            {\"statusCode\": 400, \"message\": \"invalid request body\"}\n        )\n        is False\n    )\n\n\ndef test_map_serve_event_preserves_quota_type(bridge: Any) -> None:\n    mapped = bridge._map_serve_event(\n        {\n            \"type\": \"session.execution.failed\",\n            \"data\": {\n                \"sessionID\": \"s1\",\n                \"error\": {\n                    \"type\": \"provider.free-limit\",\n                    \"message\": \"Quota\",\n                    \"status\": 429,\n                },\n            },\n        }\n    )\n    assert mapped == (\n        \"error\",\n        {\n            \"statusCode\": 429,\n            \"message\": \"Quota\",\n            \"type\": \"provider.free-limit\",\n            \"sessionID\": \"s1\",\n        },\n    )\n\n\ndef test_quota_rotation_extends_spawn_limit_without_charging_retry_budget(\n    bridge: Any,\n) -> None:\n    attempts = _attempts(bridge, max_total=2, max_quota_rotations=1)\n    attempts.note_spawn()\n    assert attempts.allow_quota_rotation()\n    assert attempts.quota_rotations == 1 and attempts.retries == 0\n    attempts.res.retry_budget.try_acquire_retry.assert_not_called()\n    assert not attempts.allow_quota_rotation()\n    attempts.note_spawn()\n    assert attempts.can_spawn() and attempts.begin_attempt()\n    attempts.note_spawn()\n    assert not attempts.can_spawn() and not attempts.begin_attempt()\n\n\n@pytest.mark.parametrize(\"denial\", [\"limit\", \"deadline\", \"aux\", \"blocking\", \"probe\"])\ndef test_denied_quota_rotation_does_not_change_counters(\n    bridge: Any, denial: str\n) -> None:\n    attempts = _attempts(bridge)\n    if denial == \"limit\":\n        attempts.total_spawns = bridge.MAX_TOTAL_SPAWNS\n    elif denial == \"deadline\":\ntests/test_claude_bridge.py:34:GIF_BYTES = b\"GIF89a\" + b\"\\x00\" * 16\ntests/test_claude_bridge.py:35:GIF87_BYTES = b\"GIF87a\" + b\"\\x00\" * 16\ntests/test_claude_bridge.py:36:WEBP_BYTES = b\"RIFF\\x00\\x00\\x00\\x00WEBPVP8 \" + b\"\\x00\" * 16\ntests/test_claude_bridge.py:353:            [{\"role\": \"user\", \"content\": [_image_part(\"image/png\", GIF_BYTES)]}]\ntests/test_claude_bridge.py:361:def test_image_extract_webp_and_gif_names():\ntests/test_claude_bridge.py:363:        {\"role\": \"user\", \"content\": [_image_part(\"image/webp\", WEBP_BYTES)]},\ntests/test_claude_bridge.py:364:        {\"role\": \"user\", \"content\": [_image_part(\"image/gif\", GIF_BYTES)]},\ntests/test_claude_bridge.py:365:        {\"role\": \"user\", \"content\": [_image_part(\"image/gif\", GIF87_BYTES)]},\ntests/test_claude_bridge.py:369:        \"image_1.webp\",\ntests/test_claude_bridge.py:370:        \"image_2.gif\",\ntests/test_claude_bridge.py:371:        \"image_3.gif\",\ntests/test_claude_bridge.py:373:    assert images[0][\"data\"] == WEBP_BYTES and images[0][\"mime\"] == \"image/webp\"\ntests/test_claude_bridge.py:374:    assert images[1][\"data\"] == GIF_BYTES and images[1][\"mime\"] == \"image/gif\"\ntests/test_claude_bridge.py:375:    assert images[2][\"data\"] == GIF87_BYTES\ntests/test_claude_bridge.py:378:def test_image_extract_rejects_non_webp_riff_and_webp_mismatch():\ntests/test_claude_bridge.py:381:            [{\"role\": \"user\", \"content\": [_image_part(\"image/webp\", RIFF_WAVE_BYTES)]}]\ntests/test_claude_bridge.py:386:            [{\"role\": \"user\", \"content\": [_image_part(\"image/png\", WEBP_BYTES)]}]\ntests/test_claude_bridge.py:391:            [{\"role\": \"user\", \"content\": [_image_part(\"image/webp\", b\"RIFF\\x00\\x00\")]}]\ntests/test_opencode_zen_bridge.py:19:    spec = importlib.util.spec_from_file_location(\"zen_quota_test_server\", path)\ntests/test_opencode_zen_bridge.py:76:def _quota_result(**overrides: Any) -> dict[str, Any]:\ntests/test_opencode_zen_bridge.py:79:            \"type\": \"provider.free-limit\",\ntests/test_opencode_zen_bridge.py:172:def test_stream_serve_attempt2_free_quota_error_after_attempt1_reasoning_rotates_proxy(\ntests/test_opencode_zen_bridge.py:182:        _quota_result(),\ntests/test_opencode_zen_bridge.py:196:    assert attempts.quota_rotations == 1\ntests/test_opencode_zen_bridge.py:212:            _quota_result(\ntests/test_opencode_zen_bridge.py:227:@pytest.mark.parametrize(\"free_quota\", [True, False])\ntests/test_opencode_zen_bridge.py:231:    free_quota: bool,\ntests/test_opencode_zen_bridge.py:235:    failed = _quota_result(reasonings=[\"thinking...\"], proxy_url=\"http://p1:10001\")\ntests/test_opencode_zen_bridge.py:236:    if not free_quota:\ntests/test_opencode_zen_bridge.py:251:    assert (\"http://p1:10001\" in bridge._proxy_quarantine_until) == free_quota\ntests/test_opencode_zen_bridge.py:311:        ({\"type\": \"provider.free-limit\", \"message\": \"Quota\"}, True),\ntests/test_opencode_zen_bridge.py:314:        (\"provider.free-limit\", True),\ntests/test_opencode_zen_bridge.py:315:        (\"Request quota exhausted.\", True),\ntests/test_opencode_zen_bridge.py:316:        (\"Request quota exhausted. QUOTA\", True),\ntests/test_opencode_zen_bridge.py:317:        ({\"message\": \"subscription quota exhausted\"}, True),\ntests/test_opencode_zen_bridge.py:323:def test_is_free_quota_error(bridge: Any, err: object, expected: bool) -> None:\ntests/test_opencode_zen_bridge.py:324:    assert bridge._is_free_quota_error(err) is expected\ntests/test_opencode_zen_bridge.py:330:        {\"statusCode\": 400, \"message\": \"Request quota exhausted.\"},\ntests/test_opencode_zen_bridge.py:333:            \"error\": {\"statusCode\": 400, \"message\": \"subscription quota exhausted\"},\ntests/test_opencode_zen_bridge.py:335:        {\"type\": \"error\", \"error\": \"Request quota exhausted. QUOTA\", \"status\": 400},\ntests/test_opencode_zen_bridge.py:338:def test_quota_stream_error_is_transient_despite_fatal_status(\ntests/test_opencode_zen_bridge.py:344:def test_fatal_stream_error_without_quota_stays_fatal(bridge: Any) -> None:\ntests/test_opencode_zen_bridge.py:353:def test_map_serve_event_preserves_quota_type(bridge: Any) -> None:\ntests/test_opencode_zen_bridge.py:360:                    \"type\": \"provider.free-limit\",\ntests/test_opencode_zen_bridge.py:372:            \"type\": \"provider.free-limit\",\ntests/test_opencode_zen_bridge.py:378:def test_quota_rotation_extends_spawn_limit_without_charging_retry_budget(\ntests/test_opencode_zen_bridge.py:381:    attempts = _attempts(bridge, max_total=2, max_quota_rotations=1)\ntests/test_opencode_zen_bridge.py:383:    assert attempts.allow_quota_rotation()\ntests/test_opencode_zen_bridge.py:384:    assert attempts.quota_rotations == 1 and attempts.retries == 0\ntests/test_opencode_zen_bridge.py:386:    assert not attempts.allow_quota_rotation()\ntests/test_opencode_zen_bridge.py:394:def test_denied_quota_rotation_does_not_change_counters(\ntests/test_opencode_zen_bridge.py:408:    assert not attempts.allow_quota_rotation()\ntests/test_opencode_zen_bridge.py:409:    assert attempts.quota_rotations == 0 and attempts.retries == 0\ntests/test_opencode_zen_bridge.py:414:def test_serve_quota_rotations_can_exceed_base_spawn_limit(\ntests/test_opencode_zen_bridge.py:420:    attempts = _attempts(bridge, max_quota_rotations=3)\ntests/test_opencode_zen_bridge.py:425:            _quota_result(),\ntests/test_opencode_zen_bridge.py:426:            _quota_result(),\ntests/test_opencode_zen_bridge.py:427:            _quota_result(),\ntests/test_opencode_zen_bridge.py:438:    assert attempts.quota_rotations == 3\n# 0023 — Поддержка WebP/GIF в ядре и отказоустойчивость ротации квот OpenCode Zen\n\n## Status\nAccepted / Approved, 2026-11-02.\n\n## Context\nПользователи DeepSeek Harness прикрепляют изображения со скриншотами macOS в формате WebP, что приводило к ошибке 400 `unsupported_image_type` на модели `Claude Opus 5.5` из-за ограничения `_IMAGE_FORMATS` в `core/tool_emulation.py`. Последующая попытка продолжить диалог на `MiMo-V2.6-Flash (Zen) Max` завершалась терминальным сбоем `Request quota exhausted. QUOTA` из-за отсутствия маркера `quota exhausted` в предикате `_is_free_quota_error` моста `opencode-zen-bridge`.\n\n## Decision\n1. В `core/tool_emulation.py` расширить `_IMAGE_FORMATS` и добавить поддержку форматов `image/gif` и `image/webp`. В `_sniff_image_mime` реализовать строгую двухточечную проверку заголовков `RIFF` и `WEBP` (`data[:4] == b\"RIFF\" and data[8:12] == b\"WEBP\"`).\n2. В `bridges/opencode-zen-bridge/server.py` расширить кортеж маркеров квоты в `_is_free_quota_error` фразами `\"quota exhausted\"`, `\"request quota exhausted\"`, `\"subscription quota exhausted\"`.\n3. Добавить регрессионные тесты в `tests/test_claude_bridge.py`, `tests/test_images_strict.py` и `tests/test_opencode_zen_bridge.py`.\n\n## Consequences\n- Все четыре формата из `KNOWN_IMAGE_MIMES` (PNG, JPEG, GIF, WebP) единообразно валидируются на системном уровне ядра.\n- Сбои исчерпания бесплатной квоты OpenCode Zen автоматически изолируются карантином текущего порта и ротируются без сбоя в пользовательской сессии.\n0057ea7035fdc73e6d3f5d19dad85a21997f363301e30cae49d21e1759d1d178  -\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat tests/test_images_strict.py; sed -n '1,270p' tests/test_opencode_zen_bridge.py; sed -n '400,465p' tests/test_claude_bridge.py; rg -n 'image|IMAGE|KNOWN_IMAGE_MIMES' bridges/claude-p-bridge/server.py core/tool_emulation.py; rg -n 'quota|L3|428|737|pytest' .ai-team/runs/claude-bridge-webp-image-fix-20261102/acceptance* .ai-team/runs/claude-bridge-webp-image-fix-20261102/receipts/*\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat tests/test_images_strict.py; sed -n '1,270p' tests/test_opencode_zen_bridge.py; sed -n '400,465p' tests/test_claude_bridge.py; rg -n 'image|IMAGE|KNOWN_IMAGE_MIMES' bridges/claude-p-bridge/server.py core/tool_emulation.py; rg -n 'quota|L3|428|737|pytest' .ai-team/runs/claude-bridge-webp-image-fix-20261102/acceptance* .ai-team/runs/claude-bridge-webp-image-fix-20261102/receipts/*\"","aggregated_output":"\"\"\"Тесты image-пути моста (C-08…C-11): таксономия C-10, лимиты, хранение, proof.\"\"\"\n\nimport json\nimport os\nimport sys\nimport time\nimport unittest\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n\nimport server  # noqa: E402\nfrom bridge_testlib import (  # noqa: E402\n    BridgeCase,\n    JPEG_MAGIC,\n    GIF_MAGIC,\n    WEBP_MAGIC,\n    find_model,\n    image_part,\n    image_url_part,\n    make_png,\n    make_sig,\n    make_proof,\n    text_part,\n)\n\n\ndef user_message(parts):\n    return {\"role\": \"user\", \"content\": parts}\n\n\nclass ImageCase(BridgeCase):\n    \"\"\"Общие стенды: probe-модель и confirmed-модель с proof.\"\"\"\n\n    def probe_stand(self, model_id=\"claude-sonnet-5-5\", limits=None):\n        def mutate(data):\n            item = find_model(data, model_id)\n            item[\"input\"] = [\"text\", \"image\"]\n            item[\"images\"][\"status\"] = \"probe\"\n            item[\"images\"][\"method\"] = \"workspace-read\"\n            if limits:\n                data[\"image_limits\"].update(limits)\n\n        return self.stand(mutate, probe=True)\n\n    def confirmed_stand(\n        self,\n        model_id=\"deepseek-v4.1-flash\",\n        efforts_proven=None,\n        impl_version=1,\n        formats=(\"image/png\",),\n        binary_bytes=b\"stand-binary\",\n    ):\n        binary = Path(self._tmp.name) / (\"droid-\" + model_id)\n        binary.write_bytes(binary_bytes)\n        holder = {}\n\n        def mutate(data):\n            item = find_model(data, model_id)\n            item[\"input\"] = [\"text\", \"image\"]\n            item[\"images\"][\"status\"] = \"confirmed\"\n            item[\"images\"][\"method\"] = \"workspace-read\"\n            item[\"images\"][\"proof\"] = make_proof(\n                binary,\n                efforts_proven if efforts_proven is not None else item[\"efforts\"],\n                impl_version=impl_version,\n                formats=formats,\n            )\n            data[\"technical_ref\"][\"droid_binary_path\"] = str(binary)\n            holder[\"item\"] = item\n\n        self.stand(mutate)\n        return binary, holder\n\n\nclass TestImagePositive(ImageCase):\n    \"\"\"Картинки идут в эфемерную RPC-сессию: проверяем фактический ввод и раскладку temp-файлов.\"\"\"\n\n    def _image_dir_prefix(self):\n        return os.path.realpath(str(server.WORKSPACE)) + \"/img-\"\n\n    def test_two_images_history_prompt_and_layout(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        first, second = make_png(64), make_png(80)\n        messages = [\n            user_message([text_part(\"first\"), image_part(first)]),\n            {\"role\": \"assistant\", \"content\": \"ok\"},\n            user_message([image_part(second), text_part(\"second\")]),\n        ]\n        with self.capture_logs() as lines:\n            status, _ = self._post(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": messages,\n                }\n            )\n        self.assertEqual(status, 200)\n        spawn = self.hub.spawns()[-1]\n        self.assertEqual(spawn[\"cwd_mode\"], \"0o700\")\n        self.assertEqual(\n            spawn[\"cwd_files\"], {\"img-1.png\": \"0o600\", \"img-2.png\": \"0o600\"}\n        )\n        self.assertTrue(spawn[\"cwd\"].startswith(self._image_dir_prefix()))\n        execs = [ln for ln in lines if ln.startswith(\"exec model=\")]\n        self.assertIn(\n            \" images=2 image_bytes=%d image_types=image/png,image/png\"\n            % (len(first) + len(second)),\n            execs[0],\n        )\n        texts = self.hub.sent_texts()\n        self.assertEqual(\n            len(texts), 3\n        )  # история replay-ится по сообщениям, цикл запускает последнее\n        self.assertEqual(texts[0], \"first\\n[image 1]\")\n        self.assertEqual(texts[1], \"ok\")\n        self.assertTrue(texts[2].startswith(\"[image 2]\\nsecond\"))\n        self.assertIn(\n            \"- [image 1] ./img-1.png (image/png, %d bytes)\" % len(first), texts[2]\n        )\n        self.assertIn(\n            \"- [image 2] ./img-2.png (image/png, %d bytes)\" % len(second), texts[2]\n        )\n        self.assertIn(\"[attachments]\", texts[2])\n        self.assertIn(\n            \"Open each image with the Read tool on exactly these paths\", texts[2]\n        )\n        self.assertTrue(\n            self.hub.rpcs(\"droid.add_user_message\")[0][\"params\"][\"skipAgentLoop\"]\n        )\n        self.assertNotIn(\n            \"skipAgentLoop\", self.hub.rpcs(\"droid.add_user_message\")[2][\"params\"]\n        )\n        # Read остаётся доступным (нужен для чтения вложений), остальные нативные tools отключены.\n        disabled = self.hub.rpcs(\"droid.update_session_settings\")[0][\"params\"][\n            \"disabledToolIds\"\n        ]\n        self.assertNotIn(\"Read\", disabled)\n        self.assertIn(\"Execute\", disabled)\n        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n\n    def test_sixteen_images_at_the_limit(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        parts = [image_part(make_png(64 + i)) for i in range(16)]\n        status, _ = self._post(\n            {\n                \"model\": \"claude-sonnet-5-5\",\n                \"reasoning_effort\": \"high\",\n                \"messages\": [user_message(parts)],\n            }\n        )\n        self.assertEqual(status, 200)\n        spawn = self.hub.spawns()[-1]\n        self.assertEqual(len(spawn[\"cwd_files\"]), 16)\n        prompt = self.hub.sent_texts()[-1]\n        for index in range(1, 17):\n            self.assertIn(\n                \"- [image %d] ./img-%d.png (image/png,\" % (index, index), prompt\n            )\n        self.assertEqual(prompt.count(\"[image 1]\"), 2)  # маркер и строка manifest\n\n    def test_image_only_message_is_not_pong(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        status, _ = self._post(\n            {\n                \"model\": \"claude-sonnet-5-5\",\n                \"reasoning_effort\": \"high\",\n                \"messages\": [user_message([image_part(make_png(64))])],\n            }\n        )\n        self.assertEqual(status, 200)\n        prompt = self.hub.sent_texts()[-1]\n        self.assertNotIn(\"Reply with exactly: PONG\", prompt)\n        self.assertTrue(prompt.startswith(\"[image 1]\"))\n\n    def test_unknown_non_image_parts_are_skipped(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        with self.capture_logs() as lines:\n            status, _ = self._post(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": [\n                        user_message(\n                            [\n                                text_part(\"hello\"),\n                                {\n                                    \"type\": \"input_audio\",\n                                    \"input_audio\": {\"data\": \"AAAA\", \"format\": \"wav\"},\n                                },\n                            ]\n                        )\n                    ],\n                }\n            )\n        self.assertEqual(status, 200)\n        execs = [ln for ln in lines if ln.startswith(\"exec model=\")]\n        self.assertNotIn(\" images=\", execs[0])\n        self.assertEqual(self.hub.sent_texts(), [\"hello\"])\n\n    def test_tools_get_read_exception_with_attachments(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": \"get_weather\",\n                    \"description\": \"Get weather\",\n                    \"parameters\": {\"type\": \"object\"},\n                },\n            }\n        ]\n        status, _ = self._post(\n            {\n                \"model\": \"claude-sonnet-5-5\",\n                \"reasoning_effort\": \"high\",\n                \"tools\": tools,\n                \"messages\": [\n                    user_message([text_part(\"weather?\"), image_part(make_png(64))])\n                ],\n            }\n        )\n        self.assertEqual(status, 200)\n        system = self.hub.inits()[-1][\"params\"][\"systemPrompt\"]\n        self.assertIn(\n            \"except Read on the attachment files listed under [attachments].\", system\n        )\n        self.assertIn(\"[attachments]\", self.hub.sent_texts()[-1])\n\n\nclass TestImageRejections(ImageCase):\n    def test_unverified_and_unsupported_models_rejected(self):\n        server.IMAGE_PROBE = True\n        for model, expected in (\n            (\"gemini-3.8-flash\", \"image_input_not_supported\"),\n            (\"glm-5.3\", \"image_input_not_supported\"),\n        ):\n            before = len(self.hub.spawns())\n            status, body = self._post_json(\n                {\n                    \"model\": model,\n                    \"reasoning_effort\": \"max\" if model == \"glm-5.3\" else \"high\",\n                    \"messages\": [\n                        user_message([text_part(\"x\"), image_part(make_png(64))])\n                    ],\n                }\n            )\n            self.assertEqual(status, 400, model)\n            self.assertEqual(body[\"error\"][\"type\"], expected)\n            self.assertEqual(len(self.hub.spawns()), before)\n\n    def test_taxonomy(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        png = make_png(64)\n        cases = [\n            (\"image_url_not_allowed\", image_url_part(\"http://127.0.0.1:19886/a.png\")),\n            (\"image_url_not_allowed\", image_url_part(\"file:///etc/hosts\")),\n            (\"image_url_not_allowed\", image_url_part(\"https://example.com/a.png\")),\n            (\"unsupported_image_type\", image_url_part(\"data:text/plain;base64,aGk=\")),\n            (\n                \"unsupported_image_type\",\n                image_url_part(\"data:image/svg+xml;base64,PHN2Zy8+\"),\n            ),\n            (\"invalid_image_base64\", image_url_part(\"data:image/png;base64,@@@@\")),\n            (\"invalid_image_base64\", image_url_part(\"data:image/png;base64,\")),\n            (\"image_type_mismatch\", image_part(make_sig(JPEG_MAGIC, 64), \"image/png\")),\n            (\"unsupported_image_type\", image_part(b\"\\x00\" * 64, \"image/png\")),\n            (\"invalid_image_content\", image_url_part(\"data:image/png,rawdata\")),\n            (\n                \"invalid_image_content\",\n                {\"type\": \"image_url\", \"image_url\": \"data:image/png;base64,AAAA\"},\n            ),\n            (\"invalid_image_content\", {\"type\": \"image_url\", \"image_url\": {}}),\n            (\n                \"unsupported_image_type\",\n                image_part(make_sig(JPEG_MAGIC, 64), \"image/jpeg\"),\n            ),\n            (\n                \"unsupported_image_type\",\n                image_part(make_sig(WEBP_MAGIC, 64), \"image/webp\"),\n            ),\n            (\n                \"unsupported_image_type\",\n                image_part(make_sig(GIF_MAGIC, 64), \"image/gif\"),\n            ),\n        ]\n        for expected, part in cases:\n            before = len(self.hub.spawns())\n            status, body = self._post_json(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": [user_message([text_part(\"x\"), part])],\n                }\n            )\n            self.assertEqual(status, 400, expected)\n            self.assertEqual(body[\"error\"][\"type\"], expected)\n            self.assertEqual(len(self.hub.spawns()), before)\n        for role in (\"assistant\", \"system\", \"tool\"):\n            messages = [\n                user_message([text_part(\"hi\")]),\n                {\"role\": role, \"content\": [image_part(png)]},\n            ]\n            status, body = self._post_json(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": messages,\n                }\n            )\n            self.assertEqual(status, 400, role)\n            self.assertEqual(body[\"error\"][\"type\"], \"invalid_image_content\")\n\n    def test_reject_line_for_image_is_strict(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        with self.capture_logs() as lines:\n            self._post(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": [\n                        user_message(\n                            [\n                                text_part(\"x\"),\n                                image_url_part(\"http://127.0.0.1:19886/a.png\"),\n                            ]\n                        )\n                    ],\n                }\n            )\n        rejects = [ln for ln in lines if \"reject reason=\" in ln]\n        self.assertEqual(len(rejects), 1)\n        self.assertEqual(rejects[0], rejects[0].rstrip())\n        self.assertRegex(\n            rejects[0],\n            r\"^reject reason=image_url_not_allowed \"\n            r\"model=claude-sonnet-5-5 model_len=\\d+ client=[0-9.:]+$\",\n        )\n\n    def test_limits(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand(\n            limits={\n                \"max_images\": 2,\n                \"max_image_bytes\": 1000,\n                \"max_total_image_bytes\": 1500,\n            }\n        )\n\n        def post(parts):\n            return self._post_json(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": [user_message(parts)],\n                }\n            )\n\n        status, body = post([image_part(make_png(64))] * 3)\n        self.assertEqual(body[\"error\"][\"type\"], \"too_many_images\")\n        status, body = post([image_part(make_png(1001))])\n        self.assertEqual(body[\"error\"][\"type\"], \"image_too_large\")\n        status, body = post([image_part(make_png(800)), image_part(make_png(800))])\n        self.assertEqual(body[\"error\"][\"type\"], \"images_too_large\")\n        status, _ = post([image_part(make_png(700)), image_part(make_png(700))])\n        self.assertEqual(status, 200)\n\n\nclass TestImageCleanup(ImageCase):\n    def test_cleanup_after_success(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        status, _ = self._post(\n            {\n                \"model\": \"claude-sonnet-5-5\",\n                \"reasoning_effort\": \"high\",\n                \"messages\": [user_message([image_part(make_png(64))])],\n            }\n        )\n        self.assertEqual(status, 200)\n        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n\n    def test_cleanup_after_exception(self):\n        # Сбой запуска (лончер умирает сразу): 502 и ни одного каталога картинок.\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        broken = Path(self._tmp.name) / \"broken-launcher\"\n        broken.write_text(\"#!/bin/sh\\nexit 1\\n\", encoding=\"utf-8\")\n        broken.chmod(0o755)\n        server.LAUNCHER = str(broken)\n        status, _ = self._post_json(\n            {\n                \"model\": \"claude-sonnet-5-5\",\n                \"reasoning_effort\": \"high\",\n                \"messages\": [user_message([image_part(make_png(64))])],\n            }\n        )\n        self.assertEqual(status, 502)\n        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n\n    def test_cleanup_after_retries(self) -> None:\n        \"\"\"Каждый явный повтор клиента запускает CLI один раз и очищает свои изображения.\"\"\"\n        from typing import Callable, cast\n\n        probe_stand = cast(Callable[[], object], getattr(self, \"probe_stand\"))\n        legacy = cast(\n            Callable[[list[list[tuple[str, object]]]], None],\n            getattr(self.hub, \"legacy\"),\n        )\n        admissions = cast(Callable[[], list[object]], getattr(self.hub, \"admissions\"))\n        spawns = cast(\n            Callable[[], list[dict[str, object]]], getattr(self.hub, \"spawns\")\n        )\n        post = cast(\n            Callable[[dict[str, object]], tuple[int, object]],\n            getattr(self, \"_post_json\"),\n        )\n        server.IMAGE_PROBE = True\n        _ = probe_stand()\n        legacy([[(\"stderr\", \"Exec failed\"), (\"done\", (1, \"\"))] for _ in range(3)])\n        request: dict[str, object] = {\n            \"model\": \"claude-sonnet-5-5\",\n            \"reasoning_effort\": \"high\",\n            \"messages\": [user_message([image_part(make_png(64))])],\n        }\n        for expected_calls in range(1, 4):\n            status, _ = post(request)\n            self.assertEqual(status, 502)\n            self.assertEqual(len(admissions()), expected_calls)\n            self.assertEqual(len(spawns()), expected_calls)\n            self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n        actual_spawns = spawns()\n        self.assertEqual(len(actual_spawns), 3)\n        for spawn in actual_spawns:  # права temp-файлов каждого запроса сохранены\n            self.assertEqual(spawn[\"cwd_files\"], {\"img-1.png\": \"0o600\"})\n        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n\n    def test_cleanup_after_client_gone(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        real_gone = server._client_gone\n        server._client_gone = lambda sock: True\n        try:\n            raw = self._raw_request(\n                json.dumps(\n                    {\n                        \"model\": \"claude-sonnet-5-5\",\n                        \"reasoning_effort\": \"high\",\n                        \"messages\": [user_message([image_part(make_png(64))])],\n                    }\n                ).encode()\n            )\n            sock = __import__(\"socket\").create_connection(\n                (\"127.0.0.1\", self.port), timeout=5\n            )\n            sock.sendall(raw)\n            time.sleep(0.7)\n            sock.close()\n        finally:\n            server._client_gone = real_gone\n        deadline = time.time() + 5\n        while time.time() < deadline and list(server.WORKSPACE.glob(\"img-*\")):\n            time.sleep(0.1)\n        self.assertEqual(list(server.WORKSPACE.glob(\"img-*\")), [])\n        # Клиент ушёл раньше хода: ход не доходит до модели, процесс не остаётся.\n        self.assertLessEqual(len(self.hub.spawns()), 1)\n        self.assertEqual(len(self.hub.admissions()), 0)\n\n\nclass TestProofFailClosed(ImageCase):\n    def request(self, model, effort=\"high\"):\n        return self._post_json(\n            {\n                \"model\": model,\n                \"reasoning_effort\": effort,\n                \"messages\": [user_message([text_part(\"x\"), image_part(make_png(64))])],\n            }\n        )\n\n    def test_valid_proof_accepts_then_degrades_on_binary_change(self):\n        binary, _ = self.confirmed_stand()\n        status, _ = self.request(\"deepseek-v4.1-flash\", \"max\")\n        self.assertEqual(status, 200)\n        self.assertEqual(len(self.hub.admissions()), 1)\n        binary.write_bytes(b\"other-binary-content\")\n        with self.capture_logs() as lines:\n            status, body = self.request(\"deepseek-v4.1-flash\", \"max\")\n        self.assertEqual(status, 400)\n        self.assertEqual(body[\"error\"][\"type\"], \"image_input_not_supported\")\n        self.assertTrue(\n            any(\n                \"image_proof_invalid model=deepseek-v4.1-flash \"\n                \"reason=droid_binary_sha\" in ln\n                for ln in lines\n            )\n        )\n        status, _ = self._post_json(\n            {\n                \"model\": \"deepseek-v4.1-flash\",\n                \"reasoning_effort\": \"max\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"text alive\"}],\n            }\n        )\n        self.assertEqual(status, 200)\n\n    def test_impl_version_mismatch_degrades(self):\n        self.confirmed_stand(impl_version=2)\n        with self.capture_logs() as lines:\n            status, body = self.request(\"deepseek-v4.1-flash\", \"high\")\n        self.assertEqual(status, 400)\n        self.assertEqual(body[\"error\"][\"type\"], \"image_input_not_supported\")\n        self.assertTrue(any(\"reason=impl_version\" in ln for ln in lines))\n        status, _ = self._post_json(\n            {\n                \"model\": \"deepseek-v4.1-flash\",\n                \"reasoning_effort\": \"high\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"still text\"}],\n            }\n        )\n        self.assertEqual(status, 200)\n\n    def test_formats_mismatch_degrades(self):\n        self.confirmed_stand(formats=())\n        with self.capture_logs() as lines:\n            status, body = self.request(\"deepseek-v4.1-flash\", \"high\")\n        self.assertEqual(status, 400)\n        self.assertTrue(any(\"reason=formats\" in ln for ln in lines))\n\n    def test_effort_not_proven_degrades_only_that_effort(self):\n        self.confirmed_stand(efforts_proven=[\"high\"])\n        status, _ = self.request(\"deepseek-v4.1-flash\", \"high\")\n        self.assertEqual(status, 200)\n        with self.capture_logs() as lines:\n            status, body = self.request(\"deepseek-v4.1-flash\", \"max\")\n        self.assertEqual(status, 400)\n        self.assertEqual(body[\"error\"][\"type\"], \"image_input_not_supported\")\n        self.assertTrue(any(\"reason=effort\" in ln for ln in lines))\n        self.assertEqual(len([ln for ln in lines if ln.startswith(\"exec model=\")]), 0)\n\n\nclass TestImageJournal(ImageCase):\n    def test_exec_line_counters_only(self):\n        server.IMAGE_PROBE = True\n        self.probe_stand()\n        with self.capture_logs() as lines:\n            self._post(\n                {\n                    \"model\": \"claude-sonnet-5-5\",\n                    \"reasoning_effort\": \"high\",\n                    \"messages\": [user_message([image_part(make_png(64))])],\n                }\n            )\n        execs = [ln for ln in lines if ln.startswith(\"exec model=\")]\n        self.assertEqual(len(execs), 1)\n        self.assertIn(\" images=1 image_bytes=64 image_types=image/png\", execs[0])\n        self.assertNotIn(\"iVBOR\", execs[0])\n        self.assertNotIn(str(server.WORKSPACE), execs[0])\n        joined = \"\\n\".join(lines)\n        self.assertNotIn(\"iVBORw0KGgo\", joined)\n        self.assertNotIn(str(server.WORKSPACE), joined)\n\n\nif __name__ == \"__main__\":\n    unittest.main(verbosity=2)\n\"\"\"Регрессии квот прокси и повторов транспорта opencode serve.\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport io\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any\nfrom unittest.mock import Mock\n\nimport pytest\n\n\n@pytest.fixture\ndef bridge(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> Any:\n    path = Path(__file__).resolve().parents[1] / \"bridges/opencode-zen-bridge/server.py\"\n    spec = importlib.util.spec_from_file_location(\"zen_quota_test_server\", path)\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    monkeypatch.setitem(sys.modules, spec.name, module)\n    # Импорт моста добавляет собственные корни; восстанавливаем sys.path после теста.\n    monkeypatch.setattr(sys, \"path\", list(sys.path))\n    spec.loader.exec_module(module)\n    monkeypatch.setattr(module, \"DEFAULTWORKDIR\", tmp_path)\n    monkeypatch.setattr(module, \"_log\", Mock())\n    monkeypatch.setattr(module, \"_StartupGate\", Mock())\n    monkeypatch.setattr(module, \"FAIL_RETRY_BACKOFF_S\", 0)\n    monkeypatch.setattr(module, \"MAX_TOTAL_SPAWNS\", 3)\n    monkeypatch.setattr(module, \"NATIVE_RETRY_LIMIT\", 3)\n    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_TRANSPORT\", \"serve\")\n    return module\n\n\ndef _handler(bridge: Any) -> Any:\n    handler = object.__new__(bridge.Handler)\n    handler.wfile = io.BytesIO()\n    handler._client_gone_check = Mock(return_value=False)\n    handler._send = Mock()\n    return handler\n\n\ndef _attempts(bridge: Any, **kwargs: Any) -> Any:\n    res = bridge._Resilience()\n    res.spawn_limiter = Mock()\n    res.spawn_limiter.acquire.return_value = True\n    res.breaker.record_failure = Mock(wraps=res.breaker.record_failure)\n    res.retry_budget.try_acquire_retry = Mock(return_value=True)\n    return bridge._RequestAttempts(res, time.monotonic() + 60, **kwargs)\n\n\ndef _result(**overrides: Any) -> dict[str, Any]:\n    result = {\n        \"texts\": [],\n        \"reasonings\": [],\n        \"native_calls\": [],\n        \"usage\": {},\n        \"error\": None,\n        \"exit_reason\": \"ok\",\n        \"delivered\": False,\n        \"terminal\": \"completed\",\n        \"first_event_at\": None,\n        \"first_token_at\": None,\n        \"step_closed\": True,\n        \"first_event_ms\": None,\n        \"ttft_ms\": None,\n        \"prompt_status\": None,\n        \"transient_error\": False,\n        \"proxy_url\": None,\n    }\n    result.update(overrides)\n    return result\n\n\ndef _quota_result(**overrides: Any) -> dict[str, Any]:\n    return _result(\n        error={\n            \"type\": \"provider.free-limit\",\n            \"statusCode\": 429,\n            \"message\": \"Free usage limit reached for this IP\",\n        },\n        transient_error=True,\n        **overrides,\n    )\n\n\ndef _install_attempts(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n    results: list[dict[str, Any]],\n    *,\n    select_proxy: bool = False,\n) -> Mock:\n    queued = iter(results)\n\n    def serve(*args: Any, **kwargs: Any) -> dict[str, Any]:\n        result = next(queued)\n        if select_proxy:\n            result[\"proxy_url\"] = bridge._next_standalone_proxy()\n        kwargs[\"on_startup_ready\"]()\n        for index, key in ((4, \"reasonings\"), (5, \"texts\"), (6, \"native_calls\")):\n            for value in result[key]:\n                args[index](value)\n        return result\n\n    runner = Mock(side_effect=serve)\n    monkeypatch.setattr(bridge, \"_serve_one_attempt\", runner)\n    return runner\n\n\ndef _configure_pool(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n    tmp_path: Path,\n    offset: int = 0,\n) -> tuple[str, str]:\n    pool = tmp_path / \"pool.txt\"\n    pool.write_text(\"u:p@host:10001\\nu:p@host:10002\\n\", encoding=\"utf-8\")\n    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_STANDALONE_PROXY\", \"pool\")\n    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_FILE\", str(pool))\n    monkeypatch.setenv(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_OFFSET\", str(offset))\n    monkeypatch.setattr(bridge, \"_resolve_proxyrack_gateway\", lambda: \"192.0.2.1\")\n    return \"http://u:p@192.0.2.1:10001\", \"http://u:p@192.0.2.1:10002\"\n\n\ndef _stream(\n    handler: Any, attempts: Any, tools: list[dict[str, Any]]\n) -> tuple[bool, dict[str, Any], list[str]]:\n    texts: list[str] = []\n    xs: dict[str, Any] = {\"status\": 200}\n    done = handler._run_serve_stream_attempts(\n        \"deepseek-v4.1-flash-free\",\n        \"Ответь\",\n        \"high\",\n        bool(tools),\n        tools,\n        \"chatcmpl-test\",\n        1,\n        \"deepseek-v4.1-flash-free\",\n        texts.append,\n        texts.append,\n        Mock(),\n        attempts,\n        attempts.res,\n        xs,\n        texts,\n    )\n    attempts.commit()\n    return done, xs, texts\n\n\ndef _json(handler: Any, attempts: Any) -> dict[str, Any]:\n    xs: dict[str, Any] = {}\n    assert handler._serve_json_serve(\n        \"deepseek-v4.1-flash-free\",\n        \"Ответь\",\n        \"high\",\n        False,\n        [],\n        None,\n        None,\n        attempts.res,\n        attempts,\n        xs,\n    )\n    attempts.commit()\n    assert handler._send.call_args.args[0] == 200\n    return handler._send.call_args.args[1][\"choices\"][0][\"message\"]\n\n\ndef test_stream_serve_attempt2_free_quota_error_after_attempt1_reasoning_rotates_proxy(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n    tmp_path: Path,\n) -> None:\n    handler = _handler(bridge)\n    attempts = _attempts(bridge)\n    p1, p2 = _configure_pool(bridge, monkeypatch, tmp_path, offset=1)\n    results = [\n        _result(reasonings=[\"Планирую вызов\"], terminal=\"incomplete_step\"),\n        _quota_result(),\n        _result(texts=[\"Ответ\"]),\n    ]\n    runner = _install_attempts(bridge, monkeypatch, results, select_proxy=True)\n    signal = Mock(side_effect=[2, 0])\n    monkeypatch.setattr(bridge, \"_incomplete_step_signal\", signal)\n    tools = [{\"type\": \"function\", \"function\": {\"name\": \"read\", \"parameters\": {}}}]\n    done, xs, texts = _stream(handler, attempts, tools)\n    assert done and xs[\"status\"] == 200\n    assert runner.call_count == 3\n    assert p1 in bridge._proxy_quarantine_until\n    assert [result[\"proxy_url\"] for result in results] == [p2, p1, p2]\n    assert \"\".join(texts) == \"Ответ\"\n    assert b'\"error\"' not in handler.wfile.getvalue()\n    assert attempts.quota_rotations == 1\n    attempts.res.breaker.record_failure.assert_not_called()\n    # Только incomplete_step расходует бюджет; смена выбитого порта — нет.\n    assert attempts.res.retry_budget.try_acquire_retry.call_count == 1\n\n\ndef test_stream_serve_attempt_with_emitted_reasoning_does_not_duplicate_on_transient_error(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    handler = _handler(bridge)\n    attempts = _attempts(bridge)\n    runner = _install_attempts(\n        bridge,\n        monkeypatch,\n        [\n            _quota_result(\n                reasonings=[\"Уникальное размышление\"], proxy_url=\"http://p1:10001\"\n            ),\n        ],\n    )\n    monkeypatch.setattr(bridge, \"_incomplete_step_signal\", Mock(return_value=0))\n    done, _, _ = _stream(handler, attempts, [])\n    assert done\n    assert runner.call_count == 1\n    assert \"http://p1:10001\" in bridge._proxy_quarantine_until\n    assert handler.wfile.getvalue().decode().count(\"Уникальное размышление\") == 1\n    assert b'\"error\"' in handler.wfile.getvalue()\n    assert attempts.retries == 0\n\n\n@pytest.mark.parametrize(\"free_quota\", [True, False])\ndef test_json_serve_discards_partial_reasoning_and_retries_on_transient_error(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n    free_quota: bool,\n) -> None:\n    handler = _handler(bridge)\n    attempts = _attempts(bridge)\n    failed = _quota_result(reasonings=[\"thinking...\"], proxy_url=\"http://p1:10001\")\n    if not free_quota:\n        failed[\"error\"] = {\"statusCode\": 503, \"message\": \"Temporarily unavailable\"}\n    runner = _install_attempts(\n        bridge,\n        monkeypatch,\n        [\n            failed,\n            _result(texts=[\"Чистый ответ\"], reasonings=[\"Готовый план\"]),\n        ],\n    )\n    message = _json(handler, attempts)\n    assert runner.call_count == 2\n    assert message[\"content\"] == \"Чистый ответ\"\n    assert message[\"reasoning_content\"] == \"Готовый план\"\n    assert \"thinking...\" not in str(message)\n    assert (\"http://p1:10001\" in bridge._proxy_quarantine_until) == free_quota\n    attempts.res.breaker.record_failure.assert_not_called()\n\n\ndef test_json_serve_no_tools_retries_when_model_calls_builtin_native_tool(\n    bridge: Any,\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    handler = _handler(bridge)\n    attempts = _attempts(bridge)\n    runner = _install_attempts(\n        bridge,\n        monkeypatch,\n        [\n            _result(native_calls=[{\"part\": {\"tool\": \"read\"}}], terminal=\"tool_calls\"),\n            _result(texts=[\"Ответ без инструментов\"]),\n        ],\n    )\n    prompt_builder = Mock(wraps=bridge._unavailable_tools_prompt)\n    monkeypatch.setattr(bridge, \"_unavailable_tools_prompt\", prompt_builder)\n    assert \"[image 1]\" in prompt\n    assert \"[attachments]\" in prompt\n    assert \"PONG\" not in prompt\n\n\n# ---- AD-003/REQ-03: argv и workspace-read -----------------------------------------\n\n\ndef test_workspace_cmd_read_and_add_dir_only_with_images(bridge):\n    cmd = bridge._build_claude_cmd(\n        \"claude-sonnet-5-5\", \"high\", Path(\"/tmp/claude-img-x\")\n    )\n    assert cmd[cmd.index(\"--tools\") + 1] == \"Read\"\n    assert cmd[cmd.index(\"--add-dir\") + 1] == \"/tmp/claude-img-x\"\n    plain = bridge._build_claude_cmd(\"claude-sonnet-5-5\", \"high\", None)\n    assert plain[plain.index(\"--tools\") + 1] == \"\"\n    assert \"--add-dir\" not in plain\n\n\ndef test_workspace_image_staging_permissions_and_cleanup(http_bridge):\n    _bridge, port = http_bridge\n    FakeRun.script = _done_script((\"text\", \"вижу картинку\"))\n    status, body = _post(\n        port,\n        {\n            \"model\": \"claude-sonnet-5-5\",\n            \"stream\": False,\n            \"messages\": [\n                {\n                    \"role\": \"user\",\n                    \"content\": [{\"type\": \"text\", \"text\": \"что тут?\"}, _image_part()],\n                }\n            ],\n        },\n    )\n    assert status == 200, body\n    captured = FakeRun.captured\n    img_dir = captured[\"img_dir\"]\n    assert img_dir and Path(img_dir).name.startswith(\"claude-img-\")\n    assert captured[\"img_dir_mode\"] == 0o700\n    assert captured[\"img_files\"][\"image_1.png\"][\"mode\"] == 0o600\n    assert captured[\"img_files\"][\"image_1.png\"][\"data\"] == PNG_BYTES\n    assert \"[attachments]\" in captured[\"prompt\"] and \"[image 1]\" in captured[\"prompt\"]\n    # finally: каталог удалён после завершения хода, ребёнок закрыт раньше ответа.\n    assert captured[\"closed\"] is True\n    assert not Path(img_dir).exists()\n\n\ndef test_cleanup_image_dir_removed_on_parser_error(http_bridge):\n    _bridge, port = http_bridge\n    FakeRun.script = _done_script((\"text\", '<tool_call>{\"name\": broken</tool_call>'))\n    status, body = _post(\n        port,\n        {\n            \"model\": \"claude-sonnet-5-5\",\n            \"stream\": False,\n            \"tools\": TOOLS,\n            \"messages\": [{\"role\": \"user\", \"content\": [_image_part()]}],\n        },\n    )\n    assert status == 502, body\n    assert \"<tool_call>\" not in body\n    assert (\n        FakeRun.captured[\"img_dir\"] and not Path(FakeRun.captured[\"img_dir\"]).exists()\n    )\n\ncore/tool_emulation.py:48:    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\ncore/tool_emulation.py:51:    НЕ-image части (например input_audio) молча пропускаются, как раньше.\ncore/tool_emulation.py:63:                if item.get(\"type\") == \"image_url\":\ncore/tool_emulation.py:65:                    parts.append(f\"[image {counter[0]}]\")\ncore/tool_emulation.py:201:def _attachments_section(images: list) -> str:\ncore/tool_emulation.py:205:        \"This request includes %d image(s) as local files in the working directory. \"\ncore/tool_emulation.py:206:        \"The markers [image N] in the conversation refer to them in order.\"\ncore/tool_emulation.py:207:        % len(images),\ncore/tool_emulation.py:209:    for index, image in enumerate(images, 1):\ncore/tool_emulation.py:211:            \"- [image %d] ./%s (%s, %d bytes)\"\ncore/tool_emulation.py:212:            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\ncore/tool_emulation.py:215:        \"Open each image with the Read tool on exactly these paths before answering about it \"\ncore/tool_emulation.py:217:        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\ncore/tool_emulation.py:227:    images: list | None = None,\ncore/tool_emulation.py:243:        head.append(_tools_section(tools, tool_choice, bool(images)))\ncore/tool_emulation.py:245:    if images:\ncore/tool_emulation.py:246:        text = text + \"\\n\\n\" + _attachments_section(images)\ncore/tool_emulation.py:1354:DEFAULT_MAX_IMAGES = 10\ncore/tool_emulation.py:1355:DEFAULT_MAX_IMAGE_BYTES = 10 * 1024 * 1024\ncore/tool_emulation.py:1356:DEFAULT_MAX_TOTAL_IMAGE_BYTES = 20 * 1024 * 1024\ncore/tool_emulation.py:1367:# (GIF87a/GIF89a; RIFF+WEBP в [8:12]) проверяет `_sniff_image_mime`.\ncore/tool_emulation.py:1368:_IMAGE_FORMATS = (\ncore/tool_emulation.py:1369:    (\"image/png\", b\"\\x89PNG\\r\\n\\x1a\\n\", \"png\"),\ncore/tool_emulation.py:1370:    (\"image/jpeg\", b\"\\xff\\xd8\\xff\", \"jpg\"),\ncore/tool_emulation.py:1371:    (\"image/gif\", b\"GIF8\", \"gif\"),\ncore/tool_emulation.py:1372:    (\"image/webp\", b\"RIFF\", \"webp\"),\ncore/tool_emulation.py:1374:_SUPPORTED_IMAGE_MIMES = tuple(mime for mime, _magic, _ext in _IMAGE_FORMATS)\ncore/tool_emulation.py:1385:def _sniff_image_mime(data: bytes) -> str:\ncore/tool_emulation.py:1392:        return \"image/png\"\ncore/tool_emulation.py:1394:        return \"image/jpeg\"\ncore/tool_emulation.py:1396:        return \"image/gif\"\ncore/tool_emulation.py:1398:        return \"image/webp\"\ncore/tool_emulation.py:1402:def extract_data_url_images(\ncore/tool_emulation.py:1405:    max_images: int = DEFAULT_MAX_IMAGES,\ncore/tool_emulation.py:1406:    max_image_bytes: int = DEFAULT_MAX_IMAGE_BYTES,\ncore/tool_emulation.py:1407:    max_total_bytes: int = DEFAULT_MAX_TOTAL_IMAGE_BYTES,\ncore/tool_emulation.py:1409:    \"\"\"Все `image_url`-части истории -> [{\"name\", \"mime\", \"data\"}] в порядке появления.\ncore/tool_emulation.py:1413:    пользовательские пути не используются (имена генерируются: `image_N.<ext>`).\ncore/tool_emulation.py:1416:    images: list[dict] = []\ncore/tool_emulation.py:1419:        return images\ncore/tool_emulation.py:1424:            if not isinstance(item, dict) or item.get(\"type\") != \"image_url\":\ncore/tool_emulation.py:1426:            image_url = item.get(\"image_url\")\ncore/tool_emulation.py:1427:            url = image_url.get(\"url\") if isinstance(image_url, dict) else None\ncore/tool_emulation.py:1429:                raise ImageInputError(\"invalid_image_content\")\ncore/tool_emulation.py:1431:                raise ImageInputError(\"image_url_not_allowed\")\ncore/tool_emulation.py:1434:                raise ImageInputError(\"invalid_image_content\")\ncore/tool_emulation.py:1438:                raise ImageInputError(\"invalid_image_content\")\ncore/tool_emulation.py:1439:            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\ncore/tool_emulation.py:1441:                raise ImageInputError(\"unsupported_image_type\")\ncore/tool_emulation.py:1442:            if len(images) >= max_images:\ncore/tool_emulation.py:1443:                raise ImageInputError(\"too_many_images\")\ncore/tool_emulation.py:1445:            if approx_bytes > max_image_bytes:\ncore/tool_emulation.py:1446:                raise ImageInputError(\"image_too_large\")\ncore/tool_emulation.py:14