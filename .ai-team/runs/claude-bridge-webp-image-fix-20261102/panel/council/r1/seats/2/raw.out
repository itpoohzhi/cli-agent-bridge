.py:1781:        _log(f\"proxy quarantined for quota limit: {_mask_secrets(proxy_url)}\")\nbridges/opencode-zen-bridge/server.py:1871:        for entry, expiry in list(_proxy_quarantine_until.items()):\nbridges/opencode-zen-bridge/server.py:1873:                del _proxy_quarantine_until[entry]\nbridges/opencode-zen-bridge/server.py:1877:            if entry not in _proxy_quarantine_until:\nbridges/opencode-zen-bridge/server.py:1881:            key=lambda entry: _proxy_quarantine_until.get(entry, 0.0),\nbridges/opencode-zen-bridge/server.py:1884:            f\"all {len(_proxy_pool_entries)} proxies quarantined, reusing earliest expiring: {_mask_secrets(best_proxy)}\"\nbridges/opencode-zen-bridge/server.py:1896:        _proxy_quarantine_until.clear()\nbridges/opencode-zen-bridge/server.py:3038:        max_quota_rotations: int | None = None,\nbridges/opencode-zen-bridge/server.py:3047:        self.max_quota_rotations = (\nbridges/opencode-zen-bridge/server.py:3048:            QUOTA_ROTATION_LIMIT if max_quota_rotations is None else max_quota_rotations\nbridges/opencode-zen-bridge/server.py:3050:        self.quota_rotations = 0\nbridges/opencode-zen-bridge/server.py:3070:        limit = min(MAX_TOTAL_SPAWNS, self.max_total) + self.quota_rotations\nbridges/opencode-zen-bridge/server.py:3084:    def allow_quota_rotation(self, reason: str = \"free_quota_proxy_rotate\") -> bool:\nbridges/opencode-zen-bridge/server.py:3086:        if self.quota_rotations >= self.max_quota_rotations:\nbridges/opencode-zen-bridge/server.py:3090:            >= min(MAX_TOTAL_SPAWNS, self.max_total) + self.quota_rotations\nbridges/opencode-zen-bridge/server.py:3099:        self.quota_rotations += 1\nbridges/opencode-zen-bridge/server.py:4221:            result[\"transient_error\"] = _is_transient_stream_error(payload)\nbridges/opencode-zen-bridge/server.py:5177:                result[\"transient_error\"] = _is_transient_stream_error(payload)\nbridges/opencode-zen-bridge/server.py:6938:                        if _is_transient_stream_error(payload):\nbridges/opencode-zen-bridge/server.py:7642:                    if _is_free_quota_error(err):\nbridges/opencode-zen-bridge/server.py:7643:                        _quarantine_proxy(result.get(\"proxy_url\"))\nbridges/opencode-zen-bridge/server.py:7646:                            if attempts.allow_quota_rotation(\nbridges/opencode-zen-bridge/server.py:7647:                                \"serve_free_quota_proxy_rotate\"\nbridges/opencode-zen-bridge/server.py:7649:                                \"serve_free_quota_retry\", charge_budget=False\nbridges/opencode-zen-bridge/server.py:8652:                            if _is_transient_stream_error(payload):\nbridges/opencode-zen-bridge/server.py:9231:                    is_free_quota = _is_free_quota_error(err)\nbridges/opencode-zen-bridge/server.py:9232:                    if is_free_quota:\nbridges/opencode-zen-bridge/server.py:9233:                        _quarantine_proxy(result.get(\"proxy_url\"))\nbridges/opencode-zen-bridge/server.py:9235:                        if is_free_quota:\nbridges/opencode-zen-bridge/server.py:9237:                            retry_allowed = attempts.allow_quota_rotation(\nbridges/opencode-zen-bridge/server.py:9238:                                \"json_serve_free_quota_proxy_rotate\"\nbridges/opencode-zen-bridge/server.py:9240:                                \"json_serve_free_quota_retry\", charge_budget=False\nDEFAULT_MAX_IMAGE_BYTES = 10 * 1024 * 1024\nDEFAULT_MAX_TOTAL_IMAGE_BYTES = 20 * 1024 * 1024\n# Служебные теги протокола <tool_call>, не имеющие смысла вне настоящего блока.\n_ORPHAN_SERVICE_TAGS = (\n    TOOL_CALL_CLOSE,\n    \"<arg_key>\",\n    \"</arg_key>\",\n    \"<arg_value>\",\n    \"</arg_value>\",\n)\n# (MIME, магический префикс, расширение файла) — принимаемые форматы вложений.\n# Для GIF/WebP префикс — только ориентир таблицы расширений: точную сигнатуру\n# (GIF87a/GIF89a; RIFF+WEBP в [8:12]) проверяет `_sniff_image_mime`.\n_IMAGE_FORMATS = (\n    (\"image/png\", b\"\\x89PNG\\r\\n\\x1a\\n\", \"png\"),\n    (\"image/jpeg\", b\"\\xff\\xd8\\xff\", \"jpg\"),\n    (\"image/gif\", b\"GIF8\", \"gif\"),\n    (\"image/webp\", b\"RIFF\", \"webp\"),\n)\n_SUPPORTED_IMAGE_MIMES = tuple(mime for mime, _magic, _ext in _IMAGE_FORMATS)\n\n\nclass ImageInputError(ValueError):\n    \"\"\"Отказ валидации изображения запроса; `code` — машинный код причины.\"\"\"\n\n    def __init__(self, code: str):\n        super().__init__(code)\n        self.code = code\n\n\ndef _sniff_image_mime(data: bytes) -> str:\n    \"\"\"MIME по магическим байтам ('' — сигнатура неизвестна).\n\n    WebP — составной контейнер RIFF: одного префикса мало, нужен маркер\n    `WEBP` в байтах [8:12] (RIFF/WAVE и обрезанные заголовки отклоняются).\n    \"\"\"\n    if len(data) >= 8 and data.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\"):\n        return \"image/png\"\n    if len(data) >= 3 and data.startswith(b\"\\xff\\xd8\\xff\"):\n        return \"image/jpeg\"\n    if len(data) >= 6 and (data.startswith(b\"GIF87a\") or data.startswith(b\"GIF89a\")):\n        return \"image/gif\"\n    if len(data) >= 12 and data[:4] == b\"RIFF\" and data[8:12] == b\"WEBP\":\n        return \"image/webp\"\n    return \"\"\n\n\ndef extract_data_url_images(\n    messages: Any,\n    *,\n    max_images: int = DEFAULT_MAX_IMAGES,\n    max_image_bytes: int = DEFAULT_MAX_IMAGE_BYTES,\n    max_total_bytes: int = DEFAULT_MAX_TOTAL_IMAGE_BYTES,\n) -> list[dict]:\n    \"\"\"Все `image_url`-части истории -> [{\"name\", \"mime\", \"data\"}] в порядке появления.\n\n    Принимаются только data URI с base64 PNG/JPEG/GIF/WebP: строгая проверка кодировки и\n    соответствия MIME сигнатуре; URL не скачиваются, `file://` не читается,\n    пользовательские пути не используются (имена генерируются: `image_N.<ext>`).\n    Любое нарушение — `ImageInputError` до запуска CLI (fail-closed).\n    \"\"\"\n    images: list[dict] = []\n    total = 0\n    if not isinstance(messages, list):\n        return images\n    for msg in messages:\n        if not isinstance(msg, dict) or not isinstance(msg.get(\"content\"), list):\n            continue\n        for item in msg[\"content\"]:\n            if not isinstance(item, dict) or item.get(\"type\") != \"image_url\":\n                continue\n            image_url = item.get(\"image_url\")\n            url = image_url.get(\"url\") if isinstance(image_url, dict) else None\n            if not isinstance(url, str):\n                raise ImageInputError(\"invalid_image_content\")\n            if not url.startswith(\"data:\"):\n                raise ImageInputError(\"image_url_not_allowed\")\n            comma = url.find(\",\")\n            if comma == -1:\n                raise ImageInputError(\"invalid_image_content\")\n            fields = [f.strip().lower() for f in url[5:comma].split(\";\")]\n            mime = fields[0] if fields else \"\"\n            if not mime or \"base64\" not in fields[1:]:\n                raise ImageInputError(\"invalid_image_content\")\n            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\n            if not ext:\n                raise ImageInputError(\"unsupported_image_type\")\n            if len(images) >= max_images:\n                raise ImageInputError(\"too_many_images\")\n            approx_bytes = (len(url) - comma - 1) * 3 // 4\n            if approx_bytes > max_image_bytes:\n                raise ImageInputError(\"image_too_large\")\n            if total + approx_bytes > max_total_bytes:\n                raise ImageInputError(\"images_too_large\")\n            payload = url[comma + 1 :]\n            if not payload:\n                raise ImageInputError(\"invalid_image_base64\")\n            try:\n                data = base64.b64decode(payload, validate=True)\n            except (binascii.Error, ValueError):\n                raise ImageInputError(\"invalid_image_base64\") from None\n            sniffed = _sniff_image_mime(data)\n            if not sniffed:\n                raise ImageInputError(\"unsupported_image_type\")\n            if sniffed != mime:\n                raise ImageInputError(\"image_type_mismatch\")\n            if len(data) > max_image_bytes:\n                raise ImageInputError(\"image_too_large\")\n            total += len(data)\n            if total > max_total_bytes:\n                raise ImageInputError(\"images_too_large\")\n            images.append(\n                {\"name\": f\"image_{len(images) + 1}.{ext}\", \"mime\": mime, \"data\": data}\n            )\n    return images\n\n\ndef extract_thinking_delta(delta: Any) -> str:\n    \"\"\"Текст нативной дельты размышления (`thinking_delta`) -> строка; иначе ''.\n\n    Транспортные адаптеры переводят свои события в общий словарь дельты; текст\n    берётся из `thinking` (форма Claude stream-json) либо `thinking_delta`.\n    \"\"\"\n    if not isinstance(delta, dict) or delta.get(\"type\") != \"thinking_delta\":\n        return \"\"\n    value = delta.get(\"thinking\")\n    if value is None:\n        value = delta.get(\"thinking_delta\")\n    return value if isinstance(value, str) else \"\"\n\n\nclass StreamNormalizer:\n    \"\"\"Единый нормализатор живого потока: content / reasoning / tool_calls (AD-005).\n\n    Один лексический автомат на все выходы транспорта. В обычном тексте первая\n    встреченная конструкция определяет контекст до своего закрытия: теги\n    размышлений (`REASONING_TAGS`) уводят дельты в reasoning, блок `<tool_call>`\n    непрозрачен и целиком уходит в `ToolCallParser` (тег размышления внутри\n    JSON-строки аргумента канал не переключает; `<tool_call>` внутри размышления\n    вызовом не становится). Теги в Markdown-коде каналом не являются (контекст —\n    `_code_context`). Нативное thinking (`feed_thinking`) уже типизировано: в\n    парсер не подаётся и не исполняется.\n\n    Каждое событие сначала добавляется в аккумуляторы (`content`,\n    `reasoning_content`, `tool_calls`), затем синхронно уведомляется sink:\n    SSE-сериализатор публикует `delta.reasoning_content` сразу, до терминального\n    события, JSON берёт тот же итог в `message.reasoning_content`; сумма\n    SSE-дельт равна JSON-итогу при одинаковом входном потоке.\n\n    При `strict_live=True` повреждённый/незакрытый блок, orphan служебный тег и\n    EOF внутри размышления поднимают `LiveParserError` — сырой XML в content не\n    попадает (fail-closed). Мысли не генерируются: upstream не дал — пусто.\n    \"\"\"\n\n    def __init__(\n        self,\n        on_content=None,\n        on_reasoning=None,\n        on_tool_call=None,\n        *,\n        strict_live: bool = True,\n        reasoning_tags=REASONING_TAGS,\n        max_reasoning_depth: int = DEFAULT_MAX_REASONING_DEPTH,\n    ):\n        self._on_content = on_content or (lambda _text: None)\n        self._on_reasoning = on_reasoning or (lambda _text: None)\n        self._on_tool_call = on_tool_call or (lambda _call: None)\n        self.strict_live = strict_live\n        self._tags = tuple(reasoning_tags)\n        self._max_depth = max(int(max_reasoning_depth), 1)\n        self._parser = ToolCallParser(\n            if (start == 0 or not _is_ident_char(text[start - 1])) and (\n                end == len(text) or not _is_ident_char(text[end])\n            ):\n                return True\n            start = text.find(name, start + 1)\n    return False\n\n\ndef _tool_name_list(tools: Any) -> list[str]:\n    \"\"\"Инструменты запроса (OpenAI-схемы или голые имена) -> список имён.\"\"\"\n    names: list[str] = []\n    for item in _list_or_empty(tools):\n        if isinstance(item, str):\n            if item:\n                names.append(item)\n        elif isinstance(item, dict):\n            fn = (\n                item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n            )\n            name = fn.get(\"name\") if isinstance(fn, dict) else None\n            if isinstance(name, str) and name:\n                names.append(name)\n    return names\n\n\ndef _is_transient_stream_error(ev: dict[str, Any]) -> bool:\n    \"\"\"Ошибка провайдера посреди стрима транзиентна (повтор имеет смысл)?\n\n    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n    Исключение: исчерпанная квота транзиентна при любом статусе (проверка ДО\n    fatal-статусов) — иначе прокси не уйдёт в карантин и ротации не будет.\n    \"\"\"\n    containers: list[dict[str, Any]] = [ev]\n    messages: list[str] = []\n    err = ev.get(\"error\")\n    if isinstance(err, dict):\n        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n    elif isinstance(err, str):\n        messages.append(err)\n    part = _dict_or_empty(ev.get(\"part\"))\n    if part:\n        part_err = _dict_or_empty(part.get(\"error\"))\n        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n    status: int | None = None\n    for container in containers:\n        if status is None:\n            for key in (\"statusCode\", \"status_code\", \"status\"):\n                value = container.get(key)\n                if isinstance(value, int) and not isinstance(value, bool):\n                    status = value\n                    break\n        for key in (\"message\", \"error\"):\n            value = container.get(key)\n            if isinstance(value, str):\n                messages.append(value)\n    if (\n        _is_free_quota_error(ev)\n        or any(_is_free_quota_error(container) for container in containers)\n        or any(_is_free_quota_error(message) for message in messages)\n    ):\n        return True\n    if status in _FATAL_STREAM_STATUSES:\n        return False\n    if status is None or status in (0, 408, 429) or status >= 500:\n        return True\n    low = \" \".join(messages).lower()\n    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n\n\ndef _step_recovery_disabled() -> bool:\n    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n    return not STEP_RECOVERY_ENABLED or os.environ.get(\n        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n\n\ndef _visible_token_estimate(stripped: str) -> int:\n    \"\"\"Грубая оценка токенов видимого текста (верхняя: не завышаем «проглоченные» токены).\"\"\"\n    return max(len(stripped) // 2, _estimate_tokens(stripped)) if stripped else 0\n\n\ndef _swallowed_tokens(\n    stripped: str, output_tokens: int, reasoning_tokens: int = 0\n) -> int:\n    \"\"\"Токены вывода, не объяснённые видимым текстом: output включает reasoning — вычитаем его.\"\"\"\n    if reasoning_tokens > 0 and output_tokens >= reasoning_tokens:\n        non_reasoning_output = max(0, output_tokens - reasoning_tokens)\n    else:\n        non_reasoning_output = output_tokens\n    return non_reasoning_output - _visible_token_estimate(stripped)\n\n\ndef _is_status_preamble(stripped: str, names: list[str]) -> bool:\n    \"\"\"Признак 5: короткая статусная преамбула с явным глаголом немедленного действия, без вывода/кода/таблиц.\"\"\"\n\ndef _uses_standalone(model_id: str) -> bool:\n    \"\"\"`opencode run --standalone`: только Zen-модели и только в динамическом режиме каталога.\"\"\"\n    return CATALOG_MODE == \"dynamic\" and _is_zen_route(model_id)\n\n\n_PROXY_VARS = (\n    \"HTTP_PROXY\",\n    \"HTTPS_PROXY\",\n    \"http_proxy\",\n    \"https_proxy\",\n    \"ALL_PROXY\",\n    \"all_proxy\",\n)\n_LOOPBACK_NO_PROXY = (\"127.0.0.1\", \"localhost\", \"::1\")\n# THREAT-003 + принятое отклонение DEV-02: к ключам пакета добавлены переменные прокси.\n_STANDALONE_ENV_ALLOWLIST = (\n    \"PATH\",\n    \"HOME\",\n    \"TMPDIR\",\n    \"LANG\",\n    \"NO_PROXY\",\n    \"no_proxy\",\n    *_PROXY_VARS,\n)\n\n\ndef _merged_no_proxy(current: str) -> str:\n    \"\"\"NO_PROXY с обязательными loopback-адресами (локальные вызовы идут мимо прокси).\"\"\"\n    parts = [p.strip() for p in current.split(\",\") if p.strip()]\n    parts.extend(p for p in _LOOPBACK_NO_PROXY if p not in parts)\n    return \",\".join(parts)\n\n\n# Пул выделенных US-портов ProxyRack: каждый порт 10000..10999 даёт отдельный чистый IP, а анонимный\n# лимит opencode.ai (36 запросов в сутки на исходящий IP) считается по IP. Режим `pool` берёт\n# порты по кругу — по одному на каждый запуск дочернего процесса (включая ретраи).\n_DEFAULT_PROXYRACK_FILE = (\n    Path.home()\n    / \".local/share/gigaexplorator-proxies/2026-08-31-volkov-proxy-manager/06-proxyrack-global-dc-1000.txt\"\n)\n_PROXYRACK_FORWARD_LOG = Path.home() / \"Library/Logs/Factory/proxyrack-forward.log\"\n_DEFAULT_PROXYRACK_GATEWAY = \"121.91.235.6\"\n_PROXYRACK_LOG_TAIL_BYTES = 16 * 1024\n_IPV4_RE = re.compile(\n    r\"^(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$\"\n)\n\n_proxy_pool_lock = threading.Lock()\n_proxy_pool_key: tuple[Any, ...] | None = None\n_proxy_pool_entries: list[str] = []\n_proxy_pool_idx = 0\nPROXY_QUOTA_COOLDOWN_S = float(\n    os.environ.get(\"OPENCODE_ZEN_PROXY_QUOTA_COOLDOWN_S\", \"3600.0\")\n)\nQUOTA_ROTATION_LIMIT = int(os.environ.get(\"OPENCODE_ZEN_QUOTA_ROTATION_LIMIT\", \"3\"))\n_proxy_quarantine_until: dict[str, float] = {}\n\n\ndef _is_free_quota_error(err: object) -> bool:\n    \"\"\"Распознать исчерпанную квоту по типу или тексту ошибки провайдера.\"\"\"\n    if isinstance(err, dict):\n        if err.get(\"type\") == \"provider.free-limit\":\n            return True\n        message = str(err.get(\"message\") or err).lower()\n    elif isinstance(err, str):\n        message = err.lower()\n    else:\n        return False\n    return any(\n        marker in message\n        for marker in (\n            \"free usage limit reached\",\n            \"usage limit reached\",\n            \"provider.free-limit\",\n            \"quota exhausted\",\n            \"request quota exhausted\",\n            \"subscription quota exhausted\",\n        )\n    )\n\n\ndef _quarantine_proxy(proxy_url: str | None, cooldown_s: float | None = None) -> None:\n    \"\"\"Временно исключить порт с исчерпанной квотой из ротации.\"\"\"\n    if not proxy_url or not str(proxy_url).strip():\n        return\n    proxy_url = str(proxy_url).strip()\n    with _proxy_pool_lock:\n        _proxy_quarantine_until[proxy_url] = time.monotonic() + (\n            PROXY_QUOTA_COOLDOWN_S if cooldown_s is None else cooldown_s\n        )\n        _log(f\"proxy quarantined for quota limit: {_mask_secrets(proxy_url)}\")\n\n\ndef _resolve_proxyrack_gateway() -> str:\n    \"\"\"IP живого шлюза ProxyRack: env -> последняя запись лога proxyrack-forward -> значение по умолчанию.\n\n    Прямой DNS global.rotating.proxyrack.net иногда отдаёт нерабочие 149.51.*; демон\n    proxyrack-forward проверяет адреса пробой и пишет живой в лог (`gateway <old> -> <new>`).\n    \"\"\"\n    forced = os.environ.get(\"OPENCODE_ZEN_BRIDGE_PROXYRACK_GATEWAY\", \"\").strip()\n    if forced:\n        return forced\n    try:\n        with _PROXYRACK_FORWARD_LOG.open(\"rb\") as fh:\n            fh.seek(0, os.SEEK_END)\n# AGENTS.md — cli-agent-bridge\n\nПроектные правила для агентов. Общие правила владельца — канон `~/Мой диск/Context/AGENTS.md` (здесь не дублируются).\n\n## ⭐ Главный архитектурный принцип: универсальность и независимость от вендоров\n\n1. **Максимальная универсальность:** все доработки делаются максимально универсальными, чтобы не зависеть от вендоров и сторонних сред исполнения.\n2. **Запрет на правку вендорского исходного кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи в исходный код и бинарные сборки внешних вендорских приложений и сред (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену исполняемых модулей. **Правка пользовательских конфигураций и профилей РАЗРЕШЕНА:** редактирование пользовательских настроек, профилей интеграции и переменных окружения (например, `~/.dsh/profiles/*/cordis.patch.yml`, `~/.dsh/.env`, `~/.dsh/.credentials.yaml`) является штатным методом настройки и полностью разрешено.\n3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\n4. **Запрет на хардкод параметров (полная конфигурируемость):** категорически запрещено зашивать в коде константами любые эксплуатационные параметры — таймауты, интервалы опроса, пороги активности, лимиты шагов и размеры буферов памяти (текста ответа, reasoning и т.д.). Любые такие параметры просто переносим в настройки: они должны быть полностью настраиваемыми через переменные окружения и конфигурационные файлы с безопасными значениями по умолчанию в качестве fallback.\n5. **Системное, агент-агностическое решение по умолчанию:** все архитектурные задачи, расхождения форматов сообщений, санитизация вызовов инструментов (tool calls), дефекты стриминга, управление сессиями, восстановление контекста и протокольные краевые случаи решаются **на системном (агент-агностик) уровне шлюза** — в универсальном ядре (`core/`) и общих механизмах эмуляции API, а не на уровне конкретного агента. Решение должно опираться на семантику протокола и контракт шлюза, а не на имя подключаемого агента.\n   - **Запрещено переносить общую логику на уровень конкретного агента:** если проблему можно решить агент-агностически, категорически недопустимы отдельные заплатки, хаки, ветвления по имени агента и дублирование исправлений для Droid, Muse, Codex, Claude Code и других подключаемых CLI-бэкендов. Системное исправление реализуется один раз в модулях ядра (`core/`) и работает единообразно для всех интеграций.\n   - **Адаптеры агентов — только тонкие трансляторы транспорта:** их ответственность ограничивается управлением жизненным циклом CLI-процесса, подключением к транспорту и двусторонней трансляцией специфичного CLI-ввода/вывода в единый внутренний контракт шлюза. Общая нормализация, санитизация, управление контекстом, восстановление после сбоев и протокольная эмуляция не должны оседать в адаптерах в виде ad-hoc логики.\n   - **Специфичная логика допускается только как доказанное исключение:** прежде чем добавлять частную обработку в адаптер, необходимо доказать невозможность системного решения в общем слое и зафиксировать непреодолимое ограничение внешнего CLI-транспорта. Такая логика должна быть строго изолирована внутри адаптера и не нарушать инварианты универсального ядра.\n\n## О проекте cli-agent-bridge\n\nУниверсальный шлюз (мост/фасад), объединяющий CLI-агентов и LLM различных провайдеров в единый OpenAI-совместимый эндпоинт (`POST /v1/chat/completions`, `GET /v1/models`, SSE-стриминг, `tools`/`tool_calls`).\n\n### Архитектурные слои\n- `server.py` — единый HTTP-фасад (OpenAI-compatible API, маршрутизация запросов, управление подключениями).\n- `core/` — универсальное ядро:\n  - `core/tool_emulation.py` — протокол и эмуляция function calling, парсинг и санитизация `<tool_call>`.\n  - `core/backend_adapter.py` — базовые абстракции и контракты адаптеров бэкендов.\n  - `core/turn_session_manager.py` — управление сессиями, контекстом и процессами.\n  - `core/context_resilience.py` — устойчивость к переполнению контекста и сжатие.\n- `adapters/` — адаптеры к конкретным CLI-транспортам и средам (Droid, Muse, Codex и др.).\n- `bridges/` — специализированные мосты (`agy-bridge`, `muse-bridge`, `opencode-zen-bridge`).\n\n## Верификация и тесты\n\nПеред фиксацией любых изменений запускать набор тестов:\n```bash\npytest tests/ -v\n```\nКод должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.\n\n## Регламент комплексного тестирования мостов и стриминга (L1 / L2 / L3)\n\nКаждая доработка мостов обязана сопровождаться трехуровневым контролем качества:\n\n1. **Уровень L1 (Детерминированные Unit-тесты):**\n   - Все изменения логики дедупликации (`_ContentArbiter`), сканирования префиксов (`_scan`) и разбора рантайм-флагов (`_parse_runtime_flags`) покрываются тестами в `tests/test_agy_bridge_resilience.py`.\n   - Запрещено сдавать код, если хотя бы один тест арбитража или graceful-таймаута завершается с ошибкой.\n   - Инвариант `_scan`: входящий фрагмент другого шага сопоставляется со старым шагом ТОЛЬКО при условии `text == candidate` или `text.startswith(candidate)`. Короткий префикс нового шага с валидным индексом (`idx is not None`) никогда не должен становиться алиасом длинного старого шага.\n\n2. **Уровень L2 (Сквозные синтетические E2E-тесты и валидация протокола SSE):**\n   - Набор `tests/test_stream_formatting_and_subagents.py` обязателен к прогону перед любым мержем.\n   - **Инвариант разграничения строк Markdown:** любые последовательные шаги в потоке `content` обязаны разделяться переводом строки `\\n\\n`. Склейка слов на границах шагов (паттерн `[а-яёa-z]\\.[А-ЯЁA-Z]`) категорически запрещена.\n   - **Инвариант защиты от циклов префиксов:** многократная смена статусов агента и скиллов оркестрации (`[гейт оркестрации: активен...`) не должна вызывать лавину повторов префикса и `content-divergence`.\n   - **Инвариант изоляции блока мышления (<Think>):** при наличии вызовов инструментов (`tool_calls`) сервисные преамбулы шагов направляются в `choices[0].delta.reasoning_content`. В `choices[0].delta.content` разрешается отдавать только финальный ответ пользователю (шаг без инструментов) либо результат реконсиляции, предотвращая досрочное закрытие аккордеона мышления в UI DeepSeek Harness.\n   - **Мультиагентный цикл:** обязательна эмуляция сессий с порождением сабагентов (`invoke_subagent` / `launch_seat.py`) с контролем непрерывности стрима родительского агента.\n   - **Инвариант скользящего окна активности (Sliding Activity Window):** любой стрим и адаптер обязан сбрасывать таймер неактивности при получении каждого полезного чанка (`content`, `reasoning_content`, `tool_calls`) и сдвигать дедлайн вперёд (`deadline = now + idle_timeout_s`). Категорически запрещено обрывать активный поток по статическому настенному таймеру при наличии входящих данных; аварийный `safety_cap_s` допустим только как предохранитель от бесконечного зацикливания.\n\n3. **Уровень L3 (Универсальный смоук-раннер моделей):**\n   - Для валидации готовности моделей и транспортов из `~/Мой диск/Context/models.md` используется скрипт `scripts/smoke_models.py`.\n   - Проверка конфигурации: `python3 scripts/smoke_models.py --dry-run`.\n   - Сквозной смоук-тест реальных бэкендов: `python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1`.\n   - Санитизация: все токены и секреты в смоук-логах и отчётах обязательно маскируются.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"Проверяю связку «распознана квота → карантин → повтор с другим прокси»: новый тест классификатора сам по себе не подтверждает весь этот путь.\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4170,4240p' bridges/opencode-zen-bridge/server.py; sed -n '7595,7705p' bridges/opencode-zen-bridge/server.py; sed -n '9190,9275p' bridges/opencode-zen-bridge/server.py; sed -n '6900,6970p' bridges/opencode-zen-bridge/server.py; sed -n '8615,8680p' bridges/opencode-zen-bridge/server.py; sed -n '290,400p' tests/test_opencode_zen_bridge.py; rg -n 'quota|free.limit|rotation|image.*(gif|webp)|WEBP|GIF|materializ' tests/test_opencode_zen_bridge.py tests/test_claude_bridge.py; cat docs/adr/0023-claude-bridge-webp-gif-and-zen-quota-resilience.md; git diff -- core/tool_emulation.py bridges/opencode-zen-bridge/server.py bridges/claude-p-bridge/server.py tests/test_claude_bridge.py tests/test_opencode_zen_bridge.py | shasum -a 256\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4170,4240p' bridges/opencode-zen-bridge/server.py; sed -n '7595,7705p' bridges/opencode-zen-bridge/server.py; sed -n '9190,9275p' bridges/opencode-zen-bridge/server.py; sed -n '6900,6970p' bridges/opencode-zen-bridge/server.py; sed -n '8615,8680p' bridges/opencode-zen-bridge/server.py; sed -n '290,400p' tests/test_opencode_zen_bridge.py; rg -n 'quota|free.limit|rotation|image.*(gif|webp)|WEBP|GIF|materializ' tests/test_opencode_zen_bridge.py tests/test_claude_bridge.py; cat docs/adr/0023-claude-bridge-webp-gif-and-zen-quota-resilience.md; git diff -- core/tool_emulation.py bridges/opencode-zen-bridge/server.py bridges/claude-p-bridge/server.py tests/test_claude_bridge.py tests/test_opencode_zen_bridge.py | shasum -a 256\"","aggregated_output":"                hard_deadline,\n                max(\n                    wait_deadline,\n                    time.monotonic()\n                    + min(_STEP_DRAIN_WINDOW_S, float(STALL_TIMEOUT_S)),\n                ),\n            )\n        if mapped_kind == \"permission_replied\":\n            replied_id = str(payload.get(\"id\") or \"\").strip()\n            if replied_id:\n                replied_perms.add(replied_id)\n            continue\n        if mapped_kind == \"permission\":\n            request_id = str(payload.get(\"id\") or \"\").strip()\n            if not request_id:\n                _ctrl_quiet(f\"/api/session/{session_id}/interrupt\")\n                raise ServeSecurityError(\"permission reject failed\")\n            if request_id in replied_perms:\n                # Уже закрыт каскадным reject serve: повторный POST не нужен.\n                continue\n            reject_failed = ctrl_http is None\n            if ctrl_http is not None:\n                try:\n                    status, _body = ctrl_http(\n                        \"POST\",\n                        f\"/api/session/{session_id}/permiss