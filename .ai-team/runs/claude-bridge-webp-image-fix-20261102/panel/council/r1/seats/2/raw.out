-p-bridge/server.py:867:                \"tool_emulation\": True, \"images\": True, \"live_reasoning\": True,\nbridges/claude-p-bridge/server.py:915:            _extract_request_images(req)\nbridges/claude-p-bridge/server.py:917:            self._send(400, {\"error\": {\"message\": f\"invalid image input: {exc.code}\",\nzsh:1: no matches found: .ai-team/runs/claude-bridge-webp-image-fix-20261102/acceptance*\n","exit_code":1,"status":"failed"}}
