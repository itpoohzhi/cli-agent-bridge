)?\n\n    `ev` — сырое событие `{\"type\":\"error\",\"error\":{…}}` или разобранный payload `{statusCode, message}`.\n    400/401/403/404/422 — детерминированный отказ (False, без повтора, Fail-Closed). Нет статуса, 0, 408,\n    429, >=500 либо маркер сетевого сбоя в сообщении — транзиентна (True).\n    Исключение: исчерпанная квота транзиентна при любом статусе (проверка ДО\n    fatal-статусов) — иначе прокси не уйдёт в карантин и ротации не будет.\n    \"\"\"\n    containers: list[dict[str, Any]] = [ev]\n    messages: list[str] = []\n    err = ev.get(\"error\")\n    if isinstance(err, dict):\n        containers.extend([err, _dict_or_empty(err.get(\"data\"))])\n    elif isinstance(err, str):\n        messages.append(err)\n    part = _dict_or_empty(ev.get(\"part\"))\n    if part:\n        part_err = _dict_or_empty(part.get(\"error\"))\n        containers.extend([part, part_err, _dict_or_empty(part_err.get(\"data\"))])\n    status: int | None = None\n    for container in containers:\n        if status is None:\n            for key in (\"statusCode\", \"status_code\", \"status\"):\n                value = container.get(key)\n                if isinstance(value, int) and not isinstance(value, bool):\n                    status = value\n                    break\n        for key in (\"message\", \"error\"):\n            value = container.get(key)\n            if isinstance(value, str):\n                messages.append(value)\n    if (\n        _is_free_quota_error(ev)\n        or any(_is_free_quota_error(container) for container in containers)\n        or any(_is_free_quota_error(message) for message in messages)\n    ):\n        return True\n    if status in _FATAL_STREAM_STATUSES:\n        return False\n    if status is None or status in (0, 408, 429) or status >= 500:\n        return True\n    low = \" \".join(messages).lower()\n    return any(marker in low for marker in _TRANSIENT_ERROR_MARKERS)\n\n\ndef _step_recovery_disabled() -> bool:\n    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n    return not STEP_RECOVERY_ENABLED or os.environ.get(\n        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\"\n    ).strip().lower() in (\"0\", \"false\", \"no\", \"off\")\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/claude-bridge-webp-image-fix-20261102/panel/council/r1","is_error":false}]},"parent_tool_use_id":null,"session_id":"71688c11-6bb7-4b51-a9bb-6efd09490686","uuid":"301d8371-bd00-4aad-8397-277d30afabd3","timestamp":"2026-11-02T16:41:20.962Z","tool_use_result":{"stdout":"core/tool_emulation.py:1367:# (GIF87a/GIF89a; RIFF+WEBP в [8:12]) проверяет `_sniff_image_mime`.\ncore/tool_emulation.py:1368:_IMAGE_FORMATS = (\ncore/tool_emulation.py:1374:_SUPPORTED_IMAGE_MIMES = tuple(mime for mime, _magic, _ext in _IMAGE_FORMATS)\ncore/tool_emulation.py:1385:def _sniff_image_mime(data: bytes) -> str:\ncore/tool_emulation.py:1402:def extract_data_url_images(\ncore/tool_emulation.py:1439:            ext = next((e for m, _magic, e in _IMAGE_FORMATS if m == mime), \"\")\ncore/tool_emulation.py:1456:            sniffed = _sniff_image_mime(data)\ntests/test_claude_bridge.py:319:    images = core_te.extract_data_url_images(messages)\ntests/test_claude_bridge.py:327:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:338:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:352:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:356:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:367:    images = core_te.extract_data_url_images(messages)\ntests/test_claude_bridge.py:380:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:385:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:390:        core_te.extract_data_url_images(\ntests/test_claude_bridge.py:398:    images = core_te.extract_data_url_images(messages)\nbridges/claude-p-bridge/server.py:80:        extrac