": \"docs/adr/0005-resilient-hub-lifecycle-and-detached-turns.md\",\n1152|      \"sha256\": \"71ef425000c1baad74245956c5ef81929db1c76553e8952fbde13c791ebcc820\"\n1153|    }\n1154|  ],\n1155|  \"approval\": {\n1156|    \"status\": \"APPROVED\",\n1157|    \"decision_ids\": [\n1158|      \"AD-001\",\n1159|      \"AD-002\",\n1160|      \"AD-003\",\n1161|      \"AD-004\"\n1162|    ],\n1163|    \"approved_by\": \"owner (mandatory input directives 1-5 in REQ-EYE-33873-RESILIENCE brief + Arch Council rework brief a1)\",\n1164|    \"evidence_ref\": \".ai-team/runs/dsh-bridge-resilience-20261017/handoff/panel-rework-brief-arch-a1.json\"\n1165|  },\n1166|  \"independent_review\": {\n1167|    \"required\": false,\n1168|    \"status\": \"NOT_REQUIRED\",\n1169|    \"reviewer\": null,\n1170|    \"evidence_ref\": null\n1171|  },\n1172|  \"open_questions\": [\n1173|    {\n1174|      \"id\": \"Q-001\",\n1175|      \"question\": \"OPEN-01: Завершается ли потомок muse serve по EOF stdin при гибели моста или остаётся сиротой (закрыто явным погашением групп при истечении drain-таймаута и процедурой orphan reaper по children.json при старте хаба, RW-004)\",\n1176|      \"blocking\": false\n1177|    },\n1178|    {\n1179|      \"id\": \"Q-002\",\n1180|      \"question\": \"OPEN-02: Точное место формирования строки TRANSPORT в упакованном коде клиента DSH (закрыто отправкой валидного SSE error-чанка и [DONE] перед закрытием потока)\",\n1181|      \"blocking\": false\n1182|    },\n1183|    {\n1184|      \"id\": \"Q-003\",\n1185|      \"question\": \"OPEN-03: Наличие автоповтора и кнопки Stop в клиенте DSH (закрыто поддержкой идемпотентного re-attach по точному turn_key для активных ходов и явным эндпоинтом отмены POST /v1/turns/<turn_id>/cancel, RW-001, RW-003)\",\n1186|      \"blocking\": false\n1187|    },\n1188|    {\n1189|      \"id\": \"Q-004\",\n1190|      \"question\": \"OPEN-04: Параметры таймера простоя и предохранительного потолка (зафиксировано директивой владельца №2 и RW-005: idle=300 с по приросту cputime и протокольным событиям, safety_cap=3600 с)\",\n1191|      \"blocking\": false\n1192|    },\n1193|    {\n1194|      \"id\": \"Q-005\",\n1195|      \"question\": \"OPEN-05: Набор переменных в deployment:persona-suffix DSH (зафиксировано директивой владельца №5: убрать {{cwd}}, передавать через AGENTS.md или DSH_CWD)\",\n1196|      \"blocking\": false\n1197|    },\n1198|    {\n1199|      \"id\": \"Q-006\",\n1200|      \"question\": \"OPEN-06: Поддержка session/resume в muse serve (закрыто директивой владельца №1 и RW-006: фоновое доведение уже запущенного процесса в TurnSessionManager с ответом 410 GAP_DETECTED при вытеснении из 10 МиБ буфера)\",\n1201|      \"blocking\": false\n1202|    },\n1203|    {\n1204|      \"id\": \"Q-007\",\n1205|      \"question\": \"OPEN-07: Применимость к остальным бэкендам моста и поставка core.* в muse-bridge (зафиксировано директивой владельца №3 и RW-008: общий слой хаба core/ и server.py + автодобавление корня в sys.path в bridges/muse-bridge/server.py)\",\n1206|      \"blocking\": false\n1207|    },\n1208|    {\n1209|      \"id\": \"Q-008\",\n1210|      \"question\": \"OPEN-08: Увеличение ExitTimeOut в launchd plist и неблокирующий перехват сигналов (зафиксировано директивой владельца №4 и RW-007: ExitTimeOut=120 с, threading.Event в signal handler, drain в фоновом потоке)\",\n1211|      \"blocking\": false\n1212|    },\n1213|    {\n1214|      \"id\": \"Q-009\",\n1215|      \"question\": \"OPEN-09: Корреляция параллельных ходов в логе при MAX_CONCURRENT >= 2 (закрыто сквозной передачей rid и turn_id во все записи лога)\",\n1216|      \"blocking\": false\n1217|    },\n1218|    {\n1219|      \"id\": \"Q-010\",\n1220|      \"question\": \"OPEN-10: Поведение SO_REUSEPORT на macOS Darwin (отложено: выбран детерминированный Graceful Shutdown & Drain с 503 Retry-After: 5 и фичефлагами DSH_BRIDGE_*_ENABLED, RW-009)\",\n1221|      \"blocking\": false\n1222|    }\n1223|  ],\n1224|  \"deferred\": [\n1225|    \"OPEN-10: Zero-downtime reload через SO_REUSEPORT или передачу сокета launchd отложен в пользу детерминированного Graceful Shutdown & Drain (DRAIN_TIMEOUT_S = 110 с, 503 Retry-After: 5)\"\n1226|  ]\n1227|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
