{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J1UjATrumL5oPnUSW1Lyez","type":"tool_result","content":"1489\t                turn.timeout_controller.terminated_reason\n1490\t                if turn.timeout_controller is not None\n1491\t                else \"\"\n1492\t            )\n1493\t            if term_reason == \"idle_timeout\" or res_state == \"idle_timeout\":\n1494\t                turn.status = STATE_TIMED_OUT_IDLE\n1495\t            elif term_reason == \"absolute_cap\" or res_state in (\n1496\t                \"timeout\",\n1497\t                \"safety_cap\",\n1498\t            ):\n1499\t                turn.status = STATE_TIMED_OUT_CAP\n1500\t            elif res_state == \"done\" and int(final_res.rc or 0) == 0:\n1501\t                turn.status = STATE_COMPLETED\n1502\t            elif res_state == \"client_gone\":\n1503\t                turn.status = STATE_CANCELLED\n1504\t            else:\n1505\t                turn.status = STATE_FAILED_BACKEND\n1506\t\n1507\t            if not turn.buffer.sealed:\n1508\t                if turn.status == STATE_COMPLETED:\n1509\t                    finish_reason = (\n1510\t                        \"tool_calls\" if final_res.tool_calls else \"stop\"\n1511\t                    )\n1512\t                    turn.buffer.append(\n1513\t                        \"done\",\n1514\t                        {\n1515\t                            \"finish_reason\": finish_reason,\n1516\t                            \"usage\": dict(turn.buffer.usage),\n1517\t                        },\n1518\t                    )\n1519\t                else:\n1520\t                    turn.buffer.append(\n1521\t                        \"error\",\n1522\t                        {\n1523\t                            \"message\": str(final_res.err or res_state),\n1524\t                            \"type\": (\n1525\t                                \"timeout_error\"\n1526\t                                if turn.status\n1527\t                                in (STATE_TIMED_OUT_IDLE, STATE_TIMED_OUT_CAP)\n1528\t                                else \"proxy_error\"\n1529\t                            ),\n1530\t                            \"code\": turn.status.lower(),\n1531\t                        },\n1532\t                    )\n1533\t                turn.buffer.seal()\n1534\t\n1535\t            turn.updated_at = time.time()\n1536\t            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n1537\t                self._active_by_key.pop(turn.turn_key, None)\n1538\t            if turn.pgid is not None:\n1539\t                self.unregister_child_pgid(turn.pgid)\n1540\t            if turn.timeout_controller is not None:\n1541\t                turn.timeout_controller.close()\n1542\t\n1543\t            out = {\n1544\t                \"state\": (\n1545\t                    \"timeout\"\n1546\t                    if turn.status in (STATE_TIMED_OUT_IDLE, STATE_TIMED_OUT_CAP)\n1547\t                    else final_res.state\n1548\t                ),\n1549\t                \"rc\": final_res.rc,\n1550\t                \"text\": final_res.text,\n1551\t                \"err\": final_res.err,\n1552\t                \"usage\": asdict(final_res.usage),\n1553\t                \"result\": {},\n1554\t                \"tool_calls\": [asdict(call) for call in final_res.tool_calls],\n1555\t                \"events\": [\n1556\t                    (\n1557\t                        event.kind,\n1558\t                        asdict(event.value)\n1559\t                        if not isinstance(event.value, str)\n1560\t                        else event.value,\n1561\t                    )\n1562\t                    for event in final_res.events or ()\n1563\t                ],\n1564\t                \"backend_kind\": backend_kind or turn.backend,\n1565\t                \"turn_id\": turn.turn_id,\n1566\t                \"turn_status\": turn.status,\n1567\t            }\n1568\t            turn.final_dict = out\n1569\t            turn.done_event.set()\n1570\t            self.persist_turn_snapshot(turn)\n1571\t            self._enforce_memory_caps_locked()\n1572\t            self._cond.notify_all()\n1573\t            return out\n1574\t\n1575\t    def spawn_detached_execution(\n1576\t        self,\n1577\t        turn: ManagedTurn,\n1578\t        runner_fn: Callable[[ManagedTurn], TurnResult],\n1579\t        *,\n1580\t        backend_kind: str = \"\",\n1581\t    ) -> threading.Thread:\n1582\t        \"\"\"Запускает выполнение хода в отдельном daemon-потоке, отвязанном от HTTP-хендлера.\"\"\"\n1583\t\n1584\t        def _worker() -> None:\n1585\t            watchdog_stop = threading.Event()\n1586\t\n1587\t            def _watchdog_loop() -> None:\n1588\t                while not watchdog_stop.wait(self.watchdog_interval_s):\n1589\t                    if turn.is_terminal or turn.cancel_event.is_set():\n1590\t                        return\n1591\t                    ctrl = turn.timeout_controller\n1592\t                    if ctrl is None:\n1593\t                        continue\n1594\t                    should_stop, reason, _metrics = ctrl.check(turn.pgid)\n1595\t                    if should_stop and reason in (\"idle_timeout\", \"absolute_cap\"):\n1596\t                        self._log(\n1597\t                            f\"watchdog_triggered rid={turn.rid} turn_id={turn.turn_id} \"\n1598\t                            f\"reason={reason} pgid={turn.pgid}\"\n1599\t                        )\n1600\t                        turn.cancel_event.set()\n1601\t                        if turn.pgid is not None:\n1602\t                            self._terminate_pgid(turn.pgid, self.cancel_grace_s)\n1603\t                        return\n1604\t\n1605\t            wd_thread: threading.Thread | None = None\n1606\t            if self.is_watchdog_enabled() and turn.timeout_controller is not None:\n1607\t                wd_thread = threading.Thread(\n1608\t                    target=_watchdog_loop,\n1609\t                    name=f\"turn-wd-{turn.turn_id}\",\n1610\t                    daemon=True,\n1611\t                )\n1612\t                wd_thread.start()\n1613\t\n1614\t            try:\n1615\t                raw_res = runner_fn(turn)\n1616\t                if (\n1617\t                    turn.timeout_controller is not None\n1618\t                    and turn.timeout_controller.terminated_reason\n1619\t                    in (\"idle_timeout\", \"absolute_cap\")\n1620\t                ):\n1621\t                    reason = turn.timeout_controller.terminated_reason\n1622\t                    raw_res = TurnResult(\n1623\t                        state=(\n1624\t                            \"idle_timeout\"\n1625\t                            if reason == \"idle_timeout\"\n1626\t                            else \"timeout\"\n1627\t                        ),\n1628\t                        rc=124,\n1629\t                        text=raw_res.text,\n1630\t                        reasoning=raw_res.reasoning,\n1631\t                        usage=raw_res.usage,\n1632\t                        err=f\"Turn terminated by watchdog: {reason}\",\n1633\t                        events=raw_res.events,\n1634\t                        tool_calls=raw_res.tool_calls,\n1635\t                    )\n1636\t                self.complete_turn_from_result(\n1637\t                    turn, raw_res, backend_kind=backend_kind\n1638\t                )\n1639\t            except Exception as exc:  # noqa: BLE001\n1640\t                err_res = TurnResult(\n1641\t                    state=\"backend_error\",\n1642\t                    rc=1,\n1643\t                    err=f\"{exc.__class__.__name__}: {exc}\",\n1644\t                )\n1645\t                self.complete_turn_from_result(\n1646\t                    turn, err_res, backend_kind=backend_kind\n1647\t                )\n1648\t            finally:\n1649\t                watchdog_stop.set()\n1650\t\n1651\t        worker = threading.Thread(\n1652\t            target=_worker,\n1653\t            name=f\"turn-exec-{turn.turn_id}\",\n1654\t            daemon=True,\n1655\t        )\n1656\t        worker.start()\n1657\t        return worker\n1658\t\n1659\t    def wait_for_active_turns(self, timeout: float) -> list[ManagedTurn]:\n1660\t        \"\"\"Ожидает завершения всех активных ходов до `timeout` секунд.\n1661\t\n1662\t        Возвращает список ходов, оставшихся активными после истечения `timeout`.\n1663\t        \"\"\"\n1664\t        deadline = time.monotonic() + max(0.0, float(timeout))\n1665\t        with self._cond:\n1666\t            while True:\n1667\t                remaining_turns = [\n1668\t                    t for t in self._turns_by_id.values() if t.is_active\n1669\t                ]\n1670\t                if not remaining_turns:\n1671\t                    return []\n1672\t                wait_s = deadline - time.monotonic()\n1673\t                if wait_s <= 0:\n1674\t                    return remaining_turns\n1675\t                self._cond.wait(timeout=min(wait_s, 0.25))\n1676\t\n1677\t    def iter_sse_stream(\n1678\t        self,\n1679\t        turn: ManagedTurn,\n1680\t        *,\n1681\t        from_seq: int = 0,\n1682\t        keepalive_interval_s: float = 10.0,\n1683\t        client_gone_fn: Callable[[], bool] | None = None,\n1684\t    ) -> Iterator[str]:\n1685\t        \"\"\"Генерирует SSE-поток событий хода (`id: <seq>\\\\ndata: ...\\\\n\\\\n`) с поддержкой дочитки.\"\"\"\n1686\t        backlog, subscriber = turn.buffer.subscribe(\n1687\t            from_seq=from_seq,\n1688\t            turn_id=turn.turn_id,\n1689\t            state_dump_path=turn.state_dump_path,\n1690\t        )\n1691\t        completion_id = f\"chatcmpl-turn-{turn.turn_id}\"\n1692\t        created = int(turn.created_at)\n1693\t        try:\n1694\t            for ev in backlog:\n1695\t                yield ev.to_sse_frame(\n1696\t                    completion_id=completion_id,\n1697\t                    created=created,\n1698\t                    model=turn.model,\n1699\t                )\n1700\t            if subscriber is None:\n1701\t                return\n1702\t            while True:\n1703\t                if client_gone_fn is not None and client_gone_fn():\n1704\t                    self.mark_detached(turn.turn_id)\n1705\t                    return\n1706\t                try:\n1707\t                    ev = subscriber.queue.get(\n1708\t                        timeout=max(0.05, float(keepalive_interval_s))\n1709\t                    )\n1710\t                except queue.Empty:\n1711\t                    if client_gone_fn is not None and client_gone_fn():\n1712\t                        self.mark_detached(turn.turn_id)\n1713\t                        return\n1714\t                    if turn.is_terminal:\n1715\t                        return\n1716\t                    yield \": keepalive\\n\\n\"\n1717\t                    continue\n1718\t                if ev is None:\n1719\t                    return\n1720\t                yield ev.to_sse_frame(\n1721\t                    completion_id=completion_id,\n1722\t                    created=created,\n1723\t                    model=turn.model,\n1724\t                )\n1725\t        finally:\n1726\t            turn.buffer.unsubscribe(subscriber)\n1727\t\n1728\t    def kill_all_active(self) -> None:\n1729\t        \"\"\"Завершает все активные ходы при истечении drain или аварийной остановке.\"\"\"\n1730\t        with self._cond:\n1731\t            active = [t for t in self._turns_by_id.values() if t.is_active]\n1732\t        for turn in active:\n1733\t            try:\n1734\t                self.interrupt_for_drain(turn)\n1735\t            except Exception:  # noqa: BLE001\n1736\t                pass\n1737\t\n1738\t    def reset(self) -> None:\n1739\t        \"\"\"Сбрасывает состояние менеджера (для изоляции тестов).\"\"\"\n1740\t        with self._cond:\n1741\t            active = [t for t in self._turns_by_id.values() if t.is_active]\n1742\t        for turn in active:\n1743\t            try:\n1744\t                self.cancel_turn(turn.turn_id, reason=\"reset\")\n1745\t            except Exception:  # noqa: BLE001\n1746\t                pass\n1747\t        with self._cond:\n1748\t            self._turns_by_id.clear()\n1749\t            self._active_by_key.clear()\n1750\t            self._children.clear()\n1751\t            self._cond.notify_all()\n1752\t\n1753\t    reset_state = reset\n1754\t\n1755\t"}]},"parent_tool_use_id":null,"session_id":"3fb1b2b6-87c5-4d4e-9965-c0b3fa5aef1f","uuid":"65a4f4d9-e466-4f4d-a20a-81e36bcc7d95","timestamp":"2026-10-17T20:01:05.839Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/core/turn_session_manager.py","content":"                turn.timeout_controller.terminated_reason\n                if turn.timeout_controller is not None\n                else \"\"\n            )\n            if term_reason == \"idle_timeout\" or res_state == \"idle_timeout\":\n                turn.status = STATE_TIMED_OUT_IDLE\n            elif term_reason == \"absolute_cap\" or res_state in (\n                \"timeout\",\n                \"safety_cap\",\n            ):\n                turn.status = STATE_TIMED_OUT_CAP\n            elif res_state == \"done\" and int(final_res.rc or 0) == 0:\n                turn.status = STATE_COMPLETED\n            elif res_state == \"client_gone\":\n                turn.status = STATE_CANCELLED\n            else:\n                turn.status = STATE_FAILED_BACKEND\n\n            if not turn.buffer.sealed:\n                if turn.status == STATE_COMPLETED:\n                    finish_reason = (\n                        \"tool_calls\" if final_res.tool_calls else \"stop\"\n                    )\n                    turn.buffer.append(\n                        \"done\",\n                        {\n                            \"finish_reason\": finish_reason,\n                            \"usage\": dict(turn.buffer.usage),\n                        },\n                    )\n                else:\n                    turn.buffer.append(\n                        \"error\",\n                        {\n                            \"message\": str(final_res.err or res_state),\n                            \"type\": (\n                                \"timeout_error\"\n                                if turn.status\n                                in (STATE_TIMED_OUT_IDLE, STATE_TIMED_OUT_CAP)\n                                else \"proxy_error\"\n                            ),\n                            \"code\": turn.status.lower(),\n                        },\n                    )\n                turn.buffer.seal()\n\n            turn.updated_at = time.time()\n            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n                self._active_by_key.pop(turn.turn_key, None)\n            if turn.pgid is not None:\n                self.unregister_child_pgid(turn.pgid)\n            if turn.timeout_controller is not None:\n                turn.timeout_controller.close()\n\n            out = {\n                \"state\": (\n                    \"timeout\"\n                    if turn.status in (STATE_TIMED_OUT_IDLE, STATE_TIMED_OUT_CAP)\n                    else final_res.state\n                ),\n                \"rc\": final_res.rc,\n                \"text\": final_res.text,\n                \"err\": final_res.err,\n                \"usage\": asdict(final_res.usage),\n                \"result\": {},\n                \"tool_calls\": [asdict(call) for call in final_res.tool_calls],\n                \"events\": [\n                    (\n                        event.kind,\n                        asdict(event.value)\n                        if not isinstance(event.value, str)\n                        else event.value,\n                    )\n                    for event in final_res.events or ()\n                ],\n                \"backend_kind\": backend_kind or turn.backend,\n                \"turn_id\": turn.turn_id,\n                \"turn_status\": turn.status,\n            }\n            turn.final_dict = out\n            turn.done_event.set()\n            self.persist_turn_snapshot(turn)\n            self._enforce_memory_caps_locked()\n            self._cond.notify_all()\n            return out\n\n    def spawn_detached_execution(\n        self,\n        turn: ManagedTurn,\n        runner_fn: Callable[[ManagedTurn], TurnResult],\n        *,\n        backend_kind: str = \"\",\n    ) -> threading.Thread:\n        \"\"\"Запускает выполнение хода в отдельном daemon-потоке, отвязанном от HTTP-хендлера.\"\"\"\n\n        def _worker() -> None:\n            watchdog_stop = threading.Event()\n\n            def _watchdog_loop() -> None:\n                while not watchdog_stop.wait(self.watchdog_interval_s):\n                    if turn.is_terminal or turn.cancel_event.is_set():\n                        return\n                    ctrl = turn.timeout_controller\n                    if ctrl is None:\n                        continue\n                    should_stop, reason, _metrics = ctrl.check(turn.pgid)\n                    if should_stop and reason in (\"idle_timeout\", \"absolute_cap\"):\n                        self._log(\n                            f\"watchdog_triggered rid={turn.rid} turn_id={turn.turn_id} \"\n                            f\"reason={reason} pgid={turn.pgid}\"\n                        )\n                        turn.cancel_event.set()\n                        if turn.pgid is not None:\n                            self._terminate_pgid(turn.pgid, self.cancel_grace_s)\n                        return\n\n            wd_thread: threading.Thread | None = None\n            if self.is_watchdog_enabled() and turn.timeout_controller is not None:\n                wd_thread = threading.Thread(\n                    target=_watchdog_loop,\n                    name=f\"turn-wd-{turn.turn_id}\",\n                    daemon=True,\n                )\n                wd_thread.start()\n\n            try:\n                raw_res = runner_fn(turn)\n                if (\n                    turn.timeout_controller is not None\n                    and turn.timeout_controller.terminated_reason\n                    in (\"idle_timeout\", \"absolute_cap\")\n                ):\n                    reason = turn.timeout_controller.terminated_reason\n                    raw_res = TurnResult(\n                        state=(\n                            \"idle_timeout\"\n                            if reason == \"idle_timeout\"\n                            else \"timeout\"\n                        ),\n                        rc=124,\n                        text=raw_res.text,\n                        reasoning=raw_res.reasoning,\n                        usage=raw_res.usage,\n                        err=f\"Turn terminated by watchdog: {reason}\",\n                        events=raw_res.events,\n                        tool_calls=raw_res.tool_calls,\n                    )\n                self.complete_turn_from_result(\n                    turn, raw_res, backend_kind=backend_kind\n                )\n            except Exception as exc:  # noqa: BLE001\n                err_res = TurnResult(\n                    state=\"backend_error\",\n                    rc=1,\n                    err=f\"{exc.__class__.__name__}: {exc}\",\n                )\n                self.complete_turn_from_result(\n                    turn, err_res, backend_kind=backend_kind\n                )\n            finally:\n                watchdog_stop.set()\n\n        worker = threading.Thread(\n            target=_worker,\n            name=f\"turn-exec-{turn.turn_id}\",\n            daemon=True,\n        )\n        worker.start()\n        return worker\n\n    def wait_for_active_turns(self, timeout: float) -> list[ManagedTurn]:\n        \"\"\"Ожидает завершения всех активных ходов до `timeout` секунд.\n\n        Возвращает список ходов, оставшихся активными после истечения `timeout`.\n        \"\"\"\n        deadline = time.monotonic() + max(0.0, float(timeout))\n        with self._cond:\n            while True:\n                remaining_turns = [\n                    t for t in self._turns_by_id.values() if t.is_active\n                ]\n                if not remaining_turns:\n                    return []\n                wait_s = deadline - time.monotonic()\n                if wait_s <= 0:\n                    return remaining_turns\n                self._cond.wait(timeout=min(wait_s, 0.25))\n\n    def iter_sse_stream(\n        self,\n        turn: ManagedTurn,\n        *,\n        from_seq: int = 0,\n        keepalive_interval_s: float = 10.0,\n        client_gone_fn: Callable[[], bool] | None = None,\n    ) -> Iterator[str]:\n        \"\"\"Генерирует SSE-поток событий хода (`id: <seq>\\\\ndata: ...\\\\n\\\\n`) с поддержкой дочитки.\"\"\"\n        backlog, subscriber = turn.buffer.subscribe(\n            from_seq=from_seq,\n            turn_id=turn.turn_id,\n            state_dump_path=turn.state_dump_path,\n        )\n        completion_id = f\"chatcmpl-turn-{turn.turn_id}\"\n        created = int(turn.created_at)\n        try:\n            for ev in backlog:\n                yield ev.to_sse_frame(\n                    completion_id=completion_id,\n                    created=created,\n                    model=turn.model,\n                )\n            if subscriber is None:\n                return\n            while True:\n                if client_gone_fn is not None and client_gone_fn():\n                    self.mark_detached(turn.turn_id)\n                    return\n                try:\n                    ev = subscriber.queue.get(\n                        timeout=max(0.05, float(keepalive_interval_s))\n                    )\n                except queue.Empty:\n                    if client_gone_fn is not None and client_gone_fn():\n                        self.mark_detached(turn.turn_id)\n                        return\n                    if turn.is_terminal:\n                        return\n                    yield \": keepalive\\n\\n\"\n                    continue\n                if ev is None:\n                    return\n                yield ev.to_sse_frame(\n                    completion_id=completion_id,\n                    created=created,\n                    model=turn.model,\n                )\n        finally:\n            turn.buffer.unsubscribe(subscriber)\n\n    def kill_all_active(self) -> None:\n        \"\"\"Завершает все активные ходы при истечении drain или аварийной остановке.\"\"\"\n        with self._cond:\n            active = [t for t in self._turns_by_id.values() if t.is_active]\n        for turn in active:\n            try:\n                self.interrupt_for_drain(turn)\n            except Exception:  # noqa: BLE001\n                pass\n\n    def reset(self) -> None:\n        \"\"\"Сбрасывает состояние менеджера (для изоляции тестов).\"\"\"\n        with self._cond:\n            active = [t for t in self._turns_by_id.values() if t.is_active]\n        for turn in active:\n            try:\n                self.cancel_turn(turn.turn_id, reason=\"reset\")\n            except Exception:  # noqa: BLE001\n                pass\n        with self._cond:\n            self._turns_by_id.clear()\n            self._active_by_key.clear()\n            self._children.clear()\n            self._cond.notify_all()\n\n    reset_state = reset\n\n","numLines":267,"startLine":1489,"totalLines":1755}},"tool_result_meta":[{"id":"toolu_01J1UjATrumL5oPnUSW1Lyez","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
