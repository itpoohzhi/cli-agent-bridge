{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P3Uq1HqtXttD71UbV3bphP","type":"tool_result","content":"1\t\"\"\"Менеджер жизненного цикла хаба, неблокирующий Drain и уборка сирот (ADR-0005 / AD-004).\n2\t\n3\tМодуль отвечает за:\n4\t1. Неблокирующий перехват `SIGTERM`/`SIGINT` (`RW-007`): обработчик сигнала выставляет\n5\t   только `threading.Event` (`shutdown_requested`), не захватывая мьютексы и не\n6\t   выполняя блокирующий ввод-вывод.\n7\t2. Координацию `DRAINING` в фоновом потоке (`DRAIN_TIMEOUT_S = 110.0` с при\n8\t   `ExitTimeOut = 120` с в launchd): новые запросы получают `HTTP 503 Service Unavailable`\n9\t   с заголовком `Retry-After: 5`, `/health` возвращает `ok: false` и заголовок\n10\t   `X-Bridge-Draining: true`, а активные ходы доводятся до конца либо корректно\n11\t   прерываются со сбросом `reasoning_content` и терминальным чанком `drain_timeout`.\n12\t3. Безопасную уборку сирот при старте (`reap_orphans_on_startup`, `RW-004`): сверка\n13\t   `workspace/state/children.json` через `os.kill(pid, 0)` и имя команды в `ps`,\n14\t   мягкое погашение `SIGTERM -> 1s -> SIGKILL` с логом `orphan_reaped`.\n15\t4. Контроль интервала SSE keepalive (`KeepaliveController`, `<= 10.0` с).\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\tfrom collections.abc import Callable\n21\timport json\n22\timport os\n23\tfrom pathlib import Path\n24\timport signal\n25\timport subprocess\n26\timport threading\n27\timport time\n28\tfrom typing import Any\n29\t\n30\tfrom core.turn_session_manager import (\n31\t    SNAPSHOT_SCHEMA_VERSION,\n32\t    TurnSessionManager,\n33\t    _atomic_write_json_0600,\n34\t)\n35\t\n36\tDRAIN_TIMEOUT_S: float = 110.0\n37\tDEFAULT_DRAIN_SECONDS: float = DRAIN_TIMEOUT_S\n38\tRETRY_AFTER_S: int = 5\n39\tORPHAN_SIGTERM_GRACE_S: float = 1.0\n40\tMAX_KEEPALIVE_INTERVAL_S: float = 10.0\n41\t\n42\tKNOWN_CHILD_BINARIES = frozenset(\n43\t    {\n44\t        \"muse\",\n45\t        \"muse-cli\",\n46\t        \"muse-cli.sh\",\n47\t        \"droid\",\n48\t        \"fake_droid\",\n49\t        \"fake_serve\",\n50\t        \"node\",\n51\t        \"python\",\n52\t        \"python3\",\n53\t        \"bash\",\n54\t        \"sh\",\n55\t        \"zsh\",\n56\t        \"sleep\",\n57\t    }\n58\t)\n59\t\n60\t\n61\tclass DrainState:\n62\t    \"\"\"Фазы жизненного цикла HTTP-хаба при перезапуске.\"\"\"\n63\t\n64\t    READY = \"READY\"\n65\t    DRAINING = \"DRAINING\"\n66\t    STOPPED = \"STOPPED\"\n67\t\n68\t\n69\tclass KeepaliveController:\n70\t    \"\"\"Контроллер интервала SSE keepalive (`<= 10.0` с для защиты от обрыва прокси/туннеля).\"\"\"\n71\t\n72\t    def __init__(self, max_interval_s: float = MAX_KEEPALIVE_INTERVAL_S) -> None:\n73\t        self.max_interval_s = max(0.05, min(float(max_interval_s), MAX_KEEPALIVE_INTERVAL_S))\n74\t\n75\t    def effective_interval(self, requested_s: float | int | None = None) -> float:\n76\t        \"\"\"Возвращает эффективный интервал keepalive, не превышающий `10.0` с.\"\"\"\n77\t        if requested_s is None:\n78\t            return self.max_interval_s\n79\t        try:\n80\t            val = float(requested_s)\n81\t        except (TypeError, ValueError):\n82\t            return self.max_interval_s\n83\t        if val <= 0:\n84\t            return self.max_interval_s\n85\t        return min(val, self.max_interval_s)\n86\t\n87\t    @staticmethod\n88\t    def sse_comment() -> str:\n89\t        \"\"\"Возвращает стандартный SSE-комментарий keepalive.\"\"\"\n90\t        return \": keepalive\\n\\n\"\n91\t\n92\t    @staticmethod\n93\t    def sse_data_chunk(\n94\t        *,\n95\t        completion_id: str,\n96\t        created: int,\n97\t        model: str,\n98\t    ) -> str:\n99\t        \"\"\"Возвращает пустой SSE data-чанк keepalive в формате OpenAI `chat.completion.chunk`.\"\"\"\n100\t        payload = json.dumps(\n101\t            {\n102\t                \"id\": completion_id,\n103\t                \"object\": \"chat.completion.chunk\",\n104\t                \"created\": int(created),\n105\t                \"model\": model,\n106\t                \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n107\t            },\n108\t            ensure_ascii=False,\n109\t        )\n110\t        return f\"data: {payload}\\n\\n\"\n111\t\n112\t\n113\tclass HubLifecycleManager:\n114\t    \"\"\"Координатор сигналов `SIGTERM`/`SIGINT`, фазы `DRAINING` и уборки сирот.\"\"\"\n115\t\n116\t    def __init__(\n117\t        self,\n118\t        workspace: Path | str | Callable[[], Path] | None = None,\n119\t        *,\n120\t        state_dir: Path | str | Callable[[], Path] | None = None,\n121\t        turn_manager: TurnSessionManager | None = None,\n122\t        active_turns_fn: Callable[[], int] | None = None,\n123\t        force_kill_fn: Callable[[], None] | None = None,\n124\t        drain_timeout_s: float = DRAIN_TIMEOUT_S,\n125\t        retry_after_s: int = RETRY_AFTER_S,\n126\t        orphan_grace_s: float = ORPHAN_SIGTERM_GRACE_S,\n127\t        drain_enabled_fn: Callable[[], bool] | None = None,\n128\t        log_fn: Callable[[str], None] | None = None,\n129\t        on_shutdown_complete: Callable[[], None] | None = None,\n130\t    ) -> None:\n131\t        ws_source = workspace if workspace is not None else (state_dir or \".\")\n132\t        self._explicit_state_dir = state_dir\n133\t        self._workspace_fn: Callable[[], Path] = (\n134\t            (lambda: Path(ws_source))\n135\t            if isinstance(ws_source, (str, Path))\n136\t            else ws_source\n137\t        )\n138\t        self.turn_manager = turn_manager\n139\t        self._active_turns_fn = active_turns_fn\n140\t        self.drain_timeout_s = float(drain_timeout_s)\n141\t        self.retry_after_s = int(retry_after_s)\n142\t        self.orphan_grace_s = float(orphan_grace_s)\n143\t        self._drain_enabled_fn = drain_enabled_fn or (\n144\t            lambda: os.environ.get(\n145\t                \"BRIDGE_DRAIN_ON_SHUTDOWN\",\n146\t                os.environ.get(\"DSH_BRIDGE_DRAIN_ENABLED\", \"true\"),\n147\t            )\n148\t            .strip()\n149\t            .lower()\n150\t            in (\"1\", \"true\", \"yes\", \"on\")\n151\t        )\n152\t        self._log_fn = log_fn\n153\t        self._on_shutdown_complete = on_shutdown_complete or force_kill_fn\n154\t\n155\t\n156\t        self.shutdown_requested = threading.Event()\n157\t        self.drain_started = threading.Event()\n158\t        self.drain_completed = threading.Event()\n159\t        self.state: str = DrainState.READY\n160\t        self.last_signal: int | None = None\n161\t\n162\t        self._lock = threading.Lock()\n163\t        self._server: Any = None\n164\t        self._drain_thread: threading.Thread | None = None\n165\t        self.keepalive = KeepaliveController()\n166\t\n167\t    @property\n168\t    def workspace(self) -> Path:\n169\t        return Path(self._workspace_fn())\n170\t\n171\t    @property\n172\t    def children_path(self) -> Path:\n173\t        if self.turn_manager is not None:\n174\t            return self.turn_manager.children_path\n175\t        if self._explicit_state_dir is not None:\n176\t            sd = Path(\n177\t                self._explicit_state_dir()\n178\t                if callable(self._explicit_state_dir)\n179\t                else self._explicit_state_dir\n180\t            )\n181\t            if (sd / \"children.json\").exists() or not (sd / \"state\").is_dir():\n182\t                return sd / \"children.json\"\n183\t        return self.workspace / \"state\" / \"children.json\"\n184\t\n185\t    def is_draining(self) -> bool:\n186\t        return (\n187\t            self.state in (DrainState.DRAINING, DrainState.STOPPED)\n188\t            or self.shutdown_requested.is_set()\n189\t        )\n190\t\n191\t    def is_drain_enabled(self) -> bool:\n192\t        return bool(self._drain_enabled_fn())\n193\t\n194\t    def _log(self, message: str) -> None:\n195\t        if self._log_fn is not None:\n196\t            try:\n197\t                self._log_fn(message)\n198\t            except Exception:  # noqa: BLE001\n199\t                pass\n200\t\n201\t    def attach_server(self, server: Any) -> None:\n202\t        \"\"\"Привязывает экземпляр `ThreadingHTTPServer` для остановки после drain.\"\"\"\n203\t        with self._lock:\n204\t            self._server = server\n205\t\n206\t    def start_signal_watcher(self, server: Any = None) -> threading.Thread:\n207\t        \"\"\"Привязывает HTTP-сервер и запускает фоновый поток координации drain.\"\"\"\n208\t        if server is not None:\n209\t            self.attach_server(server)\n210\t        return self.start_drain_worker()\n211\t\n212\t    def handle_signal(self, signum: int, _frame: Any = None) -> None:\n213\t        \"\"\"Неблокирующий обработчик `SIGTERM`/`SIGINT` (RW-007).\n214\t\n215\t        В обработчике сигнала запрещены захват `Lock`, логирование и I/O:\n216\t        выставляется только атомарный `threading.Event`.\n217\t        \"\"\"\n218\t        self.last_signal = int(signum)\n219\t        self.shutdown_requested.set()\n220\t\n221\t    def start_drain_worker(self) -> threading.Thread:\n222\t        \"\"\"Запускает фоновый поток, ожидающий `shutdown_requested`.\"\"\"\n223\t        with self._lock:\n224\t            if self._drain_thread is not None and self._drain_thread.is_alive():\n225\t                return self._drain_thread\n226\t            worker = threading.Thread(\n227\t                target=self._drain_worker_loop,\n228\t                name=\"hub-drain-coordinator\",\n229\t                daemon=True,\n230\t            )\n231\t            self._drain_thread = worker\n232\t            worker.start()\n233\t            return worker\n234\t\n235\t    def install_signal_handlers(self, *, start_worker: bool = True) -> None:\n236\t        \"\"\"Регистрирует `handle_signal` для `SIGTERM`/`SIGINT` и запускает drain-поток.\"\"\"\n237\t        if start_worker:\n238\t            self.start_drain_worker()\n239\t        if threading.current_thread() is threading.main_thread():\n240\t            signal.signal(signal.SIGTERM, self.handle_signal)\n241\t            signal.signal(signal.SIGINT, self.handle_signal)\n242\t\n243\t    def trigger_shutdown(self, signum: int = signal.SIGTERM) -> None:\n244\t        \"\"\"Инициирует процедуру Graceful Shutdown & Drain (безопасно из любого потока).\"\"\"\n245\t        self.start_drain_worker()\n246\t        self.handle_signal(signum, None)\n247\t\n248\t    def _drain_worker_loop(self) -> None:\n249\t        self.shutdown_requested.wait()\n250\t        self.run_drain_once()\n251\t\n252\t    def run_drain_once(self) -> dict[str, Any]:\n253\t        \"\"\"Выполняет фазу `DRAINING` в фоновом потоке (идемпотентно).\"\"\"\n254\t        with self._lock:\n255\t            if self.state in (DrainState.DRAINING, DrainState.STOPPED):\n256\t                return {\"interrupted_turn_ids\": [], \"state\": self.state}\n257\t            self.state = DrainState.DRAINING\n258\t            self.drain_started.set()\n259\t            srv = self._server\n260\t\n261\t        eff_timeout = self.drain_timeout_s if self.is_drain_enabled() else 0.0\n262\t        active_before = (\n263\t            self.turn_manager.active_count()\n264\t            if self.turn_manager is not None\n265\t            else (self._active_turns_fn() if self._active_turns_fn is not None else 0)\n266\t        )\n267\t        self._log(\n268\t            f\"drain_started signal={self.last_signal or 0} \"\n269\t            f\"active_turns={active_before} timeout_s={eff_timeout:.1f}\"\n270\t        )\n271\t\n272\t        remaining = []\n273\t        deadline = time.monotonic() + max(0.0, eff_timeout)\n274\t        if self.turn_manager is not None:\n275\t            if eff_timeout > 0:\n276\t                remaining = self.turn_manager.wait_for_active_turns(timeout=eff_timeout)\n277\t            else:\n278\t                remaining = self.turn_manager.active_turns()\n279\t\n280\t            for turn in remaining:\n281\t                self._log(\n282\t                    f\"drain_timeout_interrupt rid={turn.rid} turn_id={turn.turn_id} \"\n283\t                    f\"pgid={turn.pgid}\"\n284\t                )\n285\t                self.turn_manager.interrupt_for_drain(\n286\t                    turn,\n287\t                    message=\"bridge restart drain timeout exceeded\",\n288\t                )\n289\t        elif self._active_turns_fn is not None and eff_timeout > 0:\n290\t            while time.monotonic() < deadline and self._active_turns_fn() > 0:\n291\t                time.sleep(0.05)\n292\t\n293\t        if srv is not None:\n294\t            try:\n295\t                srv.shutdown()\n296\t            except Exception:  # noqa: BLE001\n297\t                pass\n298\t\n299\t        if self._on_shutdown_complete is not None:\n300\t            try:\n301\t                self._on_shutdown_complete()\n302\t            except Exception:  # noqa: BLE001\n303\t                pass\n304\t\n305\t        with self._lock:\n306\t            self.state = DrainState.STOPPED\n307\t            self.drain_completed.set()\n308\t        self._log(f\"drain_completed interrupted_turns={len(remaining)}\")\n309\t        return {\n310\t            \"interrupted_turn_ids\": [t.turn_id for t in remaining],\n311\t            \"state\": self.state,\n312\t        }\n313\t\n314\t    def draining_response(self) -> tuple[int, dict[str, str], dict[str, Any]]:\n315\t        \"\"\"Возвращает `(status_code, headers, body)` для отказа новым запросам при `DRAINING`.\"\"\"\n316\t        headers = {\n317\t            \"Retry-After\": str(self.retry_after_s),\n318\t            \"X-Bridge-Draining\": \"true\",\n319\t        }\n320\t        body = {\n321\t            \"error\": {\n322\t                \"message\": \"bridge is draining for restart\",\n323\t                \"type\": \"overloaded\",\n324\t                \"code\": 503,\n325\t            }\n326\t        }\n327\t        return 503, headers, body\n328\t\n329\t    def health_headers(self) -> dict[str, str]:\n330\t        \"\"\"Возвращает дополнительные HTTP-заголовки для `/health` в режиме `DRAINING`.\"\"\"\n331\t        if self.is_draining():\n332\t            return {\"X-Bridge-Draining\": \"true\"}\n333\t        return {}\n334\t\n335\t    @staticmethod\n336\t    def _is_pid_or_group_alive(pid: int, pgid: int) -> bool:\n337\t        for target, fn in ((pgid, os.killpg), (pid, os.kill)):\n338\t            if isinstance(target, int) and target > 0:\n339\t                try:\n340\t                    fn(target, 0)\n341\t                    return True\n342\t                except ProcessLookupError:\n343\t                    continue\n344\t                except PermissionError:\n345\t                    return True\n346\t                except OSError:\n347\t                    continue\n348\t        return False\n349\t\n350\t    @staticmethod\n351\t    def _matches_expected_command(pid: int, pgid: int, expected_cmd: str = \"\") -> bool:\n352\t        \"\"\"Проверяет через `ps`, что процесс принадлежит CLI-потомку моста, а не чужому PID.\"\"\"\n353\t        targets = []\n354\t        if isinstance(pid, int) and pid > 0:\n355\t            targets.append((\"-p\", str(pid)))\n356\t        if isinstance(pgid, int) and pgid > 0:\n357\t            targets.append((\"-g\", str(pgid)))\n358\t        if not targets:\n359\t            return False\n360\t\n361\t        for flag, val in targets:\n362\t            try:\n363\t                proc = subprocess.run(\n364\t                    [\"ps\", \"-o\", \"comm=,command=\", flag, val],\n365\t                    capture_output=True,\n366\t                    text=True,\n367\t                    timeout=2.0,\n368\t                    check=False,\n369\t                )\n370\t            except (subprocess.TimeoutExpired, OSError):\n371\t                continue\n372\t            if proc.returncode != 0 or not proc.stdout.strip():\n373\t                continue\n374\t            out_lower = proc.stdout.lower()\n375\t            if expected_cmd and expected_cmd.lower() in out_lower:\n376\t                return True\n377\t            for token in KNOWN_CHILD_BINARIES:\n378\t                if token in out_lower:\n379\t                    return True\n380\t        return False\n381\t\n382\t    def reap_orphans_on_startup(\n383\t        self, children_file: Path | None = None\n384\t    ) -> list[int]:\n385\t        \"\"\"Убирает осиротевшие группы процессов из `children.json` при старте хаба (RW-004).\"\"\"\n386\t        path = Path(children_file) if children_file is not None else self.children_path\n387\t        if not path.is_file():\n388\t            return []\n389\t\n390\t        try:\n391\t            raw = json.loads(path.read_text(encoding=\"utf-8\"))\n392\t        except (OSError, json.JSONDecodeError):\n393\t            return []\n394\t\n395\t        entries: list[dict[str, Any]] = []\n396\t        if isinstance(raw, dict):\n397\t            if isinstance(raw.get(\"children\"), list):\n398\t                entries = [item for item in raw[\"children\"] if isinstance(item, dict)]\n399\t            else:\n400\t                for key, val in raw.items():\n401\t                    if key == \"schema_version\":\n402\t                        continue\n403\t                    if isinstance(val, dict):\n404\t                        entry = dict(val)\n405\t                        if \"pid\" not in entry and str(key).isdigit():\n406\t                            entry[\"pid\"] = int(key)\n407\t                        entries.append(entry)\n408\t                    elif isinstance(val, int) and str(key).isdigit():\n409\t                        entries.append({\"pid\": int(key), \"pgid\": int(val)})\n410\t        elif isinstance(raw, list):\n411\t            for item in raw:\n412\t                if isinstance(item, dict):\n413\t                    entries.append(item)\n414\t                elif isinstance(item, int):\n415\t                    entries.append({\"pid\": item, \"pgid\": item})\n416\t\n417\t        reaped_pgids: list[int] = []\n418\t        seen_pgids: set[int] = set()\n419\t        for entry in entries:\n420\t            pid = int(entry.get(\"pid\") or entry.get(\"pgid\") or 0)\n421\t            pgid = int(entry.get(\"pgid\") or pid or 0)\n422\t            turn_id = str(entry.get(\"turn_id\") or \"-\")\n423\t            expected_cmd = str(entry.get(\"command\") or entry.get(\"cmd\") or \"\")\n424\t            if pgid <= 0 or pgid in seen_pgids:\n425\t                continue\n426\t            seen_pgids.add(pgid)\n427\t            if not self._is_pid_or_group_alive(pid, pgid):\n428\t                continue\n429\t            if not self._matches_expected_command(pid, pgid, expected_cmd):\n430\t                continue\n431\t\n432\t            try:\n433\t                os.killpg(pgid, signal.SIGTERM)\n434\t            except (ProcessLookupError, PermissionError, OSError):\n435\t                try:\n436\t                    if pid > 0:\n437\t                        os.kill(pid, signal.SIGTERM)\n438\t                except (ProcessLookupError, PermissionError, OSError):\n439\t                    pass\n440\t\n441\t            deadline = time.monotonic() + max(0.05, self.orphan_grace_s)\n442\t            while time.monotonic() < deadline:\n443\t                if not self._is_pid_or_group_alive(pid, pgid):\n444\t                    break\n445\t                time.sleep(0.05)\n446\t\n447\t            if self._is_pid_or_group_alive(pid, pgid):\n448\t                try:\n449\t                    os.killpg(pgid, signal.SIGKILL)\n450\t                except (ProcessLookupError, PermissionError, OSError):\n451\t                    try:\n452\t                        if pid > 0:\n453\t                            os.kill(pid, signal.SIGKILL)\n454\t                    except (ProcessLookupError, PermissionError, OSError):\n455\t                        pass\n456\t\n457\t            reaped_pgids.append(pgid)\n458\t            self._log(f\"orphan_reaped pgid={pgid} turn_id={turn_id}\")\n459\t\n460\t        try:\n461\t            empty_payload: Any = (\n462\t                []\n463\t                if isinstance(raw, list)\n464\t                else {\"schema_version\": SNAPSHOT_SCHEMA_VERSION, \"children\": []}\n465\t            )\n466\t            _atomic_write_json_0600(path, empty_payload)\n467\t        except OSError:\n468\t            pass\n469\t\n470\t        return reaped_pgids\n471\t\n472\t    reap_startup_orphans = reap_orphans_on_startup\n473\t\n474\t    def reset(self) -> None:\n475\t        \"\"\"Сбрасывает состояние менеджера жизненного цикла (для тестов).\"\"\"\n476\t        with self._lock:\n477\t            self.shutdown_requested.clear()\n478\t            self.drain_started.clear()\n479\t            self.drain_completed.clear()\n480\t            self.state = DrainState.READY\n481\t            self.last_signal = None\n482\t            self._drain_thread = None\n483\t\n484\t    reset_state = reset\n485\t    reset_for_tests = reset\n486\t\n487\t"}]},"parent_tool_use_id":null,"session_id":"3fb1b2b6-87c5-4d4e-9965-c0b3fa5aef1f","uuid":"e0446eb3-1bc4-4819-90e3-4bd8475a9a4e","timestamp":"2026-10-17T20:01:02.409Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/core/lifecycle.py","content":"\"\"\"Менеджер жизненного цикла хаба, неблокирующий Drain и уборка сирот (ADR-0005 / AD-004).\n\nМодуль отвечает за:\n1. Неблокирующий перехват `SIGTERM`/`SIGINT` (`RW-007`): обработчик сигнала выставляет\n   только `threading.Event` (`shutdown_requested`), не захватывая мьютексы и не\n   выполняя блокирующий ввод-вывод.\n2. Координацию `DRAINING` в фоновом потоке (`DRAIN_TIMEOUT_S = 110.0` с при\n   `ExitTimeOut = 120` с в launchd): новые запросы получают `HTTP 503 Service Unavailable`\n   с заголовком `Retry-After: 5`, `/health` возвращает `ok: false` и заголовок\n   `X-Bridge-Draining: true`, а активные ходы доводятся до конца либо корректно\n   прерываются со сбросом `reasoning_content` и терминальным чанком `drain_timeout`.\n3. Безопасную уборку сирот при старте (`reap_orphans_on_startup`, `RW-004`): сверка\n   `workspace/state/children.json` через `os.kill(pid, 0)` и имя команды в `ps`,\n   мягкое погашение `SIGTERM -> 1s -> SIGKILL` с логом `orphan_reaped`.\n4. Контроль интервала SSE keepalive (`KeepaliveController`, `<= 10.0` с).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport threading\nimport time\nfrom typing import Any\n\nfrom core.turn_session_manager import (\n    SNAPSHOT_SCHEMA_VERSION,\n    TurnSessionManager,\n    _atomic_write_json_0600,\n)\n\nDRAIN_TIMEOUT_S: float = 110.0\nDEFAULT_DRAIN_SECONDS: float = DRAIN_TIMEOUT_S\nRETRY_AFTER_S: int = 5\nORPHAN_SIGTERM_GRACE_S: float = 1.0\nMAX_KEEPALIVE_INTERVAL_S: float = 10.0\n\nKNOWN_CHILD_BINARIES = frozenset(\n    {\n        \"muse\",\n        \"muse-cli\",\n        \"muse-cli.sh\",\n        \"droid\",\n        \"fake_droid\",\n        \"fake_serve\",\n        \"node\",\n        \"python\",\n        \"python3\",\n        \"bash\",\n        \"sh\",\n        \"zsh\",\n        \"sleep\",\n    }\n)\n\n\nclass DrainState:\n    \"\"\"Фазы жизненного цикла HTTP-хаба при перезапуске.\"\"\"\n\n    READY = \"READY\"\n    DRAINING = \"DRAINING\"\n    STOPPED = \"STOPPED\"\n\n\nclass KeepaliveController:\n    \"\"\"Контроллер интервала SSE keepalive (`<= 10.0` с для защиты от обрыва прокси/туннеля).\"\"\"\n\n    def __init__(self, max_interval_s: float = MAX_KEEPALIVE_INTERVAL_S) -> None:\n        self.max_interval_s = max(0.05, min(float(max_interval_s), MAX_KEEPALIVE_INTERVAL_S))\n\n    def effective_interval(self, requested_s: float | int | None = None) -> float:\n        \"\"\"Возвращает эффективный интервал keepalive, не превышающий `10.0` с.\"\"\"\n        if requested_s is None:\n            return self.max_interval_s\n        try:\n            val = float(requested_s)\n        except (TypeError, ValueError):\n            return self.max_interval_s\n        if val <= 0:\n            return self.max_interval_s\n        return min(val, self.max_interval_s)\n\n    @staticmethod\n    def sse_comment() -> str:\n        \"\"\"Возвращает стандартный SSE-комментарий keepalive.\"\"\"\n        return \": keepalive\\n\\n\"\n\n    @staticmethod\n    def sse_data_chunk(\n        *,\n        completion_id: str,\n        created: int,\n        model: str,\n    ) -> str:\n        \"\"\"Возвращает пустой SSE data-чанк keepalive в формате OpenAI `chat.completion.chunk`.\"\"\"\n        payload = json.dumps(\n            {\n                \"id\": completion_id,\n                \"object\": \"chat.completion.chunk\",\n                \"created\": int(created),\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n            },\n            ensure_ascii=False,\n        )\n        return f\"data: {payload}\\n\\n\"\n\n\nclass HubLifecycleManager:\n    \"\"\"Координатор сигналов `SIGTERM`/`SIGINT`, фазы `DRAINING` и уборки сирот.\"\"\"\n\n    def __init__(\n        self,\n        workspace: Path | str | Callable[[], Path] | None = None,\n        *,\n        state_dir: Path | str | Callable[[], Path] | None = None,\n        turn_manager: TurnSessionManager | None = None,\n        active_turns_fn: Callable[[], int] | None = None,\n        force_kill_fn: Callable[[], None] | None = None,\n        drain_timeout_s: float = DRAIN_TIMEOUT_S,\n        retry_after_s: int = RETRY_AFTER_S,\n        orphan_grace_s: float = ORPHAN_SIGTERM_GRACE_S,\n        drain_enabled_fn: Callable[[], bool] | None = None,\n        log_fn: Callable[[str], None] | None = None,\n        on_shutdown_complete: Callable[[], None] | None = None,\n    ) -> None:\n        ws_source = workspace if workspace is not None else (state_dir or \".\")\n        self._explicit_state_dir = state_dir\n        self._workspace_fn: Callable[[], Path] = (\n            (lambda: Path(ws_source))\n            if isinstance(ws_source, (str, Path))\n            else ws_source\n        )\n        self.turn_manager = turn_manager\n        self._active_turns_fn = active_turns_fn\n        self.drain_timeout_s = float(drain_timeout_s)\n        self.retry_after_s = int(retry_after_s)\n        self.orphan_grace_s = float(orphan_grace_s)\n        self._drain_enabled_fn = drain_enabled_fn or (\n            lambda: os.environ.get(\n                \"BRIDGE_DRAIN_ON_SHUTDOWN\",\n                os.environ.get(\"DSH_BRIDGE_DRAIN_ENABLED\", \"true\"),\n            )\n            .strip()\n            .lower()\n            in (\"1\", \"true\", \"yes\", \"on\")\n        )\n        self._log_fn = log_fn\n        self._on_shutdown_complete = on_shutdown_complete or force_kill_fn\n\n\n        self.shutdown_requested = threading.Event()\n        self.drain_started = threading.Event()\n        self.drain_completed = threading.Event()\n        self.state: str = DrainState.READY\n        self.last_signal: int | None = None\n\n        self._lock = threading.Lock()\n        self._server: Any = None\n        self._drain_thread: threading.Thread | None = None\n        self.keepalive = KeepaliveController()\n\n    @property\n    def workspace(self) -> Path:\n        return Path(self._workspace_fn())\n\n    @property\n    def children_path(self) -> Path:\n        if self.turn_manager is not None:\n            return self.turn_manager.children_path\n        if self._explicit_state_dir is not None:\n            sd = Path(\n                self._explicit_state_dir()\n                if callable(self._explicit_state_dir)\n                else self._explicit_state_dir\n            )\n            if (sd / \"children.json\").exists() or not (sd / \"state\").is_dir():\n                return sd / \"children.json\"\n        return self.workspace / \"state\" / \"children.json\"\n\n    def is_draining(self) -> bool:\n        return (\n            self.state in (DrainState.DRAINING, DrainState.STOPPED)\n            or self.shutdown_requested.is_set()\n        )\n\n    def is_drain_enabled(self) -> bool:\n        return bool(self._drain_enabled_fn())\n\n    def _log(self, message: str) -> None:\n        if self._log_fn is not None:\n            try:\n                self._log_fn(message)\n            except Exception:  # noqa: BLE001\n                pass\n\n    def attach_server(self, server: Any) -> None:\n        \"\"\"Привязывает экземпляр `ThreadingHTTPServer` для остановки после drain.\"\"\"\n        with self._lock:\n            self._server = server\n\n    def start_signal_watcher(self, server: Any = None) -> threading.Thread:\n        \"\"\"Привязывает HTTP-сервер и запускает фоновый поток координации drain.\"\"\"\n        if server is not None:\n            self.attach_server(server)\n        return self.start_drain_worker()\n\n    def handle_signal(self, signum: int, _frame: Any = None) -> None:\n        \"\"\"Неблокирующий обработчик `SIGTERM`/`SIGINT` (RW-007).\n\n        В обработчике сигнала запрещены захват `Lock`, логирование и I/O:\n        выставляется только атомарный `threading.Event`.\n        \"\"\"\n        self.last_signal = int(signum)\n        self.shutdown_requested.set()\n\n    def start_drain_worker(self) -> threading.Thread:\n        \"\"\"Запускает фоновый поток, ожидающий `shutdown_requested`.\"\"\"\n        with self._lock:\n            if self._drain_thread is not None and self._drain_thread.is_alive():\n                return self._drain_thread\n            worker = threading.Thread(\n                target=self._drain_worker_loop,\n                name=\"hub-drain-coordinator\",\n                daemon=True,\n            )\n            self._drain_thread = worker\n            worker.start()\n            return worker\n\n    def install_signal_handlers(self, *, start_worker: bool = True) -> None:\n        \"\"\"Регистрирует `handle_signal` для `SIGTERM`/`SIGINT` и запускает drain-поток.\"\"\"\n        if start_worker:\n            self.start_drain_worker()\n        if threading.current_thread() is threading.main_thread():\n            signal.signal(signal.SIGTERM, self.handle_signal)\n            signal.signal(signal.SIGINT, self.handle_signal)\n\n    def trigger_shutdown(self, signum: int = signal.SIGTERM) -> None:\n        \"\"\"Инициирует процедуру Graceful Shutdown & Drain (безопасно из любого потока).\"\"\"\n        self.start_drain_worker()\n        self.handle_signal(signum, None)\n\n    def _drain_worker_loop(self) -> None:\n        self.shutdown_requested.wait()\n        self.run_drain_once()\n\n    def run_drain_once(self) -> dict[str, Any]:\n        \"\"\"Выполняет фазу `DRAINING` в фоновом потоке (идемпотентно).\"\"\"\n        with self._lock:\n            if self.state in (DrainState.DRAINING, DrainState.STOPPED):\n                return {\"interrupted_turn_ids\": [], \"state\": self.state}\n            self.state = DrainState.DRAINING\n            self.drain_started.set()\n            srv = self._server\n\n        eff_timeout = self.drain_timeout_s if self.is_drain_enabled() else 0.0\n        active_before = (\n            self.turn_manager.active_count()\n            if self.turn_manager is not None\n            else (self._active_turns_fn() if self._active_turns_fn is not None else 0)\n        )\n        self._log(\n            f\"drain_started signal={self.last_signal or 0} \"\n            f\"active_turns={active_before} timeout_s={eff_timeout:.1f}\"\n        )\n\n        remaining = []\n        deadline = time.monotonic() + max(0.0, eff_timeout)\n        if self.turn_manager is not None:\n            if eff_timeout > 0:\n                remaining = self.turn_manager.wait_for_active_turns(timeout=eff_timeout)\n            else:\n                remaining = self.turn_manager.active_turns()\n\n            for turn in remaining:\n                self._log(\n                    f\"drain_timeout_interrupt rid={turn.rid} turn_id={turn.turn_id} \"\n                    f\"pgid={turn.pgid}\"\n                )\n                self.turn_manager.interrupt_for_drain(\n                    turn,\n                    message=\"bridge restart drain timeout exceeded\",\n                )\n        elif self._active_turns_fn is not None and eff_timeout > 0:\n            while time.monotonic() < deadline and self._active_turns_fn() > 0:\n                time.sleep(0.05)\n\n        if srv is not None:\n            try:\n                srv.shutdown()\n            except Exception:  # noqa: BLE001\n                pass\n\n        if self._on_shutdown_complete is not None:\n            try:\n                self._on_shutdown_complete()\n            except Exception:  # noqa: BLE001\n                pass\n\n        with self._lock:\n            self.state = DrainState.STOPPED\n            self.drain_completed.set()\n        self._log(f\"drain_completed interrupted_turns={len(remaining)}\")\n        return {\n            \"interrupted_turn_ids\": [t.turn_id for t in remaining],\n            \"state\": self.state,\n        }\n\n    def draining_response(self) -> tuple[int, dict[str, str], dict[str, Any]]:\n        \"\"\"Возвращает `(status_code, headers, body)` для отказа новым запросам при `DRAINING`.\"\"\"\n        headers = {\n            \"Retry-After\": str(self.retry_after_s),\n            \"X-Bridge-Draining\": \"true\",\n        }\n        body = {\n            \"error\": {\n                \"message\": \"bridge is draining for restart\",\n                \"type\": \"overloaded\",\n                \"code\": 503,\n            }\n        }\n        return 503, headers, body\n\n    def health_headers(self) -> dict[str, str]:\n        \"\"\"Возвращает дополнительные HTTP-заголовки для `/health` в режиме `DRAINING`.\"\"\"\n        if self.is_draining():\n            return {\"X-Bridge-Draining\": \"true\"}\n        return {}\n\n    @staticmethod\n    def _is_pid_or_group_alive(pid: int, pgid: int) -> bool:\n        for target, fn in ((pgid, os.killpg), (pid, os.kill)):\n            if isinstance(target, int) and target > 0:\n                try:\n                    fn(target, 0)\n                    return True\n                except ProcessLookupError:\n                    continue\n                except PermissionError:\n                    return True\n                except OSError:\n                    continue\n        return False\n\n    @staticmethod\n    def _matches_expected_command(pid: int, pgid: int, expected_cmd: str = \"\") -> bool:\n        \"\"\"Проверяет через `ps`, что процесс принадлежит CLI-потомку моста, а не чужому PID.\"\"\"\n        targets = []\n        if isinstance(pid, int) and pid > 0:\n            targets.append((\"-p\", str(pid)))\n        if isinstance(pgid, int) and pgid > 0:\n            targets.append((\"-g\", str(pgid)))\n        if not targets:\n            return False\n\n        for flag, val in targets:\n            try:\n                proc = subprocess.run(\n                    [\"ps\", \"-o\", \"comm=,command=\", flag, val],\n                    capture_output=True,\n                    text=True,\n                    timeout=2.0,\n                    check=False,\n                )\n            except (subprocess.TimeoutExpired, OSError):\n                continue\n            if proc.returncode != 0 or not proc.stdout.strip():\n                continue\n            out_lower = proc.stdout.lower()\n            if expected_cmd and expected_cmd.lower() in out_lower:\n                return True\n            for token in KNOWN_CHILD_BINARIES:\n                if token in out_lower:\n                    return True\n        return False\n\n    def reap_orphans_on_startup(\n        self, children_file: Path | None = None\n    ) -> list[int]:\n        \"\"\"Убирает осиротевшие группы процессов из `children.json` при старте хаба (RW-004).\"\"\"\n        path = Path(children_file) if children_file is not None else self.children_path\n        if not path.is_file():\n            return []\n\n        try:\n            raw = json.loads(path.read_text(encoding=\"utf-8\"))\n        except (OSError, json.JSONDecodeError):\n            return []\n\n        entries: list[dict[str, Any]] = []\n        if isinstance(raw, dict):\n            if isinstance(raw.get(\"children\"), list):\n                entries = [item for item in raw[\"children\"] if isinstance(item, dict)]\n            else:\n                for key, val in raw.items():\n                    if key == \"schema_version\":\n                        continue\n                    if isinstance(val, dict):\n                        entry = dict(val)\n                        if \"pid\" not in entry and str(key).isdigit():\n                            entry[\"pid\"] = int(key)\n                        entries.append(entry)\n                    elif isinstance(val, int) and str(key).isdigit():\n                        entries.append({\"pid\": int(key), \"pgid\": int(val)})\n        elif isinstance(raw, list):\n            for item in raw:\n                if isinstance(item, dict):\n                    entries.append(item)\n                elif isinstance(item, int):\n                    entries.append({\"pid\": item, \"pgid\": item})\n\n        reaped_pgids: list[int] = []\n        seen_pgids: set[int] = set()\n        for entry in entries:\n            pid = int(entry.get(\"pid\") or entry.get(\"pgid\") or 0)\n            pgid = int(entry.get(\"pgid\") or pid or 0)\n            turn_id = str(entry.get(\"turn_id\") or \"-\")\n            expected_cmd = str(entry.get(\"command\") or entry.get(\"cmd\") or \"\")\n            if pgid <= 0 or pgid in seen_pgids:\n                continue\n            seen_pgids.add(pgid)\n            if not self._is_pid_or_group_alive(pid, pgid):\n                continue\n            if not self._matches_expected_command(pid, pgid, expected_cmd):\n                continue\n\n            try:\n                os.killpg(pgid, signal.SIGTERM)\n            except (ProcessLookupError, PermissionError, OSError):\n                try:\n                    if pid > 0:\n                        os.kill(pid, signal.SIGTERM)\n                except (ProcessLookupError, PermissionError, OSError):\n                    pass\n\n            deadline = time.monotonic() + max(0.05, self.orphan_grace_s)\n            while time.monotonic() < deadline:\n                if not self._is_pid_or_group_alive(pid, pgid):\n                    break\n                time.sleep(0.05)\n\n            if self._is_pid_or_group_alive(pid, pgid):\n                try:\n                    os.killpg(pgid, signal.SIGKILL)\n                except (ProcessLookupError, PermissionError, OSError):\n                    try:\n                        if pid > 0:\n                            os.kill(pid, signal.SIGKILL)\n                    except (ProcessLookupError, PermissionError, OSError):\n                        pass\n\n            reaped_pgids.append(pgid)\n            self._log(f\"orphan_reaped pgid={pgid} turn_id={turn_id}\")\n\n        try:\n            empty_payload: Any = (\n                []\n                if isinstance(raw, list)\n                else {\"schema_version\": SNAPSHOT_SCHEMA_VERSION, \"children\": []}\n            )\n            _atomic_write_json_0600(path, empty_payload)\n        except OSError:\n            pass\n\n        return reaped_pgids\n\n    reap_startup_orphans = reap_orphans_on_startup\n\n    def reset(self) -> None:\n        \"\"\"Сбрасывает состояние менеджера жизненного цикла (для тестов).\"\"\"\n        with self._lock:\n            self.shutdown_requested.clear()\n            self.drain_started.clear()\n            self.drain_completed.clear()\n            self.state = DrainState.READY\n            self.last_signal = None\n            self._drain_thread = None\n\n    reset_state = reset\n    reset_for_tests = reset\n\n","numLines":487,"startLine":1,"totalLines":487}},"tool_result_meta":[{"id":"toolu_01P3Uq1HqtXttD71UbV3bphP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
