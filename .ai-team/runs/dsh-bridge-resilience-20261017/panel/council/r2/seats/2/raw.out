{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L3BKLtweribXytUYBtLJCR","type":"tool_result","content":"1\t\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n2\t\n3\tМодуль реализует двухконтурный контроль времени хода исключительно средствами\n4\tстандартной библиотеки Python на macOS (Darwin):\n5\t1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n6\t   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n7\t   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n8\t   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n9\t   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n10\t2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n11\t   абсолютный потолок длительности хода независимо от активности.\n12\t\n13\tПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\n14\tфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\tfrom collections.abc import Callable\n20\tfrom dataclasses import dataclass\n21\timport os\n22\timport re\n23\timport subprocess\n24\timport threading\n25\timport time\n26\t\n27\tIDLE_TIMEOUT_S: float = 300.0\n28\tSAFETY_CAP_S: float = 3600.0\n29\tFINISH_RESERVE_S: float = 35.0\n30\tWATCHDOG_INTERVAL_S: float = 5.0\n31\tPS_TIMEOUT_S: float = 2.0\n32\t\n33\tDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\n34\tDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\n35\tDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n36\t\n37\t\n38\t_PS_LINE_RE = re.compile(\n39\t    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n40\t)\n41\t\n42\t\n43\tdef parse_cputime(raw: str) -> float:\n44\t    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n45\t    token = (raw or \"\").strip()\n46\t    if not token:\n47\t        return 0.0\n48\t    days = 0\n49\t    if \"-\" in token:\n50\t        day_part, token = token.split(\"-\", 1)\n51\t        try:\n52\t            days = int(day_part)\n53\t        except ValueError:\n54\t            return 0.0\n55\t    parts = token.split(\":\")\n56\t    try:\n57\t        if len(parts) == 3:\n58\t            hours = int(parts[0])\n59\t            minutes = int(parts[1])\n60\t            seconds = float(parts[2])\n61\t        elif len(parts) == 2:\n62\t            hours = 0\n63\t            minutes = int(parts[0])\n64\t            seconds = float(parts[1])\n65\t        elif len(parts) == 1:\n66\t            hours = 0\n67\t            minutes = 0\n68\t            seconds = float(parts[0])\n69\t        else:\n70\t            return 0.0\n71\t    except ValueError:\n72\t        return 0.0\n73\t    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n74\t    return max(0.0, float(total))\n75\t\n76\t\n77\t@dataclass(frozen=True)\n78\tclass WatchdogMetrics:\n79\t    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n80\t\n81\t    pgid: int\n82\t    alive: bool\n83\t    descendant_pids: tuple[int, ...]\n84\t    new_descendants: tuple[int, ...]\n85\t    cpu_time_s: float\n86\t    cpu_delta_s: float\n87\t    ps_degraded: bool = False\n88\t    sample_ts: float = 0.0\n89\t\n90\t    @property\n91\t    def has_progress(self) -> bool:\n92\t        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n93\t        if self.ps_degraded or not self.alive:\n94\t            return False\n95\t        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n96\t\n97\t    has_activity = has_progress\n98\t\n99\t\n100\tclass ProcessWatchdog:\n101\t    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n102\t\n103\t    def __init__(\n104\t        self,\n105\t        ps_timeout_s: float = PS_TIMEOUT_S,\n106\t        log_fn: Callable[[str], None] | None = None,\n107\t        rid: str = \"\",\n108\t        turn_id: str = \"\",\n109\t    ) -> None:\n110\t        self.ps_timeout_s = float(ps_timeout_s)\n111\t        self._log_fn = log_fn\n112\t        self.rid = rid\n113\t        self.turn_id = turn_id\n114\t        self._lock = threading.Lock()\n115\t        self._prev_cpu_by_pgid: dict[int, dict[int, float]] = {}\n116\t        self._seen_descendants_by_pgid: dict[int, set[int]] = {}\n117\t        self._seeded_pgids: set[int] = set()\n118\t\n119\t    def _log(self, msg: str) -> None:\n120\t        if self._log_fn is not None:\n121\t            try:\n122\t                self._log_fn(msg)\n123\t            except Exception:  # noqa: BLE001\n124\t                pass\n125\t\n126\t    @staticmethod\n127\t    def is_group_alive(pgid: int) -> bool:\n128\t        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n129\t        if not isinstance(pgid, int) or pgid <= 0:\n130\t            return False\n131\t        try:\n132\t            os.killpg(pgid, 0)\n133\t        except ProcessLookupError:\n134\t            return False\n135\t        except PermissionError:\n136\t            return True\n137\t        except OSError:\n138\t            return False\n139\t        return True\n140\t\n141\t    def forget(self, pgid: int) -> None:\n142\t        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n143\t        with self._lock:\n144\t            self._prev_cpu_by_pgid.pop(pgid, None)\n145\t            self._seen_descendants_by_pgid.pop(pgid, None)\n146\t            self._seeded_pgids.discard(pgid)\n147\t\n148\t    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n149\t        return subprocess.run(\n150\t            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n151\t            capture_output=True,\n152\t            text=True,\n153\t            timeout=self.ps_timeout_s,\n154\t            check=False,\n155\t        )\n156\t\n157\t    def _parse_ps_output(\n158\t        self, stdout: str, target_pgid: int\n159\t    ) -> tuple[list[int], dict[int, float], bool]:\n160\t        \"\"\"Возвращает `(descendant_pids, cpu_by_pid, any_non_zombie_in_group)`.\"\"\"\n161\t        descendants: list[int] = []\n162\t        cpu_by_pid: dict[int, float] = {}\n163\t        any_alive_proc = False\n164\t        for raw_line in (stdout or \"\").splitlines():\n165\t            line = raw_line.strip()\n166\t            if not line:\n167\t                continue\n168\t            match = _PS_LINE_RE.match(line)\n169\t            if match is None:\n170\t                continue\n171\t            try:\n172\t                pid = int(match.group(1))\n173\t                _ppid = int(match.group(2))\n174\t                pgid_col = int(match.group(3))\n175\t            except ValueError:\n176\t                continue\n177\t            if pgid_col != target_pgid:\n178\t                continue\n179\t            stat = match.group(4) or \"\"\n180\t            cputime_str = match.group(5) or \"\"\n181\t            if stat.upper().startswith(\"Z\"):\n182\t                continue\n183\t            any_alive_proc = True\n184\t            cpu_by_pid[pid] = parse_cputime(cputime_str)\n185\t            if pid != target_pgid:\n186\t                descendants.append(pid)\n187\t        descendants.sort()\n188\t        return descendants, cpu_by_pid, any_alive_proc\n189\t\n190\t    def seed(\n191\t        self, pgid: int, *, rid: str = \"\", turn_id: str = \"\"\n192\t    ) -> WatchdogMetrics:\n193\t        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n194\t        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n195\t        return metrics\n196\t\n197\t    def sample(\n198\t        self,\n199\t        pgid: int,\n200\t        *,\n201\t        rid: str = \"\",\n202\t        turn_id: str = \"\",\n203\t        _seed_only: bool = False,\n204\t    ) -> WatchdogMetrics:\n205\t        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n206\t        now = time.monotonic()\n207\t        eff_rid = rid or self.rid or \"-\"\n208\t        eff_turn = turn_id or self.turn_id or \"-\"\n209\t        if not self.is_group_alive(pgid):\n210\t            return WatchdogMetrics(\n211\t                pgid=pgid,\n212\t                alive=False,\n213\t                descendant_pids=(),\n214\t                new_descendants=(),\n215\t                cpu_time_s=0.0,\n216\t                cpu_delta_s=0.0,\n217\t                ps_degraded=False,\n218\t                sample_ts=now,\n219\t            )\n220\t\n221\t        try:\n222\t            proc = self._run_ps(pgid)\n223\t        except (subprocess.TimeoutExpired, OSError) as exc:\n224\t            if not self.is_group_alive(pgid):\n225\t                return WatchdogMetrics(\n226\t                    pgid=pgid,\n227\t                    alive=False,\n228\t                    descendant_pids=(),\n229\t                    new_descendants=(),\n230\t                    cpu_time_s=0.0,\n231\t                    cpu_delta_s=0.0,\n232\t                    ps_degraded=False,\n233\t                    sample_ts=now,\n234\t                )\n235\t            self._log(\n236\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n237\t                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n238\t            )\n239\t            return WatchdogMetrics(\n240\t                pgid=pgid,\n241\t                alive=True,\n242\t                descendant_pids=(),\n243\t                new_descendants=(),\n244\t                cpu_time_s=0.0,\n245\t                cpu_delta_s=0.0,\n246\t                ps_degraded=True,\n247\t                sample_ts=now,\n248\t            )\n249\t\n250\t        if proc.returncode != 0:\n251\t            if not self.is_group_alive(pgid):\n252\t                return WatchdogMetrics(\n253\t                    pgid=pgid,\n254\t                    alive=False,\n255\t                    descendant_pids=(),\n256\t                    new_descendants=(),\n257\t                    cpu_time_s=0.0,\n258\t                    cpu_delta_s=0.0,\n259\t                    ps_degraded=False,\n260\t                    sample_ts=now,\n261\t                )\n262\t            self._log(\n263\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n264\t                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n265\t            )\n266\t            return WatchdogMetrics(\n267\t                pgid=pgid,\n268\t                alive=True,\n269\t                descendant_pids=(),\n270\t                new_descendants=(),\n271\t                cpu_time_s=0.0,\n272\t                cpu_delta_s=0.0,\n273\t                ps_degraded=True,\n274\t                sample_ts=now,\n275\t            )\n276\t\n277\t        descendants, cpu_s, any_alive = self._parse_ps_output(proc.stdout, pgid)\n278\t        if not any_alive and not self.is_group_alive(pgid):\n279\t            return WatchdogMetrics(\n280\t                pgid=pgid,\n281\t                alive=False,\n282\t                descendant_pids=(),\n283\t                new_descendants=(),\n284\t                cpu_time_s=0.0,\n285\t                cpu_delta_s=0.0,\n286\t                ps_degraded=False,\n287\t                sample_ts=now,\n288\t            )\n289\t\n290\t        with self._lock:\n291\t            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n292\t            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n293\t            if _seed_only:\n294\t                for pid, val in cpu_s.items():\n295\t                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n296\t                seen_desc.update(descendants)\n297\t                self._seeded_pgids.add(pgid)\n298\t                total_cpu = sum(cpu_s.values())\n299\t                return WatchdogMetrics(\n300\t                    pgid=pgid,\n301\t                    alive=True,\n302\t                    descendant_pids=tuple(descendants),\n303\t                    new_descendants=(),\n304\t                    cpu_time_s=total_cpu,\n305\t                    cpu_delta_s=0.0,\n306\t                    ps_degraded=False,\n307\t                    sample_ts=now,\n308\t                )\n309\t\n310\t            cpu_delta = sum(\n311\t                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n312\t            )\n313\t            new_desc = tuple(sorted(set(descendants) - seen_desc))\n314\t            for pid, val in cpu_s.items():\n315\t                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n316\t            seen_desc.update(descendants)\n317\t            self._seeded_pgids.add(pgid)\n318\t            total_cpu = sum(cpu_s.values())\n319\t\n320\t        return WatchdogMetrics(\n321\t            pgid=pgid,\n322\t            alive=True,\n323\t            descendant_pids=tuple(descendants),\n324\t            new_descendants=new_desc,\n325\t            cpu_time_s=total_cpu,\n326\t            cpu_delta_s=cpu_delta,\n327\t            ps_degraded=False,\n328\t            sample_ts=now,\n329\t        )\n330\t\n331\t\n332\tclass AdaptiveTimeoutController:\n333\t    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n334\t\n335\t    def __init__(\n336\t        self,\n337\t        idle_timeout_s: float = IDLE_TIMEOUT_S,\n338\t        safety_cap_s: float = SAFETY_CAP_S,\n339\t        finish_reserve_s: float = FINISH_RESERVE_S,\n340\t        watchdog: ProcessWatchdog | None = None,\n341\t        watchdog_enabled: bool = True,\n342\t        clock: Callable[[], float] = time.monotonic,\n343\t        rid: str = \"\",\n344\t        turn_id: str = \"\",\n345\t        log_fn: Callable[[str], None] | None = None,\n346\t    ) -> None:\n347\t        self.idle_timeout_s = float(idle_timeout_s)\n348\t        self.safety_cap_s = float(safety_cap_s)\n349\t        self.finish_reserve_s = float(finish_reserve_s)\n350\t        self.watchdog_enabled = bool(watchdog_enabled)\n351\t        self._clock = clock\n352\t        self.rid = rid\n353\t        self.turn_id = turn_id\n354\t        self._log_fn = log_fn\n355\t        self.watchdog = watchdog or ProcessWatchdog(\n356\t            log_fn=log_fn, rid=rid, turn_id=turn_id\n357\t        )\n358\t        self._lock = threading.Lock()\n359\t        now = self._clock()\n360\t        self.started_at: float = now\n361\t        self.last_activity_ts: float = now\n362\t        self.last_activity_kind: str = \"start\"\n363\t        self.pgid: int | None = None\n364\t        self.terminated_reason: str = \"\"\n365\t\n366\t    def effective_cap_s(self) -> float:\n367\t        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n368\t        if self.safety_cap_s > self.finish_reserve_s:\n369\t            return self.safety_cap_s - self.finish_reserve_s\n370\t        return max(0.01, self.safety_cap_s)\n371\t\n372\t    def record_activity(self, kind: str = \"protocol\") -> None:\n373\t        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n374\t        now = self._clock()\n375\t        with self._lock:\n376\t            self.last_activity_ts = now\n377\t            self.last_activity_kind = kind or \"protocol\"\n378\t\n379\t    def on_activity(self, kind: str = \"protocol\") -> None:\n380\t        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n381\t        self.record_activity(kind)\n382\t\n383\t    def register_pgid(self, pgid: int) -> None:\n384\t        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n385\t        if not isinstance(pgid, int) or pgid <= 0:\n386\t            return\n387\t        with self._lock:\n388\t            self.pgid = pgid\n389\t        if self.watchdog_enabled and self.watchdog is not None:\n390\t            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n391\t\n392\t    def check(\n393\t        self, pgid: int | None = None\n394\t    ) -> tuple[bool, str, WatchdogMetrics | None]:\n395\t        \"\"\"Проверяет условия завершения хода.\n396\t\n397\t        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n398\t        `should_stop == True` принимает одно из значений:\n399\t        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n400\t        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n401\t        - `\"child_exited\"` — процессная группа завершилась.\n402\t        \"\"\"\n403\t        with self._lock:\n404\t            target_pgid = pgid if pgid is not None else self.pgid\n405\t            started_at = self.started_at\n406\t\n407\t        now = self._clock()\n408\t        if now - started_at >= self.effective_cap_s():\n409\t            with self._lock:\n410\t                self.terminated_reason = \"absolute_cap\"\n411\t            return True, \"absolute_cap\", None\n412\t\n413\t        metrics: WatchdogMetrics | None = None\n414\t        if (\n415\t            self.watchdog_enabled\n416\t            and self.watchdog is not None\n417\t            and isinstance(target_pgid, int)\n418\t            and target_pgid > 0\n419\t        ):\n420\t            metrics = self.watchdog.sample(\n421\t                target_pgid, rid=self.rid, turn_id=self.turn_id\n422\t            )\n423\t            if not metrics.alive:\n424\t                with self._lock:\n425\t                    self.terminated_reason = \"child_exited\"\n426\t                return True, \"child_exited\", metrics\n427\t            if metrics.has_progress:\n428\t                with self._lock:\n429\t                    self.last_activity_ts = now\n430\t                    self.last_activity_kind = (\n431\t                        \"new_descendants\"\n432\t                        if metrics.new_descendants\n433\t                        else \"cpu_delta\"\n434\t                    )\n435\t\n436\t        with self._lock:\n437\t            idle_elapsed = now - self.last_activity_ts\n438\t            if idle_elapsed >= self.idle_timeout_s:\n439\t                self.terminated_reason = \"idle_timeout\"\n440\t                return True, \"idle_timeout\", metrics\n441\t\n442\t        return False, \"\", metrics\n443\t\n444\t    def close(self) -> None:\n445\t        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n446\t        with self._lock:\n447\t            pgid = self.pgid\n448\t        if pgid is not None and self.watchdog is not None:\n449\t            self.watchdog.forget(pgid)\n450\t"}]},"parent_tool_use_id":null,"session_id":"3fb1b2b6-87c5-4d4e-9965-c0b3fa5aef1f","uuid":"eb1b2d19-cdaf-4efb-9e38-856ed98b79ec","timestamp":"2026-10-17T20:01:02.111Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/core/watchdog.py","content":"\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n\nМодуль реализует двухконтурный контроль времени хода исключительно средствами\nстандартной библиотеки Python на macOS (Darwin):\n1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n   абсолютный потолок длительности хода независимо от активности.\n\nПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\nфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass\nimport os\nimport re\nimport subprocess\nimport threading\nimport time\n\nIDLE_TIMEOUT_S: float = 300.0\nSAFETY_CAP_S: float = 3600.0\nFINISH_RESERVE_S: float = 35.0\nWATCHDOG_INTERVAL_S: float = 5.0\nPS_TIMEOUT_S: float = 2.0\n\nDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\nDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\nDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n\n\n_PS_LINE_RE = re.compile(\n    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n)\n\n\ndef parse_cputime(raw: str) -> float:\n    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    token = (raw or \"\").strip()\n    if not token:\n        return 0.0\n    days = 0\n    if \"-\" in token:\n        day_part, token = token.split(\"-\", 1)\n        try:\n            days = int(day_part)\n        except ValueError:\n            return 0.0\n    parts = token.split(\":\")\n    try:\n        if len(parts) == 3:\n            hours = int(parts[0])\n            minutes = int(parts[1])\n            seconds = float(parts[2])\n        elif len(parts) == 2:\n            hours = 0\n            minutes = int(parts[0])\n            seconds = float(parts[1])\n        elif len(parts) == 1:\n            hours = 0\n            minutes = 0\n            seconds = float(parts[0])\n        else:\n            return 0.0\n    except ValueError:\n        return 0.0\n    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n    return max(0.0, float(total))\n\n\n@dataclass(frozen=True)\nclass WatchdogMetrics:\n    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n\n    pgid: int\n    alive: bool\n    descendant_pids: tuple[int, ...]\n    new_descendants: tuple[int, ...]\n    cpu_time_s: float\n    cpu_delta_s: float\n    ps_degraded: bool = False\n    sample_ts: float = 0.0\n\n    @property\n    def has_progress(self) -> bool:\n        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n        if self.ps_degraded or not self.alive:\n            return False\n        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n\n    has_activity = has_progress\n\n\nclass ProcessWatchdog:\n    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n\n    def __init__(\n        self,\n        ps_timeout_s: float = PS_TIMEOUT_S,\n        log_fn: Callable[[str], None] | None = None,\n        rid: str = \"\",\n        turn_id: str = \"\",\n    ) -> None:\n        self.ps_timeout_s = float(ps_timeout_s)\n        self._log_fn = log_fn\n        self.rid = rid\n        self.turn_id = turn_id\n        self._lock = threading.Lock()\n        self._prev_cpu_by_pgid: dict[int, dict[int, float]] = {}\n        self._seen_descendants_by_pgid: dict[int, set[int]] = {}\n        self._seeded_pgids: set[int] = set()\n\n    def _log(self, msg: str) -> None:\n        if self._log_fn is not None:\n            try:\n                self._log_fn(msg)\n            except Exception:  # noqa: BLE001\n                pass\n\n    @staticmethod\n    def is_group_alive(pgid: int) -> bool:\n        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return False\n        try:\n            os.killpg(pgid, 0)\n        except ProcessLookupError:\n            return False\n        except PermissionError:\n            return True\n        except OSError:\n            return False\n        return True\n\n    def forget(self, pgid: int) -> None:\n        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n        with self._lock:\n            self._prev_cpu_by_pgid.pop(pgid, None)\n            self._seen_descendants_by_pgid.pop(pgid, None)\n            self._seeded_pgids.discard(pgid)\n\n    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n        return subprocess.run(\n            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n            capture_output=True,\n            text=True,\n            timeout=self.ps_timeout_s,\n            check=False,\n        )\n\n    def _parse_ps_output(\n        self, stdout: str, target_pgid: int\n    ) -> tuple[list[int], dict[int, float], bool]:\n        \"\"\"Возвращает `(descendant_pids, cpu_by_pid, any_non_zombie_in_group)`.\"\"\"\n        descendants: list[int] = []\n        cpu_by_pid: dict[int, float] = {}\n        any_alive_proc = False\n        for raw_line in (stdout or \"\").splitlines():\n            line = raw_line.strip()\n            if not line:\n                continue\n            match = _PS_LINE_RE.match(line)\n            if match is None:\n                continue\n            try:\n                pid = int(match.group(1))\n                _ppid = int(match.group(2))\n                pgid_col = int(match.group(3))\n            except ValueError:\n                continue\n            if pgid_col != target_pgid:\n                continue\n            stat = match.group(4) or \"\"\n            cputime_str = match.group(5) or \"\"\n            if stat.upper().startswith(\"Z\"):\n                continue\n            any_alive_proc = True\n            cpu_by_pid[pid] = parse_cputime(cputime_str)\n            if pid != target_pgid:\n                descendants.append(pid)\n        descendants.sort()\n        return descendants, cpu_by_pid, any_alive_proc\n\n    def seed(\n        self, pgid: int, *, rid: str = \"\", turn_id: str = \"\"\n    ) -> WatchdogMetrics:\n        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n        return metrics\n\n    def sample(\n        self,\n        pgid: int,\n        *,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        _seed_only: bool = False,\n    ) -> WatchdogMetrics:\n        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n        now = time.monotonic()\n        eff_rid = rid or self.rid or \"-\"\n        eff_turn = turn_id or self.turn_id or \"-\"\n        if not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        try:\n            proc = self._run_ps(pgid)\n        except (subprocess.TimeoutExpired, OSError) as exc:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        if proc.returncode != 0:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        descendants, cpu_s, any_alive = self._parse_ps_output(proc.stdout, pgid)\n        if not any_alive and not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        with self._lock:\n            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n            if _seed_only:\n                for pid, val in cpu_s.items():\n                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n                seen_desc.update(descendants)\n                self._seeded_pgids.add(pgid)\n                total_cpu = sum(cpu_s.values())\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=True,\n                    descendant_pids=tuple(descendants),\n                    new_descendants=(),\n                    cpu_time_s=total_cpu,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n\n            cpu_delta = sum(\n                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n            )\n            new_desc = tuple(sorted(set(descendants) - seen_desc))\n            for pid, val in cpu_s.items():\n                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n            seen_desc.update(descendants)\n            self._seeded_pgids.add(pgid)\n            total_cpu = sum(cpu_s.values())\n\n        return WatchdogMetrics(\n            pgid=pgid,\n            alive=True,\n            descendant_pids=tuple(descendants),\n            new_descendants=new_desc,\n            cpu_time_s=total_cpu,\n            cpu_delta_s=cpu_delta,\n            ps_degraded=False,\n            sample_ts=now,\n        )\n\n\nclass AdaptiveTimeoutController:\n    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n\n    def __init__(\n        self,\n        idle_timeout_s: float = IDLE_TIMEOUT_S,\n        safety_cap_s: float = SAFETY_CAP_S,\n        finish_reserve_s: float = FINISH_RESERVE_S,\n        watchdog: ProcessWatchdog | None = None,\n        watchdog_enabled: bool = True,\n        clock: Callable[[], float] = time.monotonic,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        log_fn: Callable[[str], None] | None = None,\n    ) -> None:\n        self.idle_timeout_s = float(idle_timeout_s)\n        self.safety_cap_s = float(safety_cap_s)\n        self.finish_reserve_s = float(finish_reserve_s)\n        self.watchdog_enabled = bool(watchdog_enabled)\n        self._clock = clock\n        self.rid = rid\n        self.turn_id = turn_id\n        self._log_fn = log_fn\n        self.watchdog = watchdog or ProcessWatchdog(\n            log_fn=log_fn, rid=rid, turn_id=turn_id\n        )\n        self._lock = threading.Lock()\n        now = self._clock()\n        self.started_at: float = now\n        self.last_activity_ts: float = now\n        self.last_activity_kind: str = \"start\"\n        self.pgid: int | None = None\n        self.terminated_reason: str = \"\"\n\n    def effective_cap_s(self) -> float:\n        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n        if self.safety_cap_s > self.finish_reserve_s:\n            return self.safety_cap_s - self.finish_reserve_s\n        return max(0.01, self.safety_cap_s)\n\n    def record_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n        now = self._clock()\n        with self._lock:\n            self.last_activity_ts = now\n            self.last_activity_kind = kind or \"protocol\"\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n        self.record_activity(kind)\n\n    def register_pgid(self, pgid: int) -> None:\n        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return\n        with self._lock:\n            self.pgid = pgid\n        if self.watchdog_enabled and self.watchdog is not None:\n            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n\n    def check(\n        self, pgid: int | None = None\n    ) -> tuple[bool, str, WatchdogMetrics | None]:\n        \"\"\"Проверяет условия завершения хода.\n\n        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n        `should_stop == True` принимает одно из значений:\n        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n        - `\"child_exited\"` — процессная группа завершилась.\n        \"\"\"\n        with self._lock:\n            target_pgid = pgid if pgid is not None else self.pgid\n            started_at = self.started_at\n\n        now = self._clock()\n        if now - started_at >= self.effective_cap_s():\n            with self._lock:\n                self.terminated_reason = \"absolute_cap\"\n            return True, \"absolute_cap\", None\n\n        metrics: WatchdogMetrics | None = None\n        if (\n            self.watchdog_enabled\n            and self.watchdog is not None\n            and isinstance(target_pgid, int)\n            and target_pgid > 0\n        ):\n            metrics = self.watchdog.sample(\n                target_pgid, rid=self.rid, turn_id=self.turn_id\n            )\n            if not metrics.alive:\n                with self._lock:\n                    self.terminated_reason = \"child_exited\"\n                return True, \"child_exited\", metrics\n            if metrics.has_progress:\n                with self._lock:\n                    self.last_activity_ts = now\n                    self.last_activity_kind = (\n                        \"new_descendants\"\n                        if metrics.new_descendants\n                        else \"cpu_delta\"\n                    )\n\n        with self._lock:\n            idle_elapsed = now - self.last_activity_ts\n            if idle_elapsed >= self.idle_timeout_s:\n                self.terminated_reason = \"idle_timeout\"\n                return True, \"idle_timeout\", metrics\n\n        return False, \"\", metrics\n\n    def close(self) -> None:\n        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n        with self._lock:\n            pgid = self.pgid\n        if pgid is not None and self.watchdog is not None:\n            self.watchdog.forget(pgid)\n","numLines":450,"startLine":1,"totalLines":450}},"tool_result_meta":[{"id":"toolu_01L3BKLtweribXytUYBtLJCR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
