{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KuvNo1beAsTNiEz9oiVEtS","type":"tool_result","content":"1\t\"\"\"Менеджер отвязанных сессий хода и кольцевой буфер событий (ADR-0005 / AD-001).\n2\t\n3\tМодуль отделяет жизненный цикл выполнения хода (`ManagedTurn`) от жизненного цикла\n4\tклиентского HTTP/SSE-соединения:\n5\t- При разрыве клиентского сокета ход переходит из `RUNNING_ATTACHED` в `RUNNING_DETACHED`\n6\t  и продолжает чтение вывода дочернего CLI в фоновом потоке до терминального состояния.\n7\t- Детерминированный `turn_key` дедуплицирует только активные (нетерминальные) ходы;\n8\t  повторный запрос с тем же промптом после терминального состояния запускает новый ход\n9\t  с новым `turn_id` (поддержка Regenerate, RW-003).\n10\t- Кольцевой буфер `TurnBuffer` ограничен `MAX_TURN_TEXT_BYTES = 10 МиБ` на ход и\n11\t  `MAX_TURN_BUFFER_TOTAL_BYTES = 128 МиБ` / `MAX_BUFFERED_TURNS = 128` глобально.\n12\t- При вытеснении событий из кольцевого буфера запрос дочитки с устаревшим курсором\n13\t  (`from_seq < oldest_available_seq - 1`) порождает `GapDetectedError` для ответа\n14\t  `HTTP 410 Gone` (`code=\"GAP_DETECTED\"`, RW-006).\n15\t- Модуль не импортирует `core.tool_emulation`, `http.server` или `adapters.*` (FU-003).\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\tfrom collections import deque\n21\tfrom collections.abc import Callable, Iterator\n22\tfrom dataclasses import asdict, dataclass, field\n23\timport hashlib\n24\timport hmac\n25\timport json\n26\timport os\n27\tfrom pathlib import Path\n28\timport queue\n29\timport re\n30\timport signal\n31\timport tempfile\n32\timport threading\n33\timport time\n34\tfrom typing import Any\n35\timport uuid\n36\t\n37\tfrom core.backend_adapter import ToolCall, TurnResult, Usage\n38\tfrom core.watchdog import (\n39\t    FINISH_RESERVE_S,\n40\t    IDLE_TIMEOUT_S,\n41\t    SAFETY_CAP_S,\n42\t    WATCHDOG_INTERVAL_S,\n43\t    AdaptiveTimeoutController,\n44\t    ProcessWatchdog,\n45\t)\n46\t\n47\tSNAPSHOT_SCHEMA_VERSION = \"1.0\"\n48\tTURN_ID_RE = re.compile(r\"^[a-zA-Z0-9_-]{1,64}$\")\n49\t\n50\tKNOWN_EVENT_KINDS = frozenset(\n51\t    {\"reasoning\", \"content\", \"tool_call\", \"error\", \"done\", \"status\"}\n52\t)\n53\t\n54\tMAX_TURN_TEXT_BYTES: int = 10 * 1024 * 1024\n55\tMAX_BUFFERED_TURNS: int = 128\n56\tMAX_TURN_BUFFER_TOTAL_BYTES: int = 128 * 1024 * 1024\n57\tTURN_RETENTION_S: float = 3600.0\n58\tCANCEL_SIGTERM_GRACE_S: float = 2.0\n59\t\n60\tSTATE_QUEUED = \"QUEUED\"\n61\tSTATE_RUNNING_ATTACHED = \"RUNNING_ATTACHED\"\n62\tSTATE_RUNNING_DETACHED = \"RUNNING_DETACHED\"\n63\tSTATE_COMPLETED = \"COMPLETED\"\n64\tSTATE_CANCELLED = \"CANCELLED\"\n65\tSTATE_FAILED_BACKEND = \"FAILED_BACKEND\"\n66\tSTATE_TIMED_OUT_IDLE = \"TIMED_OUT_IDLE\"\n67\tSTATE_TIMED_OUT_CAP = \"TIMED_OUT_CAP\"\n68\tSTATE_INTERRUPTED_DRAIN = \"INTERRUPTED_DRAIN\"\n69\t\n70\tACTIVE_TURN_STATES = frozenset(\n71\t    {STATE_QUEUED, STATE_RUNNING_ATTACHED, STATE_RUNNING_DETACHED}\n72\t)\n73\tTERMINAL_TURN_STATES = frozenset(\n74\t    {\n75\t        STATE_COMPLETED,\n76\t        STATE_CANCELLED,\n77\t        STATE_FAILED_BACKEND,\n78\t        STATE_TIMED_OUT_IDLE,\n79\t        STATE_TIMED_OUT_CAP,\n80\t        STATE_INTERRUPTED_DRAIN,\n81\t    }\n82\t)\n83\t\n84\t_SECRET_PATTERNS = (\n85\t    re.compile(r\"(?i)(Bearer\\s+)[A-Za-z0-9._~+/=-]{8,}\"),\n86\t    re.compile(\n87\t        r\"(?i)((?:DROID_DSH_BRIDGE_KEY|FACTORY_API_KEY|META_API_KEY|API_KEY|TOKEN|SECRET)\\s*[=:]\\s*)([^\\s\\\"',;]+)\"\n88\t    ),\n89\t    re.compile(r\"\\b(?:fk|sk)-[A-Za-z0-9_-]{10,}\\b\"),\n90\t)\n91\t\n92\t\n93\tdef validate_turn_id(turn_id: Any) -> bool:\n94\t    \"\"\"Проверяет идентификатор хода по строгому шаблону `^[a-zA-Z0-9_-]{1,64}$`.\"\"\"\n95\t    return isinstance(turn_id, str) and bool(TURN_ID_RE.fullmatch(turn_id))\n96\t\n97\t\n98\tdef hash_owner_token(token_or_peer: str | None) -> str:\n99\t    \"\"\"Вычисляет SHA-256 хеш токена владельца или локального пира для изоляции хода.\"\"\"\n100\t    raw = (token_or_peer or \"anonymous\").strip()\n101\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n102\t\n103\t\n104\thash_token = hash_owner_token\n105\t\n106\t\n107\tdef _is_detached_enabled() -> bool:\n108\t    \"\"\"Проверяет флаг включения фонового доведения ходов (`BRIDGE_DETACHED_TURNS_ENABLED` / `DSH_BRIDGE_DETACHED_ENABLED`).\"\"\"\n109\t    val = os.environ.get(\n110\t        \"BRIDGE_DETACHED_TURNS_ENABLED\",\n111\t        os.environ.get(\n112\t            \"BRIDGE_ENABLE_DETACHED_TURNS\",\n113\t            os.environ.get(\"DSH_BRIDGE_DETACHED_ENABLED\", \"true\"),\n114\t        ),\n115\t    )\n116\t    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n117\t\n118\t\n119\tdef _is_watchdog_enabled() -> bool:\n120\t    \"\"\"Проверяет флаг включения адаптивного watchdog (`BRIDGE_ADAPTIVE_WATCHDOG_ENABLED` / `DSH_BRIDGE_WATCHDOG_ENABLED`).\"\"\"\n121\t    val = os.environ.get(\n122\t        \"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\",\n123\t        os.environ.get(\n124\t            \"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\",\n125\t            os.environ.get(\"DSH_BRIDGE_WATCHDOG_ENABLED\", \"true\"),\n126\t        ),\n127\t    )\n128\t    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n129\t\n130\t\n131\tdef _is_drain_enabled() -> bool:\n132\t    \"\"\"Проверяет флаг включения неблокирующего drain (`BRIDGE_DRAIN_ON_SHUTDOWN` / `DSH_BRIDGE_DRAIN_ENABLED`).\"\"\"\n133\t    val = os.environ.get(\n134\t        \"BRIDGE_DRAIN_ON_SHUTDOWN\",\n135\t        os.environ.get(\n136\t            \"BRIDGE_ENABLE_GRACEFUL_DRAIN\",\n137\t            os.environ.get(\"DSH_BRIDGE_DRAIN_ENABLED\", \"true\"),\n138\t        ),\n139\t    )\n140\t    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n141\t\n142\t\n143\t\n144\tdef verify_bearer_token(provided: str | None, expected: str | None) -> bool:\n145\t    \"\"\"Константная по времени сверка Bearer-токена (`hmac.compare_digest`).\"\"\"\n146\t    if not expected:\n147\t        return True\n148\t    if not provided or not isinstance(provided, str):\n149\t        return False\n150\t    return hmac.compare_digest(provided.encode(\"utf-8\"), expected.encode(\"utf-8\"))\n151\t\n152\t\n153\tdef mask_secrets(text: str, extra_secrets: tuple[str, ...] = ()) -> str:\n154\t    \"\"\"Маскирует секреты и ключи авторизации перед записью снапшота на диск.\"\"\"\n155\t    if not text:\n156\t        return \"\"\n157\t    masked = text\n158\t    for pat in _SECRET_PATTERNS:\n159\t        if pat.groups >= 2:\n160\t            masked = pat.sub(r\"\\1[REDACTED]\", masked)\n161\t        else:\n162\t            masked = pat.sub(\"[REDACTED]\", masked)\n163\t    for env_key in (\"DROID_DSH_BRIDGE_KEY\", \"FACTORY_API_KEY\", \"META_API_KEY\"):\n164\t        env_val = os.environ.get(env_key)\n165\t        if env_val and len(env_val) >= 6 and env_val in masked:\n166\t            masked = masked.replace(env_val, \"[REDACTED]\")\n167\t    for sec in extra_secrets:\n168\t        if sec and len(sec) >= 6 and sec in masked:\n169\t            masked = masked.replace(sec, \"[REDACTED]\")\n170\t    return masked\n171\t\n172\t\n173\tdef compute_turn_key(\n174\t    cwd: str | None,\n175\t    model: str,\n176\t    session_id: str | None,\n177\t    messages: list[dict[str, Any]] | tuple[Any, ...],\n178\t    default_workspace: str = \"\",\n179\t) -> str:\n180\t    \"\"\"Детерминированный `turn_key` по спецификации §4.1 (включая последнее сообщение).\"\"\"\n181\t    raw_cwd = (cwd or default_workspace or \"\").strip() or \".\"\n182\t    norm_cwd = os.path.normpath(raw_cwd)\n183\t    norm_model = (model or \"\").strip()\n184\t    norm_session = (session_id or \"\").strip()\n185\t    messages_canonical = json.dumps(\n186\t        list(messages) if messages is not None else [],\n187\t        sort_keys=True,\n188\t        separators=(\",\", \":\"),\n189\t        ensure_ascii=False,\n190\t    )\n191\t    messages_sha256 = hashlib.sha256(messages_canonical.encode(\"utf-8\")).hexdigest()\n192\t    outer = json.dumps(\n193\t        [norm_cwd, norm_model, norm_session, messages_sha256],\n194\t        separators=(\",\", \":\"),\n195\t        ensure_ascii=False,\n196\t    )\n197\t    return hashlib.sha256(outer.encode(\"utf-8\")).hexdigest()\n198\t\n199\t\n200\tclass TurnNotFoundError(KeyError):\n201\t    \"\"\"Запрошенный `turn_id` не найден в памяти и на диске (`HTTP 404`).\"\"\"\n202\t\n203\t\n204\tclass TurnForbiddenError(PermissionError):\n205\t    \"\"\"Попытка доступа к чужому ходу (`owner_token_hash` не совпадает, `HTTP 403`).\"\"\"\n206\t\n207\t\n208\tclass InvalidTurnIdError(ValueError):\n209\t    \"\"\"Некорректный формат `turn_id` (`HTTP 400`).\"\"\"\n210\t\n211\t\n212\tclass GapDetectedError(Exception):\n213\t    \"\"\"Запрошенный курсор `from_seq` вытеснен из кольцевого буфера 10 МиБ (`HTTP 410`).\"\"\"\n214\t\n215\t    def __init__(\n216\t        self,\n217\t        *,\n218\t        turn_id: str,\n219\t        requested_from_seq: int,\n220\t        oldest_available_seq: int,\n221\t        last_seq: int,\n222\t        snapshot_url: str = \"\",\n223\t        state_dump_path: str = \"\",\n224\t    ) -> None:\n225\t        super().__init__(\n226\t            f\"GAP_DETECTED turn_id={turn_id} requested_from_seq={requested_from_seq} \"\n227\t            f\"oldest_available_seq={oldest_available_seq} last_seq={last_seq}\"\n228\t        )\n229\t        self.turn_id = turn_id\n230\t        self.requested_from_seq = int(requested_from_seq)\n231\t        self.oldest_available_seq = int(oldest_available_seq)\n232\t        self.last_seq = int(last_seq)\n233\t        self.snapshot_url = snapshot_url or f\"/v1/turns/{turn_id}\"\n234\t        self.state_dump_path = (\n235\t            state_dump_path or f\"workspace/state/turns/{turn_id}.json\"\n236\t        )\n237\t\n238\t    def to_http_payload(self) -> dict[str, Any]:\n239\t        \"\"\"Формирует JSON-ответ для `HTTP 410 Gone` по контракту §3.1 (RW-006).\"\"\"\n240\t        return {\n241\t            \"error\": {\n242\t                \"message\": (\n243\t                    \"Requested sequence has been evicted from the 10 MiB ring buffer; \"\n244\t                    f\"fetch full state snapshot via GET /v1/turns/{self.turn_id}\"\n245\t                ),\n246\t                \"type\": \"stream_gap_error\",\n247\t                \"code\": \"GAP_DETECTED\",\n248\t                \"turn_id\": self.turn_id,\n249\t                \"requested_from_seq\": self.requested_from_seq,\n250\t                \"oldest_available_seq\": self.oldest_available_seq,\n251\t                \"last_seq\": self.last_seq,\n252\t                \"snapshot_url\": self.snapshot_url,\n253\t                \"state_dump_path\": self.state_dump_path,\n254\t            }\n255\t        }\n256\t\n257\t\n258\t@dataclass(frozen=True)\n259\tclass BufferedTurnEvent:\n260\t    \"\"\"Событие хода в кольцевом буфере `TurnBuffer` с монотонным `seq`.\"\"\"\n261\t\n262\t    seq: int\n263\t    ts: float\n264\t    kind: str\n265\t    payload: Any\n266\t    byte_len: int\n267\t\n268\t    def to_sse_frame(\n269\t        self,\n270\t        *,\n271\t        completion_id: str = \"\",\n272\t        created: int = 0,\n273\t        model: str = \"\",\n274\t    ) -> str:\n275\t        \"\"\"Форматирует событие в SSE-кадр с заголовком `id: <seq>`.\"\"\"\n276\t        cid = completion_id or f\"chatcmpl-turn-{self.seq}\"\n277\t        ts_created = created or int(self.ts)\n278\t        if self.kind in (\"content\", \"reasoning\"):\n279\t            field_name = \"content\" if self.kind == \"content\" else \"reasoning_content\"\n280\t            text_val = (\n281\t                self.payload\n282\t                if isinstance(self.payload, str)\n283\t                else str(self.payload or \"\")\n284\t            )\n285\t            data = json.dumps(\n286\t                {\n287\t                    \"id\": cid,\n288\t                    \"object\": \"chat.completion.chunk\",\n289\t                    \"created\": ts_created,\n290\t                    \"model\": model,\n291\t                    \"choices\": [\n292\t                        {\n293\t                            \"index\": 0,\n294\t                            \"delta\": {field_name: text_val},\n295\t                            \"finish_reason\": None,\n296\t                        }\n297\t                    ],\n298\t                },\n299\t                ensure_ascii=False,\n300\t            )\n301\t            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n302\t        if self.kind == \"tool_call\":\n303\t            call_dict = (\n304\t                self.payload\n305\t                if isinstance(self.payload, dict)\n306\t                else asdict(self.payload)\n307\t                if hasattr(self.payload, \"__dataclass_fields__\")\n308\t                else {\"function\": {\"name\": \"unknown\", \"arguments\": str(self.payload)}}\n309\t            )\n310\t            data = json.dumps(\n311\t                {\n312\t                    \"id\": cid,\n313\t                    \"object\": \"chat.completion.chunk\",\n314\t                    \"created\": ts_created,\n315\t                    \"model\": model,\n316\t                    \"choices\": [\n317\t                        {\n318\t                            \"index\": 0,\n319\t                            \"delta\": {\"tool_calls\": [call_dict]},\n320\t                            \"finish_reason\": None,\n321\t                        }\n322\t                    ],\n323\t                },\n324\t                ensure_ascii=False,\n325\t            )\n326\t            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n327\t        if self.kind == \"error\":\n328\t            err_obj = (\n329\t                self.payload\n330\t                if isinstance(self.payload, dict)\n331\t                else {\"message\": str(self.payload), \"type\": \"stream_error\"}\n332\t            )\n333\t            data = json.dumps(\n334\t                {\n335\t                    \"id\": cid,\n336\t                    \"object\": \"chat.completion.chunk\",\n337\t                    \"created\": ts_created,\n338\t                    \"model\": model,\n339\t                    \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n340\t                    \"error\": err_obj,\n341\t                },\n342\t                ensure_ascii=False,\n343\t            )\n344\t            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n345\t        if self.kind == \"done\":\n346\t            finish = \"stop\"\n347\t            usage_payload = None\n348\t            if isinstance(self.payload, dict):\n349\t                finish = str(self.payload.get(\"finish_reason\") or \"stop\")\n350\t                usage_payload = self.payload.get(\"usage\")\n351\t            chunk_obj: dict[str, Any] = {\n352\t                \"id\": cid,\n353\t                \"object\": \"chat.completion.chunk\",\n354\t                \"created\": ts_created,\n355\t                \"model\": model,\n356\t                \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": finish}],\n357\t            }\n358\t            if usage_payload:\n359\t                chunk_obj[\"usage\"] = usage_payload\n360\t            data = json.dumps(chunk_obj, ensure_ascii=False)\n361\t            return f\"id: {self.seq}\\ndata: {data}\\n\\ndata: [DONE]\\n\\n\"\n362\t        # Расширяемый passthrough для status и неизвестных будущих типов событий (FU-002).\n363\t        raw_data = json.dumps(\n364\t            self.payload\n365\t            if isinstance(self.payload, (dict, list, str, int, float, bool))\n366\t            or self.payload is None\n367\t            else str(self.payload),\n368\t            ensure_ascii=False,\n369\t        )\n370\t        return f\"event: {self.kind}\\nid: {self.seq}\\ndata: {raw_data}\\n\\n\"\n371\t\n372\t\n373\tclass StreamSubscriber:\n374\t    \"\"\"Подписчик живого SSE-потока с неблокирующей очередью доставки.\"\"\"\n375\t\n376\t    def __init__(self, subscriber_id: str | None = None, maxsize: int = 4096) -> None:\n377\t        self.subscriber_id = subscriber_id or uuid.uuid4().hex[:12]\n378\t        self.queue: queue.Queue[BufferedTurnEvent | None] = queue.Queue(maxsize=maxsize)\n379\t        self.closed = False\n380\t\n381\t    def publish(self, event: BufferedTurnEvent | None) -> bool:\n382\t        if self.closed:\n383\t            return False\n384\t        try:\n385\t            self.queue.put_nowait(event)\n386\t            return True\n387\t        except queue.Full:\n388\t            self.closed = True\n389\t            return False\n390\t\n391\t    def close(self) -> None:\n392\t        self.closed = True\n393\t        try:\n394\t            self.queue.put_nowait(None)\n395\t        except queue.Full:\n396\t            pass\n397\t\n398\t\n399\tclass TurnBuffer:\n400\t    \"\"\"Кольцевой буфер событий одного хода с лимитом `MAX_TURN_TEXT_BYTES` (10 МиБ).\"\"\"\n401\t\n402\t    def __init__(self, max_bytes: int = MAX_TURN_TEXT_BYTES) -> None:\n403\t        self.max_bytes = max(1, int(max_bytes))\n404\t        self._lock = threading.RLock()\n405\t        self._events: deque[BufferedTurnEvent] = deque()\n406\t        self.oldest_available_seq: int = 1\n407\t        self.last_seq: int = 0\n408\t        self.total_bytes: int = 0\n409\t        self.evicted_bytes: int = 0\n410\t        self.evicted_count: int = 0\n411\t        self.sealed: bool = False\n412\t\n413\t        self._reasoning_chunks: deque[str] = deque()\n414\t        self._reasoning_bytes: int = 0\n415\t        self._content_chunks: deque[str] = deque()\n416\t        self._content_bytes: int = 0\n417\t        self.tool_calls: list[dict[str, Any]] = []\n418\t        self.usage: dict[str, int] = {\n419\t            \"prompt_tokens\": 0,\n420\t            \"completion_tokens\": 0,\n421\t            \"total_tokens\": 0,\n422\t        }\n423\t        self.error: dict[str, Any] | None = None\n424\t        self._subscribers: dict[str, StreamSubscriber] = {}\n425\t\n426\t    @staticmethod\n427\t    def _estimate_bytes(kind: str, payload: Any) -> int:\n428\t        if isinstance(payload, str):\n429\t            return max(1, len(payload.encode(\"utf-8\", errors=\"replace\")))\n430\t        try:\n431\t            encoded = json.dumps(payload, ensure_ascii=False).encode(\n432\t                \"utf-8\", errors=\"replace\"\n433\t            )\n434\t            return max(1, len(encoded))\n435\t        except Exception:  # noqa: BLE001\n436\t            return max(1, len(str(payload).encode(\"utf-8\", errors=\"replace\")))\n437\t\n438\t    def _append_bounded_text(\n439\t        self, chunks: deque[str], current_bytes: int, piece: str\n440\t    ) -> int:\n441\t        if not piece:\n442\t            return current_bytes\n443\t        piece_bytes = len(piece.encode(\"utf-8\", errors=\"replace\"))\n444\t        if piece_bytes > self.max_bytes:\n445\t            piece = piece.encode(\"utf-8\", errors=\"replace\")[-self.max_bytes :].decode(\n446\t                \"utf-8\", errors=\"ignore\"\n447\t            )\n448\t            piece_bytes = len(piece.encode(\"utf-8\", errors=\"replace\"))\n449\t        chunks.append(piece)\n450\t        current_bytes += piece_bytes\n451\t        while current_bytes > self.max_bytes and len(chunks) > 1:\n452\t            removed = chunks.popleft()\n453\t            current_bytes -= len(removed.encode(\"utf-8\", errors=\"replace\"))\n454\t        return max(0, current_bytes)\n455\t\n456\t    def append(self, kind: str, payload: Any) -> BufferedTurnEvent:\n457\t        \"\"\"Добавляет событие в буфер, вытесняя старые записи при превышении `max_bytes`.\"\"\"\n458\t        with self._lock:\n459\t            if self.sealed:\n460\t                raise RuntimeError(\"TurnBuffer is already sealed\")\n461\t            self.last_seq += 1\n462\t            seq = self.last_seq\n463\t            byte_len = self._estimate_bytes(kind, payload)\n464\t            event = BufferedTurnEvent(\n465\t                seq=seq,\n466\t                ts=time.time(),\n467\t                kind=str(kind),\n468\t                payload=payload,\n469\t                byte_len=byte_len,\n470\t            )\n471\t            self._events.append(event)\n472\t            self.total_bytes += byte_len\n473\t\n474\t            if kind == \"reasoning\" and isinstance(payload, str):\n475\t                self._reasoning_bytes = self._append_bounded_text(\n476\t                    self._reasoning_chunks, self._reasoning_bytes, payload\n477\t                )\n478\t            elif kind == \"content\" and isinstance(payload, str):\n479\t                self._content_bytes = self._append_bounded_text(\n480\t                    self._content_chunks, self._content_bytes, payload\n481\t                )\n482\t            elif kind == \"tool_call\":\n483\t                call_dict = (\n484\t                    dict(payload)\n485\t                    if isinstance(payload, dict)\n486\t                    else asdict(payload)\n487\t                    if hasattr(payload, \"__dataclass_fields__\")\n488\t                    else {\"function\": {\"name\": \"unknown\", \"arguments\": str(payload)}}\n489\t                )\n490\t                self.tool_calls.append(call_dict)\n491\t            elif kind == \"error\":\n492\t                self.error = (\n493\t                    dict(payload)\n494\t                    if isinstance(payload, dict)\n495\t                    else {\"message\": str(payload), \"type\": \"stream_error\"}\n496\t                )\n497\t            elif kind == \"done\" and isinstance(payload, dict):\n498\t                raw_usage = payload.get(\"usage\")\n499\t                if isinstance(raw_usage, dict):\n500\t                    self.set_usage(raw_usage)\n501\t\n502\t            # Вытеснение старых событий при превышении кольцевого лимита (RW-006).\n503\t            while self.total_bytes > self.max_bytes and self._events:\n504\t                evicted = self._events.popleft()\n505\t                self.total_bytes = max(0, self.total_bytes - evicted.byte_len)\n506\t                self.evicted_bytes += evicted.byte_len\n507\t                self.evicted_count += 1\n508\t\n509\t            if self._events:\n510\t                self.oldest_available_seq = self._events[0].seq\n511\t            else:\n512\t                self.oldest_available_seq = self.last_seq + 1\n513\t\n514\t            subscribers = list(self._subscribers.values())\n515\t\n516\t        for sub in subscribers:\n517\t            sub.publish(event)\n518\t        return event\n519\t\n520\t    def set_usage(self, usage: Usage | dict[str, Any]) -> None:\n521\t        \"\"\"Обновляет счётчики токенов хода.\"\"\"\n522\t        with self._lock:\n523\t            if isinstance(usage, Usage):\n524\t                in_tok = int(usage.input_tokens or 0)\n525\t                out_tok = int(usage.output_tokens or 0)\n526\t                cache_tok = usage.cache_read_tokens\n527\t            elif isinstance(usage, dict):\n528\t                in_tok = int(\n529\t                    usage.get(\"prompt_tokens\")\n530\t                    or usage.get(\"input_tokens\")\n531\t                    or 0\n532\t                )\n533\t                out_tok = int(\n534\t                    usage.get(\"completion_tokens\")\n535\t                    or usage.get(\"output_tokens\")\n536\t                    or 0\n537\t                )\n538\t                cache_tok = usage.get(\"cache_read_tokens\")\n539\t            else:\n540\t                return\n541\t            self.usage = {\n542\t                \"prompt_tokens\": in_tok,\n543\t                \"completion_tokens\": out_tok,\n544\t                \"total_tokens\": in_tok + out_tok,\n545\t            }\n546\t            if cache_tok is not None:\n547\t                self.usage[\"cache_read_tokens\"] = int(cache_tok)\n548\t\n549\t    def get_reasoning_text(self) -> str:\n550\t        with self._lock:\n551\t            return \"\".join(self._reasoning_chunks)\n552\t\n553\t    def get_content_text(self) -> str:\n554\t        with self._lock:\n555\t            return \"\".join(self._content_chunks)\n556\t\n557\t    def seal(self) -> None:\n558\t        \"\"\"Запечатывает буфер при переходе хода в терминальное состояние.\"\"\"\n559\t        with self._lock:\n560\t            if self.sealed:\n561\t                return\n562\t            self.sealed = True\n563\t            subscribers = list(self._subscribers.values())\n564\t            self._subscribers.clear()\n565\t        for sub in subscribers:\n566\t            sub.close()\n567\t\n568\t    def clear_ring_memory(self) -> int:\n569\t        \"\"\"Освобождает кольцевой список событий в памяти после сброса снапшота на диск.\"\"\"\n570\t        with self._lock:\n571\t            freed = self.total_bytes\n572\t            self._events.clear()\n573\t            self.total_bytes = 0\n574\t            return freed\n575\t\n576\t    def check_gap(\n577\t        self,\n578\t        from_seq: int,\n579\t        *,\n580\t        turn_id: str = \"\",\n581\t        state_dump_path: str = \"\",\n582\t    ) -> None:\n583\t        \"\"\"Проверяет, не вытеснено ли событие `from_seq + 1` из кольцевого буфера.\"\"\"\n584\t        with self._lock:\n585\t            req_seq = max(0, int(from_seq))\n586\t            if self.oldest_available_seq > 1 and req_seq < self.oldest_available_seq - 1:\n587\t                raise GapDetectedError(\n588\t                    turn_id=turn_id,\n589\t                    requested_from_seq=req_seq,\n590\t                    oldest_available_seq=self.oldest_available_seq,\n591\t                    last_seq=self.last_seq,\n592\t                    snapshot_url=f\"/v1/turns/{turn_id}\",\n593\t                    state_dump_path=state_dump_path\n594\t                    or f\"workspace/state/turns/{turn_id}.json\",\n595\t                )\n596\t\n597\t    def events_since(\n598\t        self,\n599\t        from_seq: int = 0,\n600\t        *,\n601\t        turn_id: str = \"\",\n602\t        state_dump_path: str = \"\",\n603\t    ) -> list[BufferedTurnEvent]:\n604\t        \"\"\"Возвращает события с `seq > from_seq` или выбрасывает `GapDetectedError` (410).\"\"\"\n605\t        with self._lock:\n606\t            self.check_gap(\n607\t                from_seq, turn_id=turn_id, state_dump_path=state_dump_path\n608\t            )\n609\t            req_seq = max(0, int(from_seq))\n610\t            return [ev for ev in self._events if ev.seq > req_seq]\n611\t\n612\t    get_since = events_since\n613\t\n614\t    def subscribe(\n615\t        self,\n616\t        from_seq: int = 0,\n617\t        *,\n618\t        turn_id: str = \"\",\n619\t        state_dump_path: str = \"\",\n620\t    ) -> tuple[list[BufferedTurnEvent], StreamSubscriber | None]:\n621\t        \"\"\"Атомарно проверяет gap, возвращает backlog `seq > from_seq` и регистрирует подписчика.\"\"\"\n622\t        with self._lock:\n623\t            self.check_gap(\n624\t                from_seq, turn_id=turn_id, state_dump_path=state_dump_path\n625\t            )\n626\t            req_seq = max(0, int(from_seq))\n627\t            backlog = [ev for ev in self._events if ev.seq > req_seq]\n628\t            if self.sealed:\n629\t                return backlog, None\n630\t            sub = StreamSubscriber()\n631\t            self._subscribers[sub.subscriber_id] = sub\n632\t            return backlog, sub\n633\t\n634\t    def unsubscribe(self, subscriber: StreamSubscriber | None) -> None:\n635\t        if subscriber is None:\n636\t            return\n637\t        subscriber.close()\n638\t        with self._lock:\n639\t            self._subscribers.pop(subscriber.subscriber_id, None)\n640\t\n641\t    def active_subscriber_count(self) -> int:\n642\t        with self._lock:\n643\t            return len(self._subscribers)\n644\t\n645\t\n646\t@dataclass\n647\tclass ManagedTurn:\n648\t    \"\"\"Дескриптор управляемого хода в `TurnSessionManager`.\"\"\"\n649\t\n650\t    turn_id: str\n651\t    turn_key: str\n652\t    rid: str\n653\t    model: str\n654\t    backend: str\n655\t    cwd: str\n656\t    owner_token_hash: str\n657\t    stream: bool = True\n658\t    emulate_tools: bool = False\n659\t    status: str = STATE_QUEUED\n660\t    created_at: float = field(default_factory=time.time)\n661\t    updated_at: float = field(default_factory=time.time)\n662\t    started_monotonic: float = field(default_factory=time.monotonic)\n663\t    pgid: int | None = None\n664\t    command_name: str = \"\"\n665\t    buffer: TurnBuffer = field(default_factory=TurnBuffer)\n666\t    timeout_controller: AdaptiveTimeoutController | None = None\n667\t    cancel_event: threading.Event = field(default_factory=threading.Event)\n668\t    done_event: threading.Event = field(default_factory=threading.Event)\n669\t    result: TurnResult | None = None\n670\t    final_dict: dict[str, Any] | None = None\n671\t    state_dump_path: str = \"\"\n672\t    _slot_release_fn: Callable[[], None] | None = None\n673\t    _slot_released: bool = False\n674\t    _cancel_callbacks: list[Callable[[], None]] = field(default_factory=list)\n675\t    _lock: threading.RLock = field(default_factory=threading.RLock)\n676\t\n677\t    @property\n678\t    def is_terminal(self) -> bool:\n679\t        with self._lock:\n680\t            return self.status in TERMINAL_TURN_STATES\n681\t\n682\t    @property\n683\t    def is_active(self) -> bool:\n684\t        with self._lock:\n685\t            return self.status in ACTIVE_TURN_STATES\n686\t\n687\t    def add_cancel_callback(self, cb: Callable[[], None]) -> None:\n688\t        with self._lock:\n689\t            self._cancel_callbacks.append(cb)\n690\t\n691\t    def mark_detached(self) -> None:\n692\t        \"\"\"Переводит ход в состояние `RUNNING_DETACHED` при разрыве клиентского сокета.\"\"\"\n693\t        with self._lock:\n694\t            if self.status == STATE_RUNNING_ATTACHED:\n695\t                self.status = STATE_RUNNING_DETACHED\n696\t                self.updated_at = time.time()\n697\t\n698\t    def touch_activity(self, kind: str = \"protocol\") -> None:\n699\t        \"\"\"Обновляет метку активности хода и сбрасывает таймер простоя.\"\"\"\n700\t        if kind == \"detached\":\n701\t            self.mark_detached()\n702\t            return\n703\t        with self._lock:\n704\t            self.updated_at = time.time()\n705\t            ctrl = self.timeout_controller\n706\t        if ctrl is not None:\n707\t            ctrl.record_activity(kind or \"protocol\")\n708\t\n709\t    def bind_process(\n710\t        self,\n711\t        *,\n712\t        pgid: int | None = None,\n713\t        terminate_fn: Callable[[], None] | None = None,\n714\t    ) -> None:\n715\t        \"\"\"Привязывает PGID или callback прерывания к активному ходу.\"\"\"\n716\t        with self._lock:\n717\t            if isinstance(pgid, int) and pgid > 0:\n718\t                self.pgid = pgid\n719\t                if self.timeout_controller is not None:\n720\t                    self.timeout_controller.register_pgid(pgid)\n721\t            if terminate_fn is not None and terminate_fn not in self._cancel_callbacks:\n722\t                self._cancel_callbacks.append(terminate_fn)\n723\t\n724\t    def release_slot_once(self) -> bool:\n725\t        \"\"\"Идемпотентно освобождает семафор конкурентности ровно один раз.\"\"\"\n726\t        with self._lock:\n727\t            if self._slot_released:\n728\t                return False\n729\t            self._slot_released = True\n730\t            fn = self._slot_release_fn\n731\t            self._slot_release_fn = None\n732\t        if fn is not None:\n733\t            try:\n734\t                fn()\n735\t            except Exception:  # noqa: BLE001\n736\t                pass\n737\t            return True\n738\t        return False\n739\t\n740\t    def to_snapshot_dict(self, *, scrub_secrets: bool = True) -> dict[str, Any]:\n741\t        \"\"\"Формирует словарь состояния версии `1.0` для `GET /v1/turns/<turn_id>` и диска.\"\"\"\n742\t        with self._lock:\n743\t            reasoning = self.buffer.get_reasoning_text()\n744\t            content = self.buffer.get_content_text()\n745\t            if not content and self.result is not None and self.result.text:\n746\t                content = self.result.text\n747\t            if not reasoning and self.result is not None and self.result.reasoning:\n748\t                reasoning = self.result.reasoning\n749\t            if scrub_secrets:\n750\t                reasoning = mask_secrets(reasoning)\n751\t                content = mask_secrets(content)\n752\t            err_obj = self.buffer.error\n753\t            if err_obj is not None and scrub_secrets:\n754\t                err_obj = {\n755\t                    k: mask_secrets(v) if isinstance(v, str) else v\n756\t                    for k, v in err_obj.items()\n757\t                }\n758\t            tool_calls = list(self.buffer.tool_calls)\n759\t            if not tool_calls and self.result is not None and self.result.tool_calls:\n760\t                tool_calls = [asdict(tc) for tc in self.result.tool_calls]\n761\t            return {\n762\t                \"schema_version\": SNAPSHOT_SCHEMA_VERSION,\n763\t                \"turn_id\": self.turn_id,\n764\t                \"turn_key\": self.turn_key,\n765\t                \"rid\": self.rid,\n766\t                \"model\": self.model,\n767\t                \"backend\": self.backend,\n768\t                \"status\": self.status.lower(),\n769\t                \"state\": self.status,\n770\t                \"created_at\": self.created_at,\n771\t                \"updated_at\": self.updated_at,\n772\t                \"oldest_available_seq\": self.buffer.oldest_available_seq,\n773\t                \"last_seq\": self.buffer.last_seq,\n774\t                \"reasoning_content\": reasoning,\n775\t                \"content\": content,\n776\t                \"tool_calls\": tool_calls,\n777\t                \"usage\": dict(self.buffer.usage),\n778\t                \"error\": err_obj,\n779\t                \"owner_token_hash\": self.owner_token_hash,\n780\t            }\n781\t\n782\t\n783\tdef _atomic_write_json_0600(path: Path, payload: Any) -> None:\n784\t    \"\"\"Атомарно записывает JSON-файл с правами `0600` в каталог с правами `0700`.\"\"\"\n785\t    parent = path.parent\n786\t    parent.mkdir(parents=True, exist_ok=True)\n787\t    try:\n788\t        parent.chmod(0o700)\n789\t    except OSError:\n790\t        pass\n791\t    raw = (json.dumps(payload, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n792\t    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=str(parent))\n793\t    tmp_path = Path(tmp_name)\n794\t    try:\n795\t        try:\n796\t            os.fchmod(fd, 0o600)\n797\t        except (AttributeError, OSError):\n798\t            pass\n799\t        with os.fdopen(fd, \"wb\") as fh:\n800\t            fh.write(raw)\n801\t            fh.flush()\n802\t            os.fsync(fh.fileno())\n803\t        os.chmod(tmp_path, 0o600)\n804\t        os.replace(tmp_path, path)\n805\t        os.chmod(path, 0o600)\n806\t    except BaseException:\n807\t        try:\n808\t            tmp_path.unlink(missing_ok=True)\n809\t        except OSError:\n810\t            pass\n811\t        raise\n812\t\n813\t\n814\tclass TurnSessionManager:\n815\t    \"\"\"Реестр и оркестратор отвязанных ходов (`ManagedTurn`) для всех адаптеров хаба.\"\"\"\n816\t\n817\t    def __init__(\n818\t        self,\n819\t        workspace: Path | str | Callable[[], Path] | None = None,\n820\t        *,\n821\t        state_root: Path | str | Callable[[], Path] | None = None,\n822\t        max_concurrent: int | None = None,\n823\t        max_turn_bytes: int = MAX_TURN_TEXT_BYTES,\n824\t        max_buffered_turns: int = MAX_BUFFERED_TURNS,\n825\t        max_total_buffer_bytes: int = MAX_TURN_BUFFER_TOTAL_BYTES,\n826\t        turn_retention_s: float = TURN_RETENTION_S,\n827\t        idle_timeout_s: float = IDLE_TIMEOUT_S,\n828\t        safety_cap_s: float = SAFETY_CAP_S,\n829\t        finish_reserve_s: float = FINISH_RESERVE_S,\n830\t        watchdog_interval_s: float = WATCHDOG_INTERVAL_S,\n831\t        cancel_grace_s: float = CANCEL_SIGTERM_GRACE_S,\n832\t        detached_enabled_fn: Callable[[], bool] | None = None,\n833\t        watchdog_enabled_fn: Callable[[], bool] | None = None,\n834\t        finalize_fn: Callable[[TurnResult, bool], TurnResult] | None = None,\n835\t        log_fn: Callable[[str], None] | None = None,\n836\t        clock: Callable[[], float] = time.monotonic,\n837\t        persist_children_file: bool = True,\n838\t    ) -> None:\n839\t        ws_source = workspace if workspace is not None else (state_root or \".\")\n840\t        self._workspace_fn: Callable[[], Path] = (\n841\t            (lambda: Path(ws_source))\n842\t            if isinstance(ws_source, (str, Path))\n843\t            else ws_source\n844\t        )\n845\t        self._state_root_fn: Callable[[], Path] | None = (\n846\t            None\n847\t            if state_root is None\n848\t            else (\n849\t                (lambda: Path(state_root))\n850\t                if isinstance(state_root, (str, Path))\n851\t                else state_root\n852\t            )\n853\t        )\n854\t        self.max_concurrent = int(max_concurrent or 32)\n855\t        self.max_turn_bytes = int(max_turn_bytes)\n856\t        self.max_buffered_turns = int(max_buffered_turns)\n857\t        self.max_total_buffer_bytes = int(max_total_buffer_bytes)\n858\t        self.turn_retention_s = float(turn_retention_s)\n859\t        self.idle_timeout_s = float(idle_timeout_s)\n860\t        self.safety_cap_s = float(safety_cap_s)\n861\t        self.finish_reserve_s = float(finish_reserve_s)\n862\t        self.watchdog_interval_s = float(watchdog_interval_s)\n863\t        self.cancel_grace_s = float(cancel_grace_s)\n864\t        self.persist_children_file = bool(persist_children_file)\n865\t        self._detached_enabled_fn = detached_enabled_fn or _is_detached_enabled\n866\t        self._watchdog_enabled_fn = watchdog_enabled_fn or _is_watchdog_enabled\n867\t        self._finalize_fn = finalize_fn\n868\t\n869\t        self._log_fn = log_fn\n870\t        self._clock = clock\n871\t\n872\t        self._lock = threading.RLock()\n873\t        self._cond = threading.Condition(self._lock)\n874\t        self._turns_by_id: dict[str, ManagedTurn] = {}\n875\t        self._active_by_key: dict[str, str] = {}\n876\t        self._children: dict[int, dict[str, Any]] = {}\n877\t\n878\t    @property\n879\t    def workspace(self) -> Path:\n880\t        return Path(self._workspace_fn())\n881\t\n882\t    @property\n883\t    def state_dir(self) -> Path:\n884\t        if self._state_root_fn is not None:\n885\t            sr = Path(self._state_root_fn())\n886\t            return sr.parent if sr.name == \"turns\" else sr\n887\t        ws = self.workspace\n888\t        if ws.name == \"state\":\n889\t            return ws\n890\t        if ws.name == \"turns\":\n891\t            return ws.parent\n892\t        return ws / \"state\"\n893\t\n894\t    @property\n895\t    def turns_dir(self) -> Path:\n896\t        if self._state_root_fn is not None:\n897\t            sr = Path(self._state_root_fn())\n898\t            return sr if sr.name == \"turns\" else sr / \"turns\"\n899\t        ws = self.workspace\n900\t        if ws.name == \"turns\":\n901\t            return ws\n902\t        return self.state_dir / \"turns\"\n903\t\n904\t    @property\n905\t    def children_path(self) -> Path:\n906\t        return self.state_dir / \"children.json\"\n907\t\n908\t    def is_detached_enabled(self) -> bool:\n909\t        return bool(self._detached_enabled_fn())\n910\t\n911\t    def is_watchdog_enabled(self) -> bool:\n912\t        return bool(self._watchdog_enabled_fn())\n913\t\n914\t    def _log(self, message: str) -> None:\n915\t        if self._log_fn is not None:\n916\t            try:\n917\t                self._log_fn(message)\n918\t            except Exception:  # noqa: BLE001\n919\t                pass\n920\t\n921\t    def ensure_state_dirs(self) -> None:\n922\t        \"\"\"Создаёт каталоги `workspace/state` и `workspace/state/turns` с правами `0700`.\"\"\"\n923\t        for directory in (self.state_dir, self.turns_dir):\n924\t            directory.mkdir(parents=True, exist_ok=True)\n925\t            try:\n926\t                directory.chmod(0o700)\n927\t            except OSError:\n928\t                pass\n929\t\n930\t    def register_child_pgid(\n931\t        self,\n932\t        turn_id_or_pgid: str | int,\n933\t        pgid: int | None = None,\n934\t        *,\n935\t        pid: int | None = None,\n936\t        rid: str = \"\",\n937\t        command: str = \"muse\",\n938\t        backend: str = \"\",\n939\t        turn_id: str = \"\",\n940\t    ) -> None:\n941\t        \"\"\"Регистрирует `pgid` дочернего процесса в `ManagedTurn` и `children.json`.\"\"\"\n942\t        if isinstance(turn_id_or_pgid, int):\n943\t            actual_pgid = turn_id_or_pgid\n944\t            actual_turn_id = turn_id\n945\t        else:\n946\t            actual_turn_id = str(turn_id_or_pgid)\n947\t            actual_pgid = int(pgid or 0)\n948\t        cmd_name = backend or command or \"muse\"\n949\t        if not isinstance(actual_pgid, int) or actual_pgid <= 0:\n950\t            return\n951\t        with self._lock:\n952\t            turn = self._turns_by_id.get(actual_turn_id) if actual_turn_id else None\n953\t            if turn is not None:\n954\t                turn.pgid = actual_pgid\n955\t                turn.command_name = cmd_name\n956\t                if turn.timeout_controller is not None:\n957\t                    turn.timeout_controller.register_pgid(actual_pgid)\n958\t            self._children[actual_pgid] = {\n959\t                \"pid\": int(pid or actual_pgid),\n960\t                \"pgid\": int(actual_pgid),\n961\t                \"turn_id\": actual_turn_id,\n962\t                \"rid\": rid or (turn.rid if turn else \"\"),\n963\t                \"started_at\": time.time(),\n964\t                \"command\": cmd_name,\n965\t            }\n966\t            if self.persist_children_file:\n967\t                self._persist_children_locked()\n968\t\n969\t    def unregister_child_pgid(self, pgid: int | None) -> None:\n970\t        \"\"\"Удаляет `pgid` из реестра `children.json` после подтверждённой гибели группы.\"\"\"\n971\t        if not isinstance(pgid, int) or pgid <= 0:\n972\t            return\n973\t        with self._lock:\n974\t            if pgid in self._children:\n975\t                self._children.pop(pgid, None)\n976\t                if self.persist_children_file:\n977\t                    self._persist_children_locked()\n978\t\n979\t    def _persist_children_locked(self) -> None:\n980\t        try:\n981\t            self.ensure_state_dirs()\n982\t            payload = {\n983\t                \"schema_version\": SNAPSHOT_SCHEMA_VERSION,\n984\t                \"children\": list(self._children.values()),\n985\t            }\n986\t            _atomic_write_json_0600(self.children_path, payload)\n987\t        except OSError:\n988\t            pass\n989\t\n990\t    def persist_turn_snapshot(self, turn: ManagedTurn) -> Path | None:\n991\t        \"\"\"Сохраняет снапшот хода в `workspace/state/turns/<turn_id>.json` с правами `0600`.\"\"\"\n992\t        try:\n993\t            self.ensure_state_dirs()\n994\t            path = self.turns_dir / f\"{turn.turn_id}.json\"\n995\t            snapshot = turn.to_snapshot_dict(scrub_secrets=True)\n996\t            _atomic_write_json_0600(path, snapshot)\n997\t            turn.state_dump_path = str(path)\n998\t            return path\n999\t        except OSError as exc:\n1000\t            self._log(\n1001\t                f\"turn_snapshot_write_failed turn_id={turn.turn_id} err={exc.__class__.__name__}\"\n1002\t            )\n1003\t            return None\n1004\t\n1005\t    def _enforce_memory_caps_locked(self) -> None:\n1006\t        \"\"\"Вытесняет старые терминальные ходы из RAM на диск при превышении лимитов.\"\"\"\n1007\t        now = time.time()\n1008\t        expired_ids = [\n1009\t            tid\n1010\t            for tid, t in self._turns_by_id.items()\n1011\t            if t.is_terminal and (now - t.updated_at) >= self.turn_retention_s\n1012\t        ]\n1013\t        for tid in expired_ids:\n1014\t            turn = self._turns_by_id.pop(tid, None)\n1015\t            if turn is not None:\n1016\t                self.persist_turn_snapshot(turn)\n1017\t                turn.buffer.clear_ring_memory()\n1018\t\n1019\t        terminal_turns = sorted(\n1020\t            (t for t in self._turns_by_id.values() if t.is_terminal),\n1021\t            key=lambda item: item.updated_at,\n1022\t        )\n1023\t        while len(self._turns_by_id) > self.max_buffered_turns and terminal_turns:\n1024\t            oldest = terminal_turns.pop(0)\n1025\t            self.persist_turn_snapshot(oldest)\n1026\t            oldest.buffer.clear_ring_memory()\n1027\t            self._turns_by_id.pop(oldest.turn_id, None)\n1028\t\n1029\t        total_ram = sum(t.buffer.total_bytes for t in self._turns_by_id.values())\n1030\t        if total_ram > self.max_total_buffer_bytes:\n1031\t            for oldest in terminal_turns:\n1032\t                if total_ram <= self.max_total_buffer_bytes:\n1033\t                    break\n1034\t                if oldest.buffer.total_bytes > 0:\n1035\t                    self.persist_turn_snapshot(oldest)\n1036\t                    total_ram -= oldest.buffer.clear_ring_memory()\n1037\t\n1038\t    def sweep_expired_snapshots(self) -> int:\n1039\t        \"\"\"Удаляет снапшоты на диске старше `TURN_RETENTION_S`.\"\"\"\n1040\t        removed = 0\n1041\t        cutoff = time.time() - self.turn_retention_s\n1042\t        try:\n1043\t            if not self.turns_dir.exists():\n1044\t                return 0\n1045\t            for path in self.turns_dir.glob(\"*.json\"):\n1046\t                try:\n1047\t                    if path.stat().st_mtime < cutoff:\n1048\t                        path.unlink(missing_ok=True)\n1049\t                        removed += 1\n1050\t                except OSError:\n1051\t                    pass\n1052\t        except OSError:\n1053\t            pass\n1054\t        return removed\n1055\t\n1056\t    def active_turns(self) -> list[ManagedTurn]:\n1057\t        \"\"\"Возвращает список всех нетерминальных ходов.\"\"\"\n1058\t        with self._lock:\n1059\t            return [t for t in self._turns_by_id.values() if t.is_active]\n1060\t\n1061\t    def active_count(self) -> int:\n1062\t        \"\"\"Количество активных (нетерминальных) ходов в менеджере.\"\"\"\n1063\t        with self._lock:\n1064\t            return sum(1 for t in self._turns_by_id.values() if t.is_active)\n1065\t\n1066\t    def find_active_by_key(\n1067\t        self, turn_key: str, owner_token_hash: str | None = None\n1068\t    ) -> ManagedTurn | None:\n1069\t        \"\"\"Находит активный ход по `turn_key` (терминальные ходы игнорируются, RW-003).\"\"\"\n1070\t        with self._lock:\n1071\t            tid = self._active_by_key.get(turn_key)\n1072\t            if not tid:\n1073\t                return None\n1074\t            turn = self._turns_by_id.get(tid)\n1075\t            if turn is None or not turn.is_active:\n1076\t                self._active_by_key.pop(turn_key, None)\n1077\t                return None\n1078\t            if (\n1079\t                owner_token_hash is not None\n1080\t                and turn.owner_token_hash\n1081\t                and turn.owner_token_hash != owner_token_hash\n1082\t            ):\n1083\t                return None\n1084\t            return turn\n1085\t\n1086\t    def get_turn(\n1087\t        self,\n1088\t        turn_id: str,\n1089\t        *,\n1090\t        owner_token_hash: str | None = None,\n1091\t    ) -> ManagedTurn:\n1092\t        \"\"\"Возвращает `ManagedTurn` по `turn_id` с проверкой формата и владельца.\"\"\"\n1093\t        if not validate_turn_id(turn_id):\n1094\t            raise InvalidTurnIdError(f\"Invalid turn_id: {turn_id!r}\")\n1095\t        with self._lock:\n1096\t            turn = self._turns_by_id.get(turn_id)\n1097\t        if turn is None:\n1098\t            raise TurnNotFoundError(turn_id)\n1099\t        if (\n1100\t            owner_token_hash is not None\n1101\t            and turn.owner_token_hash\n1102\t            and turn.owner_token_hash != owner_token_hash\n1103\t        ):\n1104\t            raise TurnForbiddenError(turn_id)\n1105\t        return turn\n1106\t\n1107\t    def get_turn_snapshot(\n1108\t        self,\n1109\t        turn_id: str,\n1110\t        *,\n1111\t        owner_token_hash: str | None = None,\n1112\t    ) -> dict[str, Any]:\n1113\t        \"\"\"Возвращает снапшот хода из памяти или с диска (`workspace/state/turns/<id>.json`).\"\"\"\n1114\t        if not validate_turn_id(turn_id):\n1115\t            raise InvalidTurnIdError(f\"Invalid turn_id: {turn_id!r}\")\n1116\t        with self._lock:\n1117\t            turn = self._turns_by_id.get(turn_id)\n1118\t        if turn is not None:\n1119\t            if (\n1120\t                owner_token_hash is not None\n1121\t                and turn.owner_token_hash\n1122\t                and turn.owner_token_hash != owner_token_hash\n1123\t            ):\n1124\t                raise TurnForbiddenError(turn_id)\n1125\t            return turn.to_snapshot_dict(scrub_secrets=True)\n1126\t\n1127\t        disk_path = self.turns_dir / f\"{turn_id}.json\"\n1128\t        if not disk_path.is_file():\n1129\t            raise TurnNotFoundError(turn_id)\n1130\t        try:\n1131\t            data = json.loads(disk_path.read_text(encoding=\"utf-8\"))\n1132\t        except (OSError, json.JSONDecodeError) as exc:\n1133\t            raise TurnNotFoundError(turn_id) from exc\n1134\t        saved_owner = data.get(\"owner_token_hash\")\n1135\t        if (\n1136\t            owner_token_hash is not None\n1137\t            and saved_owner\n1138\t            and saved_owner != owner_token_hash\n1139\t        ):\n1140\t            raise TurnForbiddenError(turn_id)\n1141\t        return data\n1142\t\n1143\t    def create_or_attach_turn(\n1144\t        self,\n1145\t        *,\n1146\t        model: str,\n1147\t        backend: str,\n1148\t        cwd: str,\n1149\t        messages: list[dict[str, Any]] | tuple[Any, ...],\n1150\t        session_id: str | None = None,\n1151\t        owner_token_hash: str = \"\",\n1152\t        rid: str = \"\",\n1153\t        requested_turn_id: str | None = None,\n1154\t        resume_turn_id: str | None = None,\n1155\t        stream: bool = True,\n1156\t        emulate_tools: bool = False,\n1157\t        idle_timeout_s: float | None = None,\n1158\t        safety_cap_s: float | None = None,\n1159\t        slot_release_fn: Callable[[], None] | None = None,\n1160\t    ) -> tuple[ManagedTurn, bool]:\n1161\t        \"\"\"Создаёт новый `ManagedTurn` или подключается к уже идущему активному ходу.\n1162\t\n1163\t        Возвращает `(turn, is_existing_active)`.\n1164\t        Терминальные ходы с тем же `turn_key` никогда не переиспользуются без явного\n1165\t        `resume_turn_id`, чтобы кнопка Regenerate всегда создавала новый ход (RW-003).\n1166\t        \"\"\"\n1167\t        if resume_turn_id is not None and resume_turn_id != \"\":\n1168\t            if not validate_turn_id(resume_turn_id):\n1169\t                raise InvalidTurnIdError(f\"Invalid X-Turn-Resume-Id: {resume_turn_id!r}\")\n1170\t            existing = self.get_turn(\n1171\t                resume_turn_id, owner_token_hash=owner_token_hash or None\n1172\t            )\n1173\t            with self._lock:\n1174\t                if existing.status == STATE_RUNNING_DETACHED:\n1175\t                    existing.status = STATE_RUNNING_ATTACHED\n1176\t                    existing.updated_at = time.time()\n1177\t            return existing, True\n1178\t\n1179\t        if requested_turn_id is not None and requested_turn_id != \"\":\n1180\t            if not validate_turn_id(requested_turn_id):\n1181\t                raise InvalidTurnIdError(f\"Invalid X-Turn-Id: {requested_turn_id!r}\")\n1182\t\n1183\t        turn_key = compute_turn_key(\n1184\t            cwd=cwd,\n1185\t            model=model,\n1186\t            session_id=session_id,\n1187\t            messages=messages,\n1188\t            default_workspace=str(self.workspace),\n1189\t        )\n1190\t\n1191\t        with self._lock:\n1192\t            if requested_turn_id and requested_turn_id in self._turns_by_id:\n1193\t                existing_by_id = self._turns_by_id[requested_turn_id]\n1194\t                if (\n1195\t                    owner_token_hash\n1196\t                    and existing_by_id.owner_token_hash\n1197\t                    and existing_by_id.owner_token_hash != owner_token_hash\n1198\t                ):\n1199\t                    raise TurnForbiddenError(requested_turn_id)\n1200\t                if existing_by_id.is_active:\n1201\t                    if existing_by_id.status == STATE_RUNNING_DETACHED:\n1202\t                        existing_by_id.status = STATE_RUNNING_ATTACHED\n1203\t                        existing_by_id.updated_at = time.time()\n1204\t                    return existing_by_id, True\n1205\t\n1206\t            active_tid = self._active_by_key.get(turn_key)\n1207\t            if active_tid:\n1208\t                active_turn = self._turns_by_id.get(active_tid)\n1209\t                if active_turn is not None and active_turn.is_active:\n1210\t                    if (\n1211\t                        active_turn.status == STATE_RUNNING_DETACHED\n1212\t                        and (\n1213\t                            not owner_token_hash\n1214\t                            or not active_turn.owner_token_hash\n1215\t                            or active_turn.owner_token_hash == owner_token_hash\n1216\t                        )\n1217\t                    ):\n1218\t                        active_turn.status = STATE_RUNNING_ATTACHED\n1219\t                        active_turn.updated_at = time.time()\n1220\t                        self._log(\n1221\t                            f\"turn_reattached rid={rid or active_turn.rid} \"\n1222\t                            f\"turn_id={active_turn.turn_id} turn_key={turn_key[:12]}\"\n1223\t                        )\n1224\t                        return active_turn, True\n1225\t                else:\n1226\t                    self._active_by_key.pop(turn_key, None)\n1227\t\n1228\t            turn_id = (\n1229\t                requested_turn_id\n1230\t                if (\n1231\t                    requested_turn_id\n1232\t                    and requested_turn_id not in self._turns_by_id\n1233\t                )\n1234\t                else f\"turn_{uuid.uuid4().hex[:16]}\"\n1235\t            )\n1236\t            eff_rid = rid or f\"r-{uuid.uuid4().hex[:8]}\"\n1237\t            eff_idle = (\n1238\t                float(idle_timeout_s)\n1239\t                if idle_timeout_s is not None\n1240\t                else self.idle_timeout_s\n1241\t            )\n1242\t            eff_cap = (\n1243\t                float(safety_cap_s)\n1244\t                if safety_cap_s is not None\n1245\t                else self.safety_cap_s\n1246\t            )\n1247\t            controller = AdaptiveTimeoutController(\n1248\t                idle_timeout_s=eff_idle,\n1249\t                safety_cap_s=eff_cap,\n1250\t                finish_reserve_s=self.finish_reserve_s,\n1251\t                watchdog_enabled=self.is_watchdog_enabled(),\n1252\t                clock=self._clock,\n1253\t                rid=eff_rid,\n1254\t                turn_id=turn_id,\n1255\t                log_fn=self._log_fn,\n1256\t            )\n1257\t            dump_path = str(self.turns_dir / f\"{turn_id}.json\")\n1258\t            turn = ManagedTurn(\n1259\t                turn_id=turn_id,\n1260\t                turn_key=turn_key,\n1261\t                rid=eff_rid,\n1262\t                model=model,\n1263\t                backend=backend,\n1264\t                cwd=cwd,\n1265\t                owner_token_hash=owner_token_hash,\n1266\t                stream=stream,\n1267\t                emulate_tools=emulate_tools,\n1268\t                status=STATE_RUNNING_ATTACHED,\n1269\t                buffer=TurnBuffer(max_bytes=self.max_turn_bytes),\n1270\t                timeout_controller=controller,\n1271\t                state_dump_path=dump_path,\n1272\t                _slot_release_fn=slot_release_fn,\n1273\t            )\n1274\t            self._turns_by_id[turn_id] = turn\n1275\t            self._active_by_key[turn_key] = turn_id\n1276\t            self._enforce_memory_caps_locked()\n1277\t            return turn, False\n1278\t\n1279\t    def finalize_abandoned_turn(self, turn: ManagedTurn | None) -> None:\n1280\t        \"\"\"Гарантирует освобождение ресурсов хода при выходе потока-исполнителя до финализации.\"\"\"\n1281\t        if turn is None:\n1282\t            return\n1283\t        turn.release_slot_once()\n1284\t        with self._lock:\n1285\t            if turn.is_terminal:\n1286\t                return\n1287\t            turn.status = STATE_CANCELLED\n1288\t            turn.updated_at = time.time()\n1289\t            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n1290\t                self._active_by_key.pop(turn.turn_key, None)\n1291\t            if not turn.buffer.sealed:\n1292\t                turn.buffer.seal()\n1293\t            if turn.timeout_controller is not None:\n1294\t                turn.timeout_controller.close()\n1295\t            turn.done_event.set()\n1296\t            self._cond.notify_all()\n1297\t\n1298\t    def mark_detached(self, turn_id: str) -> None:\n1299\t        \"\"\"Переводит активный ход в `RUNNING_DETACHED` при разрыве HTTP-соединения.\"\"\"\n1300\t        with self._lock:\n1301\t            turn = self._turns_by_id.get(turn_id)\n1302\t            if turn is not None and turn.status == STATE_RUNNING_ATTACHED:\n1303\t                turn.status = STATE_RUNNING_DETACHED\n1304\t                turn.updated_at = time.time()\n1305\t                self._log(\n1306\t                    f\"turn_detached rid={turn.rid} turn_id={turn.turn_id} \"\n1307\t                    f\"last_seq={turn.buffer.last_seq}\"\n1308\t                )\n1309\t\n1310\t    def _terminate_pgid(self, pgid: int | None, grace_s: float) -> None:\n1311\t        if not isinstance(pgid, int) or pgid <= 0:\n1312\t            return\n1313\t        try:\n1314\t            os.killpg(pgid, signal.SIGTERM)\n1315\t        except (ProcessLookupError, PermissionError, OSError):\n1316\t            self.unregister_child_pgid(pgid)\n1317\t            return\n1318\t        deadline = time.monotonic() + max(0.05, grace_s)\n1319\t        while time.monotonic() < deadline:\n1320\t            if not ProcessWatchdog.is_group_alive(pgid):\n1321\t                self.unregister_child_pgid(pgid)\n1322\t                return\n1323\t            time.sleep(0.05)\n1324\t        try:\n1325\t            os.killpg(pgid, signal.SIGKILL)\n1326\t        except (ProcessLookupError, PermissionError, OSError):\n1327\t            pass\n1328\t        self.unregister_child_pgid(pgid)\n1329\t\n1330\t    def cancel_turn(\n1331\t        self,\n1332\t        turn_id: str,\n1333\t        *,\n1334\t        owner_token_hash: str | None = None,\n1335\t        reason: str = \"client_cancelled\",\n1336\t    ) -> ManagedTurn:\n1337\t        \"\"\"Явно отменяет ход (`SIGTERM -> 2s -> SIGKILL`), немедленно освобождая слот (RW-001).\"\"\"\n1338\t        turn = self.get_turn(turn_id, owner_token_hash=owner_token_hash)\n1339\t        with self._lock:\n1340\t            if turn.status == STATE_CANCELLED:\n1341\t                return turn\n1342\t            if turn.is_terminal:\n1343\t                return turn\n1344\t            turn.status = STATE_CANCELLED\n1345\t            turn.updated_at = time.time()\n1346\t            turn.cancel_event.set()\n1347\t            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n1348\t                self._active_by_key.pop(turn.turn_key, None)\n1349\t            pgid = turn.pgid\n1350\t            callbacks = list(turn._cancel_callbacks)\n1351\t\n1352\t        # Немедленно возвращаем слот MAX_CONCURRENT до ожидания завершения потомка.\n1353\t        turn.release_slot_once()\n1354\t\n1355\t        for cb in callbacks:\n1356\t            try:\n1357\t                cb()\n1358\t            except Exception:  # noqa: BLE001\n1359\t                pass\n1360\t\n1361\t        if pgid is not None:\n1362\t            self._terminate_pgid(pgid, self.cancel_grace_s)\n1363\t\n1364\t        with self._lock:\n1365\t            if not turn.buffer.sealed:\n1366\t                turn.buffer.append(\n1367\t                    \"error\",\n1368\t                    {\n1369\t                        \"message\": f\"Turn cancelled ({reason})\",\n1370\t                        \"type\": \"cancelled\",\n1371\t                        \"code\": \"turn_cancelled\",\n1372\t                    },\n1373\t                )\n1374\t                turn.buffer.seal()\n1375\t            if turn.timeout_controller is not None:\n1376\t                turn.timeout_controller.close()\n1377\t            turn.done_event.set()\n1378\t            self.persist_turn_snapshot(turn)\n1379\t            self._cond.notify_all()\n1380\t        self._log(f\"turn_cancelled rid={turn.rid} turn_id={turn.turn_id} reason={reason}\")\n1381\t        return turn\n1382\t\n1383\t    def interrupt_for_drain(\n1384\t        self, turn: ManagedTurn, message: str = \"bridge restart drain timeout exceeded\"\n1385\t    ) -> None:\n1386\t        \"\"\"Завершает ход при истечении `DRAIN_TIMEOUT_S` со сбросом reasoning и error-чанком.\"\"\"\n1387\t        with self._lock:\n1388\t            if turn.is_terminal:\n1389\t                return\n1390\t            turn.status = STATE_INTERRUPTED_DRAIN\n1391\t            turn.updated_at = time.time()\n1392\t            turn.cancel_event.set()\n1393\t            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n1394\t                self._active_by_key.pop(turn.turn_key, None)\n1395\t            pgid = turn.pgid\n1396\t            callbacks = list(turn._cancel_callbacks)\n1397\t\n1398\t        turn.release_slot_once()\n1399\t        for cb in callbacks:\n1400\t            try:\n1401\t                cb()\n1402\t            except Exception:  # noqa: BLE001\n1403\t                pass\n1404\t        if pgid is not None:\n1405\t            self._terminate_pgid(pgid, self.cancel_grace_s)\n1406\t\n1407\t        with self._lock:\n1408\t            if not turn.buffer.sealed:\n1409\t                turn.buffer.append(\n1410\t                    \"error\",\n1411\t                    {\n1412\t                        \"message\": message,\n1413\t                        \"type\": \"overloaded\",\n1414\t                        \"code\": \"drain_timeout\",\n1415\t                    },\n1416\t                )\n1417\t                turn.buffer.seal()\n1418\t            if turn.timeout_controller is not None:\n1419\t                turn.timeout_controller.close()\n1420\t            turn.done_event.set()\n1421\t            self.persist_turn_snapshot(turn)\n1422\t            self._cond.notify_all()\n1423\t\n1424\t    def complete_turn_from_result(\n1425\t        self,\n1426\t        turn: ManagedTurn,\n1427\t        raw_result: TurnResult,\n1428\t        *,\n1429\t        backend_kind: str = \"\",\n1430\t    ) -> dict[str, Any]:\n1431\t        \"\"\"Финализирует `ManagedTurn` по `TurnResult` от `BackendAdapter.execute_turn`.\"\"\"\n1432\t        final_res = (\n1433\t            self._finalize_fn(raw_result, turn.emulate_tools)\n1434\t            if self._finalize_fn is not None\n1435\t            else raw_result\n1436\t        )\n1437\t        turn.release_slot_once()\n1438\t\n1439\t        with self._lock:\n1440\t            if turn.status in (STATE_CANCELLED, STATE_INTERRUPTED_DRAIN):\n1441\t                if turn.final_dict is not None:\n1442\t                    return turn.final_dict\n1443\t                return {\n1444\t                    \"state\": \"client_gone\",\n1445\t                    \"rc\": 1,\n1446\t                    \"text\": turn.buffer.get_content_text(),\n1447\t                    \"err\": \"cancelled\",\n1448\t                    \"usage\": dict(turn.buffer.usage),\n1449\t                    \"result\": {},\n1450\t                    \"tool_calls\": list(turn.buffer.tool_calls),\n1451\t                    \"events\": [],\n1452\t                    \"backend_kind\": backend_kind or turn.backend,\n1453\t                    \"turn_id\": turn.turn_id,\n1454\t                }\n1455\t\n1456\t            turn.result = final_res\n1457\t            turn.buffer.set_usage(final_res.usage)\n1458\t\n1459\t            # Если адаптер не стримил события живьём, докладываем их в TurnBuffer.\n1460\t            had_content = bool(turn.buffer.get_content_text())\n1461\t            had_reasoning = bool(turn.buffer.get_reasoning_text())\n1462\t            had_tool_calls = bool(turn.buffer.tool_calls)\n1463\t            if not turn.buffer.sealed:\n1464\t                for ev in final_res.events or ():\n1465\t                    if ev.kind == \"reasoning\" and isinstance(ev.value, str):\n1466\t                        if not had_reasoning:\n1467\t                            turn.buffer.append(\"reasoning\", ev.value)\n1468\t                    elif ev.kind == \"content\" and isinstance(ev.value, str):\n1469\t                        if not had_content:\n1470\t                            turn.buffer.append(\"content\", ev.value)\n1471\t                    elif ev.kind == \"tool_call\" and not had_tool_calls:\n1472\t                        call_val = (\n1473\t                            asdict(ev.value)\n1474\t                            if isinstance(ev.value, ToolCall)\n1475\t                            else ev.value\n1476\t                        )\n1477\t                        turn.buffer.append(\"tool_call\", call_val)\n1478\t                if not final_res.events:\n1479\t                    if final_res.reasoning and not had_reasoning:\n1480\t                        turn.buffer.append(\"reasoning\", final_res.reasoning)\n1481\t                    if final_res.text and not had_content:\n1482\t                        turn.buffer.append(\"content\", final_res.text)\n1483\t                    if not had_tool_calls:\n1484\t                        for tc in final_res.tool_calls or ():\n1485\t                            turn.buffer.append(\"tool_call\", asdict(tc))\n1486\t\n1487\t            res_state = str(final_res.state or \"done\")\n1488\t            term_reason = ("}]},"parent_tool_use_id":null,"session_id":"3fb1b2b6-87c5-4d4e-9965-c0b3fa5aef1f","uuid":"1b8f2650-b218-4c80-b589-1ab6817d5b91","timestamp":"2026-10-17T20:01:03.449Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/core/turn_session_manager.py","content":"\"\"\"Менеджер отвязанных сессий хода и кольцевой буфер событий (ADR-0005 / AD-001).\n\nМодуль отделяет жизненный цикл выполнения хода (`ManagedTurn`) от жизненного цикла\nклиентского HTTP/SSE-соединения:\n- При разрыве клиентского сокета ход переходит из `RUNNING_ATTACHED` в `RUNNING_DETACHED`\n  и продолжает чтение вывода дочернего CLI в фоновом потоке до терминального состояния.\n- Детерминированный `turn_key` дедуплицирует только активные (нетерминальные) ходы;\n  повторный запрос с тем же промптом после терминального состояния запускает новый ход\n  с новым `turn_id` (поддержка Regenerate, RW-003).\n- Кольцевой буфер `TurnBuffer` ограничен `MAX_TURN_TEXT_BYTES = 10 МиБ` на ход и\n  `MAX_TURN_BUFFER_TOTAL_BYTES = 128 МиБ` / `MAX_BUFFERED_TURNS = 128` глобально.\n- При вытеснении событий из кольцевого буфера запрос дочитки с устаревшим курсором\n  (`from_seq < oldest_available_seq - 1`) порождает `GapDetectedError` для ответа\n  `HTTP 410 Gone` (`code=\"GAP_DETECTED\"`, RW-006).\n- Модуль не импортирует `core.tool_emulation`, `http.server` или `adapters.*` (FU-003).\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom collections.abc import Callable, Iterator\nfrom dataclasses import asdict, dataclass, field\nimport hashlib\nimport hmac\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport re\nimport signal\nimport tempfile\nimport threading\nimport time\nfrom typing import Any\nimport uuid\n\nfrom core.backend_adapter import ToolCall, TurnResult, Usage\nfrom core.watchdog import (\n    FINISH_RESERVE_S,\n    IDLE_TIMEOUT_S,\n    SAFETY_CAP_S,\n    WATCHDOG_INTERVAL_S,\n    AdaptiveTimeoutController,\n    ProcessWatchdog,\n)\n\nSNAPSHOT_SCHEMA_VERSION = \"1.0\"\nTURN_ID_RE = re.compile(r\"^[a-zA-Z0-9_-]{1,64}$\")\n\nKNOWN_EVENT_KINDS = frozenset(\n    {\"reasoning\", \"content\", \"tool_call\", \"error\", \"done\", \"status\"}\n)\n\nMAX_TURN_TEXT_BYTES: int = 10 * 1024 * 1024\nMAX_BUFFERED_TURNS: int = 128\nMAX_TURN_BUFFER_TOTAL_BYTES: int = 128 * 1024 * 1024\nTURN_RETENTION_S: float = 3600.0\nCANCEL_SIGTERM_GRACE_S: float = 2.0\n\nSTATE_QUEUED = \"QUEUED\"\nSTATE_RUNNING_ATTACHED = \"RUNNING_ATTACHED\"\nSTATE_RUNNING_DETACHED = \"RUNNING_DETACHED\"\nSTATE_COMPLETED = \"COMPLETED\"\nSTATE_CANCELLED = \"CANCELLED\"\nSTATE_FAILED_BACKEND = \"FAILED_BACKEND\"\nSTATE_TIMED_OUT_IDLE = \"TIMED_OUT_IDLE\"\nSTATE_TIMED_OUT_CAP = \"TIMED_OUT_CAP\"\nSTATE_INTERRUPTED_DRAIN = \"INTERRUPTED_DRAIN\"\n\nACTIVE_TURN_STATES = frozenset(\n    {STATE_QUEUED, STATE_RUNNING_ATTACHED, STATE_RUNNING_DETACHED}\n)\nTERMINAL_TURN_STATES = frozenset(\n    {\n        STATE_COMPLETED,\n        STATE_CANCELLED,\n        STATE_FAILED_BACKEND,\n        STATE_TIMED_OUT_IDLE,\n        STATE_TIMED_OUT_CAP,\n        STATE_INTERRUPTED_DRAIN,\n    }\n)\n\n_SECRET_PATTERNS = (\n    re.compile(r\"(?i)(Bearer\\s+)[A-Za-z0-9._~+/=-]{8,}\"),\n    re.compile(\n        r\"(?i)((?:DROID_DSH_BRIDGE_KEY|FACTORY_API_KEY|META_API_KEY|API_KEY|TOKEN|SECRET)\\s*[=:]\\s*)([^\\s\\\"',;]+)\"\n    ),\n    re.compile(r\"\\b(?:fk|sk)-[A-Za-z0-9_-]{10,}\\b\"),\n)\n\n\ndef validate_turn_id(turn_id: Any) -> bool:\n    \"\"\"Проверяет идентификатор хода по строгому шаблону `^[a-zA-Z0-9_-]{1,64}$`.\"\"\"\n    return isinstance(turn_id, str) and bool(TURN_ID_RE.fullmatch(turn_id))\n\n\ndef hash_owner_token(token_or_peer: str | None) -> str:\n    \"\"\"Вычисляет SHA-256 хеш токена владельца или локального пира для изоляции хода.\"\"\"\n    raw = (token_or_peer or \"anonymous\").strip()\n    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n\n\nhash_token = hash_owner_token\n\n\ndef _is_detached_enabled() -> bool:\n    \"\"\"Проверяет флаг включения фонового доведения ходов (`BRIDGE_DETACHED_TURNS_ENABLED` / `DSH_BRIDGE_DETACHED_ENABLED`).\"\"\"\n    val = os.environ.get(\n        \"BRIDGE_DETACHED_TURNS_ENABLED\",\n        os.environ.get(\n            \"BRIDGE_ENABLE_DETACHED_TURNS\",\n            os.environ.get(\"DSH_BRIDGE_DETACHED_ENABLED\", \"true\"),\n        ),\n    )\n    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n\n\ndef _is_watchdog_enabled() -> bool:\n    \"\"\"Проверяет флаг включения адаптивного watchdog (`BRIDGE_ADAPTIVE_WATCHDOG_ENABLED` / `DSH_BRIDGE_WATCHDOG_ENABLED`).\"\"\"\n    val = os.environ.get(\n        \"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\",\n        os.environ.get(\n            \"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\",\n            os.environ.get(\"DSH_BRIDGE_WATCHDOG_ENABLED\", \"true\"),\n        ),\n    )\n    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n\n\ndef _is_drain_enabled() -> bool:\n    \"\"\"Проверяет флаг включения неблокирующего drain (`BRIDGE_DRAIN_ON_SHUTDOWN` / `DSH_BRIDGE_DRAIN_ENABLED`).\"\"\"\n    val = os.environ.get(\n        \"BRIDGE_DRAIN_ON_SHUTDOWN\",\n        os.environ.get(\n            \"BRIDGE_ENABLE_GRACEFUL_DRAIN\",\n            os.environ.get(\"DSH_BRIDGE_DRAIN_ENABLED\", \"true\"),\n        ),\n    )\n    return str(val).strip().lower() not in (\"0\", \"false\", \"no\", \"off\")\n\n\n\ndef verify_bearer_token(provided: str | None, expected: str | None) -> bool:\n    \"\"\"Константная по времени сверка Bearer-токена (`hmac.compare_digest`).\"\"\"\n    if not expected:\n        return True\n    if not provided or not isinstance(provided, str):\n        return False\n    return hmac.compare_digest(provided.encode(\"utf-8\"), expected.encode(\"utf-8\"))\n\n\ndef mask_secrets(text: str, extra_secrets: tuple[str, ...] = ()) -> str:\n    \"\"\"Маскирует секреты и ключи авторизации перед записью снапшота на диск.\"\"\"\n    if not text:\n        return \"\"\n    masked = text\n    for pat in _SECRET_PATTERNS:\n        if pat.groups >= 2:\n            masked = pat.sub(r\"\\1[REDACTED]\", masked)\n        else:\n            masked = pat.sub(\"[REDACTED]\", masked)\n    for env_key in (\"DROID_DSH_BRIDGE_KEY\", \"FACTORY_API_KEY\", \"META_API_KEY\"):\n        env_val = os.environ.get(env_key)\n        if env_val and len(env_val) >= 6 and env_val in masked:\n            masked = masked.replace(env_val, \"[REDACTED]\")\n    for sec in extra_secrets:\n        if sec and len(sec) >= 6 and sec in masked:\n            masked = masked.replace(sec, \"[REDACTED]\")\n    return masked\n\n\ndef compute_turn_key(\n    cwd: str | None,\n    model: str,\n    session_id: str | None,\n    messages: list[dict[str, Any]] | tuple[Any, ...],\n    default_workspace: str = \"\",\n) -> str:\n    \"\"\"Детерминированный `turn_key` по спецификации §4.1 (включая последнее сообщение).\"\"\"\n    raw_cwd = (cwd or default_workspace or \"\").strip() or \".\"\n    norm_cwd = os.path.normpath(raw_cwd)\n    norm_model = (model or \"\").strip()\n    norm_session = (session_id or \"\").strip()\n    messages_canonical = json.dumps(\n        list(messages) if messages is not None else [],\n        sort_keys=True,\n        separators=(\",\", \":\"),\n        ensure_ascii=False,\n    )\n    messages_sha256 = hashlib.sha256(messages_canonical.encode(\"utf-8\")).hexdigest()\n    outer = json.dumps(\n        [norm_cwd, norm_model, norm_session, messages_sha256],\n        separators=(\",\", \":\"),\n        ensure_ascii=False,\n    )\n    return hashlib.sha256(outer.encode(\"utf-8\")).hexdigest()\n\n\nclass TurnNotFoundError(KeyError):\n    \"\"\"Запрошенный `turn_id` не найден в памяти и на диске (`HTTP 404`).\"\"\"\n\n\nclass TurnForbiddenError(PermissionError):\n    \"\"\"Попытка доступа к чужому ходу (`owner_token_hash` не совпадает, `HTTP 403`).\"\"\"\n\n\nclass InvalidTurnIdError(ValueError):\n    \"\"\"Некорректный формат `turn_id` (`HTTP 400`).\"\"\"\n\n\nclass GapDetectedError(Exception):\n    \"\"\"Запрошенный курсор `from_seq` вытеснен из кольцевого буфера 10 МиБ (`HTTP 410`).\"\"\"\n\n    def __init__(\n        self,\n        *,\n        turn_id: str,\n        requested_from_seq: int,\n        oldest_available_seq: int,\n        last_seq: int,\n        snapshot_url: str = \"\",\n        state_dump_path: str = \"\",\n    ) -> None:\n        super().__init__(\n            f\"GAP_DETECTED turn_id={turn_id} requested_from_seq={requested_from_seq} \"\n            f\"oldest_available_seq={oldest_available_seq} last_seq={last_seq}\"\n        )\n        self.turn_id = turn_id\n        self.requested_from_seq = int(requested_from_seq)\n        self.oldest_available_seq = int(oldest_available_seq)\n        self.last_seq = int(last_seq)\n        self.snapshot_url = snapshot_url or f\"/v1/turns/{turn_id}\"\n        self.state_dump_path = (\n            state_dump_path or f\"workspace/state/turns/{turn_id}.json\"\n        )\n\n    def to_http_payload(self) -> dict[str, Any]:\n        \"\"\"Формирует JSON-ответ для `HTTP 410 Gone` по контракту §3.1 (RW-006).\"\"\"\n        return {\n            \"error\": {\n                \"message\": (\n                    \"Requested sequence has been evicted from the 10 MiB ring buffer; \"\n                    f\"fetch full state snapshot via GET /v1/turns/{self.turn_id}\"\n                ),\n                \"type\": \"stream_gap_error\",\n                \"code\": \"GAP_DETECTED\",\n                \"turn_id\": self.turn_id,\n                \"requested_from_seq\": self.requested_from_seq,\n                \"oldest_available_seq\": self.oldest_available_seq,\n                \"last_seq\": self.last_seq,\n                \"snapshot_url\": self.snapshot_url,\n                \"state_dump_path\": self.state_dump_path,\n            }\n        }\n\n\n@dataclass(frozen=True)\nclass BufferedTurnEvent:\n    \"\"\"Событие хода в кольцевом буфере `TurnBuffer` с монотонным `seq`.\"\"\"\n\n    seq: int\n    ts: float\n    kind: str\n    payload: Any\n    byte_len: int\n\n    def to_sse_frame(\n        self,\n        *,\n        completion_id: str = \"\",\n        created: int = 0,\n        model: str = \"\",\n    ) -> str:\n        \"\"\"Форматирует событие в SSE-кадр с заголовком `id: <seq>`.\"\"\"\n        cid = completion_id or f\"chatcmpl-turn-{self.seq}\"\n        ts_created = created or int(self.ts)\n        if self.kind in (\"content\", \"reasoning\"):\n            field_name = \"content\" if self.kind == \"content\" else \"reasoning_content\"\n            text_val = (\n                self.payload\n                if isinstance(self.payload, str)\n                else str(self.payload or \"\")\n            )\n            data = json.dumps(\n                {\n                    \"id\": cid,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": ts_created,\n                    \"model\": model,\n                    \"choices\": [\n                        {\n                            \"index\": 0,\n                            \"delta\": {field_name: text_val},\n                            \"finish_reason\": None,\n                        }\n                    ],\n                },\n                ensure_ascii=False,\n            )\n            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n        if self.kind == \"tool_call\":\n            call_dict = (\n                self.payload\n                if isinstance(self.payload, dict)\n                else asdict(self.payload)\n                if hasattr(self.payload, \"__dataclass_fields__\")\n                else {\"function\": {\"name\": \"unknown\", \"arguments\": str(self.payload)}}\n            )\n            data = json.dumps(\n                {\n                    \"id\": cid,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": ts_created,\n                    \"model\": model,\n                    \"choices\": [\n                        {\n                            \"index\": 0,\n                            \"delta\": {\"tool_calls\": [call_dict]},\n                            \"finish_reason\": None,\n                        }\n                    ],\n                },\n                ensure_ascii=False,\n            )\n            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n        if self.kind == \"error\":\n            err_obj = (\n                self.payload\n                if isinstance(self.payload, dict)\n                else {\"message\": str(self.payload), \"type\": \"stream_error\"}\n            )\n            data = json.dumps(\n                {\n                    \"id\": cid,\n                    \"object\": \"chat.completion.chunk\",\n                    \"created\": ts_created,\n                    \"model\": model,\n                    \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n                    \"error\": err_obj,\n                },\n                ensure_ascii=False,\n            )\n            return f\"id: {self.seq}\\ndata: {data}\\n\\n\"\n        if self.kind == \"done\":\n            finish = \"stop\"\n            usage_payload = None\n            if isinstance(self.payload, dict):\n                finish = str(self.payload.get(\"finish_reason\") or \"stop\")\n                usage_payload = self.payload.get(\"usage\")\n            chunk_obj: dict[str, Any] = {\n                \"id\": cid,\n                \"object\": \"chat.completion.chunk\",\n                \"created\": ts_created,\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": finish}],\n            }\n            if usage_payload:\n                chunk_obj[\"usage\"] = usage_payload\n            data = json.dumps(chunk_obj, ensure_ascii=False)\n            return f\"id: {self.seq}\\ndata: {data}\\n\\ndata: [DONE]\\n\\n\"\n        # Расширяемый passthrough для status и неизвестных будущих типов событий (FU-002).\n        raw_data = json.dumps(\n            self.payload\n            if isinstance(self.payload, (dict, list, str, int, float, bool))\n            or self.payload is None\n            else str(self.payload),\n            ensure_ascii=False,\n        )\n        return f\"event: {self.kind}\\nid: {self.seq}\\ndata: {raw_data}\\n\\n\"\n\n\nclass StreamSubscriber:\n    \"\"\"Подписчик живого SSE-потока с неблокирующей очередью доставки.\"\"\"\n\n    def __init__(self, subscriber_id: str | None = None, maxsize: int = 4096) -> None:\n        self.subscriber_id = subscriber_id or uuid.uuid4().hex[:12]\n        self.queue: queue.Queue[BufferedTurnEvent | None] = queue.Queue(maxsize=maxsize)\n        self.closed = False\n\n    def publish(self, event: BufferedTurnEvent | None) -> bool:\n        if self.closed:\n            return False\n        try:\n            self.queue.put_nowait(event)\n            return True\n        except queue.Full:\n            self.closed = True\n            return False\n\n    def close(self) -> None:\n        self.closed = True\n        try:\n            self.queue.put_nowait(None)\n        except queue.Full:\n            pass\n\n\nclass TurnBuffer:\n    \"\"\"Кольцевой буфер событий одного хода с лимитом `MAX_TURN_TEXT_BYTES` (10 МиБ).\"\"\"\n\n    def __init__(self, max_bytes: int = MAX_TURN_TEXT_BYTES) -> None:\n        self.max_bytes = max(1, int(max_bytes))\n        self._lock = threading.RLock()\n        self._events: deque[BufferedTurnEvent] = deque()\n        self.oldest_available_seq: int = 1\n        self.last_seq: int = 0\n        self.total_bytes: int = 0\n        self.evicted_bytes: int = 0\n        self.evicted_count: int = 0\n        self.sealed: bool = False\n\n        self._reasoning_chunks: deque[str] = deque()\n        self._reasoning_bytes: int = 0\n        self._content_chunks: deque[str] = deque()\n        self._content_bytes: int = 0\n        self.tool_calls: list[dict[str, Any]] = []\n        self.usage: dict[str, int] = {\n            \"prompt_tokens\": 0,\n            \"completion_tokens\": 0,\n            \"total_tokens\": 0,\n        }\n        self.error: dict[str, Any] | None = None\n        self._subscribers: dict[str, StreamSubscriber] = {}\n\n    @staticmethod\n    def _estimate_bytes(kind: str, payload: Any) -> int:\n        if isinstance(payload, str):\n            return max(1, len(payload.encode(\"utf-8\", errors=\"replace\")))\n        try:\n            encoded = json.dumps(payload, ensure_ascii=False).encode(\n                \"utf-8\", errors=\"replace\"\n            )\n            return max(1, len(encoded))\n        except Exception:  # noqa: BLE001\n            return max(1, len(str(payload).encode(\"utf-8\", errors=\"replace\")))\n\n    def _append_bounded_text(\n        self, chunks: deque[str], current_bytes: int, piece: str\n    ) -> int:\n        if not piece:\n            return current_bytes\n        piece_bytes = len(piece.encode(\"utf-8\", errors=\"replace\"))\n        if piece_bytes > self.max_bytes:\n            piece = piece.encode(\"utf-8\", errors=\"replace\")[-self.max_bytes :].decode(\n                \"utf-8\", errors=\"ignore\"\n            )\n            piece_bytes = len(piece.encode(\"utf-8\", errors=\"replace\"))\n        chunks.append(piece)\n        current_bytes += piece_bytes\n        while current_bytes > self.max_bytes and len(chunks) > 1:\n            removed = chunks.popleft()\n            current_bytes -= len(removed.encode(\"utf-8\", errors=\"replace\"))\n        return max(0, current_bytes)\n\n    def append(self, kind: str, payload: Any) -> BufferedTurnEvent:\n        \"\"\"Добавляет событие в буфер, вытесняя старые записи при превышении `max_bytes`.\"\"\"\n        with self._lock:\n            if self.sealed:\n                raise RuntimeError(\"TurnBuffer is already sealed\")\n            self.last_seq += 1\n            seq = self.last_seq\n            byte_len = self._estimate_bytes(kind, payload)\n            event = BufferedTurnEvent(\n                seq=seq,\n                ts=time.time(),\n                kind=str(kind),\n                payload=payload,\n                byte_len=byte_len,\n            )\n            self._events.append(event)\n            self.total_bytes += byte_len\n\n            if kind == \"reasoning\" and isinstance(payload, str):\n                self._reasoning_bytes = self._append_bounded_text(\n                    self._reasoning_chunks, self._reasoning_bytes, payload\n                )\n            elif kind == \"content\" and isinstance(payload, str):\n                self._content_bytes = self._append_bounded_text(\n                    self._content_chunks, self._content_bytes, payload\n                )\n            elif kind == \"tool_call\":\n                call_dict = (\n                    dict(payload)\n                    if isinstance(payload, dict)\n                    else asdict(payload)\n                    if hasattr(payload, \"__dataclass_fields__\")\n                    else {\"function\": {\"name\": \"unknown\", \"arguments\": str(payload)}}\n                )\n                self.tool_calls.append(call_dict)\n            elif kind == \"error\":\n                self.error = (\n                    dict(payload)\n                    if isinstance(payload, dict)\n                    else {\"message\": str(payload), \"type\": \"stream_error\"}\n                )\n            elif kind == \"done\" and isinstance(payload, dict):\n                raw_usage = payload.get(\"usage\")\n                if isinstance(raw_usage, dict):\n                    self.set_usage(raw_usage)\n\n            # Вытеснение старых событий при превышении кольцевого лимита (RW-006).\n            while self.total_bytes > self.max_bytes and self._events:\n                evicted = self._events.popleft()\n                self.total_bytes = max(0, self.total_bytes - evicted.byte_len)\n                self.evicted_bytes += evicted.byte_len\n                self.evicted_count += 1\n\n            if self._events:\n                self.oldest_available_seq = self._events[0].seq\n            else:\n                self.oldest_available_seq = self.last_seq + 1\n\n            subscribers = list(self._subscribers.values())\n\n        for sub in subscribers:\n            sub.publish(event)\n        return event\n\n    def set_usage(self, usage: Usage | dict[str, Any]) -> None:\n        \"\"\"Обновляет счётчики токенов хода.\"\"\"\n        with self._lock:\n            if isinstance(usage, Usage):\n                in_tok = int(usage.input_tokens or 0)\n                out_tok = int(usage.output_tokens or 0)\n                cache_tok = usage.cache_read_tokens\n            elif isinstance(usage, dict):\n                in_tok = int(\n                    usage.get(\"prompt_tokens\")\n                    or usage.get(\"input_tokens\")\n                    or 0\n                )\n                out_tok = int(\n                    usage.get(\"completion_tokens\")\n                    or usage.get(\"output_tokens\")\n                    or 0\n                )\n                cache_tok = usage.get(\"cache_read_tokens\")\n            else:\n                return\n            self.usage = {\n                \"prompt_tokens\": in_tok,\n                \"completion_tokens\": out_tok,\n                \"total_tokens\": in_tok + out_tok,\n            }\n            if cache_tok is not None:\n                self.usage[\"cache_read_tokens\"] = int(cache_tok)\n\n    def get_reasoning_text(self) -> str:\n        with self._lock:\n            return \"\".join(self._reasoning_chunks)\n\n    def get_content_text(self) -> str:\n        with self._lock:\n            return \"\".join(self._content_chunks)\n\n    def seal(self) -> None:\n        \"\"\"Запечатывает буфер при переходе хода в терминальное состояние.\"\"\"\n        with self._lock:\n            if self.sealed:\n                return\n            self.sealed = True\n            subscribers = list(self._subscribers.values())\n            self._subscribers.clear()\n        for sub in subscribers:\n            sub.close()\n\n    def clear_ring_memory(self) -> int:\n        \"\"\"Освобождает кольцевой список событий в памяти после сброса снапшота на диск.\"\"\"\n        with self._lock:\n            freed = self.total_bytes\n            self._events.clear()\n            self.total_bytes = 0\n            return freed\n\n    def check_gap(\n        self,\n        from_seq: int,\n        *,\n        turn_id: str = \"\",\n        state_dump_path: str = \"\",\n    ) -> None:\n        \"\"\"Проверяет, не вытеснено ли событие `from_seq + 1` из кольцевого буфера.\"\"\"\n        with self._lock:\n            req_seq = max(0, int(from_seq))\n            if self.oldest_available_seq > 1 and req_seq < self.oldest_available_seq - 1:\n                raise GapDetectedError(\n                    turn_id=turn_id,\n                    requested_from_seq=req_seq,\n                    oldest_available_seq=self.oldest_available_seq,\n                    last_seq=self.last_seq,\n                    snapshot_url=f\"/v1/turns/{turn_id}\",\n                    state_dump_path=state_dump_path\n                    or f\"workspace/state/turns/{turn_id}.json\",\n                )\n\n    def events_since(\n        self,\n        from_seq: int = 0,\n        *,\n        turn_id: str = \"\",\n        state_dump_path: str = \"\",\n    ) -> list[BufferedTurnEvent]:\n        \"\"\"Возвращает события с `seq > from_seq` или выбрасывает `GapDetectedError` (410).\"\"\"\n        with self._lock:\n            self.check_gap(\n                from_seq, turn_id=turn_id, state_dump_path=state_dump_path\n            )\n            req_seq = max(0, int(from_seq))\n            return [ev for ev in self._events if ev.seq > req_seq]\n\n    get_since = events_since\n\n    def subscribe(\n        self,\n        from_seq: int = 0,\n        *,\n        turn_id: str = \"\",\n        state_dump_path: str = \"\",\n    ) -> tuple[list[BufferedTurnEvent], StreamSubscriber | None]:\n        \"\"\"Атомарно проверяет gap, возвращает backlog `seq > from_seq` и регистрирует подписчика.\"\"\"\n        with self._lock:\n            self.check_gap(\n                from_seq, turn_id=turn_id, state_dump_path=state_dump_path\n            )\n            req_seq = max(0, int(from_seq))\n            backlog = [ev for ev in self._events if ev.seq > req_seq]\n            if self.sealed:\n                return backlog, None\n            sub = StreamSubscriber()\n            self._subscribers[sub.subscriber_id] = sub\n            return backlog, sub\n\n    def unsubscribe(self, subscriber: StreamSubscriber | None) -> None:\n        if subscriber is None:\n            return\n        subscriber.close()\n        with self._lock:\n            self._subscribers.pop(subscriber.subscriber_id, None)\n\n    def active_subscriber_count(self) -> int:\n        with self._lock:\n            return len(self._subscribers)\n\n\n@dataclass\nclass ManagedTurn:\n    \"\"\"Дескриптор управляемого хода в `TurnSessionManager`.\"\"\"\n\n    turn_id: str\n    turn_key: str\n    rid: str\n    model: str\n    backend: str\n    cwd: str\n    owner_token_hash: str\n    stream: bool = True\n    emulate_tools: bool = False\n    status: str = STATE_QUEUED\n    created_at: float = field(default_factory=time.time)\n    updated_at: float = field(default_factory=time.time)\n    started_monotonic: float = field(default_factory=time.monotonic)\n    pgid: int | None = None\n    command_name: str = \"\"\n    buffer: TurnBuffer = field(default_factory=TurnBuffer)\n    timeout_controller: AdaptiveTimeoutController | None = None\n    cancel_event: threading.Event = field(default_factory=threading.Event)\n    done_event: threading.Event = field(default_factory=threading.Event)\n    result: TurnResult | None = None\n    final_dict: dict[str, Any] | None = None\n    state_dump_path: str = \"\"\n    _slot_release_fn: Callable[[], None] | None = None\n    _slot_released: bool = False\n    _cancel_callbacks: list[Callable[[], None]] = field(default_factory=list)\n    _lock: threading.RLock = field(default_factory=threading.RLock)\n\n    @property\n    def is_terminal(self) -> bool:\n        with self._lock:\n            return self.status in TERMINAL_TURN_STATES\n\n    @property\n    def is_active(self) -> bool:\n        with self._lock:\n            return self.status in ACTIVE_TURN_STATES\n\n    def add_cancel_callback(self, cb: Callable[[], None]) -> None:\n        with self._lock:\n            self._cancel_callbacks.append(cb)\n\n    def mark_detached(self) -> None:\n        \"\"\"Переводит ход в состояние `RUNNING_DETACHED` при разрыве клиентского сокета.\"\"\"\n        with self._lock:\n            if self.status == STATE_RUNNING_ATTACHED:\n                self.status = STATE_RUNNING_DETACHED\n                self.updated_at = time.time()\n\n    def touch_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Обновляет метку активности хода и сбрасывает таймер простоя.\"\"\"\n        if kind == \"detached\":\n            self.mark_detached()\n            return\n        with self._lock:\n            self.updated_at = time.time()\n            ctrl = self.timeout_controller\n        if ctrl is not None:\n            ctrl.record_activity(kind or \"protocol\")\n\n    def bind_process(\n        self,\n        *,\n        pgid: int | None = None,\n        terminate_fn: Callable[[], None] | None = None,\n    ) -> None:\n        \"\"\"Привязывает PGID или callback прерывания к активному ходу.\"\"\"\n        with self._lock:\n            if isinstance(pgid, int) and pgid > 0:\n                self.pgid = pgid\n                if self.timeout_controller is not None:\n                    self.timeout_controller.register_pgid(pgid)\n            if terminate_fn is not None and terminate_fn not in self._cancel_callbacks:\n                self._cancel_callbacks.append(terminate_fn)\n\n    def release_slot_once(self) -> bool:\n        \"\"\"Идемпотентно освобождает семафор конкурентности ровно один раз.\"\"\"\n        with self._lock:\n            if self._slot_released:\n                return False\n            self._slot_released = True\n            fn = self._slot_release_fn\n            self._slot_release_fn = None\n        if fn is not None:\n            try:\n                fn()\n            except Exception:  # noqa: BLE001\n                pass\n            return True\n        return False\n\n    def to_snapshot_dict(self, *, scrub_secrets: bool = True) -> dict[str, Any]:\n        \"\"\"Формирует словарь состояния версии `1.0` для `GET /v1/turns/<turn_id>` и диска.\"\"\"\n        with self._lock:\n            reasoning = self.buffer.get_reasoning_text()\n            content = self.buffer.get_content_text()\n            if not content and self.result is not None and self.result.text:\n                content = self.result.text\n            if not reasoning and self.result is not None and self.result.reasoning:\n                reasoning = self.result.reasoning\n            if scrub_secrets:\n                reasoning = mask_secrets(reasoning)\n                content = mask_secrets(content)\n            err_obj = self.buffer.error\n            if err_obj is not None and scrub_secrets:\n                err_obj = {\n                    k: mask_secrets(v) if isinstance(v, str) else v\n                    for k, v in err_obj.items()\n                }\n            tool_calls = list(self.buffer.tool_calls)\n            if not tool_calls and self.result is not None and self.result.tool_calls:\n                tool_calls = [asdict(tc) for tc in self.result.tool_calls]\n            return {\n                \"schema_version\": SNAPSHOT_SCHEMA_VERSION,\n                \"turn_id\": self.turn_id,\n                \"turn_key\": self.turn_key,\n                \"rid\": self.rid,\n                \"model\": self.model,\n                \"backend\": self.backend,\n                \"status\": self.status.lower(),\n                \"state\": self.status,\n                \"created_at\": self.created_at,\n                \"updated_at\": self.updated_at,\n                \"oldest_available_seq\": self.buffer.oldest_available_seq,\n                \"last_seq\": self.buffer.last_seq,\n                \"reasoning_content\": reasoning,\n                \"content\": content,\n                \"tool_calls\": tool_calls,\n                \"usage\": dict(self.buffer.usage),\n                \"error\": err_obj,\n                \"owner_token_hash\": self.owner_token_hash,\n            }\n\n\ndef _atomic_write_json_0600(path: Path, payload: Any) -> None:\n    \"\"\"Атомарно записывает JSON-файл с правами `0600` в каталог с правами `0700`.\"\"\"\n    parent = path.parent\n    parent.mkdir(parents=True, exist_ok=True)\n    try:\n        parent.chmod(0o700)\n    except OSError:\n        pass\n    raw = (json.dumps(payload, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n    fd, tmp_name = tempfile.mkstemp(prefix=f\".{path.name}.\", dir=str(parent))\n    tmp_path = Path(tmp_name)\n    try:\n        try:\n            os.fchmod(fd, 0o600)\n        except (AttributeError, OSError):\n            pass\n        with os.fdopen(fd, \"wb\") as fh:\n            fh.write(raw)\n            fh.flush()\n            os.fsync(fh.fileno())\n        os.chmod(tmp_path, 0o600)\n        os.replace(tmp_path, path)\n        os.chmod(path, 0o600)\n    except BaseException:\n        try:\n            tmp_path.unlink(missing_ok=True)\n        except OSError:\n            pass\n        raise\n\n\nclass TurnSessionManager:\n    \"\"\"Реестр и оркестратор отвязанных ходов (`ManagedTurn`) для всех адаптеров хаба.\"\"\"\n\n    def __init__(\n        self,\n        workspace: Path | str | Callable[[], Path] | None = None,\n        *,\n        state_root: Path | str | Callable[[], Path] | None = None,\n        max_concurrent: int | None = None,\n        max_turn_bytes: int = MAX_TURN_TEXT_BYTES,\n        max_buffered_turns: int = MAX_BUFFERED_TURNS,\n        max_total_buffer_bytes: int = MAX_TURN_BUFFER_TOTAL_BYTES,\n        turn_retention_s: float = TURN_RETENTION_S,\n        idle_timeout_s: float = IDLE_TIMEOUT_S,\n        safety_cap_s: float = SAFETY_CAP_S,\n        finish_reserve_s: float = FINISH_RESERVE_S,\n        watchdog_interval_s: float = WATCHDOG_INTERVAL_S,\n        cancel_grace_s: float = CANCEL_SIGTERM_GRACE_S,\n        detached_enabled_fn: Callable[[], bool] | None = None,\n        watchdog_enabled_fn: Callable[[], bool] | None = None,\n        finalize_fn: Callable[[TurnResult, bool], TurnResult] | None = None,\n        log_fn: Callable[[str], None] | None = None,\n        clock: Callable[[], float] = time.monotonic,\n        persist_children_file: bool = True,\n    ) -> None:\n        ws_source = workspace if workspace is not None else (state_root or \".\")\n        self._workspace_fn: Callable[[], Path] = (\n            (lambda: Path(ws_source))\n            if isinstance(ws_source, (str, Path))\n            else ws_source\n        )\n        self._state_root_fn: Callable[[], Path] | None = (\n            None\n            if state_root is None\n            else (\n                (lambda: Path(state_root))\n                if isinstance(state_root, (str, Path))\n                else state_root\n            )\n        )\n        self.max_concurrent = int(max_concurrent or 32)\n        self.max_turn_bytes = int(max_turn_bytes)\n        self.max_buffered_turns = int(max_buffered_turns)\n        self.max_total_buffer_bytes = int(max_total_buffer_bytes)\n        self.turn_retention_s = float(turn_retention_s)\n        self.idle_timeout_s = float(idle_timeout_s)\n        self.safety_cap_s = float(safety_cap_s)\n        self.finish_reserve_s = float(finish_reserve_s)\n        self.watchdog_interval_s = float(watchdog_interval_s)\n        self.cancel_grace_s = float(cancel_grace_s)\n        self.persist_children_file = bool(persist_children_file)\n        self._detached_enabled_fn = detached_enabled_fn or _is_detached_enabled\n        self._watchdog_enabled_fn = watchdog_enabled_fn or _is_watchdog_enabled\n        self._finalize_fn = finalize_fn\n\n        self._log_fn = log_fn\n        self._clock = clock\n\n        self._lock = threading.RLock()\n        self._cond = threading.Condition(self._lock)\n        self._turns_by_id: dict[str, ManagedTurn] = {}\n        self._active_by_key: dict[str, str] = {}\n        self._children: dict[int, dict[str, Any]] = {}\n\n    @property\n    def workspace(self) -> Path:\n        return Path(self._workspace_fn())\n\n    @property\n    def state_dir(self) -> Path:\n        if self._state_root_fn is not None:\n            sr = Path(self._state_root_fn())\n            return sr.parent if sr.name == \"turns\" else sr\n        ws = self.workspace\n        if ws.name == \"state\":\n            return ws\n        if ws.name == \"turns\":\n            return ws.parent\n        return ws / \"state\"\n\n    @property\n    def turns_dir(self) -> Path:\n        if self._state_root_fn is not None:\n            sr = Path(self._state_root_fn())\n            return sr if sr.name == \"turns\" else sr / \"turns\"\n        ws = self.workspace\n        if ws.name == \"turns\":\n            return ws\n        return self.state_dir / \"turns\"\n\n    @property\n    def children_path(self) -> Path:\n        return self.state_dir / \"children.json\"\n\n    def is_detached_enabled(self) -> bool:\n        return bool(self._detached_enabled_fn())\n\n    def is_watchdog_enabled(self) -> bool:\n        return bool(self._watchdog_enabled_fn())\n\n    def _log(self, message: str) -> None:\n        if self._log_fn is not None:\n            try:\n                self._log_fn(message)\n            except Exception:  # noqa: BLE001\n                pass\n\n    def ensure_state_dirs(self) -> None:\n        \"\"\"Создаёт каталоги `workspace/state` и `workspace/state/turns` с правами `0700`.\"\"\"\n        for directory in (self.state_dir, self.turns_dir):\n            directory.mkdir(parents=True, exist_ok=True)\n            try:\n                directory.chmod(0o700)\n            except OSError:\n                pass\n\n    def register_child_pgid(\n        self,\n        turn_id_or_pgid: str | int,\n        pgid: int | None = None,\n        *,\n        pid: int | None = None,\n        rid: str = \"\",\n        command: str = \"muse\",\n        backend: str = \"\",\n        turn_id: str = \"\",\n    ) -> None:\n        \"\"\"Регистрирует `pgid` дочернего процесса в `ManagedTurn` и `children.json`.\"\"\"\n        if isinstance(turn_id_or_pgid, int):\n            actual_pgid = turn_id_or_pgid\n            actual_turn_id = turn_id\n        else:\n            actual_turn_id = str(turn_id_or_pgid)\n            actual_pgid = int(pgid or 0)\n        cmd_name = backend or command or \"muse\"\n        if not isinstance(actual_pgid, int) or actual_pgid <= 0:\n            return\n        with self._lock:\n            turn = self._turns_by_id.get(actual_turn_id) if actual_turn_id else None\n            if turn is not None:\n                turn.pgid = actual_pgid\n                turn.command_name = cmd_name\n                if turn.timeout_controller is not None:\n                    turn.timeout_controller.register_pgid(actual_pgid)\n            self._children[actual_pgid] = {\n                \"pid\": int(pid or actual_pgid),\n                \"pgid\": int(actual_pgid),\n                \"turn_id\": actual_turn_id,\n                \"rid\": rid or (turn.rid if turn else \"\"),\n                \"started_at\": time.time(),\n                \"command\": cmd_name,\n            }\n            if self.persist_children_file:\n                self._persist_children_locked()\n\n    def unregister_child_pgid(self, pgid: int | None) -> None:\n        \"\"\"Удаляет `pgid` из реестра `children.json` после подтверждённой гибели группы.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return\n        with self._lock:\n            if pgid in self._children:\n                self._children.pop(pgid, None)\n                if self.persist_children_file:\n                    self._persist_children_locked()\n\n    def _persist_children_locked(self) -> None:\n        try:\n            self.ensure_state_dirs()\n            payload = {\n                \"schema_version\": SNAPSHOT_SCHEMA_VERSION,\n                \"children\": list(self._children.values()),\n            }\n            _atomic_write_json_0600(self.children_path, payload)\n        except OSError:\n            pass\n\n    def persist_turn_snapshot(self, turn: ManagedTurn) -> Path | None:\n        \"\"\"Сохраняет снапшот хода в `workspace/state/turns/<turn_id>.json` с правами `0600`.\"\"\"\n        try:\n            self.ensure_state_dirs()\n            path = self.turns_dir / f\"{turn.turn_id}.json\"\n            snapshot = turn.to_snapshot_dict(scrub_secrets=True)\n            _atomic_write_json_0600(path, snapshot)\n            turn.state_dump_path = str(path)\n            return path\n        except OSError as exc:\n            self._log(\n                f\"turn_snapshot_write_failed turn_id={turn.turn_id} err={exc.__class__.__name__}\"\n            )\n            return None\n\n    def _enforce_memory_caps_locked(self) -> None:\n        \"\"\"Вытесняет старые терминальные ходы из RAM на диск при превышении лимитов.\"\"\"\n        now = time.time()\n        expired_ids = [\n            tid\n            for tid, t in self._turns_by_id.items()\n            if t.is_terminal and (now - t.updated_at) >= self.turn_retention_s\n        ]\n        for tid in expired_ids:\n            turn = self._turns_by_id.pop(tid, None)\n            if turn is not None:\n                self.persist_turn_snapshot(turn)\n                turn.buffer.clear_ring_memory()\n\n        terminal_turns = sorted(\n            (t for t in self._turns_by_id.values() if t.is_terminal),\n            key=lambda item: item.updated_at,\n        )\n        while len(self._turns_by_id) > self.max_buffered_turns and terminal_turns:\n            oldest = terminal_turns.pop(0)\n            self.persist_turn_snapshot(oldest)\n            oldest.buffer.clear_ring_memory()\n            self._turns_by_id.pop(oldest.turn_id, None)\n\n        total_ram = sum(t.buffer.total_bytes for t in self._turns_by_id.values())\n        if total_ram > self.max_total_buffer_bytes:\n            for oldest in terminal_turns:\n                if total_ram <= self.max_total_buffer_bytes:\n                    break\n                if oldest.buffer.total_bytes > 0:\n                    self.persist_turn_snapshot(oldest)\n                    total_ram -= oldest.buffer.clear_ring_memory()\n\n    def sweep_expired_snapshots(self) -> int:\n        \"\"\"Удаляет снапшоты на диске старше `TURN_RETENTION_S`.\"\"\"\n        removed = 0\n        cutoff = time.time() - self.turn_retention_s\n        try:\n            if not self.turns_dir.exists():\n                return 0\n            for path in self.turns_dir.glob(\"*.json\"):\n                try:\n                    if path.stat().st_mtime < cutoff:\n                        path.unlink(missing_ok=True)\n                        removed += 1\n                except OSError:\n                    pass\n        except OSError:\n            pass\n        return removed\n\n    def active_turns(self) -> list[ManagedTurn]:\n        \"\"\"Возвращает список всех нетерминальных ходов.\"\"\"\n        with self._lock:\n            return [t for t in self._turns_by_id.values() if t.is_active]\n\n    def active_count(self) -> int:\n        \"\"\"Количество активных (нетерминальных) ходов в менеджере.\"\"\"\n        with self._lock:\n            return sum(1 for t in self._turns_by_id.values() if t.is_active)\n\n    def find_active_by_key(\n        self, turn_key: str, owner_token_hash: str | None = None\n    ) -> ManagedTurn | None:\n        \"\"\"Находит активный ход по `turn_key` (терминальные ходы игнорируются, RW-003).\"\"\"\n        with self._lock:\n            tid = self._active_by_key.get(turn_key)\n            if not tid:\n                return None\n            turn = self._turns_by_id.get(tid)\n            if turn is None or not turn.is_active:\n                self._active_by_key.pop(turn_key, None)\n                return None\n            if (\n                owner_token_hash is not None\n                and turn.owner_token_hash\n                and turn.owner_token_hash != owner_token_hash\n            ):\n                return None\n            return turn\n\n    def get_turn(\n        self,\n        turn_id: str,\n        *,\n        owner_token_hash: str | None = None,\n    ) -> ManagedTurn:\n        \"\"\"Возвращает `ManagedTurn` по `turn_id` с проверкой формата и владельца.\"\"\"\n        if not validate_turn_id(turn_id):\n            raise InvalidTurnIdError(f\"Invalid turn_id: {turn_id!r}\")\n        with self._lock:\n            turn = self._turns_by_id.get(turn_id)\n        if turn is None:\n            raise TurnNotFoundError(turn_id)\n        if (\n            owner_token_hash is not None\n            and turn.owner_token_hash\n            and turn.owner_token_hash != owner_token_hash\n        ):\n            raise TurnForbiddenError(turn_id)\n        return turn\n\n    def get_turn_snapshot(\n        self,\n        turn_id: str,\n        *,\n        owner_token_hash: str | None = None,\n    ) -> dict[str, Any]:\n        \"\"\"Возвращает снапшот хода из памяти или с диска (`workspace/state/turns/<id>.json`).\"\"\"\n        if not validate_turn_id(turn_id):\n            raise InvalidTurnIdError(f\"Invalid turn_id: {turn_id!r}\")\n        with self._lock:\n            turn = self._turns_by_id.get(turn_id)\n        if turn is not None:\n            if (\n                owner_token_hash is not None\n                and turn.owner_token_hash\n                and turn.owner_token_hash != owner_token_hash\n            ):\n                raise TurnForbiddenError(turn_id)\n            return turn.to_snapshot_dict(scrub_secrets=True)\n\n        disk_path = self.turns_dir / f\"{turn_id}.json\"\n        if not disk_path.is_file():\n            raise TurnNotFoundError(turn_id)\n        try:\n            data = json.loads(disk_path.read_text(encoding=\"utf-8\"))\n        except (OSError, json.JSONDecodeError) as exc:\n            raise TurnNotFoundError(turn_id) from exc\n        saved_owner = data.get(\"owner_token_hash\")\n        if (\n            owner_token_hash is not None\n            and saved_owner\n            and saved_owner != owner_token_hash\n        ):\n            raise TurnForbiddenError(turn_id)\n        return data\n\n    def create_or_attach_turn(\n        self,\n        *,\n        model: str,\n        backend: str,\n        cwd: str,\n        messages: list[dict[str, Any]] | tuple[Any, ...],\n        session_id: str | None = None,\n        owner_token_hash: str = \"\",\n        rid: str = \"\",\n        requested_turn_id: str | None = None,\n        resume_turn_id: str | None = None,\n        stream: bool = True,\n        emulate_tools: bool = False,\n        idle_timeout_s: float | None = None,\n        safety_cap_s: float | None = None,\n        slot_release_fn: Callable[[], None] | None = None,\n    ) -> tuple[ManagedTurn, bool]:\n        \"\"\"Создаёт новый `ManagedTurn` или подключается к уже идущему активному ходу.\n\n        Возвращает `(turn, is_existing_active)`.\n        Терминальные ходы с тем же `turn_key` никогда не переиспользуются без явного\n        `resume_turn_id`, чтобы кнопка Regenerate всегда создавала новый ход (RW-003).\n        \"\"\"\n        if resume_turn_id is not None and resume_turn_id != \"\":\n            if not validate_turn_id(resume_turn_id):\n                raise InvalidTurnIdError(f\"Invalid X-Turn-Resume-Id: {resume_turn_id!r}\")\n            existing = self.get_turn(\n                resume_turn_id, owner_token_hash=owner_token_hash or None\n            )\n            with self._lock:\n                if existing.status == STATE_RUNNING_DETACHED:\n                    existing.status = STATE_RUNNING_ATTACHED\n                    existing.updated_at = time.time()\n            return existing, True\n\n        if requested_turn_id is not None and requested_turn_id != \"\":\n            if not validate_turn_id(requested_turn_id):\n                raise InvalidTurnIdError(f\"Invalid X-Turn-Id: {requested_turn_id!r}\")\n\n        turn_key = compute_turn_key(\n            cwd=cwd,\n            model=model,\n            session_id=session_id,\n            messages=messages,\n            default_workspace=str(self.workspace),\n        )\n\n        with self._lock:\n            if requested_turn_id and requested_turn_id in self._turns_by_id:\n                existing_by_id = self._turns_by_id[requested_turn_id]\n                if (\n                    owner_token_hash\n                    and existing_by_id.owner_token_hash\n                    and existing_by_id.owner_token_hash != owner_token_hash\n                ):\n                    raise TurnForbiddenError(requested_turn_id)\n                if existing_by_id.is_active:\n                    if existing_by_id.status == STATE_RUNNING_DETACHED:\n                        existing_by_id.status = STATE_RUNNING_ATTACHED\n                        existing_by_id.updated_at = time.time()\n                    return existing_by_id, True\n\n            active_tid = self._active_by_key.get(turn_key)\n            if active_tid:\n                active_turn = self._turns_by_id.get(active_tid)\n                if active_turn is not None and active_turn.is_active:\n                    if (\n                        active_turn.status == STATE_RUNNING_DETACHED\n                        and (\n                            not owner_token_hash\n                            or not active_turn.owner_token_hash\n                            or active_turn.owner_token_hash == owner_token_hash\n                        )\n                    ):\n                        active_turn.status = STATE_RUNNING_ATTACHED\n                        active_turn.updated_at = time.time()\n                        self._log(\n                            f\"turn_reattached rid={rid or active_turn.rid} \"\n                            f\"turn_id={active_turn.turn_id} turn_key={turn_key[:12]}\"\n                        )\n                        return active_turn, True\n                else:\n                    self._active_by_key.pop(turn_key, None)\n\n            turn_id = (\n                requested_turn_id\n                if (\n                    requested_turn_id\n                    and requested_turn_id not in self._turns_by_id\n                )\n                else f\"turn_{uuid.uuid4().hex[:16]}\"\n            )\n            eff_rid = rid or f\"r-{uuid.uuid4().hex[:8]}\"\n            eff_idle = (\n                float(idle_timeout_s)\n                if idle_timeout_s is not None\n                else self.idle_timeout_s\n            )\n            eff_cap = (\n                float(safety_cap_s)\n                if safety_cap_s is not None\n                else self.safety_cap_s\n            )\n            controller = AdaptiveTimeoutController(\n                idle_timeout_s=eff_idle,\n                safety_cap_s=eff_cap,\n                finish_reserve_s=self.finish_reserve_s,\n                watchdog_enabled=self.is_watchdog_enabled(),\n                clock=self._clock,\n                rid=eff_rid,\n                turn_id=turn_id,\n                log_fn=self._log_fn,\n            )\n            dump_path = str(self.turns_dir / f\"{turn_id}.json\")\n            turn = ManagedTurn(\n                turn_id=turn_id,\n                turn_key=turn_key,\n                rid=eff_rid,\n                model=model,\n                backend=backend,\n                cwd=cwd,\n                owner_token_hash=owner_token_hash,\n                stream=stream,\n                emulate_tools=emulate_tools,\n                status=STATE_RUNNING_ATTACHED,\n                buffer=TurnBuffer(max_bytes=self.max_turn_bytes),\n                timeout_controller=controller,\n                state_dump_path=dump_path,\n                _slot_release_fn=slot_release_fn,\n            )\n            self._turns_by_id[turn_id] = turn\n            self._active_by_key[turn_key] = turn_id\n            self._enforce_memory_caps_locked()\n            return turn, False\n\n    def finalize_abandoned_turn(self, turn: ManagedTurn | None) -> None:\n        \"\"\"Гарантирует освобождение ресурсов хода при выходе потока-исполнителя до финализации.\"\"\"\n        if turn is None:\n            return\n        turn.release_slot_once()\n        with self._lock:\n            if turn.is_terminal:\n                return\n            turn.status = STATE_CANCELLED\n            turn.updated_at = time.time()\n            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n                self._active_by_key.pop(turn.turn_key, None)\n            if not turn.buffer.sealed:\n                turn.buffer.seal()\n            if turn.timeout_controller is not None:\n                turn.timeout_controller.close()\n            turn.done_event.set()\n            self._cond.notify_all()\n\n    def mark_detached(self, turn_id: str) -> None:\n        \"\"\"Переводит активный ход в `RUNNING_DETACHED` при разрыве HTTP-соединения.\"\"\"\n        with self._lock:\n            turn = self._turns_by_id.get(turn_id)\n            if turn is not None and turn.status == STATE_RUNNING_ATTACHED:\n                turn.status = STATE_RUNNING_DETACHED\n                turn.updated_at = time.time()\n                self._log(\n                    f\"turn_detached rid={turn.rid} turn_id={turn.turn_id} \"\n                    f\"last_seq={turn.buffer.last_seq}\"\n                )\n\n    def _terminate_pgid(self, pgid: int | None, grace_s: float) -> None:\n        if not isinstance(pgid, int) or pgid <= 0:\n            return\n        try:\n            os.killpg(pgid, signal.SIGTERM)\n        except (ProcessLookupError, PermissionError, OSError):\n            self.unregister_child_pgid(pgid)\n            return\n        deadline = time.monotonic() + max(0.05, grace_s)\n        while time.monotonic() < deadline:\n            if not ProcessWatchdog.is_group_alive(pgid):\n                self.unregister_child_pgid(pgid)\n                return\n            time.sleep(0.05)\n        try:\n            os.killpg(pgid, signal.SIGKILL)\n        except (ProcessLookupError, PermissionError, OSError):\n            pass\n        self.unregister_child_pgid(pgid)\n\n    def cancel_turn(\n        self,\n        turn_id: str,\n        *,\n        owner_token_hash: str | None = None,\n        reason: str = \"client_cancelled\",\n    ) -> ManagedTurn:\n        \"\"\"Явно отменяет ход (`SIGTERM -> 2s -> SIGKILL`), немедленно освобождая слот (RW-001).\"\"\"\n        turn = self.get_turn(turn_id, owner_token_hash=owner_token_hash)\n        with self._lock:\n            if turn.status == STATE_CANCELLED:\n                return turn\n            if turn.is_terminal:\n                return turn\n            turn.status = STATE_CANCELLED\n            turn.updated_at = time.time()\n            turn.cancel_event.set()\n            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n                self._active_by_key.pop(turn.turn_key, None)\n            pgid = turn.pgid\n            callbacks = list(turn._cancel_callbacks)\n\n        # Немедленно возвращаем слот MAX_CONCURRENT до ожидания завершения потомка.\n        turn.release_slot_once()\n\n        for cb in callbacks:\n            try:\n                cb()\n            except Exception:  # noqa: BLE001\n                pass\n\n        if pgid is not None:\n            self._terminate_pgid(pgid, self.cancel_grace_s)\n\n        with self._lock:\n            if not turn.buffer.sealed:\n                turn.buffer.append(\n                    \"error\",\n                    {\n                        \"message\": f\"Turn cancelled ({reason})\",\n                        \"type\": \"cancelled\",\n                        \"code\": \"turn_cancelled\",\n                    },\n                )\n                turn.buffer.seal()\n            if turn.timeout_controller is not None:\n                turn.timeout_controller.close()\n            turn.done_event.set()\n            self.persist_turn_snapshot(turn)\n            self._cond.notify_all()\n        self._log(f\"turn_cancelled rid={turn.rid} turn_id={turn.turn_id} reason={reason}\")\n        return turn\n\n    def interrupt_for_drain(\n        self, turn: ManagedTurn, message: str = \"bridge restart drain timeout exceeded\"\n    ) -> None:\n        \"\"\"Завершает ход при истечении `DRAIN_TIMEOUT_S` со сбросом reasoning и error-чанком.\"\"\"\n        with self._lock:\n            if turn.is_terminal:\n                return\n            turn.status = STATE_INTERRUPTED_DRAIN\n            turn.updated_at = time.time()\n            turn.cancel_event.set()\n            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n                self._active_by_key.pop(turn.turn_key, None)\n            pgid = turn.pgid\n            callbacks = list(turn._cancel_callbacks)\n\n        turn.release_slot_once()\n        for cb in callbacks:\n            try:\n                cb()\n            except Exception:  # noqa: BLE001\n                pass\n        if pgid is not None:\n            self._terminate_pgid(pgid, self.cancel_grace_s)\n\n        with self._lock:\n            if not turn.buffer.sealed:\n                turn.buffer.append(\n                    \"error\",\n                    {\n                        \"message\": message,\n                        \"type\": \"overloaded\",\n                        \"code\": \"drain_timeout\",\n                    },\n                )\n                turn.buffer.seal()\n            if turn.timeout_controller is not None:\n                turn.timeout_controller.close()\n            turn.done_event.set()\n            self.persist_turn_snapshot(turn)\n            self._cond.notify_all()\n\n    def complete_turn_from_result(\n        self,\n        turn: ManagedTurn,\n        raw_result: TurnResult,\n        *,\n        backend_kind: str = \"\",\n    ) -> dict[str, Any]:\n        \"\"\"Финализирует `ManagedTurn` по `TurnResult` от `BackendAdapter.execute_turn`.\"\"\"\n        final_res = (\n            self._finalize_fn(raw_result, turn.emulate_tools)\n            if self._finalize_fn is not None\n            else raw_result\n        )\n        turn.release_slot_once()\n\n        with self._lock:\n            if turn.status in (STATE_CANCELLED, STATE_INTERRUPTED_DRAIN):\n                if turn.final_dict is not None:\n                    return turn.final_dict\n                return {\n                    \"state\": \"client_gone\",\n                    \"rc\": 1,\n                    \"text\": turn.buffer.get_content_text(),\n                    \"err\": \"cancelled\",\n                    \"usage\": dict(turn.buffer.usage),\n                    \"result\": {},\n                    \"tool_calls\": list(turn.buffer.tool_calls),\n                    \"events\": [],\n                    \"backend_kind\": backend_kind or turn.backend,\n                    \"turn_id\": turn.turn_id,\n                }\n\n            turn.result = final_res\n            turn.buffer.set_usage(final_res.usage)\n\n            # Если адаптер не стримил события живьём, докладываем их в TurnBuffer.\n            had_content = bool(turn.buffer.get_content_text())\n            had_reasoning = bool(turn.buffer.get_reasoning_text())\n            had_tool_calls = bool(turn.buffer.tool_calls)\n            if not turn.buffer.sealed:\n                for ev in final_res.events or ():\n                    if ev.kind == \"reasoning\" and isinstance(ev.value, str):\n                        if not had_reasoning:\n                            turn.buffer.append(\"reasoning\", ev.value)\n                    elif ev.kind == \"content\" and isinstance(ev.value, str):\n                        if not had_content:\n                            turn.buffer.append(\"content\", ev.value)\n                    elif ev.kind == \"tool_call\" and not had_tool_calls:\n                        call_val = (\n                            asdict(ev.value)\n                            if isinstance(ev.value, ToolCall)\n                            else ev.value\n                        )\n                        turn.buffer.append(\"tool_call\", call_val)\n                if not final_res.events:\n                    if final_res.reasoning and not had_reasoning:\n                        turn.buffer.append(\"reasoning\", final_res.reasoning)\n                    if final_res.text and not had_content:\n                        turn.buffer.append(\"content\", final_res.text)\n                    if not had_tool_calls:\n                        for tc in final_res.tool_calls or ():\n                            turn.buffer.append(\"tool_call\", asdict(tc))\n\n            res_state = str(final_res.state or \"done\")\n            term_reason = (","numLines":1488,"startLine":1,"totalLines":1755,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01KuvNo1beAsTNiEz9oiVEtS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
