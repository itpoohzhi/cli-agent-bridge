{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a14b74-03fb-7d03-878f-dfaf07bafb31"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"01a14b74-0c73-7f61-b488-8792254708ab","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14b74-0c73-7f61-b488-8792254708ab","run_stream":{"kind":"run","id":"01a14b74-0c73-7f61-b488-8792254708ab"},"call_id":"call_01a14b74a9237598a4caf32fc23e8b15","text":"{\n  \"chunk_id\": \"exec-4-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && sed -n '54,110p' core/turn_session_manager.py; echo ---BUFFER---; sed -n '400,640p' core/turn_session_manager.py | head -n 160; echo ---ORPHAN---; grep -n \\\"orphan\\\\|DETACHED_ORPHAN\\\\|300\\\" core/turn_session_manager.py | head -n 40; echo ---TESTCOUNT---; grep -c \\\"def test_\\\" tests/test_detached_turn_execution.py tests/test_adaptive_idle_watchdog.py tests/test_graceful_shutdown_drain.py tests/test_turn_cancel_and_gap.py tests/test_dsh_profile_config.py; echo ---FLAGS---; grep -rn \\\"DSH_BRIDGE_\\\\|BRIDGE_ENABLE\\\\|BRIDGE_ADAPTIVE\\\" server.py bridges/muse-bridge/server.py adapters/muse_adapter.py | head -n 40\",\n  \"description\": \"Check buffer orphan flags tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"MAX_TURN_TEXT_BYTES: int = 10 * 1024 * 1024\\nMAX_BUFFERED_TURNS: int = 128\\nMAX_TURN_BUFFER_TOTAL_BYTES: int = 128 * 1024 * 1024\\nTURN_RETENTION_S: float = 3600.0\\nCANCEL_SIGTERM_GRACE_S: float = 2.0\\n\\nSTATE_QUEUED = \\\"QUEUED\\\"\\nSTATE_RUNNING_ATTACHED = \\\"RUNNING_ATTACHED\\\"\\nSTATE_RUNNING_DETACHED = \\\"RUNNING_DETACHED\\\"\\nSTATE_COMPLETED = \\\"COMPLETED\\\"\\nSTATE_CANCELLED = \\\"CANCELLED\\\"\\nSTATE_FAILED_BACKEND = \\\"FAILED_BACKEND\\\"\\nSTATE_TIMED_OUT_IDLE = \\\"TIMED_OUT_IDLE\\\"\\nSTATE_TIMED_OUT_CAP = \\\"TIMED_OUT_CAP\\\"\\nSTATE_INTERRUPTED_DRAIN = \\\"INTERRUPTED_DRAIN\\\"\\n\\nACTIVE_TURN_STATES = frozenset(\\n    {STATE_QUEUED, STATE_RUNNING_ATTACHED, STATE_RUNNING_DETACHED}\\n)\\nTERMINAL_TURN_STATES = frozenset(\\n    {\\n        STATE_COMPLETED,\\n        STATE_CANCELLED,\\n        STATE_FAILED_BACKEND,\\n        STATE_TIMED_OUT_IDLE,\\n        STATE_TIMED_OUT_CAP,\\n        STATE_INTERRUPTED_DRAIN,\\n    }\\n)\\n\\n_SECRET_PATTERNS = (\\n    re.compile(r\\\"(?i)(Bearer\\\\s+)[A-Za-z0-9._~+/=-]{8,}\\\"),\\n    re.compile(\\n        r\\\"(?i)((?:DROID_DSH_BRIDGE_KEY|FACTORY_API_KEY|META_API_KEY|API_KEY|TOKEN|SECRET)\\\\s*[=:]\\\\s*)([^\\\\s\\\\\\\"',;]+)\\\"\\n    ),\\n    re.compile(r\\\"\\\\b(?:fk|sk)-[A-Za-z0-9_-]{10,}\\\\b\\\"),\\n)\\n\\n\\ndef validate_turn_id(turn_id: Any) -> bool:\\n    \\\"\\\"\\\"Проверяет идентификатор хода по строгому шаблону `^[a-zA-Z0-9_-]{1,64}$`.\\\"\\\"\\\"\\n    return isinstance(turn_id, str) and bool(TURN_ID_RE.fullmatch(turn_id))\\n\\n\\ndef hash_owner_token(token_or_peer: str | None) -> str:\\n    \\\"\\\"\\\"Вычисляет SHA-256 хеш токена владельца или локального пира для изоляции хода.\\\"\\\"\\\"\\n    raw = (token_or_peer or \\\"anonymous\\\").strip()\\n    return hashlib.sha256(raw.encode(\\\"utf-8\\\")).hexdigest()\\n\\n\\nhash_token = hash_owner_token\\n\\n\\ndef _is_detached_enabled() -> bool:\\n    \\\"\\\"\\\"Проверяет флаг включения фонового доведения ходов (`BRIDGE_DETACHED_TURNS_ENABLED` / `DSH_BRIDGE_DETACHED_ENABLED`).\\\"\\\"\\\"\\n    val = os.environ.get(\\n        \\\"BRIDGE_DETACHED_TURNS_ENABLED\\\",\\n---BUFFER---\\n    \\\"\\\"\\\"Кольцевой буфер событий одного хода с лимитом `MAX_TURN_TEXT_BYTES` (10 МиБ).\\\"\\\"\\\"\\n\\n    def __init__(self, max_bytes: int = MAX_TURN_TEXT_BYTES) -> None:\\n        self.max_bytes = max(1, int(max_bytes))\\n        self._lock = threading.RLock()\\n        self._events: deque[BufferedTurnEvent] = deque()\\n        self.oldest_available_seq: int = 1\\n        self.last_seq: int = 0\\n        self.total_bytes: int = 0\\n        self.evicted_bytes: int = 0\\n        self.evicted_count: int = 0\\n        self.sealed: bool = False\\n\\n        self._reasoning_chunks: deque[str] = deque()\\n        self._reasoning_bytes: int = 0\\n        self._content_chunks: deque[str] = deque()\\n        self._content_bytes: int = 0\\n        self.tool_calls: list[dict[str, Any]] = []\\n        self.usage: dict[str, int] = {\\n            \\\"prompt_tokens\\\": 0,\\n            \\\"completion_tokens\\\": 0,\\n            \\\"total_tokens\\\": 0,\\n        }\\n        self.error: dict[str, Any] | None = None\\n        self._subscribers: dict[str, StreamSubscriber] = {}\\n\\n    @staticmethod\\n    def _estimate_bytes(kind: str, payload: Any) -> int:\\n        if isinstance(payload, str):\\n            return max(1, len(payload.encode(\\\"utf-8\\\", errors=\\\"replace\\\")))\\n        try:\\n            encoded = json.dumps(payload, ensure_ascii=False).encode(\\n                \\\"utf-8\\\", errors=\\\"replace\\\"\\n            )\\n            return max(1, len(encoded))\\n        except Exception:  # noqa: BLE001\\n            return max(1, len(str(payload).encode(\\\"utf-8\\\", errors=\\\"replace\\\")))\\n\\n    def _append_bounded_text(\\n        self, chunks: deque[str], current_bytes: int, piece: str\\n    ) -> int:\\n        if not piece:\\n            return current_bytes\\n        piece_bytes = len(piece.encode(\\\"utf-8\\\", errors=\\\"replace\\\"))\\n        if piece_bytes > self.max_bytes:\\n            piece = piece.encode(\\\"utf-8\\\", errors=\\\"replace\\\")[-self.max_bytes :].decode(\\n                \\\"utf-8\\\", errors=\\\"ignore\\\"\\n            )\\n            piece_bytes = len(piece.encode(\\\"utf-8\\\", errors=\\\"replace\\\"))\\n        chunks.append(piece)\\n        current_bytes += piece_bytes\\n        while current_bytes > self.max_bytes and len(chunks) > 1:\\n            removed = chunks.popleft()\\n            current_bytes -= len(removed.encode(\\\"utf-8\\\", errors=\\\"replace\\\"))\\n        return max(0, current_bytes)\\n\\n    def append(self, kind: str, payload: Any) -> BufferedTurnEvent:\\n        \\\"\\\"\\\"Добавляет событие в буфер, вытесняя старые записи при превышении `max_bytes`.\\\"\\\"\\\"\\n        with self._lock:\\n            if self.sealed:\\n                raise RuntimeError(\\\"TurnBuffer is already sealed\\\")\\n            self.last_seq += 1\\n            seq = self.last_seq\\n            byte_len = self._estimate_bytes(kind, payload)\\n            event = BufferedTurnEvent(\\n                seq=seq,\\n                ts=time.time(),\\n                kind=str(kind),\\n                payload=payload,\\n                byte_len=byte_len,\\n            )\\n            self._events.append(event)\\n            self.total_bytes += byte_len\\n\\n            if kind == \\\"reasoning\\\" and isinstance(payload, str):\\n                self._reasoning_bytes = self._append_bounded_text(\\n                    self._reasoning_chunks, self._reasoning_bytes, payload\\n                )\\n            elif kind == \\\"content\\\" and isinstance(payload, str):\\n                self._content_bytes = self._append_bounded_text(\\n                    self._content_chunks, self._content_bytes, payload\\n                )\\n            elif kind == \\\"tool_call\\\":\\n                call_dict = (\\n                    dict(payload)\\n                    if isinstance(payload, dict)\\n                    else asdict(payload)\\n                    if hasattr(payload, \\\"__dataclass_fields__\\\")\\n                    else {\\\"function\\\": {\\\"name\\\": \\\"unknown\\\", \\\"arguments\\\": str(payload)}}\\n                )\\n                self.tool_calls.append(call_dict)\\n            elif kind == \\\"error\\\":\\n                self.error = (\\n                    dict(payload)\\n                    if isinstance(payload, dict)\\n                    else {\\\"message\\\": str(payload), \\\"type\\\": \\\"stream_error\\\"}\\n                )\\n            elif kind == \\\"done\\\" and isinstance(payload, dict):\\n                raw_usage = payload.get(\\\"usage\\\")\\n                if isinstance(raw_usage, dict):\\n                    self.set_usage(raw_usage)\\n\\n            # Вытеснение старых событий при превышении кольцевого лимита (RW-006).\\n            while self.total_bytes > self.max_bytes and self._events:\\n                evicted = self._events.popleft()\\n                self.total_bytes = max(0, self.total_bytes - evicted.byte_len)\\n                self.evicted_bytes += evicted.byte_len\\n                self.evicted_count += 1\\n\\n            if self._events:\\n                self.oldest_available_seq = self._events[0].seq\\n            else:\\n                self.oldest_available_seq = self.last_seq + 1\\n\\n            subscribers = list(self._subscribers.values())\\n\\n        for sub in subscribers:\\n            sub.publish(event)\\n        return event\\n\\n    def set_usage(self, usage: Usage | dict[str, Any]) -> None:\\n        \\\"\\\"\\\"Обновляет счётчики токенов хода.\\\"\\\"\\\"\\n        with self._lock:\\n            if isinstance(usage, Usage):\\n                in_tok = int(usage.input_tokens or 0)\\n                out_tok = int(usage.output_tokens or 0)\\n                cache_tok = usage.cache_read_tokens\\n            elif isinstance(usage, dict):\\n                in_tok = int(\\n                    usage.get(\\\"prompt_tokens\\\")\\n                    or usage.get(\\\"input_tokens\\\")\\n                    or 0\\n                )\\n                out_tok = int(\\n                    usage.get(\\\"completion_tokens\\\")\\n                    or usage.get(\\\"output_tokens\\\")\\n                    or 0\\n                )\\n                cache_tok = usage.get(\\\"cache_read_tokens\\\")\\n            else:\\n                return\\n            self.usage = {\\n                \\\"prompt_tokens\\\": in_tok,\\n                \\\"completion_tokens\\\": out_tok,\\n                \\\"total_tokens\\\": in_tok + out_tok,\\n            }\\n            if cache_tok is not None:\\n                self.usage[\\\"cache_read_tokens\\\"] = int(cache_tok)\\n\\n    def get_reasoning_text(self) -> str:\\n        with self._lock:\\n            return \\\"\\\".join(self._reasoning_chunks)\\n\\n    def get_content_text(self) -> str:\\n        with self._lock:\\n            return \\\"\\\".join(self._content_chunks)\\n\\n    def seal(self) -> None:\\n        \\\"\\\"\\\"Запечатывает буфер при переходе хода в терминальное состояние.\\\"\\\"\\\"\\n        with self._lock:\\n---ORPHAN---\\n---TESTCOUNT---\\ntests/test_detached_turn_execution.py:3\\ntests/test_adaptive_idle_watchdog.py:4\\ntests/test_graceful_shutdown_drain.py:4\\ntests/test_turn_cancel_and_gap.py:3\\ntests/test_dsh_profile_config.py:1\\n---FLAGS---\\nserver.py:11:`DROID_DSH_BRIDGE_IDLE_SECONDS` (по умолчанию 2700 с), SID и файлы остаются, следующий\\nserver.py:21:Каталог моделей — `fleet.json` (env `DROID_DSH_BRIDGE_FLEET`): читается один раз\\nserver.py:32:DROID_DSH_BRIDGE_KEY (его подкладывает start.sh из ~/.dsh/.env); в окружение\\nserver.py:137:HOST = os.environ.get(\\\"DROID_DSH_BRIDGE_HOST\\\", \\\"127.0.0.1\\\")\\nserver.py:138:PORT = int(os.environ.get(\\\"DROID_DSH_BRIDGE_PORT\\\", \\\"9882\\\"))\\nserver.py:139:AUTH_KEY = os.environ.get(\\\"DROID_DSH_BRIDGE_KEY\\\", \\\"\\\").strip()\\nserver.py:144:    os.environ.get(\\\"DROID_DSH_BRIDGE_FLEET\\\", \\\"\\\") or str(ROOT / \\\"fleet.json\\\")\\nserver.py:146:ENV_MODEL = os.environ.get(\\\"DROID_DSH_BRIDGE_MODEL\\\", \\\"\\\").strip()\\nserver.py:147:IMAGE_PROBE = os.environ.get(\\\"DROID_DSH_BRIDGE_IMAGE_PROBE\\\", \\\"\\\") == \\\"1\\\"\\nserver.py:149:MAX_CONCURRENT = int(os.environ.get(\\\"DROID_DSH_BRIDGE_MAX_CONCURRENT\\\", \\\"4\\\"))\\nserver.py:150:QUEUE_TIMEOUT_S = int(os.environ.get(\\\"DROID_DSH_BRIDGE_QUEUE_TIMEOUT\\\", \\\"900\\\"))\\nserver.py:151:TIMEOUT_S = int(os.environ.get(\\\"DROID_DSH_BRIDGE_TIMEOUT\\\", \\\"1800\\\"))\\nserver.py:152:KEEPALIVE_S = min(10.0, float(os.environ.get(\\\"DROID_DSH_BRIDGE_KEEPALIVE\\\", \\\"10\\\")))\\nserver.py:154:    os.environ.get(\\\"DROID_DSH_BRIDGE_IDLE_TIMEOUT_S\\\", str(int(DEFAULT_IDLE_TIMEOUT_S)))\\nserver.py:157:    os.environ.get(\\\"DROID_DSH_BRIDGE_SAFETY_CAP_S\\\", str(int(DEFAULT_SAFETY_CAP_S)))\\nserver.py:269:IDLE_SECONDS = float(os.environ.get(\\\"DROID_DSH_BRIDGE_IDLE_SECONDS\\\", \\\"2700\\\"))\\nserver.py:291:# образа; `DROID_DSH_BRIDGE_RECEIPT_REQUIRED=0` отключает gate (только стенд/разработка).\\nserver.py:292:RECEIPT_REQUIRED = os.environ.get(\\\"DROID_DSH_BRIDGE_RECEIPT_REQUIRED\\\", \\\"1\\\") != \\\"0\\\"\\nserver.py:329:INSTR_BLOCK_LIMIT = int(os.environ.get(\\\"DROID_DSH_BRIDGE_INSTR_LIMIT\\\", \\\"60000\\\"))\\nserver.py:333:    os.environ.get(\\\"DROID_DSH_BRIDGE_INSTR_MARGIN\\\", str(b_guard.LINE_MARGIN_MIN))\\nserver.py:335:GUARD_TICK_S = float(os.environ.get(\\\"DROID_DSH_BRIDGE_GUARD_TICK\\\", \\\"30\\\"))\\nserver.py:337:    \\\"DROID_DSH_BRIDGE_PROFILES_DIR\\\", b_guard.PROFILES_DIR\\nserver.py:339:GUARD_CANON = os.environ.get(\\\"DROID_DSH_BRIDGE_CANON\\\", b_guard.CANON_PATH)\\nserver.py:411:    env.pop(\\\"DROID_DSH_BRIDGE_KEY\\\", None)\\nserver.py:3832:            \\\"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\\\", \\\"true\\\"\\nserver.py:5941:        sys.stderr.write(\\\"DROID_DSH_BRIDGE_KEY is required; refusing to start\\\\n\\\")\\nbridges/muse-bridge/server.py:382:    return os.environ.get(\\\"BRIDGE_ENABLE_DETACHED_TURNS\\\", \\\"1\\\") not in (\\nbridges/muse-bridge/server.py:390:    return os.environ.get(\\\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\\\", \\\"1\\\") not in (\\nbridges/muse-bridge/server.py:398:    return os.environ.get(\\\"BRIDGE_ENABLE_GRACEFUL_DRAIN\\\", \\\"1\\\") not in (\\nadapters/muse_adapter.py:392:        env.pop(\\\"DROID_DSH_BRIDGE_KEY\\\", None)\\nadapters/muse_adapter.py:598:            \\\"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\\\", \\\"true\\\"\\n\",\n  \"original_output_bytes\": 11789,\n  \"original_output_tokens\": 2948,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
