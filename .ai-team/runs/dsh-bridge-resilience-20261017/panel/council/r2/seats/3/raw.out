{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c513","stream":{"kind":"session","id":"01a14b74-03fb-7d03-878f-dfaf07bafb31"},"sequence":228,"recorded_at":1780531400000451,"record_type":"event","durability":"durable","causation_id":"01a14b74-0c73-7f61-b488-8792254708ab","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a14b74-0c73-7f61-b488-8792254708ab","run_stream":{"kind":"run","id":"01a14b74-0c73-7f61-b488-8792254708ab"},"task_stream":{"kind":"task","id":"01a14b75-485b-79c2-a48b-784290283519"},"task_id":"01a14b75-485b-79c2-a48b-784290283519","event":{"kind":"output","task_id":"01a14b75-485b-79c2-a48b-784290283519","chunk":"{\n  \"chunk_id\": \"exec-8-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && sed -n '107,150p' core/turn_session_manager.py; echo ---GLOBAL---; grep -n \\\"MAX_BUFFERED_TURNS\\\\|MAX_TURN_BUFFER_TOTAL\\\" core/turn_session_manager.py; echo ---TOOLCALLCAP---; grep -n \\\"tool_calls\\\" core/turn_session_manager.py | head -n 20; echo ---RUNTESTS---; python3 -m pytest tests/test_turn_cancel_and_gap.py tests/test_adaptive_idle_watchdog.py -q 2>&1 | tail -n 20\",\n  \"description\": \"Verify flags global caps tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"def _is_detached_enabled() -> bool:\\n    \\\"\\\"\\\"Проверяет флаг включения фонового доведения ходов (`BRIDGE_DETACHED_TURNS_ENABLED` / `DSH_BRIDGE_DETACHED_ENABLED`).\\\"\\\"\\\"\\n    val = os.environ.get(\\n        \\\"BRIDGE_DETACHED_TURNS_ENABLED\\\",\\n        os.environ.get(\\n            \\\"BRIDGE_ENABLE_DETACHED_TURNS\\\",\\n            os.environ.get(\\\"DSH_BRIDGE_DETACHED_ENABLED\\\", \\\"true\\\"),\\n        ),\\n    )\\n    return str(val).strip().lower() not in (\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\")\\n\\n\\ndef _is_watchdog_enabled() -> bool:\\n    \\\"\\\"\\\"Проверяет флаг включения адаптивного watchdog (`BRIDGE_ADAPTIVE_WATCHDOG_ENABLED` / `DSH_BRIDGE_WATCHDOG_ENABLED`).\\\"\\\"\\\"\\n    val = os.environ.get(\\n        \\\"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\\\",\\n        os.environ.get(\\n            \\\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\\\",\\n            os.environ.get(\\\"DSH_BRIDGE_WATCHDOG_ENABLED\\\", \\\"true\\\"),\\n        ),\\n    )\\n    return str(val).strip().lower() not in (\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\")\\n\\n\\ndef _is_drain_enabled() -> bool:\\n    \\\"\\\"\\\"Проверяет флаг включения неблокирующего drain (`BRIDGE_DRAIN_ON_SHUTDOWN` / `DSH_BRIDGE_DRAIN_ENABLED`).\\\"\\\"\\\"\\n    val = os.environ.get(\\n        \\\"BRIDGE_DRAIN_ON_SHUTDOWN\\\",\\n        os.environ.get(\\n            \\\"BRIDGE_ENABLE_GRACEFUL_DRAIN\\\",\\n            os.environ.get(\\\"DSH_BRIDGE_DRAIN_ENABLED\\\", \\\"true\\\"),\\n        ),\\n    )\\n    return str(val).strip().lower() not in (\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\")\\n\\n\\n\\ndef verify_bearer_token(provided: str | None, expected: str | None) -> bool:\\n    \\\"\\\"\\\"Константная по времени сверка Bearer-токена (`hmac.compare_digest`).\\\"\\\"\\\"\\n    if not expected:\\n        return True\\n    if not provided or not isinstance(provided, str):\\n        return False\\n    return hmac.compare_digest(provided.encode(\\\"utf-8\\\"), expected.encode(\\\"utf-8\\\"))\\n---GLOBAL---\\n11:  `MAX_TURN_BUFFER_TOTAL_BYTES = 128 МиБ` / `MAX_BUFFERED_TURNS = 128` глобально.\\n55:MAX_BUFFERED_TURNS: int = 128\\n56:MAX_TURN_BUFFER_TOTAL_BYTES: int = 128 * 1024 * 1024\\n824:        max_buffered_turns: int = MAX_BUFFERED_TURNS,\\n825:        max_total_buffer_bytes: int = MAX_TURN_BUFFER_TOTAL_BYTES,\\n---TOOLCALLCAP---\\n319:                            \\\"delta\\\": {\\\"tool_calls\\\": [call_dict]},\\n417:        self.tool_calls: list[dict[str, Any]] = []\\n490:                self.tool_calls.append(call_dict)\\n758:            tool_calls = list(self.buffer.tool_calls)\\n759:            if not tool_calls and self.result is not None and self.result.tool_calls:\\n760:                tool_calls = [asdict(tc) for tc in self.result.tool_calls]\\n776:                \\\"tool_calls\\\": tool_calls,\\n1450:                    \\\"tool_calls\\\": list(turn.buffer.tool_calls),\\n1462:            had_tool_calls = bool(turn.buffer.tool_calls)\\n1471:                    elif ev.kind == \\\"tool_call\\\" and not had_tool_calls:\\n1483:                    if not had_tool_calls:\\n1484:                        for tc in final_res.tool_calls or ():\\n1510:                        \\\"tool_calls\\\" if final_res.tool_calls else \\\"stop\\\"\\n1554:                \\\"tool_calls\\\": [asdict(call) for call in final_res.tool_calls],\\n1634:                        tool_calls=raw_res.tool_calls,\\n---RUNTESTS---\\n/opt/homebrew/opt/python@3.14/bin/python3.14: No module named pytest\\n\",\n  \"original_output_bytes\": 3276,\n  \"original_output_tokens\": 819,\n  \"truncated\": false\n}","final_result":true}}}
