eAdapter(BackendAdapter):\n279|                 f\"muse pump failed: {type(exc).__name__}: {str(exc)[:MAX_ERR_CHARS]}\"\n280|             )\n281|         finally:\n282|+            timeout_ctrl.close()\n283|             if proc is not None:\n284|                 # Владение начинается сразу после Popen: даже отказ первого Thread.start\n285|                 # не может обойти kill/wait. Реестр и слот освобождаются ПОСЛЕ группы.\n286|@@ -756,6 +831,8 @@ class MuseAdapter(BackendAdapter):\n287|         err = \"\\n\".join(events.errors + err_lines)[-1000:]\n288|         if events.reason:\n289|             err = (err + f\"\\nreason: {events.reason}\").strip()\n290|+        if flags.get(\"cancelled\"):\n291|+            return self._result(\"cancelled\", 1, err=\"turn cancelled by user\")\n292|         if flags.get(\"client_gone\"):\n293|             return self._result(\"client_gone\", 1)\n294|         if flags.get(\"timeout\"):\n295|@@ -779,6 +856,7 @@ class MuseAdapter(BackendAdapter):\n296|             return self._result(\"backend_error\", rc, err=err)\n297|         return self._result(\"done\", 0, text=events.text, err=err, prompt=prompt)\n298| \n299|+\n300|     def shutdown(self) -> None:\n301|         \"\"\"Убить группы процессов собственных детей (только свои PID из реестра адаптера).\"\"\"\n302|         self._shutting_down = True\n303|diff --git a/bridges/muse-bridge/server.py b/bridges/muse-bridge/server.py\n304|index 2b010b5..ff19017 100644\n305|--- a/bridges/muse-bridge/server.py\n306|+++ b/bridges/muse-bridge/server.py\n307|@@ -57,13 +57,27 @@ from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n308| from pathlib import Path\n309| from typing import Any, NamedTuple\n310| \n311|+_REPO_ROOT = Path(__file__).resolve().parents[2]\n312|+if str(_REPO_ROOT) not in sys.path:\n313|+    sys.path.insert(0, str(_REPO_ROOT))\n314|+\n315|+from core.backend_adapter import ToolCall, TurnResult, Usage  # noqa: E402\n316|+from core.lifecycle import HubLifecycleManager  # noqa: E402\n317|+from core.turn_session_manager import (  # noqa: E402\n318|+    GapDetectedError,\n319|+    ManagedTurn,\n320|+    TurnSessionManager,\n321|+    validate_turn_id,\n322|+)\n323|+\n324| logger = logging.getLogger(\"muse-bridge\")\n325| \n326| HOST = os.environ.get(\"MUSE_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\n327| PORT = int(os.environ.get(\"MUSE_BRIDGE_PORT\", \"9886\"))\n328| AUTH_KEY = os.environ.get(\"MUSE_BRIDGE_KEY\", \"\").strip()\n329| \n330|-TIMEOUT_S = float(os.environ.get(\"MUSE_BRIDGE_TIMEOUT_S\", \"1800\"))\n331|+TIMEOUT_S = float(os.environ.get(\"MUSE_BRIDGE_TIMEOUT_S\", \"3600\"))\n332|+IDLE_TIMEOUT_S = float(os.environ.get(\"MUSE_BRIDGE_IDLE_TIMEOUT_S\", \"300\"))\n333| MAX_CONCURRENT = int(os.environ.get(\"MUSE_BRIDGE_MAX_CONCURRENT\", \"2\"))\n334| \n335| MUSE_WRAPPER = os.environ.get(\n336|@@ -145,7 +159,7 @@ TRANSIENT_RETRY_SCOPE = os.environ.get(\n337| ).strip()\n338| FINISH_RESERVE_S = 35.0\n339| CLOSE_RESERVE_S = 12.0\n340|-REQUEST_CAP_S = 1800.0\n341|+REQUEST_CAP_S = 3600.0\n342| MIN_ATTEMPT_REMAINING_S = float(os.environ.get(\"MUSE_BRIDGE_MIN_ATTEMPT_S\", \"120\"))\n343| CONTROL_WRITE_TIMEOUT_S = 5.0\n344| LIVE_WRITE_TIMEOUT_S = 3.0\n345|@@ -364,11 +378,54 @@ def _log(msg: str) -> None:\n346|         pass\n347| \n348| \n349|-def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n350|-    hdr = handler.headers.get(\"Authorization\", \"\")\n351|+def _is_detached_enabled() -> bool:\n352|+    return os.environ.get(\"BRIDGE_ENABLE_DETACHED_TURNS\", \"1\") not in (\n353|+        \"0\",\n354|+        \"false\",\n355|+        \"False\",\n356|+    )\n357|+\n358|+\n359|+def _is_watchdog_enabled() -> bool:\n360|+    return os.environ.get(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", \"1\") not in (\n361|+        \"0\",\n362|+        \"false\",\n363|+        \"False\",\n364|+    )\n365|+\n366|+\n367|+def _is_drain_enabled() -> bool:\n368|+    return os.environ.get(\"BRIDGE_ENABLE_GRACEFUL_DRAIN\", \"1\") not in (\n369|+        \"0\",\n370|+        \"false\",\n371|+        \"False\",\n372|+    )\n373|+\n374|+\n375|+def _extract_auth_token(handler: BaseHTTPRequestHandler) -> str:\n376|+    hdrs = getattr(handler, \"headers\", None) or {}\n377|+    hdr = hdrs.get(\"Authorization\", \"\")\n378|     if hdr.startswith(\"Bearer \"):\n379|-        return hdr[7:].strip() == AUTH_KEY\n380|-    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n381|+        return hdr[7:].strip()\n382|+    return hdrs.get(\"x-api-key\", \"\") or hdr.strip()\n383|+\n384|+\n385|+def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n386|+    return _extract_auth_token(handler) == AUTH_KEY\n387|+\n388|+\n389|+def _owner_token_hash(handler: BaseHTTPRequestHandler) -> str:\n390|+    tok = _extract_auth_token(handler) or AUTH_KEY or \"anon\"\n391|+    return hashlib.sha256(tok.encode(\"utf-8\", \"replace\")).hexdigest()\n392|+\n393|+\n394|+TURN_MANAGER = TurnSessionManager(state_root=WORKSPACE / \"turns\", log_fn=_log)\n395|+LIFECYCLE = HubLifecycleManager(turn_manager=TURN_MANAGER, log_fn=_log)\n396|+\n397|+\n398|+def _reset_state() -> None:\n399|+    TURN_MANAGER.reset()\n400|+    LIFECYCLE.reset_for_tests()\n401| \n402| \n403| def _redact_secrets(text: str) -> str:\n404|@@ -1365,7 +1422,7 @@ SSE_CHUNK_DELAY_S = float(os.environ.get(\"MUSE_BRIDGE_SSE_CHUNK_DELAY_S\", \"0.005\n405| # stream=true: заголовки и role-кадр уходят сразу, пока ход идёт — комментарии keepalive.\n406| # Без них клиент (OpenAI SDK в DeepSeek Harness) ждал заголовков до своего таймаута\n407| # (~600 с) и рвал долгий ход как \"Request timed out\".\n408|-KEEPALIVE_S = float(os.environ.get(\"MUSE_BRIDGE_KEEPALIVE_S\", \"15\"))\n409|+KEEPALIVE_S = min(10.0, float(os.environ.get(\"MUSE_BRIDGE_KEEPALIVE_S\", \"10\")))\n410| \n411| \n412| def _split_sse_chunks(text: str, size: int = 0) -> list[str]:\n413|@@ -1532,6 +1589,7 @@ class Run:\n414|         self.approval_seen = False\n415|         self.observed_barrier = False\n416|         self.exec_deadline = float(\"inf\")\n417|+        self.managed_turn: ManagedTurn | None = None\n418| \n419|     def close(self) -> None:\n420|         \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n421|@@ -1637,6 +1695,13 @@ class Run:\n422|                     \"err\": f\"spawn failed: {exc}\",\n423|                     \"state\": \"spawn_failed\",\n424|                 }\n425|+            if self.managed_turn is not None:\n426|+                self.managed_turn.bind_process(\n427|+                    pgid=self.proc.pid, terminate_fn=self.close\n428|+                )\n429|+                TURN_MANAGER.register_child_pgid(\n430|+                    self.proc.pid, backend=\"muse\", turn_id=self.managed_turn.turn_id\n431|+                )\n432|             self.action_possible = True\n433| \n434|             def drain_stderr() -> None:\n435|@@ -1674,6 +1739,8 @@ class Run:\n436|                         continue\n437|                     if not isinstance(event, dict):\n438|                         continue\n439|+                    if self.managed_turn is not None:\n440|+                        self.managed_turn.touch_activity(\"protocol\")\n441|                     ptype = str(event.get(\"payload_type\") or \"\")\n442|                     raw_payload = event.get(\"payload\")\n443|                     payload: dict[str, Any] = (\n444|@@ -1822,6 +1889,7 @@ class ServeRun:\n445|         self.request_deadline = float(\"inf\")\n446|         self.turn_started_at: float | None = None\n447|         self._live_frozen = False\n448|+        self.managed_turn: ManagedTurn | None = None\n449|         # Сквозной live-стриминг всех шагов (ADR-0004): аккумулятор по\n450|         # составному ключу (item_id, idx), единый append-only stream-текст\n451|         # для live/final/flush (S2), доступ — только под _acc_lock (S3).\n452|@@ -2014,6 +2082,13 @@ class ServeRun:\n453|         except OSError as exc:\n454|             raise ServeUnavailable(f\"serve spawn failed: {exc}\")\n455|         assert self.proc.stdout is not None and self.proc.stdin is not None\n456|+        if self.managed_turn is not None:\n457|+            self.managed_turn.bind_process(\n458|+                pgid=self.proc.pid, terminate_fn=self.close\n459|+            )\n460|+            TURN_MANAGER.register_child_pgid(\n461|+                self.proc.pid, backend=\"muse\", turn_id=self.managed_turn.turn_id\n462|+            )\n463|         # stdin неблокирующий: запись идёт срезами с дедлайном (см. _send).\n464|         os.set_blocking(self.proc.stdin.fileno(), False)\n465| \n466|@@ -2051,6 +2126,9 @@ class ServeRun:\n467| \n468|         def read_msg(timeout_at: float) -> dict[str, Any]:\n469|             while time.monotonic() < timeout_at:\n470|+                if self.managed_turn is not None and self.managed_turn.cancel_event.is_set():\n471|+                    self.close()\n472|+                    raise ServeUnavailable(\"turn cancelled\")\n473|                 if self.proc is None or self.proc.stdout is None:\n474|                     raise ServeUnavailable(\"serve stdout closed\")\n475|                 newline = rbuf.find(b\"\\n\")\n476|@@ -2083,6 +2161,8 @@ class ServeRun:\n477|                 except ValueError:\n478|                     continue\n479|                 if isinstance(msg, dict):\n480|+                    if self.managed_turn is not None:\n481|+                        self.managed_turn.touch_activity(\"protocol\")\n482|                     return msg\n483|             raise ServeUnavailable(\"serve read timeout\")\n484| \n485|@@ -2643,6 +2723,8 @@ class Handler(BaseHTTPRequestHandler):\n486|     # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n487|     _client_gone: bool = False\n488|     _current_run: Run | ServeRun | None = None\n489|+    _active_managed_turn: ManagedTurn | None = None\n490|+    _detach_on_disconnect: bool = False\n491|     # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n492|     _sse_open: bool = False\n493|     _content_started: bool = False\n494|@@ -2669,6 +2751,8 @@ class Handler(BaseHTTPRequestHandler):\n495|         # Состояние обрыва клиента и ссылка на текущий ход — на каждое соединение.\n496|         self._client_gone = False\n497|         self._current_run = None\n498|+        self._active_managed_turn = None\n499|+        self._detach_on_disconnect = False\n500|         self._sse_open = False\n(more lines below)","final_result":true}}}
