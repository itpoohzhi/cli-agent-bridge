stderr is not None\n206|             child = proc\n207|@@ -617,24 +661,51 @@ class MuseAdapter(BackendAdapter):\n208|             leader_exited: list[float] = []\n209| \n210|             def watch() -> None:\n211|-                deadline = time.monotonic() + timeout_s\n212|                 last_ka = time.monotonic()\n213|+                seeded = False\n214|+                detached = False\n215|                 while not done.wait(0.25):\n216|                     now = time.monotonic()\n217|+                    if not seeded:\n218|+                        seeded = True\n219|+                        timeout_ctrl.register_pgid(child.pid)\n220|+                    if cancel_ev is not None and cancel_ev.is_set():\n221|+                        flags[\"cancelled\"] = True\n222|+                        self._kill_group(child)\n223|+                        return\n224|                     if child.poll() is not None:\n225|                         if not leader_exited:\n226|                             leader_exited.append(now)\n227|                         if now - leader_exited[0] >= STDERR_DRAIN_GRACE_S:\n228|                             self._kill_group(child)\n229|                             return\n230|-                    elif now > deadline:\n231|-                        flags[\"timeout\"] = True\n232|-                    elif callable(gone) and gone():\n233|-                        flags[\"client_gone\"] = True\n234|-                    elif callable(keepalive) and now - last_ka >= keepalive_s:\n235|-                        last_ka = now\n236|-                        if not keepalive():\n237|-                            flags[\"client_gone\"] = True\n238|+                    else:\n239|+                        should_stop, wd_reason, _ = timeout_ctrl.check(child.pid)\n240|+                        if should_stop and wd_reason in (\n241|+                            \"idle_timeout\",\n242|+                            \"absolute_cap\",\n243|+                        )