              if detach_ok:\n247|+                                detached = True\n248|+                                if callable(ctx.on_activity):\n249|+                                    ctx.on_activity(\"detached\")\n250|+                            else:\n251|+                                flags[\"client_gone\"] = True\n252|+                        elif (\n253|+                            not detached\n254|+                            and callable(keepalive)\n255|+                            and now - last_ka >= keepalive_s\n256|+                        ):\n257|+                            last_ka = now\n258|+                            if not keepalive():\n259|+                                if detach_ok:\n260|+                                    detached = True\n261|+                                    if callable(ctx.on_activity):\n262|+                                        ctx.on_activity(\"detached\")\n263|+                                else:\n264|+                                    flags[\"client_gone\"] = True\n265|                     if flags:\n266|                         self._kill_group(child)\n267|                         return\n268|@@ -705,6 +776,9 @@ class MuseAdapter(BackendAdapter):\n269|                     line = bytes(pending[:size]).decode(\"utf-8\", \"strict\")\n270|                     del pending[:size]\n271|                     events.feed_line(line)\n272|+                    timeout_ctrl.record_activity(\"protocol\")\n273|+                    if callable(ctx.on_activity):\n274|+                        ctx.on_activity(\"protocol\")\n275|                     if events.text_bytes > MAX_TURN_TEXT_BYTES:\n276|                         raise ValueError(\"turn text exceeds the limit\")\n277|                 if len(pending) > MAX_LINE_BYTES:\n278|@@ -724,6 +798,7 @@ class MuseAdapter(BackendAdapter):\n279|                 f\"muse pump failed: {type(exc).__name__}: {str(exc)[:MAX_ERR_CHARS]}\"\n280|             )\n281|         finally