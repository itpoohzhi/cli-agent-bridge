#!/usr/bin/env python3
"""Validate panel-rework-brief.json before the coordinator accepts it.

Harness only: the contract lives in
~/Мой диск/skils/ai-sdlc/references/panel-rework-brief.md
Coordinator must run this and treat exit 0 as ACCEPT. Do not rewrite JSON here.

Optional --ledger <path>: every F-NNN of the ledger (ids from `### F-NNN` headings or
`- **id:** F-NNN` bullets only, not prose) must be covered exactly once by the brief:
source_findings of instructions / non_blocking_followups, or excluded[].id (occurrences are
counted across all three: a second one anywhere is INVALID). Free-text
`source` does not cover. Every source_findings entry must be in the ledger. findings_total
must equal the ledger size. Without the flag the coverage checks are skipped.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import Counter
from pathlib import Path
from typing import Any

SCHEMA_VERSION = "1.0"
# F-NNN / F-C11-02 и т.п.; без привязки к «хвосту» слова (DIFF-1, RW-001 не матчатся).
FINDING_ID_RE = re.compile(r"(?<![A-Za-z0-9_-])F-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![A-Za-z0-9_])")
FINDING_ID_PLACEHOLDERS = {"F-NNN"}
# Находки леджера: только заголовки `## F-NNN`..`#### F-NNN` и пункты `- **id:** F-NNN`;
# F-id в прозе (duplicate_of:F-001, закрытые находки прошлых циклов) не находки цикла.
LEDGER_ID_RE = re.compile(
    r"^(?:#{2,4}\s+|\s*-\s*\*\*id:\*\*\s*)(F-[A-Z0-9]+(?:-[A-Z0-9]+)*)(?![A-Za-z0-9_])",
    re.MULTILINE,
)
EXCLUDED_REASONS = {"invalid_after_recheck", "out_of_scope", "foreign_key"}
DUPLICATE_OF_RE = re.compile(r"^duplicate_of:(F-[A-Z0-9]+(?:-[A-Z0-9]+)*)$")
REQUIRED_TOP = (
    "schema_version",
    "run_id",
    "teamlead_cycle",
    "panel_slug",
    "panel_verdict",
    "summarizer_slot",
    "instructions",
    "non_blocking_followups",
    "do_not_change",
    "coder_entry",
    "iteration_budget_note",
)
REQUIRED_INSTRUCTION = (
    "id",
    "priority",
    "criterion",
    "file",
    "line_hint",
    "rule_ref",
    "action",
    "acceptance",
    "source",
    "evidence",
)
REQUIRED_FOLLOWUP = ("id", "text", "reason")
REQUIRED_EXCLUDED = ("id", "reason")
CRITERIA = {
    "КОРРЕКТНОСТЬ",
    "ПОЛНОТА",
    "РЕАЛИЗУЕМОСТЬ",
    "РИСКИ",
    "АЛЬТЕРНАТИВЫ",
    "СООТВЕТСТВИЕ КОНТЕКСТУ",
}


class ValidationError(ValueError):
    """Brief violates the panel-rework-brief contract."""


def fail(message: str) -> None:
    raise ValidationError(message)


def require_object(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        fail(f"{label}: expected object, got {type(value).__name__}")
    return value


def require_list(value: Any, label: str) -> list[Any]:
    if not isinstance(value, list):
        fail(f"{label}: expected array, got {type(value).__name__}")
    return value


def require_string(data: dict[str, Any], key: str, *, label: str | None = None) -> str:
    name = label or key
    value = data.get(key)
    if not isinstance(value, str) or not value.strip():
        fail(f"{name}: expected nonempty string")
    return value


def load_single_object(path: Path) -> dict[str, Any]:
    raw = path.read_text(encoding="utf-8")
    stripped = raw.lstrip()
    if stripped.startswith("```"):
        fail("file starts with a markdown fence; write raw JSON only")
    decoder = json.JSONDecoder()
    try:
        data, index = decoder.raw_decode(raw)
    except json.JSONDecodeError as exc:
        fail(f"not JSON: {exc}")
    leftover = raw[index:].strip()
    if leftover:
        fail(
            "extra data after the first JSON value "
            f"(starts {leftover[:40]!r}). Write exactly one object; "
            "do not concatenate retry output"
        )
    return require_object(data, "root")


def extract_finding_ids(text: str) -> set[str]:
    return {
        found for found in LEDGER_ID_RE.findall(text) if found not in FINDING_ID_PLACEHOLDERS
    }


def read_ledger_ids(path: Path) -> set[str]:
    if not path.is_file():
        fail(f"ledger not found: {path}")
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        fail(f"ledger is not utf-8: {exc}")
    ids = extract_finding_ids(text)
    if not ids:
        fail(f"ledger has no F-NNN ids: {path}")
    return ids


def validate_source_findings(
    data: dict[str, Any], label: str, *, ledger_ids: set[str] | None = None
) -> None:
    value = data.get("source_findings")
    if value is None:
        return
    for index, item in enumerate(require_list(value, f"{label}.source_findings")):
        if not isinstance(item, str) or not item.strip():
            fail(f"{label}.source_findings[{index}]: expected nonempty string")
        if ledger_ids is None:
            continue
        if not FINDING_ID_RE.fullmatch(item.strip()) or item.strip() in FINDING_ID_PLACEHOLDERS:
            fail(f"{label}.source_findings[{index}]: expected F-NNN, got {item!r}")
        if item.strip() not in ledger_ids:
            fail(f"{label}.source_findings[{index}]: {item.strip()} is not in the ledger")


def validate_excluded(value: Any, ledger_ids: set[str] | None = None) -> None:
    seen: set[str] = set()
    for index, item in enumerate(require_list(value, "excluded")):
        label = f"excluded[{index}]"
        data = require_object(item, label)
        missing = [key for key in REQUIRED_EXCLUDED if key not in data]
        if missing:
            fail(f"{label}: missing {missing}")
        for key in REQUIRED_EXCLUDED:
            require_string(data, key, label=f"{label}.{key}")
        finding_id = data["id"].strip()
        if not finding_id.startswith("F-"):
            fail(f"{label}.id: expected F-NNN")
        if finding_id in seen:
            fail(f"{label}.id: {finding_id} listed twice in excluded")
        seen.add(finding_id)
        reason = data["reason"]
        duplicate = DUPLICATE_OF_RE.match(reason)
        if reason not in EXCLUDED_REASONS and not duplicate:
            fail(
                f"{label}.reason: expected one of {sorted(EXCLUDED_REASONS)} "
                f"or 'duplicate_of:F-NNN', got {reason!r}"
            )
        if duplicate:
            target = duplicate.group(1)
            if target == finding_id:
                fail(f"{label}.reason: {finding_id} cannot be a duplicate of itself")
            if ledger_ids is not None and target not in ledger_ids:
                fail(f"{label}.reason: duplicate_of target {target} is not in the ledger")


def covered_finding_ids(data: dict[str, Any]) -> set[str]:
    """F-NNN, учтённые брифом: только source_findings и excluded[].id (не текст source)."""
    covered: set[str] = set()
    for key in ("instructions", "non_blocking_followups"):
        for item in data[key]:
            covered.update(entry.strip() for entry in item.get("source_findings") or [])
    for item in data.get("excluded") or []:
        covered.add(item["id"].strip())
    return covered


def validate_single_placement(data: dict[str, Any]) -> None:
    """Каждый F-NNN — ровно одно вхождение по instructions/follow-ups source_findings и excluded[].id."""
    counts: Counter[str] = Counter()
    for key in ("instructions", "non_blocking_followups"):
        for item in data[key]:
            counts.update(entry.strip() for entry in item.get("source_findings") or [])
    counts.update(item["id"].strip() for item in data.get("excluded") or [])
    repeated = sorted(finding for finding, count in counts.items() if count > 1)
    if repeated:
        fail(
            "findings placed more than once "
            f"(instructions/follow-ups/excluded; need exactly one place): {repeated}"
        )


def validate_instruction(
    item: Any, index: int, *, ledger_ids: set[str] | None = None
) -> None:
    label = f"instructions[{index}]"
    data = require_object(item, label)
    missing = [key for key in REQUIRED_INSTRUCTION if key not in data]
    if missing:
        fail(f"{label}: missing {missing}")
    for key in REQUIRED_INSTRUCTION:
        require_string(data, key, label=f"{label}.{key}")
    if data["priority"] != "blocking":
        fail(f"{label}.priority: expected 'blocking', got {data['priority']!r}")
    if data["criterion"] not in CRITERIA:
        fail(f"{label}.criterion: expected one of {sorted(CRITERIA)}")
    if not data["id"].startswith("RW-"):
        fail(f"{label}.id: expected RW-NNN")
    validate_source_findings(data, label, ledger_ids=ledger_ids)
    related = data.get("related_locations")
    if related is not None:
        for loc_index, loc in enumerate(require_list(related, f"{label}.related_locations")):
            loc_obj = require_object(loc, f"{label}.related_locations[{loc_index}]")
            require_string(loc_obj, "file", label=f"{label}.related_locations[{loc_index}].file")
            require_string(
                loc_obj, "line_hint", label=f"{label}.related_locations[{loc_index}].line_hint"
            )


def validate_followup(item: Any, index: int, *, ledger_ids: set[str] | None = None) -> None:
    label = f"non_blocking_followups[{index}]"
    data = require_object(item, label)
    missing = [key for key in REQUIRED_FOLLOWUP if key not in data]
    if missing:
        fail(f"{label}: missing {missing}")
    for key in REQUIRED_FOLLOWUP:
        require_string(data, key, label=f"{label}.{key}")
    if not data["id"].startswith("FU-"):
        fail(f"{label}.id: expected FU-NNN")
    if data.get("decision_required_human") not in (None, True, False):
        fail(f"{label}.decision_required_human: expected bool")
    validate_source_findings(data, label, ledger_ids=ledger_ids)


def validate_instruction_files(data: dict[str, Any], repo_root: Path | None) -> None:
    if repo_root is None:
        return
    for idx, item in enumerate(data.get("instructions", [])):
        file_path = repo_root / item["file"]
        if not file_path.is_file():
            fail(f"instructions[{idx}].file: target file does not exist on disk: {item['file']}")


def validate_brief(
    data: dict[str, Any],
    *,
    expected_slot: str | None,
    ledger_ids: set[str] | None = None,
    repo_root: Path | None = None,
) -> None:
    missing = [key for key in REQUIRED_TOP if key not in data]
    if missing:
        fail(f"missing top-level keys: {missing}")
    if require_string(data, "schema_version") != SCHEMA_VERSION:
        fail(f"schema_version: expected {SCHEMA_VERSION!r}")
    require_string(data, "run_id")
    cycle = data["teamlead_cycle"]
    if not isinstance(cycle, int) or isinstance(cycle, bool) or cycle < 1:
        fail("teamlead_cycle: expected integer >= 1")
    require_string(data, "panel_slug")
    if require_string(data, "panel_verdict") != "NEEDS_WORK":
        fail("panel_verdict: expected 'NEEDS_WORK'")
    slot = require_string(data, "summarizer_slot")
    if expected_slot and slot != expected_slot:
        fail(f"summarizer_slot: expected {expected_slot!r}, got {slot!r}")
    if require_string(data, "coder_entry") != "fix-from-panel":
        fail("coder_entry: expected 'fix-from-panel'")
    require_string(data, "iteration_budget_note")
    instructions = require_list(data["instructions"], "instructions")
    followups = require_list(data["non_blocking_followups"], "non_blocking_followups")
    do_not = require_list(data["do_not_change"], "do_not_change")
    if not instructions:
        fail("instructions: NEEDS_WORK brief must have at least one blocking item")
    for index, item in enumerate(instructions):
        validate_instruction(item, index, ledger_ids=ledger_ids)
    validate_instruction_files(data, repo_root)
    for index, item in enumerate(followups):
        validate_followup(item, index, ledger_ids=ledger_ids)
    if not do_not:
        fail("do_not_change: expected nonempty array of strings")
    for index, item in enumerate(do_not):
        if not isinstance(item, str) or not item.strip():
            fail(f"do_not_change[{index}]: expected nonempty string")
    if data.get("decision_required_human") not in (None, True, False):
        fail("decision_required_human: expected bool")
    if "excluded" in data:
        validate_excluded(data["excluded"], ledger_ids)
    total = data.get("findings_total")
    if total is not None and (not isinstance(total, int) or isinstance(total, bool) or total < 0):
        fail("findings_total: expected integer >= 0")
    if ledger_ids is not None:
        validate_single_placement(data)
        missing_ids = ledger_ids - covered_finding_ids(data)
        if missing_ids:
            fail(f"uncovered ledger findings: {sorted(missing_ids)}")
        if total != len(ledger_ids):
            fail(f"findings_total: expected {len(ledger_ids)} (ledger size), got {total!r}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("brief", type=Path)
    parser.add_argument(
        "--expected-slot",
        default=None,
        help="summarizer_slot that was launched; mismatch is INVALID",
    )
    parser.add_argument(
        "--ledger",
        type=Path,
        default=None,
        help=(
            "findings-ledger: every F-NNN of its `### F-NNN` headings must appear exactly once "
            "in source_findings or excluded[].id exactly once (a repeat anywhere is INVALID), "
            "every source_findings entry must be in the ledger, and findings_total must equal their count; "
            "without the flag the coverage checks are skipped"
        ),
    )
    parser.add_argument(
        "--repo-root",
        type=Path,
        default=None,
        help="repository root: every instructions[].file must exist on disk under it",
    )
    args = parser.parse_args()
    try:
        if not args.brief.is_file():
            fail(f"file not found: {args.brief}")
        data = load_single_object(args.brief)
        ledger_ids = read_ledger_ids(args.ledger) if args.ledger else None
        validate_brief(
            data,
            expected_slot=args.expected_slot,
            ledger_ids=ledger_ids,
            repo_root=args.repo_root,
        )
    except (OSError, ValidationError) as exc:
        print(f"INVALID: {exc}", file=sys.stderr)
        return 1
    ledger_note = f" ledger_findings={len(ledger_ids)}" if ledger_ids is not None else ""
    print(
        f"VALID n_instructions={len(data['instructions'])} "
        f"n_followups={len(data['non_blocking_followups'])} "
        f"slot={data['summarizer_slot']}{ledger_note}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

