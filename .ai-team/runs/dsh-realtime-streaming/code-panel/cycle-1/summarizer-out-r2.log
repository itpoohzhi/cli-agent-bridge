+            if f is not None
+            and f.get("choices", [{}])[0].get("delta", {}).get("content")
+        ]
+        joined = "".join(f["choices"][0]["delta"]["content"] for f in content_frames)
+        self.assertEqual(joined, text)
+        self.assertTrue(wait_until(lambda: budget._used == 0))
