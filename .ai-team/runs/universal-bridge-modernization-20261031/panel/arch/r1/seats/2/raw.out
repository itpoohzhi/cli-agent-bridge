{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013s5QsVuHZcMtiwMszLnpS8","type":"tool_result","content":"112:BLOCK_LIMIT = 60000  # REQ-003, граница строгая: <= 60000 проходит\n190:def make_user_global(canon_size: int) -> FileEntry:\n195:def section_bytes(display: str, size: int) -> int:\n200:def estimate_block_bytes(n_sections: int, files_total: int) -> int:\n205:def marker_text(\n220:def _marker_bytes(marker: str) -> int:\n223:        return 0\n227:def _block(entries: Sequence[FileEntry], marker: str) -> int:\n230:        return 0\n238:def dedupe_entries(entries: Sequence[FileEntry]) -> List[FileEntry]:\n257:def _canon_copies(kept: Sequence[FileEntry]) -> int:\n262:def render_plan(entries: Sequence[FileEntry], maxbytes: int) -> RenderResult:\n320:def block_within_limit(block_bytes: int) -> bool:\n322:    return block_bytes <= BLOCK_LIMIT\n325:def journal_line_bytes_est(text: str) -> int:\n337:def render_block_text(sections: Sequence[Tuple[str, str]], marker: str = \"\") -> str:\n351:def _change_entry(display: str, text: str) -> Dict[str, str]:\n365:def _baseline_identity(maxbytes: int) -> str:\n380:def render_journal_line(\n405:def exact_journal_line_bytes(\n413:def journal_line_bytes_fallback(\n424:def _line_estimate(\n447:def evaluate(\n510:        margin = BLOCK_LIMIT - line_est\n512:        if not block_within_limit(rend.block_bytes):\n514:                \"REQ003_SIZE_EXCEEDED cwd=%s basis=block block=%d limit=%d\"\n515:                % (label, rend.block_bytes, BLOCK_LIMIT)\n519:        elif not block_within_limit(line_est):\n521:                \"REQ003_SIZE_EXCEEDED cwd=%s basis=line_estimate line_est=%d limit=%d\"\n522:                % (label, line_est, BLOCK_LIMIT)\n561:def recommend_maxbytes(window_low: int, window_high: Optional[int]) -> Optional[int]:\n582:def _find_project_root(cwd: str) -> str:\n594:def collect_cwd_entries(\n653:def _entries(canon: int, *project: Tuple[str, int, bool]) -> List[FileEntry]:\n661:def self_test() -> List[str]:\n709:    for value, ok in ((59999, True), (60000, True), (60001, False)):\n710:        if block_within_limit(value) != ok:\n711:            fails.append(\"граница 60000: %d -> %s\" % (value, not ok))\n746:def _say(message: str, stream=None) -> None:\n751:def _safe_stdout() -> None:\n758:def _fmt_margin(value: Optional[int]) -> str:\n762:def run_check(maxbytes: int, cwds: Sequence[Tuple[str, str]], canon_path: str) -> int:\n771:        return 2\n855:def _user_global_problem(canon_real: str, canon_bytes: bytes) -> Optional[str]:\n874:def check_installed(\n912:def parse_profile_maxbytes(text: str) -> Optional[int]:\n983:def find_profiles(profiles_dir: str) -> List[Tuple[str, str, Optional[int]]]:\n1004:def run_profiles(\n1014:        return 2\n1030:def build_parser() -> argparse.ArgumentParser:\n1069:def main(argv: Optional[Sequence[str]] = None) -> int:\n1078:        return 1 if fails else 0\n1094:    sys.exit(main())\n-----\n11:`DROID_DSH_BRIDGE_IDLE_SECONDS` (по умолчанию 2700 с), SID и файлы остаются, следующий\n21:Каталог моделей — `fleet.json` (env `DROID_DSH_BRIDGE_FLEET`): читается один раз\n32:DROID_DSH_BRIDGE_KEY (его подкладывает start.sh из ~/.dsh/.env); в окружение\n71:import b_guard  # noqa: E402  - охранник B: автоматический контур профилей DSH (RW-003)\n147:HOST = os.environ.get(\"DROID_DSH_BRIDGE_HOST\", \"127.0.0.1\")\n148:PORT = int(os.environ.get(\"DROID_DSH_BRIDGE_PORT\", \"9882\"))\n149:AUTH_KEY = os.environ.get(\"DROID_DSH_BRIDGE_KEY\", \"\").strip()\n154:    os.environ.get(\"DROID_DSH_BRIDGE_FLEET\", \"\") or str(ROOT / \"fleet.json\")\n156:ENV_MODEL = os.environ.get(\"DROID_DSH_BRIDGE_MODEL\", \"\").strip()\n157:IMAGE_PROBE = os.environ.get(\"DROID_DSH_BRIDGE_IMAGE_PROBE\", \"\") == \"1\"\n170:MAX_CONCURRENT = int(os.environ.get(\"DROID_DSH_BRIDGE_MAX_CONCURRENT\", \"4\"))\n171:QUEUE_TIMEOUT_S = int(os.environ.get(\"DROID_DSH_BRIDGE_QUEUE_TIMEOUT\", \"900\"))\n172:TIMEOUT_S = int(os.environ.get(\"DROID_DSH_BRIDGE_TIMEOUT\", \"1800\"))\n173:KEEPALIVE_S = min(10.0, float(os.environ.get(\"DROID_DSH_BRIDGE_KEEPALIVE\", \"10\")))\n175:    os.environ.get(\"DROID_DSH_BRIDGE_IDLE_TIMEOUT_S\", str(int(DEFAULT_IDLE_TIMEOUT_S)))\n178:    os.environ.get(\"DROID_DSH_BRIDGE_SAFETY_CAP_S\", str(int(DEFAULT_SAFETY_CAP_S)))\n336:IDLE_SECONDS = float(os.environ.get(\"DROID_DSH_BRIDGE_IDLE_SECONDS\", \"2700\"))\n358:# образа; `DROID_DSH_BRIDGE_RECEIPT_REQUIRED=0` отключает gate (только стенд/разработка).\n359:RECEIPT_REQUIRED = os.environ.get(\"DROID_DSH_BRIDGE_RECEIPT_REQUIRED\", \"1\") != \"0\"\n396:INSTR_BLOCK_LIMIT = int(os.environ.get(\"DROID_DSH_BRIDGE_INSTR_LIMIT\", \"60000\"))\n397:# Не-KB формы cwd (WA/AB/DW): допустимый блок = maxBytes профиля минус запас (матрица b_guard);\n400:    os.environ.get(\"DROID_DSH_BRIDGE_INSTR_MARGIN\", str(b_guard.LINE_MARGIN_MIN))\n402:GUARD_TICK_S = float(os.environ.get(\"DROID_DSH_BRIDGE_GUARD_TICK\", \"30\"))\n404:    \"DROID_DSH_BRIDGE_PROFILES_DIR\", b_guard.PROFILES_DIR\n406:GUARD_CANON = os.environ.get(\"DROID_DSH_BRIDGE_CANON\", b_guard.CANON_PATH)\n478:    env.pop(\"DROID_DSH_BRIDGE_KEY\", None)\n592:def _receipt_state() -> str:\n2548:    \"\"\"История канонов не записана на диск: без неё после рестарта старый KB-блок потерял бы предел 60000 (RW-011).\"\"\"\n2612:    root = os.path.realpath(b_guard.KB_CWD)\n2658:    \"\"\"Применимый предел блока: KB-форма (только канон) — INSTR_BLOCK_LIMIT, прочие — maxBytes минус запас.\"\"\"\n2660:        return INSTR_BLOCK_LIMIT\n2661:    return (max_bytes or b_guard.DEFAULT_MAXBYTES) - INSTR_NONKB_MARGIN\n2702:class InstructionGuard:\n2703:    \"\"\"Автоматический контур b_guard: фактические профили DSH и канон проверяются на старте и периодически.\n2728:        \"\"\"(состояние, причины, maxBytes, предупреждения b_guard).\"\"\"\n2729:        profiles = b_guard.find_profiles(GUARD_PROFILES_DIR)\n2752:            result = b_guard.check_installed(\n2753:                maxbytes, b_guard.DEFAULT_CWDS, GUARD_CANON\n2811:GU