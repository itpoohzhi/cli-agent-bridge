RD_CANON\nserver.py-2754-            )\nserver.py-2755-            if result is None:\nserver.py-2756-                reasons.append(f\"CANON_LOST profile={name}: canon is missing\")\nserver.py-2757-                unsafe = True\nserver.py-2758-            elif result.exit_code == 2:\nserver.py-2759-                reasons.extend(\n--\nserver.py-4925-    # ---- HTTP --------------------------------------------------------------------\nserver.py-4926-    def do_GET(self) -> None:  # noqa: N802\nserver.py-4927-        path = self.path.split(\"?\", 1)[0]\nserver.py-4928-        if path in (\"/health\", \"/v1/health\"):\nserver.py-4929-            # Контракт из семи ключей прежний (расширять запрещено); ok = AND по обязательным\nserver.py-4930-            # бэкендам (droid: невалидный receipt = spawn невозможен -> ok=false, RW-015),\nserver.py-4931-            # active и max_concurrent суммируются по включённым бэкендам.\nserver.py:4932:            required = [a for a in BACKENDS.adapters() if a.required]\nserver.py-4933-            draining = _shutting_down or (\nserver.py-4934-                _is_drain_enabled() and LIFECYCLE.is_draining()\nserver.py-4935-            )\nserver.py-4936-            self._send(\nserver.py-4937-                200,\nserver.py-4938-                {\nserver.py:4939:                    \"ok\": all(a.is_healthy() for a in required),\nserver.py-4940-                    \"transport\": \"droid-exec\",\nserver.py-4941-                    \"model\": MODEL_ID,\nserver.py-4942-                    \"active\": BACKENDS.active_total(),\nserver.py-4943-                    \"max_concurrent\": BACKENDS.max_concurrent_total(),\nserver.py-4944-                    \"tool_emulation\": True,\nserver.py-4945-                    \"uptime_s\": int(time.time() - _started),\nserver.py-4946-                },\n--\nserver.py-5283-                    model_len,\nserver.py-5284-                )\nserver.py-5285-                return\nserver.py-5286-            model = FLEET[\"models\"][model_id]\nserver.py-5287-            # (8a) passthrough (AD-003/AD-007): raw-шов ДО effort-клампа, транскрипции и контекста —\nserver.py-5288-            # model/reasoning_effort/tools/Authorization уходят upstream дословно.\nserver.py-5289-            passthrough = BACKENDS.get(model[\"backend\"])\nserver.py:5290:            if isinstance(passthrough, PassthroughAdapter):\nserver.py-5291-                if raw_model != model_id:\nserver.py-5292-                    self._reject(\nserver.py-5293-                        400,\nserver.py-5294-                        \"model_not_allowed\",\nserver.py-5295-                        \"passthrough requires an exact model id\",\nserver.py-5296-                    )\nserver.py-5297-                    return\n--\nserver.py-5828-                f\"wall_s={time.monotonic() - t0:.1f} \"\nserver.py-5829-                f\"err_bytes={len(str(out.get('err') or '').encode())} {ctx['tag']}\"\nserver.py-5830-            )\nserver.py-5831-        return out\nserver.py-5832-\nserver.py-5833-    def _serve_passthrough(\nserver.py-5834-        self,\nserver.py:5835:        adapter: PassthroughAdapter,\nserver.py-5836-        raw: bytes,\nserver.py-5837-        req: dict,\nserver.py-5838-        model_id: str,\nserver.py-5839-    ) -> None:\nserver.py-5840-        \"\"\"Passthrough-маршрут: шов пишет ответ клиенту сам (значения заголовков в журнал не идут).\"\"\"\nserver.py-5841-        _log(f\"passthrough route model={model_id} backend={adapter.id}\")\nserver.py-5842-        headers = {key: value for key, value in self.headers.items()}\n--\nserver.py-6293-        except OSError:\nserver.py-6294-            pass\nserver.py-6295-\nserver.py-6296-\nserver.py-6297-def main() -> None:\nserver.py-6298-    global _budget\nserver.py-6299-    if not AUTH_KEY:\nserver.py:6300:        sys.stderr.write(\"DROID_DSH_BRIDGE_KEY is required; refusing to start\\n\")\nserver.py-6301-        raise SystemExit(1)\nserver.py-6302-    _budget = _ByteBudget(int(FLEET[\"admission\"][\"max_inflight_body_bytes\"]))\nserver.py-6303-    try:\nserver.py-6304-        WORKSPACE.mkdir(parents=True, exist_ok=True)\nserver.py-6305-        writer_lock = acquire_writer_lock()\nserver.py-6306-    except OSError as exc:\nserver.py-6307-        # Каталог состояния чужой/недоступен/не 0700: старт отклоняется понятным сообщением, а не трассировкой.\n--\nfleet_check.py-127-    if not isinstance(cat, dict):\nfleet_check.py-128-        report.add(\"catalogue\", [\"каталог не является JSON-объектом\"])\nfleet_check.py-129-        return\nfleet_check.py-130-    try:\nfleet_check.py-131-        build_catalog(\nfleet_check.py-132-            cat,\nfleet_check.py-133-            ADAPTER_KINDS,\nfleet_check.py:134:            env_model=os.environ.get(\"DROID_DSH_BRIDGE_MODEL\", \"\").strip(),\nfleet_check.py:135:            image_probe=os.environ.get(\"DROID_DSH_BRIDGE_IMAGE_PROBE\") == \"1\",\nfleet_check.py-136-        )\nfleet_check.py-137-    except FleetViolation as exc:\nfleet_check.py-138-        report.add(\"catalogue\", [\"%s: %s\" % (exc.reason, exc.model)])\nfleet_check.py-139-        return\nfleet_check.py-140-    ids = [model[\"id\"] for model in cat[\"models\"]]\nfleet_check.py-141-    # Класс III — операционный census, не второй структурный валидатор:\nfleet_check.py-142-    # частичный proof допустим на старте, но не при публикации image-профилей.\n# AGENTS.md — cli-agent-bridge\n\nПроектные правила для агентов. Общие правила владельца — канон `~/Мой диск/Context/AGENTS.md` (здесь не дублируются).\n\n## ⭐ Главный архитектурный принцип: универсальность и независимость от вендоров\n\n1. **Максимальная универсальность:** все доработки делаются максимально универсальными, чтобы не зависеть от вендоров и сторонних сред исполнения.\n2. **Запрет на правку вендорского кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи во внешние вендорские приложения и среды (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену модулей в профилях (`~/.dsh/`, `~/.claude/` и т.п.).\n3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\n4. **Запрет на хардкод параметров (полная конфигурируемость):** категорически запрещено зашивать в коде константами любые эксплуатационные параметры — таймауты, интервалы опроса, пороги активности, лимиты шагов и размеры буферов памяти (текста ответа, reasoning и т.д.). Любые такие параметры просто переносим в настройки: они должны быть полностью настраиваемыми через переменные окружения и конфигурационные файлы с безопасными значениями по умолчанию в качестве fallback.\n\n## О проекте cli-agent-bridge\n\nУниверсальный шлюз (мост/фасад), объединяющий CLI-агентов и LLM различных провайдеров в единый OpenAI-совместимый эндпоинт (`POST /v1/chat/completions`, `GET /v1/models`, SSE-стриминг, `tools`/`tool_calls`).\n\n### Архитектурные слои\n- `server.py` — единый HTTP-фасад (OpenAI-compatible API, маршрутизация запросов, управление подключениями).\n- `core/` — универсальное ядро:\n  - `core/tool_emulation.py` — протокол и эмуляция function calling, парсинг и санитизация `<tool_call>`.\n  - `core/backend_adapter.py` — базовые абстракции и контракты адаптеров бэкендов.\n  - `core/turn_session_manager.py` — управление сессиями, контекстом и процессами.\n  - `core/context_resilience.py` — устойчивость к переполнению контекста и сжатие.\n- `adapters/` — адаптеры к конкретным CLI-транспортам и средам (Droid, Muse, Codex и др.).\n- `bridges/` — специализированные мосты (`agy-bridge`, `muse-bridge`, `opencode-zen-bridge`).\n\n## Верификация и тесты\n\nПеред фиксацией любых изменений запускать набор тестов:\n```bash\npytest tests/ -v\n```\nКод должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat start.sh; cat docs/adr/0014-*.md; python3 - <<'PY'\nimport json\nfrom pathlib import Path\nf=json.loads(Path('fleet.json').read_text())\nprint('FLEET', json.dumps({k:f.get(k) for k in ('default_model','backends','admission','image_limits')},ensure_ascii=False))\nprint('MODELS', [(m['id'],m.get('backend')) for m in f['models']])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat start.sh; cat docs/adr/0014-*.md; python3 - <<'PY'\nimport json\nfrom pathlib import Path\nf=json.loads(Path('fleet.json').read_text())\nprint('FLEET', json.dumps({k:f.get(k) for k in ('default_model','backends','admission','image_limits')},ensure_ascii=False))\nprint('MODELS', [(m['id'],m.get('backend')) for m in f['models']])\nPY\"","aggregated_output":"#!/usr/bin/env bash\n# Запуск моста droid-bridge (DSH). Ключ читается из окружения или ~/.dsh/.env.\n# FACTORY_API_KEY (headless-вход Droid без интерактивного логина) читается из\n# окружения, затем из ~/.zshenv — значение не печатается и не логируется.\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}\"\nexport DROID_DSH_BRIDGE_HOST=\"${DROID_DSH_BRIDGE_HOST:-127.0.0.1}\"\nexport DROID_DSH_BRIDGE_PORT=\"${DROID_DSH_BRIDGE_PORT:-9882}\"\nif [[ -z \"${DROID_DSH_BRIDGE_KEY:-}\" && -f \"$HOME/.dsh/.env\" ]]; then\n  _k=\"$(grep -E '^DROID_DSH_BRIDGE_KEY=' \"$HOME/.dsh/.env\" | cut -d= -f2- || true)\"\n  [[ -n \"$_k\" ]] && export DROID_DSH_BRIDGE_KEY=\"$_k\"\nfi\n: \"${DROID_DSH_BRIDGE_KEY:?DROID_DSH_BRIDGE_KEY is required}\"\n# Factory-ключ нужен потомку `droid exec` (через _launch_env). Источник — только\n# ~/.zshenv: в ~/.dsh/.env секрет не дублируем (канон: один секрет — один файл).\nif [[ -z \"${FACTORY_API_KEY:-}\" && -f \"$HOME/.zshenv\" ]]; then\n  _fk=\"$(grep -E '^[[:space:]]*export[[:space:]]+FACTORY_API_KEY=' \"$HOME/.zshenv\" \\\n    | tail -n 1 | cut -d= -f2- | tr -d '\"'\"'\"'' | tr -d '[:space:]' || true)\"\n  [[ -n \"$_fk\" ]] && export FACTORY_API_KEY=\"$_fk\"\nfi\nunset _fk 2>/dev/null || true\nmkdir -p \"$ROOT/logs\" \"$ROOT/workspace\"\ncd \"$ROOT\"\nexec /usr/bin/python3 server.py\n# 0014 — agy-bridge: полная ликвидация вшитых констант и обеспечение 100% конфигурируемости эксплуатационных параметров\n\n## Status\n\nAccepted (2026-10-31, Architect cycle-4, revision a4, run `zero-hardcode-configurability`).\nЦелевой путь: `docs/adr/0014-zero-hardcode-configurability.md`.\nКритичность: S2.\nПакет: `/tmp/cel-runs/zero-hardcode-configurability/architecture/architecture-packet.json`.\n\n## Y-формулировка\n\nВ контексте standalone `agy-bridge` (`127.0.0.1:9887`), к которому DeepSeek Harness и внешние потребители обращаются напрямую,\nстолкнувшись с несоответствием правилу 4 `AGENTS.md` репозитория («Запрет на хардкод параметров: полная конфигурируемость»), выражавшимся в наличии жестко зашитых констант буферов памяти (8 MiB контент, 2 MiB reasoning), шагов (128), блобов (256 KiB), маркеров (32), дивергентного текста (64 KiB), интервала watchdog (5.0 с), бюджетов хода (3600 с, резерв 5.5 с), таймаутов дренажа и параметров circuit breaker/rate-limiter, что приводило к обрывам длительных ходов (`timeout, 3594.5s`),\nмы решили:\n1. Реализовать отказоустойчивые типизированные функции парсинга параметров окружения:\n   - `_env_int(name: str, default: int, low: int, high: int) -> int` — безопасный парсинг с проверкой диапазона `[low, high]` и fallback на `default`;\n   - `_env_int_with_zero_cap(name: str, default: int, low: int, high: int, zero_cap: int) -> int` — при `val == 0` возвращает `zero_cap`, иначе проверяет `low <= val <= high` с fallback на `default`;\n   - `_env_float(name: str, default: float, low: float, high: float) -> float` — парсинг вещественных чисел с проверкой `math.isfinite()`, диапазона `[low, high]` и fallback на `default`;\n   - `_env_bool(name: str, default: bool) -> bool` — разбор булевых значений (`\"1\"`, `\"true\"`, `\"yes\"`, `\"on\"` -> `True`; `\"0\"`, `\"false\"`, `\"no\"`, `\"off\"` -> `False`);\n2. Объединить все параметры в единый неизменяемый снимок конфигурации `_BridgeConfig` с функцией доступа `get_bridge_config()` и возможностью переинициализации `reload_bridge_config()` для изолированного юнит-тестирования без перезагрузки модулей;\n3. Ввести строгие кросс-полевые инварианты при инициализации `_BridgeConfig`:\n   - `idle_timeout_s = min(idle_timeout_s, max(1.0, req_budget_s - reserve_s))` — таймаут простоя не может превышать полезный бюджет запроса;\n   - `retry_capacity_tenths = max(retry_capacity_tenths, retry_cost_tenths)` — емкость корзины повторов не может быть меньше стоимости одной попытки;\n   - `poll_bucket_capacity_tenths = max(poll_bucket_capacity_tenths, poll_cost_tenths)` — емкость корзины опросов не может быть меньше стоимости одного опроса;\n   - `min_attempt_s = min(min_attempt_s, max(1.0, req_budget_s - reserve_s))` — минимальная попытка согласована с бюджетом;\n4. Закрепить приоритет непрерывности хода (Liveness Invariant):\n   - При `liveness_gated_timeout_enabled = True` (целевой дефолт) ход **никогда не обрывается жестким потолком времени `cap`**, пока процесс генерирует данные, рассуждает или выполняет действия (`silence < idle_now`);\n   - Прерывание допускается исключительно по `idle_timeout` при отсутствии признаков активности дольше `idle_now`;\n5. Ввести безопасные потолки памяти (Bounded Safety Caps) для предотвращения OOM:\n   - `AGY_BRIDGE_MAX_CONTENT_BYTES`: дефолт 8388608 (8 MiB), диапазон `[1024, 268435456]`; при `0` включается Safety Cap 256 MiB;\n   - `AGY_BRIDGE_MAX_REASONING_BYTES`: дефолт 2097152 (2 MiB), диапазон `[1024, 67108864]`; при `0` включается Safety Cap 64 MiB;\n   - Суммарный защитный потолок буферов процесса `TOTAL_MEMORY_SAFETY_CAP_BYTES = 536870912` (512 MiB);\n6. Вынести 100% выявленных эксплуатационных параметров в переменные окружения с каноническим префиксом `AGY_BRIDGE_*`:\n   - **Буферы памяти и защитные потолки:**\n     - `AGY_BRIDGE_MAX_CONTENT_BYTES`: дефолт 8388608 (8 MiB), диапазон `[1024, 268435456]`; при `0` включается Safety Cap 256 MiB;\n     - `AGY_BRIDGE_MAX_REASONING_BYTES`: дефолт 2097152 (2 MiB), диапазон `[1024, 67108864]`; при `0` включается Safety Cap 64 MiB;\n     - `AGY_BRIDGE_MAX_STEP_BLOB_BYTES`: дефолт 262144 (256 KiB), диапазон `[1024, 16777216]`;\n     - `AGY_BRIDGE_MAX_STEPS`: дефолт 128, диапазон `[1, 4096]`;\n     - `AGY_BRIDGE_MAX_TOOL_MARKERS`: дефолт 32, диапазон `[1, 1024]`;\n     - `AGY_BRIDGE_MAX_DIVERGENT_BYTES`: дефолт 65536 (64 KiB), диапазон `[1024, 1048576]`;\n     - `AGY_BRIDGE_TRANSCRIPT_READ_MAX`: дефолт 4194304 (4 MiB), диапазон `[1024, 67108864]`;\n     - `AGY_BRIDGE_DYNAMIC_CONFIG_MAX_BYTES`: дефолт 65536, диапазон `[1024, 1048576]`;\n     - `AGY_BRIDGE_USAGE_STEP_CAP`: дефолт 16384, диапазон `[128, 1048576]`;\n     - `AGY_BRIDGE_SQLITE_ROW_LIMIT`: дефолт 16, диапазон `[1, 1024]`;\n   - **Таймауты, бюджеты и интервалы опроса:**\n     - `AGY_BRIDGE_REQ_BUDGET_S`: дефолт 3600.0 с, диапазон `[10.0, 86400.0]`;\n     - `AGY_BRIDGE_EXT_MAX_TIMEOUT_S`: дефолт 3600.0 с, диапазон `[10.0, 86400.0]`;\n     - `AGY_BRIDGE_IDLE_TIMEOUT_S`: дефолт 1800.0 с, диапазон `[5.0, 86400.0]`;\n     - `AGY_BRIDGE_TIMEOUT_S`: дефолт 1800, диапазон `[1, 86400]`;\n     - `AGY_BRIDGE_QUEUE_TIMEOUT_S`: дефолт 900, диапазон `[1, 86400]`;\n     - `AGY_BRIDGE_KEEPALIVE_S`: дефолт 15.0, диапазон `[0.5, 300.0]`;\n     - `AGY_BRIDGE_FIRST_TOKEN_TIMEOUT_S`: дефолт 600.0, диапазон `[5.0, 3600.0]`;\n     - `AGY_BRIDGE_TRANSCRIPT_POLL_S`: дефолт 0.5, диапазон `[0.05, 10.0]`;\n     - `AGY_BRIDGE_WATCHDOG_INTERVAL_S`: дефолт 5.0, диапазон `[0.5, 60.0]`;\n     - `AGY_BRIDGE_KILL_TERM_GRACE_S`: дефолт 2.0, диапазон `[0.1, 30.0]`;\n     - `AGY_BRIDGE_PROC_EXIT_WAIT_S`: дефолт 5.0, диапазон `[0.1, 60.0]`;\n     - `AGY_BRIDGE_DRAIN_WINDOW_S`: дефолт 15.0, диапазон `[1.0, 120.0]`;\n     - `AGY_BRIDGE_DRAIN_POLL_STEP_S`: дефолт 0.1, диапазон `[0.01, 2.0]`;\n     - `AGY_BRIDGE_JOIN_TIMEOUT_S`: дефолт 0.5, диапазон `[0.05, 10.0]`;\n     - `AGY_BRIDGE_RESERVE_S`: дефолт 5.5, диапазон `[0.5, 60.0]`;\n     - `AGY_BRIDGE_MIN_ATTEMPT_S`: дефолт 10.0, диапазон `[1.0, 300.0]`;\n     - `AGY_BRIDGE_FINAL_FLUSH_S`: дефолт 5.0, диапазон `[0.5, 60.0]`;\n     - `AGY_BRIDGE_SESSION_MAX_TTL_S`: дефолт 86400.0, диапазон `[60.0, 604800.0]`;\n     - `AGY_BRIDGE_SESSION_MAX_TURNS`: дефолт 30, диапазон `[1, 1000]`;\n     - `AGY_BRIDGE_SWEEP_CUTOFF_S`: дефолт 3600.0, диапазон `[60.0, 86400.0]`;\n     - `AGY_BRIDGE_LIVENESS_GATED_TIMEOUT_ENABLED`: целевой дефолт `True` (предотвращает обрыв ходов при наличии мышления/активности модели согласно инварианту задачи; при необходимости сохраняется возможность явного переопределения на `False`);\n   - **Circuit Breaker и Rate Limiter (Token Buckets):**\n     - `AGY_BRIDGE_BREAKER_FAILURES`: дефолт 3, диапазон `[1, 100]`;\n     - `AGY_BRIDGE_BREAKER_COOLDOWN_S`: дефолт 30.0, диапазон `[1.0, 3600.0]`;\n     - `AGY_BRIDGE_BREAKER_PROBE_LEASE_S`: дефолт 60.0, диапазон `[1.0, 3600.0]`;\n     - `AGY_BRIDGE_RETRY_CAPACITY_TENTHS`: дефолт 30, диапазон `[10, 1000]`;\n     - `AGY_BRIDGE_RETRY_COST_TENTHS`: дефолт 10, диапазон `[1, 100]`;\n     - `AGY_BRIDGE_RETRY_REFILL_PER_SEC_TENTHS`: дефолт 1, диапазон `[1, 100]`;\n     - `AGY_BRIDGE_POLL_BUCKET_CAPACITY_TENTHS`: дефолт 30, диапазон `[10, 1000]`;\n     - `AGY_BRIDGE_POLL_COST_TENTHS`: дефолт 10, диапазон `[1, 100]`;\n     - `AGY_BRIDGE_POLL_REFILL_PER_SEC_TENTHS`: дефолт 1, диапазон `[1, 100]`;\n7. Формировать шаблон `_STEPS_SQL` динамически на основе вычисленных `config.sqlite_row_limit` и `config.max_step_blob_bytes`;\n8. Обеспечить сохранение обратной совместимости API и тестов: параметры по умолчанию соответствуют ранее зашитым константам, а изменение дефолта `liveness_gated_timeout_enabled` на `True` документировано как целевое функциональное исправление проблемы преждевременных таймаутов.\n\n## Context and Problem Statement\n\nВ ходе аудита инцидента обрыва хода в DeepSeek Harness на отсечке `3594.5s` и выполнения директивы владельца по скиллу `analyst-teamlead` выявлено:\n- `T_REQ_BUDGET_S = 3600.0` и `T_RESERVE_S = 5.5` зашиты константами, приводя к обрыву хода ровно через 59 минут 55 секунд независимо от того, продолжает ли модель думать или генерировать результат;\n- `DEFAULT_LIVENESS_GATED_TIMEOUT_ENABLED = False` приводил к игнорированию признаков жизни процесса при расчёте жесткого потолка времени;\n- `MAX_CONTENT_BYTES_PER_TURN = 8 * 1024 * 1024` и `MAX_REASONING_BYTES_PER_TURN = 2 * 1024 * 1024` зашиты статически, отсекая текст и рассуждения при длительных ходах;\n- `MAX_STEPS_TRACKED = 128` и `MAX_STEP_BLOB_BYTES = 262144` жестко ограничивают транскрипт шагов;\n- `WATCHDOG_INTERVAL_S = 5.0`, `PROC_EXIT_WAIT_S = 5.0`, `DRAIN_WINDOW_S = 15.0` зашиты без возможности адаптации под нагрузку;\n- Константы circuit breaker и токен-бакетов не подлежали настройке;\n- Чтение параметров окружения в ряде мест падало с необработанным `ValueError` при нечисловом вводе.\n\nЭто прямо нарушает п. 4 `AGENTS.md` проекта («Запрет на хардкод параметров: полная конфигурируемость»).\n\n## Decision Drivers\n\n- **D1 — 100% конфигурируемость без хардкода:** все эксплуатационные параметры (буферы, таймауты, лимиты, интервалы) вынесены в настройки окружения.\n- **D2 — Защита непрерывности хода (Liveness Invariant):** активный процесс модели с признаками мышления и генерации не обрывается по таймеру; прерывание возможно только при полной тишине.\n- **D3 — Отказоустойчивость парсинга (Robustness Principle):** невалидные значения, NaN, пустые строки и переполнения откатываются на безопасные дефолты.\n- **D4 — Предотвращение OOM (Bounded Safety Cap):** значение 0 не снимает лимит до бесконечности, а включает безопасный потолок (256 MiB для текста, 64 MiB для reasoning), а также суммарный потолок памяти 512 MiB.\n- **D5 — Чистая архитектура и тестируемость:** единый `_BridgeConfig` позволяет юнит-тестам динамически проверять любые конфигурации.\n\n## Verification Surface\n\n- Юнит-тесты функций `_env_int`, `_env_int_with_zero_cap`, `_env_float` и `_env_bool` с проверкой граничных значений `[low, high]`, отрицательных чисел, NaN, `inf` и отката на default.\n- Тесты переопределения каждого параметра через переменные окружения `AGY_BRIDGE_*`.\n- Тест работы `liveness_gated_timeout` при сверхдлинном ходе.\n- Тест динамической компиляции `_STEPS_SQL`.\n- Охранный юнит-тест инвентаря на отсутствие захардкоженных эксплуатационных констант.\n- Полный регрессионный прогон `pytest tests/test_agy_bridge_resilience.py -v`.\nFLEET {\"default_model\": \"claude-sonnet-5-5\", \"backends\": {\"droid\": {\"kind\": \"droid\", \"enabled\": true, \"required\": true, \"owned_by\": \"factory-droid\", \"max_concurrent\": 4}, \"muse\": {\"kind\": \"muse\", \"enabled\": true, \"required\": false, \"owned_by\": \"meta-muse\", \"max_concurrent\": 1, \"wrapper\": \"~/.config/muse-launch/muse-cli.sh\", \"technical_ref\": {\"version\": \"1.4.3\", \"binary_sha256\": \"c6db294799a190ca380da274beb3b9c0e160e0da9681a3d364ce8b0e5fa3a4bc\", \"binary_path\": \"~/.local/bin/muse\"}, \"options\": {\"streaming_mode\": \"serve\"}}, \"codex\": {\"kind\": \"passthrough\", \"enabled\": true, \"required\": false, \"owned_by\": \"openai-codex\", \"max_concurrent\": 4, \"base_url\": \"http://127.0.0.1:2455/v1\"}}, \"admission\": {\"max_http_connections\": 32, \"max_inflight_body_bytes\": 67108864, \"overload_error\": {\"http\": 503, \"type\": \"overloaded\"}, \"oversize_error\": {\"http\": 413, \"type\": \"payload_too_large\"}, \"note\": \"резерв байт по заявленному Content-Length ДО чтения тела; семафор исполнения (4) и TCP backlog лимитами HTTP-обработчиков и памяти не считаются\"}, \"image_limits\": {\"max_images\": 16, \"max_image_bytes\": 20971520, \"max_total_image_bytes\": 20971520, \"max_body_bytes\": 33554432, \"types\": [\"image/png\"]}}\nMODELS [('claude-sonnet-5-5', 'droid'), ('gemini-3.8-flash', 'droid'), ('grok-4.7', 'droid'), ('deepseek-v4.1-flash', 'droid'), ('gpt-6.1-sol', 'codex'), ('glm-5.3', 'droid'), ('muse-spark-1.3', 'muse'), ('muse-spark-1.3-contributor', 'muse'), ('muse-wonder-1.0', 'muse'), ('muse-wonder-full-1.0', 'muse'), ('gpt-6.1-terra', 'codex')]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"Хеш пакета совпал. Дефолт 120 000 Б покрывает указанный блок 63 262 Б, но пока не подтверждены безопасность большего лимита и непрерывность миграции. В текущем каталоге модель по умолчанию маршрутизируется в Droid; `required=false` этот маршрут не меняет. Проверю также авторизацию сквозных маршрутов.\n"}}
