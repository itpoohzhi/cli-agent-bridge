idges/agy-bridge/server.py        | 1127 ++++++++++++++++++++++++++++---\n core/backend_adapter.py             |   16 +\n fleet.json                          |   28 +-\n server.py                           |   43 +-\n start.sh                            |   52 +-\n tests/bridge_testlib.py             |    3 +\n tests/test_agy_bridge_resilience.py | 1252 ++++++++++++++++++++++++++++++++++-\n tests/test_b_guard.py               |  228 +++++--\n tests/test_backend_contract.py      |    9 +-\n tests/test_bridge_strict.py         |   14 +-\n tests/test_fleet_v3.py              |   50 +-\n tests/test_launch_env.py            |   90 ++-\n tests/test_muse_adapter.py          |   11 +-\n tests/test_rpc_cycle3.py            |   24 +-\n tools/b_guard.py                    |  135 +++-\n 18 files changed, 2884 insertions(+), 207 deletions(-)\n2df9276db2909ec51a9d4092f848015caa00f4ca8655e2bf528b50f418526181  .ai-team/runs/universal-bridge-modernization-20261031/code-review-package.md\nbb204486957139ef6e4006207f39511b8252f87592d9d7c161f4fbdc7bfa1a83  .ai-team/runs/universal-bridge-modernization-20261031/receipts/arch-panel.json\n{\n  \"artifact_sha256\": \"2473cdeae874aab12050b24714e4396c9e39284b20d0b5a4adb8f44c77aec402\",\n  \"expect_seats\": 3,\n  \"manifest_sha256\": \"31f4a2aa6e75295565a93da2a9c522d3141d7ac7a9152e239182b68db65790ee\",\n  \"min_seconds\": 8.0,\n  \"min_verdict_chars\": 200,\n  \"result\": \"PASS\",\n  \"round\": 2,\n  \"schema\": \"pol-receipt/1\",\n  \"seats\": [\n    {\n      \"duration_s\": 93.875927,\n      \"family\": \"OpenAI\",\n      \"k\": 1,\n      \"launch_sha256\": \"d16e2f9edf0dee112be460ce84253e8b4a7a03b7db5c3465c4c5a18c7c15d832\",\n      \"raw_out_sha256\": \"33a210b81cadb515453dfb8d17562c8002ea514db4e20d0eb835589c092189a5\",\n      \"rc\": 0,\n      \"slot_id\": \"gpt-6.1-sol-high\",\n      \"transport\": \"codex\",\n      \"verdict\": \"NEEDS WORK\",\n      \"verdict_sha256\": \"a263cd82c978bd49c0f942d8936e9371dd1002859d8e3fa54753bdb87effc4f2\"