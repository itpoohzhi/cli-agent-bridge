+            status="refused",
+            messages=pruned_msgs,
+            prompt=pruned_prompt,
+            est_before=est_before,
+            est_after=est_after,
+            msgs_total=real_msgs_total,
+            msgs_kept=kept_count,
+            msgs_dropped=dropped_count,
+            mandatory_est=mandatory_est,
+            overhead_est=overhead_est,
+        )
+    return PruneResult(
+        status="pruned",
+        messages=pruned_msgs,
+        prompt=pruned_prompt,
+        est_before=est_before,
+        est_after=est_after,
+        msgs_total=real_msgs_total,
+        msgs_kept=kept_count,
+        msgs_dropped=dropped_count,
+        mandatory_est=mandatory_est,
+        overhead_est=overhead_est,
+    )
