{"type":"tool_result","id":"toolu_011YWLsZKiXgk2QWeu6g2ZcM","messageId":"ad9a5409-1246-471c-b8d3-29d19817a3c4","toolId":"Read","isError":false,"value":"diff --git a/bridges/muse-bridge/server.py b/bridges/muse-bridge/server.py\nindex d351b6e..7cc1064 100644\n--- a/bridges/muse-bridge/server.py\n+++ b/bridges/muse-bridge/server.py\n@@ -14,7 +14,8 @@ Stdout CLI — JSONL-конверты (schema_version=1). Текст ответ\n `task.lifecycle.failed` (event.reason). Usage CLI в JSONL не отдаёт — оценка по словам.\n \n Транспорт — stdlib. `stream:true`: заголовки 200 и role-delta уходят сразу, пока ход\n-идёт — комментарии `: keepalive` (MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\n+идёт — data-чанки `chat.completion.chunk` с пустой дельтой `{\"content\": \"\"}`\n+(MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\n summaries как `delta.reasoning_content`, tool_calls, content-чанки (~300 символов), финал\n с finish_reason + usage, затем `data: [DONE]`. Ошибка после старта потока — кадр\n `{\"error\": …}` + `[DONE]`. Текст ответа CLI отдаёт в конце хода, поэтому content\n@@ -23,10 +24,9 @@ summaries как `delta.reasoning_content`, tool_calls, content-чанки (~300\n Провал хода (failed terminal, rc != 0, таймаут) не отдаётся как успешный финал: частичный\n текст и tool-блоки отбрасываются — SSE-кадр ошибки + `[DONE]` (stream) либо 502 (JSON).\n \n-Keepalive: комментарии `: keepalive` держат TCP-соединение от закрытия клиентом/прокси, но\n-SDK отбрасывает их на уровне декодера и idle-watchdog не сбрасывают. Поэтому после применения\n-профиля muse (`streamIdleTimeoutMs=1900000`) DSH нужно перезапустить; сброс watchdog кадрами\n-данных (полный стрим текста muse) в этот мост не входит.\n+Keepalive: пустые data-чанки держат SSE-соединение, не меняя текст ответа.\n+Сброс idle-watchdog клиента pi-ai требует отдельной живой проверки в DSH.\n+Перед финалом поток запечатывается; после `data: [DONE]` записей нет.\n \n Эмуляция OpenAI function calling (порт из droid-bridge): если запрос содержит\n непустой `tools` (и tool_choice != \"none\"), в системный текст добавляется протокол\n@@ -39,6 +39,7 @@ SDK отбрасывает их на уровне декодера и idle-watch\n from __future__ import annotations\n \n import json\n+import logging\n import os\n import random\n import re\n@@ -53,7 +54,9 @@ import time\n import uuid\n from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n from pathlib import Path\n-from typing import Any\n+from typing import Any, NamedTuple\n+\n+logger = logging.getLogger(\"muse-bridge\")\n \n HOST = os.environ.get(\"MUSE_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\n PORT = int(os.environ.get(\"MUSE_BRIDGE_PORT\", \"9886\"))\n@@ -74,8 +77,20 @@ ALLOWED_MODELS: dict[str, dict[str, Any]] = {\n     # 2026-10-05: контрибьютор-слот (только пикер, по просьбе владельца).\n     # id подтверждён `muse model-profile show` (резолвится); окно/лимит как у spark.\n     \"muse-spark-1.3-contributor\": {\"context_length\": 1048576, \"max_output\": 131072},\n+    \"muse-wonder-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n+    \"muse-wonder-full-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n }\n-DEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-spark-1.3\")\n+DEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-wonder-full-1.0\")\n+DEFAULT_CONTEXT_LIMIT = 400_000\n+\n+# Подстрока ошибки жёсткого порога контекста Meta (ADR-001.3, [F-01]).\n+HARD_THRESHOLD_ERR_SUBSTR = (\n+    \"context compaction replacement still exceeds the hard threshold\"\n+)\n+COMPACTION_MARKER = (\n+    \"[... earlier conversation turns compacted to stay within Muse context limit ...]\"\n+)\n+_COMPACTION_MARKER_ROLE = \"__compaction_marker__\"\n \n # OpenAI/DSH effort -> `--reasoning-effort` Muse CLI. Нет/неизвестно -> max (канон слота).\n EFFORT_MAP: dict[str, str] = {\n@@ -154,7 +169,8 @@ _LOG_LOCK = threading.Lock()\n \n \n def _log(msg: str) -> None:\n-    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\"\n+    safe_msg = _redact_secrets(msg)\n+    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {safe_msg}\"\n     sys.stderr.write(line + \"\\n\")\n     sys.stderr.flush()\n     try:\n@@ -172,6 +188,140 @@ def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n     return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n \n \n+def _redact_secrets(text: str) -> str:\n+    \"\"\"Удалить отражённые ключи до обрезки диагностики; повторный вызов безопасен.\"\"\"\n+    if AUTH_KEY:\n+        text = text.replace(AUTH_KEY, \"[REDACTED]\")\n+    text = re.sub(\n+        r\"Authorization\\s*:\\s*[^\\r\\n]+\",\n+        \"Authorization: [REDACTED]\",\n+        text,\n+        flags=re.IGNORECASE,\n+    )\n+    text = re.sub(r\"Bearer\\s+\\S+\", \"Bearer [REDACTED]\", text, flags=re.IGNORECASE)\n+    text = re.sub(\n+        r\"\"\"([\"']?(?:api[_-]?key|token|secret|password|bridge[_-]?key)[\"']?\\s*[:=]\\s*)(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^\\s,;}\"']+)\"\"\",\n+        lambda match: match[1] + \"[REDACTED]\",\n+        text,\n+        flags=re.IGNORECASE,\n+    )\n+    return re.sub(r\"sk-[A-Za-z0-9_-]{12,}\", \"[REDACTED]\", text)\n+\n+\n+def _clip_diagnostic(text: str, limit: int) -> str:\n+    \"\"\"Ограничить поле, убрав его целиком при разрезании маркера редакции.\"\"\"\n+    for marker in re.finditer(re.escape(\"[REDACTED]\"), text):\n+        if marker.start() < limit < marker.end():\n+            return \"\"\n+    return text[:limit]\n+\n+\n+def _prompt_reflected_parts(prompt: str) -> list[str]:\n+    \"\"\"Выделить длинные отражённые реплики, начиная с самых полных совпадений.\"\"\"\n+    parts = {prompt} if len(prompt.strip()) >= 8 else set()\n+    for part in prompt.split(\"\\n\\n\") + prompt.splitlines():\n+        for candidate in (part, re.sub(r\"^(?:User|Assistant|System):\\s*\", \"\", part)):\n+            if len(candidate.strip()) >= 8:\n+                parts.add(candidate)\n+    return sorted(parts, key=len, reverse=True)\n+\n+\n+def _diagnostic_text(value: Any, prompt: str = \"\") -> str:\n+    \"\"\"Санитизировать свободное поле и нормализовать управляющие переводы строк.\"\"\"\n+    text = str(value) if value is not None else \"\"\n+    text = _redact_secrets(text)\n+    parts = _prompt_reflected_parts(prompt)\n+    for part in parts:\n+        text = text.replace(part, \"[REDACTED]\")\n+    control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n+    text = re.sub(control_chars, \" \", text).strip()\n+    for part in parts:\n+        normalized = re.sub(control_chars, \" \", part).strip()\n+        text = text.replace(normalized, \"[REDACTED]\")\n+    return text\n+\n+\n+def _redact_quota(value: Any) -> Any:\n+    \"\"\"Удалить значения чувствительных ключей quota до JSON-сериализации.\"\"\"\n+    if isinstance(value, dict):\n+        return {\n+            key: \"[REDACTED]\"\n+            if re.sub(r\"[_-]\", \"\", str(key)).lower()\n+            in {\"token\", \"secret\", \"password\", \"apikey\", \"bridgekey\", \"authorization\"}\n+            else _redact_quota(item)\n+            for key, item in value.items()\n+        }\n+    if isinstance(value, list):\n+        return [_redact_quota(item) for item in value]\n+    if isinstance(value, str):\n+        return _redact_secrets(value)\n+    return value\n+\n+\n+def _turn_diagnostics(params: dict[str, Any], prompt: str) -> list[str]:\n+    \"\"\"Собрать приоритетный блок MSP с покомпонентными лимитами и бюджетом 300.\"\"\"\n+    error = params.get(\"error\")\n+    kind = message = quota = retryable = \"\"\n+    if isinstance(error, dict):\n+        kind = _diagnostic_text(error.get(\"kind\"), prompt)\n+        message = _diagnostic_text(error.get(\"message\"), prompt)\n+        if isinstance(error.get(\"retryable\"), bool):\n+            retryable = f\" retryable={error['retryable']}\"\n+        if error.get(\"quota\") is not None:\n+            try:\n+                quota = json.dumps(\n+                    _redact_quota(error[\"quota\"]),\n+                    ensure_ascii=False,\n+                    sort_keys=True,\n+                    default=str,\n+                    separators=(\",\", \":\"),\n+                )\n+            except (TypeError, ValueError, RecursionError):\n+                quota = str(error[\"quota\"])\n+            quota = _diagnostic_text(quota, prompt)\n+    elif error is not None:\n+        message = _diagnostic_text(error, prompt)\n+    reason = _diagnostic_text(params.get(\"reason\"), prompt)\n+    if reason == message:\n+        reason = \"\"\n+    fields = {\n+        \"kind\": _clip_diagnostic(kind, 64),\n+        \"message\": _clip_diagnostic(message, 160),\n+        \"quota\": _clip_diagnostic(quota, 120),\n+        \"reason\": _clip_diagnostic(reason, 160),\n+    }\n+\n+    def lines() -> list[str]:\n+        primary = \": \".join(fields[key] for key in (\"kind\", \"message\") if fields[key])\n+        primary += retryable\n+        if fields[\"quota\"]:\n+            primary += \" quota=\" + fields[\"quota\"]\n+        result = [primary.strip()] if primary.strip() else []\n+        if fields[\"reason\"]:\n+            result.append(\"reason: \" + fields[\"reason\"])\n+        return result\n+\n+    for key in (\"quota\", \"reason\", \"message\", \"kind\"):\n+        excess = len(\"\\n\".join(lines())) - 300\n+        if excess <= 0:\n+            break\n+        minimum = min(16, len(fields[key])) if key == \"reason\" else 0\n+        fields[key] = _clip_diagnostic(\n+            fields[key], max(minimum, len(fields[key]) - excess)\n+        )\n+    return lines()\n+\n+\n+def _format_err_log(\n+    model: str, via: str, out: dict[str, Any], stream: bool, state: str | None = None\n+) -> str:\n+    \"\"\"Единая однострочная запись финального отказа без промпта и секретов.\"\"\"\n+    return (\n+        f\"error model={model} via={via} rc={out.get('rc')} state={state or out.get('state')} \"\n+        f\"err={_redact_secrets(str(out.get('err') or ''))[:300]!r} stream={stream}\"\n+    )\n+\n+\n def _flatten_content(content: Any) -> str:\n     \"\"\"OpenAI content (str | list[part]) -> plain text.\"\"\"\n     if content is None:\n@@ -329,13 +479,38 @@ def _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n             systems.append(text)\n         elif role == \"assistant\":\n             turns.append(f\"Assistant: {text}\")\n-        elif role == \"tool\":\n+        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n             turns.append(text)\n         else:\n             turns.append(f\"User: {text}\")\n     return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n \n \n+def _assemble_prompt(\n+    messages: list[dict[str, Any]],\n+    tools: list[dict[str, Any]] | None = None,\n+    tool_choice: Any = None,\n+    raw_tools: Any = None,\n+) -> tuple[str, str, str]:\n+    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n+    clean_tools = (\n+        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n+    )\n+    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n+    system_text, turns_text = _messages_to_prompt(messages)\n+    if not turns_text:\n+        return system_text, \"\", \"\"\n+    head: list[str] = []\n+    if system_text:\n+        head.append(f\"[system]\\n{system_text}\")\n+    if emulate_tools:\n+        head.append(_tools_section(clean_tools, tool_choice))\n+    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not system_text:\n+        head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n+    full_prompt = \"\\n\\n\".join(head) + f\"\\n\\n{turns_text}\" if head else turns_text\n+    return system_text, turns_text, full_prompt\n+\n+\n def _strip_code_fence(text: str) -> str:\n     \"\"\"Снять обёртку ```…``` (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n     body = text.strip()\n@@ -503,13 +678,353 @@ def _map_effort(req: dict[str, Any]) -> str:\n     return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n \n \n-_TOKEN_RE = re.compile(r\"\\s+\")\n-\n-\n def _estimate_tokens(text: str) -> int:\n+    \"\"\"Консервативная оценка токенов по UTF-8 байтам и символам (ADR-001.2 §2.5).\"\"\"\n     if not text:\n         return 0\n-    return max(1, int(len(_TOKEN_RE.split(text.strip())) * 1.3))\n+    return max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)\n+\n+\n+def _context_limit(model: str) -> int:\n+    \"\"\"Единый источник лимита окна модели из ALLOWED_MODELS (ADR-001.1).\"\"\"\n+    spec = ALLOWED_MODELS.get(model)\n+    if isinstance(spec, dict):\n+        val = spec.get(\"context_length\")\n+        if isinstance(val, int) and val > 0:\n+            return val\n+    return DEFAULT_CONTEXT_LIMIT\n+\n+\n+def _context_target(limit: int) -> int:\n+    \"\"\"Целевой бюджет проактивного прунинга с гистерезисом 80% (ADR-001.1).\"\"\"\n+    return (limit * 4) // 5\n+\n+\n+def _context_retry_target(limit: int) -> int:\n+    \"\"\"Аварийный бюджет однократного retry 50% (ADR-001.1).\"\"\"\n+    return limit // 2\n+\n+\n+class PruneResult(NamedTuple):\n+    status: str  # \"pass_through\" | \"pruned\" | \"refused\"\n+    messages: list[dict[str, Any]]\n+    prompt: str\n+    est_before: int\n+    est_after: int\n+    msgs_total: int\n+    msgs_kept: int\n+    msgs_dropped: int\n+    mandatory_est: int\n+    overhead_est: int\n+\n+\n+def _overhead_tokens_estimate(\n+    has_system: bool,\n+    tools: list[dict[str, Any]] | None,\n+    tool_choice: Any,\n+    raw_tools: Any,\n+) -> int:\n+    \"\"\"Оценка фиксированной шапки промпта ([system], схемы инструментов, DEFAULT_SYSTEM_HINT).\"\"\"\n+    clean_tools = (\n+        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n+    )\n+    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n+    overhead = 0\n+    if has_system:\n+        overhead += _estimate_tokens(\"[system]\\n\") + 1\n+    if emulate_tools:\n+        overhead += _estimate_tokens(_tools_section(clean_tools, tool_choice)) + 1\n+    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not has_system:\n+        overhead += _estimate_tokens(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\") + 1\n+    return overhead\n+\n+\n+def _prune_messages(\n+    messages: list[dict[str, Any]],\n+    limit: int,\n+    target: int,\n+    tools: list[dict[str, Any]] | None = None,\n+    tool_choice: Any = None,\n+    raw_tools: Any = None,\n+) -> PruneResult:\n+    \"\"\"Чистая функция защитного прунинга истории диалога (ADR-001.2).\"\"\"\n+    _, _, full_prompt = _assemble_prompt(\n+        messages, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    est_before = _estimate_tokens(full_prompt)\n+\n+    valid_msgs: list[dict[str, Any]] = []\n+    roles: list[str] = []\n+    real_msgs_total = 0\n+    for msg in messages or []:\n+        if not isinstance(msg, dict):\n+            continue\n+        role, text = _render_turn(msg)\n+        if not text.strip():\n+            continue\n+        valid_msgs.append(msg)\n+        roles.append(role)\n+        if role != _COMPACTION_MARKER_ROLE:\n+            real_msgs_total += 1\n+\n+    has_system = any(r in (\"system\", \"developer\") for r in roles)\n+    overhead_est = _overhead_tokens_estimate(has_system, tools, tool_choice, raw_tools)\n+\n+    if est_before <= limit:\n+        mandatory_est = _compute_mandatory_est_only(\n+            valid_msgs, roles, tools, tool_choice, raw_tools\n+        )\n+        return PruneResult(\n+            status=\"pass_through\",\n+            messages=messages,\n+            prompt=full_prompt,\n+            est_before=est_before,\n+            est_after=est_before,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=real_msgs_total,\n+            msgs_dropped=0,\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+\n+    units, mandatory_indices = _partition_units(valid_msgs, roles)\n+\n+    def build_candidate(kept_flags: list[bool]) -> list[dict[str, Any]]:\n+        pruned: list[dict[str, Any]] = []\n+        seen_kept_turn = False\n+        in_dropped_gap = False\n+        for u_idx, unit in enumerate(units):\n+            u_role = _render_turn(unit[0])[0]\n+            if u_role in (\"system\", \"developer\"):\n+                pruned.extend(unit)\n+                continue\n+            if u_role == _COMPACTION_MARKER_ROLE:\n+                if seen_kept_turn:\n+                    in_dropped_gap = True\n+                continue\n+            if kept_flags[u_idx]:\n+                if in_dropped_gap:\n+                    pruned.append(\n+                        {\"role\": _COMPACTION_MARKER_ROLE, \"content\": COMPACTION_MARKER}\n+                    )\n+                    in_dropped_gap = False\n+                pruned.extend(unit)\n+                seen_kept_turn = True\n+            else:\n+                if seen_kept_turn:\n+                    in_dropped_gap = True\n+        return pruned\n+\n+    kept = [i in mandatory_indices for i in range(len(units))]\n+    mandatory_msgs = build_candidate(kept)\n+    _, _, mandatory_prompt = _assemble_prompt(\n+        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    mandatory_est = _estimate_tokens(mandatory_prompt)\n+    cap = max(limit, target)\n+    if mandatory_est > cap:\n+        kept_count = sum(\n+            len(units[i])\n+            for i in range(len(units))\n+            if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+        )\n+        return PruneResult(\n+            status=\"refused\",\n+            messages=mandatory_msgs,\n+            prompt=mandatory_prompt,\n+            est_before=est_before,\n+            est_after=mandatory_est,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=kept_count,\n+            msgs_dropped=max(0, real_msgs_total - kept_count),\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+\n+    # Фаза C: непрерывный суффикс опциональных единиц от новейшей к старейшей.\n+    for u_idx in range(len(units) - 1, -1, -1):\n+        if u_idx in mandatory_indices:\n+            continue\n+        if _render_turn(units[u_idx][0])[0] == _COMPACTION_MARKER_ROLE:\n+            continue\n+        kept[u_idx] = True\n+        cand_msgs = build_candidate(kept)\n+        _, _, cand_prompt = _assemble_prompt(\n+            cand_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+        )\n+        if _estimate_tokens(cand_prompt) <= target:\n+            continue\n+        kept[u_idx] = False\n+        break\n+\n+    pruned_msgs = build_candidate(kept)\n+    _, _, pruned_prompt = _assemble_prompt(\n+        pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    est_after = _estimate_tokens(pruned_prompt)\n+    while est_after > target:\n+        opt_indices = [\n+            i\n+            for i in range(len(units))\n+            if kept[i]\n+            and i not in mandatory_indices\n+            and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+        ]\n+        if not opt_indices:\n+            break\n+        kept[opt_indices[0]] = False\n+        pruned_msgs = build_candidate(kept)\n+        _, _, pruned_prompt = _assemble_prompt(\n+            pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+        )\n+        est_after = _estimate_tokens(pruned_prompt)\n+\n+    kept_count = sum(\n+        len(units[i])\n+        for i in range(len(units))\n+        if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+    )\n+    dropped_count = max(0, real_msgs_total - kept_count)\n+    if est_after > cap:\n+        return PruneResult(\n+            status=\"refused\",\n+            messages=pruned_msgs,\n+            prompt=pruned_prompt,\n+            est_before=est_before,\n+            est_after=est_after,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=kept_count,\n+            msgs_dropped=dropped_count,\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+    return PruneResult(\n+        status=\"pruned\",\n+        messages=pruned_msgs,\n+        prompt=pruned_prompt,\n+        est_before=est_before,\n+        est_after=est_after,\n+        msgs_total=real_msgs_total,\n+        msgs_kept=kept_count,\n+        msgs_dropped=dropped_count,\n+        mandatory_est=mandatory_est,\n+        overhead_est=overhead_est,\n+    )\n+\n+\n+def _partition_units(\n+    valid_msgs: list[dict[str, Any]], roles: list[str]\n+) -> tuple[list[list[dict[str, Any]]], set[int]]:\n+    \"\"\"Разбить валидные сообщения на атомарные единицы и выделить обязательные индексы M.\"\"\"\n+    units: list[list[dict[str, Any]]] = []\n+    consumed_tools: set[int] = set()\n+\n+    for idx, msg in enumerate(valid_msgs):\n+        role = roles[idx]\n+        if role == \"tool\":\n+            # Осиротевшие tool не попадают в units при прунинге; связанные поглощаются assistant.\n+            continue\n+        if (\n+            role == \"assistant\"\n+            and isinstance(msg.get(\"tool_calls\"), list)\n+            and msg.get(\"tool_calls\")\n+        ):\n+            call_ids = [\n+                _normalize_tool_call(tc)[\"id\"]\n+                for tc in msg[\"tool_calls\"]\n+                if _normalize_tool_call(tc)[\"id\"]\n+            ]\n+            if call_ids:\n+                expected = set(call_ids)\n+                matched_indices: list[int] = []\n+                matched_ids: set[str] = set()\n+                for j in range(idx + 1, len(valid_msgs)):\n+                    if j in consumed_tools or roles[j] != \"tool\":\n+                        continue\n+                    tc_id = str(\n+                        valid_msgs[j].get(\"tool_call_id\")\n+                        or valid_msgs[j].get(\"id\")\n+                        or \"\"\n+                    )\n+                    if tc_id in expected:\n+                        matched_indices.append(j)\n+                        matched_ids.add(tc_id)\n+                if matched_ids == expected:\n+                    consumed_tools.update(matched_indices)\n+                    units.append([msg] + [valid_msgs[j] for j in matched_indices])\n+                continue\n+        units.append([msg])\n+\n+    mandatory_indices: set[int] = set()\n+    user_unit_indices: list[int] = []\n+    last_non_sys_idx: int | None = None\n+    for u_idx, unit in enumerate(units):\n+        u_role = _render_turn(unit[0])[0]\n+        if u_role in (\"system\", \"developer\"):\n+            mandatory_indices.add(u_idx)\n+        elif u_role != _COMPACTION_MARKER_ROLE:\n+            last_non_sys_idx = u_idx\n+            if u_role not in (\"assistant\", \"tool\"):\n+                user_unit_indices.append(u_idx)\n+\n+    if user_unit_indices:\n+        mandatory_indices.add(user_unit_indices[0])\n+        mandatory_indices.add(user_unit_indices[-1])\n+        # Незавершённая единица ответа (assistant+tool после последнего user, ADR-001.2 §2.2 п.4).\n+        if (\n+            last_non_sys_idx is not None\n+            and last_non_sys_idx > user_unit_indices[-1]\n+            and len(units[last_non_sys_idx]) > 1\n+        ):\n+            mandatory_indices.add(last_non_sys_idx)\n+\n+    return units, mandatory_indices\n+\n+\n+def _compute_mandatory_est_only(\n+    valid_msgs: list[dict[str, Any]],\n+    roles: list[str],\n+    tools: list[dict[str, Any]] | None,\n+    tool_choice: Any,\n+    raw_tools: Any,\n+) -> int:\n+    units, mandatory_indices = _partition_units(valid_msgs, roles)\n+    mandatory_msgs = [\n+        m\n+        for u_idx, unit in enumerate(units)\n+        if u_idx in mandatory_indices\n+        for m in unit\n+    ]\n+    _, _, mandatory_prompt = _assemble_prompt(\n+        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    return _estimate_tokens(mandatory_prompt)\n+\n+\n+def _log_context_prune(\n+    rid: str,\n+    model: str,\n+    reason: str,\n+    attempt: int,\n+    limit: int,\n+    target: int,\n+    res: PruneResult,\n+) -> None:\n+    \"\"\"Структурная запись прунинга без тел сообщений и секретов (ADR-001.4 §4.3).\"\"\"\n+    logger.info(\n+        \"muse_context_pruned: model=%s initial=%d target=%d dropped=%d is_retry=%s\",\n+        model,\n+        res.est_before,\n+        target,\n+        res.msgs_dropped,\n+        attempt > 1,\n+    )\n+    _log(\n+        f\"context_prune rid={rid} model={model} reason={reason} attempt={attempt} \"\n+        f\"limit={limit} target={target} est_before={res.est_before} est_after={res.est_after} \"\n+        f\"msgs_total={res.msgs_total} msgs_kept={res.msgs_kept} msgs_dropped={res.msgs_dropped} \"\n+        f\"mandatory_est={res.mandatory_est} overhead_est={res.overhead_est} method=bytes_div_3\"\n+    )\n \n \n # Эмуляция SSE (OpenAI chat.completion.chunk): результат генерации уже целиком —\n@@ -729,6 +1244,10 @@ class Run:\n             str(self.workdir),\n             \"--json\",\n             \"--no-session-log\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--disable-web-tools\",\n+            \"--disable-reminders\",\n             \"--prompt-file\",\n             prompt_path,\n         ]\n@@ -986,6 +1505,8 @@ class ServeRun:\n             self.model_id,\n             \"--no-session-log\",\n             \"--trust-workspace\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n         ]\n         try:\n             self.proc = subprocess.Popen(\n@@ -1008,6 +1529,8 @@ class ServeRun:\n         os.set_blocking(self.proc.stdin.fileno(), False)\n \n         err_lines: list[str] = []\n+        turn_diag_lines: list[str] = []\n+        stderr_joined = False\n \n         def drain_stderr() -> None:\n             try:\n@@ -1193,6 +1716,8 @@ class ServeRun:\n                         _handle_event(msg, None)\n                         continue\n                     terminal = str(p.get(\"terminal\") or \"unknown\")\n+                    if terminal != \"completed\":\n+                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                     break\n                 if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                     continue  # чужой/дублированный ack — игнор, не разрываем ход\n@@ -1216,7 +1741,19 @@ class ServeRun:\n                 if part not in summaries:\n                     summaries.append(part)\n             text = final_text if final_text is not None else \"\".join(deltas)\n-            err = \"\\n\".join(err_lines[-6:])\n+            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n+            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n+            err_thread.join(timeout=5)\n+            stderr_joined = True\n+            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n+            if self.prompt:\n+                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n+            err = \"\\n\".join(turn_diag_lines)\n+            if err:\n+                if stderr_tail:\n+                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n+            else:\n+                err = stderr_tail\n             if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                 return {\n                     \"rc\": serve_rc,\n@@ -1250,7 +1787,8 @@ class ServeRun:\n                 \"via\": \"serve\",\n             }\n         finally:\n-            err_thread.join(timeout=5)\n+            if not stderr_joined:\n+                err_thread.join(timeout=5)\n             self.close()\n \n \n@@ -1269,11 +1807,13 @@ class Handler(BaseHTTPRequestHandler):\n     _current_run: Run | ServeRun | None = None\n     # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n     _sse_open: bool = False\n+    _content_started: bool = False\n     _sse_id: str = \"\"\n     _sse_created: int = 0\n     _sse_model: str = \"\"\n     _wlock: threading.Lock = threading.Lock()\n-    _ka_stop: threading.Event | None = None\n+    _sse_phase: str = \"OPEN\"\n+    _keepalive_stop: threading.Event | None = None\n     _ka_thread: threading.Thread | None = None\n \n     def setup(self) -> None:\n@@ -1281,21 +1821,38 @@ class Handler(BaseHTTPRequestHandler):\n         self._client_gone = False\n         self._current_run = None\n         self._sse_open = False\n+        self._content_started = False\n         self._sse_id = \"\"\n         self._sse_created = 0\n         self._sse_model = \"\"\n         self._wlock = threading.Lock()\n-        self._ka_stop: threading.Event | None = None\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n+        self._keepalive_stop: threading.Event | None = None\n         self._ka_thread: threading.Thread | None = None\n         super().setup()\n \n     # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n-    def _sse_write(self, text: str) -> bool:\n+    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n         \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n         try:\n             with self._wlock:\n-                self.wfile.write(text.encode(\"utf-8\"))\n-                self.wfile.flush()\n+                if self._sse_phase == \"CLOSED\" or self._client_gone:\n+                    return False\n+                if keepalive and (\n+                    self._sse_phase != \"OPEN\"\n+                    or (\n+                        self._keepalive_stop is not None\n+                        and self._keepalive_stop.is_set()\n+                    )\n+                ):\n+                    return False\n+                try:\n+                    self.wfile.write(text.encode(\"utf-8\"))\n+                    self.wfile.flush()\n+                finally:\n+                    if text == \"data: [DONE]\\n\\n\":\n+                        self._sse_phase = \"CLOSED\"\n             return True\n         except (BrokenPipeError, ConnectionResetError, OSError):\n             if not self._client_gone:\n@@ -1313,14 +1870,18 @@ class Handler(BaseHTTPRequestHandler):\n             \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n         }\n \n-    def _sse_emit(self, obj: dict) -> bool:\n-        return self._sse_write(\"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\")\n+    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n+        return self._sse_write(\n+            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n+        )\n \n     def _sse_begin(self, model: str) -> bool:\n         \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n         self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n         self._sse_created = int(time.time())\n         self._sse_model = model\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n         self.close_connection = True\n         try:\n             self.send_response(200)\n@@ -1337,7 +1898,7 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n             return False\n         stop = threading.Event()\n-        self._ka_stop = stop\n+        self._keepalive_stop = stop\n         self._ka_thread = threading.Thread(\n             target=self._keepalive_loop, args=(stop,), daemon=True\n         )\n@@ -1345,17 +1906,22 @@ class Handler(BaseHTTPRequestHandler):\n         return True\n \n     def _keepalive_loop(self, stop: threading.Event) -> None:\n-        \"\"\"Комментарии `: keepalive`: держат TCP, но не сбрасывают idle-watchdog SDK.\"\"\"\n+        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n         while not stop.wait(KEEPALIVE_S):\n-            if not self._sse_write(\": keepalive\\n\\n\"):\n+            if self._client_gone or stop.is_set():\n+                return\n+            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                 return\n \n     def _sse_stop_keepalive(self) -> None:\n-        if self._ka_stop is not None:\n-            self._ka_stop.set()\n+        if self._keepalive_stop is not None:\n+            self._keepalive_stop.set()\n+        with self._wlock:\n+            if self._sse_phase == \"OPEN\":\n+                self._sse_phase = \"FINALIZING\"\n         if self._ka_thread is not None:\n             self._ka_thread.join(timeout=2)\n-        self._ka_stop = None\n+        self._keepalive_stop = None\n         self._ka_thread = None\n \n     def _client_gone_probe(self) -> bool:\n@@ -1446,6 +2012,8 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_open and not self._sse_begin(model):\n             return\n         self._sse_stop_keepalive()\n+        with self._wlock:\n+            self._content_started = True\n         chunk = self._sse_chunk\n         reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n         if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n@@ -1579,8 +2147,9 @@ class Handler(BaseHTTPRequestHandler):\n         tool_choice = req.get(\"tool_choice\")\n         emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n \n-        system_text, prompt = _messages_to_prompt(req.get(\"messages\") or [])\n-        if not prompt:\n+        raw_messages = req.get(\"messages\") or []\n+        _, raw_turns_text = _messages_to_prompt(raw_messages)\n+        if not raw_turns_text:\n             self._send(\n                 400,\n                 {\n@@ -1591,15 +2160,56 @@ class Handler(BaseHTTPRequestHandler):\n                 },\n             )\n             return\n-        head: list[str] = []\n-        if system_text:\n-            head.append(f\"[system]\\n{system_text}\")\n-        if emulate_tools:\n-            head.append(_tools_section(tools, tool_choice))\n-        elif raw_tools and not system_text:\n-            head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n-        if head:\n-            prompt = \"\\n\\n\".join(head) + f\"\\n\\n{prompt}\"\n+\n+        rid = uuid.uuid4().hex[:8]\n+        limit = _context_limit(model)\n+        target = _context_target(limit)\n+        retry_target = _context_retry_target(limit)\n+        prune_res = _prune_messages(\n+            raw_messages,\n+            limit=limit,\n+            target=target,\n+            tools=tools,\n+            tool_choice=tool_choice,\n+            raw_tools=raw_tools,\n+        )\n+        if prune_res.status == \"refused\":\n+            _log_context_prune(\n+                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n+            )\n+            detail = (\n+                f\"mandatory context exceeds budget \"\n+                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n+            )\n+            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n+            _log(\n+                _format_err_log(\n+                    model,\n+                    \"refused\",\n+                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n+                    req.get(\"stream\") is True,\n+                )\n+            )\n+            self._send(\n+                502,\n+                {\n+                    \"error\": {\n+                        \"message\": _redact_secrets(err_msg),\n+                        \"detail\": _redact_secrets(detail)[:500],\n+                        \"type\": \"proxy_error\",\n+                        \"code\": 502,\n+                    }\n+                },\n+            )\n+            return\n+        if prune_res.status == \"pruned\":\n+            _log_context_prune(\n+                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n+            )\n+\n+        prompt = prune_res.prompt\n+        current_est = prune_res.est_after\n+        reflected_prompts: list[str] = [prompt]\n \n         effort = _map_effort(req)\n \n@@ -1628,46 +2238,139 @@ class Handler(BaseHTTPRequestHandler):\n         )\n         watcher.start()\n         runs: list = []\n-        try:\n+        terminal_context_err: str | None = None\n+        context_retry_count = 0\n+\n+        def run_attempt(attempt_prompt: str) -> tuple[dict[str, Any], str]:\n             # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n             # транспортной неполадке — тихий fallback на проверенный exec.\n-            out: dict[str, Any] | None = None\n-            via = \"exec\"\n+            attempt_out: dict[str, Any]\n+            attempt_via = \"exec\"\n             try:\n-                serve_run = ServeRun(model, prompt, effort, WORKSPACE)\n+                serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n                 runs.append(serve_run)\n                 self._current_run = serve_run\n-                out = serve_run.execute()\n-                via = \"serve\"\n+                attempt_out = serve_run.execute()\n+                attempt_via = \"serve\"\n             except ServeUnavailable as exc:\n                 if self._client_gone:\n                     # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                     _log(\"client gone during serve — exec fallback skipped\")\n-                    out = {\n+                    attempt_out = {\n                         \"rc\": -1,\n                         \"text\": \"\",\n                         \"err\": \"client gone\",\n                         \"state\": \"client_gone\",\n                     }\n-                    via = \"aborted\"\n+                    attempt_via = \"aborted\"\n                 else:\n                     _log(f\"serve unavailable ({exc}), fallback exec model={model}\")\n-                    exec_run = Run(model, prompt, effort, WORKSPACE)\n+                    exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                     runs.append(exec_run)\n                     self._current_run = exec_run\n-                    out = exec_run.execute()\n-                    via = \"exec-after-serve-fallback\"\n+                    attempt_out = exec_run.execute()\n+                    attempt_via = \"exec-after-serve-fallback\"\n                     if (\n-                        out.get(\"rc\") != 0\n+                        attempt_out.get(\"rc\") != 0\n                         and not self._client_gone\n-                        and NETWORK_RETRY_MARKER in str(out.get(\"err\") or \"\")\n+                        and NETWORK_RETRY_MARKER in str(attempt_out.get(\"err\") or \"\")\n                     ):\n                         _log(\"exec hit network marker, single retry\")\n-                        retry_run = Run(model, prompt, effort, WORKSPACE)\n+                        retry_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                         runs.append(retry_run)\n                         self._current_run = retry_run\n-                        out = retry_run.execute()\n-                        via = \"exec-retry\"\n+                        attempt_out = retry_run.execute()\n+                        attempt_via = \"exec-retry\"\n+            return attempt_out, attempt_via\n+\n+        try:\n+            t_first_attempt = time.monotonic()\n+            out, via = run_attempt(prompt)\n+            raw_err = str(out.get(\"err\") or \"\")\n+            is_hard_threshold = (\n+                out.get(\"rc\") != 0\n+                and out.get(\"state\") == \"terminal_failed\"\n+                and HARD_THRESHOLD_ERR_SUBSTR in raw_err\n+            )\n+            if (\n+                is_hard_threshold\n+                and context_retry_count == 0\n+                and not self._client_gone\n+                and not getattr(self, \"_content_started\", False)\n+            ):\n+                for run in runs:\n+                    run.close()\n+                if not all(run.dead_confirmed for run in runs):\n+                    _log(\n+                        \"context retry skipped: first attempt process group not confirmed dead\"\n+                    )\n+                else:\n+                    retry_res = _prune_messages(\n+                        raw_messages,\n+                        limit=retry_target,\n+                        target=retry_target,\n+                        tools=tools,\n+                        tool_choice=tool_choice,\n+                        raw_tools=raw_tools,\n+                    )\n+                    if retry_res.status == \"refused\":\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"refused_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        terminal_context_err = (\n+                            f\"mandatory context exceeds budget \"\n+                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n+                        )\n+                    elif (\n+                        retry_res.est_after >= current_est\n+                        or time.monotonic() - t_first_attempt >= TIMEOUT_S\n+                    ):\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"refused_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        terminal_context_err = (\n+                            f\"context hard threshold exceeded after single compaction retry \"\n+                            f\"(est_tokens={retry_res.est_after}, target={retry_target})\"\n+                        )\n+                    elif self._client_gone or self._client_gone_probe():\n+                        self._client_gone = True\n+                    else:\n+                        context_retry_count = 1\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"hard_threshold_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        prompt = retry_res.prompt\n+                        current_est = retry_res.est_after\n+                        reflected_prompts.append(prompt)\n+                        out, via = run_attempt(prompt)\n+                        raw_err_2 = str(out.get(\"err\") or \"\")\n+                        if (\n+                            out.get(\"rc\") != 0\n+                            and out.get(\"state\") == \"terminal_failed\"\n+                            and HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n+                        ):\n+                            terminal_context_err = (\n+                                f\"context hard threshold exceeded after single compaction retry \"\n+                                f\"(est_tokens={current_est}, target={retry_target})\"\n+                            )\n         finally:\n             # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n             watch_stop.set()\n@@ -1687,12 +2390,40 @@ class Handler(BaseHTTPRequestHandler):\n             # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n             _log(\"client gone — response skipped\")\n             return\n+        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n+        out = dict(out)\n\n<system-reminder>[Showing lines 1-1052 of 2894 total lines]</system-reminder>","timestamp":1791993013172,"session_id":"6aafd459-5304-42f1-9d2a-89b85e0b56ad"}
{"type":"tool_result","id":"toolu_01DeiyNmNq2HqV3EWZn6qNNb","messageId":"ad9a5409-1246-471c-b8d3-29d19817a3c4","toolId":"Read","isError":false,"value":"# Архитектурная спецификация (R2): Muse Wonder в чужих и длинных сессиях DSH\n\nРаунд R2. Заменяет R1. Вход: `analysis/muse-wonder-foreign-session/handoff-architect.md`,\n`evidence-ledger.md` ([F-01]..[F-08]), вердикты судей R1 (Визионер, Скептик: оба NEEDS_WORK).\nПакет: `architecture-packet.json` (та же папка). Нумерация решений: ADR-001.N ≡ AD-00N в пакете.\n\n## 0. Что изменилось относительно R1\n\n| Замечание R1 | Где закрыто |\n|---|---|\n| Три независимые константы лимита (Визионер) | ADR-001.1, §2.1 |\n| Нет гистерезиса, дребезг, кэш префикса (Визионер) | ADR-001.2, §2.3, RISK-002 |\n| Сохранялись только ведущие system/developer; последний user не обязателен (Скептик) | ADR-001.2, §2.2 |\n| Атомарность `tool_calls`/`tool` не определена (оба) | ADR-001.2, §2.4 |\n| Оценка «4 символа на токен» занижает кириллицу и код (оба) | ADR-001.2, §2.5 |\n| Поведение при превышении обязательного набора (оба) | ADR-001.2/001.3, §2.6, §3.3 |\n| Жизненный цикл retry, SSE, счётчики, очистка, дедлайн (оба) | ADR-001.3, §3 |\n| Подстрока ошибки хрупка; маркер в обычном ответе модели (оба) | ADR-001.3, §3.1 |\n| `self._wlock`, чистота функции прунинга (Визионер) | ADR-001.4, §4.1 |\n| Лог события, запрет логировать тела, редакция обеих попыток (оба) | ADR-001.4, §4.2-4.3 |\n| План тестов, red→green, канон проверок (оба) | §6 |\n| Порядок выката зеркала и профилей, откат, живая проверка (оба) | §7 |\n\n## 1. Контекст и проблема\n\n- **REQ-01.** Переключение на `muse-wonder-1.0` / `muse-wonder-full-1.0` в активной сессии DSH с контекстом\n  больше жёсткого лимита Meta не должно давать `terminal_failed`.\n- **Факт [F-01].** `~/.dsh/bridges/muse-bridge/logs/bridge.log:1207` (также `:1203`), 2026-10-14 17:08:24 MSK:\n  `via=serve rc=1 state=terminal_failed err='modelError: context compaction replacement still exceeds the hard threshold (639915 >= 460800 tokens) retryable=True stream=True`.\n  Ссылка в ledger на строку 1222 устарела: в файле 1207 строк.\n- **Факт [F-02/F-03].** `ALLOWED_MODELS` (`bridges/muse-bridge/server.py:77-78`) и профили DSH объявляют окно 1048576.\n  Клиент DSH не компактирует историю до порога Meta. `_messages_to_prompt` (`server.py:454`, вызов `:1767`) склеивает\n  историю без бюджета.\n- **Факт [F-04].** Мост завершает ход 502 сразу, повтора нет (`server.py:1743-1960`, ветка `out[\"state\"] != \"ok\"`).\n- **Граница достижимости.** Если системные инструкции, первый или последний `user` сами не помещаются в бюджет,\n  «безотказная работа» невозможна. В этом случае требуется детерминированный отказ (§2.6), а не молчаливая потеря.\n- **Не цель.** Модели `muse-spark-*` (тоже 1048576 в профилях) не меняются в этом MR (Q-002).\n\n## 2. ADR-001.1 и ADR-001.2\n\n### 2.1 ADR-001.1: единый источник лимита\n\n- **Решение.** Окно модели хранится в одном месте: запись `ALLOWED_MODELS[model]`. Для двух wonder-моделей значение\n  равно `400000`. Все остальные величины выводятся из него:\n  - порог срабатывания `limit = window`;\n  - целевой размер `target = limit * 4 // 5` (для 400000 это ровно 320000);\n  - аварийный размер `retry_target = limit // 2` (200000).\n- **Расхождение с брифом, фиксируется явно.** В коде ключ записи называется `context_length`, а не `contextWindow`\n  (`server.py:73-78`, `:1710`); `contextWindow` существует только в YAML профилей DSH. Поэтому формула из брифа\n  реализуется как `ALLOWED_MODELS.get(model, {}).get(\"context_length\", 400_000)`, оформленная одним помощником\n  `_context_limit(model)`. Второй ключ `contextWindow` в `ALLOWED_MODELS` не вводится: он создал бы второй источник\n  истины. Значение по умолчанию `400_000` задаётся одной константой модуля.\n- **Точки применения (4 значения, не больше).**\n  1. `bridges/muse-bridge/server.py`: `muse-wonder-1.0`, `muse-wonder-full-1.0` -> `context_length: 400000`.\n  2. `~/.dsh/bridges/muse-bridge/server.py`: зеркало. На 2026-10-14 побайтно совпадает с рабочим деревом репозитория\n     (`diff -q` без вывода), включая незакоммиченные правки.\n  3. `~/.dsh/profiles/desktop/cordis.patch.yml`: `contextWindow: 400000` у `id: muse-wonder-1.0` (строка 355) и\n     `id: muse-wonder-full-1.0` (строка 369).\n  4. `~/.dsh/profiles/web/cordis.patch.yml`: то же, строки 453 и 459.\n- **Не трогать.** Записи `muse-spark-*` и все прочие провайдеры (десятки строк `contextWindow: 1048576`). Каталоги\n  `~/.dsh/profiles/web.bak-*` (архивы). Профиль `headless`: `muse-bridge` в нём отсутствует (0 вхождений), проверить повторно\n  перед выкатом.\n- **Тест-регрессия.** `AllowedModelsSyncTest` (`tests/test_muse_bridge_killpg.py:1307`) сейчас жёстко проверяет\n  `1048576`; обновляется первым (red), см. §6.\n\n### 2.2 ADR-001.2: обязательный набор\n\nОпределения опираются на то, как `_messages_to_prompt` уже трактует роли: `system`/`developer` уходят в системный блок,\n`assistant` и `tool` рендерятся как есть, любая прочая роль (включая отсутствующую) считается `user`.\nСообщение с пустым отрендеренным текстом (`_render_turn` вернул пусто) и не-словарь в расчёт не входят.\n\nОбязательный набор M (в порядке неубывания приоритета отказа):\n1. **Все** `system`/`developer` сообщения истории, в том числе поздние вставки.\n2. Первый `user` (исходная постановка).\n3. Последний `user` (текущий запрос). Если он совпадает с первым, сообщение учитывается один раз.\n4. **Незавершённая единица ответа:** если последняя атомарная единица (см. §2.4) стоит позже последнего `user`\n   (типичный цикл агента: `assistant(tool_calls)` + `tool`-результаты), она тоже обязательна. Без неё модель отвечает на\n   вопрос, не видя результата, на который должна ответить. Это уточнение к брифу; оно вытекает из формата DSH и\n   проверяется тестом T-13.\n\nПорядок вывода сохраняет хронологию исходной истории. Системные сообщения по-прежнему выносятся в системный блок\nсуществующей логикой `_messages_to_prompt`.\n\n### 2.3 Пороги и гистерезис\n\n- `est_total` > `limit` (400000) -> прунинг до `target` (320000). `est_total` ≤ `limit` -> запрос проходит без изменений,\n  без маркера и без копирования (QS-02). Граница включительная: ровно `limit` не прунится.\n- Запас до порога клиента 80000, до жёсткого лимита Meta (460800) 140800 токенов оценки.\n- **Честное ограничение.** Мост без состояния. Если клиент не компактирует сам, история на каждом ходу растёт на\n  новый ход, и начало хвоста сдвигается на этот же объём. Гистерезис гарантирует: (а) нет дребезга «пруним / не пруним»\n  вокруг 400k; (б) неизменный префикс (системный блок, секция инструментов, первый `user`, маркер) побайтно стабилен и\n  кэшируется; (в) после компакции на клиенте (он стартует около 400k) префикс хвоста снова стабилен. Стабильность\n  префикса **хвоста** без компакции клиента не гарантируется. Квантование границы среза и серверное состояние сознательно\n  отложены (deferred). См. RISK-002.\n\n### 2.4 Инвариант атомарности инструментов\n\n- **Атомарная единица.** `assistant`-сообщение с непустым `tool_calls` + все `role: \"tool\"` сообщения, чей\n  `tool_call_id` совпадает с `id` любого из этих вызовов. Многовызовный ход (несколько `tool_calls` в одном\n  сообщении) целиком одна единица. Каждое прочее сообщение является отдельной единицей.\n- **Инвариант I-1.** В выходе прунинга нет `role: \"tool\"` без породившего `assistant` с таким же `tool_call_id` в\n  том же выходе, и нет `assistant` с `tool_calls`, у которых часть ответов отброшена, а часть оставлена.\n- **Осиротевшие `tool` во входе** (клиентская ошибка): при прунинге не попадают в выход; при проходе без прунинга\n  остаются как есть (QS-02 требует дословности).\n- Выбор хвоста идёт единицами от новейшей к старейшей, хвост непрерывный: остановка на первой единице, которая не\n  помещается (без перескоков на более мелкие старые единицы).\n\n### 2.5 Оценка токенов\n\n- `est(text) = max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)`. Так как байтов не меньше символов, второй член\n  всегда доминирует; формула записана в брифовой форме, реализация вправе считать только байты.\n- В бюджет входят: системный блок вместе с обёрткой `[system]`, секция `_tools_section(tools, tool_choice)` целиком\n  (`server.py:397`, JSON с `ensure_ascii=False`), разметка ролей (`User: `, `Assistant: `, `[tool result id] (name)`),\n  разделители `\\n\\n`, маркер. Если инструменты не эмулируются, а `raw_tools` есть без system, учитывается\n  `DEFAULT_SYSTEM_HINT`.\n- Округление: к оценке каждой части прибавляется 1 токен, а итог всегда перепроверяется по **собранному** промпту:\n  если `est(промпт) > target` (или `> limit` для жёсткой границы), хвост сокращается ещё на единицу. Тесты проверяют\n  собранный промпт, а не промежуточную сумму.\n- Консервативность имеет цену: для плотной кириллицы (2 байта на символ) оценка выше реальной токенизации, поэтому\n  мост может прунить раньше, чем клиент считает окно исчерпанным. Принято осознанно (F-05); масштаб проверяется на\n  живом ходе (ASM-004).\n\n### 2.6 Отказ при превышении обязательного набора\n\nПусть `base = est(фиксированная часть) + est(M) + est(маркер)`, `cap` = `limit` для проактивного прунинга и\n`retry_target` для retry.\n- `base > cap` -> прунинг не может помочь. Мост **не запускает модель** и отвечает терминально (см. §3.3 и §4.3).\n- Единица из п. 2.2/4 принимается, если `base + cost ≤ cap` (жёсткая граница, `target` здесь мягкая цель); иначе отказ.\n- Остальной хвост добирается до `target` (проактивно) или `retry_target` (retry).\n- Проактивный отказ происходит до `_sse_begin`, поэтому это обычный HTTP 502 JSON. Тело ответа: счётчики оценки и\n  лимит; текст сообщений не включается.\n\n### 2.7 Маркер и чистота функции\n\n- Текст маркера: `[... earlier conversation turns compacted to stay within Muse context limit ...]`. Цифр лимита в\n  тексте нет (единый источник).\n- Маркер вставляется в каждый разрыв между соседними сохранёнными репликами, где отброшены единицы (разрывов не\n  более двух: после первого `user` и перед хвостом, если последний `user` лежит раньше начала хвоста). Если отбрасывать\n  нечего, маркера нет. Рендерится как нейтральная строка без префикса `User:`/`Assistant:` (внутренняя роль\n  сообщения-заметки, обрабатываемая в `_messages_to_prompt`).\n- Прунинг: чистая функция `(messages, limit, target, fixed_overhead_tokens) -> PruneResult`. Исходный список и словари\n  не мутируются, результат собирается из ссылок на неизменённые сообщения. Детерминирован и идемпотентен: повторный\n  прунинг своего выхода с теми же параметрами не меняет его.\n\n## 3. ADR-001.3: аварийный auto-retry\n\n### 3.1 Условие срабатывания (все пункты одновременно)\n\n1. Попытка завершилась неуспехом: `out[\"rc\"] != 0` и `out[\"state\"] == \"terminal_failed\"`.\n2. Подстрока `context compaction replacement still exceeds the hard threshold` найдена в **канале ошибки**\n   (`out[\"err\"]`, сырое значение до редакции), а не в `out[\"text\"]`/`chunks`. Совпадение в обычном ответе модели retry\n   не запускает.\n3. Подстрока хранится одной константой модуля; на неё есть тест (T-17).\n4. `context_retry_count == 0` (отдельный счётчик, не связанный с `NETWORK_RETRY_MARKER` и fallback `serve -> exec`).\n5. Клиент не отключён (`not self._client_gone`), и контентные кадры ещё не отправлялись (§3.2).\n6. Первая попытка очищена: `run.close()` выполнен, `run.dead_confirmed` истинно. Иначе retry не стартует, действует\n   существующий карантин слота.\n7. Прунинг для retry возможен: `base ≤ retry_target` (§2.6) и оценка нового промпта **строго меньше** оценки\n   предыдущей попытки (иначе повтор бессмыслен: тот же промпт).\n8. Не исчерпан суммарный дедлайн хода: `time.monotonic() - t_first_attempt < TIMEOUT_S`. Retry получает остаток, если\n   сигнатура `execute()` позволяет; если нет, Coder фиксирует это в отчёте (принятый верхний предел 2×`TIMEOUT_S`).\n\nПодделка: пользователь может подсунуть текст маркера так, что он отразится в `err`. Последствие ограничено одним повтором\n(пункт 4), прочих побочных эффектов нет.\n\n### 3.2 Граница «до первого контентного чанка»\n\n- В текущем коде SSE открывается заранее (`_sse_begin`: заголовки, role-кадр, keepalive-комментарии), а все\n  reasoning/tool_calls/content-кадры пишет `_send_sse` **после** завершения всех запусков (`server.py:1614`).\n  Поэтому цикл retry целиком лежит до первого контентного кадра и между попытками клиенту уходят только keepalive.\n- Защита на будущее: флаг `self._content_started` (выставляется под `_wlock` перед первой записью reasoning/tool/content\n  кадра). Условие 5 §3.1 проверяет его. Если когда-нибудь появится реальный потоковый вывод, retry после первой дельты\n  запрещён автоматически (повторять нельзя: нарушена идемпотентность потока).\n- Между попытками нет ни `error`-кадра, ни `[DONE]`. Итог ровно один: успех либо терминальная ошибка.\n\n### 3.3 Один повтор и терминальный исход\n\n- `max_retries = 1`, цель среза `retry_target = limit // 2` (200000), промпт собирается из **исходных** `messages`, а не\n  из уже прунённого списка.\n- Повтор использует тот же слот (повторного `_slots.acquire` нет), добавляет `Run`/`ServeRun` в общий `runs` (чтобы\n  `finally` закрыл обе попытки) и переключает `self._current_run`. Транспорт внутри попытки обычный: serve-first,\n  fallback на exec допустим; сетевой retry допустим и не расходует контекстный счётчик. Вторая попытка с тем же маркером\n  контекстный retry **не** запускает.\n- Терминальный исход (повторный отказ, невыполнимый срез, превышение дедлайна, обязательный набор больше\n  `retry_target`):\n  - JSON: HTTP 502, `error.type = proxy_error`, `error.code = 502`;\n  - SSE: один `error`-кадр и один `[DONE]` (существующий путь `_send` в фазе OPEN);\n  - сообщение: `muse turn failed (rc=1, state=terminal_failed): context hard threshold exceeded after single compaction retry (est_tokens=<n>, target=<n>)`\n    либо `...: mandatory context exceeds budget (est_tokens=<n>, limit=<n>)`. В сообщении только числа и константный\n    текст.\n\n## 4. ADR-001.4: безопасность, потоки, наблюдаемость\n\n### 4.1 Потокобезопасность\n\n- `self._wlock` (обычный `threading.Lock`, `server.py:1447`) защищает только запись в SSE-сокет (`_sse_write`).\n  Прунинг и сборка промпта выполняются в потоке запроса до `_sse_begin` и повторно между попытками **без** замков;\n  ни один метод, берущий `_wlock`, не вызывается из прунинга. Тест T-11 фиксирует: во время прунинга `_wlock` не\n  захвачен.\n- Состояние попытки (`context_retry_count`, `_content_started`, предыдущая оценка) живёт в локальных переменных\n  обработчика запроса и в экземпляре `Handler` (по одному на соединение); глобальных изменяемых структур не добавляется.\n\n### 4.2 Секреты и тела сообщений\n\n- Тела отброшенных и сохранённых сообщений, tool arguments, multipart-текст и промпт в лог и диагностику не пишутся.\n- Каждая строка лога и каждое диагностическое сообщение проходит `_redact_secrets` (`server.py:177`).\n- Отражённый промпт убирается для **обеих** попыток: список `reflected_prompts` накапливает промпт каждой попытки;\n  замена `[REDACTED]` и обход `messages` (существующая логика `server.py:1877-1955`) выполняются до усечения до 500\n  символов и во всех приёмниках: лог, JSON, SSE.\n- Детектор retry читает сырой `err` только для сопоставления с константой; в лог и ответ уходит уже отредактированный\n  текст.\n\n### 4.3 Структурное событие прунинга\n\nОдна строка `_log` на каждое срабатывание прунинга и на каждый retry:\n\n```\ncontext_prune rid=<8 hex> model=<id> reason=<proactive_prune|hard_threshold_retry|refused_mandatory|refused_retry> attempt=<1|2> limit=<n> target=<n> est_before=<n> est_after=<n> msgs_total=<n> msgs_kept=<n> msgs_dropped=<n> mandatory_est=<n> overhead_est=<n> method=bytes_div_3\n```\n\n- Только числа и константные слова. `rid` генерируется на запрос (`uuid4().hex[:8]`), связывает строки обеих попыток.\n- Заголовок ответа вроде `X-Muse-Context-Pruned` и переопределение лимитов через env в этот MR не входят (deferred).\n\n## 5. Границы и контракты\n\n- Внешний вход: OpenAI `/v1/chat/completions`, JSON и SSE. Поля запроса и формат ответа успеха не меняются.\n- Внешний выход, изменённый контракт: `context_length` двух wonder-моделей в `/health` и `/v1/models` = 400000\n  (QS-03).\n- Новый внутренний контракт: ошибка 502 с двумя новыми константными текстами (§3.3).\n- Зависимости: только stdlib. Новых пакетов и файлов конфигурации нет.\n\n## 6. Сценарии качества (QA в пакете) и план тестов\n\nФайл новых тестов: `tests/test_muse_bridge_killpg.py` (в нём уже весь harness моста: `load_bridge`, `_BridgeScenario`,\n`install_protocol_wrapper`, `bridge_request`, проверки секретов и отключений). Новый файл поверх не создаётся.\n\nПорядок red -> green: сначала тесты T-00..T-23 (падают), затем реализация, затем зелёный набор. Regression-тест на\nкаждый дефект пишется до исправления.\n\n| ID | Класс | Проверка |\n|---|---|---|\n| T-00 | `AllowedModelsSyncTest` | wonder-модели: `context_length == 400000`; `/health` и `/v1/models` отдают 400000; `muse-spark-*` без изменений |\n| T-01 | `ContextEstimateTest` | оценка: латиница, кириллица (1000 символов -> 666), код, JSON, пусто -> 0; равна `max(chars//3, bytes//3)` |\n| T-02 | `ContextEstimateTest` | `_context_limit`: берётся из `ALLOWED_MODELS` (monkeypatch записи меняет порог); неизвестная модель -> 400000; `target`/`retry_target` выведены |\n| T-03 | `ContextPruneTest` | границы: оценка `limit-1`, `limit` -> без изменений (тождественный список, нет маркера); `limit+1` -> прунинг |\n| T-04 | `ContextPruneTest` | после прунинга оценка **собранного** промпта ≤ 320000 (включая большую секцию инструментов, system, маркер) |\n| T-05 | `ContextPruneTest` | сохраняются все `system`/`developer` (в том числе поздние), первый и последний `user`; один `user` не дублируется |\n| T-06 | `ContextPruneTest` | атомарность: свип по всем бюджетам вокруг границы; в выходе нет `tool` без вызова и нет частично сохранённого многовызовного хода |\n| T-07 | `ContextPruneTest` | осиротевший `tool` во входе: не попадает в прунённый выход; без прунинга остаётся дословно |\n| T-08 | `ContextPruneTest` | кириллица: `chars//3` < порога < `bytes//3` -> прунинг срабатывает (доказательство байтовой основы) |\n| T-09 | `ContextPruneTest` | multipart, `content=None`, пустые, не-словари, неизвестная роль: нет исключений; пустые не становятся первым/последним `user` |\n| T-10 | `ContextPruneTest` | маркер ровно в разрывах, порядок хронологический, детерминизм, идемпотентность повторного прунинга |\n| T-11 | `ContextPruneTest` | вход не мутирован (глубокое сравнение); `_wlock` не захвачен во время прунинга |\n| T-12 | `ContextRetryTest` | обязательный набор > `limit` -> 502 до запуска: `Run`/`ServeRun` не созданы, слот не занят, канарейка текста в ответе и логе отсутствует |\n| T-13 | `ContextPruneTest` | незавершённая единица (assistant+tool после последнего user) сохраняется; не помещается в `cap` -> отказ |\n| T-14 | `ContextPruneTest` | гистерезис: два хода подряд с ростом; префикс (system, tools, первый user, маркер) побайтно одинаков; 399999 не прунится |\n| T-15 | `ContextRetryTest` | ошибка Meta -> успех: ровно 2 запуска, промпт 2 ≤ 200000 и меньше промпта 1, 200 в JSON и SSE; в SSE один `[DONE]`, нет `error` между попытками |\n| T-16 | `ContextRetryTest` | ошибка Meta дважды: ровно 2 запуска, терминальный 502 (JSON) / `error`+один `[DONE]` (SSE), в тексте нет промпта |\n| T-17 | `ContextRetryTest` | другая ошибка -> без контекстного retry; маркер в обычном тексте ответа (rc=0) -> без retry; константа подстроки зафиксирована |\n| T-18 | `ContextRetryTest` | serve недоступен -> exec fallback -> маркер -> контекстный retry один; сетевой retry счётчик не расходует |\n| T-19 | `ContextRetryTest` | отключение клиента между попытками: второго запуска нет, группы убиты, слот свободен |\n| T-20 | `ContextRetryTest` | обязательный набор > 200000 при ошибке Meta: второго запуска нет, терминальный 502 |\n| T-21 | `ContextRetryTest` | срез не уменьшает промпт (оценка не меньше предыдущей) -> терминальный 502 без повтора |\n| T-22 | `ContextRetryTest` | первая попытка не подтверждена мёртвой -> retry не стартует, слот в карантине, освобождён ровно один раз |\n| T-23 | `ContextObservabilityTest` | строка `context_prune` содержит все поля и верный `reason`; канарейки секретов и текста сообщений отсутствуют в логе, JSON и SSE обеих попыток; серия длинных запросов не растит удерживаемые буферы |\n\nКоманда проверки перед MR (Full Suite Gate): `ruff format --check`, `ruff check`, `basedpyright`, полный прогон.\nВ репозитории нет `pyproject.toml`/`uv.lock`, поэтому `uv run pytest -q` без дополнительных ключей не работает; рабочий\nвызов: `uv run --no-project --with pytest python -m pytest -q tests/` (проверено: pytest 8.4.2). R1 называл «полный\nunittest»: заменено.\n\n## 7. Миграция и живая проверка (тяжёлый путь)\n\nПорядок выката (внешние файлы вне git, поэтому каждый шаг отдельный):\n1. До правок: бэкап `~/.dsh/bridges/muse-bridge/server.py` и двух `cordis.patch.yml` в `~/work/backups/` с датой.\n2. Реализация и тесты в репозитории (Coder). В рабочем дереве уже есть чужие незакоммиченные правки\n   `bridges/muse-bridge/server.py` и `tests/test_muse_bridge_killpg.py`: Coder стартует от их фактического состояния,\n   фиксирует `git diff` до работы и не затирает их.\n3. Совет и ACCEPT -> MR (merge делает человек).\n4. Копия `server.py` в зеркало `~/.dsh/bridges/muse-bridge/server.py`, перезапуск моста штатным способом из KB\n   (способ не угадывается: берётся из `knowledge-base`, при отсутствии запись `BLOCKED` владельцу).\n5. Проверка `/health` и `/v1/models`: оба wonder-моделя `context_length: 400000`.\n6. Правка 4 значений в профилях `desktop` и `web` (§2.1 п. 3-4), затем `diff` против бэкапа: изменились ровно 4 строки.\n   Сначала мост, потом профили: при обратном порядке клиент компактирует на 400k, а мост ещё не защищён.\n7. DSH подхватывает профиль при новой сессии или перезагрузке; уже открытые слоты хранят старое окно 1048576\n   (RISK-004), их надо перезапустить.\n\nТяжёлый путь (без него «готово» запрещено):\n- В живой «чужой» сессии владельца с историей, дающей >460800 токенов (прежний сбой 639915), переключиться на\n  `muse-wonder-1.0` и `muse-wonder-full-1.0` и выполнить реальную работу (в том числе вызов инструмента).\n- Повторить ход и сделать два параллельных хода (`MUSE_BRIDGE_MAX_CONCURRENT=2`).\n- Факты: строка `context_prune ... reason=proactive_prune` в `bridge.log`, отсутствие `terminal_failed`, реальные\n  `usage.prompt_tokens` из serve < 460800, отношение оценки к реальному счёту записать (ASM-004), тайминги хода.\n- Retry на живой сессии естественно не вызвать. Проверка: **отдельный** экземпляр моста на другом порту с\n  подменой `MUSE_BRIDGE_CLI` на заглушку, возвращающую ошибку Meta на первой попытке (VER-007). Боевой мост не трогать.\n- Откат: восстановить зеркало и два профиля из бэкапа, перезапустить мост. Прунинг без состояния, миграций данных нет.\n\n## 8. Риски и допущения (сводка; полный список в пакете)\n\n- RISK-001: оценка `bytes//3` не совпадает с токенизатором Meta -> тяжёлый путь и сравнение с `usage`.\n- RISK-002: хвост без компакции клиента сдвигается каждый ход -> кэш хвоста мимо; префикс стабилен. Принято.\n- RISK-003: потеря реплик, молчаливая для пользователя -> маркер для модели и строка `context_prune` для оператора.\n- RISK-004: открытые слоты со старым окном -> перезапуск слотов.\n- RISK-005: retry при нераспознанной смене формата ошибки Meta -> константа и тест; сбой даёт обычный 502.\n- ASM-003 (OPEN, continuable): Muse CLI/serve не держит серверного состояния сессии, которое делало бы урезание входных\n  `messages` бесполезным (замечание Визионера). Проверка: тяжёлый путь, `usage.prompt_tokens` после прунинга.\n- Вопросы владельцу (не блокируют): Q-001 имя ключа `context_length`; Q-002 `muse-spark-*` остаются на 1048576;\n  Q-003 способ перезапуска моста.\n","timestamp":1791993013172,"session_id":"6aafd459-5304-42f1-9d2a-89b85e0b56ad"}
