кст этой сессии (handoff)»\n\nПримеры промптов по каждому скиллу: `PROMPTS.md` рядом с этим файлом.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '678,1040p' bridges/muse-bridge/server.py; sed -n '1930,2594p' bridges/muse-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '678,1040p' bridges/muse-bridge/server.py; sed -n '1930,2594p' bridges/muse-bridge/server.py\"","aggregated_output":"    return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n\n\ndef _estimate_tokens(text: str) -> int:\n    \"\"\"Консервативная оценка токенов по UTF-8 байтам и символам (ADR-001.2 §2.5).\"\"\"\n    if not text:\n        return 0\n    return max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)\n\n\ndef _context_limit(model: str) -> int:\n    \"\"\"Единый источник лимита окна модели из ALLOWED_MODELS (ADR-001.1).\"\"\"\n    spec = ALLOWED_MODELS.get(model)\n    if isinstance(spec, dict):\n        val = spec.get(\"context_length\")\n        if isinstance(val, int) and val > 0:\n            return val\n    return DEFAULT_CONTEXT_LIMIT\n\n\ndef _context_target(limit: int) -> int:\n    \"\"\"Целевой бюджет проактивного прунинга с гистерезисом 80% (ADR-001.1).\"\"\"\n    return (limit * 4) // 5\n\n\ndef _context_retry_target(limit: int) -> int:\n    \"\"\"Аварийный бюджет однократного retry 50% (ADR-001.1).\"\"\"\n    return limit // 2\n\n\nclass PruneResult(NamedTuple):\n    status: str  # \"pass_through\" | \"pruned\" | \"refused\"\n    messages: list[dict[str, Any]]\n    prompt: str\n    est_before: int\n    est_after: int\n    msgs_total: int\n    msgs_kept: int\n    msgs_dropped: int\n    mandatory_est: int\n    overhead_est: int\n\n\ndef _overhead_tokens_estimate(\n    has_system: bool,\n    tools: list[dict[str, Any]] | None,\n    tool_choice: Any,\n    raw_tools: Any,\n) -> int:\n    \"\"\"Оценка фиксированной шапки промпта ([system], схемы инструментов, DEFAULT_SYSTEM_HINT).\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n    overhead = 0\n    if has_system:\n        overhead += _estimate_tokens(\"[system]\\n\") + 1\n    if emulate_tools:\n        overhead += _estimate_tokens(_tools_section(clean_tools, tool_choice)) + 1\n    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not has_system:\n        overhead += _estimate_tokens(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\") + 1\n    return overhead\n\n\ndef _prune_messages(\n    messages: list[dict[str, Any]],\n    limit: int,\n    target: int,\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> PruneResult:\n    \"\"\"Чистая функция защитного прунинга истории диалога (ADR-001.2).\"\"\"\n    _, _, full_prompt = _assemble_prompt(\n        messages, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    est_before = _estimate_tokens(full_prompt)\n\n    valid_msgs: list[dict[str, Any]] = []\n    roles: list[str] = []\n    real_msgs_total = 0\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        valid_msgs.append(msg)\n        roles.append(role)\n        if role != _COMPACTION_MARKER_ROLE:\n            real_msgs_total += 1\n\n    has_system = any(r in (\"system\", \"developer\") for r in roles)\n    overhead_est = _overhead_tokens_estimate(has_system, tools, tool_choice, raw_tools)\n\n    if est_before <= limit:\n        mandatory_est = _compute_mandatory_est_only(\n            valid_msgs, roles, tools, tool_choice, raw_tools\n        )\n        return PruneResult(\n            status=\"pass_through\",\n            messages=messages,\n            prompt=full_prompt,\n            est_before=est_before,\n            est_after=est_before,\n            msgs_total=real_msgs_total,\n            msgs_kept=real_msgs_total,\n            msgs_dropped=0,\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n\n    units, mandatory_indices = _partition_units(valid_msgs, roles)\n\n    def build_candidate(kept_flags: list[bool]) -> list[dict[str, Any]]:\n        pruned: list[dict[str, Any]] = []\n        seen_kept_turn = False\n        in_dropped_gap = False\n        for u_idx, unit in enumerate(units):\n            u_role = _render_turn(unit[0])[0]\n            if u_role in (\"system\", \"developer\"):\n                pruned.extend(unit)\n                continue\n            if u_role == _COMPACTION_MARKER_ROLE:\n                if seen_kept_turn:\n                    in_dropped_gap = True\n                continue\n            if kept_flags[u_idx]:\n                if in_dropped_gap:\n                    pruned.append(\n                        {\"role\": _COMPACTION_MARKER_ROLE, \"content\": COMPACTION_MARKER}\n                    )\n                    in_dropped_gap = False\n                pruned.extend(unit)\n                seen_kept_turn = True\n            else:\n                if seen_kept_turn:\n                    in_dropped_gap = True\n        return pruned\n\n    kept = [i in mandatory_indices for i in range(len(units))]\n    mandatory_msgs = build_candidate(kept)\n    _, _, mandatory_prompt = _assemble_prompt(\n        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    mandatory_est = _estimate_tokens(mandatory_prompt)\n    cap = max(limit, target)\n    if mandatory_est > cap:\n        kept_count = sum(\n            len(units[i])\n            for i in range(len(units))\n            if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n        )\n        return PruneResult(\n            status=\"refused\",\n            messages=mandatory_msgs,\n            prompt=mandatory_prompt,\n            est_before=est_before,\n            est_after=mandatory_est,\n            msgs_total=real_msgs_total,\n            msgs_kept=kept_count,\n            msgs_dropped=max(0, real_msgs_total - kept_count),\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n\n    # Фаза C: непрерывный суффикс опциональных единиц от новейшей к старейшей.\n    for u_idx in range(len(units) - 1, -1, -1):\n        if u_idx in mandatory_indices:\n            continue\n        if _render_turn(units[u_idx][0])[0] == _COMPACTION_MARKER_ROLE:\n            continue\n        kept[u_idx] = True\n        cand_msgs = build_candidate(kept)\n        _, _, cand_prompt = _assemble_prompt(\n            cand_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n        )\n        if _estimate_tokens(cand_prompt) <= target:\n            continue\n        kept[u_idx] = False\n        break\n\n    pruned_msgs = build_candidate(kept)\n    _, _, pruned_prompt = _assemble_prompt(\n        pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    est_after = _estimate_tokens(pruned_prompt)\n    while est_after > target:\n        opt_indices = [\n            i\n            for i in range(len(units))\n            if kept[i]\n            and i not in mandatory_indices\n            and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n        ]\n        if not opt_indices:\n            break\n        kept[opt_indices[0]] = False\n        pruned_msgs = build_candidate(kept)\n        _, _, pruned_prompt = _assemble_prompt(\n            pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n        )\n        est_after = _estimate_tokens(pruned_prompt)\n\n    kept_count = sum(\n        len(units[i])\n        for i in range(len(units))\n        if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n    )\n    dropped_count = max(0, real_msgs_total - kept_count)\n    if est_after > cap:\n        return PruneResult(\n            status=\"refused\",\n            messages=pruned_msgs,\n            prompt=pruned_prompt,\n            est_before=est_before,\n            est_after=est_after,\n            msgs_total=real_msgs_total,\n            msgs_kept=kept_count,\n            msgs_dropped=dropped_count,\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n    return PruneResult(\n        status=\"pruned\",\n        messages=pruned_msgs,\n        prompt=pruned_prompt,\n        est_before=est_before,\n        est_after=est_after,\n        msgs_total=real_msgs_total,\n        msgs_kept=kept_count,\n        msgs_dropped=dropped_count,\n        mandatory_est=mandatory_est,\n        overhead_est=overhead_est,\n    )\n\n\ndef _partition_units(\n    valid_msgs: list[dict[str, Any]], roles: list[str]\n) -> tuple[list[list[dict[str, Any]]], set[int]]:\n    \"\"\"Разбить валидные сообщения на атомарные единицы и выделить обязательные индексы M.\"\"\"\n    units: list[list[dict[str, Any]]] = []\n    consumed_tools: set[int] = set()\n\n    for idx, msg in enumerate(valid_msgs):\n        role = roles[idx]\n        if role == \"tool\":\n            # Осиротевшие tool не попадают в units при прунинге; связанные поглощаются assistant.\n            continue\n        if (\n            role == \"assistant\"\n            and isinstance(msg.get(\"tool_calls\"), list)\n            and msg.get(\"tool_calls\")\n        ):\n            call_ids = [\n                _normalize_tool_call(tc)[\"id\"]\n                for tc in msg[\"tool_calls\"]\n                if _normalize_tool_call(tc)[\"id\"]\n            ]\n            if call_ids:\n                expected = set(call_ids)\n                matched_indices: list[int] = []\n                matched_ids: set[str] = set()\n                for j in range(idx + 1, len(valid_msgs)):\n                    if j in consumed_tools or roles[j] != \"tool\":\n                        continue\n                    tc_id = str(\n                        valid_msgs[j].get(\"tool_call_id\")\n                        or valid_msgs[j].get(\"id\")\n                        or \"\"\n                    )\n                    if tc_id in expected:\n                        matched_indices.append(j)\n                        matched_ids.add(tc_id)\n                if matched_ids == expected:\n                    consumed_tools.update(matched_indices)\n                    units.append([msg] + [valid_msgs[j] for j in matched_indices])\n                continue\n        units.append([msg])\n\n    mandatory_indices: set[int] = set()\n    user_unit_indices: list[int] = []\n    last_non_sys_idx: int | None = None\n    for u_idx, unit in enumerate(units):\n        u_role = _render_turn(unit[0])[0]\n        if u_role in (\"system\", \"developer\"):\n            mandatory_indices.add(u_idx)\n        elif u_role != _COMPACTION_MARKER_ROLE:\n            last_non_sys_idx = u_idx\n            if u_role not in (\"assistant\", \"tool\"):\n                user_unit_indices.append(u_idx)\n\n    if user_unit_indices:\n        mandatory_indices.add(user_unit_indices[0])\n        mandatory_indices.add(user_unit_indices[-1])\n        # Незавершённая единица ответа (assistant+tool после последнего user, ADR-001.2 §2.2 п.4).\n        if (\n            last_non_sys_idx is not None\n            and last_non_sys_idx > user_unit_indices[-1]\n            and len(units[last_non_sys_idx]) > 1\n        ):\n            mandatory_indices.add(last_non_sys_idx)\n\n    return units, mandatory_indices\n\n\ndef _compute_mandatory_est_only(\n    valid_msgs: list[dict[str, Any]],\n    roles: list[str],\n    tools: list[dict[str, Any]] | None,\n    tool_choice: Any,\n    raw_tools: Any,\n) -> int:\n    units, mandatory_indices = _partition_units(valid_msgs, roles)\n    mandatory_msgs = [\n        m\n        for u_idx, unit in enumerate(units)\n        if u_idx in mandatory_indices\n        for m in unit\n    ]\n    _, _, mandatory_prompt = _assemble_prompt(\n        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    return _estimate_tokens(mandatory_prompt)\n\n\ndef _log_context_prune(\n    rid: str,\n    model: str,\n    reason: str,\n    attempt: int,\n    limit: int,\n    target: int,\n    res: PruneResult,\n) -> None:\n    \"\"\"Структурная запись прунинга без тел сообщений и секретов (ADR-001.4 §4.3).\"\"\"\n    logger.info(\n        \"muse_context_pruned: model=%s initial=%d target=%d dropped=%d is_retry=%s\",\n        model,\n        res.est_before,\n        target,\n        res.msgs_dropped,\n        attempt > 1,\n    )\n    _log(\n        f\"context_prune rid={rid} model={model} reason={reason} attempt={attempt} \"\n        f\"limit={limit} target={target} est_before={res.est_before} est_after={res.est_after} \"\n        f\"msgs_total={res.msgs_total} msgs_kept={res.msgs_kept} msgs_dropped={res.msgs_dropped} \"\n        f\"mandatory_est={res.mandatory_est} overhead_est={res.overhead_est} method=bytes_div_3\"\n    )\n\n\n# Эмуляция SSE (OpenAI chat.completion.chunk): результат генерации уже целиком —\n# «стрим» = нарезка готового текста на чанки с минимальной задержкой между ними.\nSSE_CHUNK_SIZE = int(os.environ.get(\"MUSE_BRIDGE_SSE_CHUNK_SIZE\", \"300\"))\nSSE_CHUNK_DELAY_S = float(os.environ.get(\"MUSE_BRIDGE_SSE_CHUNK_DELAY_S\", \"0.005\"))\n# stream=true: заголовки и role-кадр уходят сразу, пока ход идёт — комментарии keepalive.\n# Без них клиент (OpenAI SDK в DeepSeek Harness) ждал заголовков до своего таймаута\n# (~600 с) и рвал долгий ход как \"Request timed out\".\nKEEPALIVE_S = float(os.environ.get(\"MUSE_BRIDGE_KEEPALIVE_S\", \"15\"))\n\n\ndef _split_sse_chunks(text: str, size: int = 0) -> list[str]:\n        Режим сокета (timeout/blocking) не меняется: сокет общий с _sse_write\n        в соседних потоках, смена режима из пробы ломала бы их запись. Peek идёт\n        флагом MSG_DONTWAIT; select(0) заранее отсекает случай «данных нет».\n        \"\"\"\n        conn = self.connection\n        if conn is None:\n            return False\n        try:\n            ready, _, _ = select.select([conn], [], [], 0)\n        except (OSError, ValueError):\n            return True\n        if not ready:\n            return False\n        try:\n            data = conn.recv(1, socket.MSG_PEEK | getattr(socket, \"MSG_DONTWAIT\", 0))\n        except (BlockingIOError, InterruptedError):\n            return False\n        except OSError:\n            return True\n        return data == b\"\"\n\n    def _kill_current_run(self) -> None:\n        \"\"\"Убить группу текущего хода: призраки не переживают обрыв клиента.\"\"\"\n        run = self._current_run\n        if run is not None:\n            run.close()\n\n    def _watch_client(self, stop: threading.Event) -> None:\n        \"\"\"Надзор за клиентом во время хода: обрыв -> флаг + killpg группы хода.\n\n        Не выходит после первого убийства: ход может зарегистрироваться (или запустить\n        процесс) уже после обрыва — kill идемпотентен и повторяется каждый тик до stop.\n        \"\"\"\n        reported = False\n        while not stop.wait(0.25):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                if not reported:\n                    reported = True\n                    _log(\"client gone during run — killing process group\")\n                self._kill_current_run()\n\n    def _send(self, code: int, payload: dict) -> None:\n        if self._sse_open:\n            # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n            self._sse_stop_keepalive()\n            error = payload.get(\"error\") if isinstance(payload, dict) else None\n            if isinstance(error, dict):\n                error = dict(error)\n                error.setdefault(\"code\", int(code))\n            self._sse_emit({\"error\": error or payload})\n            self._sse_write(\"data: [DONE]\\n\\n\")\n            return\n        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n        try:\n            self.send_response(int(code))\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before response\")\n            self._kill_current_run()\n\n    def _send_sse(\n        self,\n        model: str,\n        content: str,\n        tool_calls: list[dict],\n        prompt_tokens: int,\n        completion_tokens: int,\n        reasoning_tokens: int,\n        summaries: list[str] | None = None,\n    ) -> None:\n        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n\n        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n        \"\"\"\n        finish = \"tool_calls\" if tool_calls else \"stop\"\n        if not self._sse_open and not self._sse_begin(model):\n            return\n        self._sse_stop_keepalive()\n        with self._wlock:\n            self._content_started = True\n        chunk = self._sse_chunk\n        reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n        if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n            return\n        for tc in tool_calls:\n            fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n            delta = {\n                \"tool_calls\": [\n                    {\n                        \"index\": tc.get(\"index\", 0),\n                        \"id\": tc.get(\"id\", \"\"),\n                        \"type\": \"function\",\n                        \"function\": {\n                            \"name\": fn.get(\"name\", \"\"),\n                            \"arguments\": fn.get(\"arguments\", \"\"),\n                        },\n                    }\n                ]\n            }\n            if not self._sse_emit(chunk(delta)):\n                return\n        for piece in _split_sse_chunks(content):\n            if not self._sse_emit(chunk({\"content\": piece})):\n                return\n            if SSE_CHUNK_DELAY_S > 0:\n                time.sleep(SSE_CHUNK_DELAY_S)\n        final = chunk({}, finish)\n        final[\"usage\"] = {\n            \"prompt_tokens\": prompt_tokens,\n            \"completion_tokens\": completion_tokens,\n            \"total_tokens\": prompt_tokens + completion_tokens,\n            \"reasoning_tokens\": reasoning_tokens,\n        }\n        if self._sse_emit(final):\n            self._sse_write(\"data: [DONE]\\n\\n\")\n\n    def do_GET(self) -> None:  # noqa: N802\n        path = self.path.split(\"?\", 1)[0]\n        if path in (\"/health\", \"/v1/health\"):\n            with _active_lock:\n                active = len(_active)\n                quarantined = len(_quarantined_slots)\n            self._send(\n                200,\n                {\n                    \"ok\": True,\n                    \"transport\": \"muse-cli\",\n                    \"wrapper\": MUSE_WRAPPER,\n                    \"models\": sorted(ALLOWED_MODELS),\n                    \"default_model\": DEFAULT_MODEL,\n                    \"default_effort\": DEFAULT_EFFORT,\n                    \"active\": active,\n                    \"quarantined\": quarantined,\n                    \"max_concurrent\": MAX_CONCURRENT,\n                    \"stream\": True,\n                    \"tool_emulation\": True,\n                    \"uptime_s\": int(time.time() - _started),\n                },\n            )\n            return\n        if not _auth_ok(self):\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        if path in (\"/v1/models\", \"/models\"):\n            self._send(\n                200,\n                {\n                    \"object\": \"list\",\n                    \"data\": [\n                        {\n                            \"id\": mid,\n                            \"object\": \"model\",\n                            \"owned_by\": \"meta-muse\",\n                            \"created\": 0,\n                            \"context_length\": meta[\"context_length\"],\n                        }\n                        for mid, meta in ALLOWED_MODELS.items()\n                    ],\n                },\n            )\n            return\n        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n\n    def do_POST(self) -> None:  # noqa: N802\n        if not _auth_ok(self):\n            self.close_connection = True\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        path = self.path.split(\"?\", 1)[0]\n        length = int(self.headers.get(\"Content-Length\") or \"0\")\n        raw = self.rfile.read(length) if length else b\"{}\"\n        try:\n            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n        except ValueError:\n            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n            return\n        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n            return\n        try:\n            self._serve_json(req)\n        finally:\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n\n    def _serve_json(self, req: dict) -> None:\n        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n        if model not in ALLOWED_MODELS:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n                        \"type\": \"invalid_request_error\",\n                        \"code\": \"model_not_found\",\n                    }\n                },\n            )\n            return\n\n        raw_tools = req.get(\"tools\")\n        tools = (\n            [t for t in raw_tools if isinstance(t, dict)]\n            if isinstance(raw_tools, list)\n            else []\n        )\n        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        raw_messages = req.get(\"messages\") or []\n        _, raw_turns_text = _messages_to_prompt(raw_messages)\n        if not raw_turns_text:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n\n        rid = uuid.uuid4().hex[:8]\n        limit = _context_limit(model)\n        target = _context_target(limit)\n        retry_target = _context_retry_target(limit)\n        prune_res = _prune_messages(\n            raw_messages,\n            limit=limit,\n            target=target,\n            tools=tools,\n            tool_choice=tool_choice,\n            raw_tools=raw_tools,\n        )\n        if prune_res.status == \"refused\":\n            _log_context_prune(\n                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n            )\n            detail = (\n                f\"mandatory context exceeds budget \"\n                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n            )\n            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n            _log(\n                _format_err_log(\n                    model,\n                    \"refused\",\n                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n                    req.get(\"stream\") is True,\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_msg),\n                        \"detail\": _redact_secrets(detail)[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if prune_res.status == \"pruned\":\n            _log_context_prune(\n                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n            )\n\n        prompt = prune_res.prompt\n        current_est = prune_res.est_after\n        reflected_prompts: list[str] = [prompt]\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        waited = time.monotonic()\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n                return\n            if time.monotonic() - waited > TIMEOUT_S:\n                self._send(\n                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n                )\n                return\n        if self._client_gone or self._client_gone_probe():\n            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n            self._client_gone = True\n            _log(\"client gone while waiting for a slot\")\n            _slots.release()\n            return\n        watch_stop = threading.Event()\n        watcher = threading.Thread(\n            target=self._watch_client, args=(watch_stop,), daemon=True\n        )\n        watcher.start()\n        runs: list = []\n        terminal_context_err: str | None = None\n        context_retry_count = 0\n\n        def run_attempt(attempt_prompt: str) -> tuple[dict[str, Any], str]:\n            # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n            # транспортной неполадке — тихий fallback на проверенный exec.\n            attempt_out: dict[str, Any]\n            attempt_via = \"exec\"\n            try:\n                serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n                runs.append(serve_run)\n                self._current_run = serve_run\n                attempt_out = serve_run.execute()\n                attempt_via = \"serve\"\n            except ServeUnavailable as exc:\n                if self._client_gone:\n                    # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                    _log(\"client gone during serve — exec fallback skipped\")\n                    attempt_out = {\n                        \"rc\": -1,\n                        \"text\": \"\",\n                        \"err\": \"client gone\",\n                        \"state\": \"client_gone\",\n                    }\n                    attempt_via = \"aborted\"\n                else:\n                    _log(f\"serve unavailable ({exc}), fallback exec model={model}\")\n                    exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                    runs.append(exec_run)\n                    self._current_run = exec_run\n                    attempt_out = exec_run.execute()\n                    attempt_via = \"exec-after-serve-fallback\"\n                    if (\n                        attempt_out.get(\"rc\") != 0\n                        and not self._client_gone\n                        and NETWORK_RETRY_MARKER in str(attempt_out.get(\"err\") or \"\")\n                    ):\n                        _log(\"exec hit network marker, single retry\")\n                        retry_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                        runs.append(retry_run)\n                        self._current_run = retry_run\n                        attempt_out = retry_run.execute()\n                        attempt_via = \"exec-retry\"\n            return attempt_out, attempt_via\n\n        try:\n            t_first_attempt = time.monotonic()\n            out, via = run_attempt(prompt)\n            raw_err = str(out.get(\"err\") or \"\")\n            is_hard_threshold = (\n                out.get(\"rc\") != 0\n                and out.get(\"state\") == \"terminal_failed\"\n                and HARD_THRESHOLD_ERR_SUBSTR in raw_err\n            )\n            if (\n                is_hard_threshold\n                and context_retry_count == 0\n                and not self._client_gone\n                and not getattr(self, \"_content_started\", False)\n            ):\n                for run in runs:\n                    run.close()\n                if not all(run.dead_confirmed for run in runs):\n                    _log(\n                        \"context retry skipped: first attempt process group not confirmed dead\"\n                    )\n                else:\n                    retry_res = _prune_messages(\n                        raw_messages,\n                        limit=retry_target,\n                        target=retry_target,\n                        tools=tools,\n                        tool_choice=tool_choice,\n                        raw_tools=raw_tools,\n                    )\n                    if retry_res.status == \"refused\":\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            f\"mandatory context exceeds budget \"\n                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n                        )\n                    elif (\n                        retry_res.est_after >= current_est\n                        or time.monotonic() - t_first_attempt >= TIMEOUT_S\n                    ):\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            f\"context hard threshold exceeded after single compaction retry \"\n                            f\"(est_tokens={retry_res.est_after}, target={retry_target})\"\n                        )\n                    elif self._client_gone or self._client_gone_probe():\n                        self._client_gone = True\n                    else:\n                        context_retry_count = 1\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"hard_threshold_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        prompt = retry_res.prompt\n                        current_est = retry_res.est_after\n                        reflected_prompts.append(prompt)\n                        out, via = run_attempt(prompt)\n                        raw_err_2 = str(out.get(\"err\") or \"\")\n                        if (\n                            out.get(\"rc\") != 0\n                            and out.get(\"state\") == \"terminal_failed\"\n                            and HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n                        ):\n                            terminal_context_err = (\n                                f\"context hard threshold exceeded after single compaction retry \"\n                                f\"(est_tokens={current_est}, target={retry_target})\"\n                            )\n        finally:\n            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n            watch_stop.set()\n            watcher.join(timeout=2)\n            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n            # между Popen и собственным finally execute().\n            for run in runs:\n                run.close()\n            if all(run.dead_confirmed for run in runs):\n                _slots.release()\n            else:\n                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n\n        if self._client_gone:\n            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n            _log(\"client gone — response skipped\")\n            return\n        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n        out = dict(out)\n        diagnostic = _redact_secrets(str(out.get(\"err\") or \"\"))\n        control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n        for ref_prompt in reflected_prompts:\n            if len(ref_prompt.strip()) >= 8:\n                diagnostic = diagnostic.replace(ref_prompt, \"[REDACTED]\")\n            for part in _prompt_reflected_parts(ref_prompt):\n                diagnostic = diagnostic.replace(part, \"[REDACTED]\")\n                norm_part = re.sub(control_chars, \" \", part).strip()\n                if len(norm_part) >= 8:\n                    diagnostic = diagnostic.replace(norm_part, \"[REDACTED]\")\n                if len(norm_part) >= 160:\n                    diagnostic = diagnostic.replace(norm_part[:160], \"[REDACTED]\")\n        for message in raw_messages:\n            if isinstance(message, dict):\n                reflected = _flatten_content(message.get(\"content\")).strip()\n                if len(reflected) >= 8:\n                    diagnostic = diagnostic.replace(reflected, \"[REDACTED]\")\n                    normalized = re.sub(control_chars, \" \", reflected)\n                    diagnostic = diagnostic.replace(normalized, \"[REDACTED]\")\n                    if len(normalized) >= 160:\n                        diagnostic = diagnostic.replace(normalized[:160], \"[REDACTED]\")\n        if terminal_context_err is not None:\n            diagnostic = _redact_secrets(terminal_context_err)\n        out[\"err\"] = _redact_secrets(diagnostic)\n        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n            err_message = (\n                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n            )\n            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n                err_message = f\"{err_message}: {detail}\"\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_message),\n                        \"detail\": detail,\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        content = out[\"text\"]\n        tool_calls: list[dict] = []\n        if emulate_tools and content:\n            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n        if not content and not tool_calls:\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(\n                _format_err_log(\n                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n                )\n            )\n            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n            err_message = (\n                f\"muse exec produced no text (rc={out.get('rc')}, \"\n                f\"state={out.get('state')}){hint}\"\n            )\n            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n                err_message = f\"{err_message}: {detail}\"\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_message),\n                        \"detail\": detail,\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n\n        prompt_tokens = _estimate_tokens(prompt)\n        completion_tokens = _estimate_tokens(out[\"text\"])\n        # Serve даёт настоящие токены (session/tokenUsage); exec — оценку.\n        # tokenUsage serve не даёт promptTokens — фолбэк на оценку по каждому\n        # полю отдельно (раньше общий if занулял prompt при пустом поле).\n        ru = out.get(\"usage\") if isinstance(out.get(\"usage\"), dict) else {}\n        ru_prompt = ru.get(\"promptTokens\") or ru.get(\"prompt_tokens\") or 0\n        ru_output = ru.get(\"outputTokens\") or ru.get(\"output_tokens\") or 0\n        try:\n            ru_prompt = int(ru_prompt)\n        except (TypeError, ValueError):\n            ru_prompt = 0\n        try:\n            ru_output = int(ru_output)\n        except (TypeError, ValueError):\n            ru_output = 0\n        if ru_prompt > 0:\n            prompt_tokens = ru_prompt\n        if ru_output > 0:\n            completion_tokens = ru_output\n        ru_reasoning = ru.get(\"reasoningTokens\") or ru.get(\"reasoning_tokens\") or 0\n        try:\n            reasoning_tokens = int(ru_reasoning)\n        except (TypeError, ValueError):\n            reasoning_tokens = 0\n        if reasoning_tokens < 0:\n            reasoning_tokens = 0\n        raw_summaries = out.get(\"summaries\")\n        summaries: list[str] = (\n            [s for s in raw_summaries if isinstance(s, str)]\n            if isinstance(raw_summaries, list)\n            else []\n        )\n        sum_chars = sum(len(s) for s in summaries)\n        if summaries:\n            preview = next((s for s in summaries if s), \"\")[:300]\n            _log(\n                f\"reasoning summaries={len(summaries)} chars={sum_chars} \"\n                f\"reasoning_tokens={reasoning_tokens} preview={preview!r}\"\n            )\n        message: dict[str, Any] = {\"role\": \"assistant\", \"content\": content}\n        finish = \"stop\"\n        if tool_calls:\n            message[\"tool_calls\"] = tool_calls\n            finish = \"tool_calls\"\n        _log(\n            f\"done model={model} via={via} rc={out.get('rc')} state={out.get('state')} \"\n            f\"tools={len(tool_calls)} out_chars={len(out['text'])} \"\n            f\"stream={req.get('stream') is True}\"\n        )\n        if req.get(\"stream\") is True:\n            self._send_sse(\n                model,\n                content,\n                tool_calls,\n                prompt_tokens,\n                completion_tokens,\n                reasoning_tokens,\n                summaries,\n            )\n            return\n        self._send(\n            200,\n            {\n                \"id\": f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\",\n                \"object\": \"chat.completion\",\n                \"created\": int(time.time()),\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n                \"usage\": {\n                    \"prompt_tokens\": prompt_tokens,\n                    \"completion_tokens\": completion_tokens,\n                    \"total_tokens\": prompt_tokens + completion_tokens,\n                    \"reasoning_tokens\": reasoning_tokens,\n                },\n                \"reasoning_summaries\": summaries,\n            },\n        )\n\n\nclass Server(ThreadingHTTPServer):\n    daemon_threads = True\n    allow_reuse_address = True\n\n\ndef main() -> int:\n    if not AUTH_KEY:\n        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n        return 2\n    try:\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n    except OSError as exc:\n        _log(f\"workspace mkdir failed: {exc}\")\n    _log(\n        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n    )\n    server = Server((HOST, PORT), Handler)\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        server.server_close()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"SHA-256 diff совпал с брифом. Проверяю атомарность tool-групп и переход между попытками: именно здесь возможны потеря контекста и запуск retry до завершения уборки первого процесса.\n"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/review.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/review.md'\"","aggregated_output":"---\nname: teamlead-gate\ndescription: >-\n  Полный защищённый цикл разработки с приёмкой кода советом тимлидов: сначала\n  orchestrate-coder-reviewer-summarizer (Reviewer заменён панелью), затем совет\n  (universal-panel, mode=code, судьи из `role-setups.md`): судьи спорят и\n  договариваются по каждой находке (дебаты, согласованный леджер) до инструкций\n  Coder и выносят ACCEPT или REJECT. Тимлид прогоняет diff в чистой среде\n  (L1/L2/L3), доказывает чувствительность тестов; oracle фиксируется до Coder.\n  При NEEDS WORK panel-rework-summarizer пишет Coder instructions, замечания\n  возвращаются на новый цикл до ACCEPT (потолок 5 циклов).\n  Триггеры: «запускай разработку по скилу техлид» (default), «… техлид фаст» (fast),\n  «… техлид квалити» (quality), «тимлид-гейт», «teamlead gate», «судьи совета\n  разошлись», «пусть тимлиды договорятся». Не для мелких правок.\n---\n\n# teamlead-gate — разработка с приёмкой кода советом тимлидов\n\nМеханика совета — `references/council.md`, совещание судей (дебаты, консенсус-леджер) —\n`references/council-consensus.md`; бриф Coder — `references/coder-brief.md`;\nпараллельные кодеры — `references/parallel-coders.md`. Здесь — инварианты, стопы, гейты.\nДоп. триггеры: «несколько кодеров параллельно» → parallel-coders.md; «бриф\nкодеру с критериями приёмки» → coder-brief.md; «совет нашёл не всё за круг» → council §3;\n«судьи спорят/не договорились» → council-consensus.md.\n\nФайлы и проверки: независимые Read/Grep/ls, Edit/Write разных файлов, cp/diff/wc — ОДНИМ сообщением, списком заранее (~/Мой диск/skils/panel-backends/references/parallelism-params.md §1); волнами и по одному — нарушение.\n\n## Вопросы владельцу (аналитик / архитектор / координатор)\n\nКанон БЛОКЕР/МОЖНО ПРОДОЛЖИТЬ, «падение транспорта — не БЛОКЕР» — `references/report-vpn-formats.md` § 1.\n\n## ⭐ КРИТИЧЕСКИЙ ИНВАРИАНТ: ЗАМКНУТЫЙ ЦИКЛ ДО ACCEPT (LOOP UNTIL ACCEPT)\n\n**Замечания Совета Тимлидов исправляются СТРОГО ПО КРУГУ ДО ВЕРДИКТА ACCEPT.**\n\n1. Никакой сдачи по самоотчёту кодера. `NEEDS WORK` → Coder исправляет, но «код написан,\n   тесты зелёные» **НЕ ЯВЛЯЕТСЯ ПРИЁМКОЙ**. Только повторный Совет вправе признать\n   замечания закрытыми.\n2. После любых исправлений Coder оркестратор **ОБЯЗАН** повторно отправить реальный\n   `git diff` на Совет Тимлидов (universal-panel, `mode=code`).\n3. Цикл: Совет (NEEDS WORK) → Coder → ПОВТОРНЫЙ Совет → … → ACCEPT.\n   Потолок — 5 тимлид-циклов. Сброс в `REJECT` на 2-м цикле запрещён.\n4. MR на remote **ДО** вердикта `ACCEPT` **КАТЕГОРИЧЕСКИ ЗАПРЕЩЁН**.\n   Coder работает только в локальной ветке. MR открывает оркестратор строго ПОСЛЕ ACCEPT.\n5. Фальш-старт MR (создан до ACCEPT) надзор не останавливает, задача не решена —\n   цикл Совета доводится до официального `ACCEPT`.\n6. Завершить ход/отчитаться после правок Coder без повторного Совета и `ACCEPT` — срыв регламента.\n\n## ⭐ ИНВАРИАНТ: ВСЕ ЗАМЕЧАНИЯ БАТЧЕМ И СОГЛАСОВАННОЕ РЕШЕНИЕ СОВЕТА\n\nКаждый судья за один проход выдаёт ВСЕ замечания сразу (поштучная выдача и обрыв на первой ошибке — malformed, council §1, §3). После независимого R1 судьи спорят по каждой находке (D-раунды ≤3, `fast` ≤2; позиции с evidence); несогласные дают CONSENT/OBJECT (с file:line), спор без согласия — владельцу; итог — согласованное решение по каждой F-NNN и вердикт из согласованного леджера (`references/council-consensus.md`); оркестратор только копирует дословно и считает статусы. Summarizer — один бриф на ВЕСЬ леджер, без «топ-N»; `late_miss`, `r2_late` — council §3 (council-gates § «Инвариант»).\n\n## Какой пакет включать\n\nДо Шага 0 выбрать сетап из фразы (default; «… техлид фаст» → `fast`; «… техлид квалити» → `quality`; таблица фраза → сетап → судьи — `references/routing-gates.md`), записать `setup` в `route-manifest.json`.\n\nРезолв моделей, приоритет модели/транспорта владельца, `direct_invocation`, блокирующий гейт маршрутизации — дословно `references/routing-gates.md` (читать до Шага 0). Нерушимое: вызов вне белого списка сетапа → `INVALID_MODEL`; пул исчерпан → `QUORUM_UNAVAILABLE`, подстановка запрещена; не спрашивать «кто кодер», панель на `acp-agents` не подменять; **panel-rework-summarizer при `NEEDS WORK`/`RED FLAG` — ВСЕГДА** (изолированно, слот из `role-setups.md`), координатору переводить замечания ЗАПРЕЩЕНО, без валидного выхода возврат Coder запрещён.\n\nСкилл-обёртка, ничего не дублирует:\n1. **Dev-цикл** — `orchestrate-coder-reviewer-summarizer` целиком (пакет по фразе).\n2. **Совет** — `universal-panel`, `mode=code`, слоты по `model-invocation.md`\n   § «Хост оркестратора». Агент пул не выбирает.\n\n## MUST: бриф Coder (невалидный — не запускать)\n\nОркестратор сам классифицирует тип и кладёт в бриф **ровно один** путь:\n`~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/<тип>.md`\n(`feature` | `bugfix` | `refactoring` | `hotfix` | `rework`; Architect — `architecture.md`;\nReviewer/MR — `code-review.md` / `mr.md`). Без этой строки бриф **невалиден**.\n**Переключение на Rework (Cycle ≥ 2):** при возврате с `NEEDS WORK` оркестратор **ОБЯЗАН** сменить тип задачи Coder на `rework` (`rework.md`, фолбэк — `bugfix.md`); хирургический фикс (Anti-ballooning, 1–15 строк на замечание), regression-тест на каждое замечание, запрет попутного рефакторинга, сверка с baseline тестов — `references/coder-brief.md` §6.\nПлюс 5–10 строк: задача, критерий, scope, тяжёлый путь. Обязательные блоки\n(форматы — `references/coder-brief.md`): **AC-оракулы** — триада current/expected/unchanged + узкая команда с эталоном (L2/L3 — не AC); **self-check** с СЫРЫМ выводом (линтеры, L1-тесты с явным списком путей и причин выбора — `references/verification-integrity.md` §8, scope `git diff --name-only` ⊆ разрешённых путей, end-to-end ручка) — заявление кодера, не доказательство (доказательство — clean-room Шага 2); **анти-примеры** 0–3 (bugfix/hotfix/rework — ≥1); **резюме** для ревьюера 3–5 строк; **валидатор полей** без LLM — нет обязательного поля, не запускать.\n\n## Пайплайн\n\n```text\ntask envelope (direct_invocation: true|false)\n  → VERIFICATION SURFACE (oracle + baseline до Coder)\n  → DEV-ЦИКЛ (Coder → CODE_GATE → Verifier; Reviewer пропущен: downstream_panel) → READY_FOR_PR\n  → CLEAN-ROOM EXECUTION-GATE (точный diff + 100% матрицы + sensitivity proof)\n  → TRACEABILITY И ОПЕЧАТКА EVIDENCE\n  → ПАКЕТ ПРИЁМКИ → СОВЕТ ТИМЛИДОВ (universal-panel, mode=code: R1 → дебаты D1..Dk → согласованный леджер)\n        ├─ PASS        → ACCEPT → L3 → [direct ? Summarizer : координатор/one-shot] → MR человеку\n        ├─ NEEDS WORK  → panel-rework-summarizer → brief.json → НОВЫЙ dev-цикл (тип: rework)\n        └─ RED FLAG    → тот же круг (не стоп), кроме требования сменить ТЗ/архитектуру\n```\n\nЛимит: **до ACCEPT, потолок 5 тимлид-циклов**; повтор по тем же пунктам в REJECT не сбрасывает.\n\n## Шаг 0. Verification surface до Coder\n\nВыполнить раздел 1 живого references/verification-integrity.md (файл читать ОДИН раз целиком здесь: Шаг 0 исполняет раздел 1, Шаг 2 — разделы 2–8 по уже прочитанному тексту, без второго чтения).\nДо Coder создать `verification-surface.json` (хеши oracle, CI/config/lock, baseline,\njobs). Oracle меняет только read-only QA/verifier, не Coder. Нет слепка — `BLOCKED`.\n\n## Шаг 1. Dev-цикл\n\nВыполнить `orchestrate-coder-reviewer-summarizer` до `READY_FOR_PR`: Reviewer пропущен (orchestrate, правило 12); максимум 2 итерации Coder↔CODE_GATE внутри цикла (бюджет автомата ≤5 отдельно); preflight с AGENTS.md.\nМодели Coordinator/Coder/Architect/Reviewer/Explorer — из `role-setups.md` выбранного сетапа, не из frontier-sdlc. Summarizer dev-пула внутри цикла не вызывать.\nВ envelope: `downstream_panel=true`, `parent_skill=teamlead-gate` (вызывающий orchestrate; во вложенной цепочке тоже он, внешних\nродителей не подставлять; `init --parent-skill`), `critical=false` / `final_gate_council=false` (второй совет не нужен).\nRisk-уровень Шагов 0/2: S0–S1 = low, S2 = medium, S3 = high.\nTask envelope: тесты CODE_GATE и surface Verifier = L1; FINAL_GATE — зелёность L1 после последней правки Coder; L2 только в Шаге 2 (`references/verification-integrity.md` §8).\nНе дошёл до `READY_FOR_PR` — совет НЕ запускать, эскалация человеку.\n\nПока идут Architect/Coder, оркестратор панели заранее готовит независимые от diff входы — `references/prepare-in-parallel.md` (перечень — `references/acceptance-package.md` § «Подготовка входов»).\n\nПараллельные кодеры (`references/parallel-coders.md`): зона = Coder = worktree/клон, merge-арбитраж по `git diff --name-only`, locks, квота ≤3/≤6, best-of-N только S2–S3, страгглер — решение владельца.\n\n## Шаг 2. Независимый clean-room прогон (гейт)\n\nВыполнить разделы 2–8 живого `verification-integrity.md`. Логи Coder/Reviewer/CI —\nзаявления, не доказательство. Evidence — только реальный запуск точного candidate\nв свежем temp-worktree/контейнере координатором или tool-enabled executor.\n\nНерушимое (детали — живой reference):\n- матрица 100% (правила репо + CI + полный сьют компонента (L2) + regression + runtime/integration/contract/UI; строки L3 до ACCEPT — `DEFERRED_L3`, не `NOT_RUN`);\n  сужать после fail нельзя; `environment-manifest.json` на точный candidate;\n- кэш отключён либо ключ содержит fingerprint; `verification-traceability.md`\n  (каждый AC → positive/negative/boundary + наблюдение; внешняя граница → end-to-end);\n- L2 (быстрый полный сьют) — один раз на SHA + environment fingerprint, раньше Шага 2 его нет; пере-проверки того же candidate берут evidence по fingerprint; любая правка → новый SHA → L2 заново (STALE);\n- рассуждение/`echo`/dry-run/collect-only/старый лог/targeted-subset вместо L2/мок вместо границы — не выполнение;\n  bugfix/новое поведение: red без fix → green на candidate; high-risk: mutation/revert smoke;\n- разделить `harness_status` и `verification_status`; опечатать всё в `evidence-manifest.sha256`;\n  medium/high-risk: blind reverse-spec свежим read-only verifier. Пробел = пакет совета BLOCKED.\n\n## Шаг 3. Пакет приёмки\n\n`.ai-team/runs/<run-id>/teamlead/package.md` — только первичные артефакты, без пересказа: task envelope, candidate manifest + полный diff с SHA256, `coder.json`, `execution-evidence.md` (сырой лог L2 обязателен) + сырые логи, surface/environment/traceability/manifest; `PR_DESCRIPTION.md` — НЕ класть. Сравнение «совет vs Reviewer» (при `downstream_panel=true` совет — единственный рубеж ревью), составы судей, полный состав, передача CLI-судьям (`judge-prompt.md`, «Не вложено»; тихая обрезка = `BLOCKED_BRIEF`), блок «ПРАВИЛА ПАРАЛЛЕЛИЗМА» — `references/acceptance-package.md` (читать при сборке пакета).\n\n## Шаг 4. Совет тимлидов → `references/council.md`\n\nГейты invocации дословно — `references/council-gates.md` § «Шаг 4» (читать перед запуском; механика — council §1). Нерушимое:\n- `mode.txt` = `code`; 3 судьи пакета рандомно из пула (без якоря; consensus §1), majority 2/3 разных семейств; раунда из 2 судей и ACCEPT на двоих нет; <3 судей — `QUORUM_UNAVAILABLE`, раунд не стартует;\n- Backend gate: 4-й судья/процесс/голос или «опрос всех доступных» (судей ровно 3) / суд в родительской сессии (немедленный стоп и FAIL раунда с откатом, не пометка; артефакты аннулируются) / подмена судьи нативным сабагентом / `acp-agents` / незаписанный fallback → FAIL; при нехватке судей фиксируется `QUORUM_UNAVAILABLE`, откат на subagent запрещён; brief-review обязателен на каждое место каждого раунда, включая D-раунды (fail-closed; `BLOCKED_BRIEF`), гейт `shasum == approved.sha256`;\n- внутренний ШАГ 6 universal-panel НЕ крутить; ШАГ 2 (один R2) и «R3 не предусмотрен» заменены совещанием (`references/council-consensus.md`): R1 → D1..Dk → согласованный леджер → вердикт по леджеру → Шаг 5.\n\n## Гейт PANEL-PROOF (Proof-of-Launch v1)\n\nКаждый судья Совета запускается СТРОГО через `launch_seat.py`. Самооценка оркестратора и субагенты текущей сессии как судьи запрещены.\nПеред переходом к `ACCEPT` и открытием `MR` обязательна валидация раунда скриптом:\n`python3 ~/Мой диск/skils/ai-sdlc/universal/teamlead-gate/scripts/verify_panel_proof.py --round-dir <RUN>/panel/council/r<R> --artifact-sha256 <sha256 пакета>`\nПри успехе (exit 0) создаётся `panel-proof.json` (`pol-receipt/1`). Без `panel-proof.json PASS` переход к ACCEPT и MR заблокирован (`BLOCKED: PANEL_PROOF_MISSING`).\nВ финальный статус/отчёт обязательна строка: `PANEL PROOF: <путь panel-proof.json> sha256=<hex> verify_panel_proof exit=0`. Подробно — `references/panel-proof-gate.md`.\n\n## Шаг 5. Разбор вердикта → `references/council.md`\n\n- **PASS → ACCEPT:** только при наличии валидного `panel-proof.json` PASS (`verify_panel_proof.py` exit 0, `references/panel-proof-gate.md`). В чат/отчёт обязательна строка `PANEL PROOF: <путь panel-proof.json> sha256=<hex> verify_panel_proof exit=0`. Без receipt переход к ACCEPT и MR категорически запрещён. `true` — отдельный Summarizer (не DeepSeek) пишет `PR_DESCRIPTION.md` + отчёт;\n  `false` — кратко координатор/one-shot. PASS не перекрывает красный execution-gate.\n  После ACCEPT — MR по `~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/mr.md` (merge — человек, «Границы»).\n  До MR — L3 (`references/verification-integrity.md` §8): FAIL → Coder (тип `rework`) → L1 → L2 → повторная панель diff-scope. MR-гейт L3: PASS | PASS_WITH_PREEXISTING | N/A.\n- **NEEDS WORK → panel-rework-summarizer → Coder:** слот из models.md (не DeepSeek); вход — согласованный леджер, все F-NNN со статусами (покрытие 100%; в instructions только согласованные blocking — `council-consensus.md` §10); до Coder — PASS проверки контракта brief; повторный совет — diff-scope (council §3). Дословно — council-gates § «Шаг 5».\n- **RED FLAG → тот же круг** (исключения — «Пайплайн», «Стоп-условия»).\n\n## Стоп-условия (поверх стопов обоих скиллов)\n\n- 5 тимлид-циклов без ACCEPT → честный отчёт с остатком замечаний; продолжение — только по явному решению владельца. Раньше потолка стоп — только неустранимый внешний блокер (смена бизнес-ТЗ, отказ смежных систем), пауза владельца/`INCOMPLETE`/бюджет (consensus §6–8); повтор NEEDS WORK/RED FLAG по тем же пунктам ≠ REJECT.\n- Нет валидного `panel-proof.json` со статусом PASS от `verify_panel_proof.py` схемы `pol-receipt/1` для текущего раунда и артефакта → `BLOCKED`, ACCEPT и MR категорически запрещены (`references/panel-proof-gate.md`).\n- Кворум и замена судей — `references/council-gates.md` § «Шаг 4». Automatic ACCEPT только при реальной majority 2/3 разных семейств; ≥2 слота одной модели без изоляции, 4-й судья, суд в родительской сессии — FAIL.\n- Нет read-back `processes.tsv` либо cleanup через `pkill`/`killall`/name-wide kill → `BLOCKED`, ACCEPT запрещён (`references/council-gates.md` § «Стоп: PID-safe lifecycle»).\n- Diff меняет согласованный внешний контракт без указания в envelope или несёт чужие Jira-KEY/скоуп → `REJECT`/не ACCEPT («совместимое поле» не смягчает).\n- Обязательный `FAIL`/`NOT_RUN`/`STALE`, пропуск строки матрицы, неподтверждённый лог → `BLOCKED`,\n  даже при PASS совета. Исключение: L3 до ACCEPT = `DEFERRED_L3` — не `NOT_RUN`, не блокер ACCEPT; MR-гейт L3: PASS | PASS_WITH_PREEXISTING | N/A (`verification-integrity.md` §8).\n- Surface изменён без QA/verifier verdict, нет clean-room/sensitivity/traceability → `BLOCKED`. Совет требует изменить ТЗ/архитектуру → решение человека.\n- Reverse-spec (medium/high-risk) расходится с envelope → NEEDS WORK или REJECT.\n\n## Корп-VPN упал — не стоп, поднять\n\nУпавший корп-VPN, `git.sberdevices.ru` не резолвится, timeout до корп-хоста — **не стоп и не `BLOCKED`**: поднять и повторить, `NOT_RUN` без попытки — нарушение; процедура — `references/report-vpn-formats.md` § 2.\n\n## Границы\n\n- Совет оценивает код и пригодность к merge. Продукт глазами пользователя — `acceptance-gate`\n  ПОСЛЕ ACCEPT: полный конвейер = `teamlead-gate` → `acceptance-gate` FULL.\n- В цикле Coder/Reviewer не пушат; в `main`/`dev` не коммитить; merge — человек.\n  Исключение — «кати» в промпте (= явная команда заранее): только по цепочке\n  PASS → ACCEPT → MR → CI 100% → merge на remote с read-back; «продолжай»/\n  молчание — не «кати»; при NEEDS WORK/RED FLAG/BLOCKED/красном гейте merge за человеком.\n- Run tracing: каждый spawn — `trace/rounds/<round-id>/<role>__<model-slug>.trace.json` + `trace/index.json` (`run-tracing.md`, `$TRACE` — `workspace-paths`); в отчёте длительности по session/round/model. Отчёт и дельту сессии — в KB по `session-guard`/`knowledge-persistence`.\n\n## Отчёт заказчику (формат)\n\nШаблон ACCEPT/не-ACCEPT — `references/report-vpn-formats.md` § 3; блок «Как совет договорился» — `references/council-consensus.md` § 11.\n\n## Связанные скиллы\n\n- `orchestrate-coder-reviewer-summarizer` — dev-цикл; `universal-panel` — механика совета; `acceptance-gate` — следующий слой; `heal-corp-vpn-network` — GIGA/EYE. Судьи/слоты, реворк-контракт, `run-tracing.md`, `workspace-paths` — дословно `references/routing-gates.md` § «Связанные скиллы».\n\n## Remote-first контракт репозитория\n\nМеняешь Git-репозиторий — перед сдачей прочитать и выполнить живого\n`references/remote-mr-workflow.md`. Локальный merge не влитие:\nсначала merge MR на remote, затем fast-forward локальной target-ветки.\ncat: /Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/review.md: No such file or directory\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,175p' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/arch-spec.md'; rg -n '\"'^diff|''^@@'\"' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/code-diff.patch'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,175p' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/arch-spec.md'; rg -n '\"'^diff|''^@@'\"' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/code-diff.patch'\"","aggregated_output":"# Архитектурная спецификация (R2): Muse Wonder в чужих и длинных сессиях DSH\n\nРаунд R2. Заменяет R1. Вход: `analysis/muse-wonder-foreign-session/handoff-architect.md`,\n`evidence-ledger.md` ([F-01]..[F-08]), вердикты судей R1 (Визионер, Скептик: оба NEEDS_WORK).\nПакет: `architecture-packet.json` (та же папка). Нумерация решений: ADR-001.N ≡ AD-00N в пакете.\n\n## 0. Что изменилось относительно R1\n\n| Замечание R1 | Где закрыто |\n|---|---|\n| Три независимые константы лимита (Визионер) | ADR-001.1, §2.1 |\n| Нет гистерезиса, дребезг, кэш префикса (Визионер) | ADR-001.2, §2.3, RISK-002 |\n| Сохранялись только ведущие system/developer; последний user не обязателен (Скептик) | ADR-001.2, §2.2 |\n| Атомарность `tool_calls`/`tool` не определена (оба) | ADR-001.2, §2.4 |\n| Оценка «4 символа на токен» занижает кириллицу и код (оба) | ADR-001.2, §2.5 |\n| Поведение при превышении обязательного набора (оба) | ADR-001.2/001.3, §2.6, §3.3 |\n| Жизненный цикл retry, SSE, счётчики, очистка, дедлайн (оба) | ADR-001.3, §3 |\n| Подстрока ошибки хрупка; маркер в обычном ответе модели (оба) | ADR-001.3, §3.1 |\n| `self._wlock`, чистота функции прунинга (Визионер) | ADR-001.4, §4.1 |\n| Лог события, запрет логировать тела, редакция обеих попыток (оба) | ADR-001.4, §4.2-4.3 |\n| План тестов, red→green, канон проверок (оба) | §6 |\n| Порядок выката зеркала и профилей, откат, живая проверка (оба) | §7 |\n\n## 1. Контекст и проблема\n\n- **REQ-01.** Переключение на `muse-wonder-1.0` / `muse-wonder-full-1.0` в активной сессии DSH с контекстом\n  больше жёсткого лимита Meta не должно давать `terminal_failed`.\n- **Факт [F-01].** `~/.dsh/bridges/muse-bridge/logs/bridge.log:1207` (также `:1203`), 2026-10-14 17:08:24 MSK:\n  `via=serve rc=1 state=terminal_failed err='modelError: context compaction replacement still exceeds the hard threshold (639915 >= 460800 tokens) retryable=True stream=True`.\n  Ссылка в ledger на строку 1222 устарела: в файле 1207 строк.\n- **Факт [F-02/F-03].** `ALLOWED_MODELS` (`bridges/muse-bridge/server.py:77-78`) и профили DSH объявляют окно 1048576.\n  Клиент DSH не компактирует историю до порога Meta. `_messages_to_prompt` (`server.py:454`, вызов `:1767`) склеивает\n  историю без бюджета.\n- **Факт [F-04].** Мост завершает ход 502 сразу, повтора нет (`server.py:1743-1960`, ветка `out[\"state\"] != \"ok\"`).\n- **Граница достижимости.** Если системные инструкции, первый или последний `user` сами не помещаются в бюджет,\n  «безотказная работа» невозможна. В этом случае требуется детерминированный отказ (§2.6), а не молчаливая потеря.\n- **Не цель.** Модели `muse-spark-*` (тоже 1048576 в профилях) не меняются в этом MR (Q-002).\n\n## 2. ADR-001.1 и ADR-001.2\n\n### 2.1 ADR-001.1: единый источник лимита\n\n- **Решение.** Окно модели хранится в одном месте: запись `ALLOWED_MODELS[model]`. Для двух wonder-моделей значение\n  равно `400000`. Все остальные величины выводятся из него:\n  - порог срабатывания `limit = window`;\n  - целевой размер `target = limit * 4 // 5` (для 400000 это ровно 320000);\n  - аварийный размер `retry_target = limit // 2` (200000).\n- **Расхождение с брифом, фиксируется явно.** В коде ключ записи называется `context_length`, а не `contextWindow`\n  (`server.py:73-78`, `:1710`); `contextWindow` существует только в YAML профилей DSH. Поэтому формула из брифа\n  реализуется как `ALLOWED_MODELS.get(model, {}).get(\"context_length\", 400_000)`, оформленная одним помощником\n  `_context_limit(model)`. Второй ключ `contextWindow` в `ALLOWED_MODELS` не вводится: он создал бы второй источник\n  истины. Значение по умолчанию `400_000` задаётся одной константой модуля.\n- **Точки применения (4 значения, не больше).**\n  1. `bridges/muse-bridge/server.py`: `muse-wonder-1.0`, `muse-wonder-full-1.0` -> `context_length: 400000`.\n  2. `~/.dsh/bridges/muse-bridge/server.py`: зеркало. На 2026-10-14 побайтно совпадает с рабочим деревом репозитория\n     (`diff -q` без вывода), включая незакоммиченные правки.\n  3. `~/.dsh/profiles/desktop/cordis.patch.yml`: `contextWindow: 400000` у `id: muse-wonder-1.0` (строка 355) и\n     `id: muse-wonder-full-1.0` (строка 369).\n  4. `~/.dsh/profiles/web/cordis.patch.yml`: то же, строки 453 и 459.\n- **Не трогать.** Записи `muse-spark-*` и все прочие провайдеры (десятки строк `contextWindow: 1048576`). Каталоги\n  `~/.dsh/profiles/web.bak-*` (архивы). Профиль `headless`: `muse-bridge` в нём отсутствует (0 вхождений), проверить повторно\n  перед выкатом.\n- **Тест-регрессия.** `AllowedModelsSyncTest` (`tests/test_muse_bridge_killpg.py:1307`) сейчас жёстко проверяет\n  `1048576`; обновляется первым (red), см. §6.\n\n### 2.2 ADR-001.2: обязательный набор\n\nОпределения опираются на то, как `_messages_to_prompt` уже трактует роли: `system`/`developer` уходят в системный блок,\n`assistant` и `tool` рендерятся как есть, любая прочая роль (включая отсутствующую) считается `user`.\nСообщение с пустым отрендеренным текстом (`_render_turn` вернул пусто) и не-словарь в расчёт не входят.\n\nОбязательный набор M (в порядке неубывания приоритета отказа):\n1. **Все** `system`/`developer` сообщения истории, в том числе поздние вставки.\n2. Первый `user` (исходная постановка).\n3. Последний `user` (текущий запрос). Если он совпадает с первым, сообщение учитывается один раз.\n4. **Незавершённая единица ответа:** если последняя атомарная единица (см. §2.4) стоит позже последнего `user`\n   (типичный цикл агента: `assistant(tool_calls)` + `tool`-результаты), она тоже обязательна. Без неё модель отвечает на\n   вопрос, не видя результата, на который должна ответить. Это уточнение к брифу; оно вытекает из формата DSH и\n   проверяется тестом T-13.\n\nПорядок вывода сохраняет хронологию исходной истории. Системные сообщения по-прежнему выносятся в системный блок\nсуществующей логикой `_messages_to_prompt`.\n\n### 2.3 Пороги и гистерезис\n\n- `est_total` > `limit` (400000) -> прунинг до `target` (320000). `est_total` ≤ `limit` -> запрос проходит без изменений,\n  без маркера и без копирования (QS-02). Граница включительная: ровно `limit` не прунится.\n- Запас до порога клиента 80000, до жёсткого лимита Meta (460800) 140800 токенов оценки.\n- **Честное ограничение.** Мост без состояния. Если клиент не компактирует сам, история на каждом ходу растёт на\n  новый ход, и начало хвоста сдвигается на этот же объём. Гистерезис гарантирует: (а) нет дребезга «пруним / не пруним»\n  вокруг 400k; (б) неизменный префикс (системный блок, секция инструментов, первый `user`, маркер) побайтно стабилен и\n  кэшируется; (в) после компакции на клиенте (он стартует около 400k) префикс хвоста снова стабилен. Стабильность\n  префикса **хвоста** без компакции клиента не гарантируется. Квантование границы среза и серверное состояние сознательно\n  отложены (deferred). См. RISK-002.\n\n### 2.4 Инвариант атомарности инструментов\n\n- **Атомарная единица.** `assistant`-сообщение с непустым `tool_calls` + все `role: \"tool\"` сообщения, чей\n  `tool_call_id` совпадает с `id` любого из этих вызовов. Многовызовный ход (несколько `tool_calls` в одном\n  сообщении) целиком одна единица. Каждое прочее сообщение является отдельной единицей.\n- **Инвариант I-1.** В выходе прунинга нет `role: \"tool\"` без породившего `assistant` с таким же `tool_call_id` в\n  том же выходе, и нет `assistant` с `tool_calls`, у которых часть ответов отброшена, а часть оставлена.\n- **Осиротевшие `tool` во входе** (клиентская ошибка): при прунинге не попадают в выход; при проходе без прунинга\n  остаются как есть (QS-02 требует дословности).\n- Выбор хвоста идёт единицами от новейшей к старейшей, хвост непрерывный: остановка на первой единице, которая не\n  помещается (без перескоков на более мелкие старые единицы).\n\n### 2.5 Оценка токенов\n\n- `est(text) = max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)`. Так как байтов не меньше символов, второй член\n  всегда доминирует; формула записана в брифовой форме, реализация вправе считать только байты.\n- В бюджет входят: системный блок вместе с обёрткой `[system]`, секция `_tools_section(tools, tool_choice)` целиком\n  (`server.py:397`, JSON с `ensure_ascii=False`), разметка ролей (`User: `, `Assistant: `, `[tool result id] (name)`),\n  разделители `\\n\\n`, маркер. Если инструменты не эмулируются, а `raw_tools` есть без system, учитывается\n  `DEFAULT_SYSTEM_HINT`.\n- Округление: к оценке каждой части прибавляется 1 токен, а итог всегда перепроверяется по **собранному** промпту:\n  если `est(промпт) > target` (или `> limit` для жёсткой границы), хвост сокращается ещё на единицу. Тесты проверяют\n  собранный промпт, а не промежуточную сумму.\n- Консервативность имеет цену: для плотной кириллицы (2 байта на символ) оценка выше реальной токенизации, поэтому\n  мост может прунить раньше, чем клиент считает окно исчерпанным. Принято осознанно (F-05); масштаб проверяется на\n  живом ходе (ASM-004).\n\n### 2.6 Отказ при превышении обязательного набора\n\nПусть `base = est(фиксированная часть) + est(M) + est(маркер)`, `cap` = `limit` для проактивного прунинга и\n`retry_target` для retry.\n- `base > cap` -> прунинг не может помочь. Мост **не запускает модель** и отвечает терминально (см. §3.3 и §4.3).\n- Единица из п. 2.2/4 принимается, если `base + cost ≤ cap` (жёсткая граница, `target` здесь мягкая цель); иначе отказ.\n- Остальной хвост добирается до `target` (проактивно) или `retry_target` (retry).\n- Проактивный отказ происходит до `_sse_begin`, поэтому это обычный HTTP 502 JSON. Тело ответа: счётчики оценки и\n  лимит; текст сообщений не включается.\n\n### 2.7 Маркер и чистота функции\n\n- Текст маркера: `[... earlier conversation turns compacted to stay within Muse context limit ...]`. Цифр лимита в\n  тексте нет (единый источник).\n- Маркер вставляется в каждый разрыв между соседними сохранёнными репликами, где отброшены единицы (разрывов не\n  более двух: после первого `user` и перед хвостом, если последний `user` лежит раньше начала хвоста). Если отбрасывать\n  нечего, маркера нет. Рендерится как нейтральная строка без префикса `User:`/`Assistant:` (внутренняя роль\n  сообщения-заметки, обрабатываемая в `_messages_to_prompt`).\n- Прунинг: чистая функция `(messages, limit, target, fixed_overhead_tokens) -> PruneResult`. Исходный список и словари\n  не мутируются, результат собирается из ссылок на неизменённые сообщения. Детерминирован и идемпотентен: повторный\n  прунинг своего выхода с теми же параметрами не меняет его.\n\n## 3. ADR-001.3: аварийный auto-retry\n\n### 3.1 Условие срабатывания (все пункты одновременно)\n\n1. Попытка завершилась неуспехом: `out[\"rc\"] != 0` и `out[\"state\"] == \"terminal_failed\"`.\n2. Подстрока `context compaction replacement still exceeds the hard threshold` найдена в **канале ошибки**\n   (`out[\"err\"]`, сырое значение до редакции), а не в `out[\"text\"]`/`chunks`. Совпадение в обычном ответе модели retry\n   не запускает.\n3. Подстрока хранится одной константой модуля; на неё есть тест (T-17).\n4. `context_retry_count == 0` (отдельный счётчик, не связанный с `NETWORK_RETRY_MARKER` и fallback `serve -> exec`).\n5. Клиент не отключён (`not self._client_gone`), и контентные кадры ещё не отправлялись (§3.2).\n6. Первая попытка очищена: `run.close()` выполнен, `run.dead_confirmed` истинно. Иначе retry не стартует, действует\n   существующий карантин слота.\n7. Прунинг для retry возможен: `base ≤ retry_target` (§2.6) и оценка нового промпта **строго меньше** оценки\n   предыдущей попытки (иначе повтор бессмыслен: тот же промпт).\n8. Не исчерпан суммарный дедлайн хода: `time.monotonic() - t_first_attempt < TIMEOUT_S`. Retry получает остаток, если\n   сигнатура `execute()` позволяет; если нет, Coder фиксирует это в отчёте (принятый верхний предел 2×`TIMEOUT_S`).\n\nПодделка: пользователь может подсунуть текст маркера так, что он отразится в `err`. Последствие ограничено одним повтором\n(пункт 4), прочих побочных эффектов нет.\n\n### 3.2 Граница «до первого контентного чанка»\n\n- В текущем коде SSE открывается заранее (`_sse_begin`: заголовки, role-кадр, keepalive-комментарии), а все\n  reasoning/tool_calls/content-кадры пишет `_send_sse` **после** завершения всех запусков (`server.py:1614`).\n  Поэтому цикл retry целиком лежит до первого контентного кадра и между попытками клиенту уходят только keepalive.\n- Защита на будущее: флаг `self._content_started` (выставляется под `_wlock` перед первой записью reasoning/tool/content\n  кадра). Условие 5 §3.1 проверяет его. Если когда-нибудь появится реальный потоковый вывод, retry после первой дельты\n  запрещён автоматически (повторять нельзя: нарушена идемпотентность потока).\n- Между попытками нет ни `error`-кадра, ни `[DONE]`. Итог ровно один: успех либо терминальная ошибка.\n\n1:diff --git a/bridges/muse-bridge/server.py b/bridges/muse-bridge/server.py\n5:@@ -14,7 +14,8 @@ Stdout CLI — JSONL-конверты (schema_version=1). Текст ответ\n15:@@ -23,10 +24,9 @@ summaries как `delta.reasoning_content`, tool_calls, content-чанки (~300\n29:@@ -39,6 +39,7 @@ SDK отбрасывает их на уровне декодера и idle-watch\n37:@@ -53,7 +54,9 @@ import time\n48:@@ -74,8 +77,20 @@ ALLOWED_MODELS: dict[str, dict[str, Any]] = {\n70:@@ -154,7 +169,8 @@ _LOG_LOCK = threading.Lock()\n80:@@ -172,6 +188,140 @@ def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n221:@@ -329,13 +479,38 @@ def _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n261:@@ -503,13 +678,353 @@ def _map_effort(req: dict[str, Any]) -> str:\n619:@@ -729,6 +1244,10 @@ class Run:\n630:@@ -986,6 +1505,8 @@ class ServeRun:\n639:@@ -1008,6 +1529,8 @@ class ServeRun:\n648:@@ -1193,6 +1716,8 @@ class ServeRun:\n657:@@ -1216,7 +1741,19 @@ class ServeRun:\n678:@@ -1250,7 +1787,8 @@ class ServeRun:\n688:@@ -1269,11 +1807,13 @@ class Handler(BaseHTTPRequestHandler):\n703:@@ -1281,21 +1821,38 @@ class Handler(BaseHTTPRequestHandler):\n746:@@ -1313,14 +1870,18 @@ class Handler(BaseHTTPRequestHandler):\n767:@@ -1337,7 +1898,7 @@ class Handler(BaseHTTPRequestHandler):\n776:@@ -1345,17 +1906,22 @@ class Handler(BaseHTTPRequestHandler):\n804:@@ -1446,6 +2012,8 @@ class Handler(BaseHTTPRequestHandler):\n813:@@ -1579,8 +2147,9 @@ class Handler(BaseHTTPRequestHandler):\n825:@@ -1591,15 +2160,56 @@ class Handler(BaseHTTPRequestHandler):\n891:@@ -1628,46 +2238,139 @@ class Handler(BaseHTTPRequestHandler):\n1047:@@ -1687,12 +2390,40 @@ class Handler(BaseHTTPRequestHandler):\n1089:@@ -1703,12 +2434,19 @@ class Handler(BaseHTTPRequestHandler):\n1111:@@ -1721,12 +2459,24 @@ class Handler(BaseHTTPRequestHandler):\n1138:diff --git a/tests/test_muse_bridge_killpg.py b/tests/test_muse_bridge_killpg.py\n1142:@@ -13,9 +13,12 @@ bridges/muse-bridge/server.py без живого muse-bin: вместо CLI —\n1155:@@ -30,9 +33,14 @@ from types import SimpleNamespace\n1171:@@ -637,5 +645,1722 @@ class WaitGroupExitTest(unittest.TestCase):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/code-review.md'; rg -n '\"'^(class |    def test_|def )'\"' tests/test_muse_bridge_killpg.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/code-review.md'; rg -n '\"'^(class |    def test_|def )'\"' tests/test_muse_bridge_killpg.py\"","aggregated_output":"# Skill: Code Review\n\n## Цель\n\nПроверить что код соответствует стандартам из `.agents/agents/python-standards.md`\nи архитектурным правилам из `.agents/agents/architecture.md`.\n\n***\n\n## Алгоритм\n\n### 1. Запустить автоматические проверки\n\n~~~bash\nuv run ruff check <файл_или_папка>\nuv run basedpyright <файл_или_папка>\n~~~\n\nВключить результаты в отчёт. Автоматические ошибки не пересказывать — только итог.\n\n### 2. Прочитать файлы под ревью полностью\n\n### 3. Проверить по чеклисту\n\n#### 🔴 Блокирующие (merge запрещён до исправления)\n\n- [ ] `from __future__ import annotations` — первая строка в файле\n- [ ] Все параметры функций аннотированы\n- [ ] Все функции имеют аннотацию возвращаемого типа (включая `-> None`)\n- [ ] Нет `Optional[X]`, `List[X]`, `Dict[K,V]` — только `X | None`, `list[X]`, `dict[K,V]`\n- [ ] Нет `-> dict` / `dict[str, Any]` как публичного контракта (HTTP schema **и** service-layer public methods) — только DTO/Value Object/Pydantic\n- [ ] **Boundary typing:** внешний API/connector — request/response через Pydantic `BaseModel` или `@dataclass`; запрещён пронос сырого `dict` / `dict[str, Any]` через service/handler boundary\n- [ ] **Domain literals:** currency, billing cycle, product_type (`USD`/`RUB`, `yearly`/`monthly`, `ppr`, …) — только `Enum` / `Final` / именованная константа; inline string в production-коде = блокер\n- [ ] **Один mapping provider→internal:** запрещены независимые копии одного и того же словаря/ветки match в разных модулях (дубль = блокер, не bikeshed)\n- [ ] **Nested `.get()` chains** на парсинге внешнего JSON / money path запрещены (silent `None`); нужен model_validate / явный доступ с проверкой\n<!-- BEGIN gitlab-review-hardening 2026-09-10-cel code-review promote -->\n<!-- END gitlab-review-hardening 2026-09-10-cel -->\n- [ ] Сервисный слой не импортирует `db/models.py` напрямую\n- [ ] Бизнес-логика не в route handlers\n- [ ] Нет `except Exception: pass`\n- [ ] Нет мутируемых значений по умолчанию (`= []`, `= {}`)\n- [ ] **Async-инварианты (§5):** проект полностью async — нет `from sqlalchemy.orm import Session` (только `AsyncSession`), все DB-методы `async def` + `await session.execute(...)`, сервис вызывает репозиторий через `await`, handler'ы `async def` + `await service.X(...)`. Sync-вызов в async-контексте блокирует event loop и валит производительность.\n- [ ] **Никаких `next(generator_func())` для async-генераторов** — это просто не работает (нужен `anext()` или `async for`). Признак copy-paste из старого sync-кода.\n- [ ] **Логирование (§13):** нет `print()`, нет f-строк в `logger.info(...)`, нет секретов / токенов / Authorization в kwargs.\n- [ ] **Безопасность (§14):** нет хардкода секретов, SQL параметризован, пароли через `bcrypt`/`argon2`, HTTP-клиенты с `timeout=` и `verify=True`, `subprocess` без `shell=True` с user input.\n- [ ] **Внешний контракт заморожен:** diff не меняет согласованный HTTP/event/data/CLI/SDK контракт с внешними исполнителями, если в текущей задаче нет явного указания это сделать. Добавление поля, смена default/типа, новый код ошибки на старом пути — тоже изменение. Канон: `.agents/agents/scope-and-contracts.md`.\n- [ ] **Только своя задача:** в diff и отчёте нет чужих Jira-KEY, чужого скоупа и «заодно» из соседних задач. Тот же канон.\n- [ ] **Сдача не минуя MR:** diff пришёл веткой / MR, не прямым коммитом или push в `main`/`master`/`dev`. Канон: `.agents/agents/mr.md`.\n\n#### 🟡 Некритичные (рекомендации, исправить в следующем PR)\n\n- [ ] Нет магических чисел — только именованные константы\n  **Исключение/эскалация:** литералы currency / billing cycle / product_type и числовые пороги биллинга/квот — это 🔴 (см. Domain literals), не 🟡.\n- [ ] Нет дублирования логики (DRY)\n- [ ] Функция делает одно дело (SRP), не длиннее 30-40 строк\n- [ ] Именование: `snake_case` / `PascalCase` / `UPPER_SNAKE_CASE`\n- [ ] Параллельные задачи через `asyncio.TaskGroup`, не `gather()` (когда не нужен `return_exceptions=True`) — §5\n- [ ] Современный синтаксис: `type UserId = int` (PEP 695), `Self`, `match/case`, `StrEnum` где уместно — §15\n- [ ] Coverage на новой логике не понижает общий процент ниже 80% (`--cov-fail-under=80`)\n\n***\n\n## Формат отчёта\n\n~~~text\n## Code Review: <файл или ветка>\n\n### Автоматические проверки\nruff: X ошибок | basedpyright: Y ошибок\n\n### Нарушения\n\n#### 🔴 Блокирующие\n\n| # | Файл | Строка | Нарушение | Стандарт |\n|---|------|--------|-----------|----------|\n| 1 | bad_link_service.py | 1 | Отсутствует `from __future__ import annotations` | python-standards §1 |\n\n#### 🟡 Некритичные\n\n| # | Файл | Строка | Нарушение | Стандарт |\n|---|------|--------|-----------|----------|\n| 1 | bad_link_service.py | 45 | Магическое число `75` | python-standards §8 |\n\n### Итог\n- Блокирующих: X\n- Рекомендаций: Y\n- Вердикт: ❌ Требует правок / ✅ Можно принимать\n~~~\n\n***\n\n## Пример промпта\n\n~~~text\nПрочитай файл .skills/code-review.md (он сам ссылается на .agents/agents/python-standards.md, .agents/agents/code.md и .agents/agents/architecture.md).\n\nПроведи code review файла app/services/bad_link_service.py.\n\nСначала запусти:\nuv run ruff check app/services/bad_link_service.py\nuv run basedpyright app/services/bad_link_service.py\n\nЗатем проведи ручную проверку по чеклисту из .skills/code-review.md.\nСформируй отчёт в формате из .skills/code-review.md.\n~~~\n\n## Remote-first контракт репозитория\n\nЕсли работа этой роли меняет Git-репозиторий, перед сдачей обязательно прочитать и\nвыполнить `~/Мой диск/skils/ai-sdlc/references/remote-mr-workflow.md`. Локальный\nmerge не считается влитием: сначала merge MR на remote, затем fast-forward\nлокальной target-ветки. Для read-only роли это требование к handoff, а не\nразрешение писать в product worktree, пушить или сливать MR.\n109:def load_bridge() -> Any:\n120:def group_alive(pgid: int) -> bool:\n131:def wait_until(predicate: Callable[[], bool], timeout: float) -> bool:\n142:class CloseKillsGroupTest(unittest.TestCase):\n176:    def test_r1_run_close_kills_group(self) -> None:\n181:    def test_r1_serve_run_close_kills_group(self) -> None:\n187:class _BridgeScenario(unittest.TestCase):\n288:class HealthQuarantinedTest(_BridgeScenario):\n291:    def test_health_reports_quarantined_slots(self) -> None:\n297:class DisconnectScenarioTest(_BridgeScenario):\n309:    def test_r2_disconnect_frees_slot_and_kills_group(self) -> None:\n336:    def test_r3_health_active_zero_after_disconnect(self) -> None:\n347:class ServeDisconnectScenarioTest(_BridgeScenario):\n360:    def test_r4_disconnect_during_serve_turn_kills_group_and_frees_slot(self) -> None:\n383:class SpyConn:\n406:class ClientGoneProbeTest(unittest.TestCase):\n420:    def test_probe_uses_msg_dontwait_without_mode_change(self) -> None:\n432:    def test_probe_no_data_is_not_disconnect(self) -> None:\n437:    def test_probe_leaves_pending_data_unread(self) -> None:\n443:    def test_probe_detects_fin_and_reset(self) -> None:\n448:    def test_probe_does_not_break_concurrent_write(self) -> None:\n479:class QuarantineSlotTest(unittest.TestCase):\n482:    def test_slot_stays_withdrawn_until_group_dies(self) -> None:\n526:    def test_no_signals_after_ceiling(self) -> None:\n554:    def test_reaped_leader_gets_no_signals(self) -> None:\n582:class ConcurrentCloseTest(unittest.TestCase):\n615:    def test_run_second_close_waits_for_cleanup(self) -> None:\n618:    def test_serve_run_second_close_waits_for_cleanup(self) -> None:\n622:class WaitGroupExitTest(unittest.TestCase):\n638:    def test_reaped_leader_gets_single_control_kill(self) -> None:\n643:    def test_live_leader_keeps_killing(self) -> None:\n648:def bridge_request(\n666:def turn_request(stream: bool = False) -> dict:\n675:class ErrorLoggingTest(_BridgeScenario):\n700:    def test_all_error_branches_log_once_and_success_stays_done(self) -> None:\n737:    def test_secret_canaries_masked_in_log_json_and_sse(self) -> None:\n778:    def test_none_diagnostic_is_empty(self) -> None:\n783:    def test_serve_json_returns_sanitized_detail_on_error(self) -> None:\n860:    def test_generic_diagnostic_not_duplicated_in_message(self) -> None:\n867:    def test_default_model_is_wonder_full(self) -> None:\n873:    def test_r2_escaped_quotes_mask_entire_secret_in_all_sinks(self) -> None:\n911:    def test_r2_long_reflected_message_redacted_before_clipping(self) -> None:\n921:    def test_r2_short_messages_preserve_error_words(self) -> None:\n930:    def test_quota_secrets_do_not_reach_any_error_sink(self) -> None:\n979:def install_protocol_wrapper(\n1035:class ServeTurnErrorExtractionTest(_BridgeScenario):\n1044:    def test_r2_prompt_parts_redacted_before_and_after_normalization(self) -> None:\n1059:    def test_typed_error_reason_and_stderr_priority(self) -> None:\n1082:    def test_reason_only_duplicate_and_malformed(self) -> None:\n1099:    def test_no_diagnostics_preserves_stderr_tail_and_success(self) -> None:\n1108:    def test_field_caps_budget_and_redaction_boundaries(self) -> None:\n1146:class SseDataKeepaliveTest(_BridgeScenario):\n1156:    def test_defaults_and_s3_seal_suppresses_late_tick_and_duplicate_done(self) -> None:\n1181:    def test_s1_data_ticks_before_done_preserve_content_and_tools(self) -> None:\n1205:    def test_s2_inflight_flush_precedes_finalization(self) -> None:\n1248:    def test_done_write_failure_closes_phase(self) -> None:\n1259:class CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n1262:    def test_serve_argv_disables_write_shell(self) -> None:\n1278:    def test_approval_falls_back_to_exec_without_decide(self) -> None:\n1308:class AllowedModelsSyncTest(_BridgeScenario):\n1311:    def test_t00_models_and_health_include_wonder_models_400k(self) -> None:\n1376:class ContextEstimateTest(unittest.TestCase):\n1379:    def test_t01_estimate_tokens_latin_cyrillic_code_json_empty(self) -> None:\n1394:    def test_t02_context_limit_and_derived_targets(self) -> None:\n1412:class ContextPruneTest(unittest.TestCase):\n1420:    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n1456:    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n1496:    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n1529:    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n1603:    def test_t07_orphan_tool_dropped_on_prune_kept_on_passthrough(self) -> None:\n1626:    def test_t08_cyrillic_triggers_prune_when_bytes_exceed_limit(self) -> None:\n1639:    def test_t09_multipart_none_empty_non_dict_unknown_role(self) -> None:\n1666:    def test_t10_marker_placement_chronology_determinism_and_idempotency(self) -> None:\n1733:    def test_t11_input_not_mutated_and_wlock_not_held_during_prune(self) -> None:\n1777:    def test_t13_trailing_incomplete_tool_unit_kept_or_refused_if_exceeds_cap(\n1814:    def test_t14_hysteresis_prefix_stability_and_399999_passthrough(self) -> None:\n1862:class ContextRetryTest(_BridgeScenario):\n1880:    def test_t12_mandatory_exceeds_limit_returns_502_before_run(self) -> None:\n1903:    def test_t15_hard_threshold_error_triggers_single_retry_and_succeeds(self) -> None:\n1959:    def test_t16_hard_threshold_error_twice_returns_terminal_502(self) -> None:\n2019:    def test_t17_other_error_or_marker_in_normal_text_does_not_retry(self) -> None:\n2068:    def test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget(\n2121:    def test_t19_client_disconnect_between_attempts_skips_second_run(self) -> None:\n2164:    def test_t20_mandatory_exceeds_200k_on_retry_skips_second_run(self) -> None:\n2197:    def test_t21_retry_cut_does_not_reduce_prompt_skips_second_run(self) -> None:\n2228:    def test_t22_unconfirmed_death_on_attempt_one_skips_retry_and_quarantines_slot(\n2277:class ContextObservabilityTest(_BridgeScenario):\n2280:    def test_t23_observability_log_fields_secret_redaction_and_no_retained_buffers(\n","exit_code":0,"status":"completed"}}
