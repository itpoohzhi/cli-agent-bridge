{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '619,890p' '.ai-team/runs/muse-wonder-foreign-session-20261014/code-diff.patch'; sed -n '1862,2120p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"@@ -729,6 +1244,10 @@ class Run:\n             str(self.workdir),\n             \"--json\",\n             \"--no-session-log\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--disable-web-tools\",\n+            \"--disable-reminders\",\n             \"--prompt-file\",\n             prompt_path,\n         ]\n@@ -986,6 +1505,8 @@ class ServeRun:\n             self.model_id,\n             \"--no-session-log\",\n             \"--trust-workspace\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n         ]\n         try:\n             self.proc = subprocess.Popen(\n@@ -1008,6 +1529,8 @@ class ServeRun:\n         os.set_blocking(self.proc.stdin.fileno(), False)\n \n         err_lines: list[str] = []\n+        turn_diag_lines: list[str] = []\n+        stderr_joined = False\n \n         def drain_stderr() -> None:\n             try:\n@@ -1193,6 +1716,8 @@ class ServeRun:\n                         _handle_event(msg, None)\n                         continue\n                     terminal = str(p.get(\"terminal\") or \"unknown\")\n+                    if terminal != \"completed\":\n+                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                     break\n                 if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                     continue  # чужой/дублированный ack — игнор, не разрываем ход\n@@ -1216,7 +1741,19 @@ class ServeRun:\n                 if part not in summaries:\n                     summaries.append(part)\n             text = final_text if final_text is not None else \"\".join(deltas)\n-            err = \"\\n\".join(err_lines[-6:])\n+            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n+            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n+            err_thread.join(timeout=5)\n+            stderr_joined = True\n+            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n+            if self.prompt:\n+                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n+            err = \"\\n\".join(turn_diag_lines)\n+            if err:\n+                if stderr_tail:\n+                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n+            else:\n+                err = stderr_tail\n             if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                 return {\n                     \"rc\": serve_rc,\n@@ -1250,7 +1787,8 @@ class ServeRun:\n                 \"via\": \"serve\",\n             }\n         finally:\n-            err_thread.join(timeout=5)\n+            if not stderr_joined:\n+                err_thread.join(timeout=5)\n             self.close()\n \n \n@@ -1269,11 +1807,13 @@ class Handler(BaseHTTPRequestHandler):\n     _current_run: Run | ServeRun | None = None\n     # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n     _sse_open: bool = False\n+    _content_started: bool = False\n     _sse_id: str = \"\"\n     _sse_created: int = 0\n     _sse_model: str = \"\"\n     _wlock: threading.Lock = threading.Lock()\n-    _ka_stop: threading.Event | None = None\n+    _sse_phase: str = \"OPEN\"\n+    _keepalive_stop: threading.Event | None = None\n     _ka_thread: threading.Thread | None = None\n \n     def setup(self) -> None:\n@@ -1281,21 +1821,38 @@ class Handler(BaseHTTPRequestHandler):\n         self._client_gone = False\n         self._current_run = None\n         self._sse_open = False\n+        self._content_started = False\n         self._sse_id = \"\"\n         self._sse_created = 0\n         self._sse_model = \"\"\n         self._wlock = threading.Lock()\n-        self._ka_stop: threading.Event | None = None\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n+        self._keepalive_stop: threading.Event | None = None\n         self._ka_thread: threading.Thread | None = None\n         super().setup()\n \n     # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n-    def _sse_write(self, text: str) -> bool:\n+    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n         \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n         try:\n             with self._wlock:\n-                self.wfile.write(text.encode(\"utf-8\"))\n-                self.wfile.flush()\n+                if self._sse_phase == \"CLOSED\" or self._client_gone:\n+                    return False\n+                if keepalive and (\n+                    self._sse_phase != \"OPEN\"\n+                    or (\n+                        self._keepalive_stop is not None\n+                        and self._keepalive_stop.is_set()\n+                    )\n+                ):\n+                    return False\n+                try:\n+                    self.wfile.write(text.encode(\"utf-8\"))\n+                    self.wfile.flush()\n+                finally:\n+                    if text == \"data: [DONE]\\n\\n\":\n+                        self._sse_phase = \"CLOSED\"\n             return True\n         except (BrokenPipeError, ConnectionResetError, OSError):\n             if not self._client_gone:\n@@ -1313,14 +1870,18 @@ class Handler(BaseHTTPRequestHandler):\n             \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n         }\n \n-    def _sse_emit(self, obj: dict) -> bool:\n-        return self._sse_write(\"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\")\n+    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n+        return self._sse_write(\n+            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n+        )\n \n     def _sse_begin(self, model: str) -> bool:\n         \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n         self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n         self._sse_created = int(time.time())\n         self._sse_model = model\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n         self.close_connection = True\n         try:\n             self.send_response(200)\n@@ -1337,7 +1898,7 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n             return False\n         stop = threading.Event()\n-        self._ka_stop = stop\n+        self._keepalive_stop = stop\n         self._ka_thread = threading.Thread(\n             target=self._keepalive_loop, args=(stop,), daemon=True\n         )\n@@ -1345,17 +1906,22 @@ class Handler(BaseHTTPRequestHandler):\n         return True\n \n     def _keepalive_loop(self, stop: threading.Event) -> None:\n-        \"\"\"Комментарии `: keepalive`: держат TCP, но не сбрасывают idle-watchdog SDK.\"\"\"\n+        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n         while not stop.wait(KEEPALIVE_S):\n-            if not self._sse_write(\": keepalive\\n\\n\"):\n+            if self._client_gone or stop.is_set():\n+                return\n+            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                 return\n \n     def _sse_stop_keepalive(self) -> None:\n-        if self._ka_stop is not None:\n-            self._ka_stop.set()\n+        if self._keepalive_stop is not None:\n+            self._keepalive_stop.set()\n+        with self._wlock:\n+            if self._sse_phase == \"OPEN\":\n+                self._sse_phase = \"FINALIZING\"\n         if self._ka_thread is not None:\n             self._ka_thread.join(timeout=2)\n-        self._ka_stop = None\n+        self._keepalive_stop = None\n         self._ka_thread = None\n \n     def _client_gone_probe(self) -> bool:\n@@ -1446,6 +2012,8 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_open and not self._sse_begin(model):\n             return\n         self._sse_stop_keepalive()\n+        with self._wlock:\n+            self._content_started = True\n         chunk = self._sse_chunk\n         reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n         if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n@@ -1579,8 +2147,9 @@ class Handler(BaseHTTPRequestHandler):\n         tool_choice = req.get(\"tool_choice\")\n         emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n \n-        system_text, prompt = _messages_to_prompt(req.get(\"messages\") or [])\n-        if not prompt:\n+        raw_messages = req.get(\"messages\") or []\n+        _, raw_turns_text = _messages_to_prompt(raw_messages)\n+        if not raw_turns_text:\n             self._send(\n                 400,\n                 {\n@@ -1591,15 +2160,56 @@ class Handler(BaseHTTPRequestHandler):\n                 },\n             )\n             return\n-        head: list[str] = []\n-        if system_text:\n-            head.append(f\"[system]\\n{system_text}\")\n-        if emulate_tools:\n-            head.append(_tools_section(tools, tool_choice))\n-        elif raw_tools and not system_text:\n-            head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n-        if head:\n-            prompt = \"\\n\\n\".join(head) + f\"\\n\\n{prompt}\"\n+\n+        rid = uuid.uuid4().hex[:8]\n+        limit = _context_limit(model)\n+        target = _context_target(limit)\n+        retry_target = _context_retry_target(limit)\n+        prune_res = _prune_messages(\n+            raw_messages,\n+            limit=limit,\n+            target=target,\n+            tools=tools,\n+            tool_choice=tool_choice,\n+            raw_tools=raw_tools,\n+        )\n+        if prune_res.status == \"refused\":\n+            _log_context_prune(\n+                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n+            )\n+            detail = (\n+                f\"mandatory context exceeds budget \"\n+                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n+            )\n+            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n+            _log(\n+                _format_err_log(\n+                    model,\n+                    \"refused\",\n+                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n+                    req.get(\"stream\") is True,\n+                )\n+            )\n+            self._send(\n+                502,\n+                {\n+                    \"error\": {\n+                        \"message\": _redact_secrets(err_msg),\n+                        \"detail\": _redact_secrets(detail)[:500],\n+                        \"type\": \"proxy_error\",\n+                        \"code\": 502,\n+                    }\n+                },\n+            )\n+            return\n+        if prune_res.status == \"pruned\":\n+            _log_context_prune(\n+                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n+            )\n+\n+        prompt = prune_res.prompt\n+        current_est = prune_res.est_after\n+        reflected_prompts: list[str] = [prompt]\n \n         effort = _map_effort(req)\n \nclass ContextRetryTest(_BridgeScenario):\n    \"\"\"T-12, T-15..T-22: аварийный auto-retry при ошибке жёсткого порога Meta.\"\"\"\n\n    def _over_budget_messages(\n        self, chunk_bytes: int = 110_000, count: int = 12\n    ) -> list[dict[str, Any]]:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-canary-head\"},\n            {\"role\": \"user\", \"content\": \"first-user-canary\"},\n        ]\n        for i in range(count):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append(\n                {\"role\": role, \"content\": f\"mid-canary-{i}-\" + (\"M\" * chunk_bytes)}\n            )\n        msgs.append({\"role\": \"user\", \"content\": \"last-user-canary\"})\n        return msgs\n\n    def test_t12_mandatory_exceeds_limit_returns_502_before_run(self) -> None:\n        huge_canary = \"MANDATORY_SECRET_CANARY_\" + (\"Z\" * 1_250_000)\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": [{\"role\": \"user\", \"content\": huge_canary}],\n            \"stream\": False,\n        }\n        with (\n            mock.patch.object(self.mod, \"ServeRun\") as serve_cls,\n            mock.patch.object(self.mod, \"Run\") as run_cls,\n        ):\n            status, body = bridge_request(self, payload)\n            self.assertEqual(status, 502)\n            serve_cls.assert_not_called()\n            run_cls.assert_not_called()\n        self.assertTrue(self._slot_free())\n        err = json.loads(body.decode(\"utf-8\"))[\"error\"]\n        self.assertIn(\"mandatory context exceeds budget\", err[\"message\"])\n        self.assertIn(\"limit=400000\", err[\"message\"])\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"reason=refused_mandatory\", logs)\n        self.assertNotIn(\"MANDATORY_SECRET_CANARY_\", body.decode(\"utf-8\") + logs)\n\n    def test_t15_hard_threshold_error_triggers_single_retry_and_succeeds(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(639915 >= 460800 tokens) retryable=True\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                prompts_seen: list[str] = []\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    prompts_seen.append(run_self.prompt)\n                    if len(prompts_seen) == 1:\n                        return {\n                            \"rc\": 1,\n                            \"state\": \"terminal_failed\",\n                            \"text\": \"\",\n                            \"err\": hard_err,\n                            \"via\": \"serve\",\n                        }\n                    return {\n                        \"rc\": 0,\n                        \"state\": \"ok\",\n                        \"text\": \"recovered-ok\",\n                        \"chunks\": [\"recovered-ok\"],\n                        \"err\": \"\",\n                        \"summaries\": [],\n                        \"usage\": {\"promptTokens\": 150000, \"outputTokens\": 5},\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(status, 200)\n                self.assertEqual(len(prompts_seen), 2)\n                est1 = self.mod._estimate_tokens(prompts_seen[0])\n                est2 = self.mod._estimate_tokens(prompts_seen[1])\n                self.assertLessEqual(est1, 320_000)\n                self.assertLessEqual(est2, 200_000)\n                self.assertLess(est2, est1)\n                text_body = body.decode(\"utf-8\")\n                self.assertIn(\"recovered-ok\", text_body)\n                if stream:\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    frames = [\n                        json.loads(line[6:])\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                    ]\n                    self.assertFalse(any(\"error\" in f for f in frames))\n\n    def test_t16_hard_threshold_error_twice_returns_terminal_502(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(500000 >= 460800 tokens) prompt-canary-reflected\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                calls = 0\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    nonlocal calls\n                    calls += 1\n                    return {\n                        \"rc\": 1,\n                        \"state\": \"terminal_failed\",\n                        \"text\": \"\",\n                        \"err\": hard_err + \" \" + run_self.prompt,\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-full-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(calls, 2)\n                text_body = body.decode(\"utf-8\")\n                if stream:\n                    self.assertEqual(status, 200)\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    err_frames = [\n                        json.loads(line[6:])[\"error\"]\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                        and \"error\" in json.loads(line[6:])\n                    ]\n                    self.assertEqual(len(err_frames), 1)\n                    err_obj = err_frames[0]\n                else:\n                    self.assertEqual(status, 502)\n                    err_obj = json.loads(text_body)[\"error\"]\n                self.assertEqual(err_obj[\"type\"], \"proxy_error\")\n                self.assertEqual(err_obj[\"code\"], 502)\n                self.assertIn(\n                    \"context hard threshold exceeded after single compaction retry\",\n                    err_obj[\"message\"],\n                )\n                self.assertIn(\"target=200000\", err_obj[\"message\"])\n                logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n                for canary in (\n                    \"sys-canary-head\",\n                    \"first-user-canary\",\n                    \"mid-canary-\",\n                    \"last-user-canary\",\n                ):\n                    self.assertNotIn(canary, text_body + logs)\n\n    def test_t17_other_error_or_marker_in_normal_text_does_not_retry(self) -> None:\n        self.assertEqual(\n            self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            \"context compaction replacement still exceeds the hard threshold\",\n        )\n        # 1) Другая ошибка в err -> 1 попытка.\n        calls = 0\n\n        def other_err(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": \"quota_exceeded\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with mock.patch.object(self.mod.ServeRun, \"execute\", other_err):\n            status, _ = bridge_request(self, payload)\n        self.assertEqual(status, 502)\n        self.assertEqual(calls, 1)\n\n        # 2) Подстрока в обычном ответе модели (rc=0, state=\"ok\") -> 1 попытка, 200 OK.\n        calls = 0\n\n        def marker_in_text(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\",\n                \"chunks\": [\n                    f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\"\n                ],\n                \"err\": \"\",\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", marker_in_text):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(calls, 1)\n        self.assertIn(self.mod.HARD_THRESHOLD_ERR_SUBSTR, body.decode(\"utf-8\"))\n\n    def test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget(\n        self,\n    ) -> None:\n        exec_prompts: list[str] = []\n\n        def fail_serve(_self: Any) -> dict[str, Any]:\n            raise self.mod.ServeUnavailable(\"serve down\")\n\n        def fake_exec(run_self: Any) -> dict[str, Any]:\n            exec_prompts.append(run_self.prompt)\n            n = len(exec_prompts)\n            if n == 1:\n                # Сетевой маркер на первой попытке -> сетевой ретрай с тем же промптом.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"nonzero_exit\",\n                    \"text\": \"\",\n                    \"err\": self.mod.NETWORK_RETRY_MARKER,\n                }\n            if n == 2:\n                # Сетевой ретрай вернул ошибку порога Meta -> должен сработать контекстный retry.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"terminal_failed\",\n                    \"text\": \"\",\n                    \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n                }\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": \"exec-recovered\",\n                \"chunks\": [\"exec-recovered\"],\n                \"err\": \"\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with (\n            mock.patch.object(self.mod.ServeRun, \"execute\", fail_serve),\n            mock.patch.object(self.mod.Run, \"execute\", fake_exec),\n        ):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(len(exec_prompts), 3)\n        self.assertEqual(exec_prompts[0], exec_prompts[1])\n        self.assertLess(\n            self.mod._estimate_tokens(exec_prompts[2]),\n            self.mod._estimate_tokens(exec_prompts[0]),\n        )\n        self.assertIn(\"exec-recovered\", body.decode(\"utf-8\"))\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,188p' bridges/muse-bridge/server.py; sed -n '325,678p' bridges/muse-bridge/server.py; sed -n '1055,1245p' bridges/muse-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,188p' bridges/muse-bridge/server.py; sed -n '325,678p' bridges/muse-bridge/server.py; sed -n '1055,1245p' bridges/muse-bridge/server.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"muse-bridge — локальный OpenAI-совместимый мост поверх Muse Code CLI (Meta).\n\nОдин запрос `/v1/chat/completions` = один headless-ход\n`~/.config/muse-launch/muse-cli.sh exec --provider meta --model muse-spark-1.3\n --reasoning-effort <TIER> --yolo --trust-workspace --workspace <WS> --json --prompt-file <f>`.\n\nВызов ТОЛЬКО через обёртку muse-cli.sh (прокси :10816, вычистка META_API_KEY,\nexit 42 при DOWN прокси) — канон model-invocation.md §2d. Голый `muse` не используется.\n\nStdout CLI — JSONL-конверты (schema_version=1). Текст ответа — из\n`run.terminal.completed` (payload.text); fallback — конкатенация `run.output.delta`\n(payload.text). Ошибки — `run.terminal.*` с terminal != completed либо\n`task.lifecycle.failed` (event.reason). Usage CLI в JSONL не отдаёт — оценка по словам.\n\nТранспорт — stdlib. `stream:true`: заголовки 200 и role-delta уходят сразу, пока ход\nидёт — data-чанки `chat.completion.chunk` с пустой дельтой `{\"content\": \"\"}`\n(MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\nsummaries как `delta.reasoning_content`, tool_calls, content-чанки (~300 символов), финал\nс finish_reason + usage, затем `data: [DONE]`. Ошибка после старта потока — кадр\n`{\"error\": …}` + `[DONE]`. Текст ответа CLI отдаёт в конце хода, поэтому content\nпо-прежнему приходит в конце. `stream:false` — обычный JSON.\n\nПровал хода (failed terminal, rc != 0, таймаут) не отдаётся как успешный финал: частичный\nтекст и tool-блоки отбрасываются — SSE-кадр ошибки + `[DONE]` (stream) либо 502 (JSON).\n\nKeepalive: пустые data-чанки держат SSE-соединение, не меняя текст ответа.\nСброс idle-watchdog клиента pi-ai требует отдельной живой проверки в DSH.\nПеред финалом поток запечатывается; после `data: [DONE]` записей нет.\n\nЭмуляция OpenAI function calling (порт из droid-bridge): если запрос содержит\nнепустой `tools` (и tool_choice != \"none\"), в системный текст добавляется протокол\n`<tool_call>{\"name\":…,\"arguments\":{…}}</tool_call>` и схемы инструментов; блоки в\nответе модели разбираются ToolCallParser в `message.tool_calls` +\n`finish_reason:\"tool_calls\"`; история assistant.tool_calls / role:\"tool\"\nрендерится обратно в те же блоки. Без `tools` мост чисто текстовый.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport random\nimport re\nimport select\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport uuid\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom typing import Any, NamedTuple\n\nlogger = logging.getLogger(\"muse-bridge\")\n\nHOST = os.environ.get(\"MUSE_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\nPORT = int(os.environ.get(\"MUSE_BRIDGE_PORT\", \"9886\"))\nAUTH_KEY = os.environ.get(\"MUSE_BRIDGE_KEY\", \"\").strip()\n\nTIMEOUT_S = float(os.environ.get(\"MUSE_BRIDGE_TIMEOUT_S\", \"1800\"))\nMAX_CONCURRENT = int(os.environ.get(\"MUSE_BRIDGE_MAX_CONCURRENT\", \"2\"))\n\nMUSE_WRAPPER = os.environ.get(\n    \"MUSE_BRIDGE_CLI\", str(Path.home() / \".config\" / \"muse-launch\" / \"muse-cli.sh\")\n)\nROOT = Path(__file__).resolve().parent\nWORKSPACE = Path(os.environ.get(\"MUSE_BRIDGE_WORKSPACE\", str(ROOT / \"workspace\")))\nLOG_PATH = Path(os.environ.get(\"MUSE_BRIDGE_LOG\", str(ROOT / \"logs\" / \"bridge.log\")))\n\nALLOWED_MODELS: dict[str, dict[str, Any]] = {\n    \"muse-spark-1.3\": {\"context_length\": 1048576, \"max_output\": 131072},\n    # 2026-10-05: контрибьютор-слот (только пикер, по просьбе владельца).\n    # id подтверждён `muse model-profile show` (резолвится); окно/лимит как у spark.\n    \"muse-spark-1.3-contributor\": {\"context_length\": 1048576, \"max_output\": 131072},\n    \"muse-wonder-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n    \"muse-wonder-full-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n}\nDEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-wonder-full-1.0\")\nDEFAULT_CONTEXT_LIMIT = 400_000\n\n# Подстрока ошибки жёсткого порога контекста Meta (ADR-001.3, [F-01]).\nHARD_THRESHOLD_ERR_SUBSTR = (\n    \"context compaction replacement still exceeds the hard threshold\"\n)\nCOMPACTION_MARKER = (\n    \"[... earlier conversation turns compacted to stay within Muse context limit ...]\"\n)\n_COMPACTION_MARKER_ROLE = \"__compaction_marker__\"\n\n# OpenAI/DSH effort -> `--reasoning-effort` Muse CLI. Нет/неизвестно -> max (канон слота).\nEFFORT_MAP: dict[str, str] = {\n    \"low\": \"low\",\n    \"medium\": \"medium\",\n    \"high\": \"high\",\n    \"xhigh\": \"xhigh\",\n    \"max\": \"max\",\n    # 2026-10-08: \"none\" запрещён meta-провайдером (muse exec RC=2:\n    # \"--reasoning-effort none is not supported with --provider meta\"),\n    # мост отдавал 502. \"Без рассуждений\" -> ближайший живой тир minimal.\n    \"off\": \"minimal\",\n    \"none\": \"minimal\",\n    \"minimal\": \"minimal\",\n    \"ultra\": \"xhigh\",  # runtime-гейт ultra откатывается в xhigh\n}\nDEFAULT_EFFORT = \"max\"\n\n# Однократный ретрай exec — ТОЛЬКО на этот маркер (exec идемпотентен).\n# Остальные ошибки (rc=42 прокси DOWN, timeout, terminal_*) не ретраятся.\nNETWORK_RETRY_MARKER = \"network connection could not be opened\"\n\n# Bridge-тир -> MSP ReasoningEffort (closed-вокабуляр SS3.2). _map_effort уже\n# нормализовал запрос; ultra откатан в xhigh там же (EFFORT_MAP).\n# 2026-10-08: +minimal (низший живой тир meta -> низший известный MSP-тир low);\n# \"none\" оставлен оборонительно (сюда больше не приходит, но MSP-вокабуляр под вопросом).\n_MSP_EFFORT = {\n    \"low\": \"low\",\n    \"medium\": \"medium\",\n    \"high\": \"high\",\n    \"xhigh\": \"xhigh\",\n    \"max\": \"max\",\n    \"minimal\": \"low\",\n    \"none\": \"low\",\n}\n\n# Грейс выхода CLI после terminal completed: вышел сам -> его rc настоящий; завис -> добивает мост.\n# Грейс вне бюджета хода (таймер TIMEOUT_S отменяется по completed), но ограничен.\nQUARANTINE_MAX_S = 600.0  # потолок карантина слота: группа не подтверждена мёртвой\n_SIGNAL_RCS = (\n    -signal.SIGKILL,\n    -signal.SIGTERM,\n)  # rc процесса, убитого мостом при уборке\nTERMINAL_EXIT_GRACE_S = 0.5\nSERVE_SPAWN_TIMEOUT_S = 30.0  # handshake+session/start должны уложиться сюда\n\n\nclass ServeUnavailable(Exception):\n    \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n\n\ndef _uuid7() -> str:\n    ms = int(time.time() * 1000) & 0xFFFFFFFFFFFF\n    rand = random.getrandbits(74)\n    value = (ms << 74) | rand\n    hx = f\"{value:032x}\"\n    hx = hx[:12] + \"7\" + hx[13:16] + f\"{8 | (int(hx[16], 16) & 3):x}\" + hx[17:]\n    return f\"{hx[:8]}-{hx[8:12]}-{hx[12:16]}-{hx[16:20]}-{hx[20:]}\"\n\n\nTOOL_CALL_OPEN = \"<tool_call>\"\nTOOL_CALL_CLOSE = \"</tool_call>\"\n\nDEFAULT_SYSTEM_HINT = (\n    \"Ты отвечаешь в текстовом чате. Не вызывай инструменты и не выполняй команды; \"\n    \"верни только текстовый ответ.\"\n)\n\n_started = time.time()\n_active: dict[str, float] = {}\n_active_lock = threading.Lock()\n# Слоты в карантине (по записи на слот: pgid не подтверждённых мёртвыми групп); под _active_lock.\n_quarantined_slots: list[list[int]] = []\n_slots = threading.Semaphore(MAX_CONCURRENT)\n_LOG_LOCK = threading.Lock()\n\n\ndef _log(msg: str) -> None:\n    safe_msg = _redact_secrets(msg)\n    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {safe_msg}\"\n    sys.stderr.write(line + \"\\n\")\n    sys.stderr.flush()\n    try:\n        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)\n        with _LOG_LOCK, LOG_PATH.open(\"a\", encoding=\"utf-8\") as fh:\n            fh.write(line + \"\\n\")\n    except OSError:\n        pass\n\n\ndef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n    hdr = handler.headers.get(\"Authorization\", \"\")\n    if hdr.startswith(\"Bearer \"):\n        return hdr[7:].strip() == AUTH_KEY\n    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\ndef _flatten_content(content: Any) -> str:\n    \"\"\"OpenAI content (str | list[part]) -> plain text.\"\"\"\n    if content is None:\n        return \"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        parts = []\n        for item in content:\n            if isinstance(item, str):\n                parts.append(item)\n            elif isinstance(item, dict):\n                if \"text\" in item:\n                    parts.append(str(item[\"text\"]))\n                elif item.get(\"type\") == \"image_url\":\n                    parts.append(\"[image omitted]\")\n        return \"\\n\".join(p for p in parts if p)\n    return str(content)\n\n\ndef _normalize_arguments(value: Any) -> dict | None:\n    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n\n    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n    и запускать инструмент с пустыми аргументами.\n    \"\"\"\n    if isinstance(value, dict):\n        return value\n    if isinstance(value, str):\n        text = value.strip()\n        if text:\n            try:\n                parsed = json.loads(text)\n            except ValueError:\n                return None\n            if isinstance(parsed, dict):\n                return parsed\n    return None\n\n\ndef _normalize_tool_call(item: Any) -> dict:\n    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n\n    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n    с конкретным вызовом при нескольких одинаковых инструментах.\n    \"\"\"\n    if not isinstance(item, dict):\n        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n    args = fn.get(\"arguments\")\n    if args is None:\n        args = item.get(\"arguments\")\n    normalized = _normalize_arguments(args)\n    return {\n        \"id\": str(item.get(\"id\") or \"\"),\n        \"name\": str(name),\n        \"arguments\": normalized if normalized is not None else {},\n    }\n\n\ndef _render_tool_call(item: Any) -> str:\n    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n\n\ndef _tool_choice_none(tool_choice: Any) -> bool:\n    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n\n\ndef _tool_choice_name(tool_choice: Any) -> str:\n    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n    if not isinstance(tool_choice, dict):\n        return \"\"\n    fn = (\n        tool_choice.get(\"function\")\n        if isinstance(tool_choice.get(\"function\"), dict)\n        else {}\n    )\n    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n    return str(name) if name else \"\"\n\n\ndef _tools_section(tools: list, tool_choice: Any) -> str:\n    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n    lines = [\n        \"[system]\",\n        \"# Tool calling protocol\",\n        \"You may call the external tools listed below.\",\n        \"When you need a tool, output ONLY blocks exactly in this form:\",\n        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n        \"You may output several such blocks in a row. Do not narrate around them.\",\n        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n        \"If no tool is needed, reply normally in plain text.\",\n        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n        \"Do not run shell commands or edit files yourself: emit a tool_call block instead.\",\n    ]\n    if tool_choice == \"required\":\n        lines.append(\"You MUST call at least one tool now.\")\n    else:\n        forced = _tool_choice_name(tool_choice)\n        if forced:\n            lines.append(f'You MUST call the tool \"{forced}\" now.')\n    lines.append(\"\")\n    lines.append(\"Available tools:\")\n    for item in tools:\n        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n        if not isinstance(fn, dict):\n            continue\n        name = str(fn.get(\"name\") or \"\")\n        desc = str(fn.get(\"description\") or \"\")\n        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n        lines.append(f\"- {name}: {desc}\")\n        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n    return \"\\n\".join(lines)\n\n\ndef _render_turn(msg: dict[str, Any]) -> tuple[str, str]:\n    \"\"\"Одна реплика истории -> (role, текст); пустой текст = пропустить.\n\n    assistant.tool_calls и role:\"tool\" рендерятся в те же блоки, что протокол.\n    \"\"\"\n    role = str(msg.get(\"role\") or \"user\").strip().lower()\n    text = _flatten_content(msg.get(\"content\"))\n    if role == \"tool\":\n        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n        name = str(msg.get(\"name\") or \"\")\n        header = f\"[tool result {call_id}]\"\n        if name:\n            header += f\" ({name})\"\n        return role, f\"{header}\\n{text}\" if text.strip() else header\n    if role == \"assistant\":\n        parts = [text] if text.strip() else []\n        calls = msg.get(\"tool_calls\")\n        if isinstance(calls, list):\n            parts.extend(_render_tool_call(tc) for tc in calls)\n        return role, \"\\n\".join(parts)\n    return role, text\n\n\ndef _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"История OpenAI -> (system_text, размеченный текст реплик).\"\"\"\n    systems: list[str] = []\n    turns: list[str] = []\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        if role in (\"system\", \"developer\"):\n            systems.append(text)\n        elif role == \"assistant\":\n            turns.append(f\"Assistant: {text}\")\n        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n            turns.append(text)\n        else:\n            turns.append(f\"User: {text}\")\n    return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n\n\ndef _assemble_prompt(\n    messages: list[dict[str, Any]],\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> tuple[str, str, str]:\n    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n    system_text, turns_text = _messages_to_prompt(messages)\n    if not turns_text:\n        return system_text, \"\", \"\"\n    head: list[str] = []\n    if system_text:\n        head.append(f\"[system]\\n{system_text}\")\n    if emulate_tools:\n        head.append(_tools_section(clean_tools, tool_choice))\n    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not system_text:\n        head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n    full_prompt = \"\\n\\n\".join(head) + f\"\\n\\n{turns_text}\" if head else turns_text\n    return system_text, turns_text, full_prompt\n\n\ndef _strip_code_fence(text: str) -> str:\n    \"\"\"Снять обёртку ```…``` (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n    body = text.strip()\n    if body.startswith(\"```\"):\n        newline = body.find(\"\\n\")\n        body = body[newline + 1 :] if newline != -1 else body[3:]\n    if body.rstrip().endswith(\"```\"):\n        body = body.rstrip()[:-3]\n    return body.strip()\n\n\ndef _parse_tool_call_block(inner: str) -> dict | None:\n    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n\n    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n    \"\"\"\n    try:\n        obj = json.loads(_strip_code_fence(inner))\n    except ValueError:\n        return None\n    if not isinstance(obj, dict):\n        return None\n    name = obj.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return None\n    arguments: dict = {}\n    if \"arguments\" in obj:\n        normalized = _normalize_arguments(obj.get(\"arguments\"))\n        if normalized is None:\n            return None\n        arguments = normalized\n    return {\"name\": name.strip(), \"arguments\": arguments}\n\n\nclass ToolCallParser:\n    \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n\n    Тег <tool_call> может прийти разорванным между дельтами: хвост, который может\n    оказаться началом тега, удерживается и не уходит в content до разрешения.\n    \"\"\"\n\n    def __init__(self, on_content, on_tool_call):\n        self._buf = \"\"\n        self._on_content = on_content\n        self._on_tool_call = on_tool_call\n\n    def feed(self, text: str) -> None:\n        self._buf += text\n        self._drain(final=False)\n\n    def finish(self) -> None:\n        self._drain(final=True)\n\n    def _drain(self, final: bool) -> None:\n        while True:\n            start = self._buf.find(TOOL_CALL_OPEN)\n            if start == -1:\n                if final:\n                    self._flush_all()\n                    return\n                keep = self._pending_prefix()\n                if keep:\n                    self._emit(self._buf[:-keep])\n                    self._buf = self._buf[-keep:]\n                else:\n                    self._flush_all()\n                return\n            if start > 0:\n                self._emit(self._buf[:start])\n                self._buf = self._buf[start:]\n            end = self._find_close_outside_string(len(TOOL_CALL_OPEN))\n            if end == -1:\n                if final:\n                    self._flush_all()  # незакрытый/невалидный блок отдаём текстом\n                return\n            inner = self._buf[len(TOOL_CALL_OPEN) : end]\n            self._buf = self._buf[end + len(TOOL_CALL_CLOSE) :]\n            call = _parse_tool_call_block(inner)\n            if call is None:\n                self._emit(TOOL_CALL_OPEN + inner + TOOL_CALL_CLOSE)\n            else:\n                self._on_tool_call(call)\n\n    def _find_close_outside_string(self, start: int) -> int:\n        \"\"\"Позиция `</tool_call>` вне строковых литералов JSON, или -1.\n\n        Закрывающий тег внутри JSON-строки (например, значение аргумента содержит\n        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n        строку не закрывают.\n        \"\"\"\n        index = start\n        length = len(self._buf)\n        in_string = False\n        escaped = False\n        while index < length:\n            char = self._buf[index]\n            if in_string:\n                if escaped:\n                    escaped = False\n                elif char == \"\\\\\":\n                    escaped = True\n                elif char == '\"':\n                    in_string = False\n            elif char == '\"':\n                in_string = True\n            elif self._buf.startswith(TOOL_CALL_CLOSE, index):\n                return index\n            index += 1\n        return -1\n\n    def _pending_prefix(self) -> int:\n        \"\"\"Длина хвоста — префикса открывающего тега (его нельзя отдать в content).\"\"\"\n        limit = min(len(TOOL_CALL_OPEN) - 1, len(self._buf))\n        for length in range(limit, 0, -1):\n            if self._buf[-length:] == TOOL_CALL_OPEN[:length]:\n                return length\n        return 0\n\n    def _emit(self, text: str) -> None:\n        if text:\n            self._on_content(text)\n\n    def _flush_all(self) -> None:\n        if self._buf:\n            text, self._buf = self._buf, \"\"\n            self._on_content(text)\n\n\ndef _split_tool_calls(chunks: list[str]) -> tuple[str, list[dict]]:\n    \"\"\"Дельты текста ответа -> (content, tool_calls в формате OpenAI).\n\n    Тот же ToolCallParser, что у droid-bridge; id вызовов — call_<hex24>.\n    \"\"\"\n    pieces: list[str] = []\n    calls: list[dict] = []\n\n    def add_call(call: dict) -> None:\n        calls.append(\n            {\n                \"index\": len(calls),\n                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": call[\"name\"],\n                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n                },\n            }\n        )\n\n    parser = ToolCallParser(pieces.append, add_call)\n    for chunk in chunks:\n        parser.feed(chunk)\n    parser.finish()\n    return \"\".join(pieces), calls\n\n\ndef _map_effort(req: dict[str, Any]) -> str:\n    \"\"\"reasoning_effort (chat) | reasoning.effort (responses-стиль) -> тир Muse.\"\"\"\n    raw: Any = req.get(\"reasoning_effort\")\n    if raw is None and isinstance(req.get(\"reasoning\"), dict):\n        raw = req[\"reasoning\"].get(\"effort\")\n    key = str(raw).strip().lower() if raw is not None else \"\"\n    return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n    except (ProcessLookupError, PermissionError, OSError):\n        try:\n            proc.kill()\n        except OSError:\n            pass\n\n\ndef _group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (killpg сигналом 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef _wait_group_exit(pgid: int, timeout: float, leader_reaped: bool = False) -> bool:\n    \"\"\"Короткое ожидание ухода группы после SIGKILL (обычно мгновенно).\n\n    Пока группа жива, SIGKILL повторяется: потомок, форкнувшийся в момент первого killpg,\n    остаётся в группе и иначе держал бы pipe (close() вешался бы на чтении stderr).\n    Лидер реапнут (leader_reaped) — его pid свободен для переиспользования, поэтому после\n    одного контрольного killpg по ещё живым потомкам сигналы прекращаются, остаётся опрос.\n    \"\"\"\n    deadline = time.monotonic() + timeout\n    control_sent = False\n    while _group_alive(pgid) and time.monotonic() < deadline:\n        if not (leader_reaped and control_sent):\n            try:\n                os.killpg(pgid, signal.SIGKILL)\n            except OSError:\n                pass\n            control_sent = True\n        time.sleep(0.05)\n    return not _group_alive(pgid)\n\n\ndef _terminate_run(run: Any, streams: tuple) -> None:\n    \"\"\"Убить группу хода и подтвердить её смерть; результат — run.dead_confirmed.\n\n    TimeoutExpired при ожидании после SIGKILL не считается смертью: SIGKILL группы повторяется\n    (в _wait_group_exit тоже), смерть группы проверяется по факту. Не подтверждена — трубы не\n    закрываются (close() ждал бы читателя), слот хендлера уйдёт в карантин.\n    \"\"\"\n    proc = run.proc\n    if proc is None:\n        return\n    # Уборка идёт под замком: параллельный close() (таймер, надзор обрыва, finally\n    # execute) ждёт её конца и видит итоговый dead_confirmed, а не выходит по _closed.\n    with run._cleanup_lock:\n        if run._closed:\n            return\n        run._closed = True\n        # Пессимистично до подтверждения: оборванная уборка уйдёт в карантин слота.\n        run.dead_confirmed = False\n        _kill_group(proc)\n        try:\n            proc.wait(timeout=5.0)\n        except subprocess.TimeoutExpired:\n            _log(f\"cleanup: wait after SIGKILL timed out pid={proc.pid}, escalating\")\n            _kill_group(proc)\n            try:\n                proc.wait(timeout=5.0)\n            except subprocess.TimeoutExpired:\n                pass\n        run.dead_confirmed = _wait_group_exit(\n            proc.pid, 2.0, leader_reaped=proc.poll() is not None\n        )\n        if not run.dead_confirmed:\n            _log(f\"cleanup: process group {proc.pid} not confirmed dead after SIGKILL\")\n            return\n        for stream in streams:\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n                pass\n\n\ndef _quarantine_slot(runs: list) -> None:\n    \"\"\"Слот держится, пока группы ходов не подтверждены мёртвыми (карантин), затем возвращается.\"\"\"\n    pgids = [r.proc.pid for r in runs if r.proc is not None]\n    _log(f\"quarantine: slot held, groups not confirmed dead pgids={pgids}\")\n    with _active_lock:\n        _quarantined_slots.append(pgids)\n\n    def work() -> None:\n        end = time.monotonic() + QUARANTINE_MAX_S\n        escalated = False\n        while True:\n            alive = [r for r in runs if r.proc is not None and _group_alive(r.proc.pid)]\n            if not alive:\n                break\n            if not escalated and time.monotonic() >= end:\n                # Потолок вышел, а группа жива: слот отпускать нельзя (orphan продолжит\n                # работу при свободном слоте) — сигнал оператору, дальше только опрос.\n                escalated = True\n                _log(\n                    \"CRITICAL quarantine: process groups still alive after \"\n                    f\"{QUARANTINE_MAX_S:.0f}s pgids={[r.proc.pid for r in alive]}, \"\n                    \"slot stays withdrawn until they die, signals stopped\"\n                )\n            if not escalated:\n                for run in alive:\n                    # Реапнутый лидер освободил pid: killpg по нему может попасть в чужую группу.\n                    if run.proc.poll() is None:\n                        _kill_group(run.proc)\n            time.sleep(1.0)\n        with _active_lock:\n            _quarantined_slots.remove(pgids)\n        _log(\"quarantine: slot released\")\n        _slots.release()\n\n    threading.Thread(target=work, daemon=True).start()\n\n\nclass Run:\n    \"\"\"Один прогон `muse-cli.sh exec` с разбором JSONL-конвертов.\"\"\"\n\n    def __init__(self, model_id: str, prompt: str, effort: str, workdir: Path) -> None:\n        self.model_id = model_id\n        self.prompt = prompt\n        self.effort = effort\n        self.workdir = workdir\n        self.proc: subprocess.Popen | None = None\n        self._closed = False\n        self._cleanup_lock = threading.Lock()\n        self.dead_confirmed = (\n            True  # False — группа не подтверждена мёртвой (карантин слота)\n        )\n\n    def close(self) -> None:\n        \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n\n        Идемпотентно: повторный вызов (таймер, надзор обрыва, finally) — no-op,\n        поэтому поздний killpg не может попасть в переиспользованный pid.\n        \"\"\"\n        proc = self.proc\n        if proc is None:\n            return\n        _terminate_run(self, (proc.stdout, proc.stderr))\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"muse wrapper not executable: {MUSE_WRAPPER}\",\n                \"state\": \"launcher_missing\",\n            }\n\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\n            \"META_API_KEY\", None\n        )  # обёртка тоже вычищает; двойная страховка (flat-подписка, не PAYG)\n\n        fd, prompt_path = tempfile.mkstemp(\n            prefix=\"muse-prompt-\", suffix=\".txt\", dir=str(self.workdir)\n        )\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(self.prompt)\n        except OSError as exc:\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"prompt file write failed: {exc}\",\n                \"state\": \"spawn_failed\",\n            }\n\n        cmd = [\n            MUSE_WRAPPER,\n            \"exec\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--reasoning-effort\",\n            self.effort,\n            \"--yolo\",\n            \"--trust-workspace\",\n            \"--workspace\",\n            str(self.workdir),\n            \"--json\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1250,1455p' bridges/muse-bridge/server.py; sed -n '1456,1660p' bridges/muse-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1250,1455p' bridges/muse-bridge/server.py; sed -n '1456,1660p' bridges/muse-bridge/server.py\"","aggregated_output":"            \"--disable-reminders\",\n            \"--prompt-file\",\n            prompt_path,\n        ]\n        _log(\n            f\"exec model={self.model_id} effort={self.effort} prompt_chars={len(self.prompt)} ws={self.workdir}\"\n        )\n\n        run_id = uuid.uuid4().hex[:8]\n        deltas: list[str] = []\n        final_text: str | None = None\n        terminal: str | None = None\n        reason: str | None = None\n        err_lines: list[str] = []\n        state = \"ok\"\n        try:\n            # Регистрация в _active ДО Popen: между появлением self.proc и записью в _active\n            # нет окна, в котором надзор уже видит процесс, а /health его не учитывает.\n            with _active_lock:\n                _active[run_id] = time.time()\n            try:\n                self.proc = subprocess.Popen(\n                    cmd,\n                    cwd=str(self.workdir),\n                    env=env,\n                    stdin=subprocess.DEVNULL,\n                    stdout=subprocess.PIPE,\n                    stderr=subprocess.PIPE,\n                    text=True,\n                    encoding=\"utf-8\",\n                    errors=\"replace\",\n                    bufsize=1,\n                    start_new_session=True,\n                )\n            except OSError as exc:\n                with _active_lock:\n                    _active.pop(run_id, None)\n                return {\n                    \"rc\": -1,\n                    \"text\": \"\",\n                    \"err\": f\"spawn failed: {exc}\",\n                    \"state\": \"spawn_failed\",\n                }\n\n            def drain_stderr() -> None:\n                try:\n                    assert self.proc is not None and self.proc.stderr is not None\n                    for line in self.proc.stderr:\n                        line = line.strip()\n                        if line:\n                            err_lines.append(line)\n                except (OSError, ValueError):\n                    pass\n\n            err_thread = threading.Thread(target=drain_stderr, daemon=True)\n            err_thread.start()\n\n            # Жёсткий дедлайн: таймер убивает процесс, даже если stdout молчит.\n            timer = threading.Timer(\n                TIMEOUT_S, lambda: (err_lines.append(\"bridge timeout\"), self.close())\n            )\n            timer.daemon = True\n            timer.start()\n            timed_out = False\n            try:\n                assert self.proc.stdout is not None\n                for raw in self.proc.stdout:\n                    raw = raw.strip()\n                    if not raw:\n                        continue\n                    try:\n                        event = json.loads(raw)\n                    except ValueError:\n                        continue\n                    if not isinstance(event, dict):\n                        continue\n                    ptype = str(event.get(\"payload_type\") or \"\")\n                    raw_payload = event.get(\"payload\")\n                    payload: dict[str, Any] = (\n                        raw_payload if isinstance(raw_payload, dict) else {}\n                    )\n                    if ptype == \"run.output.delta\":\n                        text = payload.get(\"text\")\n                        if isinstance(text, str):\n                            deltas.append(text)\n                    elif ptype.startswith(\"run.terminal\"):\n                        terminal = str(\n                            payload.get(\"terminal\") or ptype.rsplit(\".\", 1)[-1]\n                        )\n                        text = payload.get(\"text\")\n                        if isinstance(text, str):\n                            final_text = text\n                        if payload.get(\"reason\"):\n                            reason = str(payload[\"reason\"])\n                        if terminal == \"completed\":\n                            # Ход завершён: общий таймер хода отменяется сразу (грейс уборки вне\n                            # бюджета хода). Процесс может висеть после terminal — ждать EOF не\n                            # нужно, группу добьёт close() ниже.\n                            timer.cancel()\n                            break\n                    elif ptype == \"task.lifecycle.failed\":\n                        raw_ev = payload.get(\"event\")\n                        ev: dict[str, Any] = raw_ev if isinstance(raw_ev, dict) else {}\n                        if ev.get(\"reason\"):\n                            err_lines.append(f\"task failed: {ev['reason']}\")\n                if terminal == \"completed\":\n                    # Короткий ограниченный грейс: CLI выходит сам (его rc настоящий) либо висит\n                    # после terminal — тогда его добивает мост (rc от сигнала моста — не ошибка).\n                    try:\n                        self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                    except subprocess.TimeoutExpired:\n                        pass\n            except (OSError, ValueError) as exc:\n                state = \"stream_error\"\n                err_lines.append(f\"stdout read failed: {exc}\")\n            finally:\n                timer.cancel()\n                # Порядок: kill группы -> wait ребёнка -> снятие с _active\n                # (слот отпускается позже, в finally хендлера — после execute).\n                self.close()\n                try:\n                    self.proc.wait(timeout=15)\n                except subprocess.TimeoutExpired:\n                    timed_out = True\n                err_thread.join(timeout=5)\n                with _active_lock:\n                    _active.pop(run_id, None)\n        finally:\n            try:\n                os.unlink(prompt_path)\n            except OSError:\n                pass\n\n        raw_rc = self.proc.returncode if self.proc else None\n        rc = raw_rc if raw_rc is not None else -1\n        if terminal == \"completed\" and (\n            raw_rc is None or raw_rc == 0 or raw_rc in _SIGNAL_RCS\n        ):\n            # completed доставлен: rc 0 либо смерть от сигнала моста при уборке (SIGKILL/SIGTERM)\n            # не ошибка; самостоятельный rc != 0 CLI (в т.ч. между грейсом и уборкой) — ошибка.\n            # Не подтверждённая уборка (raw_rc None) не отменяет доставленный ход: журнал + карантин.\n            state, rc = \"ok\", 0\n        elif timed_out or any(line == \"bridge timeout\" for line in err_lines):\n            state = \"timeout\"\n        elif terminal is not None and terminal != \"completed\":\n            state = f\"terminal_{terminal}\"\n        elif rc != 0 and state == \"ok\":\n            state = \"nonzero_exit\"\n\n        # chunks — то, что кормим ToolCallParser: итоговый текст (приоритет) или дельты.\n        chunks = [final_text] if final_text else deltas\n        text = \"\".join(chunks)\n        if reason:\n            err_lines.append(f\"reason: {reason}\")\n        return {\n            \"rc\": rc,\n            \"text\": text,\n            \"chunks\": chunks,\n            \"err\": \"\\n\".join(err_lines[-6:]),\n            \"state\": state,\n        }\n\n\nclass ServeRun:\n    \"\"\"Один запрос через `muse serve` (MSP v1 по stdio, NDJSON JSON-RPC).\n\n    Поток (проверен офлайн на echo-провайдере 05.10.2026): initialize ->\n    notify initialized -> session/start (без approvalMode: любое явное\n    значение режектится startup ceiling; провайдер meta)\n    провайдер meta) -> turn/start (reasoningEffort=тир) -> ждём turn/completed.\n    Текст — из agentMessage (item/completed.text, fallback — item/delta);\n    reasoning summaries — из reasoning-item (summary[] + item/delta\n    field \"summary.N\"); токены — из session/tokenUsage (reasoningTokens\n    включительно). Сырой reasoning-текст в v1 не стримится (только\n    summaries) — ограничение протокола, не моста.\n\n    Любая транспортная неполадка (спавн, handshake, таймаут, интерактивный\n    запрос approval/userInput, JSON-RPC error) -> ServeUnavailable, и\n    вызывающий код тихо идёт на exec. Ошибка самой модели\n    (terminal != completed) — НЕ ServeUnavailable: ход реально выполнен,\n    fallback лишь удвоил бы вызов.\n    \"\"\"\n\n    def __init__(self, model_id: str, prompt: str, effort: str, workdir: Path) -> None:\n        self.model_id = model_id\n        self.prompt = prompt\n        self.effort = effort\n        self.workdir = workdir\n        self.proc: subprocess.Popen | None = None\n        self._rid = 0\n        self._closed = False\n        self._cleanup_lock = threading.Lock()\n        self._handle_event: Any = None  # обработчик событий; ставится в execute\n        self.dead_confirmed = (\n            True  # False — группа не подтверждена мёртвой (карантин слота)\n        )\n        # Запись в stdin serve ограничена дедлайном (ставится в execute): зависший читатель\n        # не держит слот бессрочно, при истечении ход завершается, группа убивается.\n        self._write_until = float(\"inf\")\n\n    def close(self) -> None:\n        \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n        proc = self.proc\n        if proc is None:\n            return\n        _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n\n    def _send(\n        self, method: str, params: dict | None = None, notify: bool = False\n    ) -> int:\n        assert self.proc is not None and self.proc.stdin is not None\n        self._rid += 1\n        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n        if not notify:\n            msg[\"id\"] = self._rid\n        if params is not None:\n            msg[\"params\"] = params\n        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n        try:\n            fd = self.proc.stdin.fileno()\n            view = memoryview(data)\n            sent = 0\n            while sent < len(data):\n                remaining = self._write_until - time.time()\n                if remaining <= 0:\n                    raise ServeUnavailable(\n                        \"serve stdin write timed out: child does not read\"\n                    )\n                _, writable, _ = select.select([], [fd], [], min(0.5, remaining))\n                if not writable:\n                    continue\n                try:\n                    sent += os.write(fd, view[sent:])\n                except BlockingIOError:\n                    continue\n        except (OSError, ValueError) as exc:\n            raise ServeUnavailable(f\"stdio write failed: {exc}\")\n        return self._rid\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\"META_API_KEY\", None)\n        cmd = [\n            MUSE_WRAPPER,\n            \"serve\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--no-session-log\",\n            \"--trust-workspace\",\n            \"--disable-write\",\n            \"--disable-shell\",\n        ]\n        try:\n            self.proc = subprocess.Popen(\n                cmd,\n                cwd=str(self.workdir),\n                env=env,\n                stdin=subprocess.PIPE,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n                encoding=\"utf-8\",\n                errors=\"replace\",\n                bufsize=1,\n                start_new_session=True,\n            )\n        except OSError as exc:\n            raise ServeUnavailable(f\"serve spawn failed: {exc}\")\n        assert self.proc.stdout is not None and self.proc.stdin is not None\n        # stdin неблокирующий: запись идёт срезами с дедлайном (см. _send).\n        os.set_blocking(self.proc.stdin.fileno(), False)\n\n        err_lines: list[str] = []\n        turn_diag_lines: list[str] = []\n        stderr_joined = False\n\n        def drain_stderr() -> None:\n            try:\n                assert self.proc is not None and self.proc.stderr is not None\n                for line in self.proc.stderr:\n                    line = line.strip()\n                    if line:\n                        err_lines.append(line)\n            except (OSError, ValueError):\n                pass\n\n        err_thread = threading.Thread(target=drain_stderr, daemon=True)\n        err_thread.start()\n        deadline = time.time() + TIMEOUT_S\n        setup_deadline = time.time() + SERVE_SPAWN_TIMEOUT_S\n        self._write_until = setup_deadline\n\n        # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n        # уже вычитанные в буфер TextIOWrapper (пачка строк за один write зависала бы).\n        rbuf = bytearray()\n\n        def read_msg(timeout_at: float) -> dict[str, Any]:\n            while time.time() < min(timeout_at, deadline):\n                if self.proc is None or self.proc.stdout is None:\n                    raise ServeUnavailable(\"serve stdout closed\")\n                newline = rbuf.find(b\"\\n\")\n                if newline < 0:\n                    ready, _, _ = select.select([self.proc.stdout], [], [], 0.5)\n                    if not ready:\n                        if self.proc.poll() is not None:\n                            raise ServeUnavailable(\n                                f\"serve exited rc={self.proc.returncode}: \"\n                                + \" \".join(err_lines[-3:])\n                            )\n                        continue\n                    chunk = os.read(self.proc.stdout.fileno(), 65536)\n                    if not chunk:\n                        raise ServeUnavailable(\n                            f\"serve stdout EOF rc={self.proc.poll()}: \"\n                            + \" \".join(err_lines[-3:])\n                        )\n                    rbuf.extend(chunk)\n                    continue\n                line = bytes(rbuf[:newline]).decode(\"utf-8\", \"replace\").strip()\n                del rbuf[: newline + 1]\n                if not line:\n                    continue\n                try:\n                    msg = json.loads(line)\n                except ValueError:\n                    continue\n                if isinstance(msg, dict):\n                    return msg\n            raise ServeUnavailable(\"serve read timeout\")\n\n        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n            while True:\n                msg = read_msg(timeout_at)\n                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n                    if \"error\" in msg:\n                        raise ServeUnavailable(f\"serve RPC error: {msg['error']}\")\n                    result = msg.get(\"result\")\n                    return result if isinstance(result, dict) else {}\n                self._handle_event(msg, None)\n\n        kinds: dict[str, str] = {}\n        deltas: list[str] = []\n        summary_parts: dict[int, str] = {}\n        summaries: list[str] = []\n        final_text: str | None = None\n        usage: dict[str, Any] = {}\n        turn_id: str | None = None\n        session_id: str | None = None\n\n        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n            nonlocal final_text\n            method = msg.get(\"method\")\n            params = msg.get(\"params\") if isinstance(msg.get(\"params\"), dict) else {}\n            if method in (\"approval/request\", \"userInput/request\"):\n                raise ServeUnavailable(f\"serve needs interaction ({method})\")\n            if method in (\"item/started\", \"item/completed\"):\n                raw_item = params.get(\"item\")\n                item: dict[str, Any] = raw_item if isinstance(raw_item, dict) else {}\n                iid = str(item.get(\"itemId\") or \"\")\n                kind = str(item.get(\"kind\") or \"\")\n                if iid:\n                    kinds[iid] = kind\n                if (\n                    method == \"item/completed\"\n                    and turn_id is not None\n                    and item.get(\"turnId\") == turn_id\n                ):\n                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n                        final_text = item[\"text\"]\n                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n                        summaries.extend(\n                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n                        )\n            elif method == \"item/delta\":\n                iid = str(params.get(\"itemId\") or \"\")\n                field = str(params.get(\"field\") or \"text\")\n                piece = params.get(\"delta\")\n                if not isinstance(piece, str) or not piece:\n                    return\n                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n                    try:\n                        idx = int(field.split(\".\", 1)[1])\n                    except (IndexError, ValueError):\n                        idx = len(summary_parts)\n                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n                elif (\n                    kinds.get(iid, \"agentMessage\") == \"agentMessage\" and field == \"text\"\n                ):\n                    deltas.append(piece)\n            elif method == \"session/tokenUsage\":\n                raw = params.get(\"usage\")\n                if isinstance(raw, dict):\n                    usage.update(raw)\n\n        self._handle_event = _handle_event\n\n        try:\n            init_rid = self._send(\n                \"initialize\", {\"clientInfo\": {\"name\": \"muse_bridge\", \"version\": \"1\"}}\n            )\n            init = await_result(init_rid, setup_deadline)\n            schema = init.get(\"schema\") if isinstance(init.get(\"schema\"), dict) else {}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1661,1806p' bridges/muse-bridge/server.py; sed -n '450,498p' bridges/muse-bridge/server.py; sed -n '2121,2366p' tests/test_muse_bridge_killpg.py; sed -n '187,288p' tests/test_muse_bridge_killpg.py; sed -n '979,1035p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1661,1806p' bridges/muse-bridge/server.py; sed -n '450,498p' bridges/muse-bridge/server.py; sed -n '2121,2366p' tests/test_muse_bridge_killpg.py; sed -n '187,288p' tests/test_muse_bridge_killpg.py; sed -n '979,1035p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"            _log(\n                f\"serve init server={init.get('serverInfo', {}).get('version') if isinstance(init.get('serverInfo'), dict) else '?'} \"\n                f\"schema_fp={str(schema.get('fingerprint', ''))[:19]}\"\n            )\n            self._send(\"initialized\", {}, notify=True)\n            sess_rid = self._send(\n                \"session/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"workspaceRoot\": str(self.workdir),\n                    \"providerId\": \"meta\",\n                    \"modelId\": self.model_id,\n                },\n            )\n            # approvalMode намеренно НЕ передаём: любое явное значение\n            # (allowAll, onRequest) отвергается sealed startup ceiling\n            # неинтерактивного serve (commandRejected/approval_mode_ceiling),\n            # а без ключа сервер назначает свой дефолт (promptUnmatched — так\n            # было в офлайн-пробе на echo). Запрос approval/userInput по ходу\n            # хода ведёт в ServeUnavailable -> fallback на exec.\n            sess = await_result(sess_rid, setup_deadline)\n            session = (\n                sess.get(\"session\") if isinstance(sess.get(\"session\"), dict) else {}\n            )\n            session_id = str(session.get(\"sessionId\") or \"\")\n            if not session_id:\n                raise ServeUnavailable(\"session/start gave no sessionId\")\n            tier = _MSP_EFFORT.get(self.effort, \"max\")\n            turn_rid = self._send(\n                \"turn/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"sessionId\": session_id,\n                    \"reasoningEffort\": tier,\n                    \"input\": [{\"type\": \"text\", \"text\": self.prompt}],\n                },\n            )\n            turn = await_result(turn_rid, setup_deadline)\n            if turn.get(\"status\") != \"accepted\":\n                raise ServeUnavailable(f\"turn/start not accepted: {turn}\")\n            turn_id = str(turn.get(\"turnId\") or \"\")\n            _log(\n                f\"serve turn session={session_id[:8]} turn={turn_id[:8]} effort={tier}\"\n            )\n            terminal: str | None = None\n            while time.time() < deadline:\n                # Смерть serve здесь не проверяется: события и completed, уже лежащие в буфере\n                # чтения или pipe, разбираются первыми; read_msg сам поднимет ServeUnavailable\n                # на EOF/выходе процесса, когда разбирать больше нечего.\n                msg = read_msg(deadline)\n                if msg.get(\"method\") == \"turn/completed\" and isinstance(\n                    msg.get(\"params\"), dict\n                ):\n                    p = msg[\"params\"]\n                    if turn_id is not None and p.get(\"turnId\") not in (turn_id, None):\n                        _handle_event(msg, None)\n                        continue\n                    terminal = str(p.get(\"terminal\") or \"unknown\")\n                    if terminal != \"completed\":\n                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                    break\n                if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                    continue  # чужой/дублированный ack — игнор, не разрываем ход\n                _handle_event(msg, None)\n            else:\n                raise ServeUnavailable(\"serve turn deadline exceeded\")\n            serve_rc: int | None = None\n            if terminal == \"completed\":\n                # D-A3-1: после completed — тот же грейс, что у exec: serve вышел сам с rc != 0 ->\n                # ошибка; жив -> мост закрывает группу (сигнал моста rc не определяет).\n                try:\n                    self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                except subprocess.TimeoutExpired:\n                    pass\n                self.close()\n                serve_rc = self.proc.returncode\n            ordered = [\n                summary_parts[i] for i in sorted(summary_parts) if summary_parts[i]\n            ]\n            for part in ordered:\n                if part not in summaries:\n                    summaries.append(part)\n            text = final_text if final_text is not None else \"\".join(deltas)\n            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n            err_thread.join(timeout=5)\n            stderr_joined = True\n            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n            if self.prompt:\n                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n            err = \"\\n\".join(turn_diag_lines)\n            if err:\n                if stderr_tail:\n                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n            else:\n                err = stderr_tail\n            if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                return {\n                    \"rc\": serve_rc,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": \"nonzero_exit\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            if terminal != \"completed\":\n                return {\n                    \"rc\": 1,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": f\"terminal_{terminal}\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            return {\n                \"rc\": 0,\n                \"text\": text,\n                \"chunks\": [text] if text else [],\n                \"err\": err,\n                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n            if not stderr_joined:\n                err_thread.join(timeout=5)\n            self.close()\n\n\nclass Handler(BaseHTTPRequestHandler):\n    protocol_version = \"HTTP/1.1\"\n    timeout = 300\n\n    def log_message(self, format: str, *args: Any) -> None:\n        _log(\"http \" + (format % args))\n\n    def handle_error(self, request: Any, client_address: Any) -> None:\n        _log(f\"http accept error from {client_address}\")\n\n    # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n    _client_gone: bool = False\n    role = str(msg.get(\"role\") or \"user\").strip().lower()\n    text = _flatten_content(msg.get(\"content\"))\n    if role == \"tool\":\n        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n        name = str(msg.get(\"name\") or \"\")\n        header = f\"[tool result {call_id}]\"\n        if name:\n            header += f\" ({name})\"\n        return role, f\"{header}\\n{text}\" if text.strip() else header\n    if role == \"assistant\":\n        parts = [text] if text.strip() else []\n        calls = msg.get(\"tool_calls\")\n        if isinstance(calls, list):\n            parts.extend(_render_tool_call(tc) for tc in calls)\n        return role, \"\\n\".join(parts)\n    return role, text\n\n\ndef _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"История OpenAI -> (system_text, размеченный текст реплик).\"\"\"\n    systems: list[str] = []\n    turns: list[str] = []\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        if role in (\"system\", \"developer\"):\n            systems.append(text)\n        elif role == \"assistant\":\n            turns.append(f\"Assistant: {text}\")\n        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n            turns.append(text)\n        else:\n            turns.append(f\"User: {text}\")\n    return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n\n\ndef _assemble_prompt(\n    messages: list[dict[str, Any]],\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> tuple[str, str, str]:\n    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    def test_t19_client_disconnect_between_attempts_skips_second_run(self) -> None:\n        calls = 0\n        first_entered = threading.Event()\n        release_first = threading.Event()\n\n        def fake_execute(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            first_entered.set()\n            release_first.wait(5)\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n            body = json.dumps(\n                {\n                    \"model\": \"muse-wonder-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                }\n            ).encode(\"utf-8\")\n            head = (\n                \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n                \"Host: 127.0.0.1\\r\\n\"\n                \"Content-Type: application/json\\r\\n\"\n                f\"Content-Length: {len(body)}\\r\\n\"\n                \"Connection: close\\r\\n\\r\\n\"\n            ).encode(\"utf-8\")\n            sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n            sock.sendall(head + body)\n            self.assertTrue(first_entered.wait(5))\n            sock.close()\n            time.sleep(0.35)\n            release_first.set()\n            self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n        self.assertEqual(calls, 1)\n        log_text = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"reason=proactive_prune\", log_text)\n        self.assertNotIn(\"reason=hard_threshold_retry\", log_text)\n\n    def test_t20_mandatory_exceeds_200k_on_retry_skips_second_run(self) -> None:\n        # Обязательный user ~ 250k токенов (750k байт): проходит в 400k, но не влезает в retry_target=200k.\n        calls = 0\n\n        def fake_execute(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": [\n                {\"role\": \"user\", \"content\": \"first-mandatory-\" + (\"A\" * 750_000)},\n                {\"role\": \"assistant\", \"content\": \"mid-optional-\" + (\"B\" * 300_000)},\n                {\"role\": \"user\", \"content\": \"last-mandatory\"},\n            ],\n        }\n        with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 502)\n        self.assertEqual(calls, 1)\n        err = json.loads(body.decode(\"utf-8\"))[\"error\"]\n        self.assertIn(\"mandatory context exceeds budget\", err[\"message\"])\n        self.assertIn(\"limit=200000\", err[\"message\"])\n        self.assertIn(\n            \"reason=refused_retry\", self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        )\n\n    def test_t21_retry_cut_does_not_reduce_prompt_skips_second_run(self) -> None:\n        calls = 0\n\n        def fake_execute(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            }\n\n        # Короткий запрос (<< 200k): повторный срез до 200k даёт ту же оценку -> второй запуск не нужен.\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": [{\"role\": \"user\", \"content\": \"short prompt\"}],\n        }\n        with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 502)\n        self.assertEqual(calls, 1)\n        err = json.loads(body.decode(\"utf-8\"))[\"error\"]\n        self.assertIn(\n            \"context hard threshold exceeded after single compaction retry\",\n            err[\"message\"],\n        )\n        self.assertIn(\n            \"reason=refused_retry\", self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        )\n\n    def test_t22_unconfirmed_death_on_attempt_one_skips_retry_and_quarantines_slot(\n        self,\n    ) -> None:\n        calls = 0\n        proc = CloseKillsGroupTest._spawn_group()\n        self.addCleanup(CloseKillsGroupTest._reap_group, proc)\n\n        def fake_execute(run_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            run_self.proc = proc\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            }\n\n        def fake_close(run_self: Any) -> None:\n            run_self.dead_confirmed = False\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with (\n            mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute),\n            mock.patch.object(self.mod.ServeRun, \"close\", fake_close),\n            mock.patch.object(self.mod, \"_kill_group\", lambda _p: None),\n        ):\n            status, _ = bridge_request(self, payload)\n            self.assertEqual(status, 502)\n            self.assertEqual(calls, 1)\n            self.assertEqual(len(self.mod._quarantined_slots), 1)\n            self.assertFalse(self._slot_free())\n\n            # После реальной смерти группы карантин возвращает слот ровно один раз.\n            os.killpg(proc.pid, signal.SIGKILL)\n            proc.wait(timeout=5)\n            self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n            self.assertEqual(len(self.mod._quarantined_slots), 0)\n            time.sleep(0.2)\n            self.assertTrue(self.mod._slots.acquire(blocking=False))\n            self.mod._slots.release()\n            self.assertFalse(\n                self.mod._slots._value > 1, \"семафор освобождён больше одного раза\"\n            )\n\n\nclass ContextObservabilityTest(_BridgeScenario):\n    \"\"\"T-23: формат context_prune, отсутствие секретов/тел в обоих проходах и отсутствие утечки буферов.\"\"\"\n\n    def test_t23_observability_log_fields_secret_redaction_and_no_retained_buffers(\n        self,\n    ) -> None:\n        secret1 = \"sk-attempt1secretcanary123456\"\n        secret2 = \"Bearer attempt2-secret-token-98765\"\n        body_canary_1 = \"ATTEMPT_ONE_ONLY_BODY_CANARY_\" + (\"P\" * 750_000)\n        body_canary_2 = \"MANDATORY_USER_BODY_CANARY_\" + (\"Q\" * 30)\n\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": f\"sys {secret1}\"},\n            {\"role\": \"user\", \"content\": body_canary_2},\n            {\"role\": \"assistant\", \"content\": \"old-dropped-\" + (\"D\" * 900_000)},\n            {\"role\": \"assistant\", \"content\": body_canary_1},\n            {\"role\": \"user\", \"content\": f\"final question {secret2}\"},\n        ]\n\n        attempts = 0\n\n        def fake_execute(run_self: Any) -> dict[str, Any]:\n            nonlocal attempts\n            attempts += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": (\n                    f\"{self.mod.HARD_THRESHOLD_ERR_SUBSTR} \"\n                    f\"reflected1={body_canary_1[:160]} reflected2={body_canary_2} \"\n                    f\"sec1={secret1} sec2={secret2} prompt={run_self.prompt}\"\n                ),\n            }\n\n        for stream in (False, True):\n            self.mod.LOG_PATH.unlink(missing_ok=True)\n            attempts = 0\n            with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                status, resp_bytes = bridge_request(\n                    self,\n                    {\"model\": \"muse-wonder-1.0\", \"messages\": msgs, \"stream\": stream},\n                )\n            self.assertEqual(status, 200 if stream else 502)\n            self.assertEqual(attempts, 2)\n            log_text = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n            resp_text = resp_bytes.decode(\"utf-8\")\n\n            prune_lines = [\n                line for line in log_text.splitlines() if \"context_prune \" in line\n            ]\n            self.assertEqual(len(prune_lines), 2)\n            self.assertIn(\"reason=proactive_prune\", prune_lines[0])\n            self.assertIn(\"attempt=1\", prune_lines[0])\n            self.assertIn(\"reason=hard_threshold_retry\", prune_lines[1])\n            self.assertIn(\"attempt=2\", prune_lines[1])\n            for line in prune_lines:\n                for field in (\n                    \"rid=\",\n                    \"model=muse-wonder-1.0\",\n                    \"limit=400000\",\n                    \"target=\",\n                    \"est_before=\",\n                    \"est_after=\",\n                    \"msgs_total=\",\n                    \"msgs_kept=\",\n                    \"msgs_dropped=\",\n                    \"mandatory_est=\",\n                    \"overhead_est=\",\n                    \"method=bytes_div_3\",\n                ):\n                    self.assertIn(field, line)\n\n            combined = log_text + resp_text\n            for forbidden in (\n                \"attempt1secretcanary123456\",\n                \"attempt2-secret-token-98765\",\n                \"ATTEMPT_ONE_ONLY_BODY_CANARY_\",\n                \"MANDATORY_USER_BODY_CANARY_\",\n                \"old-dropped-\",\n            ):\n                self.assertNotIn(forbidden, combined)\n\n        # Серия запросов не растит удерживаемые буферы модуля.\n        self.assertEqual(len(self.mod._active), 0)\n        self.assertEqual(len(self.mod._quarantined_slots), 0)\n\n\nif __name__ == \"__main__\":\n    unittest.main(verbosity=2)\nclass _BridgeScenario(unittest.TestCase):\n    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n\n    # Значения инициализируются в setUp() каждого теста.\n    tmp: Path = Path()\n    mod: Any = None\n    pidfile: Path = Path()\n    servepid: Path = Path()\n    server: Any = None\n\n    def wrapper_text(self) -> str:\n        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n\n    def setUp(self) -> None:\n        self.tmp = Path(tempfile.mkdtemp(prefix=\"muse-bridge-killpg-\"))\n        self.addCleanup(shutil.rmtree, str(self.tmp), True)\n        self.mod = load_bridge()\n        # Работаем только во временном каталоге: workspace и лог моста — не в репо.\n        self.mod.WORKSPACE = self.tmp / \"workspace\"\n        self.mod.LOG_PATH = self.tmp / \"bridge.log\"\n        # Один слот: при двух утечка одного не видна неблокирующей пробой семафора.\n        self.mod._slots = threading.Semaphore(1)\n        self.pidfile = self.tmp / \"run.pid\"\n        self.servepid = self.tmp / \"serve.pid\"\n        wrapper = self.tmp / \"muse-cli.sh\"\n        wrapper.write_text(self.wrapper_text(), encoding=\"utf-8\")\n        wrapper.chmod(0o755)\n        self.mod.MUSE_WRAPPER = str(wrapper)\n        self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n        threading.Thread(target=self.server.serve_forever, daemon=True).start()\n        self.addCleanup(self._teardown_scenario)\n\n    def _teardown_scenario(self) -> None:\n        \"\"\"Стоп сервера + добивание своих мок-групп (только свои PGID).\"\"\"\n        self.server.shutdown()\n        self.server.server_close()\n        for pidfile in (self.pidfile, self.servepid):\n            if pidfile.exists():\n                try:\n                    os.killpg(\n                        int(pidfile.read_text(encoding=\"utf-8\").strip()),\n                        signal.SIGKILL,\n                    )\n                except (ProcessLookupError, OSError, ValueError):\n                    pass\n\n    def _open_request(self) -> socket.socket:\n        \"\"\"POST /v1/chat/completions; соединение остаётся открытым (закрывает вызывающий).\"\"\"\n        body = json.dumps(\n            {\n                \"model\": \"muse-spark-1.3\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}],\n            }\n        ).encode(\"utf-8\")\n        head = (\n            \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n            \"Host: 127.0.0.1\\r\\n\"\n            \"Content-Type: application/json\\r\\n\"\n            f\"Content-Length: {len(body)}\\r\\n\"\n            \"Connection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n        sock.sendall(head + body)\n        return sock\n\n    def _post_request_disconnect(self) -> None:\n        \"\"\"POST /v1/chat/completions и обрыв соединения через DISCONNECT_AFTER_S.\"\"\"\n        sock = self._open_request()\n        try:\n            time.sleep(DISCONNECT_AFTER_S)\n        finally:\n            sock.close()\n\n    def _slot_free(self) -> bool:\n        \"\"\"Неблокирующая проба семафора слотов (сразу возвращаем взятую ячейку).\"\"\"\n        sem = self.mod._slots\n        if sem.acquire(blocking=False):\n            sem.release()\n            return True\n        return False\n\n    def _health_json(self) -> dict[str, Any]:\n        \"\"\"Тело ответа GET /health.\"\"\"\n        head = (\n            \"GET /health HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        with socket.create_connection(\n            self.server.server_address[:2], timeout=5\n        ) as sock:\n            sock.sendall(head)\n            chunks = []\n            while True:\n                chunk = sock.recv(65536)\n                if not chunk:\n                    break\n                chunks.append(chunk)\n        body = b\"\".join(chunks).split(b\"\\r\\n\\r\\n\", 1)[1]\n        return json.loads(body.decode(\"utf-8\"))\n\n\nclass HealthQuarantinedTest(_BridgeScenario):\ndef install_protocol_wrapper(\n    scenario: Any, params: dict, noise: bool = False, delay: float = 0\n) -> None:\n    \"\"\"Фейковый MSP с реальными pipes; фиксирует argv и входящие RPC.\"\"\"\n    config = {\n        \"params\": params,\n        \"noise\": noise,\n        \"delay\": delay,\n        \"root\": str(scenario.tmp),\n    }\n    script = scenario.tmp / \"protocol.py\"\n    script.write_text(\n        \"\"\"import json, sys, time\nfrom pathlib import Path\nconfig = json.loads(sys.argv[1])\nroot = Path(config[\"root\"])\nmode = sys.argv[2]\n(root / (mode + \"-argv.json\")).write_text(json.dumps(sys.argv[2:]))\nif mode == \"exec\":\n    print(json.dumps({\"schema_version\": 1, \"payload_type\": \"run.terminal.completed\", \"payload\": {\"text\": \"fallback-ok\"}}), flush=True)\n    sys.exit(0)\nfor line in sys.stdin:\n    msg = json.loads(line)\n    with (root / \"rpc.jsonl\").open(\"a\") as fh:\n        fh.write(json.dumps(msg) + \"\\\\n\")\n    if \"id\" not in msg:\n        continue\n    method = msg[\"method\"]\n    result = {\"session\": {\"sessionId\": \"sess-1\"}} if method == \"session/start\" else {\"status\": \"accepted\", \"turnId\": \"turn-1\"} if method == \"turn/start\" else {}\n    print(json.dumps({\"id\": msg[\"id\"], \"result\": result}), flush=True)\n    if method == \"turn/start\":\n        time.sleep(config[\"delay\"])\n        if config[\"params\"].get(\"approval\"):\n            print(json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"approval/request\", \"params\": {}}), flush=True)\n            break\n        print(json.dumps({\"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": \"hello\"}}}), flush=True)\n        print(json.dumps({\"method\": \"turn/completed\", \"params\": dict(config[\"params\"], turnId=\"turn-1\")}), flush=True)\n        if config[\"params\"].get(\"stderr\"):\n            print(config[\"params\"][\"stderr\"], file=sys.stderr, flush=True)\n        if config[\"noise\"]:\n            for i in range(12):\n                print(\"noise-%02d-\" % i + \"z\" * 100, file=sys.stderr, flush=True)\n        break\n\"\"\",\n        encoding=\"utf-8\",\n    )\n    import shlex\n\n    wrapper = scenario.tmp / \"muse-cli.sh\"\n    wrapper.write_text(\n        f'#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} {shlex.quote(json.dumps(config))} \"$@\"\\n'\n    )\n    wrapper.chmod(0o755)\n    scenario.mod.MUSE_WRAPPER = str(wrapper)\n\n\nclass ServeTurnErrorExtractionTest(_BridgeScenario):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1376,1625p' tests/test_muse_bridge_killpg.py; sed -n '1626,1861p' tests/test_muse_bridge_killpg.py; rg --files -g '*evidence*' -g '*manifest*' -g '*verification*' '.ai-team/runs/muse-wonder-foreign-session-20261014'; command -v python3; command -v ruff; command -v basedpyright\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1376,1625p' tests/test_muse_bridge_killpg.py; sed -n '1626,1861p' tests/test_muse_bridge_killpg.py; rg --files -g '*evidence*' -g '*manifest*' -g '*verification*' '.ai-team/runs/muse-wonder-foreign-session-20261014'; command -v python3; command -v ruff; command -v basedpyright\"","aggregated_output":"class ContextEstimateTest(unittest.TestCase):\n    \"\"\"T-01..T-02: оценка токенов и вывод лимитов из ALLOWED_MODELS.\"\"\"\n\n    def test_t01_estimate_tokens_latin_cyrillic_code_json_empty(self) -> None:\n        mod = load_bridge()\n        self.assertEqual(mod._estimate_tokens(\"\"), 0)\n        latin = \"a\" * 900\n        self.assertEqual(mod._estimate_tokens(latin), 300)\n        cyrillic = \"я\" * 1000\n        self.assertEqual(mod._estimate_tokens(cyrillic), 666)\n        code_sample = \"def foo(x: int) -> int:\\n    return x * 42\\n\" * 30\n        json_sample = json.dumps(\n            {\"ключ\": \"значение\", \"nums\": list(range(50))}, ensure_ascii=False\n        )\n        for sample in (latin, cyrillic, code_sample, json_sample, \"🌟\" * 90):\n            expected = max(len(sample) // 3, len(sample.encode(\"utf-8\")) // 3)\n            self.assertEqual(mod._estimate_tokens(sample), expected)\n\n    def test_t02_context_limit_and_derived_targets(self) -> None:\n        mod = load_bridge()\n        self.assertEqual(mod._context_limit(\"muse-wonder-1.0\"), 400_000)\n        self.assertEqual(mod._context_limit(\"muse-wonder-full-1.0\"), 400_000)\n        self.assertEqual(mod._context_limit(\"muse-spark-1.3\"), 1048576)\n        self.assertEqual(mod._context_limit(\"unknown-model-id\"), 400_000)\n        self.assertEqual(mod._context_target(400_000), 320_000)\n        self.assertEqual(mod._context_retry_target(400_000), 200_000)\n        with mock.patch.dict(\n            mod.ALLOWED_MODELS,\n            {\"muse-wonder-1.0\": {\"context_length\": 250_000, \"max_output\": 131072}},\n        ):\n            lim = mod._context_limit(\"muse-wonder-1.0\")\n            self.assertEqual(lim, 250_000)\n            self.assertEqual(mod._context_target(lim), 200_000)\n            self.assertEqual(mod._context_retry_target(lim), 125_000)\n\n\nclass ContextPruneTest(unittest.TestCase):\n    \"\"\"T-03..T-11, T-13..T-14: защитный прунинг истории диалога.\"\"\"\n\n    mod: Any = None\n\n    def setUp(self) -> None:\n        self.mod = load_bridge()\n\n    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n        # \"User: \" — 6 байт. Для оценки ровно N токенов при 1 реплике и другой реплике:\n        # соберём историю из 3 сообщений и подгоним байты под точный порог limit=1000.\n        limit = 1000\n        target = 800\n        m1 = {\"role\": \"user\", \"content\": \"first-user\"}\n        m3 = {\"role\": \"user\", \"content\": \"last-user\"}\n        base_prompt = self.mod._assemble_prompt(\n            [m1, {\"role\": \"assistant\", \"content\": \"\"}, m3]\n        )[2]\n        # Проверим на точной длине промпта:\n        # \"User: first-user\\n\\nAssistant: <X>\\n\\nUser: last-user\"\n        prefix_overhead = len(\n            \"User: first-user\\n\\nAssistant: \\n\\nUser: last-user\".encode(\"utf-8\")\n        )\n        for desired_est, should_prune in (\n            (limit - 1, False),\n            (limit, False),\n            (limit + 1, True),\n        ):\n            needed_bytes = desired_est * 3 - prefix_overhead\n            m2 = {\"role\": \"assistant\", \"content\": \"x\" * needed_bytes}\n            msgs = [m1, m2, m3]\n            res = self.mod._prune_messages(msgs, limit=limit, target=target)\n            self.assertEqual(res.est_before, desired_est)\n            if not should_prune:\n                self.assertEqual(res.status, \"pass_through\")\n                self.assertIs(res.messages, msgs)\n                self.assertNotIn(self.mod.COMPACTION_MARKER, res.prompt)\n            else:\n                self.assertEqual(res.status, \"pruned\")\n                self.assertLessEqual(res.est_after, target)\n                self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n                self.assertEqual(res.msgs_dropped, 1)\n        _ = base_prompt\n\n    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n        self,\n    ) -> None:\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": f\"tool_{i}\",\n                    \"description\": \"Описание инструмента \" * 40,\n                    \"parameters\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"arg\": {\"type\": \"string\", \"description\": \"d\" * 200}\n                        },\n                    },\n                },\n            }\n            for i in range(25)\n        ]\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"System instructions \" * 500},\n            {\"role\": \"user\", \"content\": \"Initial task description \" * 200},\n        ]\n        # Добавим 30 реплик по ~45k байт (~15k токенов каждая) -> ~450k токенов (> 400k).\n        for i in range(30):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append({\"role\": role, \"content\": f\"turn-{i} \" + (\"payload \" * 5600)})\n        msgs.append({\"role\": \"user\", \"content\": \"Final user question\"})\n\n        res = self.mod._prune_messages(\n            msgs, limit=400_000, target=320_000, tools=tools, tool_choice=\"auto\"\n        )\n        self.assertEqual(res.status, \"pruned\")\n        self.assertGreater(res.est_before, 400_000)\n        actual_est = self.mod._estimate_tokens(res.prompt)\n        self.assertEqual(res.est_after, actual_est)\n        self.assertLessEqual(actual_est, 320_000)\n        self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n        self.assertIn(\"# Tool calling protocol\", res.prompt)\n\n    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys-early\"},\n            {\"role\": \"user\", \"content\": \"user-first\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"developer\", \"content\": \"dev-mid-insertion\"},\n            {\"role\": \"user\", \"content\": \"U\" * 3000},\n            {\"role\": \"assistant\", \"content\": \"B\" * 3000},\n            {\"role\": \"system\", \"content\": \"sys-late-insertion\"},\n            {\"role\": \"user\", \"content\": \"user-last\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=1500, target=1000)\n        self.assertEqual(res.status, \"pruned\")\n        for needle in (\n            \"sys-early\",\n            \"dev-mid-insertion\",\n            \"sys-late-insertion\",\n            \"user-first\",\n            \"user-last\",\n        ):\n            self.assertIn(needle, res.prompt)\n        # Если в истории только один user — он не дублируется.\n        single_user_msgs = [\n            {\"role\": \"system\", \"content\": \"sys-1\"},\n            {\"role\": \"user\", \"content\": \"only-one-user\"},\n            {\"role\": \"assistant\", \"content\": \"X\" * 6000},\n        ]\n        res_single = self.mod._prune_messages(single_user_msgs, limit=1000, target=500)\n        self.assertEqual(res_single.status, \"pruned\")\n        self.assertEqual(res_single.prompt.count(\"only-one-user\"), 1)\n\n    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"user\", \"content\": \"first-user\"},\n            {\"role\": \"assistant\", \"content\": \"early-assistant-\" + (\"x\" * 300)},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_a1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f1\", \"arguments\": \"{}\"},\n                    },\n                    {\n                        \"id\": \"call_a2\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f2\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a1\",\n                \"name\": \"f1\",\n                \"content\": \"res_a1_\" + (\"y\" * 300),\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a2\",\n                \"name\": \"f2\",\n                \"content\": \"res_a2_\" + (\"z\" * 300),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"thinking\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_b1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f3\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_b1\",\n                \"name\": \"f3\",\n                \"content\": \"res_b1_\" + (\"w\" * 300),\n            },\n            {\"role\": \"user\", \"content\": \"last-user\"},\n        ]\n        full_est = self.mod._estimate_tokens(self.mod._assemble_prompt(msgs)[2])\n        for target in range(80, full_est + 20, 15):\n            res = self.mod._prune_messages(msgs, limit=full_est - 1, target=target)\n            self.assertNotEqual(res.status, \"refused\")\n            kept_call_ids: set[str] = set()\n            expected_tool_ids: dict[str, set[str]] = {}\n            actual_tool_ids: set[str] = set()\n            for m in res.messages:\n                if m.get(\"role\") == \"assistant\" and m.get(\"tool_calls\"):\n                    cids = {tc[\"id\"] for tc in m[\"tool_calls\"]}\n                    kept_call_ids |= cids\n                    expected_tool_ids[m[\"tool_calls\"][0][\"id\"]] = cids\n                elif m.get(\"role\") == \"tool\":\n                    actual_tool_ids.add(m[\"tool_call_id\"])\n            # Инвариант I-1: нет tool без вызова и нет частичного сохранения многовызовного хода.\n            self.assertEqual(\n                actual_tool_ids,\n                kept_call_ids,\n                f\"нарушена атомарность при target={target}\",\n            )\n            for group_ids in expected_tool_ids.values():\n                self.assertTrue(group_ids.issubset(actual_tool_ids))\n\n    def test_t07_orphan_tool_dropped_on_prune_kept_on_passthrough(self) -> None:\n        orphan = {\n            \"role\": \"tool\",\n            \"tool_call_id\": \"orphan_id_999\",\n            \"name\": \"ghost\",\n            \"content\": \"orphan-body\",\n        }\n        msgs = [\n            {\"role\": \"user\", \"content\": \"u1\"},\n            orphan,\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        passthru = self.mod._prune_messages(msgs, limit=5000, target=4000)\n        self.assertEqual(passthru.status, \"pass_through\")\n        self.assertIn(orphan, passthru.messages)\n        self.assertIn(\"orphan-body\", passthru.prompt)\n\n        pruned = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(pruned.status, \"pruned\")\n        self.assertNotIn(orphan, pruned.messages)\n        self.assertNotIn(\"orphan-body\", pruned.prompt)\n\n    def test_t08_cyrillic_triggers_prune_when_bytes_exceed_limit(self) -> None:\n        # 900 кириллических символов = 300 chars//3, но 1800 байт = 600 bytes//3.\n        # При limit=450 chars//3 < limit < bytes//3 -> прунинг обязан сработать.\n        msgs = [\n            {\"role\": \"user\", \"content\": \"первый\"},\n            {\"role\": \"assistant\", \"content\": \"ж\" * 900},\n            {\"role\": \"user\", \"content\": \"последний\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=450, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertLessEqual(res.est_after, 300)\n        self.assertNotIn(\"ж\" * 100, res.prompt)\n\n    def test_t09_multipart_none_empty_non_dict_unknown_role(self) -> None:\n        msgs: list[Any] = [\n            \"not-a-dict\",\n            123,\n            {\"role\": \"user\", \"content\": None},\n            {\"role\": \"user\", \"content\": \"   \"},\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": \"real-first-user\"},\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\"url\": \"http://example.com/a.png\"},\n                    },\n                ],\n            },\n            {\"role\": \"custom_unknown_role\", \"content\": \"middle-\" + (\"M\" * 3000)},\n            {\"role\": \"user\", \"content\": \"real-last-user\"},\n            {\"role\": \"user\", \"content\": \"\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertIn(\"real-first-user\", res.prompt)\n        self.assertIn(\"[image omitted]\", res.prompt)\n        self.assertIn(\"real-last-user\", res.prompt)\n        self.assertNotIn(\"middle-M\", res.prompt)\n\n    def test_t10_marker_placement_chronology_determinism_and_idempotency(self) -> None:\n        # Сценарий с двумя разрывами:\n        # U0(first_user), U1(dropped), U2(last_user), U3(dropped tool group), U4(kept trailing tool group)\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-top\"},\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"drop-1-\" + (\"A\" * 1500)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_drop\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_drop\",\n                \"name\": \"f\",\n                \"content\": \"drop-2-\" + (\"B\" * 1500),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_keep\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_keep\",\n                \"name\": \"f\",\n                \"content\": \"keep-trail\",\n            },\n        ]\n        res1 = self.mod._prune_messages(msgs, limit=600, target=400)\n        res2 = self.mod._prune_messages(msgs, limit=600, target=400)\n        self.assertEqual(res1.status, \"pruned\")\n        self.assertEqual(res1.prompt, res2.prompt)\n        self.assertEqual(res1.messages, res2.messages)\n        # Ровно два маркера в двух разрывах.\n        self.assertEqual(res1.prompt.count(self.mod.COMPACTION_MARKER), 2)\n        p_first = res1.prompt.index(\"User: first-u\")\n        p_m1 = res1.prompt.index(self.mod.COMPACTION_MARKER)\n        p_last = res1.prompt.index(\"User: last-u\")\n        p_m2 = res1.prompt.rindex(self.mod.COMPACTION_MARKER)\n        p_trail = res1.prompt.index(\"keep-trail\")\n        self.assertTrue(p_first < p_m1 < p_last < p_m2 < p_trail)\n\n        # Идемпотентность: повторный вызов с теми же параметрами и с принудительным порогом.\n        idem1 = self.mod._prune_messages(res1.messages, limit=600, target=400)\n        self.assertEqual(idem1.prompt, res1.prompt)\n        self.assertEqual(idem1.messages, res1.messages)\n        idem2 = self.mod._prune_messages(\n            res1.messages, limit=res1.est_after - 1, target=res1.est_after\n        )\n        self.assertEqual(idem2.prompt, res1.prompt)\n        self.assertEqual(idem2.messages, res1.messages)\n\n    def test_t11_input_not_mutated_and_wlock_not_held_during_prune(self) -> None:\n        import copy\n\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys\"},\n            {\"role\": \"user\", \"content\": \"u1\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        snapshot = copy.deepcopy(msgs)\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertEqual(msgs, snapshot)\n        for m in res.messages:\n            if m.get(\"role\") != self.mod._COMPACTION_MARKER_ROLE:\n                self.assertTrue(any(m is orig for orig in msgs))\n\n        # Проверка в Handler._serve_json: во время _prune_messages замок self._wlock не захвачен.\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler.connection = None\n        handler._wlock = threading.Lock()\n        handler._client_gone = False\n        handler._current_run = None\n        handler._sse_open = False\n        handler._content_started = False\n        lock_states: list[bool] = []\n        orig_prune = self.mod._prune_messages\n\n        def spy_prune(*args: Any, **kwargs: Any) -> Any:\n            lock_states.append(handler._wlock.locked())\n            return orig_prune(*args, **kwargs)\n\n        with (\n            mock.patch.object(self.mod, \"_prune_messages\", side_effect=spy_prune),\n            mock.patch.object(\n                self.mod.ServeRun,\n                \"execute\",\n                return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n            ),\n            mock.patch.object(handler, \"_send\"),\n        ):\n            handler._serve_json({\"model\": \"muse-wonder-1.0\", \"messages\": msgs})\n        self.assertEqual(lock_states, [False])\n\n    def test_t13_trailing_incomplete_tool_unit_kept_or_refused_if_exceeds_cap(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"mid-\" + (\"M\" * 2000)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_tail\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"bash\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_tail\",\n                \"name\": \"bash\",\n                \"content\": \"tool-output-\" + (\"T\" * 600),\n            },\n        ]\n        # Обязательный набор (first-u + last-u + trailing tool unit + маркер) ~ 260 токенов.\n        # Пусть limit=500, target=200: обязательный набор > target (200), но <= cap (500) -> сохраняется!\n        res_ok = self.mod._prune_messages(msgs, limit=500, target=200)\n        self.assertEqual(res_ok.status, \"pruned\")\n        self.assertIn(\"tool-output-\", res_ok.prompt)\n        self.assertNotIn(\"mid-M\", res_ok.prompt)\n        self.assertLessEqual(res_ok.est_after, 500)\n\n        # Если же обязательный набор с незавершённой единицей > cap (limit=200) -> отказ.\n        res_refused = self.mod._prune_messages(msgs, limit=200, target=160)\n        self.assertEqual(res_refused.status, \"refused\")\n\n    def test_t14_hysteresis_prefix_stability_and_399999_passthrough(self) -> None:\n        # 399_999 не прунится при limit=400_000.\n        prefix_len = len(\"User: \".encode(\"utf-8\"))\n        exact_bytes = 399_999 * 3 - prefix_len\n        msg_399k = [{\"role\": \"user\", \"content\": \"a\" * exact_bytes}]\n        res_399k = self.mod._prune_messages(msg_399k, limit=400_000, target=320_000)\n        self.assertEqual(res_399k.est_before, 399_999)\n        self.assertEqual(res_399k.status, \"pass_through\")\n\n        # Два хода подряд с ростом > 400k: префикс (system, tools, первый user, маркер) побайтно одинаков.\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\"name\": \"t1\", \"description\": \"d\", \"parameters\": {}},\n            }\n        ]\n        base_msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"stable-system-prompt\"},\n            {\"role\": \"user\", \"content\": \"stable-first-user\"},\n        ]\n        for i in range(15):\n            base_msgs.append(\n                {\n                    \"role\": \"assistant\" if i % 2 == 0 else \"user\",\n                    \"content\": f\"m{i}-\" + (\"X\" * 90_000),\n                }\n            )\n        turn1 = base_msgs + [{\"role\": \"user\", \"content\": \"question-1\"}]\n        turn2 = turn1 + [\n            {\"role\": \"assistant\", \"content\": \"answer-1-\" + (\"Y\" * 30_000)},\n            {\"role\": \"user\", \"content\": \"question-2\"},\n        ]\n        r1 = self.mod._prune_messages(turn1, limit=400_000, target=320_000, tools=tools)\n        r2 = self.mod._prune_messages(turn2, limit=400_000, target=320_000, tools=tools)\n        self.assertEqual(r1.status, \"pruned\")\n        self.assertEqual(r2.status, \"pruned\")\n        marker_end_1 = r1.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        marker_end_2 = r2.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        self.assertEqual(\n            r1.prompt[:marker_end_1].encode(\"utf-8\"),\n            r2.prompt[:marker_end_2].encode(\"utf-8\"),\n        )\n\n\n.ai-team/runs/muse-wonder-foreign-session-20261014/route-manifest.json\n.ai-team/runs/muse-wonder-foreign-session-20261014/panel/arch/r2/manifest.json\n.ai-team/runs/muse-wonder-foreign-session-20261014/panel/arch/r1/manifest.json\n.ai-team/runs/muse-wonder-foreign-session-20261014/panel/council/r1/manifest.json\n/Users/aazhiry1/.local/bin/python3\n","exit_code":1,"status":"failed"}}
