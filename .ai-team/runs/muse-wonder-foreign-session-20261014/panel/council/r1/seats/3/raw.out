{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport importlib.util, json, tempfile, threading, unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\ns=importlib.util.spec_from_file_location('judge_harness','tests/test_muse_bridge_killpg.py');t=importlib.util.module_from_spec(s);s.loader.exec_module(t)\nfor case in ('marker_clipped','body_after_key_redaction','fallback_body'):\n    with tempfile.TemporaryDirectory(prefix='muse-judge-') as root:\n        m=t.load_bridge();m.WORKSPACE=Path(root)/'workspace';m.LOG_PATH=Path(root)/'bridge.log';m._slots=threading.Semaphore(1)\n        logs=[];m._log=logs.append\n        body='BODY_PRIVATE_CANARY api_key=[REDACTED_SECRET]'\n        if case=='marker_clipped':\n            params={'terminal':'failed','error':{'kind':'modelError','message':'x'*180+m.HARD_THRESHOLD_ERR_SUBSTR}}\n            msgs=[{'role':'user','content':'first'}]+[{'role':'assistant','content':str(i)+'x'*110000} for i in range(12)]+[{'role':'user','content':'last'}]\n        else:\n            params={'terminal':'failed','error':{'kind':'quota','message':body}}\n            msgs=[{'role':'user','content':body}]\n        t.install_protocol_wrapper(SimpleNamespace(tmp=Path(root),mod=m),params)\n        h=m.Handler.__new__(m.Handler);h.connection=None;h._wlock=threading.Lock();h._client_gone=False;h._current_run=None;h._sse_open=False;h._content_started=False\n        h._client_gone_probe=lambda: False\n        responses=[];h._send=lambda status,payload:responses.append((status,payload))\n        if case=='fallback_body':\n            from unittest import mock\n            def unavailable(run):raise m.ServeUnavailable('RPC rejected input '+run.prompt)\n            with mock.patch.object(m.ServeRun,'execute',unavailable):h._serve_json({'model':'muse-wonder-1.0','messages':msgs})\n        else:h._serve_json({'model':'muse-wonder-1.0','messages':msgs})\n        rpcfile=Path(root)/'rpc.jsonl';rpc=[json.loads(x) for x in rpcfile.read_text().splitlines()] if rpcfile.exists() else []\n        turns=sum(x.get('method')=='turn/start' for x in rpc)\n        print(case,json.dumps({'status':responses[-1][0], 'serve_turns':turns,'body_in_error': 'BODY_PRIVATE_CANARY' in json.dumps(responses),'body_in_log':any('BODY_PRIVATE_CANARY' in x for x in logs),'retry_started':any('reason=hard_threshold_retry' in x for x in logs)}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
