{"type":"tool_result","id":"tc-ypzh2bsfnpe","messageId":"63cf3b1b-c459-4e7b-8b4c-139a2f9c3e80","toolId":"Read","isError":false,"value":"+        diagnostic = _redact_secrets(str(out.get(\"err\") or \"\"))\n+        control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n+        for ref_prompt in reflected_prompts:\n+            if len(ref_prompt.strip()) >= 8:\n+                diagnostic = diagnostic.replace(ref_prompt, \"[REDACTED]\")\n+            for part in _prompt_reflected_parts(ref_prompt):\n+                diagnostic = diagnostic.replace(part, \"[REDACTED]\")\n+                norm_part = re.sub(control_chars, \" \", part).strip()\n+                if len(norm_part) >= 8:\n+                    diagnostic = diagnostic.replace(norm_part, \"[REDACTED]\")\n+                if len(norm_part) >= 160:\n+                    diagnostic = diagnostic.replace(norm_part[:160], \"[REDACTED]\")\n+        for message in raw_messages:\n+            if isinstance(message, dict):\n+                reflected = _flatten_content(message.get(\"content\")).strip()\n+                if len(reflected) >= 8:\n+                    diagnostic = diagnostic.replace(reflected, \"[REDACTED]\")\n+                    normalized = re.sub(control_chars, \" \", reflected)\n+                    diagnostic = diagnostic.replace(normalized, \"[REDACTED]\")\n+                    if len(normalized) >= 160:\n+                        diagnostic = diagnostic.replace(normalized[:160], \"[REDACTED]\")\n+        if terminal_context_err is not None:\n+            diagnostic = _redact_secrets(terminal_context_err)\n+        out[\"err\"] = _redact_secrets(diagnostic)\n         if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n+            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n             self._send(\n                 502,\n                 {\n                     \"error\": {\n-                        \"message\": out.get(\"err\") or out[\"state\"],\n+                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n+                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                         \"type\": \"proxy_error\",\n                         \"code\": 502,\n                     }\n@@ -1703,12 +2434,19 @@ class Handler(BaseHTTPRequestHandler):\n             # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n             # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n             hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n+            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n+            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n+            err_message = (\n+                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n+            )\n+            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n+                err_message = f\"{err_message}: {detail}\"\n             self._send(\n                 502,\n                 {\n                     \"error\": {\n-                        \"message\": f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\",\n-                        \"detail\": str(out.get(\"err\"))[:500],\n+                        \"message\": _redact_secrets(err_message),\n+                        \"detail\": detail,\n                         \"type\": \"proxy_error\",\n                         \"code\": 502,\n                     }\n@@ -1721,12 +2459,24 @@ class Handler(BaseHTTPRequestHandler):\n             content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n         if not content and not tool_calls:\n             hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n+            _log(\n+                _format_err_log(\n+                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n+                )\n+            )\n+            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n+            err_message = (\n+                f\"muse exec produced no text (rc={out.get('rc')}, \"\n+                f\"state={out.get('state')}){hint}\"\n+            )\n+            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n+                err_message = f\"{err_message}: {detail}\"\n             self._send(\n                 502,\n                 {\n                     \"error\": {\n-                        \"message\": f\"muse exec produced no text (rc={out.get('rc')}, state={out.get('state')}){hint}\",\n-                        \"detail\": str(out.get(\"err\"))[:500],\n+                        \"message\": _redact_secrets(err_message),\n+                        \"detail\": detail,\n                         \"type\": \"proxy_error\",\n                         \"code\": 502,\n                     }\ndiff --git a/tests/test_muse_bridge_killpg.py b/tests/test_muse_bridge_killpg.py\nindex 9662841..0c3a9c6 100644\n--- a/tests/test_muse_bridge_killpg.py\n+++ b/tests/test_muse_bridge_killpg.py\n@@ -13,9 +13,12 @@ bridges/muse-bridge/server.py без живого muse-bin: вместо CLI —\n from __future__ import annotations\n \n import importlib.util\n+import http.client\n+import io\n import itertools\n import json\n import os\n+import re\n import shutil\n import signal\n import socket\n@@ -30,9 +33,14 @@ from types import SimpleNamespace\n from typing import Any, Callable\n from unittest import mock\n \n-BRIDGE_PY = (\n+_REPO_BRIDGE_PY = (\n     Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n )\n+BRIDGE_PY = (\n+    _REPO_BRIDGE_PY\n+    if _REPO_BRIDGE_PY.exists()\n+    else Path(__file__).resolve().parents[1] / \"server.py\"\n+)\n \n _LOAD_SEQ = itertools.count()\n DISCONNECT_AFTER_S = 1.0\n@@ -637,5 +645,1722 @@ class WaitGroupExitTest(unittest.TestCase):\n         self.assertGreater(count, 1)\n \n \n+def bridge_request(\n+    scenario: Any, payload: dict | None = None, path: str = \"/v1/chat/completions\"\n+) -> tuple[int, bytes]:\n+    \"\"\"Прочитать полный ответ локального стенда, включая терминальный SSE-кадр.\"\"\"\n+    conn = http.client.HTTPConnection(*scenario.server.server_address[:2], timeout=5)\n+    try:\n+        conn.request(\n+            \"POST\" if payload is not None else \"GET\",\n+            path,\n+            json.dumps(payload) if payload is not None else None,\n+            {\"Content-Type\": \"application/json\", \"Connection\": \"close\"},\n+        )\n+        response = conn.getresponse()\n+        return response.status, response.read()\n+    finally:\n+        conn.close()\n+\n+\n+def turn_request(stream: bool = False) -> dict:\n+    \"\"\"Минимальный клиентский запрос без живого провайдера.\"\"\"\n+    return {\n+        \"model\": \"muse-spark-1.3\",\n+        \"messages\": [{\"role\": \"user\", \"content\": \"prompt-canary-private\"}],\n+        \"stream\": stream,\n+    }\n+\n+\n+class ErrorLoggingTest(_BridgeScenario):\n+    \"\"\"AD-001/F-001: все выходы журналируются и не раскрывают отражённые секреты.\"\"\"\n+\n+    def _error_response(\n+        self, state: str, err: Any, stream: bool = False, rc: int = 1\n+    ) -> tuple[dict, str]:\n+        out = {\"rc\": rc, \"state\": state, \"text\": \"\", \"err\": err}\n+        with mock.patch.object(self.mod.ServeRun, \"execute\", return_value=out):\n+            status, body = bridge_request(self, turn_request(stream))\n+        self.assertEqual(status, 200 if stream else 502)\n+        if stream:\n+            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n+            frames = [\n+                json.loads(line[6:])\n+                for line in body.decode().splitlines()\n+                if line.startswith(\"data: {\")\n+            ]\n+            error = next(frame[\"error\"] for frame in frames if \"error\" in frame)\n+        else:\n+            error = json.loads(body)[\"error\"]\n+        logs = self.mod.LOG_PATH.read_text()\n+        lines = [line for line in logs.splitlines() if \" error model=\" in line]\n+        self.assertTrue(lines, \"нет итогового error-лога\")\n+        return error, lines[-1]\n+\n+    def test_all_error_branches_log_once_and_success_stays_done(self) -> None:\n+        for stream in (False, True):\n+            for state in (\"launcher_missing\", \"spawn_failed\", \"terminal_failed\", \"ok\"):\n+                with self.subTest(stream=stream, state=state):\n+                    self.mod.LOG_PATH.unlink(missing_ok=True)\n+                    error, line = self._error_response(\n+                        state, \"line1\\nline2\", stream, 0 if state == \"ok\" else 1\n+                    )\n+                    self.assertIn(\n+                        \"state=\" + (\"empty_output\" if state == \"ok\" else state), line\n+                    )\n+                    self.assertIn(\"via=serve\", line)\n+                    self.assertIn(f\"stream={stream}\", line)\n+                    self.assertIn(\"line1\\\\nline2\", line)\n+                    self.assertEqual(error[\"detail\"], \"line1\\nline2\")\n+                    self.assertEqual(\n+                        sum(\n+                            \" error model=\" in x\n+                            for x in self.mod.LOG_PATH.read_text().splitlines()\n+                        ),\n+                        1,\n+                    )\n+        with mock.patch.object(\n+            self.mod.ServeRun,\n+            \"execute\",\n+            return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n+        ):\n+            self.mod.LOG_PATH.unlink()\n+            self.assertEqual(bridge_request(self, turn_request())[0], 200)\n+        self.assertEqual(\n+            sum(\n+                \" done model=\" in x for x in self.mod.LOG_PATH.read_text().splitlines()\n+            ),\n+            1,\n+        )\n+        self.assertNotIn(\" error model=\", self.mod.LOG_PATH.read_text())\n+\n+    def test_secret_canaries_masked_in_log_json_and_sse(self) -> None:\n+        samples = [\n+            \"Bearer secret-canary-token-123\",\n+            \"Authorization: super-private-value\",\n+            \"api_key=canary_secret_val\",\n+            '{\"token\":\"canary_secret_val\"}',\n+            \"{'password': 'canary_secret_val'}\",\n+            'password=\"alpha beta gamma\"',\n+            \"TOKEN: canary_secret_val\",\n+            \"bridge-key=canary_secret_val\",\n+            \"secret=canary_secret_val\",\n+            \"sk-abcdefghijklmnop1234\",\n+            \"bare-bridge-canary\",\n+        ]\n+        # Подмена только локальной конфигурации модуля, окружение не меняется.\n+        self.mod.AUTH_KEY = \"bare-bridge-canary\"\n+        for stream in (False, True):\n+            for sample in samples:\n+                for prefix in (\"\", \"x\" * 285 + \" \", \"x\" * 485 + \" \"):\n+                    with self.subTest(stream=stream, sample=sample, prefix=len(prefix)):\n+                        # Аутентификация запроса не нужна: модульный mock не меняет тестируемую редакцию.\n+                        with mock.patch.object(self.mod, \"_auth_ok\", return_value=True):\n+                            error, line = self._error_response(\n+                                \"terminal_failed\", prefix + sample, stream\n+                            )\n+                        combined = json.dumps(error) + line\n+                        for secret in (\n+                            \"secret-canary-token-123\",\n+                            \"super-private-value\",\n+                            \"canary_secret_val\",\n+                            \"alpha beta gamma\",\n+                            \"abcdefghijklmnop1234\",\n+                            \"bare-bridge-canary\",\n+                        ):\n+                            self.assertNotIn(secret, combined)\n+                        if not prefix:\n+                            self.assertIn(\"[REDACTED]\", error[\"detail\"])\n+                            self.assertIn(\"[REDACTED]\", line)\n+                        self.assertLessEqual(len(error[\"detail\"]), 500)\n+                        self.assertNotIn(\"prompt-canary-private\", combined)\n+\n+    def test_none_diagnostic_is_empty(self) -> None:\n+        for state in (\"spawn_failed\", \"terminal_failed\", \"ok\"):\n+            error, _ = self._error_response(state, None, rc=0 if state == \"ok\" else 1)\n+            self.assertEqual(error[\"detail\"], \"\")\n+\n+    def test_serve_json_returns_sanitized_detail_on_error(self) -> None:\n+        secret = \"sk-secret-token-1234567890abcdef\"\n+        error, _ = self._error_response(\n+            \"terminal_failed\", f\"auth_failed: not logged in {secret}\"\n+        )\n+        self.assertIn(\n+            \"muse turn failed (rc=1, state=terminal_failed)\", error[\"message\"]\n+        )\n+        self.assertIn(\"auth_failed\", error[\"message\"])\n+        self.assertIn(\"[REDACTED]\", error[\"message\"])\n+        self.assertNotIn(secret, error[\"message\"])\n+        self.assertIn(\"auth_failed\", error[\"detail\"])\n+        self.assertIn(\"[REDACTED]\", error[\"detail\"])\n+        self.assertNotIn(secret, error[\"detail\"])\n+\n+        # SSE-ветка того же отказа: кадр ошибки несёт тот же санитизированный detail.\n+        sse_error, _ = self._error_response(\n+            \"terminal_failed\",\n+            \"sse upstream failed api_key=canary_sse_secret_val\",\n+            True,\n+        )\n+        self.assertTrue(\n+            sse_error[\"message\"].startswith(\n+                \"muse turn failed (rc=1, state=terminal_failed): \"\n+            )\n+        )\n+        self.assertIn(\"sse upstream failed\", sse_error[\"message\"])\n+        self.assertIn(\"[REDACTED]\", sse_error[\"message\"])\n+        self.assertNotIn(\"canary_sse_secret_val\", sse_error[\"message\"])\n+        self.assertEqual(\n+            sse_error[\"message\"],\n+            \"muse turn failed (rc=1, state=terminal_failed): \" + sse_error[\"detail\"],\n+        )\n+        self.assertIn(\"[REDACTED]\", sse_error[\"detail\"])\n+        self.assertNotIn(\"canary_sse_secret_val\", sse_error[\"detail\"])\n+\n+        # Ветка empty_output: успешный rc без текста — 502 с санитизированным detail.\n+        empty_error, _ = self._error_response(\n+            \"ok\",\n+            \"empty upstream failed api_key=canary_empty_secret_val\",\n+            rc=0,\n+        )\n+        self.assertTrue(\n+            empty_error[\"message\"].startswith(\n+                \"muse exec produced no text (rc=0, state=ok): \"\n+            )\n+        )\n+        self.assertIn(\"empty upstream failed\", empty_error[\"message\"])\n+        self.assertIn(\"[REDACTED]\", empty_error[\"message\"])\n+        self.assertNotIn(\"canary_empty_secret_val\", empty_error[\"message\"])\n+        self.assertEqual(\n+            empty_error[\"message\"],\n+            \"muse exec produced no text (rc=0, state=ok): \" + empty_error[\"detail\"],\n+        )\n+        self.assertIn(\"[REDACTED]\", empty_error[\"detail\"])\n+        self.assertNotIn(\"canary_empty_secret_val\", empty_error[\"detail\"])\n+\n+        # Длинная диагностика empty_output: detail в message и detail обрезан до 500.\n+        long_error, _ = self._error_response(\n+            \"ok\",\n+            \"api_key=canary_long_secret_val \" + \"L\" * 600,\n+            rc=0,\n+        )\n+        self.assertEqual(len(long_error[\"detail\"]), 500)\n+        self.assertTrue(\n+            long_error[\"message\"].startswith(\n+                \"muse exec produced no text (rc=0, state=ok): \"\n+            )\n+        )\n+        self.assertEqual(\n+            long_error[\"message\"],\n+            \"muse exec produced no text (rc=0, state=ok): \" + long_error[\"detail\"],\n+        )\n+        self.assertIn(\"[REDACTED]\", long_error[\"message\"])\n+        self.assertNotIn(\"canary_long_secret_val\", long_error[\"message\"])\n+        self.assertNotIn(\"canary_long_secret_val\", long_error[\"detail\"])\n+\n+    def test_generic_diagnostic_not_duplicated_in_message(self) -> None:\n+        error, _ = self._error_response(\"terminal_failed\", \"state=terminal_failed rc=1\")\n+        self.assertEqual(error[\"detail\"], \"state=terminal_failed rc=1\")\n+        self.assertEqual(\n+            error[\"message\"], \"muse turn failed (rc=1, state=terminal_failed)\"\n+        )\n+\n+    def test_default_model_is_wonder_full(self) -> None:\n+        with mock.patch.dict(os.environ):\n+            os.environ.pop(\"MUSE_BRIDGE_MODEL\", None)\n+            fresh = load_bridge()\n+        self.assertEqual(fresh.DEFAULT_MODEL, \"muse-wonder-full-1.0\")\n+\n+    def test_r2_escaped_quotes_mask_entire_secret_in_all_sinks(self) -> None:\n+        samples = (\n+            (\n+                r'{\"password\": \"alpha \\\" suffix-canary-27182\"}',\n+                '{\"password\": [REDACTED]}',\n+            ),\n+            (r'{\"token\":\"alpha\\\" beta gamma\"}', '{\"token\":[REDACTED]}'),\n+        )\n+        for stream in (False, True):\n+            for sample, expected in samples:\n+                with self.subTest(stream=stream, sample=sample):\n+                    error, _ = self._error_response(\"terminal_failed\", sample, stream)\n+                    self.assertEqual(error[\"detail\"], expected)\n+                    logs = self.mod.LOG_PATH.read_text()\n+                    self.assertNotIn(\"suffix-canary-27182\", logs)\n+                    self.assertNotIn(\"beta gamma\", logs)\n+\n+    def _protocol_error_detail(self, content: str, message: str, stream: bool) -> str:\n+        \"\"\"Проверить все выходы ошибки реального протокольного стенда.\"\"\"\n+        install_protocol_wrapper(\n+            self, {\"terminal\": \"failed\", \"error\": {\"message\": message}}\n+        )\n+        payload = turn_request(stream)\n+        payload[\"messages\"][0][\"content\"] = content\n+        status, body = bridge_request(self, payload)\n+        self.assertEqual(status, 200 if stream else 502)\n+        if stream:\n+            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n+            frames = [\n+                json.loads(line[6:])\n+                for line in body.decode().splitlines()\n+                if line.startswith(\"data: {\")\n+            ]\n+            return next(\n+                frame[\"error\"][\"detail\"] for frame in frames if \"error\" in frame\n+            )\n+        return json.loads(body)[\"error\"][\"detail\"]\n+\n+    def test_r2_long_reflected_message_redacted_before_clipping(self) -> None:\n+        content = \"private-owner-content-\" + \"Q\" * 220\n+        for stream in (False, True):\n+            with self.subTest(stream=stream):\n+                detail = self._protocol_error_detail(content, content, stream)\n+                self.assertEqual(detail, \"[REDACTED]\")\n+                combined = detail + self.mod.LOG_PATH.read_text()\n+                self.assertNotIn(\"private-owner-content-\", combined)\n+                self.assertNotIn(\"Q\" * 20, combined)\n+\n+    def test_r2_short_messages_preserve_error_words(self) -> None:\n+        expected = \"this turn failed upstream\"\n+        for stream in (False, True):\n+            for content in (\"hi\", \"e\"):\n+                with self.subTest(stream=stream, content=content):\n+                    detail = self._protocol_error_detail(content, expected, stream)\n+                    self.assertEqual(detail, expected)\n+                    self.assertIn(expected, self.mod.LOG_PATH.read_text())\n+\n+    def test_quota_secrets_do_not_reach_any_error_sink(self) -> None:\n+        samples = (\n+            \"api_key=canary_secret_val\",\n+            '{\"token\":\"canary_secret_val\"}',\n+            \"{'password': 'canary_secret_val'}\",\n+            'password=\"alpha beta gamma\"',\n+        )\n+        for stream in (False, True):\n+            for sample in samples:\n+                with self.subTest(stream=stream, sample=sample):\n+                    params = {\n+                        \"terminal\": \"failed\",\n+                        \"error\": {\n+                            \"kind\": \"quota\",\n+                            \"message\": sample,\n+                            \"quota\": {\n+                                \"token\": \"canary_secret_val\",\n+                                \"note\": sample,\n+                            },\n+                        },\n+                        \"stderr\": sample,\n+                    }\n+                    install_protocol_wrapper(self, params)\n+                    status, body = bridge_request(self, turn_request(stream))\n+                    self.assertEqual(status, 200 if stream else 502)\n+                    logs = self.mod.LOG_PATH.read_text()\n+                    for secret in (\"canary_secret_val\", \"alpha beta gamma\"):\n+                        self.assertNotIn(secret, body.decode() + logs)\n+                    self.assertIn(\"[REDACTED]\", body.decode())\n+                    self.assertIn(\"[REDACTED]\", logs)\n+        for key in (\n+            \"token\",\n+            \"secret\",\n+            \"password\",\n+            \"api_key\",\n+            \"bridge_key\",\n+            \"authorization\",\n+        ):\n+            quota = {\"outer\": [{key: \"alpha beta gamma\"}]}\n+            install_protocol_wrapper(\n+                self, {\"terminal\": \"failed\", \"error\": {\"quota\": quota}}\n+            )\n+            _, body = bridge_request(self, turn_request())\n+            self.assertIn(\"[REDACTED]\", body.decode())\n+            self.assertNotIn(\n+                \"alpha beta gamma\", body.decode() + self.mod.LOG_PATH.read_text()\n+            )\n+\n+\n+def install_protocol_wrapper(\n+    scenario: Any, params: dict, noise: bool = False, delay: float = 0\n+) -> None:\n+    \"\"\"Фейковый MSP с реальными pipes; фиксирует argv и входящие RPC.\"\"\"\n+    config = {\n+        \"params\": params,\n+        \"noise\": noise,\n+        \"delay\": delay,\n+        \"root\": str(scenario.tmp),\n+    }\n+    script = scenario.tmp / \"protocol.py\"\n+    script.write_text(\n+        \"\"\"import json, sys, time\n+from pathlib import Path\n+config = json.loads(sys.argv[1])\n+root = Path(config[\"root\"])\n+mode = sys.argv[2]\n+(root / (mode + \"-argv.json\")).write_text(json.dumps(sys.argv[2:]))\n+if mode == \"exec\":\n+    print(json.dumps({\"schema_version\": 1, \"payload_type\": \"run.terminal.completed\", \"payload\": {\"text\": \"fallback-ok\"}}), flush=True)\n+    sys.exit(0)\n+for line in sys.stdin:\n+    msg = json.loads(line)\n+    with (root / \"rpc.jsonl\").open(\"a\") as fh:\n+        fh.write(json.dumps(msg) + \"\\\\n\")\n+    if \"id\" not in msg:\n+        continue\n+    method = msg[\"method\"]\n+    result = {\"session\": {\"sessionId\": \"sess-1\"}} if method == \"session/start\" else {\"status\": \"accepted\", \"turnId\": \"turn-1\"} if method == \"turn/start\" else {}\n+    print(json.dumps({\"id\": msg[\"id\"], \"result\": result}), flush=True)\n+    if method == \"turn/start\":\n+        time.sleep(config[\"delay\"])\n+        if config[\"params\"].get(\"approval\"):\n+            print(json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"approval/request\", \"params\": {}}), flush=True)\n+            break\n+        print(json.dumps({\"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": \"hello\"}}}), flush=True)\n+        print(json.dumps({\"method\": \"turn/completed\", \"params\": dict(config[\"params\"], turnId=\"turn-1\")}), flush=True)\n+        if config[\"params\"].get(\"stderr\"):\n+            print(config[\"params\"][\"stderr\"], file=sys.stderr, flush=True)\n+        if config[\"noise\"]:\n+            for i in range(12):\n+                print(\"noise-%02d-\" % i + \"z\" * 100, file=sys.stderr, flush=True)\n+        break\n+\"\"\",\n+        encoding=\"utf-8\",\n+    )\n+    import shlex\n+\n+    wrapper = scenario.tmp / \"muse-cli.sh\"\n+    wrapper.write_text(\n+        f'#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} {shlex.quote(json.dumps(config))} \"$@\"\\n'\n+    )\n+    wrapper.chmod(0o755)\n+    scenario.mod.MUSE_WRAPPER = str(wrapper)\n+\n+\n+class ServeTurnErrorExtractionTest(_BridgeScenario):\n+    \"\"\"AD-002: приоритет, защитный разбор и точные лимиты терминальной причины.\"\"\"\n+\n+    def _execute(self, params: dict, noise: bool = False) -> dict:\n+        install_protocol_wrapper(self, params, noise)\n+        return self.mod.ServeRun(\n+            \"muse-spark-1.3\", \"p\", \"max\", self.tmp / \"workspace\"\n+        ).execute()\n+\n+    def test_r2_prompt_parts_redacted_before_and_after_normalization(self) -> None:\n+        content = \"private-owner-content-\" + \"Q\" * 220\n+        prompt = \"User: \" + content + \"\\n\\nAssistant: prior\\tprivate\\nSystem: hi\"\n+        parts = self.mod._prompt_reflected_parts(prompt)\n+        self.assertEqual(parts, sorted(parts, key=len, reverse=True))\n+        self.assertIn(content, parts)\n+        self.assertIn(\"prior\\tprivate\", parts)\n+        self.assertNotIn(\"hi\", parts)\n+        for reflected in (content, \"prior\\tprivate\", \"prior private\"):\n+            with self.subTest(reflected=reflected):\n+                diagnostic = self.mod._turn_diagnostics(\n+                    {\"error\": {\"message\": reflected}}, prompt\n+                )\n+                self.assertEqual(diagnostic, [\"[REDACTED]\"])\n+\n+    def test_typed_error_reason_and_stderr_priority(self) -> None:\n+        params = {\n+            \"terminal\": \"failed\",\n+            \"error\": {\n+                \"kind\": \"quota_exceeded\",\n+                \"message\": \"daily limit\",\n+                \"retryable\": False,\n+                \"quota\": {\"remaining\": 0},\n+            },\n+            \"reason\": \"try tomorrow\",\n+        }\n+        out = self._execute(params, True)\n+        expected = 'quota_exceeded: daily limit retryable=False quota={\"remaining\":0}\\nreason: try tomorrow'\n+        self.assertTrue(out[\"err\"].startswith(expected), out)\n+        self.assertEqual((out[\"rc\"], out[\"state\"]), (1, \"terminal_failed\"))\n+        self.assertLessEqual(len(out[\"err\"]), 500)\n+        for stream in (False, True):\n+            with mock.patch.object(self.mod.ServeRun, \"execute\", return_value=out):\n+                _, body = bridge_request(self, turn_request(stream))\n+            self.assertIn(\"quota_exceeded\", body.decode())\n+            self.assertIn(\"try tomorrow\", body.decode())\n+        self.assertIn(\"try tomorrow\", self.mod.LOG_PATH.read_text())\n+\n+    def test_reason_only_duplicate_and_malformed(self) -> None:\n+        for error, reason, expected in [\n+            (None, \"cancelled by caller\", \"reason: cancelled by caller\"),\n+            ({\"message\": \"same\"}, \"same\", \"same\"),\n+            (\"raw failure\", None, \"raw failure\"),\n+            ({\"kind\": 123, \"quota\": [1, 2]}, None, \"123\"),\n+            ([\"odd\"], 17, \"17\"),\n+        ]:\n+            with self.subTest(error=error):\n+                out = self._execute(\n+                    {\"terminal\": \"failed\", \"error\": error, \"reason\": reason}\n+                )\n+                self.assertEqual(out[\"state\"], \"terminal_failed\")\n+                self.assertIn(expected, out[\"err\"])\n+                if reason == \"same\":\n+                    self.assertEqual(out[\"err\"].count(\"same\"), 1)\n+\n+    def test_no_diagnostics_preserves_stderr_tail_and_success(self) -> None:\n+        tail = \"\\n\".join(\"noise-%02d-\" % i + \"z\" * 100 for i in range(6, 12))\n+        for terminal in (\"failed\", \"completed\"):\n+            out = self._execute({\"terminal\": terminal}, True)\n+            self.assertEqual(out[\"err\"], tail)\n+            self.assertEqual(\n+                out[\"state\"], \"ok\" if terminal == \"completed\" else \"terminal_failed\"\n+            )\n+\n+    def test_field_caps_budget_and_redaction_boundaries(self) -> None:\n+        for field, limit in ((\"kind\", 64), (\"message\", 160), (\"reason\", 160)):\n+            params: dict = {\"terminal\": \"failed\", \"error\": {}}\n+            (params if field == \"reason\" else params[\"error\"])[field] = \"X\" * (\n+                limit + 20\n+            )\n+            out = self._execute(params)\n+            self.assertIn(\"X\" * limit, out[\"err\"])\n+            self.assertNotIn(\"X\" * (limit + 1), out[\"err\"])\n+        out = self._execute(\n+            {\n+                \"terminal\": \"failed\",\n+                \"error\": {\n+                    \"kind\": \"K\" * 90,\n+                    \"message\": \"M\" * 200,\n+                    \"retryable\": True,\n+                    \"quota\": {\"data\": \"Q\" * 200},\n+                },\n+                \"reason\": \"R\" * 200,\n+            },\n+            True,\n+        )\n+        diagnostic = out[\"err\"].split(\"\\nnoise-\", 1)[0]\n+        self.assertEqual(len(diagnostic), 300)\n+        self.assertIn(\"K\" * 64, diagnostic)\n+        self.assertIn(\"R\" * 16, diagnostic)\n+        self.assertNotIn(\"quota=\", diagnostic)\n+        self.assertNotIn(\"\\r\", diagnostic)\n+        out = self._execute(\n+            {\n+                \"terminal\": \"failed\",\n+                \"error\": {\"message\": \"m\" * 155 + \" api_key=canary_secret_val\"},\n+            }\n+        )\n+        self.assertNotIn(\"canary\", out[\"err\"])\n+        self.assertNotIn(\"[REDAC\", out[\"err\"].replace(\"[REDACTED]\", \"\"))\n+\n+\n+class SseDataKeepaliveTest(_BridgeScenario):\n+    \"\"\"AD-003: S1/S2/S3 проверяют байты и события, без гонок очереди замка.\"\"\"\n+\n+    def _handler(self, writer: Any = None) -> Any:\n+        handler = self.mod.Handler.__new__(self.mod.Handler)\n+        handler._wlock = threading.Lock()\n+        handler.wfile = writer if writer is not None else io.BytesIO()\n+        handler._sse_open = True\n+        return handler\n+\n+    def test_defaults_and_s3_seal_suppresses_late_tick_and_duplicate_done(self) -> None:\n+        handler = self._handler()\n+        other = self._handler()\n+        self.assertEqual(handler._sse_phase, \"OPEN\")\n+        self.assertIsNone(handler._keepalive_stop)\n+        self.assertFalse(handler._client_gone)\n+        handler._keepalive_stop = threading.Event()\n+        self.assertIsNone(other._keepalive_stop)\n+        handler._sse_stop_keepalive()\n+        before = handler.wfile.getvalue()\n+        self.assertFalse(\n+            handler._sse_emit(handler._sse_chunk({\"content\": \"\"}), keepalive=True)\n+        )\n+        self.assertEqual(handler.wfile.getvalue(), before)\n+        handler._send_sse(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0)\n+        final = handler.wfile.getvalue()\n+        self.assertTrue(final.endswith(b\"data: [DONE]\\n\\n\"))\n+        self.assertEqual(handler._sse_phase, \"CLOSED\")\n+        self.assertFalse(\n+            handler._sse_emit(handler._sse_chunk({\"content\": \"\"}), keepalive=True)\n+        )\n+        self.assertFalse(handler._sse_write(\"data: [DONE]\\n\\n\"))\n+        self.assertFalse(handler._sse_emit({\"late\": True}))\n+        self.assertEqual(handler.wfile.getvalue(), final)\n+\n+    def test_s1_data_ticks_before_done_preserve_content_and_tools(self) -> None:\n+        install_protocol_wrapper(self, {\"terminal\": \"completed\"}, delay=0.2)\n+        self.mod.KEEPALIVE_S = 0.05\n+        _, body = bridge_request(self, turn_request(True))\n+        self.assertNotIn(b\": keepalive\", body)\n+        self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n+        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n+        frames = [\n+            json.loads(line[6:])\n+            for line in body.decode().splitlines()\n+            if line.startswith(\"data: {\")\n+        ]\n+        deltas = [frame[\"choices\"][0][\"delta\"] for frame in frames]\n+        self.assertTrue(any(delta == {\"content\": \"\"} for delta in deltas))\n+        self.assertTrue(\n+            all(frame[\"object\"] == \"chat.completion.chunk\" for frame in frames)\n+        )\n+        self.assertEqual(\"\".join(d.get(\"content\", \"\") for d in deltas), \"hello\")\n+        tool_text = '<tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"a\"}}</tool_call>'\n+        content, tools = self.mod._split_tool_calls([\"\", tool_text, \"\"])\n+        self.assertEqual(content, \"\")\n+        self.assertEqual(tools[0][\"function\"][\"name\"], \"read\")\n+        self.assertEqual(json.loads(tools[0][\"function\"][\"arguments\"]), {\"path\": \"a\"})\n+\n+    def test_s2_inflight_flush_precedes_finalization(self) -> None:\n+        entered, release = threading.Event(), threading.Event()\n+\n+        class Writer(io.BytesIO):\n+            def flush(self) -> None:\n+                if not entered.is_set():\n+                    entered.set()\n+                    if not release.wait(5):\n+                        raise OSError(\"тест не отпустил flush\")\n+\n+        writer = Writer()\n+        handler = self._handler(writer)\n+        stop = threading.Event()\n+        handler._keepalive_stop = stop\n+        self.mod.KEEPALIVE_S = 0.01\n+        ticker = threading.Thread(\n+            target=handler._keepalive_loop, args=(stop,), daemon=True\n+        )\n+        handler._ka_thread = ticker\n+        ticker.start()\n+        self.addCleanup(release.set)\n+        self.assertTrue(entered.wait(3))\n+        finalizer = threading.Thread(\n+            target=handler._send_sse,\n+            args=(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0),\n+            daemon=True,\n+        )\n+        finalizer.start()\n+        try:\n+            self.assertTrue(\n+                stop.wait(3), \"остановка не использует единый _keepalive_stop\"\n+            )\n+            self.assertTrue(finalizer.is_alive())\n+            self.assertNotIn(b\"[DONE]\", writer.getvalue())\n+        finally:\n+            release.set()\n+            finalizer.join(5)\n+            ticker.join(5)\n+        self.assertFalse(finalizer.is_alive())\n+        self.assertFalse(ticker.is_alive())\n+        self.assertTrue(writer.getvalue().startswith(b\"data: {\"))\n+        self.assertTrue(writer.getvalue().endswith(b\"data: [DONE]\\n\\n\"))\n+\n+    def test_done_write_failure_closes_phase(self) -> None:\n+        class BrokenWriter(io.BytesIO):\n+            def write(self, data: object) -> int:\n+                raise OSError(\"closed peer\")\n+\n+        handler = self._handler(BrokenWriter())\n+        self.assertFalse(handler._sse_write(\"data: [DONE]\\n\\n\"))\n+        self.assertEqual(handler._sse_phase, \"CLOSED\")\n+        self.assertTrue(handler._client_gone)\n+\n+\n+class CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n+    \"\"\"AD-004: реальные argv фейка и неизменный approval fallback.\"\"\"\n+\n+    def test_serve_argv_disables_write_shell(self) -> None:\n+        install_protocol_wrapper(self, {\"terminal\": \"completed\"})\n+        self.assertEqual(bridge_request(self, turn_request())[0], 200)\n+        argv = json.loads((self.tmp / \"serve-argv.json\").read_text())\n+        for flag in (\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--provider\",\n+            \"meta\",\n+            \"--model\",\n+            \"muse-spark-1.3\",\n+            \"--no-session-log\",\n+            \"--trust-workspace\",\n+        ):\n+            self.assertIn(flag, argv)\n+\n+    def test_approval_falls_back_to_exec_without_decide(self) -> None:\n+        install_protocol_wrapper(self, {\"approval\": True})\n+        status, body = bridge_request(self, turn_request())\n+        self.assertEqual(status, 200, body)\n+        self.assertIn(\"fallback-ok\", body.decode())\n+        argv = json.loads((self.tmp / \"exec-argv.json\").read_text())\n+        for flag in (\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--disable-web-tools\",\n+            \"--disable-reminders\",\n+            \"--yolo\",\n+            \"--provider\",\n+            \"meta\",\n+            \"--model\",\n+            \"--reasoning-effort\",\n+            \"--trust-workspace\",\n+            \"--workspace\",\n+            \"--json\",\n+            \"--no-session-log\",\n+            \"--prompt-file\",\n+        ):\n+            self.assertIn(flag, argv)\n+        self.assertNotIn(\"approval/decide\", (self.tmp / \"rpc.jsonl\").read_text())\n+        self.assertIn(\n+            \"serve unavailable (serve needs interaction (approval/request)), fallback exec\",\n+            self.mod.LOG_PATH.read_text(),\n+        )\n+\n+\n+class AllowedModelsSyncTest(_BridgeScenario):\n+    \"\"\"T-00 / AD-001: wonder-модели объявляют context_length=400000, spark без изменений.\"\"\"\n+\n+    def test_t00_models_and_health_include_wonder_models_400k(self) -> None:\n+        wonder_models = (\"muse-wonder-1.0\", \"muse-wonder-full-1.0\")\n+        for model in wonder_models:\n+            self.assertEqual(\n+                self.mod.ALLOWED_MODELS.get(model),\n+                {\"context_length\": 400_000, \"max_output\": 131072},\n+            )\n+        spark_models = (\"muse-spark-1.3\", \"muse-spark-1.3-contributor\")\n+        for model in spark_models:\n+            self.assertEqual(\n+                self.mod.ALLOWED_MODELS.get(model),\n+                {\"context_length\": 1048576, \"max_output\": 131072},\n+            )\n+        status, health_body = bridge_request(self, path=\"/health\")\n+        self.assertEqual(status, 200)\n+        health_data = json.loads(health_body.decode(\"utf-8\"))\n+        for model in wonder_models:\n+            self.assertIn(model, health_data[\"models\"])\n+\n+        status, models_body = bridge_request(self, path=\"/v1/models\")\n+        self.assertEqual(status, 200)\n+        by_id = {\n+            item[\"id\"]: item[\"context_length\"]\n+            for item in json.loads(models_body.decode(\"utf-8\"))[\"data\"]\n+        }\n+        for model in wonder_models:\n+            self.assertEqual(by_id.get(model), 400_000)\n+        for model in spark_models:\n+            self.assertEqual(by_id.get(model), 1048576)\n+\n+        for patch_rel in (\n+            \".dsh/profiles/desktop/cordis.patch.yml\",\n+            \".dsh/profiles/web/cordis.patch.yml\",\n+        ):\n+            patch_path = Path.home() / patch_rel\n+            if patch_path.exists():\n+                content = patch_path.read_text(encoding=\"utf-8\")\n+                for model in wonder_models:\n+                    m = re.search(\n+                        rf\"-\\s+id:\\s+{re.escape(model)}\\b.*?contextWindow:\\s+(\\d+)\",\n+                        content,\n+                        flags=re.DOTALL,\n+                    )\n+                    self.assertIsNotNone(m, f\"{model} not found in {patch_path}\")\n+                    assert m is not None\n+                    self.assertEqual(\n+                        int(m.group(1)),\n+                        400_000,\n+                        f\"wrong contextWindow for {model} in {patch_path}\",\n+                    )\n+                for model in spark_models:\n+                    m = re.search(\n+                        rf\"-\\s+id:\\s+{re.escape(model)}\\b.*?contextWindow:\\s+(\\d+)\",\n+                        content,\n+                        flags=re.DOTALL,\n+                    )\n+                    self.assertIsNotNone(m, f\"{model} not found in {patch_path}\")\n+                    assert m is not None\n+                    self.assertEqual(\n+                        int(m.group(1)),\n+                        1048576,\n+                        f\"wrong contextWindow for {model} in {patch_path}\",\n+                    )\n+\n+\n+class ContextEstimateTest(unittest.TestCase):\n+    \"\"\"T-01..T-02: оценка токенов и вывод лимитов из ALLOWED_MODELS.\"\"\"\n+\n+    def test_t01_estimate_tokens_latin_cyrillic_code_json_empty(self) -> None:\n+        mod = load_bridge()\n+        self.assertEqual(mod._estimate_tokens(\"\"), 0)\n+        latin = \"a\" * 900\n+        self.assertEqual(mod._estimate_tokens(latin), 300)\n+        cyrillic = \"я\" * 1000\n+        self.assertEqual(mod._estimate_tokens(cyrillic), 666)\n+        code_sample = \"def foo(x: int) -> int:\\n    return x * 42\\n\" * 30\n+        json_sample = json.dumps(\n+            {\"ключ\": \"значение\", \"nums\": list(range(50))}, ensure_ascii=False\n+        )\n+        for sample in (latin, cyrillic, code_sample, json_sample, \"🌟\" * 90):\n+            expected = max(len(sample) // 3, len(sample.encode(\"utf-8\")) // 3)\n+            self.assertEqual(mod._estimate_tokens(sample), expected)\n+\n+    def test_t02_context_limit_and_derived_targets(self) -> None:\n+        mod = load_bridge()\n+        self.assertEqual(mod._context_limit(\"muse-wonder-1.0\"), 400_000)\n+        self.assertEqual(mod._context_limit(\"muse-wonder-full-1.0\"), 400_000)\n+        self.assertEqual(mod._context_limit(\"muse-spark-1.3\"), 1048576)\n+        self.assertEqual(mod._context_limit(\"unknown-model-id\"), 400_000)\n+        self.assertEqual(mod._context_target(400_000), 320_000)\n+        self.assertEqual(mod._context_retry_target(400_000), 200_000)\n+        with mock.patch.dict(\n+            mod.ALLOWED_MODELS,\n+            {\"muse-wonder-1.0\": {\"context_length\": 250_000, \"max_output\": 131072}},\n+        ):\n+            lim = mod._context_limit(\"muse-wonder-1.0\")\n+            self.assertEqual(lim, 250_000)\n+            self.assertEqual(mod._context_target(lim), 200_000)\n+            self.assertEqual(mod._context_retry_target(lim), 125_000)\n+\n+\n+class ContextPruneTest(unittest.TestCase):\n+    \"\"\"T-03..T-11, T-13..T-14: защитный прунинг истории диалога.\"\"\"\n+\n+    mod: Any = None\n+\n+    def setUp(self) -> None:\n+        self.mod = load_bridge()\n+\n+    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n+        # \"User: \" — 6 байт. Для оценки ровно N токенов при 1 реплике и другой реплике:\n+        # соберём историю из 3 сообщений и подгоним байты под точный порог limit=1000.\n+        limit = 1000\n+        target = 800\n+        m1 = {\"role\": \"user\", \"content\": \"first-user\"}\n+        m3 = {\"role\": \"user\", \"content\": \"last-user\"}\n+        base_prompt = self.mod._assemble_prompt(\n+            [m1, {\"role\": \"assistant\", \"content\": \"\"}, m3]\n+        )[2]\n+        # Проверим на точной длине промпта:\n+        # \"User: first-user\\n\\nAssistant: <X>\\n\\nUser: last-user\"\n+        prefix_overhead = len(\n+            \"User: first-user\\n\\nAssistant: \\n\\nUser: last-user\".encode(\"utf-8\")\n+        )\n+        for desired_est, should_prune in (\n+            (limit - 1, False),\n+            (limit, False),\n+            (limit + 1, True),\n+        ):\n+            needed_bytes = desired_est * 3 - prefix_overhead\n+            m2 = {\"role\": \"assistant\", \"content\": \"x\" * needed_bytes}\n+            msgs = [m1, m2, m3]\n+            res = self.mod._prune_messages(msgs, limit=limit, target=target)\n+            self.assertEqual(res.est_before, desired_est)\n+            if not should_prune:\n+                self.assertEqual(res.status, \"pass_through\")\n+                self.assertIs(res.messages, msgs)\n+                self.assertNotIn(self.mod.COMPACTION_MARKER, res.prompt)\n+            else:\n+                self.assertEqual(res.status, \"pruned\")\n+                self.assertLessEqual(res.est_after, target)\n+                self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n+                self.assertEqual(res.msgs_dropped, 1)\n+        _ = base_prompt\n+\n+    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n+        self,\n+    ) -> None:\n+        tools = [\n+            {\n+                \"type\": \"function\",\n+                \"function\": {\n+                    \"name\": f\"tool_{i}\",\n+                    \"description\": \"Описание инструмента \" * 40,\n+                    \"parameters\": {\n+                        \"type\": \"object\",\n+                        \"properties\": {\n+                            \"arg\": {\"type\": \"string\", \"description\": \"d\" * 200}\n+                        },\n+                    },\n+                },\n+            }\n+            for i in range(25)\n+        ]\n+        msgs: list[dict[str, Any]] = [\n+            {\"role\": \"system\", \"content\": \"System instructions \" * 500},\n+            {\"role\": \"user\", \"content\": \"Initial task description \" * 200},\n+        ]\n+        # Добавим 30 реплик по ~45k байт (~15k токенов каждая) -> ~450k токенов (> 400k).\n+        for i in range(30):\n+            role = \"assistant\" if i % 2 == 0 else \"user\"\n+            msgs.append({\"role\": role, \"content\": f\"turn-{i} \" + (\"payload \" * 5600)})\n+        msgs.append({\"role\": \"user\", \"content\": \"Final user question\"})\n+\n+        res = self.mod._prune_messages(\n+            msgs, limit=400_000, target=320_000, tools=tools, tool_choice=\"auto\"\n+        )\n+        self.assertEqual(res.status, \"pruned\")\n+        self.assertGreater(res.est_before, 400_000)\n+        actual_est = self.mod._estimate_tokens(res.prompt)\n+        self.assertEqual(res.est_after, actual_est)\n+        self.assertLessEqual(actual_est, 320_000)\n+        self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n+        self.assertIn(\"# Tool calling protocol\", res.prompt)\n+\n+    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n+        self,\n+    ) -> None:\n+        msgs = [\n+            {\"role\": \"system\", \"content\": \"sys-early\"},\n+            {\"role\": \"user\", \"content\": \"user-first\"},\n+            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n+            {\"role\": \"developer\", \"content\": \"dev-mid-insertion\"},\n+            {\"role\": \"user\", \"content\": \"U\" * 3000},\n+            {\"role\": \"assistant\", \"content\": \"B\" * 3000},\n+            {\"role\": \"system\", \"content\": \"sys-late-insertion\"},\n+            {\"role\": \"user\", \"content\": \"user-last\"},\n+        ]\n+        res = self.mod._prune_messages(msgs, limit=1500, target=1000)\n+        self.assertEqual(res.status, \"pruned\")\n+        for needle in (\n+            \"sys-early\",\n+            \"dev-mid-insertion\",\n+            \"sys-late-insertion\",\n+            \"user-first\",\n+            \"user-last\",\n+        ):\n+            self.assertIn(needle, res.prompt)\n+        # Если в истории только один user — он не дублируется.\n+        single_user_msgs = [\n+            {\"role\": \"system\", \"content\": \"sys-1\"},\n+            {\"role\": \"user\", \"content\": \"only-one-user\"},\n+            {\"role\": \"assistant\", \"content\": \"X\" * 6000},\n+        ]\n+        res_single = self.mod._prune_messages(single_user_msgs, limit=1000, target=500)\n+        self.assertEqual(res_single.status, \"pruned\")\n+        self.assertEqual(res_single.prompt.count(\"only-one-user\"), 1)\n+\n+    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n+        msgs: list[dict[str, Any]] = [\n+            {\"role\": \"user\", \"content\": \"first-user\"},\n+            {\"role\": \"assistant\", \"content\": \"early-assistant-\" + (\"x\" * 300)},\n+            {\n+                \"role\": \"assistant\",\n+                \"content\": \"\",\n+                \"tool_calls\": [\n+                    {\n+                        \"id\": \"call_a1\",\n+                        \"type\": \"function\",\n+                        \"function\": {\"name\": \"f1\", \"arguments\": \"{}\"},\n+                    },\n+                    {\n+                        \"id\": \"call_a2\",\n+                        \"type\": \"function\",\n+                        \"function\": {\"name\": \"f2\", \"arguments\": \"{}\"},\n+                    },\n+                ],\n+            },\n+            {\n+                \"role\": \"tool\",\n+                \"tool_call_id\": \"call_a1\",\n+                \"name\": \"f1\",\n+                \"content\": \"res_a1_\" + (\"y\" * 300),\n+            },\n+            {\n+                \"role\": \"tool\",\n+                \"tool_call_id\": \"call_a2\",\n+                \"name\": \"f2\",\n+                \"content\": \"res_a2_\" + (\"z\" * 300),\n+            },\n+            {\n+                \"role\": \"assistant\",\n+                \"content\": \"thinking\",\n+                \"tool_calls\": [\n+                    {\n+                        \"id\": \"call_b1\",\n+                        \"type\": \"function\",\n+                        \"function\": {\"name\": \"f3\", \"arguments\": \"{}\"},\n+                    },\n+                ],\n+            },\n+            {\n+                \"role\": \"tool\",\n+                \"tool_call_id\": \"call_b1\",\n+                \"name\": \"f3\",\n+                \"content\": \"res_b1_\" + (\"w\" * 300),\n+            },\n\n<system-reminder>[Showing lines 1053-2104 of 2894 total lines]</system-reminder>","timestamp":1791993025265,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
{"type":"tool_result","id":"tc-93zawsyec39","messageId":"63cf3b1b-c459-4e7b-8b4c-139a2f9c3e80","toolId":"Read","isError":false,"value":"        _kill_group(proc)\n        try:\n            proc.wait(timeout=5.0)\n        except subprocess.TimeoutExpired:\n            _log(f\"cleanup: wait after SIGKILL timed out pid={proc.pid}, escalating\")\n            _kill_group(proc)\n            try:\n                proc.wait(timeout=5.0)\n            except subprocess.TimeoutExpired:\n                pass\n        run.dead_confirmed = _wait_group_exit(\n            proc.pid, 2.0, leader_reaped=proc.poll() is not None\n        )\n        if not run.dead_confirmed:\n            _log(f\"cleanup: process group {proc.pid} not confirmed dead after SIGKILL\")\n            return\n        for stream in streams:\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n                pass\n\n\ndef _quarantine_slot(runs: list) -> None:\n    \"\"\"Слот держится, пока группы ходов не подтверждены мёртвыми (карантин), затем возвращается.\"\"\"\n    pgids = [r.proc.pid for r in runs if r.proc is not None]\n    _log(f\"quarantine: slot held, groups not confirmed dead pgids={pgids}\")\n    with _active_lock:\n        _quarantined_slots.append(pgids)\n\n    def work() -> None:\n        end = time.monotonic() + QUARANTINE_MAX_S\n        escalated = False\n        while True:\n            alive = [r for r in runs if r.proc is not None and _group_alive(r.proc.pid)]\n            if not alive:\n                break\n            if not escalated and time.monotonic() >= end:\n                # Потолок вышел, а группа жива: слот отпускать нельзя (orphan продолжит\n                # работу при свободном слоте) — сигнал оператору, дальше только опрос.\n                escalated = True\n                _log(\n                    \"CRITICAL quarantine: process groups still alive after \"\n                    f\"{QUARANTINE_MAX_S:.0f}s pgids={[r.proc.pid for r in alive]}, \"\n                    \"slot stays withdrawn until they die, signals stopped\"\n                )\n            if not escalated:\n                for run in alive:\n                    # Реапнутый лидер освободил pid: killpg по нему может попасть в чужую группу.\n                    if run.proc.poll() is None:\n                        _kill_group(run.proc)\n            time.sleep(1.0)\n        with _active_lock:\n            _quarantined_slots.remove(pgids)\n        _log(\"quarantine: slot released\")\n        _slots.release()\n\n    threading.Thread(target=work, daemon=True).start()\n\n\nclass Run:\n    \"\"\"Один прогон `muse-cli.sh exec` с разбором JSONL-конвертов.\"\"\"\n\n    def __init__(self, model_id: str, prompt: str, effort: str, workdir: Path) -> None:\n        self.model_id = model_id\n        self.prompt = prompt\n        self.effort = effort\n        self.workdir = workdir\n        self.proc: subprocess.Popen | None = None\n        self._closed = False\n        self._cleanup_lock = threading.Lock()\n        self.dead_confirmed = (\n            True  # False — группа не подтверждена мёртвой (карантин слота)\n        )\n\n    def close(self) -> None:\n        \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n\n        Идемпотентно: повторный вызов (таймер, надзор обрыва, finally) — no-op,\n        поэтому поздний killpg не может попасть в переиспользованный pid.\n        \"\"\"\n        proc = self.proc\n        if proc is None:\n            return\n        _terminate_run(self, (proc.stdout, proc.stderr))\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"muse wrapper not executable: {MUSE_WRAPPER}\",\n                \"state\": \"launcher_missing\",\n            }\n\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\n            \"META_API_KEY\", None\n        )  # обёртка тоже вычищает; двойная страховка (flat-подписка, не PAYG)\n\n        fd, prompt_path = tempfile.mkstemp(\n            prefix=\"muse-prompt-\", suffix=\".txt\", dir=str(self.workdir)\n        )\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(self.prompt)\n        except OSError as exc:\n            return {\n                \"rc\": -1,\n                \"text\": \"\",\n                \"err\": f\"prompt file write failed: {exc}\",\n                \"state\": \"spawn_failed\",\n            }\n\n        cmd = [\n            MUSE_WRAPPER,\n            \"exec\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--reasoning-effort\",\n            self.effort,\n            \"--yolo\",\n            \"--trust-workspace\",\n            \"--workspace\",\n            str(self.workdir),\n            \"--json\",\n            \"--no-session-log\",\n            \"--disable-write\",\n            \"--disable-shell\",\n            \"--disable-web-tools\",\n            \"--disable-reminders\",\n            \"--prompt-file\",\n            prompt_path,\n        ]\n        _log(\n            f\"exec model={self.model_id} effort={self.effort} prompt_chars={len(self.prompt)} ws={self.workdir}\"\n        )\n\n        run_id = uuid.uuid4().hex[:8]\n        deltas: list[str] = []\n        final_text: str | None = None\n        terminal: str | None = None\n        reason: str | None = None\n        err_lines: list[str] = []\n        state = \"ok\"\n        try:\n            # Регистрация в _active ДО Popen: между появлением self.proc и записью в _active\n            # нет окна, в котором надзор уже видит процесс, а /health его не учитывает.\n            with _active_lock:\n                _active[run_id] = time.time()\n            try:\n                self.proc = subprocess.Popen(\n                    cmd,\n                    cwd=str(self.workdir),\n                    env=env,\n                    stdin=subprocess.DEVNULL,\n                    stdout=subprocess.PIPE,\n                    stderr=subprocess.PIPE,\n                    text=True,\n                    encoding=\"utf-8\",\n                    errors=\"replace\",\n                    bufsize=1,\n                    start_new_session=True,\n                )\n            except OSError as exc:\n                with _active_lock:\n                    _active.pop(run_id, None)\n                return {\n                    \"rc\": -1,\n                    \"text\": \"\",\n                    \"err\": f\"spawn failed: {exc}\",\n                    \"state\": \"spawn_failed\",\n                }\n\n            def drain_stderr() -> None:\n                try:\n                    assert self.proc is not None and self.proc.stderr is not None\n                    for line in self.proc.stderr:\n                        line = line.strip()\n                        if line:\n                            err_lines.append(line)\n                except (OSError, ValueError):\n                    pass\n\n            err_thread = threading.Thread(target=drain_stderr, daemon=True)\n            err_thread.start()\n\n            # Жёсткий дедлайн: таймер убивает процесс, даже если stdout молчит.\n            timer = threading.Timer(\n                TIMEOUT_S, lambda: (err_lines.append(\"bridge timeout\"), self.close())\n            )\n            timer.daemon = True\n            timer.start()\n            timed_out = False\n            try:\n                assert self.proc.stdout is not None\n                for raw in self.proc.stdout:\n                    raw = raw.strip()\n                    if not raw:\n                        continue\n                    try:\n                        event = json.loads(raw)\n                    except ValueError:\n                        continue\n                    if not isinstance(event, dict):\n                        continue\n                    ptype = str(event.get(\"payload_type\") or \"\")\n                    raw_payload = event.get(\"payload\")\n                    payload: dict[str, Any] = (\n                        raw_payload if isinstance(raw_payload, dict) else {}\n                    )\n                    if ptype == \"run.output.delta\":\n                        text = payload.get(\"text\")\n                        if isinstance(text, str):\n                            deltas.append(text)\n                    elif ptype.startswith(\"run.terminal\"):\n                        terminal = str(\n                            payload.get(\"terminal\") or ptype.rsplit(\".\", 1)[-1]\n                        )\n                        text = payload.get(\"text\")\n                        if isinstance(text, str):\n                            final_text = text\n                        if payload.get(\"reason\"):\n                            reason = str(payload[\"reason\"])\n                        if terminal == \"completed\":\n                            # Ход завершён: общий таймер хода отменяется сразу (грейс уборки вне\n                            # бюджета хода). Процесс может висеть после terminal — ждать EOF не\n                            # нужно, группу добьёт close() ниже.\n                            timer.cancel()\n                            break\n                    elif ptype == \"task.lifecycle.failed\":\n                        raw_ev = payload.get(\"event\")\n                        ev: dict[str, Any] = raw_ev if isinstance(raw_ev, dict) else {}\n                        if ev.get(\"reason\"):\n                            err_lines.append(f\"task failed: {ev['reason']}\")\n                if terminal == \"completed\":\n                    # Короткий ограниченный грейс: CLI выходит сам (его rc настоящий) либо висит\n                    # после terminal — тогда его добивает мост (rc от сигнала моста — не ошибка).\n                    try:\n                        self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                    except subprocess.TimeoutExpired:\n                        pass\n            except (OSError, ValueError) as exc:\n                state = \"stream_error\"\n                err_lines.append(f\"stdout read failed: {exc}\")\n            finally:\n                timer.cancel()\n                # Порядок: kill группы -> wait ребёнка -> снятие с _active\n                # (слот отпускается позже, в finally хендлера — после execute).\n                self.close()\n                try:\n                    self.proc.wait(timeout=15)\n                except subprocess.TimeoutExpired:\n                    timed_out = True\n                err_thread.join(timeout=5)\n                with _active_lock:\n                    _active.pop(run_id, None)\n        finally:\n            try:\n                os.unlink(prompt_path)\n            except OSError:\n                pass\n\n        raw_rc = self.proc.returncode if self.proc else None\n        rc = raw_rc if raw_rc is not None else -1\n        if terminal == \"completed\" and (\n            raw_rc is None or raw_rc == 0 or raw_rc in _SIGNAL_RCS\n        ):\n            # completed доставлен: rc 0 либо смерть от сигнала моста при уборке (SIGKILL/SIGTERM)\n            # не ошибка; самостоятельный rc != 0 CLI (в т.ч. между грейсом и уборкой) — ошибка.\n            # Не подтверждённая уборка (raw_rc None) не отменяет доставленный ход: журнал + карантин.\n            state, rc = \"ok\", 0\n        elif timed_out or any(line == \"bridge timeout\" for line in err_lines):\n            state = \"timeout\"\n        elif terminal is not None and terminal != \"completed\":\n            state = f\"terminal_{terminal}\"\n        elif rc != 0 and state == \"ok\":\n            state = \"nonzero_exit\"\n\n        # chunks — то, что кормим ToolCallParser: итоговый текст (приоритет) или дельты.\n        chunks = [final_text] if final_text else deltas\n        text = \"\".join(chunks)\n        if reason:\n            err_lines.append(f\"reason: {reason}\")\n        return {\n            \"rc\": rc,\n            \"text\": text,\n            \"chunks\": chunks,\n            \"err\": \"\\n\".join(err_lines[-6:]),\n            \"state\": state,\n        }\n\n\nclass ServeRun:\n    \"\"\"Один запрос через `muse serve` (MSP v1 по stdio, NDJSON JSON-RPC).\n\n    Поток (проверен офлайн на echo-провайдере 05.10.2026): initialize ->\n    notify initialized -> session/start (без approvalMode: любое явное\n    значение режектится startup ceiling; провайдер meta)\n    провайдер meta) -> turn/start (reasoningEffort=тир) -> ждём turn/completed.\n    Текст — из agentMessage (item/completed.text, fallback — item/delta);\n    reasoning summaries — из reasoning-item (summary[] + item/delta\n    field \"summary.N\"); токены — из session/tokenUsage (reasoningTokens\n    включительно). Сырой reasoning-текст в v1 не стримится (только\n    summaries) — ограничение протокола, не моста.\n\n    Любая транспортная неполадка (спавн, handshake, таймаут, интерактивный\n    запрос approval/userInput, JSON-RPC error) -> ServeUnavailable, и\n    вызывающий код тихо идёт на exec. Ошибка самой модели\n    (terminal != completed) — НЕ ServeUnavailable: ход реально выполнен,\n    fallback лишь удвоил бы вызов.\n    \"\"\"\n\n    def __init__(self, model_id: str, prompt: str, effort: str, workdir: Path) -> None:\n        self.model_id = model_id\n        self.prompt = prompt\n        self.effort = effort\n        self.workdir = workdir\n        self.proc: subprocess.Popen | None = None\n        self._rid = 0\n        self._closed = False\n        self._cleanup_lock = threading.Lock()\n        self._handle_event: Any = None  # обработчик событий; ставится в execute\n        self.dead_confirmed = (\n            True  # False — группа не подтверждена мёртвой (карантин слота)\n        )\n        # Запись в stdin serve ограничена дедлайном (ставится в execute): зависший читатель\n        # не держит слот бессрочно, при истечении ход завершается, группа убивается.\n        self._write_until = float(\"inf\")\n\n    def close(self) -> None:\n        \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n        proc = self.proc\n        if proc is None:\n            return\n        _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n\n    def _send(\n        self, method: str, params: dict | None = None, notify: bool = False\n    ) -> int:\n        assert self.proc is not None and self.proc.stdin is not None\n        self._rid += 1\n        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n        if not notify:\n            msg[\"id\"] = self._rid\n        if params is not None:\n            msg[\"params\"] = params\n        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n        try:\n            fd = self.proc.stdin.fileno()\n            view = memoryview(data)\n            sent = 0\n            while sent < len(data):\n                remaining = self._write_until - time.time()\n                if remaining <= 0:\n                    raise ServeUnavailable(\n                        \"serve stdin write timed out: child does not read\"\n                    )\n                _, writable, _ = select.select([], [fd], [], min(0.5, remaining))\n                if not writable:\n                    continue\n                try:\n                    sent += os.write(fd, view[sent:])\n                except BlockingIOError:\n                    continue\n        except (OSError, ValueError) as exc:\n            raise ServeUnavailable(f\"stdio write failed: {exc}\")\n        return self._rid\n\n    def execute(self) -> dict[str, Any]:\n        if not os.access(MUSE_WRAPPER, os.X_OK):\n            raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n        self.workdir.mkdir(parents=True, exist_ok=True)\n        env = dict(os.environ)\n        env.setdefault(\n            \"PATH\",\n            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n        )\n        env.pop(\"META_API_KEY\", None)\n        cmd = [\n            MUSE_WRAPPER,\n            \"serve\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            self.model_id,\n            \"--no-session-log\",\n            \"--trust-workspace\",\n            \"--disable-write\",\n            \"--disable-shell\",\n        ]\n        try:\n            self.proc = subprocess.Popen(\n                cmd,\n                cwd=str(self.workdir),\n                env=env,\n                stdin=subprocess.PIPE,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                text=True,\n                encoding=\"utf-8\",\n                errors=\"replace\",\n                bufsize=1,\n                start_new_session=True,\n            )\n        except OSError as exc:\n            raise ServeUnavailable(f\"serve spawn failed: {exc}\")\n        assert self.proc.stdout is not None and self.proc.stdin is not None\n        # stdin неблокирующий: запись идёт срезами с дедлайном (см. _send).\n        os.set_blocking(self.proc.stdin.fileno(), False)\n\n        err_lines: list[str] = []\n        turn_diag_lines: list[str] = []\n        stderr_joined = False\n\n        def drain_stderr() -> None:\n            try:\n                assert self.proc is not None and self.proc.stderr is not None\n                for line in self.proc.stderr:\n                    line = line.strip()\n                    if line:\n                        err_lines.append(line)\n            except (OSError, ValueError):\n                pass\n\n        err_thread = threading.Thread(target=drain_stderr, daemon=True)\n        err_thread.start()\n        deadline = time.time() + TIMEOUT_S\n        setup_deadline = time.time() + SERVE_SPAWN_TIMEOUT_S\n        self._write_until = setup_deadline\n\n        # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n        # уже вычитанные в буфер TextIOWrapper (пачка строк за один write зависала бы).\n        rbuf = bytearray()\n\n        def read_msg(timeout_at: float) -> dict[str, Any]:\n            while time.time() < min(timeout_at, deadline):\n                if self.proc is None or self.proc.stdout is None:\n                    raise ServeUnavailable(\"serve stdout closed\")\n                newline = rbuf.find(b\"\\n\")\n                if newline < 0:\n                    ready, _, _ = select.select([self.proc.stdout], [], [], 0.5)\n                    if not ready:\n                        if self.proc.poll() is not None:\n                            raise ServeUnavailable(\n                                f\"serve exited rc={self.proc.returncode}: \"\n                                + \" \".join(err_lines[-3:])\n                            )\n                        continue\n                    chunk = os.read(self.proc.stdout.fileno(), 65536)\n                    if not chunk:\n                        raise ServeUnavailable(\n                            f\"serve stdout EOF rc={self.proc.poll()}: \"\n                            + \" \".join(err_lines[-3:])\n                        )\n                    rbuf.extend(chunk)\n                    continue\n                line = bytes(rbuf[:newline]).decode(\"utf-8\", \"replace\").strip()\n                del rbuf[: newline + 1]\n                if not line:\n                    continue\n                try:\n                    msg = json.loads(line)\n                except ValueError:\n                    continue\n                if isinstance(msg, dict):\n                    return msg\n            raise ServeUnavailable(\"serve read timeout\")\n\n        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n            while True:\n                msg = read_msg(timeout_at)\n                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n                    if \"error\" in msg:\n                        raise ServeUnavailable(f\"serve RPC error: {msg['error']}\")\n                    result = msg.get(\"result\")\n                    return result if isinstance(result, dict) else {}\n                self._handle_event(msg, None)\n\n        kinds: dict[str, str] = {}\n        deltas: list[str] = []\n        summary_parts: dict[int, str] = {}\n        summaries: list[str] = []\n        final_text: str | None = None\n        usage: dict[str, Any] = {}\n        turn_id: str | None = None\n        session_id: str | None = None\n\n        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n            nonlocal final_text\n            method = msg.get(\"method\")\n            params = msg.get(\"params\") if isinstance(msg.get(\"params\"), dict) else {}\n            if method in (\"approval/request\", \"userInput/request\"):\n                raise ServeUnavailable(f\"serve needs interaction ({method})\")\n            if method in (\"item/started\", \"item/completed\"):\n                raw_item = params.get(\"item\")\n                item: dict[str, Any] = raw_item if isinstance(raw_item, dict) else {}\n                iid = str(item.get(\"itemId\") or \"\")\n                kind = str(item.get(\"kind\") or \"\")\n                if iid:\n                    kinds[iid] = kind\n                if (\n                    method == \"item/completed\"\n                    and turn_id is not None\n                    and item.get(\"turnId\") == turn_id\n                ):\n                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n                        final_text = item[\"text\"]\n                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n                        summaries.extend(\n                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n                        )\n            elif method == \"item/delta\":\n                iid = str(params.get(\"itemId\") or \"\")\n                field = str(params.get(\"field\") or \"text\")\n                piece = params.get(\"delta\")\n                if not isinstance(piece, str) or not piece:\n                    return\n                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n                    try:\n                        idx = int(field.split(\".\", 1)[1])\n                    except (IndexError, ValueError):\n                        idx = len(summary_parts)\n                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n                elif (\n                    kinds.get(iid, \"agentMessage\") == \"agentMessage\" and field == \"text\"\n                ):\n                    deltas.append(piece)\n            elif method == \"session/tokenUsage\":\n                raw = params.get(\"usage\")\n                if isinstance(raw, dict):\n                    usage.update(raw)\n\n        self._handle_event = _handle_event\n\n        try:\n            init_rid = self._send(\n                \"initialize\", {\"clientInfo\": {\"name\": \"muse_bridge\", \"version\": \"1\"}}\n            )\n            init = await_result(init_rid, setup_deadline)\n            schema = init.get(\"schema\") if isinstance(init.get(\"schema\"), dict) else {}\n            _log(\n                f\"serve init server={init.get('serverInfo', {}).get('version') if isinstance(init.get('serverInfo'), dict) else '?'} \"\n                f\"schema_fp={str(schema.get('fingerprint', ''))[:19]}\"\n            )\n            self._send(\"initialized\", {}, notify=True)\n            sess_rid = self._send(\n                \"session/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"workspaceRoot\": str(self.workdir),\n                    \"providerId\": \"meta\",\n                    \"modelId\": self.model_id,\n                },\n            )\n            # approvalMode намеренно НЕ передаём: любое явное значение\n            # (allowAll, onRequest) отвергается sealed startup ceiling\n            # неинтерактивного serve (commandRejected/approval_mode_ceiling),\n            # а без ключа сервер назначает свой дефолт (promptUnmatched — так\n            # было в офлайн-пробе на echo). Запрос approval/userInput по ходу\n            # хода ведёт в ServeUnavailable -> fallback на exec.\n            sess = await_result(sess_rid, setup_deadline)\n            session = (\n                sess.get(\"session\") if isinstance(sess.get(\"session\"), dict) else {}\n            )\n            session_id = str(session.get(\"sessionId\") or \"\")\n            if not session_id:\n                raise ServeUnavailable(\"session/start gave no sessionId\")\n            tier = _MSP_EFFORT.get(self.effort, \"max\")\n            turn_rid = self._send(\n                \"turn/start\",\n                {\n                    \"commandId\": _uuid7(),\n                    \"sessionId\": session_id,\n                    \"reasoningEffort\": tier,\n                    \"input\": [{\"type\": \"text\", \"text\": self.prompt}],\n                },\n            )\n            turn = await_result(turn_rid, setup_deadline)\n            if turn.get(\"status\") != \"accepted\":\n                raise ServeUnavailable(f\"turn/start not accepted: {turn}\")\n            turn_id = str(turn.get(\"turnId\") or \"\")\n            _log(\n                f\"serve turn session={session_id[:8]} turn={turn_id[:8]} effort={tier}\"\n            )\n            terminal: str | None = None\n            while time.time() < deadline:\n                # Смерть serve здесь не проверяется: события и completed, уже лежащие в буфере\n                # чтения или pipe, разбираются первыми; read_msg сам поднимет ServeUnavailable\n                # на EOF/выходе процесса, когда разбирать больше нечего.\n                msg = read_msg(deadline)\n                if msg.get(\"method\") == \"turn/completed\" and isinstance(\n                    msg.get(\"params\"), dict\n                ):\n                    p = msg[\"params\"]\n                    if turn_id is not None and p.get(\"turnId\") not in (turn_id, None):\n                        _handle_event(msg, None)\n                        continue\n                    terminal = str(p.get(\"terminal\") or \"unknown\")\n                    if terminal != \"completed\":\n                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                    break\n                if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                    continue  # чужой/дублированный ack — игнор, не разрываем ход\n                _handle_event(msg, None)\n            else:\n                raise ServeUnavailable(\"serve turn deadline exceeded\")\n            serve_rc: int | None = None\n            if terminal == \"completed\":\n                # D-A3-1: после completed — тот же грейс, что у exec: serve вышел сам с rc != 0 ->\n                # ошибка; жив -> мост закрывает группу (сигнал моста rc не определяет).\n                try:\n                    self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n                except subprocess.TimeoutExpired:\n                    pass\n                self.close()\n                serve_rc = self.proc.returncode\n            ordered = [\n                summary_parts[i] for i in sorted(summary_parts) if summary_parts[i]\n            ]\n            for part in ordered:\n                if part not in summaries:\n                    summaries.append(part)\n            text = final_text if final_text is not None else \"\".join(deltas)\n            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n            err_thread.join(timeout=5)\n            stderr_joined = True\n            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n            if self.prompt:\n                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n            err = \"\\n\".join(turn_diag_lines)\n            if err:\n                if stderr_tail:\n                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n            else:\n                err = stderr_tail\n            if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                return {\n                    \"rc\": serve_rc,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": \"nonzero_exit\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            if terminal != \"completed\":\n                return {\n                    \"rc\": 1,\n                    \"text\": text,\n                    \"chunks\": [text] if text else [],\n                    \"err\": err,\n                    \"state\": f\"terminal_{terminal}\",\n                    \"summaries\": summaries,\n                    \"usage\": usage,\n                    \"via\": \"serve\",\n                }\n            return {\n                \"rc\": 0,\n                \"text\": text,\n                \"chunks\": [text] if text else [],\n                \"err\": err,\n                \"state\": \"ok\",\n                \"summaries\": summaries,\n                \"usage\": usage,\n                \"via\": \"serve\",\n            }\n        finally:\n            if not stderr_joined:\n                err_thread.join(timeout=5)\n            self.close()\n\n\nclass Handler(BaseHTTPRequestHandler):\n    protocol_version = \"HTTP/1.1\"\n    timeout = 300\n\n    def log_message(self, format: str, *args: Any) -> None:\n        _log(\"http \" + (format % args))\n\n    def handle_error(self, request: Any, client_address: Any) -> None:\n        _log(f\"http accept error from {client_address}\")\n\n    # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n    _client_gone: bool = False\n    _current_run: Run | ServeRun | None = None\n    # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n    _sse_open: bool = False\n    _content_started: bool = False\n    _sse_id: str = \"\"\n    _sse_created: int = 0\n    _sse_model: str = \"\"\n    _wlock: threading.Lock = threading.Lock()\n    _sse_phase: str = \"OPEN\"\n    _keepalive_stop: threading.Event | None = None\n    _ka_thread: threading.Thread | None = None\n\n    def setup(self) -> None:\n        # Состояние обрыва клиента и ссылка на текущий ход — на каждое соединение.\n        self._client_gone = False\n        self._current_run = None\n        self._sse_open = False\n        self._content_started = False\n        self._sse_id = \"\"\n        self._sse_created = 0\n        self._sse_model = \"\"\n        self._wlock = threading.Lock()\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self._keepalive_stop: threading.Event | None = None\n        self._ka_thread: threading.Thread | None = None\n        super().setup()\n\n    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n        \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n        try:\n            with self._wlock:\n                if self._sse_phase == \"CLOSED\" or self._client_gone:\n                    return False\n                if keepalive and (\n                    self._sse_phase != \"OPEN\"\n                    or (\n                        self._keepalive_stop is not None\n                        and self._keepalive_stop.is_set()\n                    )\n                ):\n                    return False\n                try:\n                    self.wfile.write(text.encode(\"utf-8\"))\n                    self.wfile.flush()\n                finally:\n                    if text == \"data: [DONE]\\n\\n\":\n                        self._sse_phase = \"CLOSED\"\n            return True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            if not self._client_gone:\n                self._client_gone = True\n                _log(\"client gone mid-stream\")\n                self._kill_current_run()\n            return False\n\n    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n        return {\n            \"id\": self._sse_id,\n            \"object\": \"chat.completion.chunk\",\n            \"created\": self._sse_created,\n            \"model\": self._sse_model,\n            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n        }\n\n    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n        return self._sse_write(\n            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n        )\n\n    def _sse_begin(self, model: str) -> bool:\n        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n        self._sse_created = int(time.time())\n        self._sse_model = model\n        with self._wlock:\n            self._sse_phase = \"OPEN\"\n        self.close_connection = True\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"close\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            self.end_headers()\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before headers\")\n            return False\n        self._sse_open = True\n        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            return False\n        stop = threading.Event()\n        self._keepalive_stop = stop\n        self._ka_thread = threading.Thread(\n            target=self._keepalive_loop, args=(stop,), daemon=True\n        )\n        self._ka_thread.start()\n        return True\n\n    def _keepalive_loop(self, stop: threading.Event) -> None:\n        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n        while not stop.wait(KEEPALIVE_S):\n            if self._client_gone or stop.is_set():\n                return\n            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                return\n\n    def _sse_stop_keepalive(self) -> None:\n        if self._keepalive_stop is not None:\n            self._keepalive_stop.set()\n        with self._wlock:\n            if self._sse_phase == \"OPEN\":\n                self._sse_phase = \"FINALIZING\"\n        if self._ka_thread is not None:\n            self._ka_thread.join(timeout=2)\n        self._keepalive_stop = None\n        self._ka_thread = None\n\n    def _client_gone_probe(self) -> bool:\n        \"\"\"Обрыв клиента: FIN даёт пустой peek; ошибки сокета считаем обрывом.\n\n        Режим сокета (timeout/blocking) не меняется: сокет общий с _sse_write\n        в соседних потоках, смена режима из пробы ломала бы их запись. Peek идёт\n        флагом MSG_DONTWAIT; select(0) заранее отсекает случай «данных нет».\n        \"\"\"\n        conn = self.connection\n        if conn is None:\n            return False\n        try:\n            ready, _, _ = select.select([conn], [], [], 0)\n        except (OSError, ValueError):\n            return True\n        if not ready:\n            return False\n        try:\n            data = conn.recv(1, socket.MSG_PEEK | getattr(socket, \"MSG_DONTWAIT\", 0))\n        except (BlockingIOError, InterruptedError):\n            return False\n        except OSError:\n            return True\n        return data == b\"\"\n\n    def _kill_current_run(self) -> None:\n        \"\"\"Убить группу текущего хода: призраки не переживают обрыв клиента.\"\"\"\n        run = self._current_run\n        if run is not None:\n            run.close()\n\n    def _watch_client(self, stop: threading.Event) -> None:\n        \"\"\"Надзор за клиентом во время хода: обрыв -> флаг + killpg группы хода.\n\n        Не выходит после первого убийства: ход может зарегистрироваться (или запустить\n        процесс) уже после обрыва — kill идемпотентен и повторяется каждый тик до stop.\n        \"\"\"\n        reported = False\n        while not stop.wait(0.25):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                if not reported:\n                    reported = True\n                    _log(\"client gone during run — killing process group\")\n                self._kill_current_run()\n\n    def _send(self, code: int, payload: dict) -> None:\n        if self._sse_open:\n            # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n            self._sse_stop_keepalive()\n            error = payload.get(\"error\") if isinstance(payload, dict) else None\n            if isinstance(error, dict):\n                error = dict(error)\n                error.setdefault(\"code\", int(code))\n            self._sse_emit({\"error\": error or payload})\n            self._sse_write(\"data: [DONE]\\n\\n\")\n            return\n        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n        try:\n            self.send_response(int(code))\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            self._client_gone = True\n            _log(\"client gone before response\")\n            self._kill_current_run()\n\n    def _send_sse(\n        self,\n        model: str,\n        content: str,\n        tool_calls: list[dict],\n        prompt_tokens: int,\n        completion_tokens: int,\n        reasoning_tokens: int,\n        summaries: list[str] | None = None,\n    ) -> None:\n        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n\n        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n        \"\"\"\n        finish = \"tool_calls\" if tool_calls else \"stop\"\n        if not self._sse_open and not self._sse_begin(model):\n            return\n        self._sse_stop_keepalive()\n        with self._wlock:\n            self._content_started = True\n        chunk = self._sse_chunk\n        reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n        if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n            return\n        for tc in tool_calls:\n            fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n            delta = {\n                \"tool_calls\": [\n                    {\n                        \"index\": tc.get(\"index\", 0),\n                        \"id\": tc.get(\"id\", \"\"),\n                        \"type\": \"function\",\n                        \"function\": {\n                            \"name\": fn.get(\"name\", \"\"),\n                            \"arguments\": fn.get(\"arguments\", \"\"),\n                        },\n                    }\n                ]\n            }\n            if not self._sse_emit(chunk(delta)):\n                return\n        for piece in _split_sse_chunks(content):\n            if not self._sse_emit(chunk({\"content\": piece})):\n                return\n            if SSE_CHUNK_DELAY_S > 0:\n                time.sleep(SSE_CHUNK_DELAY_S)\n        final = chunk({}, finish)\n        final[\"usage\"] = {\n            \"prompt_tokens\": prompt_tokens,\n            \"completion_tokens\": completion_tokens,\n            \"total_tokens\": prompt_tokens + completion_tokens,\n            \"reasoning_tokens\": reasoning_tokens,\n        }\n        if self._sse_emit(final):\n            self._sse_write(\"data: [DONE]\\n\\n\")\n\n    def do_GET(self) -> None:  # noqa: N802\n        path = self.path.split(\"?\", 1)[0]\n        if path in (\"/health\", \"/v1/health\"):\n            with _active_lock:\n                active = len(_active)\n                quarantined = len(_quarantined_slots)\n            self._send(\n                200,\n                {\n                    \"ok\": True,\n                    \"transport\": \"muse-cli\",\n                    \"wrapper\": MUSE_WRAPPER,\n                    \"models\": sorted(ALLOWED_MODELS),\n                    \"default_model\": DEFAULT_MODEL,\n                    \"default_effort\": DEFAULT_EFFORT,\n                    \"active\": active,\n                    \"quarantined\": quarantined,\n                    \"max_concurrent\": MAX_CONCURRENT,\n                    \"stream\": True,\n                    \"tool_emulation\": True,\n                    \"uptime_s\": int(time.time() - _started),\n                },\n            )\n            return\n        if not _auth_ok(self):\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        if path in (\"/v1/models\", \"/models\"):\n            self._send(\n                200,\n                {\n                    \"object\": \"list\",\n                    \"data\": [\n                        {\n                            \"id\": mid,\n                            \"object\": \"model\",\n                            \"owned_by\": \"meta-muse\",\n                            \"created\": 0,\n                            \"context_length\": meta[\"context_length\"],\n                        }\n                        for mid, meta in ALLOWED_MODELS.items()\n                    ],\n                },\n            )\n            return\n        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n\n    def do_POST(self) -> None:  # noqa: N802\n        if not _auth_ok(self):\n            self.close_connection = True\n            self._send(\n                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n            )\n            return\n        path = self.path.split(\"?\", 1)[0]\n        length = int(self.headers.get(\"Content-Length\") or \"0\")\n        raw = self.rfile.read(length) if length else b\"{}\"\n        try:\n            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n        except ValueError:\n            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n            return\n        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n            return\n        try:\n            self._serve_json(req)\n        finally:\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n\n    def _serve_json(self, req: dict) -> None:\n        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n        if model not in ALLOWED_MODELS:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n                        \"type\": \"invalid_request_error\",\n                        \"code\": \"model_not_found\",\n                    }\n                },\n            )\n            return\n\n        raw_tools = req.get(\"tools\")\n        tools = (\n            [t for t in raw_tools if isinstance(t, dict)]\n            if isinstance(raw_tools, list)\n            else []\n        )\n        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        raw_messages = req.get(\"messages\") or []\n        _, raw_turns_text = _messages_to_prompt(raw_messages)\n        if not raw_turns_text:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n\n        rid = uuid.uuid4().hex[:8]\n        limit = _context_limit(model)\n        target = _context_target(limit)\n        retry_target = _context_retry_target(limit)\n        prune_res = _prune_messages(\n            raw_messages,\n            limit=limit,\n            target=target,\n            tools=tools,\n            tool_choice=tool_choice,\n            raw_tools=raw_tools,\n        )\n        if prune_res.status == \"refused\":\n            _log_context_prune(\n                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n            )\n            detail = (\n                f\"mandatory context exceeds budget \"\n                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n            )\n            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n            _log(\n                _format_err_log(\n                    model,\n                    \"refused\",\n                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n                    req.get(\"stream\") is True,\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_msg),\n                        \"detail\": _redact_secrets(detail)[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if prune_res.status == \"pruned\":\n            _log_context_prune(\n                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n            )\n\n        prompt = prune_res.prompt\n        current_est = prune_res.est_after\n        reflected_prompts: list[str] = [prompt]\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        waited = time.monotonic()\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n\n<system-reminder>[Showing lines 1112-2222 of 2595 total lines]</system-reminder>","timestamp":1791993025265,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
{"type":"tool_result","id":"tc-5hlp1f4jaao","messageId":"63cf3b1b-c459-4e7b-8b4c-139a2f9c3e80","toolId":"Read","isError":false,"value":"\n    def test_reason_only_duplicate_and_malformed(self) -> None:\n        for error, reason, expected in [\n            (None, \"cancelled by caller\", \"reason: cancelled by caller\"),\n            ({\"message\": \"same\"}, \"same\", \"same\"),\n            (\"raw failure\", None, \"raw failure\"),\n            ({\"kind\": 123, \"quota\": [1, 2]}, None, \"123\"),\n            ([\"odd\"], 17, \"17\"),\n        ]:\n            with self.subTest(error=error):\n                out = self._execute(\n                    {\"terminal\": \"failed\", \"error\": error, \"reason\": reason}\n                )\n                self.assertEqual(out[\"state\"], \"terminal_failed\")\n                self.assertIn(expected, out[\"err\"])\n                if reason == \"same\":\n                    self.assertEqual(out[\"err\"].count(\"same\"), 1)\n\n    def test_no_diagnostics_preserves_stderr_tail_and_success(self) -> None:\n        tail = \"\\n\".join(\"noise-%02d-\" % i + \"z\" * 100 for i in range(6, 12))\n        for terminal in (\"failed\", \"completed\"):\n            out = self._execute({\"terminal\": terminal}, True)\n            self.assertEqual(out[\"err\"], tail)\n            self.assertEqual(\n                out[\"state\"], \"ok\" if terminal == \"completed\" else \"terminal_failed\"\n            )\n\n    def test_field_caps_budget_and_redaction_boundaries(self) -> None:\n        for field, limit in ((\"kind\", 64), (\"message\", 160), (\"reason\", 160)):\n            params: dict = {\"terminal\": \"failed\", \"error\": {}}\n            (params if field == \"reason\" else params[\"error\"])[field] = \"X\" * (\n                limit + 20\n            )\n            out = self._execute(params)\n            self.assertIn(\"X\" * limit, out[\"err\"])\n            self.assertNotIn(\"X\" * (limit + 1), out[\"err\"])\n        out = self._execute(\n            {\n                \"terminal\": \"failed\",\n                \"error\": {\n                    \"kind\": \"K\" * 90,\n                    \"message\": \"M\" * 200,\n                    \"retryable\": True,\n                    \"quota\": {\"data\": \"Q\" * 200},\n                },\n                \"reason\": \"R\" * 200,\n            },\n            True,\n        )\n        diagnostic = out[\"err\"].split(\"\\nnoise-\", 1)[0]\n        self.assertEqual(len(diagnostic), 300)\n        self.assertIn(\"K\" * 64, diagnostic)\n        self.assertIn(\"R\" * 16, diagnostic)\n        self.assertNotIn(\"quota=\", diagnostic)\n        self.assertNotIn(\"\\r\", diagnostic)\n        out = self._execute(\n            {\n                \"terminal\": \"failed\",\n                \"error\": {\"message\": \"m\" * 155 + \" api_key=canary_secret_val\"},\n            }\n        )\n        self.assertNotIn(\"canary\", out[\"err\"])\n        self.assertNotIn(\"[REDAC\", out[\"err\"].replace(\"[REDACTED]\", \"\"))\n\n\nclass SseDataKeepaliveTest(_BridgeScenario):\n    \"\"\"AD-003: S1/S2/S3 проверяют байты и события, без гонок очереди замка.\"\"\"\n\n    def _handler(self, writer: Any = None) -> Any:\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler._wlock = threading.Lock()\n        handler.wfile = writer if writer is not None else io.BytesIO()\n        handler._sse_open = True\n        return handler\n\n    def test_defaults_and_s3_seal_suppresses_late_tick_and_duplicate_done(self) -> None:\n        handler = self._handler()\n        other = self._handler()\n        self.assertEqual(handler._sse_phase, \"OPEN\")\n        self.assertIsNone(handler._keepalive_stop)\n        self.assertFalse(handler._client_gone)\n        handler._keepalive_stop = threading.Event()\n        self.assertIsNone(other._keepalive_stop)\n        handler._sse_stop_keepalive()\n        before = handler.wfile.getvalue()\n        self.assertFalse(\n            handler._sse_emit(handler._sse_chunk({\"content\": \"\"}), keepalive=True)\n        )\n        self.assertEqual(handler.wfile.getvalue(), before)\n        handler._send_sse(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0)\n        final = handler.wfile.getvalue()\n        self.assertTrue(final.endswith(b\"data: [DONE]\\n\\n\"))\n        self.assertEqual(handler._sse_phase, \"CLOSED\")\n        self.assertFalse(\n            handler._sse_emit(handler._sse_chunk({\"content\": \"\"}), keepalive=True)\n        )\n        self.assertFalse(handler._sse_write(\"data: [DONE]\\n\\n\"))\n        self.assertFalse(handler._sse_emit({\"late\": True}))\n        self.assertEqual(handler.wfile.getvalue(), final)\n\n    def test_s1_data_ticks_before_done_preserve_content_and_tools(self) -> None:\n        install_protocol_wrapper(self, {\"terminal\": \"completed\"}, delay=0.2)\n        self.mod.KEEPALIVE_S = 0.05\n        _, body = bridge_request(self, turn_request(True))\n        self.assertNotIn(b\": keepalive\", body)\n        self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n        frames = [\n            json.loads(line[6:])\n            for line in body.decode().splitlines()\n            if line.startswith(\"data: {\")\n        ]\n        deltas = [frame[\"choices\"][0][\"delta\"] for frame in frames]\n        self.assertTrue(any(delta == {\"content\": \"\"} for delta in deltas))\n        self.assertTrue(\n            all(frame[\"object\"] == \"chat.completion.chunk\" for frame in frames)\n        )\n        self.assertEqual(\"\".join(d.get(\"content\", \"\") for d in deltas), \"hello\")\n        tool_text = '<tool_call>{\"name\":\"read\",\"arguments\":{\"path\":\"a\"}}</tool_call>'\n        content, tools = self.mod._split_tool_calls([\"\", tool_text, \"\"])\n        self.assertEqual(content, \"\")\n        self.assertEqual(tools[0][\"function\"][\"name\"], \"read\")\n        self.assertEqual(json.loads(tools[0][\"function\"][\"arguments\"]), {\"path\": \"a\"})\n\n    def test_s2_inflight_flush_precedes_finalization(self) -> None:\n        entered, release = threading.Event(), threading.Event()\n\n        class Writer(io.BytesIO):\n            def flush(self) -> None:\n                if not entered.is_set():\n                    entered.set()\n                    if not release.wait(5):\n                        raise OSError(\"тест не отпустил flush\")\n\n        writer = Writer()\n        handler = self._handler(writer)\n        stop = threading.Event()\n        handler._keepalive_stop = stop\n        self.mod.KEEPALIVE_S = 0.01\n        ticker = threading.Thread(\n            target=handler._keepalive_loop, args=(stop,), daemon=True\n        )\n        handler._ka_thread = ticker\n        ticker.start()\n        self.addCleanup(release.set)\n        self.assertTrue(entered.wait(3))\n        finalizer = threading.Thread(\n            target=handler._send_sse,\n            args=(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0),\n            daemon=True,\n        )\n        finalizer.start()\n        try:\n            self.assertTrue(\n                stop.wait(3), \"остановка не использует единый _keepalive_stop\"\n            )\n            self.assertTrue(finalizer.is_alive())\n            self.assertNotIn(b\"[DONE]\", writer.getvalue())\n        finally:\n            release.set()\n            finalizer.join(5)\n            ticker.join(5)\n        self.assertFalse(finalizer.is_alive())\n        self.assertFalse(ticker.is_alive())\n        self.assertTrue(writer.getvalue().startswith(b\"data: {\"))\n        self.assertTrue(writer.getvalue().endswith(b\"data: [DONE]\\n\\n\"))\n\n    def test_done_write_failure_closes_phase(self) -> None:\n        class BrokenWriter(io.BytesIO):\n            def write(self, data: object) -> int:\n                raise OSError(\"closed peer\")\n\n        handler = self._handler(BrokenWriter())\n        self.assertFalse(handler._sse_write(\"data: [DONE]\\n\\n\"))\n        self.assertEqual(handler._sse_phase, \"CLOSED\")\n        self.assertTrue(handler._client_gone)\n\n\nclass CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n    \"\"\"AD-004: реальные argv фейка и неизменный approval fallback.\"\"\"\n\n    def test_serve_argv_disables_write_shell(self) -> None:\n        install_protocol_wrapper(self, {\"terminal\": \"completed\"})\n        self.assertEqual(bridge_request(self, turn_request())[0], 200)\n        argv = json.loads((self.tmp / \"serve-argv.json\").read_text())\n        for flag in (\n            \"--disable-write\",\n            \"--disable-shell\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            \"muse-spark-1.3\",\n            \"--no-session-log\",\n            \"--trust-workspace\",\n        ):\n            self.assertIn(flag, argv)\n\n    def test_approval_falls_back_to_exec_without_decide(self) -> None:\n        install_protocol_wrapper(self, {\"approval\": True})\n        status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        self.assertIn(\"fallback-ok\", body.decode())\n        argv = json.loads((self.tmp / \"exec-argv.json\").read_text())\n        for flag in (\n            \"--disable-write\",\n            \"--disable-shell\",\n            \"--disable-web-tools\",\n            \"--disable-reminders\",\n            \"--yolo\",\n            \"--provider\",\n            \"meta\",\n            \"--model\",\n            \"--reasoning-effort\",\n            \"--trust-workspace\",\n            \"--workspace\",\n            \"--json\",\n            \"--no-session-log\",\n            \"--prompt-file\",\n        ):\n            self.assertIn(flag, argv)\n        self.assertNotIn(\"approval/decide\", (self.tmp / \"rpc.jsonl\").read_text())\n        self.assertIn(\n            \"serve unavailable (serve needs interaction (approval/request)), fallback exec\",\n            self.mod.LOG_PATH.read_text(),\n        )\n\n\nclass AllowedModelsSyncTest(_BridgeScenario):\n    \"\"\"T-00 / AD-001: wonder-модели объявляют context_length=400000, spark без изменений.\"\"\"\n\n    def test_t00_models_and_health_include_wonder_models_400k(self) -> None:\n        wonder_models = (\"muse-wonder-1.0\", \"muse-wonder-full-1.0\")\n        for model in wonder_models:\n            self.assertEqual(\n                self.mod.ALLOWED_MODELS.get(model),\n                {\"context_length\": 400_000, \"max_output\": 131072},\n            )\n        spark_models = (\"muse-spark-1.3\", \"muse-spark-1.3-contributor\")\n        for model in spark_models:\n            self.assertEqual(\n                self.mod.ALLOWED_MODELS.get(model),\n                {\"context_length\": 1048576, \"max_output\": 131072},\n            )\n        status, health_body = bridge_request(self, path=\"/health\")\n        self.assertEqual(status, 200)\n        health_data = json.loads(health_body.decode(\"utf-8\"))\n        for model in wonder_models:\n            self.assertIn(model, health_data[\"models\"])\n\n        status, models_body = bridge_request(self, path=\"/v1/models\")\n        self.assertEqual(status, 200)\n        by_id = {\n            item[\"id\"]: item[\"context_length\"]\n            for item in json.loads(models_body.decode(\"utf-8\"))[\"data\"]\n        }\n        for model in wonder_models:\n            self.assertEqual(by_id.get(model), 400_000)\n        for model in spark_models:\n            self.assertEqual(by_id.get(model), 1048576)\n\n        for patch_rel in (\n            \".dsh/profiles/desktop/cordis.patch.yml\",\n            \".dsh/profiles/web/cordis.patch.yml\",\n        ):\n            patch_path = Path.home() / patch_rel\n            if patch_path.exists():\n                content = patch_path.read_text(encoding=\"utf-8\")\n                for model in wonder_models:\n                    m = re.search(\n                        rf\"-\\s+id:\\s+{re.escape(model)}\\b.*?contextWindow:\\s+(\\d+)\",\n                        content,\n                        flags=re.DOTALL,\n                    )\n                    self.assertIsNotNone(m, f\"{model} not found in {patch_path}\")\n                    assert m is not None\n                    self.assertEqual(\n                        int(m.group(1)),\n                        400_000,\n                        f\"wrong contextWindow for {model} in {patch_path}\",\n                    )\n                for model in spark_models:\n                    m = re.search(\n                        rf\"-\\s+id:\\s+{re.escape(model)}\\b.*?contextWindow:\\s+(\\d+)\",\n                        content,\n                        flags=re.DOTALL,\n                    )\n                    self.assertIsNotNone(m, f\"{model} not found in {patch_path}\")\n                    assert m is not None\n                    self.assertEqual(\n                        int(m.group(1)),\n                        1048576,\n                        f\"wrong contextWindow for {model} in {patch_path}\",\n                    )\n\n\nclass ContextEstimateTest(unittest.TestCase):\n    \"\"\"T-01..T-02: оценка токенов и вывод лимитов из ALLOWED_MODELS.\"\"\"\n\n    def test_t01_estimate_tokens_latin_cyrillic_code_json_empty(self) -> None:\n        mod = load_bridge()\n        self.assertEqual(mod._estimate_tokens(\"\"), 0)\n        latin = \"a\" * 900\n        self.assertEqual(mod._estimate_tokens(latin), 300)\n        cyrillic = \"я\" * 1000\n        self.assertEqual(mod._estimate_tokens(cyrillic), 666)\n        code_sample = \"def foo(x: int) -> int:\\n    return x * 42\\n\" * 30\n        json_sample = json.dumps(\n            {\"ключ\": \"значение\", \"nums\": list(range(50))}, ensure_ascii=False\n        )\n        for sample in (latin, cyrillic, code_sample, json_sample, \"🌟\" * 90):\n            expected = max(len(sample) // 3, len(sample.encode(\"utf-8\")) // 3)\n            self.assertEqual(mod._estimate_tokens(sample), expected)\n\n    def test_t02_context_limit_and_derived_targets(self) -> None:\n        mod = load_bridge()\n        self.assertEqual(mod._context_limit(\"muse-wonder-1.0\"), 400_000)\n        self.assertEqual(mod._context_limit(\"muse-wonder-full-1.0\"), 400_000)\n        self.assertEqual(mod._context_limit(\"muse-spark-1.3\"), 1048576)\n        self.assertEqual(mod._context_limit(\"unknown-model-id\"), 400_000)\n        self.assertEqual(mod._context_target(400_000), 320_000)\n        self.assertEqual(mod._context_retry_target(400_000), 200_000)\n        with mock.patch.dict(\n            mod.ALLOWED_MODELS,\n            {\"muse-wonder-1.0\": {\"context_length\": 250_000, \"max_output\": 131072}},\n        ):\n            lim = mod._context_limit(\"muse-wonder-1.0\")\n            self.assertEqual(lim, 250_000)\n            self.assertEqual(mod._context_target(lim), 200_000)\n            self.assertEqual(mod._context_retry_target(lim), 125_000)\n\n\nclass ContextPruneTest(unittest.TestCase):\n    \"\"\"T-03..T-11, T-13..T-14: защитный прунинг истории диалога.\"\"\"\n\n    mod: Any = None\n\n    def setUp(self) -> None:\n        self.mod = load_bridge()\n\n    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n        # \"User: \" — 6 байт. Для оценки ровно N токенов при 1 реплике и другой реплике:\n        # соберём историю из 3 сообщений и подгоним байты под точный порог limit=1000.\n        limit = 1000\n        target = 800\n        m1 = {\"role\": \"user\", \"content\": \"first-user\"}\n        m3 = {\"role\": \"user\", \"content\": \"last-user\"}\n        base_prompt = self.mod._assemble_prompt(\n            [m1, {\"role\": \"assistant\", \"content\": \"\"}, m3]\n        )[2]\n        # Проверим на точной длине промпта:\n        # \"User: first-user\\n\\nAssistant: <X>\\n\\nUser: last-user\"\n        prefix_overhead = len(\n            \"User: first-user\\n\\nAssistant: \\n\\nUser: last-user\".encode(\"utf-8\")\n        )\n        for desired_est, should_prune in (\n            (limit - 1, False),\n            (limit, False),\n            (limit + 1, True),\n        ):\n            needed_bytes = desired_est * 3 - prefix_overhead\n            m2 = {\"role\": \"assistant\", \"content\": \"x\" * needed_bytes}\n            msgs = [m1, m2, m3]\n            res = self.mod._prune_messages(msgs, limit=limit, target=target)\n            self.assertEqual(res.est_before, desired_est)\n            if not should_prune:\n                self.assertEqual(res.status, \"pass_through\")\n                self.assertIs(res.messages, msgs)\n                self.assertNotIn(self.mod.COMPACTION_MARKER, res.prompt)\n            else:\n                self.assertEqual(res.status, \"pruned\")\n                self.assertLessEqual(res.est_after, target)\n                self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n                self.assertEqual(res.msgs_dropped, 1)\n        _ = base_prompt\n\n    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n        self,\n    ) -> None:\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": f\"tool_{i}\",\n                    \"description\": \"Описание инструмента \" * 40,\n                    \"parameters\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"arg\": {\"type\": \"string\", \"description\": \"d\" * 200}\n                        },\n                    },\n                },\n            }\n            for i in range(25)\n        ]\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"System instructions \" * 500},\n            {\"role\": \"user\", \"content\": \"Initial task description \" * 200},\n        ]\n        # Добавим 30 реплик по ~45k байт (~15k токенов каждая) -> ~450k токенов (> 400k).\n        for i in range(30):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append({\"role\": role, \"content\": f\"turn-{i} \" + (\"payload \" * 5600)})\n        msgs.append({\"role\": \"user\", \"content\": \"Final user question\"})\n\n        res = self.mod._prune_messages(\n            msgs, limit=400_000, target=320_000, tools=tools, tool_choice=\"auto\"\n        )\n        self.assertEqual(res.status, \"pruned\")\n        self.assertGreater(res.est_before, 400_000)\n        actual_est = self.mod._estimate_tokens(res.prompt)\n        self.assertEqual(res.est_after, actual_est)\n        self.assertLessEqual(actual_est, 320_000)\n        self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n        self.assertIn(\"# Tool calling protocol\", res.prompt)\n\n    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys-early\"},\n            {\"role\": \"user\", \"content\": \"user-first\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"developer\", \"content\": \"dev-mid-insertion\"},\n            {\"role\": \"user\", \"content\": \"U\" * 3000},\n            {\"role\": \"assistant\", \"content\": \"B\" * 3000},\n            {\"role\": \"system\", \"content\": \"sys-late-insertion\"},\n            {\"role\": \"user\", \"content\": \"user-last\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=1500, target=1000)\n        self.assertEqual(res.status, \"pruned\")\n        for needle in (\n            \"sys-early\",\n            \"dev-mid-insertion\",\n            \"sys-late-insertion\",\n            \"user-first\",\n            \"user-last\",\n        ):\n            self.assertIn(needle, res.prompt)\n        # Если в истории только один user — он не дублируется.\n        single_user_msgs = [\n            {\"role\": \"system\", \"content\": \"sys-1\"},\n            {\"role\": \"user\", \"content\": \"only-one-user\"},\n            {\"role\": \"assistant\", \"content\": \"X\" * 6000},\n        ]\n        res_single = self.mod._prune_messages(single_user_msgs, limit=1000, target=500)\n        self.assertEqual(res_single.status, \"pruned\")\n        self.assertEqual(res_single.prompt.count(\"only-one-user\"), 1)\n\n    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"user\", \"content\": \"first-user\"},\n            {\"role\": \"assistant\", \"content\": \"early-assistant-\" + (\"x\" * 300)},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_a1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f1\", \"arguments\": \"{}\"},\n                    },\n                    {\n                        \"id\": \"call_a2\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f2\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a1\",\n                \"name\": \"f1\",\n                \"content\": \"res_a1_\" + (\"y\" * 300),\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a2\",\n                \"name\": \"f2\",\n                \"content\": \"res_a2_\" + (\"z\" * 300),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"thinking\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_b1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f3\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_b1\",\n                \"name\": \"f3\",\n                \"content\": \"res_b1_\" + (\"w\" * 300),\n            },\n            {\"role\": \"user\", \"content\": \"last-user\"},\n        ]\n        full_est = self.mod._estimate_tokens(self.mod._assemble_prompt(msgs)[2])\n        for target in range(80, full_est + 20, 15):\n            res = self.mod._prune_messages(msgs, limit=full_est - 1, target=target)\n            self.assertNotEqual(res.status, \"refused\")\n            kept_call_ids: set[str] = set()\n            expected_tool_ids: dict[str, set[str]] = {}\n            actual_tool_ids: set[str] = set()\n            for m in res.messages:\n                if m.get(\"role\") == \"assistant\" and m.get(\"tool_calls\"):\n                    cids = {tc[\"id\"] for tc in m[\"tool_calls\"]}\n                    kept_call_ids |= cids\n                    expected_tool_ids[m[\"tool_calls\"][0][\"id\"]] = cids\n                elif m.get(\"role\") == \"tool\":\n                    actual_tool_ids.add(m[\"tool_call_id\"])\n            # Инвариант I-1: нет tool без вызова и нет частичного сохранения многовызовного хода.\n            self.assertEqual(\n                actual_tool_ids,\n                kept_call_ids,\n                f\"нарушена атомарность при target={target}\",\n            )\n            for group_ids in expected_tool_ids.values():\n                self.assertTrue(group_ids.issubset(actual_tool_ids))\n\n    def test_t07_orphan_tool_dropped_on_prune_kept_on_passthrough(self) -> None:\n        orphan = {\n            \"role\": \"tool\",\n            \"tool_call_id\": \"orphan_id_999\",\n            \"name\": \"ghost\",\n            \"content\": \"orphan-body\",\n        }\n        msgs = [\n            {\"role\": \"user\", \"content\": \"u1\"},\n            orphan,\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        passthru = self.mod._prune_messages(msgs, limit=5000, target=4000)\n        self.assertEqual(passthru.status, \"pass_through\")\n        self.assertIn(orphan, passthru.messages)\n        self.assertIn(\"orphan-body\", passthru.prompt)\n\n        pruned = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(pruned.status, \"pruned\")\n        self.assertNotIn(orphan, pruned.messages)\n        self.assertNotIn(\"orphan-body\", pruned.prompt)\n\n    def test_t08_cyrillic_triggers_prune_when_bytes_exceed_limit(self) -> None:\n        # 900 кириллических символов = 300 chars//3, но 1800 байт = 600 bytes//3.\n        # При limit=450 chars//3 < limit < bytes//3 -> прунинг обязан сработать.\n        msgs = [\n            {\"role\": \"user\", \"content\": \"первый\"},\n            {\"role\": \"assistant\", \"content\": \"ж\" * 900},\n            {\"role\": \"user\", \"content\": \"последний\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=450, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertLessEqual(res.est_after, 300)\n        self.assertNotIn(\"ж\" * 100, res.prompt)\n\n    def test_t09_multipart_none_empty_non_dict_unknown_role(self) -> None:\n        msgs: list[Any] = [\n            \"not-a-dict\",\n            123,\n            {\"role\": \"user\", \"content\": None},\n            {\"role\": \"user\", \"content\": \"   \"},\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": \"real-first-user\"},\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\"url\": \"http://example.com/a.png\"},\n                    },\n                ],\n            },\n            {\"role\": \"custom_unknown_role\", \"content\": \"middle-\" + (\"M\" * 3000)},\n            {\"role\": \"user\", \"content\": \"real-last-user\"},\n            {\"role\": \"user\", \"content\": \"\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertIn(\"real-first-user\", res.prompt)\n        self.assertIn(\"[image omitted]\", res.prompt)\n        self.assertIn(\"real-last-user\", res.prompt)\n        self.assertNotIn(\"middle-M\", res.prompt)\n\n    def test_t10_marker_placement_chronology_determinism_and_idempotency(self) -> None:\n        # Сценарий с двумя разрывами:\n        # U0(first_user), U1(dropped), U2(last_user), U3(dropped tool group), U4(kept trailing tool group)\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-top\"},\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"drop-1-\" + (\"A\" * 1500)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_drop\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_drop\",\n                \"name\": \"f\",\n                \"content\": \"drop-2-\" + (\"B\" * 1500),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_keep\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_keep\",\n                \"name\": \"f\",\n                \"content\": \"keep-trail\",\n            },\n        ]\n        res1 = self.mod._prune_messages(msgs, limit=600, target=400)\n        res2 = self.mod._prune_messages(msgs, limit=600, target=400)\n        self.assertEqual(res1.status, \"pruned\")\n        self.assertEqual(res1.prompt, res2.prompt)\n        self.assertEqual(res1.messages, res2.messages)\n        # Ровно два маркера в двух разрывах.\n        self.assertEqual(res1.prompt.count(self.mod.COMPACTION_MARKER), 2)\n        p_first = res1.prompt.index(\"User: first-u\")\n        p_m1 = res1.prompt.index(self.mod.COMPACTION_MARKER)\n        p_last = res1.prompt.index(\"User: last-u\")\n        p_m2 = res1.prompt.rindex(self.mod.COMPACTION_MARKER)\n        p_trail = res1.prompt.index(\"keep-trail\")\n        self.assertTrue(p_first < p_m1 < p_last < p_m2 < p_trail)\n\n        # Идемпотентность: повторный вызов с теми же параметрами и с принудительным порогом.\n        idem1 = self.mod._prune_messages(res1.messages, limit=600, target=400)\n        self.assertEqual(idem1.prompt, res1.prompt)\n        self.assertEqual(idem1.messages, res1.messages)\n        idem2 = self.mod._prune_messages(\n            res1.messages, limit=res1.est_after - 1, target=res1.est_after\n        )\n        self.assertEqual(idem2.prompt, res1.prompt)\n        self.assertEqual(idem2.messages, res1.messages)\n\n    def test_t11_input_not_mutated_and_wlock_not_held_during_prune(self) -> None:\n        import copy\n\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys\"},\n            {\"role\": \"user\", \"content\": \"u1\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        snapshot = copy.deepcopy(msgs)\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertEqual(msgs, snapshot)\n        for m in res.messages:\n            if m.get(\"role\") != self.mod._COMPACTION_MARKER_ROLE:\n                self.assertTrue(any(m is orig for orig in msgs))\n\n        # Проверка в Handler._serve_json: во время _prune_messages замок self._wlock не захвачен.\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler.connection = None\n        handler._wlock = threading.Lock()\n        handler._client_gone = False\n        handler._current_run = None\n        handler._sse_open = False\n        handler._content_started = False\n        lock_states: list[bool] = []\n        orig_prune = self.mod._prune_messages\n\n        def spy_prune(*args: Any, **kwargs: Any) -> Any:\n            lock_states.append(handler._wlock.locked())\n            return orig_prune(*args, **kwargs)\n\n        with (\n            mock.patch.object(self.mod, \"_prune_messages\", side_effect=spy_prune),\n            mock.patch.object(\n                self.mod.ServeRun,\n                \"execute\",\n                return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n            ),\n            mock.patch.object(handler, \"_send\"),\n        ):\n            handler._serve_json({\"model\": \"muse-wonder-1.0\", \"messages\": msgs})\n        self.assertEqual(lock_states, [False])\n\n    def test_t13_trailing_incomplete_tool_unit_kept_or_refused_if_exceeds_cap(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"mid-\" + (\"M\" * 2000)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_tail\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"bash\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_tail\",\n                \"name\": \"bash\",\n                \"content\": \"tool-output-\" + (\"T\" * 600),\n            },\n        ]\n        # Обязательный набор (first-u + last-u + trailing tool unit + маркер) ~ 260 токенов.\n        # Пусть limit=500, target=200: обязательный набор > target (200), но <= cap (500) -> сохраняется!\n        res_ok = self.mod._prune_messages(msgs, limit=500, target=200)\n        self.assertEqual(res_ok.status, \"pruned\")\n        self.assertIn(\"tool-output-\", res_ok.prompt)\n        self.assertNotIn(\"mid-M\", res_ok.prompt)\n        self.assertLessEqual(res_ok.est_after, 500)\n\n        # Если же обязательный набор с незавершённой единицей > cap (limit=200) -> отказ.\n        res_refused = self.mod._prune_messages(msgs, limit=200, target=160)\n        self.assertEqual(res_refused.status, \"refused\")\n\n    def test_t14_hysteresis_prefix_stability_and_399999_passthrough(self) -> None:\n        # 399_999 не прунится при limit=400_000.\n        prefix_len = len(\"User: \".encode(\"utf-8\"))\n        exact_bytes = 399_999 * 3 - prefix_len\n        msg_399k = [{\"role\": \"user\", \"content\": \"a\" * exact_bytes}]\n        res_399k = self.mod._prune_messages(msg_399k, limit=400_000, target=320_000)\n        self.assertEqual(res_399k.est_before, 399_999)\n        self.assertEqual(res_399k.status, \"pass_through\")\n\n        # Два хода подряд с ростом > 400k: префикс (system, tools, первый user, маркер) побайтно одинаков.\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\"name\": \"t1\", \"description\": \"d\", \"parameters\": {}},\n            }\n        ]\n        base_msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"stable-system-prompt\"},\n            {\"role\": \"user\", \"content\": \"stable-first-user\"},\n        ]\n        for i in range(15):\n            base_msgs.append(\n                {\n                    \"role\": \"assistant\" if i % 2 == 0 else \"user\",\n                    \"content\": f\"m{i}-\" + (\"X\" * 90_000),\n                }\n            )\n        turn1 = base_msgs + [{\"role\": \"user\", \"content\": \"question-1\"}]\n        turn2 = turn1 + [\n            {\"role\": \"assistant\", \"content\": \"answer-1-\" + (\"Y\" * 30_000)},\n            {\"role\": \"user\", \"content\": \"question-2\"},\n        ]\n        r1 = self.mod._prune_messages(turn1, limit=400_000, target=320_000, tools=tools)\n        r2 = self.mod._prune_messages(turn2, limit=400_000, target=320_000, tools=tools)\n        self.assertEqual(r1.status, \"pruned\")\n        self.assertEqual(r2.status, \"pruned\")\n        marker_end_1 = r1.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        marker_end_2 = r2.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        self.assertEqual(\n            r1.prompt[:marker_end_1].encode(\"utf-8\"),\n            r2.prompt[:marker_end_2].encode(\"utf-8\"),\n        )\n\n\nclass ContextRetryTest(_BridgeScenario):\n    \"\"\"T-12, T-15..T-22: аварийный auto-retry при ошибке жёсткого порога Meta.\"\"\"\n\n    def _over_budget_messages(\n        self, chunk_bytes: int = 110_000, count: int = 12\n    ) -> list[dict[str, Any]]:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-canary-head\"},\n            {\"role\": \"user\", \"content\": \"first-user-canary\"},\n        ]\n        for i in range(count):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append(\n                {\"role\": role, \"content\": f\"mid-canary-{i}-\" + (\"M\" * chunk_bytes)}\n            )\n        msgs.append({\"role\": \"user\", \"content\": \"last-user-canary\"})\n        return msgs\n\n    def test_t12_mandatory_exceeds_limit_returns_502_before_run(self) -> None:\n        huge_canary = \"MANDATORY_SECRET_CANARY_\" + (\"Z\" * 1_250_000)\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": [{\"role\": \"user\", \"content\": huge_canary}],\n            \"stream\": False,\n        }\n        with (\n            mock.patch.object(self.mod, \"ServeRun\") as serve_cls,\n            mock.patch.object(self.mod, \"Run\") as run_cls,\n        ):\n            status, body = bridge_request(self, payload)\n            self.assertEqual(status, 502)\n            serve_cls.assert_not_called()\n            run_cls.assert_not_called()\n        self.assertTrue(self._slot_free())\n        err = json.loads(body.decode(\"utf-8\"))[\"error\"]\n        self.assertIn(\"mandatory context exceeds budget\", err[\"message\"])\n        self.assertIn(\"limit=400000\", err[\"message\"])\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"reason=refused_mandatory\", logs)\n        self.assertNotIn(\"MANDATORY_SECRET_CANARY_\", body.decode(\"utf-8\") + logs)\n\n    def test_t15_hard_threshold_error_triggers_single_retry_and_succeeds(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(639915 >= 460800 tokens) retryable=True\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                prompts_seen: list[str] = []\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    prompts_seen.append(run_self.prompt)\n                    if len(prompts_seen) == 1:\n                        return {\n                            \"rc\": 1,\n                            \"state\": \"terminal_failed\",\n                            \"text\": \"\",\n                            \"err\": hard_err,\n                            \"via\": \"serve\",\n                        }\n                    return {\n                        \"rc\": 0,\n                        \"state\": \"ok\",\n                        \"text\": \"recovered-ok\",\n                        \"chunks\": [\"recovered-ok\"],\n                        \"err\": \"\",\n                        \"summaries\": [],\n                        \"usage\": {\"promptTokens\": 150000, \"outputTokens\": 5},\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(status, 200)\n                self.assertEqual(len(prompts_seen), 2)\n                est1 = self.mod._estimate_tokens(prompts_seen[0])\n                est2 = self.mod._estimate_tokens(prompts_seen[1])\n                self.assertLessEqual(est1, 320_000)\n                self.assertLessEqual(est2, 200_000)\n                self.assertLess(est2, est1)\n                text_body = body.decode(\"utf-8\")\n                self.assertIn(\"recovered-ok\", text_body)\n                if stream:\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    frames = [\n                        json.loads(line[6:])\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                    ]\n                    self.assertFalse(any(\"error\" in f for f in frames))\n\n    def test_t16_hard_threshold_error_twice_returns_terminal_502(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(500000 >= 460800 tokens) prompt-canary-reflected\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                calls = 0\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    nonlocal calls\n                    calls += 1\n                    return {\n                        \"rc\": 1,\n                        \"state\": \"terminal_failed\",\n                        \"text\": \"\",\n                        \"err\": hard_err + \" \" + run_self.prompt,\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-full-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(calls, 2)\n                text_body = body.decode(\"utf-8\")\n                if stream:\n                    self.assertEqual(status, 200)\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    err_frames = [\n                        json.loads(line[6:])[\"error\"]\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                        and \"error\" in json.loads(line[6:])\n                    ]\n                    self.assertEqual(len(err_frames), 1)\n                    err_obj = err_frames[0]\n                else:\n                    self.assertEqual(status, 502)\n                    err_obj = json.loads(text_body)[\"error\"]\n                self.assertEqual(err_obj[\"type\"], \"proxy_error\")\n                self.assertEqual(err_obj[\"code\"], 502)\n                self.assertIn(\n                    \"context hard threshold exceeded after single compaction retry\",\n                    err_obj[\"message\"],\n                )\n                self.assertIn(\"target=200000\", err_obj[\"message\"])\n                logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n                for canary in (\n                    \"sys-canary-head\",\n                    \"first-user-canary\",\n                    \"mid-canary-\",\n                    \"last-user-canary\",\n                ):\n                    self.assertNotIn(canary, text_body + logs)\n\n    def test_t17_other_error_or_marker_in_normal_text_does_not_retry(self) -> None:\n        self.assertEqual(\n            self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            \"context compaction replacement still exceeds the hard threshold\",\n        )\n        # 1) Другая ошибка в err -> 1 попытка.\n        calls = 0\n\n        def other_err(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": \"quota_exceeded\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with mock.patch.object(self.mod.ServeRun, \"execute\", other_err):\n            status, _ = bridge_request(self, payload)\n        self.assertEqual(status, 502)\n        self.assertEqual(calls, 1)\n\n        # 2) Подстрока в обычном ответе модели (rc=0, state=\"ok\") -> 1 попытка, 200 OK.\n        calls = 0\n\n        def marker_in_text(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\",\n                \"chunks\": [\n                    f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\"\n                ],\n                \"err\": \"\",\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", marker_in_text):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(calls, 1)\n        self.assertIn(self.mod.HARD_THRESHOLD_ERR_SUBSTR, body.decode(\"utf-8\"))\n\n    def test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget(\n        self,\n    ) -> None:\n        exec_prompts: list[str] = []\n\n        def fail_serve(_self: Any) -> dict[str, Any]:\n            raise self.mod.ServeUnavailable(\"serve down\")\n\n        def fake_exec(run_self: Any) -> dict[str, Any]:\n            exec_prompts.append(run_self.prompt)\n            n = len(exec_prompts)\n            if n == 1:\n                # Сетевой маркер на первой попытке -> сетевой ретрай с тем же промптом.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"nonzero_exit\",\n                    \"text\": \"\",\n                    \"err\": self.mod.NETWORK_RETRY_MARKER,\n                }\n            if n == 2:\n                # Сетевой ретрай вернул ошибку порога Meta -> должен сработать контекстный retry.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"terminal_failed\",\n                    \"text\": \"\",\n                    \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n                }\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": \"exec-recovered\",\n                \"chunks\": [\"exec-recovered\"],\n                \"err\": \"\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with (\n            mock.patch.object(self.mod.ServeRun, \"execute\", fail_serve),\n            mock.patch.object(self.mod.Run, \"execute\", fake_exec),\n        ):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(len(exec_prompts), 3)\n        self.assertEqual(exec_prompts[0], exec_prompts[1])\n        self.assertLess(\n            self.mod._estimate_tokens(exec_prompts[2]),\n            self.mod._estimate_tokens(exec_prompts[0]),\n        )\n        self.assertIn(\"exec-recovered\", body.decode(\"utf-8\"))\n\n    def test_t19_client_disconnect_between_attempts_skips_second_run(self) -> None:\n        calls = 0\n        first_entered = threading.Event()\n        release_first = threading.Event()\n\n        def fake_execute(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            first_entered.set()\n            release_first.wait(5)\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n            body = json.dumps(\n                {\n                    \"model\": \"muse-wonder-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                }\n            ).encode(\"utf-8\")\n            head = (\n                \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n                \"Host: 127.0.0.1\\r\\n\"\n                \"Content-Type: application/json\\r\\n\"\n                f\"Content-Length: {len(body)}\\r\\n\"\n                \"Connection: close\\r\\n\\r\\n\"\n            ).encode(\"utf-8\")\n            sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n            sock.sendall(head + body)\n            self.assertTrue(first_entered.wait(5))\n            sock.close()\n            time.sleep(0.35)\n            release_first.set()\n            self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n        self.assertEqual(calls, 1)\n        log_text = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n\n<system-reminder>[Showing lines 1081-2160 of 2367 total lines]</system-reminder>","timestamp":1791993025265,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
