{"type":"tool_result","id":"tc-fdxqp4015es","messageId":"6b5ffa2a-22d1-4434-a8e4-3a7862bc93eb","toolId":"Read","isError":false,"value":"diff --git a/bridges/muse-bridge/server.py b/bridges/muse-bridge/server.py\nindex d351b6e..7cc1064 100644\n--- a/bridges/muse-bridge/server.py\n+++ b/bridges/muse-bridge/server.py\n@@ -14,7 +14,8 @@ Stdout CLI — JSONL-конверты (schema_version=1). Текст ответ\n `task.lifecycle.failed` (event.reason). Usage CLI в JSONL не отдаёт — оценка по словам.\n \n Транспорт — stdlib. `stream:true`: заголовки 200 и role-delta уходят сразу, пока ход\n-идёт — комментарии `: keepalive` (MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\n+идёт — data-чанки `chat.completion.chunk` с пустой дельтой `{\"content\": \"\"}`\n+(MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\n summaries как `delta.reasoning_content`, tool_calls, content-чанки (~300 символов), финал\n с finish_reason + usage, затем `data: [DONE]`. Ошибка после старта потока — кадр\n `{\"error\": …}` + `[DONE]`. Текст ответа CLI отдаёт в конце хода, поэтому content\n@@ -23,10 +24,9 @@ summaries как `delta.reasoning_content`, tool_calls, content-чанки (~300\n Провал хода (failed terminal, rc != 0, таймаут) не отдаётся как успешный финал: частичный\n текст и tool-блоки отбрасываются — SSE-кадр ошибки + `[DONE]` (stream) либо 502 (JSON).\n \n-Keepalive: комментарии `: keepalive` держат TCP-соединение от закрытия клиентом/прокси, но\n-SDK отбрасывает их на уровне декодера и idle-watchdog не сбрасывают. Поэтому после применения\n-профиля muse (`streamIdleTimeoutMs=1900000`) DSH нужно перезапустить; сброс watchdog кадрами\n-данных (полный стрим текста muse) в этот мост не входит.\n+Keepalive: пустые data-чанки держат SSE-соединение, не меняя текст ответа.\n+Сброс idle-watchdog клиента pi-ai требует отдельной живой проверки в DSH.\n+Перед финалом поток запечатывается; после `data: [DONE]` записей нет.\n \n Эмуляция OpenAI function calling (порт из droid-bridge): если запрос содержит\n непустой `tools` (и tool_choice != \"none\"), в системный текст добавляется протокол\n@@ -39,6 +39,7 @@ SDK отбрасывает их на уровне декодера и idle-watch\n from __future__ import annotations\n \n import json\n+import logging\n import os\n import random\n import re\n@@ -53,7 +54,9 @@ import time\n import uuid\n from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n from pathlib import Path\n-from typing import Any\n+from typing import Any, NamedTuple\n+\n+logger = logging.getLogger(\"muse-bridge\")\n \n HOST = os.environ.get(\"MUSE_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\n PORT = int(os.environ.get(\"MUSE_BRIDGE_PORT\", \"9886\"))\n@@ -74,8 +77,20 @@ ALLOWED_MODELS: dict[str, dict[str, Any]] = {\n     # 2026-10-05: контрибьютор-слот (только пикер, по просьбе владельца).\n     # id подтверждён `muse model-profile show` (резолвится); окно/лимит как у spark.\n     \"muse-spark-1.3-contributor\": {\"context_length\": 1048576, \"max_output\": 131072},\n+    \"muse-wonder-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n+    \"muse-wonder-full-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n }\n-DEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-spark-1.3\")\n+DEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-wonder-full-1.0\")\n+DEFAULT_CONTEXT_LIMIT = 400_000\n+\n+# Подстрока ошибки жёсткого порога контекста Meta (ADR-001.3, [F-01]).\n+HARD_THRESHOLD_ERR_SUBSTR = (\n+    \"context compaction replacement still exceeds the hard threshold\"\n+)\n+COMPACTION_MARKER = (\n+    \"[... earlier conversation turns compacted to stay within Muse context limit ...]\"\n+)\n+_COMPACTION_MARKER_ROLE = \"__compaction_marker__\"\n \n # OpenAI/DSH effort -> `--reasoning-effort` Muse CLI. Нет/неизвестно -> max (канон слота).\n EFFORT_MAP: dict[str, str] = {\n@@ -154,7 +169,8 @@ _LOG_LOCK = threading.Lock()\n \n \n def _log(msg: str) -> None:\n-    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\"\n+    safe_msg = _redact_secrets(msg)\n+    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {safe_msg}\"\n     sys.stderr.write(line + \"\\n\")\n     sys.stderr.flush()\n     try:\n@@ -172,6 +188,140 @@ def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n     return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n \n \n+def _redact_secrets(text: str) -> str:\n+    \"\"\"Удалить отражённые ключи до обрезки диагностики; повторный вызов безопасен.\"\"\"\n+    if AUTH_KEY:\n+        text = text.replace(AUTH_KEY, \"[REDACTED]\")\n+    text = re.sub(\n+        r\"Authorization\\s*:\\s*[^\\r\\n]+\",\n+        \"Authorization: [REDACTED]\",\n+        text,\n+        flags=re.IGNORECASE,\n+    )\n+    text = re.sub(r\"Bearer\\s+\\S+\", \"Bearer [REDACTED]\", text, flags=re.IGNORECASE)\n+    text = re.sub(\n+        r\"\"\"([\"']?(?:api[_-]?key|token|secret|password|bridge[_-]?key)[\"']?\\s*[:=]\\s*)(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^\\s,;}\"']+)\"\"\",\n+        lambda match: match[1] + \"[REDACTED]\",\n+        text,\n+        flags=re.IGNORECASE,\n+    )\n+    return re.sub(r\"sk-[A-Za-z0-9_-]{12,}\", \"[REDACTED]\", text)\n+\n+\n+def _clip_diagnostic(text: str, limit: int) -> str:\n+    \"\"\"Ограничить поле, убрав его целиком при разрезании маркера редакции.\"\"\"\n+    for marker in re.finditer(re.escape(\"[REDACTED]\"), text):\n+        if marker.start() < limit < marker.end():\n+            return \"\"\n+    return text[:limit]\n+\n+\n+def _prompt_reflected_parts(prompt: str) -> list[str]:\n+    \"\"\"Выделить длинные отражённые реплики, начиная с самых полных совпадений.\"\"\"\n+    parts = {prompt} if len(prompt.strip()) >= 8 else set()\n+    for part in prompt.split(\"\\n\\n\") + prompt.splitlines():\n+        for candidate in (part, re.sub(r\"^(?:User|Assistant|System):\\s*\", \"\", part)):\n+            if len(candidate.strip()) >= 8:\n+                parts.add(candidate)\n+    return sorted(parts, key=len, reverse=True)\n+\n+\n+def _diagnostic_text(value: Any, prompt: str = \"\") -> str:\n+    \"\"\"Санитизировать свободное поле и нормализовать управляющие переводы строк.\"\"\"\n+    text = str(value) if value is not None else \"\"\n+    text = _redact_secrets(text)\n+    parts = _prompt_reflected_parts(prompt)\n+    for part in parts:\n+        text = text.replace(part, \"[REDACTED]\")\n+    control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n+    text = re.sub(control_chars, \" \", text).strip()\n+    for part in parts:\n+        normalized = re.sub(control_chars, \" \", part).strip()\n+        text = text.replace(normalized, \"[REDACTED]\")\n+    return text\n+\n+\n+def _redact_quota(value: Any) -> Any:\n+    \"\"\"Удалить значения чувствительных ключей quota до JSON-сериализации.\"\"\"\n+    if isinstance(value, dict):\n+        return {\n+            key: \"[REDACTED]\"\n+            if re.sub(r\"[_-]\", \"\", str(key)).lower()\n+            in {\"token\", \"secret\", \"password\", \"apikey\", \"bridgekey\", \"authorization\"}\n+            else _redact_quota(item)\n+            for key, item in value.items()\n+        }\n+    if isinstance(value, list):\n+        return [_redact_quota(item) for item in value]\n+    if isinstance(value, str):\n+        return _redact_secrets(value)\n+    return value\n+\n+\n+def _turn_diagnostics(params: dict[str, Any], prompt: str) -> list[str]:\n+    \"\"\"Собрать приоритетный блок MSP с покомпонентными лимитами и бюджетом 300.\"\"\"\n+    error = params.get(\"error\")\n+    kind = message = quota = retryable = \"\"\n+    if isinstance(error, dict):\n+        kind = _diagnostic_text(error.get(\"kind\"), prompt)\n+        message = _diagnostic_text(error.get(\"message\"), prompt)\n+        if isinstance(error.get(\"retryable\"), bool):\n+            retryable = f\" retryable={error['retryable']}\"\n+        if error.get(\"quota\") is not None:\n+            try:\n+                quota = json.dumps(\n+                    _redact_quota(error[\"quota\"]),\n+                    ensure_ascii=False,\n+                    sort_keys=True,\n+                    default=str,\n+                    separators=(\",\", \":\"),\n+                )\n+            except (TypeError, ValueError, RecursionError):\n+                quota = str(error[\"quota\"])\n+            quota = _diagnostic_text(quota, prompt)\n+    elif error is not None:\n+        message = _diagnostic_text(error, prompt)\n+    reason = _diagnostic_text(params.get(\"reason\"), prompt)\n+    if reason == message:\n+        reason = \"\"\n+    fields = {\n+        \"kind\": _clip_diagnostic(kind, 64),\n+        \"message\": _clip_diagnostic(message, 160),\n+        \"quota\": _clip_diagnostic(quota, 120),\n+        \"reason\": _clip_diagnostic(reason, 160),\n+    }\n+\n+    def lines() -> list[str]:\n+        primary = \": \".join(fields[key] for key in (\"kind\", \"message\") if fields[key])\n+        primary += retryable\n+        if fields[\"quota\"]:\n+            primary += \" quota=\" + fields[\"quota\"]\n+        result = [primary.strip()] if primary.strip() else []\n+        if fields[\"reason\"]:\n+            result.append(\"reason: \" + fields[\"reason\"])\n+        return result\n+\n+    for key in (\"quota\", \"reason\", \"message\", \"kind\"):\n+        excess = len(\"\\n\".join(lines())) - 300\n+        if excess <= 0:\n+            break\n+        minimum = min(16, len(fields[key])) if key == \"reason\" else 0\n+        fields[key] = _clip_diagnostic(\n+            fields[key], max(minimum, len(fields[key]) - excess)\n+        )\n+    return lines()\n+\n+\n+def _format_err_log(\n+    model: str, via: str, out: dict[str, Any], stream: bool, state: str | None = None\n+) -> str:\n+    \"\"\"Единая однострочная запись финального отказа без промпта и секретов.\"\"\"\n+    return (\n+        f\"error model={model} via={via} rc={out.get('rc')} state={state or out.get('state')} \"\n+        f\"err={_redact_secrets(str(out.get('err') or ''))[:300]!r} stream={stream}\"\n+    )\n+\n+\n def _flatten_content(content: Any) -> str:\n     \"\"\"OpenAI content (str | list[part]) -> plain text.\"\"\"\n     if content is None:\n@@ -329,13 +479,38 @@ def _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n             systems.append(text)\n         elif role == \"assistant\":\n             turns.append(f\"Assistant: {text}\")\n-        elif role == \"tool\":\n+        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n             turns.append(text)\n         else:\n             turns.append(f\"User: {text}\")\n     return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n \n \n+def _assemble_prompt(\n+    messages: list[dict[str, Any]],\n+    tools: list[dict[str, Any]] | None = None,\n+    tool_choice: Any = None,\n+    raw_tools: Any = None,\n+) -> tuple[str, str, str]:\n+    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n+    clean_tools = (\n+        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n+    )\n+    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n+    system_text, turns_text = _messages_to_prompt(messages)\n+    if not turns_text:\n+        return system_text, \"\", \"\"\n+    head: list[str] = []\n+    if system_text:\n+        head.append(f\"[system]\\n{system_text}\")\n+    if emulate_tools:\n+        head.append(_tools_section(clean_tools, tool_choice))\n+    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not system_text:\n+        head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n+    full_prompt = \"\\n\\n\".join(head) + f\"\\n\\n{turns_text}\" if head else turns_text\n+    return system_text, turns_text, full_prompt\n+\n+\n def _strip_code_fence(text: str) -> str:\n     \"\"\"Снять обёртку ```…``` (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n     body = text.strip()\n@@ -503,13 +678,353 @@ def _map_effort(req: dict[str, Any]) -> str:\n     return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n \n \n-_TOKEN_RE = re.compile(r\"\\s+\")\n-\n-\n def _estimate_tokens(text: str) -> int:\n+    \"\"\"Консервативная оценка токенов по UTF-8 байтам и символам (ADR-001.2 §2.5).\"\"\"\n     if not text:\n         return 0\n-    return max(1, int(len(_TOKEN_RE.split(text.strip())) * 1.3))\n+    return max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)\n+\n+\n+def _context_limit(model: str) -> int:\n+    \"\"\"Единый источник лимита окна модели из ALLOWED_MODELS (ADR-001.1).\"\"\"\n+    spec = ALLOWED_MODELS.get(model)\n+    if isinstance(spec, dict):\n+        val = spec.get(\"context_length\")\n+        if isinstance(val, int) and val > 0:\n+            return val\n+    return DEFAULT_CONTEXT_LIMIT\n+\n+\n+def _context_target(limit: int) -> int:\n+    \"\"\"Целевой бюджет проактивного прунинга с гистерезисом 80% (ADR-001.1).\"\"\"\n+    return (limit * 4) // 5\n+\n+\n+def _context_retry_target(limit: int) -> int:\n+    \"\"\"Аварийный бюджет однократного retry 50% (ADR-001.1).\"\"\"\n+    return limit // 2\n+\n+\n+class PruneResult(NamedTuple):\n+    status: str  # \"pass_through\" | \"pruned\" | \"refused\"\n+    messages: list[dict[str, Any]]\n+    prompt: str\n+    est_before: int\n+    est_after: int\n+    msgs_total: int\n+    msgs_kept: int\n+    msgs_dropped: int\n+    mandatory_est: int\n+    overhead_est: int\n+\n+\n+def _overhead_tokens_estimate(\n+    has_system: bool,\n+    tools: list[dict[str, Any]] | None,\n+    tool_choice: Any,\n+    raw_tools: Any,\n+) -> int:\n+    \"\"\"Оценка фиксированной шапки промпта ([system], схемы инструментов, DEFAULT_SYSTEM_HINT).\"\"\"\n+    clean_tools = (\n+        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n+    )\n+    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n+    overhead = 0\n+    if has_system:\n+        overhead += _estimate_tokens(\"[system]\\n\") + 1\n+    if emulate_tools:\n+        overhead += _estimate_tokens(_tools_section(clean_tools, tool_choice)) + 1\n+    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not has_system:\n+        overhead += _estimate_tokens(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\") + 1\n+    return overhead\n+\n+\n+def _prune_messages(\n+    messages: list[dict[str, Any]],\n+    limit: int,\n+    target: int,\n+    tools: list[dict[str, Any]] | None = None,\n+    tool_choice: Any = None,\n+    raw_tools: Any = None,\n+) -> PruneResult:\n+    \"\"\"Чистая функция защитного прунинга истории диалога (ADR-001.2).\"\"\"\n+    _, _, full_prompt = _assemble_prompt(\n+        messages, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    est_before = _estimate_tokens(full_prompt)\n+\n+    valid_msgs: list[dict[str, Any]] = []\n+    roles: list[str] = []\n+    real_msgs_total = 0\n+    for msg in messages or []:\n+        if not isinstance(msg, dict):\n+            continue\n+        role, text = _render_turn(msg)\n+        if not text.strip():\n+            continue\n+        valid_msgs.append(msg)\n+        roles.append(role)\n+        if role != _COMPACTION_MARKER_ROLE:\n+            real_msgs_total += 1\n+\n+    has_system = any(r in (\"system\", \"developer\") for r in roles)\n+    overhead_est = _overhead_tokens_estimate(has_system, tools, tool_choice, raw_tools)\n+\n+    if est_before <= limit:\n+        mandatory_est = _compute_mandatory_est_only(\n+            valid_msgs, roles, tools, tool_choice, raw_tools\n+        )\n+        return PruneResult(\n+            status=\"pass_through\",\n+            messages=messages,\n+            prompt=full_prompt,\n+            est_before=est_before,\n+            est_after=est_before,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=real_msgs_total,\n+            msgs_dropped=0,\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+\n+    units, mandatory_indices = _partition_units(valid_msgs, roles)\n+\n+    def build_candidate(kept_flags: list[bool]) -> list[dict[str, Any]]:\n+        pruned: list[dict[str, Any]] = []\n+        seen_kept_turn = False\n+        in_dropped_gap = False\n+        for u_idx, unit in enumerate(units):\n+            u_role = _render_turn(unit[0])[0]\n+            if u_role in (\"system\", \"developer\"):\n+                pruned.extend(unit)\n+                continue\n+            if u_role == _COMPACTION_MARKER_ROLE:\n+                if seen_kept_turn:\n+                    in_dropped_gap = True\n+                continue\n+            if kept_flags[u_idx]:\n+                if in_dropped_gap:\n+                    pruned.append(\n+                        {\"role\": _COMPACTION_MARKER_ROLE, \"content\": COMPACTION_MARKER}\n+                    )\n+                    in_dropped_gap = False\n+                pruned.extend(unit)\n+                seen_kept_turn = True\n+            else:\n+                if seen_kept_turn:\n+                    in_dropped_gap = True\n+        return pruned\n+\n+    kept = [i in mandatory_indices for i in range(len(units))]\n+    mandatory_msgs = build_candidate(kept)\n+    _, _, mandatory_prompt = _assemble_prompt(\n+        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    mandatory_est = _estimate_tokens(mandatory_prompt)\n+    cap = max(limit, target)\n+    if mandatory_est > cap:\n+        kept_count = sum(\n+            len(units[i])\n+            for i in range(len(units))\n+            if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+        )\n+        return PruneResult(\n+            status=\"refused\",\n+            messages=mandatory_msgs,\n+            prompt=mandatory_prompt,\n+            est_before=est_before,\n+            est_after=mandatory_est,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=kept_count,\n+            msgs_dropped=max(0, real_msgs_total - kept_count),\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+\n+    # Фаза C: непрерывный суффикс опциональных единиц от новейшей к старейшей.\n+    for u_idx in range(len(units) - 1, -1, -1):\n+        if u_idx in mandatory_indices:\n+            continue\n+        if _render_turn(units[u_idx][0])[0] == _COMPACTION_MARKER_ROLE:\n+            continue\n+        kept[u_idx] = True\n+        cand_msgs = build_candidate(kept)\n+        _, _, cand_prompt = _assemble_prompt(\n+            cand_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+        )\n+        if _estimate_tokens(cand_prompt) <= target:\n+            continue\n+        kept[u_idx] = False\n+        break\n+\n+    pruned_msgs = build_candidate(kept)\n+    _, _, pruned_prompt = _assemble_prompt(\n+        pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    est_after = _estimate_tokens(pruned_prompt)\n+    while est_after > target:\n+        opt_indices = [\n+            i\n+            for i in range(len(units))\n+            if kept[i]\n+            and i not in mandatory_indices\n+            and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+        ]\n+        if not opt_indices:\n+            break\n+        kept[opt_indices[0]] = False\n+        pruned_msgs = build_candidate(kept)\n+        _, _, pruned_prompt = _assemble_prompt(\n+            pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+        )\n+        est_after = _estimate_tokens(pruned_prompt)\n+\n+    kept_count = sum(\n+        len(units[i])\n+        for i in range(len(units))\n+        if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n+    )\n+    dropped_count = max(0, real_msgs_total - kept_count)\n+    if est_after > cap:\n+        return PruneResult(\n+            status=\"refused\",\n+            messages=pruned_msgs,\n+            prompt=pruned_prompt,\n+            est_before=est_before,\n+            est_after=est_after,\n+            msgs_total=real_msgs_total,\n+            msgs_kept=kept_count,\n+            msgs_dropped=dropped_count,\n+            mandatory_est=mandatory_est,\n+            overhead_est=overhead_est,\n+        )\n+    return PruneResult(\n+        status=\"pruned\",\n+        messages=pruned_msgs,\n+        prompt=pruned_prompt,\n+        est_before=est_before,\n+        est_after=est_after,\n+        msgs_total=real_msgs_total,\n+        msgs_kept=kept_count,\n+        msgs_dropped=dropped_count,\n+        mandatory_est=mandatory_est,\n+        overhead_est=overhead_est,\n+    )\n+\n+\n+def _partition_units(\n+    valid_msgs: list[dict[str, Any]], roles: list[str]\n+) -> tuple[list[list[dict[str, Any]]], set[int]]:\n+    \"\"\"Разбить валидные сообщения на атомарные единицы и выделить обязательные индексы M.\"\"\"\n+    units: list[list[dict[str, Any]]] = []\n+    consumed_tools: set[int] = set()\n+\n+    for idx, msg in enumerate(valid_msgs):\n+        role = roles[idx]\n+        if role == \"tool\":\n+            # Осиротевшие tool не попадают в units при прунинге; связанные поглощаются assistant.\n+            continue\n+        if (\n+            role == \"assistant\"\n+            and isinstance(msg.get(\"tool_calls\"), list)\n+            and msg.get(\"tool_calls\")\n+        ):\n+            call_ids = [\n+                _normalize_tool_call(tc)[\"id\"]\n+                for tc in msg[\"tool_calls\"]\n+                if _normalize_tool_call(tc)[\"id\"]\n+            ]\n+            if call_ids:\n+                expected = set(call_ids)\n+                matched_indices: list[int] = []\n+                matched_ids: set[str] = set()\n+                for j in range(idx + 1, len(valid_msgs)):\n+                    if j in consumed_tools or roles[j] != \"tool\":\n+                        continue\n+                    tc_id = str(\n+                        valid_msgs[j].get(\"tool_call_id\")\n+                        or valid_msgs[j].get(\"id\")\n+                        or \"\"\n+                    )\n+                    if tc_id in expected:\n+                        matched_indices.append(j)\n+                        matched_ids.add(tc_id)\n+                if matched_ids == expected:\n+                    consumed_tools.update(matched_indices)\n+                    units.append([msg] + [valid_msgs[j] for j in matched_indices])\n+                continue\n+        units.append([msg])\n+\n+    mandatory_indices: set[int] = set()\n+    user_unit_indices: list[int] = []\n+    last_non_sys_idx: int | None = None\n+    for u_idx, unit in enumerate(units):\n+        u_role = _render_turn(unit[0])[0]\n+        if u_role in (\"system\", \"developer\"):\n+            mandatory_indices.add(u_idx)\n+        elif u_role != _COMPACTION_MARKER_ROLE:\n+            last_non_sys_idx = u_idx\n+            if u_role not in (\"assistant\", \"tool\"):\n+                user_unit_indices.append(u_idx)\n+\n+    if user_unit_indices:\n+        mandatory_indices.add(user_unit_indices[0])\n+        mandatory_indices.add(user_unit_indices[-1])\n+        # Незавершённая единица ответа (assistant+tool после последнего user, ADR-001.2 §2.2 п.4).\n+        if (\n+            last_non_sys_idx is not None\n+            and last_non_sys_idx > user_unit_indices[-1]\n+            and len(units[last_non_sys_idx]) > 1\n+        ):\n+            mandatory_indices.add(last_non_sys_idx)\n+\n+    return units, mandatory_indices\n+\n+\n+def _compute_mandatory_est_only(\n+    valid_msgs: list[dict[str, Any]],\n+    roles: list[str],\n+    tools: list[dict[str, Any]] | None,\n+    tool_choice: Any,\n+    raw_tools: Any,\n+) -> int:\n+    units, mandatory_indices = _partition_units(valid_msgs, roles)\n+    mandatory_msgs = [\n+        m\n+        for u_idx, unit in enumerate(units)\n+        if u_idx in mandatory_indices\n+        for m in unit\n+    ]\n+    _, _, mandatory_prompt = _assemble_prompt(\n+        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n+    )\n+    return _estimate_tokens(mandatory_prompt)\n+\n+\n+def _log_context_prune(\n+    rid: str,\n+    model: str,\n+    reason: str,\n+    attempt: int,\n+    limit: int,\n+    target: int,\n+    res: PruneResult,\n+) -> None:\n+    \"\"\"Структурная запись прунинга без тел сообщений и секретов (ADR-001.4 §4.3).\"\"\"\n+    logger.info(\n+        \"muse_context_pruned: model=%s initial=%d target=%d dropped=%d is_retry=%s\",\n+        model,\n+        res.est_before,\n+        target,\n+        res.msgs_dropped,\n+        attempt > 1,\n+    )\n+    _log(\n+        f\"context_prune rid={rid} model={model} reason={reason} attempt={attempt} \"\n+        f\"limit={limit} target={target} est_before={res.est_before} est_after={res.est_after} \"\n+        f\"msgs_total={res.msgs_total} msgs_kept={res.msgs_kept} msgs_dropped={res.msgs_dropped} \"\n+        f\"mandatory_est={res.mandatory_est} overhead_est={res.overhead_est} method=bytes_div_3\"\n+    )\n \n \n # Эмуляция SSE (OpenAI chat.completion.chunk): результат генерации уже целиком —\n@@ -729,6 +1244,10 @@ class Run:\n             str(self.workdir),\n             \"--json\",\n             \"--no-session-log\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--disable-web-tools\",\n+            \"--disable-reminders\",\n             \"--prompt-file\",\n             prompt_path,\n         ]\n@@ -986,6 +1505,8 @@ class ServeRun:\n             self.model_id,\n             \"--no-session-log\",\n             \"--trust-workspace\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n         ]\n         try:\n             self.proc = subprocess.Popen(\n@@ -1008,6 +1529,8 @@ class ServeRun:\n         os.set_blocking(self.proc.stdin.fileno(), False)\n \n         err_lines: list[str] = []\n+        turn_diag_lines: list[str] = []\n+        stderr_joined = False\n \n         def drain_stderr() -> None:\n             try:\n@@ -1193,6 +1716,8 @@ class ServeRun:\n                         _handle_event(msg, None)\n                         continue\n                     terminal = str(p.get(\"terminal\") or \"unknown\")\n+                    if terminal != \"completed\":\n+                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                     break\n                 if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                     continue  # чужой/дублированный ack — игнор, не разрываем ход\n@@ -1216,7 +1741,19 @@ class ServeRun:\n                 if part not in summaries:\n                     summaries.append(part)\n             text = final_text if final_text is not None else \"\".join(deltas)\n-            err = \"\\n\".join(err_lines[-6:])\n+            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n+            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n+            err_thread.join(timeout=5)\n+            stderr_joined = True\n+            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n+            if self.prompt:\n+                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n+            err = \"\\n\".join(turn_diag_lines)\n+            if err:\n+                if stderr_tail:\n+                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n+            else:\n+                err = stderr_tail\n             if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                 return {\n                     \"rc\": serve_rc,\n@@ -1250,7 +1787,8 @@ class ServeRun:\n                 \"via\": \"serve\",\n             }\n         finally:\n-            err_thread.join(timeout=5)\n+            if not stderr_joined:\n+                err_thread.join(timeout=5)\n             self.close()\n \n \n@@ -1269,11 +1807,13 @@ class Handler(BaseHTTPRequestHandler):\n     _current_run: Run | ServeRun | None = None\n     # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n     _sse_open: bool = False\n+    _content_started: bool = False\n     _sse_id: str = \"\"\n     _sse_created: int = 0\n     _sse_model: str = \"\"\n     _wlock: threading.Lock = threading.Lock()\n-    _ka_stop: threading.Event | None = None\n+    _sse_phase: str = \"OPEN\"\n+    _keepalive_stop: threading.Event | None = None\n     _ka_thread: threading.Thread | None = None\n \n     def setup(self) -> None:\n@@ -1281,21 +1821,38 @@ class Handler(BaseHTTPRequestHandler):\n         self._client_gone = False\n         self._current_run = None\n         self._sse_open = False\n+        self._content_started = False\n         self._sse_id = \"\"\n         self._sse_created = 0\n         self._sse_model = \"\"\n         self._wlock = threading.Lock()\n-        self._ka_stop: threading.Event | None = None\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n+        self._keepalive_stop: threading.Event | None = None\n         self._ka_thread: threading.Thread | None = None\n         super().setup()\n \n     # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n-    def _sse_write(self, text: str) -> bool:\n+    def _sse_write(self, text: str, *, keepalive: bool = False) -> bool:\n         \"\"\"Запись кадра SSE под замком (keepalive и выдача из разных потоков).\"\"\"\n         try:\n             with self._wlock:\n-                self.wfile.write(text.encode(\"utf-8\"))\n-                self.wfile.flush()\n+                if self._sse_phase == \"CLOSED\" or self._client_gone:\n+                    return False\n+                if keepalive and (\n+                    self._sse_phase != \"OPEN\"\n+                    or (\n+                        self._keepalive_stop is not None\n+                        and self._keepalive_stop.is_set()\n+                    )\n+                ):\n+                    return False\n+                try:\n+                    self.wfile.write(text.encode(\"utf-8\"))\n+                    self.wfile.flush()\n+                finally:\n+                    if text == \"data: [DONE]\\n\\n\":\n+                        self._sse_phase = \"CLOSED\"\n             return True\n         except (BrokenPipeError, ConnectionResetError, OSError):\n             if not self._client_gone:\n@@ -1313,14 +1870,18 @@ class Handler(BaseHTTPRequestHandler):\n             \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n         }\n \n-    def _sse_emit(self, obj: dict) -> bool:\n-        return self._sse_write(\"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\")\n+    def _sse_emit(self, obj: dict, *, keepalive: bool = False) -> bool:\n+        return self._sse_write(\n+            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\", keepalive=keepalive\n+        )\n \n     def _sse_begin(self, model: str) -> bool:\n         \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n         self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n         self._sse_created = int(time.time())\n         self._sse_model = model\n+        with self._wlock:\n+            self._sse_phase = \"OPEN\"\n         self.close_connection = True\n         try:\n             self.send_response(200)\n@@ -1337,7 +1898,7 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n             return False\n         stop = threading.Event()\n-        self._ka_stop = stop\n+        self._keepalive_stop = stop\n         self._ka_thread = threading.Thread(\n             target=self._keepalive_loop, args=(stop,), daemon=True\n         )\n@@ -1345,17 +1906,22 @@ class Handler(BaseHTTPRequestHandler):\n         return True\n \n     def _keepalive_loop(self, stop: threading.Event) -> None:\n-        \"\"\"Комментарии `: keepalive`: держат TCP, но не сбрасывают idle-watchdog SDK.\"\"\"\n+        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n         while not stop.wait(KEEPALIVE_S):\n-            if not self._sse_write(\": keepalive\\n\\n\"):\n+            if self._client_gone or stop.is_set():\n+                return\n+            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n                 return\n \n     def _sse_stop_keepalive(self) -> None:\n-        if self._ka_stop is not None:\n-            self._ka_stop.set()\n+        if self._keepalive_stop is not None:\n+            self._keepalive_stop.set()\n+        with self._wlock:\n+            if self._sse_phase == \"OPEN\":\n+                self._sse_phase = \"FINALIZING\"\n         if self._ka_thread is not None:\n             self._ka_thread.join(timeout=2)\n-        self._ka_stop = None\n+        self._keepalive_stop = None\n         self._ka_thread = None\n \n     def _client_gone_probe(self) -> bool:\n@@ -1446,6 +2012,8 @@ class Handler(BaseHTTPRequestHandler):\n         if not self._sse_open and not self._sse_begin(model):\n             return\n         self._sse_stop_keepalive()\n+        with self._wlock:\n+            self._content_started = True\n         chunk = self._sse_chunk\n         reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n         if reasoning and not self._sse_emit(chunk({\"reasoning_content\": reasoning})):\n@@ -1579,8 +2147,9 @@ class Handler(BaseHTTPRequestHandler):\n         tool_choice = req.get(\"tool_choice\")\n         emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n \n-        system_text, prompt = _messages_to_prompt(req.get(\"messages\") or [])\n-        if not prompt:\n+        raw_messages = req.get(\"messages\") or []\n+        _, raw_turns_text = _messages_to_prompt(raw_messages)\n+        if not raw_turns_text:\n             self._send(\n                 400,\n                 {\n@@ -1591,15 +2160,56 @@ class Handler(BaseHTTPRequestHandler):\n                 },\n             )\n             return\n-        head: list[str] = []\n-        if system_text:\n-            head.append(f\"[system]\\n{system_text}\")\n-        if emulate_tools:\n-            head.append(_tools_section(tools, tool_choice))\n-        elif raw_tools and not system_text:\n-            head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n-        if head:\n-            prompt = \"\\n\\n\".join(head) + f\"\\n\\n{prompt}\"\n+\n+        rid = uuid.uuid4().hex[:8]\n+        limit = _context_limit(model)\n+        target = _context_target(limit)\n+        retry_target = _context_retry_target(limit)\n+        prune_res = _prune_messages(\n+            raw_messages,\n+            limit=limit,\n+            target=target,\n+            tools=tools,\n+            tool_choice=tool_choice,\n+            raw_tools=raw_tools,\n+        )\n+        if prune_res.status == \"refused\":\n+            _log_context_prune(\n+                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n+            )\n+            detail = (\n+                f\"mandatory context exceeds budget \"\n+                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n+            )\n+            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n+            _log(\n+                _format_err_log(\n+                    model,\n+                    \"refused\",\n+                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n+                    req.get(\"stream\") is True,\n+                )\n+            )\n+            self._send(\n+                502,\n+                {\n+                    \"error\": {\n+                        \"message\": _redact_secrets(err_msg),\n+                        \"detail\": _redact_secrets(detail)[:500],\n+                        \"type\": \"proxy_error\",\n+                        \"code\": 502,\n+                    }\n+                },\n+            )\n+            return\n+        if prune_res.status == \"pruned\":\n+            _log_context_prune(\n+                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n+            )\n+\n+        prompt = prune_res.prompt\n+        current_est = prune_res.est_after\n+        reflected_prompts: list[str] = [prompt]\n \n         effort = _map_effort(req)\n \n@@ -1628,46 +2238,139 @@ class Handler(BaseHTTPRequestHandler):\n         )\n         watcher.start()\n         runs: list = []\n-        try:\n+        terminal_context_err: str | None = None\n+        context_retry_count = 0\n+\n+        def run_attempt(attempt_prompt: str) -> tuple[dict[str, Any], str]:\n             # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n             # транспортной неполадке — тихий fallback на проверенный exec.\n-            out: dict[str, Any] | None = None\n-            via = \"exec\"\n+            attempt_out: dict[str, Any]\n+            attempt_via = \"exec\"\n             try:\n-                serve_run = ServeRun(model, prompt, effort, WORKSPACE)\n+                serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n                 runs.append(serve_run)\n                 self._current_run = serve_run\n-                out = serve_run.execute()\n-                via = \"serve\"\n+                attempt_out = serve_run.execute()\n+                attempt_via = \"serve\"\n             except ServeUnavailable as exc:\n                 if self._client_gone:\n                     # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                     _log(\"client gone during serve — exec fallback skipped\")\n-                    out = {\n+                    attempt_out = {\n                         \"rc\": -1,\n                         \"text\": \"\",\n                         \"err\": \"client gone\",\n                         \"state\": \"client_gone\",\n                     }\n-                    via = \"aborted\"\n+                    attempt_via = \"aborted\"\n                 else:\n                     _log(f\"serve unavailable ({exc}), fallback exec model={model}\")\n-                    exec_run = Run(model, prompt, effort, WORKSPACE)\n+                    exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                     runs.append(exec_run)\n                     self._current_run = exec_run\n-                    out = exec_run.execute()\n-                    via = \"exec-after-serve-fallback\"\n+                    attempt_out = exec_run.execute()\n+                    attempt_via = \"exec-after-serve-fallback\"\n                     if (\n-                        out.get(\"rc\") != 0\n+                        attempt_out.get(\"rc\") != 0\n                         and not self._client_gone\n-                        and NETWORK_RETRY_MARKER in str(out.get(\"err\") or \"\")\n+                        and NETWORK_RETRY_MARKER in str(attempt_out.get(\"err\") or \"\")\n                     ):\n                         _log(\"exec hit network marker, single retry\")\n-                        retry_run = Run(model, prompt, effort, WORKSPACE)\n+                        retry_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                         runs.append(retry_run)\n                         self._current_run = retry_run\n-                        out = retry_run.execute()\n-                        via = \"exec-retry\"\n+                        attempt_out = retry_run.execute()\n+                        attempt_via = \"exec-retry\"\n+            return attempt_out, attempt_via\n+\n+        try:\n+            t_first_attempt = time.monotonic()\n+            out, via = run_attempt(prompt)\n+            raw_err = str(out.get(\"err\") or \"\")\n+            is_hard_threshold = (\n+                out.get(\"rc\") != 0\n+                and out.get(\"state\") == \"terminal_failed\"\n+                and HARD_THRESHOLD_ERR_SUBSTR in raw_err\n+            )\n+            if (\n+                is_hard_threshold\n+                and context_retry_count == 0\n+                and not self._client_gone\n+                and not getattr(self, \"_content_started\", False)\n+            ):\n+                for run in runs:\n+                    run.close()\n+                if not all(run.dead_confirmed for run in runs):\n+                    _log(\n+                        \"context retry skipped: first attempt process group not confirmed dead\"\n+                    )\n+                else:\n+                    retry_res = _prune_messages(\n+                        raw_messages,\n+                        limit=retry_target,\n+                        target=retry_target,\n+                        tools=tools,\n+                        tool_choice=tool_choice,\n+                        raw_tools=raw_tools,\n+                    )\n+                    if retry_res.status == \"refused\":\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"refused_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        terminal_context_err = (\n+                            f\"mandatory context exceeds budget \"\n+                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n+                        )\n+                    elif (\n+                        retry_res.est_after >= current_est\n+                        or time.monotonic() - t_first_attempt >= TIMEOUT_S\n+                    ):\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"refused_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        terminal_context_err = (\n+                            f\"context hard threshold exceeded after single compaction retry \"\n+                            f\"(est_tokens={retry_res.est_after}, target={retry_target})\"\n+                        )\n+                    elif self._client_gone or self._client_gone_probe():\n+                        self._client_gone = True\n+                    else:\n+                        context_retry_count = 1\n+                        _log_context_prune(\n+                            rid,\n+                            model,\n+                            \"hard_threshold_retry\",\n+                            2,\n+                            limit,\n+                            retry_target,\n+                            retry_res,\n+                        )\n+                        prompt = retry_res.prompt\n+                        current_est = retry_res.est_after\n+                        reflected_prompts.append(prompt)\n+                        out, via = run_attempt(prompt)\n+                        raw_err_2 = str(out.get(\"err\") or \"\")\n+                        if (\n+                            out.get(\"rc\") != 0\n+                            and out.get(\"state\") == \"terminal_failed\"\n+                            and HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n+                        ):\n+                            terminal_context_err = (\n+                                f\"context hard threshold exceeded after single compaction retry \"\n+                                f\"(est_tokens={current_est}, target={retry_target})\"\n+                            )\n         finally:\n             # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n             watch_stop.set()\n@@ -1687,12 +2390,40 @@ class Handler(BaseHTTPRequestHandler):\n             # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n             _log(\"client gone — response skipped\")\n             return\n+        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n+        out = dict(out)\n\n<system-reminder>[Showing lines 1-1052 of 2894 total lines]</system-reminder>","timestamp":1791993017199,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
{"type":"tool_result","id":"tc-57f3zlvd0ln","messageId":"6b5ffa2a-22d1-4434-a8e4-3a7862bc93eb","toolId":"Read","isError":false,"value":"# Архитектурная спецификация (R2): Muse Wonder в чужих и длинных сессиях DSH\n\nРаунд R2. Заменяет R1. Вход: `analysis/muse-wonder-foreign-session/handoff-architect.md`,\n`evidence-ledger.md` ([F-01]..[F-08]), вердикты судей R1 (Визионер, Скептик: оба NEEDS_WORK).\nПакет: `architecture-packet.json` (та же папка). Нумерация решений: ADR-001.N ≡ AD-00N в пакете.\n\n## 0. Что изменилось относительно R1\n\n| Замечание R1 | Где закрыто |\n|---|---|\n| Три независимые константы лимита (Визионер) | ADR-001.1, §2.1 |\n| Нет гистерезиса, дребезг, кэш префикса (Визионер) | ADR-001.2, §2.3, RISK-002 |\n| Сохранялись только ведущие system/developer; последний user не обязателен (Скептик) | ADR-001.2, §2.2 |\n| Атомарность `tool_calls`/`tool` не определена (оба) | ADR-001.2, §2.4 |\n| Оценка «4 символа на токен» занижает кириллицу и код (оба) | ADR-001.2, §2.5 |\n| Поведение при превышении обязательного набора (оба) | ADR-001.2/001.3, §2.6, §3.3 |\n| Жизненный цикл retry, SSE, счётчики, очистка, дедлайн (оба) | ADR-001.3, §3 |\n| Подстрока ошибки хрупка; маркер в обычном ответе модели (оба) | ADR-001.3, §3.1 |\n| `self._wlock`, чистота функции прунинга (Визионер) | ADR-001.4, §4.1 |\n| Лог события, запрет логировать тела, редакция обеих попыток (оба) | ADR-001.4, §4.2-4.3 |\n| План тестов, red→green, канон проверок (оба) | §6 |\n| Порядок выката зеркала и профилей, откат, живая проверка (оба) | §7 |\n\n## 1. Контекст и проблема\n\n- **REQ-01.** Переключение на `muse-wonder-1.0` / `muse-wonder-full-1.0` в активной сессии DSH с контекстом\n  больше жёсткого лимита Meta не должно давать `terminal_failed`.\n- **Факт [F-01].** `~/.dsh/bridges/muse-bridge/logs/bridge.log:1207` (также `:1203`), 2026-10-14 17:08:24 MSK:\n  `via=serve rc=1 state=terminal_failed err='modelError: context compaction replacement still exceeds the hard threshold (639915 >= 460800 tokens) retryable=True stream=True`.\n  Ссылка в ledger на строку 1222 устарела: в файле 1207 строк.\n- **Факт [F-02/F-03].** `ALLOWED_MODELS` (`bridges/muse-bridge/server.py:77-78`) и профили DSH объявляют окно 1048576.\n  Клиент DSH не компактирует историю до порога Meta. `_messages_to_prompt` (`server.py:454`, вызов `:1767`) склеивает\n  историю без бюджета.\n- **Факт [F-04].** Мост завершает ход 502 сразу, повтора нет (`server.py:1743-1960`, ветка `out[\"state\"] != \"ok\"`).\n- **Граница достижимости.** Если системные инструкции, первый или последний `user` сами не помещаются в бюджет,\n  «безотказная работа» невозможна. В этом случае требуется детерминированный отказ (§2.6), а не молчаливая потеря.\n- **Не цель.** Модели `muse-spark-*` (тоже 1048576 в профилях) не меняются в этом MR (Q-002).\n\n## 2. ADR-001.1 и ADR-001.2\n\n### 2.1 ADR-001.1: единый источник лимита\n\n- **Решение.** Окно модели хранится в одном месте: запись `ALLOWED_MODELS[model]`. Для двух wonder-моделей значение\n  равно `400000`. Все остальные величины выводятся из него:\n  - порог срабатывания `limit = window`;\n  - целевой размер `target = limit * 4 // 5` (для 400000 это ровно 320000);\n  - аварийный размер `retry_target = limit // 2` (200000).\n- **Расхождение с брифом, фиксируется явно.** В коде ключ записи называется `context_length`, а не `contextWindow`\n  (`server.py:73-78`, `:1710`); `contextWindow` существует только в YAML профилей DSH. Поэтому формула из брифа\n  реализуется как `ALLOWED_MODELS.get(model, {}).get(\"context_length\", 400_000)`, оформленная одним помощником\n  `_context_limit(model)`. Второй ключ `contextWindow` в `ALLOWED_MODELS` не вводится: он создал бы второй источник\n  истины. Значение по умолчанию `400_000` задаётся одной константой модуля.\n- **Точки применения (4 значения, не больше).**\n  1. `bridges/muse-bridge/server.py`: `muse-wonder-1.0`, `muse-wonder-full-1.0` -> `context_length: 400000`.\n  2. `~/.dsh/bridges/muse-bridge/server.py`: зеркало. На 2026-10-14 побайтно совпадает с рабочим деревом репозитория\n     (`diff -q` без вывода), включая незакоммиченные правки.\n  3. `~/.dsh/profiles/desktop/cordis.patch.yml`: `contextWindow: 400000` у `id: muse-wonder-1.0` (строка 355) и\n     `id: muse-wonder-full-1.0` (строка 369).\n  4. `~/.dsh/profiles/web/cordis.patch.yml`: то же, строки 453 и 459.\n- **Не трогать.** Записи `muse-spark-*` и все прочие провайдеры (десятки строк `contextWindow: 1048576`). Каталоги\n  `~/.dsh/profiles/web.bak-*` (архивы). Профиль `headless`: `muse-bridge` в нём отсутствует (0 вхождений), проверить повторно\n  перед выкатом.\n- **Тест-регрессия.** `AllowedModelsSyncTest` (`tests/test_muse_bridge_killpg.py:1307`) сейчас жёстко проверяет\n  `1048576`; обновляется первым (red), см. §6.\n\n### 2.2 ADR-001.2: обязательный набор\n\nОпределения опираются на то, как `_messages_to_prompt` уже трактует роли: `system`/`developer` уходят в системный блок,\n`assistant` и `tool` рендерятся как есть, любая прочая роль (включая отсутствующую) считается `user`.\nСообщение с пустым отрендеренным текстом (`_render_turn` вернул пусто) и не-словарь в расчёт не входят.\n\nОбязательный набор M (в порядке неубывания приоритета отказа):\n1. **Все** `system`/`developer` сообщения истории, в том числе поздние вставки.\n2. Первый `user` (исходная постановка).\n3. Последний `user` (текущий запрос). Если он совпадает с первым, сообщение учитывается один раз.\n4. **Незавершённая единица ответа:** если последняя атомарная единица (см. §2.4) стоит позже последнего `user`\n   (типичный цикл агента: `assistant(tool_calls)` + `tool`-результаты), она тоже обязательна. Без неё модель отвечает на\n   вопрос, не видя результата, на который должна ответить. Это уточнение к брифу; оно вытекает из формата DSH и\n   проверяется тестом T-13.\n\nПорядок вывода сохраняет хронологию исходной истории. Системные сообщения по-прежнему выносятся в системный блок\nсуществующей логикой `_messages_to_prompt`.\n\n### 2.3 Пороги и гистерезис\n\n- `est_total` > `limit` (400000) -> прунинг до `target` (320000). `est_total` ≤ `limit` -> запрос проходит без изменений,\n  без маркера и без копирования (QS-02). Граница включительная: ровно `limit` не прунится.\n- Запас до порога клиента 80000, до жёсткого лимита Meta (460800) 140800 токенов оценки.\n- **Честное ограничение.** Мост без состояния. Если клиент не компактирует сам, история на каждом ходу растёт на\n  новый ход, и начало хвоста сдвигается на этот же объём. Гистерезис гарантирует: (а) нет дребезга «пруним / не пруним»\n  вокруг 400k; (б) неизменный префикс (системный блок, секция инструментов, первый `user`, маркер) побайтно стабилен и\n  кэшируется; (в) после компакции на клиенте (он стартует около 400k) префикс хвоста снова стабилен. Стабильность\n  префикса **хвоста** без компакции клиента не гарантируется. Квантование границы среза и серверное состояние сознательно\n  отложены (deferred). См. RISK-002.\n\n### 2.4 Инвариант атомарности инструментов\n\n- **Атомарная единица.** `assistant`-сообщение с непустым `tool_calls` + все `role: \"tool\"` сообщения, чей\n  `tool_call_id` совпадает с `id` любого из этих вызовов. Многовызовный ход (несколько `tool_calls` в одном\n  сообщении) целиком одна единица. Каждое прочее сообщение является отдельной единицей.\n- **Инвариант I-1.** В выходе прунинга нет `role: \"tool\"` без породившего `assistant` с таким же `tool_call_id` в\n  том же выходе, и нет `assistant` с `tool_calls`, у которых часть ответов отброшена, а часть оставлена.\n- **Осиротевшие `tool` во входе** (клиентская ошибка): при прунинге не попадают в выход; при проходе без прунинга\n  остаются как есть (QS-02 требует дословности).\n- Выбор хвоста идёт единицами от новейшей к старейшей, хвост непрерывный: остановка на первой единице, которая не\n  помещается (без перескоков на более мелкие старые единицы).\n\n### 2.5 Оценка токенов\n\n- `est(text) = max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)`. Так как байтов не меньше символов, второй член\n  всегда доминирует; формула записана в брифовой форме, реализация вправе считать только байты.\n- В бюджет входят: системный блок вместе с обёрткой `[system]`, секция `_tools_section(tools, tool_choice)` целиком\n  (`server.py:397`, JSON с `ensure_ascii=False`), разметка ролей (`User: `, `Assistant: `, `[tool result id] (name)`),\n  разделители `\\n\\n`, маркер. Если инструменты не эмулируются, а `raw_tools` есть без system, учитывается\n  `DEFAULT_SYSTEM_HINT`.\n- Округление: к оценке каждой части прибавляется 1 токен, а итог всегда перепроверяется по **собранному** промпту:\n  если `est(промпт) > target` (или `> limit` для жёсткой границы), хвост сокращается ещё на единицу. Тесты проверяют\n  собранный промпт, а не промежуточную сумму.\n- Консервативность имеет цену: для плотной кириллицы (2 байта на символ) оценка выше реальной токенизации, поэтому\n  мост может прунить раньше, чем клиент считает окно исчерпанным. Принято осознанно (F-05); масштаб проверяется на\n  живом ходе (ASM-004).\n\n### 2.6 Отказ при превышении обязательного набора\n\nПусть `base = est(фиксированная часть) + est(M) + est(маркер)`, `cap` = `limit` для проактивного прунинга и\n`retry_target` для retry.\n- `base > cap` -> прунинг не может помочь. Мост **не запускает модель** и отвечает терминально (см. §3.3 и §4.3).\n- Единица из п. 2.2/4 принимается, если `base + cost ≤ cap` (жёсткая граница, `target` здесь мягкая цель); иначе отказ.\n- Остальной хвост добирается до `target` (проактивно) или `retry_target` (retry).\n- Проактивный отказ происходит до `_sse_begin`, поэтому это обычный HTTP 502 JSON. Тело ответа: счётчики оценки и\n  лимит; текст сообщений не включается.\n\n### 2.7 Маркер и чистота функции\n\n- Текст маркера: `[... earlier conversation turns compacted to stay within Muse context limit ...]`. Цифр лимита в\n  тексте нет (единый источник).\n- Маркер вставляется в каждый разрыв между соседними сохранёнными репликами, где отброшены единицы (разрывов не\n  более двух: после первого `user` и перед хвостом, если последний `user` лежит раньше начала хвоста). Если отбрасывать\n  нечего, маркера нет. Рендерится как нейтральная строка без префикса `User:`/`Assistant:` (внутренняя роль\n  сообщения-заметки, обрабатываемая в `_messages_to_prompt`).\n- Прунинг: чистая функция `(messages, limit, target, fixed_overhead_tokens) -> PruneResult`. Исходный список и словари\n  не мутируются, результат собирается из ссылок на неизменённые сообщения. Детерминирован и идемпотентен: повторный\n  прунинг своего выхода с теми же параметрами не меняет его.\n\n## 3. ADR-001.3: аварийный auto-retry\n\n### 3.1 Условие срабатывания (все пункты одновременно)\n\n1. Попытка завершилась неуспехом: `out[\"rc\"] != 0` и `out[\"state\"] == \"terminal_failed\"`.\n2. Подстрока `context compaction replacement still exceeds the hard threshold` найдена в **канале ошибки**\n   (`out[\"err\"]`, сырое значение до редакции), а не в `out[\"text\"]`/`chunks`. Совпадение в обычном ответе модели retry\n   не запускает.\n3. Подстрока хранится одной константой модуля; на неё есть тест (T-17).\n4. `context_retry_count == 0` (отдельный счётчик, не связанный с `NETWORK_RETRY_MARKER` и fallback `serve -> exec`).\n5. Клиент не отключён (`not self._client_gone`), и контентные кадры ещё не отправлялись (§3.2).\n6. Первая попытка очищена: `run.close()` выполнен, `run.dead_confirmed` истинно. Иначе retry не стартует, действует\n   существующий карантин слота.\n7. Прунинг для retry возможен: `base ≤ retry_target` (§2.6) и оценка нового промпта **строго меньше** оценки\n   предыдущей попытки (иначе повтор бессмыслен: тот же промпт).\n8. Не исчерпан суммарный дедлайн хода: `time.monotonic() - t_first_attempt < TIMEOUT_S`. Retry получает остаток, если\n   сигнатура `execute()` позволяет; если нет, Coder фиксирует это в отчёте (принятый верхний предел 2×`TIMEOUT_S`).\n\nПодделка: пользователь может подсунуть текст маркера так, что он отразится в `err`. Последствие ограничено одним повтором\n(пункт 4), прочих побочных эффектов нет.\n\n### 3.2 Граница «до первого контентного чанка»\n\n- В текущем коде SSE открывается заранее (`_sse_begin`: заголовки, role-кадр, keepalive-комментарии), а все\n  reasoning/tool_calls/content-кадры пишет `_send_sse` **после** завершения всех запусков (`server.py:1614`).\n  Поэтому цикл retry целиком лежит до первого контентного кадра и между попытками клиенту уходят только keepalive.\n- Защита на будущее: флаг `self._content_started` (выставляется под `_wlock` перед первой записью reasoning/tool/content\n  кадра). Условие 5 §3.1 проверяет его. Если когда-нибудь появится реальный потоковый вывод, retry после первой дельты\n  запрещён автоматически (повторять нельзя: нарушена идемпотентность потока).\n- Между попытками нет ни `error`-кадра, ни `[DONE]`. Итог ровно один: успех либо терминальная ошибка.\n\n### 3.3 Один повтор и терминальный исход\n\n- `max_retries = 1`, цель среза `retry_target = limit // 2` (200000), промпт собирается из **исходных** `messages`, а не\n  из уже прунённого списка.\n- Повтор использует тот же слот (повторного `_slots.acquire` нет), добавляет `Run`/`ServeRun` в общий `runs` (чтобы\n  `finally` закрыл обе попытки) и переключает `self._current_run`. Транспорт внутри попытки обычный: serve-first,\n  fallback на exec допустим; сетевой retry допустим и не расходует контекстный счётчик. Вторая попытка с тем же маркером\n  контекстный retry **не** запускает.\n- Терминальный исход (повторный отказ, невыполнимый срез, превышение дедлайна, обязательный набор больше\n  `retry_target`):\n  - JSON: HTTP 502, `error.type = proxy_error`, `error.code = 502`;\n  - SSE: один `error`-кадр и один `[DONE]` (существующий путь `_send` в фазе OPEN);\n  - сообщение: `muse turn failed (rc=1, state=terminal_failed): context hard threshold exceeded after single compaction retry (est_tokens=<n>, target=<n>)`\n    либо `...: mandatory context exceeds budget (est_tokens=<n>, limit=<n>)`. В сообщении только числа и константный\n    текст.\n\n## 4. ADR-001.4: безопасность, потоки, наблюдаемость\n\n### 4.1 Потокобезопасность\n\n- `self._wlock` (обычный `threading.Lock`, `server.py:1447`) защищает только запись в SSE-сокет (`_sse_write`).\n  Прунинг и сборка промпта выполняются в потоке запроса до `_sse_begin` и повторно между попытками **без** замков;\n  ни один метод, берущий `_wlock`, не вызывается из прунинга. Тест T-11 фиксирует: во время прунинга `_wlock` не\n  захвачен.\n- Состояние попытки (`context_retry_count`, `_content_started`, предыдущая оценка) живёт в локальных переменных\n  обработчика запроса и в экземпляре `Handler` (по одному на соединение); глобальных изменяемых структур не добавляется.\n\n### 4.2 Секреты и тела сообщений\n\n- Тела отброшенных и сохранённых сообщений, tool arguments, multipart-текст и промпт в лог и диагностику не пишутся.\n- Каждая строка лога и каждое диагностическое сообщение проходит `_redact_secrets` (`server.py:177`).\n- Отражённый промпт убирается для **обеих** попыток: список `reflected_prompts` накапливает промпт каждой попытки;\n  замена `[REDACTED]` и обход `messages` (существующая логика `server.py:1877-1955`) выполняются до усечения до 500\n  символов и во всех приёмниках: лог, JSON, SSE.\n- Детектор retry читает сырой `err` только для сопоставления с константой; в лог и ответ уходит уже отредактированный\n  текст.\n\n### 4.3 Структурное событие прунинга\n\nОдна строка `_log` на каждое срабатывание прунинга и на каждый retry:\n\n```\ncontext_prune rid=<8 hex> model=<id> reason=<proactive_prune|hard_threshold_retry|refused_mandatory|refused_retry> attempt=<1|2> limit=<n> target=<n> est_before=<n> est_after=<n> msgs_total=<n> msgs_kept=<n> msgs_dropped=<n> mandatory_est=<n> overhead_est=<n> method=bytes_div_3\n```\n\n- Только числа и константные слова. `rid` генерируется на запрос (`uuid4().hex[:8]`), связывает строки обеих попыток.\n- Заголовок ответа вроде `X-Muse-Context-Pruned` и переопределение лимитов через env в этот MR не входят (deferred).\n\n## 5. Границы и контракты\n\n- Внешний вход: OpenAI `/v1/chat/completions`, JSON и SSE. Поля запроса и формат ответа успеха не меняются.\n- Внешний выход, изменённый контракт: `context_length` двух wonder-моделей в `/health` и `/v1/models` = 400000\n  (QS-03).\n- Новый внутренний контракт: ошибка 502 с двумя новыми константными текстами (§3.3).\n- Зависимости: только stdlib. Новых пакетов и файлов конфигурации нет.\n\n## 6. Сценарии качества (QA в пакете) и план тестов\n\nФайл новых тестов: `tests/test_muse_bridge_killpg.py` (в нём уже весь harness моста: `load_bridge`, `_BridgeScenario`,\n`install_protocol_wrapper`, `bridge_request`, проверки секретов и отключений). Новый файл поверх не создаётся.\n\nПорядок red -> green: сначала тесты T-00..T-23 (падают), затем реализация, затем зелёный набор. Regression-тест на\nкаждый дефект пишется до исправления.\n\n| ID | Класс | Проверка |\n|---|---|---|\n| T-00 | `AllowedModelsSyncTest` | wonder-модели: `context_length == 400000`; `/health` и `/v1/models` отдают 400000; `muse-spark-*` без изменений |\n| T-01 | `ContextEstimateTest` | оценка: латиница, кириллица (1000 символов -> 666), код, JSON, пусто -> 0; равна `max(chars//3, bytes//3)` |\n| T-02 | `ContextEstimateTest` | `_context_limit`: берётся из `ALLOWED_MODELS` (monkeypatch записи меняет порог); неизвестная модель -> 400000; `target`/`retry_target` выведены |\n| T-03 | `ContextPruneTest` | границы: оценка `limit-1`, `limit` -> без изменений (тождественный список, нет маркера); `limit+1` -> прунинг |\n| T-04 | `ContextPruneTest` | после прунинга оценка **собранного** промпта ≤ 320000 (включая большую секцию инструментов, system, маркер) |\n| T-05 | `ContextPruneTest` | сохраняются все `system`/`developer` (в том числе поздние), первый и последний `user`; один `user` не дублируется |\n| T-06 | `ContextPruneTest` | атомарность: свип по всем бюджетам вокруг границы; в выходе нет `tool` без вызова и нет частично сохранённого многовызовного хода |\n| T-07 | `ContextPruneTest` | осиротевший `tool` во входе: не попадает в прунённый выход; без прунинга остаётся дословно |\n| T-08 | `ContextPruneTest` | кириллица: `chars//3` < порога < `bytes//3` -> прунинг срабатывает (доказательство байтовой основы) |\n| T-09 | `ContextPruneTest` | multipart, `content=None`, пустые, не-словари, неизвестная роль: нет исключений; пустые не становятся первым/последним `user` |\n| T-10 | `ContextPruneTest` | маркер ровно в разрывах, порядок хронологический, детерминизм, идемпотентность повторного прунинга |\n| T-11 | `ContextPruneTest` | вход не мутирован (глубокое сравнение); `_wlock` не захвачен во время прунинга |\n| T-12 | `ContextRetryTest` | обязательный набор > `limit` -> 502 до запуска: `Run`/`ServeRun` не созданы, слот не занят, канарейка текста в ответе и логе отсутствует |\n| T-13 | `ContextPruneTest` | незавершённая единица (assistant+tool после последнего user) сохраняется; не помещается в `cap` -> отказ |\n| T-14 | `ContextPruneTest` | гистерезис: два хода подряд с ростом; префикс (system, tools, первый user, маркер) побайтно одинаков; 399999 не прунится |\n| T-15 | `ContextRetryTest` | ошибка Meta -> успех: ровно 2 запуска, промпт 2 ≤ 200000 и меньше промпта 1, 200 в JSON и SSE; в SSE один `[DONE]`, нет `error` между попытками |\n| T-16 | `ContextRetryTest` | ошибка Meta дважды: ровно 2 запуска, терминальный 502 (JSON) / `error`+один `[DONE]` (SSE), в тексте нет промпта |\n| T-17 | `ContextRetryTest` | другая ошибка -> без контекстного retry; маркер в обычном тексте ответа (rc=0) -> без retry; константа подстроки зафиксирована |\n| T-18 | `ContextRetryTest` | serve недоступен -> exec fallback -> маркер -> контекстный retry один; сетевой retry счётчик не расходует |\n| T-19 | `ContextRetryTest` | отключение клиента между попытками: второго запуска нет, группы убиты, слот свободен |\n| T-20 | `ContextRetryTest` | обязательный набор > 200000 при ошибке Meta: второго запуска нет, терминальный 502 |\n| T-21 | `ContextRetryTest` | срез не уменьшает промпт (оценка не меньше предыдущей) -> терминальный 502 без повтора |\n| T-22 | `ContextRetryTest` | первая попытка не подтверждена мёртвой -> retry не стартует, слот в карантине, освобождён ровно один раз |\n| T-23 | `ContextObservabilityTest` | строка `context_prune` содержит все поля и верный `reason`; канарейки секретов и текста сообщений отсутствуют в логе, JSON и SSE обеих попыток; серия длинных запросов не растит удерживаемые буферы |\n\nКоманда проверки перед MR (Full Suite Gate): `ruff format --check`, `ruff check`, `basedpyright`, полный прогон.\nВ репозитории нет `pyproject.toml`/`uv.lock`, поэтому `uv run pytest -q` без дополнительных ключей не работает; рабочий\nвызов: `uv run --no-project --with pytest python -m pytest -q tests/` (проверено: pytest 8.4.2). R1 называл «полный\nunittest»: заменено.\n\n## 7. Миграция и живая проверка (тяжёлый путь)\n\nПорядок выката (внешние файлы вне git, поэтому каждый шаг отдельный):\n1. До правок: бэкап `~/.dsh/bridges/muse-bridge/server.py` и двух `cordis.patch.yml` в `~/work/backups/` с датой.\n2. Реализация и тесты в репозитории (Coder). В рабочем дереве уже есть чужие незакоммиченные правки\n   `bridges/muse-bridge/server.py` и `tests/test_muse_bridge_killpg.py`: Coder стартует от их фактического состояния,\n   фиксирует `git diff` до работы и не затирает их.\n3. Совет и ACCEPT -> MR (merge делает человек).\n4. Копия `server.py` в зеркало `~/.dsh/bridges/muse-bridge/server.py`, перезапуск моста штатным способом из KB\n   (способ не угадывается: берётся из `knowledge-base`, при отсутствии запись `BLOCKED` владельцу).\n5. Проверка `/health` и `/v1/models`: оба wonder-моделя `context_length: 400000`.\n6. Правка 4 значений в профилях `desktop` и `web` (§2.1 п. 3-4), затем `diff` против бэкапа: изменились ровно 4 строки.\n   Сначала мост, потом профили: при обратном порядке клиент компактирует на 400k, а мост ещё не защищён.\n7. DSH подхватывает профиль при новой сессии или перезагрузке; уже открытые слоты хранят старое окно 1048576\n   (RISK-004), их надо перезапустить.\n\nТяжёлый путь (без него «готово» запрещено):\n- В живой «чужой» сессии владельца с историей, дающей >460800 токенов (прежний сбой 639915), переключиться на\n  `muse-wonder-1.0` и `muse-wonder-full-1.0` и выполнить реальную работу (в том числе вызов инструмента).\n- Повторить ход и сделать два параллельных хода (`MUSE_BRIDGE_MAX_CONCURRENT=2`).\n- Факты: строка `context_prune ... reason=proactive_prune` в `bridge.log`, отсутствие `terminal_failed`, реальные\n  `usage.prompt_tokens` из serve < 460800, отношение оценки к реальному счёту записать (ASM-004), тайминги хода.\n- Retry на живой сессии естественно не вызвать. Проверка: **отдельный** экземпляр моста на другом порту с\n  подменой `MUSE_BRIDGE_CLI` на заглушку, возвращающую ошибку Meta на первой попытке (VER-007). Боевой мост не трогать.\n- Откат: восстановить зеркало и два профиля из бэкапа, перезапустить мост. Прунинг без состояния, миграций данных нет.\n\n## 8. Риски и допущения (сводка; полный список в пакете)\n\n- RISK-001: оценка `bytes//3` не совпадает с токенизатором Meta -> тяжёлый путь и сравнение с `usage`.\n- RISK-002: хвост без компакции клиента сдвигается каждый ход -> кэш хвоста мимо; префикс стабилен. Принято.\n- RISK-003: потеря реплик, молчаливая для пользователя -> маркер для модели и строка `context_prune` для оператора.\n- RISK-004: открытые слоты со старым окном -> перезапуск слотов.\n- RISK-005: retry при нераспознанной смене формата ошибки Meta -> константа и тест; сбой даёт обычный 502.\n- ASM-003 (OPEN, continuable): Muse CLI/serve не держит серверного состояния сессии, которое делало бы урезание входных\n  `messages` бесполезным (замечание Визионера). Проверка: тяжёлый путь, `usage.prompt_tokens` после прунинга.\n- Вопросы владельцу (не блокируют): Q-001 имя ключа `context_length`; Q-002 `muse-spark-*` остаются на 1048576;\n  Q-003 способ перезапуска моста.\n","timestamp":1791993017199,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
{"type":"tool_result","id":"tc-jmbdsb852op","messageId":"6b5ffa2a-22d1-4434-a8e4-3a7862bc93eb","toolId":"Read","isError":false,"value":"#!/usr/bin/env python3\n\"\"\"muse-bridge — локальный OpenAI-совместимый мост поверх Muse Code CLI (Meta).\n\nОдин запрос `/v1/chat/completions` = один headless-ход\n`~/.config/muse-launch/muse-cli.sh exec --provider meta --model muse-spark-1.3\n --reasoning-effort <TIER> --yolo --trust-workspace --workspace <WS> --json --prompt-file <f>`.\n\nВызов ТОЛЬКО через обёртку muse-cli.sh (прокси :10816, вычистка META_API_KEY,\nexit 42 при DOWN прокси) — канон model-invocation.md §2d. Голый `muse` не используется.\n\nStdout CLI — JSONL-конверты (schema_version=1). Текст ответа — из\n`run.terminal.completed` (payload.text); fallback — конкатенация `run.output.delta`\n(payload.text). Ошибки — `run.terminal.*` с terminal != completed либо\n`task.lifecycle.failed` (event.reason). Usage CLI в JSONL не отдаёт — оценка по словам.\n\nТранспорт — stdlib. `stream:true`: заголовки 200 и role-delta уходят сразу, пока ход\nидёт — data-чанки `chat.completion.chunk` с пустой дельтой `{\"content\": \"\"}`\n(MUSE_BRIDGE_KEEPALIVE_S); по готовности — reasoning\nsummaries как `delta.reasoning_content`, tool_calls, content-чанки (~300 символов), финал\nс finish_reason + usage, затем `data: [DONE]`. Ошибка после старта потока — кадр\n`{\"error\": …}` + `[DONE]`. Текст ответа CLI отдаёт в конце хода, поэтому content\nпо-прежнему приходит в конце. `stream:false` — обычный JSON.\n\nПровал хода (failed terminal, rc != 0, таймаут) не отдаётся как успешный финал: частичный\nтекст и tool-блоки отбрасываются — SSE-кадр ошибки + `[DONE]` (stream) либо 502 (JSON).\n\nKeepalive: пустые data-чанки держат SSE-соединение, не меняя текст ответа.\nСброс idle-watchdog клиента pi-ai требует отдельной живой проверки в DSH.\nПеред финалом поток запечатывается; после `data: [DONE]` записей нет.\n\nЭмуляция OpenAI function calling (порт из droid-bridge): если запрос содержит\nнепустой `tools` (и tool_choice != \"none\"), в системный текст добавляется протокол\n`<tool_call>{\"name\":…,\"arguments\":{…}}</tool_call>` и схемы инструментов; блоки в\nответе модели разбираются ToolCallParser в `message.tool_calls` +\n`finish_reason:\"tool_calls\"`; история assistant.tool_calls / role:\"tool\"\nрендерится обратно в те же блоки. Без `tools` мост чисто текстовый.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport os\nimport random\nimport re\nimport select\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport uuid\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom typing import Any, NamedTuple\n\nlogger = logging.getLogger(\"muse-bridge\")\n\nHOST = os.environ.get(\"MUSE_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\nPORT = int(os.environ.get(\"MUSE_BRIDGE_PORT\", \"9886\"))\nAUTH_KEY = os.environ.get(\"MUSE_BRIDGE_KEY\", \"\").strip()\n\nTIMEOUT_S = float(os.environ.get(\"MUSE_BRIDGE_TIMEOUT_S\", \"1800\"))\nMAX_CONCURRENT = int(os.environ.get(\"MUSE_BRIDGE_MAX_CONCURRENT\", \"2\"))\n\nMUSE_WRAPPER = os.environ.get(\n    \"MUSE_BRIDGE_CLI\", str(Path.home() / \".config\" / \"muse-launch\" / \"muse-cli.sh\")\n)\nROOT = Path(__file__).resolve().parent\nWORKSPACE = Path(os.environ.get(\"MUSE_BRIDGE_WORKSPACE\", str(ROOT / \"workspace\")))\nLOG_PATH = Path(os.environ.get(\"MUSE_BRIDGE_LOG\", str(ROOT / \"logs\" / \"bridge.log\")))\n\nALLOWED_MODELS: dict[str, dict[str, Any]] = {\n    \"muse-spark-1.3\": {\"context_length\": 1048576, \"max_output\": 131072},\n    # 2026-10-05: контрибьютор-слот (только пикер, по просьбе владельца).\n    # id подтверждён `muse model-profile show` (резолвится); окно/лимит как у spark.\n    \"muse-spark-1.3-contributor\": {\"context_length\": 1048576, \"max_output\": 131072},\n    \"muse-wonder-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n    \"muse-wonder-full-1.0\": {\"context_length\": 400_000, \"max_output\": 131072},\n}\nDEFAULT_MODEL = os.environ.get(\"MUSE_BRIDGE_MODEL\", \"muse-wonder-full-1.0\")\nDEFAULT_CONTEXT_LIMIT = 400_000\n\n# Подстрока ошибки жёсткого порога контекста Meta (ADR-001.3, [F-01]).\nHARD_THRESHOLD_ERR_SUBSTR = (\n    \"context compaction replacement still exceeds the hard threshold\"\n)\nCOMPACTION_MARKER = (\n    \"[... earlier conversation turns compacted to stay within Muse context limit ...]\"\n)\n_COMPACTION_MARKER_ROLE = \"__compaction_marker__\"\n\n# OpenAI/DSH effort -> `--reasoning-effort` Muse CLI. Нет/неизвестно -> max (канон слота).\nEFFORT_MAP: dict[str, str] = {\n    \"low\": \"low\",\n    \"medium\": \"medium\",\n    \"high\": \"high\",\n    \"xhigh\": \"xhigh\",\n    \"max\": \"max\",\n    # 2026-10-08: \"none\" запрещён meta-провайдером (muse exec RC=2:\n    # \"--reasoning-effort none is not supported with --provider meta\"),\n    # мост отдавал 502. \"Без рассуждений\" -> ближайший живой тир minimal.\n    \"off\": \"minimal\",\n    \"none\": \"minimal\",\n    \"minimal\": \"minimal\",\n    \"ultra\": \"xhigh\",  # runtime-гейт ultra откатывается в xhigh\n}\nDEFAULT_EFFORT = \"max\"\n\n# Однократный ретрай exec — ТОЛЬКО на этот маркер (exec идемпотентен).\n# Остальные ошибки (rc=42 прокси DOWN, timeout, terminal_*) не ретраятся.\nNETWORK_RETRY_MARKER = \"network connection could not be opened\"\n\n# Bridge-тир -> MSP ReasoningEffort (closed-вокабуляр SS3.2). _map_effort уже\n# нормализовал запрос; ultra откатан в xhigh там же (EFFORT_MAP).\n# 2026-10-08: +minimal (низший живой тир meta -> низший известный MSP-тир low);\n# \"none\" оставлен оборонительно (сюда больше не приходит, но MSP-вокабуляр под вопросом).\n_MSP_EFFORT = {\n    \"low\": \"low\",\n    \"medium\": \"medium\",\n    \"high\": \"high\",\n    \"xhigh\": \"xhigh\",\n    \"max\": \"max\",\n    \"minimal\": \"low\",\n    \"none\": \"low\",\n}\n\n# Грейс выхода CLI после terminal completed: вышел сам -> его rc настоящий; завис -> добивает мост.\n# Грейс вне бюджета хода (таймер TIMEOUT_S отменяется по completed), но ограничен.\nQUARANTINE_MAX_S = 600.0  # потолок карантина слота: группа не подтверждена мёртвой\n_SIGNAL_RCS = (\n    -signal.SIGKILL,\n    -signal.SIGTERM,\n)  # rc процесса, убитого мостом при уборке\nTERMINAL_EXIT_GRACE_S = 0.5\nSERVE_SPAWN_TIMEOUT_S = 30.0  # handshake+session/start должны уложиться сюда\n\n\nclass ServeUnavailable(Exception):\n    \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n\n\ndef _uuid7() -> str:\n    ms = int(time.time() * 1000) & 0xFFFFFFFFFFFF\n    rand = random.getrandbits(74)\n    value = (ms << 74) | rand\n    hx = f\"{value:032x}\"\n    hx = hx[:12] + \"7\" + hx[13:16] + f\"{8 | (int(hx[16], 16) & 3):x}\" + hx[17:]\n    return f\"{hx[:8]}-{hx[8:12]}-{hx[12:16]}-{hx[16:20]}-{hx[20:]}\"\n\n\nTOOL_CALL_OPEN = \"<tool_call>\"\nTOOL_CALL_CLOSE = \"</tool_call>\"\n\nDEFAULT_SYSTEM_HINT = (\n    \"Ты отвечаешь в текстовом чате. Не вызывай инструменты и не выполняй команды; \"\n    \"верни только текстовый ответ.\"\n)\n\n_started = time.time()\n_active: dict[str, float] = {}\n_active_lock = threading.Lock()\n# Слоты в карантине (по записи на слот: pgid не подтверждённых мёртвыми групп); под _active_lock.\n_quarantined_slots: list[list[int]] = []\n_slots = threading.Semaphore(MAX_CONCURRENT)\n_LOG_LOCK = threading.Lock()\n\n\ndef _log(msg: str) -> None:\n    safe_msg = _redact_secrets(msg)\n    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {safe_msg}\"\n    sys.stderr.write(line + \"\\n\")\n    sys.stderr.flush()\n    try:\n        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)\n        with _LOG_LOCK, LOG_PATH.open(\"a\", encoding=\"utf-8\") as fh:\n            fh.write(line + \"\\n\")\n    except OSError:\n        pass\n\n\ndef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n    hdr = handler.headers.get(\"Authorization\", \"\")\n    if hdr.startswith(\"Bearer \"):\n        return hdr[7:].strip() == AUTH_KEY\n    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n\n\ndef _redact_secrets(text: str) -> str:\n    \"\"\"Удалить отражённые ключи до обрезки диагностики; повторный вызов безопасен.\"\"\"\n    if AUTH_KEY:\n        text = text.replace(AUTH_KEY, \"[REDACTED]\")\n    text = re.sub(\n        r\"Authorization\\s*:\\s*[^\\r\\n]+\",\n        \"Authorization: [REDACTED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    text = re.sub(r\"Bearer\\s+\\S+\", \"Bearer [REDACTED]\", text, flags=re.IGNORECASE)\n    text = re.sub(\n        r\"\"\"([\"']?(?:api[_-]?key|token|secret|password|bridge[_-]?key)[\"']?\\s*[:=]\\s*)(\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^\\s,;}\"']+)\"\"\",\n        lambda match: match[1] + \"[REDACTED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n    return re.sub(r\"sk-[A-Za-z0-9_-]{12,}\", \"[REDACTED]\", text)\n\n\ndef _clip_diagnostic(text: str, limit: int) -> str:\n    \"\"\"Ограничить поле, убрав его целиком при разрезании маркера редакции.\"\"\"\n    for marker in re.finditer(re.escape(\"[REDACTED]\"), text):\n        if marker.start() < limit < marker.end():\n            return \"\"\n    return text[:limit]\n\n\ndef _prompt_reflected_parts(prompt: str) -> list[str]:\n    \"\"\"Выделить длинные отражённые реплики, начиная с самых полных совпадений.\"\"\"\n    parts = {prompt} if len(prompt.strip()) >= 8 else set()\n    for part in prompt.split(\"\\n\\n\") + prompt.splitlines():\n        for candidate in (part, re.sub(r\"^(?:User|Assistant|System):\\s*\", \"\", part)):\n            if len(candidate.strip()) >= 8:\n                parts.add(candidate)\n    return sorted(parts, key=len, reverse=True)\n\n\ndef _diagnostic_text(value: Any, prompt: str = \"\") -> str:\n    \"\"\"Санитизировать свободное поле и нормализовать управляющие переводы строк.\"\"\"\n    text = str(value) if value is not None else \"\"\n    text = _redact_secrets(text)\n    parts = _prompt_reflected_parts(prompt)\n    for part in parts:\n        text = text.replace(part, \"[REDACTED]\")\n    control_chars = r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\"\n    text = re.sub(control_chars, \" \", text).strip()\n    for part in parts:\n        normalized = re.sub(control_chars, \" \", part).strip()\n        text = text.replace(normalized, \"[REDACTED]\")\n    return text\n\n\ndef _redact_quota(value: Any) -> Any:\n    \"\"\"Удалить значения чувствительных ключей quota до JSON-сериализации.\"\"\"\n    if isinstance(value, dict):\n        return {\n            key: \"[REDACTED]\"\n            if re.sub(r\"[_-]\", \"\", str(key)).lower()\n            in {\"token\", \"secret\", \"password\", \"apikey\", \"bridgekey\", \"authorization\"}\n            else _redact_quota(item)\n            for key, item in value.items()\n        }\n    if isinstance(value, list):\n        return [_redact_quota(item) for item in value]\n    if isinstance(value, str):\n        return _redact_secrets(value)\n    return value\n\n\ndef _turn_diagnostics(params: dict[str, Any], prompt: str) -> list[str]:\n    \"\"\"Собрать приоритетный блок MSP с покомпонентными лимитами и бюджетом 300.\"\"\"\n    error = params.get(\"error\")\n    kind = message = quota = retryable = \"\"\n    if isinstance(error, dict):\n        kind = _diagnostic_text(error.get(\"kind\"), prompt)\n        message = _diagnostic_text(error.get(\"message\"), prompt)\n        if isinstance(error.get(\"retryable\"), bool):\n            retryable = f\" retryable={error['retryable']}\"\n        if error.get(\"quota\") is not None:\n            try:\n                quota = json.dumps(\n                    _redact_quota(error[\"quota\"]),\n                    ensure_ascii=False,\n                    sort_keys=True,\n                    default=str,\n                    separators=(\",\", \":\"),\n                )\n            except (TypeError, ValueError, RecursionError):\n                quota = str(error[\"quota\"])\n            quota = _diagnostic_text(quota, prompt)\n    elif error is not None:\n        message = _diagnostic_text(error, prompt)\n    reason = _diagnostic_text(params.get(\"reason\"), prompt)\n    if reason == message:\n        reason = \"\"\n    fields = {\n        \"kind\": _clip_diagnostic(kind, 64),\n        \"message\": _clip_diagnostic(message, 160),\n        \"quota\": _clip_diagnostic(quota, 120),\n        \"reason\": _clip_diagnostic(reason, 160),\n    }\n\n    def lines() -> list[str]:\n        primary = \": \".join(fields[key] for key in (\"kind\", \"message\") if fields[key])\n        primary += retryable\n        if fields[\"quota\"]:\n            primary += \" quota=\" + fields[\"quota\"]\n        result = [primary.strip()] if primary.strip() else []\n        if fields[\"reason\"]:\n            result.append(\"reason: \" + fields[\"reason\"])\n        return result\n\n    for key in (\"quota\", \"reason\", \"message\", \"kind\"):\n        excess = len(\"\\n\".join(lines())) - 300\n        if excess <= 0:\n            break\n        minimum = min(16, len(fields[key])) if key == \"reason\" else 0\n        fields[key] = _clip_diagnostic(\n            fields[key], max(minimum, len(fields[key]) - excess)\n        )\n    return lines()\n\n\ndef _format_err_log(\n    model: str, via: str, out: dict[str, Any], stream: bool, state: str | None = None\n) -> str:\n    \"\"\"Единая однострочная запись финального отказа без промпта и секретов.\"\"\"\n    return (\n        f\"error model={model} via={via} rc={out.get('rc')} state={state or out.get('state')} \"\n        f\"err={_redact_secrets(str(out.get('err') or ''))[:300]!r} stream={stream}\"\n    )\n\n\ndef _flatten_content(content: Any) -> str:\n    \"\"\"OpenAI content (str | list[part]) -> plain text.\"\"\"\n    if content is None:\n        return \"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        parts = []\n        for item in content:\n            if isinstance(item, str):\n                parts.append(item)\n            elif isinstance(item, dict):\n                if \"text\" in item:\n                    parts.append(str(item[\"text\"]))\n                elif item.get(\"type\") == \"image_url\":\n                    parts.append(\"[image omitted]\")\n        return \"\\n\".join(p for p in parts if p)\n    return str(content)\n\n\ndef _normalize_arguments(value: Any) -> dict | None:\n    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n\n    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n    и запускать инструмент с пустыми аргументами.\n    \"\"\"\n    if isinstance(value, dict):\n        return value\n    if isinstance(value, str):\n        text = value.strip()\n        if text:\n            try:\n                parsed = json.loads(text)\n            except ValueError:\n                return None\n            if isinstance(parsed, dict):\n                return parsed\n    return None\n\n\ndef _normalize_tool_call(item: Any) -> dict:\n    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n\n    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n    с конкретным вызовом при нескольких одинаковых инструментах.\n    \"\"\"\n    if not isinstance(item, dict):\n        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n    args = fn.get(\"arguments\")\n    if args is None:\n        args = item.get(\"arguments\")\n    normalized = _normalize_arguments(args)\n    return {\n        \"id\": str(item.get(\"id\") or \"\"),\n        \"name\": str(name),\n        \"arguments\": normalized if normalized is not None else {},\n    }\n\n\ndef _render_tool_call(item: Any) -> str:\n    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n\n\ndef _tool_choice_none(tool_choice: Any) -> bool:\n    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n\n\ndef _tool_choice_name(tool_choice: Any) -> str:\n    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n    if not isinstance(tool_choice, dict):\n        return \"\"\n    fn = (\n        tool_choice.get(\"function\")\n        if isinstance(tool_choice.get(\"function\"), dict)\n        else {}\n    )\n    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n    return str(name) if name else \"\"\n\n\ndef _tools_section(tools: list, tool_choice: Any) -> str:\n    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n    lines = [\n        \"[system]\",\n        \"# Tool calling protocol\",\n        \"You may call the external tools listed below.\",\n        \"When you need a tool, output ONLY blocks exactly in this form:\",\n        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n        \"You may output several such blocks in a row. Do not narrate around them.\",\n        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n        \"If no tool is needed, reply normally in plain text.\",\n        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n        \"Do not run shell commands or edit files yourself: emit a tool_call block instead.\",\n    ]\n    if tool_choice == \"required\":\n        lines.append(\"You MUST call at least one tool now.\")\n    else:\n        forced = _tool_choice_name(tool_choice)\n        if forced:\n            lines.append(f'You MUST call the tool \"{forced}\" now.')\n    lines.append(\"\")\n    lines.append(\"Available tools:\")\n    for item in tools:\n        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n        if not isinstance(fn, dict):\n            continue\n        name = str(fn.get(\"name\") or \"\")\n        desc = str(fn.get(\"description\") or \"\")\n        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n        lines.append(f\"- {name}: {desc}\")\n        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n    return \"\\n\".join(lines)\n\n\ndef _render_turn(msg: dict[str, Any]) -> tuple[str, str]:\n    \"\"\"Одна реплика истории -> (role, текст); пустой текст = пропустить.\n\n    assistant.tool_calls и role:\"tool\" рендерятся в те же блоки, что протокол.\n    \"\"\"\n    role = str(msg.get(\"role\") or \"user\").strip().lower()\n    text = _flatten_content(msg.get(\"content\"))\n    if role == \"tool\":\n        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n        name = str(msg.get(\"name\") or \"\")\n        header = f\"[tool result {call_id}]\"\n        if name:\n            header += f\" ({name})\"\n        return role, f\"{header}\\n{text}\" if text.strip() else header\n    if role == \"assistant\":\n        parts = [text] if text.strip() else []\n        calls = msg.get(\"tool_calls\")\n        if isinstance(calls, list):\n            parts.extend(_render_tool_call(tc) for tc in calls)\n        return role, \"\\n\".join(parts)\n    return role, text\n\n\ndef _messages_to_prompt(messages: list[dict[str, Any]]) -> tuple[str, str]:\n    \"\"\"История OpenAI -> (system_text, размеченный текст реплик).\"\"\"\n    systems: list[str] = []\n    turns: list[str] = []\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        if role in (\"system\", \"developer\"):\n            systems.append(text)\n        elif role == \"assistant\":\n            turns.append(f\"Assistant: {text}\")\n        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n            turns.append(text)\n        else:\n            turns.append(f\"User: {text}\")\n    return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n\n\ndef _assemble_prompt(\n    messages: list[dict[str, Any]],\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> tuple[str, str, str]:\n    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n    system_text, turns_text = _messages_to_prompt(messages)\n    if not turns_text:\n        return system_text, \"\", \"\"\n    head: list[str] = []\n    if system_text:\n        head.append(f\"[system]\\n{system_text}\")\n    if emulate_tools:\n        head.append(_tools_section(clean_tools, tool_choice))\n    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not system_text:\n        head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n    full_prompt = \"\\n\\n\".join(head) + f\"\\n\\n{turns_text}\" if head else turns_text\n    return system_text, turns_text, full_prompt\n\n\ndef _strip_code_fence(text: str) -> str:\n    \"\"\"Снять обёртку ```…``` (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n    body = text.strip()\n    if body.startswith(\"```\"):\n        newline = body.find(\"\\n\")\n        body = body[newline + 1 :] if newline != -1 else body[3:]\n    if body.rstrip().endswith(\"```\"):\n        body = body.rstrip()[:-3]\n    return body.strip()\n\n\ndef _parse_tool_call_block(inner: str) -> dict | None:\n    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n\n    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n    \"\"\"\n    try:\n        obj = json.loads(_strip_code_fence(inner))\n    except ValueError:\n        return None\n    if not isinstance(obj, dict):\n        return None\n    name = obj.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return None\n    arguments: dict = {}\n    if \"arguments\" in obj:\n        normalized = _normalize_arguments(obj.get(\"arguments\"))\n        if normalized is None:\n            return None\n        arguments = normalized\n    return {\"name\": name.strip(), \"arguments\": arguments}\n\n\nclass ToolCallParser:\n    \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n\n    Тег <tool_call> может прийти разорванным между дельтами: хвост, который может\n    оказаться началом тега, удерживается и не уходит в content до разрешения.\n    \"\"\"\n\n    def __init__(self, on_content, on_tool_call):\n        self._buf = \"\"\n        self._on_content = on_content\n        self._on_tool_call = on_tool_call\n\n    def feed(self, text: str) -> None:\n        self._buf += text\n        self._drain(final=False)\n\n    def finish(self) -> None:\n        self._drain(final=True)\n\n    def _drain(self, final: bool) -> None:\n        while True:\n            start = self._buf.find(TOOL_CALL_OPEN)\n            if start == -1:\n                if final:\n                    self._flush_all()\n                    return\n                keep = self._pending_prefix()\n                if keep:\n                    self._emit(self._buf[:-keep])\n                    self._buf = self._buf[-keep:]\n                else:\n                    self._flush_all()\n                return\n            if start > 0:\n                self._emit(self._buf[:start])\n                self._buf = self._buf[start:]\n            end = self._find_close_outside_string(len(TOOL_CALL_OPEN))\n            if end == -1:\n                if final:\n                    self._flush_all()  # незакрытый/невалидный блок отдаём текстом\n                return\n            inner = self._buf[len(TOOL_CALL_OPEN) : end]\n            self._buf = self._buf[end + len(TOOL_CALL_CLOSE) :]\n            call = _parse_tool_call_block(inner)\n            if call is None:\n                self._emit(TOOL_CALL_OPEN + inner + TOOL_CALL_CLOSE)\n            else:\n                self._on_tool_call(call)\n\n    def _find_close_outside_string(self, start: int) -> int:\n        \"\"\"Позиция `</tool_call>` вне строковых литералов JSON, или -1.\n\n        Закрывающий тег внутри JSON-строки (например, значение аргумента содержит\n        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n        строку не закрывают.\n        \"\"\"\n        index = start\n        length = len(self._buf)\n        in_string = False\n        escaped = False\n        while index < length:\n            char = self._buf[index]\n            if in_string:\n                if escaped:\n                    escaped = False\n                elif char == \"\\\\\":\n                    escaped = True\n                elif char == '\"':\n                    in_string = False\n            elif char == '\"':\n                in_string = True\n            elif self._buf.startswith(TOOL_CALL_CLOSE, index):\n                return index\n            index += 1\n        return -1\n\n    def _pending_prefix(self) -> int:\n        \"\"\"Длина хвоста — префикса открывающего тега (его нельзя отдать в content).\"\"\"\n        limit = min(len(TOOL_CALL_OPEN) - 1, len(self._buf))\n        for length in range(limit, 0, -1):\n            if self._buf[-length:] == TOOL_CALL_OPEN[:length]:\n                return length\n        return 0\n\n    def _emit(self, text: str) -> None:\n        if text:\n            self._on_content(text)\n\n    def _flush_all(self) -> None:\n        if self._buf:\n            text, self._buf = self._buf, \"\"\n            self._on_content(text)\n\n\ndef _split_tool_calls(chunks: list[str]) -> tuple[str, list[dict]]:\n    \"\"\"Дельты текста ответа -> (content, tool_calls в формате OpenAI).\n\n    Тот же ToolCallParser, что у droid-bridge; id вызовов — call_<hex24>.\n    \"\"\"\n    pieces: list[str] = []\n    calls: list[dict] = []\n\n    def add_call(call: dict) -> None:\n        calls.append(\n            {\n                \"index\": len(calls),\n                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": call[\"name\"],\n                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n                },\n            }\n        )\n\n    parser = ToolCallParser(pieces.append, add_call)\n    for chunk in chunks:\n        parser.feed(chunk)\n    parser.finish()\n    return \"\".join(pieces), calls\n\n\ndef _map_effort(req: dict[str, Any]) -> str:\n    \"\"\"reasoning_effort (chat) | reasoning.effort (responses-стиль) -> тир Muse.\"\"\"\n    raw: Any = req.get(\"reasoning_effort\")\n    if raw is None and isinstance(req.get(\"reasoning\"), dict):\n        raw = req[\"reasoning\"].get(\"effort\")\n    key = str(raw).strip().lower() if raw is not None else \"\"\n    return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n\n\ndef _estimate_tokens(text: str) -> int:\n    \"\"\"Консервативная оценка токенов по UTF-8 байтам и символам (ADR-001.2 §2.5).\"\"\"\n    if not text:\n        return 0\n    return max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)\n\n\ndef _context_limit(model: str) -> int:\n    \"\"\"Единый источник лимита окна модели из ALLOWED_MODELS (ADR-001.1).\"\"\"\n    spec = ALLOWED_MODELS.get(model)\n    if isinstance(spec, dict):\n        val = spec.get(\"context_length\")\n        if isinstance(val, int) and val > 0:\n            return val\n    return DEFAULT_CONTEXT_LIMIT\n\n\ndef _context_target(limit: int) -> int:\n    \"\"\"Целевой бюджет проактивного прунинга с гистерезисом 80% (ADR-001.1).\"\"\"\n    return (limit * 4) // 5\n\n\ndef _context_retry_target(limit: int) -> int:\n    \"\"\"Аварийный бюджет однократного retry 50% (ADR-001.1).\"\"\"\n    return limit // 2\n\n\nclass PruneResult(NamedTuple):\n    status: str  # \"pass_through\" | \"pruned\" | \"refused\"\n    messages: list[dict[str, Any]]\n    prompt: str\n    est_before: int\n    est_after: int\n    msgs_total: int\n    msgs_kept: int\n    msgs_dropped: int\n    mandatory_est: int\n    overhead_est: int\n\n\ndef _overhead_tokens_estimate(\n    has_system: bool,\n    tools: list[dict[str, Any]] | None,\n    tool_choice: Any,\n    raw_tools: Any,\n) -> int:\n    \"\"\"Оценка фиксированной шапки промпта ([system], схемы инструментов, DEFAULT_SYSTEM_HINT).\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n    overhead = 0\n    if has_system:\n        overhead += _estimate_tokens(\"[system]\\n\") + 1\n    if emulate_tools:\n        overhead += _estimate_tokens(_tools_section(clean_tools, tool_choice)) + 1\n    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not has_system:\n        overhead += _estimate_tokens(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\") + 1\n    return overhead\n\n\ndef _prune_messages(\n    messages: list[dict[str, Any]],\n    limit: int,\n    target: int,\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> PruneResult:\n    \"\"\"Чистая функция защитного прунинга истории диалога (ADR-001.2).\"\"\"\n    _, _, full_prompt = _assemble_prompt(\n        messages, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    est_before = _estimate_tokens(full_prompt)\n\n    valid_msgs: list[dict[str, Any]] = []\n    roles: list[str] = []\n    real_msgs_total = 0\n    for msg in messages or []:\n        if not isinstance(msg, dict):\n            continue\n        role, text = _render_turn(msg)\n        if not text.strip():\n            continue\n        valid_msgs.append(msg)\n        roles.append(role)\n        if role != _COMPACTION_MARKER_ROLE:\n            real_msgs_total += 1\n\n    has_system = any(r in (\"system\", \"developer\") for r in roles)\n    overhead_est = _overhead_tokens_estimate(has_system, tools, tool_choice, raw_tools)\n\n    if est_before <= limit:\n        mandatory_est = _compute_mandatory_est_only(\n            valid_msgs, roles, tools, tool_choice, raw_tools\n        )\n        return PruneResult(\n            status=\"pass_through\",\n            messages=messages,\n            prompt=full_prompt,\n            est_before=est_before,\n            est_after=est_before,\n            msgs_total=real_msgs_total,\n            msgs_kept=real_msgs_total,\n            msgs_dropped=0,\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n\n    units, mandatory_indices = _partition_units(valid_msgs, roles)\n\n    def build_candidate(kept_flags: list[bool]) -> list[dict[str, Any]]:\n        pruned: list[dict[str, Any]] = []\n        seen_kept_turn = False\n        in_dropped_gap = False\n        for u_idx, unit in enumerate(units):\n            u_role = _render_turn(unit[0])[0]\n            if u_role in (\"system\", \"developer\"):\n                pruned.extend(unit)\n                continue\n            if u_role == _COMPACTION_MARKER_ROLE:\n                if seen_kept_turn:\n                    in_dropped_gap = True\n                continue\n            if kept_flags[u_idx]:\n                if in_dropped_gap:\n                    pruned.append(\n                        {\"role\": _COMPACTION_MARKER_ROLE, \"content\": COMPACTION_MARKER}\n                    )\n                    in_dropped_gap = False\n                pruned.extend(unit)\n                seen_kept_turn = True\n            else:\n                if seen_kept_turn:\n                    in_dropped_gap = True\n        return pruned\n\n    kept = [i in mandatory_indices for i in range(len(units))]\n    mandatory_msgs = build_candidate(kept)\n    _, _, mandatory_prompt = _assemble_prompt(\n        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    mandatory_est = _estimate_tokens(mandatory_prompt)\n    cap = max(limit, target)\n    if mandatory_est > cap:\n        kept_count = sum(\n            len(units[i])\n            for i in range(len(units))\n            if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n        )\n        return PruneResult(\n            status=\"refused\",\n            messages=mandatory_msgs,\n            prompt=mandatory_prompt,\n            est_before=est_before,\n            est_after=mandatory_est,\n            msgs_total=real_msgs_total,\n            msgs_kept=kept_count,\n            msgs_dropped=max(0, real_msgs_total - kept_count),\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n\n    # Фаза C: непрерывный суффикс опциональных единиц от новейшей к старейшей.\n    for u_idx in range(len(units) - 1, -1, -1):\n        if u_idx in mandatory_indices:\n            continue\n        if _render_turn(units[u_idx][0])[0] == _COMPACTION_MARKER_ROLE:\n            continue\n        kept[u_idx] = True\n        cand_msgs = build_candidate(kept)\n        _, _, cand_prompt = _assemble_prompt(\n            cand_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n        )\n        if _estimate_tokens(cand_prompt) <= target:\n            continue\n        kept[u_idx] = False\n        break\n\n    pruned_msgs = build_candidate(kept)\n    _, _, pruned_prompt = _assemble_prompt(\n        pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    est_after = _estimate_tokens(pruned_prompt)\n    while est_after > target:\n        opt_indices = [\n            i\n            for i in range(len(units))\n            if kept[i]\n            and i not in mandatory_indices\n            and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n        ]\n        if not opt_indices:\n            break\n        kept[opt_indices[0]] = False\n        pruned_msgs = build_candidate(kept)\n        _, _, pruned_prompt = _assemble_prompt(\n            pruned_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n        )\n        est_after = _estimate_tokens(pruned_prompt)\n\n    kept_count = sum(\n        len(units[i])\n        for i in range(len(units))\n        if kept[i] and _render_turn(units[i][0])[0] != _COMPACTION_MARKER_ROLE\n    )\n    dropped_count = max(0, real_msgs_total - kept_count)\n    if est_after > cap:\n        return PruneResult(\n            status=\"refused\",\n            messages=pruned_msgs,\n            prompt=pruned_prompt,\n            est_before=est_before,\n            est_after=est_after,\n            msgs_total=real_msgs_total,\n            msgs_kept=kept_count,\n            msgs_dropped=dropped_count,\n            mandatory_est=mandatory_est,\n            overhead_est=overhead_est,\n        )\n    return PruneResult(\n        status=\"pruned\",\n        messages=pruned_msgs,\n        prompt=pruned_prompt,\n        est_before=est_before,\n        est_after=est_after,\n        msgs_total=real_msgs_total,\n        msgs_kept=kept_count,\n        msgs_dropped=dropped_count,\n        mandatory_est=mandatory_est,\n        overhead_est=overhead_est,\n    )\n\n\ndef _partition_units(\n    valid_msgs: list[dict[str, Any]], roles: list[str]\n) -> tuple[list[list[dict[str, Any]]], set[int]]:\n    \"\"\"Разбить валидные сообщения на атомарные единицы и выделить обязательные индексы M.\"\"\"\n    units: list[list[dict[str, Any]]] = []\n    consumed_tools: set[int] = set()\n\n    for idx, msg in enumerate(valid_msgs):\n        role = roles[idx]\n        if role == \"tool\":\n            # Осиротевшие tool не попадают в units при прунинге; связанные поглощаются assistant.\n            continue\n        if (\n            role == \"assistant\"\n            and isinstance(msg.get(\"tool_calls\"), list)\n            and msg.get(\"tool_calls\")\n        ):\n            call_ids = [\n                _normalize_tool_call(tc)[\"id\"]\n                for tc in msg[\"tool_calls\"]\n                if _normalize_tool_call(tc)[\"id\"]\n            ]\n            if call_ids:\n                expected = set(call_ids)\n                matched_indices: list[int] = []\n                matched_ids: set[str] = set()\n                for j in range(idx + 1, len(valid_msgs)):\n                    if j in consumed_tools or roles[j] != \"tool\":\n                        continue\n                    tc_id = str(\n                        valid_msgs[j].get(\"tool_call_id\")\n                        or valid_msgs[j].get(\"id\")\n                        or \"\"\n                    )\n                    if tc_id in expected:\n                        matched_indices.append(j)\n                        matched_ids.add(tc_id)\n                if matched_ids == expected:\n                    consumed_tools.update(matched_indices)\n                    units.append([msg] + [valid_msgs[j] for j in matched_indices])\n                continue\n        units.append([msg])\n\n    mandatory_indices: set[int] = set()\n    user_unit_indices: list[int] = []\n    last_non_sys_idx: int | None = None\n    for u_idx, unit in enumerate(units):\n        u_role = _render_turn(unit[0])[0]\n        if u_role in (\"system\", \"developer\"):\n            mandatory_indices.add(u_idx)\n        elif u_role != _COMPACTION_MARKER_ROLE:\n            last_non_sys_idx = u_idx\n            if u_role not in (\"assistant\", \"tool\"):\n                user_unit_indices.append(u_idx)\n\n    if user_unit_indices:\n        mandatory_indices.add(user_unit_indices[0])\n        mandatory_indices.add(user_unit_indices[-1])\n        # Незавершённая единица ответа (assistant+tool после последнего user, ADR-001.2 §2.2 п.4).\n        if (\n            last_non_sys_idx is not None\n            and last_non_sys_idx > user_unit_indices[-1]\n            and len(units[last_non_sys_idx]) > 1\n        ):\n            mandatory_indices.add(last_non_sys_idx)\n\n    return units, mandatory_indices\n\n\ndef _compute_mandatory_est_only(\n    valid_msgs: list[dict[str, Any]],\n    roles: list[str],\n    tools: list[dict[str, Any]] | None,\n    tool_choice: Any,\n    raw_tools: Any,\n) -> int:\n    units, mandatory_indices = _partition_units(valid_msgs, roles)\n    mandatory_msgs = [\n        m\n        for u_idx, unit in enumerate(units)\n        if u_idx in mandatory_indices\n        for m in unit\n    ]\n    _, _, mandatory_prompt = _assemble_prompt(\n        mandatory_msgs, tools=tools, tool_choice=tool_choice, raw_tools=raw_tools\n    )\n    return _estimate_tokens(mandatory_prompt)\n\n\ndef _log_context_prune(\n    rid: str,\n    model: str,\n    reason: str,\n    attempt: int,\n    limit: int,\n    target: int,\n    res: PruneResult,\n) -> None:\n    \"\"\"Структурная запись прунинга без тел сообщений и секретов (ADR-001.4 §4.3).\"\"\"\n    logger.info(\n        \"muse_context_pruned: model=%s initial=%d target=%d dropped=%d is_retry=%s\",\n        model,\n        res.est_before,\n        target,\n        res.msgs_dropped,\n        attempt > 1,\n    )\n    _log(\n        f\"context_prune rid={rid} model={model} reason={reason} attempt={attempt} \"\n        f\"limit={limit} target={target} est_before={res.est_before} est_after={res.est_after} \"\n        f\"msgs_total={res.msgs_total} msgs_kept={res.msgs_kept} msgs_dropped={res.msgs_dropped} \"\n        f\"mandatory_est={res.mandatory_est} overhead_est={res.overhead_est} method=bytes_div_3\"\n    )\n\n\n# Эмуляция SSE (OpenAI chat.completion.chunk): результат генерации уже целиком —\n# «стрим» = нарезка готового текста на чанки с минимальной задержкой между ними.\nSSE_CHUNK_SIZE = int(os.environ.get(\"MUSE_BRIDGE_SSE_CHUNK_SIZE\", \"300\"))\nSSE_CHUNK_DELAY_S = float(os.environ.get(\"MUSE_BRIDGE_SSE_CHUNK_DELAY_S\", \"0.005\"))\n# stream=true: заголовки и role-кадр уходят сразу, пока ход идёт — комментарии keepalive.\n# Без них клиент (OpenAI SDK в DeepSeek Harness) ждал заголовков до своего таймаута\n# (~600 с) и рвал долгий ход как \"Request timed out\".\nKEEPALIVE_S = float(os.environ.get(\"MUSE_BRIDGE_KEEPALIVE_S\", \"15\"))\n\n\ndef _split_sse_chunks(text: str, size: int = 0) -> list[str]:\n    \"\"\"Готовый текст -> куски для SSE-дельт (по символам, юникод-сейф).\"\"\"\n    size = size or SSE_CHUNK_SIZE\n    size = max(1, size)\n    return [text[i : i + size] for i in range(0, len(text), size)] if text else []\n\n\ndef _kill_group(proc: subprocess.Popen) -> None:\n    \"\"\"Убить всю группу процессов хода: ребёнок — лидер группы (start_new_session).\n\n    Фолбэк proc.kill() — если killpg недоступен/запрещён (эталон\n    adapters/muse_adapter.py, RW-009).\n    \"\"\"\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        try:\n            proc.kill()\n        except OSError:\n            pass\n\n\ndef _group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (killpg сигналом 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef _wait_group_exit(pgid: int, timeout: float, leader_reaped: bool = False) -> bool:\n    \"\"\"Короткое ожидание ухода группы после SIGKILL (обычно мгновенно).\n\n    Пока группа жива, SIGKILL повторяется: потомок, форкнувшийся в момент первого killpg,\n    остаётся в группе и иначе держал бы pipe (close() вешался бы на чтении stderr).\n    Лидер реапнут (leader_reaped) — его pid свободен для переиспользования, поэтому после\n    одного контрольного killpg по ещё живым потомкам сигналы прекращаются, остаётся опрос.\n    \"\"\"\n    deadline = time.monotonic() + timeout\n    control_sent = False\n    while _group_alive(pgid) and time.monotonic() < deadline:\n        if not (leader_reaped and control_sent):\n            try:\n                os.killpg(pgid, signal.SIGKILL)\n            except OSError:\n                pass\n            control_sent = True\n        time.sleep(0.05)\n    return not _group_alive(pgid)\n\n\ndef _terminate_run(run: Any, streams: tuple) -> None:\n    \"\"\"Убить группу хода и подтвердить её смерть; результат — run.dead_confirmed.\n\n    TimeoutExpired при ожидании после SIGKILL не считается смертью: SIGKILL группы повторяется\n    (в _wait_group_exit тоже), смерть группы проверяется по факту. Не подтверждена — трубы не\n    закрываются (close() ждал бы читателя), слот хендлера уйдёт в карантин.\n    \"\"\"\n    proc = run.proc\n    if proc is None:\n        return\n    # Уборка идёт под замком: параллельный close() (таймер, надзор обрыва, finally\n    # execute) ждёт её конца и видит итоговый dead_confirmed, а не выходит по _closed.\n    with run._cleanup_lock:\n        if run._closed:\n            return\n        run._closed = True\n        # Пессимистично до подтверждения: оборванная уборка уйдёт в карантин слота.\n        run.dead_confirmed = False\n\n<system-reminder>[Showing lines 1-1111 of 2595 total lines]</system-reminder>","timestamp":1791993017199,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
{"type":"tool_result","id":"tc-6ctijzieh9i","messageId":"6b5ffa2a-22d1-4434-a8e4-3a7862bc93eb","toolId":"Read","isError":false,"value":"\"\"\"Regression-тесты утечки слотов muse-bridge: killpg группы и обрыв клиента.\n\n2026-10-09: close() Run/ServeRun бил только прямого ребёнка (proc.kill),\nsleep-«внук» в группе хода выживал; обрыв клиента во время exec/serve ход не\nпрерывал — слот держался всю длительность прогона (до TIMEOUT_S), /health\nпоказывал active=1. Тесты гоняют зеркальную копию моста\nbridges/muse-bridge/server.py без живого muse-bin: вместо CLI — фейк-обёртка\nна sh (serve сразу rc=42 → безусловный fallback на exec, exec держит ход:\nлидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\nкоторый проходит handshake и держит turn/start без завершения.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport http.client\nimport io\nimport itertools\nimport json\nimport os\nimport re\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any, Callable\nfrom unittest import mock\n\n_REPO_BRIDGE_PY = (\n    Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n)\nBRIDGE_PY = (\n    _REPO_BRIDGE_PY\n    if _REPO_BRIDGE_PY.exists()\n    else Path(__file__).resolve().parents[1] / \"server.py\"\n)\n\n_LOAD_SEQ = itertools.count()\nDISCONNECT_AFTER_S = 1.0\nSCENARIO_DEADLINE_S = 5.0\nGROUP_EXIT_WAIT_S = 5.0\n\n# Фейк muse-cli.sh: транспорт serve «недоступен» (мост уходит в fallback exec),\n# exec пишет pid лидера группы и держит ход 30 с.\nFAKE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exit 42\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Фейк muse-cli.sh для serve-хода: serve принимает turn/start и держит ход (без\n# turn/completed), exec-fallback отмечается отдельным pid-файлом — его появление\n# означает, что сценарий serve не удался.\nSERVE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exec \"{python}\" \"{script}\" \"{servepid}\"\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Python-скрипт serve: handshake по NDJSON JSON-RPC, после turn/start — «внук» sleep\n# в той же группе и pid-файл лидера (сигнал «serve удерживает ход»), дальше тишина.\nFAKE_SERVE_SCRIPT = \"\"\"import json, os, subprocess, sys, time\n\npidfile = sys.argv[1]\nRESULTS = {\n    \"session/start\": {\"session\": {\"sessionId\": \"sess-1\"}},\n    \"turn/start\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"},\n}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    rid = msg.get(\"id\")\n    if rid is None:\n        continue\n    reply = {\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": RESULTS.get(msg[\"method\"], {})}\n    sys.stdout.write(json.dumps(reply) + \"\\\\n\")\n    sys.stdout.flush()\n    if msg[\"method\"] == \"turn/start\":\n        subprocess.Popen([\"sleep\", \"30\"])\n        with open(pidfile, \"w\") as fh:\n            fh.write(str(os.getpid()))\n        while True:\n            time.sleep(1)\n\"\"\"\n\n\ndef load_bridge() -> Any:\n    \"\"\"Свежий экземпляр модуля моста: изолированные _slots/_active на каждый тест.\"\"\"\n    spec = importlib.util.spec_from_file_location(\n        f\"muse_bridge_server_{next(_LOAD_SEQ)}\", BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (сигнал 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef wait_until(predicate: Callable[[], bool], timeout: float) -> bool:\n    \"\"\"Опрос predicate каждые 50 мс до timeout (замер и на последней границе).\"\"\"\n    deadline = time.monotonic() + timeout\n    while True:\n        if predicate():\n            return True\n        if time.monotonic() >= deadline:\n            return predicate()\n        time.sleep(0.05)\n\n\nclass CloseKillsGroupTest(unittest.TestCase):\n    \"\"\"R1: close() убивает всю группу хода, а не только прямого ребёнка.\"\"\"\n\n    @staticmethod\n    def _spawn_group() -> subprocess.Popen:\n        \"\"\"Лидер-шелл + sleep-«внук» в собственной группе (start_new_session).\"\"\"\n        return subprocess.Popen(\n            [\"/bin/sh\", \"-c\", \"sleep 60 & wait\"],\n            start_new_session=True,\n        )\n\n    @staticmethod\n    def _reap_group(proc: subprocess.Popen) -> None:\n        \"\"\"Добить и реапнуть свою мок-группу (только свой PGID, чужие не трогаем).\"\"\"\n        try:\n            os.killpg(proc.pid, signal.SIGKILL)\n        except (ProcessLookupError, OSError):\n            pass\n        try:\n            proc.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            pass\n\n    def _assert_close_kills_group(self, run: Any) -> None:\n        proc = self._spawn_group()\n        self.addCleanup(self._reap_group, proc)\n        run.proc = proc\n        run.close()\n        gone = wait_until(lambda: not group_alive(proc.pid), GROUP_EXIT_WAIT_S)\n        self.assertTrue(\n            gone,\n            f\"sleep-внук в группе {proc.pid} пережил close() — утечка процессов\",\n        )\n\n    def test_r1_run_close_kills_group(self) -> None:\n        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-r1-\") as tmp:\n            run = load_bridge().Run(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n            self._assert_close_kills_group(run)\n\n    def test_r1_serve_run_close_kills_group(self) -> None:\n        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-r1-\") as tmp:\n            run = load_bridge().ServeRun(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n            self._assert_close_kills_group(run)\n\n\nclass _BridgeScenario(unittest.TestCase):\n    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n\n    # Значения инициализируются в setUp() каждого теста.\n    tmp: Path = Path()\n    mod: Any = None\n    pidfile: Path = Path()\n    servepid: Path = Path()\n    server: Any = None\n\n    def wrapper_text(self) -> str:\n        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n\n    def setUp(self) -> None:\n        self.tmp = Path(tempfile.mkdtemp(prefix=\"muse-bridge-killpg-\"))\n        self.addCleanup(shutil.rmtree, str(self.tmp), True)\n        self.mod = load_bridge()\n        # Работаем только во временном каталоге: workspace и лог моста — не в репо.\n        self.mod.WORKSPACE = self.tmp / \"workspace\"\n        self.mod.LOG_PATH = self.tmp / \"bridge.log\"\n        # Один слот: при двух утечка одного не видна неблокирующей пробой семафора.\n        self.mod._slots = threading.Semaphore(1)\n        self.pidfile = self.tmp / \"run.pid\"\n        self.servepid = self.tmp / \"serve.pid\"\n        wrapper = self.tmp / \"muse-cli.sh\"\n        wrapper.write_text(self.wrapper_text(), encoding=\"utf-8\")\n        wrapper.chmod(0o755)\n        self.mod.MUSE_WRAPPER = str(wrapper)\n        self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n        threading.Thread(target=self.server.serve_forever, daemon=True).start()\n        self.addCleanup(self._teardown_scenario)\n\n    def _teardown_scenario(self) -> None:\n        \"\"\"Стоп сервера + добивание своих мок-групп (только свои PGID).\"\"\"\n        self.server.shutdown()\n        self.server.server_close()\n        for pidfile in (self.pidfile, self.servepid):\n            if pidfile.exists():\n                try:\n                    os.killpg(\n                        int(pidfile.read_text(encoding=\"utf-8\").strip()),\n                        signal.SIGKILL,\n                    )\n                except (ProcessLookupError, OSError, ValueError):\n                    pass\n\n    def _open_request(self) -> socket.socket:\n        \"\"\"POST /v1/chat/completions; соединение остаётся открытым (закрывает вызывающий).\"\"\"\n        body = json.dumps(\n            {\n                \"model\": \"muse-spark-1.3\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}],\n            }\n        ).encode(\"utf-8\")\n        head = (\n            \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n            \"Host: 127.0.0.1\\r\\n\"\n            \"Content-Type: application/json\\r\\n\"\n            f\"Content-Length: {len(body)}\\r\\n\"\n            \"Connection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n        sock.sendall(head + body)\n        return sock\n\n    def _post_request_disconnect(self) -> None:\n        \"\"\"POST /v1/chat/completions и обрыв соединения через DISCONNECT_AFTER_S.\"\"\"\n        sock = self._open_request()\n        try:\n            time.sleep(DISCONNECT_AFTER_S)\n        finally:\n            sock.close()\n\n    def _slot_free(self) -> bool:\n        \"\"\"Неблокирующая проба семафора слотов (сразу возвращаем взятую ячейку).\"\"\"\n        sem = self.mod._slots\n        if sem.acquire(blocking=False):\n            sem.release()\n            return True\n        return False\n\n    def _health_json(self) -> dict[str, Any]:\n        \"\"\"Тело ответа GET /health.\"\"\"\n        head = (\n            \"GET /health HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        with socket.create_connection(\n            self.server.server_address[:2], timeout=5\n        ) as sock:\n            sock.sendall(head)\n            chunks = []\n            while True:\n                chunk = sock.recv(65536)\n                if not chunk:\n                    break\n                chunks.append(chunk)\n        body = b\"\".join(chunks).split(b\"\\r\\n\\r\\n\", 1)[1]\n        return json.loads(body.decode(\"utf-8\"))\n\n\nclass HealthQuarantinedTest(_BridgeScenario):\n    \"\"\"FU-004: /health показывает число слотов, изъятых в карантин.\"\"\"\n\n    def test_health_reports_quarantined_slots(self) -> None:\n        self.assertEqual(self._health_json()[\"quarantined\"], 0)\n        self.mod._quarantined_slots.append([424242])\n        self.assertEqual(self._health_json()[\"quarantined\"], 1)\n\n\nclass DisconnectScenarioTest(_BridgeScenario):\n    \"\"\"R2/R3: обрыв клиента во время exec-хода освобождает слот и убивает группу.\"\"\"\n\n    def _run_pid(self) -> int | None:\n        \"\"\"PID лидера exec-группы; None — exec не стартовал (обрыв раньше fallback).\"\"\"\n        if not wait_until(lambda: self.pidfile.exists(), 4.0):\n            return None\n        return int(self.pidfile.read_text(encoding=\"utf-8\").strip())\n\n    def _health_active(self) -> int:\n        return int(self._health_json()[\"active\"])\n\n    def test_r2_disconnect_frees_slot_and_kills_group(self) -> None:\n        sock = self._open_request()\n        self.addCleanup(sock.close)\n        # Обрываем только после появления pid лидера: без запущенного exec сценарий\n        # не проверяет killpg и не вправе давать PASS.\n        started = wait_until(\n            lambda: (\n                self.pidfile.exists()\n                and self.pidfile.read_text(encoding=\"utf-8\").strip() != \"\"\n            ),\n            SCENARIO_DEADLINE_S,\n        )\n        self.assertTrue(started, \"exec не стартовал: сценарий не проверяет killpg\")\n        pid = int(self.pidfile.read_text(encoding=\"utf-8\").strip())\n        self.assertTrue(group_alive(pid), \"exec-группа не жива до обрыва\")\n        time.sleep(DISCONNECT_AFTER_S)\n        sock.close()\n        ok = wait_until(\n            lambda: self._slot_free() and not group_alive(pid),\n            SCENARIO_DEADLINE_S,\n        )\n        self.assertTrue(\n            ok,\n            f\"через {DISCONNECT_AFTER_S}s после обрыва слот занят и группа \"\n            f\"{pid} жива: утечка слота сохраняется\",\n        )\n\n    def test_r3_health_active_zero_after_disconnect(self) -> None:\n        self._post_request_disconnect()\n        pid = self._run_pid()\n        ok = wait_until(lambda: self._health_active() == 0, SCENARIO_DEADLINE_S)\n        self.assertTrue(\n            ok,\n            f\"/health active={self._health_active()} после обрыва клиента \"\n            f\"(pid={pid}): disconnect-ход не снялся с учёта\",\n        )\n\n\nclass ServeDisconnectScenarioTest(_BridgeScenario):\n    \"\"\"R4: обрыв клиента во время живого serve-хода (не exec-fallback).\"\"\"\n\n    def wrapper_text(self) -> str:\n        script = self.tmp / \"fake_serve.py\"\n        script.write_text(FAKE_SERVE_SCRIPT, encoding=\"utf-8\")\n        return SERVE_WRAPPER.format(\n            python=sys.executable,\n            script=script,\n            servepid=self.servepid,\n            pidfile=self.pidfile,\n        )\n\n    def test_r4_disconnect_during_serve_turn_kills_group_and_frees_slot(self) -> None:\n        sock = self._open_request()\n        self.addCleanup(sock.close)\n        # Ход подтверждён: serve принял turn/start и держит его (pid-файл пишется после ack).\n        started = wait_until(lambda: self.servepid.exists(), SCENARIO_DEADLINE_S)\n        self.assertTrue(started, \"serve-ход не стартовал: сценарий не проверяет serve\")\n        pid = int(self.servepid.read_text(encoding=\"utf-8\").strip())\n        self.assertTrue(group_alive(pid), \"serve-группа не жива до обрыва\")\n        self.assertFalse(self._slot_free(), \"слот свободен во время serve-хода\")\n        self.assertFalse(self.pidfile.exists(), \"произошёл exec-fallback вместо serve\")\n\n        sock.close()\n        ok = wait_until(\n            lambda: self._slot_free() and not group_alive(pid), SCENARIO_DEADLINE_S\n        )\n        self.assertTrue(\n            ok,\n            f\"после обрыва serve-хода слот занят или группа {pid} жива \"\n            \"(ServeRun не входит в /health.active — смотрим группу и семафор)\",\n        )\n        self.assertFalse(self.pidfile.exists(), \"после обрыва запущен exec-fallback\")\n\n\nclass SpyConn:\n    \"\"\"Обёртка сокета: фиксирует смену режима и флаги recv, остальное — настоящий сокет.\"\"\"\n\n    def __init__(self, sock: socket.socket) -> None:\n        self._sock = sock\n        self.settimeout_calls: list[Any] = []\n        self.recv_flags: list[int] = []\n\n    def fileno(self) -> int:\n        return self._sock.fileno()\n\n    def gettimeout(self) -> float | None:\n        return self._sock.gettimeout()\n\n    def settimeout(self, value: Any) -> None:\n        self.settimeout_calls.append(value)\n        self._sock.settimeout(value)\n\n    def recv(self, size: int, flags: int = 0) -> bytes:\n        self.recv_flags.append(flags)\n        return self._sock.recv(size, flags)\n\n\nclass ClientGoneProbeTest(unittest.TestCase):\n    \"\"\"R5: проба обрыва клиента не меняет режим общего сокета и не ломает запись.\"\"\"\n\n    def _probe_pair(self) -> tuple[Any, SpyConn, socket.socket]:\n        handler_cls = load_bridge().Handler\n        left, right = socket.socketpair()\n        self.addCleanup(left.close)\n        self.addCleanup(right.close)\n        left.settimeout(5.0)\n        spy = SpyConn(left)\n        handler = handler_cls.__new__(handler_cls)\n        handler.connection = spy  # type: ignore[assignment]\n        return handler, spy, right\n\n    def test_probe_uses_msg_dontwait_without_mode_change(self) -> None:\n        handler, spy, peer = self._probe_pair()\n        peer.sendall(b\"x\")\n        self.assertFalse(handler._client_gone_probe())\n        self.assertEqual(spy.settimeout_calls, [], \"проба сменила timeout сокета\")\n        self.assertEqual(spy.gettimeout(), 5.0)\n        dontwait = getattr(socket, \"MSG_DONTWAIT\", 0)\n        self.assertTrue(spy.recv_flags, \"peek не выполнялся\")\n        for flags in spy.recv_flags:\n            self.assertTrue(flags & socket.MSG_PEEK)\n            self.assertTrue(flags & dontwait)\n\n    def test_probe_no_data_is_not_disconnect(self) -> None:\n        handler, spy, _peer = self._probe_pair()\n        self.assertFalse(handler._client_gone_probe())\n        self.assertEqual(spy.settimeout_calls, [])\n\n    def test_probe_leaves_pending_data_unread(self) -> None:\n        handler, spy, peer = self._probe_pair()\n        peer.sendall(b\"x\")\n        self.assertFalse(handler._client_gone_probe())\n        self.assertEqual(spy._sock.recv(1), b\"x\")\n\n    def test_probe_detects_fin_and_reset(self) -> None:\n        handler, _spy, peer = self._probe_pair()\n        peer.close()\n        self.assertTrue(handler._client_gone_probe())\n\n    def test_probe_does_not_break_concurrent_write(self) -> None:\n        \"\"\"Проба параллельно с большой записью: запись не падает, обрыва не видно.\"\"\"\n        handler, spy, peer = self._probe_pair()\n        peer.sendall(b\"x\")  # select готов -> проба доходит до peek\n        stop = threading.Event()\n        probes: list[bool] = []\n\n        def prober() -> None:\n            while not stop.is_set():\n                probes.append(handler._client_gone_probe())\n\n        def drain() -> None:\n            while peer.recv(65536):\n                pass\n\n        drainer = threading.Thread(target=drain, daemon=True)\n        drainer.start()\n        thread = threading.Thread(target=prober, daemon=True)\n        thread.start()\n        try:\n            spy._sock.sendall(b\"y\" * (8 * 1024 * 1024))\n        finally:\n            stop.set()\n            thread.join(timeout=5)\n        self.assertTrue(probes)\n        self.assertFalse(any(probes), \"проба приняла живого клиента за оборвавшегося\")\n        self.assertEqual(spy.settimeout_calls, [])\n        spy._sock.shutdown(socket.SHUT_WR)\n        drainer.join(timeout=5)\n\n\nclass QuarantineSlotTest(unittest.TestCase):\n    \"\"\"R6: слот в карантине не возвращается, пока группа жива, даже после потолка.\"\"\"\n\n    def test_slot_stays_withdrawn_until_group_dies(self) -> None:\n        mod = load_bridge()\n        mod._slots = threading.Semaphore(1)\n        mod._slots.acquire()\n        mod.QUARANTINE_MAX_S = 0.3\n        logs: list[str] = []\n        mod._log = logs.append\n        proc = subprocess.Popen(\n            [\"/bin/sh\", \"-c\", \"sleep 60 & wait\"], start_new_session=True\n        )\n        self.addCleanup(CloseKillsGroupTest._reap_group, proc)\n        # Живая группа: _kill_group заглушён, поэтому смерть наступает только по нашему killpg.\n        kills: list[int] = []\n        mod._kill_group = lambda p: kills.append(p.pid)\n\n        mod._quarantine_slot([SimpleNamespace(proc=proc)])\n        self.assertEqual(len(mod._quarantined_slots), 1, \"слот не учтён в карантине\")\n\n        critical = wait_until(\n            lambda: any(\"CRITICAL\" in line for line in logs), SCENARIO_DEADLINE_S\n        )\n        self.assertTrue(critical, \"после потолка карантина нет аварийной эскалации\")\n        self.assertTrue(\n            any(str(proc.pid) in line for line in logs if \"CRITICAL\" in line),\n            \"в эскалации нет pgid живой группы\",\n        )\n        self.assertFalse(\n            mod._slots.acquire(blocking=False), \"слот возвращён при живой группе\"\n        )\n        self.assertFalse(any(\"slot released\" in line for line in logs))\n\n        os.killpg(proc.pid, signal.SIGKILL)\n        proc.wait(timeout=5)\n        released = wait_until(\n            lambda: any(\"slot released\" in line for line in logs), SCENARIO_DEADLINE_S\n        )\n        self.assertTrue(released, \"слот не вернулся после смерти группы\")\n        self.assertTrue(mod._slots.acquire(blocking=False), \"слот не освобождён\")\n        self.assertEqual(len(mod._quarantined_slots), 0, \"карантин не очищен\")\n        time.sleep(1.2)\n        self.assertFalse(\n            mod._slots.acquire(blocking=False), \"слот освобождён больше одного раза\"\n        )\n\n    def test_no_signals_after_ceiling(self) -> None:\n        \"\"\"RW-007: после потолка карантина killpg не шлётся, слот остаётся изъятым.\"\"\"\n        mod = load_bridge()\n        mod._slots = threading.Semaphore(1)\n        mod._slots.acquire()\n        mod.QUARANTINE_MAX_S = 0.3\n        logs: list[str] = []\n        mod._log = logs.append\n        proc = subprocess.Popen(\n            [\"/bin/sh\", \"-c\", \"sleep 60 & wait\"], start_new_session=True\n        )\n        self.addCleanup(CloseKillsGroupTest._reap_group, proc)\n        kills: list[int] = []\n        mod._kill_group = lambda p: kills.append(p.pid)\n\n        mod._quarantine_slot([SimpleNamespace(proc=proc)])\n        critical = wait_until(\n            lambda: any(\"CRITICAL\" in line for line in logs), SCENARIO_DEADLINE_S\n        )\n        self.assertTrue(critical, \"после потолка карантина нет аварийной эскалации\")\n        sent = len(kills)\n        self.assertGreaterEqual(sent, 1, \"до потолка группа не добивалась\")\n        time.sleep(2.2)\n        self.assertEqual(len(kills), sent, \"после потолка продолжается спам killpg\")\n        self.assertFalse(\n            mod._slots.acquire(blocking=False), \"слот возвращён при живой группе\"\n        )\n\n    def test_reaped_leader_gets_no_signals(self) -> None:\n        \"\"\"RW-007: лидер реапнут — его PGID свободен для переиспользования, сигналов нет.\"\"\"\n        mod = load_bridge()\n        mod._slots = threading.Semaphore(1)\n        mod._slots.acquire()\n        logs: list[str] = []\n        mod._log = logs.append\n        # Лидер выходит сразу, «внук» остаётся в группе.\n        proc = subprocess.Popen(\n            [\"/bin/sh\", \"-c\", \"sleep 60 & exit 0\"], start_new_session=True\n        )\n        proc.wait(timeout=5)\n        self.addCleanup(CloseKillsGroupTest._reap_group, proc)\n        self.assertTrue(group_alive(proc.pid), \"стенд: группа должна быть жива\")\n        kills: list[int] = []\n        mod._kill_group = lambda p: kills.append(p.pid)\n\n        mod._quarantine_slot([SimpleNamespace(proc=proc)])\n        time.sleep(2.2)\n        self.assertEqual(kills, [], \"killpg по PGID реапнутого лидера\")\n\n        os.killpg(proc.pid, signal.SIGKILL)\n        released = wait_until(\n            lambda: any(\"slot released\" in line for line in logs), SCENARIO_DEADLINE_S\n        )\n        self.assertTrue(released, \"слот не вернулся после смерти группы\")\n\n\nclass ConcurrentCloseTest(unittest.TestCase):\n    \"\"\"RW-006: параллельный close() ждёт конца уборки, а не выходит по _closed.\"\"\"\n\n    def _assert_second_close_waits(self, cls_name: str) -> None:\n        mod = load_bridge()\n        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-rw006-\") as tmp:\n            run = getattr(mod, cls_name)(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n            proc = CloseKillsGroupTest._spawn_group()\n            self.addCleanup(CloseKillsGroupTest._reap_group, proc)\n            run.proc = proc\n            real_kill = mod._kill_group\n            started = threading.Event()\n            seen: list[bool] = []\n\n            def slow_kill(p: subprocess.Popen) -> None:\n                seen.append(run.dead_confirmed)\n                started.set()\n                time.sleep(0.6)\n                real_kill(p)\n\n            mod._kill_group = slow_kill\n            first = threading.Thread(target=run.close)\n            first.start()\n            self.assertTrue(started.wait(5), \"первая уборка не стартовала\")\n            run.close()\n            self.assertFalse(\n                group_alive(proc.pid),\n                \"второй close() вернулся до окончания уборки группы\",\n            )\n            self.assertTrue(run.dead_confirmed)\n            self.assertEqual(seen, [False], \"во время уборки dead_confirmed не False\")\n            first.join(timeout=5)\n\n    def test_run_second_close_waits_for_cleanup(self) -> None:\n        self._assert_second_close_waits(\"Run\")\n\n    def test_serve_run_second_close_waits_for_cleanup(self) -> None:\n        self._assert_second_close_waits(\"ServeRun\")\n\n\nclass WaitGroupExitTest(unittest.TestCase):\n    \"\"\"FU-001: после реапа лидера killpg по старому PGID шлётся не больше одного раза.\"\"\"\n\n    @staticmethod\n    def _count_sigkills(leader_reaped: bool) -> tuple[bool, int]:\n        mod = load_bridge()\n        sigkills: list[int] = []\n\n        def fake_killpg(pgid: int, sig: int) -> None:\n            if sig == signal.SIGKILL:\n                sigkills.append(pgid)\n\n        with mock.patch.object(mod.os, \"killpg\", fake_killpg):\n            dead = mod._wait_group_exit(424242, 0.4, leader_reaped=leader_reaped)\n        return dead, len(sigkills)\n\n    def test_reaped_leader_gets_single_control_kill(self) -> None:\n        dead, count = self._count_sigkills(leader_reaped=True)\n        self.assertFalse(dead)\n        self.assertEqual(count, 1)\n\n    def test_live_leader_keeps_killing(self) -> None:\n        _dead, count = self._count_sigkills(leader_reaped=False)\n        self.assertGreater(count, 1)\n\n\ndef bridge_request(\n    scenario: Any, payload: dict | None = None, path: str = \"/v1/chat/completions\"\n) -> tuple[int, bytes]:\n    \"\"\"Прочитать полный ответ локального стенда, включая терминальный SSE-кадр.\"\"\"\n    conn = http.client.HTTPConnection(*scenario.server.server_address[:2], timeout=5)\n    try:\n        conn.request(\n            \"POST\" if payload is not None else \"GET\",\n            path,\n            json.dumps(payload) if payload is not None else None,\n            {\"Content-Type\": \"application/json\", \"Connection\": \"close\"},\n        )\n        response = conn.getresponse()\n        return response.status, response.read()\n    finally:\n        conn.close()\n\n\ndef turn_request(stream: bool = False) -> dict:\n    \"\"\"Минимальный клиентский запрос без живого провайдера.\"\"\"\n    return {\n        \"model\": \"muse-spark-1.3\",\n        \"messages\": [{\"role\": \"user\", \"content\": \"prompt-canary-private\"}],\n        \"stream\": stream,\n    }\n\n\nclass ErrorLoggingTest(_BridgeScenario):\n    \"\"\"AD-001/F-001: все выходы журналируются и не раскрывают отражённые секреты.\"\"\"\n\n    def _error_response(\n        self, state: str, err: Any, stream: bool = False, rc: int = 1\n    ) -> tuple[dict, str]:\n        out = {\"rc\": rc, \"state\": state, \"text\": \"\", \"err\": err}\n        with mock.patch.object(self.mod.ServeRun, \"execute\", return_value=out):\n            status, body = bridge_request(self, turn_request(stream))\n        self.assertEqual(status, 200 if stream else 502)\n        if stream:\n            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n            frames = [\n                json.loads(line[6:])\n                for line in body.decode().splitlines()\n                if line.startswith(\"data: {\")\n            ]\n            error = next(frame[\"error\"] for frame in frames if \"error\" in frame)\n        else:\n            error = json.loads(body)[\"error\"]\n        logs = self.mod.LOG_PATH.read_text()\n        lines = [line for line in logs.splitlines() if \" error model=\" in line]\n        self.assertTrue(lines, \"нет итогового error-лога\")\n        return error, lines[-1]\n\n    def test_all_error_branches_log_once_and_success_stays_done(self) -> None:\n        for stream in (False, True):\n            for state in (\"launcher_missing\", \"spawn_failed\", \"terminal_failed\", \"ok\"):\n                with self.subTest(stream=stream, state=state):\n                    self.mod.LOG_PATH.unlink(missing_ok=True)\n                    error, line = self._error_response(\n                        state, \"line1\\nline2\", stream, 0 if state == \"ok\" else 1\n                    )\n                    self.assertIn(\n                        \"state=\" + (\"empty_output\" if state == \"ok\" else state), line\n                    )\n                    self.assertIn(\"via=serve\", line)\n                    self.assertIn(f\"stream={stream}\", line)\n                    self.assertIn(\"line1\\\\nline2\", line)\n                    self.assertEqual(error[\"detail\"], \"line1\\nline2\")\n                    self.assertEqual(\n                        sum(\n                            \" error model=\" in x\n                            for x in self.mod.LOG_PATH.read_text().splitlines()\n                        ),\n                        1,\n                    )\n        with mock.patch.object(\n            self.mod.ServeRun,\n            \"execute\",\n            return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n        ):\n            self.mod.LOG_PATH.unlink()\n            self.assertEqual(bridge_request(self, turn_request())[0], 200)\n        self.assertEqual(\n            sum(\n                \" done model=\" in x for x in self.mod.LOG_PATH.read_text().splitlines()\n            ),\n            1,\n        )\n        self.assertNotIn(\" error model=\", self.mod.LOG_PATH.read_text())\n\n    def test_secret_canaries_masked_in_log_json_and_sse(self) -> None:\n        samples = [\n            \"Bearer secret-canary-token-123\",\n            \"Authorization: super-private-value\",\n            \"api_key=canary_secret_val\",\n            '{\"token\":\"canary_secret_val\"}',\n            \"{'password': 'canary_secret_val'}\",\n            'password=\"alpha beta gamma\"',\n            \"TOKEN: canary_secret_val\",\n            \"bridge-key=canary_secret_val\",\n            \"secret=canary_secret_val\",\n            \"sk-abcdefghijklmnop1234\",\n            \"bare-bridge-canary\",\n        ]\n        # Подмена только локальной конфигурации модуля, окружение не меняется.\n        self.mod.AUTH_KEY = \"bare-bridge-canary\"\n        for stream in (False, True):\n            for sample in samples:\n                for prefix in (\"\", \"x\" * 285 + \" \", \"x\" * 485 + \" \"):\n                    with self.subTest(stream=stream, sample=sample, prefix=len(prefix)):\n                        # Аутентификация запроса не нужна: модульный mock не меняет тестируемую редакцию.\n                        with mock.patch.object(self.mod, \"_auth_ok\", return_value=True):\n                            error, line = self._error_response(\n                                \"terminal_failed\", prefix + sample, stream\n                            )\n                        combined = json.dumps(error) + line\n                        for secret in (\n                            \"secret-canary-token-123\",\n                            \"super-private-value\",\n                            \"canary_secret_val\",\n                            \"alpha beta gamma\",\n                            \"abcdefghijklmnop1234\",\n                            \"bare-bridge-canary\",\n                        ):\n                            self.assertNotIn(secret, combined)\n                        if not prefix:\n                            self.assertIn(\"[REDACTED]\", error[\"detail\"])\n                            self.assertIn(\"[REDACTED]\", line)\n                        self.assertLessEqual(len(error[\"detail\"]), 500)\n                        self.assertNotIn(\"prompt-canary-private\", combined)\n\n    def test_none_diagnostic_is_empty(self) -> None:\n        for state in (\"spawn_failed\", \"terminal_failed\", \"ok\"):\n            error, _ = self._error_response(state, None, rc=0 if state == \"ok\" else 1)\n            self.assertEqual(error[\"detail\"], \"\")\n\n    def test_serve_json_returns_sanitized_detail_on_error(self) -> None:\n        secret = \"sk-secret-token-1234567890abcdef\"\n        error, _ = self._error_response(\n            \"terminal_failed\", f\"auth_failed: not logged in {secret}\"\n        )\n        self.assertIn(\n            \"muse turn failed (rc=1, state=terminal_failed)\", error[\"message\"]\n        )\n        self.assertIn(\"auth_failed\", error[\"message\"])\n        self.assertIn(\"[REDACTED]\", error[\"message\"])\n        self.assertNotIn(secret, error[\"message\"])\n        self.assertIn(\"auth_failed\", error[\"detail\"])\n        self.assertIn(\"[REDACTED]\", error[\"detail\"])\n        self.assertNotIn(secret, error[\"detail\"])\n\n        # SSE-ветка того же отказа: кадр ошибки несёт тот же санитизированный detail.\n        sse_error, _ = self._error_response(\n            \"terminal_failed\",\n            \"sse upstream failed api_key=canary_sse_secret_val\",\n            True,\n        )\n        self.assertTrue(\n            sse_error[\"message\"].startswith(\n                \"muse turn failed (rc=1, state=terminal_failed): \"\n            )\n        )\n        self.assertIn(\"sse upstream failed\", sse_error[\"message\"])\n        self.assertIn(\"[REDACTED]\", sse_error[\"message\"])\n        self.assertNotIn(\"canary_sse_secret_val\", sse_error[\"message\"])\n        self.assertEqual(\n            sse_error[\"message\"],\n            \"muse turn failed (rc=1, state=terminal_failed): \" + sse_error[\"detail\"],\n        )\n        self.assertIn(\"[REDACTED]\", sse_error[\"detail\"])\n        self.assertNotIn(\"canary_sse_secret_val\", sse_error[\"detail\"])\n\n        # Ветка empty_output: успешный rc без текста — 502 с санитизированным detail.\n        empty_error, _ = self._error_response(\n            \"ok\",\n            \"empty upstream failed api_key=canary_empty_secret_val\",\n            rc=0,\n        )\n        self.assertTrue(\n            empty_error[\"message\"].startswith(\n                \"muse exec produced no text (rc=0, state=ok): \"\n            )\n        )\n        self.assertIn(\"empty upstream failed\", empty_error[\"message\"])\n        self.assertIn(\"[REDACTED]\", empty_error[\"message\"])\n        self.assertNotIn(\"canary_empty_secret_val\", empty_error[\"message\"])\n        self.assertEqual(\n            empty_error[\"message\"],\n            \"muse exec produced no text (rc=0, state=ok): \" + empty_error[\"detail\"],\n        )\n        self.assertIn(\"[REDACTED]\", empty_error[\"detail\"])\n        self.assertNotIn(\"canary_empty_secret_val\", empty_error[\"detail\"])\n\n        # Длинная диагностика empty_output: detail в message и detail обрезан до 500.\n        long_error, _ = self._error_response(\n            \"ok\",\n            \"api_key=canary_long_secret_val \" + \"L\" * 600,\n            rc=0,\n        )\n        self.assertEqual(len(long_error[\"detail\"]), 500)\n        self.assertTrue(\n            long_error[\"message\"].startswith(\n                \"muse exec produced no text (rc=0, state=ok): \"\n            )\n        )\n        self.assertEqual(\n            long_error[\"message\"],\n            \"muse exec produced no text (rc=0, state=ok): \" + long_error[\"detail\"],\n        )\n        self.assertIn(\"[REDACTED]\", long_error[\"message\"])\n        self.assertNotIn(\"canary_long_secret_val\", long_error[\"message\"])\n        self.assertNotIn(\"canary_long_secret_val\", long_error[\"detail\"])\n\n    def test_generic_diagnostic_not_duplicated_in_message(self) -> None:\n        error, _ = self._error_response(\"terminal_failed\", \"state=terminal_failed rc=1\")\n        self.assertEqual(error[\"detail\"], \"state=terminal_failed rc=1\")\n        self.assertEqual(\n            error[\"message\"], \"muse turn failed (rc=1, state=terminal_failed)\"\n        )\n\n    def test_default_model_is_wonder_full(self) -> None:\n        with mock.patch.dict(os.environ):\n            os.environ.pop(\"MUSE_BRIDGE_MODEL\", None)\n            fresh = load_bridge()\n        self.assertEqual(fresh.DEFAULT_MODEL, \"muse-wonder-full-1.0\")\n\n    def test_r2_escaped_quotes_mask_entire_secret_in_all_sinks(self) -> None:\n        samples = (\n            (\n                r'{\"password\": \"alpha \\\" suffix-canary-27182\"}',\n                '{\"password\": [REDACTED]}',\n            ),\n            (r'{\"token\":\"alpha\\\" beta gamma\"}', '{\"token\":[REDACTED]}'),\n        )\n        for stream in (False, True):\n            for sample, expected in samples:\n                with self.subTest(stream=stream, sample=sample):\n                    error, _ = self._error_response(\"terminal_failed\", sample, stream)\n                    self.assertEqual(error[\"detail\"], expected)\n                    logs = self.mod.LOG_PATH.read_text()\n                    self.assertNotIn(\"suffix-canary-27182\", logs)\n                    self.assertNotIn(\"beta gamma\", logs)\n\n    def _protocol_error_detail(self, content: str, message: str, stream: bool) -> str:\n        \"\"\"Проверить все выходы ошибки реального протокольного стенда.\"\"\"\n        install_protocol_wrapper(\n            self, {\"terminal\": \"failed\", \"error\": {\"message\": message}}\n        )\n        payload = turn_request(stream)\n        payload[\"messages\"][0][\"content\"] = content\n        status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200 if stream else 502)\n        if stream:\n            self.assertTrue(body.endswith(b\"data: [DONE]\\n\\n\"))\n            frames = [\n                json.loads(line[6:])\n                for line in body.decode().splitlines()\n                if line.startswith(\"data: {\")\n            ]\n            return next(\n                frame[\"error\"][\"detail\"] for frame in frames if \"error\" in frame\n            )\n        return json.loads(body)[\"error\"][\"detail\"]\n\n    def test_r2_long_reflected_message_redacted_before_clipping(self) -> None:\n        content = \"private-owner-content-\" + \"Q\" * 220\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                detail = self._protocol_error_detail(content, content, stream)\n                self.assertEqual(detail, \"[REDACTED]\")\n                combined = detail + self.mod.LOG_PATH.read_text()\n                self.assertNotIn(\"private-owner-content-\", combined)\n                self.assertNotIn(\"Q\" * 20, combined)\n\n    def test_r2_short_messages_preserve_error_words(self) -> None:\n        expected = \"this turn failed upstream\"\n        for stream in (False, True):\n            for content in (\"hi\", \"e\"):\n                with self.subTest(stream=stream, content=content):\n                    detail = self._protocol_error_detail(content, expected, stream)\n                    self.assertEqual(detail, expected)\n                    self.assertIn(expected, self.mod.LOG_PATH.read_text())\n\n    def test_quota_secrets_do_not_reach_any_error_sink(self) -> None:\n        samples = (\n            \"api_key=canary_secret_val\",\n            '{\"token\":\"canary_secret_val\"}',\n            \"{'password': 'canary_secret_val'}\",\n            'password=\"alpha beta gamma\"',\n        )\n        for stream in (False, True):\n            for sample in samples:\n                with self.subTest(stream=stream, sample=sample):\n                    params = {\n                        \"terminal\": \"failed\",\n                        \"error\": {\n                            \"kind\": \"quota\",\n                            \"message\": sample,\n                            \"quota\": {\n                                \"token\": \"canary_secret_val\",\n                                \"note\": sample,\n                            },\n                        },\n                        \"stderr\": sample,\n                    }\n                    install_protocol_wrapper(self, params)\n                    status, body = bridge_request(self, turn_request(stream))\n                    self.assertEqual(status, 200 if stream else 502)\n                    logs = self.mod.LOG_PATH.read_text()\n                    for secret in (\"canary_secret_val\", \"alpha beta gamma\"):\n                        self.assertNotIn(secret, body.decode() + logs)\n                    self.assertIn(\"[REDACTED]\", body.decode())\n                    self.assertIn(\"[REDACTED]\", logs)\n        for key in (\n            \"token\",\n            \"secret\",\n            \"password\",\n            \"api_key\",\n            \"bridge_key\",\n            \"authorization\",\n        ):\n            quota = {\"outer\": [{key: \"alpha beta gamma\"}]}\n            install_protocol_wrapper(\n                self, {\"terminal\": \"failed\", \"error\": {\"quota\": quota}}\n            )\n            _, body = bridge_request(self, turn_request())\n            self.assertIn(\"[REDACTED]\", body.decode())\n            self.assertNotIn(\n                \"alpha beta gamma\", body.decode() + self.mod.LOG_PATH.read_text()\n            )\n\n\ndef install_protocol_wrapper(\n    scenario: Any, params: dict, noise: bool = False, delay: float = 0\n) -> None:\n    \"\"\"Фейковый MSP с реальными pipes; фиксирует argv и входящие RPC.\"\"\"\n    config = {\n        \"params\": params,\n        \"noise\": noise,\n        \"delay\": delay,\n        \"root\": str(scenario.tmp),\n    }\n    script = scenario.tmp / \"protocol.py\"\n    script.write_text(\n        \"\"\"import json, sys, time\nfrom pathlib import Path\nconfig = json.loads(sys.argv[1])\nroot = Path(config[\"root\"])\nmode = sys.argv[2]\n(root / (mode + \"-argv.json\")).write_text(json.dumps(sys.argv[2:]))\nif mode == \"exec\":\n    print(json.dumps({\"schema_version\": 1, \"payload_type\": \"run.terminal.completed\", \"payload\": {\"text\": \"fallback-ok\"}}), flush=True)\n    sys.exit(0)\nfor line in sys.stdin:\n    msg = json.loads(line)\n    with (root / \"rpc.jsonl\").open(\"a\") as fh:\n        fh.write(json.dumps(msg) + \"\\\\n\")\n    if \"id\" not in msg:\n        continue\n    method = msg[\"method\"]\n    result = {\"session\": {\"sessionId\": \"sess-1\"}} if method == \"session/start\" else {\"status\": \"accepted\", \"turnId\": \"turn-1\"} if method == \"turn/start\" else {}\n    print(json.dumps({\"id\": msg[\"id\"], \"result\": result}), flush=True)\n    if method == \"turn/start\":\n        time.sleep(config[\"delay\"])\n        if config[\"params\"].get(\"approval\"):\n            print(json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"approval/request\", \"params\": {}}), flush=True)\n            break\n        print(json.dumps({\"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": \"hello\"}}}), flush=True)\n        print(json.dumps({\"method\": \"turn/completed\", \"params\": dict(config[\"params\"], turnId=\"turn-1\")}), flush=True)\n        if config[\"params\"].get(\"stderr\"):\n            print(config[\"params\"][\"stderr\"], file=sys.stderr, flush=True)\n        if config[\"noise\"]:\n            for i in range(12):\n                print(\"noise-%02d-\" % i + \"z\" * 100, file=sys.stderr, flush=True)\n        break\n\"\"\",\n        encoding=\"utf-8\",\n    )\n    import shlex\n\n    wrapper = scenario.tmp / \"muse-cli.sh\"\n    wrapper.write_text(\n        f'#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} {shlex.quote(json.dumps(config))} \"$@\"\\n'\n    )\n    wrapper.chmod(0o755)\n    scenario.mod.MUSE_WRAPPER = str(wrapper)\n\n\nclass ServeTurnErrorExtractionTest(_BridgeScenario):\n    \"\"\"AD-002: приоритет, защитный разбор и точные лимиты терминальной причины.\"\"\"\n\n    def _execute(self, params: dict, noise: bool = False) -> dict:\n        install_protocol_wrapper(self, params, noise)\n        return self.mod.ServeRun(\n            \"muse-spark-1.3\", \"p\", \"max\", self.tmp / \"workspace\"\n        ).execute()\n\n    def test_r2_prompt_parts_redacted_before_and_after_normalization(self) -> None:\n        content = \"private-owner-content-\" + \"Q\" * 220\n        prompt = \"User: \" + content + \"\\n\\nAssistant: prior\\tprivate\\nSystem: hi\"\n        parts = self.mod._prompt_reflected_parts(prompt)\n        self.assertEqual(parts, sorted(parts, key=len, reverse=True))\n        self.assertIn(content, parts)\n        self.assertIn(\"prior\\tprivate\", parts)\n        self.assertNotIn(\"hi\", parts)\n        for reflected in (content, \"prior\\tprivate\", \"prior private\"):\n            with self.subTest(reflected=reflected):\n                diagnostic = self.mod._turn_diagnostics(\n                    {\"error\": {\"message\": reflected}}, prompt\n                )\n                self.assertEqual(diagnostic, [\"[REDACTED]\"])\n\n    def test_typed_error_reason_and_stderr_priority(self) -> None:\n        params = {\n            \"terminal\": \"failed\",\n            \"error\": {\n                \"kind\": \"quota_exceeded\",\n                \"message\": \"daily limit\",\n                \"retryable\": False,\n                \"quota\": {\"remaining\": 0},\n            },\n            \"reason\": \"try tomorrow\",\n        }\n        out = self._execute(params, True)\n        expected = 'quota_exceeded: daily limit retryable=False quota={\"remaining\":0}\\nreason: try tomorrow'\n        self.assertTrue(out[\"err\"].startswith(expected), out)\n        self.assertEqual((out[\"rc\"], out[\"state\"]), (1, \"terminal_failed\"))\n        self.assertLessEqual(len(out[\"err\"]), 500)\n        for stream in (False, True):\n            with mock.patch.object(self.mod.ServeRun, \"execute\", return_value=out):\n                _, body = bridge_request(self, turn_request(stream))\n            self.assertIn(\"quota_exceeded\", body.decode())\n            self.assertIn(\"try tomorrow\", body.decode())\n        self.assertIn(\"try tomorrow\", self.mod.LOG_PATH.read_text())\n\n<system-reminder>[Showing lines 1-1080 of 2367 total lines]</system-reminder>","timestamp":1791993017199,"session_id":"3aa63e82-99a0-4660-90de-e4e012bfb060"}
