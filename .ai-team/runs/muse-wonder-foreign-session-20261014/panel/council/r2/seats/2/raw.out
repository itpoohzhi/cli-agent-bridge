{"type":"tool_result","id":"toolu_01VoDEKXvoBFmFins6GxSM71","messageId":"d13ae2ac-1ee9-495a-b666-4f8019b1a889","toolId":"Grep","isError":false,"value":"1311:    def test_t00_models_and_health_include_wonder_models_400k(self) -> None:\n1379:    def test_t01_estimate_tokens_latin_cyrillic_code_json_empty(self) -> None:\n1394:    def test_t02_context_limit_and_derived_targets(self) -> None:\n1420:    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n1456:    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n1496:    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n1529:    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n1603:    def test_t07_orphan_tool_dropped_on_prune_kept_on_passthrough(self) -> None:\n1626:    def test_t08_cyrillic_triggers_prune_when_bytes_exceed_limit(self) -> None:\n1639:    def test_t09_multipart_none_empty_non_dict_unknown_role(self) -> None:\n2068:    def test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget(\n2121:    def test_t19_client_disconnect_between_attempts_skips_second_run(self) -> None:\n2164:    def test_t20_mandatory_exceeds_200k_on_retry_skips_second_run(self) -> None:\n2197:    def test_t21_retry_cut_does_not_reduce_prompt_skips_second_run(self) -> None:\n2228:    def test_t22_unconfirmed_death_on_attempt_one_skips_retry_and_quarantines_slot(\n2280:    def test_t23_observability_log_fields_secret_redaction_and_no_retained_buffers(\n2364:    def test_t24_repeated_tool_call_id_across_episodes_preserves_trailing_mandatory_unit(\n2427:        elapsed = time.monotonic() - t0\n2430:        self.assertLess(elapsed, 0.5, f\"Фаза C слишком медленная: {elapsed:.2f}s\")\n2432:    def test_t25_long_prefix_before_hard_threshold_marker_triggers_retry_via_msp(\n2519:    def test_t26_reflected_message_with_embedded_secret_leaves_neither_canary_nor_secret(\n2582:    def test_t27_serve_unavailable_with_reflected_prompt_does_not_leak_to_log(","timestamp":1791994868908,"session_id":"d310f7c6-395c-4c9d-b4f3-453a867f71bf"}
