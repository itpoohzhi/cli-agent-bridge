{"type":"tool_call","id":"toolu_01WdatJxuJ7kCwKKdFZwmEvh","messageId":"ce405b9f-b7fe-49d0-a622-2b3cf3b34ac4","toolId":"Execute","toolName":"Execute","parameters":{"summary":"Probe Phase C prune performance and sanity","command":"cd /Users/aazhiry1/work/src/cli-agent-bridge && python3 - <<'EOF'\nimport importlib.util, time\nspec=importlib.util.spec_from_file_location(\"m\",\"bridges/muse-bridge/server.py\")\nm=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\nfor n in (3000,6000,20000):\n    msgs=[{\"role\":\"user\",\"content\":\"start\"}]\n    for i in range(n):\n        msgs.append({\"role\":\"assistant\" if i%2==0 else \"user\",\"content\":f\"m{i}-\"+\"a\"*300})\n    msgs.append({\"role\":\"user\",\"content\":\"end\"})\n    t=time.monotonic(); r=m._prune_messages(msgs,limit=100000,target=80000); print(n,r.status,r.est_after,round(time.monotonic()-t,3))\n# estimate equivalence of O(n) path vs exact\nimport random\nrandom.seed(1)\nbad=0\nfor trial in range(200):\n    msgs=[{\"role\":\"system\",\"content\":\"sys\"}] if trial%2 else []\n    for i in range(random.randint(3,40)):\n        k=random.random()\n        if k<0.3: msgs.append({\"role\":\"user\",\"content\":\"u\"*random.randint(10,400)+\"привет\"*random.randint(0,50)})\n        elif k<0.6: msgs.append({\"role\":\"assistant\",\"content\":\"a\"*random.randint(10,400)})\n        else:\n            cid=f\"c{random.randint(0,2)}\"\n            msgs.append({\"role\":\"assistant\",\"content\":\"x\",\"tool_calls\":[{\"id\":cid,\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":\"{}\"}}]})\n            msgs.append({\"role\":\"tool\",\"tool_call_id\":cid,\"content\":\"r\"*random.randint(10,400)})\n    msgs.append({\"role\":\"user\",\"content\":\"last\"})\n    r=m._prune_messages(msgs,limit=1500,target=1200)\n    if r.status==\"pruned\" and r.est_after>1200: bad+=1\n    if r.status==\"pruned\":\n        # check prompt estimate consistent\n        _,_,p=m._assemble_prompt(r.messages)\n        if m._estimate_tokens(p)!=r.est_after: bad+=1\nprint(\"bad\",bad)\nEOF","riskLevel":"low","timeout":120},"timestamp":1791994884790,"session_id":"d310f7c6-395c-4c9d-b4f3-453a867f71bf"}
