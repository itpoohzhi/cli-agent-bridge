{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2303,2744p' '/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py'\nsed -n '548,799p' '/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2303,2744p' '/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py'\nsed -n '548,799p' '/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py'\"","aggregated_output":"        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        raw_messages = req.get(\"messages\") or []\n        _, raw_turns_text = _messages_to_prompt(raw_messages)\n        if not raw_turns_text:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n\n        rid = uuid.uuid4().hex[:8]\n        limit = _context_limit(model)\n        target = _context_target(limit)\n        retry_target = _context_retry_target(limit)\n        prune_res = _prune_messages(\n            raw_messages,\n            limit=limit,\n            target=target,\n            tools=tools,\n            tool_choice=tool_choice,\n            raw_tools=raw_tools,\n        )\n        if prune_res.status == \"refused\":\n            _log_context_prune(\n                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n            )\n            detail = (\n                f\"mandatory context exceeds budget \"\n                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n            )\n            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n            _log(\n                _format_err_log(\n                    model,\n                    \"refused\",\n                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n                    req.get(\"stream\") is True,\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_msg),\n                        \"detail\": _redact_secrets(detail)[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if prune_res.status == \"pruned\":\n            _log_context_prune(\n                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n            )\n\n        prompt = prune_res.prompt\n        current_est = prune_res.est_after\n        reflected_prompts: list[str] = [prompt]\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        waited = time.monotonic()\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n                return\n            if time.monotonic() - waited > TIMEOUT_S:\n                self._send(\n                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n                )\n                return\n        if self._client_gone or self._client_gone_probe():\n            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n            self._client_gone = True\n            _log(\"client gone while waiting for a slot\")\n            _slots.release()\n            return\n        watch_stop = threading.Event()\n        watcher = threading.Thread(\n            target=self._watch_client, args=(watch_stop,), daemon=True\n        )\n        watcher.start()\n        runs: list = []\n        terminal_context_err: str | None = None\n        context_retry_count = 0\n\n        def run_attempt(attempt_prompt: str) -> tuple[dict[str, Any], str]:\n            # Serve-first: пробуем MSP serve (там reasoning summaries), при любой\n            # транспортной неполадке — тихий fallback на проверенный exec.\n            attempt_out: dict[str, Any]\n            attempt_via = \"exec\"\n            try:\n                serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n                runs.append(serve_run)\n                self._current_run = serve_run\n                attempt_out = serve_run.execute()\n                attempt_via = \"serve\"\n            except ServeUnavailable as exc:\n                if self._client_gone:\n                    # Обрыв клиента уже убил serve-группу: новый exec-ход не запускаем.\n                    _log(\"client gone during serve — exec fallback skipped\")\n                    attempt_out = {\n                        \"rc\": -1,\n                        \"text\": \"\",\n                        \"err\": \"client gone\",\n                        \"state\": \"client_gone\",\n                    }\n                    attempt_via = \"aborted\"\n                else:\n                    safe_exc = _sanitize_reflected(\n                        str(exc), [*reflected_prompts, attempt_prompt], raw_messages\n                    )\n                    safe_exc = re.sub(\n                        r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\", \" \", safe_exc\n                    ).strip()[:300]\n                    _log(f\"serve unavailable ({safe_exc}), fallback exec model={model}\")\n                    exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                    runs.append(exec_run)\n                    self._current_run = exec_run\n                    attempt_out = exec_run.execute()\n                    attempt_via = \"exec-after-serve-fallback\"\n                    if (\n                        attempt_out.get(\"rc\") != 0\n                        and not self._client_gone\n                        and NETWORK_RETRY_MARKER in str(attempt_out.get(\"err\") or \"\")\n                    ):\n                        _log(\"exec hit network marker, single retry\")\n                        retry_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                        runs.append(retry_run)\n                        self._current_run = retry_run\n                        attempt_out = retry_run.execute()\n                        attempt_via = \"exec-retry\"\n            return attempt_out, attempt_via\n\n        try:\n            t_first_attempt = time.monotonic()\n            out, via = run_attempt(prompt)\n            raw_err = str(out.get(\"err\") or \"\")\n            is_hard_threshold = (\n                out.get(\"rc\") != 0\n                and out.get(\"state\") == \"terminal_failed\"\n                and (\n                    bool(out.get(\"hard_threshold\"))\n                    or HARD_THRESHOLD_ERR_SUBSTR in raw_err\n                )\n            )\n            if (\n                is_hard_threshold\n                and context_retry_count == 0\n                and not self._client_gone\n                and not getattr(self, \"_content_started\", False)\n            ):\n                for run in runs:\n                    run.close()\n                if not all(run.dead_confirmed for run in runs):\n                    _log(\n                        \"context retry skipped: first attempt process group not confirmed dead\"\n                    )\n                else:\n                    retry_res = _prune_messages(\n                        raw_messages,\n                        limit=retry_target,\n                        target=retry_target,\n                        tools=tools,\n                        tool_choice=tool_choice,\n                        raw_tools=raw_tools,\n                    )\n                    if retry_res.status == \"refused\":\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            f\"mandatory context exceeds budget \"\n                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n                        )\n                    elif (\n                        retry_res.est_after >= current_est\n                        or time.monotonic() - t_first_attempt >= TIMEOUT_S\n                    ):\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            f\"context hard threshold exceeded after single compaction retry \"\n                            f\"(est_tokens={retry_res.est_after}, target={retry_target})\"\n                        )\n                    elif self._client_gone or self._client_gone_probe():\n                        self._client_gone = True\n                    else:\n                        context_retry_count = 1\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"hard_threshold_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        prompt = retry_res.prompt\n                        current_est = retry_res.est_after\n                        reflected_prompts.append(prompt)\n                        out, via = run_attempt(prompt)\n                        raw_err_2 = str(out.get(\"err\") or \"\")\n                        if (\n                            out.get(\"rc\") != 0\n                            and out.get(\"state\") == \"terminal_failed\"\n                            and (\n                                bool(out.get(\"hard_threshold\"))\n                                or HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n                            )\n                        ):\n                            terminal_context_err = (\n                                f\"context hard threshold exceeded after single compaction retry \"\n                                f\"(est_tokens={current_est}, target={retry_target})\"\n                            )\n        finally:\n            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n            watch_stop.set()\n            watcher.join(timeout=2)\n            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n            # между Popen и собственным finally execute().\n            for run in runs:\n                run.close()\n            if all(run.dead_confirmed for run in runs):\n                _slots.release()\n            else:\n                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n\n        if self._client_gone:\n            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n            _log(\"client gone — response skipped\")\n            return\n        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n        out = dict(out)\n        diagnostic = _sanitize_reflected(\n            str(out.get(\"err\") or \"\"), reflected_prompts, raw_messages\n        )\n        if terminal_context_err is not None:\n            diagnostic = _redact_secrets(terminal_context_err)\n        out[\"err\"] = _redact_secrets(diagnostic)\n        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n            err_message = (\n                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n            )\n            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n                err_message = f\"{err_message}: {detail}\"\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_message),\n                        \"detail\": detail,\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        content = out[\"text\"]\n        tool_calls: list[dict] = []\n        if emulate_tools and content:\n            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n        if not content and not tool_calls:\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(\n                _format_err_log(\n                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n                )\n            )\n            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n            err_message = (\n                f\"muse exec produced no text (rc={out.get('rc')}, \"\n                f\"state={out.get('state')}){hint}\"\n            )\n            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n                err_message = f\"{err_message}: {detail}\"\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_message),\n                        \"detail\": detail,\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n\n        prompt_tokens = _estimate_usage_tokens(prompt)\n        completion_tokens = _estimate_usage_tokens(out[\"text\"])\n        # Serve даёт настоящие токены (session/tokenUsage); exec — оценку.\n        # tokenUsage serve не даёт promptTokens — фолбэк на оценку по каждому\n        # полю отдельно (раньше общий if занулял prompt при пустом поле).\n        ru = out.get(\"usage\") if isinstance(out.get(\"usage\"), dict) else {}\n        ru_prompt = ru.get(\"promptTokens\") or ru.get(\"prompt_tokens\") or 0\n        ru_output = ru.get(\"outputTokens\") or ru.get(\"output_tokens\") or 0\n        try:\n            ru_prompt = int(ru_prompt)\n        except (TypeError, ValueError):\n            ru_prompt = 0\n        try:\n            ru_output = int(ru_output)\n        except (TypeError, ValueError):\n            ru_output = 0\n        if ru_prompt > 0:\n            prompt_tokens = ru_prompt\n        if ru_output > 0:\n            completion_tokens = ru_output\n        ru_reasoning = ru.get(\"reasoningTokens\") or ru.get(\"reasoning_tokens\") or 0\n        try:\n            reasoning_tokens = int(ru_reasoning)\n        except (TypeError, ValueError):\n            reasoning_tokens = 0\n        if reasoning_tokens < 0:\n            reasoning_tokens = 0\n        raw_summaries = out.get(\"summaries\")\n        summaries: list[str] = (\n            [s for s in raw_summaries if isinstance(s, str)]\n            if isinstance(raw_summaries, list)\n            else []\n        )\n        sum_chars = sum(len(s) for s in summaries)\n        if summaries:\n            preview = next((s for s in summaries if s), \"\")[:300]\n            _log(\n                f\"reasoning summaries={len(summaries)} chars={sum_chars} \"\n                f\"reasoning_tokens={reasoning_tokens} preview={preview!r}\"\n            )\n        message: dict[str, Any] = {\"role\": \"assistant\", \"content\": content}\n        finish = \"stop\"\n        if tool_calls:\n            message[\"tool_calls\"] = tool_calls\n            finish = \"tool_calls\"\n        _log(\n            f\"done model={model} via={via} rc={out.get('rc')} state={out.get('state')} \"\n            f\"tools={len(tool_calls)} out_chars={len(out['text'])} \"\n            f\"stream={req.get('stream') is True}\"\n        )\n        if req.get(\"stream\") is True:\n            self._send_sse(\n                model,\n                content,\n                tool_calls,\n                prompt_tokens,\n                completion_tokens,\n                reasoning_tokens,\n                summaries,\n            )\n            return\n        self._send(\n            200,\n            {\n                \"id\": f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\",\n                \"object\": \"chat.completion\",\n                \"created\": int(time.time()),\n                \"model\": model,\n                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n                \"usage\": {\n                    \"prompt_tokens\": prompt_tokens,\n                    \"completion_tokens\": completion_tokens,\n                    \"total_tokens\": prompt_tokens + completion_tokens,\n                    \"reasoning_tokens\": reasoning_tokens,\n                },\n                \"reasoning_summaries\": summaries,\n            },\n        )\n\n\nclass Server(ThreadingHTTPServer):\n    daemon_threads = True\n    allow_reuse_address = True\n\n\ndef main() -> int:\n    if not AUTH_KEY:\n        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n        return 2\n    try:\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n    except OSError as exc:\n        _log(f\"workspace mkdir failed: {exc}\")\n    _log(\n        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n    )\n    server = Server((HOST, PORT), Handler)\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        server.server_close()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n        elif role == \"assistant\":\n            turns.append(f\"Assistant: {text}\")\n        elif role in (\"tool\", _COMPACTION_MARKER_ROLE):\n            turns.append(text)\n        else:\n            turns.append(f\"User: {text}\")\n    return \"\\n\\n\".join(systems).strip(), \"\\n\\n\".join(turns)\n\n\ndef _assemble_prompt(\n    messages: list[dict[str, Any]],\n    tools: list[dict[str, Any]] | None = None,\n    tool_choice: Any = None,\n    raw_tools: Any = None,\n) -> tuple[str, str, str]:\n    \"\"\"Собрать (system_text, turns_text, full_prompt) по единым правилам моста.\"\"\"\n    clean_tools = (\n        [t for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []\n    )\n    emulate_tools = bool(clean_tools) and not _tool_choice_none(tool_choice)\n    system_text, turns_text = _messages_to_prompt(messages)\n    if not turns_text:\n        return system_text, \"\", \"\"\n    head: list[str] = []\n    if system_text:\n        head.append(f\"[system]\\n{system_text}\")\n    if emulate_tools:\n        head.append(_tools_section(clean_tools, tool_choice))\n    elif (raw_tools is not None and bool(raw_tools) or bool(tools)) and not system_text:\n        head.append(f\"[system]\\n{DEFAULT_SYSTEM_HINT}\")\n    full_prompt = \"\\n\\n\".join(head) + f\"\\n\\n{turns_text}\" if head else turns_text\n    return system_text, turns_text, full_prompt\n\n\ndef _strip_code_fence(text: str) -> str:\n    \"\"\"Снять обёртку ```…``` (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n    body = text.strip()\n    if body.startswith(\"```\"):\n        newline = body.find(\"\\n\")\n        body = body[newline + 1 :] if newline != -1 else body[3:]\n    if body.rstrip().endswith(\"```\"):\n        body = body.rstrip()[:-3]\n    return body.strip()\n\n\ndef _parse_tool_call_block(inner: str) -> dict | None:\n    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n\n    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n    \"\"\"\n    try:\n        obj = json.loads(_strip_code_fence(inner))\n    except ValueError:\n        return None\n    if not isinstance(obj, dict):\n        return None\n    name = obj.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return None\n    arguments: dict = {}\n    if \"arguments\" in obj:\n        normalized = _normalize_arguments(obj.get(\"arguments\"))\n        if normalized is None:\n            return None\n        arguments = normalized\n    return {\"name\": name.strip(), \"arguments\": arguments}\n\n\nclass ToolCallParser:\n    \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n\n    Тег <tool_call> может прийти разорванным между дельтами: хвост, который может\n    оказаться началом тега, удерживается и не уходит в content до разрешения.\n    \"\"\"\n\n    def __init__(self, on_content, on_tool_call):\n        self._buf = \"\"\n        self._on_content = on_content\n        self._on_tool_call = on_tool_call\n\n    def feed(self, text: str) -> None:\n        self._buf += text\n        self._drain(final=False)\n\n    def finish(self) -> None:\n        self._drain(final=True)\n\n    def _drain(self, final: bool) -> None:\n        while True:\n            start = self._buf.find(TOOL_CALL_OPEN)\n            if start == -1:\n                if final:\n                    self._flush_all()\n                    return\n                keep = self._pending_prefix()\n                if keep:\n                    self._emit(self._buf[:-keep])\n                    self._buf = self._buf[-keep:]\n                else:\n                    self._flush_all()\n                return\n            if start > 0:\n                self._emit(self._buf[:start])\n                self._buf = self._buf[start:]\n            end = self._find_close_outside_string(len(TOOL_CALL_OPEN))\n            if end == -1:\n                if final:\n                    self._flush_all()  # незакрытый/невалидный блок отдаём текстом\n                return\n            inner = self._buf[len(TOOL_CALL_OPEN) : end]\n            self._buf = self._buf[end + len(TOOL_CALL_CLOSE) :]\n            call = _parse_tool_call_block(inner)\n            if call is None:\n                self._emit(TOOL_CALL_OPEN + inner + TOOL_CALL_CLOSE)\n            else:\n                self._on_tool_call(call)\n\n    def _find_close_outside_string(self, start: int) -> int:\n        \"\"\"Позиция `</tool_call>` вне строковых литералов JSON, или -1.\n\n        Закрывающий тег внутри JSON-строки (например, значение аргумента содержит\n        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n        строку не закрывают.\n        \"\"\"\n        index = start\n        length = len(self._buf)\n        in_string = False\n        escaped = False\n        while index < length:\n            char = self._buf[index]\n            if in_string:\n                if escaped:\n                    escaped = False\n                elif char == \"\\\\\":\n                    escaped = True\n                elif char == '\"':\n                    in_string = False\n            elif char == '\"':\n                in_string = True\n            elif self._buf.startswith(TOOL_CALL_CLOSE, index):\n                return index\n            index += 1\n        return -1\n\n    def _pending_prefix(self) -> int:\n        \"\"\"Длина хвоста — префикса открывающего тега (его нельзя отдать в content).\"\"\"\n        limit = min(len(TOOL_CALL_OPEN) - 1, len(self._buf))\n        for length in range(limit, 0, -1):\n            if self._buf[-length:] == TOOL_CALL_OPEN[:length]:\n                return length\n        return 0\n\n    def _emit(self, text: str) -> None:\n        if text:\n            self._on_content(text)\n\n    def _flush_all(self) -> None:\n        if self._buf:\n            text, self._buf = self._buf, \"\"\n            self._on_content(text)\n\n\ndef _split_tool_calls(chunks: list[str]) -> tuple[str, list[dict]]:\n    \"\"\"Дельты текста ответа -> (content, tool_calls в формате OpenAI).\n\n    Тот же ToolCallParser, что у droid-bridge; id вызовов — call_<hex24>.\n    \"\"\"\n    pieces: list[str] = []\n    calls: list[dict] = []\n\n    def add_call(call: dict) -> None:\n        calls.append(\n            {\n                \"index\": len(calls),\n                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": call[\"name\"],\n                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n                },\n            }\n        )\n\n    parser = ToolCallParser(pieces.append, add_call)\n    for chunk in chunks:\n        parser.feed(chunk)\n    parser.finish()\n    return \"\".join(pieces), calls\n\n\ndef _map_effort(req: dict[str, Any]) -> str:\n    \"\"\"reasoning_effort (chat) | reasoning.effort (responses-стиль) -> тир Muse.\"\"\"\n    raw: Any = req.get(\"reasoning_effort\")\n    if raw is None and isinstance(req.get(\"reasoning\"), dict):\n        raw = req[\"reasoning\"].get(\"effort\")\n    key = str(raw).strip().lower() if raw is not None else \"\"\n    return EFFORT_MAP.get(key, DEFAULT_EFFORT)\n\n\n_TOKEN_RE = re.compile(r\"\\s+\")\n\n\ndef _estimate_tokens(text: str) -> int:\n    \"\"\"Консервативная оценка токенов по UTF-8 байтам и символам (ADR-001.2 §2.5).\"\"\"\n    if not text:\n        return 0\n    return max(len(text) // 3, len(text.encode(\"utf-8\")) // 3)\n\n\ndef _estimate_usage_tokens(text: str) -> int:\n    \"\"\"Оценка клиентских метрик usage по словам на exec-ветке (не бюджет прунинга).\"\"\"\n    if not text or not text.strip():\n        return 0\n    return max(1, int(len(_TOKEN_RE.split(text.strip())) * 1.3))\n\n\ndef _context_limit(model: str) -> int:\n    \"\"\"Единый источник лимита окна модели из ALLOWED_MODELS (ADR-001.1).\"\"\"\n    spec = ALLOWED_MODELS.get(model)\n    if isinstance(spec, dict):\n        val = spec.get(\"context_length\")\n        if isinstance(val, int) and val > 0:\n            return val\n    return DEFAULT_CONTEXT_LIMIT\n\n\ndef _context_target(limit: int) -> int:\n    \"\"\"Целевой бюджет проактивного прунинга с гистерезисом 80% (ADR-001.1).\"\"\"\n    return (limit * 4) // 5\n\n\ndef _context_retry_target(limit: int) -> int:\n    \"\"\"Аварийный бюджет однократного retry 50% (ADR-001.1).\"\"\"\n    return limit // 2\n\n\nclass PruneResult(NamedTuple):\n    status: str  # \"pass_through\" | \"pruned\" | \"refused\"\n    messages: list[dict[str, Any]]\n    prompt: str\n    est_before: int\n    est_after: int\n    msgs_total: int\n    msgs_kept: int\n    msgs_dropped: int\n    mandatory_est: int\n    overhead_est: int\n\n\ndef _overhead_tokens_estimate(\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '180,245p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '1410,1862p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '180,245p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '1410,1862p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\"","aggregated_output":"\n    def test_r1_serve_run_close_kills_group(self) -> None:\n        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-r1-\") as tmp:\n            run = load_bridge().ServeRun(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n            self._assert_close_kills_group(run)\n\n\nclass _BridgeScenario(unittest.TestCase):\n    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n\n    # Значения инициализируются в setUp() каждого теста.\n    tmp: Path = Path()\n    mod: Any = None\n    pidfile: Path = Path()\n    servepid: Path = Path()\n    server: Any = None\n\n    def wrapper_text(self) -> str:\n        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n\n    def setUp(self) -> None:\n        self.tmp = Path(tempfile.mkdtemp(prefix=\"muse-bridge-killpg-\"))\n        self.addCleanup(shutil.rmtree, str(self.tmp), True)\n        self.mod = load_bridge()\n        # Работаем только во временном каталоге: workspace и лог моста — не в репо.\n        self.mod.WORKSPACE = self.tmp / \"workspace\"\n        self.mod.LOG_PATH = self.tmp / \"bridge.log\"\n        # Один слот: при двух утечка одного не видна неблокирующей пробой семафора.\n        self.mod._slots = threading.Semaphore(1)\n        self.pidfile = self.tmp / \"run.pid\"\n        self.servepid = self.tmp / \"serve.pid\"\n        wrapper = self.tmp / \"muse-cli.sh\"\n        wrapper.write_text(self.wrapper_text(), encoding=\"utf-8\")\n        wrapper.chmod(0o755)\n        self.mod.MUSE_WRAPPER = str(wrapper)\n        self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n        threading.Thread(target=self.server.serve_forever, daemon=True).start()\n        self.addCleanup(self._teardown_scenario)\n\n    def _teardown_scenario(self) -> None:\n        \"\"\"Стоп сервера + добивание своих мок-групп (только свои PGID).\"\"\"\n        self.server.shutdown()\n        self.server.server_close()\n        for pidfile in (self.pidfile, self.servepid):\n            if pidfile.exists():\n                try:\n                    os.killpg(\n                        int(pidfile.read_text(encoding=\"utf-8\").strip()),\n                        signal.SIGKILL,\n                    )\n                except (ProcessLookupError, OSError, ValueError):\n                    pass\n\n    def _open_request(self) -> socket.socket:\n        \"\"\"POST /v1/chat/completions; соединение остаётся открытым (закрывает вызывающий).\"\"\"\n        body = json.dumps(\n            {\n                \"model\": \"muse-spark-1.3\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}],\n            }\n        ).encode(\"utf-8\")\n        head = (\n            \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n            \"Host: 127.0.0.1\\r\\n\"\n            \"Content-Type: application/json\\r\\n\"\n\n\nclass ContextPruneTest(unittest.TestCase):\n    \"\"\"T-03..T-11, T-13..T-14: защитный прунинг истории диалога.\"\"\"\n\n    mod: Any = None\n\n    def setUp(self) -> None:\n        self.mod = load_bridge()\n\n    def test_t03_boundary_limit_minus_one_limit_and_limit_plus_one(self) -> None:\n        # \"User: \" — 6 байт. Для оценки ровно N токенов при 1 реплике и другой реплике:\n        # соберём историю из 3 сообщений и подгоним байты под точный порог limit=1000.\n        limit = 1000\n        target = 800\n        m1 = {\"role\": \"user\", \"content\": \"first-user\"}\n        m3 = {\"role\": \"user\", \"content\": \"last-user\"}\n        base_prompt = self.mod._assemble_prompt(\n            [m1, {\"role\": \"assistant\", \"content\": \"\"}, m3]\n        )[2]\n        # Проверим на точной длине промпта:\n        # \"User: first-user\\n\\nAssistant: <X>\\n\\nUser: last-user\"\n        prefix_overhead = len(\n            \"User: first-user\\n\\nAssistant: \\n\\nUser: last-user\".encode(\"utf-8\")\n        )\n        for desired_est, should_prune in (\n            (limit - 1, False),\n            (limit, False),\n            (limit + 1, True),\n        ):\n            needed_bytes = desired_est * 3 - prefix_overhead\n            m2 = {\"role\": \"assistant\", \"content\": \"x\" * needed_bytes}\n            msgs = [m1, m2, m3]\n            res = self.mod._prune_messages(msgs, limit=limit, target=target)\n            self.assertEqual(res.est_before, desired_est)\n            if not should_prune:\n                self.assertEqual(res.status, \"pass_through\")\n                self.assertIs(res.messages, msgs)\n                self.assertNotIn(self.mod.COMPACTION_MARKER, res.prompt)\n            else:\n                self.assertEqual(res.status, \"pruned\")\n                self.assertLessEqual(res.est_after, target)\n                self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n                self.assertEqual(res.msgs_dropped, 1)\n        _ = base_prompt\n\n    def test_t04_pruned_assembled_prompt_within_320k_with_tools_and_system(\n        self,\n    ) -> None:\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": f\"tool_{i}\",\n                    \"description\": \"Описание инструмента \" * 40,\n                    \"parameters\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"arg\": {\"type\": \"string\", \"description\": \"d\" * 200}\n                        },\n                    },\n                },\n            }\n            for i in range(25)\n        ]\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"System instructions \" * 500},\n            {\"role\": \"user\", \"content\": \"Initial task description \" * 200},\n        ]\n        # Добавим 30 реплик по ~45k байт (~15k токенов каждая) -> ~450k токенов (> 400k).\n        for i in range(30):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append({\"role\": role, \"content\": f\"turn-{i} \" + (\"payload \" * 5600)})\n        msgs.append({\"role\": \"user\", \"content\": \"Final user question\"})\n\n        res = self.mod._prune_messages(\n            msgs, limit=400_000, target=320_000, tools=tools, tool_choice=\"auto\"\n        )\n        self.assertEqual(res.status, \"pruned\")\n        self.assertGreater(res.est_before, 400_000)\n        actual_est = self.mod._estimate_tokens(res.prompt)\n        self.assertEqual(res.est_after, actual_est)\n        self.assertLessEqual(actual_est, 320_000)\n        self.assertIn(self.mod.COMPACTION_MARKER, res.prompt)\n        self.assertIn(\"# Tool calling protocol\", res.prompt)\n\n    def test_t05_preserves_all_system_developer_first_and_last_user_without_dup(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys-early\"},\n            {\"role\": \"user\", \"content\": \"user-first\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"developer\", \"content\": \"dev-mid-insertion\"},\n            {\"role\": \"user\", \"content\": \"U\" * 3000},\n            {\"role\": \"assistant\", \"content\": \"B\" * 3000},\n            {\"role\": \"system\", \"content\": \"sys-late-insertion\"},\n            {\"role\": \"user\", \"content\": \"user-last\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=1500, target=1000)\n        self.assertEqual(res.status, \"pruned\")\n        for needle in (\n            \"sys-early\",\n            \"dev-mid-insertion\",\n            \"sys-late-insertion\",\n            \"user-first\",\n            \"user-last\",\n        ):\n            self.assertIn(needle, res.prompt)\n        # Если в истории только один user — он не дублируется.\n        single_user_msgs = [\n            {\"role\": \"system\", \"content\": \"sys-1\"},\n            {\"role\": \"user\", \"content\": \"only-one-user\"},\n            {\"role\": \"assistant\", \"content\": \"X\" * 6000},\n        ]\n        res_single = self.mod._prune_messages(single_user_msgs, limit=1000, target=500)\n        self.assertEqual(res_single.status, \"pruned\")\n        self.assertEqual(res_single.prompt.count(\"only-one-user\"), 1)\n\n    def test_t06_tool_calls_and_tool_results_atomicity_sweep(self) -> None:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"user\", \"content\": \"first-user\"},\n            {\"role\": \"assistant\", \"content\": \"early-assistant-\" + (\"x\" * 300)},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_a1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f1\", \"arguments\": \"{}\"},\n                    },\n                    {\n                        \"id\": \"call_a2\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f2\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a1\",\n                \"name\": \"f1\",\n                \"content\": \"res_a1_\" + (\"y\" * 300),\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_a2\",\n                \"name\": \"f2\",\n                \"content\": \"res_a2_\" + (\"z\" * 300),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"thinking\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_b1\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f3\", \"arguments\": \"{}\"},\n                    },\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_b1\",\n                \"name\": \"f3\",\n                \"content\": \"res_b1_\" + (\"w\" * 300),\n            },\n            {\"role\": \"user\", \"content\": \"last-user\"},\n        ]\n        full_est = self.mod._estimate_tokens(self.mod._assemble_prompt(msgs)[2])\n        for target in range(80, full_est + 20, 15):\n            res = self.mod._prune_messages(msgs, limit=full_est - 1, target=target)\n            self.assertNotEqual(res.status, \"refused\")\n            kept_call_ids: set[str] = set()\n            expected_tool_ids: dict[str, set[str]] = {}\n            actual_tool_ids: set[str] = set()\n            for m in res.messages:\n                if m.get(\"role\") == \"assistant\" and m.get(\"tool_calls\"):\n                    cids = {tc[\"id\"] for tc in m[\"tool_calls\"]}\n                    kept_call_ids |= cids\n                    expected_tool_ids[m[\"tool_calls\"][0][\"id\"]] = cids\n                elif m.get(\"role\") == \"tool\":\n                    actual_tool_ids.add(m[\"tool_call_id\"])\n            # Инвариант I-1: нет tool без вызова и нет частичного сохранения многовызовного хода.\n            self.assertEqual(\n                actual_tool_ids,\n                kept_call_ids,\n                f\"нарушена атомарность при target={target}\",\n            )\n            for group_ids in expected_tool_ids.values():\n                self.assertTrue(group_ids.issubset(actual_tool_ids))\n\n    def test_t07_orphan_tool_dropped_on_prune_kept_on_passthrough(self) -> None:\n        orphan = {\n            \"role\": \"tool\",\n            \"tool_call_id\": \"orphan_id_999\",\n            \"name\": \"ghost\",\n            \"content\": \"orphan-body\",\n        }\n        msgs = [\n            {\"role\": \"user\", \"content\": \"u1\"},\n            orphan,\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        passthru = self.mod._prune_messages(msgs, limit=5000, target=4000)\n        self.assertEqual(passthru.status, \"pass_through\")\n        self.assertIn(orphan, passthru.messages)\n        self.assertIn(\"orphan-body\", passthru.prompt)\n\n        pruned = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(pruned.status, \"pruned\")\n        self.assertNotIn(orphan, pruned.messages)\n        self.assertNotIn(\"orphan-body\", pruned.prompt)\n\n    def test_t08_cyrillic_triggers_prune_when_bytes_exceed_limit(self) -> None:\n        # 900 кириллических символов = 300 chars//3, но 1800 байт = 600 bytes//3.\n        # При limit=450 chars//3 < limit < bytes//3 -> прунинг обязан сработать.\n        msgs = [\n            {\"role\": \"user\", \"content\": \"первый\"},\n            {\"role\": \"assistant\", \"content\": \"ж\" * 900},\n            {\"role\": \"user\", \"content\": \"последний\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=450, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertLessEqual(res.est_after, 300)\n        self.assertNotIn(\"ж\" * 100, res.prompt)\n\n    def test_t09_multipart_none_empty_non_dict_unknown_role(self) -> None:\n        msgs: list[Any] = [\n            \"not-a-dict\",\n            123,\n            {\"role\": \"user\", \"content\": None},\n            {\"role\": \"user\", \"content\": \"   \"},\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": \"real-first-user\"},\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\"url\": \"http://example.com/a.png\"},\n                    },\n                ],\n            },\n            {\"role\": \"custom_unknown_role\", \"content\": \"middle-\" + (\"M\" * 3000)},\n            {\"role\": \"user\", \"content\": \"real-last-user\"},\n            {\"role\": \"user\", \"content\": \"\"},\n        ]\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertIn(\"real-first-user\", res.prompt)\n        self.assertIn(\"[image omitted]\", res.prompt)\n        self.assertIn(\"real-last-user\", res.prompt)\n        self.assertNotIn(\"middle-M\", res.prompt)\n\n    def test_t10_marker_placement_chronology_determinism_and_idempotency(self) -> None:\n        # Сценарий с двумя разрывами:\n        # U0(first_user), U1(dropped), U2(last_user), U3(dropped tool group), U4(kept trailing tool group)\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-top\"},\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"drop-1-\" + (\"A\" * 1500)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_drop\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_drop\",\n                \"name\": \"f\",\n                \"content\": \"drop-2-\" + (\"B\" * 1500),\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_keep\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"f\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_keep\",\n                \"name\": \"f\",\n                \"content\": \"keep-trail\",\n            },\n        ]\n        res1 = self.mod._prune_messages(msgs, limit=600, target=400)\n        res2 = self.mod._prune_messages(msgs, limit=600, target=400)\n        self.assertEqual(res1.status, \"pruned\")\n        self.assertEqual(res1.prompt, res2.prompt)\n        self.assertEqual(res1.messages, res2.messages)\n        # Ровно два маркера в двух разрывах.\n        self.assertEqual(res1.prompt.count(self.mod.COMPACTION_MARKER), 2)\n        p_first = res1.prompt.index(\"User: first-u\")\n        p_m1 = res1.prompt.index(self.mod.COMPACTION_MARKER)\n        p_last = res1.prompt.index(\"User: last-u\")\n        p_m2 = res1.prompt.rindex(self.mod.COMPACTION_MARKER)\n        p_trail = res1.prompt.index(\"keep-trail\")\n        self.assertTrue(p_first < p_m1 < p_last < p_m2 < p_trail)\n\n        # Идемпотентность: повторный вызов с теми же параметрами и с принудительным порогом.\n        idem1 = self.mod._prune_messages(res1.messages, limit=600, target=400)\n        self.assertEqual(idem1.prompt, res1.prompt)\n        self.assertEqual(idem1.messages, res1.messages)\n        idem2 = self.mod._prune_messages(\n            res1.messages, limit=res1.est_after - 1, target=res1.est_after\n        )\n        self.assertEqual(idem2.prompt, res1.prompt)\n        self.assertEqual(idem2.messages, res1.messages)\n\n    def test_t11_input_not_mutated_and_wlock_not_held_during_prune(self) -> None:\n        import copy\n\n        msgs = [\n            {\"role\": \"system\", \"content\": \"sys\"},\n            {\"role\": \"user\", \"content\": \"u1\"},\n            {\"role\": \"assistant\", \"content\": \"A\" * 3000},\n            {\"role\": \"user\", \"content\": \"u2\"},\n        ]\n        snapshot = copy.deepcopy(msgs)\n        res = self.mod._prune_messages(msgs, limit=500, target=300)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertEqual(msgs, snapshot)\n        for m in res.messages:\n            if m.get(\"role\") != self.mod._COMPACTION_MARKER_ROLE:\n                self.assertTrue(any(m is orig for orig in msgs))\n\n        # Проверка в Handler._serve_json: во время _prune_messages замок self._wlock не захвачен.\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler.connection = None\n        handler._wlock = threading.Lock()\n        handler._client_gone = False\n        handler._current_run = None\n        handler._sse_open = False\n        handler._content_started = False\n        lock_states: list[bool] = []\n        orig_prune = self.mod._prune_messages\n\n        def spy_prune(*args: Any, **kwargs: Any) -> Any:\n            lock_states.append(handler._wlock.locked())\n            return orig_prune(*args, **kwargs)\n\n        with (\n            mock.patch.object(self.mod, \"_prune_messages\", side_effect=spy_prune),\n            mock.patch.object(\n                self.mod.ServeRun,\n                \"execute\",\n                return_value={\"rc\": 0, \"state\": \"ok\", \"text\": \"ok\", \"err\": \"\"},\n            ),\n            mock.patch.object(handler, \"_send\"),\n        ):\n            handler._serve_json({\"model\": \"muse-wonder-1.0\", \"messages\": msgs})\n        self.assertEqual(lock_states, [False])\n\n    def test_t13_trailing_incomplete_tool_unit_kept_or_refused_if_exceeds_cap(\n        self,\n    ) -> None:\n        msgs = [\n            {\"role\": \"user\", \"content\": \"first-u\"},\n            {\"role\": \"assistant\", \"content\": \"mid-\" + (\"M\" * 2000)},\n            {\"role\": \"user\", \"content\": \"last-u\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"c_tail\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"bash\", \"arguments\": \"{}\"},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c_tail\",\n                \"name\": \"bash\",\n                \"content\": \"tool-output-\" + (\"T\" * 600),\n            },\n        ]\n        # Обязательный набор (first-u + last-u + trailing tool unit + маркер) ~ 260 токенов.\n        # Пусть limit=500, target=200: обязательный набор > target (200), но <= cap (500) -> сохраняется!\n        res_ok = self.mod._prune_messages(msgs, limit=500, target=200)\n        self.assertEqual(res_ok.status, \"pruned\")\n        self.assertIn(\"tool-output-\", res_ok.prompt)\n        self.assertNotIn(\"mid-M\", res_ok.prompt)\n        self.assertLessEqual(res_ok.est_after, 500)\n\n        # Если же обязательный набор с незавершённой единицей > cap (limit=200) -> отказ.\n        res_refused = self.mod._prune_messages(msgs, limit=200, target=160)\n        self.assertEqual(res_refused.status, \"refused\")\n\n    def test_t14_hysteresis_prefix_stability_and_399999_passthrough(self) -> None:\n        # 399_999 не прунится при limit=400_000.\n        prefix_len = len(\"User: \".encode(\"utf-8\"))\n        exact_bytes = 399_999 * 3 - prefix_len\n        msg_399k = [{\"role\": \"user\", \"content\": \"a\" * exact_bytes}]\n        res_399k = self.mod._prune_messages(msg_399k, limit=400_000, target=320_000)\n        self.assertEqual(res_399k.est_before, 399_999)\n        self.assertEqual(res_399k.status, \"pass_through\")\n\n        # Два хода подряд с ростом > 400k: префикс (system, tools, первый user, маркер) побайтно одинаков.\n        tools = [\n            {\n                \"type\": \"function\",\n                \"function\": {\"name\": \"t1\", \"description\": \"d\", \"parameters\": {}},\n            }\n        ]\n        base_msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"stable-system-prompt\"},\n            {\"role\": \"user\", \"content\": \"stable-first-user\"},\n        ]\n        for i in range(15):\n            base_msgs.append(\n                {\n                    \"role\": \"assistant\" if i % 2 == 0 else \"user\",\n                    \"content\": f\"m{i}-\" + (\"X\" * 90_000),\n                }\n            )\n        turn1 = base_msgs + [{\"role\": \"user\", \"content\": \"question-1\"}]\n        turn2 = turn1 + [\n            {\"role\": \"assistant\", \"content\": \"answer-1-\" + (\"Y\" * 30_000)},\n            {\"role\": \"user\", \"content\": \"question-2\"},\n        ]\n        r1 = self.mod._prune_messages(turn1, limit=400_000, target=320_000, tools=tools)\n        r2 = self.mod._prune_messages(turn2, limit=400_000, target=320_000, tools=tools)\n        self.assertEqual(r1.status, \"pruned\")\n        self.assertEqual(r2.status, \"pruned\")\n        marker_end_1 = r1.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        marker_end_2 = r2.prompt.index(self.mod.COMPACTION_MARKER) + len(\n            self.mod.COMPACTION_MARKER\n        )\n        self.assertEqual(\n            r1.prompt[:marker_end_1].encode(\"utf-8\"),\n            r2.prompt[:marker_end_2].encode(\"utf-8\"),\n        )\n\n\nclass ContextRetryTest(_BridgeScenario):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '970,1038p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '1862,2135p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '761,865p' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/code-diff.patch'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '970,1038p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '1862,2135p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'\nsed -n '761,865p' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-foreign-session-20261014/code-diff.patch'\"","aggregated_output":"                self, {\"terminal\": \"failed\", \"error\": {\"quota\": quota}}\n            )\n            _, body = bridge_request(self, turn_request())\n            self.assertIn(\"[REDACTED]\", body.decode())\n            self.assertNotIn(\n                \"alpha beta gamma\", body.decode() + self.mod.LOG_PATH.read_text()\n            )\n\n\ndef install_protocol_wrapper(\n    scenario: Any, params: dict, noise: bool = False, delay: float = 0\n) -> None:\n    \"\"\"Фейковый MSP с реальными pipes; фиксирует argv и входящие RPC.\"\"\"\n    config = {\n        \"params\": params,\n        \"noise\": noise,\n        \"delay\": delay,\n        \"root\": str(scenario.tmp),\n    }\n    script = scenario.tmp / \"protocol.py\"\n    script.write_text(\n        \"\"\"import json, sys, time\nfrom pathlib import Path\nconfig = json.loads(sys.argv[1])\nroot = Path(config[\"root\"])\nmode = sys.argv[2]\n(root / (mode + \"-argv.json\")).write_text(json.dumps(sys.argv[2:]))\nif mode == \"exec\":\n    print(json.dumps({\"schema_version\": 1, \"payload_type\": \"run.terminal.completed\", \"payload\": {\"text\": \"fallback-ok\"}}), flush=True)\n    sys.exit(0)\nfor line in sys.stdin:\n    msg = json.loads(line)\n    with (root / \"rpc.jsonl\").open(\"a\") as fh:\n        fh.write(json.dumps(msg) + \"\\\\n\")\n    if \"id\" not in msg:\n        continue\n    method = msg[\"method\"]\n    result = {\"session\": {\"sessionId\": \"sess-1\"}} if method == \"session/start\" else {\"status\": \"accepted\", \"turnId\": \"turn-1\"} if method == \"turn/start\" else {}\n    print(json.dumps({\"id\": msg[\"id\"], \"result\": result}), flush=True)\n    if method == \"turn/start\":\n        time.sleep(config[\"delay\"])\n        if config[\"params\"].get(\"approval\"):\n            print(json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"approval/request\", \"params\": {}}), flush=True)\n            break\n        print(json.dumps({\"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": \"hello\"}}}), flush=True)\n        print(json.dumps({\"method\": \"turn/completed\", \"params\": dict(config[\"params\"], turnId=\"turn-1\")}), flush=True)\n        if config[\"params\"].get(\"stderr\"):\n            print(config[\"params\"][\"stderr\"], file=sys.stderr, flush=True)\n        if config[\"noise\"]:\n            for i in range(12):\n                print(\"noise-%02d-\" % i + \"z\" * 100, file=sys.stderr, flush=True)\n        break\n\"\"\",\n        encoding=\"utf-8\",\n    )\n    import shlex\n\n    wrapper = scenario.tmp / \"muse-cli.sh\"\n    wrapper.write_text(\n        f'#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} {shlex.quote(json.dumps(config))} \"$@\"\\n'\n    )\n    wrapper.chmod(0o755)\n    scenario.mod.MUSE_WRAPPER = str(wrapper)\n\n\nclass ServeTurnErrorExtractionTest(_BridgeScenario):\n    \"\"\"AD-002: приоритет, защитный разбор и точные лимиты терминальной причины.\"\"\"\n\n    def _execute(self, params: dict, noise: bool = False) -> dict:\nclass ContextRetryTest(_BridgeScenario):\n    \"\"\"T-12, T-15..T-22: аварийный auto-retry при ошибке жёсткого порога Meta.\"\"\"\n\n    def _over_budget_messages(\n        self, chunk_bytes: int = 110_000, count: int = 12\n    ) -> list[dict[str, Any]]:\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"system\", \"content\": \"sys-canary-head\"},\n            {\"role\": \"user\", \"content\": \"first-user-canary\"},\n        ]\n        for i in range(count):\n            role = \"assistant\" if i % 2 == 0 else \"user\"\n            msgs.append(\n                {\"role\": role, \"content\": f\"mid-canary-{i}-\" + (\"M\" * chunk_bytes)}\n            )\n        msgs.append({\"role\": \"user\", \"content\": \"last-user-canary\"})\n        return msgs\n\n    def test_t12_mandatory_exceeds_limit_returns_502_before_run(self) -> None:\n        huge_canary = \"MANDATORY_SECRET_CANARY_\" + (\"Z\" * 1_250_000)\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": [{\"role\": \"user\", \"content\": huge_canary}],\n            \"stream\": False,\n        }\n        with (\n            mock.patch.object(self.mod, \"ServeRun\") as serve_cls,\n            mock.patch.object(self.mod, \"Run\") as run_cls,\n        ):\n            status, body = bridge_request(self, payload)\n            self.assertEqual(status, 502)\n            serve_cls.assert_not_called()\n            run_cls.assert_not_called()\n        self.assertTrue(self._slot_free())\n        err = json.loads(body.decode(\"utf-8\"))[\"error\"]\n        self.assertIn(\"mandatory context exceeds budget\", err[\"message\"])\n        self.assertIn(\"limit=400000\", err[\"message\"])\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"reason=refused_mandatory\", logs)\n        self.assertNotIn(\"MANDATORY_SECRET_CANARY_\", body.decode(\"utf-8\") + logs)\n\n    def test_t15_hard_threshold_error_triggers_single_retry_and_succeeds(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(639915 >= 460800 tokens) retryable=True\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                prompts_seen: list[str] = []\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    prompts_seen.append(run_self.prompt)\n                    if len(prompts_seen) == 1:\n                        return {\n                            \"rc\": 1,\n                            \"state\": \"terminal_failed\",\n                            \"text\": \"\",\n                            \"err\": hard_err,\n                            \"via\": \"serve\",\n                        }\n                    return {\n                        \"rc\": 0,\n                        \"state\": \"ok\",\n                        \"text\": \"recovered-ok\",\n                        \"chunks\": [\"recovered-ok\"],\n                        \"err\": \"\",\n                        \"summaries\": [],\n                        \"usage\": {\"promptTokens\": 150000, \"outputTokens\": 5},\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(status, 200)\n                self.assertEqual(len(prompts_seen), 2)\n                est1 = self.mod._estimate_tokens(prompts_seen[0])\n                est2 = self.mod._estimate_tokens(prompts_seen[1])\n                self.assertLessEqual(est1, 320_000)\n                self.assertLessEqual(est2, 200_000)\n                self.assertLess(est2, est1)\n                text_body = body.decode(\"utf-8\")\n                self.assertIn(\"recovered-ok\", text_body)\n                if stream:\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    frames = [\n                        json.loads(line[6:])\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                    ]\n                    self.assertFalse(any(\"error\" in f for f in frames))\n\n    def test_t16_hard_threshold_error_twice_returns_terminal_502(self) -> None:\n        hard_err = (\n            \"modelError: context compaction replacement still exceeds the hard threshold \"\n            \"(500000 >= 460800 tokens) prompt-canary-reflected\"\n        )\n        for stream in (False, True):\n            with self.subTest(stream=stream):\n                self.mod.LOG_PATH.unlink(missing_ok=True)\n                calls = 0\n\n                def fake_execute(run_self: Any) -> dict[str, Any]:\n                    nonlocal calls\n                    calls += 1\n                    return {\n                        \"rc\": 1,\n                        \"state\": \"terminal_failed\",\n                        \"text\": \"\",\n                        \"err\": hard_err + \" \" + run_self.prompt,\n                        \"via\": \"serve\",\n                    }\n\n                payload = {\n                    \"model\": \"muse-wonder-full-1.0\",\n                    \"messages\": self._over_budget_messages(),\n                    \"stream\": stream,\n                }\n                with mock.patch.object(self.mod.ServeRun, \"execute\", fake_execute):\n                    status, body = bridge_request(self, payload)\n                self.assertEqual(calls, 2)\n                text_body = body.decode(\"utf-8\")\n                if stream:\n                    self.assertEqual(status, 200)\n                    self.assertEqual(text_body.count(\"data: [DONE]\"), 1)\n                    err_frames = [\n                        json.loads(line[6:])[\"error\"]\n                        for line in text_body.splitlines()\n                        if line.startswith(\"data: {\")\n                        and \"error\" in json.loads(line[6:])\n                    ]\n                    self.assertEqual(len(err_frames), 1)\n                    err_obj = err_frames[0]\n                else:\n                    self.assertEqual(status, 502)\n                    err_obj = json.loads(text_body)[\"error\"]\n                self.assertEqual(err_obj[\"type\"], \"proxy_error\")\n                self.assertEqual(err_obj[\"code\"], 502)\n                self.assertIn(\n                    \"context hard threshold exceeded after single compaction retry\",\n                    err_obj[\"message\"],\n                )\n                self.assertIn(\"target=200000\", err_obj[\"message\"])\n                logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n                for canary in (\n                    \"sys-canary-head\",\n                    \"first-user-canary\",\n                    \"mid-canary-\",\n                    \"last-user-canary\",\n                ):\n                    self.assertNotIn(canary, text_body + logs)\n\n    def test_t17_other_error_or_marker_in_normal_text_does_not_retry(self) -> None:\n        self.assertEqual(\n            self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n            \"context compaction replacement still exceeds the hard threshold\",\n        )\n        # 1) Другая ошибка в err -> 1 попытка.\n        calls = 0\n\n        def other_err(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": \"quota_exceeded\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with mock.patch.object(self.mod.ServeRun, \"execute\", other_err):\n            status, _ = bridge_request(self, payload)\n        self.assertEqual(status, 502)\n        self.assertEqual(calls, 1)\n\n        # 2) Подстрока в обычном ответе модели (rc=0, state=\"ok\") -> 1 попытка, 200 OK.\n        calls = 0\n\n        def marker_in_text(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\",\n                \"chunks\": [\n                    f\"Here is the error string: {self.mod.HARD_THRESHOLD_ERR_SUBSTR}\"\n                ],\n                \"err\": \"\",\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", marker_in_text):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(calls, 1)\n        self.assertIn(self.mod.HARD_THRESHOLD_ERR_SUBSTR, body.decode(\"utf-8\"))\n\n    def test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget(\n        self,\n    ) -> None:\n        exec_prompts: list[str] = []\n\n        def fail_serve(_self: Any) -> dict[str, Any]:\n            raise self.mod.ServeUnavailable(\"serve down\")\n\n        def fake_exec(run_self: Any) -> dict[str, Any]:\n            exec_prompts.append(run_self.prompt)\n            n = len(exec_prompts)\n            if n == 1:\n                # Сетевой маркер на первой попытке -> сетевой ретрай с тем же промптом.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"nonzero_exit\",\n                    \"text\": \"\",\n                    \"err\": self.mod.NETWORK_RETRY_MARKER,\n                }\n            if n == 2:\n                # Сетевой ретрай вернул ошибку порога Meta -> должен сработать контекстный retry.\n                return {\n                    \"rc\": 1,\n                    \"state\": \"terminal_failed\",\n                    \"text\": \"\",\n                    \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n                }\n            return {\n                \"rc\": 0,\n                \"state\": \"ok\",\n                \"text\": \"exec-recovered\",\n                \"chunks\": [\"exec-recovered\"],\n                \"err\": \"\",\n            }\n\n        payload = {\n            \"model\": \"muse-wonder-1.0\",\n            \"messages\": self._over_budget_messages(),\n        }\n        with (\n            mock.patch.object(self.mod.ServeRun, \"execute\", fail_serve),\n            mock.patch.object(self.mod.Run, \"execute\", fake_exec),\n        ):\n            status, body = bridge_request(self, payload)\n        self.assertEqual(status, 200)\n        self.assertEqual(len(exec_prompts), 3)\n        self.assertEqual(exec_prompts[0], exec_prompts[1])\n        self.assertLess(\n            self.mod._estimate_tokens(exec_prompts[2]),\n            self.mod._estimate_tokens(exec_prompts[0]),\n        )\n        self.assertIn(\"exec-recovered\", body.decode(\"utf-8\"))\n\n    def test_t19_client_disconnect_between_attempts_skips_second_run(self) -> None:\n        calls = 0\n        first_entered = threading.Event()\n        release_first = threading.Event()\n\n        def fake_execute(_self: Any) -> dict[str, Any]:\n            nonlocal calls\n            calls += 1\n            first_entered.set()\n            release_first.wait(5)\n            return {\n                \"rc\": 1,\n                \"state\": \"terminal_failed\",\n                \"text\": \"\",\n                \"err\": self.mod.HARD_THRESHOLD_ERR_SUBSTR,\n@@ -729,6 +1392,10 @@ class Run:\n             str(self.workdir),\n             \"--json\",\n             \"--no-session-log\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n+            \"--disable-web-tools\",\n+            \"--disable-reminders\",\n             \"--prompt-file\",\n             prompt_path,\n         ]\n@@ -888,6 +1555,7 @@ class Run:\n             \"chunks\": chunks,\n             \"err\": \"\\n\".join(err_lines[-6:]),\n             \"state\": state,\n+            \"hard_threshold\": _has_hard_threshold_marker(err_lines, reason),\n         }\n \n \n@@ -986,6 +1654,8 @@ class ServeRun:\n             self.model_id,\n             \"--no-session-log\",\n             \"--trust-workspace\",\n+            \"--disable-write\",\n+            \"--disable-shell\",\n         ]\n         try:\n             self.proc = subprocess.Popen(\n@@ -1008,6 +1678,8 @@ class ServeRun:\n         os.set_blocking(self.proc.stdin.fileno(), False)\n \n         err_lines: list[str] = []\n+        turn_diag_lines: list[str] = []\n+        stderr_joined = False\n \n         def drain_stderr() -> None:\n             try:\n@@ -1180,6 +1852,7 @@ class ServeRun:\n                 f\"serve turn session={session_id[:8]} turn={turn_id[:8]} effort={tier}\"\n             )\n             terminal: str | None = None\n+            hard_threshold = False\n             while time.time() < deadline:\n                 # Смерть serve здесь не проверяется: события и completed, уже лежащие в буфере\n                 # чтения или pipe, разбираются первыми; read_msg сам поднимет ServeUnavailable\n@@ -1193,6 +1866,11 @@ class ServeRun:\n                         _handle_event(msg, None)\n                         continue\n                     terminal = str(p.get(\"terminal\") or \"unknown\")\n+                    if terminal != \"completed\":\n+                        hard_threshold = _has_hard_threshold_marker(\n+                            p.get(\"error\"), p.get(\"reason\")\n+                        )\n+                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n                     break\n                 if \"id\" in msg and (\"result\" in msg or \"error\" in msg):\n                     continue  # чужой/дублированный ack — игнор, не разрываем ход\n@@ -1216,7 +1894,20 @@ class ServeRun:\n                 if part not in summaries:\n                     summaries.append(part)\n             text = final_text if final_text is not None else \"\".join(deltas)\n-            err = \"\\n\".join(err_lines[-6:])\n+            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n+            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n+            err_thread.join(timeout=5)\n+            stderr_joined = True\n+            hard_threshold = hard_threshold or _has_hard_threshold_marker(err_lines)\n+            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n+            if self.prompt:\n+                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n+            err = \"\\n\".join(turn_diag_lines)\n+            if err:\n+                if stderr_tail:\n+                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n+            else:\n+                err = stderr_tail\n             if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n                 return {\n                     \"rc\": serve_rc,\n@@ -1227,6 +1918,7 @@ class ServeRun:\n                     \"summaries\": summaries,\n                     \"usage\": usage,\n                     \"via\": \"serve\",\n+                    \"hard_threshold\": hard_threshold,\n                 }\n             if terminal != \"completed\":\n                 return {\n@@ -1238,6 +1930,7 @@ class ServeRun:\n                     \"summaries\": summaries,\n                     \"usage\": usage,\n                     \"via\": \"serve\",\n+                    \"hard_threshold\": hard_threshold,\n                 }\n             return {\n                 \"rc\": 0,\n@@ -1250,7 +1943,8 @@ class ServeRun:\n                 \"via\": \"serve\",\n             }\n         finally:\n-            err_thread.join(timeout=5)\n+            if not stderr_joined:\n+                err_thread.join(timeout=5)\n             self.close()\n \n \n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"agent_message","text":"Дополнительные проверки выявили два дефекта: вставка `system` между `assistant(tool_calls)` и `tool` приводит к потере обязательной хвостовой связки; экранированное отражение промпта в RPC-ошибке сохраняет приватный текст после санитизации.\n\nПолный прогон запустил через `run-guarded`: 27 тестов прошли, 40 остановились на запрете sandbox создавать слушающий сокет (`bind: Operation not permitted`). Это ограничение среды; заявленные `67 passed` здесь не подтверждены.\n"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 run-guarded -- python3 - <<'PY'\nimport importlib.util,io,json,tempfile,threading\nfrom pathlib import Path\nfrom unittest import mock\ns=importlib.util.spec_from_file_location('testprobe','/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py'); t=importlib.util.module_from_spec(s); s.loader.exec_module(t)\ndef direct(scenario,payload=None,path='/v1/chat/completions'):\n    m=scenario.mod; h=m.Handler.__new__(m.Handler)\n    h.connection=None; h._client_gone=False; h._current_run=None; h._sse_open=False; h._content_started=False; h._wlock=threading.Lock(); h._sse_phase='OPEN'; h._keepalive_stop=None; h._ka_thread=None\n    h.wfile=io.BytesIO(); codes=[]\n    h.send_response=lambda code: codes.append(code)\n    h.send_header=lambda *args:None\n    h.end_headers=lambda:None\n    h._serve_json(payload)\n    h._sse_stop_keepalive()\n    return codes[0],h.wfile.getvalue()\nt.bridge_request=direct\nfor name in ('test_t24_repeated_tool_call_id_across_episodes_preserves_trailing_mandatory_unit','test_t25_long_prefix_before_hard_threshold_marker_triggers_retry_via_msp','test_t26_reflected_message_with_embedded_secret_leaves_neither_canary_nor_secret','test_t27_serve_unavailable_with_reflected_prompt_does_not_leak_to_log'):\n    with tempfile.TemporaryDirectory(prefix='council-r2-') as tmp:\n        case=t.ContextObservabilityTest(name); case.tmp=Path(tmp); case.mod=t.load_bridge(); case.mod.WORKSPACE=case.tmp/'workspace'; case.mod.LOG_PATH=case.tmp/'bridge.log'; case.mod._slots=threading.Semaphore(1)\n        getattr(case,name)(); print('DIRECT_HANDLER_PASS',name)\nwith tempfile.TemporaryDirectory(prefix='council-rpc-') as tmp:\n    case=t.ContextObservabilityTest(); case.tmp=Path(tmp); case.mod=t.load_bridge(); case.mod.WORKSPACE=case.tmp/'workspace'; case.mod.LOG_PATH=case.tmp/'bridge.log'\n    t.install_protocol_wrapper(case,{'terminal':'completed'})\n    p=case.tmp/'protocol.py'; code=p.read_text(); code=code.replace('print(json.dumps({\\\"id\\\": msg[\\\"id\\\"], \\\"result\\\": result}), flush=True)', 'print(json.dumps({\\\"id\\\": msg[\\\"id\\\"], \\\"error\\\": {\\\"message\\\": msg[\\\"params\\\"][\\\"input\\\"][0][\\\"text\\\"]}} if method == \\\"turn/start\\\" else {\\\"id\\\": msg[\\\"id\\\"], \\\"result\\\": result}), flush=True)'); p.write_text(code)\n    content='RPC_PRIVATE_CANARY: owner\\\\'s \\\"confidential\\\" memo api_key=[REDACTED_SECRET]'\n    status,body=direct(case,{'model':'muse-wonder-1.0','messages':[{'role':'user','content':content}]})\n    logs=case.mod.LOG_PATH.read_text()\n    print('REAL_RPC_FALLBACK_STATUS',status)\n    print('REAL_RPC_PRIVATE_TEXT_LEAK', 'RPC_PRIVATE_CANARY' in logs)\n    print('REAL_RPC_SECRET_LEAK', 'synthetic-secret' in logs)\n    print('REAL_RPC_LOG', next(x for x in logs.splitlines() if 'serve unavailable' in x))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
