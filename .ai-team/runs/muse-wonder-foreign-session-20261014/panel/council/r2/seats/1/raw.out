@@ class Handler(BaseHTTPRequestHandler):\n982:@@ -1446,6 +2168,8 @@ class Handler(BaseHTTPRequestHandler):\n991:@@ -1579,8 +2303,9 @@ class Handler(BaseHTTPRequestHandler):\n1003:@@ -1591,15 +2316,56 @@ class Handler(BaseHTTPRequestHandler):\n1069:@@ -1628,46 +2394,151 @@ class Handler(BaseHTTPRequestHandler):\n1238:@@ -1687,12 +2558,22 @@ class Handler(BaseHTTPRequestHandler):\n1262:@@ -1703,12 +2584,19 @@ class Handler(BaseHTTPRequestHandler):\n1284:@@ -1721,12 +2609,24 @@ class Handler(BaseHTTPRequestHandler):\n1311:@@ -1734,8 +2634,8 @@ class Handler(BaseHTTPRequestHandler):\n1322:diff --git a/tests/test_muse_bridge_killpg.py b/tests/test_muse_bridge_killpg.py\n1326:@@ -13,9 +13,12 @@ bridges/muse-bridge/server.py без живого muse-bin: вместо CLI —\n1339:@@ -30,9 +33,14 @@ from types import SimpleNamespace\n1355:@@ -637,5 +645,1978 @@ class WaitGroupExitTest(unittest.TestCase):\n9:лидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\n72:    exec \"{python}\" \"{script}\" \"{servepid}\"\n354:            python=sys.executable,\n892:        install_protocol_wrapper(\n952:                    install_protocol_wrapper(self, params)\n969:            install_protocol_wrapper(\n979:def install_protocol_wrapper(\n1039:        install_protocol_wrapper(self, params, noise)\n1182:        install_protocol_wrapper(self, {\"terminal\": \"completed\"}, delay=0.2)\n1263:        install_protocol_wrapper(self, {\"terminal\": \"completed\"})\n1279:        install_protocol_wrapper(self, {\"approval\": True})\n1376:class ContextEstimateTest(unittest.TestCase):\n1412:class ContextPruneTest(unittest.TestCase):\n1862:class ContextRetryTest(_BridgeScenario):\n2277:class ContextObservabilityTest(_BridgeScenario):\n2364:    def test_t24_repeated_tool_call_id_across_episodes_preserves_trailing_mandatory_unit(\n2432:    def test_t25_long_prefix_before_hard_threshold_marker_triggers_retry_via_msp(\n2519:    def test_t26_reflected_message_with_embedded_secret_leave