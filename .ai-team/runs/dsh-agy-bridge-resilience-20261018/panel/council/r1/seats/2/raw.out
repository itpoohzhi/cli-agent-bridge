f.fetch\n   646\t        cancelled: list[str] = []\n   647\t\n   648\t        async def fetch_one(src: dict, ctx: Any, ctx_r: Any, cutoff: Any) -> tuple:\n   649\t            try:\n   650\t                await asyncio.sleep(30)\n   651\t            finally:\n   652\t                cancelled.append(src[\"id\"])\n   653\t            return src[\"id\"], [\"never\"], None\n   654\t\n   655\t        async def fetch_one_no_rss(src: dict, ctx: Any, cutoff: Any) -> tuple:\n   656\t            return src[\"id\"], [\"ok\"], None\n   657\t\n   658\t        async def scenario() -> list:\n   659\t            return await asyncio.gather(\n   660\t                fetch._track_fetch_one({\"id\": \"hung\"}, None, None, None, fetch_one),\n   661\t                fetch._track_fetch_one(\n   662\t                    {\"id\": \"good\"}, None, None, None, fetch_one_no_rss\n   663\t                ),\n   664\t            )\n   665\t\n   666\t        self.assertEqual(fetch.FETCH_ONE_TIMEOUT_S, 60.0)\n   667\t        started = time.monotonic()\n   668\t        with mock.patch.object(fetch, \"FETCH_ONE_TIMEOUT_S\", 0.1):\n   669\t            results = asyncio.run(scenario())\n   670\t        self.assertLess(time.monotonic() - started, 2.0)\n   671\t        self.assertEqual(results[0], (\"hung\", [], \"timeout after 60s\"))\n   672\t        self.assertEqual(results[1], (\"good\", [\"ok\"], None))\n   673\t        self.assertEqual(cancelled, [\"hung\"], \"зависший источник должен быть отменён\")\n   674\t        self.assertEqual(fetch._progress[\"pending\"], set())\n   675\t        self.assertEqual(fetch._progress[\"completed\"], 2)\n   676\t\n   677\t    def test_page_close_bounded(self) -> None:\n   678\t        fetch = self.fetch\n   679\t        self.assertEqual(fetch.PAGE_CLOSE_TIMEOUT_S, 5.0)\n   680\t\n   681\t        class _HungPage:\n   682\t            async def close(self) -> None:\n   683\t                await asyncio.sleep(30)\n   684\t\n   685\t        class _BrokenPage:\n   6