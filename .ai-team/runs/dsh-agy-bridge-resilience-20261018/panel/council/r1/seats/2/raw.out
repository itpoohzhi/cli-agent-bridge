{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_agy_bridge_resilience.py | sed -n '385,711p'; rg -n '\"'^async def|wait_for|except |finally:|gather|ctx.close|browser.close|page.close'\"' '/Users/aazhiry1/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py'; rg --files -g 'pyproject.toml' -g '*requirements*' -g '*AGENTS*' -g '*CLAUDE*' -g 'pytest.ini' -g '.github/workflows/*' -g 'README*'\"","aggregated_output":"   385\t    def test_absolute_cap_maps_to_timeout(self) -> None:\n   386\t        clock = _FakeClock()\n   387\t        pure = AdaptiveTimeoutController(\n   388\t            idle_timeout_s=1000.0,\n   389\t            safety_cap_s=0.2,\n   390\t            finish_reserve_s=0.0,\n   391\t            watchdog_enabled=False,\n   392\t            clock=clock,\n   393\t        )\n   394\t        clock.advance(0.25)\n   395\t        self.assertEqual(pure.check()[:2], (True, \"absolute_cap\"))\n   396\t\n   397\t        clock = _FakeClock()\n   398\t        ctrl = self._controller(clock, safety_cap_s=7.0)\n   399\t        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n   400\t        self.assertEqual(out[\"state\"], \"timeout\")\n   401\t        self.assertEqual(out[\"rc\"], 124)\n   402\t        self.assertEqual(srv.Handler._error_body(out)[\"type\"], \"timeout\")\n   403\t\n   404\t\n   405\tclass KillSwitchTests(unittest.TestCase):\n   406\t    def test_flag_values(self) -> None:\n   407\t        for value in (\"0\", \"false\", \"no\", \"off\", \"False\", \"OFF\"):\n   408\t            with (\n   409\t                self.subTest(value=value),\n   410\t                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n   411\t            ):\n   412\t                self.assertFalse(srv._is_watchdog_enabled())\n   413\t        for value in (\"1\", \"true\", \"yes\", \"on\"):\n   414\t            with (\n   415\t                self.subTest(value=value),\n   416\t                mock.patch.dict(os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": value}),\n   417\t            ):\n   418\t                self.assertTrue(srv._is_watchdog_enabled())\n   419\t        with mock.patch.dict(os.environ):\n   420\t            os.environ.pop(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", None)\n   421\t            self.assertTrue(srv._is_watchdog_enabled())\n   422\t\n   423\t    def test_idle_timeout_env_validation(self) -> None:\n   424\t        for raw in (\"abc\", \"-5\", \"0\", \"nan\", \"inf\"):\n   425\t            with (\n   426\t                self.subTest(raw=raw),\n   427\t                mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": raw}),\n   428\t                mock.patch.object(srv, \"_log\") as log,\n   429\t            ):\n   430\t                self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n   431\t                log.assert_called_once()\n   432\t        with mock.patch.dict(os.environ, {\"AGY_BRIDGE_IDLE_TIMEOUT\": \"12.5\"}):\n   433\t            self.assertEqual(srv._idle_timeout_from_env(), 12.5)\n   434\t        with mock.patch.dict(os.environ):\n   435\t            os.environ.pop(\"AGY_BRIDGE_IDLE_TIMEOUT\", None)\n   436\t            self.assertEqual(srv._idle_timeout_from_env(), 300.0)\n   437\t\n   438\t    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n   439\t    def test_killswitch_disables_watchdog(self) -> None:\n   440\t        with tempfile.TemporaryDirectory() as tmp:\n   441\t            launcher = Path(tmp) / \"fake-launcher.sh\"\n   442\t            launcher.write_text(\"#!/bin/sh\\nexec sleep 100\\n\", encoding=\"utf-8\")\n   443\t            launcher.chmod(0o755)\n   444\t            runs: list[Any] = []\n   445\t\n   446\t            def make_run() -> Any:\n   447\t                run = srv.Run(\"ping\", \"m\", \"low\", \"default\", \"\", \"tag\")\n   448\t                runs.append(run)\n   449\t                return run\n   450\t\n   451\t            try:\n   452\t                with (\n   453\t                    mock.patch.object(srv, \"_launcher\", return_value=str(launcher)),\n   454\t                    mock.patch.object(srv, \"WORKSPACE\", Path(tmp) / \"ws\"),\n   455\t                    mock.patch.object(ProcessWatchdog, \"_run_ps\") as run_ps,\n   456\t                ):\n   457\t                    with mock.patch.dict(\n   458\t                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"0\"}\n   459\t                    ):\n   460\t                        off = make_run()\n   461\t                        self.assertEqual(\n   462\t                            off.controller.idle_timeout_s, float(srv.TIMEOUT_S)\n   463\t                        )\n   464\t                        self.assertIs(off.controller.watchdog_enabled, False)\n   465\t                        self.assertEqual(\n   466\t                            off.controller.safety_cap_s, float(srv.TIMEOUT_S)\n   467\t                        )\n   468\t                        self.assertEqual(off.controller.finish_reserve_s, 0.0)\n   469\t                        off.controller.check(off.proc.pid)\n   470\t                        run_ps.assert_not_called()  # ни seed, ни check не зовут ps\n   471\t                    with mock.patch.dict(\n   472\t                        os.environ, {\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\": \"1\"}\n   473\t                    ):\n   474\t                        on = make_run()\n   475\t                        self.assertEqual(\n   476\t                            on.controller.idle_timeout_s, srv.IDLE_TIMEOUT_S\n   477\t                        )\n   478\t                        self.assertIs(on.controller.watchdog_enabled, True)\n   479\t                        self.assertEqual(\n   480\t                            on.controller.safety_cap_s, float(srv.TIMEOUT_S)\n   481\t                        )\n   482\t            finally:\n   483\t                for run in runs:\n   484\t                    run.close()\n   485\t\n   486\t\n   487\tclass ErrorContractTests(unittest.TestCase):\n   488\t    def test_error_body_idle_timeout_http_504(self) -> None:\n   489\t        body = srv.Handler._error_body({\"state\": \"idle_timeout\", \"rc\": 124})\n   490\t        self.assertEqual(body[\"code\"], 504)\n   491\t        self.assertEqual(body[\"type\"], \"idle_timeout\")\n   492\t        self.assertIn(f\"idle timeout after {srv.IDLE_TIMEOUT_S:g}s\", body[\"message\"])\n   493\t        self.assertIn(\"idle timeout after 300s\", body[\"message\"])\n   494\t\n   495\t    def _out(self) -> dict:\n   496\t        return {\n   497\t            \"state\": \"idle_timeout\",\n   498\t            \"rc\": 124,\n   499\t            \"text\": \"\",\n   500\t            \"usage\": {},\n   501\t            \"result\": {},\n   502\t            \"err\": \"x\",\n   503\t            \"tool_calls\": [],\n   504\t            \"tool_events\": 0,\n   505\t            \"conversation_id\": \"\",\n   506\t        }\n   507\t\n   508\t    def test_sse_error_chunk_idle_timeout(self) -> None:\n   509\t        frames: list[str] = []\n   510\t        handler = srv.Handler.__new__(srv.Handler)\n   511\t        handler.send_response = lambda *_a, **_k: None\n   512\t        handler.send_header = lambda *_a, **_k: None\n   513\t        handler.end_headers = lambda: None\n   514\t        handler._emit = lambda data: frames.append(data) or True\n   515\t        handler._run_once = lambda *_a, **_k: self._out()\n   516\t        handler._serve_sse({\"model\": \"m\"})\n   517\t        self.assertGreaterEqual(len(frames), 3)\n   518\t        self.assertEqual(frames[-1], \"data: [DONE]\\n\\n\")\n   519\t        error_frame = frames[-2]\n   520\t        self.assertTrue(\n   521\t            error_frame.startswith(\"data: \") and error_frame.endswith(\"\\n\\n\")\n   522\t        )\n   523\t        payload = json.loads(error_frame[len(\"data: \") :])\n   524\t        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n   525\t        self.assertEqual(payload[\"error\"][\"code\"], 504)\n   526\t        # ни finish_reason=stop, ни usage-кадра после ошибки быть не должно\n   527\t        self.assertFalse(any('\"finish_reason\": \"stop\"' in f for f in frames))\n   528\t\n   529\t    def test_json_mode_idle_timeout_is_504(self) -> None:\n   530\t        sent: list[tuple] = []\n   531\t        handler = srv.Handler.__new__(srv.Handler)\n   532\t        handler._send = lambda code, payload: sent.append((code, payload))\n   533\t        handler._run_once = lambda *_a, **_k: self._out()\n   534\t        handler._serve_json({\"model\": \"m\"})\n   535\t        self.assertEqual(len(sent), 1)\n   536\t        code, payload = sent[0]\n   537\t        self.assertEqual(code, 504)\n   538\t        self.assertEqual(payload[\"error\"][\"type\"], \"idle_timeout\")\n   539\t\n   540\t\n   541\t@unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n   542\tclass KillGroupTests(unittest.TestCase):\n   543\t    def test_kill_group_cleans_descendants_and_reaps_zombie(self) -> None:\n   544\t        proc = _spawn([\"sh\", \"-c\", \"sleep 100 & sleep 100 & wait\"])\n   545\t        try:\n   546\t            deadline = time.monotonic() + 3.0\n   547\t            while time.monotonic() < deadline:\n   548\t                out = subprocess.run(\n   549\t                    [\"ps\", \"-o\", \"pid=\", \"-g\", str(proc.pid)],\n   550\t                    capture_output=True,\n   551\t                    text=True,\n   552\t                    check=False,\n   553\t                )\n   554\t                if len(out.stdout.split()) >= 3:  # лидер + два sleep\n   555\t                    break\n   556\t                time.sleep(0.05)\n   557\t            self.assertGreaterEqual(len(out.stdout.split()), 3, \"потомки не стартовали\")\n   558\t            srv._kill_group(proc)\n   559\t            self.assertIsNotNone(proc.returncode)\n   560\t            self.assertTrue(\n   561\t                _group_gone(proc.pid), \"потомки группы пережили _kill_group\"\n   562\t            )\n   563\t            self.assertEqual(_ps_stat(proc.pid), \"\", \"лидер остался зомби\")\n   564\t        finally:\n   565\t            _hard_kill(proc)\n   566\t\n   567\t    def test_kill_group_reaps_when_group_already_gone(self) -> None:\n   568\t        proc = _spawn([\"true\"])\n   569\t        try:\n   570\t            deadline = time.monotonic() + 3.0\n   571\t            while _ps_stat(proc.pid) != \"Z\" and time.monotonic() < deadline:\n   572\t                time.sleep(0.05)  # лидер завершён и ещё не собран\n   573\t            with (\n   574\t                mock.patch.object(srv.os, \"killpg\", side_effect=ProcessLookupError),\n   575\t                mock.patch.object(proc, \"wait\", wraps=proc.wait) as wait,\n   576\t            ):\n   577\t                srv._kill_group(proc)  # не должен падать\n   578\t            wait.assert_called()\n   579\t            self.assertEqual(proc.returncode, 0)\n   580\t            self.assertEqual(_ps_stat(proc.pid), \"\", \"зомби не собран\")\n   581\t        finally:\n   582\t            _hard_kill(proc)\n   583\t\n   584\t    def test_kill_group_escalates_to_sigkill(self) -> None:\n   585\t        self.assertEqual(srv.KILL_TERM_GRACE_S, 2.0)\n   586\t        self.assertEqual(srv.KILL_WAIT_S, 5.0)\n   587\t        proc = _spawn(\n   588\t            [\"sh\", \"-c\", \"trap '' TERM; echo ready; while :; do sleep 1; done\"],\n   589\t            stdout=subprocess.PIPE,\n   590\t        )\n   591\t        try:\n   592\t            self.assertEqual(\n   593\t                proc.stdout.readline().strip(), b\"ready\"\n   594\t            )  # trap уже установлен\n   595\t            started = time.monotonic()\n   596\t            with mock.patch.object(srv, \"KILL_TERM_GRACE_S\", 0.4):\n   597\t                srv._kill_group(proc)\n   598\t            elapsed = time.monotonic() - started\n  