{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba bridges/agy-bridge/server.py | sed -n '285,345p;525,595p;712,885p;981,1103p;1160,1232p'; cat bridges/agy-bridge/start.sh; git diff e331fd6..HEAD -- core/lifecycle.py .gitignore\"","aggregated_output":"   285\t\n   286\ttry:\n   287\t    FLEET = _load_fleet()\n   288\texcept FleetViolation as _violation:\n   289\t    sys.stderr.write(f\"fleet_invalid model={_violation.model} reason={_violation.reason}\\n\")\n   290\t    sys.stderr.flush()\n   291\t    raise SystemExit(1)\n   292\t\n   293\tMODEL_ID = ENV_MODEL or FLEET[\"default_model\"]\n   294\t\n   295\t\n   296\tdef _log(msg: str) -> None:\n   297\t    sys.stderr.write(\"[agy-bridge] %s %s\\n\" % (time.strftime(\"%H:%M:%S\"), _mask_secrets(msg)))\n   298\t    sys.stderr.flush()\n   299\t\n   300\t\n   301\tdef _idle_timeout_from_env() -> float:\n   302\t    \"\"\"Порог неактивности хода, с; невалидное или неположительное значение -> дефолт core.\"\"\"\n   303\t    raw = os.environ.get(\"AGY_BRIDGE_IDLE_TIMEOUT\", \"\").strip()\n   304\t    if not raw:\n   305\t        return float(_CORE_IDLE_TIMEOUT_S)\n   306\t    try:\n   307\t        value = float(raw)\n   308\t    except ValueError:\n   309\t        value = 0.0\n   310\t    if not value > 0.0 or value != value or value == float(\"inf\"):\n   311\t        _log(f\"AGY_BRIDGE_IDLE_TIMEOUT={raw!r} invalid, using {_CORE_IDLE_TIMEOUT_S:g}s\")\n   312\t        return float(_CORE_IDLE_TIMEOUT_S)\n   313\t    return value\n   314\t\n   315\t\n   316\tdef _is_watchdog_enabled() -> bool:\n   317\t    \"\"\"Kill-switch адаптивного сторожа: BRIDGE_ENABLE_ADAPTIVE_WATCHDOG=0|false|no|off.\"\"\"\n   318\t    raw = os.environ.get(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", \"1\").strip().lower()\n   319\t    return raw not in (\"0\", \"false\", \"no\", \"off\")\n   320\t\n   321\t\n   322\tdef _mask_secrets(text: str) -> str:\n   323\t    \"\"\"Погасить токеноподобные последовательности и сам ключ моста.\"\"\"\n   324\t    out = str(text)\n   325\t    if AUTH_KEY:\n   326\t        out = out.replace(AUTH_KEY, \"***\")\n   327\t    return _SECRET.sub(\"***\", out)\n   328\t\n   329\t\n   330\tdef _err_summary(err: Any, limit: int = 200) -> str:\n   331\t    text = \" \".join(str(err or \"\").split())\n   332\t    return text[:limit]\n   333\t\n   334\t\n   335\t# Порог неактивности хода (без протокольных событий и без прироста CPU/потомков группы).\n   336\tIDLE_TIMEOUT_S = _idle_timeout_from_env()\n   337\t# Зачистка группы: сколько ждать после SIGTERM и сколько — reap лидера после SIGKILL.\n   338\tKILL_TERM_GRACE_S = 2.0\n   339\tKILL_WAIT_S = 5.0\n   340\t# События очереди, считающиеся активностью агента (result/done/pump_error — терминальные).\n   341\t_ACTIVITY_KINDS = frozenset({\"init\", \"text\", \"reasoning\", \"tool_trace\"})\n   342\t\n   343\t\n   344\tdef _launch_env() -> dict:\n   345\t    \"\"\"Окружение для `agy`. Ключ моста потомку не передаётся.\n   525\t            \"content\": [{\"type\": \"text\", \"text\": prompt}],\n   526\t        },\n   527\t    }\n   528\t    return json.dumps(payload, ensure_ascii=False) + \"\\n\"\n   529\t\n   530\t\n   531\tdef _group_alive(pgid: int) -> bool:\n   532\t    \"\"\"Есть ли в процессной группе хоть один процесс (`killpg(pgid, 0)`).\"\"\"\n   533\t    try:\n   534\t        os.killpg(pgid, 0)\n   535\t    except ProcessLookupError:\n   536\t        return False\n   537\t    except PermissionError:\n   538\t        return True\n   539\t    except OSError:\n   540\t        return False\n   541\t    return True\n   542\t\n   543\t\n   544\tdef _kill_group(proc: subprocess.Popen) -> None:\n   545\t    \"\"\"Зачистить процессную группу хода: SIGTERM -> ожидание -> SIGKILL -> reap лидера.\n   546\t\n   547\t    `proc.wait()` вызывается ВСЕГДА (в том числе когда группы уже нет), иначе\n   548\t    завершившийся лидер остаётся зомби (`Z`).\n   549\t    \"\"\"\n   550\t    pgid = proc.pid\n   551\t    try:\n   552\t        os.killpg(pgid, signal.SIGTERM)\n   553\t    except ProcessLookupError:\n   554\t        pass  # группы уже нет — остаётся только reap лидера\n   555\t    except (PermissionError, OSError):\n   556\t        try:\n   557\t            proc.terminate()\n   558\t        except OSError:\n   559\t            pass\n   560\t    else:\n   561\t        deadline = time.monotonic() + KILL_TERM_GRACE_S\n   562\t        while time.monotonic() < deadline:\n   563\t            if proc.poll() is not None and not _group_alive(pgid):\n   564\t                break\n   565\t            time.sleep(0.05)\n   566\t        if proc.poll() is None or _group_alive(pgid):\n   567\t            try:\n   568\t                os.killpg(pgid, signal.SIGKILL)\n   569\t            except ProcessLookupError:\n   570\t                pass\n   571\t            except (PermissionError, OSError):\n   572\t                try:\n   573\t                    proc.kill()\n   574\t                except OSError:\n   575\t                    pass\n   576\t    try:\n   577\t        proc.wait(timeout=KILL_WAIT_S)\n   578\t    except subprocess.TimeoutExpired:\n   579\t        _log(f\"kill_group_wait_timeout pid={pgid} after {KILL_WAIT_S:g}s\")\n   580\t\n   581\t\n   582\tdef _kill_all(*_: Any) -> None:\n   583\t    with _active_lock:\n   584\t        procs = list(_active.values())\n   585\t    for proc in procs:\n   586\t        try:\n   587\t            os.killpg(proc.pid, signal.SIGKILL)\n   588\t        except (ProcessLookupError, PermissionError):\n   589\t            pass\n   590\t    _log(f\"shutdown: killed {len(procs)} child process group(s)\")\n   591\t    os._exit(0)\n   592\t\n   593\t\n   594\tclass _TranscriptTail:\n   595\t    \"\"\"Мышление шагов agy из транскрипта разговора.\n   712\tclass Run:\n   713\t    \"\"\"Один процесс `agy`; поток-читатель превращает stdout NDJSON в события очереди.\n   714\t\n   715\t    Промпт подаётся на stdin одной NDJSON-строкой и поток закрывается (`communicate`\n   716\t    через отдельный поток-писатель): CLI читает stdin до EOF. `-p` не передаётся\n   717\t    никогда — см. модуль-docstring.\n   718\t    \"\"\"\n   719\t\n   720\t    def __init__(self, prompt: str, model: str, effort: str, effort_source: str,\n   721\t                 cwd: str, tag: str, conversation_id: str = \"\"):\n   722\t        launcher = _launcher()\n   723\t        WORKSPACE.mkdir(parents=True, exist_ok=True)\n   724\t        work_dir = cwd if (cwd and os.path.isdir(cwd)) else str(WORKSPACE)\n   725\t        self.work_dir = work_dir\n   726\t        self.stdin_line = _ndjson_user_line(prompt)\n   727\t        cmd = [\n   728\t            launcher,\n   729\t            \"--input-format\", \"stream-json\",\n   730\t            \"--output-format\", \"stream-json\",\n   731\t            \"--dangerously-skip-permissions\",\n   732\t            \"--model\", model,\n   733\t            \"--effort\", effort,\n   734\t            \"--print-timeout=\" + str(PRINT_TIMEOUT),\n   735\t        ]\n   736\t        # RESUME: продолжение треда — отдельным флагом, промпт всё равно через stdin.\n   737\t        self.run_cid = conversation_id or \"\"\n   738\t        if self.run_cid:\n   739\t            cmd += [\"--conversation\", self.run_cid]\n   740\t        self.proc = subprocess.Popen(\n   741\t            cmd, cwd=work_dir, stdin=subprocess.PIPE,\n   742\t            stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n   743\t            start_new_session=True, env=_launch_env(),\n   744\t        )\n   745\t        self.started = time.monotonic()\n   746\t        enabled = _is_watchdog_enabled()\n   747\t        # Kill-switch выключен: порог неактивности = сквозной таймаут, `ps` не вызывается.\n   748\t        self.controller = AdaptiveTimeoutController(\n   749\t            idle_timeout_s=IDLE_TIMEOUT_S if enabled else float(TIMEOUT_S),\n   750\t            safety_cap_s=float(TIMEOUT_S),  # дефолт core (3600 с) не используется\n   751\t            finish_reserve_s=0.0,           # эффективный потолок ровно TIMEOUT_S\n   752\t            watchdog_enabled=enabled,\n   753\t            log_fn=_log,\n   754\t        )\n   755\t        self.controller.register_pgid(self.proc.pid)\n   756\t        self.got_event = False  # True после первого валидного JSON-события stdout\n   757\t        self.stderr_head: list = []\n   758\t        with _active_lock:\n   759\t            _active[self.proc.pid] = self.proc\n   760\t        self.q = queue.Queue()\n   761\t        self.err_box = []\n   762\t        # Последний виденный текст agent_response по id шага: CLI присылает\n   763\t        # накопительный снимок, новым считается только хвост сверх него.\n   764\t        self._text_seen: dict = {}\n   765\t        # Мышление шагов: отдельный поток следит за транскриптом разговора и\n   766\t        # кладёт в очередь события (\"reasoning\", текст).\n   767\t        self._proc_done = threading.Event()\n   768\t        self._stop_watch = threading.Event()\n   769\t        self._tail = _TranscriptTail(\n   770\t            emit=lambda text: self.q.put((\"reasoning\", text)),\n   771\t            stop_event=self._stop_watch, done_event=self._proc_done,\n   772\t            resumed=bool(self.run_cid))\n   773\t        threading.Thread(target=self._feed_stdin, daemon=True).start()\n   774\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n   775\t        threading.Thread(target=self._pump, daemon=True).start()\n   776\t        self._tail.start()\n   777\t\n   778\t    def _feed_stdin(self) -> None:\n   779\t        \"\"\"Отдать промпт на stdin и закрыть поток: agy читает stdin до EOF.\"\"\"\n   780\t        try:\n   781\t            self.proc.stdin.write(self.stdin_line.encode(\"utf-8\"))\n   782\t            self.proc.stdin.flush()\n   783\t        except (BrokenPipeError, OSError, ValueError):\n   784\t            pass\n   785\t        finally:\n   786\t            try:\n   787\t                self.proc.stdin.close()\n   788\t            except (BrokenPipeError, OSError, ValueError):\n   789\t                pass\n   790\t            self.proc.stdin = None\n   791\t\n   792\t    def _drain_stderr(self) -> None:\n   793\t        \"\"\"Читать stderr построчно, держать только хвост: он идёт в error-ответ.\"\"\"\n   794\t        head: list = []\n   795\t        try:\n   796\t            for raw in iter(self.proc.stderr.readline, b\"\"):\n   797\t                line = raw.decode(\"utf-8\", \"replace\").rstrip()\n   798\t                if not line or _NOISE.search(line):\n   799\t                    continue\n   800\t                head.append(line)\n   801\t                if len(head) > 40:\n   802\t                    del head[0]\n   803\t        except Exception:  # noqa: BLE001 — вторичный поток, ошибку терять нельзя молча\n   804\t            pass\n   805\t        self.err_box.append(\"\\n\".join(head).strip())\n   806\t\n   807\t    def _pump(self) -> None:\n   808\t        \"\"\"Разбор NDJSON agy 1.3.1.\n   809\t\n   810\t        `step_update.agent_response` несёт накопительный `text_delta` — наружу\n   811\t        уходит только хвост. `step_update.tool` — трассировка нативного\n   812\t        инструмента (в stderr моста). `result` — финальный текст, usage, ошибка.\n   813\t        \"\"\"\n   814\t        final_text = \"\"\n   815\t        result_ev = {}\n   816\t        try:\n   817\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n   818\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n   819\t                if not line.startswith(\"{\"):\n   820\t                    continue\n   821\t                try:\n   822\t                    ev = json.loads(line)\n   823\t                except ValueError:\n   824\t                    continue\n   825\t                self.got_event = True\n   826\t                etype = ev.get(\"event\")\n   827\t                if etype == \"init\":\n   828\t                    init = ev.get(\"init\") if isinstance(ev.get(\"init\"), dict) else {}\n   829\t                    tools = init.get(\"tools\") if isinstance(init.get(\"tools\"), list) else []\n   830\t                    self.q.put((\"init\", {\n   831\t                        \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n   832\t                        \"tools\": len(tools),\n   833\t                        \"permission_mode\": init.get(\"permission_mode\") or \"\",\n   834\t                    }))\n   835\t                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n   836\t                elif etype == \"step_update\":\n   837\t                    step = ev.get(\"step_update\") if isinstance(ev.get(\"step_update\"), dict) else {}\n   838\t                    kind = step.get(\"step_type\")\n   839\t                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n   840\t                        suffix = _reasoning_suffix(\n   841\t                            self._text_seen, str(step.get(\"step_index\", \"\")), str(step[\"text_delta\"]))\n   842\t                        if suffix:\n   843\t                            self.q.put((\"text\", suffix))\n   844\t                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n   845\t                        self.q.put((\"tool_trace\", {\n   846\t                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n   847\t                            \"duration_s\": step.get(\"duration_seconds\"),\n   848\t                        }))\n   849\t                elif etype == \"result\":\n   850\t                    result = ev.get(\"result\") if isinstance(ev.get(\"result\"), dict) else {}\n   851\t                    result_ev = result\n   852\t                    final_text = str(result.get(\"response\") or \"\")\n   853\t                    self.q.put((\"result\", {\n   854\t                        \"conversation_id\": result.get(\"conversation_id\") or \"\",\n   855\t                        \"status\": str(result.get(\"status\") or \"\"),\n   856\t                        \"error\": str(result.get(\"error\") or \"\"),\n   857\t                        \"duration_s\": result.get(\"duration_seconds\"),\n   858\t                        \"num_turns\": result.get(\"num_turns\"),\n   859\t                        \"usage\": result.get(\"usage\") or {},\n   860\t                    }))\n   861\t            rc = self.proc.wait()\n   862\t        except Exception as exc:  # noqa: BLE001 — читатель не должен умирать молча\n   863\t            self._proc_done.set()\n   864\t            self.q.put((\"pump_error\", repr(exc)))\n   865\t            return\n   866\t        time.sleep(0.05)  # дать стоку stderr дозавершиться\n   867\t        self._proc_done.set()\n   868\t        self.q.put((\"done\", (rc, final_text, result_ev)))\n   869\t\n   870\t    def close(self) -> None:\n   871\t        self._stop_watch.set()\n   872\t        self._proc_done.set()\n   873\t        self.controller.close()\n   874\t        # Группа зачищается всегда: лидер мог выйти, оставив потомков (фоновые задачи agy).\n   875\t        _kill_group(self.proc)\n   876\t        with _active_lock:\n   877\t            _active.pop(self.proc.pid, None)\n   878\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   879\t            try:\n   880\t                if stream is not None:\n   881\t                    stream.close()\n   882\t            except OSError:\n   883\t                pass\n   884\t\n   885\t\n   981\t    def _execute(self, run: Run, on_text, on_tool_trace, on_reasoning,\n   982\t                 keepalive) -> dict:\n   983\t        \"\"\"Гнать ход до конца; сквозной таймаут TIMEOUT_S на весь ход.\n   984\t\n   985\t        Колбэки возвращают False, если клиент ушёл.\n   986\t        Превышение deadline -> kill группы (в run.close()), state=timeout.\n   987\t        \"\"\"\n   988\t        pieces = []\n   989\t        reasoning_pieces = []\n   990\t        usage = {}\n   991\t        result_ev = {}\n   992\t        conversation_id = \"\"\n   993\t        tool_events = 0\n   994\t        last_ka = time.monotonic()\n   995\t        last_wd_check = time.monotonic()\n   996\t        deadline = time.monotonic() + TIMEOUT_S\n   997\t        gone = [False]\n   998\t\n   999\t        def state(name: str, rc: int, err: str = \"\") -> dict:\n  1000\t            return {\"rc\": rc, \"text\": \"\".join(pieces),\n  1001\t                    \"reasoning\": \"\".join(reasoning_pieces), \"usage\": usage,\n  1002\t                    \"result\": result_ev, \"state\": name, \"err\": err,\n  1003\t                    \"conversation_id\": conversation_id,\n  1004\t                    \"duration_s\": result_ev.get(\"duration_s\"),\n  1005\t                    \"num_turns\": result_ev.get(\"num_turns\"),\n  1006\t                    \"tool_events\": tool_events, \"tool_calls\": []}\n  1007\t\n  1008\t        def add_content(text: str) -> None:\n  1009\t            if gone[0] or not text:\n  1010\t                return\n  1011\t            pieces.append(text)\n  1012\t            if not on_text(text):\n  1013\t                gone[0] = True\n  1014\t\n  1015\t        def add_reasoning(text: str) -> None:\n  1016\t            if gone[0] or not text:\n  1017\t                return\n  1018\t            ok = on_reasoning(text)\n  1019\t            reasoning_pieces.append(text)\n  1020\t            # Диагностический след эмита мышления: что хвост добыл и дошло ли до клиента.\n  1021\t            _log(f\"reasoning-emit cid={conversation_id[:8] or '-'} \"\n  1022\t                 f\"n={len(reasoning_pieces)} len={len(text)} ok={int(bool(ok))}\")\n  1023\t            if not ok:\n  1024\t                gone[0] = True\n  1025\t\n  1026\t        while True:\n  1027\t            if time.monotonic() > deadline:\n  1028\t                return state(\"timeout\", 124, f\"proxy timeout after {TIMEOUT_S}s\")\n  1029\t            if not run.got_event and time.monotonic() - run.started > FIRST_TOKEN_TIMEOUT_S:\n  1030\t                return state(\"first_token_timeout\", 124,\n  1031\t                             f\"no agy event within {FIRST_TOKEN_TIMEOUT_S:g}s\")\n  1032\t            if _client_gone(self.connection):\n  1033\t                return state(\"client_gone\", 1)\n  1034\t            try:\n  1035\t                kind, payload = run.q.get(timeout=1.0)\n  1036\t            except queue.Empty:\n  1037\t                # check() запускает `ps`: не чаще WATCHDOG_INTERVAL_S. Пока идут события,\n  1038\t                # on_activity() и так сбрасывает таймер, поэтому пропуск безопасен.\n  1039\t                now = time.monotonic()\n  1040\t                if now - last_wd_check >= WATCHDOG_INTERVAL_S:\n  1041\t                    last_wd_check = now\n  1042\t                    should_stop, wd_reason, _metrics = run.controller.check(run.proc.pid)\n  1043\t                    if should_stop and wd_reason == \"idle_timeout\":\n  1044\t                        _log(f\"watchdog idle_timeout pgid={run.proc.pid} \"\n  1045\t                             f\"idle>={IDLE_TIMEOUT_S:g}s\")\n  1046\t                        return state(\"idle_timeout\", 124,\n  1047\t                                     f\"proxy idle timeout after {IDLE_TIMEOUT_S:g}s \"\n  1048\t                                     \"(no activity in process group)\")\n  1049\t                    if should_stop and wd_reason == \"absolute_cap\":\n  1050\t                        return state(\"timeout\", 124, f\"proxy timeout after {TIMEOUT_S}s\")\n  1051\t                    # wd_reason == \"child_exited\": штатно, \"done\"/\"pump_error\" придут из очереди\n  1052\t                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n  1053\t                    last_ka = time.monotonic()\n  1054\t                    if not keepalive():\n  1055\t                        return state(\"client_gone\", 1)\n  1056\t                continue\n  1057\t            if kind in _ACTIVITY_KINDS:\n  1058\t                run.controller.on_activity(kind)\n  1059\t            if kind == \"init\":\n  1060\t                conversation_id = str(payload.get(\"conversation_id\") or \"\")\n  1061\t                _log(f\"init conversation={conversation_id[:8] or '-'} \"\n  1062\t                     f\"tools={payload.get('tools')} \"\n  1063\t                     f\"permission_mode={payload.get('permission_mode')}\")\n  1064\t            elif kind == \"reasoning\":\n  1065\t                add_reasoning(str(payload))\n  1066\t                if gone[0]:\n  1067\t                    return state(\"client_gone\", 1)\n  1068\t            elif kind == \"text\":\n  1069\t                add_content(str(payload))\n  1070\t                if gone[0]:\n  1071\t                    return state(\"client_gone\", 1)\n  1072\t            elif kind == \"tool_trace\":\n  1073\t                tool_events += 1\n  1074\t                if not on_tool_trace(payload):\n  1075\t                    gone[0] = True\n  1076\t                    return state(\"client_gone\", 1)\n  1077\t            elif kind == \"result\":\n  1078\t                result_ev = payload\n  1079\t                usage = payload.get(\"usage\") or {}\n  1080\t                conversation_id = str(payload.get(\"conversation_id\") or conversation_id)\n  1081\t                if str(payload.get(\"status\") or \"\").upper() == \"ERROR\":\n  1082\t                    message = str(payload.get(\"error\") or \"agy reported an error\")\n  1083\t                    if not message:\n  1084\t                        message = \"agy reported an error\"\n  1085\t                    return state(\"agy_error\", 1, message[:500])\n  1086\t            elif kind == \"pump_error\":\n  1087\t                return state(\"pump_error\", 1, str(payload))\n  1088\t            elif kind == \"done\":\n  1089\t                rc, final_text, raw_result = payload\n  1090\t                if not result_ev and raw_result:\n  1091\t                    result_ev = raw_result\n  1092\t                if not pieces and final_text:\n  1093\t                    add_content(final_text)\n  1094\t                if gone[0]:\n  1095\t                    return state(\"client_gone\", 1)\n  1096\t                time.sleep(0.05)\n  1097\t                err = \"\".join(run.err_box).strip()\n  1098\t                status = str(result_ev.get(\"status\") or \"\").upper()\n  1099\t                if rc != 0 and (status == \"ERROR\" or not pieces):\n  1100\t                    return state(\"agy_error\", rc, (str(result_ev.get(\"error\") or \"\") or err)[:500])\n  1101\t                return state(\"done\", rc, err)\n  1102\t\n  1103\t    def _run_once(self, ctx: dict, on_text, on_tool_trace, on_reasoning, keepalive) -> dict:\n  1160\t                    ctx[\"conversation_id\"] = \"\"\n  1161\t                    ctx[\"prompt\"] = ctx[\"full_prompt\"]\n  1162\t                    if out[\"state\"] == \"agy_error\" and not delivered:\n  1163\t                        _log(f\"hot session failed err={_err_summary(out.get('err'), 120)!r}, \"\n  1164\t                             f\"cold fallback {tag}\")\n  1165\t                        continue\n  1166\t                # Транзиентный сбой до выдачи текста клиенту — один невидимый повтор.\n  1167\t                transient = out[\"state\"] in (\"agy_error\", \"pump_error\", \"done\") and not delivered\n  1168\t                if not transient or attempt == 2:\n  1169\t                    break\n  1170\t                _log(f\"transient failure state={out['state']} rc={out.get('rc')} \"\n  1171\t                     f\"err={_err_summary(out.get('err'), 120)!r}, retry {attempt} {tag}\")\n  1172\t                time.sleep(2 * attempt)\n  1173\t            if (out.get(\"state\") == \"done\" and out.get(\"conversation_id\")\n  1174\t                    and ctx.get(\"sess_key\")):\n  1175\t                _session_commit(ctx[\"sess_key\"], str(out[\"conversation_id\"]))\n  1176\t            if out.get(\"state\") != \"client_gone\":\n  1177\t                _last_ok[0] = (time.monotonic()\n  1178\t                               if (out.get(\"state\") == \"done\" and out.get(\"rc\") == 0) else 0.0)\n  1179\t        finally:\n  1180\t            _slots.release()\n  1181\t        _log(f\"done model={model} rc={out.get('rc')} state={out.get('state')} \"\n  1182\t             f\"conversation={(out.get('conversation_id') or '-')[:8]} \"\n  1183\t             f\"turns={out.get('num_turns')} tool_events={out.get('tool_events')} \"\n  1184\t             f\"out_bytes={len((out.get('text') or '').encode())} \"\n  1185\t             f\"wall_s={time.monotonic() - t0:.1f} \"\n  1186\t             f\"err={_err_summary(out.get('err'))!r} {tag}\")\n  1187\t        return out\n  1188\t\n  1189\t    @staticmethod\n  1190\t    def _usage_payload(usage: dict) -> dict:\n  1191\t        \"\"\"usage agy -> OpenAI-поля. thinking_tokens прибавляем к completion.\"\"\"\n  1192\t        return {\n  1193\t            \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n  1194\t            \"completion_tokens\": usage.get(\"output_tokens\", 0) + usage.get(\"thinking_tokens\", 0),\n  1195\t            \"total_tokens\": usage.get(\"total_tokens\", 0),\n  1196\t        }\n  1197\t\n  1198\t    @staticmethod\n  1199\t    def _error_body(out: dict) -> Any:\n  1200\t        st = out.get(\"state\")\n  1201\t        if st == \"timeout\":\n  1202\t            return {\"message\": f\"agy timed out after {TIMEOUT_S}s\",\n  1203\t                    \"type\": \"timeout\", \"code\": 504}\n  1204\t        if st == \"idle_timeout\":\n  1205\t            return {\"message\": f\"agy execution idle timeout after {IDLE_TIMEOUT_S:g}s \"\n  1206\t                               \"(no activity or progress in process group)\",\n  1207\t                    \"type\": \"idle_timeout\", \"code\": 504}\n  1208\t        if st == \"first_token_timeout\":\n  1209\t            return {\"message\": f\"first_token_timeout: agy gave no event within \"\n  1210\t                               f\"{FIRST_TOKEN_TIMEOUT_S:g}s\",\n  1211\t                    \"type\": \"first_token_timeout\", \"code\": 504}\n  1212\t        if st == \"queue_timeout\":\n  1213\t            return {\"message\": f\"bridge busy: queue full over {QUEUE_TIMEOUT_S}s\",\n  1214\t                    \"type\": \"overloaded\", \"code\": 503}\n  1215\t        if st == \"launcher_unavailable\":\n  1216\t            return {\"message\": \"canonical launcher is missing or not executable\",\n  1217\t                    \"type\": \"launcher_unavailable\", \"code\": 503}\n  1218\t        if st == \"client_gone\":\n  1219\t            return {\"message\": \"client gone\", \"type\": \"client_gone\", \"code\": 499}\n  1220\t        if st == \"pump_error\":\n  1221\t            return {\"message\": \"bridge reader failed\", \"detail\": str(out.get(\"err\"))[:500],\n  1222\t                    \"type\": \"proxy_error\", \"code\": 502}\n  1223\t        if st == \"agy_error\":\n  1224\t            return {\"message\": str(out.get(\"err\") or \"agy reported an error\")[:500],\n  1225\t                    \"type\": \"agy_error\", \"code\": 502}\n  1226\t        if out.get(\"rc\") != 0 or not out.get(\"text\"):\n  1227\t            return {\"message\": f\"agy exited rc={out.get('rc')}\",\n  1228\t                    \"detail\": str(out.get(\"err\"))[:500], \"type\": \"proxy_error\", \"code\": 502}\n  1229\t        return None\n  1230\t\n  1231\t    # ---- HTTP --------------------------------------------------------------------\n  1232\t    def do_GET(self) -> None:  # noqa: N802\n#!/usr/bin/env bash\n# Запуск моста agy-bridge (DSH → Antigravity CLI `agy`).\n# Ключ читается из окружения или ~/.dsh/.env; значение не печатается и не логируется.\n# Транспорт — канонический лончер ~/.config/agy-launch/agy-cli.sh (egress-пиннинг\n# Амстердам :10815, резерв hy2 :10811; прямой вызов запрещён — гео РФ).\nset -euo pipefail\nROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}\"\nexport AGY_BRIDGE_HOST=\"${AGY_BRIDGE_HOST:-127.0.0.1}\"\nexport AGY_BRIDGE_PORT=\"${AGY_BRIDGE_PORT:-9887}\"\nif [[ -z \"${AGY_BRIDGE_KEY:-}\" && -f \"$HOME/.dsh/.env\" ]]; then\n  _k=\"$(grep -E '^AGY_BRIDGE_KEY=' \"$HOME/.dsh/.env\" | cut -d= -f2- || true)\"\n  [[ -n \"$_k\" ]] && export AGY_BRIDGE_KEY=\"$_k\"\nfi\n: \"${AGY_BRIDGE_KEY:?AGY_BRIDGE_KEY is required}\"\nunset _k 2>/dev/null || true\n# core.watchdog живёт в корне репозитория cli-agent-bridge: при симлинке деплоя server.py\n# находит его сам (parents[2]); PYTHONPATH — страховка на случай копии вместо симлинка.\nREPO_ROOT=\"${CLI_AGENT_BRIDGE_ROOT:-$HOME/work/src/cli-agent-bridge}\"\nexport PYTHONPATH=\"$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}\"\nmkdir -p \"$ROOT/logs\" \"$ROOT/workspace\"\ncd \"$ROOT\"\nexec /usr/bin/python3 server.py\ndiff --git a/.gitignore b/.gitignore\nindex 818515c..4f392eb 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -3,3 +3,4 @@ workspace/\n __pycache__/\n .pytest_cache/\n *.pyc\n+backups/\ndiff --git a/core/lifecycle.py b/core/lifecycle.py\nindex b27672e..245f220 100644\n--- a/core/lifecycle.py\n+++ b/core/lifecycle.py\n@@ -44,6 +44,8 @@ KNOWN_CHILD_BINARIES = frozenset(\n         \"muse\",\n         \"muse-cli\",\n         \"muse-cli.sh\",\n+        \"agy\",\n+        \"agy-cli.sh\",\n         \"droid\",\n         \"fake_droid\",\n         \"fake_serve\",\n","exit_code":0,"status":"completed"}}
