аймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n     2\t\n     3\tМодуль реализует двухконтурный контроль времени хода исключительно средствами\n     4\tстандартной библиотеки Python на macOS (Darwin):\n     5\t1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n     6\t   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n     7\t   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n     8\t   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n     9\t   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n    10\t2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n    11\t   абсолютный потолок длительности хода независимо от активности.\n    12\t\n    13\tПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\n    14\tфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n    15\t\"\"\"\n    16\t\n    17\tfrom __future__ import annotations\n    18\t\n    19\tfrom collections.abc import Callable\n    20\tfrom dataclasses import dataclass\n    21\timport os\n    22\timport re\n    23\timport subprocess\n    24\timport threading\n    25\timport time\n    26\t\n    27\tIDLE_TIMEOUT_S: float = 300.0\n    28\tSAFETY_CAP_S: float = 3600.0\n    29\tFINISH_RESERVE_S: float = 35.0\n    30\tWATCHDOG_INTERVAL_S: float = 5.0\n    31\tPS_TIMEOUT_S: float = 2.0\n    32\t\n    33\tDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\n    34\tDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\n    35\tDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n    36\t\n    37\t\n    38\t_PS_LINE_RE = re.compile(\n    39\t    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n    40\t)\n    41\t\n    42\t\n    43\tdef parse_cputime(raw: str) -> float:\n    44\t    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    45\t    token = (raw or \"\").strip()\n    46\t    if not token:\n    47\t        return 0.0\n    48\t    days = 0\n    49\t    if \"-\" in token:\n    50\t        day_part, token = token.split(\"-\", 1)\n    51\t        try:\n    52\t            days = int(day_part)\n    53\t        except ValueError:\n    54\t            return 0.0\n    55\t    parts = token.split(\":\")\n    56\t    try:\n    57\t        if len(parts) == 3:\n    58\t            hours = int(parts[0])\n    59\t            minutes = int(parts[1])\n    60\t            seconds = float(parts[2])\n    61\t        elif len(parts) == 2:\n    62\t            hours = 0\n    63\t            minutes = int(parts[0])\n    64\t            seconds = float(parts[1])\n    65\t        elif len(parts) == 1:\n    66\t            hours = 0\n    67\t            minutes = 0\n    68\t            seconds = float(parts[0])\n    69\t        else:\n    70\t            return 0.0\n    71\t    except ValueError:\n    72\t        return 0.0\n    73\t    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n    74\t    return max(0.0, float(total))\n    75\t\n    76\t\n    77\t@dataclass(frozen=True)\n    78\tclass WatchdogMetrics:\n    79\t    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n    80\t\n    81\t    pgid: int\n    82\t    alive: bool\n    83\t    descendant_pids: tuple[int, ...]\n    84\t    new_descendants: tuple[int, ...]\n    85\t    cpu_time_s: float\n    86\t    cpu_delta_s: float\n    87\t    ps_degraded: bool = False\n    88\t    sample_ts: float = 0.0\n    89\t\n    90\t    @property\n    91\t    def has_progress(self) -> bool:\n    92\t        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n    93\t        if self.ps_degraded or not self.alive:\n    94\t            return False\n    95\t        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n    96\t\n    97\t    has_activity = has_progress\n    98\t\n    99\t\n   100\tclass ProcessWatchdog:\n   101\t    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n   102\t\n   103\t    def __init__(\n   104\t        self,\n   105\t        ps_timeout_s: float = PS_TIMEOUT_S,\n   106\t        log_fn: Callable[[str], None] | None = None,\n   107\t        rid: str = \"\",\n   108\t        turn_id: str = \"\",\n   109\t    ) -> None:\n   110\t        self.ps_timeout_s = float(ps_timeout_s)\n   280\t                pgid=pgid,\n   281\t                alive=False,\n   282\t                descendant_pids=(),\n   283\t                new_descendants=(),\n   284\t                cpu_time_s=0.0,\n   285\t                cpu_delta_s=0.0,\n   286\t                ps_degraded=False,\n   287\t                sample_ts=now,\n   288\t            )\n   289\t\n   290\t        with self._lock:\n   291\t            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n   292\t            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n   293\t            if _seed_only:\n   294\t                for pid, val in cpu_s.items():\n   295\t                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n   296\t                seen_desc.update(descendants)\n   297\t                self._seeded_pgids.add(pgid)\n   298\t                total_cpu = sum(cpu_s.values())\n   299\t                return WatchdogMetrics(\n   300\t                    pgid=pgid,\n   301\t                    alive=True,\n   302\t                    descendant_pids=tuple(descendants),\n   303\t                    new_descendants=(),\n   304\t                    cpu_time_s=total_cpu,\n   305\t                    cpu_delta_s=0.0,\n   306\t                    ps_degraded=False,\n   307\t                    sample_ts=now,\n   308\t                )\n   309\t\n   310\t            cpu_delta = sum(\n   311\t                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n   312\t            )\n   313\t            new_desc = tuple(sorted(set(descendants) - seen_desc))\n   314\t            for pid, val in cpu_s.items():\n   315\t                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n   316\t            seen_desc.update(descendants)\n   317\t            self._seeded_pgids.add(pgid)\n   318\t            total_cpu = sum(cpu_s.values())\n   319\t\n   320\t        return WatchdogMetrics(\n   321\t            pgid=pgid,\n   322\t            alive=True,\n   323\t            descendant_pids=tuple(descendants),\n   324\t            new_descendants=new_desc,\n   325\t            cpu_time_s=total_cpu,\n   326\t            cpu_delta_s=cpu_delta,\n   327\t            ps_degraded=False,\n   328\t            sample_ts=now,\n   329\t        )\n   330\t\n   331\t\n   332\tclass AdaptiveTimeoutController:\n   333\t    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n   334\t\n   335\t    def __init__(\n   336\t        self,\n   337\t        idle_timeout_s: float = IDLE_TIMEOUT_S,\n   338\t        safety_cap_s: float = SAFETY_CAP_S,\n   339\t        finish_reserve_s: float = FINISH_RESERVE_S,\n   340\t        watchdog: ProcessWatchdog | None = None,\n   341\t        watchdog_enabled: bool = True,\n   342\t        clock: Callable[[], float] = time.monotonic,\n   343\t        rid: str = \"\",\n   344\t        turn_id: str = \"\",\n   345\t        log_fn: Callable[[str], None] | None = None,\n   346\t    ) -> None:\n   347\t        self.idle_timeout_s = float(idle_timeout_s)\n   348\t        self.safety_cap_s = float(safety_cap_s)\n   349\t        self.finish_reserve_s = float(finish_reserve_s)\n   350\t        self.watchdog_enabled = bool(watchdog_enabled)\n   351\t        self._clock = clock\n   352\t        self.rid = rid\n   353\t        self.turn_id = turn_id\n   354\t        self._log_fn = log_fn\n   355\t        self.watchdog = watchdog or ProcessWatchdog(\n   356\t            log_fn=log_fn, rid=rid, turn_id=turn_id\n   357\t        )\n   358\t        self._lock = threading.Lock()\n   359\t        now = self._clock()\n   360\t        self.started_at: float = now\n   361\t        self.last_activity_ts: float = now\n   362\t        self.last_activity_kind: str = \"start\"\n   363\t        self.pgid: int | None = None\n   364\t        self.terminated_reason: str = \"\"\n   365\t\n   366\t    def effective_cap_s(self) -> float:\n   367\t        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n   368\t        if self.safety_cap_s > self.finish_reserve_s:\n   369\t            return self.safety_cap_s - self.finish_reserve_s\n   370\t        return max(0.01, self.safety_cap_s)\n   371\t\n   372\t    def record_activity(self, kind: str = \"protocol\") -> None:\n   373\t        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n   374\t        now = self._clock()\n   375\t        with self._lock:\n   376\t            self.last_activity_ts = now\n   377\t            self.last_activity_kind = kind or \"protocol\"\n   378\t\n   379\t    def on_activity(self, kind: str = \"protocol\") -> None:\n   380\t        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n   381\t        self.record_activity(kind)\n   382\t\n   383\t    def register_pgid(self, pgid: int) -> None:\n   384\t        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n   385\t        if not isinstance(pgid, int) or pgid <= 0:\n   386\t            return\n   387\t        with self._lock:\n   388\t            self.pgid = pgid\n   389\t        if self.watchdog_enabled and self.watchdog is not None:\n   390\t            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n   391\t\n   392\t    def check(\n   393\t        self, pgid: int | None = None\n   394\t    ) -> tuple[bool, str, WatchdogMetrics | None]:\n   395\t        \"\"\"Проверяет условия завершения хода.\n   396\t\n   397\t        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n   398\t        `should_stop == True` принимает одно из значений:\n   399\t        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n   400\t        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n   401\t        - `\"child_exited\"` — процессная группа завершилась.\n   402\t        \"\"\"\n   403\t        with self._lock:\n   404\t            target_pgid = pgid if pgid is not None else self.pgid\n   405\t            started_at = self.started_at\n   406\t\n   407\t        now = self._clock()\n   408\t        if now - started_at >= self.effective_cap_s():\n   409\t            with self._lock:\n   410\t                self.terminated_reason = \"absolute_cap\"\n   411\t            return True, \"absolute_cap\", None\n   412\t\n   413\t        metrics: WatchdogMetrics | None = None\n   414\t        if (\n   415\t            self.watchdog_enabled\n   416\t            and self.watchdog is not None\n   417\t            and isinstance(target_pgid, int)\n   418\t            and target_pgid > 0\n   419\t        ):\n   420\t            metrics = self.watchdog.sample(\n   421\t                target_pgid, rid=self.rid, turn_id=self.turn_id\n   422\t            )\n   423\t            if not metrics.alive:\n   424\t                with self._lock:\n   425\t                    self.terminated_reason = \"child_exited\"\n   426\t                return True, \"child_exited\", metrics\n   427\t            if metrics.has_progress:\n   428\t                with self._lock:\n   429\t                    self.last_activity_ts = now\n   430\t                    self.last_activity_kind = (\n   431\t                        \"new_descendants\"\n   432\t                        if metrics.new_descendants\n   433\t                        else \"cpu_delta\"\n   434\t                    )\n   435\t\n   436\t        with self._lock:\n   437\t            idle_elapsed = now - self.last_activity_ts\n   438\t            if idle_elapsed >= self.idle_timeout_s:\n   439\t                self.terminated_reason = \"idle_timeout\"\n   440\t                return True, \"idle_timeout\", metrics\n   441\t\n   442\t        return False, \"\", metrics\n   443\t\n   444\t    def close(self) -> None:\n   445\t        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n   446\t        with self._lock:\n   447\t            pgid = self.pgid\n   448\t        if pgid is not None and self.watchdog is not None:\n   449\t            self.watchdog.forget(pgid)\n   849\t                elif etype == \"result\":\n   850\t                    result = ev.get(\"result\") if isinstance(ev.get(\"result\"), dict) else {}\n   851\t                    result_ev = result\n   852\t                    final_text = str(result.get(\"response\") or \"\")\n   853\t                    self.q.put((\"result\", {\n   854\t                        \"conversation_id\": result.get(\"conversation_id\") or \"\",\n   855\t                        \"status\": str(result.get(\"status\") or \"\"),\n   856\t                        \"error\": str(result.get(\"error\") or \"\"),\n   857\t                        \"duration_s\": result.get(\"duration_seconds\"),\n   858\t                        \"num_turns\": result.get(\"num_turns\"),\n   859\t                        \"usage\": result.get(\"usage\") or {},\n   860\t                    }))\n   861\t            rc = self.proc.wait()\n   862\t        except Exception as exc:  # noqa: BLE001 — читатель не должен умирать молча\n   863\t            self._proc_done.set()\n   864\t            self.q.put((\"pump_error\", repr(exc)))\n   865\t            return\n   866\t        time.sleep(0.05)  # дать стоку stderr дозавершиться\n   867\t        self._proc_done.set()\n   868\t        self.q.put((\"done\", (rc, final_text, result_ev)))\n   869\t\n   870\t    def close(self) -> None:\n   871\t        self._stop_watch.set()\n   872\t        self._proc_done.set()\n   873\t        self.controller.close()\n   874\t        # Группа зачищается всегда: лидер мог выйти, оставив потомков (фоновые задачи agy).\n   875\t        _kill_group(self.proc)\n   876\t        with _active_lock:\n   877\t            _active.pop(self.proc.pid, None)\n   878\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   879\t            try:\n   880\t                if stream is not None:\n   881\t                    stream.close()\n   882\t            except OSError:\n   883\t                pass\n   884\t\n   885\t\n  1103\t    def _run_once(self, ctx: dict, on_text, on_tool_trace, on_reasoning, keepalive) -> dict:\n  1104\t        model = ctx[\"model\"]\n  1105\t        effort = ctx[\"effort\"]\n  1106\t        tag = ctx[\"tag\"]\n  1107\t        reason = self._acquire_slot(keepalive)\n  1108\t        if reason:\n  1109\t            _log(f\"no slot ({reason}) model={model} {tag}\")\n  1110\t            if reason == \"queue_timeout\":\n  1111\t                self._log_reject(\"overloaded\", model, ctx[\"model_len\"])\n  1112\t            return {\"state\": reason, \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n  1113\t                    \"err\": \"\", \"tool_calls\": [], \"tool_events\": 0,\n  1114\t                    \"conversation_id\": \"\", \"num_turns\": None, \"duration_s\": None}\n  1115\t        t0 = time.monotonic()\n  1116\t        out: dict = {}\n  1117\t        try:\n  1118\t            try:\n  1119\t                _launcher()\n  1120\t            except LauncherUnavailable:\n  1121\t                self._log_reject(\"launcher_unavailable\", model, ctx[\"model_len\"])\n  1122\t                return {\"state\": \"launcher_unavailable\", \"rc\": 1, \"text\": \"\",\n  1123\t                        \"usage\": {}, \"result\": {}, \"err\": \"\", \"tool_calls\": [],\n  1124\t                        \"tool_events\": 0, \"conversation_id\": \"\", \"num_turns\": None,\n  1125\t                        \"duration_s\": None}\n  1126\t            for attempt in (1, 2):\n  1127\t                _log(f\"exec model={model} effort={effort} effort_source={ctx['effort_source']} \"\n  1128\t                     f\"prompt_bytes={len(ctx['prompt'].encode())} \"\n  1129\t                     f\"tools={ctx['tools_count']} resume={1 if ctx.get('conversation_id') else 0} {tag}\")\n  1130\t                try:\n  1131\t                    run = Run(ctx[\"prompt\"], model, effort, ctx[\"effort_source\"],\n  1132\t                              ctx[\"cwd\"], tag, conversation_id=ctx.get(\"conversation_id\") or \"\")\n  1133\t                except LauncherUnavailable:\n  1134\t                    self._reject(503, \"launcher_unavailable\",\n  1135\t                                 \"canonical launcher is missing or not executable\",\n  1136\t                                 model=model, model_len=ctx[\"model_len\"])\n  1137\t                    out = {\"state\": \"launcher_unavailable\", \"rc\": 1, \"text\": \"\",\n  1138\t                           \"usage\": {}, \"result\": {}, \"err\": \"\", \"tool_calls\": [],\n  1139\t                           \"tool_events\": 0, \"conversation_id\": \"\", \"num_turns\": None,\n  1140\t                           \"duration_s\": None}\n  1141\t                    break\n  1142\t                except OSError as exc:\n  1143\t                    out = {\"state\": \"pump_error\", \"rc\": 1, \"text\": \"\", \"usage\": {},\n  1144\t                           \"result\": {}, \"err\": repr(exc), \"tool_calls\": [],\n  1145\t                           \"tool_events\": 0, \"conversation_id\": \"\", \"num_turns\": None,\n  1146\t                           \"duration_s\": None}\n  1147\t                    break\n  1148\t                try:\n  1149\t                    out = self._execute(run, on_text, on_tool_trace, on_reasoning, keepalive)\n  1150\t                finally:\n  1151\t                    run.close()\n  1152\t                if out[\"state\"] == \"done\":\n  1153\t                    break\n  1154\t                delivered = bool(out.get(\"text\") or out.get(\"tool_calls\"))\n  1155\t                if ctx.get(\"hot_resumed\") and out[\"state\"] != \"client_gone\":\n  1156\t                    # Горячая сессия сломалась: больше её не используем, а повтор\n  1157\t                    # идёт холодным вызовом с полной историей.\n  1158\t                    _session_invalidate(ctx[\"sess_key\"], ctx[\"conversation_id\"])\n  1159\t                    ctx[\"hot_resumed\"] = False\n  1160\t                    ctx[\"conversation_id\"] = \"\"\n  1161\t                    ctx[\"prompt\"] = ctx[\"full_prompt\"]\n\"\"\"Тесты отказоустойчивости agy-bridge (ADR-0007, arch-spec r2 §6, RW-008).\n\nПокрыто 15 сценариев: детекция неактивности группы, сброс таймера по CPU и по\nпротокольным событиям, fail-closed при деградации `ps`, троттлинг `check()` в\n`_execute`, `child_exited` как штатное завершение, `absolute_cap` -> `timeout`,\nkill-switch, контракт ошибки `idle_timeout` (HTTP 504 / SSE), зачистка группы\nпроцессов и reap лидера, изоляция таймаута источника в `fetch_via_playwright.py`.\n\nМост `bridges/agy-bridge/server.py` лежит в каталоге с дефисом, поэтому грузится\nчерез `importlib`. Таймауты малые (`idle_timeout_s=0.2`) либо мок-часы; процессы\nсоздаются с `start_new_session=True` и убираются в `finally`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport importlib.util\nimport json\nimport os\nimport queue\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any\nfrom unittest import mock\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\nfrom core.watchdog import (  # noqa: E402\n    AdaptiveTimeoutController,\n    ProcessWatchdog,\n    WatchdogMetrics,\n)\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n_FETCH_SCRIPT = Path(\n    os.environ.get(\"AIBUNKER_FETCH_SCRIPT\")\n    or \"~/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py\"\n).expanduser()\n\n_POSIX = sys.platform != \"win32\"\n_DARWIN = sys.platform == \"darwin\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-agy-resilience\")\n    os.environ.pop(\"AGY_BRIDGE_FLEET\", None)\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass _FakeClock:\n    \"\"\"Ручные часы: время движется только через advance().\"\"\"\n\n    def __init__(self, now: float = 1000.0) -> None:\n        self.now = now\n\n    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass _TickQueue:\n    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n\n    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n        self.clock = clock\n        self.empty_ticks = empty_ticks\n        self.events = list(events)\n\n    def get(self, timeout: float = 0.0) -> Any:\n        if self.empty_ticks > 0:\n            self.empty_ticks -= 1\n            self.clock.advance(float(timeout))\n            raise queue.Empty\n        if self.events:\n            return self.events.pop(0)\n        self.clock.advance(float(timeout))\n        raise queue.Empty\n\n\nclass _SpyController:\n    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n\n    def __init__(\n        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n    ) -> None:\n        self.inner = inner\n        self.forced = forced\n        self.check_calls = 0\n        self.activity: list[str] = []\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n        self.inner.on_activity(kind)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.check_calls += 1\n        if self.forced is not None:\n            return self.forced\n        return self.inner.check(pgid)\n\n\ndef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n\n\ndef _hard_kill(proc: subprocess.Popen) -> None:\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        pass\n    try:\n        proc.wait(timeout=5)\n    except (subprocess.TimeoutExpired, OSError):\n        pass\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_agy_bridge_resilience.py | sed -n '136,380p'; nl -ba core/watchdog.py | sed -n '119,280p;379,392p'; nl -ba bridges/agy-bridge/server.py | sed -n '65,112p;1438,1504p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_agy_bridge_resilience.py | sed -n '136,380p'; nl -ba core/watchdog.py | sed -n '119,280p;379,392p'; nl -ba bridges/agy-bridge/server.py | sed -n '65,112p;1438,1504p'\"","aggregated_output":"   136\t\n   137\t\n   138\tdef _ps_stat(pid: int) -> str:\n   139\t    out = subprocess.run(\n   140\t        [\"ps\", \"-o\", \"stat=\", \"-p\", str(pid)],\n   141\t        capture_output=True,\n   142\t        text=True,\n   143\t        check=False,\n   144\t    )\n   145\t    return out.stdout.strip()\n   146\t\n   147\t\n   148\tdef _group_gone(pgid: int, within_s: float = 2.0) -> bool:\n   149\t    deadline = time.monotonic() + within_s\n   150\t    while time.monotonic() < deadline:\n   151\t        try:\n   152\t            os.killpg(pgid, 0)\n   153\t        except ProcessLookupError:\n   154\t            return True\n   155\t        except PermissionError:\n   156\t            pass\n   157\t        time.sleep(0.05)\n   158\t    return False\n   159\t\n   160\t\n   161\tclass _Sock:\n   162\t    \"\"\"Пара сокетов для Handler.connection: пир открыт, данных нет -> клиент «на месте».\"\"\"\n   163\t\n   164\t    def __enter__(self) -> socket.socket:\n   165\t        self.a, self.b = socket.socketpair()\n   166\t        return self.a\n   167\t\n   168\t    def __exit__(self, *_exc: Any) -> None:\n   169\t        self.a.close()\n   170\t        self.b.close()\n   171\t\n   172\t\n   173\tdef _make_handler(connection: socket.socket) -> Any:\n   174\t    handler = srv.Handler.__new__(srv.Handler)\n   175\t    handler.connection = connection\n   176\t    return handler\n   177\t\n   178\t\n   179\tdef _fake_run(\n   180\t    clock: _FakeClock, controller: Any, events: list, empty_ticks: int\n   181\t) -> SimpleNamespace:\n   182\t    return SimpleNamespace(\n   183\t        q=_TickQueue(clock, empty_ticks, events),\n   184\t        controller=controller,\n   185\t        proc=SimpleNamespace(pid=424242),\n   186\t        got_event=True,\n   187\t        started=clock(),\n   188\t        err_box=[],\n   189\t    )\n   190\t\n   191\t\n   192\tdef _fake_time(clock: _FakeClock) -> SimpleNamespace:\n   193\t    return SimpleNamespace(\n   194\t        monotonic=clock, sleep=lambda _s: None, strftime=time.strftime, time=time.time\n   195\t    )\n   196\t\n   197\t\n   198\tdef _execute_with_clock(clock: _FakeClock, run: SimpleNamespace) -> dict:\n   199\t    \"\"\"Прогнать Handler._execute на мок-часах без реальных ожиданий.\"\"\"\n   200\t    with _Sock() as sock, mock.patch.object(srv, \"time\", _fake_time(clock)):\n   201\t        handler = _make_handler(sock)\n   202\t        return handler._execute(\n   203\t            run, lambda _t: True, lambda _e: True, lambda _r: True, None\n   204\t        )\n   205\t\n   206\t\n   207\tclass IdleDetectionTests(unittest.TestCase):\n   208\t    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n   209\t    def test_idle_timeout_detected_for_sleeping_process(self) -> None:\n   210\t        proc = _spawn([\"sleep\", \"100\"])\n   211\t        try:\n   212\t            ctrl = AdaptiveTimeoutController(\n   213\t                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n   214\t            )\n   215\t            ctrl.register_pgid(proc.pid)\n   216\t            result: tuple = (False, \"\", None)\n   217\t            deadline = time.monotonic() + 2.0\n   218\t            while time.monotonic() < deadline:\n   219\t                result = ctrl.check(proc.pid)\n   220\t                if result[0]:\n   221\t                    break\n   222\t                time.sleep(0.05)\n   223\t            self.assertTrue(result[0])\n   224\t            self.assertEqual(result[1], \"idle_timeout\")\n   225\t            ctrl.close()\n   226\t        finally:\n   227\t            _hard_kill(proc)\n   228\t\n   229\t    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n   230\t    def test_cpu_delta_resets_idle_timer(self) -> None:\n   231\t        proc = _spawn([sys.executable, \"-I\", \"-c\", \"while True: pass\"])\n   232\t        try:\n   233\t            ctrl = AdaptiveTimeoutController(\n   234\t                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n   235\t            )\n   236\t            ctrl.register_pgid(proc.pid)\n   237\t            end = time.monotonic() + 0.9  # заметно больше idle_timeout_s\n   238\t            while time.monotonic() < end:\n   239\t                should_stop, reason, _m = ctrl.check(proc.pid)\n   240\t                self.assertFalse(should_stop, f\"ложный {reason}: CPU растёт\")\n   241\t                time.sleep(0.05)\n   242\t            self.assertEqual(ctrl.last_activity_kind, \"cpu_delta\")\n   243\t            ctrl.close()\n   244\t        finally:\n   245\t            _hard_kill(proc)\n   246\t\n   247\t    def test_on_activity_resets_idle_timer(self) -> None:\n   248\t        for kind in (\"text\", \"reasoning\", \"tool_trace\", \"init\"):\n   249\t            with self.subTest(kind=kind):\n   250\t                clock = _FakeClock()\n   251\t                ctrl = AdaptiveTimeoutController(\n   252\t                    idle_timeout_s=0.2,\n   253\t                    safety_cap_s=60.0,\n   254\t                    finish_reserve_s=0.0,\n   255\t                    watchdog_enabled=False,\n   256\t                    clock=clock,\n   257\t                )\n   258\t                for _ in range(5):\n   259\t                    clock.advance(0.15)\n   260\t                    ctrl.on_activity(kind)\n   261\t                    self.assertEqual(ctrl.check(), (False, \"\", None))\n   262\t                self.assertEqual(ctrl.last_activity_kind, kind)\n   263\t                clock.advance(0.25)\n   264\t                should_stop, reason, _m = ctrl.check()\n   265\t                self.assertTrue(should_stop)\n   266\t                self.assertEqual(reason, \"idle_timeout\")\n   267\t\n   268\t    @unittest.skipUnless(_POSIX, \"нужны процессные группы POSIX\")\n   269\t    def test_ps_degraded_fail_closed(self) -> None:\n   270\t        class _DegradedPs(ProcessWatchdog):\n   271\t            def _run_ps(self, pgid: int) -> Any:\n   272\t                raise subprocess.TimeoutExpired(cmd=\"ps\", timeout=2.0)\n   273\t\n   274\t        logs: list[str] = []\n   275\t        proc = _spawn([\"sleep\", \"100\"])\n   276\t        try:\n   277\t            clock = _FakeClock()\n   278\t            ctrl = AdaptiveTimeoutController(\n   279\t                idle_timeout_s=0.2,\n   280\t                safety_cap_s=60.0,\n   281\t                finish_reserve_s=0.0,\n   282\t                watchdog=_DegradedPs(log_fn=logs.append),\n   283\t                clock=clock,\n   284\t                log_fn=logs.append,\n   285\t            )\n   286\t            ctrl.register_pgid(proc.pid)\n   287\t            self.assertEqual(ctrl.check(proc.pid)[:2], (False, \"\"))\n   288\t            marker = ctrl.last_activity_ts\n   289\t            clock.advance(0.25)\n   290\t            should_stop, reason, metrics = ctrl.check(proc.pid)\n   291\t            self.assertTrue(should_stop)\n   292\t            self.assertEqual(reason, \"idle_timeout\")\n   293\t            self.assertTrue(metrics is not None and metrics.ps_degraded)\n   294\t            self.assertEqual(\n   295\t                ctrl.last_activity_ts, marker, \"fail-closed: таймер не сбрасывается\"\n   296\t            )\n   297\t            self.assertTrue(any(\"watchdog_ps_degraded\" in line for line in logs), logs)\n   298\t        finally:\n   299\t            _hard_kill(proc)\n   300\t\n   301\t    def test_ps_degraded_stub_metrics_never_count_as_progress(self) -> None:\n   302\t        degraded = WatchdogMetrics(\n   303\t            pgid=1,\n   304\t            alive=True,\n   305\t            descendant_pids=(),\n   306\t            new_descendants=(),\n   307\t            cpu_time_s=9.0,\n   308\t            cpu_delta_s=5.0,\n   309\t            ps_degraded=True,\n   310\t        )\n   311\t        self.assertFalse(degraded.has_progress)\n   312\t\n   313\t\n   314\tclass ExecuteLoopTests(unittest.TestCase):\n   315\t    def _controller(\n   316\t        self, clock: _FakeClock, **kwargs: Any\n   317\t    ) -> AdaptiveTimeoutController:\n   318\t        params: dict[str, Any] = dict(\n   319\t            idle_timeout_s=1000.0,\n   320\t            safety_cap_s=1800.0,\n   321\t            finish_reserve_s=0.0,\n   322\t            watchdog_enabled=False,\n   323\t            clock=clock,\n   324\t        )\n   325\t        params.update(kwargs)\n   326\t        return AdaptiveTimeoutController(**params)\n   327\t\n   328\t    def test_check_throttled_in_execute(self) -> None:\n   329\t        # (а) 100 событий за 1 с реального времени: check() не вызывается чаще 1 раза.\n   330\t        clock = _FakeClock()\n   331\t        spy = _SpyController(self._controller(clock))\n   332\t        events = [(\"text\", \"x\")] * 100 + [(\"done\", (0, \"\", {}))]\n   333\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n   334\t        self.assertEqual(out[\"state\"], \"done\")\n   335\t        self.assertLessEqual(spy.check_calls, 1)\n   336\t        self.assertEqual(spy.activity, [\"text\"] * 100)\n   337\t\n   338\t        # (б) пустая очередь 12 тиков по 1 с: проверка идёт раз в WATCHDOG_INTERVAL_S.\n   339\t        clock = _FakeClock()\n   340\t        spy = _SpyController(self._controller(clock))\n   341\t        out = _execute_with_clock(\n   342\t            clock, _fake_run(clock, spy, [(\"done\", (0, \"ok\", {}))], empty_ticks=12)\n   343\t        )\n   344\t        self.assertEqual(out[\"state\"], \"done\")\n   345\t        self.assertGreaterEqual(spy.check_calls, 1)\n   346\t        self.assertLess(spy.check_calls, 12)\n   347\t        self.assertEqual(spy.check_calls, 2)  # на 5-й и 10-й секундах\n   348\t\n   349\t    def test_all_activity_kinds_reach_controller(self) -> None:\n   350\t        clock = _FakeClock()\n   351\t        spy = _SpyController(self._controller(clock))\n   352\t        events = [\n   353\t            (\"init\", {\"conversation_id\": \"c1\", \"tools\": 0, \"permission_mode\": \"\"}),\n   354\t            (\"reasoning\", \"r\"),\n   355\t            (\"text\", \"t\"),\n   356\t            (\"tool_trace\", {\"name\": \"run_command\"}),\n   357\t            (\"result\", {\"status\": \"OK\", \"usage\": {}}),\n   358\t            (\"done\", (0, \"t\", {})),\n   359\t        ]\n   360\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=0))\n   361\t        self.assertEqual(out[\"state\"], \"done\")\n   362\t        # result/done — терминальные события и активностью не считаются.\n   363\t        self.assertEqual(spy.activity, [\"init\", \"reasoning\", \"text\", \"tool_trace\"])\n   364\t\n   365\t    def test_idle_timeout_returns_state_in_execute(self) -> None:\n   366\t        clock = _FakeClock()\n   367\t        ctrl = self._controller(clock, idle_timeout_s=8.0)\n   368\t        out = _execute_with_clock(clock, _fake_run(clock, ctrl, [], empty_ticks=30))\n   369\t        self.assertEqual(out[\"state\"], \"idle_timeout\")\n   370\t        self.assertEqual(out[\"rc\"], 124)\n   371\t        self.assertIn(\"idle timeout\", out[\"err\"])\n   372\t\n   373\t    def test_child_exited_is_not_error(self) -> None:\n   374\t        clock = _FakeClock()\n   375\t        spy = _SpyController(\n   376\t            self._controller(clock), forced=(True, \"child_exited\", None)\n   377\t        )\n   378\t        events = [(\"text\", \"hi\"), (\"done\", (0, \"hi\", {}))]\n   379\t        out = _execute_with_clock(clock, _fake_run(clock, spy, events, empty_ticks=7))\n   380\t        self.assertGreaterEqual(spy.check_calls, 1)\n   119\t    def _log(self, msg: str) -> None:\n   120\t        if self._log_fn is not None:\n   121\t            try:\n   122\t                self._log_fn(msg)\n   123\t            except Exception:  # noqa: BLE001\n   124\t                pass\n   125\t\n   126\t    @staticmethod\n   127\t    def is_group_alive(pgid: int) -> bool:\n   128\t        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n   129\t        if not isinstance(pgid, int) or pgid <= 0:\n   130\t            return False\n   131\t        try:\n   132\t            os.killpg(pgid, 0)\n   133\t        except ProcessLookupError:\n   134\t            return False\n   135\t        except PermissionError:\n   136\t            return True\n   137\t        except OSError:\n   138\t            return False\n   139\t        return True\n   140\t\n   141\t    def forget(self, pgid: int) -> None:\n   142\t        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n   143\t        with self._lock:\n   144\t            self._prev_cpu_by_pgid.pop(pgid, None)\n   145\t            self._seen_descendants_by_pgid.pop(pgid, None)\n   146\t            self._seeded_pgids.discard(pgid)\n   147\t\n   148\t    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n   149\t        return subprocess.run(\n   150\t            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n   151\t            capture_output=True,\n   152\t            text=True,\n   153\t            timeout=self.ps_timeout_s,\n   154\t            check=False,\n   155\t        )\n   156\t\n   157\t    def _parse_ps_output(\n   158\t        self, stdout: str, target_pgid: int\n   159\t    ) -> tuple[list[int], dict[int, float], bool]:\n   160\t        \"\"\"Возвращает `(descendant_pids, cpu_by_pid, any_non_zombie_in_group)`.\"\"\"\n   161\t        descendants: list[int] = []\n   162\t        cpu_by_pid: dict[int, float] = {}\n   163\t        any_alive_proc = False\n   164\t        for raw_line in (stdout or \"\").splitlines():\n   165\t            line = raw_line.strip()\n   166\t            if not line:\n   167\t                continue\n   168\t            match = _PS_LINE_RE.match(line)\n   169\t            if match is None:\n   170\t                continue\n   171\t            try:\n   172\t                pid = int(match.group(1))\n   173\t                _ppid = int(match.group(2))\n   174\t                pgid_col = int(match.group(3))\n   175\t            except ValueError:\n   176\t                continue\n   177\t            if pgid_col != target_pgid:\n   178\t                continue\n   179\t            stat = match.group(4) or \"\"\n   180\t            cputime_str = match.group(5) or \"\"\n   181\t            if stat.upper().startswith(\"Z\"):\n   182\t                continue\n   183\t            any_alive_proc = True\n   184\t            cpu_by_pid[pid] = parse_cputime(cputime_str)\n   185\t            if pid != target_pgid:\n   186\t                descendants.append(pid)\n   187\t        descendants.sort()\n   188\t        return descendants, cpu_by_pid, any_alive_proc\n   189\t\n   190\t    def seed(\n   191\t        self, pgid: int, *, rid: str = \"\", turn_id: str = \"\"\n   192\t    ) -> WatchdogMetrics:\n   193\t        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n   194\t        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n   195\t        return metrics\n   196\t\n   197\t    def sample(\n   198\t        self,\n   199\t        pgid: int,\n   200\t        *,\n   201\t        rid: str = \"\",\n   202\t        turn_id: str = \"\",\n   203\t        _seed_only: bool = False,\n   204\t    ) -> WatchdogMetrics:\n   205\t        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n   206\t        now = time.monotonic()\n   207\t        eff_rid = rid or self.rid or \"-\"\n   208\t        eff_turn = turn_id or self.turn_id or \"-\"\n   209\t        if not self.is_group_alive(pgid):\n   210\t            return WatchdogMetrics(\n   211\t                pgid=pgid,\n   212\t                alive=False,\n   213\t                descendant_pids=(),\n   214\t                new_descendants=(),\n   215\t                cpu_time_s=0.0,\n   216\t                cpu_delta_s=0.0,\n   217\t                ps_degraded=False,\n   218\t                sample_ts=now,\n   219\t            )\n   220\t\n   221\t        try:\n   222\t            proc = self._run_ps(pgid)\n   223\t        except (subprocess.TimeoutExpired, OSError) as exc:\n   224\t            if not self.is_group_alive(pgid):\n   225\t                return WatchdogMetrics(\n   226\t                    pgid=pgid,\n   227\t                    alive=False,\n   228\t                    descendant_pids=(),\n   229\t                    new_descendants=(),\n   230\t                    cpu_time_s=0.0,\n   231\t                    cpu_delta_s=0.0,\n   232\t                    ps_degraded=False,\n   233\t                    sample_ts=now,\n   234\t                )\n   235\t            self._log(\n   236\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n   237\t                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n   238\t            )\n   239\t            return WatchdogMetrics(\n   240\t                pgid=pgid,\n   241\t                alive=True,\n   242\t                descendant_pids=(),\n   243\t                new_descendants=(),\n   244\t                cpu_time_s=0.0,\n   245\t                cpu_delta_s=0.0,\n   246\t                ps_degraded=True,\n   247\t                sample_ts=now,\n   248\t            )\n   249\t\n   250\t        if proc.returncode != 0:\n   251\t            if not self.is_group_alive(pgid):\n   252\t                return WatchdogMetrics(\n   253\t                    pgid=pgid,\n   254\t                    alive=False,\n   255\t                    descendant_pids=(),\n   256\t                    new_descendants=(),\n   257\t                    cpu_time_s=0.0,\n   258\t                    cpu_delta_s=0.0,\n   259\t                    ps_degraded=False,\n   260\t                    sample_ts=now,\n   261\t                )\n   262\t            self._log(\n   263\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n   264\t                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n   265\t            )\n   266\t            return WatchdogMetrics(\n   267\t                pgid=pgid,\n   268\t                alive=True,\n   269\t                descendant_pids=(),\n   270\t                new_descendants=(),\n   271\t                cpu_time_s=0.0,\n   272\t                cpu_delta_s=0.0,\n   273\t                ps_degraded=True,\n   274\t                sample_ts=now,\n   275\t            )\n   276\t\n   277\t        descendants, cpu_s, any_alive = self._parse_ps_output(proc.stdout, pgid)\n   278\t        if not any_alive and not self.is_group_alive(pgid):\n   279\t            return WatchdogMetrics(\n   280\t                pgid=pgid,\n   379\t    def on_activity(self, kind: str = \"protocol\") -> None:\n   380\t        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n   381\t        self.record_activity(kind)\n   382\t\n   383\t    def register_pgid(self, pgid: int) -> None:\n   384\t        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n   385\t        if not isinstance(pgid, int) or pgid <= 0:\n   386\t            return\n   387\t        with self._lock:\n   388\t            self.pgid = pgid\n   389\t        if self.watchdog_enabled and self.watchdog is not None:\n   390\t            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n   391\t\n   392\t    def check(\n    65\tfrom typing import Any\n    66\t\n    67\t# Корень репозитория cli-agent-bridge: resolve() раскрывает симлинк деплоя\n    68\t# (~/.dsh/bridges/agy-bridge -> <repo>/bridges/agy-bridge), parents[2] = <repo>.\n    69\t_REPO_ROOT = Path(__file__).resolve().parents[2]\n    70\tif str(_REPO_ROOT) not in sys.path:\n    71\t    sys.path.insert(0, str(_REPO_ROOT))\n    72\t\n    73\tfrom core.watchdog import (  # noqa: E402\n    74\t    IDLE_TIMEOUT_S as _CORE_IDLE_TIMEOUT_S,\n    75\t    WATCHDOG_INTERVAL_S,\n    76\t    AdaptiveTimeoutController,\n    77\t)\n    78\t\n    79\tROOT = Path(__file__).resolve().parent\n    80\tHOME = Path.home()\n    81\tHOST = os.environ.get(\"AGY_BRIDGE_HOST\", \"127.0.0.1\")\n    82\tPORT = int(os.environ.get(\"AGY_BRIDGE_PORT\", \"9887\"))\n    83\tAUTH_KEY = os.environ.get(\"AGY_BRIDGE_KEY\", \"\").strip()\n    84\tLAUNCHER = os.environ.get(\"AGY_LAUNCHER\", str(HOME / \".config\" / \"agy-launch\" / \"agy-cli.sh\"))\n    85\tFLEET_PATH = Path(os.environ.get(\"AGY_BRIDGE_FLEET\", \"\") or str(ROOT / \"fleet.json\"))\n    86\tENV_MODEL = os.environ.get(\"AGY_BRIDGE_MODEL\", \"\").strip()\n    87\tWORKSPACE = ROOT / \"workspace\"\n    88\tMAX_CONCURRENT = int(os.environ.get(\"AGY_BRIDGE_MAX_CONCURRENT\", \"4\"))\n    89\tQUEUE_TIMEOUT_S = int(os.environ.get(\"AGY_BRIDGE_QUEUE_TIMEOUT\", \"900\"))\n    90\tTIMEOUT_S = int(os.environ.get(\"AGY_BRIDGE_TIMEOUT\", \"1800\"))\n    91\tKEEPALIVE_S = float(os.environ.get(\"AGY_BRIDGE_KEEPALIVE\", \"15\"))\n    92\t# Первое событие agy приходит не мгновенно (инициализация CLI + MCP-серверов),\n    93\t# но и не через минуты; 120 с — с запасом на холодный egress.\n    94\tFIRST_TOKEN_TIMEOUT_S = float(os.environ.get(\"AGY_BRIDGE_FIRST_TOKEN_TIMEOUT\", \"120\"))\n    95\tPRINT_TIMEOUT = os.environ.get(\"AGY_BRIDGE_PRINT_TIMEOUT\", \"0\")\n    96\t\n    97\t# Мышление шагов agy: CLI кладёт его в транскрипт разговора пошагово, в середине\n    98\t# хода. Путь и имя файла фиксированы CLI (проверено на agy 1.3.1).\n    99\tBRAIN_DIR = Path(os.environ.get(\"AGY_BRIDGE_BRAIN\",\n   100\t                                \"\") or str(HOME / \".gemini\" / \"antigravity-cli\" / \"brain\"))\n   101\tTRANSCRIPT_NAME = \"transcript_full.jsonl\"\n   102\tTRANSCRIPT_POLL_S = float(os.environ.get(\"AGY_BRIDGE_TRANSCRIPT_POLL\", \"0.05\"))\n   103\t# Процесс вышел: один финальный проход по файлу, чтобы поймать запись последнего шага.\n   104\tTRANSCRIPT_GRACE_S = float(os.environ.get(\"AGY_BRIDGE_TRANSCRIPT_GRACE\", \"0.4\"))\n   105\tTRANSCRIPT_READ_MAX = 4 * 1024 * 1024\n   106\t\n   107\t# Effort-оси. `--effort` у agy принимает low|medium|high; id модели — база без уровня,\n   108\t# уровень всегда уходит отдельным флагом (см. модуль-docstring).\n   109\tEFFORT_LEVELS = (\"minimal\", \"low\", \"medium\", \"high\", \"xhigh\", \"max\")\n   110\tCLI_EFFORT_LEVELS = (\"low\", \"medium\", \"high\")\n   111\tIMAGE_STATUSES = (\"unsupported\", \"unverified\", \"probe\", \"confirmed\")\n   112\tIMPLEMENTED_METHODS: dict = {}\n  1438\t    def _serve_sse(self, ctx: dict) -> None:\n  1439\t        completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n  1440\t        created = int(time.time())\n  1441\t        shown_model = ctx[\"model\"]\n  1442\t        try:\n  1443\t            self.send_response(200)\n  1444\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n  1445\t            self.send_header(\"Cache-Control\", \"no-cache\")\n  1446\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n  1447\t            self.end_headers()\n  1448\t            self.close_connection = True\n  1449\t        except (BrokenPipeError, ConnectionResetError, OSError):\n  1450\t            _log(\"client gone before headers\")\n  1451\t            return\n  1452\t\n  1453\t        def chunk(delta: dict, finish=None, usage: dict | None = None,\n  1454\t                  conversation_id: str = \"\") -> str:\n  1455\t            body: dict = {\n  1456\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n  1457\t                \"model\": shown_model,\n  1458\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n  1459\t            }\n  1460\t            if usage is not None:\n  1461\t                body[\"usage\"] = usage\n  1462\t            if conversation_id:\n  1463\t                body[\"conversation_id\"] = conversation_id\n  1464\t            return \"data: \" + json.dumps(body, ensure_ascii=False) + \"\\n\\n\"\n  1465\t\n  1466\t        def on_text(value: str) -> bool:\n  1467\t            return self._emit(chunk({\"content\": value}))\n  1468\t\n  1469\t        def on_reasoning(value: str) -> bool:\n  1470\t            # Мышление шага: Harness читает первое непустое из\n  1471\t            # reasoning_content|reasoning|reasoning_text — отдаём только первое.\n  1472\t            return self._emit(chunk({\"reasoning_content\": value}))\n  1473\t\n  1474\t        def on_tool_trace(_event: dict) -> bool:\n  1475\t            # Нативный инструмент agy исполняется внутри CLI и наружу не транслируется:\n  1476\t            # клиенту нечего добавлять к его же истории вызовов. Трассировка — в stderr.\n  1477\t            return True\n  1478\t\n  1479\t        def keepalive() -> bool:\n  1480\t            return self._emit(\": keepalive\\n\\n\")\n  1481\t\n  1482\t        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n  1483\t            return\n  1484\t        out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n  1485\t        if out.get(\"state\") == \"client_gone\":\n  1486\t            _log(\"client gone mid-stream, child killed\")\n  1487\t            return\n  1488\t        err = self._error_body(out)\n  1489\t        if err is None:\n  1490\t            conv_id = str(out.get(\"conversation_id\") or \"\")\n  1491\t            self._emit(chunk({}, \"stop\", conversation_id=conv_id))\n  1492\t            # Harness считает tok/s и % контекста только из usage в потоке\n  1493\t            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage).\n  1494\t            # Шлём только при ненулевых токенах, чтобы пустой usage от agy\n  1495\t            # не превращался в ложные «0 tok/s / 0%».\n  1496\t            usage = self._usage_payload(out.get(\"usage\") or {})\n  1497\t            if usage[\"prompt_tokens\"] or usage[\"completion_tokens\"]:\n  1498\t                self._emit(chunk({}, \"stop\", usage, conversation_id=conv_id))\n  1499\t        else:\n  1500\t            self._emit(\"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\")\n  1501\t        self._emit(\"data: [DONE]\\n\\n\")\n  1502\t\n  1503\t\n  1504\tclass Server(ThreadingHTTPServer):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"Нашёл пробел в аварийной ветке `_kill_group`: если отправка `SIGTERM` группе вызывает `OSError`, код вызывает `proc.terminate()` и переходит к `wait()`, минуя эскалацию до `SIGKILL`. При игнорировании `SIGTERM` процесс останется жив. Существующие тесты эту ветку не покрывают.\n"}}
