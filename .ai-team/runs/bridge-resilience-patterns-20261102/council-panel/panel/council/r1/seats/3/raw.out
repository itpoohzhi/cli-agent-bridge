{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 - <<'PY'\nfrom core.resilience import ResilienceManager, ResilienceFlags\nclass Source:\n    def read(self):\n        return {'RESILIENCE_ENABLED': True, 'BULKHEAD_ENABLED': True}\nenv = {'BRIDGE_BULKHEAD_MAX_CONCURRENT':'64'}\nm = ResilienceManager(ResilienceFlags(Source(), env))\nold = [m.acquire('backend') for _ in range(64)]\nenv['BRIDGE_BULKHEAD_MAX_CONCURRENT']='1'\nnew = m.acquire('backend')\nprint('resize: outstanding leases =', len(old)+1, 'reported =', m.snapshot()['backends']['backend'])\nfor lease in old+[new]: lease.close()\nenv['BRIDGE_BULKHEAD_MAX_CONCURRENT']='129'\nm2 = ResilienceManager(ResilienceFlags(Source(), env))\nleases = [m2.acquire('backend') for _ in range(129)]\nprint('configured 129: admitted =', len(leases), 'capacity =', m2.snapshot()['backends']['backend']['capacity'])\nfor lease in leases: lease.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
