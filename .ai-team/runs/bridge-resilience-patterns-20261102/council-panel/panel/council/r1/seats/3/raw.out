{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat tests/test_resilience.py; cat docs/adr/0020-universal-backend-circuit-breaker-bulkhead-and-retries.md; command -v run-guarded; command -v pytest'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat tests/test_resilience.py; cat docs/adr/0020-universal-backend-circuit-breaker-bulkhead-and-retries.md; command -v run-guarded; command -v pytest'","aggregated_output":"\"\"\"Тесты универсальной отказоустойчивости шлюза (ADR-0020 Rev 4): `core/resilience.py` + фасад.\n\nВосемь сценариев ADR: переходы брейкера, проба HALF_OPEN (успех/сбой), generation tokens,\n`record_discard`, изоляция Bulkhead, RetryPolicy (Full Jitter, дедлайн, `bytes_delivered`),\nфлаги GigaRC (default=false, env-override). Плюс сквозные проверки через настоящий `Handler`:\n503 + `Retry-After` без обращения к upstream, `GET /v1/resilience`, неизменный `/health`.\nВремя — мок-часы, джиттер брейкера выключен (`cooldown_jitter=0`), сна нет.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport http.client\nimport json\nimport sys\nimport threading\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom types import SimpleNamespace\n\nimport pytest\n\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\n\nimport server  # noqa: E402\nfrom core.resilience import (  # noqa: E402\n    BulkheadCapacityExceeded,\n    CircuitBreaker,\n    CircuitBreakerOpen,\n    CircuitBreakerState,\n    ResilienceFlags,\n    ResilienceLease,\n    ResilienceManager,\n    RetryPolicy,\n    SnapshotFlagSource,\n    is_transient_backend_error,\n)\n\nALL_ON = {\n    \"RESILIENCE_ENABLED\": True,\n    \"CIRCUIT_BREAKER_ENABLED\": True,\n    \"BULKHEAD_ENABLED\": True,\n    \"RETRY_ENABLED\": True,\n}\n\n\nclass FakeClock:\n    def __init__(self) -> None:\n        self.now = 1000.0\n\n    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass StaticSource:\n    \"\"\"FlagSource с фиксированным снимком GigaRC.\"\"\"\n\n    def __init__(self, flags: dict[str, bool]) -> None:\n        self.flags = flags\n\n    def read(self) -> dict[str, bool]:\n        return dict(self.flags)\n\n\ndef make_manager(env: dict[str, str] | None = None, flags=None, clock=None, **kw):\n    clock = clock or FakeClock()\n    resilience_flags = ResilienceFlags(\n        StaticSource(ALL_ON if flags is None else flags),\n        env={\"BRIDGE_CIRCUIT_BREAKER_JITTER\": \"0\", **(env or {})},\n    )\n    return ResilienceManager(resilience_flags, clock=clock, **kw), clock\n\n\ndef make_breaker(\n    threshold=3, cooldown=30.0, clock=None\n) -> tuple[CircuitBreaker, FakeClock]:\n    clock = clock or FakeClock()\n    breaker = CircuitBreaker(\n        \"b\",\n        fail_threshold=threshold,\n        cooldown_s=cooldown,\n        cooldown_jitter=0,\n        clock=clock,\n    )\n    return breaker, clock\n\n\ndef trip(breaker: CircuitBreaker, times: int = 3) -> None:\n    for _ in range(times):\n        allowed, gen, _ = breaker.acquire()\n        assert allowed\n        breaker.record_failure(gen)\n\n\n# --------------------------------------------------------------------------- 1..5: брейкер\n\n\ndef test_circuit_breaker_transitions():\n    manager, _ = make_manager()\n    for _ in range(3):\n        with manager.acquire(\"codex\") as lease:\n            lease.record_failure()\n    with pytest.raises(CircuitBreakerOpen) as caught:\n        manager.acquire(\"codex\")\n    exc = caught.value\n    assert exc.error_code == \"CIRCUIT_BREAKER_OPEN\"\n    assert exc.backend_id == \"codex\"\n    assert exc.retry_after == 30  # ceil(30.0 - 0): jitter выключен, время не шло\n    # Изоляция по backend_id: другой бэкенд не затронут.\n    with manager.acquire(\"agy\") as lease:\n        lease.record_success()\n\n\ndef test_circuit_breaker_below_threshold_and_success_reset():\n    breaker, _ = make_breaker(threshold=3)\n    trip(breaker, 2)\n    assert breaker.state is CircuitBreakerState.CLOSED\n    allowed, gen, probe = breaker.acquire()\n    assert (allowed, probe) == (True, False)\n    breaker.record_success(gen)  # успех обнуляет подряд идущие сбои\n    trip(breaker, 2)\n    assert breaker.state is CircuitBreakerState.CLOSED\n    trip(breaker, 1)\n    assert breaker.state is CircuitBreakerState.OPEN\n\n\ndef test_circuit_breaker_half_open_probe_success():\n    breaker, clock = make_breaker()\n    trip(breaker)\n    assert breaker.acquire()[0] is False\n    clock.advance(29.0)\n    assert breaker.acquire()[0] is False\n    assert breaker.retry_after == 1\n    clock.advance(1.0)\n    allowed, gen, is_probe = breaker.acquire()\n    assert (allowed, is_probe) == (True, True)\n    assert breaker.state is CircuitBreakerState.HALF_OPEN\n    # Ровно одна проба: второй запрос отклонён, пока проба в полёте.\n    assert breaker.acquire()[0] is False\n    breaker.record_success(gen)\n    assert breaker.state is CircuitBreakerState.CLOSED\n    assert breaker.acquire() == (True, breaker.generation, False)\n\n\ndef test_circuit_breaker_half_open_probe_failure():\n    breaker, clock = make_breaker()\n    trip(breaker)\n    clock.advance(30.0)\n    allowed, gen, is_probe = breaker.acquire()\n    assert allowed and is_probe\n    breaker.record_failure(gen)\n    assert breaker.state is CircuitBreakerState.OPEN\n    assert breaker.retry_after == 30  # новый cooldown с момента сбоя пробы\n    assert breaker.acquire()[0] is False\n    clock.advance(30.0)\n    assert breaker.acquire()[0] is True  # снова проба\n\n\ndef test_circuit_breaker_generation_token_safety():\n    breaker, clock = make_breaker()\n    # Три «долгих» запроса стартовали в CLOSED с поколением 0.\n    slow = [breaker.acquire() for _ in range(3)]\n    assert {gen for _, gen, _ in slow} == {0}\n    # Быстрые сбои открыли брейкер (поколение 1), затем проба закрыла его (2 и 3).\n    trip(breaker)\n    clock.advance(30.0)\n    _, probe_gen, _ = breaker.acquire()\n    breaker.record_success(probe_gen)\n    assert breaker.state is CircuitBreakerState.CLOSED\n    generation = breaker.generation\n    # Запоздавшие сбои устаревшего поколения не меняют ни счётчик, ни состояние.\n    for _, gen, _ in slow:\n        breaker.record_failure(gen)\n    assert breaker.state is CircuitBreakerState.CLOSED\n    assert breaker.failures == 0\n    assert breaker.generation == generation\n    # Запоздавший успех не закрывает HALF_OPEN и не сбрасывает слот пробы.\n    trip(breaker)\n    clock.advance(30.0)\n    _, gen_probe, is_probe = breaker.acquire()\n    assert is_probe\n    breaker.record_success(slow[0][1])\n    breaker.record_discard(slow[0][1])\n    assert breaker.state is CircuitBreakerState.HALF_OPEN\n    assert breaker.acquire()[0] is False  # слот пробы всё ещё занят\n\n\ndef test_circuit_breaker_record_discard():\n    breaker, clock = make_breaker()\n    trip(breaker)\n    clock.advance(30.0)\n    allowed, gen, is_probe = breaker.acquire()\n    assert allowed and is_probe\n    assert breaker.acquire()[0] is False\n    breaker.record_discard(gen, \"client_disconnected\")\n    assert breaker.state is CircuitBreakerState.HALF_OPEN  # не OPEN\n    allowed2, gen2, is_probe2 = breaker.acquire()  # слот пробы свободен\n    assert allowed2 and is_probe2 and gen2 == gen\n    breaker.record_success(gen2)\n    assert breaker.state is CircuitBreakerState.CLOSED\n\n\ndef test_discard_in_closed_does_not_count_failure():\n    breaker, _ = make_breaker(threshold=1)\n    allowed, gen, _ = breaker.acquire()\n    assert allowed\n    breaker.record_discard(gen, \"client_disconnected\")\n    assert breaker.state is CircuitBreakerState.CLOSED\n    assert breaker.failures == 0\n\n\n# --------------------------------------------------------------------------- 6: Bulkhead\n\n\ndef test_bulkhead_concurrency_isolation():\n    manager, _ = make_manager()\n    leases = [manager.acquire(\"codex\") for _ in range(64)]\n    started = time.monotonic()\n    with pytest.raises(BulkheadCapacityExceeded) as caught:\n        manager.acquire(\"codex\")\n    assert time.monotonic() - started < 0.5  # отказ без ожидания слота\n    assert caught.value.error_code == \"BULKHEAD_CAPACITY_EXCEEDED\"\n    assert caught.value.retry_after == 1\n    # Другие бэкенды живы, их брейкеры/отсеки не затронуты.\n    for other in (\"droid\", \"muse\", \"agy\"):\n        with manager.acquire(other) as lease:\n            lease.record_success()\n    # Отказ Bulkhead не учтён брейкером codex (запрос не дошёл до бэкенда).\n    snap = manager.snapshot()[\"backends\"][\"codex\"]\n    assert snap[\"state\"] == \"CLOSED\" and snap[\"failures\"] == 0\n    assert snap[\"active\"] == 64 and snap[\"capacity\"] == 64\n    leases[0].close()\n    with manager.acquire(\"codex\") as lease:\n        lease.record_success()\n    for lease in leases[1:]:\n        lease.close()\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"active\"] == 0\n\n\ndef test_bulkhead_capacity_is_configurable_and_backend_limited():\n    manager, _ = make_manager(\n        env={\"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"2\"}, backend_limits={\"muse\": 1}\n    )\n    held = [manager.acquire(\"codex\"), manager.acquire(\"codex\")]\n    with pytest.raises(BulkheadCapacityExceeded):\n        manager.acquire(\"codex\")\n    muse = manager.acquire(\"muse\")\n    with pytest.raises(BulkheadCapacityExceeded):\n        manager.acquire(\"muse\")  # min(лимит бэкенда 1, настройка 2)\n    for lease in (*held, muse):\n        lease.close()\n\n\ndef test_bulkhead_rejection_frees_half_open_probe():\n    manager, clock = make_manager(\n        env={\n            \"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"2\",\n            \"BRIDGE_CIRCUIT_BREAKER_FAIL_THRESHOLD\": \"2\",\n        }\n    )\n    first, second = manager.acquire(\"codex\"), manager.acquire(\"codex\")\n    first.record_failure()\n    second.record_failure()  # брейкер открыт, оба слота отсека ещё заняты\n    clock.advance(30.0)\n    with pytest.raises(BulkheadCapacityExceeded):\n        manager.acquire(\"codex\")  # проба допущена брейкером, но отсек полон\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"state\"] == \"HALF_OPEN\"\n    first.close()\n    probe = manager.acquire(\"codex\")  # слот пробы возвращён отказом отсека\n    assert probe.is_probe\n    probe.record_success()\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"state\"] == \"CLOSED\"\n    probe.close()\n    second.close()\n\n\ndef test_bulkhead_capacity_change_applies_without_restart():\n    env: dict[str, str] = {\n        \"BRIDGE_CIRCUIT_BREAKER_JITTER\": \"0\",\n        \"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"1\",\n    }\n    manager = ResilienceManager(ResilienceFlags(StaticSource(ALL_ON), env=env))\n    first = manager.acquire(\"codex\")\n    with pytest.raises(BulkheadCapacityExceeded):\n        manager.acquire(\"codex\")\n    env[\"BRIDGE_BULKHEAD_MAX_CONCURRENT\"] = \"3\"\n    second = manager.acquire(\"codex\")\n    first.close()  # слот старого отсека освобождает старый семафор, а не новый\n    second.close()\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"active\"] == 0\n\n\n# --------------------------------------------------------------------------- 7: RetryPolicy\n\n\ndef test_retry_policy_full_jitter_and_deadline():\n    ranges: list[tuple[float, float]] = []\n\n    def spy(lo: float, hi: float) -> float:\n        ranges.append((lo, hi))\n        return hi\n\n    policy = RetryPolicy(\n        max_attempts=7, base_delay_s=1.0, max_delay_s=10.0, backoff_factor=2.0, rng=spy\n    )\n    delays = [policy.compute_delay(attempt) for attempt in range(6)]\n    # Full Jitter: нижняя граница всегда 0, верхняя — min(max, base * 2**attempt).\n    assert ranges == [\n        (0.0, 1.0),\n        (0.0, 2.0),\n        (0.0, 4.0),\n        (0.0, 8.0),\n        (0.0, 10.0),\n        (0.0, 10.0),\n    ]\n    assert delays == [1.0, 2.0, 4.0, 8.0, 10.0, 10.0]\n\n    # Реальный джиттер лежит в [0, потолок] и не вырождается в константу.\n    real = RetryPolicy(max_attempts=5, base_delay_s=1.0, max_delay_s=10.0)\n    samples = [real.compute_delay(3) for _ in range(200)]\n    assert all(s is not None and 0.0 <= s <= 8.0 for s in samples)\n    assert len(set(samples)) > 50\n\n    # Дедлайн: остаток исчерпан или задержка не помещается — повтора нет.\n    assert policy.compute_delay(2, deadline_s=0) is None\n    assert policy.compute_delay(2, deadline_s=-1.0) is None\n    assert policy.compute_delay(2, deadline_s=4.0) is None  # delay=4.0 >= 4.0\n    assert policy.compute_delay(2, deadline_s=4.5) == 4.0\n    # Огромный номер попытки не переполняет степень.\n    assert policy.compute_delay(10_000) == 10.0\n\n    # Инвариант доставки: байты отданы — повтор запрещён при любой ошибке.\n    transient = ConnectionError(\"upstream reset\")\n    assert policy.should_retry(0, bytes_delivered=False, exc=transient) is True\n    assert policy.should_retry(0, bytes_delivered=True, exc=transient) is False\n    assert policy.should_retry(0, bytes_delivered=True, exc=None) is False\n    # Всего max_attempts попыток; нетранзитные ошибки не повторяются.\n    three = RetryPolicy(max_attempts=3)\n    assert [three.should_retry(a, False, transient) for a in range(4)] == [\n        True,\n        True,\n        False,\n        False,\n    ]\n    assert three.should_retry(0, False, ValueError(\"bad request\")) is False\n    assert (\n        three.should_retry(0, False, None) is True\n    )  # сбой без исключения (upstream 5xx)\n    assert is_transient_backend_error(CircuitBreakerOpen(\"b\", 1)) is False\n\n\ndef test_retry_policy_from_manager_follows_flag():\n    manager, _ = make_manager(\n        env={\"BRIDGE_RETRY_MAX_ATTEMPTS\": \"5\", \"BRIDGE_RETRY_BASE_DELAY_S\": \"0.25\"}\n    )\n    policy = manager.retry_policy()\n    assert policy is not None\n    assert (policy.max_attempts, policy.base_delay_s, policy.max_delay_s) == (\n        5,\n        0.25,\n        10.0,\n    )\n    off, _ = make_manager(flags={**ALL_ON, \"RETRY_ENABLED\": False})\n    assert off.retry_policy() is None\n\n\n# --------------------------------------------------------------------------- 8: флаги GigaRC\n\n\ndef _write_snapshot(\n    path: Path, flags: dict, *, now: datetime, ttl_s: float = 60.0\n) -> None:\n    path.write_text(\n        json.dumps(\n            {\n                \"schema_version\": 1,\n                \"generated_at\": now.isoformat(),\n                \"expires_at\": (now + timedelta(seconds=ttl_s)).isoformat(),\n                \"flags\": flags,\n            }\n        )\n    )\n    path.chmod(0o600)\n\n\ndef test_resilience_gigarc_flags(tmp_path: Path):\n    # 1) Нет снимка и env — всё выключено, пороги по умолчанию.\n    missing = SnapshotFlagSource(str(tmp_path / \"absent.json\"))\n    off = ResilienceFlags(missing, env={}).current()\n    assert (off.enabled, off.circuit_breaker, off.bulkhead, off.retry) == (False,) * 4\n    manager = ResilienceManager(ResilienceFlags(missing, env={}))\n    assert manager.acquire(\"codex\").close() is None  # no-op lease\n    for _ in range(100):\n        manager.acquire(\"codex\")  # без флага Bulkhead не ограничивает\n    assert manager.snapshot()[\"backends\"] == {}\n\n    # 2) Снимок GigaRC включает флаги (дефолты порогов — из ADR).\n    tmp_path.chmod(0o700)\n    snap_path = tmp_path / \"resilience.snapshot.json\"\n    now = datetime.now(timezone.utc)\n    _write_snapshot(snap_path, ALL_ON, now=now)\n    clock = SimpleNamespace(t=now.timestamp())\n    source = SnapshotFlagSource(\n        str(snap_path), clock=lambda: clock.t, max_true_age_s=30.0\n    )\n    on = ResilienceFlags(source, env={}).current()\n    assert (on.enabled, on.circuit_breaker, on.bulkhead, on.retry) == (True,) * 4\n    assert (on.bulkhead_max_concurrent, on.fail_threshold, on.cooldown_s) == (\n        64,\n        3,\n        30.0,\n    )\n    assert (on.retry_max_attempts, on.retry_base_delay_s, on.retry_max_delay_s) == (\n        3,\n        1.0,\n        10.0,\n    )\n\n    # 3) `true` живёт только пока снимок свеж: устаревший снимок гасит флаги (lastgood → false).\n    clock.t += 31.0\n    stale = ResilienceFlags(source, env={}).current()\n    assert stale.enabled is False\n\n    # 4) Env перекрывает снимок в обе стороны (kill-switch и принудительное включение).\n    clock.t = now.timestamp()\n    killed = ResilienceFlags(\n        source, env={\"BRIDGE_CIRCUIT_BREAKER_ENABLED\": \"false\"}\n    ).current()\n    assert killed.enabled and not killed.circuit_breaker and killed.bulkhead\n    master_off = ResilienceFlags(\n        source, env={\"BRIDGE_RESILIENCE_ENABLED\": \"0\"}\n    ).current()\n    assert (master_off.circuit_breaker, master_off.bulkhead, master_off.retry) == (\n        False,\n    ) * 3\n    forced = ResilienceFlags(\n        StaticSource({}),\n        env={\"BRIDGE_RESILIENCE_ENABLED\": \"yes\", \"BRIDGE_RETRY_ENABLED\": \"on\"},\n    ).current()\n    assert forced.enabled and forced.retry and not forced.bulkhead\n\n    # 5) Пороги из env; мусор и недопустимые значения → безопасный fallback.\n    tuned = ResilienceFlags(\n        StaticSource(ALL_ON),\n        env={\n            \"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"8\",\n            \"BRIDGE_CIRCUIT_BREAKER_FAIL_THRESHOLD\": \"5\",\n            \"BRIDGE_CIRCUIT_BREAKER_COOLDOWN_S\": \"12.5\",\n            \"BRIDGE_RETRY_MAX_ATTEMPTS\": \"4\",\n            \"BRIDGE_RETRY_BASE_DELAY_S\": \"0.5\",\n            \"BRIDGE_RETRY_MAX_DELAY_S\": \"2\",\n        },\n    ).current()\n    assert (tuned.bulkhead_max_concurrent, tuned.fail_threshold, tuned.cooldown_s) == (\n        8,\n        5,\n        12.5,\n    )\n    assert (\n        tuned.retry_max_attempts,\n        tuned.retry_base_delay_s,\n        tuned.retry_max_delay_s,\n    ) == (4, 0.5, 2.0)\n    garbage = ResilienceFlags(\n        StaticSource(ALL_ON),\n        env={\n            \"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"zero\",\n            \"BRIDGE_CIRCUIT_BREAKER_FAIL_THRESHOLD\": \"0\",\n            \"BRIDGE_CIRCUIT_BREAKER_COOLDOWN_S\": \"-3\",\n            \"BRIDGE_RETRY_BASE_DELAY_S\": \"nan\",\n            \"BRIDGE_RESILIENCE_ENABLED\": \"maybe\",  # невалидный env игнорируется → берётся снимок\n        },\n    ).current()\n    assert garbage.enabled\n    assert (\n        garbage.bulkhead_max_concurrent,\n        garbage.fail_threshold,\n        garbage.cooldown_s,\n    ) == (64, 3, 30.0)\n    assert garbage.retry_base_delay_s == 1.0\n\n    # 6) Небезопасный снимок (права 0644) игнорируется: флаги остаются false.\n    snap_path.chmod(0o644)\n    unsafe = SnapshotFlagSource(str(snap_path), clock=lambda: clock.t)\n    assert ResilienceFlags(unsafe, env={}).current().enabled is False\n\n    # 7) Падение источника флагов не ломает запрос.\n    class Broken:\n        def read(self):\n            raise RuntimeError(\"boom\")\n\n    assert ResilienceFlags(Broken(), env={}).current().enabled is False\n\n\n# --------------------------------------------------------------------------- Lease\n\n\ndef test_lease_has_no_default_success():\n    manager, _ = make_manager()\n    # Выход без исхода и без исключения — не успех и не сбой.\n    for _ in range(5):\n        with manager.acquire(\"codex\"):\n            pass\n    snap = manager.snapshot()[\"backends\"][\"codex\"]\n    assert snap[\"state\"] == \"CLOSED\" and snap[\"failures\"] == 0 and snap[\"active\"] == 0\n    # Необработанное исключение — сбой; Bulkhead освобождён.\n    for _ in range(3):\n        with pytest.raises(RuntimeError):\n            with manager.acquire(\"codex\"):\n                raise RuntimeError(\"adapter crashed\")\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"state\"] == \"OPEN\"\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"active\"] == 0\n\n\ndef test_lease_first_outcome_is_final_and_probe_without_outcome_is_released():\n    manager, clock = make_manager()\n    for _ in range(3):\n        with manager.acquire(\"codex\") as lease:\n            lease.record_failure()\n    clock.advance(30.0)\n    with manager.acquire(\"codex\") as probe:\n        assert probe.is_probe\n        probe.record_discard(\"client_disconnected\")\n        probe.record_failure()  # игнорируется: исход уже зафиксирован\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"state\"] == \"HALF_OPEN\"\n    with manager.acquire(\"codex\"):  # проба без исхода не залипает навсегда\n        pass\n    with manager.acquire(\"codex\") as probe2:\n        assert probe2.is_probe\n        probe2.record_success()\n    assert manager.snapshot()[\"backends\"][\"codex\"][\"state\"] == \"CLOSED\"\n\n\ndef test_disabled_flags_give_noop_lease():\n    manager = ResilienceManager(ResilienceFlags(StaticSource({}), env={}))\n    lease = manager.acquire(\"codex\")\n    assert isinstance(lease, ResilienceLease)\n    with lease:\n        lease.record_failure()\n    for _ in range(10):\n        manager.acquire(\"codex\").record_failure()\n    manager.acquire(\"codex\")  # брейкер не открывался\n\n\n# --------------------------------------------------------------------------- фасад (HTTP)\n\n\n@pytest.fixture\ndef facade(monkeypatch):\n    \"\"\"Настоящий Handler + управляемый upstream; RESILIENCE подменяется тестом.\"\"\"\n    state = SimpleNamespace(status=200, hits=0)\n    lock = threading.Lock()\n\n    class Upstream(BaseHTTPRequestHandler):\n        def log_message(self, format: str, *args: object) -> None:\n            return\n\n        def do_POST(self):  # noqa: N802\n            self.rfile.read(int(self.headers[\"Content-Length\"]))\n            with lock:\n                state.hits += 1\n            body = json.dumps({\"id\": \"x\", \"choices\": []}).encode()\n            self.send_response(state.status)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n\n    class Srv(ThreadingHTTPServer):\n        request_queue_size = 64\n        daemon_threads = True\n\n    upstream = Srv((\"127.0.0.1\", 0), Upstream)\n    threading.Thread(\n        target=upstream.serve_forever, kwargs={\"poll_interval\": 0.01}, daemon=True\n    ).start()\n    data = json.loads((server.ROOT / \"fleet.json\").read_text())\n    for cfg in data[\"backends\"].values():\n        if cfg[\"kind\"] == \"passthrough\":\n            cfg.update(\n                base_url=f\"http://127.0.0.1:{upstream.server_port}/v1\",\n                api_key=\"\",\n                api_key_env=\"\",\n                enabled=True,\n            )\n    fleet = server._build_catalog(data)\n    monkeypatch.setattr(server, \"FLEET\", fleet)\n    monkeypatch.setattr(\n        server,\n        \"BACKENDS\",\n        server.AdapterRegistry.from_fleet(\n            fleet, server.ADAPTER_KINDS, lambda: server.FLEET, server\n        ),\n    )\n    monkeypatch.setattr(server, \"AUTH_KEY\", \"hub-test-key\")\n    monkeypatch.setattr(server, \"_log\", lambda message: None)\n    monkeypatch.setattr(server, \"_shutting_down\", False)\n    monkeypatch.setattr(server, \"_is_drain_enabled\", lambda: False)\n    monkeypatch.setattr(server, \"_is_detached_enabled\", lambda: False)\n    monkeypatch.setattr(server, \"_budget\", server._ByteBudget(1_000_000))\n    bridge = Srv((\"127.0.0.1\", 0), server.Handler)\n    threading.Thread(\n        target=bridge.serve_forever, kwargs={\"poll_interval\": 0.01}, daemon=True\n    ).start()\n\n    def call(body=None, path=\"/v1/chat/completions\", method=\"POST\", auth=True):\n        conn = http.client.HTTPConnection(\"127.0.0.1\", bridge.server_port, timeout=10)\n        try:\n            headers = {\"Content-Type\": \"application/json\"}\n            if auth:\n                headers[\"Authorization\"] = \"Bearer hub-test-key\"\n            conn.request(\n                method,\n                path,\n                body=json.dumps(body or {\"model\": \"gemini-4-argon\"})\n                if method == \"POST\"\n                else None,\n                headers=headers,\n            )\n            resp = conn.getresponse()\n            raw = resp.read()\n            return (\n                resp.status,\n                {k.lower(): v for k, v in resp.getheaders()},\n                (json.loads(raw) if raw else None),\n            )\n        finally:\n            conn.close()\n\n    try:\n        yield SimpleNamespace(call=call, state=state, monkeypatch=monkeypatch)\n    finally:\n        bridge.shutdown()\n        bridge.server_close()\n        upstream.shutdown()\n        upstream.server_close()\n\n\ndef test_facade_open_breaker_returns_503_retry_after_without_upstream_call(facade):\n    manager, _ = make_manager()\n    facade.monkeypatch.setattr(server, \"RESILIENCE\", manager)\n    facade.state.status = 502\n    for _ in range(3):\n        status, _, _ = facade.call()\n        assert status == 502  # честный ответ upstream, без подмены\n    assert facade.state.hits == 3\n    status, headers, body = facade.call()\n    assert status == 503\n    assert facade.state.hits == 3  # fail-fast: upstream не вызывался\n    assert headers[\"retry-after\"] == \"30\"\n    assert body[\"error\"] == {\n        \"message\": \"Backend 'agy' is temporarily unavailable: circuit breaker is open\",\n        \"type\": \"resilience_error\",\n        \"code\": \"CIRCUIT_BREAKER_OPEN\",\n        \"retry_after\": 30,\n    }\n    # Другой бэкенд (opencode-zen) не задет и по-прежнему доходит до upstream.\n    facade.state.status = 200\n    status, _, _ = facade.call({\"model\": \"big-pickle\"})\n    assert status == 200 and facade.state.hits == 4\n\n\ndef test_facade_4xx_and_success_do_not_trip_breaker(facade):\n    manager, _ = make_manager()\n    facade.monkeypatch.setattr(server, \"RESILIENCE\", manager)\n    facade.state.status = 429\n    for _ in range(6):\n        assert facade.call()[0] == 429  # < 500 — бэкенд жив\n    facade.state.status = 200\n    assert facade.call()[0] == 200\n    assert manager.snapshot()[\"backends\"][\"agy\"][\"state\"] == \"CLOSED\"\n\n\ndef test_facade_flags_off_keeps_legacy_behavior(facade):\n    facade.monkeypatch.setattr(\n        server,\n        \"RESILIENCE\",\n        ResilienceManager(ResilienceFlags(StaticSource({}), env={})),\n    )\n    facade.state.status = 502\n    for _ in range(8):\n        assert facade.call()[0] == 502\n    assert facade.state.hits == 8\n\n\ndef test_facade_bulkhead_503_before_headers(facade):\n    manager, _ = make_manager(env={\"BRIDGE_BULKHEAD_MAX_CONCURRENT\": \"1\"})\n    facade.monkeypatch.setattr(server, \"RESILIENCE\", manager)\n    held = manager.acquire(\"agy\")\n    try:\n        status, headers, body = facade.call()\n        assert status == 503\n        assert headers[\"retry-after\"] == \"1\"\n        assert body[\"error\"][\"code\"] == \"BULKHEAD_CAPACITY_EXCEEDED\"\n        assert facade.state.hits == 0\n    finally:\n        held.close()\n    assert facade.call()[0] == 200\n\n\ndef test_facade_resilience_endpoint_requires_auth_and_health_contract_is_frozen(facade):\n    manager, _ = make_manager()\n    facade.monkeypatch.setattr(server, \"RESILIENCE\", manager)\n    status, _, _ = facade.call(path=\"/v1/resilience\", method=\"GET\", auth=False)\n    assert status == 401\n    facade.state.status = 502\n    for _ in range(3):\n        facade.call()\n    status, _, snap = facade.call(path=\"/v1/resilience\", method=\"GET\")\n    assert status == 200\n    assert snap[\"enabled\"] is True\n    assert snap[\"backends\"][\"agy\"][\"state\"] == \"OPEN\"\n    assert snap[\"backends\"][\"agy\"][\"retry_after\"] >= 1\n    # Бэкенды из каталога видны даже без трафика.\n    assert snap[\"backends\"][\"codex\"] == {\n        \"state\": \"CLOSED\",\n        \"generation\": 0,\n        \"failures\": 0,\n        \"retry_after\": 0,\n        \"active\": 0,\n        \"capacity\": 64,\n    }\n    status, _, health = facade.call(path=\"/health\", method=\"GET\", auth=False)\n    assert status == 200\n    assert sorted(health) == sorted(\n        [\n            \"ok\",\n            \"transport\",\n            \"model\",\n            \"active\",\n            \"max_concurrent\",\n            \"tool_emulation\",\n            \"uptime_s\",\n        ]\n    )\n# ADR 0020: Универсальный Circuit Breaker, Bulkhead и ретраи с экспоненциальным бэкоффом для CLI-адаптеров хаба (Rev 4)\n\n## Статус\nProposed (Пресет `analyst-teamlead`, закрыты все замечания Совета Тимлидов R1 Cycle 3: F-001..F-007)\n\n## Контекст и проблема\n1. **Проблема спиннинга и наивных повторов процессов:** В шлюзе повторы дочерних CLI-процессов выполнялись разрозненно или отсутствовали вовсе для passthrough-маршрутов. В `server.py:5289` цикл был привязан исключительно к `droid` и использовал линейный сон `_sleep(2 * attempt)` без Full Jitter и дедлайна.\n2. **Отсутствие Circuit Breaker в ядре:** При систематическом отказе любого из 6 бэкендов (`droid`, `muse`, `codex`, `agy`, `opencode-zen`, `claude-p`) мост продолжает на каждый входящий HTTP-запрос порождать новые процессы, растрачивая ресурсы CPU/PID вместо быстрого отказа (*fail-fast 503*).\n3. **Отсутствие изоляции параллелизма (Bulkhead):** Лимит глобальных HTTP-соединений шлюза (`max_http_connections`) равен 128 (`fleet.json`). Бэкенды `passthrough` имеют `max_concurrent: 128`. Зависание одного бэкенда способно занять все 128 соединений, заблокировав обработку запросов к остальным бэкендам.\n4. **Инвариант владельца:** Автоматический переход на резервную модель/провайдер категорически запрещён. При недоступности бэкенда клиент получает прозрачный `HTTP 503` с заголовком `Retry-After`.\n\n---\n\n## Архитектурные решения\n\n### 1. Ключ изоляции: полный перечень `backend_id`\nИзоляция Circuit Breaker и Bulkhead выполняется строго по уникальному идентификатору `backend_id`. Идентификатор определяется в `server.py:6177` как `backend_id = model[\"backend\"]` из каталога `fleet.json`:\n1. `droid` (`kind: droid`, `max_concurrent: 4`)\n2. `muse` (`kind: muse`, `max_concurrent: 1`)\n3. `codex` (`kind: passthrough`, `max_concurrent: 128`)\n4. `agy` (`kind: passthrough`, `max_concurrent: 128`)\n5. `opencode-zen` (`kind: passthrough`, `max_concurrent: 128`)\n6. `claude-p` (`kind: passthrough`, `max_concurrent: 128`)\n\n---\n\n### 2. Универсальный модуль отказоустойчивости ядра (`core/resilience.py`)\nЧистый модуль `core/resilience.py` (stdlib-only, без внешних зависимостей, потокобезопасность на `threading.Lock`).\n\n#### А. Конечный автомат `CircuitBreaker` с поколениями (Generations)\n- **Состояния:**\n  - `CLOSED`: запросы разрешены, счетчик сбоев сбрасывается при успехе.\n  - `OPEN`: зафиксировано $N$ (`fail_threshold`, по умолчанию 3) последовательных сбоев. Новые запросы отклоняются (*fail-fast 503*) без вызова адаптера в течение `cooldown_s`.\n  - `HALF_OPEN`: по истечении `cooldown_s` (с рандомизацией `reset_timeout_s * uniform(0.8, 1.2)`) допускается ровно одна проба (`max_half_open_probes = 1`). При успехе автомат переходит в `CLOSED`, при сбое — в `OPEN`.\n- **Защита от запоздавших ответов (Generation Tokens):**\n  Каждый переход состояния автомата инкрементирует `generation: int`. Допущенный запрос получает `(generation, is_probe)`. Если при завершении вызова `call_generation != current_generation`, результат игнорируется, исключая порчу состояния брейкера старыми параллельными ответами.\n- **Освобождение пробы `record_discard()`:**\n  Если пробный запрос отменен клиентом, прерван нейтральной ошибкой или не дошел до бэкенда, вызывается `record_discard(generation)`, который освобождает слот пробы в `HALF_OPEN` без фиксации сбоя или перехода в `OPEN`.\n- **Классификация исключений:**\n  - *Технические сбои бэкенда (учитываются брейкером):* `BackendUnavailable` (бинарник не найден, exit!=0 на префлайте, порт недоступен), `BackendProtocolError` (пустой ответ, нарушение протокола IPC), `SubprocessError`, `BrokenPipeError` к CLI-бинарнику.\n  - *Нейтральные события (не ухудшают брейкер, вызывают `record_discard`):* обрывы клиентского HTTP-соединения (`BrokenPipeError`/`ConnectionResetError` в `StreamSink`), `BackendTimeout` из-за медленного чтения клиентом, ошибки 400 Bad Request / 401 Auth.\n- **Заголовок `Retry-After`:**\n  При состоянии `OPEN` возвращается точное целое число секунд: `max(1, int(math.ceil(self._open_until - now)))`. Джиттер вычисляется единожды при входе в `OPEN` (`self._open_until = now + reset_timeout_s * uniform(0.8, 1.2)`).\n\n#### Б. Изоляция параллелизма `Bulkhead` с защитой пула соединений\n- Ограничение ёмкости passthrough-бэкендов:\n  $$\\text{capacity}(b) = \\min(\\text{backend\\_max\\_concurrent}, \\text{BRIDGE\\_BULKHEAD\\_MAX\\_PASSTHROUGH})$$\n  По умолчанию `BRIDGE_BULKHEAD_MAX_PASSTHROUGH = 64`.\n- **Механизм защиты пула соединений:** Глобальный семафор `_conn_sem` (128) удерживается на время обработки соединения. Запросы сверх лимита Bulkhead отклоняются немедленно (<1 мс) со статусом 503 (`BULKHEAD_CAPACITY_EXCEEDED`), освобождая `_conn_sem` без задержек. Это гарантирует, что даже при зависании одного бэкенда минимум 64 глобальных HTTP-слота всегда доступны для остальных бэкендов шлюза.\n\n#### В. Агент-агностическая политика повторов `RetryPolicy` (Exponential Backoff & Full Jitter)\n- Универсальный компонент `RetryPolicy` используется всеми адаптерами шлюза (`droid`, `muse` и passthrough):\n  ```python\n  class RetryPolicy:\n      def should_retry(self, attempt: int, bytes_delivered: bool, exc: Exception | None = None) -> bool:\n          if bytes_delivered or attempt >= self.max_attempts:\n              return False\n          return is_transient_backend_error(exc)\n\n      def compute_delay(self, attempt: int, deadline_s: float | None = None) -> float | None:\n          ...\n  ```\n- **Инвариант доставки:** Если клиенту уже были отправлены смысловые байты ответа (`bytes_delivered == True`), повтор строго запрещён, предотвращая повторную генерацию и дублирование контента.\n\n---\n\n### 3. Точки интеграции в шлюз (`server.py`)\n\n#### 3.1. Единая точка маршрутизации в `do_POST` до отправки HTTP-заголовков\n```python\nbackend_id = model[\"backend\"]\n\ntry:\n    with RESILIENCE.acquire(backend_id) as lease:\n        if isinstance(passthrough, PassthroughAdapter):\n            self._serve_passthrough(passthrough, raw, req, model_id, lease)\n        elif is_stream:\n            self._serve_stream(ctx, lease)\n        else:\n            self._serve_json(ctx, lease)\nexcept ResilienceRejected as exc:\n    self._send(\n        503,\n        {\n            \"error\": {\n                \"message\": f\"Backend '{backend_id}' is temporarily unavailable: {exc.reason}\",\n                \"type\": exc.error_type,\n                \"code\": exc.error_code,\n                \"retry_after\": exc.retry_after,\n            }\n        },\n        headers={\"Retry-After\": str(exc.retry_after)},\n    )\n    return\n```\n\n#### 3.2. Явная фиксация результата вызова в `ResilienceLease`\n`ResilienceLease.__exit__` **НЕ** считает выход без исключения автоматическим успехом. Результат фиксируется строго явно:\n1. **Passthrough:** `if sink.status < 500: lease.record_success()` иначе `lease.record_failure()`.\n2. **Session / Stream / JSON:**\n   - Пустой стартовый кадр SSE (`role: assistant`) успех не фиксирует.\n   - Успех `lease.record_success()` фиксируется строго при успешном завершении хода (процесс завершился с `rc == 0`, сгенерирован финальный ответ).\n   - Аварийный обрыв процесса mid-stream вызывает `lease.record_failure()`.\n   - Клиентский обрыв сокета вызывает `lease.record_discard(\"client_disconnected\")`.\n\n#### 3.3. Наблюдаемость и безопасность\n- Замороженный контракт `/health` (`server.py:5782`) из семи ключей сохраняется без изменений.\n- Детальное состояние Circuit Breakers доступно по защищенному эндпоинту `GET /v1/resilience`, требующему авторизации через `_auth_ok(self.headers)`.\n\n---\n\n### 4. Конфигурируемость без хардкода (Zero-Hardcode) и соответствие GigaRC\nВ соответствии с правилом `AGENTS.md:249` (директива 2026-10-16):\n- Все новые механизмы закрыты флагами GigaRC с дефолтом `false`:\n  - `RESILIENCE_ENABLED`: мастер-флаг (дефолт `false`).\n  - `CIRCUIT_BREAKER_ENABLED`: флаг брейкера (дефолт `false`).\n  - `BULKHEAD_ENABLED`: флаг bulkheads (дефолт `false`).\n  - `RETRY_ENABLED`: флаг повторов с бэкоффом (дефолт `false`).\n- Флаги читаются через локальный снимок GigaRC (`FlagSource` по аналогии с `core/context_resilience.py`) с fallback на переменные окружения (`BRIDGE_RESILIENCE_ENABLED` и др.), обеспечивая мгновенный kill-switch в рантайме без перезапуска процессов.\n- Полный набор параметров окружения:\n  - `BRIDGE_RESILIENCE_ENABLED` = `false`\n  - `BRIDGE_CIRCUIT_BREAKER_ENABLED` = `false`\n  - `BRIDGE_BULKHEAD_ENABLED` = `false`\n  - `BRIDGE_RETRY_ENABLED` = `false`\n  - `BRIDGE_CB_FAIL_THRESHOLD` = `3`\n  - `BRIDGE_CB_RESET_TIMEOUT_S` = `30.0`\n  - `BRIDGE_BULKHEAD_MAX_PASSTHROUGH` = `64`\n  - `BRIDGE_RETRY_MAX_ATTEMPTS` = `3`\n  - `BRIDGE_RETRY_BASE_SLEEP_S` = `0.5`\n  - `BRIDGE_RETRY_BACKOFF_FACTOR` = `2.0`\n  - `BRIDGE_RETRY_MAX_SLEEP_S` = `5.0`\n/Users/aazhiry1/.local/bin/run-guarded\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba server.py | sed -n '5220,5335p;5420,5525p;5780,5845p;6260,6335p;6440,6550p;7340,7405p'; rg -n 'def handle|def _stream|except|ClientGone|status|sink.start|sink.write' adapters/passthrough_adapter.py; ls -ld .venv/bin/python .venv/bin/pytest\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba server.py | sed -n '5220,5335p;5420,5525p;5780,5845p;6260,6335p;6440,6550p;7340,7405p'; rg -n 'def handle|def _stream|except|ClientGone|status|sink.start|sink.write' adapters/passthrough_adapter.py; ls -ld .venv/bin/python .venv/bin/pytest\"","aggregated_output":"  5220\t        T/L всё равно освобождаются сразу по возврату _execute, независимо от скорости клиента.\n  5221\t        \"\"\"\n  5222\t        # Адаптер возвращает legacy-контекст без фасадных полей корреляции.\n  5223\t        ctx = {\n  5224\t            **ctx,\n  5225\t            \"request_id\": self._trace.request_id if self._trace else None,\n  5226\t            \"subagent_id\": self._trace.subagent_id if self._trace else None,\n  5227\t        }\n  5228\t        model = ctx[\"model\"]\n  5229\t        effort = ctx[\"effort\"]\n  5230\t        autonomy = ctx[\"autonomy\"]\n  5231\t        tag = ctx[\"tag\"]\n  5232\t        t0 = time.monotonic()\n  5233\t        out: dict = {}\n  5234\t        img_dir = None\n  5235\t        chat = None\n  5236\t        chat_held = False\n  5237\t        poll_state = {\"last_ka\": 0.0}\n  5238\t        run = None\n  5239\t        open_attempt = None\n  5240\t        committed_turns = 0\n  5241\t        cfg = (\n  5242\t            \"\"  # заданы до ветвлений: finally видит их и при раннем исключении (RW-004)\n  5243\t        )\n  5244\t        rpc = ctx[\"rpc\"]\n  5245\t        try:\n  5246\t            try:\n  5247\t                _launcher()\n  5248\t            except LauncherUnavailable:\n  5249\t                # Гонка с удалением лончера: ответ отдаёт вызывающая ветка.\n  5250\t                self._log_reject(\"launcher_unavailable\", model, ctx[\"model_len\"])\n  5251\t                return {\n  5252\t                    \"state\": \"launcher_unavailable\",\n  5253\t                    \"rc\": 1,\n  5254\t                    \"text\": \"\",\n  5255\t                    \"usage\": {},\n  5256\t                    \"result\": {},\n  5257\t                    \"err\": \"\",\n  5258\t                    \"tool_calls\": [],\n  5259\t                    \"events\": [],\n  5260\t                }\n  5261\t            if ctx[\"route\"] == \"keyed\":\n  5262\t                chat = REGISTRY.get(ctx[\"key_hash\"])\n  5263\t                reason = self._acquire_chat(chat, keepalive, poll_state)\n  5264\t                if reason:\n  5265\t                    return self._no_slot(ctx, reason)\n  5266\t                chat_held = True\n  5267\t                _reconcile_chat_env(chat, ctx.get(\"fwd_env\"))\n  5268\t            images = ctx.get(\"images\") or []\n  5269\t            if images:\n  5270\t                img_dir = WORKSPACE / (\"img-\" + uuid.uuid4().hex)\n  5271\t                total_bytes = 0\n  5272\t                try:\n  5273\t                    img_dir.mkdir(parents=True, exist_ok=True)\n  5274\t                    os.chmod(img_dir, 0o700)\n  5275\t                    for image in images:\n  5276\t                        target = img_dir / image[\"name\"]\n  5277\t                        target.write_bytes(image[\"data\"])\n  5278\t                        os.chmod(target, 0o600)\n  5279\t                        total_bytes += len(image[\"data\"])\n  5280\t                except OSError as exc:\n  5281\t                    # ENOSPC, отказ chmod и пр. при spool картинок: предусмотренная ошибка 502, каталог чистится в finally.\n  5282\t                    _log(f\"spool_error err={_err_summary(exc, 120)!r}\")\n  5283\t                    return {\n  5284\t                        \"state\": \"spool_error\",\n  5285\t                        \"rc\": 1,\n  5286\t                        \"text\": \"\",\n  5287\t                        \"usage\": {},\n  5288\t                        \"result\": {},\n  5289\t                        \"err\": \"\",\n  5290\t                        \"tool_calls\": [],\n  5291\t                        \"events\": [],\n  5292\t                    }\n  5293\t                img_stats = (\n  5294\t                    len(images),\n  5295\t                    total_bytes,\n  5296\t                    \",\".join(image[\"mime\"] for image in images),\n  5297\t                )\n  5298\t            else:\n  5299\t                img_stats = None\n  5300\t            work_dir = _work_dir_for(ctx[\"cwd\"], img_dir)\n  5301\t            rpc = ctx[\"rpc\"]\n  5302\t            cfg = _config_digest(rpc[\"system\"], work_dir)\n  5303\t            keep_tools = [\"Read\"] if images else []\n  5304\t            for attempt in (1, 2, 3):\n  5305\t                plan = _make_plan(ctx, chat, cfg, work_dir, keep_tools)\n  5306\t                plan[\"fwd_env\"] = ctx.get(\"fwd_env\")\n  5307\t                holds_slot = False\n  5308\t                dead = plan.pop(\"dead_proc\")\n  5309\t                if dead is not None:\n  5310\t                    chat.proc = None\n  5311\t                    dead.close(mode=\"term\", term_wait=0.5, kill_wait=0.5)\n  5312\t                old = plan.pop(\"handoff\")\n  5313\t                if old is not None:\n  5314\t                    # rebase: слот P старого процесса передаётся новому без возврата в пул.\n  5315\t                    chat.proc = None\n  5316\t                    old.close(mode=\"term\", keep_slot=True)\n  5317\t                    holds_slot = True\n  5318\t                t_held = False\n  5319\t                t_released = [False]\n  5320\t\n  5321\t                def _release_turn_slot() -> None:\n  5322\t                    if t_held and not t_released[0]:\n  5323\t                        t_released[0] = True\n  5324\t                        _slots.release()\n  5325\t\n  5326\t                managed_turn = getattr(self, \"_active_managed_turn\", None)\n  5327\t                if managed_turn is not None:\n  5328\t                    managed_turn._slot_release_fn = _release_turn_slot\n  5329\t                    managed_turn._slot_released = False\n  5330\t                new_run = None\n  5331\t                try:\n  5332\t                    # Любая ошибка между взятием слотов P/T и созданием Run возвращает их (RW-012):\n  5333\t                    # после создания Run слот P принадлежит ему, а T освобождает внутренний finally.\n  5334\t                    if plan[\"need_slot\"] and not holds_slot:\n  5335\t                        waited = time.monotonic()\n  5420\t                            or getattr(getattr(new_run, \"proc\", None), \"pid\", None),\n  5421\t                            terminate_fn=lambda p=getattr(new_run, \"proc\", None): (\n  5422\t                                _close_async(p, \"kill\") if p is not None else None\n  5423\t                            ),\n  5424\t                        )\n  5425\t                    holds_slot = False\n  5426\t                except Exception as exc:  # noqa: BLE001 - любая ошибка подготовки хода: ресурсы назад, штатный 502\n  5427\t                    if new_run is None:\n  5428\t                        if t_held:\n  5429\t                            _release_turn_slot()\n  5430\t                        if holds_slot:\n  5431\t                            POOL.release()\n  5432\t                    _log(\n  5433\t                        f\"session_rpc chat={plan['hash8']} attempt_setup_failed \"\n  5434\t                        f\"err={_err_summary(repr(exc), 160)!r}\"\n  5435\t                    )\n  5436\t                    out = {\n  5437\t                        \"state\": \"pump_error\",\n  5438\t                        \"rc\": 1,\n  5439\t                        \"text\": \"\",\n  5440\t                        \"usage\": {},\n  5441\t                        \"result\": {},\n  5442\t                        \"err\": repr(exc)[:500],\n  5443\t                        \"tool_calls\": [],\n  5444\t                        \"events\": [],\n  5445\t                    }\n  5446\t                    break\n  5447\t                except BaseException:\n  5448\t                    if new_run is None:\n  5449\t                        if t_held:\n  5450\t                            _release_turn_slot()\n  5451\t                        if holds_slot:\n  5452\t                            POOL.release()\n  5453\t                    raise\n  5454\t                run = new_run\n  5455\t                open_attempt = (plan, run)\n  5456\t                try:\n  5457\t                    out = self._execute(\n  5458\t                        run,\n  5459\t                        keepalive,\n  5460\t                        ctx[\"emulate_tools\"],\n  5461\t                        sse_writer,\n  5462\t                    )\n  5463\t                finally:\n  5464\t                    try:\n  5465\t                        run.close()\n  5466\t                    finally:\n  5467\t                        if managed_turn is not None:\n  5468\t                            managed_turn.release_slot_once()\n  5469\t                        _release_turn_slot()\n  5470\t                ok = bool(run.ok and out.get(\"state\") == \"done\" and out.get(\"rc\") == 0)\n  5471\t                try:\n  5472\t                    committed_turns = _finish_attempt(\n  5473\t                        chat, plan, run, out, ok, cfg, rpc[\"items\"]\n  5474\t                    )\n  5475\t                except PersistError:\n  5476\t                    # Commit не записан: успешный ответ клиенту не выдаётся, повтор хода не делаем.\n  5477\t                    open_attempt = None\n  5478\t                    out = {\n  5479\t                        \"state\": \"persist_error\",\n  5480\t                        \"rc\": 1,\n  5481\t                        \"text\": \"\",\n  5482\t                        \"usage\": {},\n  5483\t                        \"result\": {},\n  5484\t                        \"err\": \"chat state commit failed\",\n  5485\t                        \"tool_calls\": [],\n  5486\t                        \"events\": [],\n  5487\t                    }\n  5488\t                    break\n  5489\t                open_attempt = None\n  5490\t                if ok:\n  5491\t                    break\n  5492\t                # Без sse_writer контент до terminal не отдаётся, delivered здесь — страховка.\n  5493\t                # С sse_writer часть контента могла уже уйти клиенту ЖИВЬЁМ до сбоя (run._live_mids\n  5494\t                # непусто) — тихий повтор показал бы его клиенту повторно, поэтому тоже delivered.\n  5495\t                delivered = bool(\n  5496\t                    out.get(\"text\") or out.get(\"tool_calls\") or run._live_mids\n  5497\t                )\n  5498\t                if out[\"state\"] != \"done\" or delivered or attempt == 3:\n  5499\t                    break\n  5500\t                # Транзиентный сбой (rc!=0, клиенту ничего не выдано): повтор невидим;\n  5501\t                # он строится заново из истории запроса, а не повтором user в старую сессию.\n  5502\t                _log(\n  5503\t                    f\"transient failure rc={out['rc']} err={_err_summary(out.get('err'), 120)!r}, \"\n  5504\t                    f\"retry {attempt} {tag}\"\n  5505\t                )\n  5506\t                # Сбой egress не должен сохранять SKIP-префлайт: повтор идёт с полным префлайтом.\n  5507\t                _last_ok[0] = 0.0\n  5508\t                _sleep(2 * attempt)\n  5509\t            ok_done = bool(\n  5510\t                run is not None\n  5511\t                and run.ok\n  5512\t                and out.get(\"state\") == \"done\"\n  5513\t                and out.get(\"rc\") == 0\n  5514\t            )\n  5515\t            hot = bool(ok_done and run.path in (\"hot\", \"restore\"))\n  5516\t            usage = out.get(\"usage\") or {}\n  5517\t            rep_turns = committed_turns if ok_done else 0\n  5518\t            sess8 = ((run.sid if ok_done else plan[\"sid\"]) or \"\")[:8] or \"-\"\n  5519\t            raw_in = usage.get(\"input_tokens\", 0)\n  5520\t            raw_out = usage.get(\"output_tokens\", 0)\n  5521\t            cache_read = usage.get(\"cache_read_tokens\")\n  5522\t            cache_read_str = (\n  5523\t                str(cache_read)\n  5524\t                if isinstance(cache_read, int) and not isinstance(cache_read, bool)\n  5525\t                else \"-\"\n  5780\t        except (BrokenPipeError, ConnectionResetError, OSError):\n  5781\t            return\n  5782\t        for frame in TURN_MANAGER.iter_sse_stream(\n  5783\t            turn,\n  5784\t            from_seq=from_seq,\n  5785\t            keepalive_interval_s=min(10.0, KEEPALIVE_S),\n  5786\t            client_gone_fn=lambda: _client_gone(self.connection),\n  5787\t        ):\n  5788\t            if not self._emit(frame):\n  5789\t                TURN_MANAGER.mark_detached(turn.turn_id)\n  5790\t                return\n  5791\t\n  5792\t    # ---- HTTP --------------------------------------------------------------------\n  5793\t    def do_GET(self) -> None:  # noqa: N802\n  5794\t        self._trace = None\n  5795\t        path = self.path.split(\"?\", 1)[0]\n  5796\t        if path in (\"/health\", \"/v1/health\"):\n  5797\t            # Контракт из семи ключей прежний (расширять запрещено); ok = AND по обязательным\n  5798\t            # бэкендам (droid: невалидный receipt = spawn невозможен -> ok=false, RW-015),\n  5799\t            # active и max_concurrent суммируются по включённым бэкендам.\n  5800\t            required = [a for a in BACKENDS.adapters() if a.required]\n  5801\t            draining = _shutting_down or (\n  5802\t                _is_drain_enabled() and LIFECYCLE.is_draining()\n  5803\t            )\n  5804\t            self._send(\n  5805\t                200,\n  5806\t                {\n  5807\t                    \"ok\": all(a.is_healthy() for a in required),\n  5808\t                    \"transport\": \"droid-exec\",\n  5809\t                    \"model\": MODEL_ID,\n  5810\t                    \"active\": BACKENDS.active_total(),\n  5811\t                    \"max_concurrent\": BACKENDS.max_concurrent_total(),\n  5812\t                    \"tool_emulation\": True,\n  5813\t                    \"uptime_s\": int(time.time() - _started),\n  5814\t                },\n  5815\t                extra_headers={\"X-Bridge-Draining\": \"1\"} if draining else None,\n  5816\t            )\n  5817\t            return\n  5818\t        if self._handle_models_get():\n  5819\t            return\n  5820\t        if not _auth_ok(self):\n  5821\t            self._send(\n  5822\t                401,\n  5823\t                {\n  5824\t                    \"error\": {\n  5825\t                        \"message\": \"unauthorized\",\n  5826\t                        \"type\": \"auth_error\",\n  5827\t                        \"code\": 401,\n  5828\t                    }\n  5829\t                },\n  5830\t            )\n  5831\t            return\n  5832\t        if path == \"/v1/resilience\":\n  5833\t            self._send(\n  5834\t                200,\n  5835\t                RESILIENCE.snapshot(a.id for a in BACKENDS.adapters()),\n  5836\t            )\n  5837\t            return\n  5838\t        if _is_detached_enabled() and path.startswith(\"/v1/turns/\"):\n  5839\t            m_stream = re.fullmatch(r\"/v1/turns/([^/]+)/stream\", path)\n  5840\t            if m_stream:\n  5841\t                self._serve_turn_stream(m_stream.group(1))\n  5842\t                return\n  5843\t            m_turn = re.fullmatch(r\"/v1/turns/([^/]+)\", path)\n  5844\t            if m_turn:\n  5845\t                turn_id = m_turn.group(1)\n  6260\t            # (9) effort: строковый вне каталога клампится вниз к allowed модели.\n  6261\t            raw_effort = req.get(\"reasoning_effort\")\n  6262\t            effort_from_alias = raw_effort is None and alias_effort is not None\n  6263\t            if effort_from_alias:\n  6264\t                raw_effort = alias_effort\n  6265\t            if raw_effort is None:\n  6266\t                effort = model[\"default_effort\"]\n  6267\t                effort_source = \"default\"\n  6268\t            elif isinstance(raw_effort, str):\n  6269\t                candidate = raw_effort.strip()\n  6270\t                if not candidate:\n  6271\t                    effort = model[\"default_effort\"]\n  6272\t                    effort_source = \"default\"\n  6273\t                else:\n  6274\t                    effort, clamped = clamp_effort_downward(\n  6275\t                        candidate, model[\"efforts\"], model[\"default_effort\"]\n  6276\t                    )\n  6277\t                    effort_source = \"alias\" if effort_from_alias else \"request\"\n  6278\t                    if clamped:\n  6279\t                        _log(\n  6280\t                            f\"clamp reasoning_effort '{candidate}' -> '{effort}' for model {model_id}\"\n  6281\t                        )\n  6282\t            else:\n  6283\t                self._reject(\n  6284\t                    400,\n  6285\t                    \"unsupported_reasoning_effort\",\n  6286\t                    \"reasoning_effort must be a string\",\n  6287\t                    model_id,\n  6288\t                    model_len,\n  6289\t                )\n  6290\t                return\n  6291\t            # (9a) autonomy: low|medium|high|off -> `autonomyLevel` RPC\n  6292\t            # (off — read-only droid, Reviewer-пути); дефолт high (максимум).\n  6293\t            raw_autonomy = req.get(\"autonomy\")\n  6294\t            if raw_autonomy is None:\n  6295\t                autonomy = AUTONOMY_DEFAULT\n  6296\t                autonomy_source = \"default\"\n  6297\t            elif isinstance(raw_autonomy, str):\n  6298\t                candidate = raw_autonomy.strip()\n  6299\t                if not candidate:\n  6300\t                    autonomy = AUTONOMY_DEFAULT\n  6301\t                    autonomy_source = \"default\"\n  6302\t                elif candidate in AUTONOMY_LEVELS or candidate == AUTONOMY_OFF:\n  6303\t                    autonomy = candidate\n  6304\t                    autonomy_source = \"request\"\n  6305\t                else:\n  6306\t                    self._reject(\n  6307\t                        400,\n  6308\t                        \"unsupported_autonomy\",\n  6309\t                        \"autonomy is not allowed (low|medium|high|off)\",\n  6310\t                        model_id,\n  6311\t                        model_len,\n  6312\t                    )\n  6313\t                    return\n  6314\t            else:\n  6315\t                self._reject(\n  6316\t                    400,\n  6317\t                    \"unsupported_autonomy\",\n  6318\t                    \"autonomy must be a string\",\n  6319\t                    model_id,\n  6320\t                    model_len,\n  6321\t                )\n  6322\t                return\n  6323\t            # (10) reasoning-объект не поддерживаем.\n  6324\t            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n  6325\t                self._reject(\n  6326\t                    400,\n  6327\t                    \"unsupported_parameter\",\n  6328\t                    \"reasoning parameter is not supported\",\n  6329\t                    model_id,\n  6330\t                    model_len,\n  6331\t                )\n  6332\t                return\n  6333\t            # (10a) отказоустойчивость контекста: история вмещается в окно модели до всего прочего.\n  6334\t            gated = self._context_gate(req, model_id, model, model_len)\n  6335\t            if gated is None:\n  6440\t                _is_detached_enabled()\n  6441\t                and (\n  6442\t                    _client_gone is _DEFAULT_CLIENT_GONE\n  6443\t                    or bool(req_turn_id or resume_turn_id)\n  6444\t                )\n  6445\t                and not is_legacy_muse_sleep\n  6446\t            )\n  6447\t            managed_turn: ManagedTurn | None = None\n  6448\t            attached_existing = False\n  6449\t            if _is_detached_enabled():\n  6450\t                try:\n  6451\t                    managed_turn, attached_existing = (\n  6452\t                        TURN_MANAGER.create_or_attach_turn(\n  6453\t                            model=model_id,\n  6454\t                            backend=model[\"backend\"],\n  6455\t                            cwd=cwd,\n  6456\t                            messages=messages,\n  6457\t                            session_id=raw_key if keyed else \"\",\n  6458\t                            owner_token_hash=_owner_token_hash(self),\n  6459\t                            requested_turn_id=req_turn_id or None,\n  6460\t                            resume_turn_id=resume_turn_id or None,\n  6461\t                            stream=bool(req.get(\"stream\")),\n  6462\t                            emulate_tools=emulate_tools,\n  6463\t                            idle_timeout_s=(\n  6464\t                                SILENCE_WATCHDOG_S\n  6465\t                                if _is_watchdog_enabled()\n  6466\t                                else TIMEOUT_S\n  6467\t                            ),\n  6468\t                            safety_cap_s=TIMEOUT_S,\n  6469\t                        )\n  6470\t                    )\n  6471\t                except PermissionError:\n  6472\t                    self._reject(\n  6473\t                        403,\n  6474\t                        \"forbidden\",\n  6475\t                        \"turn belongs to another token\",\n  6476\t                        model_id,\n  6477\t                        model_len,\n  6478\t                    )\n  6479\t                    return\n  6480\t                except ValueError as exc:\n  6481\t                    self._reject(400, \"invalid_request\", str(exc), model_id, model_len)\n  6482\t                    return\n  6483\t            self._active_managed_turn = managed_turn\n  6484\t            ctx = {\n  6485\t                \"request_id\": self._trace.request_id if self._trace else None,\n  6486\t                \"subagent_id\": self._trace.subagent_id if self._trace else None,\n  6487\t                \"route\": route,\n  6488\t                \"key_hash\": _key_hash(raw_key)\n  6489\t                if (route == \"keyed\" and isinstance(raw_key, str))\n  6490\t                else \"\",\n  6491\t                \"rpc\": transcript,\n  6492\t                \"instr\": instr if route in (\"keyed\", \"nokey\") else (0, \"-\", 0),\n  6493\t                \"model\": model_id,\n  6494\t                \"backend\": model[\"backend\"],\n  6495\t                \"model_len\": model_len,\n  6496\t                \"effort\": effort,\n  6497\t                \"effort_source\": effort_source,\n  6498\t                \"autonomy\": autonomy,\n  6499\t                \"autonomy_source\": autonomy_source,\n  6500\t                \"prompt\": prompt,\n  6501\t                \"images\": images,\n  6502\t                \"cwd\": cwd,\n  6503\t                \"fwd_env\": fwd_env,\n  6504\t                \"emulate_tools\": emulate_tools,\n  6505\t                \"tool_schemas\": build_tool_schemas(raw_tools),\n  6506\t                \"tag\": (\n  6507\t                    f\"client={self._client_tag()} \"\n  6508\t                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n  6509\t                ),\n  6510\t                \"stream\": bool(req.get(\"stream\")),\n  6511\t                \"turn_id\": managed_turn.turn_id if managed_turn is not None else \"\",\n  6512\t                \"managed_turn\": managed_turn,\n  6513\t                \"detach_on_disconnect\": detach_on_disconnect,\n  6514\t                \"attached_existing\": attached_existing,\n  6515\t            }\n  6516\t            _log(\n  6517\t                f\"chat route=cli model={model_id} alias={model_id + '-' + alias[1] if alias else '-'} {self._trace_log_fields()}\"\n  6518\t            )\n  6519\t            serve = (\n  6520\t                (lambda: self._serve_sse(ctx))\n  6521\t                if ctx[\"stream\"]\n  6522\t                else (lambda: self._serve_json(ctx))\n  6523\t            )\n  6524\t            if attached_existing:\n  6525\t                # Присоединение к уже идущему ходу нового вызова бэкенда не создаёт: допуск не нужен.\n  6526\t                serve()\n  6527\t            else:\n  6528\t                self._serve_resilient(model[\"backend\"], serve)\n  6529\t        finally:\n  6530\t            if (\n  6531\t                managed_turn is not None\n  6532\t                and not attached_existing\n  6533\t                and managed_turn.is_active\n  6534\t            ):\n  6535\t                TURN_MANAGER.finalize_abandoned_turn(managed_turn)\n  6536\t            self._active_managed_turn = None\n  6537\t            if reserved and budget is not None:\n  6538\t                budget.release(reserved)\n  6539\t            _DELIVERY_BUDGET.release(self._delivery_reserved)\n  6540\t            self._delivery_reserved = 0\n  6541\t\n  6542\t    def _forwarded_env(\n  6543\t        self, extra: Any, model_id: str, model_len: int\n  6544\t    ) -> \"dict[str, str] | None | bool\":\n  6545\t        \"\"\"`extra_body.env` под флагом GigaRC (ADR-0016): dict | None; False — 400 уже отправлен.\n  6546\t\n  6547\t        Флаг выключен — поле игнорируется целиком (поведение прежнее). Включён: запрещённые и\n  6548\t        невалидные имена/значения отбрасываются, не-loopback `AGENT_BROWSER_CDP` — 400. Если клиент\n  6549\t        прислал непустой env без `AGENT_BROWSER_CDP`, мост подставляет локально найденный loopback CDP.\n  6550\t        \"\"\"\n  7340\t\n  7341\tBridgeHandler = Handler\n  7342\t\n  7343\t\n  7344\tclass Server(ThreadingHTTPServer):\n  7345\t    \"\"\"HTTP-сервер с семафором числа соединений на уровне приёма (C-11).\"\"\"\n  7346\t\n  7347\t    daemon_threads = True\n  7348\t    request_queue_size = 64\n  7349\t    allow_reuse_address = True\n  7350\t\n  7351\t    def __init__(self, *args: Any, **kwargs: Any):\n  7352\t        super().__init__(*args, **kwargs)\n  7353\t        self._conn_sem = threading.BoundedSemaphore(\n  7354\t            int(FLEET[\"admission\"][\"max_http_connections\"])\n  7355\t        )\n  7356\t\n  7357\t    def _send_raw_503(self, request: socket.socket) -> None:\n  7358\t        body = json.dumps(\n  7359\t            {\n  7360\t                \"error\": {\n  7361\t                    \"message\": \"bridge overloaded: connection limit\",\n  7362\t                    \"type\": \"overloaded\",\n  7363\t                    \"code\": 503,\n  7364\t                },\n  7365\t            }\n  7366\t        ).encode(\"utf-8\")\n  7367\t        head = (\n  7368\t            b\"HTTP/1.1 503 Service Unavailable\\r\\n\"\n  7369\t            b\"Content-Type: application/json; charset=utf-8\\r\\n\"\n  7370\t            b\"Content-Length: \" + str(len(body)).encode() + b\"\\r\\n\"\n  7371\t            b\"Connection: close\\r\\n\\r\\n\"\n  7372\t        )\n  7373\t        request.sendall(head + body)\n  7374\t\n  7375\t    def process_request(self, request: Any, client_address: Any) -> None:\n  7376\t        if not self._conn_sem.acquire(blocking=False):\n  7377\t            try:\n  7378\t                peer = f\"{client_address[0]}:{client_address[1]}\"\n  7379\t            except (TypeError, IndexError):\n  7380\t                peer = \"unknown\"\n  7381\t            _log(f\"reject reason=overloaded model=unknown model_len=0 client={peer}\")\n  7382\t            try:\n  7383\t                if isinstance(request, socket.socket):\n  7384\t                    self._send_raw_503(request)\n  7385\t            except OSError:\n  7386\t                pass\n  7387\t            self.shutdown_request(request)\n  7388\t            return\n  7389\t        super().process_request(request, client_address)\n  7390\t\n  7391\t    def process_request_thread(self, request: Any, client_address: Any) -> None:\n  7392\t        try:\n  7393\t            super().process_request_thread(request, client_address)\n  7394\t        finally:\n  7395\t            self._conn_sem.release()\n  7396\t\n  7397\t\n  7398\tdef _sweep_workspace(cutoff_s: float = 3600.0) -> None:\n  7399\t    \"\"\"Удалить ходы muse и prompt-*/img-* старше cutoff (наследие упавших ходов, RW-010).\n  7400\t\n  7401\t    Подметаются per-turn подкаталоги muse (`muse/turn-*`) и legacy `muse/prompt-*.txt`:\n  7402\t    после SIGKILL хаба они остаются без владельца. `cutoff_s=0` — уборка на shutdown.\n  7403\t    \"\"\"\n  7404\t    cutoff = time.time() - cutoff_s\n  7405\t    for pattern in (\"prompt-*.txt\", \"muse/prompt-*.txt\", \"muse/turn-*\"):\n111:    except ValueError:\n119:    except ValueError:\n129:    except ValueError:\n210:class ClientGone(Exception):\n248:    \"\"\"Куда шов пишет ответ клиенту; реализует хаб (`server.py`). Любая ошибка записи -> ClientGone.\"\"\"\n250:    def start(self, status: int, headers: list[tuple[str, str]]) -> None:\n444:    except (ValueError, UnicodeDecodeError):\n731:            except ValueError:\n883:    except AccumulatorOverflow:\n894:    except UpstreamBodyTooLarge:\n910:    status: int, error_type: str, message: str\n913:        {\"error\": {\"message\": message, \"type\": error_type, \"code\": status}},\n1042:    def handle(\n1065:            except socket.timeout:\n1070:            except (OSError, http.client.HTTPException):\n1074:        except ClientGone:\n1113:        self, sink: ResponseSink, status: int, error_type: str, message: str\n1115:        self._log(f\"passthrough fail status={status} type={error_type}\")\n1116:        headers, body = _json_error(status, error_type, message)\n1117:        sink.start(status, headers)\n1118:        sink.write(body)\n1137:        if resp.status == 200 and \"text/event-stream\" in content_type:\n1