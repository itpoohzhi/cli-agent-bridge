   # изолированная сессия с replay истории запроса.\n  6403\t            transcript = _transcribe(messages, tools, tool_choice, images)\n  6404\t            raw_key = req.get(\"prompt_cache_key\")\n  6405\t            keyed = isinstance(raw_key, str) and 0 < len(raw_key) <= KEY_MAX_LEN\n  6406\t            if images:\n  6407\t                route = \"image\"\n  6408\t            elif _is_title_request(messages, tools, req):\n  6409\t                route = \"title\"\n  6410\t            elif not transcript[\"runnable\"]:\n  6411\t                route = \"fallback\"\n  6412\t                transcript = {\n  6413\t                    \"system\": None,\n  6414\t                    \"runnable\": True,\n  6415\t                    \"items\": [\n  6416\t                        {\"role\": \"user\", \"text\": prompt, \"digest\": _digest(prompt)}\n  6417\t                    ],\n  6418\t                }\n  6419\t            elif keyed:\n  6420\t                route = \"keyed\"\n  6421\t            else:\n  6422\t                route = \"nokey\"\n  6423\t            instr = self._prompt_guard(\n  6424\t                messages, route, raw_key, cwd, model_id, model_len, adapter\n  6425\t            )\n  6426\t            if instr is None:\n  6427\t                return\n  6428\t            is_legacy_muse_sleep = (\n  6429\t                model[\"backend\"] == \"muse\"\n  6430\t                and not req_turn_id\n  6431\t                and not resume_turn_id\n  6432\t                and not keyed\n  6433\t                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\").is_file()\n  6434\t                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\")\n  6435\t                .read_text(encoding=\"utf-8\", errors=\"ignore\")\n  6436\t                .strip()\n  6437\t                == \"sleep\"\n  6438\t            )\n  6439\t            detach_on_disconnect = (\n  6440\t                _is_detached_enabled()\n  6441\t                and (\n  6442\t                    _client_gone is _DEFAULT_CLIENT_GONE\n1067:class LauncherUnavailable(Exception):\n1080:    raise LauncherUnavailable(LAUNCHER)\n1092:    \"\"\"Проверка протокола, политики tools и профиля настроек receipt; расхождение — LauncherUnavailable.\"\"\"\n1100:        raise LauncherUnavailable(\n1112:        raise LauncherUnavailable(\"droid receipt: tools policy mismatch\")\n1119:        raise LauncherUnavailable(\"droid receipt: settings profile mismatch\")\n1124:        raise LauncherUnavailable(\"droid receipt: qualification probes are not all ok\")\n1128:    \"\"\"(путь образа, receipt) либо LauncherUnavailable; ('', None) — gate выключен.\n1140:        raise LauncherUnavailable(\"droid receipt missing or unreadable\")\n1142:        raise LauncherUnavailable(\n1152:        raise LauncherUnavailable(\"droid receipt malformed\")\n1160:        raise LauncherUnavailable(\n1164:        raise LauncherUnavailable(\"droid image sha256 does not match receipt\")\n1170:    \"\"\"Путь квалифицированного образа из receipt ('' — gate выключен) либо LauncherUnavailable.\"\"\"\n1180:    except LauncherUnavailable:\n1985:                    continue  # шум лончера/preflight, как и раньше\n3765:        except LauncherUnavailable as exc:\n3780:        except LauncherUnavailable as exc:\n5248:            except LauncherUnavailable:\n5807:                    \"ok\": all(a.is_healthy() for a in required),\n6353:                (False, \"backend_disabled\") if adapter is None else adapter.preflight()\n7450:        except LauncherUnavailable as exc:\n","exit_code":0,"status":"completed"}}
