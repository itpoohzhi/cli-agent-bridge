{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 - <<'PY'\nimport io\nfrom types import SimpleNamespace\nimport server\nfrom adapters.passthrough_adapter import PassthroughAdapter\nfrom core.resilience import ResilienceManager, ResilienceFlags\nclass Source:\n    def read(self):\n        return {'RESILIENCE_ENABLED': True, 'CIRCUIT_BREAKER_ENABLED': True}\nclass Response:\n    def getheaders(self): return [('Content-Type','text/event-stream')]\n    def readline(self, *args): raise TimeoutError('upstream stalled')\nadapter = PassthroughAdapter('b', {'base_url':'http://127.0.0.1:1234/v1', 'max_concurrent':64}, lambda: {}, sanitize=False)\nadapter.handle = lambda **kw: adapter._relay_stream(Response(), None, kw['sink'], False)\nserver._log = lambda msg: None\nmanager = ResilienceManager(ResilienceFlags(Source(), env={}))\nhandler = server.Handler.__new__(server.Handler)\nhandler.path='/v1/chat/completions'\nhandler.headers={}\nhandler._trace=None\nhandler._trace_log_fields=lambda: ''\nhandler.send_response=lambda *a: None\nhandler.send_header=lambda *a: None\nhandler.end_headers=lambda: None\nhandler.wfile=io.BytesIO()\nfor _ in range(4):\n    with manager.acquire('b') as lease:\n        handler._resilience_lease=lease\n        server.Handler._serve_passthrough(handler, adapter, b'{}', {}, 'model')\nprint('4 upstream timeouts:', manager.snapshot()['backends']['b'])\nprint('client saw upstream_stream_error:', b'upstream_stream_error' in handler.wfile.getvalue())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
