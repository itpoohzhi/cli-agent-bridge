{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KoWQhUNizMFabPQbCHWVEh","type":"tool_result","content":"1\t\"\"\"Универсальные паттерны отказоустойчивости шлюза (ADR-0020 Rev 4).\n2\t\n3\tCircuit Breaker с generation tokens, Bulkhead (изоляция параллелизма по `backend_id`) и\n4\tRetryPolicy (экспоненциальный бэкофф с Full Jitter и контролем дедлайна). Модуль чистый:\n5\tstdlib-only, без знания об адаптерах и именах агентов — ключ изоляции это строка `backend_id`.\n6\t\n7\tИнвариант владельца: автоматического fallback на другую модель/провайдер нет. Недоступный\n8\tбэкенд = честный отказ вызывающему (`CircuitBreakerOpen` / `BulkheadCapacityExceeded`),\n9\tкоторый фасад превращает в HTTP 503 с `Retry-After`.\n10\t\n11\tВсе механизмы закрыты флагами GigaRC (дефолт `false`, снимок + env-override, см.\n12\t`ResilienceFlags`); пороги и задержки — только из настроек с безопасными fallback-значениями.\n13\t\"\"\"\n14\t\n15\tfrom __future__ import annotations\n16\t\n17\timport enum\n18\timport json\n19\timport math\n20\timport os\n21\timport random\n22\timport stat\n23\timport subprocess\n24\timport threading\n25\timport time\n26\tfrom collections.abc import Callable, Iterable, Mapping\n27\tfrom dataclasses import dataclass\n28\tfrom datetime import datetime, timezone\n29\tfrom types import TracebackType\n30\tfrom typing import Any, Protocol\n31\t\n32\t# --------------------------------------------------------------------------- исключения\n33\t\n34\t\n35\tclass ResilienceError(Exception):\n36\t    \"\"\"База отказов слоя отказоустойчивости: запрос отклонён до обращения к бэкенду.\"\"\"\n37\t\n38\t    error_code = \"RESILIENCE_ERROR\"\n39\t    error_type = \"resilience_error\"\n40\t\n41\t    def __init__(self, backend_id: str, retry_after: int, message: str = \"\") -> None:\n42\t        self.backend_id = backend_id\n43\t        self.retry_after = max(1, int(retry_after))\n44\t        self.reason = message\n45\t        super().__init__(\n46\t            message or f\"backend '{backend_id}' is temporarily unavailable\"\n47\t        )\n48\t\n49\t\n50\tclass CircuitBreakerOpen(ResilienceError):\n51\t    \"\"\"Брейкер бэкенда разомкнут (или проба HALF_OPEN уже занята): fail-fast.\"\"\"\n52\t\n53\t    error_code = \"CIRCUIT_BREAKER_OPEN\"\n54\t\n55\t    def __init__(self, backend_id: str, retry_after: int) -> None:\n56\t        super().__init__(backend_id, retry_after, \"circuit breaker is open\")\n57\t\n58\t\n59\tclass BulkheadCapacityExceeded(ResilienceError):\n60\t    \"\"\"Ёмкость отсека бэкенда исчерпана: отказ за O(1), без ожидания слота.\"\"\"\n61\t\n62\t    error_code = \"BULKHEAD_CAPACITY_EXCEEDED\"\n63\t\n64\t    def __init__(self, backend_id: str, retry_after: int) -> None:\n65\t        super().__init__(backend_id, retry_after, \"bulkhead capacity exceeded\")\n66\t\n67\t\n68\t# --------------------------------------------------------------------------- настройки и флаги\n69\t\n70\t_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n71\t_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n72\t\n73\tFLAG_RESILIENCE = \"RESILIENCE_ENABLED\"\n74\tFLAG_CIRCUIT_BREAKER = \"CIRCUIT_BREAKER_ENABLED\"\n75\tFLAG_BULKHEAD = \"BULKHEAD_ENABLED\"\n76\tFLAG_RETRY = \"RETRY_ENABLED\"\n77\tFLAG_NAMES = (FLAG_RESILIENCE, FLAG_CIRCUIT_BREAKER, FLAG_BULKHEAD, FLAG_RETRY)\n78\t\n79\tENV_PREFIX = \"BRIDGE_\"\n80\t\n81\tSNAPSHOT_MAX_BYTES = 64 * 1024\n82\t\n83\t\n84\t@dataclass(frozen=True)\n85\tclass ResilienceSettings:\n86\t    \"\"\"Иммутабельный снимок флагов и порогов на время одного запроса.\n87\t\n88\t    `circuit_breaker`/`bulkhead`/`retry` уже учитывают мастер-флаг `enabled`.\n89\t    \"\"\"\n90\t\n91\t    enabled: bool = False\n92\t    circuit_breaker: bool = False\n93\t    bulkhead: bool = False\n94\t    retry: bool = False\n95\t    bulkhead_max_concurrent: int = 64\n96\t    bulkhead_retry_after_s: int = 1\n97\t    fail_threshold: int = 3\n98\t    cooldown_s: float = 30.0\n99\t    cooldown_jitter: float = 0.2\n100\t    retry_max_attempts: int = 3\n101\t    retry_base_delay_s: float = 1.0\n102\t    retry_max_delay_s: float = 10.0\n103\t    retry_backoff_factor: float = 2.0\n104\t\n105\t\n106\tclass FlagSource(Protocol):\n107\t    \"\"\"Источник булевых флагов GigaRC: `{имя: bool}`; отсутствие флага = false.\"\"\"\n108\t\n109\t    def read(self) -> Mapping[str, bool]: ...\n110\t\n111\t\n112\tdef default_snapshot_path() -> str:\n113\t    return os.path.expanduser(\"~/.config/cli-agent-bridge/resilience.snapshot.json\")\n114\t\n115\t\n116\tdef _parse_utc(value: Any) -> float:\n117\t    if not isinstance(value, str) or not value:\n118\t        raise ValueError(\"timestamp\")\n119\t    text = value[:-1] + \"+00:00\" if value.endswith(\"Z\") else value\n120\t    parsed = datetime.fromisoformat(text)\n121\t    if parsed.tzinfo is None:\n122\t        raise ValueError(\"timestamp without tz\")\n123\t    return parsed.astimezone(timezone.utc).timestamp()\n124\t\n125\t\n126\t@dataclass(frozen=True)\n127\tclass _Snapshot:\n128\t    generated_at: float\n129\t    expires_at: float\n130\t    flags: Mapping[str, bool]\n131\t\n132\t\n133\tclass SnapshotFlagSource:\n134\t    \"\"\"Читатель локального атомарного JSON-снимка GigaRC: lastgood, default=false, без исключений.\n135\t\n136\t    Снимок: `{\"schema_version\": 1, \"generated_at\": ISO, \"expires_at\": ISO, \"flags\": {...}}`.\n137\t    Любой сбой (нет файла, мусор, чужие права, симлинк) оставляет lastgood, а при его\n138\t    отсутствии все флаги false. `true` живёт только пока снимок свеж, `false` — бессрочно.\n139\t    \"\"\"\n140\t\n141\t    def __init__(\n142\t        self,\n143\t        path: str | None = None,\n144\t        *,\n145\t        clock: Callable[[], float] = time.time,\n146\t        max_true_age_s: float | None = None,\n147\t    ) -> None:\n148\t        self._path = path or os.environ.get(\n149\t            ENV_PREFIX + \"RESILIENCE_SNAPSHOT_PATH\", default_snapshot_path()\n150\t        )\n151\t        self._clock = clock\n152\t        self._max_true_age_s = (\n153\t            max_true_age_s\n154\t            if max_true_age_s is not None\n155\t            else _env_float(\n156\t                os.environ,\n157\t                (ENV_PREFIX + \"RESILIENCE_SNAPSHOT_MAX_AGE_S\",),\n158\t                30.0,\n159\t                minimum=0.0,\n160\t            )\n161\t        )\n162\t        self._lock = threading.Lock()\n163\t        self._sig: tuple[int, int, int, int] | None = None\n164\t        self._last: _Snapshot | None = None\n165\t\n166\t    def read(self) -> Mapping[str, bool]:\n167\t        with self._lock:\n168\t            try:\n169\t                fresh = self._load()\n170\t            except Exception:  # noqa: BLE001 - гонка/мусор не должны ронять запрос\n171\t                fresh = None\n172\t            if fresh is not None:\n173\t                self._last = fresh\n174\t            snap = self._last\n175\t            if snap is None:\n176\t                return {}\n177\t            now = self._clock()\n178\t            alive = (\n179\t                now < snap.expires_at\n180\t                and (now - snap.generated_at) <= self._max_true_age_s\n181\t            )\n182\t            return {name: value and alive for name, value in snap.flags.items()}\n183\t\n184\t    def _load(self) -> _Snapshot | None:\n185\t        euid = os.geteuid()\n186\t        st = os.lstat(self._path)\n187\t        if not stat.S_ISREG(st.st_mode):\n188\t            return None\n189\t        sig = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)\n190\t        if sig == self._sig and self._last is not None:\n191\t            return self._last\n192\t        parent = os.stat(os.path.dirname(self._path) or \".\")\n193\t        if parent.st_uid != euid or parent.st_mode & 0o077:\n194\t            return None\n195\t        fd = os.open(\n196\t            self._path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, \"O_CLOEXEC\", 0)\n197\t        )\n198\t        try:\n199\t            before = os.fstat(fd)\n200\t            if (\n201\t                not stat.S_ISREG(before.st_mode)\n202\t                or before.st_uid != euid\n203\t                or before.st_mode & 0o077\n204\t                or before.st_size > SNAPSHOT_MAX_BYTES\n205\t            ):\n206\t                return None\n207\t            raw = os.read(fd, SNAPSHOT_MAX_BYTES + 1)\n208\t        finally:\n209\t            os.close(fd)\n210\t        data = json.loads(raw.decode(\"utf-8\"))\n211\t        if not isinstance(data, dict) or data.get(\"schema_version\") != 1:\n212\t            return None\n213\t        flags = data.get(\"flags\")\n214\t        if not isinstance(flags, dict):\n215\t            return None\n216\t        snap = _Snapshot(\n217\t            generated_at=_parse_utc(data.get(\"generated_at\")),\n218\t            expires_at=_parse_utc(data.get(\"expires_at\")),\n219\t            flags={k: v for k, v in flags.items() if isinstance(v, bool)},\n220\t        )\n221\t        self._sig = sig\n222\t        return snap\n223\t\n224\t\n225\tdef _env_bool(env: Mapping[str, str], name: str) -> bool | None:\n226\t    raw = env.get(ENV_PREFIX + name)\n227\t    if raw is None:\n228\t        return None\n229\t    text = raw.strip().lower()\n230\t    if text in _TRUE:\n231\t        return True\n232\t    if text in _FALSE:\n233\t        return False\n234\t    return None\n235\t\n236\t\n237\tdef _env_float(\n238\t    env: Mapping[str, str],\n239\t    names: Iterable[str],\n240\t    default: float,\n241\t    *,\n242\t    minimum: float = 0.0,\n243\t    allow_equal: bool = True,\n244\t) -> float:\n245\t    \"\"\"Первое валидное значение из списка имён (основное имя, затем алиасы), иначе default.\"\"\"\n246\t    for name in names:\n247\t        raw = env.get(name)\n248\t        if raw is None:\n249\t            continue\n250\t        try:\n251\t            value = float(raw)\n252\t        except ValueError:\n253\t            continue\n254\t        if math.isfinite(value) and (\n255\t            value >= minimum if allow_equal else value > minimum\n256\t        ):\n257\t            return value\n258\t    return default\n259\t\n260\t\n261\tdef _env_int(\n262\t    env: Mapping[str, str], names: Iterable[str], default: int, *, minimum: int = 1\n263\t) -> int:\n264\t    for name in names:\n265\t        raw = env.get(name)\n266\t        if raw is None:\n267\t            continue\n268\t        try:\n269\t            value = int(raw.strip())\n270\t        except ValueError:\n271\t            continue\n272\t        if value >= minimum:\n273\t            return value\n274\t    return default\n275\t\n276\t\n277\tclass ResilienceFlags:\n278\t    \"\"\"Флаги GigaRC (дефолт false) + пороги из env; env перекрывает снимок, снимок — default.\n279\t\n280\t    Булев флаг: `BRIDGE_<ИМЯ>` из env (если задан и валиден) → значение снимка GigaRC →\n281\t    `False`. Env `false` — аварийный kill-switch поверх снимка. Мастер-флаг `RESILIENCE_ENABLED`\n282\t    должен быть истинным, иначе остальные не действуют. Читается на каждый запрос: смена\n283\t    флага вступает в силу без рестарта.\n284\t    \"\"\"\n285\t\n286\t    def __init__(\n287\t        self,\n288\t        source: FlagSource | None = None,\n289\t        env: Mapping[str, str] | None = None,\n290\t    ) -> None:\n291\t        self._source: FlagSource = (\n292\t            source if source is not None else SnapshotFlagSource()\n293\t        )\n294\t        self._env = env\n295\t\n296\t    def current(self) -> ResilienceSettings:\n297\t        env: Mapping[str, str] = self._env if self._env is not None else os.environ\n298\t        try:\n299\t            snap = self._source.read()\n300\t        except Exception:  # noqa: BLE001 - источник флагов не должен ронять запрос\n301\t            snap = {}\n302\t\n303\t        def flag(name: str) -> bool:\n304\t            override = _env_bool(env, name)\n305\t            return override if override is not None else bool(snap.get(name, False))\n306\t\n307\t        master = flag(FLAG_RESILIENCE)\n308\t        if not master:\n309\t            return ResilienceSettings()\n310\t        p = ENV_PREFIX\n311\t        return ResilienceSettings(\n312\t            enabled=True,\n313\t            circuit_breaker=flag(FLAG_CIRCUIT_BREAKER),\n314\t            bulkhead=flag(FLAG_BULKHEAD),\n315\t            retry=flag(FLAG_RETRY),\n316\t            bulkhead_max_concurrent=_env_int(\n317\t                env,\n318\t                (\n319\t                    p + \"BULKHEAD_MAX_CONCURRENT\",\n320\t                    p + \"BULKHEAD_MAX_PASSTHROUGH\",\n321\t                ),\n322\t                64,\n323\t            ),\n324\t            bulkhead_retry_after_s=_env_int(env, (p + \"BULKHEAD_RETRY_AFTER_S\",), 1),\n325\t            fail_threshold=_env_int(\n326\t                env,\n327\t                (p + \"CIRCUIT_BREAKER_FAIL_THRESHOLD\", p + \"CB_FAIL_THRESHOLD\"),\n328\t                3,\n329\t            ),\n330\t            cooldown_s=_env_float(\n331\t                env,\n332\t                (p + \"CIRCUIT_BREAKER_COOLDOWN_S\", p + \"CB_RESET_TIMEOUT_S\"),\n333\t                30.0,\n334\t                minimum=0.0,\n335\t                allow_equal=False,\n336\t            ),\n337\t            cooldown_jitter=min(\n338\t                _env_float(env, (p + \"CIRCUIT_BREAKER_JITTER\",), 0.2, minimum=0.0),\n339\t                0.9,\n340\t            ),\n341\t            retry_max_attempts=_env_int(env, (p + \"RETRY_MAX_ATTEMPTS\",), 3),\n342\t            retry_base_delay_s=_env_float(\n343\t                env,\n344\t                (p + \"RETRY_BASE_DELAY_S\", p + \"RETRY_BASE_SLEEP_S\"),\n345\t                1.0,\n346\t                minimum=0.0,\n347\t            ),\n348\t            retry_max_delay_s=_env_float(\n349\t                env,\n350\t                (p + \"RETRY_MAX_DELAY_S\", p + \"RETRY_MAX_SLEEP_S\"),\n351\t                10.0,\n352\t                minimum=0.0,\n353\t            ),\n354\t            retry_backoff_factor=_env_float(\n355\t                env, (p + \"RETRY_BACKOFF_FACTOR\",), 2.0, minimum=1.0\n356\t            ),\n357\t        )\n358\t\n359\t\n360\t# --------------------------------------------------------------------------- Circuit Breaker\n361\t\n362\t\n363\tclass CircuitBreakerState(enum.Enum):\n364\t    CLOSED = \"CLOSED\"\n365\t    OPEN = \"OPEN\"\n366\t    HALF_OPEN = \"HALF_OPEN\"\n367\t\n368\t\n369\tclass CircuitBreaker:\n370\t    \"\"\"Потокобезопасный автомат CLOSED → OPEN → HALF_OPEN с поколениями (generation tokens).\n371\t\n372\t    Каждый переход состояния увеличивает `_generation`. Допущенный вызов получает\n373\t    `(allowed, generation, is_probe)`; результат с устаревшим поколением игнорируется,\n374\t    поэтому запоздавший ответ старого запроса не портит состояние. В HALF_OPEN допускается\n375\t    ровно одна проба; `record_discard` освобождает её слот без фиксации сбоя.\n376\t    Переход OPEN → HALF_OPEN ленивый — на первом `acquire` после cooldown.\n377\t    \"\"\"\n378\t\n379\t    def __init__(\n380\t        self,\n381\t        backend_id: str = \"\",\n382\t        *,\n383\t        fail_threshold: int = 3,\n384\t        cooldown_s: float = 30.0,\n385\t        cooldown_jitter: float = 0.2,\n386\t        clock: Callable[[], float] = time.monotonic,\n387\t        rng: Callable[[float, float], float] = random.uniform,\n388\t    ) -> None:\n389\t        self.backend_id = backend_id\n390\t        self._lock = threading.Lock()\n391\t        self._clock = clock\n392\t        self._rng = rng\n393\t        self._fail_threshold = max(1, int(fail_threshold))\n394\t        self._cooldown_s = float(cooldown_s)\n395\t        self._cooldown_jitter = float(cooldown_jitter)\n396\t        self._state = CircuitBreakerState.CLOSED\n397\t        self._generation = 0\n398\t        self._failures = 0\n399\t        self._probe_in_flight = False\n400\t        self._open_until = 0.0\n401\t\n402\t    def configure(\n403\t        self,\n404\t        *,\n405\t        fail_threshold: int | None = None,\n406\t        cooldown_s: float | None = None,\n407\t        cooldown_jitter: float | None = None,\n408\t    ) -> None:\n409\t        \"\"\"Горячая смена порогов (GigaRC/env) без потери состояния.\"\"\"\n410\t        with self._lock:\n411\t            if fail_threshold is not None:\n412\t                self._fail_threshold = max(1, int(fail_threshold))\n413\t            if cooldown_s is not None:\n414\t                self._cooldown_s = float(cooldown_s)\n415\t            if cooldown_jitter is not None:\n416\t                self._cooldown_jitter = float(cooldown_jitter)\n417\t\n418\t    @property\n419\t    def state(self) -> CircuitBreakerState:\n420\t        with self._lock:\n421\t            return self._state\n422\t\n423\t    @property\n424\t    def generation(self) -> int:\n425\t        with self._lock:\n426\t            return self._generation\n427\t\n428\t    @property\n429\t    def failures(self) -> int:\n430\t        with self._lock:\n431\t            return self._failures\n432\t\n433\t    @property\n434\t    def retry_after(self) -> int:\n435\t        \"\"\"Целые секунды до следующей попытки; 0 — отказ не действует.\"\"\"\n436\t        with self._lock:\n437\t            return self._retry_after_locked(self._clock())\n438\t\n439\t    def _retry_after_locked(self, now: float) -> int:\n440\t        if self._state is CircuitBreakerState.OPEN:\n441\t            remaining = self._open_until - now\n442\t            return max(1, math.ceil(remaining)) if remaining > 0 else 0\n443\t        if self._state is CircuitBreakerState.HALF_OPEN and self._probe_in_flight:\n444\t            return 1\n445\t        return 0\n446\t\n447\t    def _transition_locked(self, state: CircuitBreakerState, now: float) -> None:\n448\t        self._state = state\n449\t        self._generation += 1\n450\t        self._failures = 0\n451\t        self._probe_in_flight = False\n452\t        if state is CircuitBreakerState.OPEN:\n453\t            # Джиттер считается один раз при входе в OPEN: Retry-After стабилен.\n454\t            spread = self._cooldown_jitter\n455\t            self._open_until = now + self._cooldown_s * self._rng(\n456\t                1.0 - spread, 1.0 + spread\n457\t            )\n458\t\n459\t    def acquire(self) -> tuple[bool, int, bool]:\n460\t        \"\"\"(allowed, generation, is_probe). Отказ — `allowed=False`, вызывать бэкенд нельзя.\"\"\"\n461\t        with self._lock:\n462\t            now = self._clock()\n463\t            if self._state is CircuitBreakerState.OPEN:\n464\t                if now < self._open_until:\n465\t                    return False, self._generation, False\n466\t                self._transition_locked(CircuitBreakerState.HALF_OPEN, now)\n467\t            if self._state is CircuitBreakerState.HALF_OPEN:\n468\t                if self._probe_in_flight:\n469\t                    return False, self._generation, False\n470\t                self._probe_in_flight = True\n471\t                return True, self._generation, True\n472\t            return True, self._generation, False\n473\t\n474\t    def record_success(self, generation: int) -> None:\n475\t        with self._lock:\n476\t            if generation != self._generation:\n477\t                return\n478\t            if self._state is CircuitBreakerState.HALF_OPEN:\n479\t                self._transition_locked(CircuitBreakerState.CLOSED, self._clock())\n480\t            elif self._state is CircuitBreakerState.CLOSED:\n481\t                self._failures = 0\n482\t\n483\t    def record_failure(self, generation: int, exc: BaseException | None = None) -> None:\n484\t        with self._lock:\n485\t            if generation != self._generation:\n486\t                return\n487\t            now = self._clock()\n488\t            if self._state is CircuitBreakerState.HALF_OPEN:\n489\t                self._transition_locked(CircuitBreakerState.OPEN, now)\n490\t            elif self._state is CircuitBreakerState.CLOSED:\n491\t                self._failures += 1\n492\t                if self._failures >= self._fail_threshold:\n493\t                    self._transition_locked(CircuitBreakerState.OPEN, now)\n494\t\n495\t    def record_discard(self, generation: int, reason: str = \"\") -> None:\n496\t        \"\"\"Нейтральный исход (обрыв клиента, 4xx): слот пробы свободен, счётчики не меняются.\"\"\"\n497\t        with self._lock:\n498\t            if generation != self._generation:\n499\t                return\n500\t            if self._state is CircuitBreakerState.HALF_OPEN:\n501\t                self._probe_in_flight = False\n502\t\n503\t    def snapshot(self) -> dict[str, Any]:\n504\t        with self._lock:\n505\t            return {\n506\t                \"state\": self._state.value,\n507\t                \"generation\": self._generation,\n508\t                \"failures\": self._failures,\n509\t                \"retry_after\": self._retry_after_locked(self._clock()),\n510\t            }\n511\t\n512\t\n513\t# --------------------------------------------------------------------------- Bulkhead\n514\t\n515\t\n516\tclass BulkheadLease:\n517\t    \"\"\"Занятый слот отсека; `close()` идемпотентен.\"\"\"\n518\t\n519\t    def __init__(self, bulkhead: Bulkhead) -> None:\n520\t        self._bulkhead: Bulkhead | None = bulkhead\n521\t        self._lock = threading.Lock()\n522\t\n523\t    def close(self) -> None:\n524\t        with self._lock:\n525\t            bulkhead, self._bulkhead = self._bulkhead, None\n526\t        if bulkhead is not None:\n527\t            bulkhead._release()\n528\t\n529\t\n530\tclass Bulkhead:\n531\t    \"\"\"Ограничитель параллелизма бэкенда на семафоре; захват неблокирующий (`timeout=0`).\"\"\"\n532\t\n533\t    def __init__(self, backend_id: str, capacity: int) -> None:\n534\t        self.backend_id = backend_id\n535\t        self.capacity = max(1, int(capacity))\n536\t        self._sem = threading.BoundedSemaphore(self.capacity)\n537\t        self._lock = threading.Lock()\n538\t        self._active = 0\n539\t\n540\t    @property\n541\t    def active(self) -> int:\n542\t        with self._lock:\n543\t            return self._active\n544\t\n545\t    def acquire(self, timeout: float = 0) -> BulkheadLease | None:\n546\t        if timeout <= 0:\n547\t            got = self._sem.acquire(blocking=False)\n548\t        else:\n549\t            got = self._sem.acquire(timeout=timeout)\n550\t        if not got:\n551\t            return None\n552\t        with self._lock:\n553\t            self._active += 1\n554\t        return BulkheadLease(self)\n555\t\n556\t    def _release(self) -> None:\n557\t        with self._lock:\n558\t            self._active -= 1\n559\t        self._sem.release()\n560\t\n561\t\n562\t# --------------------------------------------------------------------------- RetryPolicy\n563\t\n564\t\n565\tdef is_transient_backend_error(exc: BaseException | None) -> bool:\n566\t    \"\"\"Транзиентный технический сбой бэкенда, повтор допустим.\n567\t\n568\t    `None` — вызывающий зафиксировал сбой без исключения (например, upstream 5xx).\n569\t    Отказы самого слоя отказоустойчивости повторять нельзя.\n570\t    \"\"\"\n571\t    if exc is None:\n572\t        return True\n573\t    if isinstance(exc, ResilienceError):\n574\t        return False\n575\t    return isinstance(\n576\t        exc,\n577\t        (TimeoutError, ConnectionError, InterruptedError, subprocess.SubprocessError),\n578\t    )\n579\t\n580\t\n581\tclass RetryPolicy:\n582\t    \"\"\"Повторы с экспоненциальным бэкоффом и Full Jitter (агент-агностичная политика).\n583\t\n584\t    `attempt` — 0-based индекс только что упавшей попытки; всего попыток `max_attempts`.\n585\t    Задержка: `uniform(0, min(max_delay, base * factor ** attempt))`. Повтор запрещён, если\n586\t    клиенту уже отданы байты ответа (`bytes_delivered`) или исчерпан дедлайн.\n587\t    \"\"\"\n588\t\n589\t    def __init__(\n590\t        self,\n591\t        max_attempts: int = 3,\n592\t        base_delay_s: float = 1.0,\n593\t        max_delay_s: float = 10.0,\n594\t        backoff_factor: float = 2.0,\n595\t        *,\n596\t        rng: Callable[[float, float], float] = random.uniform,\n597\t        is_transient: Callable[\n598\t            [BaseException | None], bool\n599\t        ] = is_transient_backend_error,\n600\t    ) -> None:\n601\t        self.max_attempts = max(1, int(max_attempts))\n602\t        self.base_delay_s = max(0.0, float(base_delay_s))\n603\t        self.max_delay_s = max(0.0, float(max_delay_s))\n604\t        self.backoff_factor = max(1.0, float(backoff_factor))\n605\t        self._rng = rng\n606\t        self._is_transient = is_transient\n607\t\n608\t    @classmethod\n609\t    def from_settings(cls, settings: ResilienceSettings, **kwargs: Any) -> RetryPolicy:\n610\t        return cls(\n611\t            settings.retry_max_attempts,\n612\t            settings.retry_base_delay_s,\n613\t            settings.retry_max_delay_s,\n614\t            settings.retry_backoff_factor,\n615\t            **kwargs,\n616\t        )\n617\t\n618\t    def should_retry(\n619\t        self,\n620\t        attempt: int,\n621\t        bytes_delivered: bool,\n622\t        exc: BaseException | None = None,\n623\t    ) -> bool:\n624\t        if bytes_delivered or attempt + 1 >= self.max_attempts:\n625\t            return False\n626\t        return self._is_transient(exc)\n627\t\n628\t    def compute_delay(\n629\t        self, attempt: int, deadline_s: float | None = None\n630\t    ) -> float | None:\n631\t        \"\"\"Секунды сна перед повтором; None — повтор не укладывается в `deadline_s` (остаток).\n632\t\n633\t        Показатель степени ограничен, чтобы `factor ** attempt` не переполнялся.\n634\t        \"\"\"\n635\t        if deadline_s is not None and deadline_s <= 0:\n636\t            return None\n637\t        try:\n638\t            ceiling = self.base_delay_s * self.backoff_factor ** max(\n639\t                0, min(attempt, 1023)\n640\t            )\n641\t        except OverflowError:\n642\t            ceiling = math.inf\n643\t        delay = self._rng(0.0, min(self.max_delay_s, ceiling))\n644\t        if deadline_s is not None and delay >= deadline_s:\n645\t            return None\n646\t        return delay\n647\t\n648\t\n649\t# --------------------------------------------------------------------------- Lease и Manager\n650\t\n651\t\n652\tclass ResilienceLease:\n653\t    \"\"\"Контекстный менеджер одного запроса: слот Bulkhead + допуск брейкера.\n654\t\n655\t    Результат фиксируется только явно (`record_*`). Выход без исключения успехом не считается;\n656\t    выход с необработанным исключением фиксирует сбой. Первый явный исход финален.\n657\t    \"\"\"\n658\t\n659\t    def __init__(\n660\t        self,\n661\t        backend_id: str,\n662\t        breaker: CircuitBreaker | None = None,\n663\t        bulkhead_lease: BulkheadLease | None = None,\n664\t        generation: int = 0,\n665\t        is_probe: bool = False,\n666\t    ) -> None:\n667\t        self.backend_id = backend_id\n668\t        self.generation = generation\n669\t        self.is_probe = is_probe\n670\t        self._breaker = breaker\n671\t        self._bulkhead_lease = bulkhead_lease\n672\t        self._recorded = False\n673\t        self._lock = threading.Lock()\n674\t\n675\t    def _claim(self) -> bool:\n676\t        with self._lock:\n677\t            if self._recorded:\n678\t                return False\n679\t            self._recorded = True\n680\t            return True\n681\t\n682\t    @property\n683\t    def recorded(self) -> bool:\n684\t        return self._recorded\n685\t\n686\t    def record_success(self) -> None:\n687\t        if self._claim() and self._breaker is not None:\n688\t            self._breaker.record_success(self.generation)\n689\t\n690\t    def record_failure(self, exc: BaseException | None = None) -> None:\n691\t        if self._claim() and self._breaker is not None:\n692\t            self._breaker.record_failure(self.generation, exc)\n693\t\n694\t    def record_discard(self, reason: str = \"\") -> None:\n695\t        if self._claim() and self._breaker is not None:\n696\t            self._breaker.record_discard(self.generation, reason)\n697\t\n698\t    def close(self) -> None:\n699\t        with self._lock:\n700\t            lease, self._bulkhead_lease = self._bulkhead_lease, None\n701\t        if lease is not None:\n702\t            lease.close()\n703\t\n704\t    def __enter__(self) -> ResilienceLease:\n705\t        return self\n706\t\n707\t    def __exit__(\n708\t        self,\n709\t        exc_type: type[BaseException] | None,\n710\t        exc_val: BaseException | None,\n711\t        exc_tb: TracebackType | None,\n712\t    ) -> None:\n713\t        try:\n714\t            if exc_val is not None:\n715\t                self.record_failure(exc_val)\n716\t            elif not self.recorded and self.is_probe:\n717\t                # Проба без явного исхода не должна навсегда занять слот HALF_OPEN.\n718\t                self.record_discard(\"no_outcome\")\n719\t        finally:\n720\t            self.close()\n721\t\n722\t\n723\tclass ResilienceManager:\n724\t    \"\"\"Реестр CircuitBreaker и Bulkhead по `backend_id`; настройки читаются на каждый запрос.\"\"\"\n725\t\n726\t    def __init__(\n727\t        self,\n728\t        flags: ResilienceFlags | None = None,\n729\t        *,\n730\t        backend_limits: Mapping[str, int] | None = None,\n731\t        clock: Callable[[], float] = time.monotonic,\n732\t        rng: Callable[[float, float], float] = random.uniform,\n733\t    ) -> None:\n734\t        self._flags = flags if flags is not None else ResilienceFlags()\n735\t        self._backend_limits = dict(backend_limits or {})\n736\t        self._clock = clock\n737\t        self._rng = rng\n738\t        self._lock = threading.Lock()\n739\t        self._breakers: dict[str, CircuitBreaker] = {}\n740\t        self._bulkheads: dict[str, Bulkhead] = {}\n741\t\n742\t    def settings(self) -> ResilienceSettings:\n743\t        return self._flags.current()\n744\t\n745\t    def retry_policy(self) -> RetryPolicy | None:\n746\t        \"\"\"RetryPolicy по текущим настройкам; None — повторы выключены флагом.\"\"\"\n747\t        settings = self._flags.current()\n748\t        if not settings.retry:\n749\t            return None\n750\t        return RetryPolicy.from_settings(settings)\n751\t\n752\t    def _breaker_for(\n753\t        self, backend_id: str, settings: ResilienceSettings\n754\t    ) -> CircuitBreaker:\n755\t        with self._lock:\n756\t            breaker = self._breakers.get(backend_id)\n757\t            if breaker is None:\n758\t                breaker = CircuitBreaker(\n759\t                    backend_id,\n760\t                    fail_threshold=settings.fail_threshold,\n761\t                    cooldown_s=settings.cooldown_s,\n762\t                    cooldown_jitter=settings.cooldown_jitter,\n763\t                    clock=self._clock,\n764\t                    rng=self._rng,\n765\t                )\n766\t                self._breakers[backend_id] = breaker\n767\t        breaker.configure(\n768\t            fail_threshold=settings.fail_threshold,\n769\t            cooldown_s=settings.cooldown_s,\n770\t            cooldown_jitter=settings.cooldown_jitter,\n771\t        )\n772\t        return breaker\n773\t\n774\t    def _capacity(self, backend_id: str, settings: ResilienceSettings) -> int:\n775\t        cap = settings.bulkhead_max_concurrent\n776\t        return max(1, min(self._backend_limits.get(backend_id, cap), cap))\n777\t\n778\t    def _bulkhead_for(self, backend_id: str, settings: ResilienceSettings) -> Bulkhead:\n779\t        capacity = self._capacity(backend_id, settings)\n780\t        with self._lock:\n781\t            bulkhead = self._bulkheads.get(backend_id)\n782\t            if bulkhead is None or bulkhead.capacity != capacity:\n783\t                # Смена ёмкости: новый отсек; уже выданные слоты освободят старый семафор.\n784\t                bulkhead = Bulkhead(backend_id, capacity)\n785\t                self._bulkheads[backend_id] = bulkhead\n786\t            return bulkhead\n787\t\n788\t    def acquire(self, backend_id: str) -> ResilienceLease:\n789\t        \"\"\"Допуск запроса к бэкенду либо `CircuitBreakerOpen`/`BulkheadCapacityExceeded`.\"\"\"\n790\t        settings = self._flags.current()\n791\t        if not settings.enabled or not (settings.circuit_breaker or settings.bulkhead):\n792\t            return ResilienceLease(backend_id)\n793\t        breaker: CircuitBreaker | None = None\n794\t        generation, is_probe = 0, False\n795\t        if settings.circuit_breaker:\n796\t            breaker = self._breaker_for(backend_id, settings)\n797\t            allowed, generation, is_probe = breaker.acquire()\n798\t            if not allowed:\n799\t                raise CircuitBreakerOpen(backend_id, breaker.retry_after or 1)\n800\t        bulkhead_lease: BulkheadLease | None = None\n801\t        if settings.bulkhead:\n802\t            bulkhead_lease = self._bulkhead_for(backend_id, settings).acquire(timeout=0)\n803\t            if bulkhead_lease is None:\n804\t                if breaker is not None:\n805\t                    # Запрос не дошёл до бэкенда: слот пробы HALF_OPEN возвращаем.\n806\t                    breaker.record_discard(generation, \"bulkhead_rejected\")\n807\t                raise BulkheadCapacityExceeded(\n808\t                    backend_id, settings.bulkhead_retry_after_s\n809\t                )\n810\t        return ResilienceLease(\n811\t            backend_id, breaker, bulkhead_lease, generation, is_probe\n812\t        )\n813\t\n814\t    def snapshot(self, extra_backend_ids: Iterable[str] = ()) -> dict[str, Any]:\n815\t        \"\"\"Состояние всех известных бэкендов для `GET /v1/resilience`.\"\"\"\n816\t        settings = self._flags.current()\n817\t        with self._lock:\n818\t            breakers = dict(self._breakers)\n819\t            bulkheads = dict(self._bulkheads)\n820\t        ids = sorted({*breakers, *bulkheads, *extra_backend_ids})\n821\t        backends: dict[str, Any] = {}\n822\t        for backend_id in ids:\n823\t            breaker = breakers.get(backend_id)\n824\t            bulkhead = bulkheads.get(backend_id)\n825\t            entry: dict[str, Any] = (\n826\t                breaker.snapshot()\n827\t                if breaker is not None\n828\t                else {\n829\t                    \"state\": CircuitBreakerState.CLOSED.value,\n830\t                    \"generation\": 0,\n831\t                    \"failures\": 0,\n832\t                    \"retry_after\": 0,\n833\t                }\n834\t            )\n835\t            entry[\"active\"] = bulkhead.active if bulkhead is not None else 0\n836\t            entry[\"capacity\"] = (\n837\t                bulkhead.capacity\n838\t                if bulkhead is not None\n839\t                else self._capacity(backend_id, settings)\n840\t            )\n841\t            backends[backend_id] = entry\n842\t        return {\n843\t            \"enabled\": settings.enabled,\n844\t            \"flags\": {\n845\t                \"circuit_breaker\": settings.circuit_breaker,\n846\t                \"bulkhead\": settings.bulkhead,\n847\t                \"retry\": settings.retry,\n848\t            },\n849\t            \"backends\": backends,\n850\t        }\n851\t"}]},"parent_tool_use_id":null,"session_id":"cb69deea-21f8-4365-acd8-64c37359365f","uuid":"d992ece9-02f0-48de-bfd2-0268c576adc9","timestamp":"2026-11-01T23:28:05.661Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/core/resilience.py","content":"\"\"\"Универсальные паттерны отказоустойчивости шлюза (ADR-0020 Rev 4).\n\nCircuit Breaker с generation tokens, Bulkhead (изоляция параллелизма по `backend_id`) и\nRetryPolicy (экспоненциальный бэкофф с Full Jitter и контролем дедлайна). Модуль чистый:\nstdlib-only, без знания об адаптерах и именах агентов — ключ изоляции это строка `backend_id`.\n\nИнвариант владельца: автоматического fallback на другую модель/провайдер нет. Недоступный\nбэкенд = честный отказ вызывающему (`CircuitBreakerOpen` / `BulkheadCapacityExceeded`),\nкоторый фасад превращает в HTTP 503 с `Retry-After`.\n\nВсе механизмы закрыты флагами GigaRC (дефолт `false`, снимок + env-override, см.\n`ResilienceFlags`); пороги и задержки — только из настроек с безопасными fallback-значениями.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport enum\nimport json\nimport math\nimport os\nimport random\nimport stat\nimport subprocess\nimport threading\nimport time\nfrom collections.abc import Callable, Iterable, Mapping\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom types import TracebackType\nfrom typing import Any, Protocol\n\n# --------------------------------------------------------------------------- исключения\n\n\nclass ResilienceError(Exception):\n    \"\"\"База отказов слоя отказоустойчивости: запрос отклонён до обращения к бэкенду.\"\"\"\n\n    error_code = \"RESILIENCE_ERROR\"\n    error_type = \"resilience_error\"\n\n    def __init__(self, backend_id: str, retry_after: int, message: str = \"\") -> None:\n        self.backend_id = backend_id\n        self.retry_after = max(1, int(retry_after))\n        self.reason = message\n        super().__init__(\n            message or f\"backend '{backend_id}' is temporarily unavailable\"\n        )\n\n\nclass CircuitBreakerOpen(ResilienceError):\n    \"\"\"Брейкер бэкенда разомкнут (или проба HALF_OPEN уже занята): fail-fast.\"\"\"\n\n    error_code = \"CIRCUIT_BREAKER_OPEN\"\n\n    def __init__(self, backend_id: str, retry_after: int) -> None:\n        super().__init__(backend_id, retry_after, \"circuit breaker is open\")\n\n\nclass BulkheadCapacityExceeded(ResilienceError):\n    \"\"\"Ёмкость отсека бэкенда исчерпана: отказ за O(1), без ожидания слота.\"\"\"\n\n    error_code = \"BULKHEAD_CAPACITY_EXCEEDED\"\n\n    def __init__(self, backend_id: str, retry_after: int) -> None:\n        super().__init__(backend_id, retry_after, \"bulkhead capacity exceeded\")\n\n\n# --------------------------------------------------------------------------- настройки и флаги\n\n_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n\nFLAG_RESILIENCE = \"RESILIENCE_ENABLED\"\nFLAG_CIRCUIT_BREAKER = \"CIRCUIT_BREAKER_ENABLED\"\nFLAG_BULKHEAD = \"BULKHEAD_ENABLED\"\nFLAG_RETRY = \"RETRY_ENABLED\"\nFLAG_NAMES = (FLAG_RESILIENCE, FLAG_CIRCUIT_BREAKER, FLAG_BULKHEAD, FLAG_RETRY)\n\nENV_PREFIX = \"BRIDGE_\"\n\nSNAPSHOT_MAX_BYTES = 64 * 1024\n\n\n@dataclass(frozen=True)\nclass ResilienceSettings:\n    \"\"\"Иммутабельный снимок флагов и порогов на время одного запроса.\n\n    `circuit_breaker`/`bulkhead`/`retry` уже учитывают мастер-флаг `enabled`.\n    \"\"\"\n\n    enabled: bool = False\n    circuit_breaker: bool = False\n    bulkhead: bool = False\n    retry: bool = False\n    bulkhead_max_concurrent: int = 64\n    bulkhead_retry_after_s: int = 1\n    fail_threshold: int = 3\n    cooldown_s: float = 30.0\n    cooldown_jitter: float = 0.2\n    retry_max_attempts: int = 3\n    retry_base_delay_s: float = 1.0\n    retry_max_delay_s: float = 10.0\n    retry_backoff_factor: float = 2.0\n\n\nclass FlagSource(Protocol):\n    \"\"\"Источник булевых флагов GigaRC: `{имя: bool}`; отсутствие флага = false.\"\"\"\n\n    def read(self) -> Mapping[str, bool]: ...\n\n\ndef default_snapshot_path() -> str:\n    return os.path.expanduser(\"~/.config/cli-agent-bridge/resilience.snapshot.json\")\n\n\ndef _parse_utc(value: Any) -> float:\n    if not isinstance(value, str) or not value:\n        raise ValueError(\"timestamp\")\n    text = value[:-1] + \"+00:00\" if value.endswith(\"Z\") else value\n    parsed = datetime.fromisoformat(text)\n    if parsed.tzinfo is None:\n        raise ValueError(\"timestamp without tz\")\n    return parsed.astimezone(timezone.utc).timestamp()\n\n\n@dataclass(frozen=True)\nclass _Snapshot:\n    generated_at: float\n    expires_at: float\n    flags: Mapping[str, bool]\n\n\nclass SnapshotFlagSource:\n    \"\"\"Читатель локального атомарного JSON-снимка GigaRC: lastgood, default=false, без исключений.\n\n    Снимок: `{\"schema_version\": 1, \"generated_at\": ISO, \"expires_at\": ISO, \"flags\": {...}}`.\n    Любой сбой (нет файла, мусор, чужие права, симлинк) оставляет lastgood, а при его\n    отсутствии все флаги false. `true` живёт только пока снимок свеж, `false` — бессрочно.\n    \"\"\"\n\n    def __init__(\n        self,\n        path: str | None = None,\n        *,\n        clock: Callable[[], float] = time.time,\n        max_true_age_s: float | None = None,\n    ) -> None:\n        self._path = path or os.environ.get(\n            ENV_PREFIX + \"RESILIENCE_SNAPSHOT_PATH\", default_snapshot_path()\n        )\n        self._clock = clock\n        self._max_true_age_s = (\n            max_true_age_s\n            if max_true_age_s is not None\n            else _env_float(\n                os.environ,\n                (ENV_PREFIX + \"RESILIENCE_SNAPSHOT_MAX_AGE_S\",),\n                30.0,\n                minimum=0.0,\n            )\n        )\n        self._lock = threading.Lock()\n        self._sig: tuple[int, int, int, int] | None = None\n        self._last: _Snapshot | None = None\n\n    def read(self) -> Mapping[str, bool]:\n        with self._lock:\n            try:\n                fresh = self._load()\n            except Exception:  # noqa: BLE001 - гонка/мусор не должны ронять запрос\n                fresh = None\n            if fresh is not None:\n                self._last = fresh\n            snap = self._last\n            if snap is None:\n                return {}\n            now = self._clock()\n            alive = (\n                now < snap.expires_at\n                and (now - snap.generated_at) <= self._max_true_age_s\n            )\n            return {name: value and alive for name, value in snap.flags.items()}\n\n    def _load(self) -> _Snapshot | None:\n        euid = os.geteuid()\n        st = os.lstat(self._path)\n        if not stat.S_ISREG(st.st_mode):\n            return None\n        sig = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)\n        if sig == self._sig and self._last is not None:\n            return self._last\n        parent = os.stat(os.path.dirname(self._path) or \".\")\n        if parent.st_uid != euid or parent.st_mode & 0o077:\n            return None\n        fd = os.open(\n            self._path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, \"O_CLOEXEC\", 0)\n        )\n        try:\n            before = os.fstat(fd)\n            if (\n                not stat.S_ISREG(before.st_mode)\n                or before.st_uid != euid\n                or before.st_mode & 0o077\n                or before.st_size > SNAPSHOT_MAX_BYTES\n            ):\n                return None\n            raw = os.read(fd, SNAPSHOT_MAX_BYTES + 1)\n        finally:\n            os.close(fd)\n        data = json.loads(raw.decode(\"utf-8\"))\n        if not isinstance(data, dict) or data.get(\"schema_version\") != 1:\n            return None\n        flags = data.get(\"flags\")\n        if not isinstance(flags, dict):\n            return None\n        snap = _Snapshot(\n            generated_at=_parse_utc(data.get(\"generated_at\")),\n            expires_at=_parse_utc(data.get(\"expires_at\")),\n            flags={k: v for k, v in flags.items() if isinstance(v, bool)},\n        )\n        self._sig = sig\n        return snap\n\n\ndef _env_bool(env: Mapping[str, str], name: str) -> bool | None:\n    raw = env.get(ENV_PREFIX + name)\n    if raw is None:\n        return None\n    text = raw.strip().lower()\n    if text in _TRUE:\n        return True\n    if text in _FALSE:\n        return False\n    return None\n\n\ndef _env_float(\n    env: Mapping[str, str],\n    names: Iterable[str],\n    default: float,\n    *,\n    minimum: float = 0.0,\n    allow_equal: bool = True,\n) -> float:\n    \"\"\"Первое валидное значение из списка имён (основное имя, затем алиасы), иначе default.\"\"\"\n    for name in names:\n        raw = env.get(name)\n        if raw is None:\n            continue\n        try:\n            value = float(raw)\n        except ValueError:\n            continue\n        if math.isfinite(value) and (\n            value >= minimum if allow_equal else value > minimum\n        ):\n            return value\n    return default\n\n\ndef _env_int(\n    env: Mapping[str, str], names: Iterable[str], default: int, *, minimum: int = 1\n) -> int:\n    for name in names:\n        raw = env.get(name)\n        if raw is None:\n            continue\n        try:\n            value = int(raw.strip())\n        except ValueError:\n            continue\n        if value >= minimum:\n            return value\n    return default\n\n\nclass ResilienceFlags:\n    \"\"\"Флаги GigaRC (дефолт false) + пороги из env; env перекрывает снимок, снимок — default.\n\n    Булев флаг: `BRIDGE_<ИМЯ>` из env (если задан и валиден) → значение снимка GigaRC →\n    `False`. Env `false` — аварийный kill-switch поверх снимка. Мастер-флаг `RESILIENCE_ENABLED`\n    должен быть истинным, иначе остальные не действуют. Читается на каждый запрос: смена\n    флага вступает в силу без рестарта.\n    \"\"\"\n\n    def __init__(\n        self,\n        source: FlagSource | None = None,\n        env: Mapping[str, str] | None = None,\n    ) -> None:\n        self._source: FlagSource = (\n            source if source is not None else SnapshotFlagSource()\n        )\n        self._env = env\n\n    def current(self) -> ResilienceSettings:\n        env: Mapping[str, str] = self._env if self._env is not None else os.environ\n        try:\n            snap = self._source.read()\n        except Exception:  # noqa: BLE001 - источник флагов не должен ронять запрос\n            snap = {}\n\n        def flag(name: str) -> bool:\n            override = _env_bool(env, name)\n            return override if override is not None else bool(snap.get(name, False))\n\n        master = flag(FLAG_RESILIENCE)\n        if not master:\n            return ResilienceSettings()\n        p = ENV_PREFIX\n        return ResilienceSettings(\n            enabled=True,\n            circuit_breaker=flag(FLAG_CIRCUIT_BREAKER),\n            bulkhead=flag(FLAG_BULKHEAD),\n            retry=flag(FLAG_RETRY),\n            bulkhead_max_concurrent=_env_int(\n                env,\n                (\n                    p + \"BULKHEAD_MAX_CONCURRENT\",\n                    p + \"BULKHEAD_MAX_PASSTHROUGH\",\n                ),\n                64,\n            ),\n            bulkhead_retry_after_s=_env_int(env, (p + \"BULKHEAD_RETRY_AFTER_S\",), 1),\n            fail_threshold=_env_int(\n                env,\n                (p + \"CIRCUIT_BREAKER_FAIL_THRESHOLD\", p + \"CB_FAIL_THRESHOLD\"),\n                3,\n            ),\n            cooldown_s=_env_float(\n                env,\n                (p + \"CIRCUIT_BREAKER_COOLDOWN_S\", p + \"CB_RESET_TIMEOUT_S\"),\n                30.0,\n                minimum=0.0,\n                allow_equal=False,\n            ),\n            cooldown_jitter=min(\n                _env_float(env, (p + \"CIRCUIT_BREAKER_JITTER\",), 0.2, minimum=0.0),\n                0.9,\n            ),\n            retry_max_attempts=_env_int(env, (p + \"RETRY_MAX_ATTEMPTS\",), 3),\n            retry_base_delay_s=_env_float(\n                env,\n                (p + \"RETRY_BASE_DELAY_S\", p + \"RETRY_BASE_SLEEP_S\"),\n                1.0,\n                minimum=0.0,\n            ),\n            retry_max_delay_s=_env_float(\n                env,\n                (p + \"RETRY_MAX_DELAY_S\", p + \"RETRY_MAX_SLEEP_S\"),\n                10.0,\n                minimum=0.0,\n            ),\n            retry_backoff_factor=_env_float(\n                env, (p + \"RETRY_BACKOFF_FACTOR\",), 2.0, minimum=1.0\n            ),\n        )\n\n\n# --------------------------------------------------------------------------- Circuit Breaker\n\n\nclass CircuitBreakerState(enum.Enum):\n    CLOSED = \"CLOSED\"\n    OPEN = \"OPEN\"\n    HALF_OPEN = \"HALF_OPEN\"\n\n\nclass CircuitBreaker:\n    \"\"\"Потокобезопасный автомат CLOSED → OPEN → HALF_OPEN с поколениями (generation tokens).\n\n    Каждый переход состояния увеличивает `_generation`. Допущенный вызов получает\n    `(allowed, generation, is_probe)`; результат с устаревшим поколением игнорируется,\n    поэтому запоздавший ответ старого запроса не портит состояние. В HALF_OPEN допускается\n    ровно одна проба; `record_discard` освобождает её слот без фиксации сбоя.\n    Переход OPEN → HALF_OPEN ленивый — на первом `acquire` после cooldown.\n    \"\"\"\n\n    def __init__(\n        self,\n        backend_id: str = \"\",\n        *,\n        fail_threshold: int = 3,\n        cooldown_s: float = 30.0,\n        cooldown_jitter: float = 0.2,\n        clock: Callable[[], float] = time.monotonic,\n        rng: Callable[[float, float], float] = random.uniform,\n    ) -> None:\n        self.backend_id = backend_id\n        self._lock = threading.Lock()\n        self._clock = clock\n        self._rng = rng\n        self._fail_threshold = max(1, int(fail_threshold))\n        self._cooldown_s = float(cooldown_s)\n        self._cooldown_jitter = float(cooldown_jitter)\n        self._state = CircuitBreakerState.CLOSED\n        self._generation = 0\n        self._failures = 0\n        self._probe_in_flight = False\n        self._open_until = 0.0\n\n    def configure(\n        self,\n        *,\n        fail_threshold: int | None = None,\n        cooldown_s: float | None = None,\n        cooldown_jitter: float | None = None,\n    ) -> None:\n        \"\"\"Горячая смена порогов (GigaRC/env) без потери состояния.\"\"\"\n        with self._lock:\n            if fail_threshold is not None:\n                self._fail_threshold = max(1, int(fail_threshold))\n            if cooldown_s is not None:\n                self._cooldown_s = float(cooldown_s)\n            if cooldown_jitter is not None:\n                self._cooldown_jitter = float(cooldown_jitter)\n\n    @property\n    def state(self) -> CircuitBreakerState:\n        with self._lock:\n            return self._state\n\n    @property\n    def generation(self) -> int:\n        with self._lock:\n            return self._generation\n\n    @property\n    def failures(self) -> int:\n        with self._lock:\n            return self._failures\n\n    @property\n    def retry_after(self) -> int:\n        \"\"\"Целые секунды до следующей попытки; 0 — отказ не действует.\"\"\"\n        with self._lock:\n            return self._retry_after_locked(self._clock())\n\n    def _retry_after_locked(self, now: float) -> int:\n        if self._state is CircuitBreakerState.OPEN:\n            remaining = self._open_until - now\n            return max(1, math.ceil(remaining)) if remaining > 0 else 0\n        if self._state is CircuitBreakerState.HALF_OPEN and self._probe_in_flight:\n            return 1\n        return 0\n\n    def _transition_locked(self, state: CircuitBreakerState, now: float) -> None:\n        self._state = state\n        self._generation += 1\n        self._failures = 0\n        self._probe_in_flight = False\n        if state is CircuitBreakerState.OPEN:\n            # Джиттер считается один раз при входе в OPEN: Retry-After стабилен.\n            spread = self._cooldown_jitter\n            self._open_until = now + self._cooldown_s * self._rng(\n                1.0 - spread, 1.0 + spread\n            )\n\n    def acquire(self) -> tuple[bool, int, bool]:\n        \"\"\"(allowed, generation, is_probe). Отказ — `allowed=False`, вызывать бэкенд нельзя.\"\"\"\n        with self._lock:\n            now = self._clock()\n            if self._state is CircuitBreakerState.OPEN:\n                if now < self._open_until:\n                    return False, self._generation, False\n                self._transition_locked(CircuitBreakerState.HALF_OPEN, now)\n            if self._state is CircuitBreakerState.HALF_OPEN:\n                if self._probe_in_flight:\n                    return False, self._generation, False\n                self._probe_in_flight = True\n                return True, self._generation, True\n            return True, self._generation, False\n\n    def record_success(self, generation: int) -> None:\n        with self._lock:\n            if generation != self._generation:\n                return\n            if self._state is CircuitBreakerState.HALF_OPEN:\n                self._transition_locked(CircuitBreakerState.CLOSED, self._clock())\n            elif self._state is CircuitBreakerState.CLOSED:\n                self._failures = 0\n\n    def record_failure(self, generation: int, exc: BaseException | None = None) -> None:\n        with self._lock:\n            if generation != self._generation:\n                return\n            now = self._clock()\n            if self._state is CircuitBreakerState.HALF_OPEN:\n                self._transition_locked(CircuitBreakerState.OPEN, now)\n            elif self._state is CircuitBreakerState.CLOSED:\n                self._failures += 1\n                if self._failures >= self._fail_threshold:\n                    self._transition_locked(CircuitBreakerState.OPEN, now)\n\n    def record_discard(self, generation: int, reason: str = \"\") -> None:\n        \"\"\"Нейтральный исход (обрыв клиента, 4xx): слот пробы свободен, счётчики не меняются.\"\"\"\n        with self._lock:\n            if generation != self._generation:\n                return\n            if self._state is CircuitBreakerState.HALF_OPEN:\n                self._probe_in_flight = False\n\n    def snapshot(self) -> dict[str, Any]:\n        with self._lock:\n            return {\n                \"state\": self._state.value,\n                \"generation\": self._generation,\n                \"failures\": self._failures,\n                \"retry_after\": self._retry_after_locked(self._clock()),\n            }\n\n\n# --------------------------------------------------------------------------- Bulkhead\n\n\nclass BulkheadLease:\n    \"\"\"Занятый слот отсека; `close()` идемпотентен.\"\"\"\n\n    def __init__(self, bulkhead: Bulkhead) -> None:\n        self._bulkhead: Bulkhead | None = bulkhead\n        self._lock = threading.Lock()\n\n    def close(self) -> None:\n        with self._lock:\n            bulkhead, self._bulkhead = self._bulkhead, None\n        if bulkhead is not None:\n            bulkhead._release()\n\n\nclass Bulkhead:\n    \"\"\"Ограничитель параллелизма бэкенда на семафоре; захват неблокирующий (`timeout=0`).\"\"\"\n\n    def __init__(self, backend_id: str, capacity: int) -> None:\n        self.backend_id = backend_id\n        self.capacity = max(1, int(capacity))\n        self._sem = threading.BoundedSemaphore(self.capacity)\n        self._lock = threading.Lock()\n        self._active = 0\n\n    @property\n    def active(self) -> int:\n        with self._lock:\n            return self._active\n\n    def acquire(self, timeout: float = 0) -> BulkheadLease | None:\n        if timeout <= 0:\n            got = self._sem.acquire(blocking=False)\n        else:\n            got = self._sem.acquire(timeout=timeout)\n        if not got:\n            return None\n        with self._lock:\n            self._active += 1\n        return BulkheadLease(self)\n\n    def _release(self) -> None:\n        with self._lock:\n            self._active -= 1\n        self._sem.release()\n\n\n# --------------------------------------------------------------------------- RetryPolicy\n\n\ndef is_transient_backend_error(exc: BaseException | None) -> bool:\n    \"\"\"Транзиентный технический сбой бэкенда, повтор допустим.\n\n    `None` — вызывающий зафиксировал сбой без исключения (например, upstream 5xx).\n    Отказы самого слоя отказоустойчивости повторять нельзя.\n    \"\"\"\n    if exc is None:\n        return True\n    if isinstance(exc, ResilienceError):\n        return False\n    return isinstance(\n        exc,\n        (TimeoutError, ConnectionError, InterruptedError, subprocess.SubprocessError),\n    )\n\n\nclass RetryPolicy:\n    \"\"\"Повторы с экспоненциальным бэкоффом и Full Jitter (агент-агностичная политика).\n\n    `attempt` — 0-based индекс только что упавшей попытки; всего попыток `max_attempts`.\n    Задержка: `uniform(0, min(max_delay, base * factor ** attempt))`. Повтор запрещён, если\n    клиенту уже отданы байты ответа (`bytes_delivered`) или исчерпан дедлайн.\n    \"\"\"\n\n    def __init__(\n        self,\n        max_attempts: int = 3,\n        base_delay_s: float = 1.0,\n        max_delay_s: float = 10.0,\n        backoff_factor: float = 2.0,\n        *,\n        rng: Callable[[float, float], float] = random.uniform,\n        is_transient: Callable[\n            [BaseException | None], bool\n        ] = is_transient_backend_error,\n    ) -> None:\n        self.max_attempts = max(1, int(max_attempts))\n        self.base_delay_s = max(0.0, float(base_delay_s))\n        self.max_delay_s = max(0.0, float(max_delay_s))\n        self.backoff_factor = max(1.0, float(backoff_factor))\n        self._rng = rng\n        self._is_transient = is_transient\n\n    @classmethod\n    def from_settings(cls, settings: ResilienceSettings, **kwargs: Any) -> RetryPolicy:\n        return cls(\n            settings.retry_max_attempts,\n            settings.retry_base_delay_s,\n            settings.retry_max_delay_s,\n            settings.retry_backoff_factor,\n            **kwargs,\n        )\n\n    def should_retry(\n        self,\n        attempt: int,\n        bytes_delivered: bool,\n        exc: BaseException | None = None,\n    ) -> bool:\n        if bytes_delivered or attempt + 1 >= self.max_attempts:\n            return False\n        return self._is_transient(exc)\n\n    def compute_delay(\n        self, attempt: int, deadline_s: float | None = None\n    ) -> float | None:\n        \"\"\"Секунды сна перед повтором; None — повтор не укладывается в `deadline_s` (остаток).\n\n        Показатель степени ограничен, чтобы `factor ** attempt` не переполнялся.\n        \"\"\"\n        if deadline_s is not None and deadline_s <= 0:\n            return None\n        try:\n            ceiling = self.base_delay_s * self.backoff_factor ** max(\n                0, min(attempt, 1023)\n            )\n        except OverflowError:\n            ceiling = math.inf\n        delay = self._rng(0.0, min(self.max_delay_s, ceiling))\n        if deadline_s is not None and delay >= deadline_s:\n            return None\n        return delay\n\n\n# --------------------------------------------------------------------------- Lease и Manager\n\n\nclass ResilienceLease:\n    \"\"\"Контекстный менеджер одного запроса: слот Bulkhead + допуск брейкера.\n\n    Результат фиксируется только явно (`record_*`). Выход без исключения успехом не считается;\n    выход с необработанным исключением фиксирует сбой. Первый явный исход финален.\n    \"\"\"\n\n    def __init__(\n        self,\n        backend_id: str,\n        breaker: CircuitBreaker | None = None,\n        bulkhead_lease: BulkheadLease | None = None,\n        generation: int = 0,\n        is_probe: bool = False,\n    ) -> None:\n        self.backend_id = backend_id\n        self.generation = generation\n        self.is_probe = is_probe\n        self._breaker = breaker\n        self._bulkhead_lease = bulkhead_lease\n        self._recorded = False\n        self._lock = threading.Lock()\n\n    def _claim(self) -> bool:\n        with self._lock:\n            if self._recorded:\n                return False\n            self._recorded = True\n            return True\n\n    @property\n    def recorded(self) -> bool:\n        return self._recorded\n\n    def record_success(self) -> None:\n        if self._claim() and self._breaker is not None:\n            self._breaker.record_success(self.generation)\n\n    def record_failure(self, exc: BaseException | None = None) -> None:\n        if self._claim() and self._breaker is not None:\n            self._breaker.record_failure(self.generation, exc)\n\n    def record_discard(self, reason: str = \"\") -> None:\n        if self._claim() and self._breaker is not None:\n            self._breaker.record_discard(self.generation, reason)\n\n    def close(self) -> None:\n        with self._lock:\n            lease, self._bulkhead_lease = self._bulkhead_lease, None\n        if lease is not None:\n            lease.close()\n\n    def __enter__(self) -> ResilienceLease:\n        return self\n\n    def __exit__(\n        self,\n        exc_type: type[BaseException] | None,\n        exc_val: BaseException | None,\n        exc_tb: TracebackType | None,\n    ) -> None:\n        try:\n            if exc_val is not None:\n                self.record_failure(exc_val)\n            elif not self.recorded and self.is_probe:\n                # Проба без явного исхода не должна навсегда занять слот HALF_OPEN.\n                self.record_discard(\"no_outcome\")\n        finally:\n            self.close()\n\n\nclass ResilienceManager:\n    \"\"\"Реестр CircuitBreaker и Bulkhead по `backend_id`; настройки читаются на каждый запрос.\"\"\"\n\n    def __init__(\n        self,\n        flags: ResilienceFlags | None = None,\n        *,\n        backend_limits: Mapping[str, int] | None = None,\n        clock: Callable[[], float] = time.monotonic,\n        rng: Callable[[float, float], float] = random.uniform,\n    ) -> None:\n        self._flags = flags if flags is not None else ResilienceFlags()\n        self._backend_limits = dict(backend_limits or {})\n        self._clock = clock\n        self._rng = rng\n        self._lock = threading.Lock()\n        self._breakers: dict[str, CircuitBreaker] = {}\n        self._bulkheads: dict[str, Bulkhead] = {}\n\n    def settings(self) -> ResilienceSettings:\n        return self._flags.current()\n\n    def retry_policy(self) -> RetryPolicy | None:\n        \"\"\"RetryPolicy по текущим настройкам; None — повторы выключены флагом.\"\"\"\n        settings = self._flags.current()\n        if not settings.retry:\n            return None\n        return RetryPolicy.from_settings(settings)\n\n    def _breaker_for(\n        self, backend_id: str, settings: ResilienceSettings\n    ) -> CircuitBreaker:\n        with self._lock:\n            breaker = self._breakers.get(backend_id)\n            if breaker is None:\n                breaker = CircuitBreaker(\n                    backend_id,\n                    fail_threshold=settings.fail_threshold,\n                    cooldown_s=settings.cooldown_s,\n                    cooldown_jitter=settings.cooldown_jitter,\n                    clock=self._clock,\n                    rng=self._rng,\n                )\n                self._breakers[backend_id] = breaker\n        breaker.configure(\n            fail_threshold=settings.fail_threshold,\n            cooldown_s=settings.cooldown_s,\n            cooldown_jitter=settings.cooldown_jitter,\n        )\n        return breaker\n\n    def _capacity(self, backend_id: str, settings: ResilienceSettings) -> int:\n        cap = settings.bulkhead_max_concurrent\n        return max(1, min(self._backend_limits.get(backend_id, cap), cap))\n\n    def _bulkhead_for(self, backend_id: str, settings: ResilienceSettings) -> Bulkhead:\n        capacity = self._capacity(backend_id, settings)\n        with self._lock:\n            bulkhead = self._bulkheads.get(backend_id)\n            if bulkhead is None or bulkhead.capacity != capacity:\n                # Смена ёмкости: новый отсек; уже выданные слоты освободят старый семафор.\n                bulkhead = Bulkhead(backend_id, capacity)\n                self._bulkheads[backend_id] = bulkhead\n            return bulkhead\n\n    def acquire(self, backend_id: str) -> ResilienceLease:\n        \"\"\"Допуск запроса к бэкенду либо `CircuitBreakerOpen`/`BulkheadCapacityExceeded`.\"\"\"\n        settings = self._flags.current()\n        if not settings.enabled or not (settings.circuit_breaker or settings.bulkhead):\n            return ResilienceLease(backend_id)\n        breaker: CircuitBreaker | None = None\n        generation, is_probe = 0, False\n        if settings.circuit_breaker:\n            breaker = self._breaker_for(backend_id, settings)\n            allowed, generation, is_probe = breaker.acquire()\n            if not allowed:\n                raise CircuitBreakerOpen(backend_id, breaker.retry_after or 1)\n        bulkhead_lease: BulkheadLease | None = None\n        if settings.bulkhead:\n            bulkhead_lease = self._bulkhead_for(backend_id, settings).acquire(timeout=0)\n            if bulkhead_lease is None:\n                if breaker is not None:\n                    # Запрос не дошёл до бэкенда: слот пробы HALF_OPEN возвращаем.\n                    breaker.record_discard(generation, \"bulkhead_rejected\")\n                raise BulkheadCapacityExceeded(\n                    backend_id, settings.bulkhead_retry_after_s\n                )\n        return ResilienceLease(\n            backend_id, breaker, bulkhead_lease, generation, is_probe\n        )\n\n    def snapshot(self, extra_backend_ids: Iterable[str] = ()) -> dict[str, Any]:\n        \"\"\"Состояние всех известных бэкендов для `GET /v1/resilience`.\"\"\"\n        settings = self._flags.current()\n        with self._lock:\n            breakers = dict(self._breakers)\n            bulkheads = dict(self._bulkheads)\n        ids = sorted({*breakers, *bulkheads, *extra_backend_ids})\n        backends: dict[str, Any] = {}\n        for backend_id in ids:\n            breaker = breakers.get(backend_id)\n            bulkhead = bulkheads.get(backend_id)\n            entry: dict[str, Any] = (\n                breaker.snapshot()\n                if breaker is not None\n                else {\n                    \"state\": CircuitBreakerState.CLOSED.value,\n                    \"generation\": 0,\n                    \"failures\": 0,\n                    \"retry_after\": 0,\n                }\n            )\n            entry[\"active\"] = bulkhead.active if bulkhead is not None else 0\n            entry[\"capacity\"] = (\n                bulkhead.capacity\n                if bulkhead is not None\n                else self._capacity(backend_id, settings)\n            )\n            backends[backend_id] = entry\n        return {\n            \"enabled\": settings.enabled,\n            \"flags\": {\n                \"circuit_breaker\": settings.circuit_breaker,\n                \"bulkhead\": settings.bulkhead,\n                \"retry\": settings.retry,\n            },\n            \"backends\": backends,\n        }\n","numLines":851,"startLine":1,"totalLines":851}},"tool_result_meta":[{"id":"toolu_01KoWQhUNizMFabPQbCHWVEh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
