{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba core/resilience.py'","aggregated_output":"     1\t\"\"\"Универсальные паттерны отказоустойчивости шлюза (ADR-0020 Rev 4).\n     2\t\n     3\tCircuit Breaker с generation tokens, Bulkhead (изоляция параллелизма по `backend_id`) и\n     4\tRetryPolicy (экспоненциальный бэкофф с Full Jitter и контролем дедлайна). Модуль чистый:\n     5\tstdlib-only, без знания об адаптерах и именах агентов — ключ изоляции это строка `backend_id`.\n     6\t\n     7\tИнвариант владельца: автоматического fallback на другую модель/провайдер нет. Недоступный\n     8\tбэкенд = честный отказ вызывающему (`CircuitBreakerOpen` / `BulkheadCapacityExceeded`),\n     9\tкоторый фасад превращает в HTTP 503 с `Retry-After`.\n    10\t\n    11\tВсе механизмы закрыты флагами GigaRC (дефолт `false`, снимок + env-override, см.\n    12\t`ResilienceFlags`); пороги и задержки — только из настроек с безопасными fallback-значениями.\n    13\t\"\"\"\n    14\t\n    15\tfrom __future__ import annotations\n    16\t\n    17\timport enum\n    18\timport json\n    19\timport math\n    20\timport os\n    21\timport random\n    22\timport stat\n    23\timport subprocess\n    24\timport threading\n    25\timport time\n    26\tfrom collections.abc import Callable, Iterable, Mapping\n    27\tfrom dataclasses import dataclass\n    28\tfrom datetime import datetime, timezone\n    29\tfrom types import TracebackType\n    30\tfrom typing import Any, Protocol\n    31\t\n    32\t# --------------------------------------------------------------------------- исключения\n    33\t\n    34\t\n    35\tclass ResilienceError(Exception):\n    36\t    \"\"\"База отказов слоя отказоустойчивости: запрос отклонён до обращения к бэкенду.\"\"\"\n    37\t\n    38\t    error_code = \"RESILIENCE_ERROR\"\n    39\t    error_type = \"resilience_error\"\n    40\t\n    41\t    def __init__(self, backend_id: str, retry_after: int, message: str = \"\") -> None:\n    42\t        self.backend_id = backend_id\n    43\t        self.retry_after = max(1, int(retry_after))\n    44\t        self.reason = message\n    45\t        super().__init__(\n    46\t            message or f\"backend '{backend_id}' is temporarily unavailable\"\n    47\t        )\n    48\t\n    49\t\n    50\tclass CircuitBreakerOpen(ResilienceError):\n    51\t    \"\"\"Брейкер бэкенда разомкнут (или проба HALF_OPEN уже занята): fail-fast.\"\"\"\n    52\t\n    53\t    error_code = \"CIRCUIT_BREAKER_OPEN\"\n    54\t\n    55\t    def __init__(self, backend_id: str, retry_after: int) -> None:\n    56\t        super().__init__(backend_id, retry_after, \"circuit breaker is open\")\n    57\t\n    58\t\n    59\tclass BulkheadCapacityExceeded(ResilienceError):\n    60\t    \"\"\"Ёмкость отсека бэкенда исчерпана: отказ за O(1), без ожидания слота.\"\"\"\n    61\t\n    62\t    error_code = \"BULKHEAD_CAPACITY_EXCEEDED\"\n    63\t\n    64\t    def __init__(self, backend_id: str, retry_after: int) -> None:\n    65\t        super().__init__(backend_id, retry_after, \"bulkhead capacity exceeded\")\n    66\t\n    67\t\n    68\t# --------------------------------------------------------------------------- настройки и флаги\n    69\t\n    70\t_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n    71\t_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n    72\t\n    73\tFLAG_RESILIENCE = \"RESILIENCE_ENABLED\"\n    74\tFLAG_CIRCUIT_BREAKER = \"CIRCUIT_BREAKER_ENABLED\"\n    75\tFLAG_BULKHEAD = \"BULKHEAD_ENABLED\"\n    76\tFLAG_RETRY = \"RETRY_ENABLED\"\n    77\tFLAG_NAMES = (FLAG_RESILIENCE, FLAG_CIRCUIT_BREAKER, FLAG_BULKHEAD, FLAG_RETRY)\n    78\t\n    79\tENV_PREFIX = \"BRIDGE_\"\n    80\t\n    81\tSNAPSHOT_MAX_BYTES = 64 * 1024\n    82\t\n    83\t\n    84\t@dataclass(frozen=True)\n    85\tclass ResilienceSettings:\n    86\t    \"\"\"Иммутабельный снимок флагов и порогов на время одного запроса.\n    87\t\n    88\t    `circuit_breaker`/`bulkhead`/`retry` уже учитывают мастер-флаг `enabled`.\n    89\t    \"\"\"\n    90\t\n    91\t    enabled: bool = False\n    92\t    circuit_breaker: bool = False\n    93\t    bulkhead: bool = False\n    94\t    retry: bool = False\n    95\t    bulkhead_max_concurrent: int = 64\n    96\t    bulkhead_retry_after_s: int = 1\n    97\t    fail_threshold: int = 3\n    98\t    cooldown_s: float = 30.0\n    99\t    cooldown_jitter: float = 0.2\n   100\t    retry_max_attempts: int = 3\n   101\t    retry_base_delay_s: float = 1.0\n   102\t    retry_max_delay_s: float = 10.0\n   103\t    retry_backoff_factor: float = 2.0\n   104\t\n   105\t\n   106\tclass FlagSource(Protocol):\n   107\t    \"\"\"Источник булевых флагов GigaRC: `{имя: bool}`; отсутствие флага = false.\"\"\"\n   108\t\n   109\t    def read(self) -> Mapping[str, bool]: ...\n   110\t\n   111\t\n   112\tdef default_snapshot_path() -> str:\n   113\t    return os.path.expanduser(\"~/.config/cli-agent-bridge/resilience.snapshot.json\")\n   114\t\n   115\t\n   116\tdef _parse_utc(value: Any) -> float:\n   117\t    if not isinstance(value, str) or not value:\n   118\t        raise ValueError(\"timestamp\")\n   119\t    text = value[:-1] + \"+00:00\" if value.endswith(\"Z\") else value\n   120\t    parsed = datetime.fromisoformat(text)\n   121\t    if parsed.tzinfo is None:\n   122\t        raise ValueError(\"timestamp without tz\")\n   123\t    return parsed.astimezone(timezone.utc).timestamp()\n   124\t\n   125\t\n   126\t@dataclass(frozen=True)\n   127\tclass _Snapshot:\n   128\t    generated_at: float\n   129\t    expires_at: float\n   130\t    flags: Mapping[str, bool]\n   131\t\n   132\t\n   133\tclass SnapshotFlagSource:\n   134\t    \"\"\"Читатель локального атомарного JSON-снимка GigaRC: lastgood, default=false, без исключений.\n   135\t\n   136\t    Снимок: `{\"schema_version\": 1, \"generated_at\": ISO, \"expires_at\": ISO, \"flags\": {...}}`.\n   137\t    Любой сбой (нет файла, мусор, чужие права, симлинк) оставляет lastgood, а при его\n   138\t    отсутствии все флаги false. `true` живёт только пока снимок свеж, `false` — бессрочно.\n   139\t    \"\"\"\n   140\t\n   141\t    def __init__(\n   142\t        self,\n   143\t        path: str | None = None,\n   144\t        *,\n   145\t        clock: Callable[[], float] = time.time,\n   146\t        max_true_age_s: float | None = None,\n   147\t    ) -> None:\n   148\t        self._path = path or os.environ.get(\n   149\t            ENV_PREFIX + \"RESILIENCE_SNAPSHOT_PATH\", default_snapshot_path()\n   150\t        )\n   151\t        self._clock = clock\n   152\t        self._max_true_age_s = (\n   153\t            max_true_age_s\n   154\t            if max_true_age_s is not None\n   155\t            else _env_float(\n   156\t                os.environ,\n   157\t                (ENV_PREFIX + \"RESILIENCE_SNAPSHOT_MAX_AGE_S\",),\n   158\t                30.0,\n   159\t                minimum=0.0,\n   160\t            )\n   161\t        )\n   162\t        self._lock = threading.Lock()\n   163\t        self._sig: tuple[int, int, int, int] | None = None\n   164\t        self._last: _Snapshot | None = None\n   165\t\n   166\t    def read(self) -> Mapping[str, bool]:\n   167\t        with self._lock:\n   168\t            try:\n   169\t                fresh = self._load()\n   170\t            except Exception:  # noqa: BLE001 - гонка/мусор не должны ронять запрос\n   171\t                fresh = None\n   172\t            if fresh is not None:\n   173\t                self._last = fresh\n   174\t            snap = self._last\n   175\t            if snap is None:\n   176\t                return {}\n   177\t            now = self._clock()\n   178\t            alive = (\n   179\t                now < snap.expires_at\n   180\t                and (now - snap.generated_at) <= self._max_true_age_s\n   181\t            )\n   182\t            return {name: value and alive for name, value in snap.flags.items()}\n   183\t\n   184\t    def _load(self) -> _Snapshot | None:\n   185\t        euid = os.geteuid()\n   186\t        st = os.lstat(self._path)\n   187\t        if not stat.S_ISREG(st.st_mode):\n   188\t            return None\n   189\t        sig = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)\n   190\t        if sig == self._sig and self._last is not None:\n   191\t            return self._last\n   192\t        parent = os.stat(os.path.dirname(self._path) or \".\")\n   193\t        if parent.st_uid != euid or parent.st_mode & 0o077:\n   194\t            return None\n   195\t        fd = os.open(\n   196\t            self._path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, \"O_CLOEXEC\", 0)\n   197\t        )\n   198\t        try:\n   199\t            before = os.fstat(fd)\n   200\t            if (\n   201\t                not stat.S_ISREG(before.st_mode)\n   202\t                or before.st_uid != euid\n   203\t                or before.st_mode & 0o077\n   204\t                or before.st_size > SNAPSHOT_MAX_BYTES\n   205\t            ):\n   206\t                return None\n   207\t            raw = os.read(fd, SNAPSHOT_MAX_BYTES + 1)\n   208\t        finally:\n   209\t            os.close(fd)\n   210\t        data = json.loads(raw.decode(\"utf-8\"))\n   211\t        if not isinstance(data, dict) or data.get(\"schema_version\") != 1:\n   212\t            return None\n   213\t        flags = data.get(\"flags\")\n   214\t        if not isinstance(flags, dict):\n   215\t            return None\n   216\t        snap = _Snapshot(\n   217\t            generated_at=_parse_utc(data.get(\"generated_at\")),\n   218\t            expires_at=_parse_utc(data.get(\"expires_at\")),\n   219\t            flags={k: v for k, v in flags.items() if isinstance(v, bool)},\n   220\t        )\n   221\t        self._sig = sig\n   222\t        return snap\n   223\t\n   224\t\n   225\tdef _env_bool(env: Mapping[str, str], name: str) -> bool | None:\n   226\t    raw = env.get(ENV_PREFIX + name)\n   227\t    if raw is None:\n   228\t        return None\n   229\t    text = raw.strip().lower()\n   230\t    if text in _TRUE:\n   231\t        return True\n   232\t    if text in _FALSE:\n   233\t        return False\n   234\t    return None\n   235\t\n   236\t\n   237\tdef _env_float(\n   238\t    env: Mapping[str, str],\n   239\t    names: Iterable[str],\n   240\t    default: float,\n   241\t    *,\n   242\t    minimum: float = 0.0,\n   243\t    allow_equal: bool = True,\n   244\t) -> float:\n   245\t    \"\"\"Первое валидное значение из списка имён (основное имя, затем алиасы), иначе default.\"\"\"\n   246\t    for name in names:\n   247\t        raw = env.get(name)\n   248\t        if raw is None:\n   249\t            continue\n   250\t        try:\n   251\t            value = float(raw)\n   252\t        except ValueError:\n   253\t            continue\n   254\t        if math.isfinite(value) and (\n   255\t            value >= minimum if allow_equal else value > minimum\n   256\t        ):\n   257\t            return value\n   258\t    return default\n   259\t\n   260\t\n   261\tdef _env_int(\n   262\t    env: Mapping[str, str], names: Iterable[str], default: int, *, minimum: int = 1\n   263\t) -> int:\n   264\t    for name in names:\n   265\t        raw = env.get(name)\n   266\t        if raw is None:\n   267\t            continue\n   268\t        try:\n   269\t            value = int(raw.strip())\n   270\t        except ValueError:\n   271\t            continue\n   272\t        if value >= minimum:\n   273\t            return value\n   274\t    return default\n   275\t\n   276\t\n   277\tclass ResilienceFlags:\n   278\t    \"\"\"Флаги GigaRC (дефолт false) + пороги из env; env перекрывает снимок, снимок — default.\n   279\t\n   280\t    Булев флаг: `BRIDGE_<ИМЯ>` из env (если задан и валиден) → значение снимка GigaRC →\n   281\t    `False`. Env `false` — аварийный kill-switch поверх снимка. Мастер-флаг `RESILIENCE_ENABLED`\n   282\t    должен быть истинным, иначе остальные не действуют. Читается на каждый запрос: смена\n   283\t    флага вступает в силу без рестарта.\n   284\t    \"\"\"\n   285\t\n   286\t    def __init__(\n   287\t        self,\n   288\t        source: FlagSource | None = None,\n   289\t        env: Mapping[str, str] | None = None,\n   290\t    ) -> None:\n   291\t        self._source: FlagSource = (\n   292\t            source if source is not None else SnapshotFlagSource()\n   293\t        )\n   294\t        self._env = env\n   295\t\n   296\t    def current(self) -> ResilienceSettings:\n   297\t        env: Mapping[str, str] = self._env if self._env is not None else os.environ\n   298\t        try:\n   299\t            snap = self._source.read()\n   300\t        except Exception:  # noqa: BLE001 - источник флагов не должен ронять запрос\n   301\t            snap = {}\n   302\t\n   303\t        def flag(name: str) -> bool:\n   304\t            override = _env_bool(env, name)\n   305\t            return override if override is not None else bool(snap.get(name, False))\n   306\t\n   307\t        master = flag(FLAG_RESILIENCE)\n   308\t        if not master:\n   309\t            return ResilienceSettings()\n   310\t        p = ENV_PREFIX\n   311\t        return ResilienceSettings(\n   312\t            enabled=True,\n   313\t            circuit_breaker=flag(FLAG_CIRCUIT_BREAKER),\n   314\t            bulkhead=flag(FLAG_BULKHEAD),\n   315\t            retry=flag(FLAG_RETRY),\n   316\t            bulkhead_max_concurrent=_env_int(\n   317\t                env,\n   318\t                (\n   319\t                    p + \"BULKHEAD_MAX_CONCURRENT\",\n   320\t                    p + \"BULKHEAD_MAX_PASSTHROUGH\",\n   321\t                ),\n   322\t                64,\n   323\t            ),\n   324\t            bulkhead_retry_after_s=_env_int(env, (p + \"BULKHEAD_RETRY_AFTER_S\",), 1),\n   325\t            fail_threshold=_env_int(\n   326\t                env,\n   327\t                (p + \"CIRCUIT_BREAKER_FAIL_THRESHOLD\", p + \"CB_FAIL_THRESHOLD\"),\n   328\t                3,\n   329\t            ),\n   330\t            cooldown_s=_env_float(\n   331\t                env,\n   332\t                (p + \"CIRCUIT_BREAKER_COOLDOWN_S\", p + \"CB_RESET_TIMEOUT_S\"),\n   333\t                30.0,\n   334\t                minimum=0.0,\n   335\t                allow_equal=False,\n   336\t            ),\n   337\t            cooldown_jitter=min(\n   338\t                _env_float(env, (p + \"CIRCUIT_BREAKER_JITTER\",), 0.2, minimum=0.0),\n   339\t                0.9,\n   340\t            ),\n   341\t            retry_max_attempts=_env_int(env, (p + \"RETRY_MAX_ATTEMPTS\",), 3),\n   342\t            retry_base_delay_s=_env_float(\n   343\t                env,\n   344\t                (p + \"RETRY_BASE_DELAY_S\", p + \"RETRY_BASE_SLEEP_S\"),\n   345\t                1.0,\n   346\t                minimum=0.0,\n   347\t            ),\n   348\t            retry_max_delay_s=_env_float(\n   349\t                env,\n   350\t                (p + \"RETRY_MAX_DELAY_S\", p + \"RETRY_MAX_SLEEP_S\"),\n   351\t                10.0,\n   352\t                minimum=0.0,\n   353\t            ),\n   354\t            retry_backoff_factor=_env_float(\n   355\t                env, (p + \"RETRY_BACKOFF_FACTOR\",), 2.0, minimum=1.0\n   356\t            ),\n   357\t        )\n   358\t\n   359\t\n   360\t# --------------------------------------------------------------------------- Circuit Breaker\n   361\t\n   362\t\n   363\tclass CircuitBreakerState(enum.Enum):\n   364\t    CLOSED = \"CLOSED\"\n   365\t    OPEN = \"OPEN\"\n   366\t    HALF_OPEN = \"HALF_OPEN\"\n   367\t\n   368\t\n   369\tclass CircuitBreaker:\n   370\t    \"\"\"Потокобезопасный автомат CLOSED → OPEN → HALF_OPEN с поколениями (generation tokens).\n   371\t\n   372\t    Каждый переход состояния увеличивает `_generation`. Допущенный вызов получает\n   373\t    `(allowed, generation, is_probe)`; результат с устаревшим поколением игнорируется,\n   374\t    поэтому запоздавший ответ старого запроса не портит состояние. В HALF_OPEN допускается\n   375\t    ровно одна проба; `record_discard` освобождает её слот без фиксации сбоя.\n   376\t    Переход OPEN → HALF_OPEN ленивый — на первом `acquire` после cooldown.\n   377\t    \"\"\"\n   378\t\n   379\t    def __init__(\n   380\t        self,\n   381\t        backend_id: str = \"\",\n   382\t        *,\n   383\t        fail_threshold: int = 3,\n   384\t        cooldown_s: float = 30.0,\n   385\t        cooldown_jitter: float = 0.2,\n   386\t        clock: Callable[[], float] = time.monotonic,\n   387\t        rng: Callable[[float, float], float] = random.uniform,\n   388\t    ) -> None:\n   389\t        self.backend_id = backend_id\n   390\t        self._lock = threading.Lock()\n   391\t        self._clock = clock\n   392\t        self._rng = rng\n   393\t        self._fail_threshold = max(1, int(fail_threshold))\n   394\t        self._cooldown_s = float(cooldown_s)\n   395\t        self._cooldown_jitter = float(cooldown_jitter)\n   396\t        self._state = CircuitBreakerState.CLOSED\n   397\t        self._generation = 0\n   398\t        self._failures = 0\n   399\t        self._probe_in_flight = False\n   400\t        self._open_until = 0.0\n   401\t\n   402\t    def configure(\n   403\t        self,\n   404\t        *,\n   405\t        fail_threshold: int | None = None,\n   406\t        cooldown_s: float | None = None,\n   407\t        cooldown_jitter: float | None = None,\n   408\t    ) -> None:\n   409\t        \"\"\"Горячая смена порогов (GigaRC/env) без потери состояния.\"\"\"\n   410\t        with self._lock:\n   411\t            if fail_threshold is not None:\n   412\t                self._fail_threshold = max(1, int(fail_threshold))\n   413\t            if cooldown_s is not None:\n   414\t                self._cooldown_s = float(cooldown_s)\n   415\t            if cooldown_jitter is not None:\n   416\t                self._cooldown_jitter = float(cooldown_jitter)\n   417\t\n   418\t    @property\n   419\t    def state(self) -> CircuitBreakerState:\n   420\t        with self._lock:\n   421\t            return self._state\n   422\t\n   423\t    @property\n   424\t    def generation(self) -> int:\n   425\t        with self._lock:\n   426\t            return self._generation\n   427\t\n   428\t    @property\n   429\t    def failures(self) -> int:\n   430\t        with self._lock:\n   431\t            return self._failures\n   432\t\n   433\t    @property\n   434\t    def retry_after(self) -> int:\n   435\t        \"\"\"Целые секунды до следующей попытки; 0 — отказ не действует.\"\"\"\n   436\t        with self._lock:\n   437\t            return self._retry_after_locked(self._clock())\n   438\t\n   439\t    def _retry_after_locked(self, now: float) -> int:\n   440\t        if self._state is CircuitBreakerState.OPEN:\n   441\t            remaining = self._open_until - now\n   442\t            return max(1, math.ceil(remaining)) if remaining > 0 else 0\n   443\t        if self._state is CircuitBreakerState.HALF_OPEN and self._probe_in_flight:\n   444\t            return 1\n   445\t        return 0\n   446\t\n   447\t    def _transition_locked(self, state: CircuitBreakerState, now: float) -> None:\n   448\t        self._state = state\n   449\t        self._generation += 1\n   450\t        self._failures = 0\n   451\t        self._probe_in_flight = False\n   452\t        if state is CircuitBreakerState.OPEN:\n   453\t            # Джиттер считается один раз при входе в OPEN: Retry-After стабилен.\n   454\t            spread = self._cooldown_jitter\n   455\t            self._open_until = now + self._cooldown_s * self._rng(\n   456\t                1.0 - spread, 1.0 + spread\n   457\t            )\n   458\t\n   459\t    def acquire(self) -> tuple[bool, int, bool]:\n   460\t        \"\"\"(allowed, generation, is_probe). Отказ — `allowed=False`, вызывать бэкенд нельзя.\"\"\"\n   461\t        with self._lock:\n   462\t            now = self._clock()\n   463\t            if self._state is CircuitBreakerState.OPEN:\n   464\t                if now < self._open_until:\n   465\t                    return False, self._generation, False\n   466\t                self._transition_locked(CircuitBreakerState.HALF_OPEN, now)\n   467\t            if self._state is CircuitBreakerState.HALF_OPEN:\n   468\t                if self._probe_in_flight:\n   469\t                    return False, self._generation, False\n   470\t                self._probe_in_flight = True\n   471\t                return True, self._generation, True\n   472\t            return True, self._generation, False\n   473\t\n   474\t    def record_success(self, generation: int) -> None:\n   475\t        with self._lock:\n   476\t            if generation != self._generation:\n   477\t                return\n   478\t            if self._state is CircuitBreakerState.HALF_OPEN:\n   479\t                self._transition_locked(CircuitBreakerState.CLOSED, self._clock())\n   480\t            elif self._state is CircuitBreakerState.CLOSED:\n   481\t                self._failures = 0\n   482\t\n   483\t    def record_failure(self, generation: int, exc: BaseException | None = None) -> None:\n   484\t        with self._lock:\n   485\t            if generation != self._generation:\n   486\t                return\n   487\t            now = self._clock()\n   488\t            if self._state is CircuitBreakerState.HALF_OPEN:\n   489\t                self._transition_locked(CircuitBreakerState.OPEN, now)\n   490\t            elif self._state is CircuitBreakerState.CLOSED:\n   491\t                self._failures += 1\n   492\t                if self._failures >= self._fail_threshold:\n   493\t                    self._transition_locked(CircuitBreakerState.OPEN, now)\n   494\t\n   495\t    def record_discard(self, generation: int, reason: str = \"\") -> None:\n   496\t        \"\"\"Нейтральный исход (обрыв клиента, 4xx): слот пробы свободен, счётчики не меняются.\"\"\"\n   497\t        with self._lock:\n   498\t            if generation != self._generation:\n   499\t                return\n   500\t            if self._state is CircuitBreakerState.HALF_OPEN:\n   501\t                self._probe_in_flight = False\n   502\t\n   503\t    def snapshot(self) -> dict[str, Any]:\n   504\t        with self._lock:\n   505\t            return {\n   506\t                \"state\": self._state.value,\n   507\t                \"generation\": self._generation,\n   508\t                \"failures\": self._failures,\n   509\t                \"retry_after\": self._retry_after_locked(self._clock()),\n   510\t            }\n   511\t\n   512\t\n   513\t# --------------------------------------------------------------------------- Bulkhead\n   514\t\n   515\t\n   516\tclass BulkheadLease:\n   517\t    \"\"\"Занятый слот отсека; `close()` идемпотентен.\"\"\"\n   518\t\n   519\t    def __init__(self, bulkhead: Bulkhead) -> None:\n   520\t        self._bulkhead: Bulkhead | None = bulkhead\n   521\t        self._lock = threading.Lock()\n   522\t\n   523\t    def close(self) -> None:\n   524\t        with self._lock:\n   525\t            bulkhead, self._bulkhead = self._bulkhead, None\n   526\t        if bulkhead is not None:\n   527\t            bulkhead._release()\n   528\t\n   529\t\n   530\tclass Bulkhead:\n   531\t    \"\"\"Ограничитель параллелизма бэкенда на семафоре; захват неблокирующий (`timeout=0`).\"\"\"\n   532\t\n   533\t    def __init__(self, backend_id: str, capacity: int) -> None:\n   534\t        self.backend_id = backend_id\n   535\t        self.capacity = max(1, int(capacity))\n   536\t        self._sem = threading.BoundedSemaphore(self.capacity)\n   537\t        self._lock = threading.Lock()\n   538\t        self._active = 0\n   539\t\n   540\t    @property\n   541\t    def active(self) -> int:\n   542\t        with self._lock:\n   543\t            return self._active\n   544\t\n   545\t    def acquire(self, timeout: float = 0) -> BulkheadLease | None:\n   546\t        if timeout <= 0:\n   547\t            got = self._sem.acquire(blocking=False)\n   548\t        else:\n   549\t            got = self._sem.acquire(timeout=timeout)\n   550\t        if not got:\n   551\t            return None\n   552\t        with self._lock:\n   553\t            self._active += 1\n   554\t        return BulkheadLease(self)\n   555\t\n   556\t    def _release(self) -> None:\n   557\t        with self._lock:\n   558\t            self._active -= 1\n   559\t        self._sem.release()\n   560\t\n   561\t\n   562\t# --------------------------------------------------------------------------- RetryPolicy\n   563\t\n   564\t\n   565\tdef is_transient_backend_error(exc: BaseException | None) -> bool:\n   566\t    \"\"\"Транзиентный технический сбой бэкенда, повтор допустим.\n   567\t\n   568\t    `None` — вызывающий зафиксировал сбой без исключения (например, upstream 5xx).\n   569\t    Отказы самого слоя отказоустойчивости повторять нельзя.\n   570\t    \"\"\"\n   571\t    if exc is None:\n   572\t        return True\n   573\t    if isinstance(exc, ResilienceError):\n   574\t        return False\n   575\t    return isinstance(\n   576\t        exc,\n   577\t        (TimeoutError, ConnectionError, InterruptedError, subprocess.SubprocessError),\n   578\t    )\n   579\t\n   580\t\n   581\tclass RetryPolicy:\n   582\t    \"\"\"Повторы с экспоненциальным бэкоффом и Full Jitter (агент-агностичная политика).\n   583\t\n   584\t    `attempt` — 0-based индекс только что упавшей попытки; всего попыток `max_attempts`.\n   585\t    Задержка: `uniform(0, min(max_delay, base * factor ** attempt))`. Повтор запрещён, если\n   586\t    клиенту уже отданы байты ответа (`bytes_delivered`) или исчерпан дедлайн.\n   587\t    \"\"\"\n   588\t\n   589\t    def __init__(\n   590\t        self,\n   591\t        max_attempts: int = 3,\n   592\t        base_delay_s: float = 1.0,\n   593\t        max_delay_s: float = 10.0,\n   594\t        backoff_factor: float = 2.0,\n   595\t        *,\n   596\t        rng: Callable[[float, float], float] = random.uniform,\n   597\t        is_transient: Callable[\n   598\t            [BaseException | None], bool\n   599\t        ] = is_transient_backend_error,\n   600\t    ) -> None:\n   601\t        self.max_attempts = max(1, int(max_attempts))\n   602\t        self.base_delay_s = max(0.0, float(base_delay_s))\n   603\t        self.max_delay_s = max(0.0, float(max_delay_s))\n   604\t        self.backoff_factor = max(1.0, float(backoff_factor))\n   605\t        self._rng = rng\n   606\t        self._is_transient = is_transient\n   607\t\n   608\t    @classmethod\n   609\t    def from_settings(cls, settings: ResilienceSettings, **kwargs: Any) -> RetryPolicy:\n   610\t        return cls(\n   611\t            settings.retry_max_attempts,\n   612\t            settings.retry_base_delay_s,\n   613\t            settings.retry_max_delay_s,\n   614\t            settings.retry_backoff_factor,\n   615\t            **kwargs,\n   616\t        )\n   617\t\n   618\t    def should_retry(\n   619\t        self,\n   620\t        attempt: int,\n   621\t        bytes_delivered: bool,\n   622\t        exc: BaseException | None = None,\n   623\t    ) -> bool:\n   624\t        if bytes_delivered or attempt + 1 >= self.max_attempts:\n   625\t            return False\n   626\t        return self._is_transient(exc)\n   627\t\n   628\t    def compute_delay(\n   629\t        self, attempt: int, deadline_s: float | None = None\n   630\t    ) -> float | None:\n   631\t        \"\"\"Секунды сна перед повтором; None — повтор не укладывается в `deadline_s` (остаток).\n   632\t\n   633\t        Показатель степени ограничен, чтобы `factor ** attempt` не переполнялся.\n   634\t        \"\"\"\n   635\t        if deadline_s is not None and deadline_s <= 0:\n   636\t            return None\n   637\t        try:\n   638\t            ceiling = self.base_delay_s * self.backoff_factor ** max(\n   639\t                0, min(attempt, 1023)\n   640\t            )\n   641\t        except OverflowError:\n   642\t            ceiling = math.inf\n   643\t        delay = self._rng(0.0, min(self.max_delay_s, ceiling))\n   644\t        if deadline_s is not None and delay >= deadline_s:\n   645\t            return None\n   646\t        return delay\n   647\t\n   648\t\n   649\t# --------------------------------------------------------------------------- Lease и Manager\n   650\t\n   651\t\n   652\tclass ResilienceLease:\n   653\t    \"\"\"Контекстный менеджер одного запроса: слот Bulkhead + допуск брейкера.\n   654\t\n   655\t    Результат фиксируется только явно (`record_*`). Выход без исключения успехом не считается;\n   656\t    выход с необработанным исключением фиксирует сбой. Первый явный исход финален.\n   657\t    \"\"\"\n   658\t\n   659\t    def __init__(\n   660\t        self,\n   661\t        backend_id: str,\n   662\t        breaker: CircuitBreaker | None = None,\n   663\t        bulkhead_lease: BulkheadLease | None = None,\n   664\t        generation: int = 0,\n   665\t        is_probe: bool = False,\n   666\t    ) -> None:\n   667\t        self.backend_id = backend_id\n   668\t        self.generation = generation\n   669\t        self.is_probe = is_probe\n   670\t        self._breaker = breaker\n   671\t        self._bulkhead_lease = bulkhead_lease\n   672\t        self._recorded = False\n   673\t        self._lock = threading.Lock()\n   674\t\n   675\t    def _claim(self) -> bool:\n   676\t        with self._lock:\n   677\t            if self._recorded:\n   678\t                return False\n   679\t            self._recorded = True\n   680\t            return True\n   681\t\n   682\t    @property\n   683\t    def recorded(self) -> bool:\n   684\t        return self._recorded\n   685\t\n   686\t    def record_success(self) -> None:\n   687\t        if self._claim() and self._breaker is not None:\n   688\t            self._breaker.record_success(self.generation)\n   689\t\n   690\t    def record_failure(self, exc: BaseException | None = None) -> None:\n   691\t        if self._claim() and self._breaker is not None:\n   692\t            self._breaker.record_failure(self.generation, exc)\n   693\t\n   694\t    def record_discard(self, reason: str = \"\") -> None:\n   695\t        if self._claim() and self._breaker is not None:\n   696\t            self._breaker.record_discard(self.generation, reason)\n   697\t\n   698\t    def close(self) -> None:\n   699\t        with self._lock:\n   700\t            lease, self._bulkhead_lease = self._bulkhead_lease, None\n   701\t        if lease is not None:\n   702\t            lease.close()\n   703\t\n   704\t    def __enter__(self) -> ResilienceLease:\n   705\t        return self\n   706\t\n   707\t    def __exit__(\n   708\t        self,\n   709\t        exc_type: type[BaseException] | None,\n   710\t        exc_val: BaseException | None,\n   711\t        exc_tb: TracebackType | None,\n   712\t    ) -> None:\n   713\t        try:\n   714\t            if exc_val is not None:\n   715\t                self.record_failure(exc_val)\n   716\t            elif not self.recorded and self.is_probe:\n   717\t                # Проба без явного исхода не должна навсегда занять слот HALF_OPEN.\n   718\t                self.record_discard(\"no_outcome\")\n   719\t        finally:\n   720\t            self.close()\n   721\t\n   722\t\n   723\tclass ResilienceManager:\n   724\t    \"\"\"Реестр CircuitBreaker и Bulkhead по `backend_id`; настройки читаются на каждый запрос.\"\"\"\n   725\t\n   726\t    def __init__(\n   727\t        self,\n   728\t        flags: ResilienceFlags | None = None,\n   729\t        *,\n   730\t        backend_limits: Mapping[str, int] | None = None,\n   731\t        clock: Callable[[], float] = time.monotonic,\n   732\t        rng: Callable[[float, float], float] = random.uniform,\n   733\t    ) -> None:\n   734\t        self._flags = flags if flags is not None else ResilienceFlags()\n   735\t        self._backend_limits = dict(backend_limits or {})\n   736\t        self._clock = clock\n   737\t        self._rng = rng\n   738\t        self._lock = threading.Lock()\n   739\t        self._breakers: dict[str, CircuitBreaker] = {}\n   740\t        self._bulkheads: dict[str, Bulkhead] = {}\n   741\t\n   742\t    def settings(self) -> ResilienceSettings:\n   743\t        return self._flags.current()\n   744\t\n   745\t    def retry_policy(self) -> RetryPolicy | None:\n   746\t        \"\"\"RetryPolicy по текущим настройкам; None — повторы выключены флагом.\"\"\"\n   747\t        settings = self._flags.current()\n   748\t        if not settings.retry:\n   749\t            return None\n   750\t        return RetryPolicy.from_settings(settings)\n   751\t\n   752\t    def _breaker_for(\n   753\t        self, backend_id: str, settings: ResilienceSettings\n   754\t    ) -> CircuitBreaker:\n   755\t        with self._lock:\n   756\t            breaker = self._breakers.get(backend_id)\n   757\t            if breaker is None:\n   758\t                breaker = CircuitBreaker(\n   759\t                    backend_id,\n   760\t                    fail_threshold=settings.fail_threshold,\n   761\t                    cooldown_s=settings.cooldown_s,\n   762\t                    cooldown_jitter=settings.cooldown_jitter,\n   763\t                    clock=self._clock,\n   764\t                    rng=self._rng,\n   765\t                )\n   766\t                self._breakers[backend_id] = breaker\n   767\t        breaker.configure(\n   768\t            fail_threshold=settings.fail_threshold,\n   769\t            cooldown_s=settings.cooldown_s,\n   770\t            cooldown_jitter=settings.cooldown_jitter,\n   771\t        )\n   772\t        return breaker\n   773\t\n   774\t    def _capacity(self, backend_id: str, settings: ResilienceSettings) -> int:\n   775\t        cap = settings.bulkhead_max_concurrent\n   776\t        return max(1, min(self._backend_limits.get(backend_id, cap), cap))\n   777\t\n   778\t    def _bulkhead_for(self, backend_id: str, settings: ResilienceSettings) -> Bulkhead:\n   779\t        capacity = self._capacity(backend_id, settings)\n   780\t        with self._lock:\n   781\t            bulkhead = self._bulkheads.get(backend_id)\n   782\t            if bulkhead is None or bulkhead.capacity != capacity:\n   783\t                # Смена ёмкости: новый отсек; уже выданные слоты освободят старый семафор.\n   784\t                bulkhead = Bulkhead(backend_id, capacity)\n   785\t                self._bulkheads[backend_id] = bulkhead\n   786\t            return bulkhead\n   787\t\n   788\t    def acquire(self, backend_id: str) -> ResilienceLease:\n   789\t        \"\"\"Допуск запроса к бэкенду либо `CircuitBreakerOpen`/`BulkheadCapacityExceeded`.\"\"\"\n   790\t        settings = self._flags.current()\n   791\t        if not settings.enabled or not (settings.circuit_breaker or settings.bulkhead):\n   792\t            return ResilienceLease(backend_id)\n   793\t        breaker: CircuitBreaker | None = None\n   794\t        generation, is_probe = 0, False\n   795\t        if settings.circuit_breaker:\n   796\t            breaker = self._breaker_for(backend_id, settings)\n   797\t            allowed, generation, is_probe = breaker.acquire()\n   798\t            if not allowed:\n   799\t                raise CircuitBreakerOpen(backend_id, breaker.retry_after or 1)\n   800\t        bulkhead_lease: BulkheadLease | None = None\n   801\t        if settings.bulkhead:\n   802\t            bulkhead_lease = self._bulkhead_for(backend_id, settings).acquire(timeout=0)\n   803\t            if bulkhead_lease is None:\n   804\t                if breaker is not None:\n   805\t                    # Запрос не дошёл до бэкенда: слот пробы HALF_OPEN возвращаем.\n   806\t                    breaker.record_discard(generation, \"bulkhead_rejected\")\n   807\t                raise BulkheadCapacityExceeded(\n   808\t                    backend_id, settings.bulkhead_retry_after_s\n   809\t                )\n   810\t        return ResilienceLease(\n   811\t            backend_id, breaker, bulkhead_lease, generation, is_probe\n   812\t        )\n   813\t\n   814\t    def snapshot(self, extra_backend_ids: Iterable[str] = ()) -> dict[str, Any]:\n   815\t        \"\"\"Состояние всех известных бэкендов для `GET /v1/resilience`.\"\"\"\n   816\t        settings = self._flags.current()\n   817\t        with self._lock:\n   818\t            breakers = dict(self._breakers)\n   819\t            bulkheads = dict(self._bulkheads)\n   820\t        ids = sorted({*breakers, *bulkheads, *extra_backend_ids})\n   821\t        backends: dict[str, Any] = {}\n   822\t        for backend_id in ids:\n   823\t            breaker = breakers.get(backend_id)\n   824\t            bulkhead = bulkheads.get(backend_id)\n   825\t            entry: dict[str, Any] = (\n   826\t                breaker.snapshot()\n   827\t                if breaker is not None\n   828\t                else {\n   829\t                    \"state\": CircuitBreakerState.CLOSED.value,\n   830\t                    \"generation\": 0,\n   831\t                    \"failures\": 0,\n   832\t                    \"retry_after\": 0,\n   833\t                }\n   834\t            )\n   835\t            entry[\"active\"] = bulkhead.active if bulkhead is not None else 0\n   836\t            entry[\"capacity\"] = (\n   837\t                bulkhead.capacity\n   838\t                if bulkhead is not None\n   839\t                else self._capacity(backend_id, settings)\n   840\t            )\n   841\t            backends[backend_id] = entry\n   842\t        return {\n   843\t            \"enabled\": settings.enabled,\n   844\t            \"flags\": {\n   845\t                \"circuit_breaker\": settings.circuit_breaker,\n   846\t                \"bulkhead\": settings.bulkhead,\n   847\t                \"retry\": settings.retry,\n   848\t            },\n   849\t            \"backends\": backends,\n   850\t        }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5360,5540p' server.py; sed -n '6200,6260p' server.py; sed -n '6310,6540p' server.py; sed -n '6810,6965p' server.py; sed -n '7050,7275p' server.py; rg -n 'RESILIENCE =|retry_policy\\\\(|RetryPolicy|retry_max|backoff|class _HandlerSink' server.py core adapters; rg -n 'exception|except|stream|error|finish|\\\\[DONE\\\\]' adapters/passthrough_adapter.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5360,5540p' server.py; sed -n '6200,6260p' server.py; sed -n '6310,6540p' server.py; sed -n '6810,6965p' server.py; sed -n '7050,7275p' server.py; rg -n 'RESILIENCE =|retry_policy\\\\(|RetryPolicy|retry_max|backoff|class _HandlerSink' server.py core adapters; rg -n 'exception|except|stream|error|finish|\\\\[DONE\\\\]' adapters/passthrough_adapter.py\"","aggregated_output":"                        f\"request_id={ctx.get('request_id') or '-'} subagent_id={ctx.get('subagent_id') or '-'}\"\n                    )\n                    if (\n                        plan[\"path\"] in (\"cold\", \"rebase\", \"ephemeral\")\n                        and ctx.get(\"instr\", (0, \"-\", 0))[2]\n                    ):\n                        sections, omitted, nbytes = ctx[\"instr\"]\n                        _log(\n                            f\"instr_guard sections={sections} omitted={omitted} bytes={nbytes}\"\n                        )\n                    if (\n                        chat is not None\n                        and chat.sid\n                        and plan[\"path\"] in (\"hot\", \"restore\")\n                    ):\n                        # Отпечаток ожидающего хода ДО add: после падения моста — только replay.\n                        # Не записан — ход не стартует (иначе рестарт продолжил бы старый SID неоднозначно).\n                        try:\n                            _write_record(chat, \"PENDING\")\n                        except (OSError, StateConflict, ValueError, TypeError) as exc:\n                            chat.state = \"DIRTY\"\n                            _log(\n                                f\"session_rpc chat={chat.key_hash[:8]} persist_failed \"\n                                f\"err={_err_summary(exc, 120)!r}\"\n                            )\n                            stale, chat.proc = chat.proc, None\n                            if stale is not None:\n                                _close_async(stale, \"term\")\n                            _release_turn_slot()\n                            t_held = False\n                            if holds_slot:\n                                POOL.release()\n                                holds_slot = False\n                            return {\n                                \"state\": \"persist_error\",\n                                \"rc\": 1,\n                                \"text\": \"\",\n                                \"usage\": {},\n                                \"result\": {},\n                                \"err\": \"chat state is not writable\",\n                                \"tool_calls\": [],\n                                \"events\": [],\n                            }\n                    _log(\n                        f\"session_rpc chat={plan['hash8']} key={1 if chat is not None else 0} \"\n                        f\"path={plan['path']} gen={(chat.generation if chat else 0)} \"\n                        f\"sid={plan['sid'][:8] or '-'}\"\n                    )\n                    if chat is not None and plan[\"path\"] in (\"cold\", \"rebase\"):\n                        # Новая generation: SID известен только после initialize, PENDING пишется Run до первого add.\n                        plan[\"before_add\"] = functools.partial(_write_pending, chat)\n                    new_run = Run(\n                        plan,\n                        chat.proc if plan[\"path\"] == \"hot\" else None,\n                        holds_slot,\n                        sse_writer,\n                    )\n                    if managed_turn is not None:\n                        managed_turn.bind_process(\n                            pgid=getattr(new_run, \"pgid\", None)\n                            or getattr(getattr(new_run, \"proc\", None), \"pid\", None),\n                            terminate_fn=lambda p=getattr(new_run, \"proc\", None): (\n                                _close_async(p, \"kill\") if p is not None else None\n                            ),\n                        )\n                    holds_slot = False\n                except Exception as exc:  # noqa: BLE001 - любая ошибка подготовки хода: ресурсы назад, штатный 502\n                    if new_run is None:\n                        if t_held:\n                            _release_turn_slot()\n                        if holds_slot:\n                            POOL.release()\n                    _log(\n                        f\"session_rpc chat={plan['hash8']} attempt_setup_failed \"\n                        f\"err={_err_summary(repr(exc), 160)!r}\"\n                    )\n                    out = {\n                        \"state\": \"pump_error\",\n                        \"rc\": 1,\n                        \"text\": \"\",\n                        \"usage\": {},\n                        \"result\": {},\n                        \"err\": repr(exc)[:500],\n                        \"tool_calls\": [],\n                        \"events\": [],\n                    }\n                    break\n                except BaseException:\n                    if new_run is None:\n                        if t_held:\n                            _release_turn_slot()\n                        if holds_slot:\n                            POOL.release()\n                    raise\n                run = new_run\n                open_attempt = (plan, run)\n                try:\n                    out = self._execute(\n                        run,\n                        keepalive,\n                        ctx[\"emulate_tools\"],\n                        sse_writer,\n                    )\n                finally:\n                    try:\n                        run.close()\n                    finally:\n                        if managed_turn is not None:\n                            managed_turn.release_slot_once()\n                        _release_turn_slot()\n                ok = bool(run.ok and out.get(\"state\") == \"done\" and out.get(\"rc\") == 0)\n                try:\n                    committed_turns = _finish_attempt(\n                        chat, plan, run, out, ok, cfg, rpc[\"items\"]\n                    )\n                except PersistError:\n                    # Commit не записан: успешный ответ клиенту не выдаётся, повтор хода не делаем.\n                    open_attempt = None\n                    out = {\n                        \"state\": \"persist_error\",\n                        \"rc\": 1,\n                        \"text\": \"\",\n                        \"usage\": {},\n                        \"result\": {},\n                        \"err\": \"chat state commit failed\",\n                        \"tool_calls\": [],\n                        \"events\": [],\n                    }\n                    break\n                open_attempt = None\n                if ok:\n                    break\n                # Без sse_writer контент до terminal не отдаётся, delivered здесь — страховка.\n                # С sse_writer часть контента могла уже уйти клиенту ЖИВЬЁМ до сбоя (run._live_mids\n                # непусто) — тихий повтор показал бы его клиенту повторно, поэтому тоже delivered.\n                delivered = bool(\n                    out.get(\"text\") or out.get(\"tool_calls\") or run._live_mids\n                )\n                if out[\"state\"] != \"done\" or delivered or attempt == 3:\n                    break\n                # Транзиентный сбой (rc!=0, клиенту ничего не выдано): повтор невидим;\n                # он строится заново из истории запроса, а не повтором user в старую сессию.\n                _log(\n                    f\"transient failure rc={out['rc']} err={_err_summary(out.get('err'), 120)!r}, \"\n                    f\"retry {attempt} {tag}\"\n                )\n                # Сбой egress не должен сохранять SKIP-префлайт: повтор идёт с полным префлайтом.\n                _last_ok[0] = 0.0\n                _sleep(2 * attempt)\n            ok_done = bool(\n                run is not None\n                and run.ok\n                and out.get(\"state\") == \"done\"\n                and out.get(\"rc\") == 0\n            )\n            hot = bool(ok_done and run.path in (\"hot\", \"restore\"))\n            usage = out.get(\"usage\") or {}\n            rep_turns = committed_turns if ok_done else 0\n            sess8 = ((run.sid if ok_done else plan[\"sid\"]) or \"\")[:8] or \"-\"\n            raw_in = usage.get(\"input_tokens\", 0)\n            raw_out = usage.get(\"output_tokens\", 0)\n            cache_read = usage.get(\"cache_read_tokens\")\n            cache_read_str = (\n                str(cache_read)\n                if isinstance(cache_read, int) and not isinstance(cache_read, bool)\n                else \"-\"\n            )\n            _log(\n                f\"usage sess={sess8} raw={raw_in}/{raw_out} \"\n                f\"cache_read={cache_read_str} \"\n                f\"rep={raw_in}/{raw_out} resumed={1 if hot else 0} turns={rep_turns}\"\n            )\n        finally:\n            # Независимые звенья: сбой одного (например, _finish_attempt) не оставляет аренду L и ссылку на чат.\n            try:\n                if open_attempt is not None:\n                    # Исключение посреди хода: чат инвалидируется, процесс не остаётся «в середине хода».\n                    _finish_attempt(\n                        chat,\n                        open_attempt[0],\n                        open_attempt[1],\n            # model/reasoning_effort/tools/Authorization уходят upstream дословно.\n            passthrough = BACKENDS.get(model[\"backend\"])\n            if isinstance(passthrough, PassthroughAdapter):\n                if raw_model != model_id and alias is None:\n                    self._reject(\n                        400,\n                        \"model_not_allowed\",\n                        \"passthrough requires an exact model id\",\n                    )\n                    return\n                if auth_deferred:\n                    hdr = self.headers.get(\"Authorization\", \"\")\n                    client_token = (\n                        hdr[7:].strip()\n                        if hdr.startswith(\"Bearer \")\n                        else (self.headers.get(\"x-api-key\", \"\").strip() or hdr.strip())\n                    )\n                    if (\n                        PASSTHROUGH_AUTH_FLAG_SOURCE.enabled()\n                        and passthrough.validate_client_token(client_token)\n                    ):\n                        auth_deferred = False\n                    elif getattr(passthrough, \"_upstream_key\", None):\n                        self.close_connection = True\n                        self._send(\n                            401,\n                            {\n                                \"error\": {\n                                    \"message\": \"unauthorized\",\n                                    \"type\": \"auth_error\",\n                                }\n                            },\n                        )\n                        return\n                if alias is not None:\n                    req = {**req, \"model\": model_id}\n                    if req.get(\"reasoning_effort\") is None:\n                        req[\"reasoning_effort\"] = alias_effort\n                    raw = json.dumps(req, ensure_ascii=False).encode(\"utf-8\")\n                _log(\n                    f\"chat route=passthrough model={model_id} alias={model_id + '-' + alias[1] if alias else '-'} {self._trace_log_fields()}\"\n                )\n                self._serve_resilient(\n                    model[\"backend\"],\n                    lambda: self._serve_passthrough(passthrough, raw, req, model_id),\n                )\n                return\n            if auth_deferred:\n                self.close_connection = True\n                self._send(\n                    401,\n                    {\n                        \"error\": {\n                            \"message\": \"unauthorized\",\n                            \"type\": \"auth_error\",\n                            \"code\": 401,\n                        }\n                    },\n                )\n                return\n            # (9) effort: строковый вне каталога клампится вниз к allowed модели.\n                        model_id,\n                        model_len,\n                    )\n                    return\n            else:\n                self._reject(\n                    400,\n                    \"unsupported_autonomy\",\n                    \"autonomy must be a string\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (10) reasoning-объект не поддерживаем.\n            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n                self._reject(\n                    400,\n                    \"unsupported_parameter\",\n                    \"reasoning parameter is not supported\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (10a) отказоустойчивость контекста: история вмещается в окно модели до всего прочего.\n            gated = self._context_gate(req, model_id, model, model_len)\n            if gated is None:\n                return\n            req, self._context_pruned = gated\n            # (11) изображения (C-08…C-11).\n            try:\n                images = _collect_images(req, model, effort)\n            except ImageReject as exc:\n                self._reject(\n                    400,\n                    exc.reason,\n                    f\"image rejected: {exc.reason}\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (12) бэкенд модели: допуск/лончер проверяются до SSE и до любого запуска.\n            adapter = BACKENDS.get(model[\"backend\"])\n            ok, why = (\n                (False, \"backend_disabled\") if adapter is None else adapter.preflight()\n            )\n            if not ok:\n                self._reject(\n                    503,\n                    \"launcher_unavailable\",\n                    \"canonical launcher is missing or not executable\"\n                    if why == \"launcher_unavailable\"\n                    else f\"backend {model['backend']} is unavailable: {why}\",\n                    model_id,\n                    model_len,\n                )\n                return\n            raw_messages = req.get(\"messages\")\n            messages = raw_messages if isinstance(raw_messages, list) else []\n            raw_tools = req.get(\"tools\")\n            tools = (\n                [t for t in raw_tools if isinstance(t, dict)]\n                if isinstance(raw_tools, list)\n                else []\n            )\n            tool_choice = req.get(\"tool_choice\")\n            emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n            prompt = _messages_to_prompt(messages, tools, tool_choice, images)\n            extra = (\n                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            )\n            cwd = str(extra.get(\"cwd\") or \"\")\n            fwd_env = self._forwarded_env(extra, model_id, model_len)\n            if fwd_env is False:\n                return\n            req_turn_id = (\n                self.headers.get(\"X-Turn-Id\") or str(extra.get(\"turn_id\") or \"\")\n            ).strip()\n            resume_turn_id = (\n                self.headers.get(\"X-Resume-Turn-Id\")\n                or str(extra.get(\"resume_turn_id\") or \"\")\n            ).strip()\n            for candidate_tid in (req_turn_id, resume_turn_id):\n                if candidate_tid and not validate_turn_id(candidate_tid):\n                    self._reject(\n                        400,\n                        \"invalid_request\",\n                        \"invalid turn_id\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n            # Маршрут хода: нового 400 на ключ нет — плохой/отсутствующий ключ = холодная\n            # изолированная сессия с replay истории запроса.\n            transcript = _transcribe(messages, tools, tool_choice, images)\n            raw_key = req.get(\"prompt_cache_key\")\n            keyed = isinstance(raw_key, str) and 0 < len(raw_key) <= KEY_MAX_LEN\n            if images:\n                route = \"image\"\n            elif _is_title_request(messages, tools, req):\n                route = \"title\"\n            elif not transcript[\"runnable\"]:\n                route = \"fallback\"\n                transcript = {\n                    \"system\": None,\n                    \"runnable\": True,\n                    \"items\": [\n                        {\"role\": \"user\", \"text\": prompt, \"digest\": _digest(prompt)}\n                    ],\n                }\n            elif keyed:\n                route = \"keyed\"\n            else:\n                route = \"nokey\"\n            instr = self._prompt_guard(\n                messages, route, raw_key, cwd, model_id, model_len, adapter\n            )\n            if instr is None:\n                return\n            is_legacy_muse_sleep = (\n                model[\"backend\"] == \"muse\"\n                and not req_turn_id\n                and not resume_turn_id\n                and not keyed\n                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\").is_file()\n                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\")\n                .read_text(encoding=\"utf-8\", errors=\"ignore\")\n                .strip()\n                == \"sleep\"\n            )\n            detach_on_disconnect = (\n                _is_detached_enabled()\n                and (\n                    _client_gone is _DEFAULT_CLIENT_GONE\n                    or bool(req_turn_id or resume_turn_id)\n                )\n                and not is_legacy_muse_sleep\n            )\n            managed_turn: ManagedTurn | None = None\n            attached_existing = False\n            if _is_detached_enabled():\n                try:\n                    managed_turn, attached_existing = (\n                        TURN_MANAGER.create_or_attach_turn(\n                            model=model_id,\n                            backend=model[\"backend\"],\n                            cwd=cwd,\n                            messages=messages,\n                            session_id=raw_key if keyed else \"\",\n                            owner_token_hash=_owner_token_hash(self),\n                            requested_turn_id=req_turn_id or None,\n                            resume_turn_id=resume_turn_id or None,\n                            stream=bool(req.get(\"stream\")),\n                            emulate_tools=emulate_tools,\n                            idle_timeout_s=(\n                                SILENCE_WATCHDOG_S\n                                if _is_watchdog_enabled()\n                                else TIMEOUT_S\n                            ),\n                            safety_cap_s=TIMEOUT_S,\n                        )\n                    )\n                except PermissionError:\n                    self._reject(\n                        403,\n                        \"forbidden\",\n                        \"turn belongs to another token\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n                except ValueError as exc:\n                    self._reject(400, \"invalid_request\", str(exc), model_id, model_len)\n                    return\n            self._active_managed_turn = managed_turn\n            ctx = {\n                \"request_id\": self._trace.request_id if self._trace else None,\n                \"subagent_id\": self._trace.subagent_id if self._trace else None,\n                \"route\": route,\n                \"key_hash\": _key_hash(raw_key)\n                if (route == \"keyed\" and isinstance(raw_key, str))\n                else \"\",\n                \"rpc\": transcript,\n                \"instr\": instr if route in (\"keyed\", \"nokey\") else (0, \"-\", 0),\n                \"model\": model_id,\n                \"backend\": model[\"backend\"],\n                \"model_len\": model_len,\n                \"effort\": effort,\n                \"effort_source\": effort_source,\n                \"autonomy\": autonomy,\n                \"autonomy_source\": autonomy_source,\n                \"prompt\": prompt,\n                \"images\": images,\n                \"cwd\": cwd,\n                \"fwd_env\": fwd_env,\n                \"emulate_tools\": emulate_tools,\n                \"tool_schemas\": build_tool_schemas(raw_tools),\n                \"tag\": (\n                    f\"client={self._client_tag()} \"\n                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n                ),\n                \"stream\": bool(req.get(\"stream\")),\n                \"turn_id\": managed_turn.turn_id if managed_turn is not None else \"\",\n                \"managed_turn\": managed_turn,\n                \"detach_on_disconnect\": detach_on_disconnect,\n                \"attached_existing\": attached_existing,\n            }\n            _log(\n                f\"chat route=cli model={model_id} alias={model_id + '-' + alias[1] if alias else '-'} {self._trace_log_fields()}\"\n            )\n            serve = (\n                (lambda: self._serve_sse(ctx))\n                if ctx[\"stream\"]\n                else (lambda: self._serve_json(ctx))\n            )\n            if attached_existing:\n                # Присоединение к уже идущему ходу нового вызова бэкенда не создаёт: допуск не нужен.\n                serve()\n            else:\n                self._serve_resilient(model[\"backend\"], serve)\n        finally:\n            if (\n                managed_turn is not None\n                and not attached_existing\n                and managed_turn.is_active\n            ):\n                TURN_MANAGER.finalize_abandoned_turn(managed_turn)\n            self._active_managed_turn = None\n            if reserved and budget is not None:\n                budget.release(reserved)\n            _DELIVERY_BUDGET.release(self._delivery_reserved)\n            self._delivery_reserved = 0\n        # Только локальный HTTP-буфер: межмодульный seam уже вернул DTO.\n        out = {\n            \"state\": result.state,\n            \"rc\": result.rc,\n            \"text\": result.text,\n            \"reasoning\": result.reasoning,\n            \"err\": result.err,\n            \"usage\": asdict(result.usage),\n            \"result\": {},\n            \"tool_calls\": [asdict(call) for call in result.tool_calls],\n            \"events\": [\n                (\n                    event.kind,\n                    asdict(event.value)\n                    if not isinstance(event.value, str)\n                    else event.value,\n                )\n                for event in result.events or ()\n            ],\n            \"backend_kind\": adapter.kind,\n        }\n        if (\n            adapter.kind != \"droid\"\n        ):  # droid-путь пишет свои done/usage строки в _run_once\n            # RW-007: сырой stderr/terminal reason бэкенда может содержать пользовательский\n            # текст; в постоянный журнал идут только коды и размеры (сырой err — в ответ клиенту).\n            _log(\n                f\"done model={ctx['model']} backend={adapter.id} rc={out.get('rc')} \"\n                f\"state={out.get('state')} out_bytes={len(str(out.get('text') or '').encode())} \"\n                f\"wall_s={time.monotonic() - t0:.1f} \"\n                f\"err_bytes={len(str(out.get('err') or '').encode())} {ctx['tag']}\"\n            )\n        return out\n\n    @staticmethod\n    def _record_turn_outcome(\n        lease: ResilienceLease, out: dict, backend_err: Any\n    ) -> None:\n        \"\"\"Явный исход хода CLI-бэкенда: успех — `rc == 0` и нет ошибки бэкенда (ADR-0020 §3.2).\"\"\"\n        if backend_err is None and out.get(\"rc\") == 0:\n            lease.record_success()\n        elif out.get(\"state\") in _RESILIENCE_NEUTRAL_STATES:\n            # Локальная перегрузка/хранилище моста — не вина бэкенда: брейкер не штрафуем.\n            lease.record_discard(str(out.get(\"state\")))\n        else:\n            lease.record_failure()\n\n    def _current_lease(self) -> ResilienceLease:\n        \"\"\"Lease текущего запроса; вне `_serve_resilient` (тесты, прямой вызов) — пустой (no-op).\"\"\"\n        return getattr(self, \"_resilience_lease\", None) or ResilienceLease(\"\")\n\n    def _serve_resilient(self, backend_id: str, serve: Callable[[], None]) -> None:\n        \"\"\"Допуск по брейкеру и отсеку ДО любых заголовков; отказ — честный 503 + Retry-After.\"\"\"\n        try:\n            lease = RESILIENCE.acquire(backend_id)\n        except ResilienceError as exc:\n            _log(\n                f\"reject reason=resilience code={exc.error_code} backend={backend_id} \"\n                f\"retry_after={exc.retry_after}\"\n            )\n            self.close_connection = True\n            self._send(\n                503,\n                {\n                    \"error\": {\n                        \"message\": f\"Backend '{backend_id}' is temporarily unavailable: {exc.reason}\",\n                        \"type\": exc.error_type,\n                        \"code\": exc.error_code,\n                        \"retry_after\": exc.retry_after,\n                    }\n                },\n                extra_headers={\"Retry-After\": str(exc.retry_after)},\n            )\n            return\n        # Handler живёт на соединение (keep-alive): lease привязан только к этому запросу.\n        self._resilience_lease = lease\n        try:\n            with lease:\n                try:\n                    serve()\n                except (BrokenPipeError, ConnectionResetError):\n                    lease.record_discard(\"client_disconnected\")\n                    raise\n        finally:\n            self._resilience_lease = None\n\n    def _serve_passthrough(\n        self,\n        adapter: PassthroughAdapter,\n        raw: bytes,\n        req: dict,\n        model_id: str,\n    ) -> None:\n        \"\"\"Passthrough-маршрут: шов пишет ответ клиенту сам (значения заголовков в журнал не идут).\"\"\"\n        lease = self._current_lease()\n        started = time.monotonic()\n        _log(\n            f\"passthrough route model={model_id} backend={adapter.id} {self._trace_log_fields()}\"\n        )\n        raw, req = _strip_passthrough_env(raw, req)\n        headers = {key: value for key, value in self.headers.items()}\n        trace_headers = _trace_headers(self._trace)\n        if REQUEST_ATTRIBUTION_ENABLED:\n            names = {REQUEST_ID_HEADER.lower(), SUBAGENT_ID_HEADER.lower()}\n            headers = {\n                key: value for key, value in headers.items() if key.lower() not in names\n            }\n            headers.update(trace_headers)\n        sink = _HandlerSink(self, extra_headers=trace_headers)\n        try:\n            adapter.handle(\n                path=self.path, raw_body=raw, request=req, headers=headers, sink=sink\n            )\n            # Исход фиксируется явно (ADR-0020 §3.2): обрыв клиента нейтрален, 5xx — сбой бэкенда.\n            if sink.client_gone:\n                lease.record_discard(\"client_disconnected\")\n            elif 0 < sink.status < 500:\n                lease.record_success()\n            else:\n                lease.record_failure()\n        finally:\n            _log(\n                f\"done route=passthrough status={sink.status} {self._trace_log_fields()} elapsed_ms={int((time.monotonic() - started) * 1000)}\"\n            )\n\n    def _serve_json(self, ctx: dict) -> None:\n        started = time.monotonic()\n        self._response_status = 0\n        try:\n            self._serve_json_body(ctx)\n        finally:\n            _log(\n                f\"done route=cli status={self._response_status} {self._trace_log_fields()} elapsed_ms={int((time.monotonic() - started) * 1000)}\"\n            )\n\n    def _serve_json_body(self, ctx: dict[str, Any]) -> None:\n        lease = self._current_lease()\n        out = self._dispatch(ctx, None)\n        if out.get(\"state\") == \"client_gone\":\n            lease.record_discard(\"client_disconnected\")\n            return\n        backend_err = self._error_body(out)\n        self._record_turn_outcome(lease, out, backend_err)\n        err = backend_err or self._reserve_delivery(out)\n        if err is not None:\n            self._send(err[\"code\"], {\"error\": err})\n            return\n        usage = out.get(\"usage\") or {}\n        wire_usage = _wire_usage(\n            usage.get(\"input_tokens\", 0),\n            usage.get(\"output_tokens\", 0),\n            usage.get(\"cache_read_tokens\"),\n        )\n        # content и arguments вызовов сериализуются отдельно и вставляются на место меток: большой текст\n        # не проходит через дополнительный dict -> dumps -> encode (RW-012).\n        marker = \"@@content-\" + uuid.uuid4().hex + \"@@\"\n        )\n\n    def _serve_sse(self, ctx: dict) -> None:\n        started = time.monotonic()\n        self._response_status = 0\n        try:\n            self._serve_sse_body(ctx)\n        finally:\n            _log(\n                f\"done route=cli status={self._response_status} {self._trace_log_fields()} elapsed_ms={int((time.monotonic() - started) * 1000)}\"\n            )\n\n    def _serve_sse_body(self, ctx: dict[str, Any]) -> None:\n        lease = self._current_lease()\n        # RW-203: состояние отказа живой записи не наследуется следующим запросом.\n        self._client_write_dead = False\n        completion_id = f\"chatcmpl-droid-{uuid.uuid4().hex[:12]}\"\n        created = int(time.time())\n        shown_model = ctx[\"model\"]\n        managed_turn: ManagedTurn | None = ctx.get(\"managed_turn\") or getattr(\n            self, \"_active_managed_turn\", None\n        )\n        try:\n            self._response_status = 200\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            if managed_turn is not None:\n                self.send_header(\"X-Turn-Id\", managed_turn.turn_id)\n            for key, value in _trace_headers(self._trace):\n                self.send_header(key, value)\n            if self._context_pruned:\n                # CD-003: сигнал до первого SSE-байта, после старта потока не меняется.\n                self.send_header(ctxres.PRUNED_HEADER, self._context_pruned)\n            self.end_headers()\n            self.close_connection = True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            _log(\"client gone before headers\")\n            lease.record_discard(\"client_disconnected\")\n            if managed_turn is not None and ctx.get(\"detach_on_disconnect\"):\n                TURN_MANAGER.mark_detached(managed_turn.turn_id)\n            return\n\n        if ctx.get(\"attached_existing\") and managed_turn is not None:\n            from_seq = self._parse_from_seq() or 0\n            for frame in TURN_MANAGER.iter_sse_stream(\n                managed_turn,\n                from_seq=from_seq,\n                keepalive_interval_s=min(10.0, KEEPALIVE_S),\n                client_gone_fn=lambda: _client_gone(self.connection),\n            ):\n                if not self._emit(frame):\n                    TURN_MANAGER.mark_detached(managed_turn.turn_id)\n                    return\n            return\n\n        def chunk(delta: dict, finish=None) -> str:\n            return (\n                \"data: \"\n                + json.dumps(\n                    {\n                        \"id\": completion_id,\n                        \"object\": \"chat.completion.chunk\",\n                        \"created\": created,\n                        \"model\": shown_model,\n                        \"choices\": [\n                            {\"index\": 0, \"delta\": delta, \"finish_reason\": finish}\n                        ],\n                    },\n                    ensure_ascii=False,\n                )\n                + \"\\n\\n\"\n            )\n\n        live_sent = [\n            0\n        ]  # RW-211: байты content/reasoning, реально отданные этим запросом\n        reasoning_live_chars = 0\n        sse_lock = threading.RLock()\n        sink_closed = threading.Event()\n\n        def emit(frame: str) -> bool:\n            with sse_lock:\n                return self._emit(frame)\n\n        def stream_error_frame(message: str) -> str:\n            # RW-202/RW-211: fail-close кадр chat.completion.chunk, а не плоский\n            # {\"error\": ...}: id/created/model те же, что у предыдущих кадров,\n            # пустая delta и finish_reason=null.\n            return (\n                \"data: \"\n                + json.dumps(\n                    {\n                        \"id\": completion_id,\n                        \"object\": \"chat.completion.chunk\",\n                        \"created\": created,\n                        \"model\": shown_model,\n                        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n                        \"error\": {\n                            \"message\": message,\n                            \"type\": \"stream_error\",\n                            \"code\": \"live_prefix_invalidated\",\n                            \"param\": None,\n                        },\n                    },\n                    ensure_ascii=False,\n                )\n                + \"\\n\\n\"\n            )\n\n        def keepalive() -> bool:\n            with sse_lock:\n                if sink_closed.is_set():\n                    return False\n                return write_keepalive()\n\n        def write_keepalive() -> bool:\n            # RW-201/RW-009: та же защита, что у sse_writer ниже — запись ограничена\n            # LIVE_WRITE_TIMEOUT_S, а не таймаутом соединения (300с), иначе клиент,\n            # который просто не читает, держит T/L все 300с на одном keepalive.\n            prev_timeout = self.connection.gettimeout()\n            try:\n                self.connection.settimeout(LIVE_WRITE_TIMEOUT_S)\n                return emit(\": keepalive\\n\\n\")\n            finally:\n                self.connection.settimeout(prev_timeout)\n\n        def sse_writer(kind: str, text: str) -> bool:\n            with sse_lock:\n                if sink_closed.is_set() or self._client_write_dead:\n                    return False\n                return write_live(kind, text)\n\n        def write_live(kind: str, text: str) -> bool:\n            nonlocal reasoning_live_chars\n            # AD-002/AD-003: честная живая доставка — content/reasoning_content уходят прямо\n            # отсюда, по мере готовности (с коалесацией ~40мс на стороне _execute), а не одним\n            # куском после полного хода. Разрыв соединения здесь — тот же сигнал, что у keepalive.\n            # RW-009: пишем с коротким таймаутом (не 300с socket-таймаута соединения) — клиент,\n            # который не читает SSE (окно забито), не держит T/L всю длину connection timeout;\n            # TimeoutError/socket.timeout — подвид OSError, _emit его уже превращает в False.\n            field = \"content\" if kind == \"content\" else \"reasoning_content\"\n            ok = True\n            prev_timeout = self.connection.gettimeout()\n            try:\n                self.connection.settimeout(LIVE_WRITE_TIMEOUT_S)\n                for piece in _text_slices(text) if text else [text]:\n                    if not emit(chunk({field: piece})):\n                        ok = False\n                        break\n                    live_sent[0] += len(piece.encode(\"utf-8\"))\n                    if kind == \"reasoning\":\n                        reasoning_live_chars += len(piece)\n            finally:\n                self.connection.settimeout(prev_timeout)\n            if not ok:\n                # RW-203: отказ фиксируется на Handler — _serve_sse больше не отправит\n                # этому клиенту ни одного терминального кадра (включая keepalive).\n                self._client_write_dead = True\n            return ok\n\n        if not emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            # Пустой стартовый кадр успехом не считается; обрыв клиента нейтрален.\n            lease.record_discard(\"client_disconnected\")\n            if managed_turn is not None and ctx.get(\"detach_on_disconnect\"):\n                self._client_write_dead = True\n                TURN_MANAGER.mark_detached(managed_turn.turn_id)\n            else:\n                return\n        try:\n            try:\n                out = self._dispatch(ctx, keepalive, sse_writer)\n            finally:\n                # Возврат адаптера закрывает sink под тем же lock, что и записи.\n                # Даже consumer, переживший join(5), больше не может дописать кадр.\n                with sse_lock:\n                    sink_closed.set()\n        except Exception as exc:  # noqa: BLE001 - RW-211: клиенту нужен конверт, а не сырой сбой\n            if self._client_write_dead:\n                _log(\n                    f\"client_write_dead: dispatch error suppressed \"\n                    f\"err={_err_summary(repr(exc), 160)!r}\"\n                )\n                lease.record_discard(\"client_disconnected\")\n                return\n            if not live_sent[0]:\n                raise  # живых байт не было: прежнее поведение (сбой наружу; lease зафиксирует сбой)\n            _log(f\"live_dispatch_failed err={_err_summary(repr(exc), 160)!r}\")\n            lease.record_failure(exc)\n            emit(stream_error_frame(str(exc)[:500] or exc.__class__.__name__))\n            emit(\"data: [DONE]\\n\\n\")\n            return\n        if self._client_write_dead:\n            # RW-203: сокет отверг живую запись — терминальные кадры (tool_call, stop,\n            # usage, error) и [DONE] мёртвому клиенту не отправляются.\n            _log(\"client_write_dead: terminal frames suppressed\")\n            lease.record_discard(\"client_disconnected\")\n            return\n        if out.get(\"state\") == \"client_gone\":\n            _log(\"client gone mid-stream, child killed\")\n            lease.record_discard(\"client_disconnected\")\n            return\n        backend_err = self._error_body(out)\n        self._record_turn_outcome(lease, out, backend_err)\n        err = backend_err or self._reserve_delivery(out)\n        if err is None:\n            # Доставка — отдельный этап: T/L уже свободны, checkpoint записан; обрыв клиента\n            # здесь ни на что, кроме самого ответа, не влияет. У droid content/reasoning уже ушли\n            # живьём из _execute (sse_writer выше): здесь остаются только tool_call-кадры.\n            live_backend = out.get(\"backend_kind\") == \"droid\"\n            reasoning_to_skip = reasoning_live_chars\n            for kind, value in out.get(\"events\") or []:\n                if kind in (\"content\", \"reasoning\"):\n                    if live_backend:\n                        continue\n                    if kind == \"reasoning\" and reasoning_to_skip:\n                        skipped = min(reasoning_to_skip, len(value))\n                        value = value[skipped:]\n                        reasoning_to_skip -= skipped\n                        if not value:\n                            continue\n                    field = \"content\" if kind == \"content\" else \"reasoning_content\"\n                    # Большое событие выдаётся срезами: в памяти одновременно только один срез SSE-кадра.\n                    delivered = (\n                        all(\nserver.py:524:RESILIENCE = ResilienceManager()\nserver.py:1276:class _HandlerSink(ResponseSink):\ncore/resilience.py:4:RetryPolicy (экспоненциальный бэкофф с Full Jitter и контролем дедлайна). Модуль чистый:\ncore/resilience.py:73:FLAG_RESILIENCE = \"RESILIENCE_ENABLED\"\ncore/resilience.py:100:    retry_max_attempts: int = 3\ncore/resilience.py:102:    retry_max_delay_s: float = 10.0\ncore/resilience.py:103:    retry_backoff_factor: float = 2.0\ncore/resilience.py:341:            retry_max_attempts=_env_int(env, (p + \"RETRY_MAX_ATTEMPTS\",), 3),\ncore/resilience.py:348:            retry_max_delay_s=_env_float(\ncore/resilience.py:354:            retry_backoff_factor=_env_float(\ncore/resilience.py:562:# --------------------------------------------------------------------------- RetryPolicy\ncore/resilience.py:581:class RetryPolicy:\ncore/resilience.py:594:        backoff_factor: float = 2.0,\ncore/resilience.py:604:        self.backoff_factor = max(1.0, float(backoff_factor))\ncore/resilience.py:609:    def from_settings(cls, settings: ResilienceSettings, **kwargs: Any) -> RetryPolicy:\ncore/resilience.py:611:            settings.retry_max_attempts,\ncore/resilience.py:613:            settings.retry_max_delay_s,\ncore/resilience.py:614:            settings.retry_backoff_factor,\ncore/resilience.py:638:            ceiling = self.base_delay_s * self.backoff_factor ** max(\ncore/resilience.py:745:    def retry_policy(self) -> RetryPolicy | None:\ncore/resilience.py:746:        \"\"\"RetryPolicy по текущим настройкам; None — повторы выключены флагом.\"\"\"\ncore/resilience.py:750:        return RetryPolicy.from_settings(settings)\n3:Отдельный raw HTTP-шов вне `TurnContext`/`TurnResult`: запрос уходит upstream (`base_url`\n6:Модуль не знает ни об одном конкретном upstream, клиенте или модели и не импортирует `server`.\n10:`finish_reason` своей choice. Конец потока без `finish_reason` (обрыв upstream, RW-002)\n11:сбрасывает буфер choice: недособранные вызовы downstream не уходят, клиент получает\n12:терминальный error-chunk без `[DONE]`.\n111:    except ValueError:\n119:    except ValueError:\n129:    except ValueError:\n211:    \"\"\"Запись клиенту невозможна (отмена/обрыв): upstream закрывается, повторов нет.\"\"\"\n218:class UpstreamBodyTooLarge(Exception):\n219:    \"\"\"Тело или строка upstream превысили лимит.\"\"\"\n437:    \"\"\"Тело non-stream `chat.completion`: санитизируются `choices[].message.tool_calls`\n444:    except (ValueError, UnicodeDecodeError):\n474:                parser.finish()\n523:def _error_frame(chunk: Mapping[str, Any], code: str, message: str) -> bytes:\n524:    \"\"\"Терминальный error-chunk в форме `chat.completion.chunk` (как fail-close кадр фасада).\"\"\"\n531:            \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n532:            \"error\": {\n534:                \"type\": \"stream_error\",\n545:    \"\"\"SSE-события upstream: (сырые байты события, склеенный `data:` либо None).\"\"\"\n551:            raise UpstreamBodyTooLarge(\"sse_line\")\n559:            raise UpstreamBodyTooLarge(\"sse_event\")\n566:            value = text[5:].decode(\"utf-8\", errors=\"replace\")\n593:    \"\"\"Пробросить SSE-поток upstream клиенту с санитизацией `tool_calls` (AD-005).\n608:    finished: set[int] = set()\n624:    def repetition_error() -> StreamOutcome:\n628:            _error_frame(\n630:                \"upstream_repetition_loop\",\n631:                \"upstream repetition loop detected\",\n677:            k: base[k] for k in base if k not in (\"choices\", \"usage\", \"error\")\n684:            {\"index\": index, \"delta\": {\"content\": text}, \"finish_reason\": None}\n689:        \"\"\"`finish()` парсера choice: удержанный content уходит перед терминалом.\"\"\"\n694:        parsers[index].finish()\n699:                return repetition_error()\n710:            if data.strip() == \"[DONE]\":\n715:                if acc.pending_choices() or (trusted_tools and seen - finished):\n716:                    acc.close()  # [DONE] без finish_reason у choice с вызовами: успеха нет\n719:                        _error_frame(\n721:                            \"upstream_incomplete_stream\",\n722:                            \"upstream stream ended before finish_reason\",\n731:            except ValueError:\n758:                            return repetition_error()\n811:                            return repetition_error()\n812:                if choice.get(\"finish_reason\"):\n813:                    finished.add(index)\n842:                                if k not in (\"choices\", \"usage\", \"error\")\n848:                                    \"finish_reason\": None,\n860:                and not c.get(\"finish_reason\")\n863:            if choices and only_empty and \"usage\" not in chunk and \"error\" not in chunk:\n866:        # EOF без [DONE]: недособранное сбрасывается, незавершённые choices — ошибка.\n871:        unfinished = seen - finished\n872:        if acc.pending_choices() or unfinished:\n876:                _error_frame(\n878:                    \"upstream_incomplete_stream\",\n879:                    \"upstream stream ended before finish_reason\",\n883:    except AccumulatorOverflow:\n887:            _error_frame(\n889:                \"upstream_response_too_large\",\n890:                \"upstream tool_calls exceed the bridge limit\",\n894:    except UpstreamBodyTooLarge:\n898:            _error_frame(\n900:                \"upstream_response_too_large\",\n901:                \"upstream event exceeds the bridge limit\",\n909:def _json_error(\n910:    status: int, error_type: str, message: str\n913:        {\"error\": {\"message\": message, \"type\": error_type, \"code\": status}},\n923:    \"\"\"Тело upstream не больше `limit`: проверка заявленного размера и инкрементальное чтение.\"\"\"\n926:        raise UpstreamBodyTooLarge(\"content_length\")\n935:            raise UpstreamBodyTooLarge(\"body\")\n944:        sessions=SESSIONS_NONE, streaming=STREAMING_NATIVE, usage=\"exact\"\n961:        self._upstream_key = (\n997:        \"\"\"Проверяет клиентский токен по собственному настроенному ключу upstream.\"\"\"\n998:        if not self._upstream_key or not token:\n1001:            token.encode(\"utf-8\"), self._upstream_key.encode(\"utf-8\")\n1011:        return True  # stateless: процессов нет, недоступность upstream — 502/504 на запросе\n1051:        \"\"\"Один запрос: байты тела уходят upstream без мутаций, ответ пишется в `sink`.\"\"\"\n1065:            except socket.timeout:\n1067:                    sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n1070:            except (OSError, http.client.HTTPException):\n1071:                self._fail(sink, 502, \"upstream_unavailable\", \"upstream is unavailable\")\n1074:        except ClientGone:\n1096:            and (not self._upstream_key or k.lower() != \"authorization\")\n1098:        if self._upstream_key:\n1099:            forwarded[\"Authorization\"] = f\"Bearer {self._upstream_key}\"\n1113:        self, sink: ResponseSink, status: int, error_type: str, message: str\n1115:        self._log(f\"passthrough fail status={status} type={error_type}\")\n1116:        headers, body = _json_error(status, error_type, message)\n1137:        if resp.status == 200 and \"text/event-stream\" in content_type:\n1138:            self._relay_stream(resp, schemas, sink, sanitize)\n1142:        except UpstreamBodyTooLarge:\n1146:                \"upstream_response_too_large\",\n1147:                \"upstream response exceeds the bridge limit\",\n1150:        except socket.timeout:\n1152:                sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n1155:        except (OSError, http.client.HTTPException):\n1156:            self._fail(sink, 502, \"upstream_unavailable\", \"upstream is unavailable\")\n1164:    def _relay_stream(\n1173:        flag = getattr(self.host, \"is_trusted_tool_streaming_enabled\", None)\n1177:            and bool(self._upstream_key)\n1189:            (\"Content-Type\", \"text/event-stream\"),\n1206:        except (socket.timeout, OSError, http.client.HTTPException):\n1208:                _error_frame({}, \"upstream_stream_error\", \"upstream stream failed\")\n1213:                f\"passthrough stream incomplete={outcome.incomplete} overflow={outcome.overflow}\"\n","exit_code":0,"status":"completed"}}
