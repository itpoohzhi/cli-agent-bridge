rn_id\n  1308\t            self._enforce_memory_caps_locked()\n  1309\t            return turn, False\n  1310\t\n  1311\t    def finalize_abandoned_turn(self, turn: ManagedTurn | None) -> None:\n  1312\t        \"\"\"Гарантирует освобождение ресурсов хода при выходе потока-исполнителя до финализации.\"\"\"\n  1313\t        if turn is None:\n  1314\t            return\n  1315\t        turn.release_slot_once()\n  1316\t        with self._lock:\n  1317\t            if turn.is_terminal:\n  1318\t                return\n  1319\t            turn.status = STATE_CANCELLED\n  1320\t            turn.updated_at = time.time()\n  1321\t            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\n  1322\t                self._active_by_key.pop(turn.turn_key, None)\n  1323\t            if not turn.buffer.sealed:\n  1324\t                turn.buffer.seal()\n  1325\t            if turn.timeout_controller is not None:\n  1326\t                turn.timeout_controller.close()\n  1327\t            turn.done_event.set()\n  1328\t            self._cond.notify_all()\n  1329\t\n  1330\t    def mark_detached(self, turn_id: str) -> None:\n  1331\t        \"\"\"Переводит активный ход в `RUNNING_DETACHED` при разрыве HTTP-соединения.\"\"\"\n  1332\t        with self._lock:\n  1333\t            turn = self._turns_by_id.get(turn_id)\n  1334\t            if turn is not None and turn.status == STATE_RUNNING_ATTACHED:\n  1276\tclass _HandlerSink(ResponseSink):\n  1277\t    \"\"\"Запись ответа passthrough-шва в сокет клиента; сбой записи — ClientGone.\"\"\"\n  1278\t\n  1279\t    _DROP = frozenset({\"server\", \"date\"})\n  1280\t\n  1281\t    def __init__(\n  1282\t        self,\n  1283\t        handler: BaseHTTPRequestHandler,\n  1284\t        extra_headers: list[tuple[str, str]] | None = None,\n  1285\t    ) -> None:\n  1286\t        self._handler = handler\n  1287\t        self._extra_headers = list(extra_headers or ())\n  1288\t        self._extra_names = {key.lower() for key, _ in self._extra_headers}\n  1289\t        if extra_headers is not None and REQUEST_ATTRIBUTION_ENABLED:\n  1290\t            # Upstream не должен приписывать отсутствующий у клиента subagent_id.\n  1291\t            self._extra_names.update(\n  1292\t                {REQUEST_ID_HEADER.lower(), SUBAGENT_ID_HEADER.lower()}\n  1293\t            )\n  1294\t        self.status = 0\n  1295\t        self.client_gone = False\n  1296\t\n  1297\t    def start(self, status: int, headers: list[tuple[str, str]]) -> None:\n  1298\t        self.status = int(status)\n  1299\t        try:\n  1300\t            self._handler.send_response(int(status))\n  1301\t            for key, value in headers:\n  1302\t                if key.lower() not in self._DROP | self._extra_names:\n  1303\t                    self._handler.send_header(key, value)\n  1304\t            for key, value in self._extra_headers:\n  1305\t                self._handler.send_header(key, value)\n  1306\t            if not any(key.lower() == \"content-length\" for key, _ in headers):\n  1307\t                self._handler.close_connection = (\n  1308\t                    True  # тело без длины (SSE) — конец по закрытию\n  1309\t                )\n  1310\t            self._handler.end_headers()\n  1311\t        except (BrokenPipeError, ConnectionResetError, OSError) as exc:\n  1312\t            self.client_gone = True\n  1313\t            raise ClientGone() from exc\n  1314\t\n  1315\t    def write(self, data: bytes) -> None:\n  1316\t        try:\n  1317\t            self._handler.wfile.write(data)\n  1318\t            self._handler.wfile.flush()\n  1319\t        except (BrokenPipeError, ConnectionResetError, OSError) as exc:\n  1320\t            self.client_gone = True\n  1321\t            raise ClientGone() from exc\n  1322\t\n  1323\t\n  1324\tdef _owner_token_hash(handler: BaseHTTPRequestHandler) -> str:\n  1325\t    return hash_token(_extract_auth_token(handler) or AUTH_KEY)\n  1326\t\n    50\t    \"note\": \"резерв байт по заявленному Content-Length ДО чтения тела; семафор исполнения (128) и TCP backlog лимитами HTTP-обработчиков и памяти не считаются\"\n    51\t  },\n    52\t  \"backends\": {\n    53\t    \"droid\": {\n    54\t      \"kind\": \"droid\",\n    55\t      \"enabled\": false,\n    56\t      \"required\": false,\n    57\t      \"owned_by\": \"factory-droid\",\n    58\t      \"max_concurrent\": 4\n    59\t    },\n    60\t    \"muse\": {\n    61\t      \"kind\": \"muse\",\n    62\t      \"enabled\": true,\n    63\t      \"required\": false,\n    64\t      \"owned_by\": \"meta-muse\",\n    65\t      \"max_concurrent\": 1,\n    66\t      \"wrapper\": \"~/.config/muse-launch/muse-cli.sh\",\n    67\t      \"technical_ref\": {\n    68\t        \"version\": \"1.4.3\",\n    69\t        \"binary_sha256\": \"c6db294799a190ca380da274beb3b9c0e160e0da9681a3d364ce8b0e5fa3a4bc\",\n    70\t        \"binary_path\": \"~/.local/bin/muse\"\n    71\t      },\n    72\t      \"options\": {\n    73\t        \"streaming_mode\": \"serve\"\n    74\t      }\n    75\t    },\n    76\t    \"codex\": {\n    77\t      \"kind\": \"passthrough\",\n    78\t      \"enabled\": true,\n    79\t      \"required\": false,\n    80\t      \"owned_by\": \"openai-codex\",\n    81\t      \"max_concurrent\": 128,\n    82\t      \"base_url\": \"http://127.0.0.1:2455/v1\",\n    83\t      \"api_key_env\": \"CODEX_LB_API_KEY\"\n    84\t    },\n    85\t    \"agy\": {\n    86\t      \"kind\": \"passthrough\",\n    87\t      \"enabled\": true,\n    88\t      \"required\": false,\n    89\t      \"owned_by\": \"agy-bridge\",\n    90\t      \"max_concurrent\": 128,\n    91\t      \"base_url\": \"http://127.0.0.1:9887/v1\",\n    92\t      \"api_key_env\": \"AGY_BRIDGE_KEY\"\n    93\t    },\n    94\t    \"opencode-zen\": {\n    95\t      \"kind\": \"passthrough\",\n    96\t      \"enabled\": true,\n    97\t      \"required\": false,\n    98\t      \"owned_by\": \"opencode-zen-bridge\",\n    99\t      \"max_concurrent\": 128,\n   100\t      \"base_url\": \"http://127.0.0.1:9883/v1\",\n   101\t      \"api_key_env\": \"OPENCODE_ZEN_BRIDGE_KEY\"\n   102\t    },\n   103\t    \"claude-p\": {\n   104\t      \"kind\": \"passthrough\",\n   105\t      \"enabled\": true,\n   106\t      \"required\": false,\n   107\t      \"owned_by\": \"claude-p-bridge\",\n   108\t      \"max_concurrent\": 128,\n   109\t      \"base_url\": \"http://127.0.0.1:9881/v1\",\n   110\t      \"api_key_env\": \"CLAUDE_P_BRIDGE_KEY\"\n6:503 + `Retry-After` без обращения к upstream, `GET /v1/resilience`, неизменный `/health`.\n112:    assert exc.retry_after == 30  # ceil(30.0 - 0): jitter выключен, время не шло\n137:    assert breaker.retry_after == 1\n157:    assert breaker.retry_after == 30  # новый cooldown с момента сбоя пробы\n227:    assert caught.value.retry_after == 1\n235:    assert snap[\"active\"] == 64 and snap[\"capacity\"] == 64\n244:def test_bulkhead_capacity_is_configurable_and_backend_limited():\n281:def test_bulkhead_capacity_change_applies_without_restart():\n300:def test_retry_policy_full_jitter_and_deadline():\n337:    transient = ConnectionError(\"upstream reset\")\n338:    assert policy.should_retry(0, bytes_delivered=False, exc=transient) is True\n339:    assert policy.should_retry(0, bytes_delivered=True, exc=transient) is False\n340:    assert policy.should_retry(0, bytes_delivered=True, exc=None) is False\n343:    assert [three.should_retry(a, False, transient) for a in range(4)] == [\n349:    assert three.should_retry(0, False, ValueError(\"bad request\")) is False\n351:        three.should_retry(0, False, None) is True\n352:    )  # сбой без исключения (upstream 5xx)\n356:def test_retry_policy_from_manager_follows_flag():\n360:    policy = manager.retry_policy()\n368:    assert off.retry_policy() is None\n394:    assert (off.enabled, off.circuit_breaker, off.bulkhead, off.retry) == (False,) * 4\n411:    assert (on.enabled, on.circuit_breaker, on.bulkhead, on.retry) == (True,) * 4\n417:    assert (on.retry_max_attempts, on.retry_base_delay_s, on.retry_max_delay_s) == (\n437:    assert (master_off.circuit_breaker, master_off.bulkhead, master_off.retry) == (\n444:    assert forced.enabled and forced.retry and not forced.bulkhead\n464:        tuned.retry_max_attempts,\n465:        tuned.retry_base_delay_s,\n466:        tuned.retry_max_delay_s,\n484:    assert garbage.retry_base_delay_s == 1.0\n554:    \"\"\"Настоящий Handler + управляемый upstream; RESILIENCE подменяется тестом.\"\"\"\n558:    class Upstream(BaseHTTPRequestHandler):\n577:    upstream = Srv((\"127.0.0.1\", 0), Upstream)\n579:        target=upstream.serve_forever, kwargs={\"poll_interval\": 0.01}, daemon=True\n585:                base_url=f\"http://127.0.0.1:{upstream.server_port}/v1\",\n603:    monkeypatch.setattr(server, \"_is_detached_enabled\", lambda: False)\n639:        upstream.shutdown()\n640:        upstream.server_close()\n643:def test_facade_open_breaker_returns_503_retry_after_without_upstream_call(facade):\n649:        assert status == 502  # честный ответ upstream, без подмены\n653:    assert facade.state.hits == 3  # fail-fast: upstream не вызывался\n654:    assert headers[\"retry-after\"] == \"30\"\n659:        \"retry_after\": 30,\n661:    # Другой бэкенд (opencode-zen) не задет и по-прежнему доходит до upstream.\n697:        assert headers[\"retry-after\"] == \"1\"\n717:    assert snap[\"backends\"][\"agy\"][\"retry_after\"] >= 1\n723:        \"retry_after\": 0,\n725:        \"capacity\": 64,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"PANEL-NONCE: e10dce6b1e4b7b17\nARTIFACT-SHA256: 8b703e9c4d5d73321cc4cf48a02a801ddc4f4e47d9c325c9a21a5e75d5c38cf6\nAGREE RW-001 — проверил: core/resilience.py:745, server.py:5304, server.py:5508 — retry_policy() не вызывается из фасада и адаптеров; прежние три попытки и линейный сон 2 * attempt не управляются новой политикой.\nAGREE RW-002 — проверил: adapters/passthrough_adapter.py:1194, adapters/passthrough_adapter.py:1206, server.py:6926 — после HTTP 200 ошибка upstream превращается в SSE error-frame без передачи исхода фасаду; сохранённый status=200 вызывает record_success().\nAGREE RW-003 — проверил: server.py:6353, server.py:6452, server.py:6528 — preflight и создание ManagedTurn предшествуют допуску; отказ preflight возвращает 503 без Retry-After, обходя обработчик ResilienceError.\nAGREE RW-004 — проверил: server.py:524, core/resilience.py:774, core/resilience.py:782 — backend_limits не переданы; изменение ёмкости заменяет Bulkhead новым семафором, позволяя новые захваты без учёта ещё активных старых слотов.\nAGREE RW-005 — проверил: server.py:7214, server.py:7222, server.py:7247, core/resilience.py:675, core/resilience.py:495 — discard до продолжающегося detached-выполнения освобождает пробу HALF_OPEN и окончательно фиксирует исход lease; последующий результат теряется, а _client_write_dead также подавляет учёт ошибки бэкенда.\nVERDICT: NEEDS WORK"}}
