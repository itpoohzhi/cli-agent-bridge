                )\n  5463\t                finally:\n  5464\t                    try:\n  5465\t                        run.close()\n  5466\t                    finally:\n  5467\t                        if managed_turn is not None:\n  5468\t                            managed_turn.release_slot_once()\n  5469\t                        _release_turn_slot()\n  5470\t                ok = bool(run.ok and out.get(\"state\") == \"done\" and out.get(\"rc\") == 0)\n  5471\t                try:\n  5472\t                    committed_turns = _finish_attempt(\n  5473\t                        chat, plan, run, out, ok, cfg, rpc[\"items\"]\n  5474\t                    )\n  5475\t                except PersistError:\n  5476\t                    # Commit не записан: успешный ответ клиенту не выдаётся, повтор хода не делаем.\n  5477\t                    open_attempt = None\n  5478\t                    out = {\n  5479\t                        \"state\": \"persist_error\",\n  5480\t                        \"rc\": 1,\n  5481\t                        \"text\": \"\",\n  5482\t                        \"usage\": {},\n  5483\t                        \"result\": {},\n  5484\t                        \"err\": \"chat state commit failed\",\n  5485\t                        \"tool_calls\": [],\n  5486\t                        \"events\": [],\n  5487\t                    }\n  5488\t                    break\n  5489\t                open_attempt = None\n  5490\t                if ok:\n  5491\t                    break\n  5492\t                # Без sse_writer контент до terminal не отдаётся, delivered здесь — страховка.\n  5493\t                # С sse_writer часть контента могла уже уйти клиенту ЖИВЬЁМ до сбоя (run._live_mids\n  5494\t                # непусто) — тихий повтор показал бы его клиенту повторно, поэтому тоже delivered.\n  5495\t                delivered = bool(\n  5496\t                    out.get(\"text\") or out.get(\"tool_calls\") or run._live_mids\n  5497\t                )\n  5498\t                if out[\"state\"] != \"done\" or delivered or attempt == 3:\n  5499\t                    break\n  5500\t                # Транзиентный сбой (rc!=0, клиенту ничего не выдано): повтор невидим;\n  5501\t                # он строится заново из истории запроса, а не повтором user в старую сессию.\n  5502\t                _log(\n  5503\t                    f\"transient failure rc={out['rc']} err={_err_summary(out.get('err'), 120)!r}, \"\n  5504\t                    f\"retry {attempt} {tag}\"\n  5505\t                )\n  5506\t                # Сбой egress не должен сохранять SKIP-префлайт: повтор идёт с полным префлайтом.\n  5507\t                _last_ok[0] = 0.0\n  5508\t                _sleep(2 * attempt)\n  5509\t            ok_done = bool(\n  5510\t                run is not None\n  5511\t                and run.ok\n  5512\t                and out.get(\"state\") == \"done\"\n  5513\t                and out.get(\"rc\") == 0\n  5514\t            )\n  5515\t            hot = bool(ok_done and run.path in (\"hot\", \"restore\"))\n  5516\t            usage = out.get(\"usage\") or {}\n  5517\t            rep_turns = committed_turns if ok_done else 0\n  5518\t            sess8 = ((run.sid if ok_done else plan[\"sid\"]) or \"\")[:8] or \"-\"\n  5519\t            raw_in = usage.get(\"input_tokens\", 0)\n  5520\t            raw_out = usage.get(\"output_tokens\", 0)\n  5521\t            cache_read = usage.get(\"cache_read_tokens\")\n  5522\t            cache_read_str = (\n  5523\t                str(cache_read)\n  5524\t                if isinstance(cache_read, int) and not isinstance(cache_read, bool)\n  5525\t                else \"-\"\n  6325\t                self._reject(\n  6326\t                    400,\n  6327\t                    \"unsupported_parameter\",\n  6328\t                    \"reasoning parameter is not supported\",\n  6329\t                    model_id,\n  6330\t                    model_len,\n  6331\t                )\n  6332\t                return\n  6333\t            # (10a) отказоустойчивость контекста: история вмещается в окно модели до всего прочего.\n  6334\t            gated = self._context_gate(req, model_id, model, model_len)\n  6335\t            if gated is None:\n  6336\t                return\n  6337\t            req, self._context_pruned = gated\n  6338\t            # (11) изображения (C-08…C-11).\n  6339\t            try:\n  6340\t                images = _collect_images(req, model, effort)\n  6341\t            except ImageReject as exc:\n  6342\t                self._reject(\n  6343\t                    400,\n  6344\t                    exc.reason,\n  6345\t                    f\"image rejected: {exc.reason}\",\n  6346\t                    model_id,\n  6347\t                    model_len,\n  6348\t                )\n  6349\t                return\n  6350\t            # (12) бэкенд модели: допуск/лончер проверяются до SSE и до любого запуска.\n  6351\t            adapter = BACKENDS.get(model[\"backend\"])\n  6352\t            ok, why = (\n  6353\t                (False, \"backend_disabled\") if adapter is None else adapter.preflight()\n  6354\t            )\n  6355\t            if not ok:\n  6356\t                self._reject(\n  6357\t                    503,\n  6358\t                    \"launcher_unavailable\",\n  6359\t                    \"canonical launcher is missing or not executable\"\n  6360\t                    if why == \"launcher_unavailable\"\n  6361\t                    else f\"backend {model['backend']} is unavailable: {why}\",\n  6362\t                    model_id,\n  6363\t                    model_len,\n  6364\t                )\n  6365\t                return\n  6366\t            raw_messages = req.get(\"messages\")\n  6367\t            messages = raw_messages if isinstance(raw_messages, list) else []\n  6368\t            raw_tools = req.get(\"tools\")\n  6369\t            tools = (\n  6370\t                [t for t in raw_tools if isinstance(t, dict)]\n  6371\t                if isinstance(raw_tools, list)\n  6372\t                else []\n  6373\t            )\n  6374\t            tool_choice = req.get(\"tool_choice\")\n  6375\t            emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n  6430\t                and not req_turn_id\n  6431\t                and not resume_turn_id\n  6432\t                and not keyed\n  6433\t                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\").is_file()\n  6434\t                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\")\n  6435\t                .read_text(encoding=\"utf-8\", errors=\"ignore\")\n  6436\t                .strip()\n  6437\t                == \"sleep\"\n  6438\t            )\n  6439\t            detach_on_disconnect = (\n  6440\t                _is_detached_enabled()\n  6441\t                and (\n  6442\t                    _client_gone is _DEFAULT_CLIENT_GONE\n  6443\t                    or bool(req_turn_id or resume_turn_id)\n  6444\t                )\n  6445\t                and not is_legacy_muse_sleep\n  6446\t            )\n  6447\t            managed_turn: ManagedTurn | None = None\n  6448\t            attached_existing = False\n  6449\t            if _is_detached_enabled():\n  6450\t                try:\n  6451\t                    managed_turn, attached_existing = (\n  6452\t                        TURN_MANAGER.create_or_attach_turn(\n  6453\t                            model=model_id,\n  6454\t                            backend=model[\"backend\"],\n  6455\t                            cwd=cwd,\n  6456\t                            messages=messages,\n  6457\t                            session_id=raw_key if keyed else \"\",\n  6458\t                            owner_token_hash=_owner_token_hash(self),\n  6459\t                            requested_turn_id=req_turn_id or None,\n  6460\t                            resume_turn_id=resume_turn_id or None,\n  6461\t                            stream=bool(req.get(\"stream\")),\n  6462\t                            emulate_tools=emulate_tools,\n  6463\t                            idle_timeout_s=(\n  6464\t                                SILENCE_WATCHDOG_S\n  6465\t                                if _is_watchdog_enabled()\n  6466\t                                else TIMEOUT_S\n  6467\t                            ),\n  6468\t                            safety_cap_s=TIMEOUT_S,\n  6469\t                        )\n  6470\t                    )\n  6471\t                except PermissionError:\n  6472\t                    self._reject(\n  6473\t                        403,\n  6474\t                        \"forbidden\",\n  6475\t                        \"turn belongs to another token\",\n  6476\t                        model_id,\n  6477\t                        model_len,\n  6478\t                    )\n  6479\t                    return\n  6480\t                except ValueError as exc:\n  6481\t                    self._reject(400, \"invalid_request\", str(exc), model_id, model_len)\n  6482\t                    return\n  6483\t            self._active_managed_turn = managed_turn\n  6484\t            ctx = {\n  6485\t                \"request_id\": self._trace.request_id if self._trace else None,\n  6486\t                \"subagent_id\": self._trace.subagent_id if self._trace else None,\n  6487\t                \"route\": route,\n  6488\t                \"key_hash\": _key_hash(raw_key)\n  6489\t                if (route == \"keyed\" and isinstance(raw_key, str))\n  6490\t                else \"\",\n  6491\t                \"rpc\": transcript,\n  6492\t                \"instr\": instr if route in (\"keyed\", \"nokey\") else (0, \"-\", 0),\n  6493\t                \"model\": model_id,\n  6494\t                \"backend\": model[\"backend\"],\n  6495\t                \"model_len\": model_len,\n  6496\t                \"effort\": effort,\n  6497\t                \"effort_source\": effort_source,\n  6498\t                \"autonomy\": autonomy,\n  6499\t                \"autonomy_source\": autonomy_source,\n  6500\t                \"prompt\": prompt,\n  6501\t                \"images\": images,\n  6502\t                \"cwd\": cwd,\n  6503\t                \"fwd_env\": fwd_env,\n  6504\t                \"emulate_tools\": emulate_tools,\n  6505\t                \"tool_schemas\": build_tool_schemas(raw_tools),\n  6506\t                \"tag\": (\n  6507\t                    f\"client={self._client_tag()} \"\n  6508\t                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n  6509\t                ),\n  6510\t                \"stream\": bool(req.get(\"stream\")),\n  6511\t                \"turn_id\": managed_turn.turn_id if managed_turn is not None else \"\",\n  6512\t                \"managed_turn\": managed_turn,\n  6513\t                \"detach_on_disconnect\": detach_on_disconnect,\n  6514\t                \"attached_existing\": attached_existing,\n  6515\t            }\n  6516\t            _log(\n  6517\t                f\"chat route=cli model={model_id} alias={model_id + '-' + alias[1] if alias else '-'} {self._trace_log_fields()}\"\n  6518\t            )\n  6519\t            serve = (\n  6520\t                (lambda: self._serve_sse(ctx))\n  6521\t                if ctx[\"stream\"]\n  6522\t                else (lambda: self._serve_json(ctx))\n  6523\t            )\n  6524\t            if attached_existing:\n  6525\t                # Присоединение к уже идущему ходу нового вызова бэкенда не создаёт: допуск не нужен.\n  6526\t                serve()\n  6527\t            else:\n  6528\t                self._serve_resilient(model[\"backend\"], serve)\n  6529\t        finally:\n  6530\t            if (\n  6531\t                managed_turn is not None\n  6532\t                and not attached_existing\n  6533\t                and managed_turn.is_active\n  6534\t            ):\n  6535\t                TURN_MANAGER.finalize_abandoned_turn(managed_turn)\n  6838\t                f\"state={out.get('state')} out_bytes={len(str(out.get('text') or '').encode())} \"\n  6839\t                f\"wall_s={time.monotonic() - t0:.1f} \"\n  6840\t                f\"err_bytes={len(str(out.get('err') or '').encode())} {ctx['tag']}\"\n  6841\t            )\n  6842\t        return out\n  6843\t\n  6844\t    @staticmethod\n  6845\t    def _record_turn_outcome(\n  6846\t        lease: ResilienceLease, out: dict, backend_err: Any\n  6847\t    ) -> None:\n  6848\t        \"\"\"Явный исход хода CLI-бэкенда: успех — `rc == 0` и нет ошибки бэкенда (ADR-0020 §3.2).\"\"\"\n  6849\t        if backend_err is None and out.get(\"rc\") == 0:\n  6850\t            lease.record_success()\n  6851\t        elif out.get(\"state\") in _RESILIENCE_NEUTRAL_STATES:\n  6852\t            # Локальная перегрузка/хранилище моста — не вина бэкенда: брейкер не штрафуем.\n  6853\t            lease.record_discard(str(out.get(\"state\")))\n  6854\t        else:\n  6855\t            lease.record_failure()\n  6856\t\n  6857\t    def _current_lease(self) -> ResilienceLease:\n  6858\t        \"\"\"Lease текущего запроса; вне `_serve_resilient` (тесты, прямой вызов) — пустой (no-op).\"\"\"\n  6859\t        return getattr(self, \"_resilience_lease\", None) or ResilienceLease(\"\")\n  6860\t\n  6861\t    def _serve_resilient(self, backend_id: str, serve: Callable[[], None]) -> None:\n  6862\t        \"\"\"Допуск по брейкеру и отсеку ДО любых заголовков; отказ — честный 503 + Retry-After.\"\"\"\n  6863\t        try:\n  6864\t            lease = RESILIENCE.acquire(backend_id)\n  6865\t        except ResilienceError as exc:\n  6866\t            _log(\n  6867\t                f\"reject reason=resilience code={exc.error_code} backend={backend_id} \"\n  6868\t                f\"retry_after={exc.retry_after}\"\n  6869\t            )\n  6870\t            self.close_connection = True\n  6871\t            self._send(\n  6872\t                503,\n  6873\t                {\n  6874\t                    \"error\": {\n  6875\t                        \"message\": f\"Backend '{backend_id}' is temporarily unavailable: {exc.reason}\",\n  6876\t                        \"type\": exc.error_type,\n  6877\t                        \"code\": exc.error_code,\n  6878\t                        \"retry_after\": exc.retry_after,\n  6879\t                    }\n  6880\t                },\n  6881\t                extra_headers={\"Retry-After\": str(exc.retry_after)},\n  6882\t            )\n  6883\t            return\n  6884\t        # Handler живёт на соединение (keep-alive): lease привязан только к этому запросу.\n  6885\t        self._resilience_lease = lease\n  6886\t        try:\n  6887\t            with lease:\n  6888\t                try:\n  6889\t                    serve()\n  6890\t                except (BrokenPipeError, ConnectionResetError):\n  6891\t                    lease.record_discard(\"client_disconnected\")\n  6892\t                    raise\n  6893\t        finally:\n  6894\t            self._resilience_lease = None\n  6895\t\n  6896\t    def _serve_passthrough(\n  6897\t        self,\n  6898\t        adapter: PassthroughAdapter,\n  6899\t        raw: bytes,\n  6900\t        req: dict,\n  6901\t        model_id: str,\n  6902\t    ) -> None:\n  6903\t        \"\"\"Passthrough-маршрут: шов пишет ответ клиенту сам (значения заголовков в журнал не идут).\"\"\"\n  6904\t        lease = self._current_lease()\n  6905\t        started = time.monotonic()\n  6906\t        _log(\n  6907\t            f\"passthrough route model={model_id} backend={adapter.id} {self._trace_log_fields()}\"\n  6908\t        )\n  6909\t        raw, req = _strip_passthrough_env(raw, req)\n  6910\t        headers = {key: value for key, value in self.headers.items()}\n  6911\t        trace_headers = _trace_headers(self._trace)\n  6912\t        if REQUEST_ATTRIBUTION_ENABLED:\n  6913\t            names = {REQUEST_ID_HEADER.lower(), SUBAGENT_ID_HEADER.lower()}\n  6914\t            headers = {\n  6915\t                key: value for key, value in headers.items() if key.lower() not in names\n  6916\t            }\n  6917\t            headers.update(trace_headers)\n  6918\t        sink = _HandlerSink(self, extra_headers=trace_headers)\n  6919\t        try:\n  6920\t            adapter.handle(\n  6921\t                path=self.path, raw_body=raw, request=req, headers=headers, sink=sink\n  6922\t            )\n  6923\t            # Исход фиксируется явно (ADR-0020 §3.2): обрыв клиента нейтрален, 5xx — сбой бэкенда.\n  6924\t            if sink.client_gone:\n  6925\t                lease.record_discard(\"client_disconnected\")\n  6926\t            elif 0 < sink.status < 500:\n  6927\t                lease.record_success()\n  6928\t            else:\n  6929\t                lease.record_failure()\n  6930\t        finally:\n  6931\t            _log(\n  6932\t                f\"done route=passthrough status={sink.status} {self._trace_log_fields()} elapsed_ms={int((time.monotonic() - started) * 1000)}\"\n  6933\t            )\n  6934\t\n  6935\t    def _serve_json(self, ctx: dict) -> None:\n  6936\t        started = time.monotonic()\n  6937\t        self._response_status = 0\n  6938\t        try:\n  6939\t            self._serve_json_body(ctx)\n  6940\t        finally:\n  6941\t            _log(\n  6942\t                f\"done route=cli status={self._response_status} {self._trace_log_fields()} elapsed_ms={int((time.monotonic() - started) * 1000)}\"\n  6943\t            )\n  6944\t\n  6945\t    def _serve_json_body(self, ctx: dict[str, Any]) -> None:\n  6946\t        lease = self._current_lease()\n  6947\t        out = self._dispatch(ctx, None)\n  6948\t        if out.get(\"state\") == \"client_gone\":\n  6949\t            lease.record_discard(\"client_disconnected\")\n  6950\t            return\n  6951\t        backend_err = self._error_body(out)\n  6952\t        self._record_turn_outcome(lease, out, backend_err)\n  6953\t        err = backend_err or self._reserve_delivery(out)\n  6954\t        if err is not None:\n  6955\t            self._send(err[\"code\"], {\"error\": err})\n  6956\t            return\n  6957\t        usage = out.get(\"usage\") or {}\n  6958\t        wire_usage = _wire_usage(\n  6959\t            usage.get(\"input_tokens\", 0),\n  6960\t            usage.get(\"output_tokens\", 0),\n  7208\t                # этому клиенту ни одного терминального кадра (включая keepalive).\n  7209\t                self._client_write_dead = True\n  7210\t            return ok\n  7211\t\n  7212\t        if not emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n  7213\t            # Пустой стартовый кадр успехом не считается; обрыв клиента нейтрален.\n  7214\t            lease.record_discard(\"client_disconnected\")\n  7215\t            if managed_turn is not None and ctx.get(\"detach_on_disconnect\"):\n  7216\t                self._client_write_dead = True\n  7217\t                TURN_MANAGER.mark_detached(managed_turn.turn_id)\n  7218\t            else:\n  7219\t                return\n  7220\t        try:\n  7221\t            try:\n  7222\t                out = self._dispatch(ctx, keepalive, sse_writer)\n  7223\t            finally:\n  7224\t                # Возврат адаптера закрывает sink под тем же lock, что и записи.\n  7225\t                # Даже consumer, переживший join(5), больше не может дописать кадр.\n  7226\t                with sse_lock:\n  7227\t                    sink_closed.set()\n  7228\t        except Exception as exc:  # noqa: BLE001 - RW-211: клиенту нужен конверт, а не сырой сбой\n  7229\t            if self._client_write_dead:\n  7230\t                _log(\n  7231\t                    f\"client_write_dead: dispatch error suppressed \"\n  7232\t                    f\"err={_err_summary(repr(exc), 160)!r}\"\n  7233\t                )\n  7234\t                lease.record_discard(\"client_disconnected\")\n  7235\t                return\n  7236\t            if not live_sent[0]:\n  7237\t                raise  # живых байт не было: прежнее поведение (сбой наружу; lease зафиксирует сбой)\n  7238\t            _log(f\"live_dispatch_failed err={_err_summary(repr(exc), 160)!r}\")\n  7239\t            lease.record_failure(exc)\n  7240\t            emit(stream_error_frame(str(exc)[:500] or exc.__class__.__name__))\n  7241\t            emit(\"data: [DONE]\\n\\n\")\n  7242\t            return\n  7243\t        if self._client_write_dead:\n  7244\t            # RW-203: сокет отверг живую запись — терминальные кадры (tool_call, stop,\n  7245\t            # usage, error) и [DONE] мёртвому клиенту не отправляются.\n  7246\t            _log(\"client_write_dead: terminal frames suppressed\")\n  7247\t            lease.record_discard(\"client_disconnected\")\n  7248\t            return\n  7249\t        if out.get(\"state\") == \"client_gone\":\n  7250\t            _log(\"client gone mid-stream, child killed\")\n  7251\t            lease.record_discard(\"client_disconnected\")\n  7252\t            return\n  7253\t        backend_err = self._error_body(out)\n  7254\t        self._record_turn_outcome(lease, out, backend_err)\n  7255\t        err = backend_err or self._reserve_delivery(out)\n  7256\t        if err is None:\n  7257\t            # Доставка — отдельный этап: T/L уже свободны, checkpoint записан; обрыв клиента\n  7258\t            # здесь ни на что, кроме самого ответа, не влияет. У droid content/reasoning уже ушли\n  7259\t            # живьём из _execute (sse_writer выше): здесь остаются только tool_call-кадры.\n  7260\t            live_backend = out.get(\"backend_kind\") == \"droid\"\n  7261\t            reasoning_to_skip = reasoning_live_chars\n  7262\t            for kind, value in out.get(\"events\") or []:\n  7263\t                if kind in (\"content\", \"reasoning\"):\n  7264\t                    if live_backend:\n  7265\t                        continue\n  1040\t        return bool(getattr(self.host, \"BRIDGE_SANITIZE_TOOL_CALLS\", True))\n  1041\t\n  1042\t    def handle(\n  1043\t        self,\n  1044\t        *,\n  1045\t        path: str,\n  1046\t        raw_body: bytes,\n  1047\t        request: Mapping[str, Any],\n  1048\t        headers: Mapping[str, str],\n  1049\t        sink: ResponseSink,\n  1050\t    ) -> None:\n  1051\t        \"\"\"Один запрос: байты тела уходят upstream без мутаций, ответ пишется в `sink`.\"\"\"\n  1052\t        queue_timeout = float(\n  1053\t            getattr(self.host, \"QUEUE_TIMEOUT_S\", DEFAULT_QUEUE_TIMEOUT_S)\n  1054\t        )\n  1055\t        if not self._slots.acquire(timeout=queue_timeout):\n  1056\t            self._fail(sink, 503, \"overloaded\", \"passthrough backend is saturated\")\n  1057\t            return\n  1058\t        with self._lock:\n  1059\t            self._active += 1\n  1060\t        conn: Optional[http.client.HTTPConnection] = None\n  1061\t        try:\n  1062\t            try:\n  1063\t                conn = self._open(path, raw_body, headers)\n  1064\t                resp = conn.getresponse()\n  1065\t            except socket.timeout:\n  1066\t                self._fail(\n  1067\t                    sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n  1068\t                )\n  1069\t                return\n  1070\t            except (OSError, http.client.HTTPException):\n  1071\t                self._fail(sink, 502, \"upstream_unavailable\", \"upstream is unavailable\")\n  1072\t                return\n  1073\t            self._respond(resp, request, sink)\n  1074\t        except ClientGone:\n  1075\t            self._log(\"passthrough client_gone\")\n  1076\t        finally:\n  1077\t            if conn is not None:\n  1078\t                conn.close()\n  1079\t            with self._lock:\n  1080\t                self._active -= 1\n  1081\t            self._slots.release()\n  1082\t\n  1083\t    def _open(\n  1084\t        self, path: str, raw_body: bytes, headers: Mapping[str, str]\n  1085\t    ) -> http.client.HTTPConnection:\n  1160\t        headers = self._response_headers(resp) + [(\"Content-Length\", str(len(body)))]\n  1161\t        sink.start(resp.status, headers)\n  1162\t        sink.write(body)\n  1163\t\n  1164\t    def _relay_stream(\n  1165\t        self,\n  1166\t        resp: http.client.HTTPResponse,\n  1167\t        schemas: Optional[dict[str, Any]],\n  1168\t        sink: ResponseSink,\n  1169\t        sanitize: bool,\n  1170\t    ) -> None:\n  1171\t        # Выбор доверия фиксируется до sink.start (первой записи клиенту).\n  1172\t        # Маркер допустим только от настроенного аутентифицированного loopback peer.\n  1173\t        flag = getattr(self.host, \"is_trusted_tool_streaming_enabled\", None)\n  1174\t        trusted = (\n  1175\t            sanitize\n  1176\t            and self.config.get(\"trusted_tool_sanitizer\") is True\n  1177\t            and bool(self._upstream_key)\n  1178\t            and self._host == \"127.0.0.1\"\n  1179\t            and callable(flag)\n  1180\t            and flag() is True\n  1181\t            and resp.getheader(\"X-Bridge-Tool-Sanitized\") == \"1\"\n  1182\t        )\n  1183\t        headers = [\n  1184\t            (k, v)\n  1185\t            for k, v in self._response_headers(resp)\n  1186\t            if k.lower() != \"content-type\"\n  1187\t        ]\n  1188\t        headers += [\n  1189\t            (\"Content-Type\", \"text/event-stream\"),\n  1190\t            (\"Cache-Control\", \"no-cache\"),\n  1191\t            (\"X-Accel-Buffering\", \"no\"),\n  1192\t        ]\n  1193\t        outcome = StreamOutcome(committed=True)\n  1194\t        sink.start(200, headers)  # Заголовки тоже фиксируют ответ; повтор уже запрещён.\n  1195\t        try:\n  1196\t            outcome = relay_sse(\n  1197\t                resp.readline,\n  1198\t                sink.write,\n  1199\t                tool_schemas=schemas,\n  1200\t                limits=self.limits,\n  1201\t                process=self.process_budget,\n  1202\t                sanitize=sanitize,\n  1203\t                trusted_tools=trusted,\n  1204\t                state=outcome,\n  1205\t            )\n  1206\t        except (socket.timeout, OSError, http.client.HTTPException):\n  1207\t            sink.write(\n  1208\t                _error_frame({}, \"upstream_stream_error\", \"upstream stream failed\")\n  1209\t            )\n  1210\t            return\n  1211\t        if outcome.incomplete or outcome.overflow:\n  1212\t            self._log(\n  1213\t                f\"passthrough stream incomplete={outcome.incomplete} overflow={outcome.overflow}\"\n  1214\t            )\n   737\t        self._rng = rng\n   738\t        self._lock = threading.Lock()\n   739\t        self._breakers: dict[str, CircuitBreaker] = {}\n   740\t        self._bulkheads: dict[str, Bulkhead] = {}\n   741\t\n   742\t    def settings(self) -> ResilienceSettings:\n   743\t        return self._flags.current()\n   744\t\n   745\t    def retry_policy(self) -> RetryPolicy | None:\n   746\t        \"\"\"RetryPolicy по текущим настройкам; None — повторы выключены флагом.\"\"\"\n   747\t        settings = self._flags.current()\n   748\t        if not settings.retry:\n   749\t            return None\n   750\t        return RetryPolicy.from_settings(settings)\n   751\t\n   752\t    def _breaker_for(\n   753\t        self, backend_id: str, settings: ResilienceSettings\n   754\t    ) -> CircuitBreaker:\n   755\t        with self._lock:\n   756\t            breaker = self._breakers.get(backend_id)\n   757\t            if breaker is None:\n   758\t                breaker = CircuitBreaker(\n   759\t                    backend_id,\n   760\t                    fail_threshold=settings.fail_threshold,\n   761\t                    cooldown_s=settings.cooldown_s,\n   762\t                    cooldown_jitter=settings.cooldown_jitter,\n   763\t                    clock=self._clock,\n   764\t                    rng=self._rng,\n   765\t                )\n   766\t                self._breakers[backend_id] = breaker\n   767\t        breaker.configure(\n   768\t            fail_threshold=settings.fail_threshold,\n   769\t            cooldown_s=settings.cooldown_s,\n   770\t            cooldown_jitter=settings.cooldown_jitter,\n   771\t        )\n   772\t        return breaker\n   773\t\n   774\t    def _capacity(self, backend_id: str, settings: ResilienceSettings) -> int:\n   775\t        cap = settings.bulkhead_max_concurrent\n   776\t        return max(1, min(self._backend_limits.get(backend_id, cap), cap))\n   777\t\n   778\t    def _bulkhead_for(self, backend_id: str, settings: ResilienceSettings) -> Bulkhead:\n   779\t        capacity = self._capacity(backend_id, settings)\n   780\t        with self._lock:\n   781\t            bulkhead = self._bulkheads.get(backend_id)\n   782\t            if bulkhead is None or bulkhead.capacity != capacity:\n   783\t                # Смена ёмкости: новый отсек; уже выданные слоты освободят старый семафор.\n   784\t                bulkhead = Bulkhead(backend_id, capacity)\n   785\t                self._bulkheads[backend_id] = bulkhead\n   786\t            return bulkhead\n   787\t\n   788\t    def acquire(self, backend_id: str) -> ResilienceLease:\n   789\t        \"\"\"Допуск запроса к бэкенду либо `CircuitBreakerOpen`/`BulkheadCapacityExceeded`.\"\"\"\n   790\t        settings = self._flags.current()\n   791\t        if not settings.enabled or not (settings.circuit_breaker or settings.bulkhead):\n   792\t            return ResilienceLease(backend_id)\n   793\t        breaker: CircuitBreaker | None = None\n   794\t        generation, is_probe = 0, False\n   795\t        if settings.circuit_breaker:\n   796\t            breaker = self._breaker_for(backend_id, settings)\n   797\t            allowed, generation, is_probe = breaker.acquire()\n   798\t            if not allowed:\n   799\t                raise CircuitBreakerOpen(backend_id, breaker.retry_after or 1)\n   800\t        bulkhead_lease: BulkheadLease | None = None\n58:      \"max_concurrent\": 4\n65:      \"max_concurrent\": 1,\n81:      \"max_concurrent\": 128,\n90:      \"max_concurrent\": 128,\n99:      \"max_concurrent\": 128,\n108:      \"max_concurrent\": 128,\n97:| **teamlead-gate** | Цикл разработки с проверкой кода и приёмкой советом тимлидов до ACCEPT. Когда: «тимлид-гейт», «teamlead gate» | `~/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md` |\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"Канон `~/Мой диск/Context/AGENTS.md` прочитан до `<!-- КАНОН-КОНЕЦ -->`; проектный `~/work/src/cli-agent-bridge/AGENTS.md` прочитан. В исходниках подтверждаются потеря исхода SSE и создание ManagedTurn до допуска. Проверю отдельно, когда при отсоединении клиента освобождается проба HALF_OPEN.\n"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; nl -ba server.py | sed -n '1268,1330p;518,528p;6670,6830p'; nl -ba core/resilience.py | sed -n '442,508p;665,719p'; rg -n 'def create_or_attach_turn|def finalize_abandoned_turn|def dispatch|def .*runner|Thread\\\\(' core/turn_session_manager.py; rg -n 'for attempt|range\\\\(1, 4\\\\)' server.py; cat .ai-team/runs/bridge-resilience-patterns-20261102/architecture/architecture-packet.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; nl -ba server.py | sed -n '1268,1330p;518,528p;6670,6830p'; nl -ba core/resilience.py | sed -n '442,508p;665,719p'; rg -n 'def create_or_attach_turn|def finalize_abandoned_turn|def dispatch|def .*runner|Thread\\\\(' core/turn_session_manager.py; rg -n 'for attempt|range\\\\(1, 4\\\\)' server.py; cat .ai-team/runs/bridge-resilience-patterns-20261102/architecture/architecture-packet.md\"","aggregated_output":"---\nname: teamlead-gate\ndescription: >-\n  Ведёт полный цикл разработки с приёмкой кода советом тимлидов: dev-цикл,\n  clean-room L1/L2/L3, панель судей (universal-panel, mode=code) до ACCEPT\n  или возврата Coder через panel-rework-summarizer (потолок 3 цикла).\n  Триггеры: «запускай разработку по скилу техлид» (default), «… техлид\n  фаст» (fast), «… техлид квалити» (quality), «тимлид-гейт», «teamlead\n  gate», «судьи совета разошлись», «пусть тимлиды договорятся». Не для\n  мелких правок.\n---\n\n# teamlead-gate — разработка с приёмкой кода советом тимлидов\n\nПрочитай `references/council.md`, когда запускаешь Шаг 4; прочитай `references/council-consensus.md`, когда после `R1` есть спор или повторный раунд; прочитай `references/coder-brief.md`, когда собираешь бриф Coder. Здесь — маршрут шагов 0–6, инварианты, стопы и DoD.\n\nНезависимые Read/Grep/ls, Edit/Write разных файлов, cp/diff/wc — одним сообщением, списком заранее (`~/Мой диск/skils/panel-backends/references/parallelism-params.md` §1).\n\n## Вопросы владельцу (аналитик / архитектор / координатор)\n\nКанон БЛОКЕР/МОЖНО ПРОДОЛЖИТЬ, «падение транспорта — не БЛОКЕР» — прочитай `references/report-vpn-formats.md` § 1, когда формулируешь вопрос владельцу.\n\n## ⭐ КРИТИЧЕСКИЙ ИНВАРИАНТ: ЗАМКНУТЫЙ ЦИКЛ ДО ACCEPT (LOOP UNTIL ACCEPT)\n\n**Замечания Совета Тимлидов исправляются СТРОГО ПО КРУГУ ДО ВЕРДИКТА ACCEPT.**\n\n1. Никакой сдачи по самоотчёту кодера: «код написан, тесты зелёные» не приёмка. Только повторный Совет вправе признать замечания закрытыми.\n2. После любых исправлений Coder оркестратор обязан повторно отправить реальный `git diff` на Совет (universal-panel, `mode=code`).\n3. Цикл: Совет (NEEDS WORK) → Coder → повторный Совет → … → ACCEPT. Потолок — 3 тимлид-цикла; сброс в `REJECT` на 2-м цикле запрещён.\n4. MR на remote до `ACCEPT` категорически запрещён. Coder работает только в локальной ветке; MR открывает оркестратор строго после ACCEPT.\n5. Фальш-старт MR цикл не останавливает: совет доводится до официального `ACCEPT`.\n6. Завершить ход после правок Coder без повторного Совета и `ACCEPT` — срыв регламента.\n\n## ⭐ ИНВАРИАНТ: ВСЕ ЗАМЕЧАНИЯ БАТЧЕМ И СОГЛАСОВАННОЕ РЕШЕНИЕ СОВЕТА\n\nКаждый судья за один проход выдаёт все замечания сразу (поштучная выдача — malformed). Итог спорных находок — согласованный леджер; оркестратор только копирует дословно и считает статусы. Summarizer — один бриф на весь леджер, без «топ-N» (прочитай `references/council.md` §3, когда проверяешь полноту и `late_miss`/`r2_late`).\n\n## Scope Fencing и circuit-breaker лимиты\n\n- **Scope Fencing:** дефект, существовавший до текущего diff и находящийся вне текущего diff, классифицируется как `[pre-existing]`, помечается non-blocking и не блокирует сдачу; сдача в этом случае — `ACCEPT_WITH_OBSERVATIONS`. Дефекты, внесённые текущим diff, блокируют сдачу как прежде.\n- **Лимит циклов:** потолок — 3 тимлид-цикла; превышение — эскалация владельцу, обход только по прямому указанию владельца (`--owner-override` в `launch_seat.py`).\n- **Лимит раундов:** исторический circuit-breaker «≤ 10 раундов» (`CIRCUIT_BREAKER_TRIGGERED`, обход только `--owner-override`) действующей нормой дебатов не является: FSM раннера жёстче — `R1 + D1 + [D2] + C1`, не более 4 раундов, `D3` запрещён (Шаг 4).\n- **Лимит брифа:** ≤ 120 KiB (122880 байт); превышение — `OVERSIZED_BRIEF`, обход только `--owner-override`.\n\n## Какой пакет включать\n\nДо Шага 0 выбери сетап из фразы (`default`; «… техлид фаст» → `fast`; «… техлид квалити» → `quality`) и запиши `setup` в `route-manifest.json`. Прочитай `references/routing-gates.md`, когда резолвишь модели до Шага 0. Нерушимое: вызов вне белого списка сетапа → `INVALID_MODEL`; пул исчерпан → `QUORUM_UNAVAILABLE`, подстановка запрещена; панель на `acp-agents` не подменять; **panel-rework-summarizer при `NEEDS WORK`/`RED FLAG` — всегда** (изолированно, слот по `~/Мой диск/Context/models.md`), координатору переводить замечания запрещено, без валидного выхода возврат Coder запрещён.\n\nСкилл-обёртка: dev-цикл — `orchestrate-coder-reviewer-summarizer` целиком; совет — `universal-panel`, `mode=code`, слоты по `~/Мой диск/Context/models.md`. Агент пул не выбирает.\n\n## MUST: бриф Coder (невалидный — не запускать)\n\nВ бриф — **ровно один** путь `~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/<тип>.md` (`feature`|`bugfix`|`refactoring`|`hotfix`|`rework`; Architect — `architecture.md`; Reviewer/MR — `code-review.md`/`mr.md`). Без строки бриф невалиден. При возврате с `NEEDS WORK` (Cycle ≥ 2) тип меняется на `rework`. Прочитай `references/coder-brief.md`, когда собираешь обязательные блоки брифа (AC-оракулы, self-check с сырым выводом, анти-примеры, резюме, валидатор полей без LLM, специфика rework).\n\n## Пайплайн\n\n```text\ntask envelope → VERIFICATION SURFACE (oracle+baseline до Coder)\n → DEV-ЦИКЛ (Coder→CODE_GATE→Verifier; Reviewer пропущен) → READY_FOR_PR\n → CLEAN-ROOM (точный diff + 100% матрицы + sensitivity) → EVIDENCE опечатан\n → ПАКЕТ ПРИЁМКИ → СОВЕТ: R1 → (3/3 PASS, OPEN_BLOCKING=0, нет открытых CONFLICT → выход) | RECHECK → леджер → D1 → [D2 по спорным блокерам] → C1 (всегда настоящий раунд) → final-panel-verdict.md\n      ├─ PASS → ACCEPT → L3 → MR человеку\n      ├─ NEEDS WORK → panel-rework-summarizer → новый dev-цикл (rework)\n      └─ RED FLAG → тот же круг, кроме требования сменить ТЗ/архитектуру\n```\n\nЛимит: **до ACCEPT, потолок 3 тимлид-цикла**; повтор по тем же пунктам в REJECT не сбрасывает.\n\n## Шаг 0. Безусловная изоляция в песочницу `$WORK` с временным Git и Verification surface до Coder\n\nДо снятия `verification-surface.json` и запуска Coder сессия изолируется во временный каталог `$WORK = ~/tmp/<project-slug>/<branch-slug>--<session-id>/` с собственным Git по скиллу `~/Мой диск/skils/parallel-clones/SKILL.md` (включая проекты без Git в `<дом>`, где в `$WORK` выполняется `git init -q -b main`). Файлы `.env*` копируются в `$WORK` для прогона тестов L1/L2/L3 и **строго до базового коммита `BASE_COMMIT`** скрываются от Git через `$WORK/.git/info/exclude` (`git rm --cached -r -f --ignore-unmatch '.env*' '*/.env*' && test -z \"$(git ls-files '.env*' '*/.env*')\" || exit 1`), а рабочая ветка именуется `<type>/<JIRA-KEY>-<short-description>` (или `<type>/LOCAL-<short-description>` без Jira). Сразу после получения `ACCEPT` Совета (`verify_panel_proof.py` `exit=0`) изменения доставляются из `$WORK` в `<дом>` через **3-Way Git Merge в `$WORK`** (`source-current` от `BASE_COMMIT` -> `git merge source-current` -> разрешение конфликтов в `$WORK` -> обязательный повтор тестов после любого слияния (как с конфликтами, так и без конфликтов) -> атомарный перенос в `<дом>` без `.git`, плюс push/MR при наличии `origin`), после чего временная песочница **безусловно удаляется** (проверка доставки -> `rm -rf \"$WORK\"` -> `test ! -e \"$WORK\"` -> снятие `.ai-team/merge.lock` -> статус `removed` в `$RUN/created.tsv`).\n\nПрочитай `references/verification-integrity.md` целиком один раз здесь и выполни его раздел 1 (Шаг 2 исполняет разделы 2–8 по уже прочитанному). До Coder создай `verification-surface.json` (хеши oracle, CI/config/lock, baseline, jobs). Oracle меняет только read-only QA/verifier, не Coder. Нет слепка — `BLOCKED`.\n\n## Шаг 1. Dev-цикл\n\n**NFFC:** рабочие роли сначала нативно через `:9882`; приоритет над legacy CLI-шаблонами —\n`~/Мой диск/skils/panel-backends/references/model-invocation.md` §0 (Native-First & Fail-Closed).\nМеста Совета остаются только на `launch_seat.py` с `verify_panel_proof.py`; NFFC их не заменяет.\n\nВыполни `orchestrate-coder-reviewer-summarizer` до `READY_FOR_PR`: Reviewer пропущен (`downstream_panel=true`, `parent_skill=teamlead-gate`, `critical=false`/`final_gate_council=false`); максимум 2 итерации Coder↔CODE_GATE внутри цикла. Модели ролей — из выбранного сетапа по `~/Мой диск/Context/models.md`; Summarizer dev-пула внутри цикла не вызывать. Не дошёл до `READY_FOR_PR` — совет не запускать, эскалация человеку.\n\nПока идут Architect/Coder, готовь независимые от diff входы: прочитай `references/prepare-in-parallel.md`, когда стартует Шаг 1. Параллельные кодеры: прочитай `references/parallel-coders.md`, когда разделяешь работу на зоны (зона = Coder = worktree/клон, locks, merge-арбитраж).\n\n## Шаг 2. Независимый clean-room прогон (гейт)\n\nВыполни разделы 2–8 `references/verification-integrity.md`. Логи Coder/Reviewer/CI — заявления, не доказательство; evidence — только реальный запуск точного candidate в свежем temp-worktree/контейнере. Матрица 100%, L2 один раз на SHA+fingerprint, любая правка → новый SHA → L2 заново; `echo`/dry-run/collect-only/старый лог/targeted-subset вместо L2 — не выполнение. Пробел = пакет совета `BLOCKED`.\n\n## Шаг 3. Пакет приёмки\n\nСобери `.ai-team/runs/<run-id>/teamlead/package.md` только из первичных артефактов, без пересказа (task envelope, candidate manifest + полный diff с SHA256, `coder.json`, `execution-evidence.md` с сырым логом L2, surface/environment/traceability/manifest; `PR_DESCRIPTION.md` не класть). Прочитай `references/acceptance-package.md`, когда собираешь пакет и передаёшь его CLI-судьям (тихая обрезка = `BLOCKED_BRIEF`).\n\n## Шаг 4. Совет тимлидов\n\nПрочитай `references/council-gates.md`, когда запускаешь совет; прочитай `references/council.md`, когда собираешь раунд; прочитай `references/council-consensus.md`, когда после `R1` нужен леджер, дебаты или проверка выхода по единому инварианту. Нерушимое:\n\n- `mode.txt` = `code`; ровно 3 судьи из пула сетапа; предпочтительно majority 2/3 разных семейств (`QUORUM_FULL`). При недоборе 3 семейств действует каскад деградации под разными шляпами `QUORUM_DEGRADED_HATS` (разрешается брать любую доступную модель роли, в т.ч. одну модель трижды под разными ролевыми шляпами Скептик, Реалист, Визионер в изолированных вызовах); раунда из 2 судей и ACCEPT на двоих нет; вердикт выносится большинством 2/3 ролевых шляп; только при отсутствии хотя бы одной рабочей модели роли — `QUORUM_UNAVAILABLE`, раунд не стартует.\n- Backend gate: 4-й судья/процесс/голос, «опрос всех доступных», суд в родительской сессии, подмена нативным сабагентом/`acp-agents`, незаписанный fallback → FAIL раунда с откатом.\n- Каждый судья обеих панелей (`arch` и `code`) стартует только с одобренным brief-review своего места (fail-closed, `BLOCKED_BRIEF`); гейт `shasum == approved.sha256`.\n- Внутренний ШАГ 6 universal-panel не крутить.\n\n### Выход после `R1` — единый инвариант (`consensus-debate.md`)\n\nНормативное ядро — `~/Мой диск/skils/panel-backends/references/consensus-debate.md`, разделы «Единый инвариант выхода после R1 и RECHECK» и «Единый согласованный документ судейства (final-panel-verdict.md, разделы А–Г) и именные профили контуров»; здесь правила не дублируются. `panel-proof.json` (`verify_panel_proof.py`, `exit=0`) обязателен на каждом раунде; жеребьёвка и состав — по `~/Мой диск/Context/models.md`.\n\n- **Выход сразу после слепого `R1`** — только при `3/3 PASS`/`ACCEPT`, `OPEN_BLOCKING = 0` и отсутствии открытых `CONFLICT` (буквальное требование `CONFLICT=0` как цель агрегации отменено: конфликт формализуется статусами леджера, `council-consensus.md` §12); неблокирующие заметки идут в раздел Г `final-panel-verdict.md` без `D1`.\n- **Во всех остальных случаях** (`OPEN_BLOCKING > 0`, `CONFLICT > 0`, `< 3/3 PASS`, включая `0/3 PASS`, `≥2 RED FLAG`, `1 RED FLAG` + `1 NEEDS WORK`, `2/3 PASS` при `OPEN_BLOCKING > 0`) обязателен маршрут `R1` → `RECHECK` (`recheck-r1.md`) → `consensus-ledger.md` → `D1` → [`D2`] → `C1` → `final-panel-verdict.md` (А–Г) [+ `panel-rework-brief.json` при `NEEDS WORK`/`RED FLAG`]. Пропуск `RECHECK` и `D1` при `0/3 PASS` или `≥2 RED FLAG`, передача сырых недебатированных голосов в `panel-rework-summarizer`/Coder запрещены. Потолок D-раундов во всех сетапах: `D1` плюс один `D2` только по спорным `OPEN`-блокерам; `D3` запрещён. Досрочный выход при `OPEN = 0` пропускает только `D2`, но не `C1`: на пути дебатов `C1` всегда запускается настоящим раундом фиксации согласия; открытый `CONFLICT` на потолке — `PAUSED_OWNER` / `OWNER_PENDING`, `panel-rework-brief.json` не выпускается.\n- **После каждого прохода** (`ACCEPT`/`PASS` и `NEEDS WORK`/`RED FLAG`) выпускается `final-panel-verdict.md` (А–Г) и выводится владельцу в чат первым блоком; раздел В (`excluded_findings`) — закрытый набор для следующего прохода.\n\nИсполнитель дебатов — раннер: `python3 -I scripts/run_consensus_council.py --run-dir <RUN> --artifact-path <FILE> --setup <default|fast|quality> --stage council [--resume]`. Раннер сам вызывает `select_round_seats.py` (для `r>=2` — только с `--prior-ledger` на неизменяемый снимок леджера прошлого раунда; бриф несёт `PRIOR-LEDGER-SHA256`), запускает три `launch_seat.py` веером (все стартуют до завершения любого), извлекает `verdict.md` из `raw.out` экстрактором верификатора и заново запускает `verify_panel_proof.py` на каждый раунд; ручная сборка консенсуса вместо раннера запрещена. Коды выхода: 0 — агрегация, 1 — fail closed (подделка nonce/семейств/снятие `BLOCKER-SAFETY`/ack), 3 — `BLOCKED: QUORUM_UNAVAILABLE`, 4 — `ESCALATED`/`PAUSED_OWNER`. `PAUSED_OWNER` селектора (повтор троицы семейств при пуле 3of3, exit 3 селектора с готовым манифестом) раннер под кворум не маскирует: стоп до явного `--owner-ack-reason <TEXT>` вызывающего; сам ack записывает `select_round_seats.py --owner-ack`, раннер его не подделывает, после ack — `--resume`.\n\n### Точечная замена упавшего места (`--replace-failed-seat`)\n\nЕсли 1 из 3 мест завершилось техническим отказом транспорта, `quota_window`, `HUNG` или `malformed` (нет `COVERAGE`/`FINDINGS_COMPLETE`), 2 валидных голоса сохраняются и не перезапускаются. Заменяется только упавшее место через `launch_seat.py` (`--replace-failed-seat`, резервный слот пула по `models.md` п. 1.4/1.8). Потолок — **не более 2 технических замен мест на раунд**; далее штатный добор «пул N/3» по п. 1.8 или `QUORUM_UNAVAILABLE`.\n\n### Brief-review: `full` на `R1`, `delta_prelint` на повторных раундах\n\nНа `R1` каждого нового `artifact_hash`/цикла все 3 места проходят параллельный brief-review `run_kind: \"full\"` на 3 разных слотах пула Brief-review без возвращения. На `D<k>`, `C1` и при `--replace-failed-seat` в том же цикле и том же `artifact_hash` (у `R1` уже `APPROVE`, `sources.sha256` и общее тело чек-листа неизменны, добавлены только дословные обёртки D9) применяется детерминированный `run_kind: \"delta_prelint\"` (brief-review D9, 0 вызовов LLM).\n\n## Гейт PANEL-PROOF (Proof-of-Launch v1)\n\nКаждый судья запускается строго через `launch_seat.py`; самооценка оркестратора и субагенты сессии как судьи запрещены. Перед `ACCEPT` и MR обязателен `verify_panel_proof.py` (`exit=0`) с `panel-proof.json` (`pol-receipt/1`) `PASS`; без него — `BLOCKED: PANEL_PROOF_MISSING`. В отчёт: `PANEL PROOF: <путь panel-proof.json> sha256=<hex> verify_panel_proof exit=0`. Прочитай `references/panel-proof-gate.md`, когда проверяешь раунд.\n\n## Шаг 5. Разбор вердикта\n\nПрочитай `references/council.md` §2 и `references/council-gates.md`, когда разбираешь вердикт.\n\n- **PASS → ACCEPT:** только при валидном `panel-proof.json` PASS (`verify_panel_proof.py` `exit=0`) и строке `PANEL PROOF: …` в отчёте. PASS не перекрывает красный execution-gate. До MR — L3 (FAIL → Coder `rework` → L1 → L2 → повторная панель); MR-гейт L3: PASS | PASS_WITH_PREEXISTING | N/A. `direct_invocation: true` — Summarizer пишет `PR_DESCRIPTION.md` и отчёт; `false` — кратко координатор/one-shot.\n- **NEEDS WORK → panel-rework-summarizer → Coder:** слот по `~/Мой диск/Context/models.md` (не DeepSeek); вход — согласованный леджер (после `RECHECK` и дебатов) и `final-panel-verdict.md` (А–Г), покрытие 100% F-NNN, в instructions только согласованные blocking; при открытом `CONFLICT` — `PAUSED_OWNER`, summarizer не вызывается и `panel-rework-brief.json` не выпускается; Coder — только после PASS проверки контракта brief; повторный совет — diff-scope.\n- **RED FLAG → тот же круг**, кроме требования сменить ТЗ/архитектуру (решение человека).\n\n## Стоп-условия (поверх стопов обоих скиллов)\n\nПрочитай `references/council-gates.md` § «Стоп-условия (полный перечень)», когда проверяешь право на ACCEPT. Кратко: 3 цикла без ACCEPT → честный отчёт, продолжение только по решению владельца; нет `panel-proof.json` PASS → `BLOCKED`, ACCEPT/MR запрещены; нет read-back `processes.tsv` или cleanup через `pkill`/`killall` → `BLOCKED`; обязательный `FAIL`/`NOT_RUN`/`STALE` в матрице → `BLOCKED` даже при PASS совета (`DEFERRED_L3` до ACCEPT — не блокер); diff меняет согласованный контракт без envelope или несёт чужие KEY → не ACCEPT.\n\n## Корп-VPN упал — не стоп, поднять\n\nУпавший корп-VPN и timeout до корп-хоста — не `BLOCKED`: поднять и повторить. Прочитай `references/report-vpn-formats.md` § 2, когда корп-хост недоступен.\n\n## Границы\n\nСовет оценивает пригодность к merge; продукт глазами пользователя — `acceptance-gate` после ACCEPT. В `main`/`dev` не коммитить; merge — человек, кроме «кати» (PASS → ACCEPT → MR → CI 100% → merge с read-back). Каждый spawn — в `trace/index.json`.\n\n## Отчёт заказчику (формат)\n\nПрочитай `references/report-vpn-formats.md` § 3, когда пишешь отчёт; блок «Как совет договорился» — `references/council-consensus.md` § 11.\n\n## DoD сдачи\n\n- [ ] Цикл закрыт вердиктом `ACCEPT` повторного Совета, не самоотчётом Coder; MR открыт только после ACCEPT.\n- [ ] Каждый судья обеих панелей запущен строго через `launch_seat.py` и подтверждён `verify_panel_proof.py` (`panel-proof.json` PASS, `exit=0`); строка `PANEL PROOF: …` в отчёте.\n- [ ] Выход после `R1` — только по единому инварианту `consensus-debate.md`; `--replace-failed-seat` (≤2 на раунд) и `run_kind` brief-review (`full` на `R1`, `delta_prelint` на повторных) применены по правилам Шага 4; `final-panel-verdict.md` (А–Г) выпущен после прохода и показан владельцу первым блоком.\n- [ ] Дебаты исполнены раннером `scripts/run_consensus_council.py` (FSM `R1 → RECHECK → D1 → [D2] → C1 → AGGREGATE`, чекпоинты и `--resume`); первичный `consensus/consensus-ledger.json` (`pol-consensus/1.0`) записан, `BLOCKER-SAFETY` не снят большинством/переклассификацией, кворум 2/3 посчитан по независимым семействам, производные Markdown совпадают с JSON.\n- [ ] Clean-room evidence опечатан, матрица без обязательных `FAIL`/`NOT_RUN`/`STALE`, L3-гейт до MR закрыт.\n\n## Неснимаемые стоп-коды: `HL-ENV-01`, `C-MULT-I1..I5`, `S-HERD-I1..I5`, `H-CPU-I1..I5`, `R-BULK-I1..I5`\n\nПеред `ACCEPT` каждый судья проверяет все 21 стоп-код и самостоятельно пересчитывает численные инварианты. Прочитай `references/council-gates.md` § «Неснимаемые стоп-коды HL (полный текст)», когда проверяешь high-load кандидат: нарушение или отсутствие детерминированного теста — безусловный `BLOCKER` (`NEEDS WORK`), в техдолг не списывается.\n\n## Remote-first контракт репозитория\n\nМеняешь Git-репозиторий — прочитай и выполни `references/remote-mr-workflow.md`, когда готовишь сдачу: сначала merge MR на remote, затем fast-forward локальной target-ветки.\n\n## Связанные скиллы\n\n`orchestrate-coder-reviewer-summarizer` — dev-цикл; `universal-panel` — механика совета; `acceptance-gate` — следующий слой. Прочитай `references/routing-gates.md` § «Связанные скиллы», когда резолвишь слоты и смежные каноны.\n   518\t\n   519\t# ---- ОТКАЗОУСТОЙЧИВОСТЬ КОНТЕКСТА (EYE-33873, ADR-0006): общее ядро core/context_resilience.\n   520\t# Флаги читаются из локального снимка GigaRC (дефолт false = прежнее поведение хаба).\n   521\tCONTEXT_FLAGS = ctxres.FlagSource()\n   522\t# ---- ОТКАЗОУСТОЙЧИВОСТЬ БЭКЕНДОВ (ADR-0020): Circuit Breaker + Bulkhead по backend_id.\n   523\t# Все механизмы за флагами GigaRC (дефолт false = прежнее поведение); fallback на другую модель запрещён.\n   524\tRESILIENCE = ResilienceManager()\n   525\tCONTEXT_EPOCHS = ctxres.EpochStore()\n   526\t# Droid-маршрут хаба не квалифицирован (VER-006): строгий admission включается только флагом\n   527\t# DYNAMIC_PRUNER_ENABLED; после паспорта счётчика владелец переводит маршрут в enrolled.\n   528\tCONTEXT_ENROLLED = False\n  1268\t    \"\"\"\n  1269\t    if not hasattr(BACKENDS, \"adapters\"):\n  1270\t        return False\n  1271\t    return str(handler.client_address[0]) in _LOOPBACK_PEERS and any(\n  1272\t        isinstance(adapter, PassthroughAdapter) for adapter in BACKENDS.adapters()\n  1273\t    )\n  1274\t\n  1275\t\n  1276\tclass _HandlerSink(ResponseSink):\n  1277\t    \"\"\"Запись ответа passthrough-шва в сокет клиента; сбой записи — ClientGone.\"\"\"\n  1278\t\n  1279\t    _DROP = frozenset({\"server\", \"date\"})\n  1280\t\n  1281\t    def __init__(\n  1282\t        self,\n  1283\t        handler: BaseHTTPRequestHandler,\n  1284\t        extra_headers: list[tuple[str, str]] | None = None,\n  1285\t    ) -> None:\n  1286\t        self._handler = handler\n  1287\t        self._extra_headers = list(extra_headers or ())\n  1288\t        self._extra_names = {key.lower() for key, _ in self._extra_headers}\n  1289\t        if extra_headers is not None and REQUEST_ATTRIBUTION_ENABLED:\n  1290\t            # Upstream не должен приписывать отсутствующий у клиента subagent_id.\n  1291\t            self._extra_names.update(\n  1292\t                {REQUEST_ID_HEADER.lower(), SUBAGENT_ID_HEADER.lower()}\n  1293\t            )\n  1294\t        self.status = 0\n  1295\t        self.client_gone = False\n  1296\t\n  1297\t    def start(self, status: int, headers: list[tuple[str, str]]) -> None:\n  1298\t        self.status = int(status)\n  1299\t        try:\n  1300\t            self._handler.send_response(int(status))\n  1301\t            for key, value in headers:\n  1302\t                if key.lower() not in self._DROP | self._extra_names:\n  1303\t                    self._handler.send_header(key, value)\n  1304\t            for key, value in self._extra_headers:\n  1305\t                self._handler.send_header(key, value)\n  1306\t            if not any(key.lower() == \"content-length\" for key, _ in headers):\n  1307\t                self._handler.close_connection = (\n  1308\t                    True  # тело без длины (SSE) — конец по закрытию\n  1309\t                )\n  1310\t            self._handler.end_headers()\n  1311\t        except (BrokenPipeError, ConnectionResetError, OSError) as exc:\n  1312\t            self.client_gone = True\n  1313\t            raise ClientGone() from exc\n  1314\t\n  1315\t    def write(self, data: bytes) -> None:\n  1316\t        try:\n  1317\t            self._handler.wfile.write(data)\n  1318\t            self._handler.wfile.flush()\n  1319\t        except (BrokenPipeError, ConnectionResetError, OSError) as exc:\n  1320\t            self.client_gone = True\n  1321\t            raise ClientGone() from exc\n  1322\t\n  1323\t\n  1324\tdef _owner_token_hash(handler: BaseHTTPRequestHandler) -> str:\n  1325\t    return hash_token(_extract_auth_token(handler) or AUTH_KEY)\n  1326\t\n  1327\t\n  1328\tclass ImageReject(Exception):\n  1329\t    \"\"\"Отказ image-пути с типом из таксономии C-10.\"\"\"\n  1330\t\n  6670\t            if refuse:\n  6671\t                # Код из базовой таксономии отказов (503 launcher_unavailable), клиенты DSH нового кода не знают.\n  6672\t                self._reject(\n  6673\t                    503,\n  6674\t                    \"launcher_unavailable\",\n  6675\t                    \"instruction guard is unsafe (\"\n  6676\t                    + \"; \".join(guard_reasons)[:200]\n  6677\t                    + \"): new chats are refused until the DSH profile is fixed\",\n  6678\t                    model_id,\n  6679\t                    model_len,\n  6680\t                )\n  6681\t                return None\n  6682\t        elif over is not None:\n  6683\t            # REQ-003: блок agent-instructions сверх применимого предела не доходит ни до spawn, ни до add.\n  6684\t            _log(\n  6685\t                f\"instr_gate_alert reason=REQ003_SIZE_EXCEEDED bytes={over[0]} limit={over[1]}\"\n  6686\t            )\n  6687\t            self._reject(\n  6688\t                503,\n  6689\t                \"launcher_unavailable\",\n  6690\t                f\"agent-instructions block {over[0]} bytes exceeds {over[1]}: request refused before launch\",\n  6691\t                model_id,\n  6692\t                model_len,\n  6693\t            )\n  6694\t            return None\n  6695\t        return instr\n  6696\t\n  6697\t    def _dispatch(\n  6698\t        self, ctx: dict, keepalive, sse_writer: \"StreamSink | None\" = None\n  6699\t    ) -> dict:\n  6700\t        \"\"\"Ход через адаптер бэкенда модели; общий разбор `<tool_call>` и итог в формате фасада.\n  6701\t\n  6702\t        sse_writer не None только у настоящего живого SSE-хода (_serve_sse): адаптеры, умеющие\n  6703\t        отдавать content/reasoning по мере готовности (сейчас — droid), сами вызывают его из\n  6704\t        своего пути выполнения. Остальные (muse) его просто игнорируют — поведение не меняется.\n  6705\t        \"\"\"\n  6706\t        managed_turn: ManagedTurn | None = ctx.get(\"managed_turn\") or getattr(\n  6707\t            self, \"_active_managed_turn\", None\n  6708\t        )\n  6709\t        if ctx.get(\"attached_existing\") and managed_turn is not None:\n  6710\t            managed_turn.done_event.wait(timeout=TIMEOUT_S)\n  6711\t            if managed_turn.final_dict is not None:\n  6712\t                return dict(managed_turn.final_dict)\n  6713\t     