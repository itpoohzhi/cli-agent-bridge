e: ignore[override]\n+                starts.append(time.monotonic())\n+                time.sleep(0.05)\n+                return super().write(data)\n+\n+        writer = SlowWriter()\n+        handler._wlock = threading.Lock()\n+        handler.wfile = writer\n+        handler._sse_open = True\n+        handler._live_sent_text = \"\"\n+        w = time.monotonic() + 0.32\n+        handler._write_deadline = w\n+        handler._send_sse(\"muse-spark-1.3\", \"y\" * 200, [], 1, 1, 0)\n+        self.assertNotIn(b\"data: [DONE]\", writer.getvalue())\n+        self.assertTrue(all(s <= w + 0.06 for s in starts), starts)\n+        self.assertNotIn(b'\"finish_reason\": \"stop\"', writer.getvalue())\n+\n+\n if __name__ == \"__main__\":\n     unittest.main(verbosity=2)\n\n```\n.ai-team/runs/muse-wonder-approval-20261015/coder.json:12:  \"summary\": \"Реализован пакет a4 REQ-MUSE-002/003/004 в bridges/muse-bridge/server.py: AD-001 approvalMode allowAll (env denyUnmatched AD-007), AD-002 ApprovalPolicy с receipt+decide/cancel в том же serve-ходе и терминальной деградацией с grace, setup-барьер APPROVAL_SEEN/ACTION_POSSIBLE (a4 F-001), AD-006 -32030 без обхода и без exec при denyUnmatched, AD-003 абсолютный бюджет D/E/W от приёма с единым предикатом допуска и транзиентным повтором только pre-action (observed-items по env), AD-004 единый bounded _sse_write и live reasoning через sink с префикс-монотонным согласованием F/P (VER-013 MET). Тесты: расширена фикстура install_fake_msp, добавлены классы Approval/TransientRetry/LiveReasoning полного набора a4, заменён approval-тест и обновлён test_t18 (oracle_changes). Коммиты: 9f87eb0 baseline REQ-MUSE-001 как есть, 4548dd3 реализация; push/MR/деплой не выполнялись. Для ревьюера первым смотреть: ApprovalPolicy и approval-ветку ServeRun (AD-001/002), цикл попыток Handler с предикатом _can_start (AD-003), _sse_write/_live_reasoning_sink/_send_sse (AD-004), два oracle_change теста и новые классы Approval/TransientRetry/LiveReasoning.\",\n