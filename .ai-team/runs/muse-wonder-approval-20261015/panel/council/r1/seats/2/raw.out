{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport importlib.util,pathlib,tempfile,time,json,io,threading\nfrom types import SimpleNamespace\ns=importlib.util.spec_from_file_location('acceptance_probes','tests/test_muse_bridge_killpg.py');t=importlib.util.module_from_spec(s);s.loader.exec_module(t)\nwith tempfile.TemporaryDirectory(prefix='council-k2-probe-') as td:\n    c=SimpleNamespace(tmp=pathlib.Path(td),mod=t.load_bridge());m=c.mod;m.LOG_PATH=c.tmp/'bridge.log'\n    m.APPROVAL_CANCEL_GRACE_S=.15;m.SERVE_SPAWN_TIMEOUT_S=1.4\n    t.install_fake_msp(c,serve_plans=[{'setup_approval':{'when':'initialize','payload':{'availableChoices':[]}}}])\n    r=m.ServeRun('muse-spark-1.3','hi','max',c.tmp/'workspace');start=time.monotonic()\n    try:r.execute()\n    except m.ServeUnavailable as exc:print('PROBE_SETUP_GRACE',json.dumps({'grace':.15,'setup_limit':1.4,'elapsed':round(time.monotonic()-start,3),'degraded':r.approval_degraded,'error':str(exc)}))\n    t.install_fake_msp(c,serve_plans=[t.ok_plan({'summary':[0,'a']},{'reasoning_completed':['b','c']})])\n    h=m.Handler.__new__(m.Handler);h._wlock=threading.Lock();h.wfile=io.BytesIO();h._sse_open=True;h._live_sent_text=''\n    r=m.ServeRun('muse-spark-1.3','hi','max',c.tmp/'workspace');r.live_sink=h._live_reasoning_sink\n    out=r.execute();h._send_sse('muse-spark-1.3',out['text'],[],1,1,0,out['summaries'])\n    print('PROBE_DIVERGED_PIPELINE',json.dumps({'summaries':out['summaries'],'reasoning':''.join(t.sse_deltas(h.wfile.getvalue(),'reasoning_content'))}))\n    print('PROBE_AUDIT_NEWLINE',repr(m._render_audit_token('web_search\\\\n')),repr(m._render_tool_token('tool\\\\n')))\nwith tempfile.TemporaryDirectory(prefix='council-k2-w-') as td:\n    m=t.load_bridge();m.LOG_PATH=pathlib.Path(td)/'bridge.log';m.TIMEOUT_S=.6;m.FINISH_RESERVE_S=.2;m.CLOSE_RESERVE_S=.1;m.MIN_ATTEMPT_REMAINING_S=.01\n    h=m.Handler.__new__(m.Handler);h._wlock=threading.Lock();h.wfile=io.BytesIO();h._client_gone_probe=lambda:False\n    h._sse_begin=lambda model:True\n    events={};start=time.monotonic()\n    class Connection:\n        def shutdown(self,*args):events['shutdown']=time.monotonic()-start\n        def close(self):events['close']=time.monotonic()-start\n    h.connection=Connection()\n    class SlowCleanupRun:\n        def __init__(self,*args):self.dead_confirmed=True;self._closed=False;self.lock=threading.Lock()\n        def execute(self):time.sleep(.95);return {'rc':0,'state':'ok','text':'hello'}\n        def close(self):\n            with self.lock:\n                if self._closed:return\n                events['cleanup_start']=time.monotonic()-start;time.sleep(.3);self._closed=True\n    m.ServeRun=SlowCleanupRun\n    h._serve_json(t.turn_request(stream=True));h._req_done.set()\n    print('PROBE_W_ORDER',json.dumps({'W_from_t0':.5,**{k:round(v,3) for k,v in events.items()}}))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
