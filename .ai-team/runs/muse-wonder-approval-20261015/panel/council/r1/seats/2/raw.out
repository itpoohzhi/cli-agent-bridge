rue}])\ntests/test_muse_bridge_killpg.py:3598:    def test_t_r07_action_possible_single_effect(self) -> None:\ntests/test_muse_bridge_killpg.py:3600:            install_fake_msp(\ntests/test_muse_bridge_killpg.py:3612:            install_fake_msp(\ntests/test_muse_bridge_killpg.py:3624:    def test_t_r07b_observed_items_scope(self) -> None:\ntests/test_muse_bridge_killpg.py:3627:            install_fake_msp(\ntests/test_muse_bridge_killpg.py:3639:            install_fake_msp(\ntests/test_muse_bridge_killpg.py:3656:    def test_t_r03c_client_gone_during_retry_pause(self) -> None:\ntests/test_muse_bridge_killpg.py:3658:        install_fake_msp(\ntests/test_muse_bridge_killpg.py:3677:    def test_t_r08_deadline_from_receipt_queue(self) -> None:\ntests/test_muse_bridge_killpg.py:3683:        install_fake_msp(self, serve_plans=[ok_plan({\"delay\": 1.2})])\ntests/test_muse_bridge_killpg.py:3702:    def test_t_r09_parallel_series_max_two_processes(self) -> None:\ntests/test_muse_bridge_killpg.py:3708:        install_fake_msp(self, serve_plans=[plan], track_concurrency=True)\ntests/test_muse_bridge_killpg.py:3725:    def test_t_r10_model_hangs_to_e_outcome_by_d(self) -> None:\ntests/test_muse_bridge_killpg.py:3731:        install_fake_msp(self, serve_plans=[{\"steps\": [{\"hang\": True}]}])\ntests/test_muse_bridge_killpg.py:3740:    def test_t_r11_setup_approval_no_replay_either_scope(self) -> None:\ntests/test_muse_bridge_killpg.py:3753:                install_fake_msp(self, serve_plans=[plan, ok_plan()])\ntests/test_muse_bridge_killpg.py:3760:    def test_t_r12_slow_steady_delivery_cut_at_w(self) -> None:\ntests/test_muse_bridge_killpg.py:3780:        handler._write_deadline = w\ntests/test_muse_bridge_killpg.py:3789:        handler._write_deadline = time.monotonic() + 5\ntests/test_muse_bridge_killpg.py:3795:class LiveReasoningTest(_BridgeScenario):\ntests/test_muse_bridge_killpg.py:3798:    def test_t_l01_live_deltas_concat_equals_buffered(self) -> None:\ntests/test_muse_bridge_killpg.py:3804:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3813:    def test_t_l02_completed_only_summaries_not_lost(self) -> None:\ntests/test_muse_bridge_killpg.py:3815:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3821:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3826:    def test_t_l03_keepalive_data_chunks_preserved(self) -> None:\ntests/test_muse_bridge_killpg.py:3828:        install_fake_msp(self, serve_plans=[ok_plan({\"delay\": 0.25})])\ntests/test_muse_bridge_killpg.py:3835:    def test_t_l04_live_write_failure_is_terminal_not_exception(self) -> None:\ntests/test_muse_bridge_killpg.py:3849:    def test_t_l05_model_retry_scheduled_log_only(self) -> None:\ntests/test_muse_bridge_killpg.py:3861:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3869:    def test_t_l06_out_of_order_summaries_prefix_monotone(self) -> None:\ntests/test_muse_bridge_killpg.py:3875:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3880:        install_fake_msp(self, serve_plans=[plan])\ntests/test_muse_bridge_killpg.py:3885:    def test_t_l07_diverged_snapshot_sends_authoritative_full(self) -> None:\ntests/test_muse_bridge_killpg.py:3911:        handler._write_deadline = time.monotonic() + 30\ntests/test_muse_bridge_killpg.py:3925:    def test_t_l08a_live_write_bounded_by_single_budget(self) -> None:\ntests/test_muse_bridge_killpg.py:3941:    def test_t_l08b_keepalive_blocking_first_bounds_sink(self) -> None:\ntests/test_muse_bridge_killpg.py:3970:    def test_t_l08c_terminal_delivery_and_stop_bounded(self) -> None:\ntests/test_muse_bridge_killpg.py:3986:    def test_t_l09_slow_steady_frames_stop_at_w(self) -> None:\ntests/test_muse_bridge_killpg.py:4005:        handler._write_deadline = w\n  продолжается. Терминальный исход после исчерпания — существующий формат\n  502 / SSE error с диагностикой последней попытки после редакции и удаления\n  отражённых промптов всех попыток.\n\n## 4. REQ-MUSE-004: живость и прогресс в SSE\n\nРешение AD-004 (APPROVED), границы BND-002 и BND-004, дельта CD-001.\n\n### 4.1 Что стримится, а что нет\n\nСтримится только прирост reasoning summaries serve-пути. Content, tool_calls,\nusage и финальный кадр — как сегодня, после завершения всех попыток: разбор\ntool-разметки `_split_tool_calls` работает по полному тексту, и частичная\nразметка клиенту не утекает. Exec-ходы summaries не дают и live не имеют.\nФорма Non-stream JSON не меняется, включая поле `reasoning_summaries` целиком; запись тоже ограничена W/D, при невозможности доставки — закрытие без нового процесса.\n\n### 4.2 Контракт live-sink и инвариант конкатенации\n\n- ServeRun получает необязательный sink Handler и зовёт его синхронно из своего\n  цикла чтения при каждом приросте summary: дельты `summary.N` и списки\n  `summary` из `item/completed` проходят один путь накопления\n  (`summary_parts`/`summaries`, как сегодня), чтобы текст без дельт не терялся.\n  ServeRun сокет, `_wlock` и фазы SSE не знает и исключений записи не получает:\n  sink возвращает только факт успеха.\n- Предел выдачи a4 (PF-a3-002): для любого вызова _sse_write в момент s единый локальный deadline L=min(s+LIVE_WRITE_TIMEOUT_S, W), LIVE_WRITE_TIMEOUT_S=3 с. Ожидание _wlock, sendall/write и flush используют один убывающий остаток до L (таймаут переустанавливается по остатку перед каждым блокирующим этапом, не по 3 с на этап); возвращается прежний socket timeout до освобождения замка. Этот предел действует на role, keepalive, live reasoning, финальный reasoning-хвост, tool_calls, КАЖДЫЙ content-кадр, finish_reason, usage, error и [DONE], без исключений. Все циклы сериализации/разбиения кадров, baseline-пауза 5 мс между content-кадрами и остановка/join keepalive проверяют W и прерываются надзором; нельзя начинать новый кадр/паузу при неположительном остатке, кадровый бюджет не обновляет W. keepalive допускается только OPEN, перед финальной выдачей останавливается в остатке до W. При истечении W либо L или частичном кадре запрос получает единственный локальный неуспешный исход delivery_deadline/client_gone, live и другие писатели остановлены, соединение закрывается; поздний успех модели игнорируется, повтор/fallback запрещены даже если ещё нет _content_started. После частично отправленного кадра или при нулевом остатке новый error/[DONE] не дописывается. Если ошибка известна раньше и полный корректный error+[DONE] успевает в оставшийся W, допустим один обычный ошибочный терминал; гарантировать его при аварийном обрыве нельзя. Успех существует только если ВСЯ конечная выдача, включая finish/usage и единственный [DONE], завершена до W; успешный локальный исход не фиксируется по завершению вычисления. При исчерпании бюджета результат может быть усечён закрытием соединения; отсутствие потери F обещается только для полностью доставленного успешного ответа. Полный текст и завершающий [DONE] после W не обещаются ни для читающего клиента, ни при расхождении snapshot. Нормальный путь сохраняет поля/порядок внешнего API. Резерв на 2 error-кадра не является доказательством доставки N content-кадров.\n- Префикс-монотонная публикация (RW-005). Порядок опубликованного задним\n  числом не меняется: до заморозки live отдаёт только прирост\n  `summary_parts[0]`. Заморозка наступает при первой дельте с индексом больше\n  0, при `item/completed` reasoning или в конце хода; дальше дельты только\n  копятся. Поздний меньший индекс (первой пришла `summary.1`) ничего не\n  публикует до согласования. Финальное согласование в `_send_sse`: пусть `F`\n  — сегодняшняя сборка `\"\\n\\n\".join(summaries)`, `P` — уже отправленный\n  live-текст. Если `F` начинается с `P`, доотдаётся только хвост `F[len(P):]`\n  (при полном live финального reasoning-кадра нет, повтор snapshot хвоста не\n  даёт). Если нет (расхождение; не ожидается, ASM-011; PF-a2-004) — для полностью доставленного успешного ответа **потеря\n  авторитетного текста запрещена**: после уже отправленного `P` клиенту уходит\n  разделитель `\"\\n\\n\"` и авторитетный `F` **целиком** отдельным абзацем\n  (допускается дублирование части текста, потери нет), расхождение логируется\n  счётчиком `reasoning_diverged` с длинами `P`, `F` и общего префикса без текста.\n  Пример: `P=\"a\"`, `F=\"b\\n\\nc\"` → клиент получает `a` + `\\n\\n` + `b\\n\\nc`. Так последовательность `0:\"a\" → 1:\"b\" → 0:\"c\"` даёт клиенту\n  `\"a\"` + хвост `\"c\\n\\nb\"` = итоговую `\"ac\\n\\nb\"`, а расхождение\n  `item/completed` с дельтами не дублирует и не переставляет текст.\n  Non-stream ответ всегда несёт авторитетную сборку `F` целиком.\n- Первый фактически отправляемый непустой reasoning-кадр выставляет\n  `_content_started` внутри той же критической секции `_sse_write` до записи (форма —\n  параметр или колбэк вызова, зона Coder) — с этого момента повторы §3\n  и контекстный повтор запрещены; буферизованная, но не отправленная дельта\n  флага не ставит.\n- Keepalive без изменений: пустой data-чанк каждые 15 с в фазе OPEN (предел записи —\n  общий, выше). Переход на SSE-комментарии droid-моста не делается (OPEN-03,\n  deferred): пустые чанки держат клиента по комментарию в коде моста (влияние на\n  idle-watchdog клиента в ledger не найдено, ASM-003, `[F-47]`), комментарии для\n  muse-моста не проверены, а тест test_s1 закрепляет отсутствие `: keepalive` и\n  сохраняется.\n\n### 4.3 Наблюдаемость прогресса\n\n- Первая summary-дельта хода логируется строкой с секундами от старта хода и\n  индексом (без текста): это вход отдельной диагностики VER-011; приёмку VER-009 наблюдение не заменяет (RW-007). На транзиентном терминале при истинном `_content_started` пишется строка `retry_blocked` — пара логов даёт долю ходов «первая дельта раньше сбоя» для метрики FU-005.\n  Существующая строка `reasoning summaries=... preview=` в конце хода не меняется.\n- Журнал инструментальных item (PF-a2-006): каждый `item/started` и `item/completed` с\n  `kind` вне {`reasoning`, `agentMessage`} логируется строкой с `kind` и `toolName` только при\n  совпадении с allowlist `[A-Za-z0-9_.:/-]{1,64}` (иначе `redacted` с длиной), без `rawArgs`;\n  счётчик таких item входит в итоговую строку хода; на каждом транзиентном терминале serve\n  логируется наличие `timeToFirstTokenMs` и `usage` (EVD-028). Это исполнимый способ закрытия\n  ASM-010 и аудит наблюдаемых инструментальных действий отдельно от остаточных approval-запросов\n  (T-A15, VER-009).\n- `turn/modelRetryScheduled` (только 1.4.8) логируется полями `attempt`,\n  `maxAttempts`, `retryDelayMs`, `errorKind` и клиенту не отдаётся: текстовый\n  проброс загрязнил бы reasoning и ложно закрыл окно повторов. Живость на время\n  паузы провайдера держит keepalive.\n\n## 5. Безопасность и угрозы\n\nГраницы доверия и потоки данных (VIEW-003):\n\n```text\n[DSH доверенный клиент владельца]\n   |  промпт, история сессии            ^ SSE: reasoning/content\n   v                                    |\n[мост :9886, ключ, loopback] --аудит безопасных полей--> bridge.log\n   |  MSP: session/start allowAll, receipt/decide\n   v\n[muse serve: песочница хоста, write/shell OFF] -> инструменты модели\n   |  через muse-cli.sh и прокси :10816 (вне доверия моста)\n   v\n[Meta API]\n```\n\nСводка угроз пакета: THREAT-001 (авторазрешённый инструмент и исходящая сеть),\nTHREAT-002 (утечка через аудит-лог), THREAT-003 (удержание слотов циклами и\nповторами), THREAT-004 (переигрывание после частичных эффектов). Митигации и\nпроверки — в пакете по ID. Честный остаток: до первого живого payload (OPEN-01)\nпакет не утверждает, какие именно действия будут авторазрешены на wonder;\nутверждается только, что write и shell выключены хостом, песочница включена, а\nкаждое решение моста по остаточному запросу видно владельцу в логе (полный аудит действий без остаточного запроса пакет не обещает, FU-001); откат политики — env-переключатель AD-007: при `denyUnmatched` мост нигде не разрешает\nдействия автоматически (`exec --yolo` не запускается ни в какой роли, AD-006), цена — доступность\n(RISK-010); применение — plist + `bootout`/`bootstrap` (§7). Селективный deny без payload не\nпроектируется: список запретов по догадке дал бы ложную границу.\n\n## 6. План тестов (red → green, файл тот же)\n\"\"\"Regression-тесты утечки слотов muse-bridge: killpg группы и обрыв клиента.\n\n2026-10-09: close() Run/ServeRun бил только прямого ребёнка (proc.kill),\nsleep-«внук» в группе хода выживал; обрыв клиента во время exec/serve ход не\nпрерывал — слот держался всю длительность прогона (до TIMEOUT_S), /health\nпоказывал active=1. Тесты гоняют зеркальную копию моста\nbridges/muse-bridge/server.py без живого muse-bin: вместо CLI — фейк-обёртка\nна sh (serve сразу rc=42 → безусловный fallback на exec, exec держит ход:\nлидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\nкоторый проходит handshake и держит turn/start без завершения.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport http.client\nimport io\nimport itertools\nimport json\nimport os\nimport re\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any, Callable\nfrom unittest import mock\n\n_REPO_BRIDGE_PY = (\n    Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n)\nBRIDGE_PY = (\n    _REPO_BRIDGE_PY\n    if _REPO_BRIDGE_PY.exists()\n    else Path(__file__).resolve().parents[1] / \"server.py\"\n)\n\n_LOAD_SEQ = itertools.count()\nDISCONNECT_AFTER_S = 1.0\nSCENARIO_DEADLINE_S = 5.0\nGROUP_EXIT_WAIT_S = 5.0\n\n# Фейк muse-cli.sh: транспорт serve «недоступен» (мост уходит в fallback exec),\n# exec пишет pid лидера группы и держит ход 30 с.\nFAKE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exit 42\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Фейк muse-cli.sh для serve-хода: serve принимает turn/start и держит ход (без\n# turn/completed), exec-fallback отмечается отдельным pid-файлом — его появление\n# означает, что сценарий serve не удался.\nSERVE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exec \"{python}\" \"{script}\" \"{servepid}\"\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Python-скрипт serve: handshake по NDJSON JSON-RPC, после turn/start — «внук» sleep\n# в той же группе и pid-файл лидера (сигнал «serve удерживает ход»), дальше тишина.\nFAKE_SERVE_SCRIPT = \"\"\"import json, os, subprocess, sys, time\n\npidfile = sys.argv[1]\nRESULTS = {\n    \"session/start\": {\"session\": {\"sessionId\": \"sess-1\"}},\n    \"turn/start\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"},\n}\nfor line in sys.stdin:\n    msg = json.loads(line)\n    rid = msg.get(\"id\")\n    if rid is None:\n        continue\n    reply = {\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": RESULTS.get(msg[\"method\"], {})}\n    sys.stdout.write(json.dumps(reply) + \"\\\\n\")\n    sys.stdout.flush()\n    if msg[\"method\"] == \"turn/start\":\n        subprocess.Popen([\"sleep\", \"30\"])\n        with open(pidfile, \"w\") as fh:\n            fh.write(str(os.getpid()))\n        while True:\n            time.sleep(1)\n\"\"\"\n\n\ndef load_bridge() -> Any:\n    \"\"\"Свежий экземпляр модуля моста: изолированные _slots/_active на каждый тест.\"\"\"\n    spec = importlib.util.spec_from_file_location(\n        f\"muse_bridge_server_{next(_LOAD_SEQ)}\", BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (сигнал 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '110,330p' .ai-team/runs/muse-wonder-approval-20261015/architecture/arch-spec.md; sed -n '1360,1450p' bridges/muse-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '110,330p' .ai-team/runs/muse-wonder-approval-20261015/architecture/arch-spec.md; sed -n '1360,1450p' bridges/muse-bridge/server.py\"","aggregated_output":"Выход — ровно одно действие:\n\n- `approve(choiceId)` — выбор только из текущих `availableChoices`;\n- `deny(choiceId)` — выбор с `decision` равным `abort` или `denied` (только ветка\n  деградации §2.4);\n- `cancel_user_input` — для `userInput/request`;\n- `fail_turn` — разрешающего и отклоняющего выбора нет, транспорт завершает ход\n  через `turn/cancel`.\n\nПравило выбора разрешающего `choiceId` (детерминированно, по полю `decision`\nкаждого элемента `availableChoices`, не по строке `choiceId`):\n\n1. первый выбор с `decision == \"approved\"`;\n2. иначе первый с `decision == \"approvedForSession\"`;\n3. `approvedPolicyAmendment` никогда не выбирается: смена политики выходит за\n   решение владельца (EVD-009 фиксирует режим сессии, а не правку политики);\n4. пустой или отсутствующий список, битый снимок — `fail_turn` ветки деградации.\n\nАудит-запись действия строится здесь же и содержит только: метод, `toolName`,\n`subject.kind`, `protectedWrite`, `judgeEscalated`, список `choiceId` снимка,\nвыбранный `choiceId` и его `decision`, счётчик решения в ходе. Транспорт пишет её одной\nстрокой `_log` (редакция существующая). Свободные строки снимка рендерятся в лог\nограниченно (FU-009): `toolName` и каждый `choiceId` — только при `[A-Za-z0-9_.:-]`\nи длине до 64, иначе `redacted` с длиной и префиксом sha256; список `choiceId`\nобрезан 8 значениями. Команда `decide` получает сырые значения без изменений.\nApprove политика выдаёт только при сконфигурированном `allowAll` (AD-007). Пример формы (значения иллюстративны):\n\n```text\napproval_decide tool=web_search subject=tool protected=0 judge=0 choices=[c1,c2] chosen=c1 decision=approved n=1\n```\n\n### 2.3 Транспорт decide в ServeRun (BND-002)\n\n- Receipt: ответ по серверному id дословно, result: {} (EVD-006). Уже получение approval/request|requested или userInput/request в setup либо внутри хода защёлкивает APPROVAL_SEEN/ACTION_POSSIBLE ДО receipt, дедупликации и выбора политики. Поэтому ошибка receipt/decide/cancel после события терминальна без любого нового serve/exec даже до turn/start; исключение также несёт агрегаты Handler. Точный барьер — §3.2 и AD-002/003.\n- `approval/decide` параметры: `approvalId` и `sessionId` из снимка,\n  `requirementId` — значение `currentRequirementId` снимка дословно (объект\n  `{approvalId, sourceIndex}` по схеме, мост его не конструирует и не правит),\n  `commandId` — существующий `_uuid7()`, `choiceId` — из политики. `feedback`\n  не отправляется.\n- Decide не ожидается рекурсивно внутри обработчика события: команда уходит,\n  её `result`/`error` разбирает главный цикл по `rid` моста. Голые ack чужих rid\n  по-прежнему игнорируются; `error` ожидающего decide ведёт в деградацию §2.4,\n  кроме `-32051 approvalAlreadyResolved`, который логируется и ход продолжается\n  (гонка request против requested). `result.terminal == false` ничего не требует:\n  обновлённый `approval/request` придёт обычным событием и пройдёт тот же путь.\n- Дедупликация: множество решённых пар (`approvalId`, дословное представление\n  `currentRequirementId`) на ход. Повтор той же пары из `approval/requested`\n  после `approval/request` второго decide не даёт.\n- Критично: дедлайн записи в stdin. Сегодня `self._write_until` равен\n  setup-дедлайну 30 с на весь `execute` (`server.py:1697-1698`), а approval в\n  инцидентах приходил на 275 с и 412 с. После записи `turn/start` граница\n  записи обязана стать дедлайном хода, иначе первый же decide упадёт в\n  `ServeUnavailable` и вернёт exec-рестарт. Тест T-A07 (§6) это закрепляет.\n- `userInput/request`: receipt, затем `userInput/cancel` с `commandId`,\n  `sessionId`, `userInputId` из снимка. `userInput/interrupt` не применяется:\n  по схеме он останавливает ход (EVD-006 через F-34), что противоречит REQ.\n  Результат cancel наблюдается главным циклом так же, как decide.\n- Уведомления `approval/updated`, `approval/resolved`,\n  `session/approvalModeChanged`, `userInput/settled` только разбираются без\n  действий (resolved допустимо логировать одной строкой без payload).\n\n### 2.4 Границы цикла и деградация\n\nНа один ход: не более 10 `approval/decide` суммарно, **включая финальный\nотказной decide**, и не более 3 `userInput/cancel` (константы модуля, §8).\nОдиннадцатого decide не существует: при исчерпанном счёте деградация идёт сразу\nчерез `turn/cancel`. Обоснование меры 10 как в a1: порядок выше единичного\nнаблюдения при жёстком пределе удержания слота; значение обратимо константой.\n\nТерминальное защёлкивание отказа (RW-006, единое правило PF-a2-011). Триггеры: нет\nразрешающего выбора; **любая** ошибка `approval/decide`, кроме benign `-32051`\n(коды схемы `[F-28]`: `-32050`, `-32052`, `-32053`, `-32054 approvalReviewerUnavailable`,\n`-32030 commandRejected`); **любая** ошибка `userInput/cancel`; превышение границы;\nошибка либо превышение предела записи stdin после ACTION_POSSIBLE/APPROVAL_SEEN, включая setup. При первом триггере локальный исход хода\nфиксируется неуспешным ровно один раз: при наличии выбора `abort`/`denied` и\nсвободном счёте уходит один такой decide, иначе один\n`turn/cancel {commandId, sessionId, turnId}`. После защёлкивания: новых\nразрешений и повторных входов в деградацию нет; дальнейшие `approval/request`\nи `userInput/request` только логируются без команд; любой ответ сервера —\nповторный request, `terminal=false`, успешный `turn/completed`, молчание —\nлокальный исход не меняет, поздний успешный текст отбрасывается, частичный\nтекст клиенту не уходит. Клиент получает ровно один терминальный исход\nсуществующим форматом (502 или SSE error, один `[DONE]`). Влияние denied и\ncancel на pending approval неизвестно (ASM-006) и опорой не служит.\n\nGrace после деградации (RW-008, PF-a2-003): `APPROVAL_CANCEL_GRACE_S=15` с\n(один интервал keepalive, ограничен общими E/W/D §3.3) отсчитывается по `time.monotonic()` от момента\nлокального защёлкивания (`_approval_degraded=True`) и **включает саму попытку записи**\n`turn/cancel` или отказного decide в stdin: запись ограничена остатком grace,\nзаблокированный stdin grace не продлевает. Запись любой управляющей команды (receipt,\ndecide, cancel) ограничена `CONTROL_WRITE_TIMEOUT_S=5` с (ASM-012) и остатком до\nисполнительного дедлайна E; превышение защёлкивает деградацию. Grace не продлевает W/D (§3.3). По истечении grace —\nубийство группы процессов serve существующей механикой, терминальная ошибка,\nосвобождение слота. Ожидания дедлайна 1800 с ради слота здесь нет: два\nпроигнорировавших cancel (или заблокировавших stdin) хода мост целиком не блокируют.\nДедлайны ServeRun переводятся с `time.time()` на `time.monotonic()` (EVD-026).\n\nExec-рестарт по ветке деградации запрещён; альтернатива «exec последним шагом\nдеградации до `_content_started`» взвешена и отклонена в AD-002 (FU-004):\nпосле approval-трафика ACTION_POSSIBLE §3.2 может быть уже защёлкнут.\nКаждая деградация логируется `approval_degraded` с флагами `content_started`\nи барьера активности — это измеримый вход условия её пересмотра.\n\nЧто меняется против a1 в fallback (RW-001, PF-a2-001): тихий exec fallback по\n`ServeUnavailable` сохраняется **только до записи `turn/start`** (граница\n`ACTION_POSSIBLE`, §3.2) и до любого approval-трафика (спавн, handshake,\n`session/start`, EOF и RPC-ошибки setup, включая ветку `-32030` из AD-006) и только\nесли режим не `denyUnmatched` (PF-a2-005: exec всегда с `--yolo`, при `denyUnmatched` он\nне запускается ни в какой роли — терминальный исход 502/SSE error с причиной\n`exec_fallback_disabled`). После записи `turn/start` EOF, ошибка\nчтения, ошибка записи stdin, дедлайн чтения и `turn/start` без ack — терминальные без exec;\n`cancel` → EOF — ожидаемое подтверждение очистки, а не повод для fallback.\nОшибка модели (`terminal != completed`) по-прежнему не фолбэчится; при\nушедшем клиенте надзор убивает группу и ничего нового не стартует. Approval\nво время setup-фазы (`await_result` маршрутизирует чужие сообщения в тот же\nобработчик) проходит тот же путь: `sessionId` берётся из снимка, локальная\nсессия моста может ещё не существовать.\n\n## 3. REQ-MUSE-003: ограниченный повтор транзиентных сбоев\n\nРешение AD-003 (APPROVED), граница BND-003. Внутренний однократный сетевой повтор внутри\nexec-after-fallback (`server.py:2435-2445`, baseline REQ-MUSE-001) **упраздняется**: после\nстарта exec-процесса повтор запрещён (§3.2, ACTION_POSSIBLE); отдельного третьего пути повтора\nне остаётся.\n\n**Честная цена (a3, PF-a2-001, RISK-009).** Повтор допускается только там, где отсутствие\nдействия модели доказано: до записи `turn/start`. Посреди хода и на exec действие без\nitem/approval сигналов фактами не исключено (ASM-010), а семантика at-least-once владельцем\nне принималась (THREAT-004). Поэтому наблюдавшиеся net-timeout длительностью до 452 с\n(EVD-011) в области по умолчанию остаются терминальным отказом без повтора; REQ-MUSE-003\nзакрывается только для пре-турновых сбоев. Расширение — по решению владельца (Q-010).\n\n### 3.1 Классификация (только явные маркеры)\n\nПопытка считается транзиентно-транспортной, когда её сырой канал ошибки (до\nредакции, как детектор hard threshold) содержит хотя бы одну подстроку:\n\n| Маркер | Источник |\n|---|---|\n| `[net-timeout]` | лог и бенч (EVD-011) |\n| `timed out waiting for response data` | лог и бенч (EVD-011) |\n| `network connection could not be opened` | существующий `NETWORK_RETRY_MARKER` (EVD-010) |\n| `transport_connect_unreachable` | текст REQ-MUSE-003; в логах на 2026-10-15 не засвидетельствован (grep пуст), тест синтетический |\n\nИсточник текста явный (FU-012): на serve для пре-турновых сбоев — текст ошибки setup (исключение ServeRun), а для терминала хода (используется только в области `observed-items`, §3.2 п.5) классификатор смотрит конкатенацию `turn/completed.error.kind` и `error.message` до редакции (поля схемы `[F-35]`), на exec — сырой stderr-канал ошибки; значения enum `kind` не выдумываются, маркеры ищутся в обоих полях. Классификатор — чистая проверка по образцу `_has_hard_threshold_marker`,\nрезультат — флаг в словаре попытки по образцу `hard_threshold`. Поле\n`retryable` ошибки serve само по себе класс не даёт: hard threshold тоже\n`retryable=True` и принадлежит контекстному пути. Подстрока в обычном тексте\nответа при `rc == 0` повтор не запускает. Состояния `timeout`, `spawn_failed`,\n`launcher_missing`, `client_gone` не повторяются при любом тексте: первое уже\nисчерпало бюджет, остальные детерминистичны или бессмысленны без клиента.\n\n### 3.2 Граница действия и условия допуска нового процесса (все одновременно)\n\nНеобратимый общий барьер a4 (PF-a3-001): у запроса APPROVAL_SEEN защёлкивается сразу при получении approval/request, approval/requested или userInput/request, в том числе во время initialize/session/start/setup, ДО receipt, дедупликации и решения политики. ACTION_POSSIBLE для serve защёлкивается при самом раннем из этих событий, ДО первой попытки записи любого разрешающего approval/decide (approved либо approvedForSession, даже без предшествующего события) и ДО первого байта turn/start; exec — при успешном старте процесса с промптом. Разрешающий decide во время setup допустим только в том же процессе при allowAll, с теми же choices/лимитами/таймерами AD-002. ACK, -32051, terminal=false, ошибка/частичная запись, конец setup и смерть группы не сбрасывают ни один флаг. Эти флаги передаются Handler до возврата результата или исключения; агрегаты на запрос монотонны по всем попыткам. APPROVAL_SEEN или попытка разрешающего decide безусловно запрещают ЛЮБОЙ новый serve/exec (внутренний fallback, транзиентный и контекстный retry, обе области pre-action/observed-items). Не требуется доказательство фактически выполненного действия. Ошибка управляющего обмена после такого события терминальна по AD-002 даже до turn/start; если turnId ещё неизвестен, turn/cancel с выдуманным ID не посылается: доступный отказной decide в оставшемся счёте, иначе bounded ожидание/killpg. Setup-обработчик не продлевает SERVE_SPAWN_TIMEOUT_S и применяет min(CONTROL_WRITE_TIMEOUT_S, остаток setup/E); grace от локального защёлкивания обрезается общим дедлайном завершения AD-003. Тот же процесс может продолжиться успешно и послать первый turn/start; запрет касается переигрывания новым процессом.\n\n1. Попытка неуспешна и классифицирована транзиентной (§3.1) либо является пре-турновым\n   сбоем serve; при этом не является hard threshold с доступным контекстным повтором\n   (приоритет §3.3).\n2. Транзиентных повторов в этом запросе было меньше 2 (отдельный счётчик запроса,\n   не попытки). Внутренний serve→exec fallback счётчик не расходует только в\n   до-турновой ветке, где исхода хода ещё не было, но проходит тот же предикат,\n   тот же дедлайн и тот же лимит процессов — бесплатным он не является (RW-001).\n3. Клиент на месте (`_client_gone` ложен и проба отрицательна) в момент решения\n   и после паузы.\n4. Контентные кадры не отправлялись: `_content_started` ложен. Пустые keepalive и\n   role-кадр границей не являются; первая фактически отправленная live\n   reasoning-дельта является (§4.2), буферизованная неотправленная — нет.\n5. Область повтора (PF-a2-001, AD-003 п.4): по умолчанию `pre-action` — условие\n   «нет ACTION_POSSIBLE у прежних попыток» (см. выше): новый процесс возможен только после\n   сбоев до setup approval/userInput/попытки allowing decide И записи `turn/start` (spawn, handshake, `session/start`, до-турновый транспорт).\n   Переключатель `MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE=observed-items` (читается при старте,\n   невалидное значение останавливает старт) заменяет это условие барьером наблюдаемой\n   активности a2: на serve не было `approval/request|requested`, `userInput/request`,\n   отправленного decide и item с `kind` вне {`reasoning`, `agentMessage`} (ServeRun ведёт\n   `kinds`, EVD-025), на exec результат не несёт текста и summaries — и тем самым **принимает\n   at-least-once** для действий без наблюдаемых сигналов; включается только после записанного\n   решения владельца (Q-010) и закрытия ASM-010; при старте warning, на каждый повтор — строка\n   `retry_scope`. В обеих областях НЕ было APPROVAL_SEEN/попытки allowing decide и не защёлкнута approval-деградация; финализация/ошибка доставки не начата. Переключатель не отменяет общий approval-барьер. Для exec-процесса\n   дополнительно режим approval не `denyUnmatched` (§2.4).\n6. Все группы процессов прежних попыток закрыты и `dead_confirmed` истинен;\n   иначе действует существующий карантин слота, повтор не стартует.\n7. Остаток до исполнительного дедлайна E (§3.3) не меньше `MIN_ATTEMPT_REMAINING_S=120` с\n   (PF-a2-008); пауза повтора входит в бюджет.\n8. Промпт повтора — тот же `attempt_prompt` текущей попытки дословно; прунинг на\n   транзиентной ветке не выполняется.\n\nТот же предикат (пункты 3–7) гейтит до-турновый exec-fallback и серверный пре-турновый\nповтор: новый процесс в обход предиката не стартует ни в одной ветке. Контекстный повтор\n(hard threshold, AD-005) сохраняет гарантию «ровно один и до первого контентного кадра»\n(`do_not_change`) и гейтится пунктами 3–7 с **барьером наблюдаемой активности** вместо\nACTION_POSSIBLE: hard threshold — явный отказ провайдера по размеру контекста, а не\nнеопределённый таймаут; остаток риска ненаблюдаемого действия унаследован от baseline\nREQ-MUSE-001 и записан в ASM-010. Общий approval/allowing-decide барьер остаётся обязательным для контекстного retry; объект AD-005 и его лимит/прунинг сохранены без изменений.\n\n### 3.3 Бюджеты, дедлайн и взаимодействие счётчиков\n\n- Бюджет a4 (PF-a3-002): t0 = time.monotonic() при приёме запроса Handler до очереди; D — АБСОЛЮТНЫЙ предел ВСЕГО запроса, включая очередь, вычисление, сериализацию, всю успешную либо ошибочную выдачу, закрытие соединения и bounded cleanup. D = t0 + min(TIMEOUT_S, REQUEST_CAP_S), REQUEST_CAP_S=1800 с (выбор ASM-013; при default TIMEOUT_S=1800 сохранён); большее операторское TIMEOUT_S не отодвигает D. При известных клиентских 1900 с [F-19]/EVD-016 запас не меньше 100 с, не используется для выдачи. E = D − FINISH_RESERVE_S (35 с), W = D − CLOSE_RESERVE_S (12 с). Очередь, все попытки и retry-паузы ограничены E, вся выдача и все её писатели — W; E..D резервируется для grace/уборки/выдачи/закрытия, но не доказывает доставку произвольного числа кадров. Успешная модель около E получает только остаток до W на финальную выдачу (максимум 23 с при default до затрат cleanup). Ни кадр, ни пауза, ни flush, ни keepalive, ни ожидание _wlock/остановки keepalive не продлевают W. Смена фаз и все входы в _wlock тоже bounded остатком до W. Независимый от писателя и _wlock надзор при достижении W атомарно останавливает выдачу, запрещает новые процессы, делает shutdown/close соединения без ожидания _wlock и прерывает все ожидания; уборка группы ограничена остатком до D (нового полного grace после W/D нет). CLOSE_RESERVE_S=12 с — явно выбранный continuable резерв по текущему worst-case _terminate_run 5+5+2, EVD-026; это не измеренный SLA ОС, ASM-013. Подтверждённая смерть освобождает слот ровно один раз до D; если подтверждения нет к D, соединение всё равно закрыто, слот в существующем карантине, новый процесс запрещён и отсутствие освобождения не маскируется успешным исходом. D не сдвигается при повторах или завершении модели. HTTP JSON non-stream использует тот же W/D и bounded запись, форма ответа не меняется.\n- Новый процесс допускается только при остатке до E не меньше MIN_ATTEMPT_REMAINING_S=120 с (env MUSE_BRIDGE_MIN_ATTEMPT_S); очередь входит в t0. Порог по-прежнему выше 51.1/94 с из EVD-011, handshake=30 с не является временем на ход.\n- Контекстный повтор (ровно 1, AD-005) получает тот же остаток до `E` и проходит\n  предикат §3.2 (с барьером наблюдаемой активности, §3.2).\n- Цикл запроса детерминирован: после каждой попытки сначала проверяется\n  контекстный повтор (hard threshold, свой счётчик, прунённый промпт), затем\n  транзиентный (свой счётчик, тот же промпт), иначе терминальный исход.\n  Верхняя граница едина везде (FU-006): не более 3 вызовов `run_attempt` без\n  контекстного повтора и не более 4 с ним (1 + 1 контекстный + 2\n  транзиентных), не более 8 процессов с до-турновым fallback, все в одном\n  слоте и внутри бюджета `E`. В области по умолчанию транзиентный повтор исполняется\n  только после пре-турновых сбоев serve (новый serve-процесс, затем один exec-fallback),\n  паузы 2/4 с + джиттер применяются к ним же.\n- Паузы между транзиентными попытками: 2 с, затем 4 с, каждая плюс джиттер\n  равномерно до 1 с; суммарно не более 8 с. Пауза спит срезами не дольше тика\n  надзора клиента (0.25 с) и прерывается уходом клиента. Длительности читаются\n  из модульных констант в момент повтора, чтобы тесты ужимали их monkeypatch,\n  как сегодня ужимается `KEEPALIVE_S`.\n- Нагрузка при деградации транспорта (FU-010, QA-009): слот удерживается на\n  весь ход, поэтому повторы не поднимают параллельность выше\n  `MAX_CONCURRENT=2`; глобальный cooldown и circuit breaker осознанно не\n  вводятся, суммарную длительность ограничивают паузы и исполнительный дедлайн `E`.\n- Между попытками клиенту не уходит ни error, ни [DONE]; keepalive фазы OPEN\n  продолжается. Терминальный исход после исчерпания — существующий формат\ndef _kill_group(proc: subprocess.Popen) -> None:\n    \"\"\"Убить всю группу процессов хода: ребёнок — лидер группы (start_new_session).\n\n    Фолбэк proc.kill() — если killpg недоступен/запрещён (эталон\n    adapters/muse_adapter.py, RW-009).\n    \"\"\"\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        try:\n            proc.kill()\n        except OSError:\n            pass\n\n\ndef _group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (killpg сигналом 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef _wait_group_exit(pgid: int, timeout: float, leader_reaped: bool = False) -> bool:\n    \"\"\"Короткое ожидание ухода группы после SIGKILL (обычно мгновенно).\n\n    Пока группа жива, SIGKILL повторяется: потомок, форкнувшийся в момент первого killpg,\n    остаётся в группе и иначе держал бы pipe (close() вешался бы на чтении stderr).\n    Лидер реапнут (leader_reaped) — его pid свободен для переиспользования, поэтому после\n    одного контрольного killpg по ещё живым потомкам сигналы прекращаются, остаётся опрос.\n    \"\"\"\n    deadline = time.monotonic() + timeout\n    control_sent = False\n    while _group_alive(pgid) and time.monotonic() < deadline:\n        if not (leader_reaped and control_sent):\n            try:\n                os.killpg(pgid, signal.SIGKILL)\n            except OSError:\n                pass\n            control_sent = True\n        time.sleep(0.05)\n    return not _group_alive(pgid)\n\n\ndef _terminate_run(run: Any, streams: tuple) -> None:\n    \"\"\"Убить группу хода и подтвердить её смерть; результат — run.dead_confirmed.\n\n    TimeoutExpired при ожидании после SIGKILL не считается смертью: SIGKILL группы повторяется\n    (в _wait_group_exit тоже), смерть группы проверяется по факту. Не подтверждена — трубы не\n    закрываются (close() ждал бы читателя), слот хендлера уйдёт в карантин.\n    \"\"\"\n    proc = run.proc\n    if proc is None:\n        return\n    # Уборка идёт под замком: параллельный close() (таймер, надзор обрыва, finally\n    # execute) ждёт её конца и видит итоговый dead_confirmed, а не выходит по _closed.\n    with run._cleanup_lock:\n        if run._closed:\n            return\n        run._closed = True\n        # Пессимистично до подтверждения: оборванная уборка уйдёт в карантин слота.\n        run.dead_confirmed = False\n        _kill_group(proc)\n        try:\n            proc.wait(timeout=5.0)\n        except subprocess.TimeoutExpired:\n            _log(f\"cleanup: wait after SIGKILL timed out pid={proc.pid}, escalating\")\n            _kill_group(proc)\n            try:\n                proc.wait(timeout=5.0)\n            except subprocess.TimeoutExpired:\n                pass\n        run.dead_confirmed = _wait_group_exit(\n            proc.pid, 2.0, leader_reaped=proc.poll() is not None\n        )\n        if not run.dead_confirmed:\n            _log(f\"cleanup: process group {proc.pid} not confirmed dead after SIGKILL\")\n            return\n        for stream in streams:\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n                pass\n\n\ndef _quarantine_slot(runs: list) -> None:\n    \"\"\"Слот держится, пока группы ходов не подтверждены мёртвыми (карантин), затем возвращается.\"\"\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^class (Approval|TransientRetry|LiveReasoning)|''^    def test_t_[arl]|''^    def test_startup|''^def load|''^def make|''^def install_fake'\"' tests/test_muse_bridge_killpg.py; sed -n '1,75p' tests/test_muse_bridge_killpg.py; sed -n '185,290p' tests/test_muse_bridge_killpg.py; sed -n '3570,4013p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^class (Approval|TransientRetry|LiveReasoning)|''^    def test_t_[arl]|''^    def test_startup|''^def load|''^def make|''^def install_fake'\"' tests/test_muse_bridge_killpg.py; sed -n '1,75p' tests/test_muse_bridge_killpg.py; sed -n '185,290p' tests/test_muse_bridge_killpg.py; sed -n '3570,4013p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"109:def load_bridge() -> Any:\n1246:def install_fake_msp(\n2941:class ApprovalTest(_BridgeScenario):\n2948:    def test_t_a01_session_start_allowall_and_flags(self) -> None:\n2963:    def test_t_a02_approval_receipt_and_decide_without_exec(self) -> None:\n2984:    def test_t_a03_policy_preference_and_amendment_never_chosen(self) -> None:\n3033:    def test_t_a04_terminal_false_then_updated_request(self) -> None:\n3044:    def test_t_a05_requested_dedup_single_decide(self) -> None:\n3067:    def test_t_a06_user_input_receipt_and_cancel(self) -> None:\n3082:    def test_t_a07_approval_after_setup_window_still_decides(self) -> None:\n3091:    def test_t_a08_decide_error_codes_latch_and_32051_benign(self) -> None:\n3136:    def test_t_a09_decide_and_cancel_bounds(self) -> None:\n3152:    def test_t_a09b_ignored_cancel_killed_within_grace(self) -> None:\n3173:    def test_t_a09c_blocked_stdin_grace_from_latch(self) -> None:\n3194:    def test_t_a10_canaries_redacted_in_audit_log(self) -> None:\n3232:    def test_t_a11_ceiling_32030_single_exec_fallback(self) -> None:\n3247:    def test_t_a11b_deny_unmatched_never_exec(self) -> None:\n3287:    def test_t_a13_terminal_latch_discards_late_success(self) -> None:\n3319:    def test_t_a14_env_mode_gates_session_and_approve(self) -> None:\n3338:    def test_t_a15_tool_item_journal_without_args(self) -> None:\n3366:    def test_t_a16_setup_approval_blocks_any_new_process(self) -> None:\n3402:    def test_startup_constants_validation(self) -> None:\n3410:class TransientRetryTest(_BridgeScenario):\n3419:    def test_t_r01_pre_turn_markers_retry_new_serve(self) -> None:\n3451:    def test_t_r02_three_transient_failures_terminal(self) -> None:\n3460:    def test_t_r03_no_retry_guards(self) -> None:\n3528:    def test_t_r03b_unconfirmed_death_quarantine_then_release(self) -> None:\n3556:    def test_t_r05_retry_gets_only_remaining_budget(self) -> None:\n3579:    def test_t_r06_admission_predicate_matrix(self) -> None:\n3598:    def test_t_r07_action_possible_single_effect(self) -> None:\n3624:    def test_t_r07b_observed_items_scope(self) -> None:\n3656:    def test_t_r03c_client_gone_during_retry_pause(self) -> None:\n3677:    def test_t_r08_deadline_from_receipt_queue(self) -> None:\n3702:    def test_t_r09_parallel_series_max_two_processes(self) -> None:\n3725:    def test_t_r10_model_hangs_to_e_outcome_by_d(self) -> None:\n3740:    def test_t_r11_setup_approval_no_replay_either_scope(self) -> None:\n3760:    def test_t_r12_slow_steady_delivery_cut_at_w(self) -> None:\n3795:class LiveReasoningTest(_BridgeScenario):\n3798:    def test_t_l01_live_deltas_concat_equals_buffered(self) -> None:\n3813:    def test_t_l02_completed_only_summaries_not_lost(self) -> None:\n3826:    def test_t_l03_keepalive_data_chunks_preserved(self) -> None:\n3835:    def test_t_l04_live_write_failure_is_terminal_not_exception(self) -> None:\n3849:    def test_t_l05_model_retry_scheduled_log_only(self) -> None:\n3869:    def test_t_l06_out_of_order_summaries_prefix_monotone(self) -> None:\n3885:    def test_t_l07_diverged_snapshot_sends_authoritative_full(self) -> None:\n3925:    def test_t_l08a_live_write_bounded_by_single_budget(self) -> None:\n3941:    def test_t_l08b_keepalive_blocking_first_bounds_sink(self) -> None:\n3970:    def test_t_l08c_terminal_delivery_and_stop_bounded(self) -> None:\n3986:    def test_t_l09_slow_steady_frames_stop_at_w(self) -> None:\n\"\"\"Regression-тесты утечки слотов muse-bridge: killpg группы и обрыв клиента.\n\n2026-10-09: close() Run/ServeRun бил только прямого ребёнка (proc.kill),\nsleep-«внук» в группе хода выживал; обрыв клиента во время exec/serve ход не\nпрерывал — слот держался всю длительность прогона (до TIMEOUT_S), /health\nпоказывал active=1. Тесты гоняют зеркальную копию моста\nbridges/muse-bridge/server.py без живого muse-bin: вместо CLI — фейк-обёртка\nна sh (serve сразу rc=42 → безусловный fallback на exec, exec держит ход:\nлидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\nкоторый проходит handshake и держит turn/start без завершения.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport http.client\nimport io\nimport itertools\nimport json\nimport os\nimport re\nimport shutil\nimport signal\nimport socket\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any, Callable\nfrom unittest import mock\n\n_REPO_BRIDGE_PY = (\n    Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n)\nBRIDGE_PY = (\n    _REPO_BRIDGE_PY\n    if _REPO_BRIDGE_PY.exists()\n    else Path(__file__).resolve().parents[1] / \"server.py\"\n)\n\n_LOAD_SEQ = itertools.count()\nDISCONNECT_AFTER_S = 1.0\nSCENARIO_DEADLINE_S = 5.0\nGROUP_EXIT_WAIT_S = 5.0\n\n# Фейк muse-cli.sh: транспорт serve «недоступен» (мост уходит в fallback exec),\n# exec пишет pid лидера группы и держит ход 30 с.\nFAKE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exit 42\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n    sleep 30 &\n    wait\n    ;;\nesac\nexit 0\n\"\"\"\n\n# Фейк muse-cli.sh для serve-хода: serve принимает turn/start и держит ход (без\n# turn/completed), exec-fallback отмечается отдельным pid-файлом — его появление\n# означает, что сценарий serve не удался.\nSERVE_WRAPPER = \"\"\"#!/bin/sh\ncase \"$1\" in\n  serve)\n    exec \"{python}\" \"{script}\" \"{servepid}\"\n    ;;\n  exec)\n    echo $$ > \"{pidfile}\"\n\n\nclass _BridgeScenario(unittest.TestCase):\n    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n\n    # Значения инициализируются в setUp() каждого теста.\n    tmp: Path = Path()\n    mod: Any = None\n    pidfile: Path = Path()\n    servepid: Path = Path()\n    server: Any = None\n\n    def wrapper_text(self) -> str:\n        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n\n    def setUp(self) -> None:\n        self.tmp = Path(tempfile.mkdtemp(prefix=\"muse-bridge-killpg-\"))\n        self.addCleanup(shutil.rmtree, str(self.tmp), True)\n        self.mod = load_bridge()\n        # Работаем только во временном каталоге: workspace и лог моста — не в репо.\n        self.mod.WORKSPACE = self.tmp / \"workspace\"\n        self.mod.LOG_PATH = self.tmp / \"bridge.log\"\n        # Один слот: при двух утечка одного не видна неблокирующей пробой семафора.\n        self.mod._slots = threading.Semaphore(1)\n        self.pidfile = self.tmp / \"run.pid\"\n        self.servepid = self.tmp / \"serve.pid\"\n        wrapper = self.tmp / \"muse-cli.sh\"\n        wrapper.write_text(self.wrapper_text(), encoding=\"utf-8\")\n        wrapper.chmod(0o755)\n        self.mod.MUSE_WRAPPER = str(wrapper)\n        self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n        threading.Thread(target=self.server.serve_forever, daemon=True).start()\n        self.addCleanup(self._teardown_scenario)\n\n    def _teardown_scenario(self) -> None:\n        \"\"\"Стоп сервера + добивание своих мок-групп (только свои PGID).\"\"\"\n        self.server.shutdown()\n        self.server.server_close()\n        for pidfile in (self.pidfile, self.servepid):\n            if pidfile.exists():\n                try:\n                    os.killpg(\n                        int(pidfile.read_text(encoding=\"utf-8\").strip()),\n                        signal.SIGKILL,\n                    )\n                except (ProcessLookupError, OSError, ValueError):\n                    pass\n\n    def _open_request(self) -> socket.socket:\n        \"\"\"POST /v1/chat/completions; соединение остаётся открытым (закрывает вызывающий).\"\"\"\n        body = json.dumps(\n            {\n                \"model\": \"muse-spark-1.3\",\n                \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}],\n            }\n        ).encode(\"utf-8\")\n        head = (\n            \"POST /v1/chat/completions HTTP/1.1\\r\\n\"\n            \"Host: 127.0.0.1\\r\\n\"\n            \"Content-Type: application/json\\r\\n\"\n            f\"Content-Length: {len(body)}\\r\\n\"\n            \"Connection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        sock = socket.create_connection(self.server.server_address[:2], timeout=5)\n        sock.sendall(head + body)\n        return sock\n\n    def _post_request_disconnect(self) -> None:\n        \"\"\"POST /v1/chat/completions и обрыв соединения через DISCONNECT_AFTER_S.\"\"\"\n        sock = self._open_request()\n        try:\n            time.sleep(DISCONNECT_AFTER_S)\n        finally:\n            sock.close()\n\n    def _slot_free(self) -> bool:\n        \"\"\"Неблокирующая проба семафора слотов (сразу возвращаем взятую ячейку).\"\"\"\n        sem = self.mod._slots\n        if sem.acquire(blocking=False):\n            sem.release()\n            return True\n        return False\n\n    def _health_json(self) -> dict[str, Any]:\n        \"\"\"Тело ответа GET /health.\"\"\"\n        head = (\n            \"GET /health HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: close\\r\\n\\r\\n\"\n        ).encode(\"utf-8\")\n        with socket.create_connection(\n            self.server.server_address[:2], timeout=5\n        ) as sock:\n            sock.sendall(head)\n            chunks = []\n            while True:\n                chunk = sock.recv(65536)\n                if not chunk:\n                    break\n                chunks.append(chunk)\n        body = b\"\".join(chunks).split(b\"\\r\\n\\r\\n\", 1)[1]\n        return json.loads(body.decode(\"utf-8\"))\n\n\nclass HealthQuarantinedTest(_BridgeScenario):\n    \"\"\"FU-004: /health показывает число слотов, изъятых в карантин.\"\"\"\n\n            }\n\n        with mock.patch.object(self.mod.ServeRun, \"execute\", fake_serve):\n            status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        self.assertEqual(len(deadlines), 2)\n        self.assertAlmostEqual(deadlines[0], deadlines[1], places=6)\n        self.assertLess(deadlines[1], started + self.mod.TIMEOUT_S - 30)\n\n    def test_t_r06_admission_predicate_matrix(self) -> None:\n        cases: list[tuple[str, dict, int]] = [\n            (\"turn_start_no_ack\", {\"turn_start_eof\": True}, 502),\n            (\"summary_eof\", {\"steps\": [{\"summary\": [0, \"x\"]}, {\"eof\": True}]}, 502),\n            (\"approval_exit\", {\"steps\": [{\"approval_then_exit\": {}}]}, 502),\n            (\"cancel_eof\", {\"steps\": [{\"approval\": {\"availableChoices\": []}}]}, 502),\n        ]\n        for name, plan, want in cases:\n            with self.subTest(case=name):\n                install_fake_msp(self, serve_plans=[plan])\n                status, _ = bridge_request(self, turn_request())\n                self.assertEqual(status, want)\n                self.assertEqual(proc_count(self, \"exec\"), 0)\n        with self.subTest(case=\"handshake_eof_allows_exec\"):\n            install_fake_msp(self, serve_plans=[{\"handshake_eof\": True}])\n            status, body = bridge_request(self, turn_request())\n            self.assertEqual(status, 200, body)\n            self.assertEqual(proc_count(self, \"exec\"), 1)\n\n    def test_t_r07_action_possible_single_effect(self) -> None:\n        with self.subTest(path=\"serve\"):\n            install_fake_msp(\n                self,\n                serve_plans=[\n                    {\"steps\": [{\"effect\": \"fx\"}, fail_terminal(\"[net-timeout] mid\")]},\n                    ok_plan(),\n                ],\n            )\n            status, _ = bridge_request(self, turn_request())\n            self.assertEqual(status, 502)\n            self.assertEqual(proc_count(self, \"serve\"), 1)\n            self.assertEqual(effect_lines(self), [\"fx\"])\n        with self.subTest(path=\"exec\"):\n            install_fake_msp(\n                self,\n                serve_plans=[{\"handshake_eof\": True}],\n                exec_plans=[\n                    {\"rc\": 1, \"stderr\": \"[net-timeout] exec\", \"effect\": \"exec-fx\"}\n                ],\n            )\n            status, _ = bridge_request(self, turn_request())\n            self.assertEqual(status, 502)\n            self.assertEqual(proc_count(self, \"exec\"), 1)\n            self.assertEqual(effect_lines(self), [\"exec-fx\"])\n\n    def test_t_r07b_observed_items_scope(self) -> None:\n        self.mod.TRANSIENT_RETRY_SCOPE = \"observed-items\"\n        with self.subTest(case=\"no_signals_retries\"):\n            install_fake_msp(\n                self,\n                serve_plans=[\n                    {\"steps\": [{\"effect\": \"fx\"}, fail_terminal(\"[net-timeout] mid\")]},\n                    ok_plan(),\n                ],\n            )\n            status, body = bridge_request(self, turn_request())\n            self.assertEqual(status, 200, body)\n            self.assertEqual(proc_count(self, \"serve\"), 2)\n            self.assertIn(\"retry_scope\", self.mod.LOG_PATH.read_text(encoding=\"utf-8\"))\n        with self.subTest(case=\"tool_item_blocks\"):\n            install_fake_msp(\n                self,\n                serve_plans=[\n                    {\"steps\": [{\"tool_item\": {}}, fail_terminal(\"[net-timeout] mid\")]},\n                    ok_plan(),\n                ],\n            )\n            status, _ = bridge_request(self, turn_request())\n            self.assertEqual(status, 502)\n            self.assertEqual(proc_count(self, \"serve\"), 1)\n        with self.subTest(case=\"invalid_scope_stops_start\"):\n            with mock.patch.dict(\n                os.environ, {\"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE\": \"bogus\"}\n            ):\n                with self.assertRaises(Exception):\n                    load_bridge()\n\n    def test_t_r03c_client_gone_during_retry_pause(self) -> None:\n        self.mod.TRANSIENT_BACKOFF_S = (1.0, 1.0)\n        install_fake_msp(\n            self,\n            serve_plans=[\n                {\"session_error\": {\"code\": -32603, \"message\": \"[net-timeout]\"}},\n                ok_plan(),\n            ],\n        )\n        sock = self._open_request()\n        self.addCleanup(sock.close)\n        self.assertTrue(\n            wait_until(lambda: proc_count(self, \"serve\") == 1, 3.0),\n            \"первый serve не стартовал\",\n        )\n        time.sleep(0.3)\n        sock.close()\n        self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n        time.sleep(0.3)\n        self.assertEqual(proc_count(self, \"serve\"), 1)\n\n    def test_t_r08_deadline_from_receipt_queue(self) -> None:\n        self.mod._slots = threading.Semaphore(2)\n        self.mod.TIMEOUT_S = 2.0\n        self.mod.FINISH_RESERVE_S = 0.3\n        self.mod.CLOSE_RESERVE_S = 0.2\n        self.mod.MIN_ATTEMPT_REMAINING_S = 0.8\n        install_fake_msp(self, serve_plans=[ok_plan({\"delay\": 1.2})])\n        results: list[tuple[int, bytes]] = []\n\n        def call() -> None:\n            results.append(bridge_request(self, turn_request()))\n\n        threads = [threading.Thread(target=call) for _ in range(3)]\n        started = time.monotonic()\n        for t in threads:\n            t.start()\n        for t in threads:\n            t.join(timeout=8)\n        elapsed = time.monotonic() - started\n        self.assertEqual(len(results), 3)\n        self.assertLess(elapsed, 3.5)\n        self.assertEqual(proc_count(self, \"serve\"), 2)\n        statuses = sorted(s for s, _ in results)\n        self.assertEqual(statuses, [200, 200, 503])\n\n    def test_t_r09_parallel_series_max_two_processes(self) -> None:\n        self.mod._slots = threading.Semaphore(2)\n        plan = {\n            \"setup_delay\": 0.25,\n            \"session_error\": {\"code\": -32603, \"message\": \"[net-timeout]\"},\n        }\n        install_fake_msp(self, serve_plans=[plan], track_concurrency=True)\n        results: list[tuple[int, bytes]] = []\n        threads = [\n            threading.Thread(\n                target=lambda: results.append(bridge_request(self, turn_request()))\n            )\n            for _ in range(2)\n        ]\n        for t in threads:\n            t.start()\n        for t in threads:\n            t.join(timeout=8)\n        self.assertEqual(sorted(s for s, _ in results), [502, 502])\n        counts = [int(x) for x in (self.tmp / \"concurrency.log\").read_text().split()]\n        self.assertTrue(counts)\n        self.assertLessEqual(max(counts), 2)\n\n    def test_t_r10_model_hangs_to_e_outcome_by_d(self) -> None:\n        self.mod.TIMEOUT_S = 2.6\n        self.mod.FINISH_RESERVE_S = 0.7\n        self.mod.CLOSE_RESERVE_S = 0.3\n        self.mod.MIN_ATTEMPT_REMAINING_S = 0.2\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n        install_fake_msp(self, serve_plans=[{\"steps\": [{\"hang\": True}]}])\n        started = time.monotonic()\n        status, _ = bridge_request(self, turn_request())\n        elapsed = time.monotonic() - started\n        self.assertEqual(status, 502)\n        self.assertLess(elapsed, 2.6 + 1.5)\n        self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n        self.assertEqual(proc_count(self, \"exec\"), 0)\n\n    def test_t_r11_setup_approval_no_replay_either_scope(self) -> None:\n        for scope in (\"pre-action\", \"observed-items\"):\n            with self.subTest(scope=scope):\n                self.mod.TRANSIENT_RETRY_SCOPE = scope\n                plan = {\n                    \"setup_approval\": {\n                        \"when\": \"session/start\",\n                        \"mode\": \"requested\",\n                        \"effect\": \"setup-fx\",\n                        \"after\": \"break\",\n                    },\n                    \"steps\": [_OK_STEP],\n                }\n                install_fake_msp(self, serve_plans=[plan, ok_plan()])\n                status, _ = bridge_request(self, turn_request())\n                self.assertEqual(status, 502)\n                self.assertEqual(proc_count(self, \"serve\"), 1)\n                self.assertEqual(proc_count(self, \"exec\"), 0)\n                self.assertEqual(effect_lines(self), [\"setup-fx\"])\n\n    def test_t_r12_slow_steady_delivery_cut_at_w(self) -> None:\n        # Детерминированный транспорт: каждый кадр быстрее L, сумма — дольше W.\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n        self.mod.SSE_CHUNK_SIZE = 10\n        self.mod.SSE_CHUNK_DELAY_S = 0.0\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        starts: list[float] = []\n\n        class SlowWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                starts.append(time.monotonic())\n                time.sleep(0.05)\n                return super().write(data)\n\n        writer = SlowWriter()\n        handler._wlock = threading.Lock()\n        handler.wfile = writer\n        handler._sse_open = True\n        handler._live_sent_text = \"\"\n        w = time.monotonic() + 0.32\n        handler._write_deadline = w\n        handler._send_sse(\"muse-spark-1.3\", \"x\" * 200, [], 1, 1, 0)\n        self.assertNotIn(b\"data: [DONE]\", writer.getvalue())\n        self.assertTrue(all(s <= w + 0.06 for s in starts), starts)\n        # Контроль: малый N успевает до W целиком с одним [DONE].\n        writer2 = SlowWriter()\n        handler.wfile = writer2\n        handler._sse_phase = \"OPEN\"\n        handler._client_gone = False\n        handler._write_deadline = time.monotonic() + 5\n        handler._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0)\n        self.assertEqual(writer2.getvalue().count(b\"data: [DONE]\"), 1)\n        self.assertIn(b\"hi\", writer2.getvalue())\n\n\nclass LiveReasoningTest(_BridgeScenario):\n    \"\"\"REQ-MUSE-004 / AD-004 (T-L01..T-L09).\"\"\"\n\n    def test_t_l01_live_deltas_concat_equals_buffered(self) -> None:\n        plan = ok_plan(\n            {\"summary\": [0, \"think-\"]},\n            {\"summary\": [0, \"more\"]},\n            {\"summary\": [1, \"second\"]},\n        )\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        deltas = sse_deltas(body, \"reasoning_content\")\n        self.assertGreaterEqual(len(deltas), 3)\n        self.assertEqual(\"\".join(deltas), \"think-more\\n\\nsecond\")\n        self.assertEqual(\"\".join(sse_deltas(body, \"content\")), \"hello\")\n        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n\n    def test_t_l02_completed_only_summaries_not_lost(self) -> None:\n        plan = ok_plan({\"reasoning_completed\": [\"alpha\", \"beta\"]})\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        self.assertEqual(\n            \"\".join(sse_deltas(body, \"reasoning_content\")), \"alpha\\n\\nbeta\"\n        )\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        self.assertEqual(json.loads(body)[\"reasoning_summaries\"], [\"alpha\", \"beta\"])\n\n    def test_t_l03_keepalive_data_chunks_preserved(self) -> None:\n        self.mod.KEEPALIVE_S = 0.05\n        install_fake_msp(self, serve_plans=[ok_plan({\"delay\": 0.25})])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        self.assertNotIn(b\": keepalive\", body)\n        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n        self.assertTrue(any(d == \"\" for d in sse_deltas(body, \"content\")[:-1]))\n\n    def test_t_l04_live_write_failure_is_terminal_not_exception(self) -> None:\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n\n        class BrokenWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                raise OSError(\"closed peer\")\n\n        handler._wlock = threading.Lock()\n        handler.wfile = BrokenWriter()\n        handler._sse_open = True\n        handler._live_sent_text = \"\"\n        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n        self.assertTrue(handler._client_gone)\n\n    def test_t_l05_model_retry_scheduled_log_only(self) -> None:\n        plan = ok_plan(\n            {\n                \"model_retry\": {\n                    \"attempt\": 1,\n                    \"maxAttempts\": 4,\n                    \"retryDelayMs\": 500,\n                    \"errorKind\": \"network\",\n                    \"turnId\": \"turn-1\",\n                }\n            }\n        )\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        self.assertEqual(sse_deltas(body, \"reasoning_content\"), [])\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"modelRetryScheduled\", logs)\n        self.assertIn(\"attempt=1\", logs)\n\n    def test_t_l06_out_of_order_summaries_prefix_monotone(self) -> None:\n        plan = ok_plan(\n            {\"summary\": [0, \"a\"]},\n            {\"summary\": [1, \"b\"]},\n            {\"summary\": [0, \"c\"]},\n        )\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"ac\\n\\nb\")\n        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n        install_fake_msp(self, serve_plans=[plan])\n        status, body = bridge_request(self, turn_request(stream=True))\n        self.assertEqual(status, 200, body)\n        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\")\n\n    def test_t_l07_diverged_snapshot_sends_authoritative_full(self) -> None:\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler._wlock = threading.Lock()\n        handler.wfile = io.BytesIO()\n        handler._sse_open = True\n        handler._live_sent_text = \"a\"\n        handler._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0, [\"b\", \"c\"])\n        deltas = sse_deltas(handler.wfile.getvalue(), \"reasoning_content\")\n        self.assertEqual(deltas, [\"\\n\\nb\\n\\nc\"])\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"reasoning_diverged\", logs)\n        handler2 = self.mod.Handler.__new__(self.mod.Handler)\n        handler2._wlock = threading.Lock()\n        handler2.wfile = io.BytesIO()\n        handler2._sse_open = True\n        handler2._live_sent_text = \"a\"\n        handler2._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0, [\"ab\"])\n        self.assertEqual(\n            sse_deltas(handler2.wfile.getvalue(), \"reasoning_content\"), [\"b\"]\n        )\n\n    def _timing_handler(self) -> Any:\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        handler._wlock = threading.Lock()\n        handler._sse_open = True\n        handler._live_sent_text = \"\"\n        handler._write_deadline = time.monotonic() + 30\n        conn = SimpleNamespace(_timeout=None)\n\n        def gettimeout() -> Any:\n            return conn._timeout\n\n        def settimeout(value: Any) -> None:\n            conn._timeout = value\n\n        conn.gettimeout = gettimeout  # type: ignore[attr-defined]\n        conn.settimeout = settimeout  # type: ignore[attr-defined]\n        handler.connection = conn\n        return handler\n\n    def test_t_l08a_live_write_bounded_by_single_budget(self) -> None:\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n        handler = self._timing_handler()\n\n        class TimeoutWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                limit = handler.connection.gettimeout() or 5.0\n                time.sleep(min(float(limit), 5.0))\n                raise TimeoutError(\"socket timeout\")\n\n        handler.wfile = TimeoutWriter()\n        started = time.monotonic()\n        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n        self.assertLess(time.monotonic() - started, 1.0)\n        self.assertTrue(handler._client_gone)\n\n    def test_t_l08b_keepalive_blocking_first_bounds_sink(self) -> None:\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.25\n        handler = self._timing_handler()\n        release = threading.Event()\n        self.addCleanup(release.set)\n\n        class BlockWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                limit = handler.connection.gettimeout() or 5.0\n                if not release.wait(timeout=float(limit)):\n                    raise TimeoutError(\"socket timeout\")\n                return super().write(data)\n\n        handler.wfile = BlockWriter()\n        results: dict[str, Any] = {}\n        ka = threading.Thread(\n            target=lambda: results.__setitem__(\n                \"ka\", handler._sse_write(\"data: ka\\n\\n\", keepalive=True)\n            ),\n            daemon=True,\n        )\n        ka.start()\n        time.sleep(0.05)\n        started = time.monotonic()\n        self.assertFalse(handler._live_reasoning_sink(\"summary\"))\n        self.assertLess(time.monotonic() - started, 1.0)\n        ka.join(timeout=2)\n        self.assertFalse(ka.is_alive())\n\n    def test_t_l08c_terminal_delivery_and_stop_bounded(self) -> None:\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n        handler = self._timing_handler()\n\n        class TimeoutWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                limit = handler.connection.gettimeout() or 5.0\n                time.sleep(min(float(limit), 5.0))\n                raise TimeoutError(\"socket timeout\")\n\n        handler.wfile = TimeoutWriter()\n        started = time.monotonic()\n        handler._send_sse(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0)\n        self.assertLess(time.monotonic() - started, 1.5)\n        self.assertTrue(handler._client_gone)\n\n    def test_t_l09_slow_steady_frames_stop_at_w(self) -> None:\n        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n        self.mod.SSE_CHUNK_SIZE = 10\n        self.mod.SSE_CHUNK_DELAY_S = 0.0\n        handler = self.mod.Handler.__new__(self.mod.Handler)\n        starts: list[float] = []\n\n        class SlowWriter(io.BytesIO):\n            def write(self, data):  # type: ignore[override]\n                starts.append(time.monotonic())\n                time.sleep(0.05)\n                return super().write(data)\n\n        writer = SlowWriter()\n        handler._wlock = threading.Lock()\n        handler.wfile = writer\n        handler._sse_open = True\n        handler._live_sent_text = \"\"\n        w = time.monotonic() + 0.32\n        handler._write_deadline = w\n        handler._send_sse(\"muse-spark-1.3\", \"y\" * 200, [], 1, 1, 0)\n        self.assertNotIn(b\"data: [DONE]\", writer.getvalue())\n        self.assertTrue(all(s <= w + 0.06 for s in starts), starts)\n        self.assertNotIn(b'\"finish_reason\": \"stop\"', writer.getvalue())\n\n\nif __name__ == \"__main__\":\n    unittest.main(verbosity=2)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1030,1340p' tests/test_muse_bridge_killpg.py; sed -n '2941,2985p' tests/test_muse_bridge_killpg.py; sed -n '3130,3195p' tests/test_muse_bridge_killpg.py; sed -n '3360,3412p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1030,1340p' tests/test_muse_bridge_killpg.py; sed -n '2941,2985p' tests/test_muse_bridge_killpg.py; sed -n '3130,3195p' tests/test_muse_bridge_killpg.py; sed -n '3360,3412p' tests/test_muse_bridge_killpg.py\"","aggregated_output":"    )\n    wrapper.chmod(0o755)\n    scenario.mod.MUSE_WRAPPER = str(wrapper)\n\n\n_FAKE_MSP_HEAD = \"\"\"import json, os, sys, time\nfrom pathlib import Path\ncfg = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))\nroot = Path(cfg[\"root\"]); mode = sys.argv[2]\n(root / (mode + \"-argv.json\")).write_text(json.dumps(sys.argv[2:]), encoding=\"utf-8\")\nwith (root / (mode + \"-argv.jsonl\")).open(\"a\", encoding=\"utf-8\") as fh:\n    fh.write(json.dumps(sys.argv[2:]) + \"\\\\n\")\ndef bump(name):\n    p = root / name\n    n = int(p.read_text(encoding=\"utf-8\")) if p.exists() else 0\n    n += 1; p.write_text(str(n), encoding=\"utf-8\"); return n\ndef effect(name):\n    with (root / \"effects.log\").open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(str(name) + \"\\\\n\")\nidx = bump(mode + \"-count.txt\")\nif mode == \"exec\":\n    plans = cfg.get(\"exec_plans\") or [{\"text\": \"fallback-ok\"}]\n    plan = plans[min(idx - 1, len(plans) - 1)]\n    if plan.get(\"effect\"): effect(plan[\"effect\"])\n    if plan.get(\"delay\"): time.sleep(float(plan[\"delay\"]))\n    if plan.get(\"stderr\"): print(plan[\"stderr\"], file=sys.stderr, flush=True)\n    rc = int(plan.get(\"rc\", 0))\n    if rc == 0:\n        print(json.dumps({\"schema_version\": 1, \"payload_type\": \"run.terminal.completed\", \"payload\": {\"text\": plan.get(\"text\", \"fallback-ok\")}}), flush=True)\n    sys.exit(rc)\nplans = cfg.get(\"serve_plans\") or [{}]\nplan = plans[min(idx - 1, len(plans) - 1)]\nwith (root / \"serve-pids.log\").open(\"a\", encoding=\"utf-8\") as fh:\n    fh.write(str(os.getpid()) + \"\\\\n\")\nactive_file = None\nif cfg.get(\"track_concurrency\"):\n    active_file = root / (\"active-%d\" % os.getpid()); active_file.write_text(\"1\")\n    with (root / \"concurrency.log\").open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(str(len(list(root.glob(\"active-*\")))) + \"\\\\n\")\nif plan.get(\"handshake_eof\"):\n    sys.exit(0)\nif plan.get(\"handshake_hang\"):\n    time.sleep(30); sys.exit(0)\ndef send(obj):\n    sys.stdout.write(json.dumps(obj) + \"\\\\n\"); sys.stdout.flush()\ndef read_msg():\n    line = sys.stdin.readline()\n    if not line: raise EOFError\n    msg = json.loads(line)\n    with (root / \"rpc.jsonl\").open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(json.dumps(msg) + \"\\\\n\")\n    return msg\n_decide_i = [0]\ndef decide_reply(rid):\n    reps = plan.get(\"decide_replies\") or [{\"result\": {\"terminal\": True}}]\n    rep = reps[min(_decide_i[0], len(reps) - 1)]; _decide_i[0] += 1\n    if \"error\" in rep: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"error\": rep[\"error\"]})\n    else: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": rep.get(\"result\", {})})\ndef cancel_reply(rid):\n    rep = plan.get(\"cancel_reply\") or {}\n    if \"error\" in rep: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"error\": rep[\"error\"]})\n    else: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": rep.get(\"result\", {})})\ndef await_command():\n    while True:\n        msg = read_msg(); m = msg.get(\"method\")\n        if m == \"approval/decide\": decide_reply(msg[\"id\"]); return msg\n        if m in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"]); return msg\ndef appr_payload(over=None, n=0):\n    aid = \"appr-%d\" % n\n    base = {\"approvalId\": aid, \"availableChoices\": [\n        {\"choiceId\": \"c-approve\", \"decision\": \"approved\", \"label\": \"Allow\", \"scope\": \"once\"},\n        {\"choiceId\": \"c-abort\", \"decision\": \"abort\", \"label\": \"Abort\", \"scope\": \"once\"}],\n        \"currentRequirementId\": {\"approvalId\": aid, \"sourceIndex\": n}, \"itemId\": \"item-1\",\n        \"judgeEscalated\": False, \"protectedWrite\": False, \"rawArgs\": \"{}\", \"sessionId\": \"sess-1\",\n        \"sourceRange\": {}, \"subject\": {\"kind\": \"tool\", \"toolName\": \"web_search\"}, \"taskId\": \"task-1\",\n        \"toolCallId\": \"tc-1\", \"toolName\": \"web_search\", \"turnId\": \"turn-1\", \"viewCursor\": \"0\"}\n    if over: base.update(over)\n    return base\ndef do_approval(over=None, req_mode=\"request\", n=0):\n    payload = appr_payload(over, n)\n    if req_mode == \"requested\":\n        send({\"jsonrpc\": \"2.0\", \"method\": \"approval/requested\", \"params\": payload})\n    else:\n        send({\"jsonrpc\": \"2.0\", \"id\": 9000 + n, \"method\": \"approval/request\", \"params\": payload})\n    return await_command()\ndef ui_payload(over=None, n=0):\n    base = {\"userInputId\": \"ui-%d\" % n, \"sessionId\": \"sess-1\", \"toolName\": \"ask_user\",\n            \"itemId\": \"item-1\", \"toolCallId\": \"tc-1\", \"turnId\": \"turn-1\", \"viewCursor\": \"0\",\n            \"sourceRange\": {}, \"questions\": [{\"questionId\": \"q1\", \"text\": \"question\"}]}\n    if over: base.update(over)\n    return base\ndef do_user_input(over=None, n=0):\n    send({\"jsonrpc\": \"2.0\", \"id\": 9100 + n, \"method\": \"userInput/request\", \"params\": ui_payload(over, n)})\n    return await_command()\n\"\"\"\n\n_FAKE_MSP_TAIL = \"\"\"_started = set()\ndef ensure_item(kind):\n    iid = \"r1\" if kind == \"reasoning\" else \"a1\" if kind == \"agentMessage\" else \"t1\"\n    if iid not in _started:\n        _started.add(iid)\n        send({\"jsonrpc\": \"2.0\", \"method\": \"item/started\", \"params\": {\"item\": {\"itemId\": iid, \"turnId\": \"turn-1\", \"kind\": kind}}})\n    return iid\ndef run_steps():\n    for step in plan.get(\"steps\") or []:\n        if \"delay\" in step: time.sleep(float(step[\"delay\"]))\n        elif \"effect\" in step: effect(step[\"effect\"])\n        elif \"approval\" in step: do_approval(step[\"approval\"] if isinstance(step[\"approval\"], dict) else None, step.get(\"mode\", \"request\"), int(step.get(\"n\", 0)))\n        elif \"approval_repeat\" in step:\n            for i in range(int(step[\"approval_repeat\"])): do_approval(None, \"request\", i)\n        elif \"approval_nowait\" in step:\n            over = step[\"approval_nowait\"] if isinstance(step[\"approval_nowait\"], dict) else None\n            n = int(step.get(\"n\", 7))\n            send({\"jsonrpc\": \"2.0\", \"id\": 9200 + n, \"method\": \"approval/request\", \"params\": appr_payload(over, n)})\n        elif \"approval_then_exit\" in step:\n            over = step[\"approval_then_exit\"] if isinstance(step[\"approval_then_exit\"], dict) else None\n            send({\"jsonrpc\": \"2.0\", \"id\": 9300, \"method\": \"approval/request\", \"params\": appr_payload(over, 0)})\n            sys.stdout.flush(); os._exit(0)\n        elif \"user_input\" in step: do_user_input(step[\"user_input\"] if isinstance(step[\"user_input\"], dict) else None, int(step.get(\"n\", 0)))\n        elif \"user_input_repeat\" in step:\n            for i in range(int(step[\"user_input_repeat\"])): do_user_input(None, i)\n        elif \"summary\" in step:\n            ensure_item(\"reasoning\")\n            sidx, text = step[\"summary\"]\n            send({\"jsonrpc\": \"2.0\", \"method\": \"item/delta\", \"params\": {\"itemId\": \"r1\", \"field\": \"summary.%s\" % sidx, \"delta\": text}})\n        elif \"reasoning_completed\" in step:\n            ensure_item(\"reasoning\")\n            send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"r1\", \"turnId\": \"turn-1\", \"kind\": \"reasoning\", \"summary\": list(step[\"reasoning_completed\"])}}})\n        elif \"tool_item\" in step:\n            ti = step[\"tool_item\"] if isinstance(step[\"tool_item\"], dict) else {}\n            item = {\"itemId\": \"t1\", \"turnId\": \"turn-1\", \"kind\": ti.get(\"kind\", \"toolCall\"), \"toolName\": ti.get(\"toolName\", \"web_search\"), \"rawArgs\": ti.get(\"rawArgs\", \"{}\")}\n            send({\"jsonrpc\": \"2.0\", \"method\": \"item/started\", \"params\": {\"item\": item}})\n            send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": item}})\n        elif \"model_retry\" in step:\n            send({\"jsonrpc\": \"2.0\", \"method\": \"turn/modelRetryScheduled\", \"params\": dict(step[\"model_retry\"])})\n        elif \"text_delta\" in step:\n            ensure_item(\"agentMessage\")\n            send({\"jsonrpc\": \"2.0\", \"method\": \"item/delta\", \"params\": {\"itemId\": \"a1\", \"field\": \"text\", \"delta\": step[\"text_delta\"]}})\n        elif \"eof\" in step:\n            sys.stdout.flush(); os._exit(0)\n        elif \"hang\" in step:\n            while True:\n                msg = read_msg(); m = msg.get(\"method\")\n                if m == \"approval/decide\": decide_reply(msg[\"id\"])\n                elif m in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"])\n        elif \"no_read_hang\" in step:\n            while True: time.sleep(1)\n        elif \"terminal\" in step:\n            t = step[\"terminal\"] if isinstance(step[\"terminal\"], dict) else {}\n            if t.get(\"text\"):\n                ensure_item(\"agentMessage\")\n                send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a1\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": t[\"text\"]}}})\n            params = {\"turnId\": \"turn-1\", \"sessionId\": \"sess-1\", \"terminal\": t.get(\"terminal\", \"completed\")}\n            for key in (\"error\", \"reason\", \"timeToFirstTokenMs\", \"usage\", \"durationMs\"):\n                if key in t: params[key] = t[key]\n            send({\"jsonrpc\": \"2.0\", \"method\": \"turn/completed\", \"params\": params})\n            return\ndef maybe_setup(when):\n    sa = plan.get(\"setup_approval\")\n    if not sa or sa.get(\"when\") != when: return False\n    do_approval(sa.get(\"payload\") if isinstance(sa.get(\"payload\"), dict) else None, sa.get(\"mode\", \"request\"), 0)\n    if sa.get(\"effect\"): effect(sa[\"effect\"])\n    return sa.get(\"after\") == \"break\"\ntry:\n    while True:\n        msg = read_msg(); method = msg.get(\"method\")\n        if method == \"initialize\":\n            if maybe_setup(\"initialize\"):\n                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": {\"code\": -32603, \"message\": plan.get(\"setup_approval\", {}).get(\"break_message\", \"[net-timeout] setup break\")}}); break\n            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"serverInfo\": {\"version\": \"1.4.9-test\"}, \"schema\": {\"fingerprint\": \"fp-test-1234567890abcdef\"}}})\n        elif method == \"session/start\":\n            if maybe_setup(\"session/start\"):\n                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": {\"code\": -32603, \"message\": plan.get(\"setup_approval\", {}).get(\"break_message\", \"[net-timeout] setup break\")}}); break\n            if plan.get(\"setup_delay\"): time.sleep(float(plan[\"setup_delay\"]))\n            se = plan.get(\"session_error\")\n            if se:\n                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": se}); break\n            if plan.get(\"no_session_id\"):\n                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"session\": {}}}); continue\n            reqmode = (msg.get(\"params\") or {}).get(\"approvalMode\") or \"allowAll\"\n            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"session\": {\"sessionId\": \"sess-1\", \"approvalMode\": {\"mode\": reqmode, \"source\": \"startup\", \"lastCommandId\": None}}}})\n        elif method == \"turn/start\":\n            if plan.get(\"turn_start_eof\"): os._exit(0)\n            if plan.get(\"turn_delay\"): time.sleep(float(plan[\"turn_delay\"]))\n            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"}})\n            run_steps(); break\n        elif method == \"approval/decide\": decide_reply(msg[\"id\"])\n        elif method in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"])\nexcept EOFError:\n    pass\nfinally:\n    if active_file is not None:\n        try: active_file.unlink()\n        except OSError: pass\n\"\"\"\n\nFAKE_MSP_SCRIPT = _FAKE_MSP_HEAD + _FAKE_MSP_TAIL\n\n_OK_STEP = {\"terminal\": {\"terminal\": \"completed\", \"text\": \"hello\"}}\n\n\ndef ok_plan(*steps: dict) -> dict:\n    \"\"\"План serve, завершающийся успешным hello после шагов.\"\"\"\n    return {\"steps\": [*steps, _OK_STEP]}\n\n\ndef fail_terminal(marker: str, **extra: Any) -> dict:\n    \"\"\"Шаг транзиентного терминального провала serve.\"\"\"\n    term: dict[str, Any] = {\n        \"terminal\": \"failed\",\n        \"error\": {\"kind\": \"network\", \"message\": marker},\n    }\n    term.update(extra)\n    return {\"terminal\": term}\n\n\ndef install_fake_msp(\n    scenario: Any,\n    serve_plans: list[dict] | None = None,\n    exec_plans: list[dict] | None = None,\n    track_concurrency: bool = False,\n) -> None:\n    \"\"\"Расширенный фейковый MSP (a4): планы по вызовам, rpc.jsonl, счётчики.\"\"\"\n    import shlex\n\n    for name in (\n        \"rpc.jsonl\",\n        \"effects.log\",\n        \"serve-count.txt\",\n        \"exec-count.txt\",\n        \"serve-argv.jsonl\",\n        \"exec-argv.jsonl\",\n        \"serve-pids.log\",\n        \"concurrency.log\",\n    ):\n        try:\n            (scenario.tmp / name).unlink()\n        except OSError:\n            pass\n    cfg = {\n        \"root\": str(scenario.tmp),\n        \"serve_plans\": serve_plans or [ok_plan()],\n        \"exec_plans\": exec_plans or [{\"text\": \"fallback-ok\"}],\n        \"track_concurrency\": track_concurrency,\n    }\n    cfg_path = scenario.tmp / \"fake-cfg.json\"\n    cfg_path.write_text(json.dumps(cfg), encoding=\"utf-8\")\n    script = scenario.tmp / \"fake_msp.py\"\n    script.write_text(FAKE_MSP_SCRIPT, encoding=\"utf-8\")\n    wrapper = scenario.tmp / \"muse-cli.sh\"\n    wrapper.write_text(\n        f\"#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} \"\n        f'{shlex.quote(str(cfg_path))} \"$@\"\\n',\n        encoding=\"utf-8\",\n    )\n    wrapper.chmod(0o755)\n    scenario.mod.MUSE_WRAPPER = str(wrapper)\n\n\ndef rpc_msgs(scenario: Any) -> list[dict]:\n    \"\"\"Все входящие RPC фейка (мост -> serve), включая receipt-ответы.\"\"\"\n    path = scenario.tmp / \"rpc.jsonl\"\n    if not path.exists():\n        return []\n    return [\n        json.loads(line)\n        for line in path.read_text(encoding=\"utf-8\").splitlines()\n        if line.strip()\n    ]\n\n\ndef rpc_by_method(scenario: Any, method: str) -> list[dict]:\n    return [m for m in rpc_msgs(scenario) if m.get(\"method\") == method]\n\n\ndef proc_count(scenario: Any, mode: str) -> int:\n    \"\"\"Число запусков serve/exec по argv-журналу фейка.\"\"\"\n    path = scenario.tmp / f\"{mode}-argv.jsonl\"\n    if not path.exists():\n        return 0\n    return len(\n        [ln for ln in path.read_text(encoding=\"utf-8\").splitlines() if ln.strip()]\n    )\n\n\ndef effect_lines(scenario: Any) -> list[str]:\n    path = scenario.tmp / \"effects.log\"\n    if not path.exists():\n        return []\n    return [ln for ln in path.read_text(encoding=\"utf-8\").splitlines() if ln.strip()]\n\n\ndef sse_frames(body: bytes) -> list[dict]:\n    return [\n        json.loads(line[6:])\n        for line in body.decode(\"utf-8\", \"replace\").splitlines()\n        if line.startswith(\"data: {\")\n    ]\n\n\ndef sse_deltas(body: bytes, key: str) -> list[str]:\n    out: list[str] = []\n    for frame in sse_frames(body):\n        for choice in frame.get(\"choices\") or []:\n            delta = choice.get(\"delta\") or {}\n            if isinstance(delta.get(key), str):\n                out.append(delta[key])\n    return out\n\n\nclass ServeTurnErrorExtractionTest(_BridgeScenario):\nclass ApprovalTest(_BridgeScenario):\n    \"\"\"REQ-MUSE-002 / AD-001, AD-002, AD-006, AD-007 (T-A01..T-A16).\"\"\"\n\n    def _shrink_grace(self) -> None:\n        self.mod.APPROVAL_CANCEL_GRACE_S = 0.4\n        self.mod.CONTROL_WRITE_TIMEOUT_S = 0.5\n\n    def test_t_a01_session_start_allowall_and_flags(self) -> None:\n        install_fake_msp(self, serve_plans=[ok_plan()])\n        status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        starts = rpc_by_method(self, \"session/start\")\n        self.assertEqual(len(starts), 1)\n        self.assertEqual(starts[0][\"params\"][\"approvalMode\"], \"allowAll\")\n        argv = json.loads((self.tmp / \"serve-argv.json\").read_text())\n        self.assertIn(\"--disable-write\", argv)\n        self.assertIn(\"--disable-shell\", argv)\n        self.assertNotIn(\"--disable-sandbox\", argv)\n        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        self.assertIn(\"approvalMode=allowAll\", logs)\n        self.assertIn(\"1.4.9-test\", logs)\n\n    def test_t_a02_approval_receipt_and_decide_without_exec(self) -> None:\n        install_fake_msp(self, serve_plans=[ok_plan({\"approval\": {}})])\n        status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        self.assertIn(\"hello\", body.decode())\n        self.assertEqual(proc_count(self, \"exec\"), 0)\n        self.assertEqual(len(rpc_by_method(self, \"turn/start\")), 1)\n        receipts = [\n            m for m in rpc_msgs(self) if \"method\" not in m and m.get(\"id\") == 9000\n        ]\n        self.assertEqual(len(receipts), 1)\n        self.assertEqual(receipts[0].get(\"result\"), {})\n        decides = rpc_by_method(self, \"approval/decide\")\n        self.assertEqual(len(decides), 1)\n        params = decides[0][\"params\"]\n        self.assertEqual(params[\"choiceId\"], \"c-approve\")\n        self.assertEqual(\n            params[\"requirementId\"], {\"approvalId\": \"appr-0\", \"sourceIndex\": 0}\n        )\n        self.assertIn(\"via=serve\", self.mod.LOG_PATH.read_text(encoding=\"utf-8\"))\n\n    def test_t_a03_policy_preference_and_amendment_never_chosen(self) -> None:\n        policy = self.mod.ApprovalPolicy(\"allowAll\")\n            }\n            install_fake_msp(self, serve_plans=[plan])\n            status, _ = bridge_request(self, turn_request())\n            self.assertEqual(status, 502)\n            self.assertEqual(proc_count(self, \"exec\"), 0)\n\n    def test_t_a09_decide_and_cancel_bounds(self) -> None:\n        self._shrink_grace()\n        plan = {\"steps\": [{\"approval_repeat\": 12}]}\n        install_fake_msp(self, serve_plans=[plan])\n        status, _ = bridge_request(self, turn_request())\n        self.assertEqual(status, 502)\n        self.assertEqual(len(rpc_by_method(self, \"approval/decide\")), 10)\n        self.assertEqual(proc_count(self, \"exec\"), 0)\n        self.assertTrue(self._slot_free())\n        plan = {\"steps\": [{\"user_input_repeat\": 5}]}\n        install_fake_msp(self, serve_plans=[plan])\n        status, _ = bridge_request(self, turn_request())\n        self.assertEqual(status, 502)\n        self.assertEqual(len(rpc_by_method(self, \"userInput/cancel\")), 3)\n        self.assertTrue(self._slot_free())\n\n    def test_t_a09b_ignored_cancel_killed_within_grace(self) -> None:\n        self._shrink_grace()\n        plan = {\"steps\": [{\"approval\": {\"availableChoices\": []}}, {\"hang\": True}]}\n        install_fake_msp(self, serve_plans=[plan])\n        started = time.monotonic()\n        status, body = bridge_request(self, turn_request(stream=True))\n        elapsed = time.monotonic() - started\n        self.assertEqual(status, 200)\n        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n        self.assertTrue(any(\"error\" in f for f in sse_frames(body)))\n        self.assertLess(elapsed, 0.4 + 3.0)\n        self.assertTrue(\n            wait_until(self._slot_free, SCENARIO_DEADLINE_S), \"слот не освободился\"\n        )\n        pids = (self.tmp / \"serve-pids.log\").read_text().split()\n        self.assertTrue(pids)\n        self.assertTrue(\n            wait_until(lambda: not group_alive(int(pids[-1])), GROUP_EXIT_WAIT_S)\n        )\n        self.assertEqual(proc_count(self, \"exec\"), 0)\n\n    def test_t_a09c_blocked_stdin_grace_from_latch(self) -> None:\n        self._shrink_grace()\n        plan = {\n            \"steps\": [\n                {\"approval_nowait\": {\"availableChoices\": []}, \"n\": 3},\n                {\"no_read_hang\": True},\n            ]\n        }\n        install_fake_msp(self, serve_plans=[plan])\n        started = time.monotonic()\n        status, body = bridge_request(self, turn_request(stream=True))\n        elapsed = time.monotonic() - started\n        self.assertEqual(status, 200)\n        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n        self.assertLess(elapsed, 0.4 + 3.5)\n        self.assertTrue(wait_until(self._slot_free, SCENARIO_DEADLINE_S))\n        self.assertEqual(proc_count(self, \"exec\"), 0)\n        self.assertIn(\n            \"approval_degraded\", self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n        )\n\n    def test_t_a10_canaries_redacted_in_audit_log(self) -> None:\n        bad_choice = \"bad id CANARY_CHOICE\"\n        self.assertIn(\"tool_item\", logs)\n        self.assertIn(\"web_search\", logs)\n        self.assertIn(\"tool_items=1\", logs)\n        self.assertIn(\"ttft=1\", logs)\n        self.assertNotIn(canary, logs)\n\n    def test_t_a16_setup_approval_blocks_any_new_process(self) -> None:\n        for when in (\"initialize\", \"session/start\"):\n            for req_mode in (\"request\", \"requested\"):\n                with self.subTest(when=when, mode=req_mode):\n                    plan = {\n                        \"setup_approval\": {\n                            \"when\": when,\n                            \"mode\": req_mode,\n                            \"effect\": \"setup-effect\",\n                            \"after\": \"break\",\n                        },\n                        \"steps\": [_OK_STEP],\n                    }\n                    install_fake_msp(self, serve_plans=[plan, ok_plan()])\n                    status, body = bridge_request(self, turn_request(stream=True))\n                    self.assertEqual(status, 200)\n                    self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n                    self.assertTrue(any(\"error\" in f for f in sse_frames(body)))\n                    self.assertEqual(proc_count(self, \"serve\"), 1)\n                    self.assertEqual(proc_count(self, \"exec\"), 0)\n                    self.assertEqual(effect_lines(self), [\"setup-effect\"])\n                    self.assertEqual(len(rpc_by_method(self, \"approval/decide\")), 1)\n        # Контроль: setup-транзиент без approval по-прежнему повторяется.\n        self.mod.TRANSIENT_BACKOFF_S = (0.0, 0.0)\n        self.mod.TRANSIENT_JITTER_S = 0.0\n        install_fake_msp(\n            self,\n            serve_plans=[\n                {\"session_error\": {\"code\": -32603, \"message\": \"[net-timeout]\"}},\n                ok_plan(),\n            ],\n        )\n        status, body = bridge_request(self, turn_request())\n        self.assertEqual(status, 200, body)\n        self.assertEqual(proc_count(self, \"serve\"), 2)\n\n    def test_startup_constants_validation(self) -> None:\n        with mock.patch.dict(os.environ, {\"MUSE_BRIDGE_TIMEOUT_S\": \"100\"}):\n            with self.assertRaises(Exception):\n                load_bridge()\n        with mock.patch.dict(os.environ, {\"MUSE_BRIDGE_TIMEOUT_S\": \"1800\"}):\n            self.assertIsNotNone(load_bridge())\n\n\nclass TransientRetryTest(_BridgeScenario):\n    \"\"\"REQ-MUSE-003 / AD-003 (T-R01..T-R12).\"\"\"\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '320,365p' bridges/muse-bridge/server.py; sed -n '325,380p' .ai-team/runs/muse-wonder-approval-20261015/architecture/arch-spec.md; sed -n '1,120p' AGENTS.md; sed -n '1,120p' .agents/AGENTS.md; sed -n '3627,3661p' bridges/muse-bridge/server.py; rg -n 'VER-013|loopback|slow-reader|environment-manifest|execution-evidence|evidence-manifest|raw.*log|сыро' .ai-team/runs/muse-wonder-approval-20261015/code-review-package.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '320,365p' bridges/muse-bridge/server.py; sed -n '325,380p' .ai-team/runs/muse-wonder-approval-20261015/architecture/arch-spec.md; sed -n '1,120p' AGENTS.md; sed -n '1,120p' .agents/AGENTS.md; sed -n '3627,3661p' bridges/muse-bridge/server.py; rg -n 'VER-013|loopback|slow-reader|environment-manifest|execution-evidence|evidence-manifest|raw.*log|сыро' .ai-team/runs/muse-wonder-approval-20261015/code-review-package.md\"","aggregated_output":"TOOL_CALL_CLOSE = \"</tool_call>\"\n\nDEFAULT_SYSTEM_HINT = (\n    \"Ты отвечаешь в текстовом чате. Не вызывай инструменты и не выполняй команды; \"\n    \"верни только текстовый ответ.\"\n)\n\n_started = time.time()\n_active: dict[str, float] = {}\n_active_lock = threading.Lock()\n# Слоты в карантине (по записи на слот: pgid не подтверждённых мёртвыми групп); под _active_lock.\n_quarantined_slots: list[list[int]] = []\n_slots = threading.Semaphore(MAX_CONCURRENT)\n_LOG_LOCK = threading.Lock()\n\n\ndef _log(msg: str) -> None:\n    safe_msg = _redact_secrets(msg)\n    line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {safe_msg}\"\n    sys.stderr.write(line + \"\\n\")\n    sys.stderr.flush()\n    try:\n        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)\n        with _LOG_LOCK, LOG_PATH.open(\"a\", encoding=\"utf-8\") as fh:\n            fh.write(line + \"\\n\")\n    except OSError:\n        pass\n\n\ndef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n    hdr = handler.headers.get(\"Authorization\", \"\")\n    if hdr.startswith(\"Bearer \"):\n        return hdr[7:].strip() == AUTH_KEY\n    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n\n\ndef _redact_secrets(text: str) -> str:\n    \"\"\"Удалить отражённые ключи до обрезки диагностики; повторный вызов безопасен.\"\"\"\n    if AUTH_KEY:\n        text = text.replace(AUTH_KEY, \"[REDACTED]\")\n    text = re.sub(\n        r\"Authorization\\s*:\\s*[^\\r\\n]+\",\n        \"Authorization: [REDACTED]\",\n        text,\n        flags=re.IGNORECASE,\n    )\n- Нагрузка при деградации транспорта (FU-010, QA-009): слот удерживается на\n  весь ход, поэтому повторы не поднимают параллельность выше\n  `MAX_CONCURRENT=2`; глобальный cooldown и circuit breaker осознанно не\n  вводятся, суммарную длительность ограничивают паузы и исполнительный дедлайн `E`.\n- Между попытками клиенту не уходит ни error, ни [DONE]; keepalive фазы OPEN\n  продолжается. Терминальный исход после исчерпания — существующий формат\n  502 / SSE error с диагностикой последней попытки после редакции и удаления\n  отражённых промптов всех попыток.\n\n## 4. REQ-MUSE-004: живость и прогресс в SSE\n\nРешение AD-004 (APPROVED), границы BND-002 и BND-004, дельта CD-001.\n\n### 4.1 Что стримится, а что нет\n\nСтримится только прирост reasoning summaries serve-пути. Content, tool_calls,\nusage и финальный кадр — как сегодня, после завершения всех попыток: разбор\ntool-разметки `_split_tool_calls` работает по полному тексту, и частичная\nразметка клиенту не утекает. Exec-ходы summaries не дают и live не имеют.\nФорма Non-stream JSON не меняется, включая поле `reasoning_summaries` целиком; запись тоже ограничена W/D, при невозможности доставки — закрытие без нового процесса.\n\n### 4.2 Контракт live-sink и инвариант конкатенации\n\n- ServeRun получает необязательный sink Handler и зовёт его синхронно из своего\n  цикла чтения при каждом приросте summary: дельты `summary.N` и списки\n  `summary` из `item/completed` проходят один путь накопления\n  (`summary_parts`/`summaries`, как сегодня), чтобы текст без дельт не терялся.\n  ServeRun сокет, `_wlock` и фазы SSE не знает и исключений записи не получает:\n  sink возвращает только факт успеха.\n- Предел выдачи a4 (PF-a3-002): для любого вызова _sse_write в момент s единый локальный deadline L=min(s+LIVE_WRITE_TIMEOUT_S, W), LIVE_WRITE_TIMEOUT_S=3 с. Ожидание _wlock, sendall/write и flush используют один убывающий остаток до L (таймаут переустанавливается по остатку перед каждым блокирующим этапом, не по 3 с на этап); возвращается прежний socket timeout до освобождения замка. Этот предел действует на role, keepalive, live reasoning, финальный reasoning-хвост, tool_calls, КАЖДЫЙ content-кадр, finish_reason, usage, error и [DONE], без исключений. Все циклы сериализации/разбиения кадров, baseline-пауза 5 мс между content-кадрами и остановка/join keepalive проверяют W и прерываются надзором; нельзя начинать новый кадр/паузу при неположительном остатке, кадровый бюджет не обновляет W. keepalive допускается только OPEN, перед финальной выдачей останавливается в остатке до W. При истечении W либо L или частичном кадре запрос получает единственный локальный неуспешный исход delivery_deadline/client_gone, live и другие писатели остановлены, соединение закрывается; поздний успех модели игнорируется, повтор/fallback запрещены даже если ещё нет _content_started. После частично отправленного кадра или при нулевом остатке новый error/[DONE] не дописывается. Если ошибка известна раньше и полный корректный error+[DONE] успевает в оставшийся W, допустим один обычный ошибочный терминал; гарантировать его при аварийном обрыве нельзя. Успех существует только если ВСЯ конечная выдача, включая finish/usage и единственный [DONE], завершена до W; успешный локальный исход не фиксируется по завершению вычисления. При исчерпании бюджета результат может быть усечён закрытием соединения; отсутствие потери F обещается только для полностью доставленного успешного ответа. Полный текст и завершающий [DONE] после W не обещаются ни для читающего клиента, ни при расхождении snapshot. Нормальный путь сохраняет поля/порядок внешнего API. Резерв на 2 error-кадра не является доказательством доставки N content-кадров.\n- Префикс-монотонная публикация (RW-005). Порядок опубликованного задним\n  числом не меняется: до заморозки live отдаёт только прирост\n  `summary_parts[0]`. Заморозка наступает при первой дельте с индексом больше\n  0, при `item/completed` reasoning или в конце хода; дальше дельты только\n  копятся. Поздний меньший индекс (первой пришла `summary.1`) ничего не\n  публикует до согласования. Финальное согласование в `_send_sse`: пусть `F`\n  — сегодняшняя сборка `\"\\n\\n\".join(summaries)`, `P` — уже отправленный\n  live-текст. Если `F` начинается с `P`, доотдаётся только хвост `F[len(P):]`\n  (при полном live финального reasoning-кадра нет, повтор snapshot хвоста не\n  даёт). Если нет (расхождение; не ожидается, ASM-011; PF-a2-004) — для полностью доставленного успешного ответа **потеря\n  авторитетного текста запрещена**: после уже отправленного `P` клиенту уходит\n  разделитель `\"\\n\\n\"` и авторитетный `F` **целиком** отдельным абзацем\n  (допускается дублирование части текста, потери нет), расхождение логируется\n  счётчиком `reasoning_diverged` с длинами `P`, `F` и общего префикса без текста.\n  Пример: `P=\"a\"`, `F=\"b\\n\\nc\"` → клиент получает `a` + `\\n\\n` + `b\\n\\nc`. Так последовательность `0:\"a\" → 1:\"b\" → 0:\"c\"` даёт клиенту\n  `\"a\"` + хвост `\"c\\n\\nb\"` = итоговую `\"ac\\n\\nb\"`, а расхождение\n  `item/completed` с дельтами не дублирует и не переставляет текст.\n  Non-stream ответ всегда несёт авторитетную сборку `F` целиком.\n- Первый фактически отправляемый непустой reasoning-кадр выставляет\n  `_content_started` внутри той же критической секции `_sse_write` до записи (форма —\n  параметр или колбэк вызова, зона Coder) — с этого момента повторы §3\n  и контекстный повтор запрещены; буферизованная, но не отправленная дельта\n  флага не ставит.\n- Keepalive без изменений: пустой data-чанк каждые 15 с в фазе OPEN (предел записи —\n  общий, выше). Переход на SSE-комментарии droid-моста не делается (OPEN-03,\n  deferred): пустые чанки держат клиента по комментарию в коде моста (влияние на\nsed: AGENTS.md: No such file or directory\nsed: .agents/AGENTS.md: No such file or directory\n    daemon_threads = True\n    allow_reuse_address = True\n\n\ndef main() -> int:\n    if not AUTH_KEY:\n        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n        return 2\n    try:\n        _validate_startup_config()\n    except RuntimeError as exc:\n        sys.stderr.write(f\"{exc}; refusing to start\\n\")\n        _log(f\"startup config invalid: {exc}\")\n        return 2\n    if TRANSIENT_RETRY_SCOPE == \"observed-items\":\n        _log(\"warning retry_scope=observed-items at-least-once accepted by operator\")\n    try:\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n    except OSError as exc:\n        _log(f\"workspace mkdir failed: {exc}\")\n    _log(\n        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n    )\n    server = Server((HOST, PORT), Handler)\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        server.server_close()\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"В a4 обнаружил явное разрешение отправлять финальный reasoning целиком при расхождении, так что замечание об этом снимаю. Проверяю другие риски: соблюдается ли grace во время setup и закрывает ли надзор W сокет до ожидания уборки процесса. Тесты T-L09/T-R12 проверяют начало записей, но не полную границу закрытия.\n"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '105,133p' tests/test_muse_bridge_killpg.py; rg -n '\"'^def bridge_request|''^def turn_request'\"' tests/test_muse_bridge_killpg.py; sed -n '2670,2740p' tests/test_muse_bridge_killpg.py; rg --files .ai-team/runs/muse-wonder-approval-20261015/receipts .ai-team/runs/muse-wonder-approval-20261015/verification .ai-team/runs/muse-wonder-approval-20261015/logs 2>/dev/null\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '105,133p' tests/test_muse_bridge_killpg.py; rg -n '\"'^def bridge_request|''^def turn_request'\"' tests/test_muse_bridge_killpg.py; sed -n '2670,2740p' tests/test_muse_bridge_killpg.py; rg --files .ai-team/runs/muse-wonder-approval-20261015/receipts .ai-team/runs/muse-wonder-approval-20261015/verification .ai-team/runs/muse-wonder-approval-20261015/logs 2>/dev/null\"","aggregated_output":"            time.sleep(1)\n\"\"\"\n\n\ndef load_bridge() -> Any:\n    \"\"\"Свежий экземпляр модуля моста: изолированные _slots/_active на каждый тест.\"\"\"\n    spec = importlib.util.spec_from_file_location(\n        f\"muse_bridge_server_{next(_LOAD_SEQ)}\", BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef group_alive(pgid: int) -> bool:\n    \"\"\"Жива ли группа pgid (сигнал 0 ничего не убивает).\"\"\"\n    try:\n        os.killpg(pgid, 0)\n    except ProcessLookupError:\n        return False\n    except OSError:\n        return True\n    return True\n\n\ndef wait_until(predicate: Callable[[], bool], timeout: float) -> bool:\n    \"\"\"Опрос predicate каждые 50 мс до timeout (замер и на последней границе).\"\"\"\n    deadline = time.monotonic() + timeout\n648:def bridge_request(\n666:def turn_request(stream: bool = False) -> dict:\n            combined = log_text + resp_text\n            for forbidden in (\n                \"attempt1secretcanary123456\",\n                \"attempt2-secret-token-98765\",\n                \"ATTEMPT_ONE_ONLY_BODY_CANARY_\",\n                \"MANDATORY_USER_BODY_CANARY_\",\n                \"old-dropped-\",\n            ):\n                self.assertNotIn(forbidden, combined)\n\n        # Серия запросов не растит удерживаемые буферы модуля.\n        self.assertEqual(len(self.mod._active), 0)\n        self.assertEqual(len(self.mod._quarantined_slots), 0)\n\n    def test_t24_repeated_tool_call_id_across_episodes_preserves_trailing_mandatory_unit(\n        self,\n    ) -> None:\n        \"\"\"RW-001 / FU-001: повтор tool_call_id в разных эпизодах не теряет хвостовой вызов; Фаза C линейна.\"\"\"\n        msgs: list[dict[str, Any]] = [\n            {\"role\": \"user\", \"content\": \"first-user\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_0\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"cmd\", \"arguments\": '{\"step\": 1}'},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_0\",\n                \"name\": \"cmd\",\n                \"content\": \"ep1-tool-result-\" + (\"X\" * 1200),\n            },\n            {\"role\": \"assistant\", \"content\": \"ep1-summary-\" + (\"Y\" * 300)},\n            {\"role\": \"user\", \"content\": \"last-user\"},\n            {\n                \"role\": \"assistant\",\n                \"content\": \"tail-assistant-call\",\n                \"tool_calls\": [\n                    {\n                        \"id\": \"call_0\",\n                        \"type\": \"function\",\n                        \"function\": {\"name\": \"cmd\", \"arguments\": '{\"step\": 2}'},\n                    }\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"call_0\",\n                \"name\": \"cmd\",\n                \"content\": \"tail-mandatory-tool-result\",\n            },\n        ]\n        res = self.mod._prune_messages(msgs, limit=500, target=400)\n        self.assertEqual(res.status, \"pruned\")\n        self.assertNotIn(\"ep1-tool-result-\", res.prompt)\n        self.assertIn(\"User: first-user\", res.prompt)\n        self.assertIn(\"User: last-user\", res.prompt)\n        self.assertIn(\"tail-assistant-call\", res.prompt)\n        self.assertIn(\"tail-mandatory-tool-result\", res.prompt)\n\n        # FU-001: 3000 сообщений прунятся за линейное время (< 0.5 с).\n        many_msgs: list[dict[str, Any]] = [{\"role\": \"user\", \"content\": \"start\"}]\n        for i in range(3000):\n            many_msgs.append(\n                {\n                    \"role\": \"assistant\" if i % 2 == 0 else \"user\",\n.ai-team/runs/muse-wonder-approval-20261015/receipts/arch-panel.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/coder.transport.jsonl\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04-files.sha256\n.ai-team/runs/muse-wonder-approval-20261015/receipts/arch-gate-a4.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/coder.process.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04.process.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04-validation.log\n.ai-team/runs/muse-wonder-approval-20261015/receipts/verifier-receipt.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/arch-gate-a3.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04-baseline.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/arch-gate-a2.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect.iter2.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/arch-gate.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04.transport.err\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect.iter3.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/coder.transport.err\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect.json\n.ai-team/runs/muse-wonder-approval-20261015/receipts/architect-04.transport.jsonl\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport importlib.util, pathlib, time, json\np=pathlib.Path('tests/test_muse_bridge_killpg.py')\ns=importlib.util.spec_from_file_location('acceptance_probes',p)\nt=importlib.util.module_from_spec(s); s.loader.exec_module(t)\ncase=t._BridgeScenario(); case.setUp()\ntry:\n    case.mod.APPROVAL_CANCEL_GRACE_S=0.15\n    case.mod.SERVE_SPAWN_TIMEOUT_S=1.4\n    t.install_fake_msp(case,serve_plans=[{'setup_approval': {'when':'initialize','payload':{'availableChoices':[]}}}])\n    started=time.monotonic()\n    status,body=t.bridge_request(case,t.turn_request())\n    elapsed=time.monotonic()-started\n    print('PROBE_SETUP_GRACE',json.dumps({'grace':0.15,'setup_limit':1.4,'elapsed':round(elapsed,3),'status':status,'exec_count':t.proc_count(case,'exec')}))\nfinally:\n    case.doCleanups()\ncase=t._BridgeScenario(); case.setUp()\ntry:\n    t.install_fake_msp(case,serve_plans=[t.ok_plan({'summary':[0,'a']},{'reasoning_completed':['b','c']})])\n    status,body=t.bridge_request(case,t.turn_request(stream=True))\n    print('PROBE_DIVERGED_PIPELINE',json.dumps({'status':status,'reasoning':''.join(t.sse_deltas(body,'reasoning_content'))}))\n    print('PROBE_AUDIT_NEWLINE',repr(case.mod._render_audit_token('web_search\\\\n')),repr(case.mod._render_tool_token('tool\\\\n')))\nfinally:\n    case.doCleanups()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport importlib.util, pathlib, time, json\np=pathlib.Path('tests/test_muse_bridge_killpg.py')\ns=importlib.util.spec_from_file_location('acceptance_probes',p)\nt=importlib.util.module_from_spec(s); s.loader.exec_module(t)\ncase=t._BridgeScenario(); case.setUp()\ntry:\n    case.mod.APPROVAL_CANCEL_GRACE_S=0.15\n    case.mod.SERVE_SPAWN_TIMEOUT_S=1.4\n    t.install_fake_msp(case,serve_plans=[{'setup_approval': {'when':'initialize','payload':{'availableChoices':[]}}}])\n    started=time.monotonic()\n    status,body=t.bridge_request(case,t.turn_request())\n    elapsed=time.monotonic()-started\n    print('PROBE_SETUP_GRACE',json.dumps({'grace':0.15,'setup_limit':1.4,'elapsed':round(elapsed,3),'status':status,'exec_count':t.proc_count(case,'exec')}))\nfinally:\n    case.doCleanups()\ncase=t._BridgeScenario(); case.setUp()\ntry:\n    t.install_fake_msp(case,serve_plans=[t.ok_plan({'summary':[0,'a']},{'reasoning_completed':['b','c']})])\n    status,body=t.bridge_request(case,t.turn_request(stream=True))\n    print('PROBE_DIVERGED_PIPELINE',json.dumps({'status':status,'reasoning':''.join(t.sse_deltas(body,'reasoning_content'))}))\n    print('PROBE_AUDIT_NEWLINE',repr(case.mod._render_audit_token('web_search\\\\n')),repr(case.mod._render_tool_token('tool\\\\n')))\nfinally:\n    case.doCleanups()\nPY\"","aggregated_output":"Traceback (most recent call last):\n  File \"<stdin>\", line 5, in <module>\n  File \"/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_muse_bridge_killpg.py\", line 216, in setUp\n    self.server = self.mod.Server((\"127.0.0.1\", 0), self.mod.Handler)\n                  ~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/Users/aazhiry1/.local/share/uv/python/cpython-3.14.6-macos-aarch64-none/lib/python3.14/socketserver.py\", line 457, in __init__\n    self.server_bind()\n    ~~~~~~~~~~~~~~~~^^\n  File \"/Users/aazhiry1/.l