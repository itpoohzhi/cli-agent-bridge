{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"task_stream":{"kind":"task","id":"01a14391-cfeb-7302-9417-b0f0432cb6cb"},"task_id":"01a14391-cfeb-7302-9417-b0f0432cb6cb","event":{"kind":"output","task_id":"01a14391-cfeb-7302-9417-b0f0432cb6cb","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(2822 line(s) above)\n2823|    def _send_sse(\n2824|        self,\n2825|        model: str,\n2826|        content: str,\n2827|        tool_calls: list[dict],\n2828|        prompt_tokens: int,\n2829|        completion_tokens: int,\n2830|        reasoning_tokens: int,\n2831|        summaries: list[str] | None = None,\n2832|    ) -> None:\n2833|        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n2834|\n2835|        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n2836|        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n2837|        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n2838|        \"\"\"\n2839|        finish = \"tool_calls\" if tool_calls else \"stop\"\n2840|        if not self._sse_open and not self._sse_begin(model):\n2841|            return\n2842|        self._sse_stop_keepalive()\n2843|        chunk = self._sse_chunk\n2844|        reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n2845|        live_sent = getattr(self, \"_live_sent_text\", \"\")\n2846|        if reasoning:\n2847|            if not live_sent:\n2848|                tail = reasoning\n2849|            elif reasoning.startswith(live_sent):\n2850|                tail = reasoning[len(live_sent) :]\n2851|            else:\n2852|                common = 0\n2853|                for a_ch, b_ch in zip(live_sent, reasoning):\n2854|                    if a_ch != b_ch:\n2855|                        break\n2856|                    common += 1\n2857|                _log(\n2858|                    f\"reasoning_diverged p_len={len(live_sent)} f_len={len(reasoning)} \"\n2859|                    f\"common={common} count=1\"\n2860|                )\n2861|                tail = \"\\n\\n\" + reasoning\n2862|            if tail and not self._sse_emit(\n2863|                chunk({\"reasoning_content\": tail}), mark_content=True\n2864|            ):\n2865|                return\n2866|        for tc in tool_calls:\n2867|            fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n2868|            delta = {\n2869|                \"tool_calls\": [\n2870|                    {\n2871|                        \"index\": tc.get(\"index\", 0),\n2872|                        \"id\": tc.get(\"id\", \"\"),\n2873|                        \"type\": \"function\",\n2874|                        \"function\": {\n2875|                            \"name\": fn.get(\"name\", \"\"),\n2876|                            \"arguments\": fn.get(\"arguments\", \"\"),\n2877|                        },\n2878|                    }\n2879|                ]\n2880|            }\n2881|            if not self._sse_emit(chunk(delta), mark_content=True):\n2882|                return\n2883|        for piece in _split_sse_chunks(content):\n2884|            if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2885|                self._delivery_failed = True\n2886|                return\n2887|            if not self._sse_emit(chunk({\"content\": piece}), mark_content=True):\n2888|                return\n2889|            if SSE_CHUNK_DELAY_S > 0:\n2890|                _w = getattr(self, \"_write_deadline\", float(\"inf\"))\n2891|                if _w - time.monotonic() <= SSE_CHUNK_DELAY_S:\n2892|                    self._delivery_failed = True\n2893|                    return\n2894|                time.sleep(SSE_CHUNK_DELAY_S)\n2895|        final = chunk({}, finish)\n2896|        final[\"usage\"] = {\n2897|            \"prompt_tokens\": prompt_tokens,\n2898|            \"completion_tokens\": completion_tokens,\n2899|            \"total_tokens\": prompt_tokens + completion_tokens,\n2900|            \"reasoning_tokens\": reasoning_tokens,\n2901|        }\n2902|        if self._sse_emit(final):\n2903|            self._sse_write(\"data: [DONE]\\n\\n\")\n2904|\n2905|    def do_GET(self) -> None:  # noqa: N802\n2906|        path = self.path.split(\"?\", 1)[0]\n2907|        if path in (\"/health\", \"/v1/health\"):\n2908|            with _active_lock:\n2909|                active = len(_active)\n2910|                quarantined = len(_quarantined_slots)\n2911|            self._send(\n2912|                200,\n2913|                {\n2914|                    \"ok\": True,\n2915|                    \"transport\": \"muse-cli\",\n2916|                    \"wrapper\": MUSE_WRAPPER,\n2917|                    \"models\": sorted(ALLOWED_MODELS),\n2918|                    \"default_model\": DEFAULT_MODEL,\n2919|                    \"default_effort\": DEFAULT_EFFORT,\n2920|                    \"active\": active,\n2921|                    \"quarantined\": quarantined,\n2922|                    \"max_concurrent\": MAX_CONCURRENT,\n2923|                    \"stream\": True,\n2924|                    \"tool_emulation\": True,\n2925|                    \"uptime_s\": int(time.time() - _started),\n2926|                },\n2927|            )\n2928|            return\n2929|        if not _auth_ok(self):\n2930|            self._send(\n2931|                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n2932|            )\n2933|            return\n2934|        if path in (\"/v1/models\", \"/models\"):\n2935|            self._send(\n2936|                200,\n2937|                {\n2938|                    \"object\": \"list\",\n2939|                    \"data\": [\n2940|                        {\n2941|                            \"id\": mid,\n2942|                            \"object\": \"model\",\n2943|                            \"owned_by\": \"meta-muse\",\n2944|                            \"created\": 0,\n2945|                            \"context_length\": meta[\"context_length\"],\n2946|                        }\n2947|                        for mid, meta in ALLOWED_MODELS.items()\n2948|                    ],\n2949|                },\n2950|            )\n2951|            return\n2952|        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n2953|\n2954|    def do_POST(self) -> None:  # noqa: N802\n2955|        if not _auth_ok(self):\n2956|            self.close_connection = True\n2957|            self._send(\n2958|                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n2959|            )\n2960|            return\n2961|        path = self.path.split(\"?\", 1)[0]\n2962|        length = int(self.headers.get(\"Content-Length\") or \"0\")\n2963|        raw = self.rfile.read(length) if length else b\"{}\"\n2964|        try:\n2965|            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n2966|        except ValueError:\n2967|            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n2968|            return\n2969|        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n2970|            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n2971|            return\n2972|        try:\n2973|            self._serve_json(req)\n2974|        finally:\n2975|            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n2976|            self._sse_stop_keepalive()\n2977|            _done = getattr(self, \"_req_done\", None)\n2978|            if _done is not None:\n2979|                _done.set()\n2980|            self._write_deadline = float(\"inf\")\n2981|            self._exec_deadline = float(\"inf\")\n2982|            self._request_deadline = float(\"inf\")\n(more lines below)","final_result":true}}}
