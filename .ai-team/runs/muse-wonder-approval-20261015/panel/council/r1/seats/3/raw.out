{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c49d","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":169,"recorded_at":1780531400000333,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"task_stream":{"kind":"task","id":"01a14391-742d-7443-85ff-4233c02ec290"},"task_id":"01a14391-742d-7443-85ff-4233c02ec290","event":{"kind":"output","task_id":"01a14391-742d-7443-85ff-4233c02ec290","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(1999 line(s) above)\n2000|                    default=str,\n2001|                ),\n2002|            )\n2003|\n2004|        def _send_decide(\n2005|            snapshot: dict[str, Any], choice: dict[str, Any], *, allowing: bool\n2006|        ) -> None:\n2007|            if allowing:\n2008|                self._note_allowing_decide()\n2009|            self.decide_count += 1\n2010|            rid = self._send(\n2011|                \"approval/decide\",\n2012|                {\n2013|                    \"approvalId\": snapshot.get(\"approvalId\"),\n2014|                    \"choiceId\": choice.get(\"choiceId\"),\n2015|                    \"commandId\": _uuid7(),\n2016|                    \"requirementId\": snapshot.get(\"currentRequirementId\"),\n2017|                    \"sessionId\": snapshot.get(\"sessionId\") or session_id or \"\",\n2018|                },\n2019|                control=True,\n2020|            )\n2021|            pending[rid] = \"decide\"\n2022|\n2023|        def _latch_degradation(\n2024|            reason: str, snapshot: dict[str, Any] | None = None\n2025|        ) -> None:\n2026|            if self.approval_degraded:\n2027|                return\n2028|            self.approval_degraded = True\n2029|            now = time.monotonic()\n2030|            self.degraded_at = now\n2031|            grace_end = now + APPROVAL_CANCEL_GRACE_S\n2032|            if self.write_deadline != float(\"inf\"):\n2033|                grace_end = min(\n2034|                    grace_end, self.write_deadline - 2 * LIVE_WRITE_TIMEOUT_S\n2035|                )\n2036|            self.grace_end = grace_end\n2037|            _log(\n2038|                f\"approval_degraded reason={reason} approval_seen={int(self.approval_seen)} \"\n2039|                f\"action_possible={int(self.action_possible)} \"\n2040|                f\"barrier={int(self.observed_barrier)} tool_items={self.tool_item_count} \"\n2041|                f\"grace_s={max(0.0, grace_end - now):.2f}\"\n2042|            )\n2043|            snap = (\n2044|                snapshot\n2045|                if snapshot is not None\n2046|                else (last_snapshot[0] if last_snapshot else None)\n2047|            )\n2048|            try:\n2049|                deny = ApprovalPolicy.deny_choice(snap)\n2050|                if deny is not None and self.decide_count < MAX_APPROVAL_DECIDE:\n2051|                    _send_decide(snap or {}, deny, allowing=False)\n2052|                elif turn_id:\n2053|                    rid = self._send(\n2054|                        \"turn/cancel\",\n2055|                        {\n2056|                            \"commandId\": _uuid7(),\n2057|                            \"sessionId\": session_id or \"\",\n2058|                            \"turnId\": turn_id,\n2059|                        },\n2060|                        control=True,\n2061|                    )\n2062|                    pending[rid] = \"turn_cancel\"\n2063|            except ServeUnavailable as exc:\n2064|                _log(f\"approval degrade command failed: {exc}\")\n2065|\n2066|        def _handle_ack(msg: dict[str, Any]) -> None:\n2067|            raw_id = msg.get(\"id\")\n2068|            if not isinstance(raw_id, int):\n2069|                return\n2070|            kind = pending.pop(raw_id, None)\n2071|            if kind is None:\n2072|                return\n2073|            if \"error\" in msg:\n2074|                err = msg.get(\"error\") if isinstance(msg.get(\"error\"), dict) else {}\n2075|                code = err.get(\"code\")\n2076|                if kind == \"decide\" and code == -32051:\n2077|                    _log(\"approval decide benign -32051 already resolved\")\n2078|                    return\n2079|                if kind in (\"decide\", \"user_cancel\"):\n2080|                    _latch_degradation(f\"{kind}_error_{code}\")\n2081|                return\n2082|            result = msg.get(\"result\") if isinstance(msg.get(\"result\"), dict) else {}\n2083|            if result.get(\"terminal\") is False:\n2084|                _log(\"approval decide terminal=false awaiting updated request\")\n2085|\n2086|        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n2087|            while True:\n2088|                msg = read_msg(timeout_at)\n2089|                if \"method\" in msg:\n2090|                    self._handle_event(msg, None)\n2091|                    continue\n2092|                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n2093|                    if \"error\" in msg:\n2094|                        err = msg[\"error\"]\n2095|                        if isinstance(err, dict) and err.get(\"code\") == -32030:\n2096|                            self.ceiling_seen = True\n2097|                            _log(\n2098|                                f\"serve approval ceiling -32030 version={self.server_version} \"\n2099|                                \"warning approvalMode not applied\"\n2100|                            )\n2101|                        self.last_error_text = str(err)\n2102|                        raise ServeUnavailable(f\"serve RPC error: {err}\")\n2103|                    result = msg.get(\"result\")\n2104|                    return result if isinstance(result, dict) else {}\n2105|                _handle_ack(msg)\n2106|\n2107|        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n2108|            nonlocal final_text\n2109|            method = msg.get(\"method\")\n2110|            _raw_params = msg.get(\"params\")\n2111|            params: dict[str, Any] = (\n2112|                _raw_params if isinstance(_raw_params, dict) else {}\n2113|            )\n2114|            if method in (\n2115|                \"approval/request\",\n2116|                \"approval/requested\",\n2117|                \"userInput/request\",\n2118|            ):\n2119|                # a4: защёлки ДО receipt/дедупликации/политики, включая setup.\n2120|                self.approval_seen = True\n2121|                self.action_possible = True\n2122|                self.observed_barrier = True\n2123|                if self.approval_degraded:\n2124|                    _log(f\"approval after degraded ignored method={method}\")\n2125|                    return\n2126|                server_id = msg.get(\"id\")\n2127|                try:\n2128|                    if server_id is not None:\n2129|                        self._send_response(server_id, {})\n2130|                except ServeUnavailable:\n2131|                    _latch_degradation(\"receipt_write_failed\", params)\n2132|                    return\n2133|                if method == \"userInput/request\":\n2134|                    last_snapshot[:] = [params]\n2135|                    policy = ApprovalPolicy(APPROVAL_MODE)\n2136|                    _log(policy.evaluate_user_input(params)[\"audit\"])\n2137|                    if self.user_input_cancel_count >= MAX_USER_INPUT_CANCEL:\n2138|                        _latch_degradation(\"user_input_limit\", params)\n2139|                        return\n2140|                    self.user_input_cancel_count += 1\n2141|                    try:\n2142|                        rid = self._send(\n2143|                            \"userInput/cancel\",\n2144|                            {\n2145|                                \"commandId\": _uuid7(),\n2146|                                \"sessionId\": params.get(\"sessionId\")\n2147|                                or session_id\n2148|                                or \"\",\n2149|                                \"userInputId\": params.get(\"userInputId\"),\n2150|                            },\n2151|                            control=True,\n2152|                        )\n2153|                        pending[rid] = \"user_cancel\"\n2154|                    except ServeUnavailable:\n2155|                        _latch_degradation(\"user_input_write_failed\", params)\n2156|                    return\n2157|                pair = _pair_key(params)\n2158|                if pair in seen_pairs:\n2159|                    _log(\"approval duplicate suppressed\")\n2160|                    return\n2161|                seen_pairs.add(pair)\n2162|                last_snapshot[:] = [params]\n2163|                if self.decide_count >= MAX_APPROVAL_DECIDE:\n2164|                    _latch_degradation(\"decide_limit\", params)\n2165|                    return\n2166|                verdict = ApprovalPolicy(APPROVAL_MODE).evaluate(params)\n2167|                _log(f\"{verdict['audit']} n={self.decide_count + 1}\")\n2168|                if verdict[\"action\"] == \"approve\":\n2169|                    choice = next(\n2170|                        (\n2171|                            c\n2172|                            for c in ApprovalPolicy._choices(params)\n2173|                            if c.get(\"choiceId\") == verdict[\"choice_id\"]\n2174|                        ),\n2175|                        {\"choiceId\": verdict[\"choice_id\"]},\n2176|                    )\n2177|                    try:\n2178|                        _send_decide(params, choice, allowing=True)\n2179|                    except ServeUnavailable:\n2180|                        _latch_degradation(\"decide_write_failed\", params)\n2181|                elif verdict[\"action\"] == \"deny\":\n2182|                    _latch_degradation(\"no_approve_choice\", params)\n2183|                else:\n2184|                    _latch_degradation(\"no_choice\", params)\n2185|                return\n2186|            if method == \"turn/modelRetryScheduled\":\n2187|                _log(\n2188|                    \"turn modelRetryScheduled \"\n2189|                    f\"attempt={params.get('attempt')} maxAttempts={params.get('maxAttempts')} \"\n2190|                    f\"retryDelayMs={params.get('retryDelayMs')} \"\n2191|                    f\"errorKind={_render_audit_token(params.get('errorKind'))}\"\n2192|                )\n2193|                return\n2194|            if method in (\n2195|                \"approval/updated\",\n2196|                \"approval/resolved\",\n2197|                \"session/approvalModeChanged\",\n2198|                \"userInput/settled\",\n2199|            ):\n2200|                if method == \"approval/resolved\":\n2201|                    _log(\"approval resolved\")\n2202|                return\n2203|            if method in (\"item/started\", \"item/completed\"):\n2204|                raw_item = params.get(\"item\")\n2205|                item: dict[str, Any] = raw_item if isinstance(raw_item, dict) else {}\n2206|                iid = str(item.get(\"itemId\") or \"\")\n2207|                kind = str(item.get(\"kind\") or \"\")\n2208|                if iid:\n2209|                    kinds[iid] = kind\n2210|                if kind and kind not in (\"reasoning\", \"agentMessage\"):\n2211|                    self.observed_barrier = True\n2212|                    if iid:\n2213|                        tool_item_ids.add(iid)\n2214|                        self.tool_item_count = len(tool_item_ids)\n2215|                    _log(\n2216|                        f\"tool_item kind={_render_tool_token(kind)} \"\n2217|                        f\"tool={_render_tool_token(item.get('toolName'))}\"\n2218|                    )\n2219|                if method == \"item/completed\" and kind == \"reasoning\":\n2220|                    self._live_frozen = True\n2221|                if (\n2222|                    method == \"item/completed\"\n2223|                    and turn_id is not None\n2224|                    and item.get(\"turnId\") == turn_id\n2225|                ):\n2226|                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n2227|                        final_text = item[\"text\"]\n2228|                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n2229|                        summaries.extend(\n2230|                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n2231|                        )\n2232|            elif method == \"item/delta\":\n2233|                iid = str(params.get(\"itemId\") or \"\")\n2234|                field = str(params.get(\"field\") or \"text\")\n2235|                piece = params.get(\"delta\")\n2236|                if not isinstance(piece, str) or not piece:\n2237|                    return\n2238|                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n2239|                    try:\n2240|                        idx = int(field.split(\".\", 1)[1])\n2241|                    except (IndexError, ValueError):\n2242|                        idx = len(summary_parts)\n2243|                    if not first_summary_logged[0]:\n2244|                        first_summary_logged[0] = True\n2245|                        _t0 = self.turn_started_at or _now0\n2246|                        _log(\n2247|                            f\"first summary delta idx={idx} \"\n2248|                            f\"after_s={time.monotonic() - _t0:.2f}\"\n2249|                        )\n2250|                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n2251|                    if idx > 0:\n2252|                        self._live_frozen = True\n2253|                    elif not self._live_frozen and self.live_sink is not None:\n2254|                        try:\n2255|                            delivered = bool(self.live_sink(summary_parts.get(0, \"\")))\n2256|                        except Exception:  # noqa: BLE001, S112\n2257|                            delivered = False\n2258|                        if not delivered:\n2259|                            self._live_frozen = True\n2260|                elif (\n2261|                    kinds.get(iid, \"agentMessage\") == \"agentMessage\" and field == \"text\"\n2262|                ):\n2263|                    deltas.append(piece)\n2264|            elif method == \"session/tokenUsage\":\n2265|                raw = params.get(\"usage\")\n2266|                if isinstance(raw, dict):\n2267|                    usage.update(raw)\n2268|\n2269|        self._handle_event = _handle_event\n(more lines below)","final_result":true}}}
