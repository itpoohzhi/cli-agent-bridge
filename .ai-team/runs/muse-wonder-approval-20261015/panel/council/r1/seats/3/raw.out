{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a9","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":175,"recorded_at":1780531400000345,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"call_id":"call_01a1439164fd72da877ea3376316076d","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(139 line(s) above)\n140|\n141|# --- REQ-MUSE-002/003/004 (пакет a4): approval, бюджеты, повторы, live ---\n142|APPROVAL_MODE = os.environ.get(\"MUSE_BRIDGE_APPROVAL_MODE\", \"allowAll\").strip()\n143|TRANSIENT_RETRY_SCOPE = os.environ.get(\n144|    \"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE\", \"pre-action\"\n145|).strip()\n146|FINISH_RESERVE_S = 35.0\n147|CLOSE_RESERVE_S = 12.0\n148|REQUEST_CAP_S = 1800.0\n149|MIN_ATTEMPT_REMAINING_S = float(os.environ.get(\"MUSE_BRIDGE_MIN_ATTEMPT_S\", \"120\"))\n150|CONTROL_WRITE_TIMEOUT_S = 5.0\n151|LIVE_WRITE_TIMEOUT_S = 3.0\n152|APPROVAL_CANCEL_GRACE_S = 15.0\n153|MAX_APPROVAL_DECIDE = 10\n154|MAX_USER_INPUT_CANCEL = 3\n155|TRANSIENT_MAX_RETRIES = 2\n156|TRANSIENT_BACKOFF_S: tuple[float, float] = (2.0, 4.0)\n157|TRANSIENT_JITTER_S = 1.0\n158|TRANSIENT_MARKERS: tuple[str, ...] = (\n159|    \"[net-timeout]\",\n160|    \"timed out waiting for response data\",\n161|    NETWORK_RETRY_MARKER,\n162|    \"transport_connect_unreachable\",\n163|)\n164|NON_RETRYABLE_STATES = frozenset(\n165|    {\"timeout\", \"spawn_failed\", \"launcher_missing\", \"client_gone\"}\n166|)\n167|\n168|\n169|def _validate_startup_config() -> None:\n170|    \"\"\"Невалидный env-режим или бюджет останавливают старт моста (AD-007).\"\"\"\n171|    if APPROVAL_MODE not in (\"allowAll\", \"denyUnmatched\"):\n172|        raise RuntimeError(f\"MUSE_BRIDGE_APPROVAL_MODE invalid: {APPROVAL_MODE!r}\")\n173|    if TRANSIENT_RETRY_SCOPE not in (\"pre-action\", \"observed-items\"):\n174|        raise RuntimeError(\n175|            f\"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE invalid: {TRANSIENT_RETRY_SCOPE!r}\"\n176|        )\n177|    if TIMEOUT_S < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S:\n178|        raise RuntimeError(\n179|            \"MUSE_BRIDGE_TIMEOUT_S too small: \"\n180|            f\"{TIMEOUT_S} < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S \"\n181|            f\"({FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S})\"\n182|        )\n183|\n184|\n185|_validate_startup_config()\n186|\n187|\n188|def _is_transient_text(*values: Any) -> bool:\n189|    \"\"\"Классификация транзиента только по явным маркерам (§3.1 пакета).\"\"\"\n190|    for value in values:\n191|        if value is None:\n192|            continue\n193|        if isinstance(value, str):\n194|            text = value\n195|        elif isinstance(value, (list, tuple)):\n196|            if _is_transient_text(*value):\n197|                return True\n198|            continue\n199|        elif isinstance(value, dict):\n200|            text = \" \".join(\n201|                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n202|            )\n203|            if not text.strip():\n204|                text = str(value)\n205|        else:\n206|            text = str(value)\n207|        if any(marker in text for marker in TRANSIENT_MARKERS):\n208|            return True\n209|    return False\n210|\n211|\n212|_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n213|_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n214|\n215|\n216|def _render_audit_token(value: Any) -> str:\n217|    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n218|    text = value if isinstance(value, str) else \"\"\n219|    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n220|        return text\n221|    raw = text if isinstance(value, str) else str(value or \"\")\n222|    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n223|    return f\"redacted(len={len(raw)},sha256={digest})\"\n224|\n225|\n226|def _render_tool_token(value: Any) -> str:\n227|    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n228|    text = value if isinstance(value, str) else \"\"\n229|    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n230|        return text\n231|    return f\"redacted(len={len(text)})\"\n232|\n233|\n234|class ApprovalPolicy:\n235|    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n236|\n237|    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n238|    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n239|    \"\"\"\n240|\n241|    def __init__(self, mode: str) -> None:\n242|        self.mode = mode\n243|\n244|    @staticmethod\n245|    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n246|        raw = params.get(\"availableChoices\")\n247|        if not isinstance(raw, list):\n248|            return []\n249|        return [c for c in raw if isinstance(c, dict)]\n250|\n251|    @staticmethod\n252|    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n253|        if not params:\n254|            return None\n255|        for choice in ApprovalPolicy._choices(params):\n256|            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n257|                return choice\n258|        return None\n259|\n260|    def evaluate(self, params: dict[str, Any]) -> dict[str, Any]:\n261|        choices = self._choices(params)\n262|        approve = next(\n263|            (c for c in choices if c.get(\"decision\") == \"approved\"), None\n264|        ) or next(\n265|            (c for c in choices if c.get(\"decision\") == \"approvedForSession\"), None\n266|        )\n267|        deny = self.deny_choice(params)\n268|        action = \"fail_turn\"\n269|        chosen: dict[str, Any] | None = None\n270|        if self.mode == \"allowAll\" and approve is not None:\n271|            action, chosen = \"approve\", approve\n272|        elif deny is not None:\n273|            action, chosen = \"deny\", deny\n274|        subject = (\n275|            params.get(\"subject\") if isinstance(params.get(\"subject\"), dict) else {}\n276|        )\n277|        choice_ids = \",\".join(\n278|            _render_audit_token(c.get(\"choiceId\")) for c in choices[:8]\n279|        )\n280|        audit = (\n281|            \"approval_decide \"\n282|            f\"tool={_render_audit_token(params.get('toolName'))} \"\n283|            f\"subject={_render_audit_token(subject.get('kind'))} \"\n284|            f\"protected={1 if params.get('protectedWrite') else 0} \"\n285|            f\"judge={1 if params.get('judgeEscalated') else 0} \"\n286|            f\"choices=[{choice_ids}] \"\n287|            f\"chosen={_render_audit_token(chosen.get('choiceId')) if chosen else 'none'} \"\n288|            f\"decision={_render_audit_token(chosen.get('decision')) if chosen else 'none'}\"\n289|        )\n290|        return {\n291|            \"action\": action,\n292|            \"choice_id\": chosen.get(\"choiceId\") if chosen else None,\n293|            \"decision\": chosen.get(\"decision\") if chosen else None,\n294|            \"audit\": audit,\n295|        }\n296|\n297|    def evaluate_user_input(self, params: dict[str, Any]) -> dict[str, Any]:\n298|        return {\n299|            \"action\": \"cancel_user_input\",\n300|            \"audit\": (\n301|                f\"user_input_cancel tool={_render_audit_token(params.get('toolName'))}\"\n302|            ),\n303|        }\n304|\n305|\n306|class ServeUnavailable(Exception):\n307|    \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n308|\n309|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ab","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":176,"recorded_at":1780531400000347,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"call_id":"call_01a14391681a76fba7b7d21bb2c49a29","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(2539 line(s) above)\n2540|    def _sse_write(\n2541|        self, text: str, *, keepalive: bool = False, mark_content: bool = False\n2542|    ) -> bool:\n2543|        \"\"\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\n2544|\n2545|        Ожидание замка, запись и flush делят единый остаток; исчерпание =\n2546|        зависший клиент (client_gone + killpg). Действует на всех писателей.\n2547|        \"\"\"\n2548|        started = time.monotonic()\n2549|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2550|        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\n2551|        if limit <= started:\n2552|            if not self._client_gone:\n2553|                self._client_gone = True\n2554|                self._delivery_failed = True\n2555|                _log(\"delivery_deadline write budget exhausted before frame\")\n2556|                self._kill_current_run()\n2557|            return False\n2558|        if not self._wlock.acquire(timeout=max(0.0, limit - time.monotonic())):\n2559|            if not self._client_gone:\n2560|                self._client_gone = True\n2561|                self._delivery_failed = True\n2562|                _log(\"client gone mid-stream (sse lock wait budget)\")\n2563|                self._kill_current_run()\n2564|            return False\n2565|        try:\n2566|            if self._sse_phase == \"CLOSED\" or self._client_gone:\n2567|                return False\n2568|            if keepalive and (\n2569|                self._sse_phase != \"OPEN\"\n2570|                or (self._keepalive_stop is not None and self._keepalive_stop.is_set())\n2571|            ):\n2572|                return False\n2573|            if time.monotonic() >= limit:\n2574|                raise TimeoutError(\"sse write budget exhausted\")\n2575|            if mark_content:\n2576|                self._content_started = True\n2577|            conn = getattr(self, \"connection\", None)\n2578|            prev_timeout: Any = None\n2579|            have_conn = False\n2580|            if conn is not None and hasattr(conn, \"settimeout\"):\n2581|                try:\n2582|                    prev_timeout = conn.gettimeout()\n2583|                    conn.settimeout(max(0.001, limit - time.monotonic()))\n2584|                    have_conn = True\n2585|                except (OSError, ValueError, AttributeError):\n2586|                    have_conn = False\n2587|            try:\n2588|                self.wfile.write(text.encode(\"utf-8\"))\n2589|                if have_conn:\n2590|                    try:\n2591|                        conn.settimeout(max(0.001, limit - time.monotonic()))\n2592|                    except (OSError, ValueError, AttributeError):\n2593|                        pass\n2594|                self.wfile.flush()\n2595|            finally:\n2596|                if text == \"data: [DONE]\\n\\n\":\n2597|                    self._sse_phase = \"CLOSED\"\n2598|                if have_conn:\n2599|                    try:\n2600|                        conn.settimeout(prev_timeout)\n2601|                    except (OSError, ValueError, AttributeError):\n2602|                        pass\n2603|            return True\n2604|        except (BrokenPipeError, ConnectionResetError, OSError):\n2605|            if not self._client_gone:\n2606|                self._client_gone = True\n2607|                self._delivery_failed = True\n2608|                _log(\"client gone mid-stream\")\n2609|                self._kill_current_run()\n2610|            return False\n2611|        finally:\n2612|            self._wlock.release()\n2613|\n2614|    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n2615|        return {\n2616|            \"id\": self._sse_id,\n2617|            \"object\": \"chat.completion.chunk\",\n2618|            \"created\": self._sse_created,\n2619|            \"model\": self._sse_model,\n2620|            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n2621|        }\n2622|\n2623|    def _sse_emit(\n2624|        self, obj: dict, *, keepalive: bool = False, mark_content: bool = False\n2625|    ) -> bool:\n2626|        return self._sse_write(\n2627|            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\",\n2628|            keepalive=keepalive,\n2629|            mark_content=mark_content,\n2630|        )\n2631|\n2632|    def _live_reasoning_sink(self, full_text: str) -> bool:\n2633|        \"\"\"Sink ServeRun: публикует только прирост summary.0 до заморозки.\"\"\"\n2634|        if not full_text or not getattr(self, \"_sse_open\", False):\n2635|            return True\n2636|        sent = getattr(self, \"_live_sent_text\", \"\")\n2637|        if full_text == sent or not full_text.startswith(sent):\n2638|            return True\n2639|        delta = full_text[len(sent) :]\n2640|        if not delta:\n2641|            return True\n2642|        ok = self._sse_emit(\n2643|            self._sse_chunk({\"reasoning_content\": delta}), mark_content=True\n2644|        )\n2645|        if ok:\n2646|            self._live_sent_text = full_text\n2647|        return ok\n2648|\n2649|    def _force_close_connection(self) -> None:\n2650|        \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n2651|        self._client_gone = True\n2652|        conn = getattr(self, \"connection\", None)\n2653|        if conn is None:\n2654|            return\n2655|        try:\n2656|            conn.shutdown(socket.SHUT_RDWR)\n2657|        except (OSError, ValueError, AttributeError):\n2658|            pass\n2659|        try:\n2660|            conn.close()\n2661|        except (OSError, ValueError, AttributeError):\n2662|            pass\n2663|\n2664|    def _sse_begin(self, model: str) -> bool:\n2665|        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n2666|        if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2667|            self._delivery_failed = True\n2668|            self._client_gone = True\n2669|            return False\n2670|        self._live_sent_text = \"\"\n2671|        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n2672|        self._sse_created = int(time.time())\n2673|        self._sse_model = model\n2674|        with self._wlock:\n2675|            self._sse_phase = \"OPEN\"\n2676|        self.close_connection = True\n2677|        try:\n2678|            self.send_response(200)\n2679|            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n2680|            self.send_header(\"Cache-Control\", \"no-cache\")\n2681|            self.send_header(\"Connection\", \"close\")\n2682|            self.send_header(\"X-Accel-Buffering\", \"no\")\n2683|            self.end_headers()\n2684|        except (BrokenPipeError, ConnectionResetError, OSError):\n2685|            self._client_gone = True\n2686|            _log(\"client gone before headers\")\n2687|            return False\n2688|        self._sse_open = True\n2689|        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n2690|            return False\n2691|        stop = threading.Event()\n2692|        self._keepalive_stop = stop\n2693|        self._ka_thread = threading.Thread(\n2694|            target=self._keepalive_loop, args=(stop,), daemon=True\n2695|        )\n2696|        self._ka_thread.start()\n2697|        return True\n2698|\n2699|    def _keepalive_loop(self, stop: threading.Event) -> None:\n2700|        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n2701|        while not stop.wait(KEEPALIVE_S):\n2702|            if self._client_gone or stop.is_set():\n2703|                return\n2704|            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n2705|                return\n2706|\n2707|    def _sse_stop_keepalive(self) -> None:\n2708|        if self._keepalive_stop is not None:\n2709|            self._keepalive_stop.set()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
