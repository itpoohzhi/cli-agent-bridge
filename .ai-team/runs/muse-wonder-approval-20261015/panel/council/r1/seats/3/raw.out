\n56| \n57| from __future__ import annotations\n58| \n59|+import hashlib\n60| import json\n61| import logging\n62| import os\n63|@@ -137,6 +138,170 @@ _SIGNAL_RCS = (\n64| TERMINAL_EXIT_GRACE_S = 0.5\n65| SERVE_SPAWN_TIMEOUT_S = 30.0  # handshake+session/start должны уложиться сюда\n66| \n67|+# --- REQ-MUSE-002/003/004 (пакет a4): approval, бюджеты, повторы, live ---\n68|+APPROVAL_MODE = os.environ.get(\"MUSE_BRIDGE_APPROVAL_MODE\", \"allowAll\").strip()\n69|+TRANSIENT_RETRY_SCOPE = os.environ.get(\n70|+    \"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE\", \"pre-action\"\n71|+).strip()\n72|+FINISH_RESERVE_S = 35.0\n73|+CLOSE_RESERVE_S = 12.0\n74|+REQUEST_CAP_S = 1800.0\n75|+MIN_ATTEMPT_REMAINING_S = float(os.environ.get(\"MUSE_BRIDGE_MIN_ATTEMPT_S\", \"120\"))\n76|+CONTROL_WRITE_TIMEOUT_S = 5.0\n77|+LIVE_WRITE_TIMEOUT_S = 3.0\n78|+APPROVAL_CANCEL_GRACE_S = 15.0\n79|+MAX_APPROVAL_DECIDE = 10\n80|+MAX_USER_INPUT_CANCEL = 3\n81|+TRANSIENT_MAX_RETRIES = 2\n82|+TRANSIENT_BACKOFF_S: tuple[float, float] = (2.0, 4.0)\n83|+TRANSIENT_JITTER_S = 1.0\n84|+TRANSIENT_MARKERS: tuple[str, ...] = (\n85|+    \"[net-timeout]\",\n86|+    \"timed out waiting for response data\",\n87|+    NETWORK_RETRY_MARKER,\n88|+    \"transport_connect_unreachable\",\n89|+)\n90|+NON_RETRYABLE_STATES = frozenset(\n91|+    {\"timeout\", \"spawn_failed\", \"launcher_missing\", \"client_gone\"}\n92|+)\n93|+\n94|+\n95|+def _validate_startup_config() -> None:\n96|+    \"\"\"Невалидный env-режим или бюджет останавливают старт моста (AD-007).\"\"\"\n97|+    if APPROVAL_MODE not in (\"allowAll\", \"denyUnmatched\"):\n98|+        raise RuntimeError(f\"MUSE_BRIDGE_APPROVAL_MODE invalid: {APPROVAL_MODE!r}\")\n99|+    if TRANSIENT_RETRY_SCOPE not in (\"pre-action\", \"observed-items\"):\n100|+        raise RuntimeError(\n101|+            f\"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE invalid: {TRANSIENT_RETRY_SCOPE!r}\"\n102|+        )\n103|+    if TIMEOUT_S < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S:\n104|+        raise RuntimeError(\n105|+            \"MUSE_BRIDGE_TIMEOUT_S too small: \"\n106|+            f\"{TIMEOUT_S} < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S \"\n107|+            f\"({FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S})\"\n108|+        )\n109|+\n110|+\n111|+_validate_startup_config()\n112|+\n113|+\n114|+def _is_transient_text(*values: Any) -> bool:\n115|+    \"\"\"Классификация транзиента только по явным маркерам (§3.1 пакета).\"\"\"\n116|+    for value in values:\n117|+        if value is None:\n118|+            continue\n119|+        if isinstance(value, str):\n120|+            text = value\n121|+        elif isinstance(value, (list, tuple)):\n122|+            if _is_transient_text(*value):\n123|+                return True\n124|+            continue\n125|+        elif isinstance(value, dict):\n126|+            text = \" \".join(\n127|+                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n128|+            )\n129|+            if not text.strip():\n130|+                text = str(value)\n131|+        else:\n132|+            text = str(value)\n133|+        if any(marker in text for marker in TRANSIENT_MARKERS):\n134|+            return True\n135|+    return False\n136|+\n137|+\n138|+_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n139|+_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n140|+\n141|+\n142|+def _render_audit_token(value: Any) -> str:\n143|+    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n144|+    text = value if isinstance(value, str) else \"\"\n145|+    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n146|+        return text\n147|+    raw = text if isinstance(value, str) else str(value or \"\")\n148|+    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n149|+    return f\"redacted(len={len(raw)},sha256={digest})\"\n150|+\n151|+\n152|+def _render_tool_token(value: Any) -> str:\n153|+    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n154|+    text = value if isinstance(value, str) else \"\"\n155|+    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n156|+        return text\n157|+    return f\"redacted(len={len(text)})\"\n158|+\n159|+\n160|+class ApprovalPolicy:\n161|+    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n162|+\n163|+    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n164|+    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n165|+    \"\"\"\n166|+\n167|+    def __init__(self, mode: str) -> None:\n168|+        self.mode = mode\n169|+\n170|+    @staticmethod\n171|+    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n172|+        raw = params.get(\"availableChoices\")\n173|+        if not isinstance(raw, list):\n174|+            return []\n175|+        return [c for c in raw if isinstance(c, dict)]\n176|+\n177|+    @staticmethod\n178|+    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n179|+        if not params:\n180|+            return None\n181|+        for choice in ApprovalPolicy._choices(params):\n182|+            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n183|+                return choice\n184|+        return None\n185|+\n186|+    def evaluate(self, params: dict[str, Any]) -> dict[str, Any]:\n187|+        choices = self._choices(params)\n188|+        approve = next(\n189|+            (c for c in choices if c.get(\"decision\") == \"approved\"), None\n190|+        ) or next(\n191|+            (c for c in choices if c.get(\"decision\") == \"approvedForSession\"), None\n192|+        )\n193|+        deny = self.deny_choice(params)\n194|+        action = \"fail_turn\"\n195|+        chosen: dict[str, Any] | None = None\n196|+        if self.mode == \"allowAll\" and approve is not None:\n197|+            action, chosen = \"approve\", approve\n198|+        elif deny is not None:\n199|+            action, chosen = \"deny\", deny\n200|+        subject = (\n201|+            params.get(\"subject\") if isinstance(params.get(\"subject\"), dict) else {}\n202|+        )\n203|+        choice_ids = \",\".join(\n204|+            _render_audit_token(c.get(\"choiceId\")) for c in choices[:8]\n205|+        )\n206|+        audit = (\n207|+            \"approval_decide \"\n208|+            f\"tool={_render_audit_token(params.get('toolName'))} \"\n209|+            f\"subject={_render_audit_token(subject.get('kind'))} \"\n210|+            f\"protected={1 if params.get('protectedWrite') else 0} \"\n211|+            f\"judge={1 if params.get('judgeEscalated') else 0} \"\n212|+            f\"choices=[{choice_ids}] \"\n213|+            f\"chosen={_render_audit_token(chosen.get('choiceId')) if chosen else 'none'} \"\n214|+            f\"decision={_render_audit_token(chosen.get('decision')) if chosen else 'none'}\"\n215|+        )\n216|+        return {\n217|+            \"action\": action,\n218|+            \"choice_id\": chosen.get(\"choiceId\") if chosen else None,\n219|+            \"decision\": chosen.get(\"decision\") if chosen else None,\n220|+            \"audit\": audit,\n221|+        }\n222|+\n223|+    def evaluate_user_input(self, params: dict[str, Any]) -> dict[str, Any]:\n224|+        return {\n225|+            \"action\": \"cancel_user_input\",\n226|+            \"audit\": (\n227|+                f\"user_input_cancel tool={_render_audit_token(params.get('toolName'))}\"\n228|+            ),\n229|+        }\n230|+\n231| \n232| class ServeUnavailable(Exception):\n233|     \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n234|@@ -1332,6 +1497,11 @@ class Run:\n235|         self.dead_confirmed = (\n236|             True  # False — группа не подтверждена мёртвой (карантин слота)\n237|         )\n238|+        # Барьеры AD-003: exec защёлкивает ACTION_POSSIBLE при старте процесса.\n239|+        self.action_possible = False\n240|+        self.approval_seen = False\n241|+        self.observed_barrier = False\n242|+        self.exec_deadline = float(\"inf\")\n243| \n244|     def close(self) -> None:\n245|         \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n246|@@ -1438,6 +1608,7 @@ class Run:\n247|                     \"err\": f\"spawn failed: {exc}\",\n248|                     \"state\": \"spawn_failed\",\n249|                 }\n250|+            self.action_possible = True\n251| \n252|             def drain_stderr() -> None:\n253|                 try:\n254|@@ -1453,8 +1624,11 @@ class Run:\n255|             err_thread.start()\n256| \n257|             # Жёсткий дедлайн: таймер убивает процесс, даже если stdout молчит.\n258|+            _remain = self.exec_deadline - time.monotonic()\n259|+            _timer_s = min(TIMEOUT_S, _remain) if _remain != float(\"inf\") else TIMEOUT_S\n260|             timer = threading.Timer(\n261|-                TIMEOUT_S, lambda: (err_lines.append(\"bridge timeout\"), self.close())\n262|+                max(0.05, _timer_s),\n263|+                lambda: (err_lines.append(\"bridge timeout\"), self.close()),\n264|             )\n265|             timer.daemon = True\n266|             timer.start()\n267|@@ -1556,25 +1730,29 @@ class Run:\n268|             \"err\": \"\\n\".join(err_lines[-6:]),\n269|             \"state\": state,\n270|             \"hard_threshold\": _has_hard_threshold_marker(err_lines, reason),\n271|+            \"action_possible\": self.action_possible,\n272|+            \"approval_seen\": False,\n273|+            \"observed_barrier\": bool(text),\n274|+            \"transient\": state != \"ok\" and _is_transient_text(err_lines, reason),\n275|         }\n276| \n277| \n278| class ServeRun:\n279|     \"\"\"Один запрос через `muse serve` (MSP v1 по stdio, NDJSON JSON-RPC).\n280| \n281|-    Поток (проверен офлайн на echo-провайдере 05.10.2026): initialize ->\n282|-    notify initialized -> session/start (без approvalMode: любое явное\n283|-    значение режектится startup ceiling; провайдер meta)\n284|-    провайдер meta) -> turn/start (reasoningEffort=тир) -> ждём turn/completed.\n285|+    Поток: initialize -> notify initialized -> session/start\n286|+    (approvalMode из AD-001/AD-007; провайдер meta) -> turn/start\n287|+    (reasoningEffort=тир) -> ждём turn/completed; остаточные\n288|+    approval/userInput обрабатывает ApprovalPolicy в том же ходе (AD-002).\n289|     Текст — из agentMessage (item/completed.text, fallback — item/delta);\n290|     reasoning summaries — из reasoning-item (summary[] + item/delta\n291|     field \"summary.N\"); токены — из session/tokenUsage (reasoningTokens\n292|     включительно). Сырой reasoning-текст в v1 не стримится (только\n293|     summaries) — ограничение протокола, не моста.\n294| \n295|-    Любая транспортная неполадка (спавн, handshake, таймаут, интерактивный\n296|-    запрос approval/userInput, JSON-RPC error) -> ServeUnavailable, и\n297|-    вызывающий код тихо идёт на exec. Ошибка самой модели\n298|+    Транспортная неполадка до ACTION_POSSIBLE -> ServeUnavailable;\n299|+    допуск exec-fallback решает единый предикат Handler (AD-003).\n300|+    Ошибка самой модели\n301|     (terminal != completed) — НЕ ServeUnavailable: ход реально выполнен,\n302|     fallback лишь удвоил бы вызов.\n303|     \"\"\"\n304|@@ -1595,6 +1773,26 @@ class ServeRun:\n305|         # Запись в stdin serve ограничена дедлайном (ставится в execute): зависший читатель\n306|         # не держит слот бессрочно, при истечении ход завершается, группа убивается.\n307|         self._write_until = float(\"inf\")\n308|+        # Барьеры и состояние approval/повторов (AD-002/AD-003, пакет a4).\n309|+        self.approval_seen = False\n310|+        self.action_possible = False\n311|+        self.allowing_decide_attempted = False\n312|+        self.approval_degraded = False\n313|+        self.degraded_at: float | None = None\n314|+        self.grace_end: float | None = None\n315|+        self.observed_barrier = False\n316|+        self.tool_item_count = 0\n317|+        self.decide_count = 0\n318|+        self.user_input_cancel_count = 0\n319|+        self.ceiling_seen = False\n320|+        self.server_version = \"?\"\n321|+        self.last_error_text = \"\"\n322|+        self.live_sink: Any = None\n323|+        self.exec_deadline = float(\"inf\")\n324|+        self.write_deadline = float(\"inf\")\n325|+        self.request_deadline = float(\"inf\")\n326|+        self.turn_started_at: float | None = None\n327|+        self._live_frozen = False\n328| \n329|     def close(self) -> None:\n330|         \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n331|@@ -1603,23 +1801,24 @@ class ServeRun:\n332|             return\n333|         _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n334| \n335|-    def _send(\n336|-        self, method: str, params: dict | None = None, notify: bool = False\n337|-    ) -> int:\n338|+    def _control_limit(self) -> float:\n339|+        limit = min(\n340|+            self._write_until,\n341|+            time.monotonic() + CONTROL_WRITE_TIMEOUT_S,\n342|+            self.exec_deadline,\n343|+        )\n344|+        if self.grace_end is not None:\n345|+            limit = min(limit, self.grace_end)\n346|+        return limit\n347|+\n348|+    def _write_bytes(self, data: bytes, limit: float) -> None:\n349|         assert self.proc is not None and self.proc.stdin is not None\n350|-        self._rid += 1\n351|-        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n352|-        if not notify:\n353|-            msg[\"id\"] = self._rid\n354|-        if params is not None:\n355|-            msg[\"params\"] = params\n356|-        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n357|         try:\n358|             fd = self.proc.stdin.fileno()\n359|             view = memoryview(data)\n360|             sent = 0\n361|             while sent < len(data):\n362|-                remaining = self._write_until - time.time()\n363|+                remaining = limit - time.monotonic()\n364|                 if remaining <= 0:\n365|                     raise ServeUnavailable(\n366|                         \"serve stdin write timed out: child does not read\"\n367|@@ -1631,10 +1830,40 @@ class ServeRun:\n368|                     sent += os.write(fd, view[sent:])\n369|                 except BlockingIOError:\n370|                     continue\n371|+        except ServeUnavailable:\n372|+            raise\n373|         except (OSError, ValueError) as exc:\n374|             raise ServeUnavailable(f\"stdio write failed: {exc}\")\n375|+\n376|+    def _send(\n377|+        self,\n378|+        method: str,\n379|+        params: dict | None = None,\n380|+        notify: bool = False,\n381|+        *,\n382|+        control: bool = False,\n383|+    ) -> int:\n384|+        self._rid += 1\n385|+        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n386|+        if not notify:\n387|+            msg[\"id\"] = self._rid\n388|+        if params is not None:\n389|+            msg[\"params\"] = params\n390|+        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n391|+        self._write_bytes(data, self._control_limit() if control else self._write_until)\n392|         return self._rid\n393| \n394|+    def _send_response(self, server_id: Any, result: dict) -> None:\n395|+        \"\"\"Receipt по серверному id дословно (AD-002).\"\"\"\n396|+        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"id\": server_id, \"result\": result}\n397|+        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n398|+        self._write_bytes(data, self._control_limit())\n399|+\n400|+    def _note_allowing_decide(self) -> None:\n401|+        \"\"\"Защёлкивание ДО первой попытки записи разрешающего decide (a4).\"\"\"\n402|+        self.allowing_decide_attempted = True\n403|+        self.action_possible = True\n404|+\n405|     def execute(self) -> dict[str, Any]:\n406|         if not os.access(MUSE_WRAPPER, os.X_OK):\n407|             raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n408|@@ -1693,8 +1922,16 @@ class ServeRun:\n409| \n410|         err_thread = threading.Thread(target=drain_stderr, daemon=True)\n411|         err_thread.start()\n412|-        deadline = time.time() + TIMEOUT_S\n413|-        setup_deadline = time.time() + SERVE_SPAWN_TIMEOUT_S\n414|+        _now0 = time.monotonic()\n415|+        _exec_dl = self.exec_deadline\n416|+        deadline = (\n417|+            min(_now0 + TIMEOUT_S, _exec_dl)\n418|+            if _exec_dl != float(\"inf\")\n419|+            else _now0 + TIMEOUT_S\n420|+        )\n421|+        if self.exec_deadline == float(\"inf\"):\n422|+            self.exec_deadline = deadline\n423|+        setup_deadline = min(_now0 + SERVE_SPAWN_TIMEOUT_S, deadline)\n424|         self._write_until = setup_deadline\n425| \n426|         # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n427|@@ -1702,12 +1939,15 @@ class ServeRun:\n428|         rbuf = bytearray()\n429| \n430|         def read_msg(timeout_at: float) -> dict[str, Any]:\n431|-            while time.time() < min(timeout_at, deadline):\n432|+            while time.monotonic() < timeout_at:\n433|                 if self.proc is None or self.proc.stdout is None:\n434|                     raise ServeUnavailable(\"serve stdout closed\")\n435|                 newline = rbuf.find(b\"\\n\")\n436|                 if newline < 0:\n437|-                    ready, _, _ = select.select([self.proc.stdout], [], [], 0.5)\n438|+                    _remain = max(0.0, timeout_at - time.monotonic())\n439|+                    ready, _, _ = select.select(\n440|+                        [self.proc.stdout], [], [], min(0.5, _remain)\n441|+                    )\n442|                     if not ready:\n443|                         if self.proc.poll() is not None:\n444|                             raise ServeUnavailable(\n445|@@ -1735,16 +1975,6 @@ class ServeRun:\n446|                     return msg\n447|             raise ServeUnavailable(\"serve read timeout\")\n448| \n449|-        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n450|-            while True:\n451|-                msg = read_msg(timeout_at)\n452|-                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n453|-                    if \"error\" in msg:\n454|-                        raise ServeUnavailable(f\"serve RPC error: {msg['error']}\")\n455|-                    result = msg.get(\"result\")\n456|-                    return result if isinstance(result, dict) else {}\n457|-                self._handle_event(msg, None)\n458|-\n459|         kinds: dict[str, str] = {}\n460|         deltas: list[str] = []\n461|         summary_parts: dict[int, str] = {}\n462|@@ -1753,13 +1983,223 @@ class ServeRun:\n463|         usage: dict[str, Any] = {}\n464|         turn_id: str | None = None\n465|         session_id: str | None = None\n466|+        pending: dict[int, str] = {}\n467|+        seen_pairs: set[tuple[str, str]] = set()\n468|+        tool_item_ids: set[str] = set()\n469|+        last_snapshot: list[dict[str, Any]] = []\n470|+        transient_terminal = [False]\n471|+        first_summary_logged = [False]\n472|+\n473|+        def _pair_key(params: dict[str, Any]) -> tuple[str, str]:\n474|+            return (\n475|+                str(params.get(\"approvalId\") or \"\"),\n476|+                json.dumps(\n477|+                    params.get(\"currentRequirementId\"),\n478|+                    ensure_ascii=False,\n479|+                    sort_keys=True,\n480|+                    default=str,\n481|+                ),\n482|+            )\n483|+\n484|+        def _send_decide(\n485|+            snapshot: dict[str, Any], choice: dict[str, Any], *, allowing: bool\n486|+        ) -> None:\n487|+            if allowing:\n488|+                self._note_allowing_decide()\n489|+            self.decide_count += 1\n490|+            rid = self._send(\n491|+                \"approval/decide\",\n492|+                {\n493|+                    \"approvalId\": snapshot.get(\"approvalId\"),\n494|+                    \"choiceId\": choice.get(\"choiceId\"),\n495|+                    \"commandId\": _uuid7(),\n496|+                    \"requirementId\": snapshot.get(\"currentRequirementId\"),\n497|+                    \"sessionId\": snapshot.get(\"sessionId\") or session_id or \"\",\n498|+                },\n499|+                control=True,\n500|+            )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b9","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":55,"recorded_at":1780531400000105,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"call_id":"call_01a14390e9dd74898eb95e6bd03ce2af","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/muse-wonder-approval-20261015/architecture/arch-spec.md`.\n1|# Архитектурная спецификация: muse-bridge — approval без перезапуска хода, повтор net-timeout, живость долгих ходов\n2|\n3|Статус пакета: `APPROVED` (архитектурная delta a4 по F-001(a3)/F-002(a3), owner-blocking; это статус схемы пакета, НЕ вердикт новой панели. R18 и delta_a2/a3 — исторические входы. Повторный ARCH_GATE и новая панель a4 pending; Coder/MR не запускались. Трассировка: `delta_a4`, `architecture/delta-a4.md` и механические diffs к prev a3).\n4|Пакет: `.ai-team/runs/muse-wonder-approval-20261015/architecture/architecture-packet.json`.\n5|ADR политики: `architecture/proposals/docs/adr/0003-muse-serve-approval-allowall.md`\n6|(материализация в `docs/adr/0003-muse-serve-approval-allowall.md` оркестратором после approval).\n7|Нумерация: AD-001..AD-007, QA, BND, RISK, THREAT, VER — как в пакете; ссылки на находки арх-панели: `PF-a1-NNN` (проход a1) и `PF-a2-NNN` (проход a2), `PF-a3-001/002` (owner-blocking F-001(a3)/F-002(a3)), чтобы не путать с фактами `[F-NN]`; факты [F-NN] —\n8|`analysis/muse-wonder-approval-and-upstream-timeouts/evidence-ledger.md`;\n9|EVD-NNN — evidence пакета.\n10|\n11|## 0. Вход и свежесть фактов\n12|\n13|- Требования: REQ-MUSE-002 (ход не перезапускается при `approval/request` /\n14|  `userInput/request`), REQ-MUSE-003 (транзиентный `net-timeout` /\n15|  `transport_connect_unreachable` не доходит до пользователя провалом, если устраним\n16|  ограниченным повтором), REQ-MUSE-004 (признаки жизни и прогресс мышления в SSE).\n17|  Критичность S2: боевой мост `:9886` под launchd.\n18|- REQ-MUSE-001 (прунинг 400k/320k/200k) уже в рабочем дереве и наследуется без\n19|  пересмотра (AD-005).\n20|- Открытый блокер аналитика OPEN-07 (политика approval) закрыт владельцем\n21|  2026-10-15 05:44 MSK выбором `allowAll` (EVD-009, ASM-009 VALIDATED). Остальные\n22|  OPEN-01..06, 08, 09 — класса «можно продолжить», оформлены ASM-001..008 и Q-001..008.\n23|- Свежесть: факты ledger датированы 2026-10-15. Архитектор выборочно перепроверил по\n24|  коду путь+символ факты F-01 (`server.py:1757-1762`), F-08/F-31 (`:1824-1829`),\n25|  F-12 (`:114`, `:2438`), F-15 (`:65`, `:138`, `:1696`), F-16/F-17 (`:1185`,\n26|  `:2064-2070`, `:2172-2175`), F-20 (тесты `:1181-1185`, `:1278-1305`), F-49\n27|  (`:87-88`, `:2464`) — строки и поведение совпадают с ledger. Версия CLI на машине\n28|  1.4.8-R6256.1 (`muse-cli.sh --version`, 2026-10-15).\n29|- Проектных файлов правил (`AGENTS.md`, `.agents/`, `CLAUDE.md`) в репозитории нет;\n30|  канон репозитория для этого изменения — сам код, `docs/adr/` (формат ADR-full\n31|  0001/0002), `ruff.toml` (E4/E7/E9/F), `pyrightconfig.json` и прошлый пакет\n32|  REQ-MUSE-001. `pyproject.toml` отсутствует, тесты запускаются через\n33|  `uv run --no-project --with pytest`.\n34|\n35|## 1. Контекст, фактическая система и замороженное\n36|\n37|Фактический стек: один файл `bridges/muse-bridge/server.py` (2744 строки, stdlib,\n38|`ThreadingHTTPServer`, потоки). Командное слоение Litestar/FastAPI из Python-overlay\n39|к этому репозиторию не применяется; границы пакета описывают реальное устройство\n40|(`Handler`, `ServeRun`, `Run`), новые слои и зависимости не вводятся.\n41|\n42|Потоки as-is (каждый подтверждён evidence пакета):\n43|\n44|```text\n45|DSH (OpenAI SSE, timeout 1900 c, maxRetries 0)\n46|  -> muse-bridge 127.0.0.1:9886 (Handler, MAX_CONCURRENT=2)\n47|       -> ServeRun: muse serve по stdio MSP, процесс на запрос,\n48|          --disable-write --disable-shell --trust-workspace --no-session-log\n49|       -> Run (fallback и прямой путь): muse exec --yolo --disable-write\n50|          --disable-shell --disable-web-tools --disable-reminders\n51|  -> muse-cli.sh -> прокси 127.0.0.1:10816 -> ProxyRack -> Meta\n52|```\n53|\n54|Заморожено (AD-005): внешний контракт `/v1/chat/completions`, `/health`,\n55|`/v1/models` (формы, коды, окна моделей); профили DSH; флаги безопасности обоих\n56|путей; песочница включена (`--disable-sandbox` не появляется). Единственная\n57|контрактная дельта — CD-001: фрагментация существующего `delta.reasoning_content`\n58|на несколько кадров (§4). Поле `approvalMode` уходит только во внутренний MSP\n59|между мостом и serve и клиенту не видно.\n60|\n61|Измеренный baseline, на который опираются QA (без выдуманных NFR):\n62|\n63|| Величина | Значение | Источник |\n64||---|---|---|\n65|| Ход wonder до approval | 275 с, 412 с | EVD-003 |\n66|| Повтор exec после approval | 455 с до net-timeout; 2242 с до client gone | EVD-003 |\n67|| Net-timeout | 20 с (low и max), 452 с, бенч 31.5 с | EVD-011 |\n68|| Успешные ходы бенча max | 100 KB 51.1 с; 400 KB 251.2 с; 800 KB 281.3 с | EVD-011 |\n69|| Длинные serve-ходы wonder | 205 с, 232 с, 237 с | EVD-011 |\n70|| Keepalive клиенту | пустой data-чанк каждые 15 с | EVD-014 |\n71|| Дедлайн хода моста / handshake | 1800 с / 30 с | EVD-013 |\n72|| Клиентские пределы DSH | 1900 с общий и idle, повторов нет | EVD-016 |\n73|| Тестовый baseline | 67 passed; basedpyright 0 errors, 1448 warnings | task envelope |\n74|\n75|## 2. REQ-MUSE-002: approval без перезапуска хода\n76|\n77|Решения: AD-001 (политика, APPROVED владельцем), AD-002 (внутриходовая обработка, APPROVED),\n78|AD-006 (потолок версии без обхода, APPROVED), AD-007 (env-переключатель режима, APPROVED). Границы: BND-001, BND-002.\n79|\n80|### 2.1 Последовательность хода (VIEW-001)\n81|\n82|```text\n83|ServeRun: spawn serve (флаги без изменений)\n84|  initialize -> лог serverInfo.version + schema fingerprint (уже есть)\n85|  initialized (notify)\n86|  session/start {commandId, workspaceRoot, providerId=meta, modelId,\n87|                 approvalMode=<AD-007, по умолчанию \"allowAll\">}\n88|    -> ошибка -32030: второго старта нет, ServeRun прерывается до turn/start\n89|       с warning; allowAll — ровно один exec-fallback Handler (AD-006, без обхода\n90|       потолка), denyUnmatched — терминальный отказ без exec (AD-006, AD-007)\n91|    -> лог эффективного approvalMode из результата сессии\n92|  turn/start -> главный цикл чтения до turn/completed или дедлайна хода\n93|    approval/request (есть id):\n94|      1) ответ {\"id\": <тот же id>, \"result\": {}}        (receipt, EVD-006)\n95|      2) ApprovalPolicy(params) -> действие + аудит-запись\n96|      3) approval/decide по действию; результат наблюдается в главном цикле\n97|    approval/requested (нет id): тот же decide без receipt, дедупликация\n98|    userInput/request: receipt -> userInput/cancel по политике\n99|    turn/modelRetryScheduled: только лог (§4.3)\n100|    item/delta summary.N: накопление + live-sink (§4)\n101|```\n102|\n103|### 2.2 Граница ApprovalPolicy (BND-001)\n104|\n105|Чистое решение по снимку `params`, без I/O. Вход: поля снимка, которые политика\n106|вправе читать (`approvalId`, `currentRequirementId`, `availableChoices`,\n107|`sessionId`, `toolName`, `subject.kind`, `protectedWrite`, `judgeEscalated`;\n108|для userInput — `userInputId`, `sessionId`, `toolName`). `rawArgs`, тела вопросов\n109|и содержимое `subject` дальше `kind` политика не читает и никуда не пишет.\n110|Выход — ровно одно действие:\n111|\n112|- `approve(choiceId)` — выбор только из текущих `availableChoices`;\n113|- `deny(choiceId)` — выбор с `decision` равным `abort` или `denied` (только ветка\n114|  деградации §2.4);\n115|- `cancel_user_input` — для `userInput/request`;\n116|- `fail_turn` — разрешающего и отклоняющего выбора нет, транспорт завершает ход\n117|  через `turn/cancel`.\n118|\n119|Правило выбора разрешающего `choiceId` (детерминированно, по полю `decision`\n120|каждого элемента `availableChoices`, не по строке `choiceId`):\n121|\n122|1. первый выбор с `decision == \"approved\"`;\n123|2. иначе первый с `decision == \"approvedForSession\"`;\n124|3. `approvedPolicyAmendment` никогда не выбирается: смена политики выходит за\n125|   решение владельца (EVD-009 фиксирует режим сессии, а не правку политики);\n126|4. пустой или отсутствующий список, битый снимок — `fail_turn` ветки деградации.\n127|\n128|Аудит-запись действия строится здесь же и содержит только: метод, `toolName`,\n129|`subject.kind`, `protectedWrite`, `judgeEscalated`, список `choiceId` снимка,\n130|выбранный `choiceId` и его `decision`, счётчик решения в ходе. Транспорт пишет её одной\n131|строкой `_log` (редакция существующая). Свободные строки снимка рендерятся в лог\n132|ограниченно (FU-009): `toolName` и каждый `choiceId` — только при `[A-Za-z0-9_.:-]`\n133|и длине до 64, иначе `redacted` с длиной и префиксом sha256; список `choiceId`\n134|обрезан 8 значениями. Команда `decide` получает сырые значения без изменений.\n135|Approve политика выдаёт только при сконфигурированном `allowAll` (AD-007). Пример формы (значения иллюстративны):\n136|\n137|```text\n138|approval_decide tool=web_search subject=tool protected=0 judge=0 choices=[c1,c2] chosen=c1 decision=approved n=1\n139|```\n140|\n141|### 2.3 Транспорт decide в ServeRun (BND-002)\n142|\n143|- Receipt: ответ по серверному id дословно, result: {} (EVD-006). Уже получение approval/request|requested или userInput/request в setup либо внутри хода защёлкивает APPROVAL_SEEN/ACTION_POSSIBLE ДО receipt, дедупликации и выбора политики. Поэтому ошибка receipt/decide/cancel после события терминальна без любого нового serve/exec даже до turn/start; исключение также несёт агрегаты Handler. Точный барьер — §3.2 и AD-002/003.\n144|- `approval/decide` параметры: `approvalId` и `sessionId` из снимка,\n145|  `requirementId` — значение `currentRequirementId` снимка дословно (объект\n146|  `{approvalId, sourceIndex}` по схеме, мост его не конструирует и не правит),\n147|  `commandId` — существующий `_uuid7()`, `choiceId` — из политики. `feedback`\n148|  не отправляется.\n149|- Decide не ожидается рекурсивно внутри обработчика события: команда уходит,\n150|  её `result`/`error` разбирает главный цикл по `rid` моста. Голые ack чужих rid\n151|  по-прежнему игнорируются; `error` ожидающего decide ведёт в деградацию §2.4,\n152|  кроме `-32051 approvalAlreadyResolved`, который логируется и ход продолжается\n153|  (гонка request против requested). `result.terminal == false` ничего не требует:\n154|  обновлённый `approval/request` придёт обычным событием и пройдёт тот же путь.\n155|- Дедупликация: множество решённых пар (`approvalId`, дословное представление\n156|  `currentRequirementId`) на ход. Повтор той же пары из `approval/requested`\n157|  после `approval/request` второго decide не даёт.\n158|- Критично: дедлайн записи в stdin. Сегодня `self._write_until` равен\n159|  setup-дедлайну 30 с на весь `execute` (`server.py:1697-1698`), а approval в\n160|  инцидентах приходил на 275 с и 412 с. После записи `turn/start` граница\n161|  записи обязана стать дедлайном хода, иначе первый же decide упадёт в\n162|  `ServeUnavailable` и вернёт exec-рестарт. Тест T-A07 (§6) это закрепляет.\n163|- `userInput/request`: receipt, затем `userInput/cancel` с `commandId`,\n164|  `sessionId`, `userInputId` из снимка. `userInput/interrupt` не применяется:\n165|  по схеме он останавливает ход (EVD-006 через F-34), что противоречит REQ.\n166|  Результат cancel наблюдается главным циклом так же, как decide.\n167|- Уведомления `approval/updated`, `approval/resolved`,\n168|  `session/approvalModeChanged`, `userInput/settled` только разбираются без\n169|  действий (resolved допустимо логировать одной строкой без payload).\n170|\n171|### 2.4 Границы цикла и деградация\n172|\n173|На один ход: не более 10 `approval/decide` суммарно, **включая финальный\n174|отказной decide**, и не более 3 `userInput/cancel` (константы модуля, §8).\n175|Одиннадцатого decide не существует: при исчерпанном счёте деградация идёт сразу\n176|через `turn/cancel`. Обоснование меры 10 как в a1: порядок выше единичного\n177|наблюдения при жёстком пределе удержания слота; значение обратимо константой.\n178|\n179|Терминальное защёлкивание отказа (RW-006, единое правило PF-a2-011). Триггеры: нет\n180|разрешающего выбора; **любая** ошибка `approval/decide`, кроме benign `-32051`\n181|(коды схемы `[F-28]`: `-32050`, `-32052`, `-32053`, `-32054 approvalReviewerUnavailable`,\n182|`-32030 commandRejected`); **любая** ошибка `userInput/cancel`; превышение границы;\n183|ошибка либо превышение предела записи stdin после ACTION_POSSIBLE/APPROVAL_SEEN, включая setup. При первом триггере локальный исход хода\n184|фиксируется неуспешным ровно один раз: при наличии выбора `abort`/`denied` и\n185|свободном счёте уходит один такой decide, иначе один\n186|`turn/cancel {commandId, sessionId, turnId}`. После защёлкивания: новых\n187|разрешений и повторных входов в деградацию нет; дальнейшие `approval/request`\n188|и `userInput/request` только логируются без команд; любой ответ сервера —\n189|повторный request, `terminal=false`, успешный `turn/completed`, молчание —\n190|локальный исход не меняет, поздний успешный текст отбрасывается, частичный\n191|текст клиенту не уходит. Клиент получает ровно один терминальный исход\n192|существующим форматом (502 или SSE error, один `[DONE]`). Влияние denied и\n193|cancel на pending approval неизвестно (ASM-006) и опорой не служит.\n194|\n195|Grace после деградации (RW-008, PF-a2-003): `APPROVAL_CANCEL_GRACE_S=15` с\n196|(один интервал keepalive, ограничен общими E/W/D §3.3) отсчитывается по `time.monotonic()` от момента\n197|локального защёлкивания (`_approval_degraded=True`) и **включает саму попытку записи**\n198|`turn/cancel` или отказного decide в stdin: запись ограничена остатком grace,\n199|заблокированный stdin grace не продлевает. Запись любой управляющей команды (receipt,\n200|decide, cancel) ограничена `CONTROL_WRITE_TIMEOUT_S=5` с (ASM-012) и остатком до\n201|исполнительного дедлайна E; превышение защёлкивает деградацию. Grace не продлевает W/D (§3.3). По истечении grace —\n202|убийство группы процессов serve существующей механикой, терминальная ошибка,\n203|освобождение слота. Ожидания дедлайна 1800 с ради слота здесь нет: два\n204|проигнорировавших cancel (или заблокировавших stdin) хода мост целиком не блокируют.\n205|Дедлайны ServeRun переводятся с `time.time()` на `time.monotonic()` (EVD-026).\n206|\n207|Exec-рестарт по ветке деградации запрещён; альтернатива «exec последним шагом\n208|деградации до `_content_started`» взвешена и отклонена в AD-002 (FU-004):\n209|после approval-трафика ACTION_POSSIBLE §3.2 может быть уже защёлкнут.\n210|Каждая деградация логируется `approval_degraded` с флагами `content_started`\n211|и барьера активности — это измеримый вход условия её пересмотра.\n212|\n213|Что меняется против a1 в fallback (RW-001, PF-a2-001): тихий exec fallback по\n214|`ServeUnavailable` сохраняется **только до записи `turn/start`** (граница\n215|`ACTION_POSSIBLE`, §3.2) и до любого approval-трафика (спавн, handshake,\n216|`session/start`, EOF и RPC-ошибки setup, включая ветку `-32030` из AD-006) и только\n217|если режим не `denyUnmatched` (PF-a2-005: exec всегда с `--yolo`, при `denyUnmatched` он\n218|не запускается ни в какой роли — терминальный исход 502/SSE error с причиной\n219|`exec_fallback_disabled`). После записи `turn/start` EOF, ошибка\n220|чтения, ошибка записи stdin, дедлайн чтения и `turn/start` без ack — терминальные без exec;\n221|`cancel` → EOF — ожидаемое подтверждение очистки, а не повод для fallback.\n222|Ошибка модели (`terminal != completed`) по-прежнему не фолбэчится; при\n223|ушедшем клиенте надзор убивает группу и ничего нового не стартует. Approval\n224|во время setup-фазы (`await_result` маршрутизирует чужие сообщения в тот же\n225|обработчик) проходит тот же путь: `sessionId` берётся из снимка, локальная\n226|сессия моста может ещё не существовать.\n227|\n228|## 3. REQ-MUSE-003: ограниченный повтор транзиентных сбоев\n229|\n230|Решение AD-003 (APPROVED), граница BND-003. Внутренний однократный сетевой повтор внутри\n231|exec-after-fallback (`server.py:2435-2445`, baseline REQ-MUSE-001) **упраздняется**: после\n232|старта exec-процесса повтор запрещён (§3.2, ACTION_POSSIBLE); отдельного третьего пути повтора\n233|не остаётся.\n234|\n235|**Честная цена (a3, PF-a2-001, RISK-009).** Повтор допускается только там, где отсутствие\n236|действия модели доказано: до записи `turn/start`. Посреди хода и на exec действие без\n237|item/approval сигналов фактами не исключено (ASM-010), а семантика at-least-once владельцем\n238|не принималась (THREAT-004). Поэтому наблюдавшиеся net-timeout длительностью до 452 с\n239|(EVD-011) в области по умолчанию остаются терминальным отказом без повтора; REQ-MUSE-003\n240|закрывается только для пре-турновых сбоев. Расширение — по решению владельца (Q-010).\n241|\n242|### 3.1 Классификация (только явные маркеры)\n243|\n244|Попытка считается транзиентно-транспортной, когда её сырой канал ошибки (до\n245|редакции, как детектор hard threshold) содержит хотя бы одну подстроку:\n246|\n247|| Маркер | Источник |\n248||---|---|\n249|| `[net-timeout]` | лог и бенч (EVD-011) |\n250|| `timed out waiting for response data` | лог и бенч (EVD-011) |\n251|| `network connection could not be opened` | существующий `NETWORK_RETRY_MARKER` (EVD-010) |\n252|| `transport_connect_unreachable` | текст REQ-MUSE-003; в логах на 2026-10-15 не засвидетельствован (grep пуст), тест синтетический |\n253|\n254|Источник текста явный (FU-012): на serve для пре-турновых сбоев — текст ошибки setup (исключение ServeRun), а для терминала хода (используется только в области `observed-items`, §3.2 п.5) классификатор смотрит конкатенацию `turn/completed.error.kind` и `error.message` до редакции (поля схемы `[F-35]`), на exec — сырой stderr-канал ошибки; значения enum `kind` не выдумываются, маркеры ищутся в обоих полях. Классификатор — чистая проверка по образцу `_has_hard_threshold_marker`,\n255|результат — флаг в словаре попытки по образцу `hard_threshold`. Поле\n256|`retryable` ошибки serve само по себе класс не даёт: hard threshold тоже\n257|`retryable=True` и принадлежит контекстному пути. Подстрока в обычном тексте\n258|ответа при `rc == 0` повтор не запускает. Состояния `timeout`, `spawn_failed`,\n259|`launcher_missing`, `client_gone` не повторяются при любом тексте: первое уже\n260|исчерпало бюджет, остальные детерминистичны или бессмысленны без клиента.\n261|\n262|### 3.2 Граница действия и условия допуска нового процесса (все одновременно)\n263|\n264|Необратимый общий барьер a4 (PF-a3-001): у запроса APPROVAL_SEEN защёлкивается сразу при получении approval/request, approval/requested или userInput/request, в том числе во время initialize/session/start/setup, ДО receipt, дедупликации и решения политики. ACTION_POSSIBLE для serve защёлкивается при самом раннем из этих событий, ДО первой попытки записи любого разрешающего approval/decide (approved либо approvedForSession, даже без предшествующего события) и ДО первого байта turn/start; exec — при успешном старте процесса с промптом. Разрешающий decide во время setup допустим только в том же процессе при allowAll, с теми же choices/лимитами/таймерами AD-002. ACK, -32051, terminal=false, ошибка/частичная запись, конец setup и смерть группы не сбрасывают ни один флаг. Эти флаги передаются Handler до возврата результата или исключения; агрегаты на запрос монотонны по всем попыткам. APPROVAL_SEEN или попытка разрешающего decide безусловно запрещают ЛЮБОЙ новый serve/exec (внутренний fallback, транзиентный и контекстный retry, обе области pre-action/observed-items). Не требуется доказательство фактически выполненного действия. Ошибка управляющего обмена после такого события терминальна по AD-002 даже до turn/start; если turnId ещё неизвестен, turn/cancel с выдуманным ID не посылается: доступный отказной decide в оставшемся счёте, иначе bounded ожидание/killpg. Setup-обработчик не продлевает SERVE_SPAWN_TIMEOUT_S и применяет min(CONTROL_WRITE_TIMEOUT_S, остаток setup/E); grace от локального защёлкивания обрезается общим дедлайном завершения AD-003. Тот же процесс может продолжиться успешно и послать первый turn/start; запрет касается переигрывания новым процессом.\n265|\n266|1. Попытка неуспешна и классифицирована транзиентной (§3.1) либо является пре-турновым\n267|   сбоем serve; при этом не является hard threshold с доступным контекстным повтором\n268|   (приоритет §3.3).\n269|2. Транзиентных повторов в этом запросе было меньше 2 (отдельный счётчик запроса,\n270|   не попытки). Внутренний serve→exec fallback счётчик не расходует только в\n271|   до-турновой ветке, где исхода хода ещё не было, но проходит тот же предикат,\n272|   тот же дедлайн и тот же лимит процессов — бесплатным он не является (RW-001).\n273|3. Клиент на месте (`_client_gone` ложен и проба отрицательна) в момент решения\n274|   и после паузы.\n275|4. Контентные кадры не отправлялись: `_content_started` ложен. Пустые keepalive и\n276|   role-кадр границей не являются; первая фактически отправленная live\n277|   reasoning-дельта является (§4.2), буферизованная неотправленная — нет.\n278|5. Область повтора (PF-a2-001, AD-003 п.4): по умолчанию `pre-action` — условие\n279|   «нет ACTION_POSSIBLE у прежних попыток» (см. выше): новый процесс возможен только после\n280|   сбоев до setup approval/userInput/попытки allowing decide И записи `turn/start` (spawn, handshake, `session/start`, до-турновый транспорт).\n281|   Переключатель `MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE=observed-items` (читается при старте,\n282|   невалидное значение останавливает старт) заменяет это условие барьером наблюдаемой\n283|   активности a2: на serve не было `approval/request|requested`, `userInput/request`,\n284|   отправленного decide и item с `kind` вне {`reasoning`, `agentMessage`} (ServeRun ведёт\n285|   `kinds`, EVD-025), на exec результат не несёт текста и summaries — и тем самым **принимает\n286|   at-least-once** для действий без наблюдаемых сигналов; включается только после записанного\n287|   решения владельца (Q-010) и закрытия ASM-010; при старте warning, на каждый повтор — строка\n288|   `retry_scope`. В обеих областях НЕ было APPROVAL_SEEN/попытки allowing decide и не защёлкнута approval-деградация; финализация/ошибка доставки не начата. Переключатель не отменяет общий approval-барьер. Для exec-процесса\n289|   дополнительно режим approval не `denyUnmatched` (§2.4).\n290|6. Все группы процессов прежних попыток закрыты и `dead_confirmed` истинен;\n291|   иначе действует существующий карантин слота, повтор не стартует.\n292|7. Остаток до исполнительного дедлайна E (§3.3) не меньше `MIN_ATTEMPT_REMAINING_S=120` с\n293|   (PF-a2-008); пауза повтора входит в бюджет.\n294|8. Промпт повтора — тот же `attempt_prompt` текущей попытки дословно; прунинг на\n295|   транзиентной ветке не выполняется.\n296|\n297|Тот же предикат (пункты 3–7) гейтит до-турновый exec-fallback и серверный пре-турновый\n298|повтор: новый процесс в обход предиката не стартует ни в одной ветке. Контекстный повтор\n299|(hard threshold, AD-005) сохраняет гарантию «ровно один и до первого контентного кадра»\n300|(`do_not_change`) и гейтится пунктами 3–7 с **барьером наблюдаемой активности** вместо\n301|ACTION_POSSIBLE: hard threshold — явный отказ провайдера по размеру контекста, а не\n302|неопределённый таймаут; остаток риска ненаблюдаемого действия унаследован от baseline\n303|REQ-MUSE-001 и записан в ASM-010. Общий approval/allowing-decide барьер остаётся обязательным для контекстного retry; объект AD-005 и его лимит/прунинг сохранены без изменений.\n304|\n305|### 3.3 Бюджеты, дедлайн и взаимодействие счётчиков\n306|\n307|- Бюджет a4 (PF-a3-002): t0 = time.monotonic() при приёме запроса Handler до очереди; D — АБСОЛЮТНЫЙ предел ВСЕГО запроса, включая очередь, вычисление, сериализацию, всю успешную либо ошибочную выдачу, закрытие соединения и bounded cleanup. D = t0 + min(TIMEOUT_S, REQUEST_CAP_S), REQUEST_CAP_S=1800 с (выбор ASM-013; при default TIMEOUT_S=1800 сохранён); большее операторское TIMEOUT_S не отодвигает D. При известных клиентских 1900 с [F-19]/EVD-016 запас не меньше 100 с, не используется для выдачи. E = D − FINISH_RESERVE_S (35 с), W = D − CLOSE_RESERVE_S (12 с). Очередь, все попытки и retry-паузы ограничены E, вся выдача и все её писатели — W; E..D резервируется для grace/уборки/выдачи/закрытия, но не доказывает доставку произвольного числа кадров. Успешная модель около E получает только остаток до W на финальную выдачу (максимум 23 с при default до затрат cleanup). Ни кадр, ни пауза, ни flush, ни keepalive, ни ожидание _wlock/остановки keepalive не продлевают W. Смена фаз и все входы в _wlock тоже bounded остатком до W. Независимый от писателя и _wlock надзор при достижении W атомарно останавливает выдачу, запрещает новые процессы, делает shutdown/close соединения без ожидания _wlock и прерывает все ожидания; уборка группы ограничена остатком до D (нового полного grace после W/D нет). CLOSE_RESERVE_S=12 с — явно выбранный continuable резерв по текущему worst-case _terminate_run 5+5+2, EVD-026; это не измеренный SLA ОС, ASM-013. Подтверждённая смерть освобождает слот ровно один раз до D; если подтверждения нет к D, соединение всё равно закрыто, слот в существующем карантине, новый процесс запрещён и отсутствие освобождения не маскируется успешным исходом. D не сдвигается при повторах или завершении модели. HTTP JSON non-stream использует тот же W/D и bounded запись, форма ответа не меняется.\n308|- Новый процесс допускается только при остатке до E не меньше MIN_ATTEMPT_REMAINING_S=120 с (env MUSE_BRIDGE_MIN_ATTEMPT_S); очередь входит в t0. Порог по-прежнему выше 51.1/94 с из EVD-011, handshake=30 с не является временем на ход.\n309|- Контекстный повтор (ровно 1, AD-005) получает тот же остаток до `E` и проходит\n310|  предикат §3.2 (с барьером наблюдаемой активности, §3.2).\n311|- Цикл запроса детерминирован: после каждой попытки сначала проверяется\n312|  контекстный повтор (hard threshold, свой счётчик, прунённый промпт), затем\n313|  транзиентный (свой счётчик, тот же промпт), иначе терминальный исход.\n314|  Верхняя граница едина везде (FU-006): не более 3 вызовов `run_attempt` без\n315|  контекстного повтора и не более 4 с ним (1 + 1 контекстный + 2\n316|  транзиентных), не более 8 процессов с до-турновым fallback, все в одном\n317|  слоте и внутри бюджета `E`. В области по умолчанию транзиентный повтор исполняется\n318|  только после пре-турновых сбоев serve (новый serve-процесс, затем один exec-fallback),\n319|  паузы 2/4 с + джиттер применяются к ним же.\n320|- Паузы между транзиентными попытками: 2 с, затем 4 с, каждая плюс джиттер\n321|  равномерно до 1 с; суммарно не более 8 с. Пауза спит срезами не дольше тика\n322|  надзора клиента (0.25 с) и прерывается уходом клиента. Длительности читаются\n323|  из модульных констант в момент повтора, чтобы тесты ужимали их monkeypatch,\n324|  как сегодня ужимается `KEEPALIVE_S`.\n325|- Нагрузка при деградации транспорта (FU-010, QA-009): слот удерживается на\n326|  весь ход, поэтому повторы не поднимают параллельность выше\n327|  `MAX_CONCURRENT=2`; глобальный cooldown и circuit breaker осознанно не\n328|  вводятся, суммарную длительность ограничивают паузы и исполнительный дедлайн `E`.\n329|- Между попытками клиенту не уходит ни error, ни [DONE]; keepalive фазы OPEN\n330|  продолжается. Терминальный исход после исчерпания — существующий формат\n331|  502 / SSE error с диагностикой последней попытки после редакции и удаления\n332|  отражённых промптов всех попыток.\n333|\n334|## 4. REQ-MUSE-004: живость и прогресс в SSE\n335|\n336|Решение AD-004 (APPROVED), границы BND-002 и BND-004, дельта CD-001.\n337|\n338|### 4.1 Что стримится, а что нет\n339|\n340|Стримится только прирост reasoning summaries serve-пути. Content, tool_calls,\n341|usage и финальный кадр — как сегодня, после завершения всех попыток: разбор\n342|tool-разметки `_split_tool_calls` работает по полному тексту, и частичная\n343|разметка клиенту не утекает. Exec-ходы summaries не дают и live не имеют.\n344|Форма Non-stream JSON не меняется, включая поле `reasoning_summaries` целиком; запись тоже ограничена W/D, при невозможности доставки — закрытие без нового процесса.\n345|\n346|### 4.2 Контракт live-sink и инвариант конкатенации\n347|\n348|- ServeRun получает необязательный sink Handler и зовёт его синхронно из своего\n349|  цикла чтения при каждом приросте summary: дельты `summary.N` и списки\n350|  `summary` из `item/completed` проходят один путь накопления\n351|  (`summary_parts`/`summaries`, как сегодня), чтобы текст без дельт не терялся.\n352|  ServeRun сокет, `_wlock` и фазы SSE не знает и исключений записи не получает:\n353|  sink возвращает только факт успеха.\n354|- Предел выдачи a4 (PF-a3-002): для любого вызова _sse_write в момент s единый локальный deadline L=min(s+LIVE_WRITE_TIMEOUT_S, W), LIVE_WRITE_TIMEOUT_S=3 с. Ожидание _wlock, sendall/write и flush используют один убывающий остаток до L (таймаут переустанавливается по остатку перед каждым блокирующим этапом, не по 3 с на этап); возвращается прежний socket timeout до освобождения замка. Этот предел действует на role, keepalive, live reasoning, финальный reasoning-хвост, tool_calls, КАЖДЫЙ content-кадр, finish_reason, usage, error и [DONE], без исключений. Все циклы сериализации/разбиения кадров, baseline-пауза 5 мс между content-кадрами и остановка/join keepalive проверяют W и прерываются надзором; нельзя начинать новый кадр/паузу при неположительном остатке, кадровый бюджет не обновляет W. keepalive допускается только OPEN, перед финальной выдачей останавливается в остатке до W. При истечении W либо L или частичном кадре запрос получает единственный локальный неуспешный исход delivery_deadline/client_gone, live и другие писатели остановлены, соединение закрывается; поздний успех модели игнорируется, повтор/fallback запрещены даже если ещё нет _content_started. После частично отправленного кадра или при нулевом остатке новый error/[DONE] не дописывается. Если ошибка известна раньше и полный корректный error+[DONE] успевает в оставшийся W, допустим один обычный ошибочный терминал; гарантировать его при аварийном обрыве нельзя. Успех существует только если ВСЯ конечная выдача, включая finish/usage и единственный [DONE], завершена до W; успешный локальный исход не фиксируется по завершению вычисления. При исчерпании бюджета результат может быть усечён закрытием соединения; отсутствие потери F обещается только для полностью доставленного успешного ответа. Полный текст и завершающий [DONE] после W не обещаются ни для читающего клиента, ни при расхождении snapshot. Нормальный путь сохраняет поля/порядок внешнего API. Резерв на 2 error-кадра не является доказательством доставки N content-кадров.\n355|- Префикс-монотонная публикация (RW-005). Порядок опубликованного задним\n356|  числом не меняется: до заморозки live отдаёт только прирост\n357|  `summary_parts[0]`. Заморозка наступает при первой дельте с индексом больше\n358|  0, при `item/completed` reasoning или в конце хода; дальше дельты только\n359|  копятся. Поздний меньший индекс (первой пришла `summary.1`) ничего не\n360|  публикует до согласования. Финальное согласование в `_send_sse`: пусть `F`\n361|  — сегодняшняя сборка `\"\\n\\n\".join(summaries)`, `P` — уже отправленный\n362|  live-текст. Если `F` начинается с `P`, доотдаётся только хвост `F[len(P):]`\n363|  (при полном live финального reasoning-кадра нет, повтор snapshot хвоста не\n364|  даёт). Если нет (расхождение; не ожидается, ASM-011; PF-a2-004) — для полностью доставленного успешного ответа **потеря\n365|  авторитетного текста запрещена**: после уже отправленного `P` клиенту уходит\n366|  разделитель `\"\\n\\n\"` и авторитетный `F` **целиком** отдельным абзацем\n367|  (допускается дублирование части текста, потери нет), расхождение логируется\n368|  счётчиком `reasoning_diverged` с длинами `P`, `F` и общего префикса без текста.\n369|  Пример: `P=\"a\"`, `F=\"b\\n\\nc\"` → клиент получает `a` + `\\n\\n` + `b\\n\\nc`. Так последовательность `0:\"a\" → 1:\"b\" → 0:\"c\"` даёт клиенту\n370|  `\"a\"` + хвост `\"c\\n\\nb\"` = итоговую `\"ac\\n\\nb\"`, а расхождение\n371|  `item/completed` с дельтами не дублирует и не переставляет текст.\n372|  Non-stream ответ всегда несёт авторитетную сборку `F` целиком.\n373|- Первый фактически отправляемый непустой reasoning-кадр выставляет\n374|  `_content_started` внутри той же критической секции `_sse_write` до записи (форма —\n375|  параметр или колбэк вызова, зона Coder) — с этого момента повторы §3\n376|  и контекстный повтор запрещены; буферизованная, но не отправленная дельта\n377|  флага не ставит.\n378|- Keepalive без изменений: пустой data-чанк каждые 15 с в фазе OPEN (предел записи —\n379|  общий, выше). Переход на SSE-комментарии droid-моста не делается (OPEN-03,\n380|  deferred): пустые чанки держат клиента по комментарию в коде моста (влияние на\n381|  idle-watchdog клиента в ledger не найдено, ASM-003, `[F-47]`), комментарии для\n382|  muse-моста не проверены, а тест test_s1 закрепляет отсутствие `: keepalive` и\n383|  сохраняется.\n384|\n385|### 4.3 Наблюдаемость прогресса\n386|\n387|- Первая summary-дельта хода логируется строкой с секундами от старта хода и\n388|  индексом (без текста): это вход отдельной диагностики VER-011; приёмку VER-009 наблюдение не заменяет (RW-007). На транзиентном терминале при истинном `_content_started` пишется строка `retry_blocked` — пара логов даёт долю ходов «первая дельта раньше сбоя» для метрики FU-005.\n389|  Существующая строка `reasoning summaries=... preview=` в конце хода не меняется.\n390|- Журнал инструментальных item (PF-a2-006): каждый `item/started` и `item/completed` с\n391|  `kind` вне {`reasoning`, `agentMessage`} логируется строкой с `kind` и `toolName` только при\n392|  совпадении с allowlist `[A-Za-z0-9_.:/-]{1,64}` (иначе `redacted` с длиной), без `rawArgs`;\n393|  счётчик таких item входит в итоговую строку хода; на каждом транзиентном терминале serve\n394|  логируется наличие `timeToFirstTokenMs` и `usage` (EVD-028). Это исполнимый способ закрытия\n395|  ASM-010 и аудит наблюдаемых инструментальных действий отдельно от остаточных approval-запросов\n396|  (T-A15, VER-009).\n397|- `turn/modelRetryScheduled` (только 1.4.8) логируется полями `attempt`,\n398|  `maxAttempts`, `retryDelayMs`, `errorKind` и клиенту не отдаётся: текстовый\n399|  проброс загрязнил бы reasoning и ложно закрыл окно повторов. Живость на время\n400|  паузы провайдера держит keepalive.\n401|\n402|## 5. Безопасность и угрозы\n403|\n404|Границы доверия и потоки данных (VIEW-003):\n405|\n406|```text\n407|[DSH доверенный клиент владельца]\n408|   |  промпт, история сессии            ^ SSE: reasoning/content\n409|   v                                    |\n410|[мост :9886, ключ, loopback] --аудит безопасных полей--> bridge.log\n411|   |  MSP: session/start allowAll, receipt/decide\n412|   v\n413|[muse serve: песочница хоста, write/shell OFF] -> инструменты модели\n414|   |  через muse-cli.sh и прокси :10816 (вне доверия моста)\n415|   v\n416|[Meta API]\n417|```\n418|\n419|Сводка угроз пакета: THREAT-001 (авторазрешённый инструмент и исходящая сеть),\n420|THREAT-002 (утечка через аудит-лог), THREAT-003 (удержание слотов циклами и\n421|повторами), THREAT-004 (переигрывание после частичных эффектов). Митигации и\n422|проверки — в пакете по ID. Честный остаток: до первого живого payload (OPEN-01)\n423|пакет не утверждает, какие именно действия будут авторазрешены на wonder;\n424|утверждается только, что write и shell выключены хостом, песочница включена, а\n425|каждое решение моста по остаточному запросу видно владельцу в логе (полный аудит действий без остаточного запроса пакет не обещает, FU-001); откат политики — env-переключатель AD-007: при `denyUnmatched` мост нигде не разрешает\n426|действия автоматически (`exec --yolo` не запускается ни в какой роли, AD-006), цена — доступность\n427|(RISK-010); применение — plist + `bootout`/`bootstrap` (§7). Селективный deny без payload не\n428|проектируется: список запретов по догадке дал бы ложную границу.\n429|\n430|## 6. План тестов (red → green, файл тот же)\n431|\n432|Все тесты — в `tests/test_muse_bridge_killpg.py`, новый файл не создаётся.\n433|Порядок: сначала падающие тесты нового контракта и регрессии на каждый REQ,\n434|затем реализация. Фикстура `install_protocol_wrapper` расширяется, сохраняя\n435|прежние сценарии: реальный payload approval с `availableChoices`, ответы на\n436|`approval/decide` и `userInput/cancel`, ветка `terminal=false` со вторым\n437|запросом, задержанные `item/delta summary.N`, терминалы с net-timeout для serve\n438|и exec, ветка `-32030` на первый `session/start`, уведомление\n439|`turn/modelRetryScheduled`. Параметры прежнего вызова `{\"approval\": True}` с\n440|пустым payload остаются валидным входом деградации, а не нормой.\n441|\n442|| ID | Класс (-k) | Проверка |\n443||---|---|---|\n444|| T-A01 | Approval | `rpc.jsonl`: `session/start` несёт `approvalMode=allowAll`; serve argv с `--disable-write --disable-shell` и без `--disable-sandbox`; лог эффективного режима |\n445|| T-A02 | Approval | approval с choices approved+abort: receipt тем же id, decide с approved `choiceId`, `requirementId` дословно, ход `via=serve`, exec-argv отсутствует, один `turn/start` |\n446|| T-A03 | Approval | предпочтение `approved` над `approvedForSession`; только `approvedPolicyAmendment` в списке ведёт в деградацию, а не в выбор |\n447|| T-A04 | Approval | `terminal=false`, затем обновлённый запрос с новым requirement: второй decide, ход завершён |\n448|| T-A05 | Approval | только `approval/requested` без запроса: один decide без receipt; пара request+requested даёт один decide; `-32051` не роняет ход |\n449|| T-A06 | Approval | `userInput/request`: receipt и `userInput/cancel`, ход продолжается; тела вопросов в логе нет |\n450|| T-A07 | Approval | approval позже setup-окна (фикстура ужимает spawn-окно и задерживает запрос за него): decide уходит, exec не стартует (регрессия `_write_until`) |\n451|| T-A08 | Approval | пустой `availableChoices`; ошибка decide **параметризована по всем кодам `[F-28]`**: `-32050`, `-32052`, `-32053`, `-32054`, `-32030` защёлкивают деградацию (abort/denied или `turn/cancel`, терминальная ошибка, exec не стартует), `-32051` benign и ход продолжается; отдельный кейс — ошибка `userInput/cancel` защёлкивает (PF-a2-011) |\n452|| T-A09 | Approval | серия запросов сверх границ 10 и 3: ход остановлен деградацией без одиннадцатого decide, группа мертва, слот свободен |\n453|| T-A09b | Approval | фейковый serve игнорирует `turn/cancel` и отказной decide (RW-008): группа мертва и слот освобождён не позже ужатого grace после деградации, клиенту один терминальный исход, exec не стартует |\n454|| T-A09c | Approval | stdin serve заблокирован **до** деградации (фикстура перестаёт читать stdin): grace отсчитан от защёлкивания по монотонным часам и включает попытку записи cancel/decide, группа убита и слот свободен не позже ужатого grace плюс уборка, клиенту один терминальный исход (PF-a2-003) |\n455|| T-A10 | Approval | канарейки в `rawArgs`, в вопросе userInput и в `choiceId`/`toolName` отсутствуют в логе дословно, JSON и SSE (FU-009); аудит-строка содержит только разрешённые поля с ограниченным рендером |\n456|| T-A11 | Approval | allowAll, `-32030` на старт с явным режимом (FU-002): второго `session/start` и `approval/decide` нет, warning с версией, ровно один exec-fallback до записи `turn/start`, один процесс serve (AD-006) |\n457|| T-A11b | Approval | denyUnmatched × {`-32030`, EOF handshake, таймаут handshake, `session/start` без `sessionId`, spawn failed} (PF-a2-005): exec-argv отсутствует (`--yolo` не вызывается), serve не более одного процесса, один терминальный исход 502 либо SSE error с причиной `exec_fallback_disabled` и один `[DONE]` |\n458|| T-A13 | Approval | терминальное защёлкивание (RW-006): после denied сервер поочерёдно повторяет request, возвращает `terminal=false`, присылает успешный terminal, не завершает ход; во всех ветках не более 10 decide, exec нет, ровно один терминальный исход, поздний успех отброшен |\n459|| T-A14 | Approval | env-режим (AD-007): `MUSE_BRIDGE_APPROVAL_MODE=denyUnmatched` уходит в `session/start` и approve не отправляется; без env — `allowAll`; невалидное значение останавливает старт с ошибкой; **матрица режим × пре-турновый сбой serve** (PF-a2-005): denyUnmatched — exec не вызывается (T-A11b), allowAll — согласованный ровно один exec-fallback |\n460|| T-A15 | Approval | журнал инструментальных item (PF-a2-006): строки с `kind` и безопасным `toolName` для item вне {reasoning, agentMessage}, канарейка в аргументах отсутствует в логе дословно, счётчик в итоговой строке хода, на транзиентном терминале залогировано наличие `timeToFirstTokenMs`/`usage` |\n461|| T-R01 | TransientRetry | каждый из четырёх маркеров на **пре-турновом** сбое serve (setup с маркером в тексте ошибки): повтор новым serve и успех, ровно 2 попытки, один [DONE], нет error между; те же маркеры в `turn/completed.error` (реальная форма с `error.kind`/`error.message`, FU-012) и в stderr exec в области по умолчанию **не** повторяются (терминал, ровно одна попытка), а при `observed-items` — повторяются (T-R07b) |\n462|| T-R02 | TransientRetry | три транзиентных отказа: ровно 3 попытки, терминальная ошибка прежнего формата, группы мертвы, слот освобождён один раз |\n463|| T-R03 | TransientRetry | нет повтора: после первой live-дельты, при уходе клиента в паузе и во время попытки, при `dead_confirmed` ложном, при остатке до `E` меньше `MIN_ATTEMPT_REMAINING_S`, на `timeout` и `spawn_failed`, на маркере в успешном тексте |\n464|| T-R04 | TransientRetry | hard threshold в приоритете: контекстный повтор с прунённым промптом, транзиентный счётчик не израсходован; обновлённый test_t18 сохраняет это утверждение |\n465|| T-R05 | TransientRetry | повторная попытка получает только остаток до `E` от приёма (фикстура фиксирует переданный дедлайн/таймер меньше полного TIMEOUT_S) |\n466|| T-R06 | TransientRetry | предикат допуска (RW-001): `turn/start` записан, но ack не пришёл (обрыв), summary→EOF, summary→ошибка чтения, approval→ошибка записи receipt/decide, cancel→EOF не запускают exec и дают один терминальный исход; EOF рукопожатия до любого approval/userInput/allowing decide и записи `turn/start` один раз допускает exec |\n467|| T-R07 | TransientRetry | граница ACTION_POSSIBLE (PF-a2-001, red до фикса): заглушка serve пишет наблюдаемый маркер побочного эффекта БЕЗ `item/started|completed`, `approval/request` и выходного текста, затем после записи `turn/start` возвращает net-timeout — ровно одна попытка, **ровно один** побочный эффект, один терминальный исход; то же для exec (эффект, пустой stdout, маркер в stderr): один процесс, один эффект; сбой до любого approval/userInput/allowing decide и записи `turn/start` с маркером допускает повтор |\n468|| T-R07b | TransientRetry | область `observed-items` (`MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE`): заглушка без сигналов повторяется, в логе warning старта и `retry_scope` на повторе; заглушка с инструментальным item, approval либо непустым текстом exec — не повторяется; невалидное значение переключателя останавливает старт |\n469|| T-R08 | TransientRetry | дедлайн от приёма (RW-002, PF-a2-008): три одновременных запроса при двух занятых слотах, задержанные serve и fallback; третий получает ответ или предусмотренную ошибку внутри `E` от приёма; запрос с остатком меньше ужатого `MIN_ATTEMPT_REMAINING_S` получает предусмотренную ошибку, процесс не стартует; слоты освобождены по одному разу |\n470|| T-R10 | TransientRetry | бюджет E/D (PF-a2-003): модель висит до `E` (ужатые константы): терминальный исход клиенту и свободный слот не позже `D` от приёма, резерв `FINISH_RESERVE_S` не исчерпан попыткой, дополнительного полного grace после `D` нет |\n471|| T-R09 | TransientRetry | серия net-timeout под двумя параллельными ходами (QA-009): одновременно не более 2 процессов, повторы внутри слотов с паузами, оба исхода внутри исполнительного дедлайна `E` |\n472|| T-L01 | LiveReasoning | дельты `summary.0` и `summary.1` с задержкой: кадры reasoning до финального, порядок индексов, разделитель, конкатенация равна буферизованному варианту, финального дубля нет |\n473|| T-L02 | LiveReasoning | summary только из `item/completed` без дельт не теряется ни в live, ни в non-stream `reasoning_summaries` |\n474|| T-L03 | LiveReasoning + test_s1 | пустые keepalive-чанки сохранены, `: keepalive` отсутствует, один [DONE], content и tool_calls целы |\n475|| T-L04 | LiveReasoning | сбой записи в середине live: ход не падает исключением ServeRun, live отключён, терминальный путь существующий |\n476|| T-L05 | LiveReasoning | `turn/modelRetryScheduled` только в логе полями уведомления, в SSE текста нет, `_content_started` им не выставляется |\n477|| T-L06 | LiveReasoning | out-of-order (RW-005): `0:a → 1:b → 0:c` и поздний меньший индекс (`1` раньше `0`): опубликованный порядок не переписывается, клиентская конкатенация равна сборке по индексам, потерь и дублей нет |\n478|| T-L07 | LiveReasoning | расхождение snapshot (RW-005, PF-a2-004): `P=\"a\"`, `F=\"b\\n\\nc\"` → клиентский поток даёт `a` + `\\n\\n` + `b\\n\\nc` (авторитетный текст целиком, потери нет), в расширяющем случае хвост без дубля и повтор финального snapshot не дублирует, счётчик `reasoning_diverged` с длинами в логе, non-stream несёт авторитетную сборку |\n479|| T-L08a | LiveReasoning | медленный клиент (RW-004): клиент не читает, заглушка заполняет буфер live-дельтами при ужатом `LIVE_WRITE_TIMEOUT_S`; sink возвращается не позже предела, группа мертва и слот свободен в пределах предела плюс подтверждение смерти, второй клиент получает полный ответ |\n480|| T-L08b | LiveReasoning | **keepalive блокируется первым** (PF-a2-002, red до фикса): `KEEPALIVE_S` ужат, запись keepalive-кадра блокируется под `_wlock` (детерминированно — обёртка записи, блокирующаяся на остаток `connection.gettimeout()`, и/или реальный сокет с малыми буферами), затем в цикл чтения MSP приходит summary-дельта; sink и keepalive возвращаются не позже предела (а не за `Handler.timeout`), группа мертва, слот свободен, второй клиент обслужен |\n481|| T-L08c | LiveReasoning | блокируется терминальная выдача (писатель — `_send_sse`) и `_sse_stop_keepalive` при зависшем keepalive: ожидание замка и запись ограничены тем же пределом, слот свободен, второй клиент обслужен |\n482|\n483|Судьба существующих тестов, закрепляющих старое поведение:\n484|\n485|| Тест | Было | Стало | Почему не ослабление |\n486||---|---|---|---|\n487|| `test_approval_falls_back_to_exec_without_decide` | нет decide, обязателен exec | заменён T-A01..T-A11: decide обязателен, exec запрещён | REQ-MUSE-002 прямо отменяет этот контракт; проверки exec-флагов переезжают в тесты транспортного fallback, которые сохраняются |\n488|| `test_t18_serve_fallback_and_network_retry_preserve_context_retry_budget` | внутренний exec network retry | транзиентный счётчик AD-003, утверждение про контекстный бюджет дословно сохранено (T-R04) | механизм обобщён, гарантия не снята |\n489|| `test_t27_serve_unavailable_with_reflected_prompt_does_not_leak_to_log` | утечка на ServeUnavailable | сохраняется на транспортном ServeUnavailable; T-A10 добавляет approval-канарейку | покрытие расширено |\n490|| `test_s1_data_ticks_before_done_preserve_content_and_tools` | нет `: keepalive`, пустые тики | сохраняется и дополняется T-L03 | AD-004 сознательно не меняет keepalive |\n491|| класс R4 (клиент ушёл при живом serve) | exec не запускается | без изменений, плюс T-R03 на паузе повтора | инвариант сохранён и расширен |\n492|\n493|Команды замороженной поверхности — VER-001..VER-007 пакета. Baseline до фикса\n494|фиксируется тем же VER-005 на чистом дереве ветки (67 passed из envelope сверяется\n495|фактом прогона Coder до правок).\n496|\n497|## 7. Выкат, проверка и откат\n498|\n499|1. Шаг 0 (FU-008): незакоммиченный baseline REQ-MUSE-001 отделяется первым\n500|   отдельным коммитом на ветке `bugfix/muse-wonder-approval-retry-liveness`\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
