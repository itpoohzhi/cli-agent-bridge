{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c499","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":167,"recorded_at":1780531400000329,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"task_stream":{"kind":"task","id":"01a14391-7341-7053-8d73-dff887b323c3"},"task_id":"01a14391-7341-7053-8d73-dff887b323c3","event":{"kind":"output","task_id":"01a14391-7341-7053-8d73-dff887b323c3","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(139 line(s) above)\n140|\n141|# --- REQ-MUSE-002/003/004 (пакет a4): approval, бюджеты, повторы, live ---\n142|APPROVAL_MODE = os.environ.get(\"MUSE_BRIDGE_APPROVAL_MODE\", \"allowAll\").strip()\n143|TRANSIENT_RETRY_SCOPE = os.environ.get(\n144|    \"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE\", \"pre-action\"\n145|).strip()\n146|FINISH_RESERVE_S = 35.0\n147|CLOSE_RESERVE_S = 12.0\n148|REQUEST_CAP_S = 1800.0\n149|MIN_ATTEMPT_REMAINING_S = float(os.environ.get(\"MUSE_BRIDGE_MIN_ATTEMPT_S\", \"120\"))\n150|CONTROL_WRITE_TIMEOUT_S = 5.0\n151|LIVE_WRITE_TIMEOUT_S = 3.0\n152|APPROVAL_CANCEL_GRACE_S = 15.0\n153|MAX_APPROVAL_DECIDE = 10\n154|MAX_USER_INPUT_CANCEL = 3\n155|TRANSIENT_MAX_RETRIES = 2\n156|TRANSIENT_BACKOFF_S: tuple[float, float] = (2.0, 4.0)\n157|TRANSIENT_JITTER_S = 1.0\n158|TRANSIENT_MARKERS: tuple[str, ...] = (\n159|    \"[net-timeout]\",\n160|    \"timed out waiting for response data\",\n161|    NETWORK_RETRY_MARKER,\n162|    \"transport_connect_unreachable\",\n163|)\n164|NON_RETRYABLE_STATES = frozenset(\n165|    {\"timeout\", \"spawn_failed\", \"launcher_missing\", \"client_gone\"}\n166|)\n167|\n168|\n169|def _validate_startup_config() -> None:\n170|    \"\"\"Невалидный env-режим или бюджет останавливают старт моста (AD-007).\"\"\"\n171|    if APPROVAL_MODE not in (\"allowAll\", \"denyUnmatched\"):\n172|        raise RuntimeError(f\"MUSE_BRIDGE_APPROVAL_MODE invalid: {APPROVAL_MODE!r}\")\n173|    if TRANSIENT_RETRY_SCOPE not in (\"pre-action\", \"observed-items\"):\n174|        raise RuntimeError(\n175|            f\"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE invalid: {TRANSIENT_RETRY_SCOPE!r}\"\n176|        )\n177|    if TIMEOUT_S < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S:\n178|        raise RuntimeError(\n179|            \"MUSE_BRIDGE_TIMEOUT_S too small: \"\n180|            f\"{TIMEOUT_S} < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S \"\n181|            f\"({FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S})\"\n182|        )\n183|\n184|\n185|_validate_startup_config()\n186|\n187|\n188|def _is_transient_text(*values: Any) -> bool:\n189|    \"\"\"Классификация транзиента только по явным маркерам (§3.1 пакета).\"\"\"\n190|    for value in values:\n191|        if value is None:\n192|            continue\n193|        if isinstance(value, str):\n194|            text = value\n195|        elif isinstance(value, (list, tuple)):\n196|            if _is_transient_text(*value):\n197|                return True\n198|            continue\n199|        elif isinstance(value, dict):\n200|            text = \" \".join(\n201|                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n202|            )\n203|            if not text.strip():\n204|                text = str(value)\n205|        else:\n206|            text = str(value)\n207|        if any(marker in text for marker in TRANSIENT_MARKERS):\n208|            return True\n209|    return False\n210|\n211|\n212|_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n213|_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n214|\n215|\n216|def _render_audit_token(value: Any) -> str:\n217|    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n218|    text = value if isinstance(value, str) else \"\"\n219|    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n220|        return text\n221|    raw = text if isinstance(value, str) else str(value or \"\")\n222|    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n223|    return f\"redacted(len={len(raw)},sha256={digest})\"\n224|\n225|\n226|def _render_tool_token(value: Any) -> str:\n227|    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n228|    text = value if isinstance(value, str) else \"\"\n229|    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n230|        return text\n231|    return f\"redacted(len={len(text)})\"\n232|\n233|\n234|class ApprovalPolicy:\n235|    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n236|\n237|    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n238|    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n239|    \"\"\"\n240|\n241|    def __init__(self, mode: str) -> None:\n242|        self.mode = mode\n243|\n244|    @staticmethod\n245|    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n246|        raw = params.get(\"availableChoices\")\n247|        if not isinstance(raw, list):\n248|            return []\n249|        return [c for c in raw if isinstance(c, dict)]\n250|\n251|    @staticmethod\n252|    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n253|        if not params:\n254|            return None\n255|        for choice in ApprovalPolicy._choices(params):\n256|            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n257|                return choice\n258|        return None\n259|\n260|    def evaluate(self, params: dict[str, Any]) -> dict[str, Any]:\n261|        choices = self._choices(params)\n262|        approve = next(\n263|            (c for c in choices if c.get(\"decision\") == \"approved\"), None\n264|        ) or next(\n265|            (c for c in choices if c.get(\"decision\") == \"approvedForSession\"), None\n266|        )\n267|        deny = self.deny_choice(params)\n268|        action = \"fail_turn\"\n269|        chosen: dict[str, Any] | None = None\n270|        if self.mode == \"allowAll\" and approve is not None:\n271|            action, chosen = \"approve\", approve\n272|        elif deny is not None:\n273|            action, chosen = \"deny\", deny\n274|        subject = (\n275|            params.get(\"subject\") if isinstance(params.get(\"subject\"), dict) else {}\n276|        )\n277|        choice_ids = \",\".join(\n278|            _render_audit_token(c.get(\"choiceId\")) for c in choices[:8]\n279|        )\n280|        audit = (\n281|            \"approval_decide \"\n282|            f\"tool={_render_audit_token(params.get('toolName'))} \"\n283|            f\"subject={_render_audit_token(subject.get('kind'))} \"\n284|            f\"protected={1 if params.get('protectedWrite') else 0} \"\n285|            f\"judge={1 if params.get('judgeEscalated') else 0} \"\n286|            f\"choices=[{choice_ids}] \"\n287|            f\"chosen={_render_audit_token(chosen.get('choiceId')) if chosen else 'none'} \"\n288|            f\"decision={_render_audit_token(chosen.get('decision')) if chosen else 'none'}\"\n289|        )\n290|        return {\n291|            \"action\": action,\n292|            \"choice_id\": chosen.get(\"choiceId\") if chosen else None,\n293|            \"decision\": chosen.get(\"decision\") if chosen else None,\n294|            \"audit\": audit,\n295|        }\n296|\n297|    def evaluate_user_input(self, params: dict[str, Any]) -> dict[str, Any]:\n298|        return {\n299|            \"action\": \"cancel_user_input\",\n300|            \"audit\": (\n301|                f\"user_input_cancel tool={_render_audit_token(params.get('toolName'))}\"\n302|            ),\n303|        }\n304|\n305|\n306|class ServeUnavailable(Exception):\n307|    \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n308|\n309|\n(more lines below)","final_result":true}}}
