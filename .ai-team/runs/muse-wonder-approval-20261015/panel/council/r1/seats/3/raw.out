{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a1","stream":{"kind":"session","id":"01a14390-a8e3-7500-ab07-f35718b900bc"},"sequence":171,"recorded_at":1780531400000337,"record_type":"event","durability":"durable","causation_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a14390-aea6-7e42-a3f6-3236dfbb4802","run_stream":{"kind":"run","id":"01a14390-aea6-7e42-a3f6-3236dfbb4802"},"task_stream":{"kind":"task","id":"01a14391-738f-7442-9466-0cdf9bea5964"},"task_id":"01a14391-738f-7442-9466-0cdf9bea5964","event":{"kind":"output","task_id":"01a14391-738f-7442-9466-0cdf9bea5964","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(2539 line(s) above)\n2540|    def _sse_write(\n2541|        self, text: str, *, keepalive: bool = False, mark_content: bool = False\n2542|    ) -> bool:\n2543|        \"\"\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\n2544|\n2545|        Ожидание замка, запись и flush делят единый остаток; исчерпание =\n2546|        зависший клиент (client_gone + killpg). Действует на всех писателей.\n2547|        \"\"\"\n2548|        started = time.monotonic()\n2549|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2550|        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\n2551|        if limit <= started:\n2552|            if not self._client_gone:\n2553|                self._client_gone = True\n2554|                self._delivery_failed = True\n2555|                _log(\"delivery_deadline write budget exhausted before frame\")\n2556|                self._kill_current_run()\n2557|            return False\n2558|        if not self._wlock.acquire(timeout=max(0.0, limit - time.monotonic())):\n2559|            if not self._client_gone:\n2560|                self._client_gone = True\n2561|                self._delivery_failed = True\n2562|                _log(\"client gone mid-stream (sse lock wait budget)\")\n2563|                self._kill_current_run()\n2564|            return False\n2565|        try:\n2566|            if self._sse_phase == \"CLOSED\" or self._client_gone:\n2567|                return False\n2568|            if keepalive and (\n2569|                self._sse_phase != \"OPEN\"\n2570|                or (self._keepalive_stop is not None and self._keepalive_stop.is_set())\n2571|            ):\n2572|                return False\n2573|            if time.monotonic() >= limit:\n2574|                raise TimeoutError(\"sse write budget exhausted\")\n2575|            if mark_content:\n2576|                self._content_started = True\n2577|            conn = getattr(self, \"connection\", None)\n2578|            prev_timeout: Any = None\n2579|            have_conn = False\n2580|            if conn is not None and hasattr(conn, \"settimeout\"):\n2581|                try:\n2582|                    prev_timeout = conn.gettimeout()\n2583|                    conn.settimeout(max(0.001, limit - time.monotonic()))\n2584|                    have_conn = True\n2585|                except (OSError, ValueError, AttributeError):\n2586|                    have_conn = False\n2587|            try:\n2588|                self.wfile.write(text.encode(\"utf-8\"))\n2589|                if have_conn:\n2590|                    try:\n2591|                        conn.settimeout(max(0.001, limit - time.monotonic()))\n2592|                    except (OSError, ValueError, AttributeError):\n2593|                        pass\n2594|                self.wfile.flush()\n2595|            finally:\n2596|                if text == \"data: [DONE]\\n\\n\":\n2597|                    self._sse_phase = \"CLOSED\"\n2598|                if have_conn:\n2599|                    try:\n2600|                        conn.settimeout(prev_timeout)\n2601|                    except (OSError, ValueError, AttributeError):\n2602|                        pass\n2603|            return True\n2604|        except (BrokenPipeError, ConnectionResetError, OSError):\n2605|            if not self._client_gone:\n2606|                self._client_gone = True\n2607|                self._delivery_failed = True\n2608|                _log(\"client gone mid-stream\")\n2609|                self._kill_current_run()\n2610|            return False\n2611|        finally:\n2612|            self._wlock.release()\n2613|\n2614|    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n2615|        return {\n2616|            \"id\": self._sse_id,\n2617|            \"object\": \"chat.completion.chunk\",\n2618|            \"created\": self._sse_created,\n2619|            \"model\": self._sse_model,\n2620|            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n2621|        }\n2622|\n2623|    def _sse_emit(\n2624|        self, obj: dict, *, keepalive: bool = False, mark_content: bool = False\n2625|    ) -> bool:\n2626|        return self._sse_write(\n2627|            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\",\n2628|            keepalive=keepalive,\n2629|            mark_content=mark_content,\n2630|        )\n2631|\n2632|    def _live_reasoning_sink(self, full_text: str) -> bool:\n2633|        \"\"\"Sink ServeRun: публикует только прирост summary.0 до заморозки.\"\"\"\n2634|        if not full_text or not getattr(self, \"_sse_open\", False):\n2635|            return True\n2636|        sent = getattr(self, \"_live_sent_text\", \"\")\n2637|        if full_text == sent or not full_text.startswith(sent):\n2638|            return True\n2639|        delta = full_text[len(sent) :]\n2640|        if not delta:\n2641|            return True\n2642|        ok = self._sse_emit(\n2643|            self._sse_chunk({\"reasoning_content\": delta}), mark_content=True\n2644|        )\n2645|        if ok:\n2646|            self._live_sent_text = full_text\n2647|        return ok\n2648|\n2649|    def _force_close_connection(self) -> None:\n2650|        \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n2651|        self._client_gone = True\n2652|        conn = getattr(self, \"connection\", None)\n2653|        if conn is None:\n2654|            return\n2655|        try:\n2656|            conn.shutdown(socket.SHUT_RDWR)\n2657|        except (OSError, ValueError, AttributeError):\n2658|            pass\n2659|        try:\n2660|            conn.close()\n2661|        except (OSError, ValueError, AttributeError):\n2662|            pass\n2663|\n2664|    def _sse_begin(self, model: str) -> bool:\n2665|        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n2666|        if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2667|            self._delivery_failed = True\n2668|            self._client_gone = True\n2669|            return False\n2670|        self._live_sent_text = \"\"\n2671|        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n2672|        self._sse_created = int(time.time())\n2673|        self._sse_model = model\n2674|        with self._wlock:\n2675|            self._sse_phase = \"OPEN\"\n2676|        self.close_connection = True\n2677|        try:\n2678|            self.send_response(200)\n2679|            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n2680|            self.send_header(\"Cache-Control\", \"no-cache\")\n2681|            self.send_header(\"Connection\", \"close\")\n2682|            self.send_header(\"X-Accel-Buffering\", \"no\")\n2683|            self.end_headers()\n2684|        except (BrokenPipeError, ConnectionResetError, OSError):\n2685|            self._client_gone = True\n2686|            _log(\"client gone before headers\")\n2687|            return False\n2688|        self._sse_open = True\n2689|        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n2690|            return False\n2691|        stop = threading.Event()\n2692|        self._keepalive_stop = stop\n2693|        self._ka_thread = threading.Thread(\n2694|            target=self._keepalive_loop, args=(stop,), daemon=True\n2695|        )\n2696|        self._ka_thread.start()\n2697|        return True\n2698|\n2699|    def _keepalive_loop(self, stop: threading.Event) -> None:\n2700|        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n2701|        while not stop.wait(KEEPALIVE_S):\n2702|            if self._client_gone or stop.is_set():\n2703|                return\n2704|            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n2705|                return\n2706|\n2707|    def _sse_stop_keepalive(self) -> None:\n2708|        if self._keepalive_stop is not None:\n2709|            self._keepalive_stop.set()\n(more lines below)","final_result":true}}}
