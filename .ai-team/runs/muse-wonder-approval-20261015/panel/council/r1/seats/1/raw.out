{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AeYEQhUd1PJMCHxVjMSTyE","type":"tool_result","content":"2960\t            return\n2961\t        path = self.path.split(\"?\", 1)[0]\n2962\t        length = int(self.headers.get(\"Content-Length\") or \"0\")\n2963\t        raw = self.rfile.read(length) if length else b\"{}\"\n2964\t        try:\n2965\t            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n2966\t        except ValueError:\n2967\t            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n2968\t            return\n2969\t        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n2970\t            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n2971\t            return\n2972\t        try:\n2973\t            self._serve_json(req)\n2974\t        finally:\n2975\t            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n2976\t            self._sse_stop_keepalive()\n2977\t            _done = getattr(self, \"_req_done\", None)\n2978\t            if _done is not None:\n2979\t                _done.set()\n2980\t            self._write_deadline = float(\"inf\")\n2981\t            self._exec_deadline = float(\"inf\")\n2982\t            self._request_deadline = float(\"inf\")\n2983\t            self._delivery_failed = False\n2984\t\n2985\t    def _serve_json(self, req: dict) -> None:\n2986\t        # Абсолютный бюджет запроса a4: t0 при приёме, до очереди и вычислений.\n2987\t        _t0 = time.monotonic()\n2988\t        _req_deadline = _t0 + min(TIMEOUT_S, REQUEST_CAP_S)\n2989\t        _exec_deadline = _req_deadline - FINISH_RESERVE_S\n2990\t        _write_deadline = _req_deadline - CLOSE_RESERVE_S\n2991\t        self._request_deadline = _req_deadline\n2992\t        self._exec_deadline = _exec_deadline\n2993\t        self._write_deadline = _write_deadline\n2994\t        self._live_sent_text = \"\"\n2995\t        self._delivery_failed = False\n2996\t        _req_done = threading.Event()\n2997\t        self._req_done = _req_done\n2998\t\n2999\t        def _supervise_w() -> None:\n3000\t            while not _req_done.wait(0.05):\n3001\t                if time.monotonic() >= _write_deadline:\n3002\t                    self._delivery_failed = True\n3003\t                    _log(\"delivery_deadline W reached: closing connection\")\n3004\t                    self._kill_current_run()\n3005\t                    self._force_close_connection()\n3006\t                    return\n3007\t\n3008\t        threading.Thread(target=_supervise_w, daemon=True).start()\n3009\t        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n3010\t        if model not in ALLOWED_MODELS:\n3011\t            self._send(\n3012\t                400,\n3013\t                {\n3014\t                    \"error\": {\n3015\t                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n3016\t                        \"type\": \"invalid_request_error\",\n3017\t                        \"code\": \"model_not_found\",\n3018\t                    }\n3019\t                },\n3020\t            )\n3021\t            return\n3022\t\n3023\t        raw_tools = req.get(\"tools\")\n3024\t        tools = (\n3025\t            [t for t in raw_tools if isinstance(t, dict)]\n3026\t            if isinstance(raw_tools, list)\n3027\t            else []\n3028\t        )\n3029\t        tool_choice = req.get(\"tool_choice\")\n3030\t        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n3031\t\n3032\t        raw_messages = req.get(\"messages\") or []\n3033\t        _, raw_turns_text = _messages_to_prompt(raw_messages)\n3034\t        if not raw_turns_text:\n3035\t            self._send(\n3036\t                400,\n3037\t                {\n3038\t                    \"error\": {\n3039\t                        \"message\": \"no user content\",\n3040\t                        \"type\": \"invalid_request_error\",\n3041\t                    }\n3042\t                },\n3043\t            )\n3044\t            return\n3045\t\n3046\t        rid = uuid.uuid4().hex[:8]\n3047\t        limit = _context_limit(model)\n3048\t        target = _context_target(limit)\n3049\t        retry_target = _context_retry_target(limit)\n3050\t        prune_res = _prune_messages(\n3051\t            raw_messages,\n3052\t            limit=limit,\n3053\t            target=target,\n3054\t            tools=tools,\n3055\t            tool_choice=tool_choice,\n3056\t            raw_tools=raw_tools,\n3057\t        )\n3058\t        if prune_res.status == \"refused\":\n3059\t            _log_context_prune(\n3060\t                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n3061\t            )\n3062\t            detail = (\n3063\t                f\"mandatory context exceeds budget \"\n3064\t                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n3065\t            )\n3066\t            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n3067\t            _log(\n3068\t                _format_err_log(\n3069\t                    model,\n3070\t                    \"refused\",\n3071\t                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n3072\t                    req.get(\"stream\") is True,\n3073\t                )\n3074\t            )\n3075\t            self._send(\n3076\t                502,\n3077\t                {\n3078\t                    \"error\": {\n3079\t                        \"message\": _redact_secrets(err_msg),\n3080\t                        \"detail\": _redact_secrets(detail)[:500],\n3081\t                        \"type\": \"proxy_error\",\n3082\t                        \"code\": 502,\n3083\t                    }\n3084\t                },\n3085\t            )\n3086\t            return\n3087\t        if prune_res.status == \"pruned\":\n3088\t            _log_context_prune(\n3089\t                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n3090\t            )\n3091\t\n3092\t        prompt = prune_res.prompt\n3093\t        current_est = prune_res.est_after\n3094\t        reflected_prompts: list[str] = [prompt]\n3095\t\n3096\t        effort = _map_effort(req)\n3097\t\n3098\t        if req.get(\"stream\") is True and not self._sse_begin(model):\n3099\t            return\n3100\t        while not _slots.acquire(timeout=1.0):\n3101\t            if self._client_gone or self._client_gone_probe():\n3102\t                self._client_gone = True\n3103\t                _log(\"client gone while waiting for a slot\")\n3104\t                return\n3105\t            if time.monotonic() >= _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3106\t                _log(\"insufficient remaining budget while waiting for a slot\")\n3107\t                self._send(\n3108\t                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n3109\t                )\n3110\t                return\n3111\t        if self._client_gone or self._client_gone_probe():\n3112\t            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n3113\t            self._client_gone = True\n3114\t            _log(\"client gone while waiting for a slot\")\n3115\t            _slots.release()\n3116\t            return\n3117\t        if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3118\t            _log(\"insufficient remaining budget after slot acquire\")\n3119\t            _slots.release()\n3120\t            self._send(503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}})\n3121\t            return\n3122\t        watch_stop = threading.Event()\n3123\t        watcher = threading.Thread(\n3124\t            target=self._watch_client, args=(watch_stop,), daemon=True\n3125\t        )\n3126\t        watcher.start()\n3127\t        runs: list = []\n3128\t        terminal_context_err: str | None = None\n3129\t        context_retry_count = 0\n3130\t        transient_retry_count = 0\n3131\t        attempt_calls = [0]\n3132\t        agg: dict[str, bool] = {\n3133\t            \"approval_seen\": False,\n3134\t            \"action\": False,\n3135\t            \"allowing\": False,\n3136\t            \"degraded\": False,\n3137\t            \"observed\": False,\n3138\t        }\n3139\t\n3140\t        def _update_agg(run: Any, out: dict[str, Any] | None) -> None:\n3141\t            if run is not None:\n3142\t                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n3143\t                    getattr(run, \"approval_seen\", False)\n3144\t                )\n3145\t                agg[\"action\"] = agg[\"action\"] or bool(\n3146\t                    getattr(run, \"action_possible\", False)\n3147\t                )\n3148\t                agg[\"allowing\"] = agg[\"allowing\"] or bool(\n3149\t                    getattr(run, \"allowing_decide_attempted\", False)\n3150\t                )\n3151\t                agg[\"degraded\"] = agg[\"degraded\"] or bool(\n3152\t                    getattr(run, \"approval_degraded\", False)\n3153\t                )\n3154\t                agg[\"observed\"] = agg[\"observed\"] or bool(\n3155\t                    getattr(run, \"observed_barrier\", False)\n3156\t                )\n3157\t            if out:\n3158\t                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n3159\t                    out.get(\"approval_seen\")\n3160\t                )\n3161\t                agg[\"action\"] = agg[\"action\"] or bool(out.get(\"action_possible\"))\n3162\t                agg[\"allowing\"] = agg[\"allowing\"] or bool(out.get(\"allowing_decide\"))\n3163\t                agg[\"degraded\"] = agg[\"degraded\"] or bool(out.get(\"approval_degraded\"))\n3164\t                observed = out.get(\"observed_barrier\")\n3165\t                if observed is None:\n3166\t                    observed = bool(out.get(\"text\") or out.get(\"summaries\"))\n3167\t                agg[\"observed\"] = agg[\"observed\"] or bool(observed)\n3168\t\n3169\t        def _can_start(is_exec: bool, *, context: bool = False) -> tuple[bool, str]:\n3170\t            if self._client_gone or self._client_gone_probe():\n3171\t                self._client_gone = True\n3172\t                return False, \"client_gone\"\n3173\t            if getattr(self, \"_content_started\", False):\n3174\t                return False, \"content_started\"\n3175\t            if getattr(self, \"_delivery_failed\", False):\n3176\t                return False, \"delivery_failed\"\n3177\t            if agg[\"degraded\"]:\n3178\t                return False, \"approval_degraded\"\n3179\t            if agg[\"approval_seen\"] or agg[\"allowing\"]:\n3180\t                return False, \"approval_barrier\"\n3181\t            if is_exec and APPROVAL_MODE == \"denyUnmatched\":\n3182\t                return False, \"exec_fallback_disabled\"\n3183\t            if runs and not all(getattr(r, \"dead_confirmed\", True) for r in runs):\n3184\t                return False, \"group_not_dead\"\n3185\t            if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3186\t                return False, \"insufficient_remaining\"\n3187\t            if context or TRANSIENT_RETRY_SCOPE == \"observed-items\":\n3188\t                if agg[\"observed\"]:\n3189\t                    return False, \"observed_barrier\"\n3190\t            elif agg[\"action\"]:\n3191\t                return False, \"action_possible\"\n3192\t            return True, \"\"\n3193\t\n3194\t        def _blocked_out(err: str) -> dict[str, Any]:\n3195\t            return {\n3196\t                \"rc\": 1,\n3197\t                \"text\": \"\",\n3198\t                \"chunks\": [],\n3199\t                \"err\": err,\n3200\t                \"state\": \"terminal_failed\",\n3201\t                \"approval_seen\": agg[\"approval_seen\"],\n3202\t                \"action_possible\": agg[\"action\"],\n3203\t                \"approval_degraded\": agg[\"degraded\"],\n3204\t                \"observed_barrier\": agg[\"observed\"],\n3205\t                \"transient\": False,\n3206\t            }\n3207\t\n3208\t        def run_attempt(\n3209\t            attempt_prompt: str, *, context: bool = False\n3210\t        ) -> tuple[dict[str, Any], str]:\n3211\t            attempt_calls[0] += 1\n3212\t            ok_gate, gate_reason = _can_start(False, context=context)\n3213\t            if not ok_gate:\n3214\t                _log(f\"new serve process blocked reason={gate_reason}\")\n3215\t                return _blocked_out(f\"new process blocked: {gate_reason}\"), \"blocked\"\n3216\t            serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n3217\t            serve_run.exec_deadline = _exec_deadline\n3218\t            serve_run.write_deadline = _write_deadline\n3219\t            serve_run.request_deadline = _req_deadline\n3220\t            if req.get(\"stream\") is True and self._sse_open:\n3221\t                serve_run.live_sink = self._live_reasoning_sink\n3222\t            runs.append(serve_run)\n3223\t            self._current_run = serve_run\n3224\t            try:\n3225\t                attempt_out = serve_run.execute()\n3226\t                _update_agg(serve_run, attempt_out)\n3227\t                return attempt_out, \"serve\"\n3228\t            except ServeUnavailable as exc:\n3229\t                _update_agg(serve_run, None)\n3230\t                if self._client_gone:\n3231\t                    _log(\"client gone during serve — exec fallback skipped\")\n3232\t                    return (\n3233\t                        {\n3234\t                            \"rc\": -1,\n3235\t                            \"text\": \"\",\n3236\t                            \"err\": \"client gone\",\n3237\t                            \"state\": \"client_gone\",\n3238\t                        },\n3239\t                        \"aborted\",\n3240\t                    )\n3241\t                exc_text = str(exc)\n3242\t                safe_exc = _sanitize_reflected(\n3243\t                    exc_text, [*reflected_prompts, attempt_prompt], raw_messages\n3244\t                )\n3245\t                safe_exc = re.sub(\n3246\t                    r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\", \" \", safe_exc\n3247\t                ).strip()[:300]\n3248\t                if _is_transient_text(exc_text) and not serve_run.ceiling_seen:\n3249\t                    return (\n3250\t                        {\n3251\t                            \"rc\": 1,\n3252\t                            \"text\": \"\",\n3253\t                            \"err\": exc_text,\n3254\t                            \"state\": \"terminal_failed\",\n3255\t                            \"transient\": True,\n3256\t                            \"approval_seen\": agg[\"approval_seen\"],\n3257\t                            \"action_possible\": agg[\"action\"],\n3258\t                            \"approval_degraded\": agg[\"degraded\"],\n3259\t                            \"observed_barrier\": agg[\"observed\"],\n3260\t                        },\n3261\t                        \"serve\",\n3262\t                    )\n3263\t                ok_exec, exec_reason = _can_start(True, context=context)\n3264\t                if not ok_exec:\n3265\t                    if exec_reason == \"exec_fallback_disabled\":\n3266\t                        err = (\n3267\t                            \"exec_fallback_disabled(denyUnmatched): \"\n3268\t                            f\"serve unavailable: {safe_exc}\"\n3269\t                        )\n3270\t                    else:\n3271\t                        err = exc_text\n3272\t                    _log(\n3273\t                        f\"serve unavailable ({safe_exc}), exec fallback blocked \"\n3274\t                        f\"reason={exec_reason}\"\n3275\t                    )\n3276\t                    return _blocked_out(err), \"serve\"\n3277\t                _log(f\"serve unavailable ({safe_exc}), fallback exec model={model}\")\n3278\t                exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n3279\t                exec_run.exec_deadline = _exec_deadline\n3280\t                exec_run.action_possible = True\n3281\t                agg[\"action\"] = True\n3282\t                runs.append(exec_run)\n3283\t                self._current_run = exec_run\n3284\t                attempt_out = exec_run.execute()\n3285\t                _update_agg(exec_run, attempt_out)\n3286\t                return attempt_out, \"exec-after-serve-fallback\"\n3287\t\n3288\t        out: dict[str, Any] = {\n3289\t            \"rc\": 1,\n3290\t            \"text\": \"\",\n3291\t            \"err\": \"no attempt\",\n3292\t            \"state\": \"terminal_failed\",\n3293\t        }\n3294\t        via = \"none\"\n3295\t        try:\n3296\t            out, via = run_attempt(prompt)\n3297\t            while True:\n3298\t                if out.get(\"rc\") == 0 and out.get(\"state\") == \"ok\":\n3299\t                    break\n3300\t                if self._client_gone or getattr(self, \"_delivery_failed\", False):\n3301\t                    break\n3302\t                raw_err = str(out.get(\"err\") or \"\")\n3303\t                is_hard_threshold = (\n3304\t                    out.get(\"rc\") != 0\n3305\t                    and out.get(\"state\") == \"terminal_failed\"\n3306\t                    and (\n3307\t                        bool(out.get(\"hard_threshold\"))\n3308\t                        or HARD_THRESHOLD_ERR_SUBSTR in raw_err\n3309\t                    )\n3310\t                )\n3311\t                # Сначала контекстный повтор (AD-005), затем транзиентный.\n3312\t                if (\n3313\t                    is_hard_threshold\n3314\t                    and context_retry_count == 0\n3315\t                    and attempt_calls[0] < 4\n3316\t                    and not getattr(self, \"_content_started\", False)\n3317\t                ):\n3318\t                    for run in runs:\n3319\t                        run.close()\n3320\t                    if not all(run.dead_confirmed for run in runs):\n3321\t                        _log(\n3322\t                            \"context retry skipped: first attempt process group not confirmed dead\"\n3323\t                        )\n3324\t                        break\n3325\t                    ok_ctx, ctx_reason = _can_start(False, context=True)\n3326\t                    if not ok_ctx:\n3327\t                        _log(f\"context retry skipped reason={ctx_reason}\")\n3328\t                        break\n3329\t                    retry_res = _prune_messages(\n3330\t                        raw_messages,\n3331\t                        limit=retry_target,\n3332\t                        target=retry_target,\n3333\t                        tools=tools,\n3334\t                        tool_choice=tool_choice,\n3335\t                        raw_tools=raw_tools,\n3336\t                    )\n3337\t                    if retry_res.status == \"refused\":\n3338\t                        _log_context_prune(\n3339\t                            rid,\n3340\t                            model,\n3341\t                            \"refused_retry\",\n3342\t                            2,\n3343\t                            limit,\n3344\t                            retry_target,\n3345\t                            retry_res,\n3346\t                        )\n3347\t                        terminal_context_err = (\n3348\t                            f\"mandatory context exceeds budget \"\n3349\t                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n3350\t                        )\n3351\t                        break\n3352\t                    if retry_res.est_after >= current_est or (\n3353\t                        time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S\n3354\t                    ):\n3355\t                        _log_context_prune(\n3356\t                            rid,\n3357\t                            model,\n3358\t                            \"refused_retry\",\n3359\t                            2,\n3360\t                            limit,\n3361\t                            retry_target,\n3362\t                            retry_res,\n3363\t                        )\n3364\t                        terminal_context_err = (\n3365\t                            \"context hard threshold exceeded after single \"\n3366\t                            f\"compaction retry (est_tokens={retry_res.est_after}, \"\n3367\t                            f\"target={retry_target})\"\n3368\t                        )\n3369\t                        break\n3370\t                    if self._client_gone or self._client_gone_probe():\n3371\t                        self._client_gone = True\n3372\t                        break\n3373\t                    context_retry_count = 1\n3374\t                    _log_context_prune(\n3375\t                        rid,\n3376\t                        model,\n3377\t                        \"hard_threshold_retry\",\n3378\t                        2,\n3379\t                        limit,\n3380\t                        retry_target,\n3381\t                        retry_res,\n3382\t                    )\n3383\t                    prompt = retry_res.prompt\n3384\t                    current_est = retry_res.est_after\n3385\t                    reflected_prompts.append(prompt)\n3386\t                    out, via = run_attempt(prompt, context=True)\n3387\t                    raw_err_2 = str(out.get(\"err\") or \"\")\n3388\t                    if (\n3389\t                        out.get(\"rc\") != 0\n3390\t                        and out.get(\"state\") == \"terminal_failed\"\n3391\t                        and (\n3392\t                            bool(out.get(\"hard_threshold\"))\n3393\t                            or HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n3394\t                        )\n3395\t                    ):\n3396\t                        terminal_context_err = (\n3397\t                            \"context hard threshold exceeded after single \"\n3398\t                            f\"compaction retry (est_tokens={current_est}, \"\n3399\t                            f\"target={retry_target})\"\n3400\t                        )\n3401\t                    continue\n3402\t                is_transient = (\n3403\t                    out.get(\"rc\") != 0\n3404\t                    and str(out.get(\"state\") or \"\") not in NON_RETRYABLE_STATES\n3405\t                    and (bool(out.get(\"transient\")) or _is_transient_text(raw_err))\n3406\t                )\n3407\t                max_calls = 4 if context_retry_count else 3\n3408\t                if (\n3409\t                    not is_transient\n3410\t                    or transient_retry_count >= TRANSIENT_MAX_RETRIES\n3411\t                    or attempt_calls[0] >= max_calls\n3412\t                ):\n3413\t                    if is_transient and getattr(self, \"_content_started\", False):\n3414\t                        _log(\"retry_blocked reason=content_started\")\n3415\t                    break\n3416\t                for run in runs:\n3417\t                    run.close()\n3418\t                ok_retry, retry_reason = _can_start(False)\n3419\t                if not ok_retry:\n3420\t                    if getattr(self, \"_content_started\", False):\n3421\t                        _log(f\"retry_blocked reason={retry_reason} content_started=1\")\n3422\t                    else:\n3423\t                        _log(f\"transient retry blocked reason={retry_reason}\")\n3424\t                    break\n3425\t                backoff = TRANSIENT_BACKOFF_S\n3426\t                pause = backoff[min(transient_retry_count, len(backoff) - 1)]\n3427\t                if TRANSIENT_JITTER_S > 0:\n3428\t                    pause += random.uniform(0, TRANSIENT_JITTER_S)\n3429\t                transient_retry_count += 1\n3430\t                if TRANSIENT_RETRY_SCOPE == \"observed-items\":\n3431\t                    _log(\n3432\t                        \"transient retry retry_scope=observed-items \"\n3433\t                        f\"n={transient_retry_count}\"\n3434\t                    )\n3435\t                else:\n3436\t                    _log(\n3437\t                        \"transient retry retry_scope=pre-action \"\n3438\t                        f\"n={transient_retry_count} pause_s={pause:.2f}\"\n3439\t                    )\n3440\t                pause_end = min(time.monotonic() + pause, _exec_deadline)\n3441\t                client_left = False\n3442\t                while time.monotonic() < pause_end:\n3443\t                    if self._client_gone or self._client_gone_probe():\n3444\t                        self._client_gone = True\n3445\t                        client_left = True\n3446\t                        break\n3447\t                    time.sleep(min(0.05, max(0.0, pause_end - time.monotonic())))\n3448\t                if client_left:\n3449\t                    break\n3450\t                out, via = run_attempt(prompt)\n3451\t        finally:\n3452\t            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n3453\t            watch_stop.set()\n3454\t            watcher.join(timeout=2)\n3455\t            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n3456\t            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n3457\t            # между Popen и собственным finally execute().\n3458\t            for run in runs:\n3459\t                run.close()\n3460\t            if all(run.dead_confirmed for run in runs):\n3461\t                _slots.release()\n3462\t            else:\n3463\t                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n3464\t                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n3465\t\n3466\t        if self._client_gone:\n3467\t            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n3468\t            _log(\"client gone — response skipped\")\n3469\t            return\n3470\t        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n3471\t        out = dict(out)\n3472\t        diagnostic = _sanitize_reflected(\n3473\t            str(out.get(\"err\") or \"\"), reflected_prompts, raw_messages\n3474\t        )\n3475\t        if terminal_context_err is not None:\n3476\t            diagnostic = _redact_secrets(terminal_context_err)\n3477\t        out[\"err\"] = _redact_secrets(diagnostic)\n3478\t        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n3479\t            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n3480\t            self._send(\n3481\t                502,\n3482\t                {\n3483\t                    \"error\": {\n3484\t                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n3485\t                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n3486\t                        \"type\": \"proxy_error\",\n3487\t                        \"code\": 502,\n3488\t                    }\n3489\t                },\n3490\t            )\n3491\t            return\n3492\t        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n3493\t            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n3494\t            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n3495\t            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n3496\t            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n3497\t            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n3498\t            err_message = (\n3499\t                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n3500\t            )\n3501\t            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n3502\t                err_message = f\"{err_message}: {detail}\"\n3503\t            self._send(\n3504\t                502,\n3505\t                {\n3506\t                    \"error\": {\n3507\t                        \"message\": _redact_secrets(err_message),\n3508\t                        \"detail\": detail,\n3509\t                        \"type\": \"proxy_error\",\n3510\t                        \"code\": 502,\n3511\t                    }\n3512\t                },\n3513\t            )\n3514\t            return\n3515\t        content = out[\"text\"]\n3516\t        tool_calls: list[dict] = []\n3517\t        if emulate_tools and content:\n3518\t            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n3519\t        if not content and not tool_calls:"}]},"parent_tool_use_id":null,"session_id":"4b21654b-c0d2-42b3-be01-0e38d5ad59b6","uuid":"592daa80-fec5-4dc0-9fb2-b9d87921beca","timestamp":"2026-10-16T07:15:10.402Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py","content":"            return\n        path = self.path.split(\"?\", 1)[0]\n        length = int(self.headers.get(\"Content-Length\") or \"0\")\n        raw = self.rfile.read(length) if length else b\"{}\"\n        try:\n            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n        except ValueError:\n            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n            return\n        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n            return\n        try:\n            self._serve_json(req)\n        finally:\n            # Любой выход (в т.ч. обрыв в очереди за слотом): поток keepalive не переживает запрос.\n            self._sse_stop_keepalive()\n            _done = getattr(self, \"_req_done\", None)\n            if _done is not None:\n                _done.set()\n            self._write_deadline = float(\"inf\")\n            self._exec_deadline = float(\"inf\")\n            self._request_deadline = float(\"inf\")\n            self._delivery_failed = False\n\n    def _serve_json(self, req: dict) -> None:\n        # Абсолютный бюджет запроса a4: t0 при приёме, до очереди и вычислений.\n        _t0 = time.monotonic()\n        _req_deadline = _t0 + min(TIMEOUT_S, REQUEST_CAP_S)\n        _exec_deadline = _req_deadline - FINISH_RESERVE_S\n        _write_deadline = _req_deadline - CLOSE_RESERVE_S\n        self._request_deadline = _req_deadline\n        self._exec_deadline = _exec_deadline\n        self._write_deadline = _write_deadline\n        self._live_sent_text = \"\"\n        self._delivery_failed = False\n        _req_done = threading.Event()\n        self._req_done = _req_done\n\n        def _supervise_w() -> None:\n            while not _req_done.wait(0.05):\n                if time.monotonic() >= _write_deadline:\n                    self._delivery_failed = True\n                    _log(\"delivery_deadline W reached: closing connection\")\n                    self._kill_current_run()\n                    self._force_close_connection()\n                    return\n\n        threading.Thread(target=_supervise_w, daemon=True).start()\n        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n        if model not in ALLOWED_MODELS:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n                        \"type\": \"invalid_request_error\",\n                        \"code\": \"model_not_found\",\n                    }\n                },\n            )\n            return\n\n        raw_tools = req.get(\"tools\")\n        tools = (\n            [t for t in raw_tools if isinstance(t, dict)]\n            if isinstance(raw_tools, list)\n            else []\n        )\n        tool_choice = req.get(\"tool_choice\")\n        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n\n        raw_messages = req.get(\"messages\") or []\n        _, raw_turns_text = _messages_to_prompt(raw_messages)\n        if not raw_turns_text:\n            self._send(\n                400,\n                {\n                    \"error\": {\n                        \"message\": \"no user content\",\n                        \"type\": \"invalid_request_error\",\n                    }\n                },\n            )\n            return\n\n        rid = uuid.uuid4().hex[:8]\n        limit = _context_limit(model)\n        target = _context_target(limit)\n        retry_target = _context_retry_target(limit)\n        prune_res = _prune_messages(\n            raw_messages,\n            limit=limit,\n            target=target,\n            tools=tools,\n            tool_choice=tool_choice,\n            raw_tools=raw_tools,\n        )\n        if prune_res.status == \"refused\":\n            _log_context_prune(\n                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n            )\n            detail = (\n                f\"mandatory context exceeds budget \"\n                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n            )\n            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n            _log(\n                _format_err_log(\n                    model,\n                    \"refused\",\n                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n                    req.get(\"stream\") is True,\n                )\n            )\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_msg),\n                        \"detail\": _redact_secrets(detail)[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if prune_res.status == \"pruned\":\n            _log_context_prune(\n                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n            )\n\n        prompt = prune_res.prompt\n        current_est = prune_res.est_after\n        reflected_prompts: list[str] = [prompt]\n\n        effort = _map_effort(req)\n\n        if req.get(\"stream\") is True and not self._sse_begin(model):\n            return\n        while not _slots.acquire(timeout=1.0):\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                _log(\"client gone while waiting for a slot\")\n                return\n            if time.monotonic() >= _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n                _log(\"insufficient remaining budget while waiting for a slot\")\n                self._send(\n                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n                )\n                return\n        if self._client_gone or self._client_gone_probe():\n            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n            self._client_gone = True\n            _log(\"client gone while waiting for a slot\")\n            _slots.release()\n            return\n        if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n            _log(\"insufficient remaining budget after slot acquire\")\n            _slots.release()\n            self._send(503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}})\n            return\n        watch_stop = threading.Event()\n        watcher = threading.Thread(\n            target=self._watch_client, args=(watch_stop,), daemon=True\n        )\n        watcher.start()\n        runs: list = []\n        terminal_context_err: str | None = None\n        context_retry_count = 0\n        transient_retry_count = 0\n        attempt_calls = [0]\n        agg: dict[str, bool] = {\n            \"approval_seen\": False,\n            \"action\": False,\n            \"allowing\": False,\n            \"degraded\": False,\n            \"observed\": False,\n        }\n\n        def _update_agg(run: Any, out: dict[str, Any] | None) -> None:\n            if run is not None:\n                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n                    getattr(run, \"approval_seen\", False)\n                )\n                agg[\"action\"] = agg[\"action\"] or bool(\n                    getattr(run, \"action_possible\", False)\n                )\n                agg[\"allowing\"] = agg[\"allowing\"] or bool(\n                    getattr(run, \"allowing_decide_attempted\", False)\n                )\n                agg[\"degraded\"] = agg[\"degraded\"] or bool(\n                    getattr(run, \"approval_degraded\", False)\n                )\n                agg[\"observed\"] = agg[\"observed\"] or bool(\n                    getattr(run, \"observed_barrier\", False)\n                )\n            if out:\n                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n                    out.get(\"approval_seen\")\n                )\n                agg[\"action\"] = agg[\"action\"] or bool(out.get(\"action_possible\"))\n                agg[\"allowing\"] = agg[\"allowing\"] or bool(out.get(\"allowing_decide\"))\n                agg[\"degraded\"] = agg[\"degraded\"] or bool(out.get(\"approval_degraded\"))\n                observed = out.get(\"observed_barrier\")\n                if observed is None:\n                    observed = bool(out.get(\"text\") or out.get(\"summaries\"))\n                agg[\"observed\"] = agg[\"observed\"] or bool(observed)\n\n        def _can_start(is_exec: bool, *, context: bool = False) -> tuple[bool, str]:\n            if self._client_gone or self._client_gone_probe():\n                self._client_gone = True\n                return False, \"client_gone\"\n            if getattr(self, \"_content_started\", False):\n                return False, \"content_started\"\n            if getattr(self, \"_delivery_failed\", False):\n                return False, \"delivery_failed\"\n            if agg[\"degraded\"]:\n                return False, \"approval_degraded\"\n            if agg[\"approval_seen\"] or agg[\"allowing\"]:\n                return False, \"approval_barrier\"\n            if is_exec and APPROVAL_MODE == \"denyUnmatched\":\n                return False, \"exec_fallback_disabled\"\n            if runs and not all(getattr(r, \"dead_confirmed\", True) for r in runs):\n                return False, \"group_not_dead\"\n            if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n                return False, \"insufficient_remaining\"\n            if context or TRANSIENT_RETRY_SCOPE == \"observed-items\":\n                if agg[\"observed\"]:\n                    return False, \"observed_barrier\"\n            elif agg[\"action\"]:\n                return False, \"action_possible\"\n            return True, \"\"\n\n        def _blocked_out(err: str) -> dict[str, Any]:\n            return {\n                \"rc\": 1,\n                \"text\": \"\",\n                \"chunks\": [],\n                \"err\": err,\n                \"state\": \"terminal_failed\",\n                \"approval_seen\": agg[\"approval_seen\"],\n                \"action_possible\": agg[\"action\"],\n                \"approval_degraded\": agg[\"degraded\"],\n                \"observed_barrier\": agg[\"observed\"],\n                \"transient\": False,\n            }\n\n        def run_attempt(\n            attempt_prompt: str, *, context: bool = False\n        ) -> tuple[dict[str, Any], str]:\n            attempt_calls[0] += 1\n            ok_gate, gate_reason = _can_start(False, context=context)\n            if not ok_gate:\n                _log(f\"new serve process blocked reason={gate_reason}\")\n                return _blocked_out(f\"new process blocked: {gate_reason}\"), \"blocked\"\n            serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n            serve_run.exec_deadline = _exec_deadline\n            serve_run.write_deadline = _write_deadline\n            serve_run.request_deadline = _req_deadline\n            if req.get(\"stream\") is True and self._sse_open:\n                serve_run.live_sink = self._live_reasoning_sink\n            runs.append(serve_run)\n            self._current_run = serve_run\n            try:\n                attempt_out = serve_run.execute()\n                _update_agg(serve_run, attempt_out)\n                return attempt_out, \"serve\"\n            except ServeUnavailable as exc:\n                _update_agg(serve_run, None)\n                if self._client_gone:\n                    _log(\"client gone during serve — exec fallback skipped\")\n                    return (\n                        {\n                            \"rc\": -1,\n                            \"text\": \"\",\n                            \"err\": \"client gone\",\n                            \"state\": \"client_gone\",\n                        },\n                        \"aborted\",\n                    )\n                exc_text = str(exc)\n                safe_exc = _sanitize_reflected(\n                    exc_text, [*reflected_prompts, attempt_prompt], raw_messages\n                )\n                safe_exc = re.sub(\n                    r\"[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]\", \" \", safe_exc\n                ).strip()[:300]\n                if _is_transient_text(exc_text) and not serve_run.ceiling_seen:\n                    return (\n                        {\n                            \"rc\": 1,\n                            \"text\": \"\",\n                            \"err\": exc_text,\n                            \"state\": \"terminal_failed\",\n                            \"transient\": True,\n                            \"approval_seen\": agg[\"approval_seen\"],\n                            \"action_possible\": agg[\"action\"],\n                            \"approval_degraded\": agg[\"degraded\"],\n                            \"observed_barrier\": agg[\"observed\"],\n                        },\n                        \"serve\",\n                    )\n                ok_exec, exec_reason = _can_start(True, context=context)\n                if not ok_exec:\n                    if exec_reason == \"exec_fallback_disabled\":\n                        err = (\n                            \"exec_fallback_disabled(denyUnmatched): \"\n                            f\"serve unavailable: {safe_exc}\"\n                        )\n                    else:\n                        err = exc_text\n                    _log(\n                        f\"serve unavailable ({safe_exc}), exec fallback blocked \"\n                        f\"reason={exec_reason}\"\n                    )\n                    return _blocked_out(err), \"serve\"\n                _log(f\"serve unavailable ({safe_exc}), fallback exec model={model}\")\n                exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n                exec_run.exec_deadline = _exec_deadline\n                exec_run.action_possible = True\n                agg[\"action\"] = True\n                runs.append(exec_run)\n                self._current_run = exec_run\n                attempt_out = exec_run.execute()\n                _update_agg(exec_run, attempt_out)\n                return attempt_out, \"exec-after-serve-fallback\"\n\n        out: dict[str, Any] = {\n            \"rc\": 1,\n            \"text\": \"\",\n            \"err\": \"no attempt\",\n            \"state\": \"terminal_failed\",\n        }\n        via = \"none\"\n        try:\n            out, via = run_attempt(prompt)\n            while True:\n                if out.get(\"rc\") == 0 and out.get(\"state\") == \"ok\":\n                    break\n                if self._client_gone or getattr(self, \"_delivery_failed\", False):\n                    break\n                raw_err = str(out.get(\"err\") or \"\")\n                is_hard_threshold = (\n                    out.get(\"rc\") != 0\n                    and out.get(\"state\") == \"terminal_failed\"\n                    and (\n                        bool(out.get(\"hard_threshold\"))\n                        or HARD_THRESHOLD_ERR_SUBSTR in raw_err\n                    )\n                )\n                # Сначала контекстный повтор (AD-005), затем транзиентный.\n                if (\n                    is_hard_threshold\n                    and context_retry_count == 0\n                    and attempt_calls[0] < 4\n                    and not getattr(self, \"_content_started\", False)\n                ):\n                    for run in runs:\n                        run.close()\n                    if not all(run.dead_confirmed for run in runs):\n                        _log(\n                            \"context retry skipped: first attempt process group not confirmed dead\"\n                        )\n                        break\n                    ok_ctx, ctx_reason = _can_start(False, context=True)\n                    if not ok_ctx:\n                        _log(f\"context retry skipped reason={ctx_reason}\")\n                        break\n                    retry_res = _prune_messages(\n                        raw_messages,\n                        limit=retry_target,\n                        target=retry_target,\n                        tools=tools,\n                        tool_choice=tool_choice,\n                        raw_tools=raw_tools,\n                    )\n                    if retry_res.status == \"refused\":\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            f\"mandatory context exceeds budget \"\n                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n                        )\n                        break\n                    if retry_res.est_after >= current_est or (\n                        time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S\n                    ):\n                        _log_context_prune(\n                            rid,\n                            model,\n                            \"refused_retry\",\n                            2,\n                            limit,\n                            retry_target,\n                            retry_res,\n                        )\n                        terminal_context_err = (\n                            \"context hard threshold exceeded after single \"\n                            f\"compaction retry (est_tokens={retry_res.est_after}, \"\n                            f\"target={retry_target})\"\n                        )\n                        break\n                    if self._client_gone or self._client_gone_probe():\n                        self._client_gone = True\n                        break\n                    context_retry_count = 1\n                    _log_context_prune(\n                        rid,\n                        model,\n                        \"hard_threshold_retry\",\n                        2,\n                        limit,\n                        retry_target,\n                        retry_res,\n                    )\n                    prompt = retry_res.prompt\n                    current_est = retry_res.est_after\n                    reflected_prompts.append(prompt)\n                    out, via = run_attempt(prompt, context=True)\n                    raw_err_2 = str(out.get(\"err\") or \"\")\n                    if (\n                        out.get(\"rc\") != 0\n                        and out.get(\"state\") == \"terminal_failed\"\n                        and (\n                            bool(out.get(\"hard_threshold\"))\n                            or HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n                        )\n                    ):\n                        terminal_context_err = (\n                            \"context hard threshold exceeded after single \"\n                            f\"compaction retry (est_tokens={current_est}, \"\n                            f\"target={retry_target})\"\n                        )\n                    continue\n                is_transient = (\n                    out.get(\"rc\") != 0\n                    and str(out.get(\"state\") or \"\") not in NON_RETRYABLE_STATES\n                    and (bool(out.get(\"transient\")) or _is_transient_text(raw_err))\n                )\n                max_calls = 4 if context_retry_count else 3\n                if (\n                    not is_transient\n                    or transient_retry_count >= TRANSIENT_MAX_RETRIES\n                    or attempt_calls[0] >= max_calls\n                ):\n                    if is_transient and getattr(self, \"_content_started\", False):\n                        _log(\"retry_blocked reason=content_started\")\n                    break\n                for run in runs:\n                    run.close()\n                ok_retry, retry_reason = _can_start(False)\n                if not ok_retry:\n                    if getattr(self, \"_content_started\", False):\n                        _log(f\"retry_blocked reason={retry_reason} content_started=1\")\n                    else:\n                        _log(f\"transient retry blocked reason={retry_reason}\")\n                    break\n                backoff = TRANSIENT_BACKOFF_S\n                pause = backoff[min(transient_retry_count, len(backoff) - 1)]\n                if TRANSIENT_JITTER_S > 0:\n                    pause += random.uniform(0, TRANSIENT_JITTER_S)\n                transient_retry_count += 1\n                if TRANSIENT_RETRY_SCOPE == \"observed-items\":\n                    _log(\n                        \"transient retry retry_scope=observed-items \"\n                        f\"n={transient_retry_count}\"\n                    )\n                else:\n                    _log(\n                        \"transient retry retry_scope=pre-action \"\n                        f\"n={transient_retry_count} pause_s={pause:.2f}\"\n                    )\n                pause_end = min(time.monotonic() + pause, _exec_deadline)\n                client_left = False\n                while time.monotonic() < pause_end:\n                    if self._client_gone or self._client_gone_probe():\n                        self._client_gone = True\n                        client_left = True\n                        break\n                    time.sleep(min(0.05, max(0.0, pause_end - time.monotonic())))\n                if client_left:\n                    break\n                out, via = run_attempt(prompt)\n        finally:\n            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n            watch_stop.set()\n            watcher.join(timeout=2)\n            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n            # между Popen и собственным finally execute().\n            for run in runs:\n                run.close()\n            if all(run.dead_confirmed for run in runs):\n                _slots.release()\n            else:\n                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n\n        if self._client_gone:\n            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n            _log(\"client gone — response skipped\")\n            return\n        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n        out = dict(out)\n        diagnostic = _sanitize_reflected(\n            str(out.get(\"err\") or \"\"), reflected_prompts, raw_messages\n        )\n        if terminal_context_err is not None:\n            diagnostic = _redact_secrets(terminal_context_err)\n        out[\"err\"] = _redact_secrets(diagnostic)\n        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n            err_message = (\n                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n            )\n            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n                err_message = f\"{err_message}: {detail}\"\n            self._send(\n                502,\n                {\n                    \"error\": {\n                        \"message\": _redact_secrets(err_message),\n                        \"detail\": detail,\n                        \"type\": \"proxy_error\",\n                        \"code\": 502,\n                    }\n                },\n            )\n            return\n        content = out[\"text\"]\n        tool_calls: list[dict] = []\n        if emulate_tools and content:\n            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n        if not content and not tool_calls:","numLines":560,"startLine":2960,"totalLines":3662}},"tool_result_meta":[{"id":"toolu_01AeYEQhUd1PJMCHxVjMSTyE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
