1..T-R12, markers, budget, pre-action barrier, queue/deadline, quarantine)\n36\t- `LiveReasoningTest`: 12 tests (T-L01..T-L09, monotonic deltas, freeze, diverged reconciliation, bounded socket write)\n37\t- `CloseKillsGroupTest`, `HealthQuarantinedTest`, `DisconnectScenarioTest`, `ServeDisconnectScenarioTest`, `ClientGoneProbeTest`, `QuarantineSlotTest`, `ConcurrentCloseTest`, `WaitGroupExitTest`, `ErrorLoggingTest`, `ServeTurnErrorExtractionTest`, `SseDataKeepaliveTest`, `CliDisableFlagsAndApprovalFallbackTest`, `AllowedModelsSyncTest`, `ContextPruneTest`, `ContextRetryTest`: 63 tests.\n38\t\n39\t## 4. Clean-Room L2 Verifier Summary\n40\t- `tests/test_muse_bridge_killpg.py`: 111 passed, 0 failed.\n41\t- Full `tests/` suite: 648 passed, 1 pre-existing failure (`test_b_guard.py tm018`, PASS_WITH_PREEXISTING).\n42\t- Code quality:\n43\t  - `ruff format --check`: 0 errors (all files formatted)\n44\t  - `ruff check`: 0 errors\n45\t  - `basedpyright`: 0 errors (1982 warnings, baseline 1448 warnings)\n46\t  - `git diff --check`: 0 whitespace/conflict errors\n47\t  - Scope: strictly `bridges/muse-bridge/server.py` and `tests/test_muse_bridge_killpg.py`.\n48\t\n49\t## 5. Full Git Diff (`git diff 9f87eb0..HEAD`)\n50\t```diff\n51\tdiff --git a/bridges/muse-bridge/server.py b/bridges/muse-bridge/server.py\n52\tindex f961cd8..0bbb1ad 100644\n53\t--- a/bridges/muse-bridge/server.py\n54\t+++ b/bridges/muse-bridge/server.py\n55\t@@ -38,6 +38,7 @@ Keepalive: пустые data-чанки держат SSE-соединение, \n56\t \n57\t from __future__ import annotations\n58\t \n59\t+import hashlib\n60\t import json\n61\t import logging\n62\t import os\n63\t@@ -137,6 +138,170 @@ _SIGNAL_RCS = (\n64\t TERMINAL_EXIT_GRACE_S = 0.5\n65\t SERVE_SPAWN_TIMEOUT_S = 30.0  # handshake+session/start должны уложиться сюда\n66\t \n67\t+# --- REQ-MUSE-002/003/004 (пакет a4): approval, бюджеты, повторы, live ---\n68\t+APPROVAL_MODE = os.environ.get(\"MUSE_BRIDGE_APPROVAL_MODE\", \"allowAll\").strip()\n69\t+TRANSIENT_RETRY_SCOPE = os.environ.get(\n70\t+    \"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE\", \"pre-action\"\n71\t+).strip()\n72\t+FINISH_RESERVE_S = 35.0\n73\t+CLOSE_RESERVE_S = 12.0\n74\t+REQUEST_CAP_S = 1800.0\n75\t+MIN_ATTEMPT_REMAINING_S = float(os.environ.get(\"MUSE_BRIDGE_MIN_ATTEMPT_S\", \"120\"))\n76\t+CONTROL_WRITE_TIMEOUT_S = 5.0\n77\t+LIVE_WRITE_TIMEOUT_S = 3.0\n78\t+APPROVAL_CANCEL_GRACE_S = 15.0\n79\t+MAX_APPROVAL_DECIDE = 10\n80\t+MAX_USER_INPUT_CANCEL = 3\n81\t+TRANSIENT_MAX_RETRIES = 2\n82\t+TRANSIENT_BACKOFF_S: tuple[float, float] = (2.0, 4.0)\n83\t+TRANSIENT_JITTER_S = 1.0\n84\t+TRANSIENT_MARKERS: tuple[str, ...] = (\n85\t+    \"[net-timeout]\",\n86\t+    \"timed out waiting for response data\",\n87\t+    NETWORK_RETRY_MARKER,\n88\t+    \"transport_connect_unreachable\",\n89\t+)\n90\t+NON_RETRYABLE_STATES = frozenset(\n91\t+    {\"timeout\", \"spawn_failed\", \"launcher_missing\", \"client_gone\"}\n92\t+)\n93\t+\n94\t+\n95\t+def _validate_startup_config() -> None:\n96\t+    \"\"\"Невалидный env-режим или бюджет останавливают старт моста (AD-007).\"\"\"\n97\t+    if APPROVAL_MODE not in (\"allowAll\", \"denyUnmatched\"):\n98\t+        raise RuntimeError(f\"MUSE_BRIDGE_APPROVAL_MODE invalid: {APPROVAL_MODE!r}\")\n99\t+    if TRANSIENT_RETRY_SCOPE not in (\"pre-action\", \"observed-items\"):\n100\t+        raise RuntimeError(\n101\t+            f\"MUSE_BRIDGE_TRANSIENT_RETRY_SCOPE invalid: {TRANSIENT_RETRY_SCOPE!r}\"\n102\t+        )\n103\t+    if TIMEOUT_S < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S:\n104\t+        raise RuntimeError(\n105\t+            \"MUSE_BRIDGE_TIMEOUT_S too small: \"\n106\t+            f\"{TIMEOUT_S} < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S \"\n107\t+            f\"({FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S})\"\n108\t+        )\n109\t+\n110\t+\n111\t+_validate_startup_config()\n112\t+\n113\t+\n114\t+def _is_transient_text(*values: Any) -> bool:\n115\t+    \"\"\"Классификация транзиента только по явным маркерам (§3.1 пакета).\"\"\"\n116\t+    for value in values:\n117\t+        if value is None:\n118\t+            continue\n119\t+        if isinstance(value, str):\n120\t+            text = value\n121\t+        elif isinstance(value, (list, tuple)):\n122\t+            if _is_transient_text(*value):\n123\t+                return True\n124\t+            continue\n125\t+        elif isinstance(value, dict):\n126\t+            text = \" \".join(\n127\t+                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n128\t+            )\n129\t+            if not text.strip():\n130\t+                text = str(value)\n131\t+        else:\n132\t+            text = str(value)\n133\t+        if any(marker in text for marker in TRANSIENT_MARKERS):\n134\t+            return True\n135\t+    return False\n136\t+\n137\t+\n138\t+_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n139\t+_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n140\t+\n141\t+\n142\t+def _render_audit_token(value: Any) -> str:\n143\t+    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n144\t+    text = value if isinstance(value, str) else \"\"\n145\t+    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n146\t+        return text\n147\t+    raw = text if isinstance(value, str) else str(value or \"\")\n148\t+    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n149\t+    return f\"redacted(len={len(raw)},sha256={digest})\"\n150\t+\n151\t+\n152\t+def _render_tool_token(value: Any) -> str:\n153\t+    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n154\t+    text = value if isinstance(value, str) else \"\"\n155\t+    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n156\t+        return text\n157\t+    return f\"redacted(len={len(text)})\"\n158\t+\n159\t+\n160\t+class ApprovalPolicy:\n161\t+    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n162\t+\n163\t+    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n164\t+    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n165\t+    \"\"\"\n166\t+\n167\t+    def __init__(self, mode: str) -> None:\n168\t+        self.mode = mode\n169\t+\n170\t+    @staticmethod\n171\t+    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n172\t+        raw = params.get(\"availableChoices\")\n173\t+        if not isinstance(raw, list):\n174\t+            return []\n175\t+        return [c for c in raw if isinstance(c, dict)]\n176\t+\n177\t+    @staticmethod\n178\t+    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n179\t+        if not params:\n180\t+            return None\n181\t+        for choice in ApprovalPolicy._choices(params):\n182\t+            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n183\t+                return choice\n184\t+        return None\n185\t+\n186\t+    def evaluate(self, params: dict[str, Any]) -> dict[str, Any]:\n187\t+        choices = self._choices(params)\n188\t+        approve = next(\n189\t+            (c for c in choices if c.get(\"decision\") == \"approved\"), None\n190\t+        ) or next(\n191\t+            (c for c in choices if c.get(\"decision\") == \"approvedForSession\"), None\n192\t+        )\n193\t+        deny = self.deny_choice(params)\n194\t+        action = \"fail_turn\"\n195\t+        chosen: dict[str, Any] | None = None\n196\t+        if self.mode == \"allowAll\" and approve is not None:\n197\t+            action, chosen = \"approve\", approve\n198\t+        elif deny is not None:\n199\t+            action, chosen = \"deny\", deny\n200\t+        subject = (\n201\t+            params.get(\"subject\") if isinstance(params.get(\"subject\"), dict) else {}\n202\t+        )\n203\t+        choice_ids = \",\".join(\n204\t+            _render_audit_token(c.get(\"choiceId\")) for c in choices[:8]\n205\t+        )\n206\t+        audit = (\n207\t+            \"approval_decide \"\n208\t+            f\"tool={_render_audit_token(params.get('toolName'))} \"\n209\t+            f\"subject={_render_audit_token(subject.get('kind'))} \"\n210\t+            f\"protected={1 if params.get('protectedWrite') else 0} \"\n211\t+            f\"judge={1 if params.get('judgeEscalated') else 0} \"\n212\t+            f\"choices=[{choice_ids}] \"\n213\t+            f\"chosen={_render_audit_token(chosen.get('choiceId')) if chosen else 'none'} \"\n214\t+            f\"decision={_render_audit_token(chosen.get('decision')) if chosen else 'none'}\"\n215\t+        )\n216\t+        return {\n217\t+            \"action\": action,\n218\t+            \"choice_id\": chosen.get(\"choiceId\") if chosen else None,\n219\t+            \"decision\": chosen.get(\"decision\") if chosen else None,\n220\t+            \"audit\": audit,\n221\t+        }\n222\t+\n223\t+    def evaluate_user_input(self, params: dict[str, Any]) -> dict[str, Any]:\n224\t+        return {\n225\t+            \"action\": \"cancel_user_input\",\n226\t+            \"audit\": (\n227\t+                f\"user_input_cancel tool={_render_audit_token(params.get('toolName'))}\"\n228\t+            ),\n229\t+        }\n230\t+\n231\t \n232\t class ServeUnavailable(Exception):\n233\t     \"\"\"Транспорт serve недоступен -> тихий fallback на exec. Не ошибка запроса.\"\"\"\n234\t@@ -1332,6 +1497,11 @@ class Run:\n235\t         self.dead_confirmed = (\n236\t             True  # False — группа не подтверждена мёртвой (карантин слота)\n237\t         )\n238\t+        # Барьеры AD-003: exec защёлкивает ACTION_POSSIBLE при старте процесса.\n239\t+        self.action_possible = False\n240\t+        self.approval_seen = False\n241\t+        self.observed_barrier = False\n242\t+        self.exec_deadline = float(\"inf\")\n243\t \n244\t     def close(self) -> None:\n245\t         \"\"\"Убить группу процессов хода и коротко дождаться её ухода.\n246\t@@ -1438,6 +1608,7 @@ class Run:\n247\t                     \"err\": f\"spawn failed: {exc}\",\n248\t                     \"state\": \"spawn_failed\",\n249\t                 }\n250\t+            self.action_possible = True\n251\t \n252\t             def drain_stderr() -> None:\n253\t                 try:\n254\t@@ -1453,8 +1624,11 @@ class Run:\n255\t             err_thread.start()\n256\t \n257\t             # Жёсткий дедлайн: таймер убивает процесс, даже если stdout молчит.\n258\t+            _remain = self.exec_deadline - time.monotonic()\n259\t+            _timer_s = min(TIMEOUT_S, _remain) if _remain != float(\"inf\") else TIMEOUT_S\n260\t             timer = threading.Timer(\n261\t-                TIMEOUT_S, lambda: (err_lines.append(\"bridge timeout\"), self.close())\n262\t+                max(0.05, _timer_s),\n263\t+                lambda: (err_lines.append(\"bridge timeout\"), self.close()),\n264\t             )\n265\t             timer.daemon = True\n266\t             timer.start()\n267\t@@ -1556,25 +1730,29 @@ class Run:\n268\t             \"err\": \"\\n\".join(err_lines[-6:]),\n269\t             \"state\": state,\n270\t             \"hard_threshold\": _has_hard_threshold_marker(err_lines, reason),\n271\t+            \"action_possible\": self.action_possible,\n272\t+            \"approval_seen\": False,\n273\t+            \"observed_barrier\": bool(text),\n274\t+            \"transient\": state != \"ok\" and _is_transient_text(err_lines, reason),\n275\t         }\n276\t \n277\t \n278\t class ServeRun:\n279\t     \"\"\"Один запрос через `muse serve` (MSP v1 по stdio, NDJSON JSON-RPC).\n280\t \n281\t-    Поток (проверен офлайн на echo-провайдере 05.10.2026): initialize ->\n282\t-    notify initialized -> session/start (без approvalMode: любое явное\n283\t-    значение режектится startup ceiling; провайдер meta)\n284\t-    провайдер meta) -> turn/start (reasoningEffort=тир) -> ждём turn/completed.\n285\t+    Поток: initialize -> notify initialized -> session/start\n286\t+    (approvalMode из AD-001/AD-007; провайдер meta) -> turn/start\n287\t+    (reasoningEffort=тир) -> ждём turn/completed; остаточные\n288\t+    approval/userInput обрабатывает ApprovalPolicy в том же ходе (AD-002).\n289\t     Текст — из agentMessage (item/completed.text, fallback — item/delta);\n290\t     reasoning summaries — из reasoning-item (summary[] + item/delta\n291\t     field \"summary.N\"); токены — из session/tokenUsage (reasoningTokens\n292\t     включительно). Сырой reasoning-текст в v1 не стримится (только\n293\t     summaries) — ограничение протокола, не моста.\n294\t \n295\t-    Любая транспортная неполадка (спавн, handshake, таймаут, интерактивный\n296\t-    запрос approval/userInput, JSON-RPC error) -> ServeUnavailable, и\n297\t-    вызывающий код тихо идёт на exec. Ошибка самой модели\n298\t+    Транспортная неполадка до ACTION_POSSIBLE -> ServeUnavailable;\n299\t+    допуск exec-fallback решает единый предикат Handler (AD-003).\n300\t+    Ошибка самой модели\n301\t     (terminal != completed) — НЕ ServeUnavailable: ход реально выполнен,\n302\t     fallback лишь удвоил бы вызов.\n303\t     \"\"\"\n304\t@@ -1595,6 +1773,26 @@ class ServeRun:\n305\t         # Запись в stdin serve ограничена дедлайном (ставится в execute): зависший читатель\n306\t         # не держит слот бессрочно, при истечении ход завершается, группа убивается.\n307\t         self._write_until = float(\"inf\")\n308\t+        # Барьеры и состояние approval/повторов (AD-002/AD-003, пакет a4).\n309\t+        self.approval_seen = False\n310\t+        self.action_possible = False\n311\t+        self.allowing_decide_attempted = False\n312\t+        self.approval_degraded = False\n313\t+        self.degraded_at: float | None = None\n314\t+        self.grace_end: float | None = None\n315\t+        self.observed_barrier = False\n316\t+        self.tool_item_count = 0\n317\t+        self.decide_count = 0\n318\t+        self.user_input_cancel_count = 0\n319\t+        self.ceiling_seen = False\n320\t+        self.server_version = \"?\"\n321\t+        self.last_error_text = \"\"\n322\t+        self.live_sink: Any = None\n323\t+        self.exec_deadline = float(\"inf\")\n324\t+        self.write_deadline = float(\"inf\")\n325\t+        self.request_deadline = float(\"inf\")\n326\t+        self.turn_started_at: float | None = None\n327\t+        self._live_frozen = False\n328\t \n329\t     def close(self) -> None:\n330\t         \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n331\t@@ -1603,23 +1801,24 @@ class ServeRun:\n332\t             return\n333\t         _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n334\t \n335\t-    def _send(\n336\t-        self, method: str, params: dict | None = None, notify: bool = False\n337\t-    ) -> int:\n338\t+    def _control_limit(self) -> float:\n339\t+        limit = min(\n340\t+            self._write_until,\n341\t+            time.monotonic() + CONTROL_WRITE_TIMEOUT_S,\n342\t+            self.exec_deadline,\n343\t+        )\n344\t+        if self.grace_end is not None:\n345\t+            limit = min(limit, self.grace_end)\n346\t+        return limit\n347\t+\n348\t+    def _write_bytes(self, data: bytes, limit: float) -> None:\n349\t         assert self.proc is not None and self.proc.stdin is not None\n350\t-        self._rid += 1\n351\t-        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n352\t-        if not notify:\n353\t-            msg[\"id\"] = self._rid\n354\t-        if params is not None:\n355\t-            msg[\"params\"] = params\n356\t-        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n357\t         try:\n358\t             fd = self.proc.stdin.fileno()\n359\t             view = memoryview(data)\n360\t             sent = 0\n361\t             while sent < len(data):\n362\t-                remaining = self._write_until - time.time()\n363\t+                remaining = limit - time.monotonic()\n364\t                 if remaining <= 0:\n365\t                     raise ServeUnavailable(\n366\t                         \"serve stdin write timed out: child does not read\"\n367\t@@ -1631,10 +1830,40 @@ class ServeRun:\n368\t                     sent += os.write(fd, view[sent:])\n369\t                 except BlockingIOError:\n370\t                     continue\n371\t+        except ServeUnavailable:\n372\t+            raise\n373\t         except (OSError, ValueError) as exc:\n374\t             raise ServeUnavailable(f\"stdio write failed: {exc}\")\n375\t+\n376\t+    def _send(\n377\t+        self,\n378\t+        method: str,\n379\t+        params: dict | None = None,\n380\t+        notify: bool = False,\n381\t+        *,\n382\t+        control: bool = False,\n383\t+    ) -> int:\n384\t+        self._rid += 1\n385\t+        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n386\t+        if not notify:\n387\t+            msg[\"id\"] = self._rid\n388\t+        if params is not None:\n389\t+            msg[\"params\"] = params\n390\t+        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n391\t+        self._write_bytes(data, self._control_limit() if control else self._write_until)\n392\t         return self._rid\n393\t \n394\t+    def _send_response(self, server_id: Any, result: dict) -> None:\n395\t+        \"\"\"Receipt по серверному id дословно (AD-002).\"\"\"\n396\t+        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"id\": server_id, \"result\": result}\n397\t+        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n398\t+        self._write_bytes(data, self._control_limit())\n399\t+\n400\t+    def _note_allowing_decide(self) -> None:\n401\t+        \"\"\"Защёлкивание ДО первой попытки записи разрешающего decide (a4).\"\"\"\n402\t+        self.allowing_decide_attempted = True\n403\t+        self.action_possible = True\n404\t+\n405\t     def execute(self) -> dict[str, Any]:\n406\t         if not os.access(MUSE_WRAPPER, os.X_OK):\n407\t             raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n408\t@@ -1693,8 +1922,16 @@ class ServeRun:\n409\t \n410\t         err_thread = threading.Thread(target=drain_stderr, daemon=True)\n411\t         err_thread.start()\n412\t-        deadline = time.time() + TIMEOUT_S\n413\t-        setup_deadline = time.time() + SERVE_SPAWN_TIMEOUT_S\n414\t+        _now0 = time.monotonic()\n415\t+        _exec_dl = self.exec_deadline\n416\t+        deadline = (\n417\t+            min(_now0 + TIMEOUT_S, _exec_dl)\n418\t+            if _exec_dl != float(\"inf\")\n419\t+            else _now0 + TIMEOUT_S\n420\t+        )\n421\t+        if self.exec_deadline == float(\"inf\"):\n422\t+            self.exec_deadline = deadline\n423\t+        setup_deadline = min(_now0 + SERVE_SPAWN_TIMEOUT_S, deadline)\n424\t         self._write_until = setup_deadline\n425\t \n426\t         # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n427\t@@ -1702,12 +1939,15 @@ class ServeRun:\n428\t         rbuf = bytearray()\n429\t \n430\t         def read_msg(timeout_at: float) -> dict[str, Any]:\n431\t-            while time.time() < min(timeout_at, deadline):\n432\t+            while time.monotonic() < timeout_at:\n433\t                 if self.proc is None or self.proc.stdout is None:\n434\t                     raise ServeUnavailable(\"serve stdout closed\")\n435\t                 newline = rbuf.find(b\"\\n\")\n436\t                 if newline < 0:\n437\t-                    ready, _, _ = select.select([self.proc.stdout], [], [], 0.5)\n438\t+                    _remain = max(0.0, timeout_at - time.monotonic())\n439\t+                    ready, _, _ = select.select(\n440\t+                        [self.proc.stdout], [], [], min(0.5, _remain)\n441\t+                    )\n442\t                     if not ready:\n443\t                         if self.proc.poll() is not None:\n444\t                             raise ServeUnavailable(\n445\t@@ -1735,16 +1975,6 @@ class ServeRun:\n446\t                     return msg\n447\t             raise ServeUnavailable(\"serve read timeout\")\n448\t \n449\t-        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n450\t-            while True:\n451\t-                msg = read_msg(timeout_at)\n452\t-                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n453\t-                    if \"error\" in msg:\n454\t-                        raise ServeUnavailable(f\"serve RPC error: {msg['error']}\")\n455\t-                    result = msg.get(\"result\")\n456\t-                    return result if isinstance(result, dict) else {}\n457\t-                self._handle_event(msg, None)\n458\t-\n459\t         kinds: dict[str, str] = {}\n460\t         deltas: list[str] = []\n461\t         summary_parts: dict[int, str] = {}\n462\t@@ -1753,13 +1983,223 @@ class ServeRun:\n463\t         usage: dict[str, Any] = {}\n464\t         turn_id: str | None = None\n465\t         session_id: str | None = None\n466\t+        pending: dict[int, str] = {}\n467\t+        seen_pairs: set[tuple[str, str]] = set()\n468\t+        tool_item_ids: set[str] = set()\n469\t+        last_snapshot: list[dict[str, Any]] = []\n470\t+        transient_terminal = [False]\n471\t+        first_summary_logged = [False]\n472\t+\n473\t+        def _pair_key(params: dict[str, Any]) -> tuple[str, str]:\n474\t+            return (\n475\t+                str(params.get(\"approvalId\") or \"\"),\n476\t+                json.dumps(\n477\t+                    params.get(\"currentRequirementId\"),\n478\t+                    ensure_ascii=False,\n479\t+                    sort_keys=True,\n480\t+                    default=str,\n481\t+                ),\n482\t+            )\n483\t+\n484\t+        def _send_decide(\n485\t+            snapshot: dict[str, Any], choice: dict[str, Any], *, allowing: bool\n486\t+        ) -> None:\n487\t+            if allowing:\n488\t+                self._note_allowing_decide()\n489\t+            self.decide_count += 1\n490\t+            rid = self._send(\n491\t+                \"approval/decide\",\n492\t+                {\n493\t+                    \"approvalId\": snapshot.get(\"approvalId\"),\n494\t+                    \"choiceId\": choice.get(\"choiceId\"),\n495\t+                    \"commandId\": _uuid7(),\n496\t+                    \"requirementId\": snapshot.get(\"currentRequirementId\"),\n497\t+                    \"sessionId\": snapshot.get(\"sessionId\") or session_id or \"\",\n498\t+                },\n499\t+                control=True,\n500\t+            )\n501\t+            pending[rid] = \"decide\"\n502\t+\n503\t+        def _latch_degradation(\n504\t+            reason: str, snapshot: dict[str, Any] | None = None\n505\t+        ) -> None:\n506\t+            if self.approval_degraded:\n507\t+                return\n508\t+            self.approval_degraded = True\n509\t+            now = time.monotonic()\n510\t+            self.degraded_at = now\n511\t+            grace_end = now + APPROVAL_CANCEL_GRACE_S\n512\t+            if self.write_deadline != float(\"inf\"):\n513\t+                grace_end = min(\n514\t+                    grace_end, self.write_deadline - 2 * LIVE_WRITE_TIMEOUT_S\n515\t+                )\n516\t+            self.grace_end = grace_end\n517\t+            _log(\n518\t+                f\"approval_degraded reason={reason} approval_seen={int(self.approval_seen)} \"\n519\t+                f\"action_possible={int(self.action_possible)} \"\n520\t+                f\"barrier={int(self.observed_barrier)} tool_items={self.tool_item_count} \"\n521\t+                f\"grace_s={max(0.0, grace_end - now):.2f}\"\n522\t+            )\n523\t+            snap = (\n524\t+                snapshot\n525\t+                if snapshot is not None\n526\t+                else (last_snapshot[0] if last_snapshot else None)\n527\t+            )\n528\t+            try:\n529\t+                deny = ApprovalPolicy.deny_choice(snap)\n530\t+                if deny is not None and self.decide_coun