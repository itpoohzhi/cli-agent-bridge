{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3790,4040p' bridges/agy-bridge/server.py; sed -n '4510,4615p' bridges/agy-bridge/server.py; sed -n '5270,5500p' bridges/agy-bridge/server.py; rg -n 'offer_content\\\\(|def deliver|reasoning_content|_offer_transcript' bridges/agy-bridge/server.py; nl -ba scripts/smoke_models.py; cat .ai-team/runs/dsh-stream-reasoning-formatting-20261102/verification-surface.json\"","aggregated_output":"    всей истории на каждый чанк нет. При исчерпании лимитов приём прекращается с\n    явным `overflow` (accepted-текст молча не отбрасывается и не переотдаётся).\n    \"\"\"\n\n    def __init__(self, turn_id: str) -> None:\n        self.turn_id = turn_id\n        self.by_key: dict[tuple[str, str, int], _ArbStep] = {}\n        self.step_count = 0\n        self.eq_index: dict[str, list[_ArbStep]] = {}\n        self.sorted_texts: list[str] = []\n        # Те же индексы в разрезе источника-создателя: кандидат с валидным idx\n        # сверяется только с шагами ДРУГИХ источников, без скана одноимённых.\n        self._eq_by_source: dict[str, dict[str, list[_ArbStep]]] = {}\n        self._sorted_by_source: dict[str, list[str]] = {}\n        self.retained_divergent: list[str] = []\n        self.retained_divergent_bytes = 0\n        self.last_step: _ArbStep | None = None\n        self.last_by_source: dict[str, _ArbStep] = {}\n        self.chunks: list[str] = []\n        self.bytes_total = 0\n        self.overflow = False\n        self.divergences = 0\n        self.probes = 0\n        self.last_result_diverged = False\n\n    def _set_overflow(self, why: str) -> None:\n        if not self.overflow:\n            self.overflow = True\n            _log(f\"content-overflow turn={self.turn_id[:8] or '-'} why={why}\")\n\n    def _retain_divergent(self, text: str) -> None:\n        \"\"\"Удержать расходящийся текст (до MAX_RETAINED_DIVERGENT_BYTES суммарно).\"\"\"\n        room = MAX_RETAINED_DIVERGENT_BYTES - self.retained_divergent_bytes\n        if room <= 0 or not text:\n            return\n        data = text.encode(\"utf-8\")\n        if len(data) > room:\n            text = data[:room].decode(\"utf-8\", \"ignore\")\n            data = text.encode(\"utf-8\")\n        if text:\n            self.retained_divergent.append(text)\n            self.retained_divergent_bytes += len(data)\n\n    def retained_divergent_text(self) -> str:\n        return \"\".join(self.retained_divergent)\n\n    @staticmethod\n    def _drop(\n        eq: dict[str, list[_ArbStep]],\n        texts: list[str],\n        step: _ArbStep,\n        old: str,\n    ) -> None:\n        bucket = eq.get(old)\n        if bucket is None:\n            return\n        bucket.remove(step)\n        if not bucket:\n            del eq[old]\n            pos = bisect.bisect_left(texts, old)\n            if pos < len(texts) and texts[pos] == old:\n                del texts[pos]\n\n    @staticmethod\n    def _put(\n        eq: dict[str, list[_ArbStep]], texts: list[str], step: _ArbStep, text: str\n    ) -> None:\n        bucket = eq.setdefault(text, [])\n        if not bucket:\n            bisect.insort(texts, text)\n        bucket.append(step)\n\n    def _unindex(self, step: _ArbStep) -> None:\n        old = step.emitted\n        if not old:\n            return\n        self._drop(self.eq_index, self.sorted_texts, step, old)\n        self._drop(\n            self._eq_by_source.setdefault(step.origin, {}),\n            self._sorted_by_source.setdefault(step.origin, []),\n            step,\n            old,\n        )\n\n    def _index(self, step: _ArbStep, text: str) -> None:\n        self._put(self.eq_index, self.sorted_texts, step, text)\n        self._put(\n            self._eq_by_source.setdefault(step.origin, {}),\n            self._sorted_by_source.setdefault(step.origin, []),\n            step,\n            text,\n        )\n\n    def _eligible(self, step: _ArbStep, source: str, idx: int | None) -> bool:\n        self.probes += 1\n        return idx is None or step.origin != source\n\n    def _match(self, source: str, idx: int | None, text: str) -> _ArbStep | None:\n        \"\"\"Шаг, к которому относится кандидат без прямого ключа (уровень 2).\"\"\"\n        if idx is None:\n            found = self._scan(self.eq_index, self.sorted_texts, source, idx, text)\n        else:\n            # Валидный idx: подходят только шаги других источников; одноимённые\n            # (N одинаковых шагов одного источника) не просматриваются вовсе.\n            found = None\n            for other, eq in self._eq_by_source.items():\n                if other == source:\n                    continue\n                found = self._scan(eq, self._sorted_by_source[other], source, idx, text)\n                if found is not None:\n                    break\n        if found is not None:\n            return found\n        refs: list[_ArbStep] = []\n        if self.last_step is not None:\n            refs.append(self.last_step)\n        for other, step in self.last_by_source.items():\n            if other != source and step not in refs:\n                refs.append(step)\n        for step in refs:\n            if (\n                step.emitted\n                and text.startswith(step.emitted)\n                and self._eligible(step, source, idx)\n            ):\n                return step\n        return None\n\n    def _scan(\n        self,\n        eq: dict[str, list[_ArbStep]],\n        texts: list[str],\n        source: str,\n        idx: int | None,\n        text: str,\n    ) -> _ArbStep | None:\n        for step in eq.get(text, ()):\n            if self._eligible(step, source, idx):\n                return step\n        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\n        if candidates:\n            candidates.sort(key=len, reverse=True)\n            for cand in candidates:\n                for step in eq[cand]:\n                    if self._eligible(step, source, idx):\n                        return step\n        if idx is None:\n            pos = bisect.bisect_left(texts, text)\n            while pos < len(texts) and texts[pos].startswith(text):\n                for step in eq[texts[pos]]:\n                    if step.origin != source and self._eligible(step, source, idx):\n                        return step\n                pos += 1\n        return None\n\n    def _advance(self, step: _ArbStep, source: str, text: str) -> str:\n        if step.frozen:\n            return \"\"\n        prefix = step.emitted\n        if text == prefix or (len(text) < len(prefix) and prefix.startswith(text)):\n            return \"\"\n        if not text.startswith(prefix):\n            step.frozen = True\n            self._retain_divergent(text)\n            self.divergences += 1\n            _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source={source}\")\n            return \"\"\n        suffix = text[len(prefix) :]\n        size = len(suffix.encode(\"utf-8\"))\n        if self.bytes_total + size > MAX_CONTENT_BYTES_PER_TURN:\n            self._set_overflow(\"bytes\")\n            return \"\"\n        self._unindex(step)\n        step.emitted = text\n        self._index(step, text)\n        self.chunks.append(suffix)\n        self.bytes_total += size\n        self.last_step = step\n        self.last_by_source[source] = step\n        return suffix\n\n    def offer(self, source: str, step_index: object, text: str, cid: str = \"\") -> str:\n        \"\"\"Кумулятивный снимок -> новый суффикс ('' — дубль, префикс или заморозка).\"\"\"\n        if self.overflow or not text:\n            return \"\"\n        idx = (\n            step_index\n            if isinstance(step_index, int)\n            and not isinstance(step_index, bool)\n            and step_index >= 0\n            else None\n        )\n        key = (self.turn_id, cid, idx) if idx is not None else None\n        step = self.by_key.get(key) if key is not None else None\n        if step is None:\n            step = self._match(source, idx, text)\n            if step is None:\n                if self.step_count >= MAX_CONTENT_STEPS:\n                    self._set_overflow(\"steps\")\n                    return \"\"\n                step = _ArbStep(source)\n                self.step_count += 1\n            if key is not None:\n                if len(self.by_key) >= 4 * MAX_CONTENT_STEPS:\n                    self._set_overflow(\"aliases\")\n                    return \"\"\n                self.by_key[key] = step\n        return self._advance(step, source, text)\n\n    def reconcile_result(self, text: str) -> str:\n        \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n        self.last_result_diverged = False\n        if self.overflow or not text:\n            return \"\"\n        emitted = \"\".join(self.chunks)\n        if not emitted:\n            if self.step_count >= MAX_CONTENT_STEPS:\n                self._set_overflow(\"steps\")\n                return \"\"\n            self.step_count += 1\n            return self._advance(_ArbStep(\"result\"), \"result\", text)\n        if text == emitted or emitted.startswith(text):\n            return \"\"\n        if text.startswith(emitted):\n            if self.step_count >= MAX_CONTENT_STEPS:\n                self._set_overflow(\"steps\")\n                return \"\"\n            self.step_count += 1\n            return self._advance(_ArbStep(\"result\"), \"result\", text[len(emitted) :])\n        if text in self.eq_index:\n            self.probes += 1\n            return \"\"\n        pos = bisect.bisect_left(self.sorted_texts, text)\n        if pos < len(self.sorted_texts) and self.sorted_texts[pos].startswith(text):\n            self.probes += 1\n            return \"\"\n        last = self.last_step\n        if last is not None and last.emitted and text.startswith(last.emitted):\n            return self._advance(last, \"result\", text)\n        self._retain_divergent(text)\n        self.divergences += 1\n        self.last_result_diverged = True\n        _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n        return \"\"\n\n\ndef _safe_tool_name(raw: object) -> str:\n    \"\"\"Имя инструмента для маркера: только закрытый список, всё остальное -> `tool`.\"\"\"\n    if not isinstance(raw, str):\n        return \"tool\"\n    name = raw.strip()\n        with self._usage_lock:\n            self._usage_snapshot = snap\n\n    def usage_snapshot(self) -> _UsageSnapshot:\n        with self._usage_lock:\n            return self._usage_snapshot\n\n    def _emit_record(self, raw: bytes) -> None:\n        line = raw.strip()\n        if not line:\n            return\n        if (\n            b\"PLANNER_RESPONSE\" not in line\n            and b\"END_TURN\" not in line\n            and b\"TURN_COMPLETE\" not in line\n        ):\n            return  # быстрый отсев служебных записей без разбора JSON\n        try:\n            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n        except ValueError:\n            return\n        if not isinstance(parsed, dict):\n            return\n        rec = cast(\"dict[str, object]\", parsed)\n        rtype = str(rec.get(\"type\") or \"\")\n        idx = _as_int(rec.get(\"step_index\"))\n        if idx is not None and idx < self.base_idx:\n            return  # история прошлых ходов\n        if self._in_rewrite:\n            self._note_activity()\n        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n            self.end_marker = True\n            return\n        if rtype != \"PLANNER_RESPONSE\":\n            return\n        if self.usage_enabled:\n            self._record_usage(rec)\n        content = rec.get(\"content\")\n        emit_content = self.emit_content\n        has_tools = bool(rec.get(\"tool_calls\"))\n        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n        if emit_content is not None and isinstance(content, str) and content.strip():\n            if has_tools and isolate_tools:\n                preambles = getattr(self, \"_preambles_emitted\", None)\n                if preambles is None:\n                    preambles = self._preambles_emitted = set()\n                key_idx = idx if idx is not None else -1\n                if key_idx not in preambles:\n                    preambles.add(key_idx)\n                    _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n            else:\n                _ = emit_content(\n                    idx, content\n                )  # live planner-текст, независимо от tool_calls\n        if idx is None:\n            return\n        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n            self.final_planner = True\n        thinking = rec.get(\"thinking\")\n        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n\n    # ---- состояние шагов -----------------------------------------------------------\n    def _state(self, idx: int) -> _StepState:\n        state = self.seen.get(idx)\n        if state is not None:\n            return state\n        if len(self.seen) >= MAX_STEPS_TRACKED:\n            evictable = [\n                k\n                for k, s in self.seen.items()\n                if s.finalized and k < self.poll_watermark\n            ]\n            if evictable:\n                del self.seen[min(evictable)]\n            else:\n                self._sqlite_off(\"seen_cap\")\n                del self.seen[min(self.seen)]\n        state = _StepState()\n        self.seen[idx] = state\n        return state\n\n    def _step_done(self, state: _StepState) -> bool:\n        return state.sql_done or (\n            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n        )\n\n    def _advance_watermark(self) -> None:\n        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n        mark = self.poll_watermark\n        for key in sorted(self.seen):\n            if key < mark:\n                continue\n            if not self._step_done(self.seen[key]):\n                break\n            mark = key + 1\n        self.poll_watermark = mark\n\n    def _emit_delta(self, idx: int, state: _StepState, delta: str, source: str) -> bool:\n        def delivered() -> None:\n            state.delivered_len += len(delta)\n            state.delivered_sha.update(delta.encode(\"utf-8\"))\n\n        ok = self.emit(idx, delta, delivered)\n        if not ok:\n            self.dead = True\n            return False\n        log_cap = False\n        with self._emit_lock:\n            if self.drain_closed:\n                outcome = \"late\"\n            elif self._reasoning_bytes + size > MAX_REASONING_BYTES_PER_TURN:\n                outcome = \"cap\"\n                log_cap = not self._cap_logged\n                self._cap_logged = True\n            else:\n                self._reasoning_bytes += size\n                self.q.put((\"reasoning\", delta))\n                if on_delivered is not None:\n                    on_delivered()\n                return True\n            total = self._reasoning_bytes\n        cid8 = self._tail.cid[:8] or \"-\"\n        if outcome == \"late\":\n            _log(f\"reasoning-late-drop cid={cid8} step={idx} len={len(delta)}\")\n        elif log_cap:\n            _log(f\"reasoning-cap cid={cid8} bytes={total}\")\n        return False\n\n    def _close_and_put_done(self, kind: str, payload: object) -> None:\n        \"\"\"Атомарно закрыть выдачу мышления и поставить терминальное событие (один раз).\"\"\"\n        with self._emit_lock:\n            if self._done_put:\n                return\n            self._done_put = True\n            self.drain_closed = True\n            self.q.put((kind, payload))\n\n    def note_producer_activity(self, source: str) -> None:\n        \"\"\"Новый прогресс producer'а (stdout/transcript): продлевает idle, не зависит от CPU.\"\"\"\n        now = time.monotonic()\n        with self._activity_lock:\n            self.last_producer_activity_ts = now\n            if source == \"transcript\":\n                self.transcript_activity_ts = now\n\n    def _on_tail_activity(self) -> None:\n        self.note_producer_activity(\"transcript\")\n\n    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n        \"\"\"Кандидат planner-текста в арбитр; новый суффикс уходит в очередь под _emit_lock.\n\n        Сокетного ввода-вывода здесь нет: потребитель (`_execute`) пишет в сокет сам.\n        False — выдача уже закрыта terminal barrier'ом.\n        \"\"\"\n        with self._emit_lock:\n            if self.drain_closed:\n                return False\n            suffix = self._arbiter.offer(\n                source, step_index, text, self._tail.cid or self.run_cid\n            )\n            if suffix:\n                sep = \"\"\n                last_idx = getattr(self, \"_last_step_index\", None)\n                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n                if last_idx is not None and last_idx != step_index and emitted_wire:\n                    if not emitted_wire.endswith(\"\\n\"):\n                        sep = (\n                            \"\\n\\n\"\n                            if not suffix.startswith(\"\\n\")\n                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n                        )\n                    elif not emitted_wire.endswith(\"\\n\\n\"):\n                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n                self._last_step_index = step_index\n                self._content_emitted_wire = emitted_wire + sep + suffix\n                self.q.put((\"text\", sep + suffix))\n        return True\n\n    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n        return self.offer_content(\"transcript\", step_index, text)\n\n    def reconcile_result(self, text: str) -> str:\n        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром и выданного в wire.\"\"\"\n        with self._emit_lock:\n            emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n            if emitted_wire and text:\n                if text == emitted_wire or emitted_wire.startswith(text):\n                    self._arbiter.last_result_diverged = False\n                    return \"\"\n                if text.startswith(emitted_wire):\n                    self._arbiter.last_result_diverged = False\n                    return text[len(emitted_wire) :]\n                clean_text = text.replace(\"\\r\\n\", \"\\n\").strip()\n                clean_wire = emitted_wire.replace(\"\\r\\n\", \"\\n\").strip()\n                if clean_text == clean_wire or clean_wire.startswith(clean_text):\n                    self._arbiter.last_result_diverged = False\n                    return \"\"\n            return self._arbiter.reconcile_result(text)\n\n    def retained_divergent_text(self) -> str:\n        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n        with self._emit_lock:\n            return self._arbiter.retained_divergent_text()\n\n    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n        заморозка выдачи и остаток очереди ДО terminal marker'а.\n\n        Процесс при этом ещё жив: окно дренирования хвоста открывает `_proc_done`.\n        Возвращает необработанные потребителем события (\"text\"/\"reasoning\"/\"tool_trace\").\n        \"\"\"\n        started = time.monotonic()\n        join_budget = budget_s\n        if getattr(self, \"usage_enabled\", False):\n            # Один монотонный дедлайн попытки от EOF/первого drain: content-drain и\n            # usage-drain делят его, второго окна нет.\n            t0 = getattr(self, \"_drain_t0\", None)\n            t0 = started if t0 is None else t0\n            self._drain_t0 = t0\n            limit = t0 + min(budget_s, DRAIN_MAX_S)\n            if not getattr(self._tail, \"drain_deadline\", 0.0):\n                self._tail.drain_deadline = min(limit, t0 + DRAIN_WINDOW_S)\n            join_budget = max(0.0, limit - started)\n        else:\n            self._tail.drain_deadline = started + min(budget_s, DRAIN_WINDOW_S)\n        self._proc_done.set()\n        thread = self._tail.thread\n        if thread is not threading.current_thread():\n            thread.join(timeout=max(0.0, join_budget - (time.monotonic() - started)))\n        with self._emit_lock:\n            self.drain_closed = True\n            self._done_put = True\n        events: list[tuple[str, object]] = []\n        while True:\n            try:\n                kind, payload = self.q.get_nowait()\n            except queue.Empty:\n                break\n            if kind in (\"text\", \"reasoning\", \"tool_trace\"):\n                events.append((kind, payload))\n        return events\n\n    def usage_snapshot(self) -> _UsageSnapshot:\n        \"\"\"Снимок счётчиков хода; пока поток tail жив, полнота суммы не гарантируется.\"\"\"\n        getter = getattr(self._tail, \"usage_snapshot\", None)\n        snap = getter() if callable(getter) else _EMPTY_USAGE_SNAPSHOT\n        thread = getattr(self._tail, \"thread\", None)\n        if (\n            snap.completeness\n            and thread is not None\n            and thread is not threading.current_thread()\n            and thread.is_alive()\n        ):\n            return replace(snap, completeness=False)\n        return snap\n\n    def _feed_stdin(self) -> None:\n        \"\"\"Отдать промпт на stdin и закрыть поток: agy читает stdin до EOF.\"\"\"\n        try:\n            self.proc.stdin.write(self.stdin_line.encode(\"utf-8\"))\n            self.proc.stdin.flush()\n        except (BrokenPipeError, OSError, ValueError):\n            pass\n        finally:\n            try:\n                self.proc.stdin.close()\n            except (BrokenPipeError, OSError, ValueError):\n                pass\n            self.proc.stdin = None\n\n    def _drain_stderr(self) -> None:\n        \"\"\"Читать stderr построчно, держать только хвост: он идёт в error-ответ.\"\"\"\n        head: list = []\n        try:\n            for raw in iter(self.proc.stderr.readline, b\"\"):\n                line = raw.decode(\"utf-8\", \"replace\").rstrip()\n                if not line or _NOISE.search(line):\n                    continue\n                head.append(line)\n                if len(head) > 40:\n                    del head[0]\n        except Exception:  # noqa: BLE001 — вторичный поток, ошибку терять нельзя молча\n            pass\n        self.err_box.append(\"\\n\".join(head).strip())\n\n    def _pump(self) -> None:\n        \"\"\"Разбор NDJSON agy 1.3.1.\n\n        `step_update.agent_response` несёт накопительный `text_delta` — наружу\n        уходит только хвост. `step_update.tool` — трассировка нативного\n        инструмента (в stderr моста). `result` — финальный текст, usage, ошибка.\n\n        После EOF: ждём выход процесса не дольше PROC_EXIT_WAIT_S, затем даём\n        источнику мышления дренировать окно DRAIN_WINDOW_S (join с бюджетом) и\n        только потом ставим (\"done\", …). Терминальное событие кладётся ровно один\n        раз в `finally`, поэтому очередь закрывается при любом исходе.\n        \"\"\"\n        final_text = \"\"\n        result_ev = {}\n        tool_ordinal = 0\n        tool_ordinal_by_id: dict[str, int] = {}\n        term_kind = \"pump_error\"\n        term_payload: object = \"pump terminated\"\n        try:\n            for raw in iter(self.proc.stdout.readline, b\"\"):\n                line = raw.decode(\"utf-8\", \"replace\").strip()\n                if not line.startswith(\"{\"):\n                    continue\n                try:\n                    ev = json.loads(line)\n                except ValueError:\n                    continue\n                self.got_event = True\n                self.note_producer_activity(\"stdout\")\n                etype = ev.get(\"event\")\n                if etype == \"init\":\n                    init = ev.get(\"init\") if isinstance(ev.get(\"init\"), dict) else {}\n                    tools_raw = cast(object, init.get(\"tools\"))\n                    tools = (\n                        cast(\"list[object]\", tools_raw)\n                        if isinstance(tools_raw, list)\n                        else []\n                    )\n                    self.q.put(\n                        (\n                            \"init\",\n                            {\n                                \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n                                \"tools\": len(tools),\n                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n                            },\n                        )\n                    )\n                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n                elif etype == \"step_update\":\n                    step = (\n                        ev.get(\"step_update\")\n42:Мышление шагов (`reasoning_content`) идёт клиенту в реальном времени: пока шаг ещё\n57:    инструментов в `reasoning_content` (без args/result/путей);\n4608:        def delivered() -> None:\n5246:            emit_content=self._offer_transcript if self.content_streaming else None,\n5312:    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n5342:    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n5343:        return self.offer_content(\"transcript\", step_index, text)\n5507:                            _ = self.offer_content(\n6091:        def deliver(events: list) -> None:\n7363:                message[\"reasoning_content\"] = reasoning\n7513:            # reasoning_content|reasoning|reasoning_text — отдаём только первое.\n7516:            ok = commit() and emit(chunk({\"reasoning_content\": value}))\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n     3\t\n     4\tПозволяет автоматически проверять доступность и работоспособность моделей из\n     5\tканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n     6\t\n     7\tИспользование:\n     8\t    python3 scripts/smoke_models.py --dry-run\n     9\t    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n    10\t    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport os\n    18\tfrom pathlib import Path\n    19\timport re\n    20\timport sys\n    21\timport time\n    22\timport urllib.error\n    23\timport urllib.request\n    24\tfrom typing import Any, NamedTuple\n    25\t\n    26\t\n    27\tDEFAULT_MODELS_MD = Path(\n    28\t    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n    29\t).expanduser()\n    30\tDEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n    31\t\n    32\t\n    33\tclass ModelEntry(NamedTuple):\n    34\t    role: str\n    35\t    model_id: str\n    36\t    effort: str\n    37\t    family: str\n    38\t\n    39\t\n    40\tdef parse_models_md(path: Path) -> list[ModelEntry]:\n    41\t    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    42\t    if not path.is_file():\n    43\t        raise FileNotFoundError(f\"Канонический файл models.md не найден: {path}\")\n    44\t\n    45\t    content = path.read_text(encoding=\"utf-8\")\n    46\t    entries: list[ModelEntry] = []\n    47\t    current_role = \"General\"\n    48\t\n    49\t    # Регулярное выражение для строк вида:\n    50\t    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    51\t    row_pattern = re.compile(\n    52\t        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    53\t    )\n    54\t\n    55\t    for line in content.splitlines():\n    56\t        line = line.strip()\n    57\t        if line.startswith(\"### \"):\n    58\t            header = line[4:].strip()\n    59\t            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n    60\t            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n    61\t            continue\n    62\t\n    63\t        match = row_pattern.match(line)\n    64\t        if match:\n    65\t            model_id = match.group(1).strip()\n    66\t            effort = match.group(2).strip()\n    67\t            family = match.group(3).strip()\n    68\t            # Пропускаем заголовки таблиц\n    69\t            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n    70\t                continue\n    71\t            entries.append(ModelEntry(current_role, model_id, effort, family))\n    72\t\n    73\t    # Дедупликация по паре (role, model_id)\n    74\t    seen = set()\n    75\t    unique_entries = []\n    76\t    for e in entries:\n    77\t        key = (e.role, e.model_id)\n    78\t        if key not in seen:\n    79\t            seen.add(key)\n    80\t            unique_entries.append(e)\n    81\t\n    82\t    return unique_entries\n    83\t\n    84\t\n    85\tdef mask_secret(text: str) -> str:\n    86\t    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n    87\t    return re.sub(\n    88\t        r\"(Bearer\\s+|api[_-]?key[:=]\\s*)[a-zA-Z0-9_\\-\\.]{8,}\",\n    89\t        r\"\\1[MASKED]\",\n    90\t        text,\n    91\t        flags=re.IGNORECASE,\n    92\t    )\n    93\t\n    94\t\n    95\tdef smoke_test_model(\n    96\t    hub_url: str,\n    97\t    model_id: str,\n    98\t    timeout_s: float = 20.0,\n    99\t    api_key: str | None = None,\n   100\t) -> tuple[bool, str, float]:\n   101\t    \"\"\"Выполнить смоук-запрос к модели через OpenAI-совместимый SSE-стрим с замером TTFT.\"\"\"\n   102\t    key = api_key or os.environ.get(\"BRIDGE_KEY\") or os.environ.get(\"HUB_API_KEY\")\n   103\t    if not key:\n   104\t        dsh_env = Path.home() / \".dsh\" / \".env\"\n   105\t        if dsh_env.is_file():\n   106\t            try:\n   107\t                for line in dsh_env.read_text(encoding=\"utf-8\").splitlines():\n   108\t                    if line.startswith(\"BRIDGE_KEY=\"):\n   109\t                        key = line.split(\"=\", 1)[1].strip()\n   110\t                        break\n   111\t            except OSError:\n   112\t                pass\n   113\t    if not key:\n   114\t        key = os.environ.get(\"OPENAI_API_KEY\") or \"test-smoke-key\"\n   115\t\n   116\t    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n   117\t    payload = {\n   118\t        \"model\": model_id,\n   119\t        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n   120\t        \"max_tokens\": 15,\n   121\t        \"stream\": True,\n   122\t    }\n   123\t    data_bytes = json.dumps(payload).encode(\"utf-8\")\n   124\t    req = urllib.request.Request(\n   125\t        endpoint,\n   126\t        data=data_bytes,\n   127\t        method=\"POST\",\n   128\t    )\n   129\t    req.add_header(\"Content-Type\", \"application/json\")\n   130\t    req.add_header(\"Authorization\", f\"Bearer {key}\")\n   131\t\n   132\t    t0 = time.monotonic()\n   133\t    ttft: float | None = None\n   134\t    got_done = False\n   135\t    try:\n   136\t        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n   137\t            status_code = resp.getcode()\n   138\t            if status_code != 200:\n   139\t                return False, f\"HTTP {status_code}\", time.monotonic() - t0\n   140\t            for raw_line in resp:\n   141\t                line = raw_line.decode(\"utf-8\", \"replace\").strip()\n   142\t                if not line or not line.startswith(\"data:\"):\n   143\t                    continue\n   144\t                data_str = line[5:].strip()\n   145\t                if data_str == \"[DONE]\":\n   146\t                    got_done = True\n   147\t                    break\n   148\t                try:\n   149\t                    chunk = json.loads(data_str)\n   150\t                    choices = chunk.get(\"choices\") or []\n   151\t                    if choices:\n   152\t                        delta = choices[0].get(\"delta\") or {}\n   153\t                        if (\n   154\t                            delta.get(\"content\")\n   155\t                            or delta.get(\"reasoning_content\")\n   156\t                            or delta.get(\"thinking\")\n   157\t                        ):\n   158\t                            if ttft is None:\n   159\t                                ttft = time.monotonic() - t0\n   160\t                except ValueError:\n   161\t                    pass\n   162\t            elapsed = time.monotonic() - t0\n   163\t            display_time = ttft if ttft is not None else elapsed\n   164\t            if ttft is not None:\n   165\t                return True, \"STREAM_OK\", display_time\n   166\t            if got_done:\n   167\t                return True, \"DONE_OK\", elapsed\n   168\t            return False, \"No stream chunks\", elapsed\n   169\t    except urllib.error.HTTPError as e:\n   170\t        elapsed = time.monotonic() - t0\n   171\t        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n   172\t        return False, err_msg, elapsed\n   173\t    except Exception as e:\n   174\t        elapsed = time.monotonic() - t0\n   175\t        return False, mask_secret(f\"Error: {e}\"), elapsed\n   176\t\n   177\t\n   178\tdef main() -> int:\n   179\t    parser = argparse.ArgumentParser(\n   180\t        description=\"Smoke test runner for models defined in models.md\"\n   181\t    )\n   182\t    parser.add_argument(\n   183\t        \"--models-md\",\n   184\t        type=Path,\n   185\t        default=DEFAULT_MODELS_MD,\n   186\t        help=\"Path to Context/models.md\",\n   187\t    )\n   188\t    parser.add_argument(\n   189\t        \"--hub-url\",\n   190\t        type=str,\n   191\t        default=DEFAULT_HUB_URL,\n   192\t        help=\"URL of the bridge hub endpoint\",\n   193\t    )\n   194\t    parser.add_argument(\n   195\t        \"--model\",\n   196\t        type=str,\n   197\t        default=\"\",\n   198\t        help=\"Filter by specific model ID\",\n   199\t    )\n   200\t    parser.add_argument(\n   201\t        \"--dry-run\",\n   202\t        action=\"store_true\",\n   203\t        help=\"Validate configuration and parse models without sending network requests\",\n   204\t    )\n   205\t    parser.add_argument(\n   206\t        \"--live\",\n   207\t        action=\"store_true\",\n   208\t        help=\"Execute live HTTP smoke requests against the hub\",\n   209\t    )\n   210\t    parser.add_argument(\n   211\t        \"--timeout\",\n   212\t        type=float,\n   213\t        default=15.0,\n   214\t        help=\"Request timeout in seconds\",\n   215\t    )\n   216\t\n   217\t    args = parser.parse_args()\n   218\t\n   219\t    models = parse_models_md(args.models_md)\n   220\t    if args.model:\n   221\t        models = [m for m in models if m.model_id == args.model]\n   222\t\n   223\t    if not models:\n   224\t        print(\"FAIL: No models found matching criteria.\")\n   225\t        return 1\n   226\t\n   227\t    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n   228\t    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n   229\t    print(\"-\" * 88)\n   230\t\n   231\t    all_ok = True\n   232\t    for entry in models:\n   233\t        if args.dry_run or not args.live:\n   234\t            status = \"CONFIGURED\"\n   235\t            latency_str = \"-\"\n   236\t        else:\n   237\t            ok, status, lat = smoke_test_model(\n   238\t                args.hub_url, entry.model_id, timeout_s=args.timeout\n   239\t            )\n   240\t            latency_str = f\"{lat:.2f}s\"\n   241\t            if not ok:\n   242\t                all_ok = False\n   243\t\n   244\t        print(\n   245\t            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n   246\t        )\n   247\t\n   248\t    if args.dry_run:\n   249\t        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n   250\t        return 0\n   251\t\n   252\t    if not args.live:\n   253\t        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n   254\t        return 0\n   255\t\n   256\t    return 0 if all_ok else 1\n   257\t\n   258\t\n   259\tif __name__ == \"__main__\":\n   260\t    sys.exit(main())\n{\n  \"schema_version\": \"1.0\",\n  \"run_id\": \"dsh-stream-reasoning-formatting-20261102\",\n  \"verification_surface\": [\n    {\n      \"id\": \"VER-001\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-004\",\n        \"AD-001\",\n        \"QA-001\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_step_boundary_newline_separation -v\",\n      \"expected\": \"exit 0; successive steps separated by newlines\",\n      \"environment\": \"local\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-002\",\n      \"requirement_ids\": [\n        \"REQ-002\",\n        \"REQ-004\",\n        \"AD-002\",\n        \"QA-002\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_arbiter_no_prefix_repetition_on_divergence -v\",\n      \"expected\": \"exit 0; arbiter does not duplicate prefixes on divergence\",\n      \"environment\": \"local\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-003\",\n      \"requirement_ids\": [\n        \"REQ-003\",\n        \"REQ-004\",\n        \"AD-003\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"pytest tests/test_agy_bridge_resilience.py -k test_tool_preamble_isolated_to_reasoning -v\",\n      \"expected\": \"exit 0; intermediate steps with tool_calls routed to reasoning_content\",\n      \"environment\": \"local\",\n      \"owner\": \"verifier\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"В L3 нашёл путь, где раннер возвращает `STREAM_OK` после получения текста, даже если поток закончился без `[DONE]`. Также проверяю stdout-путь: изоляция преамбул добавлена в чтение транскрипта, но текст может поступить из CLI раньше.\n"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5490,5555p' bridges/agy-bridge/server.py; sed -n '6085,6130p' bridges/agy-bridge/server.py; sed -n '6235,6315p' bridges/agy-bridge/server.py; rg -n '\"'^def _pump_queue|''^def _bare_run|''^def _stdout_text|''^def _stdout_tool|''^class _Pump|''^def _spawn'\"' tests/test_agy_bridge_resilience.py; sed -n '1,150p' tests/test_agy_bridge_resilience.py; cat .ai-team/runs/dsh-stream-reasoning-formatting-20261102/package.md; cat .ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/arch-spec.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5490,5555p' bridges/agy-bridge/server.py; sed -n '6085,6130p' bridges/agy-bridge/server.py; sed -n '6235,6315p' bridges/agy-bridge/server.py; rg -n '\"'^def _pump_queue|''^def _bare_run|''^def _stdout_text|''^def _stdout_tool|''^class _Pump|''^def _spawn'\"' tests/test_agy_bridge_resilience.py; sed -n '1,150p' tests/test_agy_bridge_resilience.py; cat .ai-team/runs/dsh-stream-reasoning-formatting-20261102/package.md; cat .ai-team/runs/dsh-stream-reasoning-formatting-20261102/architecture/arch-spec.md\"","aggregated_output":"                            {\n                                \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n                                \"tools\": len(tools),\n                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n                            },\n                        )\n                    )\n                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n                elif etype == \"step_update\":\n                    step = (\n                        ev.get(\"step_update\")\n                        if isinstance(ev.get(\"step_update\"), dict)\n                        else {}\n                    )\n                    kind = step.get(\"step_type\")\n                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n                        if self.content_streaming:\n                            _ = self.offer_content(\n                                \"stdout\",\n                                _as_int(step.get(\"step_index\")),\n                                str(step[\"text_delta\"]),\n                            )\n                        else:\n                            suffix = _reasoning_suffix(\n                                self._text_seen,\n                                str(step.get(\"step_index\", \"\")),\n                                str(step[\"text_delta\"]),\n                            )\n                            if suffix:\n                                self.q.put((\"text\", suffix))\n                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n                        step_idx = _as_int(step.get(\"step_index\"))\n                        trace: dict[str, object] = {\n                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n                            \"duration_s\": step.get(\"duration_seconds\"),\n                            \"step_index\": step_idx,\n                        }\n                        if step_idx is None:\n                            # Идентичность DONE без step_index: монотонный ordinal хода,\n                            # назначается один раз и переживает повторную доставку события.\n                            raw_id = (\n                                step.get(\"call_id\")\n                                or step.get(\"tool_call_id\")\n                                or step.get(\"id\")\n                            )\n                            call_id = (\n                                str(raw_id).strip()\n                                if isinstance(raw_id, (str, int))\n                                else \"\"\n                            )\n                            if call_id:\n                                # Повтор события с тем же call_id получает тот же ordinal.\n                                ord_val = tool_ordinal_by_id.get(call_id)\n                                if ord_val is None:\n                                    tool_ordinal += 1\n                                    ord_val = tool_ordinal\n                                    tool_ordinal_by_id[call_id] = ord_val\n                                trace[\"fallback_ordinal\"] = ord_val\n                                trace[\"call_id\"] = call_id\n                            else:\n                                tool_ordinal += 1\n                                trace[\"fallback_ordinal\"] = tool_ordinal\n                        self.q.put((\"tool_trace\", trace))\n                elif etype == \"result\":\n                    result = (\n                        ev.get(\"result\") if isinstance(ev.get(\"result\"), dict) else {}\n                f\"reasoning-emit cid={conversation_id[:8] or '-'} \"\n                f\"n={len(reasoning_pieces)} len={len(text)} ok={int(bool(ok))}\"\n            )\n            if not ok:\n                gone[0] = True\n\n        def deliver(events: list) -> None:\n            nonlocal tool_events\n            for kind, payload in events:\n                if gone[0]:\n                    break\n                if kind == \"text\":\n                    add_content(str(payload))\n                elif kind == \"reasoning\":\n                    add_reasoning(str(payload))\n                elif kind == \"tool_trace\":\n                    tool_events += 1\n                    if not on_tool_trace(payload):\n                        gone[0] = True\n\n        def finish(\n            name: str, rc: int, err: str = \"\", limit: float | None = None\n        ) -> dict:\n            \"\"\"Терминальное состояние с bounded drain (<= T_DRAIN_MAX_S) остатка источников.\n\n            timeout/idle_timeout при graceful: остаток откладывается в `retained_events`\n            (доставка и notice — в окне финальной записи). Иначе остаток уходит сразу.\n            \"\"\"\n            retained: list = []\n            drain = getattr(run, \"terminal_drain\", None)\n            graceful = name in (\n                \"timeout\",\n                \"idle_timeout\",\n            ) and _new_flag(\"graceful_timeout_on_partial\")\n            if drain is not None and (\n                graceful\n                or (\n                    content_streaming\n                    and name in (\"timeout\", \"idle_timeout\", \"agy_error\", \"pump_error\")\n                )\n            ):\n                retained = list(drain(T_DRAIN_MAX_S))\n                if not graceful:\n                    deliver(retained)\n                    retained = []\n            out = state(name, rc, err)\n                conversation_id = str(payload.get(\"conversation_id\") or \"\")\n                _log(\n                    f\"init conversation={conversation_id[:8] or '-'} \"\n                    f\"tools={payload.get('tools')} \"\n                    f\"permission_mode={payload.get('permission_mode')}\"\n                )\n            elif kind == \"reasoning\":\n                add_reasoning(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"text\":\n                add_content(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"tool_trace\":\n                tool_events += 1\n                if not on_tool_trace(payload):\n                    gone[0] = True\n                    return state(\"client_gone\", 1)\n            elif kind == \"result\":\n                result_ev = payload\n                usage = payload.get(\"usage\") or {}\n                conversation_id = str(payload.get(\"conversation_id\") or conversation_id)\n                if str(payload.get(\"status\") or \"\").upper() == \"ERROR\":\n                    # Не выходим по result ERROR: мышление последнего шага ещё в очереди\n                    # перед done, и оно обязано попасть в out до решения о повторе.\n                    message = str(payload.get(\"error\") or \"agy reported an error\")\n                    result_error = message[:500]\n                    result_error_at = time.monotonic()\n            elif kind == \"pump_error\":\n                return finish(\"pump_error\", 1, str(payload))\n            elif kind == \"done\":\n                rc, final_text, raw_result = payload\n                if result_error:\n                    return state(\"agy_error\", 1, result_error)\n                if not result_ev and raw_result:\n                    result_ev = raw_result\n                if content_streaming or usage_enabled:\n                    # Хвост транскрипта, записанный прямо перед done, дренируется\n                    # ДО reconcile: result.response — агрегат, досылается лишь недостающее.\n                    # При usage_enabled тот же drain — барьер счётчиков шагов (единый\n                    # дедлайн попытки <= T_DRAIN_MAX_S, второго окна нет).\n                    drain = getattr(run, \"terminal_drain\", None)\n                    if callable(drain):\n                        deliver(list(drain(T_DRAIN_MAX_S)))\n                if content_streaming:\n                    delta = run.reconcile_result(final_text)\n                    if delta:\n                        add_content(delta)\n                    elif final_text and getattr(run._arbiter, \"last_result_diverged\", False):\n                        full_emitted = \"\".join(pieces)\n                        sep = (\n                            \"\\n\\n\"\n                            if full_emitted and not full_emitted.endswith(\"\\n\")\n                            else (\n                                \"\\n\"\n                                if full_emitted and not full_emitted.endswith(\"\\n\\n\")\n                                else \"\"\n                            )\n                        )\n                        _log(\n                            f\"content-reconcile-fallback \"\n                            f\"turn={getattr(run, 'turn_id', '')[:8] or '-'} \"\n                            f\"len={len(final_text)}\"\n                        )\n                        add_content(sep + final_text if full_emitted else final_text)\n                elif not pieces and final_text:\n                    add_content(final_text)\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n                time.sleep(0.05)\n                err = \"\".join(run.err_box).strip()\n                status = str(result_ev.get(\"status\") or \"\").upper()\n                if rc != 0 and (status == \"ERROR\" or not pieces):\n                    return state(\n                        \"agy_error\",\n                        rc,\n                        (str(result_ev.get(\"error\") or \"\") or err)[:500],\n                    )\n                return state(\"done\", rc, err)\n\n138:def _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n2192:def _bare_run() -> object:\n4075:def _pump_queue(\n4120:def _stdout_text(idx: object, text: str) -> dict[str, object]:\n4131:def _stdout_tool(idx: object, name: object = \"run_command\") -> dict[str, object]:\n\"\"\"Тесты отказоустойчивости agy-bridge (ADR-0007, arch-spec r2 §6, RW-008).\n\nПокрыто 15 сценариев: детекция неактивности группы, сброс таймера по CPU и по\nпротокольным событиям, fail-closed при деградации `ps`, троттлинг `check()` в\n`_execute`, `child_exited` как штатное завершение, `absolute_cap` -> `timeout`,\nkill-switch, контракт ошибки `idle_timeout` (HTTP 504 / SSE), зачистка группы\nпроцессов и reap лидера, изоляция таймаута источника в `fetch_via_playwright.py`.\n\nМост `bridges/agy-bridge/server.py` лежит в каталоге с дефисом, поэтому грузится\nчерез `importlib`. Таймауты малые (`idle_timeout_s=0.2`) либо мок-часы; процессы\nсоздаются с `start_new_session=True` и убираются в `finally`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport base64\nimport contextlib\nimport dataclasses\nimport gc\nimport hashlib\nimport http.client\nimport importlib.util\nimport io\nimport json\nimport os\nimport queue\nimport re\nimport resource\nimport shutil\nimport signal\nimport socket\nimport sqlite3\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport tracemalloc\nimport unittest\nfrom pathlib import Path\nfrom types import ModuleType\nfrom types import SimpleNamespace\nfrom typing import Any\nfrom typing import Callable, cast\nfrom unittest import mock\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\nfrom core.watchdog import (  # noqa: E402\n    AdaptiveTimeoutController,\n    ProcessWatchdog,\n    WatchdogMetrics,\n)\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n_FETCH_SCRIPT = Path(\n    os.environ.get(\"AIBUNKER_FETCH_SCRIPT\")\n    or \"~/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py\"\n).expanduser()\n\n_POSIX = sys.platform != \"win32\"\n_DARWIN = sys.platform == \"darwin\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-agy-resilience\")\n    os.environ.pop(\"AGY_BRIDGE_FLEET\", None)\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass _FakeClock:\n    \"\"\"Ручные часы: время движется только через advance().\"\"\"\n\n    def __init__(self, now: float = 1000.0) -> None:\n        self.now = now\n\n    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass _TickQueue:\n    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n\n    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n        self.clock = clock\n        self.empty_ticks = empty_ticks\n        self.events = list(events)\n\n    def get(self, timeout: float = 0.0) -> Any:\n        if self.empty_ticks > 0:\n            self.empty_ticks -= 1\n            self.clock.advance(float(timeout))\n            raise queue.Empty\n        if self.events:\n            return self.events.pop(0)\n        self.clock.advance(float(timeout))\n        raise queue.Empty\n\n\nclass _SpyController:\n    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n\n    def __init__(\n        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n    ) -> None:\n        self.inner = inner\n        self.forced = forced\n        self.check_calls = 0\n        self.activity: list[str] = []\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n        self.inner.on_activity(kind)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.check_calls += 1\n        if self.forced is not None:\n            return self.forced\n        return self.inner.check(pgid)\n\n\ndef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n\n\ndef _hard_kill(proc: subprocess.Popen) -> None:\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        pass\n    try:\n        proc.wait(timeout=5)\n    except (subprocess.TimeoutExpired, OSError):\n        pass\n# Пакет приёмки: Модернизация тестирования и исправление стриминга cli-agent-bridge (Cycle 2)\n\n## Метаданные\n- **Task ID:** `REQ-DSH-STREAM-REASONING-FORMATTING`\n- **Run ID:** `dsh-stream-reasoning-formatting-20261102`\n- **Cycle:** `2` (Rework по замечаниям Совета Тимлидов RW-009..RW-019)\n- **Пресет:** `panel-analyst-teamlead`\n- **Дата:** 2026-11-02\n- **Статус:** `VERIFIED_READY_FOR_COUNCIL_CYCLE_2`\n\n---\n\n## 1. Суть выполненных доработок\n\n1. **Устранение склеивания строк в стриминге (REQ-001 / ADR-1):**\n   - В `Run.offer_content` добавлена проверка границ шагов: при смене шага планировщика (`_last_step_index != step_index`) и наличии ранее выданного текста буфер предваряется `\\n\\n`, если он не завершался переводом строки.\n   - Исключено слияние предложений и токенов на границах действий (дефект «...данных.Проверяю вывод...»).\n\n2. **Устранение лавины префиксов гейтов в арбитре (REQ-002 / ADR-2):**\n   - В `_ContentArbiter._scan` исправлено префиксное сопоставление: кандидат сопоставляется только при точном равенстве `text == candidate` либо если входящий текст является истинным продолжением `text.startswith(candidate)`.\n   - Шаг с валидным индексом (`idx is not None`) изолирован от ошибочного алиасинга с более длинным текстом чужого старого шага.\n   - Полностью ликвидирована циклическая заморозка шагов и повторная эмиссия префиксов `[гейт оркестрации: активен...`.\n\n3. **Семантическая изоляция Reasoning при вызовах инструментов (REQ-003 / ADR-3 / RW-016):**\n   - В `_TranscriptTail._emit_record`: при наличии `tool_calls` преамбула шага направляется в `choices[0].delta.reasoning_content`.\n   - Добавлен трекер `self._preambles_emitted: set[int]`: исключена повторная эмиссия преамбул в reasoning при перечитывании файла транскрипта (`_in_rewrite`).\n   - Поле `choices[0].delta.content` остаётся чистым до получения финального ответа без вызовов инструментов.\n   - Аккордеон мышления `<Think>` в UI DeepSeek Harness остаётся активным на протяжении всех промежуточных шагов агента.\n\n4. **Синхронизация Wire и Reconcile без ложной дивергенции (RW-015 / F-002):**\n   - В `Run.reconcile_result`: сверка финального текста выполняется относительно фактически отправленного в сокет потока `_content_emitted_wire` (с учётом разделителей `\\n\\n`). Исключено ложное срабатывание дивергенции арбитра (`last_result_diverged=True`) и повторный терминальный выброс полного текста ответа клиенту.\n\n5. **Нормализация рантайм-флагов (REQ-004 / ADR-4):**\n   - В `_parse_runtime_flags` поддержан алиас `AGY_GRACEFUL_TIMEOUT_FINISH_REASON`, нормализация `max_tokens` -> `length` и сброс невалидных значений в дефолтный `stop`. Все 13 подтестов `GracefulTimeoutFinishReasonTests` зелёные.\n\n6. **Сквозной синтетический e2e сьют L2 (REQ-005 / ADR-5 / RW-017):**\n   - В `tests/test_stream_formatting_and_subagents.py` реализовано 4 сквозных теста: проверка разграничения Markdown строк `\\n\\n`, защита от зацикливания префиксов, изоляция tool-преамбул в reasoning и тест дедупликации преамбул / синхронизации reconcile с wire (`test_e2e_reconcile_wire_sync_and_preamble_dedup`). 4/4 passed (0.02s).\n\n7. **Универсальный смоук-раннер моделей L3 с TTFT и Fail-Fast (REQ-006 / ADR-6 / RW-018 / RW-019 / F-013):**\n   - В `scripts/smoke_models.py` удалён фиктивный список моделей: скрипт строго падает с `FileNotFoundError` и кодом выхода 1 при отсутствии канона `models.md`.\n   - Реализован потоковый смоук со стримингом (`stream=True`), чтением чанков SSE, замером TTFT по первому чанку `content`/`reasoning_content` и валидацией маркера завершения `[DONE]`. Проведено успешное живое тестирование на хаб-мосте `127.0.0.1:9882`.\n\n8. **Регламент тестирования в AGENTS.md (REQ-007 / ADR-7):**\n   - В `/Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md` зафиксирован трехуровневый регламент (L1 Unit / L2 Synthetic E2E / L3 Smoke Runner).\n\n---\n\n## 2. Матрица верификации (Verification Surface)\n\n| ID | Требование | Метод проверки | Ожидание | Фактический результат |\n|---|---|---|---|---|\n| **VER-001** | REQ-001, REQ-004 | `pytest tests/test_agy_bridge_resilience.py -k test_step_boundary_newline_separation` | PASS | **PASS (0.16s)** |\n| **VER-002** | REQ-002, REQ-004 | `pytest tests/test_agy_bridge_resilience.py -k test_arbiter_no_prefix_repetition_on_divergence` | PASS | **PASS (0.16s)** |\n| **VER-003** | REQ-003, REQ-004, RW-016 | `pytest tests/test_agy_bridge_resilience.py -k test_tool_preamble_isolated_to_reasoning` | PASS | **PASS (0.16s)** |\n| **VER-004** | REQ-005, RW-017 | `pytest tests/test_stream_formatting_and_subagents.py -v` | PASS | **PASS (4/4 passed, 0.02s)** |\n| **VER-005** | REQ-006, RW-018 | `python3 scripts/smoke_models.py --dry-run` | PASS | **PASS (20 моделей валидировано)** |\n| **VER-006** | RW-018 | `python3 scripts/smoke_models.py --models-md /nonexistent/models.md --dry-run` | FAIL (exit 1) | **PASS (FileNotFoundError, exit 1)** |\n| **VER-007** | RW-019, F-013 | `python3 scripts/smoke_models.py --live --model claude-sonnet-5-5` | PASS (STREAM_OK) | **PASS (STREAM_OK, TTFT 2.14s..9.67s)** |\n| **VER-008** | REQ-007 | `grep -q \"Регламент комплексного тестирования\" AGENTS.md` | PASS | **PASS (раздел зафиксирован)** |\n| **FULL-L1** | Регрессия моста | `pytest tests/test_agy_bridge_resilience.py -q` | PASS | **PASS (346 passed, 737 subtests, 0:03:38)** |\n\n---\n\n## 3. Затронутые файлы\n- `bridges/agy-bridge/server.py`\n- `tests/test_stream_formatting_and_subagents.py`\n- `scripts/smoke_models.py`\n- `AGENTS.md`\n- `analysis/bridge-testing-modernization/` (артефакты панели аналитиков)\n- `.ai-team/runs/dsh-stream-reasoning-formatting-20261102/` (архитектурный пакет, спецификация и пакет приёмки)\n# Архитектурная спецификация (arch-spec.md)\n\n## 1. Контекст и архитектурный контракт\nЗадача:\n1. Устранение дефектов форматирования, склеивания строк промежуточных статусов (`провИщу`, слитный текст) и циклического дублирования префиксов гейтов (`[гейт оркестрации: активен...`), а также семантическая изоляция рассуждений (`reasoning_content`) от сервисных преамбул в OpenAI-совместимом эндпоинте моста `bridges/agy-bridge/server.py` для DeepSeek Harness.\n2. Комплексная модернизация тестовой системы `cli-agent-bridge` (трехуровневая архитектура L1/L2/L3, покрытие сабагентов, скиллов оркестрации и смоук моделей) по результатам панели аналитиков `multi-analyst-debate`.\n\n## 2. Архитектурные решения (ADR)\n\n### ADR-1: Детерминированное разделение шагов переносом строк (`\\n\\n`)\n- **Проблема:** При стриминге текста шагов планировщика (`PLANNER_RESPONSE.content` и stdout `step_update.agent_response`) чанки разных шагов склеиваются «встык» без пробелов или переносов строк.\n- **Решение:** В методах `Run.offer_content` и `_ContentArbiter._advance`: если для текущего хода уже был выдан текст предыдущего шага, и буфер не заканчивается на `\\n` или `\\n\\n`, то текст нового шага предваряется `\\n\\n`.\n- **Инвариант:** Ни один новый шаг не начинается на той же строке, что и предыдущий.\n\n### ADR-2: Корректное сопоставление префиксов в `_ContentArbiter._scan`\n- **Проблема:** Условие `while pos < len(texts) and texts[pos].startswith(text):` ошибочно сопоставляло короткий кандидат нового шага с длинными текстами других шагов с общим префиксом (например `[`), что приводило к `content-divergence`, заморозке шага (`step.frozen = True`) и повторной циклической эмиссии префиксов с нуля.\n- **Решение:** Кандидат `texts[pos]` сопоставляется с входящим `text` только при точном совпадении `text == texts[pos]` либо если входящий текст является истинным продолжением/расширением известного шага `text.startswith(texts[pos])`. Короткий префикс нового шага никогда не захватывает более длинный текст завершённого старого шага.\n- **Инвариант:** Кандидат другого шага никогда не становится ложным алиасом чужого текста.\n\n### ADR-3: Семантическая изоляция сервисных преамбул промежуточных шагов с `tool_calls`\n- **Проблема:** Преамбула шага с вызовом инструмента (например, `[гейт оркестрации: активен] Ищу...`) при отправке в `delta.content` преждевременно закрывает блок размышлений `<Think>` в UI DeepSeek Harness. Все последующие мыслительные шаги схлопываются в верхний блок, а сервисные логи засоряют ответ.\n- **Решение:** В `_TranscriptTail._emit_record`: при наличии `tool_calls` промежуточный текст направляется в `choices[0].delta.reasoning_content` (как часть рабочего рассуждения агента). В `choices[0].delta.content` направляется только шаг без `tool_calls` (финальный ответ пользователю) и `reconcile_result`. Поведение управляется флагом `isolate_tool_preambles_to_reasoning` (по умолчанию `True`).\n- **Инвариант:** UI Harness остаётся в фазе Thinking во время выполнения инструментов, а итоговый ответ попадает в `content` чистым.\n\n### ADR-4: Исправление парсинга рантайм-флагов и fallback\n- **Проблема:** Падения тестов `GracefulTimeoutFinishReasonTests` из-за неполной поддержки alias `AGY_GRACEFUL_TIMEOUT_FINISH_REASON`, отсутствия нормализации `max_tokens` -> `length` и сохранения невалидных значений вместо сброса в `\"stop\"`.\n- **Решение:** В `_parse_runtime_flags` поддержать fallback по `_NEW_FLAG_ENV`, нормализовать строковые значения к допустимым (`stop` или `length`), при любых невалидных строках/типах возвращать `\"stop\"`.\n\n### ADR-5: Синтетический e2e сьют тестирования стриминга и сабагентов L2 (`tests/test_stream_formatting_and_subagents.py`)\n- **Проблема:** Тесты L1 тестировали изолированные методы, пропуская системные дефекты форматирования стриминга и гонки транскриптов.\n- **Решение:** Создание сьюта `tests/test_stream_formatting_and_subagents.py` с детерминированным симулятором жизненного цикла агента, проверяющим:\n  1. Разделение шагов `\\n\\n` и отсутствие склейки строк.\n  2. Защиту от повторов префиксов при смене статусов оркестрации.\n  3. Маршрутизацию преамбул `tool_calls` в `reasoning_content`.\n  4. Сценарное взаимодействие с сабагентами (эмуляция `invoke_subagent` / `launch_seat`).\n- **Инвариант:** Время прогона L2 < 5 секунд, 0 внешних сетевых зависимостей.\n\n### ADR-6: Универсальный смоук-раннер моделей L3 (`scripts/smoke_models.py`)\n- **Проблема:** Невозможность проверить доступность всех моделей из `models.md` без ручного запуска и риска поломки сессий владельца.\n- **Решение:** Разработка скрипта `scripts/smoke_models.py`, считывающего актуальный список моделей из `~/Мой диск/Context/models.md`, опрашивающего эндпоинты моста (`:9882`, `:9887`), валидирующего TTFT, reasoning и streaming с безопасным маскированием секретов.\n\n### ADR-7: Закрепление регламента комплексного тестирования в `AGENTS.md`\n- **Решение:** Обновление локального `/Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md` разделом «Регламент комплексного тестирования мостов и стриминга» с обязательными требованиями к проверке разделения шагов, семантической изоляции reasoning и запуска смоук-тестов.\n\n## 3. Highload & Resilience (HL-ENV/v1)\n- Ограничение буферов: `MAX_CONTENT_BYTES_PER_TURN = 8 MiB`, `MAX_REASONING_BYTES_PER_TURN = 2 MiB`.\n- Bounded-дренаж: `T_DRAIN_MAX_S = 3.0s`.\n- Защита от OOM и утечек дескрипторов при длительных сессиях сабагентов.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4060,4148p' tests/test_agy_bridge_resilience.py; sed -n '2180,2235p' tests/test_agy_bridge_resilience.py; command -v python3; test \"'! -x .venv/bin/python || .venv/bin/python -V; nl -ba tests/test_stream_formatting_and_subagents.py | sed -n '\"'110,290p'; sed -n '1,100p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/code-review.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4060,4148p' tests/test_agy_bridge_resilience.py; sed -n '2180,2235p' tests/test_agy_bridge_resilience.py; command -v python3; test \"'! -x .venv/bin/python || .venv/bin/python -V; nl -ba tests/test_stream_formatting_and_subagents.py | sed -n '\"'110,290p'; sed -n '1,100p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/code-review.md'\"","aggregated_output":"            fx.set_env(\"AGY_SQLITE_REASONING_ENABLED\", None)\n            self.assertEqual(_bfn(\"_sqlite_disabled_reason\")(), \"\")\n\n\n# ---- арбитр planner-контента (AD-001, VER-001) -----------------------------------------\n\n\ndef _arb(turn: str = \"turn-1\") -> object:\n    return _bfn(\"_ContentArbiter\")(turn)\n\n\ndef _offer(arb: object, source: str, idx: object, text: str, cid: str = _CID) -> str:\n    return _str(_ofn(arb, \"offer\")(source, idx, text, cid))\n\n\ndef _pump_queue(\n    lines: list[dict[str, object]], content: bool = False\n) -> tuple[object, list[tuple[str, object]]]:\n    \"\"\"Прогнать Run._pump по готовому stdout без процесса: (run, события очереди).\"\"\"\n    run = object.__new__(cast(\"type[object]\", _bval(\"Run\")))\n    payload = b\"\".join(json.dumps(line).encode(\"utf-8\") + b\"\\n\" for line in lines)\n    tail = SimpleNamespace(\n        cid=\"\",\n        bind=lambda _cid: None,\n        drain_deadline=0.0,\n        thread=SimpleNamespace(join=lambda timeout=None: None, is_alive=lambda: False),\n    )\n    attrs: dict[str, object] = {\n        \"proc\": SimpleNamespace(\n            stdout=io.BytesIO(payload), wait=lambda timeout=None: 0\n        ),\n        \"q\": queue.Queue(),\n        \"_text_seen\": {},\n        \"_tail\": tail,\n        \"_proc_done\": threading.Event(),\n        \"_stop_watch\": threading.Event(),\n        \"_emit_lock\": threading.Lock(),\n        \"drain_closed\": False,\n        \"_done_put\": False,\n        \"got_event\": False,\n        \"content_streaming\": content,\n        \"_arbiter\": _arb(\"turn-pump\"),\n        \"run_cid\": \"\",\n        \"turn_id\": \"turn-pump\",\n        \"_activity_lock\": threading.Lock(),\n        \"last_producer_activity_ts\": 0.0,\n        \"transcript_activity_ts\": None,\n        \"started\": 0.0,\n        \"err_box\": [],\n    }\n    for key, value in attrs.items():\n        setattr(run, key, value)\n    _ = _ofn(run, \"_pump\")()\n    items: list[tuple[str, object]] = []\n    q = cast(\"queue.Queue[tuple[str, object]]\", _oval(run, \"q\"))\n    while not q.empty():\n        items.append(q.get_nowait())\n    return run, items\n\n\ndef _stdout_text(idx: object, text: str) -> dict[str, object]:\n    return {\n        \"event\": \"step_update\",\n        \"step_update\": {\n            \"step_type\": \"agent_response\",\n            \"step_index\": idx,\n            \"text_delta\": text,\n        },\n    }\n\n\ndef _stdout_tool(idx: object, name: object = \"run_command\") -> dict[str, object]:\n    step: dict[str, object] = {\n        \"step_type\": \"tool\",\n        \"state\": \"DONE\",\n        \"tool_name\": name,\n        \"duration_seconds\": 1.5,\n    }\n    if idx is not _MISSING:\n        step[\"step_index\"] = idx\n    return {\"event\": \"step_update\", \"step_update\": step}\n\n\n_MISSING = object()\n\n\ndef _tail_with(\n    emit_content: Callable[[int | None, str], bool] | None = None,\n    on_activity: Callable[[], None] | None = None,\n        self.events = []\n        self.thread = threading.Thread(target=self._block, daemon=True)\n        self.thread.start()\n\n    def _block(self) -> None:\n        _ = self.release.wait(10)\n\n    def interrupt_active_query(self) -> None:\n        self.events.append(\"interrupt\")\n        self.release.set()\n\n\ndef _bare_run() -> object:\n    \"\"\"Run без процесса: только то, что нужно для _emit_reasoning/_close_and_put_done.\"\"\"\n    run = object.__new__(cast(\"type[object]\", _bval(\"Run\")))\n    setattr(run, \"_emit_lock\", threading.Lock())\n    setattr(run, \"q\", queue.Queue())\n    setattr(run, \"drain_closed\", False)\n    setattr(run, \"_done_put\", False)\n    setattr(run, \"_reasoning_bytes\", 0)\n    setattr(run, \"_cap_logged\", False)\n    setattr(run, \"_tail\", SimpleNamespace(cid=\"\"))\n    return run\n\n\ndef _queue_kinds(run: object) -> list[str]:\n    q = cast(\"queue.Queue[tuple[str, object]]\", _oval(run, \"q\"))\n    kinds: list[str] = []\n    while not q.empty():\n        kinds.append(q.get_nowait()[0])\n    return kinds\n\n\nclass BreakerAndBudgetTests(unittest.TestCase):\n    \"\"\"AD-005: circuit breaker с probe_gen, целочисленные бюджеты (AO-01, AO-02).\"\"\"\n\n    def test_ao01_breaker_fsm_atomic_probe_and_stale_probe(self) -> None:\n        clock = _FakeClock()\n        with _Fixture(), mock.patch.object(_bridge(), \"time\", _fake_time(clock)):\n            report = _bfn(\"_breaker_report\")\n            acquire = _bfn(\"_breaker_acquire\")\n            # единичная divergence и холодные ходы не открывают breaker\n            _ = report(None, 1, True)\n            self.assertEqual(_bval(\"_breaker_state\"), \"CLOSED\")\n            _ = report(None, 1, False)\n            self.assertEqual(_bval(\"_breaker_failures\"), 0)\n            for _turn in range(3):\n                _ = report(None, 0, False)\n            self.assertEqual(_bval(\"_breaker_state\"), \"CLOSED\")\n            # классификация ошибок источника\n            for message, failed in (\n                (sqlite3.OperationalError(\"unable to open database file\"), False),\n                (sqlite3.OperationalError(\"no such table: steps\"), True),\n                (sqlite3.OperationalError(\"no such column: step_payload\"), True),\n                (sqlite3.DatabaseError(\"file is not a database\"), True),\n            ):\n/Users/aazhiry1/.local/bin/python3\nPython 3.9.6\n   110\t            # Эмулируем приход короткого префикса, затем полного текста\n   111\t            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n   112\t            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n   113\t            if d1:\n   114\t                emitted_deltas.append(d1)\n   115\t            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n   116\t            if d2:\n   117\t                emitted_deltas.append(d2)\n   118\t\n   119\t        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n   120\t        self.assertEqual(arb.divergences, 0)\n   121\t\n   122\t        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n   123\t        full_text = \"\".join(emitted_deltas)\n   124\t        count = full_text.count(\"[гейт оркестрации: активен\")\n   125\t        self.assertEqual(\n   126\t            count,\n   127\t            len(statuses),\n   128\t            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n   129\t        )\n   130\t\n   131\t    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n   132\t        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n   133\t        emitted_events: list[tuple[str, str]] = []\n   134\t\n   135\t        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n   136\t            emitted_events.append((\"reasoning\", delta))\n   137\t            if on_del is not None:\n   138\t                on_del()\n   139\t            return True\n   140\t\n   141\t        def emit_content(idx: int | None, text: str) -> bool:\n   142\t            emitted_events.append((\"content\", text))\n   143\t            return True\n   144\t\n   145\t        plan = srv._TurnPlan()\n   146\t        plan.mode = \"OFF\"\n   147\t        plan.base_idx = 0\n   148\t        plan.offset = 0\n   149\t\n   150\t        tail = srv._TranscriptTail(\n   151\t            emit=emit_reasoning,\n   152\t            stop_event=threading.Event(),\n   153\t            done_event=threading.Event(),\n   154\t            resumed=False,\n   155\t            plan=plan,\n   156\t            turn_id=\"turn-subagent-1\",\n   157\t            emit_content=emit_content,\n   158\t            on_activity=None,\n   159\t            usage_enabled=False,\n   160\t            isolate_tool_preambles=True,\n   161\t        )\n   162\t\n   163\t        # Эмулируем транскрипт мультиагентного цикла:\n   164\t        # Шаг 1: Оркестратор запускает сабагента Coder\n   165\t        record_step1 = {\n   166\t            \"type\": \"PLANNER_RESPONSE\",\n   167\t            \"step_index\": 1,\n   168\t            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n   169\t            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n   170\t            \"tool_calls\": [\n   171\t                {\n   172\t                    \"name\": \"invoke_subagent\",\n   173\t                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n   174\t                }\n   175\t            ],\n   176\t        }\n   177\t        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n   178\t\n   179\t        # Шаг 2: Финальный ответ после завершения сабагента\n   180\t        record_step2 = {\n   181\t            \"type\": \"PLANNER_RESPONSE\",\n   182\t            \"step_index\": 2,\n   183\t            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   184\t            \"thinking\": \"Формирую итоговый статус для владельца.\",\n   185\t        }\n   186\t        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n   187\t\n   188\t        # Проверяем распределение:\n   189\t        # 1. Преамбула шага 1 ушла в reasoning\n   190\t        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n   191\t        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n   192\t\n   193\t        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n   194\t        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n   195\t        self.assertEqual(len(content_pieces), 1)\n   196\t        self.assertEqual(\n   197\t            content_pieces[0],\n   198\t            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   199\t        )\n   200\t\n   201\t    def test_e2e_reconcile_wire_sync_and_preamble_dedup(self) -> None:\n   202\t        \"\"\"Сквозная проверка: дедупликация преамбул в reasoning и синхронизация reconcile с wire.\"\"\"\n   203\t        # 1. Проверка дедупликации преамбулы при повторной записи шага\n   204\t        emitted_events: list[tuple[str, str]] = []\n   205\t\n   206\t        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n   207\t            emitted_events.append((\"reasoning\", delta))\n   208\t            return True\n   209\t\n   210\t        plan = srv._TurnPlan()\n   211\t        plan.mode = \"OFF\"\n   212\t        tail = srv._TranscriptTail(\n   213\t            emit=emit_reasoning,\n   214\t            stop_event=threading.Event(),\n   215\t            done_event=threading.Event(),\n   216\t            resumed=False,\n   217\t            plan=plan,\n   218\t            turn_id=\"turn-dedup-1\",\n   219\t            emit_content=lambda idx, t: True,\n   220\t            isolate_tool_preambles=True,\n   221\t        )\n   222\t\n   223\t        rec = {\n   224\t            \"type\": \"PLANNER_RESPONSE\",\n   225\t            \"step_index\": 10,\n   226\t            \"content\": \"Запуск анализа...\",\n   227\t            \"tool_calls\": [{\"name\": \"read_file\", \"args\": {}}],\n   228\t        }\n   229\t        raw_bytes = json.dumps(rec).encode(\"utf-8\")\n   230\t        tail._emit_record(raw_bytes)\n   231\t        # Повторная доставка того же шага (например при rewrite)\n   232\t        tail._emit_record(raw_bytes)\n   233\t\n   234\t        preambles = [t for k, t in emitted_events if \"Запуск анализа...\" in t]\n   235\t        self.assertEqual(\n   236\t            len(preambles),\n   237\t            1,\n   238\t            f\"Преамбула эмитирована {len(preambles)} раз вместо 1: {preambles}\",\n   239\t        )\n   240\t\n   241\t        # 2. Проверка отсутствия ложной дивергенции в Run.reconcile_result\n   242\t        run = object.__new__(srv.Run)\n   243\t        setattr(run, \"_emit_lock\", threading.Lock())\n   244\t        setattr(run, \"q\", queue.Queue())\n   245\t        setattr(run, \"drain_closed\", False)\n   246\t        setattr(run, \"_done_put\", False)\n   247\t        setattr(run, \"_reasoning_bytes\", 0)\n   248\t        setattr(run, \"_cap_logged\", False)\n   249\t        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-sync-1\"))\n   250\t        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-sync-1\"))\n   251\t        setattr(run, \"turn_id\", \"turn-sync-1\")\n   252\t        setattr(run, \"run_cid\", \"cid-sync-1\")\n   253\t        setattr(run, \"_last_step_index\", None)\n   254\t        setattr(run, \"_content_emitted_wire\", \"\")\n   255\t\n   256\t        run.offer_content(\"transcript\", 1, \"Шаг 1 завершён.\")\n   257\t        run.offer_content(\"transcript\", 2, \"Шаг 2 завершён.\")\n   258\t\n   259\t        # Wire содержит разделитель \\n\\n\n   260\t        wire_text = getattr(run, \"_content_emitted_wire\")\n   261\t        self.assertEqual(wire_text, \"Шаг 1 завершён.\\n\\nШаг 2 завершён.\")\n   262\t\n   263\t        # reconcile_result с тем же текстом не должен давать дивергенции\n   264\t        delta = run.reconcile_result(wire_text)\n   265\t        self.assertEqual(delta, \"\")\n   266\t        self.assertFalse(\n   267\t            getattr(run._arbiter, \"last_result_diverged\", False),\n   268\t            \"Ложное срабатывание дивергенции при точном совпадении wire_text\",\n   269\t        )\n   270\t\n   271\t        # reconcile_result с дополнительным хвостом\n   272\t        delta_extra = run.reconcile_result(wire_text + \" Дополнительный итог.\")\n   273\t        self.assertEqual(delta_extra, \" Дополнительный итог.\")\n   274\t        self.assertFalse(\n   275\t            getattr(run._arbiter, \"last_result_diverged\", False),\n   276\t            \"Ложное срабатывание дивергенции при суффиксе wire_text\",\n   277\t        )\n   278\t\n   279\t\n   280\tif __name__ == \"__main__\":\n   281\t    unittest.main()\n# Skill: Code Review\n\n## Цель\n\nПроверить что код соответствует стандартам из `.agents/agents/python-standards.md`\nи архитектурным правилам из `.agents/agents/architecture.md`.\n\n***\n\n## Алгоритм\n\n### 1. Запустить автоматические проверки\n\n~~~bash\nuv run ruff check <файл_или_папка>\nuv run basedpyright <файл_или_папка>\n~~~\n\nВключить результаты в отчёт. Автоматические ошибки не пересказывать — только итог.\n\n### 2. Прочитать файлы под ревью полностью\n\n### 3. Проверить по чеклисту\n\n#### 🔴 Блокирующие (merge запрещён до исправления)\n\n- [ ] `from __future__ import annotations` — первая строка в файле\n- [ ] Все параметры функций аннотированы\n- [ ] Все функции имеют аннотацию возвращаемого типа (включая `-> None`)\n- [ ] Нет `Optional[X]`, `List[X]`, `Dict[K,V]` — только `X | None`, `list[X]`, `dict[K,V]`\n- [ ] Нет `-> dict` / `dict[str, Any]` как публичного контракта (HTTP schema **и** service-layer public methods) — только DTO/Value Object/Pydantic\n- [ ] **Boundary typing:** внешний API/connector — request/response через Pydantic `BaseModel` или `@dataclass`; запрещён пронос сырого `dict` / `dict[str, Any]` через service/handler boundary\n- [ ] **Domain literals:** currency, billing cycle, product_type (`USD`/`RUB`, `yearly`/`monthly`, `ppr`, …) — только `Enum` / `Final` / именованная константа; inline string в production-коде = блокер\n- [ ] **Один mapping provider→internal:** запрещены независимые копии одного и того же словаря/ветки match в разных модулях (дубль = блокер, не bikeshed)\n- [ ] **Nested `.get()` chains** на парсинге внешнего JSON / money path запрещены (silent `None`); нужен model_validate / явный доступ с проверкой\n<!-- BEGIN gitlab-review-hardening 2026-09-10-cel code-review promote -->\n<!-- END gitlab-review-hardening 2026-09-10-cel -->\n- [ ] Сервисный слой не импортирует `db/models.py` напрямую\n- [ ] Бизнес-логика не в route handlers\n- [ ] Нет `except Exception: pass`\n- [ ] Нет мутируемых значений по умолчанию (`= []`, `= {}`)\n- [ ] **Async-инварианты (§5):** проект полностью async — нет `from sqlalchemy.orm import Session` (только `AsyncSession`), все DB-методы `async def` + `await session.execute(...)`, сервис вызывает репозиторий через `await`, handler'ы `async def` + `await service.X(...)`. Sync-вызов в async-контексте блокирует event loop и валит производительность.\n- [ ] **Никаких `next(generator_func())` для async-генераторов** — это просто не работает (нужен `anext()` или `async for`). Признак copy-paste из старого sync-кода.\n- [ ] **Логирование (§13):** нет `print()`, нет f-строк в `logger.info(...)`, нет секретов / токенов / Authorization в kwargs.\n- [ ] **Безопасность (§14):** нет хардкода секретов, SQL параметризован, пароли через `bcrypt`/`argon2`, HTTP-клиенты с `timeout=` и `verify=True`, `subprocess` без `shell=True` с user input.\n- [ ] **Внешний контракт заморожен:** diff не меняет согласованный HTTP/event/data/CLI/SDK контракт с внешними исполнителями, если в текущей задаче нет явного указания это сделать. Добавление поля, смена default/типа, новый код ошибки на старом пути — тоже изменение. Канон: `.agents/agents/scope-and-contracts.md`.\n- [ ] **Только своя задача:** в diff и отчёте нет чужих Jira-KEY, чужого скоупа и «заодно» из соседних задач. Тот же канон.\n- [ ] **Сдача не минуя MR:** diff пришёл веткой / MR, не прямым коммитом или push в `main`/`master`/`dev`. Канон: `.agents/agents/mr.md`.\n- [ ] **Highload Hot-Path & Complexity:** на горячем пути (`executor/`, сетевое проксирование, роутинг, IPC) отсутствуют блокирующий синхронный код в `async def` (запрет 21, проверяется `ruff ASYNC` + AST-гейтом) и линейные O(N) циклы/генераторы по коллекциям размера пула/снапшота > 100 элементов; сложность по размеру пула строго O(1) или O(log N) (O(k) по элементам самого запроса допустима в пределах `S_frame_max`).\n- [ ] **Zero-copy / early-exit / pass-through / backpressure (blocking):** отправка кадров/тел > 4 КиБ на горячем пути только через общий `send_all(view)` на `memoryview` (нет `bytes[sent:]`, на приёме для неизменяемых `bytes`/`str` нет рекуррентного переприсваивания аккумулятора в цикле и его sync-хелперах (`acc += chunk`, `acc = acc + chunk`, `f\"{acc}{chunk}\"`, `%`/`.format()`, `.__add__`), а для `bytearray` нет `buf = buf + chunk` / `buf[:] = buf + chunk` (для `bytearray` разрешены только in-place `buf.extend(chunk)` и `buf += chunk`), соблюдён лимит размера кадра `S_frame_max` из `NFR-Scale Card`, хук наблюдения `on_chunk(acc_obj)` с проверкой неизменности `id(acc_obj)` и граница роста `bytearray` $9/8$ в `H-CPU-I6(а)`; ctypes-указатель — с явной проверкой границ без `assert` и удержанием буфера); retry/diversity-циклы выходят на 1-й итерации при структурном отсутствии кандидатов; pass-through и распаковка `Content-Encoding` строго по условиям `python-standards.md` (запрет 24, RFC 9111 §5.2.1.6/§5.2.2.6 `no-transform`, RFC 9110 §7.7) и с оракулом `H-CPU-I6`(г) на заголовки (`Content-Encoding`, `Content-Length`, удаление/пересчёт `Content-Digest` RFC 9530 §2 / `Repr-Digest` RFC 9530 §3 / `Digest` / `Content-MD5` включая трейлеры, `Accept-Ranges: none`, обязательный `Vary: Accept-Encoding` на обеих ветках при content negotiation по RFC 9111 §4.1 даже при наличии `no-transform`, ослабление `ETag`), многомерные лимиты распаковки (срезы `step_len = min(len(mv) - pos, 4096, 65536 - (member_in_offset % 65536))`, `wbits=31` для `gzip` и 2-байтовый `hdr_buf` с выбором `-MAX_WBITS` либо двумя независимыми состояниями `st15`/`st_raw` при совпадении с заголовком RFC 1950 (и отказом `st15` при `FDICT=1`) для `deflate`, проверка `total_out <= S_frame_max` перед каждым `out = d.decompress(...)`, `total_out += len(out); if total_out > S_frame_max: raise` после каждого вызова и drain `while d.unconsumed_tail and not d.eof:`, расчёт `consumed = step_len - len(d.unused_data)` (`pos += consumed`, `total_in += consumed`, `member_in_offset += consumed`), проверка прогресса `total_out > out_at_last_checkpoint` с обновлением `out_at_last_checkpoint = total_out` на границах `member_in_offset % 65536 == 0`, ленивое создание следующего `decompressobj(31)` в `gzip` после `d.eof is True` только при поступлении следующего байта входа `pos < len(mv)` (`member_count = 1..8`, отказ при EOF `deflate` с `< 2` байтами), `total_in <= S_frame_max`, `<= 1` слой `Content-Encoding`, атомарный try-acquire `if sem.locked():` (`503` до заголовков / аварийный обрыв после) на `sem = asyncio.Semaphore(4)` с `cf_fut = decompress_pool.submit(_worker)` и идемпотентным `_release_once()` через `_safe_schedule_release()` в `finally:` потока, при сбое `submit` и при `cf_fut.cancelled()`, с абортом всего запроса при `TimeoutError` на `wait_for(shield(worker_fut), 0.050)`), глобальный бюджет провизорных буферов `global_provisional_decompress_bytes <= 8 * S_frame_max`, явную проверку без `assert` (`d.unconsumed_tail in (b\"\", d.unused_data)` на границе промежуточного члена `gzip` и `d.eof is True and d.unconsumed_tail == b\"\" and d.unused_data == b\"\" and d.flush() == b\"\"` на финальном EOF входа), `identity;q=0` и `206` (`406` при `q=0` только на `206`, но не на бестелесных `1xx`/`204`/`205`/`304`/`HEAD`); `CURL_WRITEFUNC_PAUSE` не сопровождается постановкой chunk в очередь, есть байтовый бюджет очереди и жизненный цикл паузы.\n- [ ] **Сериализация Data Plane:** на горячем пути отсутствует стандартный `import json`; используется `orjson` (с возвратом `bytes`) для HTTP или `msgspec` для IPC кадров.\n- [ ] **Zero Blocking I/O (`H-CPU-I2`, Запрет 21):** в потоке `event loop` внутри `async def` (и вызываемых из них синхронных хелперах) отсутствуют любые блокирующие синхронные вызовы (DNS, блокирующие сокеты, файловый/ФС I/O, `time.sleep`, `subprocess`, блокирующие `Lock.acquire`/`Event.wait`/`Queue.get`, sync HTTP/DB драйверы) и CPU-тики $> 2\\text{ мс}$; неблокирующие режимы (`sock.gettimeout() == 0`, `acquire(blocking=False)`, `get_nowait()`/`put_nowait()`) и offload по **fail-closed белому списку `TO_THREAD_ALLOWLIST`** (`await loop.getaddrinfo(...)`, `await asyncio.to_thread(fn, ...)` для явно разрешённых I/O-хелперов классов 1–3 с циклами `<= S_frame_max` и GIL-отпускающих C-расширений вроде потокового `zlib.decompressobj(wbits).decompress(sub, max_length=S_frame_max - total_out + 1)` с полным контрактом защиты от bomb/усечения (срезы до границ `member_in_offset % 65536 == 0`, `wbits=31` для `gzip` и 2-байтовый `hdr_buf` с `-MAX_WBITS` либо двумя независимыми состояниями `st15`/`st_raw` для `deflate`, проверка `total_out <= S_frame_max` перед каждым `out = d.decompress(...)`, `total_out += len(out); if total_out > S_frame_max: raise` и drain `while d.unconsumed_tail and not d.eof:`, сдвиг `consumed = step_len - len(d.unused_data)` (`pos += consumed`, `member_in_offset += consumed`), проверка прогресса `total_out > out_at_last_checkpoint` с обновлением `out_at_last_checkpoint = total_out` на `member_in_offset % 65536 == 0`, ленивое создание следующего `decompressobj(31)` в `gzip` после `eof` только при наличии следующего входного байта `pos < len(mv)` (`member_count = 1..8`, отказ при EOF `deflate` с `< 2` байтами), `total_in <= S_frame_max`, `<= 1` слоя `Content-Encoding`, try-acquire `if sem.locked():` (`503` до заголовков / аварийный обрыв после) на `sem = asyncio.Semaphore(4)` с `cf_fut = decompress_pool.submit(_worker)`, `_release_once()` через `_safe_schedule_release()` по `finally:` потока, сбою `submit` и `cf_fut.cancelled()`, абортом всего запроса при `TimeoutError` на `wait_for(shield(worker_fut), 0.050)` , `global_provisional_decompress_bytes <= 8 * S_frame_max` и явную проверку без `assert` `d.unconsumed_tail in (b\"\", d.unused_data)` на границе члена `gzip` и `d.eof is True and d.unconsumed_tail == b\"\" and d.unused_data == b\"\" and d.flush() == b\"\"` на финальном EOF входа) и `zlib.compress` на `<= S_frame_max`, без one-shot `zlib.decompress`) разрешены, а любые функции вне `TO_THREAD_ALLOWLIST` и вызовы `GIL_HOLDING_DENYLIST` (`orjson`/`msgspec`/`pydantic`/`json`/`pickle`/`deepcopy`) заблокированы; при активных `assert tracemalloc.is_tracing() is True and gc.isenabled() is True` проверены чистый прирост пика `0 <= peak - base_current <= 4 * S_frame_max` после `reset_peak()`, `delta_gc_gen1_gen2 == 0` по `gc.get_stats()` (с `gc.freeze()`/`gc.unfreeze()` в `finally`), лог чередования пачек `max_pages_touched_per_tick <= MAX_PAGES_PER_TICK` с сериализацией поколений `len(live_mmaps) <= G_reload = 2` и `sum(len(m) for m in live_mmaps) <= Mem_shared_max` и прогон `-m \"measured or heavy\"` (`-n 0` после `gc.collect()` с включённым GC, включая `max_reload_window_tick_ms <= 2.0 мс`, 0-й запрос `first_post_swap_req_tick_ms <= 2.0 мс` и стационарный `p99 <= 2.0 мс`).\n- [ ] **Двухшкальное время:** дельты для таймаутов, пауз и sleep берутся только от `time.monotonic()` (`_monotonic_ms`); запрещено смешивать с `time.time()` в одном вычитании (защита от spin-loop).\n\n- [ ] **Инварианты `T-LIFE/v1`, `O-EXIT/v1`, `M-SEM/v1` (`.agents/agents/testing.md` `#t-life`, `#o-exit`, `#m-sem`):** сверить diff с единой таблицей триггеров (`Триггер → Инвариант`). При сработавшем триггере: (а) отметка `N/A` отклоняется (`BLOCKED`); (б) `PASS` по подстроке SQL, только по HTTP-статусу или только по полю структуры без проверки sink-а финализатора отклоняется; (в) при неполном Stage 1 `M-SEM/v1` ставится `BLOCKED`, а при выполненном Stage 1 без живой сверки Stage 2 допускается только статус `PASS_STAGE1_ONLY` (`PENDING_STAGE2_LIVE_VERIFY`), но не полный `PASS`.\n\n#### 🟡 Некритичные (рекомендации, исправить в следующем PR)\n\n- [ ] Нет магических чисел — только именованные константы\n  **Исключение/эскалация:** литералы currency / billing cycle / product_type и числовые пороги биллинга/квот — это 🔴 (см. Domain literals), не 🟡.\n- [ ] Нет дублирования логики (DRY)\n- [ ] Функция делает одно дело (SRP), не длиннее 30-40 строк\n- [ ] Именование: `snake_case` / `PascalCase` / `UPPER_SNAKE_CASE`\n- [ ] Параллельные задачи через `asyncio.TaskGroup`, не `gather()` (когда не нужен `return_exceptions=True`) — §5\n- [ ] Современный синтаксис: `type UserId = int` (PEP 695), `Self`, `match/case`, `StrEnum` где уместно — §15\n- [ ] Coverage на новой логике не понижает общий процент ниже 80% (`--cov-fail-under=80`)\n\n***\n\n## Формат отчёта\n\n~~~text\n## Code Review: <файл или ветка>\n\n### Автоматические проверки\nruff: X ошибок | basedpyright: Y ошибок\n\n### Нарушения\n\n#### 🔴 Блокирующие\n\n| # | Файл | Строка | Нарушение | Стандарт |\n|---|------|--------|-----------|----------|\n| 1 | bad_link_service.py | 1 | Отсутствует `from __future__ import annotations` | python-standards §1 |\n\n#### 🟡 Некритичные\n\n| # | Файл | Строка | Нарушение | Стандарт |\n|---|------|--------|-----------|----------|\n| 1 | bad_link_service.py | 45 | Магическое число `75` | python-standards §8 |\n\n### Покрытие инвариантов (`T-LIFE/v1` / `O-EXIT/v1` / `M-SEM/v1`)\n- `T-LIFE/v1`: `PASS` / `BLOCKED` / `N/A (триггеры времени/жизненного цикла не затронуты)` — <ссылка на тест/ячейки матрицы>\n- `O-EXIT/v1`: `PASS` / `BLOCKED` / `N/A (ранние выходы и порядок инициализации контекста не затронуты)` — <ссылка на тест финализатора и sink>\n- `M-SEM/v1`: `PASS` / `PASS_STAGE1_ONLY (PENDING_STAGE2_LIVE_VERIFY)` / `BLOCKED` / `N/A (метрики/панели/знаменатели не затронуты)` — <ссылка на паспорт метрики и фикстуру>\n\n### Итог\n- Блокирующих: X\n- Рекомендаций: Y\n- Вердикт: ❌ Требует правок / ✅ Можно принимать\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport runpy, io, json\nfrom unittest.mock import patch\nsm = runpy.run_path('scripts/smoke_models.py')\nclass Resp(io.BytesIO):\n    def getcode(self): return 200\nfor name, body in [('eof_without_done', b'data: {\\\"choices\\\":[{\\\"delta\\\":{\\\"content\\\":\\\"hi\\\"}}]}\\\\n\\\\n'), ('error_then_done', b'data: {\\\"error\\\":{\\\"message\\\":\\\"backend failed\\\"}}\\\\n\\\\ndata: [DONE]\\\\n\\\\n')]:\n    with patch('urllib.request.urlopen', return_value=Resp(body)):\n        print(name, sm['smoke_test_model']('http://example.invalid/v1','fixture',api_key='fixture'))\nt = runpy.run_path('tests/test_agy_bridge_resilience.py')\nrun, items = t['_pump_queue']([t['_stdout_text'](1,'Tool preamble'),t['_stdout_tool'](1)],content=True)\nprint('stdout_before_transcript', [(k,v) for k,v in items if k in ('text','reasoning')])\nsrv=t['srv']\nr=t['_bare_run']()\nr._arbiter=srv._ContentArbiter('x'); r.turn_id='x'; r.run_cid='x'\nr.offer_content('stdout',None,'Alpha.')\nr.offer_content('stdout',None,'Bravo.')\nprint('no_step_index_wire',repr(r._content_emitted_wire))\nr=t['_bare_run'](); r._arbiter=srv._ContentArbiter('x'); r.turn_id='x'; r.run_cid='x'\nr.offer_content('stdout',1,'First.')\nr.offer_content('stdout',2,'Second.')\nprint('normalized_aggregate', repr(r.reconcile_result('First.\\\\n\\\\nSecond. Extra.')),r._arbiter.last_result_diverged)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
