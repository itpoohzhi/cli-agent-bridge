h(\"\\n\\n\"):\n5336|                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n5337|                self._last_step_index = step_index\n5338|                self._content_emitted_wire = emitted_wire + sep + suffix\n5339|                self.q.put((\"text\", sep + suffix))\n5340|        return True\n5341|\n5342|    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n5343|        return self.offer_content(\"transcript\", step_index, text)\n5344|\n5345|    def reconcile_result(self, text: str) -> str:\n5346|        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром и выданного в wire.\"\"\"\n5347|        with self._emit_lock:\n5348|            emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5349|            if emitted_wire and text:\n5350|                if text == emitted_wire or emitted_wire.startswith(text):\n5351|                    self._arbiter.last_result_diverged = False\n5352|                    return \"\"\n5353|                if text.startswith(emitted_wire):\n5354|                    self._arbiter.last_result_diverged = False\n5355|                    return text[len(emitted_wire) :]\n5356|                clean_text = text.replace(\"\\r\\n\", \"\\n\").strip()\n5357|                clean_wire = emitted_wire.replace(\"\\r\\n\", \"\\n\").strip()\n5358|                if clean_text == clean_wire or clean_wire.startswith(clean_text):\n5359|                    self._arbiter.last_result_diverged = False\n5360|                    return \"\"\n5361|            return self._arbiter.reconcile_result(text)\n5362|\n5363|    def retained_divergent_text(self) -> str:\n5364|        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n5365|        with self._emit_lock:\n5366|            return self._arbiter.retained_divergent_text()\n5367|\n5368|    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n5369|        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n5370|        заморозка выдачи и остаток очереди ДО terminal marker'а.\n5371|\n5372|        Процесс при этом ещё жив: окно дренирования хвоста открывает `_proc_done`.\n5373|        Возвращает необработанные потребителем события (\"text\"/\"reasoning\"/\"tool_trace\").\n5374|        \"\"\"\n5375|        started = time.monotonic()\n5376|        join_budget = budget_s\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c405","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":93,"recorded_at":1780531400000181,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c64eba1718ba7af2a581742953f","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(3772 line(s) above)\n3773|class _ContentArbiter:\n3774|    \"\"\"Двухуровневый арбитр planner-текста двух источников (stdout и transcript), AD-001.\n3775|\n3776|    Вызывается под `Run._emit_lock`; ввода-вывода внутри нет. Кандидат — кумулятивный\n3777|    снимок текста шага.\n3778|\n3779|    Уровень 1 — ключ `(turn_id, cid, step_idx)` при валидном `step_idx >= 0`: равный\n3780|    снимок или его префикс дают 0 байт, расширение — только суффикс, непрефиксное\n3781|    расхождение замораживает шаг (без повтора старого префикса и склейки мусора).\n3782|\n3783|    Уровень 2 — turn-level: кандидат без валидного idx (None/<0/не-int) либо со\n3784|    «чужим» idx сверяется со снимками шагов, созданных ДРУГИМ источником (при idx\n3785|    None — любым): равный/префикс -> 0 байт, расширение последнего снимка -> суффикс;\n3786|    совпавший шаг получает alias (source, idx) -> канонический watermark. Два\n3787|    валидных шага одного источника с одинаковым текстом сохраняются оба.\n3788|\n3789|    Индексы: equality — dict, префикс — bisect по отсортированным снимкам; обхода\n3790|    всей истории на каждый чанк нет. При исчерпании лимитов приём прекращается с\n3791|    явным `overflow` (accepted-текст молча не отбрасывается и не переотдаётся).\n3792|    \"\"\"\n3793|\n3794|    def __init__(self, turn_id: str) -> None:\n3795|        self.turn_id = turn_id\n3796|        self.by_key: dict[tuple[str, str, int], _ArbStep] = {}\n3797|        self.step_count = 0\n3798|        self.eq_index: dict[str, list[_ArbStep]] = {}\n3799|        self.sorted_texts: list[str] = []\n3800|        # Те же индексы в разрезе источника-создателя: кандидат с валидным idx\n3801|        # сверяется только с шагами ДРУГИХ источников, без скана одноимённых.\n3802|        self._eq_by_source: dict[str, dict[str, list[_ArbStep]]] = {}\n3803|        self._sorted_by_source: dict[str, list[str]] = {}\n3804|        self.retained_divergent: list[str] = []\n3805|        self.retained_divergent_bytes = 0\n3806|        self.last_step: _ArbStep | None = None\n3807|        self.last_by_source: dict[str, _ArbStep] = {}\n3808|        self.chunks: list[str] = []\n3809|        self.bytes_total = 0\n3810|        self.overflow = False\n3811|        self.divergences = 0\n3812|        self.probes = 0\n3813|        self.last_result_diverged = False\n3814|\n3815|    def _set_overflow(self, why: str) -> None:\n3816|        if not self.overflow:\n3817|            self.overflow = True\n3818|            _log(f\"content-overflow turn={self.turn_id[:8] or '-'} why={why}\")\n3819|\n3820|    def _retain_divergent(self, text: str) -> None:\n3821|        \"\"\"Удержать расходящийся текст (до MAX_RETAINED_DIVERGENT_BYTES суммарно).\"\"\"\n3822|        room = MAX_RETAINED_DIVERGENT_BYTES - self.retained_divergent_bytes\n3823|        if room <= 0 or not text:\n3824|            return\n3825|        data = text.encode(\"utf-8\")\n3826|        if len(data) > room:\n3827|            text = data[:room].decode(\"utf-8\", \"ignore\")\n3828|            data = text.encode(\"utf-8\")\n3829|        if text:\n3830|            self.retained_divergent.append(text)\n3831|            self.retained_divergent_bytes += len(data)\n3832|\n3833|    def retained_divergent_text(self) -> str:\n3834|        return \"\".join(self.retained_divergent)\n3835|\n3836|    @staticmethod\n3837|    def _drop(\n3838|        eq: dict[str, list[_ArbStep]],\n3839|        texts: list[str],\n3840|        step: _ArbStep,\n3841|        old: str,\n3842|    ) -> None:\n3843|        bucket = eq.get(old)\n3844|        if bucket is None:\n3845|            return\n3846|        bucket.remove(step)\n3847|        if not bucket:\n3848|            del eq[old]\n3849|            pos = bisect.bisect_left(texts, old)\n3850|            if pos < len(texts) and texts[pos] == old:\n3851|                del texts[pos]\n3852|\n3853|    @staticmethod\n3854|    def _put(\n3855|        eq: dict[str, list[_ArbStep]], texts: list[str], step: _ArbStep, text: str\n3856|    ) -> None:\n3857|        bucket = eq.setdefault(text, [])\n3858|        if not bucket:\n3859|            bisect.insort(texts, text)\n3860|        bucket.append(step)\n3861|\n3862|    def _unindex(self, step: _ArbStep) -> None:\n3863|        old = step.emitted\n3864|        if not old:\n3865|            return\n3866|        self._drop(self.eq_index, self.sorted_texts, step, old)\n3867|        self._drop(\n3868|            self._eq_by_source.setdefault(step.origin, {}),\n3869|            self._sorted_by_source.setdefault(step.origin, []),\n3870|            step,\n3871|            old,\n3872|        )\n3873|\n3874|    def _index(self, step: _ArbStep, text: str) -> None:\n3875|        self._put(self.eq_index, self.sorted_texts, step, text)\n3876|        self._put(\n3877|            self._eq_by_source.setdefault(step.origin, {}),\n3878|            self._sorted_by_source.setdefault(step.origin, []),\n3879|            step,\n3880|            text,\n3881|        )\n3882|\n3883|    def _eligible(self, step: _ArbStep, source: str, idx: int | None) -> bool:\n3884|        self.probes += 1\n3885|        return idx is None or step.origin != source\n3886|\n3887|    def _match(self, source: str, idx: int | None, text: str) -> _ArbStep | None:\n3888|        \"\"\"Шаг, к которому относится кандидат без прямого ключа (уровень 2).\"\"\"\n3889|        if idx is None:\n3890|            found = self._scan(self.eq_index, self.sorted_texts, source, idx, text)\n3891|        else:\n3892|            # Валидный idx: подходят только шаги других источников; одноимённые\n3893|            # (N одинаковых шагов одного источника) не просматриваются вовсе.\n3894|            found = None\n3895|            for other, eq in self._eq_by_source.items():\n3896|                if other == source:\n3897|                    continue\n3898|                found = self._scan(eq, self._sorted_by_source[other], source, idx, text)\n3899|                if found is not None:\n3900|                    break\n3901|        if found is not None:\n3902|            return found\n3903|        refs: list[_ArbStep] = []\n3904|        if self.last_step is not None:\n3905|            refs.append(self.last_step)\n3906|        for other, step in self.last_by_source.items():\n3907|            if other != source and step not in refs:\n3908|                refs.append(step)\n3909|        for step in refs:\n3910|            if (\n3911|                step.emitted\n3912|                and text.startswith(step.emitted)\n3913|                and self._eligible(step, source, idx)\n3914|            ):\n3915|                return step\n3916|        return None\n3917|\n3918|    def _scan(\n3919|        self,\n3920|        eq: dict[str, list[_ArbStep]],\n3921|        texts: list[str],\n3922|        source: str,\n3923|        idx: int | None,\n3924|        text: str,\n3925|    ) -> _ArbStep | None:\n3926|        for step in eq.get(text, ()):\n3927|            if self._eligible(step, source, idx):\n3928|                return step\n3929|        candidates = [t for t in texts if len(text) >= len(t) and text.startswith(t)]\n3930|        if candidates:\n3931|            candidates.sort(key=len, reverse=True)\n3932|            for cand in candidates:\n3933|                for step in eq[cand]:\n3934|                    if self._eligible(step, source, idx):\n3935|                        return step\n3936|        if idx is None:\n3937|            pos = bisect.bisect_left(texts, text)\n3938|            while pos < len(texts) and texts[pos].startswith(text):\n3939|                for step in eq[texts[pos]]:\n3940|                    if step.origin != source and self._eligible(step, source, idx):\n3941|                        return step\n3942|                pos += 1\n3943|        return None\n3944|\n3945|    def _advance(self, step: _ArbStep, source: str, text: str) -> str:\n3946|        if step.frozen:\n3947|            return \"\"\n3948|        prefix = step.emitted\n3949|        if text == prefix or (len(text) < len(prefix) and prefix.startswith(text)):\n3950|            return \"\"\n3951|        if not text.startswith(prefix):\n3952|            step.frozen = True\n3953|            self._retain_divergent(text)\n3954|            self.divergences += 1\n3955|            _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source={source}\")\n3956|            return \"\"\n3957|        suffix = text[len(prefix) :]\n3958|        size = len(suffix.encode(\"utf-8\"))\n3959|        if self.bytes_total + size > MAX_CONTENT_BYTES_PER_TURN:\n3960|            self._set_overflow(\"bytes\")\n3961|            return \"\"\n3962|        self._unindex(step)\n3963|        step.emitted = text\n3964|        self._index(step, text)\n3965|        self.chunks.append(suffix)\n3966|        self.bytes_total += size\n3967|        self.last_step = step\n3968|        self.last_by_source[source] = step\n3969|        return suffix\n3970|\n3971|    def offer(self, source: str, step_index: object, text: str, cid: str = \"\") -> str:\n3972|        \"\"\"Кумулятивный снимок -> новый суффикс ('' — дубль, префикс или заморозка).\"\"\"\n3973|        if self.overflow or not text:\n3974|            return \"\"\n3975|        idx = (\n3976|            step_index\n3977|            if isinstance(step_index, int)\n3978|            and not isinstance(step_index, bool)\n3979|            and step_index >= 0\n3980|            else None\n3981|        )\n3982|        key = (self.turn_id, cid, idx) if idx is not None else None\n3983|        step = self.by_key.get(key) if key is not None else None\n3984|        if step is None:\n3985|            step = self._match(source, idx, text)\n3986|            if step is None:\n3987|                if self.step_count >= MAX_CONTENT_STEPS:\n3988|                    self._set_overflow(\"steps\")\n3989|                    return \"\"\n3990|                step = _ArbStep(source)\n3991|                self.step_count += 1\n3992|            if key is not None:\n3993|                if len(self.by_key) >= 4 * MAX_CONTENT_STEPS:\n3994|                    self._set_overflow(\"aliases\")\n3995|                    return \"\"\n3996|                self.by_key[key] = step\n3997|        return self._advance(step, source, text)\n3998|\n3999|    def reconcile_result(self, text: str) -> str:\n4000|        \"\"\"`result.response` как агрегат: досылается только то, чего ещё не было выдано.\"\"\"\n4001|        self.last_result_diverged = False\n4002|        if self.overflow or not text:\n4003|            return \"\"\n4004|        emitted = \"\".join(self.chunks)\n4005|        if not emitted:\n4006|            if self.step_count >= MAX_CONTENT_STEPS:\n4007|                self._set_overflow(\"steps\")\n4008|                return \"\"\n4009|            self.step_count += 1\n4010|            return self._advance(_ArbStep(\"result\"), \"result\", text)\n4011|        if text == emitted or emitted.startswith(text):\n4012|            return \"\"\n4013|        if text.startswith(emitted):\n4014|            if self.step_count >= MAX_CONTENT_STEPS:\n4015|                self._set_overflow(\"steps\")\n4016|                return \"\"\n4017|            self.step_count += 1\n4018|            return self._advance(_ArbStep(\"result\"), \"result\", text[len(emitted) :])\n4019|        if text in self.eq_index:\n4020|            self.probes += 1\n4021|            return \"\"\n4022|        pos = bisect.bisect_left(self.sorted_texts, text)\n4023|        if pos < len(self.sorted_texts) and self.sorted_texts[pos].startswith(text):\n4024|            self.probes += 1\n4025|            return \"\"\n4026|        last = self.last_step\n4027|        if last is not None and last.emitted and text.startswith(last.emitted):\n4028|            return self._advance(last, \"result\", text)\n4029|        self._retain_divergent(text)\n4030|        self.divergences += 1\n4031|        self.last_result_diverged = True\n4032|        _log(f\"content-divergence turn={self.turn_id[:8] or '-'} source=result\")\n4033|        return \"\"\n4034|\n4035|\n4036|def _safe_tool_name(raw: object) -> str:\n4037|    \"\"\"Имя инструмента для маркера: только закрытый список, всё остальное -> `tool`.\"\"\"\n4038|    if not isinstance(raw, str):\n4039|        return \"tool\"\n4040|    name = raw.strip()\n4041|    if (\n4042|        not name\n4043|        or len(name) > 128\n4044|        or name[0] in \"/.\"\n4045|        or \"..\" in name\n4046|        or re.fullmatch(r\"[A-Za-z0-9_:./-]+\", name) is None\n4047|    ):\n4048|        return \"tool\"\n4049|    bare = re.split(r\"[:./]\", name)[-1]\n4050|    if bare in TOOL_NAME_ALLOWLIST or _SAFE_MCP_TOOL_RE.fullmatch(bare) is not None:\n4051|        return bare\n4052|    return \"tool\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c64eec7706cba5e5cd10685abeb","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4539 line(s) above)\n4540|        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n4541|            self.end_marker = True\n4542|            return\n4543|        if rtype != \"PLANNER_RESPONSE\":\n4544|            return\n4545|        if self.usage_enabled:\n4546|            self._record_usage(rec)\n4547|        content = rec.get(\"content\")\n4548|        emit_content = self.emit_content\n4549|        has_tools = bool(rec.get(\"tool_calls\"))\n4550|        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n4551|        if emit_content is not None and isinstance(content, str) and content.strip():\n4552|            if has_tools and isolate_tools:\n4553|                preambles = getattr(self, \"_preambles_emitted\", None)\n4554|                if preambles is None:\n4555|                    preambles = self._preambles_emitted = set()\n4556|                key_idx = idx if idx is not None else -1\n4557|                if key_idx not in preambles:\n4558|                    preambles.add(key_idx)\n4559|                    _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n4560|            else:\n4561|                _ = emit_content(\n4562|                    idx, content\n4563|                )  # live planner-текст, независимо от tool_calls\n4564|        if idx is None:\n4565|            return\n4566|        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n4567|            self.final_planner = True\n4568|        thinking = rec.get(\"thinking\")\n4569|        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n4570|\n4571|    # ---- состояние шагов -----------------------------------------------------------\n4572|    def _state(self, idx: int) -> _StepState:\n4573|        state = self.seen.get(idx)\n4574|        if state is not None:\n4575|            return state\n4576|        if len(self.seen) >= MAX_STEPS_TRACKED:\n4577|            evictable = [\n4578|                k\n4579|                for k, s in self.seen.items()\n4580|                if s.finalized and k < self.poll_watermark\n4581|            ]\n4582|            if evictable:\n4583|                del self.seen[min(evictable)]\n4584|            else:\n4585|                self._sqlite_off(\"seen_cap\")\n4586|                del self.seen[min(self.seen)]\n4587|        state = _StepState()\n4588|        self.seen[idx] = state\n4589|        return state\n4590|\n4591|    def _step_done(self, state: _StepState) -> bool:\n4592|        return state.sql_done or (\n4593|            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n4594|        )\n4595|\n4596|    def _advance_watermark(self) -> None:\n4597|        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n4598|        mark = self.poll_watermark\n4599|        for key in sorted(self.seen):\n4600|            if key < mark:\n4601|                continue\n4602|            if not self._step_done(self.seen[key]):\n4603|                break\n4604|            mark = key + 1\n4605|        self.poll_watermark = mark\n4606|\n4607|    def _emit_delta(self, idx: int, state: _StepState, delta: str, source: str) -> bool:\n4608|        def delivered() -> None:\n4609|            state.delivered_len += len(delta)\n4610|            state.delivered_sha.update(delta.encode(\"utf-8\"))\n4611|\n4612|        ok = self.emit(idx, delta, delivered)\n4613|        if not ok:\n4614|            self.dead = True\n4615|            return False\n4616|        self.emitted += 1\n4617|        self._note_activity()\n4618|        _log(f\"{source}-emit cid={self._cid8()} step={idx} len={len(delta)}\")\n4619|        return True\n4620|\n4621|    def _diverge(\n4622|        self, idx: int, state: _StepState, source: str, len_prev: int, len_new: int\n4623|    ) -> None:\n4624|        \"\"\"Непрефиксное изменение: выдача шага замораживается на отданном префиксе.\"\"\"\n4625|        state.diverged = True\n4626|        self.failed = True\n4627|        _count_divergence()\n4628|        if self.mode == \"LIVE\":\n4629|            _compat_demote()\n4630|        _log(\n4631|            f\"sqlite_{source}_divergence cid={self._cid8()} step={idx} len_prev={len_prev} len_new={len_new}\"\n4632|        )\n4633|        self._sqlite_off(\"divergence\")\n4634|\n4635|    def _apply_snapshot(self, idx: int, state: _StepState, text: str) -> None:\n4636|        \"\"\"SQLite-снимок 20.3: выдать приращение, только если это префиксное продолжение.\"\"\"\n4637|        if self.mode != \"LIVE\" or state.diverged or not text:\n4638|            return\n4639|        sent = state.delivered_len\n4640|        if sent == 0:\n4641|            _ = self._emit_delta(idx, state, text, \"sqlite\")\n4642|        elif len(text) < sent:\n4643|            return  # устаревший снимок\n4644|        elif _sha(text[:sent]) != state.delivered_sha.hexdigest():\n4645|            self._diverge(idx, state, \"snapshot\", sent, len(text))\n4646|        elif len(text) > sent:\n4647|            _ = self._emit_delta(idx, state, text[sent:], \"sqlite\")\n4648|\n4649|    def _apply_final(self, idx: int, final_text: str) -> None:\n4650|        \"\"\"Финал шага из транскрипта: докинуть хвост или заморозить при расхождении.\"\"\"\n4651|        state = self._state(idx)\n4652|        if state.finalized:\n4653|            return\n4654|        state.final_len = len(final_text)\n4655|        state.final_sha = _sha(final_text) if final_text else \"\"\n4656|        sent = state.delivered_len\n4657|        if state.diverged:\n4658|            pass\n4659|        elif sent == 0:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
