ning_bytes\\\",0),(\\\"_cap_logged\\\",False),(\\\"_tail\\\",SimpleNamespace(cid=\\\"c1\\\")),(\\\"_arbiter\\\",srv._ContentArbiter(\\\"turn-b\\\")),(\\\"turn_id\\\",\\\"turn-b\\\"),(\\\"run_cid\\\",\\\"c1\\\"),(\\\"_last_step_index\\\",None),(\\\"_content_emitted_wire\\\",\\\"\\\")]:\\n    setattr(run,k,v)\\nrun.offer_content(\\\"transcript\\\",1,\\\"Step1.\\\")\\nrun.offer_content(\\\"transcript\\\",2,\\\"Step2.\\\")\\nwire=run._content_emitted_wire\\nd1=run.reconcile_result(wire+\\\" EXTRA\\\"); d2=run.reconcile_result(wire+\\\" EXTRA\\\")\\nprint(\\\"B wire:\\\",repr(wire),\\\"d1:\\\",repr(d1),\\\"d2(second call):\\\",repr(d2),\\\"wire_after:\\\",repr(run._content_emitted_wire))\\n\\n# Probe C: None step_index separation in offer_content\\nrun2 = object.__new__(srv.Run)\\nfor k,v in [(\\\"_emit_lock\\\",threading.Lock()),(\\\"q\\\",queue.Queue()),(\\\"drain_closed\\\",False),(\\\"_done_put\\\",False),(\\\"_reasoning_bytes\\\",0),(\\\"_cap_logged\\\",False),(\\\"_tail\\\",SimpleNamespace(cid=\\\"c1\\\")),(\\\"_arbiter\\\",srv._ContentArbiter(\\\"turn-c\\\")),(\\\"turn_id\\\",\\\"turn-c\\\"),(\\\"run_cid\\\",\\\"c1\\\"),(\\\"_last_step_index\\\",None),(\\\"_content_emitted_wire\\\",\\\"\\\")]:\\n    setattr(run2,k,v)\\nrun2.offer_content(\\\"stdout\\\",None,\\\"First sentence.\\\")\\nrun2.offer_content(\\\"stdout\\\",None,\\\"Second independent text.\\\")\\nprint(\\\"C wire (None idx):\\\", repr(run2._content_emitted_wire))\\nPYEOF\\n/Users/aazhiry1/work/src/cli-agent-bridge/.venv/bin/python /tmp/probe_visioner.py 2>&1 | tail -10\",\n  \"description\": \"Probe preamble dedup and reconcile edges\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"A reasoning events: [('reasoning', 0, 'Preamble A\\\\n\\\\n'), ('reasoning', 5, 'Step5 v1\\\\n\\\\n')]\\nB wire: 'Step1.\\\\n\\\\nStep2.' d1: ' EXTRA' d2(second call): ' EXTRA' wire_after: 'Step1.\\\\n\\\\nStep2.'\\nC wire (None idx): 'First sentence.Second independent text.'\\n\",\n  \"original_output_bytes\": 249,\n  \"original_output_tokens\": 63,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
