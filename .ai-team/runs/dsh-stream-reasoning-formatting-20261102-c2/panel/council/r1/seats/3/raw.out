{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c459","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":135,"recorded_at":1780531400000265,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c6510457221bb6f3a71a1422e65","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_formatting_and_subagents.py`.\n1|\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n2|\n3|Проверяет:\n4|1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n5|2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n6|3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n7|4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n8|\"\"\"\n9|\n10|from __future__ import annotations\n11|\n12|import importlib.util\n13|import json\n14|import os\n15|from pathlib import Path\n16|import queue\n17|import re\n18|import sys\n19|import threading\n20|import unittest\n21|from types import SimpleNamespace\n22|from typing import Any, cast\n23|\n24|_REPO_ROOT = Path(__file__).resolve().parents[1]\n25|if str(_REPO_ROOT) not in sys.path:\n26|    sys.path.insert(0, str(_REPO_ROOT))\n27|\n28|_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n29|\n30|\n31|def _load_bridge() -> Any:\n32|    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n33|    spec = importlib.util.spec_from_file_location(\n34|        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n35|    )\n36|    assert spec is not None and spec.loader is not None\n37|    module = importlib.util.module_from_spec(spec)\n38|    sys.modules[spec.name] = module\n39|    spec.loader.exec_module(module)\n40|    return module\n41|\n42|\n43|srv = _load_bridge()\n44|\n45|\n46|class SyntheticE2EAgentStreamTests(unittest.TestCase):\n47|    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n48|\n49|    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n50|        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n51|        run = object.__new__(srv.Run)\n52|        setattr(run, \"_emit_lock\", threading.Lock())\n53|        setattr(run, \"q\", queue.Queue())\n54|        setattr(run, \"drain_closed\", False)\n55|        setattr(run, \"_done_put\", False)\n56|        setattr(run, \"_reasoning_bytes\", 0)\n57|        setattr(run, \"_cap_logged\", False)\n58|        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n59|        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n60|        setattr(run, \"turn_id\", \"turn-e2e-1\")\n61|        setattr(run, \"run_cid\", \"cid-test-e2e\")\n62|        setattr(run, \"_last_step_index\", None)\n63|        setattr(run, \"_content_emitted_wire\", \"\")\n64|\n65|        # Эмулируем шаги из скриншота пользователя:\n66|        # Шаг 1: \"Ищу в базе знаний и git посл\"\n67|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n68|        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n69|        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n70|        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n71|        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n72|        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n73|        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n74|\n75|        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n76|        emitted_chunks: list[str] = []\n77|        while not q.empty():\n78|            item = q.get_nowait()\n79|            if item[0] == \"text\":\n80|                emitted_chunks.append(str(item[1]))\n81|\n82|        full_stream = \"\".join(emitted_chunks)\n83|\n84|        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n85|        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n86|        self.assertIsNone(\n87|            glued_pattern.search(full_stream),\n88|            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n89|        )\n90|\n91|        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n92|        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n93|        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n94|\n95|    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n96|        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n97|        arb = srv._ContentArbiter(\"turn-orch-1\")\n98|\n99|        # Агент меняет статусы оркестрации на протяжении 5 шагов\n100|        statuses = [\n101|            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n102|            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n103|            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n104|            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n105|            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n106|        ]\n107|\n108|        emitted_deltas: list[str] = []\n109|        for idx, status in enumerate(statuses, 1):\n110|            # Эмулируем приход короткого префикса, затем полного текста\n111|            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n112|            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n113|            if d1:\n114|                emitted_deltas.append(d1)\n115|            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n116|            if d2:\n117|                emitted_deltas.append(d2)\n118|\n119|        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n120|        self.assertEqual(arb.divergences, 0)\n121|\n122|        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n123|        full_text = \"\".join(emitted_deltas)\n124|        count = full_text.count(\"[гейт оркестрации: активен\")\n125|        self.assertEqual(\n126|            count,\n127|            len(statuses),\n128|            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n129|        )\n130|\n131|    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n132|        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n133|        emitted_events: list[tuple[str, str]] = []\n134|\n135|        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n136|            emitted_events.append((\"reasoning\", delta))\n137|            if on_del is not None:\n138|                on_del()\n139|            return True\n140|\n141|        def emit_content(idx: int | None, text: str) -> bool:\n142|            emitted_events.append((\"content\", text))\n143|            return True\n144|\n145|        plan = srv._TurnPlan()\n146|        plan.mode = \"OFF\"\n147|        plan.base_idx = 0\n148|        plan.offset = 0\n149|\n150|        tail = srv._TranscriptTail(\n151|            emit=emit_reasoning,\n152|            stop_event=threading.Event(),\n153|            done_event=threading.Event(),\n154|            resumed=False,\n155|            plan=plan,\n156|            turn_id=\"turn-subagent-1\",\n157|            emit_content=emit_content,\n158|            on_activity=None,\n159|            usage_enabled=False,\n160|            isolate_tool_preambles=True,\n161|        )\n162|\n163|        # Эмулируем транскрипт мультиагентного цикла:\n164|        # Шаг 1: Оркестратор запускает сабагента Coder\n165|        record_step1 = {\n166|            \"type\": \"PLANNER_RESPONSE\",\n167|            \"step_index\": 1,\n168|            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n169|            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n170|            \"tool_calls\": [\n171|                {\n172|                    \"name\": \"invoke_subagent\",\n173|                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n174|                }\n175|            ],\n176|        }\n177|        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n178|\n179|        # Шаг 2: Финальный ответ после завершения сабагента\n180|        record_step2 = {\n181|            \"type\": \"PLANNER_RESPONSE\",\n182|            \"step_index\": 2,\n183|            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n184|            \"thinking\": \"Формирую итоговый статус для владельца.\",\n185|        }\n186|        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n187|\n188|        # Проверяем распределение:\n189|        # 1. Преамбула шага 1 ушла в reasoning\n190|        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n191|        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n192|\n193|        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n194|        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n195|        self.assertEqual(len(content_pieces), 1)\n196|        self.assertEqual(\n197|            content_pieces[0],\n198|            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n199|        )\n200|\n201|    def test_e2e_reconcile_wire_sync_and_preamble_dedup(self) -> None:\n202|        \"\"\"Сквозная проверка: дедупликация преамбул в reasoning и синхронизация reconcile с wire.\"\"\"\n203|        # 1. Проверка дедупликации преамбулы при повторной записи шага\n204|        emitted_events: list[tuple[str, str]] = []\n205|\n206|        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n207|            emitted_events.append((\"reasoning\", delta))\n208|            return True\n209|\n210|        plan = srv._TurnPlan()\n211|        plan.mode = \"OFF\"\n212|        tail = srv._TranscriptTail(\n213|            emit=emit_reasoning,\n214|            stop_event=threading.Event(),\n215|            done_event=threading.Event(),\n216|            resumed=False,\n217|            plan=plan,\n218|            turn_id=\"turn-dedup-1\",\n219|            emit_content=lambda idx, t: True,\n220|            isolate_tool_preambles=True,\n221|        )\n222|\n223|        rec = {\n224|            \"type\": \"PLANNER_RESPONSE\",\n225|            \"step_index\": 10,\n226|            \"content\": \"Запуск анализа...\",\n227|            \"tool_calls\": [{\"name\": \"read_file\", \"args\": {}}],\n228|        }\n229|        raw_bytes = json.dumps(rec).encode(\"utf-8\")\n230|        tail._emit_record(raw_bytes)\n231|        # Повторная доставка того же шага (например при rewrite)\n232|        tail._emit_record(raw_bytes)\n233|\n234|        preambles = [t for k, t in emitted_events if \"Запуск анализа...\" in t]\n235|        self.assertEqual(\n236|            len(preambles),\n237|            1,\n238|            f\"Преамбула эмитирована {len(preambles)} раз вместо 1: {preambles}\",\n239|        )\n240|\n241|        # 2. Проверка отсутствия ложной дивергенции в Run.reconcile_result\n242|        run = object.__new__(srv.Run)\n243|        setattr(run, \"_emit_lock\", threading.Lock())\n244|        setattr(run, \"q\", queue.Queue())\n245|        setattr(run, \"drain_closed\", False)\n246|        setattr(run, \"_done_put\", False)\n247|        setattr(run, \"_reasoning_bytes\", 0)\n248|        setattr(run, \"_cap_logged\", False)\n249|        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-sync-1\"))\n250|        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-sync-1\"))\n251|        setattr(run, \"turn_id\", \"turn-sync-1\")\n252|        setattr(run, \"run_cid\", \"cid-sync-1\")\n253|        setattr(run, \"_last_step_index\", None)\n254|        setattr(run, \"_content_emitted_wire\", \"\")\n255|\n256|        run.offer_content(\"transcript\", 1, \"Шаг 1 завершён.\")\n257|        run.offer_content(\"transcript\", 2, \"Шаг 2 завершён.\")\n258|\n259|        # Wire содержит разделитель \\n\\n\n260|        wire_text = getattr(run, \"_content_emitted_wire\")\n261|        self.assertEqual(wire_text, \"Шаг 1 завершён.\\n\\nШаг 2 завершён.\")\n262|\n263|        # reconcile_result с тем же текстом не должен давать дивергенции\n264|        delta = run.reconcile_result(wire_text)\n265|        self.assertEqual(delta, \"\")\n266|        self.assertFalse(\n267|            getattr(run._arbiter, \"last_result_diverged\", False),\n268|            \"Ложное срабатывание дивергенции при точном совпадении wire_text\",\n269|        )\n270|\n271|        # reconcile_result с дополнительным хвостом\n272|        delta_extra = run.reconcile_result(wire_text + \" Дополнительный итог.\")\n273|        self.assertEqual(delta_extra, \" Дополнительный итог.\")\n274|        self.assertFalse(\n275|            getattr(run._arbiter, \"last_result_diverged\", False),\n276|            \"Ложное срабатывание дивергенции при суффиксе wire_text\",\n277|        )\n278|\n279|\n280|if __name__ == \"__main__\":\n281|    unittest.main()","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45b","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":136,"recorded_at":1780531400000267,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c65130877c892696022f3ebe6f3","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/scripts/smoke_models.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n3|\n4|Позволяет автоматически проверять доступность и работоспособность моделей из\n5|канонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n6|\n7|Использование:\n8|    python3 scripts/smoke_models.py --dry-run\n9|    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n10|    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n11|\"\"\"\n12|\n13|from __future__ import annotations\n14|\n15|import argparse\n16|import json\n17|import os\n18|from pathlib import Path\n19|import re\n20|import sys\n21|import time\n22|import urllib.error\n23|import urllib.request\n24|from typing import Any, NamedTuple\n25|\n26|\n27|DEFAULT_MODELS_MD = Path(\n28|    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n29|).expanduser()\n30|DEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n31|\n32|\n33|class ModelEntry(NamedTuple):\n34|    role: str\n35|    model_id: str\n36|    effort: str\n37|    family: str\n38|\n39|\n40|def parse_models_md(path: Path) -> list[ModelEntry]:\n41|    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n42|    if not path.is_file():\n43|        raise FileNotFoundError(f\"Канонический файл models.md не найден: {path}\")\n44|\n45|    content = path.read_text(encoding=\"utf-8\")\n46|    entries: list[ModelEntry] = []\n47|    current_role = \"General\"\n48|\n49|    # Регулярное выражение для строк вида:\n50|    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n51|    row_pattern = re.compile(\n52|        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n53|    )\n54|\n55|    for line in content.splitlines():\n56|        line = line.strip()\n57|        if line.startswith(\"### \"):\n58|            header = line[4:].strip()\n59|            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n60|            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n61|            continue\n62|\n63|        match = row_pattern.match(line)\n64|        if match:\n65|            model_id = match.group(1).strip()\n66|            effort = match.group(2).strip()\n67|            family = match.group(3).strip()\n68|            # Пропускаем заголовки таблиц\n69|            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n70|                continue\n71|            entries.append(ModelEntry(current_role, model_id, effort, family))\n72|\n73|    # Дедупликация по паре (role, model_id)\n74|    seen = set()\n75|    unique_entries = []\n76|    for e in entries:\n77|        key = (e.role, e.model_id)\n78|        if key not in seen:\n79|            seen.add(key)\n80|            unique_entries.append(e)\n81|\n82|    return unique_entries\n83|\n84|\n85|def mask_secret(text: str) -> str:\n86|    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n87|    return re.sub(\n88|        r\"(Bearer\\s+|api[_-]?key[:=]\\s*)[a-zA-Z0-9_\\-\\.]{8,}\",\n89|        r\"\\1[MASKED]\",\n90|        text,\n91|        flags=re.IGNORECASE,\n92|    )\n93|\n94|\n95|def smoke_test_model(\n96|    hub_url: str,\n97|    model_id: str,\n98|    timeout_s: float = 20.0,\n99|    api_key: str | None = None,\n100|) -> tuple[bool, str, float]:\n101|    \"\"\"Выполнить смоук-запрос к модели через OpenAI-совместимый SSE-стрим с замером TTFT.\"\"\"\n102|    key = api_key or os.environ.get(\"BRIDGE_KEY\") or os.environ.get(\"HUB_API_KEY\")\n103|    if not key:\n104|        dsh_env = Path.home() / \".dsh\" / \".env\"\n105|        if dsh_env.is_file():\n106|            try:\n107|                for line in dsh_env.read_text(encoding=\"utf-8\").splitlines():\n108|                    if line.startswith(\"BRIDGE_KEY=\"):\n109|                        key = line.split(\"=\", 1)[1].strip()\n110|                        break\n111|            except OSError:\n112|                pass\n113|    if not key:\n114|        key = os.environ.get(\"OPENAI_API_KEY\") or \"test-smoke-key\"\n115|\n116|    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n117|    payload = {\n118|        \"model\": model_id,\n119|        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n120|        \"max_tokens\": 15,\n121|        \"stream\": True,\n122|    }\n123|    data_bytes = json.dumps(payload).encode(\"utf-8\")\n124|    req = urllib.request.Request(\n125|        endpoint,\n126|        data=data_bytes,\n127|        method=\"POST\",\n128|    )\n129|    req.add_header(\"Content-Type\", \"application/json\")\n130|    req.add_header(\"Authorization\", f\"Bearer {key}\")\n131|\n132|    t0 = time.monotonic()\n133|    ttft: float | None = None\n134|    got_done = False\n135|    try:\n136|        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n137|            status_code = resp.getcode()\n138|            if status_code != 200:\n139|                return False, f\"HTTP {status_code}\", time.monotonic() - t0\n140|            for raw_line in resp:\n141|                line = raw_line.decode(\"utf-8\", \"replace\").strip()\n142|                if not line or not line.startswith(\"data:\"):\n143|                    continue\n144|                data_str = line[5:].strip()\n145|                if data_str == \"[DONE]\":\n146|                    got_done = True\n147|                    break\n148|                try:\n149|                    chunk = json.loads(data_str)\n150|                    choices = chunk.get(\"choices\") or []\n151|                    if choices:\n152|                        delta = choices[0].get(\"delta\") or {}\n153|                        if (\n154|                            delta.get(\"content\")\n155|                            or delta.get(\"reasoning_content\")\n156|                            or delta.get(\"thinking\")\n157|                        ):\n158|                            if ttft is None:\n159|                                ttft = time.monotonic() - t0\n160|                except ValueError:\n161|                    pass\n162|            elapsed = time.monotonic() - t0\n163|            display_time = ttft if ttft is not None else elapsed\n164|            if ttft is not None:\n165|                return True, \"STREAM_OK\", display_time\n166|            if got_done:\n167|                return True, \"DONE_OK\", elapsed\n168|            return False, \"No stream chunks\", elapsed\n169|    except urllib.error.HTTPError as e:\n170|        elapsed = time.monotonic() - t0\n171|        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n172|        return False, err_msg, elapsed\n173|    except Exception as e:\n174|        elapsed = time.monotonic() - t0\n175|        return False, mask_secret(f\"Error: {e}\"), elapsed\n176|\n177|\n178|def main() -> int:\n179|    parser = argparse.ArgumentParser(\n180|        description=\"Smoke test runner for models defined in models.md\"\n181|    )\n182|    parser.add_argument(\n183|        \"--models-md\",\n184|        type=Path,\n185|        default=DEFAULT_MODELS_MD,\n186|        help=\"Path to Context/models.md\",\n187|    )\n188|    parser.add_argument(\n189|        \"--hub-url\",\n190|        type=str,\n191|        default=DEFAULT_HUB_URL,\n192|        help=\"URL of the bridge hub endpoint\",\n193|    )\n194|    parser.add_argument(\n195|        \"--model\",\n196|        type=str,\n197|        default=\"\",\n198|        help=\"Filter by specific model ID\",\n199|    )\n200|    parser.add_argument(\n201|        \"--dry-run\",\n202|        action=\"store_true\",\n203|        help=\"Validate configuration and parse models without sending network requests\",\n204|    )\n205|    parser.add_argument(\n206|        \"--live\",\n207|        action=\"store_true\",\n208|        help=\"Execute live HTTP smoke requests against the hub\",\n209|    )\n210|    parser.add_argument(\n211|        \"--timeout\",\n212|        type=float,\n213|        default=15.0,\n214|        help=\"Request timeout in seconds\",\n215|    )\n216|\n217|    args = parser.parse_args()\n218|\n219|    models = parse_models_md(args.models_md)\n220|    if args.model:\n221|        models = [m for m in models if m.model_id == args.model]\n222|\n223|    if not models:\n224|        print(\"FAIL: No models found matching criteria.\")\n225|        return 1\n226|\n227|    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n228|    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n229|    print(\"-\" * 88)\n230|\n231|    all_ok = True\n232|    for entry in models:\n233|        if args.dry_run or not args.live:\n234|            status = \"CONFIGURED\"\n235|            latency_str = \"-\"\n236|        else:\n237|            ok, status, lat = smoke_test_model(\n238|                args.hub_url, entry.model_id, timeout_s=args.timeout\n239|            )\n240|            latency_str = f\"{lat:.2f}s\"\n241|            if not ok:\n242|                all_ok = False\n243|\n244|        print(\n245|            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n246|        )\n247|\n248|    if args.dry_run:\n249|        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n250|        return 0\n251|\n252|    if not args.live:\n253|        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n254|        return 0\n255|\n256|    return 0 if all_ok else 1\n257|\n258|\n259|if __name__ == \"__main__\":\n260|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45d","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":137,"recorded_at":1780531400000269,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c6515cc755e8fcd35d5b56493a6","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md`.\n1|# AGENTS.md — cli-agent-bridge\n2|\n3|Проектные правила для агентов. Общие правила владельца — канон `~/Мой диск/Context/AGENTS.md` (здесь не дублируются).\n4|\n5|## ⭐ Главный архитектурный принцип: универсальность и независимость от вендоров\n6|\n7|1. **Максимальная универсальность:** все доработки делаются максимально универсальными, чтобы не зависеть от вендоров и сторонних сред исполнения.\n8|2. **Запрет на правку вендорского исходного кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи в исходный код и бинарные сборки внешних вендорских приложений и сред (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену исполняемых модулей. **Правка пользовательских конфигураций и профилей РАЗРЕШЕНА:** редактирование пользовательских настроек, профилей интеграции и переменных окружения (например, `~/.dsh/profiles/*/cordis.patch.yml`, `~/.dsh/.env`, `~/.dsh/.credentials.yaml`) является штатным методом настройки и полностью разрешено.\n9|3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\n10|4. **Запрет на хардкод параметров (полная конфигурируемость):** категорически запрещено зашивать в коде константами любые эксплуатационные параметры — таймауты, интервалы опроса, пороги активности, лимиты шагов и размеры буферов памяти (текста ответа, reasoning и т.д.). Любые такие параметры просто переносим в настройки: они должны быть полностью настраиваемыми через переменные окружения и конфигурационные файлы с безопасными значениями по умолчанию в качестве fallback.\n11|5. **Системное, агент-агностическое решение по умолчанию:** все архитектурные задачи, расхождения форматов сообщений, санитизация вызовов инструментов (tool calls), дефекты стриминга, управление сессиями, восстановление контекста и протокольные краевые случаи решаются **на системном (агент-агностик) уровне шлюза** — в универсальном ядре (`core/`) и общих механизмах эмуляции API, а не на уровне конкретного агента. Решение должно опираться на семантику протокола и контракт шлюза, а не на имя подключаемого агента.\n12|   - **Запрещено переносить общую логику на уровень конкретного агента:** если проблему можно решить агент-агностически, категорически недопустимы отдельные заплатки, хаки, ветвления по имени агента и дублирование исправлений для Droid, Muse, Codex, Claude Code и других подключаемых CLI-бэкендов. Системное исправление реализуется один раз в модулях ядра (`core/`) и работает единообразно для всех интеграций.\n13|   - **Адаптеры агентов — только тонкие трансляторы транспорта:** их ответственность ограничивается управлением жизненным циклом CLI-процесса, подключением к транспорту и двусторонней трансляцией специфичного CLI-ввода/вывода в единый внутренний контракт шлюза. Общая нормализация, санитизация, управление контекстом, восстановление после сбоев и протокольная эмуляция не должны оседать в адаптерах в виде ad-hoc логики.\n14|   - **Специфичная логика допускается только как доказанное исключение:** прежде чем добавлять частную обработку в адаптер, необходимо доказать невозможность системного решения в общем слое и зафиксировать непреодолимое ограничение внешнего CLI-транспорта. Такая логика должна быть строго изолирована внутри адаптера и не нарушать инварианты универсального ядра.\n15|\n16|## О проекте cli-agent-bridge\n17|\n18|Универсальный шлюз (мост/фасад), объединяющий CLI-агентов и LLM различных провайдеров в единый OpenAI-совместимый эндпоинт (`POST /v1/chat/completions`, `GET /v1/models`, SSE-стриминг, `tools`/`tool_calls`).\n19|\n20|### Архитектурные слои\n21|- `server.py` — единый HTTP-фасад (OpenAI-compatible API, маршрутизация запросов, управление подключениями).\n22|- `core/` — универсальное ядро:\n23|  - `core/tool_emulation.py` — протокол и эмуляция function calling, парсинг и санитизация `<tool_call>`.\n24|  - `core/backend_adapter.py` — базовые абстракции и контракты адаптеров бэкендов.\n25|  - `core/turn_session_manager.py` — управление сессиями, контекстом и процессами.\n26|  - `core/context_resilience.py` — устойчивость к переполнению контекста и сжатие.\n27|- `adapters/` — адаптеры к конкретным CLI-транспортам и средам (Droid, Muse, Codex и др.).\n28|- `bridges/` — специализированные мосты (`agy-bridge`, `muse-bridge`, `opencode-zen-bridge`).\n29|\n30|## Верификация и тесты\n31|\n32|Перед фиксацией любых изменений запускать набор тестов:\n33|```bash\n34|pytest tests/ -v\n35|```\n36|Код должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.\n37|\n38|## Регламент комплексного тестирования мостов и стриминга (L1 / L2 / L3)\n39|\n40|Каждая доработка мостов обязана сопровождаться трехуровневым контролем качества:\n41|\n42|1. **Уровень L1 (Детерминированные Unit-тесты):**\n43|   - Все изменения логики дедупликации (`_ContentArbiter`), сканирования префиксов (`_scan`) и разбора рантайм-флагов (`_parse_runtime_flags`) покрываются тестами в `tests/test_agy_bridge_resilience.py`.\n44|   - Запрещено сдавать код, если хотя бы один тест арбитража или graceful-таймаута завершается с ошибкой.\n45|   - Инвариант `_scan`: входящий фрагмент другого шага сопоставляется со старым шагом ТОЛЬКО при условии `text == candidate` или `text.startswith(candidate)`. Короткий префикс нового шага с валидным индексом (`idx is not None`) никогда не должен становиться алиасом длинного старого шага.\n46|\n47|2. **Уровень L2 (Сквозные синтетические E2E-тесты и валидация протокола SSE):**\n48|   - Набор `tests/test_stream_formatting_and_subagents.py` обязателен к прогону перед любым мержем.\n49|   - **Инвариант разграничения строк Markdown:** любые последовательные шаги в потоке `content` обязаны разделяться переводом строки `\\n\\n`. Склейка слов на границах шагов (паттерн `[а-яёa-z]\\.[А-ЯЁA-Z]`) категорически запрещена.\n50|   - **Инвариант защиты от циклов префиксов:** многократная смена статусов агента и скиллов оркестрации (`[гейт оркестрации: активен...`) не должна вызывать лавину повторов префикса и `content-divergence`.\n51|   - **Инвариант изоляции блока мышления (<Think>):** при наличии вызовов инструментов (`tool_calls`) сервисные преамбулы шагов направляются в `choices[0].delta.reasoning_content`. В `choices[0].delta.content` разрешается отдавать только финальный ответ пользователю (шаг без инструментов) либо результат реконсиляции, предотвращая досрочное закрытие аккордеона мышления в UI DeepSeek Harness.\n52|   - **Мультиагентный цикл:** обязательна эмуляция сессий с порождением сабагентов (`invoke_subagent` / `launch_seat.py`) с контролем непрерывности стрима родительского агента.\n53|   - **Инвариант скользящего окна активности (Sliding Activity Window):** любой стрим и адаптер обязан сбрасывать таймер неактивности при получении каждого полезного чанка (`content`, `reasoning_content`, `tool_calls`) и сдвигать дедлайн вперёд (`deadline = now + idle_timeout_s`). Категорически запрещено обрывать активный поток по статическому настенному таймеру при наличии входящих данных; аварийный `safety_cap_s` допустим только как предохранитель от бесконечного зацикливания.\n54|\n55|3. **Уровень L3 (Универсальный смоук-раннер моделей):**\n56|   - Для валидации готовности моделей и транспортов из `~/Мой диск/Context/models.md` используется скрипт `scripts/smoke_models.py`.\n57|   - Проверка конфигурации: `python3 scripts/smoke_models.py --dry-run`.\n58|   - Сквозной смоук-тест реальных бэкендов: `python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1`.\n59|   - Санитизация: все токены и секреты в смоук-логах и отчётах обязательно маскируются.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
