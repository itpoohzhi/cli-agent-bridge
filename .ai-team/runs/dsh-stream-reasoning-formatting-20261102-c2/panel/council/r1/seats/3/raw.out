{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c659f007239a2194069ec2870f6","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(2944 line(s) above)\n2945|\n2946|\n2947|class _RuntimeFlags(NamedTuple):\n2948|    \"\"\"Неизменяемый валидированный снимок флагов новой политики.\"\"\"\n2949|\n2950|    planner_content_streaming_enabled: bool = False\n2951|    emit_tool_trace: bool = False\n2952|    extended_timeout_enabled: bool = False\n2953|    graceful_timeout_on_partial: bool = False\n2954|    step_scoped_usage_enabled: bool = False\n2955|    stream_resilience_enabled: bool = True\n2956|    isolate_tool_preambles_to_reasoning: bool = True\n2957|    graceful_timeout_finish_reason: str = \"stop\"\n2958|\n2959|\n2960|_NEW_FLAG_ENV = {\n2961|    \"planner_content_streaming_enabled\": \"AGY_PLANNER_CONTENT_STREAMING_ENABLED\",\n2962|    \"emit_tool_trace\": \"AGY_BRIDGE_EMIT_TOOL_TRACE\",\n2963|    \"extended_timeout_enabled\": \"AGY_EXTENDED_TIMEOUT_ENABLED\",\n2964|    \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n2965|    \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n2966|    \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n2967|    \"isolate_tool_preambles_to_reasoning\": \"AGY_ISOLATE_TOOL_PREAMBLES_TO_REASONING\",\n2968|}\n2969|_ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n2970|_ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n2971|_COLD_FLAGS = _RuntimeFlags()\n2972|_cfg_lock = threading.Lock()\n2973|_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS\n2974|_cfg_key: tuple[int, int] | None = None\n2975|_cfg_checked_at: float | None = None\n2976|_cfg_generation: int = 0\n2977|\n2978|\n2979|def _parse_runtime_flags(text: str) -> _RuntimeFlags:\n2980|    \"\"\"Разобрать флаги; нестроковый finish_reason заменяется дефолтом 'stop'.\n2981|\n2982|    ValueError для не-bool флагов отвергает файл целиком.\n2983|    \"\"\"\n2984|    data = cast(object, json.loads(text))\n2985|    if not isinstance(data, dict):\n2986|        raise ValueError(\"dynamic_config: not an object\")\n2987|    raw = cast(\"dict[str, object]\", data)\n2988|    values: dict[str, bool] = {}\n2989|    finish_reason = _COLD_FLAGS.graceful_timeout_finish_reason\n2990|    for name in _RuntimeFlags._fields:\n2991|        default = getattr(_COLD_FLAGS, name)\n2992|        if name == \"stream_resilience_enabled\":\n2993|            default = raw.get(_NEW_FLAG_ENV[name], default)\n2994|        if name == \"graceful_timeout_finish_reason\":\n2995|            raw_val = raw.get(\"graceful_timeout_finish_reason\")\n2996|            if raw_val is None:\n2997|                raw_val = raw.get(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", default)\n2998|            if isinstance(raw_val, str):\n2999|                s = raw_val.strip().lower()\n3000|                if s in (\"length\", \"max_tokens\"):\n3001|                    finish_reason = \"length\"\n3002|                elif s == \"stop\":\n3003|                    finish_reason = \"stop\"\n3004|                else:\n3005|                    finish_reason = \"stop\"\n3006|            else:\n3007|                finish_reason = \"stop\"\n3008|            continue\n3009|        value = raw.get(name, default)\n3010|        if not isinstance(value, bool):\n3011|            raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n3012|        values[name] = value\n3013|    return _RuntimeFlags(**values, graceful_timeout_finish_reason=finish_reason)\n3014|\n3015|\n3016|def _runtime_snapshot() -> _RuntimeFlags:\n3017|    \"\"\"Снимок флагов из dynamic_config.json: TTL 1.0 с, ключ версии (mtime_ns, size).\n3018|\n3019|    Пока stat не изменился, JSON не разбирается (identity снимка сохраняется). Битый\n3020|    JSON или не-bool флаг отвергают файл целиком: действует last-known-good,\n3021|    на холодном старте — кодовые дефолты. Нестроковый finish_reason заменяется\n3022|    на 'stop'. При отсутствии файла используются кодовые дефолты.\n3023|    \"\"\"\n3024|    global _cfg_snapshot, _cfg_key, _cfg_checked_at, _cfg_generation\n3025|    now = time.monotonic()\n3026|    with _cfg_lock:\n3027|        if _cfg_checked_at is not None and now - _cfg_checked_at < FLAG_TTL_S:\n3028|            return _cfg_snapshot\n3029|        known_key = _cfg_key\n3030|        snapshot = _cfg_snapshot\n3031|        gen = _cfg_generation\n3032|    key = known_key\n3033|    try:\n3034|        info = DYNAMIC_CONFIG_PATH.stat()\n3035|    except FileNotFoundError:\n3036|        snapshot, key = _COLD_FLAGS, None\n3037|    except OSError:\n3038|        pass  # транзиентная ошибка: остаётся last-known-good\n3039|    else:\n3040|        new_key = (info.st_mtime_ns, info.st_size)\n3041|        if new_key != known_key:\n3042|            try:\n3043|                parsed = _parse_runtime_flags(\n3044|                    DYNAMIC_CONFIG_PATH.read_text(encoding=\"utf-8\")\n3045|                )\n3046|            except OSError:\n3047|                pass  # повторим на следующем TTL\n3048|            except ValueError:\n3049|                key = (\n3050|                    new_key  # битый файл: lastgood, без повторного разбора того же stat\n3051|                )\n3052|            else:\n3053|                snapshot, key = parsed, new_key\n3054|    with _cfg_lock:\n3055|        if _cfg_generation != gen:\n3056|            # Параллельный читатель уже записал более свежий снимок: не затираем его.\n3057|            return _cfg_snapshot\n3058|        _cfg_snapshot = snapshot\n3059|        _cfg_key = key\n3060|        _cfg_checked_at = time.monotonic()\n3061|        _cfg_generation = gen + 1\n3062|    return snapshot\n3063|\n3064|\n3065|def _new_flag(name: str, default: bool = False) -> bool:\n3066|    \"\"\"Явный env > JSON bool > кодовый default; старые флаги выключены.\"\"\"\n3067|    if name == \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\":\n3068|        name = \"stream_resilience_enabled\"\n3069|    env = os.environ.get(_NEW_FLAG_ENV[name], \"\").strip().lower()\n3070|    if env in _ENV_TRUE:\n3071|        return True\n3072|    if env in _ENV_FALSE:\n3073|        return False\n3074|    return bool(getattr(_runtime_snapshot(), name, default))\n3075|\n3076|\n3077|def _graceful_finish_reason() -> str:\n3078|    \"\"\"Возвращает finish_reason graceful-таймаута: 'stop' или 'length'.\n3079|\n3080|    Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\n3081|    graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\n3082|    Значение 'max_tokens' нормализуется в 'length'. Невалидный непустой env\n3083|    переопределяет конфиг и даёт 'stop'.\n3084|    \"\"\"\n3085|    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\")\n3086|    if raw_env is not None and raw_env.strip():\n3087|        s = raw_env.strip().lower()\n3088|        if s in (\"length\", \"max_tokens\"):\n3089|            return \"length\"\n3090|        return \"stop\"\n3091|    snap = _runtime_snapshot()\n3092|    val = snap.graceful_timeout_finish_reason.strip().lower()\n3093|    if val in (\"length\", \"max_tokens\"):\n3094|        return \"length\"\n3095|    return \"stop\"\n3096|\n3097|\n3098|AGY_BRIDGE_STREAM_RESILIENCE_ENABLED = _new_flag(\n3099|    \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True\n3100|)\n3101|\n3102|\n3103|def _positive_env(name: str) -> float | None:\n3104|    raw = os.environ.get(name, \"\").strip()\n3105|    if not raw:\n3106|        return None\n3107|    try:\n3108|        value = float(raw)\n3109|    except ValueError:\n3110|        return None\n3111|    if not value > 0.0 or value != value or value == float(\"inf\"):\n3112|        return None\n3113|    return value\n3114|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c65a27170188ba59b98a9216e69","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4155 line(s) above)\n4156|class _TranscriptTail:\n4157|    \"\"\"Источник мышления шагов agy: транскрипт разговора и SQLite `conversations/<cid>.db`.\n4158|\n4159|    Один daemon-поток на ход — единственный писатель состояния шагов (без замков).\n4160|    Транскрипт `<BRAIN_DIR>/<cid>/.system_generated/logs/transcript_full.jsonl`\n4161|    читается инкрементально по байтовому смещению: запись `PLANNER_RESPONSE`\n4162|    появляется после завершения шага. Параллельно, пока шаг ещё генерируется\n4163|    (`status=8`), подполе 20.3 его `step_payload` в SQLite растёт — оттуда мышление\n4164|    уходит клиенту дельтами. База открывается строго на чтение, на каждый опрос\n4165|    своё соединение, закрываемое в `finally`.\n4166|\n4167|    Режим хода `LIVE|SHADOW|OFF` фиксируется на старте: в SHADOW SQLite только\n4168|    наблюдается (canary совместимости agy), клиенту выдаёт транскрипт. Дедупликация\n4169|    по `idx == step_index` с проверкой префикса sha256: непрефиксный снимок\n4170|    замораживает выдачу шага на уже отданном префиксе.\n4171|\n4172|    Поток вспомогательный и не может влиять на ответ: нет каталога, нет файла,\n4173|    битая строка, ошибка SQLite — просто «мышления нет».\n4174|    \"\"\"\n4175|\n4176|    def __init__(\n4177|        self,\n4178|        emit: Callable[[int, str, Callable[[], None] | None], bool],\n4179|        stop_event: threading.Event,\n4180|        done_event: threading.Event,\n4181|        resumed: bool,\n4182|        plan: _TurnPlan | None = None,\n4183|        turn_id: str = \"\",\n4184|        emit_content: Callable[[int | None, str], bool] | None = None,\n4185|        on_activity: Callable[[], None] | None = None,\n4186|        usage_enabled: bool = False,\n4187|        isolate_tool_preambles: bool = False,\n4188|    ) -> None:\n4189|        self.emit = emit\n4190|        # PLANNER_RESPONSE.content -> арбитр (AD-001); None — прежнее поведение.\n4191|        self.emit_content = emit_content\n4192|        self.isolate_tool_preambles = isolate_tool_preambles\n4193|        # Реальный прогресс транскрипта/SQLite текущего хода -> producer activity (AD-003).\n4194|        self.on_activity = on_activity\n4195|        # Дедлайн потока: синхронизируется с effective_max_timeout_s политики (AD-003).\n4196|        self.deadline_s: float = TIMEOUT_S + 60.0\n4197|        self._in_rewrite: bool = False\n4198|        self.stop_event = stop_event\n4199|        self.done_event = done_event\n4200|        self.resumed = resumed\n4201|        self.plan: _TurnPlan = plan if plan is not None else _TurnPlan()\n4202|        self.turn_id: str = turn_id\n4203|        self.mode: str = self.plan.mode\n4204|        self.base_idx: int = self.plan.base_idx\n4205|        self.probe_gen: int | None = self.plan.probe_gen\n4206|        self.cid: str = \"\"\n4207|        self.seen: dict[int, _StepState] = {}\n4208|        self.poll_watermark: int = self.plan.base_idx\n4209|        self.sqlite_active: bool = self.plan.mode in (\"LIVE\", \"SHADOW\")\n4210|        self.bucket: _PollBucket = _PollBucket()\n4211|        self.selects_ok: int = 0\n4212|        self.failed: bool = False\n4213|        self.emitted: int = 0\n4214|        self.dead: bool = False\n4215|        self.end_marker: bool = False\n4216|        self.final_planner: bool = False\n4217|        self.drain_deadline: float = 0.0\n4218|        self.drain_outcome: str = \"\"\n4219|        self.last_poll: str = \"\"\n4220|        self._ready = threading.Event()\n4221|        self._offset: int = self.plan.offset\n4222|        self._buf: bytes = b\"\"\n4223|        self._transcript_ok: bool = True\n4224|        self._owned_cid: str = \"\"\n4225|        self._next_poll_at: float = 0.0\n4226|        self._preambles_emitted: set[int] = set()\n4227|        self._interrupted: bool = False\n4228|        self._active_conn: sqlite3.Connection | None = None\n4229|        self._conn_lock = threading.Lock()\n4230|        self._db_path: Path | None = None\n4231|        self._open_fail_logged: bool = False\n4232|        self._oversize_logged: set[int] = set()\n4233|        self._finished: bool = False\n4234|        # Закреплённый на попытку файл транскрипта (только при usage_enabled).\n4235|        self._path: Path | None = self.plan.transcript_path\n4236|        # Счётчики шагов хода: единственный писатель — поток tail; наружу — снимок.\n4237|        self.usage_enabled: bool = usage_enabled\n4238|        self.step_records_by_index: (\n4239|            dict[int, tuple[int, int | None, int] | None] | None\n4240|        ) = {} if usage_enabled else None\n4241|        self.last_valid_step_index: int | None = None\n4242|        self.last_step_usage: tuple[int, int, int | None, int] | None = None\n4243|        self.observed_planner_steps_saturated: bool = False\n4244|        self._usage_out_sum: int = 0\n4245|        self._usage_invalid: int = 0\n4246|        self._usage_dirty: bool = False\n4247|        self._usage_lock = threading.Lock()\n4248|        self._usage_snapshot: _UsageSnapshot = _EMPTY_USAGE_SNAPSHOT\n4249|        self.thread = threading.Thread(target=self._run, daemon=True)\n4250|\n4251|    # ---- жизненный цикл ----------------------------------------------------------\n4252|    def start(self) -> None:\n4253|        self.thread.start()\n4254|\n4255|    def _cid8(self) -> str:\n4256|        return self.cid[:8] or \"-\"\n4257|\n4258|    def bind(self, cid: str) -> None:\n4259|        \"\"\"Привязать источник к разговору из события `init` потока agy.\"\"\"\n4260|        if not cid or self.cid:\n4261|            return\n4262|        self.cid = cid\n4263|        if _CID_RE.fullmatch(cid) is None:\n4264|            self._transcript_ok = False\n4265|            self._sqlite_off(\"cid\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e5","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":205,"recorded_at":1780531400000405,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"call_id":"call_01a19c65a5a5721cac2f18f1e7c8a98f","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(5494 line(s) above)\n5495|                        )\n5496|                    )\n5497|                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n5498|                elif etype == \"step_update\":\n5499|                    step = (\n5500|                        ev.get(\"step_update\")\n5501|                        if isinstance(ev.get(\"step_update\"), dict)\n5502|                        else {}\n5503|                    )\n5504|                    kind = step.get(\"step_type\")\n5505|                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n5506|                        if self.content_streaming:\n5507|                            _ = self.offer_content(\n5508|                                \"stdout\",\n5509|                                _as_int(step.get(\"step_index\")),\n5510|                                str(step[\"text_delta\"]),\n5511|                            )\n5512|                        else:\n5513|                            suffix = _reasoning_suffix(\n5514|                                self._text_seen,\n5515|                                str(step.get(\"step_index\", \"\")),\n5516|                                str(step[\"text_delta\"]),\n5517|                            )\n5518|                            if suffix:\n5519|                                self.q.put((\"text\", suffix))\n5520|                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n5521|                        step_idx = _as_int(step.get(\"step_index\"))\n5522|                        trace: dict[str, object] = {\n5523|                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n5524|                            \"duration_s\": step.get(\"duration_seconds\"),\n5525|                            \"step_index\": step_idx,\n5526|                        }\n5527|                        if step_idx is None:\n5528|                            # Идентичность DONE без step_index: монотонный ordinal хода,\n5529|                            # назначается один раз и переживает повторную доставку события.\n5530|                            raw_id = (\n5531|                                step.get(\"call_id\")\n5532|                                or step.get(\"tool_call_id\")\n5533|                                or step.get(\"id\")\n5534|                            )\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
