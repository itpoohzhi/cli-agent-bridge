{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c555","stream":{"kind":"session","id":"01a19c64-67ee-7c02-be8b-a768a8dca388"},"sequence":261,"recorded_at":1780531400000517,"record_type":"event","durability":"durable","causation_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a","run_stream":{"kind":"run","id":"01a19c64-6d4f-7d93-bac3-647ea7fcc22a"},"task_stream":{"kind":"task","id":"01a19c66-233e-73d3-90af-cce1e6dcd6f7"},"task_id":"01a19c66-233e-73d3-90af-cce1e6dcd6f7","event":{"kind":"output","task_id":"01a19c66-233e-73d3-90af-cce1e6dcd6f7","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py`.\n(13605 line(s) above)\n13606|class StreamFormattingAndReasoningIsolationTests(unittest.TestCase):\n13607|    \"\"\"Детерминированные тесты L1 на разграничение строк, сопоставление префиксов и изоляцию reasoning.\"\"\"\n13608|\n13609|    def test_step_boundary_newline_separation(self) -> None:\n13610|        \"\"\"VER-001 / REQ-001: Текст независимых шагов планировщика разделяется \\\\n\\\\n без склеивания слов.\"\"\"\n13611|        run = _bare_run()\n13612|        setattr(run, \"_arbiter\", _arb())\n13613|        setattr(run, \"turn_id\", \"turn-fmt-1\")\n13614|        setattr(run, \"run_cid\", _CID)\n13615|        offer = _ofn(run, \"offer_content\")\n13616|\n13617|        # Шаг 1: завершается точкой без перевода строки\n13618|        self.assertTrue(offer(\"stdout\", 1, \"Завершаю поиск данных.\"))\n13619|        # Шаг 2: начинается со слова с заглавной буквы\n13620|        self.assertTrue(offer(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\"))\n13621|        # Шаг 3: завершается с переводом строки\n13622|        self.assertTrue(offer(\"stdout\", 3, \"Следующее действие.\\n\"))\n13623|        # Шаг 4: начинается без перевода строки\n13624|        self.assertTrue(offer(\"stdout\", 4, \"Финальный результат.\"))\n13625|\n13626|        q = cast(\"queue.Queue[tuple[str, object]]\", _oval(run, \"q\"))\n13627|        chunks = [cast(str, q.get_nowait()[1]) for _ in range(q.qsize())]\n13628|        combined = \"\".join(chunks)\n13629|\n13630|        # Проверяем, что нет слитного \"данных.Проверяю\"\n13631|        self.assertNotIn(\"данных.Проверяю\", combined)\n13632|        self.assertIn(\"Завершаю поиск данных.\\n\\nПроверяю вывод лога задачи 349.\", combined)\n13633|        self.assertIn(\"Следующее действие.\\n\\nФинальный результат.\", combined)\n13634|\n13635|    def test_arbiter_no_prefix_repetition_on_divergence(self) -> None:\n13636|        \"\"\"VER-002 / REQ-002: Короткие префиксы новых шагов не вызывают лавины повторов [гейт...\"\"\"\n13637|        arb = _arb()\n13638|        step1_text = \"[гейт оркестрации: активен | роль: explorer] Читаю канон AGENTS.md\"\n13639|        step2_prefix = \"[гейт оркестрации: активен\"\n13640|        step2_full = \"[гейт оркестрации: активен | роль: worker] Запускаю тесты pytest\"\n13641|\n13642|        # Шаг 1\n13643|        self.assertEqual(_offer(arb, \"transcript\", 1, step1_text), step1_text)\n13644|\n13645|        # Шаг 2 начинается с префикса, совпадающего с шагом 1\n13646|        delta_prefix = _offer(arb, \"transcript\", 2, step2_prefix)\n13647|        self.assertEqual(delta_prefix, step2_prefix)\n13648|        self.assertEqual(_oval(arb, \"divergences\"), 0)\n13649|\n13650|        # Шаг 2 досылает полный текст\n13651|        delta_full = _offer(arb, \"transcript\", 2, step2_full)\n13652|        self.assertEqual(delta_full, step2_full[len(step2_prefix):])\n13653|        self.assertEqual(_oval(arb, \"divergences\"), 0)\n13654|\n13655|        # Проверяем, что в chunks нет зацикленного повтора\n13656|        chunks = _oval(arb, \"chunks\")\n13657|        joined = \"\".join(chunks)\n13658|        self.assertEqual(joined.count(\"[гейт оркестрации: активен\"), 2)\n13659|\n13660|    def test_tool_preamble_isolated_to_reasoning(self) -> None:\n13661|        \"\"\"VER-003 / REQ-003: Сервисная преамбула шага с tool_calls изолируется в reasoning, сохраняя <Think>.\"\"\"\n13662|        with _Fixture() as fx:\n13663|            content_emitted: list[tuple[int | None, str]] = []\n13664|            reasoning_emitted: list[tuple[int, str]] = []\n13665|\n13666|            def emit_content(idx: int | None, text: str) -> bool:\n13667|                content_emitted.append((idx, text))\n13668|                return True\n13669|\n13670|            def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n13671|                reasoning_emitted.append((idx, delta))\n13672|                if on_del is not None:\n13673|                    on_del()\n13674|                return True\n13675|\n13676|            plan = _bfn(\"_TurnPlan\")()\n13677|            setattr(plan, \"mode\", \"OFF\")\n13678|            setattr(plan, \"base_idx\", 0)\n13679|            setattr(plan, \"offset\", 0)\n13680|\n13681|            tail = _bfn(\"_TranscriptTail\")(\n13682|                emit_reasoning,\n13683|                threading.Event(),\n13684|                threading.Event(),\n13685|                False,\n13686|                plan,\n13687|                \"turn-reasoning-1\",\n13688|                emit_content,\n13689|                None,\n13690|                False,\n13691|                True,  # isolate_tool_preambles=True\n13692|            )\n13693|            setattr(tail, \"cid\", _CID)\n13694|\n13695|            # Шаг 1: содержит tool_calls и преамбулу в content\n13696|            fx.append_record(\n13697|                {\n13698|                    \"type\": \"PLANNER_RESPONSE\",\n13699|                    \"step_index\": 1,\n13700|                    \"content\": \"Ищу скилл analyst-teamlead и проверяю базу знаний\",\n13701|                    \"tool_calls\": [{\"name\": \"read_file\", \"args\": {\"Path\": \"/tmp/test\"}}],\n13702|                }\n13703|            )\n13704|            # Шаг 2: финальный ответ пользователю (без tool_calls)\n13705|            fx.append_record(\n13706|                {\n13707|                    \"type\": \"PLANNER_RESPONSE\",\n13708|                    \"step_index\": 2,\n13709|                    \"content\": \"Вот согласованный ответ для пользователя.\",\n13710|                }\n13711|            )\n13712|\n13713|            _ = _ofn(tail, \"_read_transcript\")()\n13714|\n13715|            # В content должен попасть ТОЛЬКО финальный ответ шага 2\n13716|            self.assertEqual(len(content_emitted), 1)\n13717|            self.assertEqual(content_emitted[0], (2, \"Вот согласованный ответ для пользователя.\"))\n13718|\n13719|            # В reasoning должна попасть сервисная преамбула шага 1\n13720|            reasoning_texts = [delta for _, delta in reasoning_emitted]\n13721|            self.assertTrue(any(\"Ищу скилл analyst-teamlead\" in t for t in reasoning_texts))\n13722|","final_result":true}}}
