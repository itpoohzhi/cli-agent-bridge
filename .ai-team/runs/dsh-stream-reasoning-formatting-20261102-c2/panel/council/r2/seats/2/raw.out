{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KoQiwbcP6WWJ22sevBt9Ur","type":"tool_result","content":"def smoke_test_model(\n    hub_url: str,\n    model_id: str,\n    timeout_s: float = 20.0,\n    api_key: str | None = None,\n) -> tuple[bool, str, float]:\n    \"\"\"Выполнить смоук-запрос к модели через OpenAI-совместимый SSE-стрим с замером TTFT.\"\"\"\n    key = api_key or os.environ.get(\"BRIDGE_KEY\") or os.environ.get(\"HUB_API_KEY\")\n    if not key:\n        dsh_env = Path.home() / \".dsh\" / \".env\"\n        if dsh_env.is_file():\n            try:\n                for line in dsh_env.read_text(encoding=\"utf-8\").splitlines():\n                    if line.startswith(\"BRIDGE_KEY=\"):\n                        key = line.split(\"=\", 1)[1].strip()\n                        break\n            except OSError:\n                pass\n    if not key:\n        key = os.environ.get(\"OPENAI_API_KEY\") or \"test-smoke-key\"\n\n    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n    payload = {\n        \"model\": model_id,\n        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n        \"max_tokens\": 15,\n        \"stream\": True,\n    }\n    data_bytes = json.dumps(payload).encode(\"utf-8\")\n    req = urllib.request.Request(\n        endpoint,\n        data=data_bytes,\n        method=\"POST\",\n    )\n    req.add_header(\"Content-Type\", \"application/json\")\n    req.add_header(\"Authorization\", f\"Bearer {key}\")\n\n    t0 = time.monotonic()\n    ttft: float | None = None\n    got_done = False\n    try:\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n            status_code = resp.getcode()\n            if status_code != 200:\n                return False, f\"HTTP {status_code}\", time.monotonic() - t0\n            for raw_line in resp:\n                line = raw_line.decode(\"utf-8\", \"replace\").strip()\n                if not line or not line.startswith(\"data:\"):\n                    continue\n                data_str = line[5:].strip()\n                if data_str == \"[DONE]\":\n                    got_done = True\n                    break\n                try:\n                    chunk = json.loads(data_str)\n                    choices = chunk.get(\"choices\") or []\n                    if choices:\n                        delta = choices[0].get(\"delta\") or {}\n                        if (\n                            delta.get(\"content\")\n                            or delta.get(\"reasoning_content\")\n                            or delta.get(\"thinking\")\n                        ):\n                            if ttft is None:\n                                ttft = time.monotonic() - t0\n                except ValueError:\n                    pass\n            elapsed = time.monotonic() - t0\n            display_time = ttft if ttft is not None else elapsed\n            if ttft is not None:\n                return True, \"STREAM_OK\", display_time\n            if got_done:\n                return True, \"DONE_OK\", elapsed\n            return False, \"No stream chunks\", elapsed\n    except urllib.error.HTTPError as e:\n        elapsed = time.monotonic() - t0\n        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n        return False, err_msg, elapsed\n    except Exception as e:\n        elapsed = time.monotonic() - t0\n        return False, mask_secret(f\"Error: {e}\"), elapsed\n\n-----\ndef parse_models_md(path: Path) -> list[ModelEntry]:\n    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    if not path.is_file():\n        raise FileNotFoundError(f\"Канонический файл models.md не найден: {path}\")\n\n    content = path.read_text(encoding=\"utf-8\")\n    entries: list[ModelEntry] = []\n    current_role = \"General\"\n\n    # Регулярное выражение для строк вида:\n    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    row_pattern = re.compile(\n        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    )\n\n    for line in content.splitlines():\n        line = line.strip()\n        if line.startswith(\"### \"):\n            header = line[4:].strip()\n            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n            continue\n\n        match = row_pattern.match(line)\n        if match:\n            model_id = match.group(1).strip()\n            effort = match.group(2).strip()\n            family = match.group(3).strip()\n            # Пропускаем заголовки таблиц\n            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n                continue\n            entries.append(ModelEntry(current_role, model_id, effort, family))\n\n    # Дедупликация по паре (role, model_id)\n    seen = set()\n    unique_entries = []\n    for e in entries:\n        key = (e.role, e.model_id)\n        if key not in seen:\n            seen.add(key)\n            unique_entries.append(e)\n\n    return unique_entries\n\n\n----\n\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n\nПроверяет:\n1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport re\nimport sys\nimport threading\nimport unittest\nfrom types import SimpleNamespace\nfrom typing import Any, cast\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass SyntheticE2EAgentStreamTests(unittest.TestCase):\n    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-stream-reasoning-formatting-20261102-c2/panel/council/r2","is_error":false}]},"parent_tool_use_id":null,"session_id":"a325761f-10e1-43b4-bfbd-7054aaeeb0de","uuid":"707a179d-7e59-480b-b1e6-4d13dff6d888","timestamp":"2026-11-02T13:20:24.197Z","tool_use_result":{"stdout":"def smoke_test_model(\n    hub_url: str,\n    model_id: str,\n    timeout_s: float = 20.0,\n    api_key: str | None = None,\n) -> tuple[bool, str, float]:\n    \"\"\"Выполнить смоук-запрос к модели через OpenAI-совместимый SSE-стрим с замером TTFT.\"\"\"\n    key = api_key or os.environ.get(\"BRIDGE_KEY\") or os.environ.get(\"HUB_API_KEY\")\n    if not key:\n        dsh_env = Path.home() / \".dsh\" / \".env\"\n        if dsh_env.is_file():\n            try:\n                for line in dsh_env.read_text(encoding=\"utf-8\").splitlines():\n                    if line.startswith(\"BRIDGE_KEY=\"):\n                        key = line.split(\"=\", 1)[1].strip()\n                        break\n            except OSError:\n                pass\n    if not key:\n        key = os.environ.get(\"OPENAI_API_KEY\") or \"test-smoke-key\"\n\n    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n    payload = {\n        \"model\": model_id,\n        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n        \"max_tokens\": 15,\n        \"stream\": True,\n    }\n    data_bytes = json.dumps(payload).encode(\"utf-8\")\n    req = urllib.request.Request(\n        endpoint,\n        data=data_bytes,\n        method=\"POST\",\n    )\n    req.add_header(\"Content-Type\", \"application/json\")\n    req.add_header(\"Authorization\", f\"Bearer {key}\")\n\n    t0 = time.monotonic()\n    ttft: float | None = None\n    got_done = False\n    try:\n        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n            status_code = resp.getcode()\n            if status_code != 200:\n                return False, f\"HTTP {status_code}\", time.monotonic() - t0\n            for raw_line in resp:\n                line = raw_line.decode(\"utf-8\", \"replace\").strip()\n                if not line or not line.startswith(\"data:\"):\n                    continue\n                data_str = line[5:].strip()\n                if data_str == \"[DONE]\":\n                    got_done = True\n                    break\n                try:\n                    chunk = json.loads(data_str)\n                    choices = chunk.get(\"choices\") or []\n                    if choices:\n                        delta = choices[0].get(\"delta\") or {}\n                        if (\n                            delta.get(\"content\")\n                            or delta.get(\"reasoning_content\")\n                            or delta.get(\"thinking\")\n                        ):\n                            if ttft is None:\n                                ttft = time.monotonic() - t0\n                except ValueError:\n                    pass\n            elapsed = time.monotonic() - t0\n            display_time = ttft if ttft is not None else elapsed\n            if ttft is not None:\n                return True, \"STREAM_OK\", display_time\n            if got_done:\n                return True, \"DONE_OK\", elapsed\n            return False, \"No stream chunks\", elapsed\n    except urllib.error.HTTPError as e:\n        elapsed = time.monotonic() - t0\n        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n        return False, err_msg, elapsed\n    except Exception as e:\n        elapsed = time.monotonic() - t0\n        return False, mask_secret(f\"Error: {e}\"), elapsed\n\n-----\ndef parse_models_md(path: Path) -> list[ModelEntry]:\n    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    if not path.is_file():\n        raise FileNotFoundError(f\"Канонический файл models.md не найден: {path}\")\n\n    content = path.read_text(encoding=\"utf-8\")\n    entries: list[ModelEntry] = []\n    current_role = \"General\"\n\n    # Регулярное выражение для строк вида:\n    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    row_pattern = re.compile(\n        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    )\n\n    for line in content.splitlines():\n        line = line.strip()\n        if line.startswith(\"### \"):\n            header = line[4:].strip()\n            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n            continue\n\n        match = row_pattern.match(line)\n        if match:\n            model_id = match.group(1).strip()\n            effort = match.group(2).strip()\n            family = match.group(3).strip()\n            # Пропускаем заголовки таблиц\n            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n                continue\n            entries.append(ModelEntry(current_role, model_id, effort, family))\n\n    # Дедупликация по паре (role, model_id)\n    seen = set()\n    unique_entries = []\n    for e in entries:\n        key = (e.role, e.model_id)\n        if key not in seen:\n            seen.add(key)\n            unique_entries.append(e)\n\n    return unique_entries\n\n\n----\n\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n\nПроверяет:\n1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport queue\nimport re\nimport sys\nimport threading\nimport unittest\nfrom types import SimpleNamespace\nfrom typing import Any, cast\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass SyntheticE2EAgentStreamTests(unittest.TestCase):\n    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"","stderr":"\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-stream-reasoning-formatting-20261102-c2/panel/council/r2","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KoQiwbcP6WWJ22sevBt9Ur","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
