d\": ev.get(\"conversation_id\") or \"\",\n5492|                                \"tools\": len(tools),\n5493|                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n5494|                            },\n5495|                        )\n5496|                    )\n5497|                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n5498|                elif etype == \"step_update\":\n5499|                    step = (\n5500|                        ev.get(\"step_update\")\n5501|                        if isinstance(ev.get(\"step_update\"), dict)\n5502|                        else {}\n5503|                    )\n5504|                    kind = step.get(\"step_type\")\n5505|                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n5506|                        if self.content_streaming:\n5507|                            _ = self.offer_content(\n5508|                                \"stdout\",\n5509|                                _as_int(step.get(\"step_index\")),\n5510|                                str(step[\"text_delta\"]),\n5511|                            )\n5512|                        else:\n5513|                            suffix = _reasoning_suffix(\n5514|                                self._text_seen,\n5515|                                str(step.get(\"step_index\", \"\")),\n5516|                                str(step[\"text_delta\"]),\n5517|                            )\n5518|                            if suffix:\n5519|                                self.q.put((\"text\", suffix))\n5520|                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n5521|                        step_idx = _as_int(step.get(\"step_index\"))\n5522|                        trace: dict[str, object] = {\n5523|                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n5524|                            \"duration_s\": step.get(\"duration_seconds\"),\n5525|                            \"step_index\": step_idx,\n5526|                        }\n5527|                        if step_idx is None:\n5528|                            # Идентичность DONE без step_index: монотонный ordinal хода,\n5529|                            # назначается один раз и переживает повторную доставку события.\n5530|                            raw_id = (\n5531|                                step.get(\"call_id\")\n5532|                                or step.get(\"tool_call_id\")\n5533|                                or step.get(\"id\")\n5534|                            )\n5535|                            call_id = (\n5536|                                str(raw_id).strip()\n5537|                                if isinstance(raw_id, (str, int))\n5538|                                else \"\"\n5539|                            )\n5540|                            if call_id:\n5541|                                # Повтор события с тем же call_id получает тот же ordinal.\n5542|                                ord_val = tool_ordinal_by_id.get(call_id)\n5543|                                if ord_val is None:\n5544|                                    tool_ordinal += 1\n5545|                                    ord_val = tool_ordinal\n5546|                                    tool_ordinal_by_id[call_id] = ord_val\n5547|                                trace[\"fallback_ordinal\"] = ord_val\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43b","stream":{"kind":"session","id":"01a19c6a-e924-79d3-97ee-8c156603bc22"},"sequence":120,"recorded_at":1780531400000235,"record_type":"event","durability":"durable","causation_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","run_stream":{"kind":"run","id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4"},"task_stream":{"kind":"task","id":"01a19c6b-666a-7503-b890-d239076b5186"},"task_id":"01a19c6b-666a-7503-b890-d239076b5186","event":{"kind":"completed","task_id":"01a19c6b-666a-7503-b890-d239076b5186"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43d","stream":{"kind":"session","id":"01a19c6a-e924-79d3-97ee-8c156603bc22"},"sequence":121,"recorded_at":1780531400000237,"record_type":"event","durability":"durable","causation_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","run_stream":{"kind":"run","id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4"},"call_id":"call_01a19c6b58d4741e8659ce8a6ba22771","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(4516 line(s) above)\n4517|    def _emit_record(self, raw: bytes) -> None:\n4518|        line = raw.strip()\n4519|        if not line:\n4520|            return\n4521|        if (\n4522|            b\"PLANNER_RESPONSE\" not in line\n4523|            and b\"END_TURN\" not in line\n4524|            and b\"TURN_COMPLETE\" not in line\n4525|        ):\n4526|            return  # быстрый отсев служебных записей без разбора JSON\n4527|        try:\n4528|            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n4529|        except ValueError:\n4530|            return\n4531|        if not isinstance(parsed, dict):\n4532|            return\n4533|        rec = cast(\"dict[str, object]\", parsed)\n4534|        rtype = str(rec.get(\"type\") or \"\")\n4535|        idx = _as_int(rec.get(\"step_index\"))\n4536|        if idx is not None and idx < self.base_idx:\n4537|            return  # история прошлых ходов\n4538|        if self._in_rewrite:\n4539|            self._note_activity()\n4540|        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n4541|            self.end_marker = True\n4542|            return\n4543|        if rtype != \"PLANNER_RESPONSE\":\n4544|            return\n4545|        if self.usage_enabled:\n4546|            self._record_usage(rec)\n4547|        content = rec.get(\"content\")\n4548|        emit_content = self.emit_content\n4549|        has_tools = bool(rec.get(\"tool_calls\"))\n4550|        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n4551|        if emit_content is not None and isinstance(content, str) and content.strip():\n4552|            if has_tools and isolate_tools:\n4553|                preambles = getattr(self, \"_preambles_emitted\", None)\n4554|                if preambles is None:\n4555|                    preambles = self._preambles_emitted = set()\n4556|                key_idx = idx if idx is not None else -1\n4557|                if key_idx not in preambles:\n4558|                    preambles.add(key_idx)\n4559|                    _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n4560|            else:\n4561|                _ = emit_content(\n4562|                    idx, content\n4563|                )  # live planner-текст, независимо от tool_calls\n4564|        if idx is None:\n4565|            return\n4566|        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n4567|            self.final_planner = True\n4568|        thinking = rec.get(\"thinking\")\n4569|        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n4570|\n4571|    # ---- состояние шагов -----------------------------------------------------------\n4572|    def _state(self, idx: int) -> _StepState:\n4573|        state = self.seen.get(idx)\n4574|        if state is not None:\n4575|            return state\n4576|        if len(self.seen) >= MAX_STEPS_TRACKED:\n4577|            evictable = [\n4578|                k\n4579|                for k, s in self.seen.items()\n4580|                if s.finalized and k < self.poll_watermark\n4581|            ]\n4582|            if evictable:\n4583|                del self.seen[min(evictable)]\n4584|            else:\n4585|                self._sqlite_off(\"seen_cap\")\n4586|                del self.seen[min(self.seen)]\n4587|        state = _StepState()\n4588|        self.seen[idx] = state\n4589|        return state\n4590|\n4591|    def _step_done(self, state: _StepState) -> bool:\n4592|        return state.sql_done or (\n4593|            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n4594|        )\n4595|\n4596|    def _advance_watermark(self) -> None:\n4597|        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n4598|        mark = self.poll_watermark\n4599|        for key in sorted(self.seen):\n4600|            if key < mark:\n4601|                continue\n4602|            if not self._step_done(self.seen[key]):\n4603|                break\n4604|            mark = key + 1\n4605|        self.poll_watermark = mark\n4606|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a19c6a-e924-79d3-97ee-8c156603bc22"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4","run_stream":{"kind":"run","id":"01a19c6a-ed7b-7cf3-82d4-4c6e98a894d4"},"call_id":"call_01a19c6b5b64740a9bd4f5fa0f34a370","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py`.\n(5311 line(s) above)\n5312|    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n5313|        \"\"\"Кандидат planner-текста в арбитр; новый суффикс уходит в очередь под _emit_lock.\n5314|\n5315|        Сокетного ввода-вывода здесь нет: потребитель (`_execute`) пишет в сокет сам.\n5316|        False — выдача уже закрыта terminal barrier'ом.\n5317|        \"\"\"\n5318|        with self._emit_lock:\n5319|            if self.drain_closed:\n5320|                return False\n5321|            suffix = self._arbiter.offer(\n5322|                source, step_index, text, self._tail.cid or self.run_cid\n5323|            )\n5324|            if suffix:\n5325|                sep = \"\"\n5326|                last_idx = getattr(self, \"_last_step_index\", None)\n5327|                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5328|                if last_idx is not None and last_idx != step_index and emitted_wire:\n5329|                    if not emitted_wire.endswith(\"\\n\"):\n5330|                        sep = (\n5331|                            \"\\n\\n\"\n5332|                            if not suffix.startswith(\"\\n\")\n5333|                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n5334|                        )\n5335|                    elif not emitted_wire.endswith(\"\\n\\n\"):\n5336|                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n5337|                self._last_step_index = step_index\n5338|                self._content_emitted_wire = emitted_wire + sep + suffix\n5339|                self.q.put((\"text\", sep + suffix))\n5340|        return True\n5341|\n5342|    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n5343|        return self.offer_content(\"transcript\", step_index, text)\n5344|\n5345|    def reconcile_result(self, text: str) -> str:\n5346|        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром и выданного в wire.\"\"\"\n5347|        with self._emit_lock:\n5348|            emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5349|            if emitted_wire and text:\n5350|                if text == emitted_wire or emitted_wire.startswith(text):\n5351|                    self._arbiter.last_result_diverged = False\n5352|                    return \"\"\n5353|                if text.startswith(emitted_wire):\n5354|                    self._arbiter.last_result_diverged = False\n5355|                    return text[len(emitted_wire) :]\n5356|                clean_text = text.replace(\"\\r\\n\", \"\\n\").strip()\n5357|                clean_wire = emitted_wire.replace(\"\\r\\n\", \"\\n\").strip()\n5358|                if clean_text == clean_wire or clean_wire.startswith(clean_text):\n5359|                    self._arbiter.last_result_diverged = False\n5360|                    return \"\"\n5361|            return self._arbiter.reconcile_result(text)\n5362|\n5363|    def retained_divergent_text(self) -> str:\n5364|        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n5365|        with self._emit_lock:\n5366|            return self._arbiter.retained_divergent_text()\n5367|\n5368|    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n5369|        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n5370|        заморозка выдачи и остаток очереди ДО terminal marker'а.\n5371|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
