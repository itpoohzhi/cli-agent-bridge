ток-читатель превращает stdout NDJSON в события очереди.\n5184:                stdout=subprocess.PIPE,\n5210:        self.got_event = False  # True после первого валидного JSON-события stdout\n5232:        self._last_step_index: object = None\n5233:        self._content_emitted_wire: str = \"\"\n5234:        # Реальная активность producer'ов (stdout/transcript), независимо от cpu_delta.\n5302:        \"\"\"Новый прогресс producer'а (stdout/transcript): продлевает idle, не зависит от CPU.\"\"\"\n5312:    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n5322:                source, step_index, text, self._tail.cid or self.run_cid\n5326:                last_idx = getattr(self, \"_last_step_index\", None)\n5327:                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5328:                if last_idx is not None and last_idx != step_index and emitted_wire:\n5337:                self._last_step_index = step_index\n5338:                self._content_emitted_wire = emitted_wire + sep + suffix\n5342:    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n5343:        return self.offer_content(\"transcript\", step_index, text)\n5345:    def reconcile_result(self, text: str) -> str:\n5348:            emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n5449:    def _pump(self) -> None:\n5468:            for raw in iter(self.proc.stdout.readline, b\"\"):\n5477:                self.note_producer_activity(\"stdout\")\n5508:                                \"stdout\",\n5509:                                _as_int(step.get(\"step_index\")),\n5515:                                str(step.get(\"step_index\", \"\")),\n5521:                        step_idx = _as_int(step.get(\"step_index\"))\n5525:                            \"step_index\": step_idx,\n5528:                            # Идентичность DONE без step_index: монотонный ordinal хода,\n5616:        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n6034:        idle (по реальной активности producer'ов stdout/transcript, независимо от\n6164:                        \"(no stdout/transcript progress)\",\n","exit_code":0,"status":"completed"}}
