{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tests/test_stream_formatting_and_subagents.py'","aggregated_output":"     1\t\"\"\"tests/test_stream_formatting_and_subagents.py — Сквозные синтетические e2e-тесты (L2)\n     2\t\n     3\tПроверяет:\n     4\t1. Разграничение шагов Markdown (\\\\n\\\\n, отсутствие склейки слов вида \"данных.Проверяю\").\n     5\t2. Исключение зацикливания префиксов оркестрации (\"[гейт оркестрации: активен...\").\n     6\t3. Семантическую изоляцию reasoning при вызовах инструментов (сохранение блока <Think> в UI).\n     7\t4. Жизненный цикл мультиагентных сессий (сабагенты, вызовы инструментов и непрерывность потока).\n     8\t\"\"\"\n     9\t\n    10\tfrom __future__ import annotations\n    11\t\n    12\timport importlib.util\n    13\timport json\n    14\timport os\n    15\tfrom pathlib import Path\n    16\timport queue\n    17\timport re\n    18\timport sys\n    19\timport threading\n    20\timport unittest\n    21\tfrom types import SimpleNamespace\n    22\tfrom typing import Any, cast\n    23\t\n    24\t_REPO_ROOT = Path(__file__).resolve().parents[1]\n    25\tif str(_REPO_ROOT) not in sys.path:\n    26\t    sys.path.insert(0, str(_REPO_ROOT))\n    27\t\n    28\t_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n    29\t\n    30\t\n    31\tdef _load_bridge() -> Any:\n    32\t    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-stream-e2e\")\n    33\t    spec = importlib.util.spec_from_file_location(\n    34\t        \"agy_bridge_server_e2e_under_test\", _BRIDGE_PY\n    35\t    )\n    36\t    assert spec is not None and spec.loader is not None\n    37\t    module = importlib.util.module_from_spec(spec)\n    38\t    sys.modules[spec.name] = module\n    39\t    spec.loader.exec_module(module)\n    40\t    return module\n    41\t\n    42\t\n    43\tsrv = _load_bridge()\n    44\t\n    45\t\n    46\tclass SyntheticE2EAgentStreamTests(unittest.TestCase):\n    47\t    \"\"\"Сквозные сценарные тесты стриминга агента, сабагентов и скиллов оркестрации.\"\"\"\n    48\t\n    49\t    def test_e2e_multi_step_markdown_boundary_separation(self) -> None:\n    50\t        \"\"\"Сквозная проверка: шаги агента разделяются \\\\n\\\\n, слова на стыках не склеиваются.\"\"\"\n    51\t        run = object.__new__(srv.Run)\n    52\t        setattr(run, \"_emit_lock\", threading.Lock())\n    53\t        setattr(run, \"q\", queue.Queue())\n    54\t        setattr(run, \"drain_closed\", False)\n    55\t        setattr(run, \"_done_put\", False)\n    56\t        setattr(run, \"_reasoning_bytes\", 0)\n    57\t        setattr(run, \"_cap_logged\", False)\n    58\t        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-test-e2e\"))\n    59\t        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-e2e-1\"))\n    60\t        setattr(run, \"turn_id\", \"turn-e2e-1\")\n    61\t        setattr(run, \"run_cid\", \"cid-test-e2e\")\n    62\t        setattr(run, \"_last_step_index\", None)\n    63\t        setattr(run, \"_content_emitted_wire\", \"\")\n    64\t\n    65\t        # Эмулируем шаги из скриншота пользователя:\n    66\t        # Шаг 1: \"Ищу в базе знаний и git посл\"\n    67\t        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git посл\")\n    68\t        # Шаг 1 (продолжение): \"Проверяю результаты поиска по переезду базы данных.\"\n    69\t        run.offer_content(\"stdout\", 1, \"Ищу в базе знаний и git послПроверяю результаты поиска по переезду базы данных.\")\n    70\t        # Шаг 2: \"Проверяю вывод лога задачи 349.\" (начинается с заглавной буквы)\n    71\t        run.offer_content(\"stdout\", 2, \"Проверяю вывод лога задачи 349.\")\n    72\t        # Шаг 3: \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\"\n    73\t        run.offer_content(\"stdout\", 3, \"Останавливаю фоновую задачу поиска. Читаю параллельно все об...\")\n    74\t\n    75\t        q = cast(\"queue.Queue[tuple[str, object]]\", getattr(run, \"q\"))\n    76\t        emitted_chunks: list[str] = []\n    77\t        while not q.empty():\n    78\t            item = q.get_nowait()\n    79\t            if item[0] == \"text\":\n    80\t                emitted_chunks.append(str(item[1]))\n    81\t\n    82\t        full_stream = \"\".join(emitted_chunks)\n    83\t\n    84\t        # 1. Проверяем, что нет дефекта склеивания точки и заглавной буквы без переноса строк\n    85\t        glued_pattern = re.compile(r\"[а-яёa-z]\\.[А-ЯЁA-Z]\")\n    86\t        self.assertIsNone(\n    87\t            glued_pattern.search(full_stream),\n    88\t            f\"Обнаружена склейка слов на стыке шагов: {full_stream!r}\",\n    89\t        )\n    90\t\n    91\t        # 2. Проверяем наличие разделителя \\n\\n между шагами 1, 2 и 3\n    92\t        self.assertIn(\"базы данных.\\n\\nПроверяю вывод\", full_stream)\n    93\t        self.assertIn(\"задачи 349.\\n\\nОстанавливаю фоновую\", full_stream)\n    94\t\n    95\t    def test_e2e_orchestration_gate_prefix_loop_prevention(self) -> None:\n    96\t        \"\"\"Сквозная проверка: повторение префиксов статусов оркестрации не приводит к лавине дублей.\"\"\"\n    97\t        arb = srv._ContentArbiter(\"turn-orch-1\")\n    98\t\n    99\t        # Агент меняет статусы оркестрации на протяжении 5 шагов\n   100\t        statuses = [\n   101\t            \"[гейт оркестрации: активен | роль: lead-orchestrator] Инициализация контура\",\n   102\t            \"[гейт оркестрации: активен | роль: explorer] Сбор контекста и чтение канона\",\n   103\t            \"[гейт оркестрации: активен | роль: explorer] Поиск тестов в tests/\",\n   104\t            \"[гейт оркестрации: активен | роль: worker] Запуск pytest\",\n   105\t            \"[гейт оркестрации: активен | роль: reviewer] Анализ отчёта\",\n   106\t        ]\n   107\t\n   108\t        emitted_deltas: list[str] = []\n   109\t        for idx, status in enumerate(statuses, 1):\n   110\t            # Эмулируем приход короткого префикса, затем полного текста\n   111\t            short_prefix = status[:27]  # \"[гейт оркестрации: активен\"\n   112\t            d1 = arb.offer(\"transcript\", idx, short_prefix, \"cid-orch\")\n   113\t            if d1:\n   114\t                emitted_deltas.append(d1)\n   115\t            d2 = arb.offer(\"transcript\", idx, status, \"cid-orch\")\n   116\t            if d2:\n   117\t                emitted_deltas.append(d2)\n   118\t\n   119\t        # Проверяем, что ни один шаг не был ошибочно заморожен из-за divergence\n   120\t        self.assertEqual(arb.divergences, 0)\n   121\t\n   122\t        # Полный текст не должен содержать патологического зацикливания \"[гейт оркестрации: активен\"\n   123\t        full_text = \"\".join(emitted_deltas)\n   124\t        count = full_text.count(\"[гейт оркестрации: активен\")\n   125\t        self.assertEqual(\n   126\t            count,\n   127\t            len(statuses),\n   128\t            f\"Префикс повторился {count} раз вместо {len(statuses)}: {full_text!r}\",\n   129\t        )\n   130\t\n   131\t    def test_e2e_subagent_tool_preambles_isolated_to_reasoning(self) -> None:\n   132\t        \"\"\"Сквозная проверка: преамбулы запуска сабагентов изолируются в reasoning_content.\"\"\"\n   133\t        emitted_events: list[tuple[str, str]] = []\n   134\t\n   135\t        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n   136\t            emitted_events.append((\"reasoning\", delta))\n   137\t            if on_del is not None:\n   138\t                on_del()\n   139\t            return True\n   140\t\n   141\t        def emit_content(idx: int | None, text: str) -> bool:\n   142\t            emitted_events.append((\"content\", text))\n   143\t            return True\n   144\t\n   145\t        plan = srv._TurnPlan()\n   146\t        plan.mode = \"OFF\"\n   147\t        plan.base_idx = 0\n   148\t        plan.offset = 0\n   149\t\n   150\t        tail = srv._TranscriptTail(\n   151\t            emit=emit_reasoning,\n   152\t            stop_event=threading.Event(),\n   153\t            done_event=threading.Event(),\n   154\t            resumed=False,\n   155\t            plan=plan,\n   156\t            turn_id=\"turn-subagent-1\",\n   157\t            emit_content=emit_content,\n   158\t            on_activity=None,\n   159\t            usage_enabled=False,\n   160\t            isolate_tool_preambles=True,\n   161\t        )\n   162\t\n   163\t        # Эмулируем транскрипт мультиагентного цикла:\n   164\t        # Шаг 1: Оркестратор запускает сабагента Coder\n   165\t        record_step1 = {\n   166\t            \"type\": \"PLANNER_RESPONSE\",\n   167\t            \"step_index\": 1,\n   168\t            \"content\": \"[гейт оркестрации: активен] Запускаю сабагента Coder для исправления тестов...\",\n   169\t            \"thinking\": \"Анализ завершён. Необходимо делегировать кодогенерацию роли Coder.\",\n   170\t            \"tool_calls\": [\n   171\t                {\n   172\t                    \"name\": \"invoke_subagent\",\n   173\t                    \"args\": {\"Role\": \"Coder\", \"Prompt\": \"Fix test\"},\n   174\t                }\n   175\t            ],\n   176\t        }\n   177\t        tail._emit_record(json.dumps(record_step1).encode(\"utf-8\"))\n   178\t\n   179\t        # Шаг 2: Финальный ответ после завершения сабагента\n   180\t        record_step2 = {\n   181\t            \"type\": \"PLANNER_RESPONSE\",\n   182\t            \"step_index\": 2,\n   183\t            \"content\": \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   184\t            \"thinking\": \"Формирую итоговый статус для владельца.\",\n   185\t        }\n   186\t        tail._emit_record(json.dumps(record_step2).encode(\"utf-8\"))\n   187\t\n   188\t        # Проверяем распределение:\n   189\t        # 1. Преамбула шага 1 ушла в reasoning\n   190\t        reasoning_pieces = [text for kind, text in emitted_events if kind == \"reasoning\"]\n   191\t        self.assertTrue(any(\"Запускаю сабагента Coder\" in r for r in reasoning_pieces))\n   192\t\n   193\t        # 2. В content попал ТОЛЬКО финальный ответ шага 2 без сервисных преамбул вызова инструмента\n   194\t        content_pieces = [text for kind, text in emitted_events if kind == \"content\"]\n   195\t        self.assertEqual(len(content_pieces), 1)\n   196\t        self.assertEqual(\n   197\t            content_pieces[0],\n   198\t            \"Сабагент Coder завершил работу. Все тесты успешно пройдены.\",\n   199\t        )\n   200\t\n   201\t    def test_e2e_reconcile_wire_sync_and_preamble_dedup(self) -> None:\n   202\t        \"\"\"Сквозная проверка: дедупликация преамбул в reasoning и синхронизация reconcile с wire.\"\"\"\n   203\t        # 1. Проверка дедупликации преамбулы при повторной записи шага\n   204\t        emitted_events: list[tuple[str, str]] = []\n   205\t\n   206\t        def emit_reasoning(idx: int, delta: str, on_del: Any = None) -> bool:\n   207\t            emitted_events.append((\"reasoning\", delta))\n   208\t            return True\n   209\t\n   210\t        plan = srv._TurnPlan()\n   211\t        plan.mode = \"OFF\"\n   212\t        tail = srv._TranscriptTail(\n   213\t            emit=emit_reasoning,\n   214\t            stop_event=threading.Event(),\n   215\t            done_event=threading.Event(),\n   216\t            resumed=False,\n   217\t            plan=plan,\n   218\t            turn_id=\"turn-dedup-1\",\n   219\t            emit_content=lambda idx, t: True,\n   220\t            isolate_tool_preambles=True,\n   221\t        )\n   222\t\n   223\t        rec = {\n   224\t            \"type\": \"PLANNER_RESPONSE\",\n   225\t            \"step_index\": 10,\n   226\t            \"content\": \"Запуск анализа...\",\n   227\t            \"tool_calls\": [{\"name\": \"read_file\", \"args\": {}}],\n   228\t        }\n   229\t        raw_bytes = json.dumps(rec).encode(\"utf-8\")\n   230\t        tail._emit_record(raw_bytes)\n   231\t        # Повторная доставка того же шага (например при rewrite)\n   232\t        tail._emit_record(raw_bytes)\n   233\t\n   234\t        preambles = [t for k, t in emitted_events if \"Запуск анализа...\" in t]\n   235\t        self.assertEqual(\n   236\t            len(preambles),\n   237\t            1,\n   238\t            f\"Преамбула эмитирована {len(preambles)} раз вместо 1: {preambles}\",\n   239\t        )\n   240\t\n   241\t        # 2. Проверка отсутствия ложной дивергенции в Run.reconcile_result\n   242\t        run = object.__new__(srv.Run)\n   243\t        setattr(run, \"_emit_lock\", threading.Lock())\n   244\t        setattr(run, \"q\", queue.Queue())\n   245\t        setattr(run, \"drain_closed\", False)\n   246\t        setattr(run, \"_done_put\", False)\n   247\t        setattr(run, \"_reasoning_bytes\", 0)\n   248\t        setattr(run, \"_cap_logged\", False)\n   249\t        setattr(run, \"_tail\", SimpleNamespace(cid=\"cid-sync-1\"))\n   250\t        setattr(run, \"_arbiter\", srv._ContentArbiter(\"turn-sync-1\"))\n   251\t        setattr(run, \"turn_id\", \"turn-sync-1\")\n   252\t        setattr(run, \"run_cid\", \"cid-sync-1\")\n   253\t        setattr(run, \"_last_step_index\", None)\n   254\t        setattr(run, \"_content_emitted_wire\", \"\")\n   255\t\n   256\t        run.offer_content(\"transcript\", 1, \"Шаг 1 завершён.\")\n   257\t        run.offer_content(\"transcript\", 2, \"Шаг 2 завершён.\")\n   258\t\n   259\t        # Wire содержит разделитель \\n\\n\n   260\t        wire_text = getattr(run, \"_content_emitted_wire\")\n   261\t        self.assertEqual(wire_text, \"Шаг 1 завершён.\\n\\nШаг 2 завершён.\")\n   262\t\n   263\t        # reconcile_result с тем же текстом не должен давать дивергенции\n   264\t        delta = run.reconcile_result(wire_text)\n   265\t        self.assertEqual(delta, \"\")\n   266\t        self.assertFalse(\n   267\t            getattr(run._arbiter, \"last_result_diverged\", False),\n   268\t            \"Ложное срабатывание дивергенции при точном совпадении wire_text\",\n   269\t        )\n   270\t\n   271\t        # reconcile_result с дополнительным хвостом\n   272\t        delta_extra = run.reconcile_result(wire_text + \" Дополнительный итог.\")\n   273\t        self.assertEqual(delta_extra, \" Дополнительный итог.\")\n   274\t        self.assertFalse(\n   275\t            getattr(run._arbiter, \"last_result_diverged\", False),\n   276\t            \"Ложное срабатывание дивергенции при суффиксе wire_text\",\n   277\t        )\n   278\t\n   279\t\n   280\tif __name__ == \"__main__\":\n   281\t    unittest.main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4517,4605p' bridges/agy-bridge/server.py\nsed -n '5310,5375p' bridges/agy-bridge/server.py\nsed -n '5449,5545p' bridges/agy-bridge/server.py\nnl -ba scripts/smoke_models.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4517,4605p' bridges/agy-bridge/server.py\nsed -n '5310,5375p' bridges/agy-bridge/server.py\nsed -n '5449,5545p' bridges/agy-bridge/server.py\nnl -ba scripts/smoke_models.py\"","aggregated_output":"    def _emit_record(self, raw: bytes) -> None:\n        line = raw.strip()\n        if not line:\n            return\n        if (\n            b\"PLANNER_RESPONSE\" not in line\n            and b\"END_TURN\" not in line\n            and b\"TURN_COMPLETE\" not in line\n        ):\n            return  # быстрый отсев служебных записей без разбора JSON\n        try:\n            parsed = cast(object, json.loads(line.decode(\"utf-8\", \"replace\")))\n        except ValueError:\n            return\n        if not isinstance(parsed, dict):\n            return\n        rec = cast(\"dict[str, object]\", parsed)\n        rtype = str(rec.get(\"type\") or \"\")\n        idx = _as_int(rec.get(\"step_index\"))\n        if idx is not None and idx < self.base_idx:\n            return  # история прошлых ходов\n        if self._in_rewrite:\n            self._note_activity()\n        if rtype in (\"END_TURN\", \"TURN_COMPLETE\"):\n            self.end_marker = True\n            return\n        if rtype != \"PLANNER_RESPONSE\":\n            return\n        if self.usage_enabled:\n            self._record_usage(rec)\n        content = rec.get(\"content\")\n        emit_content = self.emit_content\n        has_tools = bool(rec.get(\"tool_calls\"))\n        isolate_tools = getattr(self, \"isolate_tool_preambles\", False)\n        if emit_content is not None and isinstance(content, str) and content.strip():\n            if has_tools and isolate_tools:\n                preambles = getattr(self, \"_preambles_emitted\", None)\n                if preambles is None:\n                    preambles = self._preambles_emitted = set()\n                key_idx = idx if idx is not None else -1\n                if key_idx not in preambles:\n                    preambles.add(key_idx)\n                    _ = self.emit(idx if idx is not None else 0, content + \"\\n\\n\", None)\n            else:\n                _ = emit_content(\n                    idx, content\n                )  # live planner-текст, независимо от tool_calls\n        if idx is None:\n            return\n        if isinstance(content, str) and content.strip() and not rec.get(\"tool_calls\"):\n            self.final_planner = True\n        thinking = rec.get(\"thinking\")\n        self._apply_final(idx, thinking if isinstance(thinking, str) else \"\")\n\n    # ---- состояние шагов -----------------------------------------------------------\n    def _state(self, idx: int) -> _StepState:\n        state = self.seen.get(idx)\n        if state is not None:\n            return state\n        if len(self.seen) >= MAX_STEPS_TRACKED:\n            evictable = [\n                k\n                for k, s in self.seen.items()\n                if s.finalized and k < self.poll_watermark\n            ]\n            if evictable:\n                del self.seen[min(evictable)]\n            else:\n                self._sqlite_off(\"seen_cap\")\n                del self.seen[min(self.seen)]\n        state = _StepState()\n        self.seen[idx] = state\n        return state\n\n    def _step_done(self, state: _StepState) -> bool:\n        return state.sql_done or (\n            state.finalized and (self.mode != \"SHADOW\" or state.canary_done)\n        )\n\n    def _advance_watermark(self) -> None:\n        \"\"\"Сдвинуть нижнюю границу SELECT через непрерывный префикс завершённых шагов.\"\"\"\n        mark = self.poll_watermark\n        for key in sorted(self.seen):\n            if key < mark:\n                continue\n            if not self._step_done(self.seen[key]):\n                break\n            mark = key + 1\n        self.poll_watermark = mark\n        self.note_producer_activity(\"transcript\")\n\n    def offer_content(self, source: str, step_index: object, text: str) -> bool:\n        \"\"\"Кандидат planner-текста в арбитр; новый суффикс уходит в очередь под _emit_lock.\n\n        Сокетного ввода-вывода здесь нет: потребитель (`_execute`) пишет в сокет сам.\n        False — выдача уже закрыта terminal barrier'ом.\n        \"\"\"\n        with self._emit_lock:\n            if self.drain_closed:\n                return False\n            suffix = self._arbiter.offer(\n                source, step_index, text, self._tail.cid or self.run_cid\n            )\n            if suffix:\n                sep = \"\"\n                last_idx = getattr(self, \"_last_step_index\", None)\n                emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n                if last_idx is not None and last_idx != step_index and emitted_wire:\n                    if not emitted_wire.endswith(\"\\n\"):\n                        sep = (\n                            \"\\n\\n\"\n                            if not suffix.startswith(\"\\n\")\n                            else (\"\\n\" if not suffix.startswith(\"\\n\\n\") else \"\")\n                        )\n                    elif not emitted_wire.endswith(\"\\n\\n\"):\n                        sep = \"\\n\" if not suffix.startswith(\"\\n\") else \"\"\n                self._last_step_index = step_index\n                self._content_emitted_wire = emitted_wire + sep + suffix\n                self.q.put((\"text\", sep + suffix))\n        return True\n\n    def _offer_transcript(self, step_index: int | None, text: str) -> bool:\n        return self.offer_content(\"transcript\", step_index, text)\n\n    def reconcile_result(self, text: str) -> str:\n        \"\"\"Недостающий хвост `result.response` относительно уже принятого арбитром и выданного в wire.\"\"\"\n        with self._emit_lock:\n            emitted_wire = getattr(self, \"_content_emitted_wire\", \"\")\n            if emitted_wire and text:\n                if text == emitted_wire or emitted_wire.startswith(text):\n                    self._arbiter.last_result_diverged = False\n                    return \"\"\n                if text.startswith(emitted_wire):\n                    self._arbiter.last_result_diverged = False\n                    return text[len(emitted_wire) :]\n                clean_text = text.replace(\"\\r\\n\", \"\\n\").strip()\n                clean_wire = emitted_wire.replace(\"\\r\\n\", \"\\n\").strip()\n                if clean_text == clean_wire or clean_wire.startswith(clean_text):\n                    self._arbiter.last_result_diverged = False\n                    return \"\"\n            return self._arbiter.reconcile_result(text)\n\n    def retained_divergent_text(self) -> str:\n        \"\"\"Расходящийся (непрефиксный) planner-текст, удержанный арбитром.\"\"\"\n        with self._emit_lock:\n            return self._arbiter.retained_divergent_text()\n\n    def terminal_drain(self, budget_s: float) -> list[tuple[str, object]]:\n        \"\"\"Ограниченный (<= budget_s) финальный дренаж на timeout/ошибке: хвост источников,\n        заморозка выдачи и остаток очереди ДО terminal marker'а.\n\n        Процесс при этом ещё жив: окно дренирования хвоста открывает `_proc_done`.\n        Возвращает необработанные потребителем события (\"text\"/\"reasoning\"/\"tool_trace\").\n        \"\"\"\n        started = time.monotonic()\n    def _pump(self) -> None:\n        \"\"\"Разбор NDJSON agy 1.3.1.\n\n        `step_update.agent_response` несёт накопительный `text_delta` — наружу\n        уходит только хвост. `step_update.tool` — трассировка нативного\n        инструмента (в stderr моста). `result` — финальный текст, usage, ошибка.\n\n        После EOF: ждём выход процесса не дольше PROC_EXIT_WAIT_S, затем даём\n        источнику мышления дренировать окно DRAIN_WINDOW_S (join с бюджетом) и\n        только потом ставим (\"done\", …). Терминальное событие кладётся ровно один\n        раз в `finally`, поэтому очередь закрывается при любом исходе.\n        \"\"\"\n        final_text = \"\"\n        result_ev = {}\n        tool_ordinal = 0\n        tool_ordinal_by_id: dict[str, int] = {}\n        term_kind = \"pump_error\"\n        term_payload: object = \"pump terminated\"\n        try:\n            for raw in iter(self.proc.stdout.readline, b\"\"):\n                line = raw.decode(\"utf-8\", \"replace\").strip()\n                if not line.startswith(\"{\"):\n                    continue\n                try:\n                    ev = json.loads(line)\n                except ValueError:\n                    continue\n                self.got_event = True\n                self.note_producer_activity(\"stdout\")\n                etype = ev.get(\"event\")\n                if etype == \"init\":\n                    init = ev.get(\"init\") if isinstance(ev.get(\"init\"), dict) else {}\n                    tools_raw = cast(object, init.get(\"tools\"))\n                    tools = (\n                        cast(\"list[object]\", tools_raw)\n                        if isinstance(tools_raw, list)\n                        else []\n                    )\n                    self.q.put(\n                        (\n                            \"init\",\n                            {\n                                \"conversation_id\": ev.get(\"conversation_id\") or \"\",\n                                \"tools\": len(tools),\n                                \"permission_mode\": init.get(\"permission_mode\") or \"\",\n                            },\n                        )\n                    )\n                    self._tail.bind(str(ev.get(\"conversation_id\") or \"\"))\n                elif etype == \"step_update\":\n                    step = (\n                        ev.get(\"step_update\")\n                        if isinstance(ev.get(\"step_update\"), dict)\n                        else {}\n                    )\n                    kind = step.get(\"step_type\")\n                    if kind == \"agent_response\" and step.get(\"text_delta\"):\n                        if self.content_streaming:\n                            _ = self.offer_content(\n                                \"stdout\",\n                                _as_int(step.get(\"step_index\")),\n                                str(step[\"text_delta\"]),\n                            )\n                        else:\n                            suffix = _reasoning_suffix(\n                                self._text_seen,\n                                str(step.get(\"step_index\", \"\")),\n                                str(step[\"text_delta\"]),\n                            )\n                            if suffix:\n                                self.q.put((\"text\", suffix))\n                    elif kind == \"tool\" and step.get(\"state\") == \"DONE\":\n                        step_idx = _as_int(step.get(\"step_index\"))\n                        trace: dict[str, object] = {\n                            \"name\": str(step.get(\"tool_name\") or \"tool\"),\n                            \"duration_s\": step.get(\"duration_seconds\"),\n                            \"step_index\": step_idx,\n                        }\n                        if step_idx is None:\n                            # Идентичность DONE без step_index: монотонный ordinal хода,\n                            # назначается один раз и переживает повторную доставку события.\n                            raw_id = (\n                                step.get(\"call_id\")\n                                or step.get(\"tool_call_id\")\n                                or step.get(\"id\")\n                            )\n                            call_id = (\n                                str(raw_id).strip()\n                                if isinstance(raw_id, (str, int))\n                                else \"\"\n                            )\n                            if call_id:\n                                # Повтор события с тем же call_id получает тот же ordinal.\n                                ord_val = tool_ordinal_by_id.get(call_id)\n                                if ord_val is None:\n                                    tool_ordinal += 1\n                                    ord_val = tool_ordinal\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"scripts/smoke_models.py — Универсальный смоук-раннер моделей по models.md (L3)\n     3\t\n     4\tПозволяет автоматически проверять доступность и работоспособность моделей из\n     5\tканонического файла ~/Мой диск/Context/models.md через мост-шлюз cli-agent-bridge.\n     6\t\n     7\tИспользование:\n     8\t    python3 scripts/smoke_models.py --dry-run\n     9\t    python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1\n    10\t    python3 scripts/smoke_models.py --live --model claude-sonnet-5-5\n    11\t\"\"\"\n    12\t\n    13\tfrom __future__ import annotations\n    14\t\n    15\timport argparse\n    16\timport json\n    17\timport os\n    18\tfrom pathlib import Path\n    19\timport re\n    20\timport sys\n    21\timport time\n    22\timport urllib.error\n    23\timport urllib.request\n    24\tfrom typing import Any, NamedTuple\n    25\t\n    26\t\n    27\tDEFAULT_MODELS_MD = Path(\n    28\t    os.environ.get(\"MODELS_MD_PATH\") or \"~/Мой диск/Context/models.md\"\n    29\t).expanduser()\n    30\tDEFAULT_HUB_URL = os.environ.get(\"HUB_BRIDGE_URL\", \"http://127.0.0.1:9882/v1\")\n    31\t\n    32\t\n    33\tclass ModelEntry(NamedTuple):\n    34\t    role: str\n    35\t    model_id: str\n    36\t    effort: str\n    37\t    family: str\n    38\t\n    39\t\n    40\tdef parse_models_md(path: Path) -> list[ModelEntry]:\n    41\t    \"\"\"Извлечь уникальные модели и роли из models.md.\"\"\"\n    42\t    if not path.is_file():\n    43\t        raise FileNotFoundError(f\"Канонический файл models.md не найден: {path}\")\n    44\t\n    45\t    content = path.read_text(encoding=\"utf-8\")\n    46\t    entries: list[ModelEntry] = []\n    47\t    current_role = \"General\"\n    48\t\n    49\t    # Регулярное выражение для строк вида:\n    50\t    # | `claude-sonnet-5-5` | `high` | Anthropic | ... |\n    51\t    row_pattern = re.compile(\n    52\t        r\"^\\|\\s*`?([a-zA-Z0-9.\\-_]+)`?\\s*\\|\\s*`?([a-zA-Z0-9]+)`?\\s*\\|\\s*([a-zA-Z0-9.\\s]+)\\s*\\|\"\n    53\t    )\n    54\t\n    55\t    for line in content.splitlines():\n    56\t        line = line.strip()\n    57\t        if line.startswith(\"### \"):\n    58\t            header = line[4:].strip()\n    59\t            # Извлекаем роль из заголовка (например \"### Coder — пул разработки...\")\n    60\t            current_role = header.split(\"—\")[0].split(\"-\")[0].strip()\n    61\t            continue\n    62\t\n    63\t        match = row_pattern.match(line)\n    64\t        if match:\n    65\t            model_id = match.group(1).strip()\n    66\t            effort = match.group(2).strip()\n    67\t            family = match.group(3).strip()\n    68\t            # Пропускаем заголовки таблиц\n    69\t            if model_id.lower() in (\"модель\", \"слот\", \"пакет\", \"№\", \"роль\"):\n    70\t                continue\n    71\t            entries.append(ModelEntry(current_role, model_id, effort, family))\n    72\t\n    73\t    # Дедупликация по паре (role, model_id)\n    74\t    seen = set()\n    75\t    unique_entries = []\n    76\t    for e in entries:\n    77\t        key = (e.role, e.model_id)\n    78\t        if key not in seen:\n    79\t            seen.add(key)\n    80\t            unique_entries.append(e)\n    81\t\n    82\t    return unique_entries\n    83\t\n    84\t\n    85\tdef mask_secret(text: str) -> str:\n    86\t    \"\"\"Маскирование токенов и авторизационных заголовков.\"\"\"\n    87\t    return re.sub(\n    88\t        r\"(Bearer\\s+|api[_-]?key[:=]\\s*)[a-zA-Z0-9_\\-\\.]{8,}\",\n    89\t        r\"\\1[MASKED]\",\n    90\t        text,\n    91\t        flags=re.IGNORECASE,\n    92\t    )\n    93\t\n    94\t\n    95\tdef smoke_test_model(\n    96\t    hub_url: str,\n    97\t    model_id: str,\n    98\t    timeout_s: float = 20.0,\n    99\t    api_key: str | None = None,\n   100\t) -> tuple[bool, str, float]:\n   101\t    \"\"\"Выполнить смоук-запрос к модели через OpenAI-совместимый SSE-стрим с замером TTFT.\"\"\"\n   102\t    key = api_key or os.environ.get(\"BRIDGE_KEY\") or os.environ.get(\"HUB_API_KEY\")\n   103\t    if not key:\n   104\t        dsh_env = Path.home() / \".dsh\" / \".env\"\n   105\t        if dsh_env.is_file():\n   106\t            try:\n   107\t                for line in dsh_env.read_text(encoding=\"utf-8\").splitlines():\n   108\t                    if line.startswith(\"BRIDGE_KEY=\"):\n   109\t                        key = line.split(\"=\", 1)[1].strip()\n   110\t                        break\n   111\t            except OSError:\n   112\t                pass\n   113\t    if not key:\n   114\t        key = os.environ.get(\"OPENAI_API_KEY\") or \"test-smoke-key\"\n   115\t\n   116\t    endpoint = hub_url.rstrip(\"/\") + \"/chat/completions\"\n   117\t    payload = {\n   118\t        \"model\": model_id,\n   119\t        \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}],\n   120\t        \"max_tokens\": 15,\n   121\t        \"stream\": True,\n   122\t    }\n   123\t    data_bytes = json.dumps(payload).encode(\"utf-8\")\n   124\t    req = urllib.request.Request(\n   125\t        endpoint,\n   126\t        data=data_bytes,\n   127\t        method=\"POST\",\n   128\t    )\n   129\t    req.add_header(\"Content-Type\", \"application/json\")\n   130\t    req.add_header(\"Authorization\", f\"Bearer {key}\")\n   131\t\n   132\t    t0 = time.monotonic()\n   133\t    ttft: float | None = None\n   134\t    got_done = False\n   135\t    try:\n   136\t        with urllib.request.urlopen(req, timeout=timeout_s) as resp:\n   137\t            status_code = resp.getcode()\n   138\t            if status_code != 200:\n   139\t                return False, f\"HTTP {status_code}\", time.monotonic() - t0\n   140\t            for raw_line in resp:\n   141\t                line = raw_line.decode(\"utf-8\", \"replace\").strip()\n   142\t                if not line or not line.startswith(\"data:\"):\n   143\t                    continue\n   144\t                data_str = line[5:].strip()\n   145\t                if data_str == \"[DONE]\":\n   146\t                    got_done = True\n   147\t                    break\n   148\t                try:\n   149\t                    chunk = json.loads(data_str)\n   150\t                    choices = chunk.get(\"choices\") or []\n   151\t                    if choices:\n   152\t                        delta = choices[0].get(\"delta\") or {}\n   153\t                        if (\n   154\t                            delta.get(\"content\")\n   155\t                            or delta.get(\"reasoning_content\")\n   156\t                            or delta.get(\"thinking\")\n   157\t                        ):\n   158\t                            if ttft is None:\n   159\t                                ttft = time.monotonic() - t0\n   160\t                except ValueError:\n   161\t                    pass\n   162\t            elapsed = time.monotonic() - t0\n   163\t            display_time = ttft if ttft is not None else elapsed\n   164\t            if ttft is not None:\n   165\t                return True, \"STREAM_OK\", display_time\n   166\t            if got_done:\n   167\t                return True, \"DONE_OK\", elapsed\n   168\t            return False, \"No stream chunks\", elapsed\n   169\t    except urllib.error.HTTPError as e:\n   170\t        elapsed = time.monotonic() - t0\n   171\t        err_msg = mask_secret(f\"HTTP {e.code}: {e.reason}\")\n   172\t        return False, err_msg, elapsed\n   173\t    except Exception as e:\n   174\t        elapsed = time.monotonic() - t0\n   175\t        return False, mask_secret(f\"Error: {e}\"), elapsed\n   176\t\n   177\t\n   178\tdef main() -> int:\n   179\t    parser = argparse.ArgumentParser(\n   180\t        description=\"Smoke test runner for models defined in models.md\"\n   181\t    )\n   182\t    parser.add_argument(\n   183\t        \"--models-md\",\n   184\t        type=Path,\n   185\t        default=DEFAULT_MODELS_MD,\n   186\t        help=\"Path to Context/models.md\",\n   187\t    )\n   188\t    parser.add_argument(\n   189\t        \"--hub-url\",\n   190\t        type=str,\n   191\t        default=DEFAULT_HUB_URL,\n   192\t        help=\"URL of the bridge hub endpoint\",\n   193\t    )\n   194\t    parser.add_argument(\n   195\t        \"--model\",\n   196\t        type=str,\n   197\t        default=\"\",\n   198\t        help=\"Filter by specific model ID\",\n   199\t    )\n   200\t    parser.add_argument(\n   201\t        \"--dry-run\",\n   202\t        action=\"store_true\",\n   203\t        help=\"Validate configuration and parse models without sending network requests\",\n   204\t    )\n   205\t    parser.add_argument(\n   206\t        \"--live\",\n   207\t        action=\"store_true\",\n   208\t        help=\"Execute live HTTP smoke requests against the hub\",\n   209\t    )\n   210\t    parser.add_argument(\n   211\t        \"--timeout\",\n   212\t        type=float,\n   213\t        default=15.0,\n   214\t        help=\"Request timeout in seconds\",\n   215\t    )\n   216\t\n   217\t    args = parser.parse_args()\n   218\t\n   219\t    models = parse_models_md(args.models_md)\n   220\t    if args.model:\n   221\t        models = [m for m in models if m.model_id == args.model]\n   222\t\n   223\t    if not models:\n   224\t        print(\"FAIL: No models found matching criteria.\")\n   225\t        return 1\n   226\t\n   227\t    print(f\"=== Smoke Models Matrix (Found {len(models)} model entries) ===\")\n   228\t    print(f\"{'Role':<15} | {'Model ID':<25} | {'Family':<15} | {'Status':<15} | {'Latency':<10}\")\n   229\t    print(\"-\" * 88)\n   230\t\n   231\t    all_ok = True\n   232\t    for entry in models:\n   233\t        if args.dry_run or not args.live:\n   234\t            status = \"CONFIGURED\"\n   235\t            latency_str = \"-\"\n   236\t        else:\n   237\t            ok, status, lat = smoke_test_model(\n   238\t                args.hub_url, entry.model_id, timeout_s=args.timeout\n   239\t            )\n   240\t            latency_str = f\"{lat:.2f}s\"\n   241\t            if not ok:\n   242\t                all_ok = False\n   243\t\n   244\t        print(\n   245\t            f\"{entry.role:<15} | {entry.model_id:<25} | {entry.family:<15} | {status:<15} | {latency_str:<10}\"\n   246\t        )\n   247\t\n   248\t    if args.dry_run:\n   249\t        print(\"\\nPASS: Configuration is valid (dry-run mode).\")\n   250\t        return 0\n   251\t\n   252\t    if not args.live:\n   253\t        print(\"\\nNOTE: Run with --live to perform actual network requests, or --dry-run for validation.\")\n   254\t        return 0\n   255\t\n   256\t    return 0 if all_ok else 1\n   257\t\n   258\t\n   259\tif __name__ == \"__main__\":\n   260\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"Вижу разрыв между двумя источниками текста: изоляция преамбул есть в обработчике транскрипта, а stdout направляет текст прямо в content. Также L3 возвращает STREAM_OK после первого полезного чанка, не требуя `[DONE]`. Проверяю обработку шагов без индекса и полноту списка моделей.\n"}}
