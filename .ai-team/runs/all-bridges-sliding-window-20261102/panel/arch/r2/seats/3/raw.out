ine.startswith(\"#\") or \"=\" not in line:\n   101\t                       continue\n   102\t                   if line.startswith(\"export \"):\n   103\t                       line = line[len(\"export \"):].strip()\n   104\t                   k, v = line.split(\"=\", 1)\n   105\t                   k = k.strip()\n   106\t                   v = v.strip().strip(\"'\\\"\")\n   107\t                   if k in _ALLOWED_SETTINGS_KEYS:\n   108\t                       res[k] = v\n   109\t       except OSError:\n   110\t           pass\n   111\t       return res\n   112\t\n   113\t   _DSH_ENV = _read_dsh_env_file()\n   114\t\n   115\t   def _get_setting(name: str, fallback_name: str | None = None, default: str = \"\") -> str:\n   116\t       \"\"\"Двухступенчатый каскад чтения: os.environ -> _DSH_ENV -> fallback -> default.\"\"\"\n   117\t       for k in (name, fallback_name) if fallback_name else (name,):\n   118\t           val = os.environ.get(k)\n   119\t           if val is not None and val.strip():\n   120\t               return val.strip()\n   121\t           val = _DSH_ENV.get(k)\n   122\t           if val is not None and val.strip():\n   123\t               return val.strip()\n   124\t       return default\n   125\t\n   126\t   def _get_positive_float(name: str, fallback_name: str | None = None, default: float = 0.0) -> float:\n   127\t       raw = _get_setting(name, fallback_name)\n   128\t       if not raw:\n   160\t\n   161\t4. **В методе `_execute` (в классе `Handler`):**\n   162\t   - До блока `try:` объявляется контроллер и отметка времени последней проверки с безопасным чтением процесса (защита от отсутствия атрибута `proc` в `FakeRun`):\n   163\t     ```python\n   164\t     controller = None\n   165\t     last_check_ts = time.monotonic()\n   166\t     proc = getattr(run, \"proc\", None)\n   167\t     proc_pid = getattr(proc, \"pid\", None) if proc is not None else None\n   168\t\n   169\t     if _is_watchdog_enabled() and AdaptiveTimeoutController is not No