{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py'","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"OpenAI-совместимый мост к CLI `claude -p` (Claude Code).\n     3\t\n     4\tОдин запрос /v1/chat/completions = один headless-ход\n     5\t`claude -p --output-format stream-json --verbose --include-partial-messages`.\n     6\tПоток stream-json переводится в OpenAI Chat Completions (stream и не-stream).\n     7\t\n     8\tМост эмулирует OpenAI function calling: если запрос содержит непустой `tools`,\n     9\tв промпт добавляется протокол и схемы инструментов, а встроенные инструменты\n    10\tClaude Code отключаются (`--tools \"\"`). Модель просят отвечать блоками\n    11\t`<tool_call>{\"name\":…,\"arguments\":{…}}</tool_call>`; потоковые блоки переводятся\n    12\tв OpenAI-чанки `delta.tool_calls`, история с `tool_calls`/`role:\"tool\"`\n    13\tрендерится обратно в те же блоки.\n    14\t\n    15\tОбщая протокольная логика живёт только в универсальном ядре `core/` (ADR 0014,\n    16\tAD-002: этот файл в репозитории — SSOT, локальных копий парсера нет; без core\n    17\tмост не стартует). Весь поток Claude всегда проходит через\n    18\t`core.tool_emulation.StreamNormalizer` поверх\n    19\t`ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON): повреждённый XML не\n    20\tпопадает в `content`, fallback на терминальный `result` исключён, ошибка\n    21\tпотока — корректный `502 proxy_error`.\n    22\t\n    23\tИзображения (`image_url` data URI PNG/JPEG) мост материализует в изолированный\n    24\tсессионный каталог `/tmp/claude-img-<uuid>/` (0700, файлы 0600) и запускает\n    25\tClaude с `--allowedTools \"Read(<каталог>/**)\"`, `--restricted` и\n    26\t`--add-dir <каталог>` (AD-003, workspace-read);\n    27\tкаталог удаляется в `finally` после подтверждённого завершения ребёнка. Без\n    28\tкартинок сохраняется прежний режим `--tools \"\"`.\n    29\t\n    30\tReasoning публикуется в реальном времени (AD-005): нативные `thinking_delta` и\n    31\tтеги размышлений в тексте уходят в SSE как `choices[0].delta.reasoning_content`\n    32\tдо терминального события; в JSON тот же накопленный итог отдаётся как\n    33\t`message.reasoning_content`.\n    34\t\n    35\tСекреты с диска не читаются: ключ авторизации берётся только из окружения\n    36\tCLAUDE_P_BRIDGE_KEY, переменные окружения ребёнка не трогаются.\n    37\t\"\"\"\n    38\t\n    39\tfrom __future__ import annotations\n    40\t\n    41\timport hmac\n    42\timport json\n    43\timport os\n    44\timport queue\n    45\timport select\n    46\timport shutil\n    47\timport signal\n    48\timport socket\n    49\timport subprocess\n    50\timport sys\n    51\timport threading\n    52\timport time\n    53\timport uuid\n    54\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n    55\tfrom pathlib import Path\n    56\tfrom typing import Any\n    57\t\n    58\t_REPO_ROOT = Path(__file__).resolve().parents[2]\n    59\tfor _p in (_REPO_ROOT, Path(__file__).resolve().parents[1]):\n    60\t    if str(_p) not in sys.path:\n    61\t        sys.path.insert(0, str(_p))\n    62\t\n    63\ttry:\n    64\t    from core.stream_framing import format_stream_error_sse\n    65\t    from core.tool_emulation import (  # noqa: E402\n    66\t        DEFAULT_MAX_IMAGE_BYTES,\n    67\t        DEFAULT_MAX_IMAGES,\n    68\t        DEFAULT_MAX_TOTAL_IMAGE_BYTES,\n    69\t        ImageInputError,\n    70\t        LiveParserError,\n    71\t        StreamNormalizer,\n    72\t        _messages_to_prompt,\n    73\t        _tool_choice_none,\n    74\t        build_tool_schemas,\n    75\t        extract_data_url_images,\n    76\t        extract_thinking_delta,\n    77\t        sanitize_tool_call,\n    78\t    )\n    79\texcept ImportError as exc:\n    80\t    # Fail-closed (AD-002): без согласованного core мост не запускается;\n    81\t    # встроенной запасной копии парсера не существует.\n    82\t    sys.stderr.write(\n    83\t        \"claude-p-bridge: core.tool_emulation is required \"\n    84\t        f\"(repo root {_REPO_ROOT}): {exc}\\n\"\n    85\t    )\n    86\t    raise SystemExit(1) from exc\n    87\t\n    88\t\n    89\tdef _env_positive_int(name: str, default: int) -> int:\n    90\t    \"\"\"Положительное целое из env; пустое/нечисловое/неположительное -> default.\"\"\"\n    91\t    raw = os.environ.get(name, \"\").strip()\n    92\t    if not raw:\n    93\t        return default\n    94\t    try:\n    95\t        value = int(raw)\n    96\t    except ValueError:\n    97\t        return default\n    98\t    return value if value > 0 else default\n    99\t\n   100\t\n   101\tROOT = Path(__file__).resolve().parent\n   102\tHOST = os.environ.get(\"CLAUDE_P_BRIDGE_HOST\", \"127.0.0.1\")\n   103\tPORT = int(os.environ.get(\"CLAUDE_P_BRIDGE_PORT\", \"9881\"))\n   104\tAUTH_KEY = os.environ.get(\"CLAUDE_P_BRIDGE_KEY\", \"\").strip()\n   105\tMODEL_ID = os.environ.get(\"CLAUDE_P_BRIDGE_MODEL\", \"claude-sonnet-5-5\")\n   106\t# Поддерживаемые модели -> уровень effort по умолчанию (если reasoning_effort не задан).\n   107\tSUPPORTED_MODELS = {\n   108\t    \"claude-opus-5-5\": \"high\",\n   109\t    \"claude-sonnet-5-5\": \"high\",\n   110\t    \"claude-haiku-5-5\": \"high\",\n   111\t}\n   112\tCLAUDE_BIN = os.environ.get(\n   113\t    \"CLAUDE_P_BRIDGE_BIN\",\n   114\t    shutil.which(\"claude\") or os.path.expanduser(\"~/.local/bin/claude\")\n   115\t)\n   116\tMCP_CONFIG = ROOT / \"empty-mcp.json\"\n   117\tWORKSPACE = ROOT / \"workspace\"\n   118\t\n   119\t\n   120\t_CLAUDE_HOME_LOCK = threading.Lock()\n   121\t_CLAUDE_HOME_INITIALIZED = False\n   122\t\n   123\t\n   124\tdef _prepare_claude_home() -> Path:\n   125\t    \"\"\"Подготовить изолированный фиктивный HOME для claude -p (P0/P2 Zero-Canon).\n   126\t\n   127\t    В ~/.claude/ переносятся только файлы авторизации, настроек и сертификатов,\n   128\t    без глобальных инструкций (agents-global.md, CLAUDE.md) и пользовательских расширений.\n   129\t    Защита от race condition (F-001): потокобезопасная однократная инициализация под lock,\n   130\t    атомарная запись через временный файл (os.replace) и строгие права 0700/0600.\n   131\t    \"\"\"\n   132\t    global _CLAUDE_HOME_INITIALIZED\n   133\t    real_claude = Path.home() / \".claude\"\n   134\t    home = WORKSPACE / \"runtime\" / \"claude-home\"\n   135\t    claude_dir = home / \".claude\"\n   136\t\n   137\t    if _CLAUDE_HOME_INITIALIZED and claude_dir.is_dir():\n   138\t        return home\n   139\t\n   140\t    with _CLAUDE_HOME_LOCK:\n   141\t        if _CLAUDE_HOME_INITIALIZED and claude_dir.is_dir():\n   142\t            return home\n   143\t\n   144\t        home.mkdir(parents=True, exist_ok=True)\n   145\t        claude_dir.mkdir(parents=True, exist_ok=True)\n   146\t        try:\n   147\t            os.chmod(claude_dir, 0o700)\n   148\t        except OSError:\n   149\t            pass\n   150\t\n   151\t        allowed_files = (\n   152\t            \"settings.json\",\n   153\t            \"aeza-8788-ca.pem\",\n   154\t            \"bundle-with-aeza.pem\",\n   155\t            \"policy-limits.json\",\n   156\t            \"policy-limits.json.signature.json\",\n   157\t            \"policy-limits.json.stamp.json\",\n   158\t        )\n   159\t\n   160\t        for name in allowed_files:\n   161\t            source = real_claude / name\n   162\t            if source.is_file():\n   163\t                dest = claude_dir / name\n   164\t                tmp_dest = claude_dir / f\".tmp_{name}_{uuid.uuid4().hex[:8]}\"\n   165\t                try:\n   166\t                    shutil.copy2(source, tmp_dest)\n   167\t                    os.chmod(tmp_dest, 0o600)\n   168\t                    os.replace(tmp_dest, dest)\n   169\t                except OSError:\n   170\t                    if tmp_dest.exists():\n   171\t                        try:\n   172\t                            tmp_dest.unlink()\n   173\t                        except OSError:\n   174\t                            pass\n   175\t\n   176\t        _CLAUDE_HOME_INITIALIZED = True\n   177\t        return home\n   178\tMAX_CONCURRENT = int(os.environ.get(\"CLAUDE_P_BRIDGE_MAX_CONCURRENT\", \"8\"))\n   179\tQUEUE_TIMEOUT_S = int(os.environ.get(\"CLAUDE_P_BRIDGE_QUEUE_TIMEOUT\", \"900\"))\n   180\tKEEPALIVE_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_KEEPALIVE\", \"15\"))\n   181\tMAX_REQUEST_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_BODY_BYTES\", 100 * 1024 * 1024)\n   182\tQUEUE_MAXSIZE = _env_positive_int(\"CLAUDE_P_BRIDGE_QUEUE_MAXSIZE\", 1000)\n   183\tMAX_STDERR_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_STDERR_BYTES\", 10 * 1024 * 1024)\n   184\tIO_CHUNK_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_IO_CHUNK_BYTES\", 64 * 1024)\n   185\tPROCESS_WAIT_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_PROCESS_WAIT_S\", \"5\"))\n   186\tPOLL_INTERVAL_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_POLL_INTERVAL_S\", \"1\"))\n   187\tSTDERR_DRAIN_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_STDERR_DRAIN_S\", \"0.05\"))\n   188\tHTTP_TIMEOUT_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_HTTP_TIMEOUT_S\", \"300\"))\n   189\tHTTP_BACKLOG = _env_positive_int(\"CLAUDE_P_BRIDGE_HTTP_BACKLOG\", 64)\n   190\t# Лимиты и корень временных каталогов изображений — только через env с безопасными\n   191\t# значениями по умолчанию из core (без хардкода эксплуатационных параметров).\n   192\tMAX_IMAGES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_IMAGES\", DEFAULT_MAX_IMAGES)\n   193\tMAX_IMAGE_BYTES = _env_positive_int(\n   194\t    \"CLAUDE_P_BRIDGE_MAX_IMAGE_BYTES\", DEFAULT_MAX_IMAGE_BYTES\n   195\t)\n   196\tMAX_TOTAL_IMAGE_BYTES = _env_positive_int(\n   197\t    \"CLAUDE_P_BRIDGE_MAX_TOTAL_IMAGE_BYTES\", DEFAULT_MAX_TOTAL_IMAGE_BYTES\n   198\t)\n   199\tIMAGE_TMP_ROOT = Path(os.environ.get(\"CLAUDE_P_BRIDGE_TMPDIR\", \"/tmp\"))\n   200\tMODEL_CONTEXT = {\n   201\t    \"claude-sonnet-5-5\": 1_000_000,\n   202\t    \"claude-opus-5-5\": 1_000_000,\n   203\t    \"claude-haiku-5-5\": 200_000,\n   204\t}\n   205\tCONTEXT_LENGTH = 1_000_000  # fallback для неизвестных моделей\n   206\tTOOL_CALL_OPEN = \"<tool_call>\"\n   207\tTOOL_CALL_CLOSE = \"</tool_call>\"\n   208\t\n   209\t_slots = threading.BoundedSemaphore(MAX_CONCURRENT)\n   210\t_active = {}\n   211\t_active_img_dirs: set = set()\n   212\t_active_lock = threading.Lock()\n   213\t_started = time.time()\n   214\t\n   215\t\n   216\tdef _log(msg: str) -> None:\n   217\t    \"\"\"Диагностика в stderr (файлы вне каталога моста не создаём).\"\"\"\n   218\t    try:\n   219\t        sys.stderr.write(\n   220\t            f\"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}\\n\"\n   221\t        )\n   222\t        sys.stderr.flush()\n   223\t    except OSError:\n   224\t        pass\n   225\t\n   226\t\n   227\tdef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n   228\t    hdr = handler.headers.get(\"Authorization\", \"\")\n   229\t    expected = AUTH_KEY.encode(\"utf-8\")\n   230\t    if hdr.startswith(\"Bearer \"):\n   231\t        return hmac.compare_digest(hdr[7:].strip().encode(\"utf-8\"), expected)\n   232\t    return hmac.compare_digest(\n   233\t        handler.headers.get(\"x-api-key\", \"\").encode(\"utf-8\"), expected\n   234\t    ) or hmac.compare_digest(hdr.strip().encode(\"utf-8\"), expected)\n   235\t\n   236\t\n   237\tdef _extract_request_images(req: dict) -> list:\n   238\t    \"\"\"Изображения всей истории `messages` -> [{\"name\", \"mime\", \"data\"}] (core, AD-003).\"\"\"\n   239\t    messages = req.get(\"messages\") if isinstance(req.get(\"messages\"), list) else []\n   240\t    return extract_data_url_images(\n   241\t        messages,\n   242\t        max_images=MAX_IMAGES,\n   243\t        max_image_bytes=MAX_IMAGE_BYTES,\n   244\t        max_total_bytes=MAX_TOTAL_IMAGE_BYTES,\n   245\t    )\n   246\t\n   247\t\n   248\tdef _stage_images(images: list) -> Path | None:\n   249\t    \"\"\"Материализовать изображения в `/tmp/claude-img-<uuid>/` (0700, файлы 0600).\n   250\t\n   251\t    Каталог создаётся атомарно без изменения глобального umask, файлы —\n   252\t    exclusive/no-follow созданием. При частичной ошибке каталог удаляется здесь же.\n   253\t    \"\"\"\n   254\t    if not images:\n   255\t        return None\n   256\t    img_dir = IMAGE_TMP_ROOT / f\"claude-img-{uuid.uuid4().hex}\"\n   257\t    os.mkdir(img_dir, 0o700)\n   258\t    os.chmod(img_dir, 0o700)\n   259\t    try:\n   260\t        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, \"O_NOFOLLOW\", 0)\n   261\t        for image in images:\n   262\t            target = img_dir / image[\"name\"]\n   263\t            fd = os.open(target, flags, 0o600)\n   264\t            try:\n   265\t                view = memoryview(image[\"data\"])\n   266\t                while view:\n   267\t                    view = view[os.write(fd, view) :]\n   268\t            finally:\n   269\t                os.close(fd)\n   270\t            os.chmod(target, 0o600)\n   271\t    except BaseException:\n   272\t        shutil.rmtree(img_dir, ignore_errors=True)\n   273\t        raise\n   274\t    with _active_lock:\n   275\t        _active_img_dirs.add(img_dir)\n   276\t    return img_dir\n   277\t\n   278\t\n   279\tdef _cleanup_img_dir(img_dir: Path | None) -> None:\n   280\t    \"\"\"Гарантированное удаление сессионного каталога картинок своего хода.\"\"\"\n   281\t    if img_dir is None:\n   282\t        return\n   283\t    with _active_lock:\n   284\t        _active_img_dirs.discard(Path(img_dir))\n   285\t    shutil.rmtree(img_dir, ignore_errors=True)\n   286\t\n   287\t\n   288\tdef _build_claude_cmd(model: str, effort: str, img_dir: Path | None = None) -> list:\n   289\t    \"\"\"argv `claude -p`; с картинками — только встроенный Read по `--add-dir` (AD-003).\"\"\"\n   290\t    cmd = [\n   291\t        CLAUDE_BIN, \"-p\",\n   292\t        \"--model\", model,\n   293\t        \"--effort\", effort,\n   294\t        \"--output-format\", \"stream-json\",\n   295\t        \"--verbose\",\n   296\t        \"--include-partial-messages\",\n   297\t        \"--strict-mcp-config\",\n   298\t        \"--mcp-config\", str(MCP_CONFIG),\n   299\t    ]\n   300\t    if img_dir is not None:\n   301\t        cmd += [\"--permission-mode\", \"dontAsk\",\n   302\t                \"--tools\", \"Read\", \"--allowedTools\", f\"Read({img_dir}/**)\",\n   303\t                \"--add-dir\", str(img_dir)]\n   304\t    else:\n   305\t        # Встроенные инструменты отключены: действия идут только через DSH.\n   306\t        cmd += [\"--permission-mode\", \"bypassPermissions\", \"--tools\", \"\"]\n   307\t    return cmd\n   308\t\n   309\t\n   310\tdef _effort(value: Any, model: str = MODEL_ID) -> str:\n   311\t    \"\"\"reasoning_effort -> уровень claude для модели (замеры KB 13.10/19.10.2026).\n   312\t\n   313\t    Opus 5.5: low/medium/high; xhigh и max -> high. Sonnet 5.5: low/medium/high/xhigh;\n   314\t    max -> xhigh. Haiku 5.5: low/medium/high/xhigh/max (max не по умолчанию: 300 с+\n   315\t    против 25-40 с на high). Всё остальное (none/пусто/мусор) -> дефолт модели `high`.\n   316\t    \"\"\"\n   317\t    eff = str(value or \"\").strip().lower()\n   318\t    default = SUPPORTED_MODELS.get(model, \"high\")\n   319\t    if model == \"claude-haiku-5-5\":\n   320\t        return eff if eff in (\"low\", \"medium\", \"high\", \"xhigh\", \"max\") else default\n   321\t    if model == \"claude-sonnet-5-5\":\n   322\t        if eff == \"max\":\n   323\t            return \"xhigh\"\n   324\t        return eff if eff in (\"low\", \"medium\", \"high\", \"xhigh\") else default\n   325\t    if eff in (\"xhigh\", \"max\"):\n   326\t        return \"high\"\n   327\t    return eff if eff in (\"low\", \"medium\", \"high\") else default\n   328\t\n   329\t\n   330\tdef _resolve_model(req: dict) -> tuple[str, dict | None]:\n   331\t    \"\"\"Модель запроса (fallback MODEL_ID) и тело ошибки 400, если модель не поддержана.\"\"\"\n   332\t    raw = req.get(\"model\")\n   333\t    model = str(raw).strip() if raw else MODEL_ID\n   334\t    if model not in SUPPORTED_MODELS:\n   335\t        return model, {\"message\": f\"model not allowed: {model}\",\n   336\t                       \"type\": \"invalid_request_error\", \"code\": 400}\n   337\t    return model, None\n   338\t\n   339\t\n   340\tdef _kill_group(proc: subprocess.Popen) -> None:\n   341\t    \"\"\"SIGTERM процессной группе, затем SIGKILL, если не завершилась.\"\"\"\n   342\t    for sig in (signal.SIGTERM, signal.SIGKILL):\n   343\t        try:\n   344\t            os.killpg(proc.pid, sig)\n   345\t        except (ProcessLookupError, PermissionError):\n   346\t            return\n   347\t        try:\n   348\t            proc.wait(timeout=PROCESS_WAIT_S)\n   349\t            return\n   350\t        except subprocess.TimeoutExpired:\n   351\t            continue\n   352\t\n   353\t\n   354\tdef _kill_all(*_: Any) -> None:\n   355\t    with _active_lock:\n   356\t        procs = list(_active.values())\n   357\t        img_dirs = list(_active_img_dirs)\n   358\t    reaped = True\n   359\t    for proc in procs:\n   360\t        try:\n   361\t            os.killpg(proc.pid, signal.SIGKILL)\n   362\t        except (ProcessLookupError, PermissionError):\n   363\t            pass\n   364\t    for proc in procs:\n   365\t        try:\n   366\t            proc.wait(timeout=PROCESS_WAIT_S)\n   367\t        except subprocess.TimeoutExpired:\n   368\t            reaped = False\n   369\t    if reaped:\n   370\t        for img_dir in img_dirs:  # только свои сессионные каталоги картинок\n   371\t            _cleanup_img_dir(img_dir)\n   372\t    _log(f\"shutdown: killed {len(procs)} child process group(s)\")\n   373\t    os._exit(0)\n   374\t\n   375\t\n   376\tclass Run:\n   377\t    \"\"\"Один процесс `claude -p`; поток-читатель превращает stdout в события очереди.\"\"\"\n   378\t\n   379\t    def __init__(self, prompt: str, model: str, effort: str, tag: str,\n   380\t                 img_dir: Path | None = None):\n   381\t        WORKSPACE.mkdir(parents=True, exist_ok=True)\n   382\t        # С картинками Claude работает из сессионного каталога вложений: пути\n   383\t        # в секции [attachments] относительные, Read ограничен этим каталогом.\n   384\t        cmd = _build_claude_cmd(model, effort, img_dir)\n   385\t        self.cmd = cmd\n   386\t        self.img_dir = img_dir\n   387\t        _log(f\"exec model={model} effort={effort} prompt_bytes={len(prompt.encode())} {tag}\")\n   388\t        child_env = os.environ.copy()\n   389\t        child_env[\"HOME\"] = str(_prepare_claude_home())\n   390\t        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n   391\t        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n   392\t\n   393\t        self.proc = subprocess.Popen(\n   394\t            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n   395\t            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n   396\t            start_new_session=True, env=child_env,\n   397\t        )\n   398\t        with _active_lock:\n   399\t            _active[self.proc.pid] = self.proc\n   400\t        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n   401\t        self._closed = threading.Event()\n   402\t        self.err_box = []\n   403\t        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n   404\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n   405\t        threading.Thread(target=self._pump, daemon=True).start()\n   406\t\n   407\t    def _feed(self, prompt: str) -> None:\n   408\t        \"\"\"Промпт уходит только через stdin.\"\"\"\n   409\t        try:\n   410\t            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n   411\t            self.proc.stdin.close()\n   412\t        except (BrokenPipeError, OSError):\n   413\t            pass\n   414\t\n   415\t    def _drain_stderr(self) -> None:\n   416\t        remaining = MAX_STDERR_BYTES\n   417\t        retained = bytearray()\n   418\t        try:\n   419\t            while chunk := self.proc.stderr.read(IO_CHUNK_BYTES):\n   420\t                if remaining:\n   421\t                    retained.extend(chunk[:remaining])\n   422\t                    remaining = max(0, remaining - len(chunk))\n   423\t        except Exception:  # noqa: BLE001 - вторичный поток, ошибку терять нельзя молча\n   424\t            pass\n   425\t        finally:\n   426\t            self.err_box.append(retained.decode(\"utf-8\", \"replace\"))\n   427\t\n   428\t    def _enqueue(self, event: tuple) -> None:\n   429\t        \"\"\"Ограниченная очередь с прерыванием ожидания при закрытии хода.\"\"\"\n   430\t        while not self._closed.is_set():\n   431\t            try:\n   432\t                self.q.put(event, timeout=POLL_INTERVAL_S)\n   433\t                return\n   434\t            except queue.Full:\n   435\t                continue\n   436\t\n   437\t    def _pump(self) -> None:\n   438\t        \"\"\"Разбор stream-json: content_block_delta -> text/thinking, result -> итог.\"\"\"\n   439\t        try:\n   440\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n   441\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n   442\t                if not line.startswith(\"{\"):\n   443\t                    continue\n   444\t                try:\n   445\t                    ev = json.loads(line)\n   446\t                except ValueError:\n   447\t                    continue\n   448\t                etype = ev.get(\"type\")\n   449\t                if etype == \"stream_event\":\n   450\t                    inner = ev.get(\"event\") or {}\n   451\t                    if inner.get(\"type\") == \"content_block_delta\":\n   452\t                        delta = inner.get(\"delta\") or {}\n   453\t                        dtype = delta.get(\"type\")\n   454\t                        if dtype == \"text_delta\" and delta.get(\"text\"):\n   455\t                            self._enqueue((\"text\", delta[\"text\"]))\n   456\t                        elif dtype == \"thinking_delta\":\n   457\t                            thinking = extract_thinking_delta(delta)\n   458\t                            if thinking:\n   459\t                                self._enqueue((\"thinking\", thinking))\n   460\t                elif etype == \"result\":\n   461\t                    self._enqueue((\"result\", ev))\n   462\t            rc = self.proc.wait()\n   463\t        except Exception as exc:  # noqa: BLE001 - читатель не должен умирать молча\n   464\t            self._enqueue((\"pump_error\", repr(exc)))\n   465\t            return\n   466\t        time.sleep(STDERR_DRAIN_S)  # дать стоку stderr дозавершиться\n   467\t        self._enqueue((\"done\", rc))\n   468\t\n   469\t    def close(self) -> None:\n   470\t        self._closed.set()\n   471\t        if self.proc.poll() is None:\n   472\t            _kill_group(self.proc)\n   473\t        self.proc.wait(timeout=PROCESS_WAIT_S)\n   474\t        with _active_lock:\n   475\t            _active.pop(self.proc.pid, None)\n   476\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   477\t            try:\n   478\t                if stream is not None:\n   479\t                    stream.close()\n   480\t            except OSError:\n   481\t                pass\n   482\t\n   483\t\n   484\tdef _client_gone(sock: socket.socket) -> bool:\n   485\t    try:\n   486\t        ready, _, _ = select.select([sock], [], [], 0)\n   487\t        return bool(ready) and sock.recv(1, socket.MSG_PEEK) == b\"\"\n   488\t    except (OSError, ValueError):\n   489\t        return True\n   490\t\n   491\t\n   492\tclass Handler(BaseHTTPRequestHandler):\n   493\t    protocol_version = \"HTTP/1.1\"\n   494\t    timeout = HTTP_TIMEOUT_S\n   495\t\n   496\t    def log_message(self, format: str, *args: Any) -> None:\n   497\t        _log(\"http \" + (format % args))\n   498\t\n   499\t    def handle_error(self, request: Any, client_address: Any) -> None:\n   500\t        _log(f\"http accept error from {client_address}\")\n   501\t\n   502\t    def _send(self, code: int, payload: dict) -> None:\n   503\t        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n   504\t        self.send_response(int(code))\n   505\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n   506\t        self.send_header(\"Content-Length\", str(len(body)))\n   507\t        self.end_headers()\n   508\t        self.wfile.write(body)\n   509\t\n   510\t    def _emit(self, data: str) -> bool:\n   511\t        try:\n   512\t            self.wfile.write(data.encode(\"utf-8\"))\n   513\t            self.wfile.flush()\n   514\t            return True\n   515\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   516\t            return False\n   517\t\n   518\t    def _acquire_slot(self, keepalive):\n   519\t        \"\"\"Ждём слот семафора до QUEUE_TIMEOUT_S, попутно keepalive и проверка клиента.\"\"\"\n   520\t        waited = time.monotonic()\n   521\t        last_ka = 0.0\n   522\t        while not _slots.acquire(timeout=POLL_INTERVAL_S):\n   523\t            if _client_gone(self.connection):\n   524\t                return \"client_gone\"\n   525\t            if time.monotonic() - waited > QUEUE_TIMEOUT_S:\n   526\t                return \"queue_timeout\"\n   527\t            if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   528\t                last_ka = time.monotonic()\n   529\t                if not keepalive():\n   530\t                    return \"client_gone\"\n   531\t        return \"\"\n   532\t\n   533\t    def _execute(self, run: Run, on_text, on_reasoning, on_tool_call,\n   534\t                 keepalive, emulate_tools: bool, tools: list | None = None) -> dict:\n   535\t        \"\"\"Гнать ход до конца.\n   536\t\n   537\t        on_text/on_reasoning/on_tool_call/keepalive возвращают False, если клиент ушёл.\n   538\t        Весь текстовый поток ВСЕГДА проходит через `StreamNormalizer` поверх\n   539\t        `ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON — в том числе без\n   540\t        tools и при tool_choice=none): повреждённый `<tool_call>` поднимает\n   541\t        `LiveParserError`, сырой XML в content не уходит; распознанный вызов без\n   542\t        эмуляции — ошибка протокола, а не опубликованный инструмент. Reasoning\n   543\t        (нативный thinking и теги в тексте) публикуется до терминального события.\n   544\t        \"\"\"\n   545\t        pieces = []\n   546\t        reasoning_pieces: list = []\n   547\t        tool_calls: list = []\n   548\t        usage = {}\n   549\t        result_ev = {}\n   550\t        tool_schemas = build_tool_schemas(tools or [])\n   551\t        last_ka = time.monotonic()\n   552\t        gone = [False]\n   553\t\n   554\t        def state(name: str, rc: int, err: str = \"\") -> dict:\n   555\t            return {\"rc\": rc, \"text\": \"\".join(pieces), \"usage\": usage,\n   556\t                    \"reasoning\": \"\".join(reasoning_pieces),\n   557\t                    \"result\": result_ev, \"state\": name, \"err\": err,\n   558\t                    \"tool_calls\": tool_calls}\n   559\t\n   560\t        def add_content(text: str) -> None:\n   561\t            if gone[0] or not text:\n   562\t                return\n   563\t            pieces.append(text)\n   564\t            if not on_text(text):\n   565\t                gone[0] = True\n   566\t\n   567\t        def add_reasoning(text: str) -> None:\n   568\t            if gone[0] or not text:\n   569\t                return\n   570\t            reasoning_pieces.append(text)\n   571\t            if not on_reasoning(text):\n   572\t                gone[0] = True\n   573\t\n   574\t        def add_call(call: dict) -> None:\n   575\t            if gone[0]:\n   576\t                return\n   577\t            if not emulate_tools:\n   578\t                raise LiveParserError(\"tool_call published without tool emulation\")\n   579\t            entry = {\n   580\t                \"index\": len(tool_calls),\n   581\t                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n   582\t                \"type\": \"function\",\n   583\t                \"function\": {\n   584\t                    \"name\": call[\"name\"],\n   585\t                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n   586\t                },\n   587\t            }\n   588\t            # Схемная санитизация — ровно один раз на владельце маршрута (AD-004).\n   589\t            for item in sanitize_tool_call(entry, tool_schemas):\n   590\t                item = dict(item, index=len(tool_calls))\n   591\t                tool_calls.append(item)\n   592\t                if not on_tool_call(item):\n   593\t                    gone[0] = True\n   594\t                    return\n   595\t\n   596\t        normalizer = StreamNormalizer(\n   597\t            add_content, add_reasoning, add_call, strict_live=True\n   598\t        )\n   599\t\n   600\t        while True:\n   601\t            if _client_gone(self.connection):\n   602\t                return state(\"client_gone\", 1)\n   603\t            try:\n   604\t                kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   605\t            except queue.Empty:\n   606\t                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   607\t                    last_ka = time.monotonic()\n   608\t                    if not keepalive():\n   609\t                        return state(\"client_gone\", 1)\n   610\t                continue\n   611\t            if kind == \"text\":\n   612\t                normalizer.feed_text(str(payload))\n   613\t                if gone[0]:\n   614\t                    return state(\"client_gone\", 1)\n   615\t            elif kind == \"thinking\":\n   616\t                normalizer.feed_thinking(str(payload))\n   617\t                if gone[0]:\n   618\t                    return state(\"client_gone\", 1)\n   619\t            elif kind == \"result\":\n   620\t                result_ev = payload\n   621\t                usage = payload.get(\"usage\") or {}\n   622\t            elif kind == \"pump_error\":\n   623\t                return state(\"pump_error\", 1, str(payload))\n   624\t            elif kind == \"done\":\n   625\t                # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n   626\t                # сырой XML текстом не досбрасываем. Fallback на терминальный\n   627\t                # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n   628\t                normalizer.finish()\n   629\t                if gone[0]:\n   630\t                    return state(\"client_gone\", 1)\n   631\t                time.sleep(STDERR_DRAIN_S)\n   632\t                return state(\"done\", payload, \"\".join(run.err_box))\n   633\t\n   634\t    def _run_once(self, req: dict, on_text, on_reasoning, on_tool_call, keepalive) -> dict:\n   635\t        raw_messages = req.get(\"messages\")\n   636\t        messages: list = raw_messages if isinstance(raw_messages, list) else []\n   637\t        raw_tools = req.get(\"tools\")\n   638\t        tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n   639\t        tool_choice = req.get(\"tool_choice\")\n   640\t        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n   641\t        model, model_err = _resolve_model(req)\n   642\t        if model_err is not None:\n   643\t            return {\"state\": \"bad_model\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   644\t                    \"err\": model_err[\"message\"], \"tool_calls\": []}\n   645\t        try:\n   646\t            images = _extract_request_images(req)\n   647\t        except ImageInputError as exc:\n   648\t            return {\"state\": \"bad_image\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   649\t                    \"err\": exc.code, \"tool_calls\": []}\n   650\t        prompt = _messages_to_prompt(messages, tools, tool_choice, images or None)\n   651\t        effort = _effort(req.get(\"reasoning_effort\"), model)\n   652\t        tag = (f\"client={self.client_address[0]}:{self.client_address[1]} \"\n   653\t               f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\")\n   654\t        reason = self._acquire_slot(keepalive)\n   655\t        if reason:\n   656\t            _log(f\"no slot ({reason}) model={model} effort={effort} {tag}\")\n   657\t            return {\"state\": reason, \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   658\t                    \"err\": \"\", \"tool_calls\": []}\n   659\t        t0 = time.monotonic()\n   660\t        img_dir = None\n   661\t        can_cleanup = True\n   662\t        try:\n   663\t            try:\n   664\t                img_dir = _stage_images(images)\n   665\t                run = Run(prompt, model, effort, tag, img_dir=img_dir)\n   666\t                can_cleanup = False\n   667\t            except OSError as exc:\n   668\t                _log(f\"image stage/spawn failed model={model} err={exc!r:.200} {tag}\")\n   669\t                return {\"state\": \"image_error\", \"rc\": 1, \"text\": \"\", \"usage\": {},\n   670\t                        \"result\": {}, \"err\": str(exc)[:200], \"tool_calls\": []}\n   671\t            try:\n   672\t                out = self._execute(run, on_text, on_reasoning, on_tool_call,\n   673\t                                    keepalive, emulate_tools, tools)\n   674\t            except LiveParserError as exc:\n   675\t                # AD-004: битый поток — 502 proxy_error; сырой XML клиенту не уходит.\n   676\t                _log(f\"parser_error model={model} err={exc} {tag}\")\n   677\t                out = {\"state\": \"parser_error\", \"rc\": 1, \"text\": \"\", \"reasoning\": \"\",\n   678\t                       \"usage\": {}, \"result\": {}, \"err\": str(exc), \"tool_calls\": []}\n   679\t            finally:\n   680\t                run.close()  # сначала завершить и reap своего ребёнка\n   681\t                can_cleanup = True\n   682\t        finally:\n   683\t            if can_cleanup:\n   684\t                _cleanup_img_dir(img_dir)\n   685\t            _slots.release()\n   686\t        out_calls = out.get(\"tool_calls\")\n   687\t        out_text = out.get(\"text\")\n   688\t        _log(f\"done model={model} effort={effort} rc={out['rc']} state={out['state']} \"\n   689\t             f\"tools={len(out_calls) if isinstance(out_calls, list) else 0} \"\n   690\t             f\"out_bytes={len(out_text.encode()) if isinstance(out_text, str) else 0} \"\n   691\t             f\"wall_s={time.monotonic() - t0:.1f} {tag}\")\n   692\t        return out\n   693\t\n   694\t    @staticmethod\n   695\t    def _error_body(out: dict) -> Any:\n   696\t        st = out.get(\"state\")\n   697\t        if st == \"bad_model\":\n   698\t            return {\"message\": str(out.get(\"err\")), \"type\": \"invalid_request_error\", \"code\": 400}\n   699\t        if st == \"bad_image\":\n   700\t            return {\"message\": f\"invalid image input: {out.get('err')}\",\n   701\t                    \"type\": \"invalid_request_error\", \"code\": 400}\n   702\t        if st == \"parser_error\":\n   703\t            return {\"message\": \"malformed tool_call stream\",\n   704\t                    \"type\": \"proxy_error\", \"code\": 502}\n   705\t        if st == \"image_error\":\n   706\t            return {\"message\": \"image staging or spawn failed\",\n   707\t                    \"type\": \"proxy_error\", \"code\": 502}\n   708\t        if st == \"queue_timeout\":\n   709\t            return {\"message\": f\"bridge busy: queue full over {QUEUE_TIMEOUT_S}s\",\n   710\t                    \"type\": \"overloaded\", \"code\": 503}\n   711\t        if st == \"client_gone\":\n   712\t            return {\"message\": \"client gone\", \"type\": \"client_gone\", \"code\": 499}\n   713\t        if st == \"pump_error\":\n   714\t            return {\"message\": \"bridge reader failed\", \"detail\": str(out.get(\"err\"))[:500],\n   715\t                    \"type\": \"proxy_error\", \"code\": 502}\n   716\t        if (out.get(\"result\") or {}).get(\"is_error\"):\n   717\t            detail = str((out[\"result\"].get(\"result\")) or out.get(\"err\") or \"claude reported an error\")\n   718\t            if \"<tool_call\" in detail:  # сырой XML не публикуется даже в тексте ошибки\n   719\t                detail = \"claude reported an error\"\n   720\t            return {\"message\": detail[:500], \"type\": \"claude_error\", \"code\": 502}\n   721\t        if out.get(\"rc\") != 0 or not (out.get(\"text\") or out.get(\"tool_calls\")):\n   722\t            return {\"message\": f\"claude exited rc={out.get('rc')}\",\n   723\t                    \"detail\": str(out.get(\"err\"))[:500], \"type\": \"proxy_error\", \"code\": 502}\n   724\t        return None\n   725\t\n   726\t    # ---- HTTP --------------------------------------------------------------------\n   727\t    def do_GET(self) -> None:  # noqa: N802\n   728\t        path = self.path.split(\"?\", 1)[0]\n   729\t        if path in (\"/health\", \"/v1/health\"):\n   730\t            with _active_lock:\n   731\t                active = len(_active)\n   732\t            self._send(200, {\n   733\t                \"ok\": True, \"transport\": \"claude-p\", \"model\": MODEL_ID,\n   734\t                \"models\": list(SUPPORTED_MODELS),\n   735\t                \"active\": active, \"max_concurrent\": MAX_CONCURRENT,\n   736\t                \"tool_emulation\": True, \"images\": True, \"live_reasoning\": True,\n   737\t                \"uptime_s\": int(time.time() - _started),\n   738\t            })\n   739\t            return\n   740\t        if not _auth_ok(self):\n   741\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   742\t            return\n   743\t        if path in (\"/v1/models\", \"/models\"):\n   744\t            self._send(200, {\"object\": \"list\", \"data\": [{\n   745\t                \"id\": model_id, \"object\": \"model\", \"owned_by\": \"anthropic\",\n   746\t                \"created\": 0, \"context_length\": MODEL_CONTEXT.get(model_id, CONTEXT_LENGTH),\n   747\t            } for model_id in SUPPORTED_MODELS]})\n   748\t            return\n   749\t        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   750\t\n   751\t    def do_POST(self) -> None:  # noqa: N802\n   752\t        if not _auth_ok(self):\n   753\t            # Непрочитанное тело иначе будет разобрано как следующий запрос keep-alive.\n   754\t            self.close_connection = True\n   755\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   756\t            return\n   757\t        path = self.path.split(\"?\", 1)[0]\n   758\t        try:\n   759\t            length = int(self.headers.get(\"Content-Length\") or \"0\")\n   760\t        except ValueError:\n   761\t            length = -1\n   762\t        if length < 0 or length > MAX_REQUEST_BYTES:\n   763\t            self.close_connection = True\n   764\t            self._send(413 if length > MAX_REQUEST_BYTES else 400,\n   765\t                       {\"error\": {\"message\": \"invalid request body length\"}})\n   766\t            return\n   767\t        raw = self.rfile.read(length) if length else b\"{}\"\n   768\t        try:\n   769\t            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n   770\t        except ValueError:\n   771\t            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n   772\t            return\n   773\t        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n   774\t            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   775\t            return\n   776\t        # Невалидную модель отсекаем до SSE-заголовков, иначе 400 уже не отправить.\n   777\t        _model, model_err = _resolve_model(req)\n   778\t        if model_err is not None:\n   779\t            self._send(400, {\"error\": {\"message\": model_err[\"message\"],\n   780\t                                       \"type\": model_err[\"type\"]}})\n   781\t            return\n   782\t        # Невалидные изображения отсекаем там же, до спавна и SSE-заголовков.\n   783\t        try:\n   784\t            _extract_request_images(req)\n   785\t        except ImageInputError as exc:\n   786\t            self._send(400, {\"error\": {\"message\": f\"invalid image input: {exc.code}\",\n   787\t                                       \"type\": \"invalid_request_error\"}})\n   788\t            return\n   789\t        if req.get(\"stream\"):\n   790\t            self._serve_sse(req)\n   791\t        else:\n   792\t            self._serve_json(req)\n   793\t\n   794\t    def _serve_json(self, req: dict) -> None:\n   795\t        out = self._run_once(req, lambda _v: True, lambda _v: True, lambda _e: True, None)\n   796\t        if out.get(\"state\") == \"client_gone\":\n   797\t            return\n   798\t        err = self._error_body(out)\n   799\t        if err is not None:\n   800\t            self._send(err[\"code\"], {\"error\": err})\n   801\t            return\n   802\t        usage = out.get(\"usage\") or {}\n   803\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n   804\t        if out.get(\"reasoning\"):\n   805\t            message[\"reasoning_content\"] = out[\"reasoning\"]\n   806\t        finish = \"stop\"\n   807\t        if out.get(\"tool_calls\"):\n   808\t            message[\"tool_calls\"] = out[\"tool_calls\"]\n   809\t            finish = \"tool_calls\"\n   810\t        self._send(200, {\n   811\t            \"id\": f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n   812\t            \"created\": int(time.time()), \"model\": req.get(\"model\") or MODEL_ID,\n   813\t            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n   814\t            \"usage\": {\n   815\t                \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n   816\t                \"completion_tokens\": usage.get(\"output_tokens\", 0),\n   817\t                \"total_tokens\": usage.get(\"input_tokens\", 0) + usage.get(\"output_tokens\", 0),\n   818\t            },\n   819\t        })\n   820\t\n   821\t    def _serve_sse(self, req: dict) -> None:\n   822\t        completion_id = f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\"\n   823\t        created = int(time.time())\n   824\t        shown_model = str(req.get(\"model\") or MODEL_ID)\n   825\t        try:\n   826\t            self.send_response(200)\n   827\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n   828\t            self.send_header(\"Cache-Control\", \"no-cache\")\n   829\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n   830\t            self.end_headers()\n   831\t            self.close_connection = True\n   832\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   833\t            _log(\"client gone before headers\")\n   834\t            return\n   835\t\n   836\t        def chunk(delta: dict, finish=None) -> str:\n   837\t            return \"data: \" + json.dumps({\n   838\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n   839\t                \"model\": shown_model,\n   840\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n   841\t            }, ensure_ascii=False) + \"\\n\\n\"\n   842\t\n   843\t        def on_text(value: str) -> bool:\n   844\t            return self._emit(chunk({\"content\": value}))\n   845\t\n   846\t        def on_reasoning(value: str) -> bool:\n   847\t            return self._emit(chunk({\"reasoning_content\": value}))\n   848\t\n   849\t        def on_tool_call(entry: dict) -> bool:\n   850\t            return self._emit(chunk({\"tool_calls\": [entry]}))\n   851\t\n   852\t        def keepalive() -> bool:\n   853\t            return self._emit(\": keepalive\\n\\n\")\n   854\t\n   855\t        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n   856\t            return\n   857\t        out = self._run_once(req, on_text, on_reasoning, on_tool_call, keepalive)\n   858\t        if out.get(\"state\") == \"client_gone\":\n   859\t            _log(\"client gone mid-stream, child killed\")\n   860\t            return\n   861\t        err = self._error_body(out)\n   862\t        if err is None:\n   863\t            finish = \"tool_calls\" if out.get(\"tool_calls\") else \"stop\"\n   864\t            self._emit(chunk({}, finish))\n   865\t        else:\n   866\t            error_msg = str(err.get(\"message\") or \"\") if isinstance(err, dict) else str(err)\n   867\t            error_chunk = format_stream_error_sse(str(error_msg), finish_reason=\"stop\")\n   868\t            self._emit(error_chunk)\n   869\t            return\n   870\t        self._emit(\"data: [DONE]\\n\\n\")\n   871\t\n   872\t\n   873\tclass Server(ThreadingHTTPServer):\n   874\t    daemon_threads = True\n   875\t    request_queue_size = HTTP_BACKLOG\n   876\t    allow_reuse_address = True\n   877\t\n   878\t\n   879\tdef main() -> None:\n   880\t    if not AUTH_KEY:\n   881\t        sys.stderr.write(\"CLAUDE_P_BRIDGE_KEY is required; refusing to start\\n\")\n   882\t        raise SystemExit(1)\n   883\t    WORKSPACE.mkdir(parents=True, exist_ok=True)\n   884\t    signal.signal(signal.SIGTERM, _kill_all)\n   885\t    signal.signal(signal.SIGINT, _kill_all)\n   886\t    server = Server((HOST, PORT), Handler)\n   887\t    _log(f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\n   888\t         f\"queue_timeout={QUEUE_TIMEOUT_S}s keepalive={KEEPALIVE_S}s\")\n   889\t    print(f\"[claude-p-bridge] listening on http://{HOST}:{PORT}/v1\", flush=True)\n   890\t    server.serve_forever()\n   891\t\n   892\t\n   893\tif __name__ == \"__main__\":\n   894\t    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat /Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md; nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/analysis/all-bridges-sliding-activity-window/handoff-architect.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat /Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md; nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/analysis/all-bridges-sliding-activity-window/handoff-architect.md'","aggregated_output":"# AGENTS.md — cli-agent-bridge\n\nПроектные правила для агентов. Общие правила владельца — канон `~/Мой диск/Context/AGENTS.md` (здесь не дублируются).\n\n## ⭐ Главный архитектурный принцип: универсальность и независимость от вендоров\n\n1. **Максимальная универсальность:** все доработки делаются максимально универсальными, чтобы не зависеть от вендоров и сторонних сред исполнения.\n2. **Запрет на правку вендорского исходного кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи в исходный код и бинарные сборки внешних вендорских приложений и сред (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену исполняемых модулей. **Правка пользовательских конфигураций и профилей РАЗРЕШЕНА:** редактирование пользовательских настроек, профилей интеграции и переменных окружения (например, `~/.dsh/profiles/*/cordis.patch.yml`, `~/.dsh/.env`, `~/.dsh/.credentials.yaml`) является штатным методом настройки и полностью разрешено.\n3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\n4. **Запрет на хардкод параметров (полная конфигурируемость):** категорически запрещено зашивать в коде константами любые эксплуатационные параметры — таймауты, интервалы опроса, пороги активности, лимиты шагов и размеры буферов памяти (текста ответа, reasoning и т.д.). Любые такие параметры просто переносим в настройки: они должны быть полностью настраиваемыми через переменные окружения и конфигурационные файлы с безопасными значениями по умолчанию в качестве fallback.\n5. **Системное, агент-агностическое решение по умолчанию:** все архитектурные задачи, расхождения форматов сообщений, санитизация вызовов инструментов (tool calls), дефекты стриминга, управление сессиями, восстановление контекста и протокольные краевые случаи решаются **на системном (агент-агностик) уровне шлюза** — в универсальном ядре (`core/`) и общих механизмах эмуляции API, а не на уровне конкретного агента. Решение должно опираться на семантику протокола и контракт шлюза, а не на имя подключаемого агента.\n   - **Запрещено переносить общую логику на уровень конкретного агента:** если проблему можно решить агент-агностически, категорически недопустимы отдельные заплатки, хаки, ветвления по имени агента и дублирование исправлений для Droid, Muse, Codex, Claude Code и других подключаемых CLI-бэкендов. Системное исправление реализуется один раз в модулях ядра (`core/`) и работает единообразно для всех интеграций.\n   - **Адаптеры агентов — только тонкие трансляторы транспорта:** их ответственность ограничивается управлением жизненным циклом CLI-процесса, подключением к транспорту и двусторонней трансляцией специфичного CLI-ввода/вывода в единый внутренний контракт шлюза. Общая нормализация, санитизация, управление контекстом, восстановление после сбоев и протокольная эмуляция не должны оседать в адаптерах в виде ad-hoc логики.\n   - **Специфичная логика допускается только как доказанное исключение:** прежде чем добавлять частную обработку в адаптер, необходимо доказать невозможность системного решения в общем слое и зафиксировать непреодолимое ограничение внешнего CLI-транспорта. Такая логика должна быть строго изолирована внутри адаптера и не нарушать инварианты универсального ядра.\n\n## О проекте cli-agent-bridge\n\nУниверсальный шлюз (мост/фасад), объединяющий CLI-агентов и LLM различных провайдеров в единый OpenAI-совместимый эндпоинт (`POST /v1/chat/completions`, `GET /v1/models`, SSE-стриминг, `tools`/`tool_calls`).\n\n### Архитектурные слои\n- `server.py` — единый HTTP-фасад (OpenAI-compatible API, маршрутизация запросов, управление подключениями).\n- `core/` — универсальное ядро:\n  - `core/tool_emulation.py` — протокол и эмуляция function calling, парсинг и санитизация `<tool_call>`.\n  - `core/backend_adapter.py` — базовые абстракции и контракты адаптеров бэкендов.\n  - `core/turn_session_manager.py` — управление сессиями, контекстом и процессами.\n  - `core/context_resilience.py` — устойчивость к переполнению контекста и сжатие.\n- `adapters/` — адаптеры к конкретным CLI-транспортам и средам (Droid, Muse, Codex и др.).\n- `bridges/` — специализированные мосты (`agy-bridge`, `muse-bridge`, `opencode-zen-bridge`).\n\n## Верификация и тесты\n\nПеред фиксацией любых изменений запускать набор тестов:\n```bash\npytest tests/ -v\n```\nКод должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.\n\n## Регламент комплексного тестирования мостов и стриминга (L1 / L2 / L3)\n\nКаждая доработка мостов обязана сопровождаться трехуровневым контролем качества:\n\n1. **Уровень L1 (Детерминированные Unit-тесты):**\n   - Все изменения логики дедупликации (`_ContentArbiter`), сканирования префиксов (`_scan`) и разбора рантайм-флагов (`_parse_runtime_flags`) покрываются тестами в `tests/test_agy_bridge_resilience.py`.\n   - Запрещено сдавать код, если хотя бы один тест арбитража или graceful-таймаута завершается с ошибкой.\n   - Инвариант `_scan`: входящий фрагмент другого шага сопоставляется со старым шагом ТОЛЬКО при условии `text == candidate` или `text.startswith(candidate)`. Короткий префикс нового шага с валидным индексом (`idx is not None`) никогда не должен становиться алиасом длинного старого шага.\n\n2. **Уровень L2 (Сквозные синтетические E2E-тесты и валидация протокола SSE):**\n   - Набор `tests/test_stream_formatting_and_subagents.py` обязателен к прогону перед любым мержем.\n   - **Инвариант разграничения строк Markdown:** любые последовательные шаги в потоке `content` обязаны разделяться переводом строки `\\n\\n`. Склейка слов на границах шагов (паттерн `[а-яёa-z]\\.[А-ЯЁA-Z]`) категорически запрещена.\n   - **Инвариант защиты от циклов префиксов:** многократная смена статусов агента и скиллов оркестрации (`[гейт оркестрации: активен...`) не должна вызывать лавину повторов префикса и `content-divergence`.\n   - **Инвариант изоляции блока мышления (<Think>):** при наличии вызовов инструментов (`tool_calls`) сервисные преамбулы шагов направляются в `choices[0].delta.reasoning_content`. В `choices[0].delta.content` разрешается отдавать только финальный ответ пользователю (шаг без инструментов) либо результат реконсиляции, предотвращая досрочное закрытие аккордеона мышления в UI DeepSeek Harness.\n   - **Мультиагентный цикл:** обязательна эмуляция сессий с порождением сабагентов (`invoke_subagent` / `launch_seat.py`) с контролем непрерывности стрима родительского агента.\n   - **Инвариант скользящего окна активности (Sliding Activity Window):** любой стрим и адаптер обязан сбрасывать таймер неактивности при получении каждого полезного чанка (`content`, `reasoning_content`, `tool_calls`) и сдвигать дедлайн вперёд (`deadline = now + idle_timeout_s`). Категорически запрещено обрывать активный поток по статическому настенному таймеру при наличии входящих данных; аварийный `safety_cap_s` допустим только как предохранитель от бесконечного зацикливания.\n\n3. **Уровень L3 (Универсальный смоук-раннер моделей):**\n   - Для валидации готовности моделей и транспортов из `~/Мой диск/Context/models.md` используется скрипт `scripts/smoke_models.py`.\n   - Проверка конфигурации: `python3 scripts/smoke_models.py --dry-run`.\n   - Сквозной смоук-тест реальных бэкендов: `python3 scripts/smoke_models.py --live --hub-url http://127.0.0.1:9882/v1`.\n   - Санитизация: все токены и секреты в смоук-логах и отчётах обязательно маскируются.\n     1\t# Handoff to Architect — Сквозное внедрение скользящих окон активности во все мосты (Rev 22, канонический)\n     2\t\n     3\t## 1. Входные факты и матрица компонентов\n     4\t- Карточка задачи: `analysis/all-bridges-sliding-activity-window/research-plan.md`\n     5\t- Реестр фактов: `analysis/all-bridges-sliding-activity-window/evidence-ledger.md` (`[F-01]`..`[F-15]`)\n     6\t- Анализ рисков: `analysis/all-bridges-sliding-activity-window/evidence-black.md` (`[B-01]`..`[B-24]`)\n     7\t- Варианты архитектуры: `analysis/all-bridges-sliding-activity-window/competing-options.md` (Вариант V2)\n     8\t- Рекомендация RCA: `analysis/all-bridges-sliding-activity-window/consolidated-rca-decision.md`\n     9\t\n    10\t### Выверенная матрица компонентов системы\n    11\t| Компонент / Файл | Фактическое состояние в коде | Реальная целевая дельта задачи |\n    12\t|---|---|---|\n    13\t| `bridges/claude-p-bridge/server.py` | В цикле `_execute` (`:600-615`) вотчдог отсутствует: `run.q.get(timeout=POLL_INTERVAL_S)` крутится бесконечно при зависании CLI | **ЦЕЛЕВАЯ ДЕЛЬТА 1**: Безопасный парсер настроек `_read_dsh_env_file() -> dict[str, str]` со строгим whitelist несекретных настроек (любые `*_KEY` исключены), последнее значение перезаписывает предыдущее (паритет с shell), возвращающий локальный словарь `_DSH_ENV` **БЕЗ мутации `os.environ`**. Размещение функций строго между `:98` и `:101`. Защищенный импорт `from core.watchdog import AdaptiveTimeoutController` сразу после настройки `sys.path` (`:58-61`). Каскадный геттер: `CLAUDE_P_BRIDGE_*` -> `BRIDGE_*` -> `default`; проверка `0 < val < float(\"inf\")` без зависимости от `math`. Флаг `CLAUDE_P_BRIDGE_WATCHDOG_ENABLED` (дефолт `\"1\"`). Чтение и передача всех 4 параметров (`idle_timeout_s`, `safety_cap_s`, `io_wait_cap_s`, `watchdog_interval_s`). Безопасное чтение процесса `proc = getattr(run, \"proc\", None)` и `proc_pid = getattr(proc, \"pid\", None)` (100% совместимость с `FakeRun`). Контракт `should_stop, reason, _ = controller.check(proc_pid)` с реакцией на таймауты (`idle_timeout`, `absolute_cap`) и пропуском нормального выхода `child_exited`; троттлинг проверок в начале `while True:` по `controller.watchdog_interval_s`; вызов `record_activity(kind)` на `text`, `thinking` и `result`; в `@staticmethod _error_body`: перехват `st == \"timeout\"` -> 504; `try...finally` с закрытием контроллера |\n    14\t| `bridges/opencode-zen-bridge/server.py` | Использует собственное пространство имён `BRIDGE_ZEN_*` и хелпер `_zen_positive_float` (`:338`). `STALL_TIMEOUT_S` (`:1946`) | **ЦЕЛЕВАЯ ДЕЛЬТА 2**: Чтение `STALL_TIMEOUT_S` через существующий хелпер `_zen_positive_float(\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\", 60.0)`, сохраняя чистую изоляцию от `BRIDGE_ZEN_IDLE_TIMEOUT_S` |\n    15\t| `server.py` (Хаб) | Функция `parse_live_write_timeout(default: float = 30.0)` (`:394-406`) читает только `DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S` | **ЦЕЛЕВАЯ ДЕЛЬТА 3**: Двухступенчатый fallback: сначала проверяется `BRIDGE_CLIENT_WRITE_TIMEOUT_S`; если не задан или невалиден — проверяется `DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S`; если оба отсутствуют/невалидны — возвращается переданный `default` |\n    16\t| `tests/test_claude_p_watchdog.py` | Отсутствует | **ЦЕЛЕВАЯ ДЕЛЬТА 4**: Новый детерминированный набор unit-тестов L1 для вотчдога `claude-p-bridge`: модульная фикстура изоляции с `pytest.MonkeyPatch.context()`, очисткой префиксов и `sys.modules.pop` в `finally`, фильтрация секретов, мок `_kill_group`, срабатывание таймаутов, реакция на `child_exited`, сброс таймера активности, троттлинг проверок и закрытие контроллера в `finally` |\n    17\t| `tests/test_stream_timeout_config.py` | Тестирует `parse_live_write_timeout` (`:9-37`) | **ЦЕЛЕВАЯ ДЕЛЬТА 5**: Добавление `monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)` во все тесты таймаута и добавление unit-теста на двухступенчатый fallback и приоритет |\n    18\t| `core/watchdog.py` | `AdaptiveTimeoutController` (`:359-515`) работает стабильно и проверен | Сохраняется в текущем проверенном виде без изменений |\n    19\t| `adapters/passthrough_adapter.py` | Автономный `_TimedSseReader` (`:642-720`) с `last_upstream`, `idle_timeout_s`, `safety_cap_s` (173 теста PASS) | Сохраняется в неизменном эталонном виде |\n    20\t| `bridges/agy-bridge/server.py` | Использует `AdaptiveTimeoutController` (`:5202`) и `on_activity` (`:6236`) | Сохраняется в рабочем виде, подтверждена совместимость |\n    21\t\n    22\t---\n    23\t\n    24\t## 2. NFR-Scale Card и параметры надежности\n    25\t\n    26\t### 2.1. Изоляция сабагентов и предотвращение Deadlock\n    27\t- Сабагенты Совета Тимлидов (`launch_seat.py`) вызываются через прямые терминальные CLI-транспорты (`claude -p`, `codex exec`) по таблице `panel_transports.json`, минуя HTTP-семафор хаба `MAX_CONCURRENT=128`. Это предотвращает взаимную блокировку родительских сессий и судейских процессов.\n    28\t- На хабе `:9882` очередь ожидания слота семафора ограничена `QUEUE_TIMEOUT_S = 900` с (`server.py:383`).\n    29\t- Семафор входящих сетевых соединений `_conn_sem` (`fleet.admission.max_http_connections`) при насыщении возвращает 503 `connection limit` (`server.py:7718-7733`).\n    30\t\n    31\t### 2.2. Защита от медленного клиента (Целевая реализация в `server.py`)\n    32\t```python\n    33\tdef _parse_valid_timeout(raw: str | None, low: float = 1.0, high: float = 300.0) -> float | None:\n    34\t    if raw is None or not raw.strip():\n    35\t        return None\n    36\t    try:\n    37\t        val = float(raw.strip())\n    38\t        if math.isfinite(val) and low <= val <= high:\n    39\t            return val\n    40\t    except (ValueError, TypeError):\n    41\t        pass\n    42\t    return None\n    43\t\n    44\tdef parse_live_write_timeout(default: float = 30.0) -> float:\n    45\t    # 1. Приоритет канонического имени:\n    46\t    val = _parse_valid_timeout(os.getenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\"))\n    47\t    if val is not None:\n    48\t        return val\n    49\t    # 2. Fallback на legacy имя Droid:\n    50\t    val = _parse_valid_timeout(os.getenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\"))\n    51\t    if val is not None:\n    52\t        return val\n    53\t    # 3. Безопасный дефолт:\n    54\t    return default\n    55\t```\n    56\t\n    57\t---\n    58\t\n    59\t## 3. Архитектурное задание для architect-software-product\n    60\t\n    61\t### 3.1. Внедрение вотчдога в `bridges/claude-p-bridge/server.py`\n    62\t\n    63\t1. **Изолированный защищенный импорт контроллера (размещается сразу после настройки `sys.path` на `:58-61`, сохраняя fail-closed AD-002 для `core.tool_emulation` на `:63-86`):**\n    64\t   ```python\n    65\t   try:\n    66\t       from core.watchdog import AdaptiveTimeoutController\n    67\t   except ImportError:\n    68\t       AdaptiveTimeoutController = None  # type: ignore[assignment,misc]\n    69\t   ```\n    70\t\n    71\t2. **Размещение функций конфигурации строго между `:98` и `:101` (после `_env_positive_int`, до объявления констант `ROOT`, `HOST`, `AUTH_KEY`):**\n    72\t   - Строгий whitelist ключей конфигурации: чтение любых ключей авторизации (`*_KEY`) категорически запрещено!\n    73\t   - Повторяющиеся ключи в файле: последнее значение перезаписывает предыдущее (паритет с shell).\n    74\t   ```python\n    75\t   _ALLOWED_SETTINGS_KEYS = frozenset({\n    76\t       \"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\",\n    77\t       \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\",\n    78\t       \"CLAUDE_P_BRIDGE_IO_WAIT_CAP_S\",\n    79\t       \"CLAUDE_P_BRIDGE_SAFETY_CAP_S\",\n    80\t       \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\",\n    81\t       \"BRIDGE_IDLE_TIMEOUT_S\",\n    82\t       \"BRIDGE_IO_WAIT_CAP_S\",\n    83\t       \"BRIDGE_SAFETY_CAP_S\",\n    84\t       \"BRIDGE_WATCHDOG_INTERVAL_S\",\n    85\t   })\n    86\t\n    87\t   def _read_dsh_env_file() -> dict[str, str]:\n    88\t       \"\"\"Безопасно читает только несекретные настройки из ~/.dsh/.env.\n    89\t       \n    90\t       НЕ мутирует os.environ, гарантируя полную изоляцию от окружения pytest и подпроцессов.\n    91\t       \"\"\"\n    92\t       env_file = Path.home() / \".dsh\" / \".env\"\n    93\t       if not env_file.is_file():\n    94\t           return {}\n    95\t       res: dict[str, str] = {}\n    96\t       try:\n    97\t           with open(env_file, \"r\", encoding=\"utf-8\") as f:\n    98\t               for line in f:\n    99\t                   line = line.strip()\n   100\t                   if not line or line.startswith(\"#\") or \"=\" not in line:\n   101\t                       continue\n   102\t                   if line.startswith(\"export \"):\n   103\t                       line = line[len(\"export \"):].strip()\n   104\t                   k, v = line.split(\"=\", 1)\n   105\t                   k = k.strip()\n   106\t                   v = v.strip().strip(\"'\\\"\")\n   107\t                   if k in _ALLOWED_SETTINGS_KEYS:\n   108\t                       res[k] = v\n   109\t       except OSError:\n   110\t           pass\n   111\t       return res\n   112\t\n   113\t   _DSH_ENV = _read_dsh_env_file()\n   114\t\n   115\t   def _get_setting(name: str, fallback_name: str | None = None, default: str = \"\") -> str:\n   116\t       \"\"\"Двухступенчатый каскад чтения: os.environ -> _DSH_ENV -> fallback -> default.\"\"\"\n   117\t       for k in (name, fallback_name) if fallback_name else (name,):\n   118\t           val = os.environ.get(k)\n   119\t           if val is not None and val.strip():\n   120\t               return val.strip()\n   121\t           val = _DSH_ENV.get(k)\n   122\t           if val is not None and val.strip():\n   123\t               return val.strip()\n   124\t       return default\n   125\t\n   126\t   def _get_positive_float(name: str, fallback_name: str | None = None, default: float = 0.0) -> float:\n   127\t       raw = _get_setting(name, fallback_name)\n   128\t       if not raw:\n   129\t           return default\n   130\t       try:\n   131\t           val = float(raw)\n   132\t           return val if 0 < val < float(\"inf\") else default\n   133\t       except (ValueError, TypeError):\n   134\t           return default\n   135\t   ```\n   136\t\n   137\t3. **Конфигурация параметров с каскадным fallback:**\n   138\t   ```python\n   139\t   def _is_watchdog_enabled() -> bool:\n   140\t       raw = _get_setting(\"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\", default=\"1\").lower()\n   141\t       return raw not in (\"0\", \"false\", \"no\", \"off\")\n   142\t\n   143\t   CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S = _get_positive_float(\n   144\t       \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\", \"BRIDGE_IDLE_TIMEOUT_S\", 300.0\n   145\t   )\n   146\t   CLAUDE_P_BRIDGE_IO_WAIT_CAP_S = _get_positive_float(\n   147\t       \"CLAUDE_P_BRIDGE_IO_WAIT_CAP_S\", \"BRIDGE_IO_WAIT_CAP_S\", 900.0\n   148\t   )\n   149\t   CLAUDE_P_BRIDGE_SAFETY_CAP_S = _get_positive_float(\n   150\t       \"CLAUDE_P_BRIDGE_SAFETY_CAP_S\", \"BRIDGE_SAFETY_CAP_S\", 3600.0\n   151\t   )\n   152\t   CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S = _get_positive_float(\n   153\t       \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", \"BRIDGE_WATCHDOG_INTERVAL_S\", 5.0\n   154\t   )\n   155\t   ```\n   156\t   *Примечание по рантайму и семантике таймаутов:*\n   157\t   - `idle_timeout_s` отслеживает паузы между фрагментами активности процесса. Согласно `core/watchdog.py:109-115`, I/O-grace действует при статусах процесса `S`, `D`, `I`, `U` (ожидание сокета/сети/диска). Поскольку дочерний процесс `claude` в ожидании сетевого ответа находится в состоянии `S` (sleep/wait), `AdaptiveTimeoutController` с активным `io_grace` расширяет окно неактивности до `CLAUDE_P_BRIDGE_IO_WAIT_CAP_S` (по умолчанию 900 с), предотвращая ложное прибивание при длительной генерации ответа.\n   158\t   - `safety_cap_s` задаёт **абсолютный настенный потолок хода от момента старта** (`now - started_at >= effective_cap_s`, где `effective_cap_s = safety_cap_s - finish_reserve_s` = 3565 с при дефолте 3600 с). Он принудительно завершает ход даже при непрерывной генерации токенов для гарантированной защиты от бесконечного зацикливания генерации.\n   159\t   - Сброс таймера активности: `_pump` передаёт в очередь `text`, `thinking` и `result`, на которые вызывается `record_activity(kind)`. При эмуляции инструментов вызовы формируются как фрагменты текста и регистрируются через `record_activity(\"text\")`. Если процесс выполняет внутренние операции без передачи чанков в очередь, таймер активности обновляется в методе `check()` на основе прироста CPU или обнаружения дочерних процессов (`has_progress`).\n   160\t\n   161\t4. **В методе `_execute` (в классе `Handler`):**\n   162\t   - До блока `try:` объявляется контроллер и отметка времени последней проверки с безопасным чтением процесса (защита от отсутствия атрибута `proc` в `FakeRun`):\n   163\t     ```python\n   164\t     controller = None\n   165\t     last_check_ts = time.monotonic()\n   166\t     proc = getattr(run, \"proc\", None)\n   167\t     proc_pid = getattr(proc, \"pid\", None) if proc is not None else None\n   168\t\n   169\t     if _is_watchdog_enabled() and AdaptiveTimeoutController is not None and proc_pid:\n   170\t         controller = AdaptiveTimeoutController(\n   171\t             idle_timeout_s=CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S,\n   172\t             safety_cap_s=CLAUDE_P_BRIDGE_SAFETY_CAP_S,\n   173\t             io_wait_cap_s=CLAUDE_P_BRIDGE_IO_WAIT_CAP_S,\n   174\t             watchdog_interval_s=CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S,\n   175\t         )\n   176\t         controller.register_pgid(proc_pid)\n   177\t     ```\n   178\t   - Цикл `while True:` оборачивается в `try...finally`:\n   179\t     ```python\n   180\t     try:\n   181\t         while True:\n   182\t             if _client_gone(self.connection):\n   183\t                 return state(\"client_gone\", 1)\n   184\t\n   185\t             now = time.monotonic()\n   186\t             if controller is not None and proc is not None and proc_pid and (now - last_check_ts >= controller.watchdog_interval_s):\n   187\t                 last_check_ts = now\n   188\t                 should_stop, reason, _ = controller.check(proc_pid)\n   189\t                 if should_stop and reason in (\"idle_timeout\", \"absolute_cap\"):\n   190\t                     _kill_group(proc)\n   191\t                     return state(\"timeout\", 1, f\"claude-p watchdog: {reason}\")\n   192\t                 # Если reason == \"child_exited\" — это нормальный выход потомка,\n   193\t                 # не убиваем процесс и ждем пока очередь дочитает событие \"done\"\n   194\t\n   195\t             try:\n   196\t                 kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   197\t             except queue.Empty:\n   198\t                 if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   199\t                     last_ka = time.monotonic()\n   200\t                     if not keepalive():\n   201\t                         return state(\"client_gone\", 1)\n   202\t                 continue\n   203\t\n   204\t             if controller is not None and kind in (\"text\", \"thinking\", \"result\"):\n   205\t                 controller.record_activity(kind)\n   206\t\n   207\t             if kind == \"text\":\n   208\t                 normalizer.feed_text(str(payload))\n   209\t                 if gone[0]:\n   210\t                     return state(\"client_gone\", 1)\n   211\t             elif kind == \"thinking\":\n   212\t                 normalizer.feed_thinking(str(payload))\n   213\t                 if gone[0]:\n   214\t                     return state(\"client_gone\", 1)\n   215\t             elif kind == \"result\":\n   216\t                 result_ev = payload\n   217\t                 usage = payload.get(\"usage\") or {}\n   218\t             elif kind == \"pump_error\":\n   219\t                 return state(\"pump_error\", 1, str(payload))\n   220\t             elif kind == \"done\":\n   221\t                 normalizer.finish()\n   222\t                 if gone[0]:\n   223\t                     return state(\"client_gone\", 1)\n   224\t                 time.sleep(STDERR_DRAIN_S)\n   225\t                 return state(\"done\", payload, \"\".join(run.err_box))\n   226\t     finally:\n   227\t         if controller is not None:\n   228\t             controller.close()\n   229\t     ```\n   230\t\n   231\t5. **В `@staticmethod _error_body(out: dict) -> Any`:**\n   232\t   - В начало метода до проверок `is_error` и `rc != 0`:\n   233\t     ```python\n   234\t     st = str(out.get(\"state\") or \"\")\n   235\t     if st == \"timeout\":\n   236\t         return {\n   237\t             \"message\": str(out.get(\"err\") or \"upstream timeout\"),\n   238\t             \"type\": \"upstream_timeout\",\n   239\t             \"code\": 504,\n   240\t         }\n   241\t     ```\n   242\t   *(Примечание по SSE: в потоковом ответе ошибка транслируется через `format_stream_error_sse(..., finish_reason=\"stop\")` согласно существующему контракту).*\n   243\t\n   244\t### 3.2. Настройка в `bridges/opencode-zen-bridge/server.py`\n   245\tИспользование существующего хелпера `_zen_positive_float` (`:338`):\n   246\t```python\n   247\tSTALL_TIMEOUT_S = _zen_positive_float(\n   248\t    \"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\",\n   249\t    60.0,\n   250\t)\n   251\t```\n   252\t\n   253\t---\n   254\t\n   255\t## 4. Верификационные требования и изоляция тестов\n   256\t\n   257\t### 4.1. Набор тестов для claude-p вотчдога (`tests/test_claude_p_watchdog.py`)\n   258\tРазрабатывается новый тестовый файл с детерминированными моками. Для полной изоляции от реального `~/.dsh/.env` разработчика используется модульная фикстура, которая изолирует `HOME` / `Path.home` и очищает окружение **до загрузки модуля** моста под уникальным именем:\n   259\t```python\n   260\timport importlib.util\n   261\tfrom pathlib import Path\n   262\timport sys\n   263\timport uuid\n   264\timport pytest\n   265\t\n   266\tREPO_ROOT = Path(__file__).resolve().parents[1]\n   267\t\n   268\t@pytest.fixture(scope=\"module\")\n   269\tdef isolated_claude_bridge(tmp_path_factory):\n   270\t    tmp_home = tmp_path_factory.mktemp(\"fake_home\")\n   271\t    with pytest.MonkeyPatch.context() as mp:\n   272\t        mp.setenv(\"HOME\", str(tmp_home))\n   273\t        for key in list(sys.modules.get(\"os\", __import__(\"os\")).environ.keys()):\n   274\t            if key.startswith(\"CLAUDE_P_BRIDGE_\") or key.startswith(\"BRIDGE_\"):\n   275\t                mp.delenv(key, raising=False)\n   276\t        module_name = f\"claude_p_bridge_isolated_{uuid.uuid4().hex[:8]}\"\n   277\t        spec = importlib.util.spec_from_file_location(\n   278\t            module_name,\n   279\t            REPO_ROOT / \"bridges\" / \"claude-p-bridge\" / \"server.py\",\n   280\t        )\n   281\t        mod = importlib.util.module_from_spec(spec)\n   282\t        sys.modules[module_name] = mod\n   283\t        try:\n   284\t            spec.loader.exec_module(mod)\n   285\t            yield mod\n   286\t        finally:\n   287\t            sys.modules.pop(module_name, None)\n   288\t```\n   289\tТестовые сценарии:\n   290\t1. `test_claude_p_env_loader_security`: проверка, что `_read_dsh_env_file` изолирован, не мутирует `os.environ`, читает только разрешенные ключи из whitelist, последнее значение перезаписывает предыдущее, категорически игнорируя секреты (`CLAUDE_P_BRIDGE_KEY`, `BRIDGE_KEY`, `CODEX_LB_*`, `CURSOR_*`, `MUSE_*`).\n   291\t2. `test_watchdog_timeout_trigger`: мокируется `_kill_group` (защита от вызова `os.killpg` на фейковом pid). Проверка, что при возврате `(True, \"idle_timeout\", ...)` вызывается мок `_kill_group`, возвращается статус `state(\"timeout\", 1, ...)` и `_error_body` выдаёт код 504.\n   292\t3. `test_child_exited_no_false_timeout`: проверка, что при возврате `(True, \"child_exited\", ...)` ход не прерывается ложным таймаутом, а очередь успешно дочитывает `done`.\n   293\t4. `test_watchdog_throttle`: проверка, что `controller.check()` вызывается не чаще чем раз в `controller.watchdog_interval_s`.\n   294\t5. `test_record_activity_calls`: проверка вызова `record_activity(kind)` на события `text`, `thinking` и `result`.\n   295\t6. `test_controller_closed_in_finally`: проверка гарантированного вызова `controller.close()` при любом исходе хода.\n   296\t\n   297\t### 4.2. Изоляция тестов конфигурации таймаутов (`tests/test_stream_timeout_config.py`)\n   298\t1. Во всех тестах функции `parse_live_write_timeout` (`:9-37`) добавить `monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)` для защиты от фонового окружения.\n   299\t2. Добавить тест `test_live_write_timeout_priority`:\n   300\t   - При валидном `BRIDGE_CLIENT_WRITE_TIMEOUT_S` берется оно.\n   301\t   - При невалидном `BRIDGE_CLIENT_WRITE_TIMEOUT_S` и валидном `DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S` берется legacy.\n   302\t   - При обоих невалидных возвращается переданный `default`.\n   303\t\n   304\t### 4.3. Интеграционный прогон регрессий:\n   305\tОбязательный прогон полного набора тестов моста:\n   306\t`uv run pytest -o pythonpath=. tests/test_claude_bridge.py tests/test_claude_p_watchdog.py tests/test_stream_timeout_config.py tests/test_stream_resilience.py tests/test_http_presend_resilience.py` -> 100% PASS.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '59,235p' /Users/aazhiry1/work/src/cli-agent-bridge/analysis/all-bridges-sliding-activity-window/handoff-architect.md; sed -n '365,410p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py; cat /Users/aazhiry1/work/src/cli-agent-bridge/core/watchdog.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '59,235p' /Users/aazhiry1/work/src/cli-agent-bridge/analysis/all-bridges-sliding-activity-window/handoff-architect.md; sed -n '365,410p' /Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py; cat /Users/aazhiry1/work/src/cli-agent-bridge/core/watchdog.py\"","aggregated_output":"## 3. Архитектурное задание для architect-software-product\n\n### 3.1. Внедрение вотчдога в `bridges/claude-p-bridge/server.py`\n\n1. **Изолированный защищенный импорт контроллера (размещается сразу после настройки `sys.path` на `:58-61`, сохраняя fail-closed AD-002 для `core.tool_emulation` на `:63-86`):**\n   ```python\n   try:\n       from core.watchdog import AdaptiveTimeoutController\n   except ImportError:\n       AdaptiveTimeoutController = None  # type: ignore[assignment,misc]\n   ```\n\n2. **Размещение функций конфигурации строго между `:98` и `:101` (после `_env_positive_int`, до объявления констант `ROOT`, `HOST`, `AUTH_KEY`):**\n   - Строгий whitelist ключей конфигурации: чтение любых ключей авторизации (`*_KEY`) категорически запрещено!\n   - Повторяющиеся ключи в файле: последнее значение перезаписывает предыдущее (паритет с shell).\n   ```python\n   _ALLOWED_SETTINGS_KEYS = frozenset({\n       \"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\",\n       \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\",\n       \"CLAUDE_P_BRIDGE_IO_WAIT_CAP_S\",\n       \"CLAUDE_P_BRIDGE_SAFETY_CAP_S\",\n       \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\",\n       \"BRIDGE_IDLE_TIMEOUT_S\",\n       \"BRIDGE_IO_WAIT_CAP_S\",\n       \"BRIDGE_SAFETY_CAP_S\",\n       \"BRIDGE_WATCHDOG_INTERVAL_S\",\n   })\n\n   def _read_dsh_env_file() -> dict[str, str]:\n       \"\"\"Безопасно читает только несекретные настройки из ~/.dsh/.env.\n       \n       НЕ мутирует os.environ, гарантируя полную изоляцию от окружения pytest и подпроцессов.\n       \"\"\"\n       env_file = Path.home() / \".dsh\" / \".env\"\n       if not env_file.is_file():\n           return {}\n       res: dict[str, str] = {}\n       try:\n           with open(env_file, \"r\", encoding=\"utf-8\") as f:\n               for line in f:\n                   line = line.strip()\n                   if not line or line.startswith(\"#\") or \"=\" not in line:\n                       continue\n                   if line.startswith(\"export \"):\n                       line = line[len(\"export \"):].strip()\n                   k, v = line.split(\"=\", 1)\n                   k = k.strip()\n                   v = v.strip().strip(\"'\\\"\")\n                   if k in _ALLOWED_SETTINGS_KEYS:\n                       res[k] = v\n       except OSError:\n           pass\n       return res\n\n   _DSH_ENV = _read_dsh_env_file()\n\n   def _get_setting(name: str, fallback_name: str | None = None, default: str = \"\") -> str:\n       \"\"\"Двухступенчатый каскад чтения: os.environ -> _DSH_ENV -> fallback -> default.\"\"\"\n       for k in (name, fallback_name) if fallback_name else (name,):\n           val = os.environ.get(k)\n           if val is not None and val.strip():\n               return val.strip()\n           val = _DSH_ENV.get(k)\n           if val is not None and val.strip():\n               return val.strip()\n       return default\n\n   def _get_positive_float(name: str, fallback_name: str | None = None, default: float = 0.0) -> float:\n       raw = _get_setting(name, fallback_name)\n       if not raw:\n           return default\n       try:\n           val = float(raw)\n           return val if 0 < val < float(\"inf\") else default\n       except (ValueError, TypeError):\n           return default\n   ```\n\n3. **Конфигурация параметров с каскадным fallback:**\n   ```python\n   def _is_watchdog_enabled() -> bool:\n       raw = _get_setting(\"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\", default=\"1\").lower()\n       return raw not in (\"0\", \"false\", \"no\", \"off\")\n\n   CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S = _get_positive_float(\n       \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\", \"BRIDGE_IDLE_TIMEOUT_S\", 300.0\n   )\n   CLAUDE_P_BRIDGE_IO_WAIT_CAP_S = _get_positive_float(\n       \"CLAUDE_P_BRIDGE_IO_WAIT_CAP_S\", \"BRIDGE_IO_WAIT_CAP_S\", 900.0\n   )\n   CLAUDE_P_BRIDGE_SAFETY_CAP_S = _get_positive_float(\n       \"CLAUDE_P_BRIDGE_SAFETY_CAP_S\", \"BRIDGE_SAFETY_CAP_S\", 3600.0\n   )\n   CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S = _get_positive_float(\n       \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", \"BRIDGE_WATCHDOG_INTERVAL_S\", 5.0\n   )\n   ```\n   *Примечание по рантайму и семантике таймаутов:*\n   - `idle_timeout_s` отслеживает паузы между фрагментами активности процесса. Согласно `core/watchdog.py:109-115`, I/O-grace действует при статусах процесса `S`, `D`, `I`, `U` (ожидание сокета/сети/диска). Поскольку дочерний процесс `claude` в ожидании сетевого ответа находится в состоянии `S` (sleep/wait), `AdaptiveTimeoutController` с активным `io_grace` расширяет окно неактивности до `CLAUDE_P_BRIDGE_IO_WAIT_CAP_S` (по умолчанию 900 с), предотвращая ложное прибивание при длительной генерации ответа.\n   - `safety_cap_s` задаёт **абсолютный настенный потолок хода от момента старта** (`now - started_at >= effective_cap_s`, где `effective_cap_s = safety_cap_s - finish_reserve_s` = 3565 с при дефолте 3600 с). Он принудительно завершает ход даже при непрерывной генерации токенов для гарантированной защиты от бесконечного зацикливания генерации.\n   - Сброс таймера активности: `_pump` передаёт в очередь `text`, `thinking` и `result`, на которые вызывается `record_activity(kind)`. При эмуляции инструментов вызовы формируются как фрагменты текста и регистрируются через `record_activity(\"text\")`. Если процесс выполняет внутренние операции без передачи чанков в очередь, таймер активности обновляется в методе `check()` на основе прироста CPU или обнаружения дочерних процессов (`has_progress`).\n\n4. **В методе `_execute` (в классе `Handler`):**\n   - До блока `try:` объявляется контроллер и отметка времени последней проверки с безопасным чтением процесса (защита от отсутствия атрибута `proc` в `FakeRun`):\n     ```python\n     controller = None\n     last_check_ts = time.monotonic()\n     proc = getattr(run, \"proc\", None)\n     proc_pid = getattr(proc, \"pid\", None) if proc is not None else None\n\n     if _is_watchdog_enabled() and AdaptiveTimeoutController is not None and proc_pid:\n         controller = AdaptiveTimeoutController(\n             idle_timeout_s=CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S,\n             safety_cap_s=CLAUDE_P_BRIDGE_SAFETY_CAP_S,\n             io_wait_cap_s=CLAUDE_P_BRIDGE_IO_WAIT_CAP_S,\n             watchdog_interval_s=CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S,\n         )\n         controller.register_pgid(proc_pid)\n     ```\n   - Цикл `while True:` оборачивается в `try...finally`:\n     ```python\n     try:\n         while True:\n             if _client_gone(self.connection):\n                 return state(\"client_gone\", 1)\n\n             now = time.monotonic()\n             if controller is not None and proc is not None and proc_pid and (now - last_check_ts >= controller.watchdog_interval_s):\n                 last_check_ts = now\n                 should_stop, reason, _ = controller.check(proc_pid)\n                 if should_stop and reason in (\"idle_timeout\", \"absolute_cap\"):\n                     _kill_group(proc)\n                     return state(\"timeout\", 1, f\"claude-p watchdog: {reason}\")\n                 # Если reason == \"child_exited\" — это нормальный выход потомка,\n                 # не убиваем процесс и ждем пока очередь дочитает событие \"done\"\n\n             try:\n                 kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n             except queue.Empty:\n                 if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n                     last_ka = time.monotonic()\n                     if not keepalive():\n                         return state(\"client_gone\", 1)\n                 continue\n\n             if controller is not None and kind in (\"text\", \"thinking\", \"result\"):\n                 controller.record_activity(kind)\n\n             if kind == \"text\":\n                 normalizer.feed_text(str(payload))\n                 if gone[0]:\n                     return state(\"client_gone\", 1)\n             elif kind == \"thinking\":\n                 normalizer.feed_thinking(str(payload))\n                 if gone[0]:\n                     return state(\"client_gone\", 1)\n             elif kind == \"result\":\n                 result_ev = payload\n                 usage = payload.get(\"usage\") or {}\n             elif kind == \"pump_error\":\n                 return state(\"pump_error\", 1, str(payload))\n             elif kind == \"done\":\n                 normalizer.finish()\n                 if gone[0]:\n                     return state(\"client_gone\", 1)\n                 time.sleep(STDERR_DRAIN_S)\n                 return state(\"done\", payload, \"\".join(run.err_box))\n     finally:\n         if controller is not None:\n             controller.close()\n     ```\n\n5. **В `@staticmethod _error_body(out: dict) -> Any`:**\n   - В начало метода до проверок `is_error` и `rc != 0`:\n     ```python\n     st = str(out.get(\"state\") or \"\")\n     if st == \"timeout\":\n        try:\n            proc.wait(timeout=PROCESS_WAIT_S)\n        except subprocess.TimeoutExpired:\n            reaped = False\n    if reaped:\n        for img_dir in img_dirs:  # только свои сессионные каталоги картинок\n            _cleanup_img_dir(img_dir)\n    _log(f\"shutdown: killed {len(procs)} child process group(s)\")\n    os._exit(0)\n\n\nclass Run:\n    \"\"\"Один процесс `claude -p`; поток-читатель превращает stdout в события очереди.\"\"\"\n\n    def __init__(self, prompt: str, model: str, effort: str, tag: str,\n                 img_dir: Path | None = None):\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n        # С картинками Claude работает из сессионного каталога вложений: пути\n        # в секции [attachments] относительные, Read ограничен этим каталогом.\n        cmd = _build_claude_cmd(model, effort, img_dir)\n        self.cmd = cmd\n        self.img_dir = img_dir\n        _log(f\"exec model={model} effort={effort} prompt_bytes={len(prompt.encode())} {tag}\")\n        child_env = os.environ.copy()\n        child_env[\"HOME\"] = str(_prepare_claude_home())\n        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n\n        self.proc = subprocess.Popen(\n            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n            start_new_session=True, env=child_env,\n        )\n        with _active_lock:\n            _active[self.proc.pid] = self.proc\n        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n        self._closed = threading.Event()\n        self.err_box = []\n        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n        threading.Thread(target=self._drain_stderr, daemon=True).start()\n        threading.Thread(target=self._pump, daemon=True).start()\n\n    def _feed(self, prompt: str) -> None:\n        \"\"\"Промпт уходит только через stdin.\"\"\"\n        try:\n            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n\nМодуль реализует двухконтурный контроль времени хода исключительно средствами\nстандартной библиотеки Python на macOS (Darwin):\n1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n   абсолютный потолок длительности хода независимо от активности.\n\nПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\nфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nimport math\nimport os\nimport re\nimport subprocess\nimport threading\nimport time\n\nIDLE_TIMEOUT_S: float = 300.0\nSAFETY_CAP_S: float = 3600.0\nFINISH_RESERVE_S: float = 35.0\nWATCHDOG_INTERVAL_S: float = 5.0\nPS_TIMEOUT_S: float = 2.0\n\nDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\nDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\nDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n\n\ndef positive_env(name: str, default: float) -> float:\n    \"\"\"Читает конечное положительное число, сохраняя безопасный fallback.\"\"\"\n    try:\n        value = float(os.environ.get(name, str(default)))\n    except (TypeError, ValueError, OverflowError):\n        return default\n    return value if math.isfinite(value) and value > 0 else default\n\n\ndef io_grace_enabled() -> bool:\n    \"\"\"Читает явный булев переключатель; некорректное значение даёт дефолт true.\"\"\"\n    value = os.environ.get(\"BRIDGE_IO_GRACE_ENABLED\", \"true\").strip().lower()\n    if value in (\"0\", \"false\", \"no\", \"off\"):\n        return False\n    return True\n\n\n_PS_LINE_RE = re.compile(\n    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n)\n\n\ndef parse_cputime(raw: str) -> float:\n    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    token = (raw or \"\").strip()\n    if not token:\n        return 0.0\n    days = 0\n    if \"-\" in token:\n        day_part, token = token.split(\"-\", 1)\n        try:\n            days = int(day_part)\n        except ValueError:\n            return 0.0\n    parts = token.split(\":\")\n    try:\n        if len(parts) == 3:\n            hours = int(parts[0])\n            minutes = int(parts[1])\n            seconds = float(parts[2])\n        elif len(parts) == 2:\n            hours = 0\n            minutes = int(parts[0])\n            seconds = float(parts[1])\n        elif len(parts) == 1:\n            hours = 0\n            minutes = 0\n            seconds = float(parts[0])\n        else:\n            return 0.0\n    except ValueError:\n        return 0.0\n    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n    return max(0.0, float(total))\n\n\n@dataclass(frozen=True)\nclass WatchdogMetrics:\n    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n\n    pgid: int\n    alive: bool\n    descendant_pids: tuple[int, ...]\n    new_descendants: tuple[int, ...]\n    cpu_time_s: float\n    cpu_delta_s: float\n    ps_degraded: bool = False\n    sample_ts: float = 0.0\n    states: list[str] = field(default_factory=list)\n\n    def is_waiting_io(self) -> bool:\n        \"\"\"Живая группа ожидает I/O; учитывается первая буква stat без флагов ps.\"\"\"\n        return (\n            self.alive\n            and not self.ps_degraded\n            and any(state[:1].upper() in {\"S\", \"D\", \"I\", \"U\"} for state in self.states)\n        )\n\n    @property\n    def has_progress(self) -> bool:\n        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n        if self.ps_degraded or not self.alive:\n            return False\n        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n\n    has_activity = has_progress\n\n\nclass ProcessWatchdog:\n    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n\n    def __init__(\n        self,\n        ps_timeout_s: float = PS_TIMEOUT_S,\n        log_fn: Callable[[str], None] | None = None,\n        rid: str = \"\",\n        turn_id: str = \"\",\n    ) -> None:\n        self.ps_timeout_s = float(ps_timeout_s)\n        self._log_fn = log_fn\n        self.rid = rid\n        self.turn_id = turn_id\n        self._lock = threading.Lock()\n        self._prev_cpu_by_pgid: dict[int, dict[int, float]] = {}\n        self._seen_descendants_by_pgid: dict[int, set[int]] = {}\n        self._seeded_pgids: set[int] = set()\n\n    def _log(self, msg: str) -> None:\n        if self._log_fn is not None:\n            try:\n                self._log_fn(msg)\n            except Exception:  # noqa: BLE001\n                pass\n\n    @staticmethod\n    def is_group_alive(pgid: int) -> bool:\n        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return False\n        try:\n            os.killpg(pgid, 0)\n        except ProcessLookupError:\n            return False\n        except PermissionError:\n            return True\n        except OSError:\n            return False\n        return True\n\n    def forget(self, pgid: int) -> None:\n        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n        with self._lock:\n            self._prev_cpu_by_pgid.pop(pgid, None)\n            self._seen_descendants_by_pgid.pop(pgid, None)\n            self._seeded_pgids.discard(pgid)\n\n    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n        return subprocess.run(\n            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n            capture_output=True,\n            text=True,\n            timeout=self.ps_timeout_s,\n            check=False,\n        )\n\n    def _parse_ps_output(\n        self, stdout: str, target_pgid: int\n    ) -> tuple[list[int], dict[int, float], list[str]]:\n        \"\"\"Возвращает PID, CPU и реальные состояния незавершённых членов группы.\"\"\"\n        descendants: list[int] = []\n        cpu_by_pid: dict[int, float] = {}\n        states: list[str] = []\n        for raw_line in (stdout or \"\").splitlines():\n            line = raw_line.strip()\n            if not line:\n                continue\n            match = _PS_LINE_RE.match(line)\n            if match is None:\n                continue\n            try:\n                pid = int(match.group(1))\n                _ppid = int(match.group(2))\n                pgid_col = int(match.group(3))\n            except ValueError:\n                continue\n            if pgid_col != target_pgid:\n                continue\n            stat = match.group(4) or \"\"\n            cputime_str = match.group(5) or \"\"\n            if stat[:1].upper() in {\"Z\", \"X\"}:\n                continue\n            states.append(stat)\n            cpu_by_pid[pid] = parse_cputime(cputime_str)\n            if pid != target_pgid:\n                descendants.append(pid)\n        descendants.sort()\n        return descendants, cpu_by_pid, states\n\n    def seed(self, pgid: int, *, rid: str = \"\", turn_id: str = \"\") -> WatchdogMetrics:\n        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n        return metrics\n\n    def sample(\n        self,\n        pgid: int,\n        *,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        _seed_only: bool = False,\n    ) -> WatchdogMetrics:\n        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n        now = time.monotonic()\n        eff_rid = rid or self.rid or \"-\"\n        eff_turn = turn_id or self.turn_id or \"-\"\n        if not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        try:\n            proc = self._run_ps(pgid)\n        except (subprocess.TimeoutExpired, OSError) as exc:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        if proc.returncode != 0:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        descendants, cpu_s, states = self._parse_ps_output(proc.stdout, pgid)\n        if not states and not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        with self._lock:\n            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n            if _seed_only:\n                for pid, val in cpu_s.items():\n                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n                seen_desc.update(descendants)\n                self._seeded_pgids.add(pgid)\n                total_cpu = sum(cpu_s.values())\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=True,\n                    descendant_pids=tuple(descendants),\n                    new_descendants=(),\n                    cpu_time_s=total_cpu,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                    states=states,\n                )\n\n            cpu_delta = sum(\n                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n            )\n            new_desc = tuple(sorted(set(descendants) - seen_desc))\n            for pid, val in cpu_s.items():\n                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n            seen_desc.update(descendants)\n            self._seeded_pgids.add(pgid)\n            total_cpu = sum(cpu_s.values())\n\n        return WatchdogMetrics(\n            pgid=pgid,\n            alive=True,\n            descendant_pids=tuple(descendants),\n            new_descendants=new_desc,\n            cpu_time_s=total_cpu,\n            cpu_delta_s=cpu_delta,\n            ps_degraded=False,\n            sample_ts=now,\n            states=states,\n        )\n\n\nclass AdaptiveTimeoutController:\n    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n\n    def __init__(\n        self,\n        idle_timeout_s: float = IDLE_TIMEOUT_S,\n        safety_cap_s: float | None = None,\n        finish_reserve_s: float = FINISH_RESERVE_S,\n        watchdog: ProcessWatchdog | None = None,\n        watchdog_enabled: bool = True,\n        clock: Callable[[], float] = time.monotonic,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        log_fn: Callable[[str], None] | None = None,\n        io_wait_cap_s: float | None = None,\n        watchdog_interval_s: float | None = None,\n    ) -> None:\n        self.watchdog_interval_s = (\n            positive_env(\"BRIDGE_WATCHDOG_INTERVAL_S\", WATCHDOG_INTERVAL_S)\n            if watchdog_interval_s is None\n            else float(watchdog_interval_s)\n        )\n        self.idle_timeout_s = max(\n            10.0, float(idle_timeout_s), 2 * self.watchdog_interval_s\n        )\n        self.safety_cap_s = (\n            positive_env(\n                \"BRIDGE_SAFETY_CAP_S\",\n                positive_env(\"DROID_DSH_BRIDGE_SAFETY_CAP_S\", SAFETY_CAP_S),\n            )\n            if safety_cap_s is None\n            else float(safety_cap_s)\n        )\n        self.io_wait_cap_s = (\n            positive_env(\"BRIDGE_IO_WAIT_CAP_S\", 900.0)\n            if io_wait_cap_s is None\n            else float(io_wait_cap_s)\n        )\n        self.io_grace_enabled = io_grace_enabled()\n        self.finish_reserve_s = float(finish_reserve_s)\n        self.watchdog_enabled = bool(watchdog_enabled)\n        self._clock = clock\n        self.rid = rid\n        self.turn_id = turn_id\n        self._log_fn = log_fn\n        self.watchdog = watchdog or ProcessWatchdog(\n            log_fn=log_fn, rid=rid, turn_id=turn_id\n        )\n        self._lock = threading.Lock()\n        now = self._clock()\n        self.started_at: float = now\n        self.last_activity_ts: float = now\n        self.last_activity_kind: str = \"start\"\n        self.pgid: int | None = None\n        self.terminated_reason: str = \"\"\n\n    def effective_cap_s(self) -> float:\n        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n        if self.safety_cap_s > self.finish_reserve_s:\n            return self.safety_cap_s - self.finish_reserve_s\n        return max(0.01, self.safety_cap_s)\n\n    def record_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n        now = self._clock()\n        with self._lock:\n            self.last_activity_ts = now\n            self.last_activity_kind = kind or \"protocol\"\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n        self.record_activity(kind)\n\n    def register_pgid(self, pgid: int) -> None:\n        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return\n        with self._lock:\n            self.pgid = pgid\n        if self.watchdog_enabled and self.watchdog is not None:\n            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n\n    def check(\n        self, pgid: int | None = None\n    ) -> tuple[bool, str, WatchdogMetrics | None]:\n        \"\"\"Проверяет условия завершения хода.\n\n        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n        `should_stop == True` принимает одно из значений:\n        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n        - `\"child_exited\"` — процессная группа завершилась.\n        \"\"\"\n        with self._lock:\n            target_pgid = pgid if pgid is not None else self.pgid\n            started_at = self.started_at\n\n        now = self._clock()\n        if now - started_at >= self.effective_cap_s():\n            with self._lock:\n                self.terminated_reason = \"absolute_cap\"\n            return True, \"absolute_cap\", None\n\n        metrics: WatchdogMetrics | None = None\n        if (\n            self.watchdog_enabled\n            and self.watchdog is not None\n            and isinstance(target_pgid, int)\n            and target_pgid > 0\n        ):\n            metrics = self.watchdog.sample(\n                target_pgid, rid=self.rid, turn_id=self.turn_id\n            )\n            if not metrics.alive:\n                with self._lock:\n                    self.terminated_reason = \"child_exited\"\n                return True, \"child_exited\", metrics\n            if metrics.has_progress:\n                with self._lock:\n                    self.last_activity_ts = now\n                    self.last_activity_kind = (\n                        \"new_descendants\"\n                        if metrics.new_descendants\n                        else \"cpu_delta\"\n                    )\n\n        with self._lock:\n            idle_elapsed = now - self.last_activity_ts\n            if idle_elapsed >= self.idle_timeout_s and not self.has_io_grace(\n                metrics, idle_elapsed\n            ):\n                self.terminated_reason = \"idle_timeout\"\n                return True, \"idle_timeout\", metrics\n\n        return False, \"\", metrics\n\n    def has_io_grace(\n        self, metrics: WatchdogMetrics | None, idle_elapsed: float\n    ) -> bool:\n        \"\"\"Даёт ограниченную отсрочку I/O без подмены last_activity_ts.\"\"\"\n        return bool(\n            self.io_grace_enabled\n            and metrics is not None\n            and metrics.is_waiting_io()\n            and idle_elapsed < self.io_wait_cap_s\n        )\n\n    def close(self) -> None:\n        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n        with self._lock:\n            pgid = self.pgid\n        if pgid is not None and self.watchdog is not None:\n            self.watchdog.forget(pgid)\n\n\n# Имя из контракта контроллера хода; прежний импорт остаётся совместимым.\nTurnTimeoutController = AdaptiveTimeoutController\n","exit_code":0,"status":"completed"}}
