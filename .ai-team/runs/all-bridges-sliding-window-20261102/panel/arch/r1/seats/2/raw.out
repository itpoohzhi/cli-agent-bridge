server.py-1952-STATUS_CONTINUATION = \"[мост] Ожидание продолжения…\\n\"\nbridges/opencode-zen-bridge/server.py-1953-_SERVE_ALLOWLIST = (\nbridges/opencode-zen-bridge/server.py-1954-    \"PATH\",\nbridges/opencode-zen-bridge/server.py-1955-    \"HOME\",\n--\nbridges/opencode-zen-bridge/server.py-4151-        if mapped is None:\nbridges/opencode-zen-bridge/server.py-4152-            continue\nbridges/opencode-zen-bridge/server.py-4153-        mapped_kind, payload = mapped\nbridges/opencode-zen-bridge/server.py-4154-        if attempt_deadline is not None:\nbridges/opencode-zen-bridge/server.py-4155-            wait_deadline = min(\nbridges/opencode-zen-bridge/server.py-4156-                hard_deadline,\nbridges/opencode-zen-bridge/server.py-4157-                max(\nbridges/opencode-zen-bridge/server.py-4158-                    wait_deadline,\nbridges/opencode-zen-bridge/server.py-4159-                    time.monotonic()\nbridges/opencode-zen-bridge/server.py:4160:                    + min(_STEP_DRAIN_WINDOW_S, float(STALL_TIMEOUT_S)),\nbridges/opencode-zen-bridge/server.py-4161-                ),\nbridges/opencode-zen-bridge/server.py-4162-            )\nbridges/opencode-zen-bridge/server.py-4163-        if mapped_kind == \"permission_replied\":\nbridges/opencode-zen-bridge/server.py-4164-            replied_id = str(payload.get(\"id\") or \"\").strip()\nbridges/opencode-zen-bridge/server.py-4165-            if replied_id:\nbridges/opencode-zen-bridge/server.py-4166-                replied_perms.add(replied_id)\nbridges/opencode-zen-bridge/server.py-4167-            continue\nbridges/opencode-zen-bridge/server.py-4168-        if mapped_kind == \"permission\":\nbridges/opencode-zen-bridge/server.py-4169-            request_id = str(payload.get(\"id\") or \"\").strip()\n--\nbridges/opencode-zen-bridge/server.py-4896-            if (\nbridges/opencode-zen-bridge/server.py-4897-                result[\"first_event_at\"] is not None\nbridges/opencode-zen-bridge/server.py-4898-                and result[\"first_token_at\"] is None\nbridges/opencode-zen-bridge/server.py-4899-                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\nbridges/opencode-zen-bridge/server.py-4900-            ):\nbridges/opencode-zen-bridge/server.py-4901-                result[\"exit_reason\"] = \"first_token_timeout\"\nbridges/opencode-zen-bridge/server.py-4902-                result[\"delivered\"] = True\nbridges/opencode-zen-bridge/server.py-4903-                return result\nbridges/opencode-zen-bridge/server.py-4904-            if result[\"first_token_at\"] is not None and now - last_token_at > float(\nbridges/opencode-zen-bridge/server.py:4905:                STALL_TIMEOUT_S\nbridges/opencode-zen-bridge/server.py-4906-            ):\nbridges/opencode-zen-bridge/server.py-4907-                result[\"exit_reason\"] = \"stall_timeout\"\nbridges/opencode-zen-bridge/server.py-4908-                result[\"delivered\"] = True\nbridges/opencode-zen-bridge/server.py-4909-                return result\nbridges/opencode-zen-bridge/server.py-4910-            # Классификация HTTP-статуса prompt по FALLBACK_DECISION_TABLE до ожидания SSE-события.\nbridges/opencode-zen-bridge/server.py-4911-            _ps = prompt_status.get(\"status\")\nbridges/opencode-zen-bridge/server.py-4912-            if isinstance(_ps, int) and _ps != 200 and result[\"prompt_status\"] is None:\nbridges/opencode-zen-bridge/server.py-4913-                result[\"prompt_status\"] = _ps\nbridges/opencode-zen-bridge/server.py-4914-                if _ps in (401, 403):\n--\nbridges/opencode-zen-bridge/server.py-6802-            ):\nbridges/opencode-zen-bridge/server.py-6803-                reason = \"first_event_timeout\"\nbridges/opencode-zen-bridge/server.py-6804-            elif first_token_at is None and now - attempt_start > float(\nbridges/opencode-zen-bridge/server.py-6805-                FIRST_TOKEN_TIMEOUT_S\nbridges/opencode-zen-bridge/server.py-6806-            ):\nbridges/opencode-zen-bridge/server.py-6807-                reason = \"first_token_timeout\"\nbridges/opencode-zen-bridge/server.py-6808-            elif (\nbridges/opencode-zen-bridge/server.py-6809-                last_token_at is not None\nbridges/opencode-zen-bridge/server.py-6810-                and not subagent_started_at\nbridges/opencode-zen-bridge/server.py:6811:                and now - last_token_at > float(STALL_TIMEOUT_S)\nbridges/opencode-zen-bridge/server.py-6812-            ):\nbridges/opencode-zen-bridge/server.py-6813-                reason = \"stall_timeout\"\nbridges/opencode-zen-bridge/server.py-6814-            if reason:\nbridges/opencode-zen-bridge/server.py-6815-                watchdog_reason.append(reason)\nbridges/opencode-zen-bridge/server.py-6816-                state = reason\nbridges/opencode-zen-bridge/server.py-6817-                _log(f\"opencode run watchdog: {reason}\")\nbridges/opencode-zen-bridge/server.py-6818-                if self.proc is not None:\nbridges/opencode-zen-bridge/server.py-6819-                    _stop_proc(self.proc)\nbridges/opencode-zen-bridge/server.py-6820-\n--\nbridges/opencode-zen-bridge/server.py-8451-                        watchdog_state[\"first_event_at\"] is not None\nbridges/opencode-zen-bridge/server.py-8452-                        and watchdog_state[\"first_token_at\"] is None\nbridges/opencode-zen-bridge/server.py-8453-                        and now_s - attempt_start > float(FIRST_TOKEN_TIMEOUT_S)\nbridges/opencode-zen-bridge/server.py-8454-                    ):\nbridges/opencode-zen-bridge/server.py-8455-                        watchdog_state[\"reason\"] = \"first_token_timeout\"\nbridges/opencode-zen-bridge/server.py-8456-                        _stop_proc(proc)\nbridges/opencode-zen-bridge/server.py-8457-                        return\nbridges/opencode-zen-bridge/server.py-8458-                    if watchdog_state[\"first_token_at\"] is not None and now_s - float(\nbridges/opencode-zen-bridge/server.py-8459-                        watchdog_state[\"last_token_at\"]\nbridges/opencode-zen-bridge/server.py:8460:                    ) > float(STALL_TIMEOUT_S):\nbridges/opencode-zen-bridge/server.py-8461-                        watchdog_state[\"reason\"] = \"stall_timeout\"\nbridges/opencode-zen-bridge/server.py-8462-                        _stop_proc(proc)\nbridges/opencode-zen-bridge/server.py-8463-                        return\nbridges/opencode-zen-bridge/server.py-8464-                    try:\nbridges/opencode-zen-bridge/server.py-8465-                        if thinking_enabled and now_s >= float(\nbridges/opencode-zen-bridge/server.py-8466-                            watchdog_state[\"status_next\"]\nbridges/opencode-zen-bridge/server.py-8467-                        ):\nbridges/opencode-zen-bridge/server.py-8468-                            if watchdog_state[\"first_token_at\"] is None:\nbridges/opencode-zen-bridge/server.py-8469-                                if (\ntests/test_claude_bridge.py\ntests/test_opencode_zen_bridge.py\ntests/test_stream_timeout_config.py\n---\nname: answer-review-loop\ndescription: >-\n  Проверяет артефакт тройкой Скептиков zero-canon R1→D1. Когда: перед итогом задачи >1 шага, фактологическими проверками стенда/инфры, оперативными справками, выводами анализа/архитектуры, pre-action конфигов/сервисов, verify/smoke, close.md и Outline; короткий ответ — on-demand.\n---\n\n# Проверка тройкой Скептиков\n\n## Когда читать / когда не читать\n\n**Читать и выполнять обязательно (без напоминания владельца):**\n\n1. **Перед итоговым содержательным ответом любой многошаговой задачи (`>1` шага по `cel`) и аналитическим/архитектурным выводом в чате** (сдача, выводы анализа, архитектура, код/конфиг) — с обязательной отметкой `[ПРОВЕРЕНО ЛУПОМ: тройка R1→D1 OK (исправлено M, отсеяно галлюцинаций H)]`.\n2. **Pre-action гейт (до исполнения):** перед применением любых новых конфигов, лимитов памяти/пулов/воркеров, миграций, DAG, правил роутинга, перед запуском серверов/БД/пулеров (`PgBouncer`, `Redis`, `PostgreSQL`, прокси, воркеров, контейнеров) или переходом к шагу `verify`/`smoke`. **Запрет параметров по умолчанию:** проверяемый черновик/конфиг обязан содержать явный расчёт параметров под целевую нагрузку (`concurrency / RPS → лимиты клиентских и серверных пулов/соединений, памяти и таймаутов`); запуск сервиса или пулера с непросчитанными дефолтными лимитами (`default_pool_size`, `max_client_conn` и т.п.) блокируется как `[BLOCKER]`.\n3. **Pre-close гейт (до закрытия):** перед записью `close.md` (`ГОТОВО`) в `/tmp/cel-runs/<slug>/` и перед публикацией документа в Outline (`outline-kb`).\n4. **По прямому запросу владельца (`on-demand`):** для любого короткого ответа («прогони через лёгкий луп», «проверь ответ субагентами»).\n5. **Перед любым ответом владельцу, содержащим проверяемые утверждения о конкретном стенде, хосте, инфраструктуре, сервисах, процессах, портах, конфигурациях, файлах, кодовой базе или оперативных данных** (включая оперативные справки, уточнения, диагностику 502/ошибок и проверку гипотез) — независимо от количества шагов (включая 1 шаг), краткости ответа, отсутствия изменений и использования cel. Короткий поиск и точечный опрос без cel от лупа не освобождают.\n\n**Не читать (без лупа, если владелец не запросил `on-demand` явно):**\n\n- чистые приветствия, благодарности и подтверждения получения сообщений («привет», «спасибо», «принято», «понял») без содержательных фактов о системах (слово «готов» исключено во избежание путаницы со стендом);\n- промежуточные организационные 5-минутки и статусы `cel` без утверждений о состоянии стенда, систем, конфигураций или кода;\n- встречные уточняющие вопросы агента владельцу (`ASK`), не содержащие таких утверждений;\n- внутренние ответы сабагентов оркестратору и вызовы чекера `cel` (итоговый ответ владельцу проверяется по общим триггерам);\n- сообщения исключительно о невозможности выполнить проверку стенда или запустить луп (с фиксацией открытого ограничения, без домыслов).\n\nОдношаговые быстрые справки о стенде, сервисах, конфигурациях и коде НЕ являются исключением: при наличии проверяемых утверждений луп обязателен.\n\nДля полного цикла разработки кода/MR с советом тимлидов используй\n`teamlead-gate`, для текста голосом владельца — `clean-text`.\n`universal-panel` — совет с ACCEPT/REJECT; `universal-reviewer` — общее ревью;\n`brief-review` — проверка брифа; `fact-check-answers` — самопроверка фактов.\n`acceptance-gate` — приёмка результата. Эти job не подменяй данным лупом.\nПроверка миграции перед применением не заменяет ревью её разработки.\n\n## Границы и гейт\n\nОдна job: проверить конкретный артефакт перед действием или ответом.\nРевьюеры возвращают замечания, автор сверяет и исправляет; оркестратор собирает\nреестр и проверяет доказательства. Этот луп не выдаёт ACCEPT совета тимлидов.\nДеградация лупа не ослабляет отдельный кворум SDLC-панели и живую приёмку. Изолированный сабпроцесс под ролевой шляпой (в Совете тимлидов или панели) действует автономно: случайный запуск под другой шляпой или совпадение семейства с автором решения НЕ является основанием для отмены или перезапуска Совета, а замечания Скептиков с требованием перезапуска по этому мотиву отклоняются как ложные блокеры.\n\nОбычный режим — одна итерация с обязательным перекрёстным раундом: R1 → D1 → при спорных блокерах D2.\nПолный режим — перед Outline или по запросу «полный луп до 3 итераций»:\nдо трёх итераций проверки полного текста с историей исправлений.\nD1/D2 — дебаты внутри итерации, а не расход следующих итераций исправления.\n[FACT] и три линзы обязательны; [CLARITY] включается только в полном режиме.\n\nКаждый запуск — Host-Native Zero-Canon Isolation, без Docker: чистый cwd,\nнет канона, глобальных хуков, MCP, инструментов и истории чата.\nПрофиль и резервирование — [транспортный гейт](references/transport-gate.md).\n\n### Пул моделей для троек\n\nЕдинственный источник состава роли и pinned live ID — роль **«Ревью ответа (`answer-review-loop`) — быстрые Скептики `zero-canon` (`R1 → D1 [→ D2]`)»** в `~/Мой диск/Context/models.md`. Статусы `LIMIT BLOCKED`, `TEMP OFF` и лимиты — `~/Мой диск/Context/model-notes.md`; транспорты и профили `zero-canon` — `~/Мой диск/skils/panel-backends/references/model-invocation.md`.\n\n- По этой роли запускай фиксированную основную тройку параллельно, без жребия: 3 модели из 3 разных семейств (`family`).\n- Слот резерв №1 из ~/Мой диск/Context/models.md подставляй только при отказе или недоступности одного из трёх основных слотов (или статусе TEMP OFF в ~/Мой диск/Context/model-notes.md).\n- Не подмешивай пулы Coder, Architect, Analyst, Reviewer и судей `default`/`quality`; этот луп использует только быстрые модели своей роли.\n\n### Транспорт (единый канон — panel-backends):\nПорядок и физический способ вызова моделей и сабагентов (собственные нативные сабагенты хоста → универсальный мост `:9882` по HTTP → терминальный CLI-фолбэк) определяется **СТРОГО ЕДИНЫМ ИСТОЧНИКОМ ТРАНСПОРТОВ** — скиллом `~/Мой диск/skils/panel-backends/SKILL.md` и подразделом «Профили чистого листа (Host-Native Zero-Canon) для answer-review-loop» в `~/Мой диск/skils/panel-backends/references/model-invocation.md` (мост `:9882` — приоритетный транспорт; терминальный CLI — аварийный фолбэк при сбое моста). Собственных правил транспорта скилл не объявляет.\n\nОперационные лимиты и потолки (включая 900 с и надзор по\n`~/Мой диск/skils/cel/references/liveness-detector.md`) — только в\n`~/Мой диск/Context/model-notes.md`. Не превращай резерв в четвёртый голос;\nдождись всех назначенных вызовов. Расхождение источников — недоступность слота, не обход.\n\n## Алгоритм\n\n### 1. Определи гейт и режим\n\n**Действие:** прочитай [правила](references/rules-full.md) и\n[полный алгоритм](references/algorithm-full.md), классифицируй триггер.\n**Вход:** запрос и предстоящее действие либо ответ.\n**Наблюдаемый выход:** обычный/полный режим и объект проверки. Для pre-action\nобязателен явный расчёт `concurrency / RPS → клиентские и серверные пулы/соединения,\nпамять, таймауты`: укажи исходную целевую нагрузку, формулы и итоговые значения.\nНет расчёта или оставлены непросчитанные дефолтные лимиты — `[BLOCKER]`;\nприменение конфига, запуск сервиса/БД/пулера и `verify`/`smoke` запрещены до закрытия.\n**Условие остановки / ветка ошибки:** исключение → профильный скилл;\nнет триггера → обычный ответ без запуска; неясен объект → запроси его.\n\n### 2. Собери очищенный бриф\n\n**Действие:** прочитай [промпты](references/prompts-and-examples.md) и\n[рубрику](references/rubric-and-verdict.md), собери одинаковый бриф для слотов.\n**Вход:** постановка дословно, полный артефакт, предоставленные первоисточники.\n**Наблюдаемый выход:** бриф без секретов и авторских рассуждений, версия/SHA объекта. Для проверок стенда/инфраструктуры в бриф обязательно включаются точные команды (на darwin: `lsof -nP -iTCP -sTCP:LISTEN`, `ps -o pid,comm`), коды возврата, время и сырой stdout/stderr без секретов.\nВ полном режиме со второй итерации приложи накопительную историю.\n**Условие остановки / ветка ошибки:** пустой артефакт → верни автору;\nнеочищаемый или не помещающийся целиком бриф → остаток, без заявления OK.\n\n### 3. Изолируй и запусти R1\n\n**Действие:** прочитай [транспортный гейт](references/transport-gate.md),\nподтверди zero-canon профиль и запусти основную тройку параллельно в фоне.\nШаблон запуска возьми из указанного подраздела `model-invocation.md`;\nв транспортном гейте — только инварианты изоляции и деградация.\n**Вход:** очищенный бриф и три линзы Скептика.\n**Наблюдаемый выход:** по каждому слоту сырой ответ (`>64` байт), завершение и OK/ISSUES\nлибо точная причина отказа; резерв подставлен при необходимости.\n**Условие остановки / ветка ошибки:** при двух доступных — `пул 2/3`;\nпри одной — `пул 1/3 (без перекрёстных дебатов)` и проверка каждого замечания\nоркестратором по первоисточнику; при 0/4 →\n`ОСТАТОК РЕВЬЮ: ревью недоступно (<причины по слотам>)`.\nНедоказанная изоляция считается недоступностью слота, не голосом.\n\n### 4. Собери реестр кандидатов для обязательного D1\n\n**Действие:** прочитай раздел разбора в\n[рубрике](references/rubric-and-verdict.md); проверь цитаты и формат R1.\nСобери обезличенный дедуп-реестр кандидатов F1..Fk и перейди к обязательному раунду D1 (шаг 5).\n**Вход:** завершённые независимые ответы, исходный артефакт.\n**Наблюдаемый выход:** обезличенный дедуп-реестр F1..Fk с цитатами и механизмами\nотказа; даже если все 3 слота в R1 вернули OK (0 замечаний), раунд D1 обязателен\nкак перекрёстная сверка трёх ответов R1 и подтверждение отсутствия пропущенных\nошибок в артефакте.\n**Условие остановки / ветка ошибки:** при пуле 3/3 или 2/3 → обязательный D1\n(шаг 5); для пары при деградации 2/3 — аналогично обязательный D1; только при\nдеградации до 1/3 перекрёстных дебатов нет → шаг 7.\nOK со списком ошибок или ISSUES без цитат/механизмов — malformed, не чистый OK.\n\n### 5. Проведи перекрёстный факт-чек D1\n\n**Действие:** прочитай D1-промпт в\n[промптах](references/prompts-and-examples.md), отправь всем активным участникам\nисходный артефакт и тот же реестр F1..Fk без авторства пунктов.\n**Вход:** реестр и полная неизменная редакция артефакта R1.\n**Наблюдаемый выход:** параллельные CONFIRMED/FALSE_POSITIVE по каждому F;\nдля подтверждения — цитата/расчёт, для опровержения — контр-цитата/расчёт.\n**Условие остановки / ветка ошибки:** ≥2/3 подтверждений (пара: 2/2) →\nCONFIRMED ISSUE; 0/3 или 1/3 при двух доказательных опровержениях →\nREJECTED HALLUCINATION. Недостаток доказательств → спорный, не галлюцинация.\nОтказавший участник не голосует; пересчитай пул по транспортному гейту.\n\n### 6. Разреши спорные блокеры D2\n\n**Действие:** прочитай правила блокеров в\n[полном алгоритме](references/algorithm-full.md) и D2-промпт в\n[промптах](references/prompts-and-examples.md).\n**Вход:** только спорные BLOCKER-SAFETY / падение прод-контура, аргументы ЗА\nи ПРОТИВ из D1, исходный артефакт.\n**Наблюдаемый выход:** один прицельный параллельный D2 и итоговое голосование.\n**Условие остановки / ветка ошибки:** нет таких споров → шаг 7;\nесть 1/3 без прямого контрдоказательства остальных → D2 обязателен\nпо жёсткому гейту 2 `~/Мой диск/Context/AGENTS.md`;\n≥2/3 (пара: 2/2) → подтверждено, иначе нерешённое →\n`ОСТАТОК РЕВЬЮ: спорный`. Блокер не снимается одним большинством против:\nнужно контрдоказательство либо принятие риска владельцем.\n\n### 7. Сверь и исправь\n\n**Действие:** прочитай ветку исправления в\n[полном алгоритме](references/algorithm-full.md); проверь согласованные пункты\nпо первоисточнику и передай автору только доказанные исправления.\n**Вход:** результаты D1/D2 либо единственного ревьюера, исходные данные.\n**Наблюдаемый выход:** M исправленных пунктов, H доказательно отсеянных\nгаллюцинаций, журнал источников и закрытия. Для pre-action конфига/скрипта\nперепроверь исправленный артефакт либо закрой каждый пункт по чек-листу.\n**Условие остановки / ветка ошибки:** нет источника/сохранился спор → остаток;\nобычный режим → шаг 8 без новой итерации; полный → полный новый бриф\nс историей, пока не чистый вердикт или три итерации. Стагнация → стоп с остатком.\n\n### 8. Сообщи итог и закрой временные материалы\n\n**Действие:** прочитай форматы сдачи в\n[рубрике](references/rubric-and-verdict.md), сопоставь итог с исходным запросом.\n**Вход:** проверенный артефакт, счётчики, открытые пункты и размер пула.\n**Наблюдаемый выход:** `тройка R1→D1: OK (исправлено M, отсеяно галлюцинаций H)`\n(с явной допиской D2, деградации пула и уровня факт-чека при наличии).\n**Условие остановки / ветка ошибки:** остаток → перечисли его вместо OK;\npre-action/pre-close с незакрытым остатком не разрешает действие/«готово».\nПолный режим после правок требует проверки полного текста следующей итерацией;\nлимит исчерпан → остаток «исправлен, но не перепроверен» либо «не исправлен».\nУдали только собственный временный профиль после сохранения нужных свидетельств.\n\n## DoD\n\n- Триггер, режим, версия объекта и фактический пул названы.\n- Zero-canon подтверждён; три основных слота запускались параллельно.\n- Проведён обязательный обезличенный раунд D1 (включая перекрёстную сверку при 0 замечаний в R1); спорные блокеры прошли D2 или вынесены в остаток.\n- Каждый принятый пункт проверен; каждая галлюцинация имеет контрдоказательство.\n- Pre-action исправления перепроверены/закрыты чек-листом; полный режим имеет\n  финальное полное ревью; незакрытое не замаскировано словом OK.\n\n## Основания и ссылки\n\nЗамер 2026-10-29: `/tmp/cel-runs/fast-review-panel-bench/suite100-v2-summary.json`\nи `reviewer-100-v2-final-audit.md` в том же каталоге: 21×10=210 ответов,\n100 дефектов в 10 заданиях; основная тройка — 97/100, медиана 31.13 с,\nодиночные конфигурации четырёх слотов роли (flash-med 79, deepseek-off 79,\nterra-med 82, резерв haiku-low 84) — 79–84/100\n(по всем 14 skeptic-конфигурациям стенда — 66–84/100).\nЭто regex-recall объединения, не доказанная точность согласованного D1;\nвремя расчётное, без накладных расходов и дебатов. Ориентир полного прогона\nR1→D1 — ~50 с в сумме (по выбору владельца 2026-10-29), при этом расчётная\nмедиана R1 по бенчмарку — 31.13 с (не таймаут и не SLA;\nнадзор живости — по liveness-detector.md).\nУсловный D2 для неразрешённых BLOCKER-SAFETY следует из жёсткого гейта 2\n`~/Мой диск/Context/AGENTS.md`: большинство без контрдоказательства\nили принятия риска владельцем блокер не снимает.\nПодробности: `~/Мой диск/Работа/Sber/knowledge-base/tools/fast-review-panel-benchmark-2026-10-29.md`\n(срез 2026-10-29); актуальность ролей/запретов — `models.md`/`model-notes.md` выше.\n\nПрежний `description` до этой редакции сохранён дословно: [description-history.md](references/description-history.md).\n\n## Анти-паттерны\n\n- Не подменяй роль «Ревью ответа (`answer-review-loop`) — быстрые Скептики `zero-canon` (`R1 → D1 [→ D2]`)» из `~/Мой диск/Context/models.md` другими ролями; ограничения сверяй в `~/Мой диск/Context/model-notes.md`, профили — в `~/Мой диск/skils/panel-backends/references/model-invocation.md`.\n- Не спавнь внешние терминальные CLI-клиенты (`codex exec`, `claude -p`, `agy.real`), пока доступен единый мост `:9882`. Терминальные клиенты в шелле триггерят глобальные хуки (`inject-agents-canon.py`), разрушают Zero-Canon изоляцию и создают дикий оверхед по времени.\n- Не симулируй и не используй платформенные таски (`Task`, `task-NNN`, `invoke_subagent` для внешних моделей).\n- Не смешивай этот луп с Советом Тимлидов (`teamlead-gate`) и SDLC-приёмкой: КАТЕГОРИЧЕСКИ ЗАПРЕЩЕНО требовать или выводить в отчёте блоки `PANEL PROOF`, `ПРОВЕРЕНО ЛЁГКИМ / ПРОВЕРЕНО ТЯЖЁЛЫМ / НЕ ПРОВЕРЕНО`, `ЗАПИСАНО В KB` или `JIRA?`.\n- Единственный валидный формат отметки успешного лупа в ответе — [ПРОВЕРЕНО ЛУПОМ: тройка R1→D1 OK (исправлено M, отсеяно галлюцинаций H)].\n- Не запускай старую последовательную цепочку и не передавай историю/канон.\n- Не называй отсутствие большинства доказательством галлюцинации.\n- Не считай timeout, malformed, отказ или текст оркестратора голосом.\n- Не выдавай расчётные 31.13 с за SLA и 97/100 за качество дебатов.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '540,820p' bridges/claude-p-bridge/server.py | nl -ba -v540; sed -n '394,410p' server.py | nl -ba -v394; sed -n '325,365p' bridges/opencode-zen-bridge/server.py | nl -ba -v325; sed -n '1928,1998p' bridges/opencode-zen-bridge/server.py | nl -ba -v1928; rg --files tests -g '*claude*' -g '*stream_timeout*' -g '*opencode*'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '540,820p' bridges/claude-p-bridge/server.py | nl -ba -v540; sed -n '394,410p' server.py | nl -ba -v394; sed -n '325,365p' bridges/opencode-zen-bridge/server.py | nl -ba -v325; sed -n '1928,1998p' bridges/opencode-zen-bridge/server.py | nl -ba -v1928; rg --files tests -g '*claude*' -g '*stream_timeout*' -g '*opencode*'\"","aggregated_output":"   540\t        tools и при tool_choice=none): повреждённый `<tool_call>` поднимает\n   541\t        `LiveParserError`, сырой XML в content не уходит; распознанный вызов без\n   542\t        эмуляции — ошибка протокола, а не опубликованный инструмент. Reasoning\n   543\t        (нативный thinking и теги в тексте) публикуется до терминального события.\n   544\t        \"\"\"\n   545\t        pieces = []\n   546\t        reasoning_pieces: list = []\n   547\t        tool_calls: list = []\n   548\t        usage = {}\n   549\t        result_ev = {}\n   550\t        tool_schemas = build_tool_schemas(tools or [])\n   551\t        last_ka = time.monotonic()\n   552\t        gone = [False]\n   553\t\n   554\t        def state(name: str, rc: int, err: str = \"\") -> dict:\n   555\t            return {\"rc\": rc, \"text\": \"\".join(pieces), \"usage\": usage,\n   556\t                    \"reasoning\": \"\".join(reasoning_pieces),\n   557\t                    \"result\": result_ev, \"state\": name, \"err\": err,\n   558\t                    \"tool_calls\": tool_calls}\n   559\t\n   560\t        def add_content(text: str) -> None:\n   561\t            if gone[0] or not text:\n   562\t                return\n   563\t            pieces.append(text)\n   564\t            if not on_text(text):\n   565\t                gone[0] = True\n   566\t\n   567\t        def add_reasoning(text: str) -> None:\n   568\t            if gone[0] or not text:\n   569\t                return\n   570\t            reasoning_pieces.append(text)\n   571\t            if not on_reasoning(text):\n   572\t                gone[0] = True\n   573\t\n   574\t        def add_call(call: dict) -> None:\n   575\t            if gone[0]:\n   576\t                return\n   577\t            if not emulate_tools:\n   578\t                raise LiveParserError(\"tool_call published without tool emulation\")\n   579\t            entry = {\n   580\t                \"index\": len(tool_calls),\n   581\t                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n   582\t                \"type\": \"function\",\n   583\t                \"function\": {\n   584\t                    \"name\": call[\"name\"],\n   585\t                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n   586\t                },\n   587\t            }\n   588\t            # Схемная санитизация — ровно один раз на владельце маршрута (AD-004).\n   589\t            for item in sanitize_tool_call(entry, tool_schemas):\n   590\t                item = dict(item, index=len(tool_calls))\n   591\t                tool_calls.append(item)\n   592\t                if not on_tool_call(item):\n   593\t                    gone[0] = True\n   594\t                    return\n   595\t\n   596\t        normalizer = StreamNormalizer(\n   597\t            add_content, add_reasoning, add_call, strict_live=True\n   598\t        )\n   599\t\n   600\t        while True:\n   601\t            if _client_gone(self.connection):\n   602\t                return state(\"client_gone\", 1)\n   603\t            try:\n   604\t                kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   605\t            except queue.Empty:\n   606\t                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   607\t                    last_ka = time.monotonic()\n   608\t                    if not keepalive():\n   609\t                        return state(\"client_gone\", 1)\n   610\t                continue\n   611\t            if kind == \"text\":\n   612\t                normalizer.feed_text(str(payload))\n   613\t                if gone[0]:\n   614\t                    return state(\"client_gone\", 1)\n   615\t            elif kind == \"thinking\":\n   616\t                normalizer.feed_thinking(str(payload))\n   617\t                if gone[0]:\n   618\t                    return state(\"client_gone\", 1)\n   619\t            elif kind == \"result\":\n   620\t                result_ev = payload\n   621\t                usage = payload.get(\"usage\") or {}\n   622\t            elif kind == \"pump_error\":\n   623\t                return state(\"pump_error\", 1, str(payload))\n   624\t            elif kind == \"done\":\n   625\t                # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n   626\t                # сырой XML текстом не досбрасываем. Fallback на терминальный\n   627\t                # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n   628\t                normalizer.finish()\n   629\t                if gone[0]:\n   630\t                    return state(\"client_gone\", 1)\n   631\t                time.sleep(STDERR_DRAIN_S)\n   632\t                return state(\"done\", payload, \"\".join(run.err_box))\n   633\t\n   634\t    def _run_once(self, req: dict, on_text, on_reasoning, on_tool_call, keepalive) -> dict:\n   635\t        raw_messages = req.get(\"messages\")\n   636\t        messages: list = raw_messages if isinstance(raw_messages, list) else []\n   637\t        raw_tools = req.get(\"tools\")\n   638\t        tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n   639\t        tool_choice = req.get(\"tool_choice\")\n   640\t        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n   641\t        model, model_err = _resolve_model(req)\n   642\t        if model_err is not None:\n   643\t            return {\"state\": \"bad_model\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   644\t                    \"err\": model_err[\"message\"], \"tool_calls\": []}\n   645\t        try:\n   646\t            images = _extract_request_images(req)\n   647\t        except ImageInputError as exc:\n   648\t            return {\"state\": \"bad_image\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   649\t                    \"err\": exc.code, \"tool_calls\": []}\n   650\t        prompt = _messages_to_prompt(messages, tools, tool_choice, images or None)\n   651\t        effort = _effort(req.get(\"reasoning_effort\"), model)\n   652\t        tag = (f\"client={self.client_address[0]}:{self.client_address[1]} \"\n   653\t               f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\")\n   654\t        reason = self._acquire_slot(keepalive)\n   655\t        if reason:\n   656\t            _log(f\"no slot ({reason}) model={model} effort={effort} {tag}\")\n   657\t            return {\"state\": reason, \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   658\t                    \"err\": \"\", \"tool_calls\": []}\n   659\t        t0 = time.monotonic()\n   660\t        img_dir = None\n   661\t        can_cleanup = True\n   662\t        try:\n   663\t            try:\n   664\t                img_dir = _stage_images(images)\n   665\t                run = Run(prompt, model, effort, tag, img_dir=img_dir)\n   666\t                can_cleanup = False\n   667\t            except OSError as exc:\n   668\t                _log(f\"image stage/spawn failed model={model} err={exc!r:.200} {tag}\")\n   669\t                return {\"state\": \"image_error\", \"rc\": 1, \"text\": \"\", \"usage\": {},\n   670\t                        \"result\": {}, \"err\": str(exc)[:200], \"tool_calls\": []}\n   671\t            try:\n   672\t                out = self._execute(run, on_text, on_reasoning, on_tool_call,\n   673\t                                    keepalive, emulate_tools, tools)\n   674\t            except LiveParserError as exc:\n   675\t                # AD-004: битый поток — 502 proxy_error; сырой XML клиенту не уходит.\n   676\t                _log(f\"parser_error model={model} err={exc} {tag}\")\n   677\t                out = {\"state\": \"parser_error\", \"rc\": 1, \"text\": \"\", \"reasoning\": \"\",\n   678\t                       \"usage\": {}, \"result\": {}, \"err\": str(exc), \"tool_calls\": []}\n   679\t            finally:\n   680\t                run.close()  # сначала завершить и reap своего ребёнка\n   681\t                can_cleanup = True\n   682\t        finally:\n   683\t            if can_cleanup:\n   684\t                _cleanup_img_dir(img_dir)\n   685\t            _slots.release()\n   686\t        out_calls = out.get(\"tool_calls\")\n   687\t        out_text = out.get(\"text\")\n   688\t        _log(f\"done model={model} effort={effort} rc={out['rc']} state={out['state']} \"\n   689\t             f\"tools={len(out_calls) if isinstance(out_calls, list) else 0} \"\n   690\t             f\"out_bytes={len(out_text.encode()) if isinstance(out_text, str) else 0} \"\n   691\t             f\"wall_s={time.monotonic() - t0:.1f} {tag}\")\n   692\t        return out\n   693\t\n   694\t    @staticmethod\n   695\t    def _error_body(out: dict) -> Any:\n   696\t        st = out.get(\"state\")\n   697\t        if st == \"bad_model\":\n   698\t            return {\"message\": str(out.get(\"err\")), \"type\": \"invalid_request_error\", \"code\": 400}\n   699\t        if st == \"bad_image\":\n   700\t            return {\"message\": f\"invalid image input: {out.get('err')}\",\n   701\t                    \"type\": \"invalid_request_error\", \"code\": 400}\n   702\t        if st == \"parser_error\":\n   703\t            return {\"message\": \"malformed tool_call stream\",\n   704\t                    \"type\": \"proxy_error\", \"code\": 502}\n   705\t        if st == \"image_error\":\n   706\t            return {\"message\": \"image staging or spawn failed\",\n   707\t                    \"type\": \"proxy_error\", \"code\": 502}\n   708\t        if st == \"queue_timeout\":\n   709\t            return {\"message\": f\"bridge busy: queue full over {QUEUE_TIMEOUT_S}s\",\n   710\t                    \"type\": \"overloaded\", \"code\": 503}\n   711\t        if st == \"client_gone\":\n   712\t            return {\"message\": \"client gone\", \"type\": \"client_gone\", \"code\": 499}\n   713\t        if st == \"pump_error\":\n   714\t            return {\"message\": \"bridge reader failed\", \"detail\": str(out.get(\"err\"))[:500],\n   715\t                    \"type\": \"proxy_error\", \"code\": 502}\n   716\t        if (out.get(\"result\") or {}).get(\"is_error\"):\n   717\t            detail = str((out[\"result\"].get(\"result\")) or out.get(\"err\") or \"claude reported an error\")\n   718\t            if \"<tool_call\" in detail:  # сырой XML не публикуется даже в тексте ошибки\n   719\t                detail = \"claude reported an error\"\n   720\t            return {\"message\": detail[:500], \"type\": \"claude_error\", \"code\": 502}\n   721\t        if out.get(\"rc\") != 0 or not (out.get(\"text\") or out.get(\"tool_calls\")):\n   722\t            return {\"message\": f\"claude exited rc={out.get('rc')}\",\n   723\t                    \"detail\": str(out.get(\"err\"))[:500], \"type\": \"proxy_error\", \"code\": 502}\n   724\t        return None\n   725\t\n   726\t    # ---- HTTP --------------------------------------------------------------------\n   727\t    def do_GET(self) -> None:  # noqa: N802\n   728\t        path = self.path.split(\"?\", 1)[0]\n   729\t        if path in (\"/health\", \"/v1/health\"):\n   730\t            with _active_lock:\n   731\t                active = len(_active)\n   732\t            self._send(200, {\n   733\t                \"ok\": True, \"transport\": \"claude-p\", \"model\": MODEL_ID,\n   734\t                \"models\": list(SUPPORTED_MODELS),\n   735\t                \"active\": active, \"max_concurrent\": MAX_CONCURRENT,\n   736\t                \"tool_emulation\": True, \"images\": True, \"live_reasoning\": True,\n   737\t                \"uptime_s\": int(time.time() - _started),\n   738\t            })\n   739\t            return\n   740\t        if not _auth_ok(self):\n   741\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   742\t            return\n   743\t        if path in (\"/v1/models\", \"/models\"):\n   744\t            self._send(200, {\"object\": \"list\", \"data\": [{\n   745\t                \"id\": model_id, \"object\": \"model\", \"owned_by\": \"anthropic\",\n   746\t                \"created\": 0, \"context_length\": MODEL_CONTEXT.get(model_id, CONTEXT_LENGTH),\n   747\t            } for model_id in SUPPORTED_MODELS]})\n   748\t            return\n   749\t        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   750\t\n   751\t    def do_POST(self) -> None:  # noqa: N802\n   752\t        if not _auth_ok(self):\n   753\t            # Непрочитанное тело иначе будет разобрано как следующий запрос keep-alive.\n   754\t            self.close_connection = True\n   755\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   756\t            return\n   757\t        path = self.path.split(\"?\", 1)[0]\n   758\t        try:\n   759\t            length = int(self.headers.get(\"Content-Length\") or \"0\")\n   760\t        except ValueError:\n   761\t            length = -1\n   762\t        if length < 0 or length > MAX_REQUEST_BYTES:\n   763\t            self.close_connection = True\n   764\t            self._send(413 if length > MAX_REQUEST_BYTES else 400,\n   765\t                       {\"error\": {\"message\": \"invalid request body length\"}})\n   766\t            return\n   767\t        raw = self.rfile.read(length) if length else b\"{}\"\n   768\t        try:\n   769\t            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n   770\t        except ValueError:\n   771\t            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n   772\t            return\n   773\t        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n   774\t            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   775\t            return\n   776\t        # Невалидную модель отсекаем до SSE-заголовков, иначе 400 уже не отправить.\n   777\t        _model, model_err = _resolve_model(req)\n   778\t        if model_err is not None:\n   779\t            self._send(400, {\"error\": {\"message\": model_err[\"message\"],\n   780\t                                       \"type\": model_err[\"type\"]}})\n   781\t            return\n   782\t        # Невалидные изображения отсекаем там же, до спавна и SSE-заголовков.\n   783\t        try:\n   784\t            _extract_request_images(req)\n   785\t        except ImageInputError as exc:\n   786\t            self._send(400, {\"error\": {\"message\": f\"invalid image input: {exc.code}\",\n   787\t                                       \"type\": \"invalid_request_error\"}})\n   788\t            return\n   789\t        if req.get(\"stream\"):\n   790\t            self._serve_sse(req)\n   791\t        else:\n   792\t            self._serve_json(req)\n   793\t\n   794\t    def _serve_json(self, req: dict) -> None:\n   795\t        out = self._run_once(req, lambda _v: True, lambda _v: True, lambda _e: True, None)\n   796\t        if out.get(\"state\") == \"client_gone\":\n   797\t            return\n   798\t        err = self._error_body(out)\n   799\t        if err is not None:\n   800\t            self._send(err[\"code\"], {\"error\": err})\n   801\t            return\n   802\t        usage = out.get(\"usage\") or {}\n   803\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n   804\t        if out.get(\"reasoning\"):\n   805\t            message[\"reasoning_content\"] = out[\"reasoning\"]\n   806\t        finish = \"stop\"\n   807\t        if out.get(\"tool_calls\"):\n   808\t            message[\"tool_calls\"] = out[\"tool_calls\"]\n   809\t            finish = \"tool_calls\"\n   810\t        self._send(200, {\n   811\t            \"id\": f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n   812\t            \"created\": int(time.time()), \"model\": req.get(\"model\") or MODEL_ID,\n   813\t            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n   814\t            \"usage\": {\n   815\t                \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n   816\t                \"completion_tokens\": usage.get(\"output_tokens\", 0),\n   817\t                \"total_tokens\": usage.get(\"input_tokens\", 0) + usage.get(\"output_tokens\", 0),\n   818\t            },\n   819\t        })\n   820\t\n   394\tdef parse_live_write_timeout(default: float = 30.0) -> float:\n   395\t    \"\"\"Читает таймаут записи, возвращая default при неверном значении ENV.\"\"\"\n   396\t    raw = os.environ.get(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"\").strip()\n   397\t    if not raw:\n   398\t        return default\n   399\t    try:\n   400\t        val = float(raw)\n   401\t        if not (1.0 <= val <= 300.0):\n   402\t            return default\n   403\t        return val\n   404\t    except (ValueError, TypeError):\n   405\t        return default\n   406\t\n   407\t\n   408\tLIVE_WRITE_TIMEOUT_S: float = parse_live_write_timeout(30.0)\n   409\t# Таймаут первого события stream-json от `droid exec` (с момента старта процесса).\n   410\tFIRST_TOKEN_TIMEOUT_S = float(\n   325\t    \"\"\"Применить общий санитизатор на единой границе всех маршрутов ответа.\"\"\"\n   326\t    if not BRIDGE_SANITIZE_TOOL_CALLS:\n   327\t        return calls\n   328\t    return sanitize_tool_calls_list(calls, schemas, **_SANITIZE_LIMITS)\n   329\t\n   330\t\n   331\tHOST = os.environ.get(\"OPENCODE_ZEN_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\n   332\tPORT = _positive_int(os.environ.get(\"OPENCODE_ZEN_BRIDGE_PORT\"), 9883)\n   333\tAUTH_KEY = os.environ.get(\"OPENCODE_ZEN_BRIDGE_KEY\", \"\").strip()\n   334\t\n   335\tTIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\n   336\t\n   337\t\n   338\tdef _zen_positive_float(name: str, default: float) -> float:\n   339\t    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\n   340\t    try:\n   341\t        value = float(os.environ.get(name, str(default)))\n   342\t        return value if 0 < value < float(\"inf\") else default\n   343\t    except ValueError:\n   344\t        return default\n   345\t\n   346\t\n   347\tdef _zen_targeted(model: str, prompt: str) -> bool:\n   348\t    \"\"\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\"\"\"\n   349\t    models = {\n   350\t        \"deepseek-v4.1-flash-free\",\n   351\t        *filter(\n   352\t            None, re.split(r\"[,\\s]+\", os.environ.get(\"BRIDGE_ZEN_TIMEOUT_MODELS\", \"\"))\n   353\t        ),\n   354\t    }\n   355\t    threshold = _positive_int(os.environ.get(\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\"), 8192)\n   356\t    return model in models and len(prompt.encode(\"utf-8\")) > threshold\n   357\t\n   358\t\n   359\tdef _zen_ttft_timeout(model: str, prompt: str) -> float:\n   360\t    \"\"\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\"\"\"\n   361\t    if _zen_targeted(model, prompt):\n   362\t        return min(\n   363\t            TIMEOUT_S,\n   364\t            _zen_positive_float(\n   365\t                \"BRIDGE_ZEN_TTFT_TIMEOUT_S\",\n  1928\t            env[\"OPENCODE_MODELS_PATH\"] = OPENCODE_MODELS_PATH\n  1929\t            env[\"OPENCODE_DISABLE_MODELS_FETCH\"] = \"1\"\n  1930\t    else:\n  1931\t        for name in _PROXY_VARS:\n  1932\t            env.pop(name, None)\n  1933\t        env[\"NO_PROXY\"] = \"127.0.0.1,localhost\"\n  1934\t    return env\n  1935\t\n  1936\t\n  1937\tDYNAMIC_CONFIG_PATH = Path(__file__).resolve().parent / \"dynamic_config.json\"\n  1938\tLEASE_DIR = Path(\"/tmp/opencode-zen-bridge-leases\")\n  1939\tSERVE_TEST_ELIGIBLE = False\n  1940\tFIRST_EVENT_TIMEOUT_S = float(\n  1941\t    os.environ.get(\"OPENCODE_ZEN_BRIDGE_FIRST_EVENT_TIMEOUT_S\", \"20.0\")\n  1942\t)\n  1943\tFIRST_TOKEN_TIMEOUT_S = float(\n  1944\t    os.environ.get(\"OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S\", \"60.0\")\n  1945\t)\n  1946\tSTALL_TIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\", \"60.0\"))\n  1947\tFIRST_STATUS_DELAY_S = 0.65\n  1948\tSTATUS_WAITING_INTERVAL_S = 5.0\n  1949\tSTALL_HEARTBEAT_INTERVAL_S = 15.0\n  1950\tSTATUS_INITIAL = \"[мост] Подключение к модели…\\n\"\n  1951\tSTATUS_WAITING = \"[мост] Ожидание первого токена…\\n\"\n  1952\tSTATUS_CONTINUATION = \"[мост] Ожидание продолжения…\\n\"\n  1953\t_SERVE_ALLOWLIST = (\n  1954\t    \"PATH\",\n  1955\t    \"HOME\",\n  1956\t    \"USER\",\n  1957\t    \"LOGNAME\",\n  1958\t    \"SHELL\",\n  1959\t    \"LANG\",\n  1960\t    \"LC_ALL\",\n  1961\t    \"LC_CTYPE\",\n  1962\t    \"TZ\",\n  1963\t    \"TERM\",\n  1964\t    \"COLORTERM\",\n  1965\t    \"HTTP_PROXY\",\n  1966\t    \"HTTPS_PROXY\",\n  1967\t    \"ALL_PROXY\",\n  1968\t    \"NO_PROXY\",\n  1969\t    \"http_proxy\",\n  1970\t    \"https_proxy\",\n  1971\t    \"all_proxy\",\n  1972\t    \"no_proxy\",\n  1973\t    \"SSL_CERT_FILE\",\n  1974\t    \"SSL_CERT_DIR\",\n  1975\t    \"NODE_EXTRA_CA_CERTS\",\n  1976\t    \"XDG_DATA_HOME\",\n  1977\t    \"XDG_CONFIG_HOME\",\n  1978\t    \"OPENCODE_CONFIG\",\n  1979\t    \"OPENCODE_CONFIG_CONTENT\",\n  1980\t    \"OPENCODE_MODELS_PATH\",\n  1981\t)\n  1982\t_dynamic_config_cache: dict[str, object] = {\"key\": None, \"value\": False, \"path\": \"\"}\n  1983\t_LSOF_CALLS: collections.deque[int] = collections.deque(maxlen=64)\n  1984\t_PORT_ALLOC_LOCK = threading.Lock()\n  1985\t_ACTIVE_SERVE_PORTS: set[int] = set()\n  1986\t_MAX_STDERR_TAIL_BYTES = 16384\n  1987\t_STDERR_CHUNK_READ_BYTES = 4096\n  1988\t_MAX_SSE_LINE_BYTES = 1024 * 1024\n  1989\t_STEP_DRAIN_WINDOW_S = 1.0\n  1990\t_MAX_SERVE_QUEUE_BYTES = 16 * 1024 * 1024\n  1991\t_MAX_SERVE_ACCUMULATED_BYTES = 16 * 1024 * 1024\n  1992\t_MAX_SERVE_HTTP_BODY_BYTES = 8 * 1024 * 1024\n  1993\t_MAX_SERVE_NATIVE_TOOLS = 128\n  1994\t_DOWNSTREAM_WRITE_TIMEOUT_S = 5.0\n  1995\t_AUX_IO_BUDGET_S = 54.0\n  1996\t\n  1997\t\n  1998\tclass ServeUnavailable(Exception):\ntests/test_claude_bridge.py\ntests/test_opencode_zen_bridge.py\ntests/test_stream_timeout_config.py\n","exit_code":0,"status":"completed"}}
