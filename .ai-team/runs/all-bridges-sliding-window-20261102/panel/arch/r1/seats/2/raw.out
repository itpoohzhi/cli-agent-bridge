CODE_ZEN_BRIDGE_KEY\", \"\").strip()\nbridges/opencode-zen-bridge/server.py-334-\nbridges/opencode-zen-bridge/server.py-335-TIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\nbridges/opencode-zen-bridge/server.py-336-\nbridges/opencode-zen-bridge/server.py-337-\nbridges/opencode-zen-bridge/server.py:338:def _zen_positive_float(name: str, default: float) -> float:\nbridges/opencode-zen-bridge/server.py-339-    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\nbridges/opencode-zen-bridge/server.py-340-    try:\nbridges/opencode-zen-bridge/server.py-341-        value = float(os.environ.get(name, str(default)))\nbridges/opencode-zen-bridge/server.py-342-        return value if 0 < value < float(\"inf\") else default\nbridges/opencode-zen-bridge/server.py-343-    except ValueError:\nbridges/opencode-zen-bridge/server.py-344-        return default\nbridges/opencode-zen-bridge/server.py-345-\nbridges/opencode-zen-bridge/server.py-346-\nbridges/opencode-zen-bridge/server.py-347-def _zen_targeted(model: str, prompt: str) -> bool:\n--\nbridges/opencode-zen-bridge/server.py-367-            ),\nbridges/opencode-zen-bridge/server.py-368-        )\nbridges/opencode-zen-bridge/server.py-369-    return TIMEOUT_S\nbridges/opencode-zen-bridge/server.py-370-\nbridges/opencode-zen-bridge/server.py-371-\nbridges/opencode-zen-bridge/server.py-372-def _zen_idle_timeout(model: str, prompt: str) -> float:\nbridges/opencode-zen-bridge/server.py-373-    \"\"\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\"\"\"\nbridges/opencode-zen-bridge/server.py-374-    if not _zen_targeted(model, prompt):\nbridges/opencode-zen-bridge/server.py-375-        return TIMEOUT_S\nbridges/opencode-zen-bridge/server.py:376:    return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_IDLE_TIMEOUT_S\", 15.0))\nbridges/opencode-zen-bridge/server.py-377-\nbridges/opencode-zen-bridge/server.py-378-\nbridges/opencode-zen-b