{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"rg --files '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/all-bridges-sliding-window-20261102/architecture' '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/all-bridges-sliding-window-20261102/plans'; nl -ba '/Users/aazhiry1/work/src/cli-agent-bridge/bridges/claude-p-bridge/server.py'\"","aggregated_output":"/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/all-bridges-sliding-window-20261102/architecture/architecture-packet.json\n/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/all-bridges-sliding-window-20261102/plans/architect-01.json\n     1\t#!/usr/bin/env python3\n     2\t\"\"\"OpenAI-совместимый мост к CLI `claude -p` (Claude Code).\n     3\t\n     4\tОдин запрос /v1/chat/completions = один headless-ход\n     5\t`claude -p --output-format stream-json --verbose --include-partial-messages`.\n     6\tПоток stream-json переводится в OpenAI Chat Completions (stream и не-stream).\n     7\t\n     8\tМост эмулирует OpenAI function calling: если запрос содержит непустой `tools`,\n     9\tв промпт добавляется протокол и схемы инструментов, а встроенные инструменты\n    10\tClaude Code отключаются (`--tools \"\"`). Модель просят отвечать блоками\n    11\t`<tool_call>{\"name\":…,\"arguments\":{…}}</tool_call>`; потоковые блоки переводятся\n    12\tв OpenAI-чанки `delta.tool_calls`, история с `tool_calls`/`role:\"tool\"`\n    13\tрендерится обратно в те же блоки.\n    14\t\n    15\tОбщая протокольная логика живёт только в универсальном ядре `core/` (ADR 0014,\n    16\tAD-002: этот файл в репозитории — SSOT, локальных копий парсера нет; без core\n    17\tмост не стартует). Весь поток Claude всегда проходит через\n    18\t`core.tool_emulation.StreamNormalizer` поверх\n    19\t`ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON): повреждённый XML не\n    20\tпопадает в `content`, fallback на терминальный `result` исключён, ошибка\n    21\tпотока — корректный `502 proxy_error`.\n    22\t\n    23\tИзображения (`image_url` data URI PNG/JPEG) мост материализует в изолированный\n    24\tсессионный каталог `/tmp/claude-img-<uuid>/` (0700, файлы 0600) и запускает\n    25\tClaude с `--allowedTools \"Read(<каталог>/**)\"`, `--restricted` и\n    26\t`--add-dir <каталог>` (AD-003, workspace-read);\n    27\tкаталог удаляется в `finally` после подтверждённого завершения ребёнка. Без\n    28\tкартинок сохраняется прежний режим `--tools \"\"`.\n    29\t\n    30\tReasoning публикуется в реальном времени (AD-005): нативные `thinking_delta` и\n    31\tтеги размышлений в тексте уходят в SSE как `choices[0].delta.reasoning_content`\n    32\tдо терминального события; в JSON тот же накопленный итог отдаётся как\n    33\t`message.reasoning_content`.\n    34\t\n    35\tСекреты с диска не читаются: ключ авторизации берётся только из окружения\n    36\tCLAUDE_P_BRIDGE_KEY, переменные окружения ребёнка не трогаются.\n    37\t\"\"\"\n    38\t\n    39\tfrom __future__ import annotations\n    40\t\n    41\timport hmac\n    42\timport json\n    43\timport os\n    44\timport queue\n    45\timport select\n    46\timport shutil\n    47\timport signal\n    48\timport socket\n    49\timport subprocess\n    50\timport sys\n    51\timport threading\n    52\timport time\n    53\timport uuid\n    54\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n    55\tfrom pathlib import Path\n    56\tfrom typing import Any\n    57\t\n    58\t_REPO_ROOT = Path(__file__).resolve().parents[2]\n    59\tfor _p in (_REPO_ROOT, Path(__file__).resolve().parents[1]):\n    60\t    if str(_p) not in sys.path:\n    61\t        sys.path.insert(0, str(_p))\n    62\t\n    63\ttry:\n    64\t    from core.stream_framing import format_stream_error_sse\n    65\t    from core.tool_emulation import (  # noqa: E402\n    66\t        DEFAULT_MAX_IMAGE_BYTES,\n    67\t        DEFAULT_MAX_IMAGES,\n    68\t        DEFAULT_MAX_TOTAL_IMAGE_BYTES,\n    69\t        ImageInputError,\n    70\t        LiveParserError,\n    71\t        StreamNormalizer,\n    72\t        _messages_to_prompt,\n    73\t        _tool_choice_none,\n    74\t        build_tool_schemas,\n    75\t        extract_data_url_images,\n    76\t        extract_thinking_delta,\n    77\t        sanitize_tool_call,\n    78\t    )\n    79\texcept ImportError as exc:\n    80\t    # Fail-closed (AD-002): без согласованного core мост не запускается;\n    81\t    # встроенной запасной копии парсера не существует.\n    82\t    sys.stderr.write(\n    83\t        \"claude-p-bridge: core.tool_emulation is required \"\n    84\t        f\"(repo root {_REPO_ROOT}): {exc}\\n\"\n    85\t    )\n    86\t    raise SystemExit(1) from exc\n    87\t\n    88\t\n    89\tdef _env_positive_int(name: str, default: int) -> int:\n    90\t    \"\"\"Положительное целое из env; пустое/нечисловое/неположительное -> default.\"\"\"\n    91\t    raw = os.environ.get(name, \"\").strip()\n    92\t    if not raw:\n    93\t        return default\n    94\t    try:\n    95\t        value = int(raw)\n    96\t    except ValueError:\n    97\t        return default\n    98\t    return value if value > 0 else default\n    99\t\n   100\t\n   101\tROOT = Path(__file__).resolve().parent\n   102\tHOST = os.environ.get(\"CLAUDE_P_BRIDGE_HOST\", \"127.0.0.1\")\n   103\tPORT = int(os.environ.get(\"CLAUDE_P_BRIDGE_PORT\", \"9881\"))\n   104\tAUTH_KEY = os.environ.get(\"CLAUDE_P_BRIDGE_KEY\", \"\").strip()\n   105\tMODEL_ID = os.environ.get(\"CLAUDE_P_BRIDGE_MODEL\", \"claude-sonnet-5-5\")\n   106\t# Поддерживаемые модели -> уровень effort по умолчанию (если reasoning_effort не задан).\n   107\tSUPPORTED_MODELS = {\n   108\t    \"claude-opus-5-5\": \"high\",\n   109\t    \"claude-sonnet-5-5\": \"high\",\n   110\t    \"claude-haiku-5-5\": \"high\",\n   111\t}\n   112\tCLAUDE_BIN = os.environ.get(\n   113\t    \"CLAUDE_P_BRIDGE_BIN\",\n   114\t    shutil.which(\"claude\") or os.path.expanduser(\"~/.local/bin/claude\")\n   115\t)\n   116\tMCP_CONFIG = ROOT / \"empty-mcp.json\"\n   117\tWORKSPACE = ROOT / \"workspace\"\n   118\t\n   119\t\n   120\t_CLAUDE_HOME_LOCK = threading.Lock()\n   121\t_CLAUDE_HOME_INITIALIZED = False\n   122\t\n   123\t\n   124\tdef _prepare_claude_home() -> Path:\n   125\t    \"\"\"Подготовить изолированный фиктивный HOME для claude -p (P0/P2 Zero-Canon).\n   126\t\n   127\t    В ~/.claude/ переносятся только файлы авторизации, настроек и сертификатов,\n   128\t    без глобальных инструкций (agents-global.md, CLAUDE.md) и пользовательских расширений.\n   129\t    Защита от race condition (F-001): потокобезопасная однократная инициализация под lock,\n   130\t    атомарная запись через временный файл (os.replace) и строгие права 0700/0600.\n   131\t    \"\"\"\n   132\t    global _CLAUDE_HOME_INITIALIZED\n   133\t    real_claude = Path.home() / \".claude\"\n   134\t    home = WORKSPACE / \"runtime\" / \"claude-home\"\n   135\t    claude_dir = home / \".claude\"\n   136\t\n   137\t    if _CLAUDE_HOME_INITIALIZED and claude_dir.is_dir():\n   138\t        return home\n   139\t\n   140\t    with _CLAUDE_HOME_LOCK:\n   141\t        if _CLAUDE_HOME_INITIALIZED and claude_dir.is_dir():\n   142\t            return home\n   143\t\n   144\t        home.mkdir(parents=True, exist_ok=True)\n   145\t        claude_dir.mkdir(parents=True, exist_ok=True)\n   146\t        try:\n   147\t            os.chmod(claude_dir, 0o700)\n   148\t        except OSError:\n   149\t            pass\n   150\t\n   151\t        allowed_files = (\n   152\t            \"settings.json\",\n   153\t            \"aeza-8788-ca.pem\",\n   154\t            \"bundle-with-aeza.pem\",\n   155\t            \"policy-limits.json\",\n   156\t            \"policy-limits.json.signature.json\",\n   157\t            \"policy-limits.json.stamp.json\",\n   158\t        )\n   159\t\n   160\t        for name in allowed_files:\n   161\t            source = real_claude / name\n   162\t            if source.is_file():\n   163\t                dest = claude_dir / name\n   164\t                tmp_dest = claude_dir / f\".tmp_{name}_{uuid.uuid4().hex[:8]}\"\n   165\t                try:\n   166\t                    shutil.copy2(source, tmp_dest)\n   167\t                    os.chmod(tmp_dest, 0o600)\n   168\t                    os.replace(tmp_dest, dest)\n   169\t                except OSError:\n   170\t                    if tmp_dest.exists():\n   171\t                        try:\n   172\t                            tmp_dest.unlink()\n   173\t                        except OSError:\n   174\t                            pass\n   175\t\n   176\t        _CLAUDE_HOME_INITIALIZED = True\n   177\t        return home\n   178\tMAX_CONCURRENT = int(os.environ.get(\"CLAUDE_P_BRIDGE_MAX_CONCURRENT\", \"8\"))\n   179\tQUEUE_TIMEOUT_S = int(os.environ.get(\"CLAUDE_P_BRIDGE_QUEUE_TIMEOUT\", \"900\"))\n   180\tKEEPALIVE_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_KEEPALIVE\", \"15\"))\n   181\tMAX_REQUEST_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_BODY_BYTES\", 100 * 1024 * 1024)\n   182\tQUEUE_MAXSIZE = _env_positive_int(\"CLAUDE_P_BRIDGE_QUEUE_MAXSIZE\", 1000)\n   183\tMAX_STDERR_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_STDERR_BYTES\", 10 * 1024 * 1024)\n   184\tIO_CHUNK_BYTES = _env_positive_int(\"CLAUDE_P_BRIDGE_IO_CHUNK_BYTES\", 64 * 1024)\n   185\tPROCESS_WAIT_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_PROCESS_WAIT_S\", \"5\"))\n   186\tPOLL_INTERVAL_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_POLL_INTERVAL_S\", \"1\"))\n   187\tSTDERR_DRAIN_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_STDERR_DRAIN_S\", \"0.05\"))\n   188\tHTTP_TIMEOUT_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_HTTP_TIMEOUT_S\", \"300\"))\n   189\tHTTP_BACKLOG = _env_positive_int(\"CLAUDE_P_BRIDGE_HTTP_BACKLOG\", 64)\n   190\t# Лимиты и корень временных каталогов изображений — только через env с безопасными\n   191\t# значениями по умолчанию из core (без хардкода эксплуатационных параметров).\n   192\tMAX_IMAGES = _env_positive_int(\"CLAUDE_P_BRIDGE_MAX_IMAGES\", DEFAULT_MAX_IMAGES)\n   193\tMAX_IMAGE_BYTES = _env_positive_int(\n   194\t    \"CLAUDE_P_BRIDGE_MAX_IMAGE_BYTES\", DEFAULT_MAX_IMAGE_BYTES\n   195\t)\n   196\tMAX_TOTAL_IMAGE_BYTES = _env_positive_int(\n   197\t    \"CLAUDE_P_BRIDGE_MAX_TOTAL_IMAGE_BYTES\", DEFAULT_MAX_TOTAL_IMAGE_BYTES\n   198\t)\n   199\tIMAGE_TMP_ROOT = Path(os.environ.get(\"CLAUDE_P_BRIDGE_TMPDIR\", \"/tmp\"))\n   200\tMODEL_CONTEXT = {\n   201\t    \"claude-sonnet-5-5\": 1_000_000,\n   202\t    \"claude-opus-5-5\": 1_000_000,\n   203\t    \"claude-haiku-5-5\": 200_000,\n   204\t}\n   205\tCONTEXT_LENGTH = 1_000_000  # fallback для неизвестных моделей\n   206\tTOOL_CALL_OPEN = \"<tool_call>\"\n   207\tTOOL_CALL_CLOSE = \"</tool_call>\"\n   208\t\n   209\t_slots = threading.BoundedSemaphore(MAX_CONCURRENT)\n   210\t_active = {}\n   211\t_active_img_dirs: set = set()\n   212\t_active_lock = threading.Lock()\n   213\t_started = time.time()\n   214\t\n   215\t\n   216\tdef _log(msg: str) -> None:\n   217\t    \"\"\"Диагностика в stderr (файлы вне каталога моста не создаём).\"\"\"\n   218\t    try:\n   219\t        sys.stderr.write(\n   220\t            f\"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}\\n\"\n   221\t        )\n   222\t        sys.stderr.flush()\n   223\t    except OSError:\n   224\t        pass\n   225\t\n   226\t\n   227\tdef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n   228\t    hdr = handler.headers.get(\"Authorization\", \"\")\n   229\t    expected = AUTH_KEY.encode(\"utf-8\")\n   230\t    if hdr.startswith(\"Bearer \"):\n   231\t        return hmac.compare_digest(hdr[7:].strip().encode(\"utf-8\"), expected)\n   232\t    return hmac.compare_digest(\n   233\t        handler.headers.get(\"x-api-key\", \"\").encode(\"utf-8\"), expected\n   234\t    ) or hmac.compare_digest(hdr.strip().encode(\"utf-8\"), expected)\n   235\t\n   236\t\n   237\tdef _extract_request_images(req: dict) -> list:\n   238\t    \"\"\"Изображения всей истории `messages` -> [{\"name\", \"mime\", \"data\"}] (core, AD-003).\"\"\"\n   239\t    messages = req.get(\"messages\") if isinstance(req.get(\"messages\"), list) else []\n   240\t    return extract_data_url_images(\n   241\t        messages,\n   242\t        max_images=MAX_IMAGES,\n   243\t        max_image_bytes=MAX_IMAGE_BYTES,\n   244\t        max_total_bytes=MAX_TOTAL_IMAGE_BYTES,\n   245\t    )\n   246\t\n   247\t\n   248\tdef _stage_images(images: list) -> Path | None:\n   249\t    \"\"\"Материализовать изображения в `/tmp/claude-img-<uuid>/` (0700, файлы 0600).\n   250\t\n   251\t    Каталог создаётся атомарно без изменения глобального umask, файлы —\n   252\t    exclusive/no-follow созданием. При частичной ошибке каталог удаляется здесь же.\n   253\t    \"\"\"\n   254\t    if not images:\n   255\t        return None\n   256\t    img_dir = IMAGE_TMP_ROOT / f\"claude-img-{uuid.uuid4().hex}\"\n   257\t    os.mkdir(img_dir, 0o700)\n   258\t    os.chmod(img_dir, 0o700)\n   259\t    try:\n   260\t        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, \"O_NOFOLLOW\", 0)\n   261\t        for image in images:\n   262\t            target = img_dir / image[\"name\"]\n   263\t            fd = os.open(target, flags, 0o600)\n   264\t            try:\n   265\t                view = memoryview(image[\"data\"])\n   266\t                while view:\n   267\t                    view = view[os.write(fd, view) :]\n   268\t            finally:\n   269\t                os.close(fd)\n   270\t            os.chmod(target, 0o600)\n   271\t    except BaseException:\n   272\t        shutil.rmtree(img_dir, ignore_errors=True)\n   273\t        raise\n   274\t    with _active_lock:\n   275\t        _active_img_dirs.add(img_dir)\n   276\t    return img_dir\n   277\t\n   278\t\n   279\tdef _cleanup_img_dir(img_dir: Path | None) -> None:\n   280\t    \"\"\"Гарантированное удаление сессионного каталога картинок своего хода.\"\"\"\n   281\t    if img_dir is None:\n   282\t        return\n   283\t    with _active_lock:\n   284\t        _active_img_dirs.discard(Path(img_dir))\n   285\t    shutil.rmtree(img_dir, ignore_errors=True)\n   286\t\n   287\t\n   288\tdef _build_claude_cmd(model: str, effort: str, img_dir: Path | None = None) -> list:\n   289\t    \"\"\"argv `claude -p`; с картинками — только встроенный Read по `--add-dir` (AD-003).\"\"\"\n   290\t    cmd = [\n   291\t        CLAUDE_BIN, \"-p\",\n   292\t        \"--model\", model,\n   293\t        \"--effort\", effort,\n   294\t        \"--output-format\", \"stream-json\",\n   295\t        \"--verbose\",\n   296\t        \"--include-partial-messages\",\n   297\t        \"--strict-mcp-config\",\n   298\t        \"--mcp-config\", str(MCP_CONFIG),\n   299\t    ]\n   300\t    if img_dir is not None:\n   301\t        cmd += [\"--permission-mode\", \"dontAsk\",\n   302\t                \"--tools\", \"Read\", \"--allowedTools\", f\"Read({img_dir}/**)\",\n   303\t                \"--add-dir\", str(img_dir)]\n   304\t    else:\n   305\t        # Встроенные инструменты отключены: действия идут только через DSH.\n   306\t        cmd += [\"--permission-mode\", \"bypassPermissions\", \"--tools\", \"\"]\n   307\t    return cmd\n   308\t\n   309\t\n   310\tdef _effort(value: Any, model: str = MODEL_ID) -> str:\n   311\t    \"\"\"reasoning_effort -> уровень claude для модели (замеры KB 13.10/19.10.2026).\n   312\t\n   313\t    Opus 5.5: low/medium/high; xhigh и max -> high. Sonnet 5.5: low/medium/high/xhigh;\n   314\t    max -> xhigh. Haiku 5.5: low/medium/high/xhigh/max (max не по умолчанию: 300 с+\n   315\t    против 25-40 с на high). Всё остальное (none/пусто/мусор) -> дефолт модели `high`.\n   316\t    \"\"\"\n   317\t    eff = str(value or \"\").strip().lower()\n   318\t    default = SUPPORTED_MODELS.get(model, \"high\")\n   319\t    if model == \"claude-haiku-5-5\":\n   320\t        return eff if eff in (\"low\", \"medium\", \"high\", \"xhigh\", \"max\") else default\n   321\t    if model == \"claude-sonnet-5-5\":\n   322\t        if eff == \"max\":\n   323\t            return \"xhigh\"\n   324\t        return eff if eff in (\"low\", \"medium\", \"high\", \"xhigh\") else default\n   325\t    if eff in (\"xhigh\", \"max\"):\n   326\t        return \"high\"\n   327\t    return eff if eff in (\"low\", \"medium\", \"high\") else default\n   328\t\n   329\t\n   330\tdef _resolve_model(req: dict) -> tuple[str, dict | None]:\n   331\t    \"\"\"Модель запроса (fallback MODEL_ID) и тело ошибки 400, если модель не поддержана.\"\"\"\n   332\t    raw = req.get(\"model\")\n   333\t    model = str(raw).strip() if raw else MODEL_ID\n   334\t    if model not in SUPPORTED_MODELS:\n   335\t        return model, {\"message\": f\"model not allowed: {model}\",\n   336\t                       \"type\": \"invalid_request_error\", \"code\": 400}\n   337\t    return model, None\n   338\t\n   339\t\n   340\tdef _kill_group(proc: subprocess.Popen) -> None:\n   341\t    \"\"\"SIGTERM процессной группе, затем SIGKILL, если не завершилась.\"\"\"\n   342\t    for sig in (signal.SIGTERM, signal.SIGKILL):\n   343\t        try:\n   344\t            os.killpg(proc.pid, sig)\n   345\t        except (ProcessLookupError, PermissionError):\n   346\t            return\n   347\t        try:\n   348\t            proc.wait(timeout=PROCESS_WAIT_S)\n   349\t            return\n   350\t        except subprocess.TimeoutExpired:\n   351\t            continue\n   352\t\n   353\t\n   354\tdef _kill_all(*_: Any) -> None:\n   355\t    with _active_lock:\n   356\t        procs = list(_active.values())\n   357\t        img_dirs = list(_active_img_dirs)\n   358\t    reaped = True\n   359\t    for proc in procs:\n   360\t        try:\n   361\t            os.killpg(proc.pid, signal.SIGKILL)\n   362\t        except (ProcessLookupError, PermissionError):\n   363\t            pass\n   364\t    for proc in procs:\n   365\t        try:\n   366\t            proc.wait(timeout=PROCESS_WAIT_S)\n   367\t        except subprocess.TimeoutExpired:\n   368\t            reaped = False\n   369\t    if reaped:\n   370\t        for img_dir in img_dirs:  # только свои сессионные каталоги картинок\n   371\t            _cleanup_img_dir(img_dir)\n   372\t    _log(f\"shutdown: killed {len(procs)} child process group(s)\")\n   373\t    os._exit(0)\n   374\t\n   375\t\n   376\tclass Run:\n   377\t    \"\"\"Один процесс `claude -p`; поток-читатель превращает stdout в события очереди.\"\"\"\n   378\t\n   379\t    def __init__(self, prompt: str, model: str, effort: str, tag: str,\n   380\t                 img_dir: Path | None = None):\n   381\t        WORKSPACE.mkdir(parents=True, exist_ok=True)\n   382\t        # С картинками Claude работает из сессионного каталога вложений: пути\n   383\t        # в секции [attachments] относительные, Read ограничен этим каталогом.\n   384\t        cmd = _build_claude_cmd(model, effort, img_dir)\n   385\t        self.cmd = cmd\n   386\t        self.img_dir = img_dir\n   387\t        _log(f\"exec model={model} effort={effort} prompt_bytes={len(prompt.encode())} {tag}\")\n   388\t        child_env = os.environ.copy()\n   389\t        child_env[\"HOME\"] = str(_prepare_claude_home())\n   390\t        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n   391\t        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n   392\t\n   393\t        self.proc = subprocess.Popen(\n   394\t            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n   395\t            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n   396\t            start_new_session=True, env=child_env,\n   397\t        )\n   398\t        with _active_lock:\n   399\t            _active[self.proc.pid] = self.proc\n   400\t        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n   401\t        self._closed = threading.Event()\n   402\t        self.err_box = []\n   403\t        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n   404\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n   405\t        threading.Thread(target=self._pump, daemon=True).start()\n   406\t\n   407\t    def _feed(self, prompt: str) -> None:\n   408\t        \"\"\"Промпт уходит только через stdin.\"\"\"\n   409\t        try:\n   410\t            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n   411\t            self.proc.stdin.close()\n   412\t        except (BrokenPipeError, OSError):\n   413\t            pass\n   414\t\n   415\t    def _drain_stderr(self) -> None:\n   416\t        remaining = MAX_STDERR_BYTES\n   417\t        retained = bytearray()\n   418\t        try:\n   419\t            while chunk := self.proc.stderr.read(IO_CHUNK_BYTES):\n   420\t                if remaining:\n   421\t                    retained.extend(chunk[:remaining])\n   422\t                    remaining = max(0, remaining - len(chunk))\n   423\t        except Exception:  # noqa: BLE001 - вторичный поток, ошибку терять нельзя молча\n   424\t            pass\n   425\t        finally:\n   426\t            self.err_box.append(retained.decode(\"utf-8\", \"replace\"))\n   427\t\n   428\t    def _enqueue(self, event: tuple) -> None:\n   429\t        \"\"\"Ограниченная очередь с прерыванием ожидания при закрытии хода.\"\"\"\n   430\t        while not self._closed.is_set():\n   431\t            try:\n   432\t                self.q.put(event, timeout=POLL_INTERVAL_S)\n   433\t                return\n   434\t            except queue.Full:\n   435\t                continue\n   436\t\n   437\t    def _pump(self) -> None:\n   438\t        \"\"\"Разбор stream-json: content_block_delta -> text/thinking, result -> итог.\"\"\"\n   439\t        try:\n   440\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n   441\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n   442\t                if not line.startswith(\"{\"):\n   443\t                    continue\n   444\t                try:\n   445\t                    ev = json.loads(line)\n   446\t                except ValueError:\n   447\t                    continue\n   448\t                etype = ev.get(\"type\")\n   449\t                if etype == \"stream_event\":\n   450\t                    inner = ev.get(\"event\") or {}\n   451\t                    if inner.get(\"type\") == \"content_block_delta\":\n   452\t                        delta = inner.get(\"delta\") or {}\n   453\t                        dtype = delta.get(\"type\")\n   454\t                        if dtype == \"text_delta\" and delta.get(\"text\"):\n   455\t                            self._enqueue((\"text\", delta[\"text\"]))\n   456\t                        elif dtype == \"thinking_delta\":\n   457\t                            thinking = extract_thinking_delta(delta)\n   458\t                            if thinking:\n   459\t                                self._enqueue((\"thinking\", thinking))\n   460\t                elif etype == \"result\":\n   461\t                    self._enqueue((\"result\", ev))\n   462\t            rc = self.proc.wait()\n   463\t        except Exception as exc:  # noqa: BLE001 - читатель не должен умирать молча\n   464\t            self._enqueue((\"pump_error\", repr(exc)))\n   465\t            return\n   466\t        time.sleep(STDERR_DRAIN_S)  # дать стоку stderr дозавершиться\n   467\t        self._enqueue((\"done\", rc))\n   468\t\n   469\t    def close(self) -> None:\n   470\t        self._closed.set()\n   471\t        if self.proc.poll() is None:\n   472\t            _kill_group(self.proc)\n   473\t        self.proc.wait(timeout=PROCESS_WAIT_S)\n   474\t        with _active_lock:\n   475\t            _active.pop(self.proc.pid, None)\n   476\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   477\t            try:\n   478\t                if stream is not None:\n   479\t                    stream.close()\n   480\t            except OSError:\n   481\t                pass\n   482\t\n   483\t\n   484\tdef _client_gone(sock: socket.socket) -> bool:\n   485\t    try:\n   486\t        ready, _, _ = select.select([sock], [], [], 0)\n   487\t        return bool(ready) and sock.recv(1, socket.MSG_PEEK) == b\"\"\n   488\t    except (OSError, ValueError):\n   489\t        return True\n   490\t\n   491\t\n   492\tclass Handler(BaseHTTPRequestHandler):\n   493\t    protocol_version = \"HTTP/1.1\"\n   494\t    timeout = HTTP_TIMEOUT_S\n   495\t\n   496\t    def log_message(self, format: str, *args: Any) -> None:\n   497\t        _log(\"http \" + (format % args))\n   498\t\n   499\t    def handle_error(self, request: Any, client_address: Any) -> None:\n   500\t        _log(f\"http accept error from {client_address}\")\n   501\t\n   502\t    def _send(self, code: int, payload: dict) -> None:\n   503\t        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n   504\t        self.send_response(int(code))\n   505\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n   506\t        self.send_header(\"Content-Length\", str(len(body)))\n   507\t        self.end_headers()\n   508\t        self.wfile.write(body)\n   509\t\n   510\t    def _emit(self, data: str) -> bool:\n   511\t        try:\n   512\t            self.wfile.write(data.encode(\"utf-8\"))\n   513\t            self.wfile.flush()\n   514\t            return True\n   515\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   516\t            return False\n   517\t\n   518\t    def _acquire_slot(self, keepalive):\n   519\t        \"\"\"Ждём слот семафора до QUEUE_TIMEOUT_S, попутно keepalive и проверка клиента.\"\"\"\n   520\t        waited = time.monotonic()\n   521\t        last_ka = 0.0\n   522\t        while not _slots.acquire(timeout=POLL_INTERVAL_S):\n   523\t            if _client_gone(self.connection):\n   524\t                return \"client_gone\"\n   525\t            if time.monotonic() - waited > QUEUE_TIMEOUT_S:\n   526\t                return \"queue_timeout\"\n   527\t            if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   528\t                last_ka = time.monotonic()\n   529\t                if not keepalive():\n   530\t                    return \"client_gone\"\n   531\t        return \"\"\n   532\t\n   533\t    def _execute(self, run: Run, on_text, on_reasoning, on_tool_call,\n   534\t                 keepalive, emulate_tools: bool, tools: list | None = None) -> dict:\n   535\t        \"\"\"Гнать ход до конца.\n   536\t\n   537\t        on_text/on_reasoning/on_tool_call/keepalive возвращают False, если клиент ушёл.\n   538\t        Весь текстовый поток ВСЕГДА проходит через `StreamNormalizer` поверх\n   539\t        `ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON — в том числе без\n   540\t        tools и при tool_choice=none): повреждённый `<tool_call>` поднимает\n   541\t        `LiveParserError`, сырой XML в content не уходит; распознанный вызов без\n   542\t        эмуляции — ошибка протокола, а не опубликованный инструмент. Reasoning\n   543\t        (нативный thinking и теги в тексте) публикуется до терминального события.\n   544\t        \"\"\"\n   545\t        pieces = []\n   546\t        reasoning_pieces: list = []\n   547\t        tool_calls: list = []\n   548\t        usage = {}\n   549\t        result_ev = {}\n   550\t        tool_schemas = build_tool_schemas(tools or [])\n   551\t        last_ka = time.monotonic()\n   552\t        gone = [False]\n   553\t\n   554\t        def state(name: str, rc: int, err: str = \"\") -> dict:\n   555\t            return {\"rc\": rc, \"text\": \"\".join(pieces), \"usage\": usage,\n   556\t                    \"reasoning\": \"\".join(reasoning_pieces),\n   557\t                    \"result\": result_ev, \"state\": name, \"err\": err,\n   558\t                    \"tool_calls\": tool_calls}\n   559\t\n   560\t        def add_content(text: str) -> None:\n   561\t            if gone[0] or not text:\n   562\t                return\n   563\t            pieces.append(text)\n   564\t            if not on_text(text):\n   565\t                gone[0] = True\n   566\t\n   567\t        def add_reasoning(text: str) -> None:\n   568\t            if gone[0] or not text:\n   569\t                return\n   570\t            reasoning_pieces.append(text)\n   571\t            if not on_reasoning(text):\n   572\t                gone[0] = True\n   573\t\n   574\t        def add_call(call: dict) -> None:\n   575\t            if gone[0]:\n   576\t                return\n   577\t            if not emulate_tools:\n   578\t                raise LiveParserError(\"tool_call published without tool emulation\")\n   579\t            entry = {\n   580\t                \"index\": len(tool_calls),\n   581\t                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n   582\t                \"type\": \"function\",\n   583\t                \"function\": {\n   584\t                    \"name\": call[\"name\"],\n   585\t                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n   586\t                },\n   587\t            }\n   588\t            # Схемная санитизация — ровно один раз на владельце маршрута (AD-004).\n   589\t            for item in sanitize_tool_call(entry, tool_schemas):\n   590\t                item = dict(item, index=len(tool_calls))\n   591\t                tool_calls.append(item)\n   592\t                if not on_tool_call(item):\n   593\t                    gone[0] = True\n   594\t                    return\n   595\t\n   596\t        normalizer = StreamNormalizer(\n   597\t            add_content, add_reasoning, add_call, strict_live=True\n   598\t        )\n   599\t\n   600\t        while True:\n   601\t            if _client_gone(self.connection):\n   602\t                return state(\"client_gone\", 1)\n   603\t            try:\n   604\t                kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   605\t            except queue.Empty:\n   606\t                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   607\t                    last_ka = time.monotonic()\n   608\t                    if not keepalive():\n   609\t                        return state(\"client_gone\", 1)\n   610\t                continue\n   611\t            if kind == \"text\":\n   612\t                normalizer.feed_text(str(payload))\n   613\t                if gone[0]:\n   614\t                    return state(\"client_gone\", 1)\n   615\t            elif kind == \"thinking\":\n   616\t                normalizer.feed_thinking(str(payload))\n   617\t                if gone[0]:\n   618\t                    return state(\"client_gone\", 1)\n   619\t            elif kind == \"result\":\n   620\t                result_ev = payload\n   621\t                usage = payload.get(\"usage\") or {}\n   622\t            elif kind == \"pump_error\":\n   623\t                return state(\"pump_error\", 1, str(payload))\n   624\t            elif kind == \"done\":\n   625\t                # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n   626\t                # сырой XML текстом не досбрасываем. Fallback на терминальный\n   627\t                # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n   628\t                normalizer.finish()\n   629\t                if gone[0]:\n   630\t                    return state(\"client_gone\", 1)\n   631\t                time.sleep(STDERR_DRAIN_S)\n   632\t                return state(\"done\", payload, \"\".join(run.err_box))\n   633\t\n   634\t    def _run_once(self, req: dict, on_text, on_reasoning, on_tool_call, keepalive) -> dict:\n   635\t        raw_messages = req.get(\"messages\")\n   636\t        messages: list = raw_messages if isinstance(raw_messages, list) else []\n   637\t        raw_tools = req.get(\"tools\")\n   638\t        tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n   639\t        tool_choice = req.get(\"tool_choice\")\n   640\t        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n   641\t        model, model_err = _resolve_model(req)\n   642\t        if model_err is not None:\n   643\t            return {\"state\": \"bad_model\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   644\t                    \"err\": model_err[\"message\"], \"tool_calls\": []}\n   645\t        try:\n   646\t            images = _extract_request_images(req)\n   647\t        except ImageInputError as exc:\n   648\t            return {\"state\": \"bad_image\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   649\t                    \"err\": exc.code, \"tool_calls\": []}\n   650\t        prompt = _messages_to_prompt(messages, tools, tool_choice, images or None)\n   651\t        effort = _effort(req.get(\"reasoning_effort\"), model)\n   652\t        tag = (f\"client={self.client_address[0]}:{self.client_address[1]} \"\n   653\t               f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\")\n   654\t        reason = self._acquire_slot(keepalive)\n   655\t        if reason:\n   656\t            _log(f\"no slot ({reason}) model={model} effort={effort} {tag}\")\n   657\t            return {\"state\": reason, \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   658\t                    \"err\": \"\", \"tool_calls\": []}\n   659\t        t0 = time.monotonic()\n   660\t        img_dir = None\n   661\t        can_cleanup = True\n   662\t        try:\n   663\t            try:\n   664\t                img_dir = _stage_images(images)\n   665\t                run = Run(prompt, model, effort, tag, img_dir=img_dir)\n   666\t                can_cleanup = False\n   667\t            except OSError as exc:\n   668\t                _log(f\"image stage/spawn failed model={model} err={exc!r:.200} {tag}\")\n   669\t                return {\"state\": \"image_error\", \"rc\": 1, \"text\": \"\", \"usage\": {},\n   670\t                        \"result\": {}, \"err\": str(exc)[:200], \"tool_calls\": []}\n   671\t            try:\n   672\t                out = self._execute(run, on_text, on_reasoning, on_tool_call,\n   673\t                                    keepalive, emulate_tools, tools)\n   674\t            except LiveParserError as exc:\n   675\t                # AD-004: битый поток — 502 proxy_error; сырой XML клиенту не уходит.\n   676\t                _log(f\"parser_error model={model} err={exc} {tag}\")\n   677\t                out = {\"state\": \"parser_error\", \"rc\": 1, \"text\": \"\", \"reasoning\": \"\",\n   678\t                       \"usage\": {}, \"result\": {}, \"err\": str(exc), \"tool_calls\": []}\n   679\t            finally:\n   680\t                run.close()  # сначала завершить и reap своего ребёнка\n   681\t                can_cleanup = True\n   682\t        finally:\n   683\t            if can_cleanup:\n   684\t                _cleanup_img_dir(img_dir)\n   685\t            _slots.release()\n   686\t        out_calls = out.get(\"tool_calls\")\n   687\t        out_text = out.get(\"text\")\n   688\t        _log(f\"done model={model} effort={effort} rc={out['rc']} state={out['state']} \"\n   689\t             f\"tools={len(out_calls) if isinstance(out_calls, list) else 0} \"\n   690\t             f\"out_bytes={len(out_text.encode()) if isinstance(out_text, str) else 0} \"\n   691\t             f\"wall_s={time.monotonic() - t0:.1f} {tag}\")\n   692\t        return out\n   693\t\n   694\t    @staticmethod\n   695\t    def _error_body(out: dict) -> Any:\n   696\t        st = out.get(\"state\")\n   697\t        if st == \"bad_model\":\n   698\t            return {\"message\": str(out.get(\"err\")), \"type\": \"invalid_request_error\", \"code\": 400}\n   699\t        if st == \"bad_image\":\n   700\t            return {\"message\": f\"invalid image input: {out.get('err')}\",\n   701\t                    \"type\": \"invalid_request_error\", \"code\": 400}\n   702\t        if st == \"parser_error\":\n   703\t            return {\"message\": \"malformed tool_call stream\",\n   704\t                    \"type\": \"proxy_error\", \"code\": 502}\n   705\t        if st == \"image_error\":\n   706\t            return {\"message\": \"image staging or spawn failed\",\n   707\t                    \"type\": \"proxy_error\", \"code\": 502}\n   708\t        if st == \"queue_timeout\":\n   709\t            return {\"message\": f\"bridge busy: queue full over {QUEUE_TIMEOUT_S}s\",\n   710\t                    \"type\": \"overloaded\", \"code\": 503}\n   711\t        if st == \"client_gone\":\n   712\t            return {\"message\": \"client gone\", \"type\": \"client_gone\", \"code\": 499}\n   713\t        if st == \"pump_error\":\n   714\t            return {\"message\": \"bridge reader failed\", \"detail\": str(out.get(\"err\"))[:500],\n   715\t                    \"type\": \"proxy_error\", \"code\": 502}\n   716\t        if (out.get(\"result\") or {}).get(\"is_error\"):\n   717\t            detail = str((out[\"result\"].get(\"result\")) or out.get(\"err\") or \"claude reported an error\")\n   718\t            if \"<tool_call\" in detail:  # сырой XML не публикуется даже в тексте ошибки\n   719\t                detail = \"claude reported an error\"\n   720\t            return {\"message\": detail[:500], \"type\": \"claude_error\", \"code\": 502}\n   721\t        if out.get(\"rc\") != 0 or not (out.get(\"text\") or out.get(\"tool_calls\")):\n   722\t            return {\"message\": f\"claude exited rc={out.get('rc')}\",\n   723\t                    \"detail\": str(out.get(\"err\"))[:500], \"type\": \"proxy_error\", \"code\": 502}\n   724\t        return None\n   725\t\n   726\t    # ---- HTTP --------------------------------------------------------------------\n   727\t    def do_GET(self) -> None:  # noqa: N802\n   728\t        path = self.path.split(\"?\", 1)[0]\n   729\t        if path in (\"/health\", \"/v1/health\"):\n   730\t            with _active_lock:\n   731\t                active = len(_active)\n   732\t            self._send(200, {\n   733\t                \"ok\": True, \"transport\": \"claude-p\", \"model\": MODEL_ID,\n   734\t                \"models\": list(SUPPORTED_MODELS),\n   735\t                \"active\": active, \"max_concurrent\": MAX_CONCURRENT,\n   736\t                \"tool_emulation\": True, \"images\": True, \"live_reasoning\": True,\n   737\t                \"uptime_s\": int(time.time() - _started),\n   738\t            })\n   739\t            return\n   740\t        if not _auth_ok(self):\n   741\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   742\t            return\n   743\t        if path in (\"/v1/models\", \"/models\"):\n   744\t            self._send(200, {\"object\": \"list\", \"data\": [{\n   745\t                \"id\": model_id, \"object\": \"model\", \"owned_by\": \"anthropic\",\n   746\t                \"created\": 0, \"context_length\": MODEL_CONTEXT.get(model_id, CONTEXT_LENGTH),\n   747\t            } for model_id in SUPPORTED_MODELS]})\n   748\t            return\n   749\t        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   750\t\n   751\t    def do_POST(self) -> None:  # noqa: N802\n   752\t        if not _auth_ok(self):\n   753\t            # Непрочитанное тело иначе будет разобрано как следующий запрос keep-alive.\n   754\t            self.close_connection = True\n   755\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   756\t            return\n   757\t        path = self.path.split(\"?\", 1)[0]\n   758\t        try:\n   759\t            length = int(self.headers.get(\"Content-Length\") or \"0\")\n   760\t        except ValueError:\n   761\t            length = -1\n   762\t        if length < 0 or length > MAX_REQUEST_BYTES:\n   763\t            self.close_connection = True\n   764\t            self._send(413 if length > MAX_REQUEST_BYTES else 400,\n   765\t                       {\"error\": {\"message\": \"invalid request body length\"}})\n   766\t            return\n   767\t        raw = self.rfile.read(length) if length else b\"{}\"\n   768\t        try:\n   769\t            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n   770\t        except ValueError:\n   771\t            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n   772\t            return\n   773\t        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n   774\t            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   775\t            return\n   776\t        # Невалидную модель отсекаем до SSE-заголовков, иначе 400 уже не отправить.\n   777\t        _model, model_err = _resolve_model(req)\n   778\t        if model_err is not None:\n   779\t            self._send(400, {\"error\": {\"message\": model_err[\"message\"],\n   780\t                                       \"type\": model_err[\"type\"]}})\n   781\t            return\n   782\t        # Невалидные изображения отсекаем там же, до спавна и SSE-заголовков.\n   783\t        try:\n   784\t            _extract_request_images(req)\n   785\t        except ImageInputError as exc:\n   786\t            self._send(400, {\"error\": {\"message\": f\"invalid image input: {exc.code}\",\n   787\t                                       \"type\": \"invalid_request_error\"}})\n   788\t            return\n   789\t        if req.get(\"stream\"):\n   790\t            self._serve_sse(req)\n   791\t        else:\n   792\t            self._serve_json(req)\n   793\t\n   794\t    def _serve_json(self, req: dict) -> None:\n   795\t        out = self._run_once(req, lambda _v: True, lambda _v: True, lambda _e: True, None)\n   796\t        if out.get(\"state\") == \"client_gone\":\n   797\t            return\n   798\t        err = self._error_body(out)\n   799\t        if err is not None:\n   800\t            self._send(err[\"code\"], {\"error\": err})\n   801\t            return\n   802\t        usage = out.get(\"usage\") or {}\n   803\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n   804\t        if out.get(\"reasoning\"):\n   805\t            message[\"reasoning_content\"] = out[\"reasoning\"]\n   806\t        finish = \"stop\"\n   807\t        if out.get(\"tool_calls\"):\n   808\t            message[\"tool_calls\"] = out[\"tool_calls\"]\n   809\t            finish = \"tool_calls\"\n   810\t        self._send(200, {\n   811\t            \"id\": f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n   812\t            \"created\": int(time.time()), \"model\": req.get(\"model\") or MODEL_ID,\n   813\t            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n   814\t            \"usage\": {\n   815\t                \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n   816\t                \"completion_tokens\": usage.get(\"output_tokens\", 0),\n   817\t                \"total_tokens\": usage.get(\"input_tokens\", 0) + usage.get(\"output_tokens\", 0),\n   818\t            },\n   819\t        })\n   820\t\n   821\t    def _serve_sse(self, req: dict) -> None:\n   822\t        completion_id = f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\"\n   823\t        created = int(time.time())\n   824\t        shown_model = str(req.get(\"model\") or MODEL_ID)\n   825\t        try:\n   826\t            self.send_response(200)\n   827\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n   828\t            self.send_header(\"Cache-Control\", \"no-cache\")\n   829\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n   830\t            self.end_headers()\n   831\t            self.close_connection = True\n   832\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   833\t            _log(\"client gone before headers\")\n   834\t            return\n   835\t\n   836\t        def chunk(delta: dict, finish=None) -> str:\n   837\t            return \"data: \" + json.dumps({\n   838\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n   839\t                \"model\": shown_model,\n   840\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n   841\t            }, ensure_ascii=False) + \"\\n\\n\"\n   842\t\n   843\t        def on_text(value: str) -> bool:\n   844\t            return self._emit(chunk({\"content\": value}))\n   845\t\n   846\t        def on_reasoning(value: str) -> bool:\n   847\t            return self._emit(chunk({\"reasoning_content\": value}))\n   848\t\n   849\t        def on_tool_call(entry: dict) -> bool:\n   850\t            return self._emit(chunk({\"tool_calls\": [entry]}))\n   851\t\n   852\t        def keepalive() -> bool:\n   853\t            return self._emit(\": keepalive\\n\\n\")\n   854\t\n   855\t        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n   856\t            return\n   857\t        out = self._run_once(req, on_text, on_reasoning, on_tool_call, keepalive)\n   858\t        if out.get(\"state\") == \"client_gone\":\n   859\t            _log(\"client gone mid-stream, child killed\")\n   860\t            return\n   861\t        err = self._error_body(out)\n   862\t        if err is None:\n   863\t            finish = \"tool_calls\" if out.get(\"tool_calls\") else \"stop\"\n   864\t            self._emit(chunk({}, finish))\n   865\t        else:\n   866\t            error_msg = str(err.get(\"message\") or \"\") if isinstance(err, dict) else str(err)\n   867\t            error_chunk = format_stream_error_sse(str(error_msg), finish_reason=\"stop\")\n   868\t            self._emit(error_chunk)\n   869\t            return\n   870\t        self._emit(\"data: [DONE]\\n\\n\")\n   871\t\n   872\t\n   873\tclass Server(ThreadingHTTPServer):\n   874\t    daemon_threads = True\n   875\t    request_queue_size = HTTP_BACKLOG\n   876\t    allow_reuse_address = True\n   877\t\n   878\t\n   879\tdef main() -> None:\n   880\t    if not AUTH_KEY:\n   881\t        sys.stderr.write(\"CLAUDE_P_BRIDGE_KEY is required; refusing to start\\n\")\n   882\t        raise SystemExit(1)\n   883\t    WORKSPACE.mkdir(parents=True, exist_ok=True)\n   884\t    signal.signal(signal.SIGTERM, _kill_all)\n   885\t    signal.signal(signal.SIGINT, _kill_all)\n   886\t    server = Server((HOST, PORT), Handler)\n   887\t    _log(f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\n   888\t         f\"queue_timeout={QUEUE_TIMEOUT_S}s keepalive={KEEPALIVE_S}s\")\n   889\t    print(f\"[claude-p-bridge] listening on http://{HOST}:{PORT}/v1\", flush=True)\n   890\t    server.serve_forever()\n   891\t\n   892\t\n   893\tif __name__ == \"__main__\":\n   894\t    main()\n","exit_code":0,"status":"completed"}}
