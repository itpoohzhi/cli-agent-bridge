ure\": \"таймаут применяется корректно\",\n   243\t      \"verification_ids\": [\n   244\t        \"VER-005\"\n   245\t      ]\n   246\t    }\n   247\t  ],\n   248\t  \"boundaries\": [\n   249\t    {\n   250\t      \"id\": \"BND-001\",\n   251\t      \"component\": \"ClaudePBridgeWatchdog\",\n   252\t      \"responsibility\": \"Мониторинг активности CLI claude -p через AdaptiveTimeoutController и аварийное завершение группы процесса\",\n   253\t      \"allowed_dependencies\": [\n   254\t        \"core/watchdog.py\",\n   255\t        \"bridges/claude-p-bridge/server.py\"\n   256\t      ],\n   257\t      \"forbidden_dependencies\": [\n   258\t        \"vendor binary patches\",\n   259\t        \"hardcoded wall-clock kills\"\n   260\t      ],\n   261\t      \"verification_ids\": [\n   262\t        \"VER-001\"\n   263\t      ]\n   264\t    },\n   265\t    {\n   266\t      \"id\": \"BND-002\",\n   267\t      \"component\": \"DshEnvSecurityParser\",\n   268\t      \"responsibility\": \"Безопасное извлечение несекретных настроек таймаутов из ~/.dsh/.env без загрязнения os.environ\",\n   269\t      \"allowed_dependencies\": [\n   270\t        \"pathlib.Path\"\n   271\t      ],\n   272\t      \"forbidden_dependencies\": [\n   273\t        \"os.environ.update\",\n   274\t        \"reading sensitive keys\"\n   275\t      ],\n   276\t      \"verification_ids\": [\n   277\t        \"VER-002\"\n   278\t      ]\n   279\t    },\n   280\t    {\n   281\t      \"id\": \"BND-003\",\n   282\t      \"component\": \"OpenCodeZenBridgeConfig\",\n   283\t      \"responsibility\": \"Конфигурируемое чтение STALL_TIMEOUT_S через изолированный хелпер _zen_positive_float\",\n   284\t      \"allowed_dependencies\": [\n   285\t        \"bridges/opencode-zen-bridge/server.py\"\n   286\t      ],\n   287\t      \"forbidden_dependencies\": [\n   288\t        \"unisolated environment collisions\"\n   289\t      ],\n   290\t      \"verification_ids\": [\n   291\t        \"VER-004\"\n   292\t      ]\n   2