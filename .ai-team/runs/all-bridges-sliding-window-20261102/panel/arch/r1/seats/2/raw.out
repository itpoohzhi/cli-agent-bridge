{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '376,840p' bridges/claude-p-bridge/server.py | nl -ba -v376\"","aggregated_output":"   376\tclass Run:\n   377\t    \"\"\"Один процесс `claude -p`; поток-читатель превращает stdout в события очереди.\"\"\"\n   378\t\n   379\t    def __init__(self, prompt: str, model: str, effort: str, tag: str,\n   380\t                 img_dir: Path | None = None):\n   381\t        WORKSPACE.mkdir(parents=True, exist_ok=True)\n   382\t        # С картинками Claude работает из сессионного каталога вложений: пути\n   383\t        # в секции [attachments] относительные, Read ограничен этим каталогом.\n   384\t        cmd = _build_claude_cmd(model, effort, img_dir)\n   385\t        self.cmd = cmd\n   386\t        self.img_dir = img_dir\n   387\t        _log(f\"exec model={model} effort={effort} prompt_bytes={len(prompt.encode())} {tag}\")\n   388\t        child_env = os.environ.copy()\n   389\t        child_env[\"HOME\"] = str(_prepare_claude_home())\n   390\t        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n   391\t        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n   392\t\n   393\t        self.proc = subprocess.Popen(\n   394\t            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n   395\t            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n   396\t            start_new_session=True, env=child_env,\n   397\t        )\n   398\t        with _active_lock:\n   399\t            _active[self.proc.pid] = self.proc\n   400\t        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n   401\t        self._closed = threading.Event()\n   402\t        self.err_box = []\n   403\t        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n   404\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n   405\t        threading.Thread(target=self._pump, daemon=True).start()\n   406\t\n   407\t    def _feed(self, prompt: str) -> None:\n   408\t        \"\"\"Промпт уходит только через stdin.\"\"\"\n   409\t        try:\n   410\t            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n   411\t            self.proc.stdin.close()\n   412\t        except (BrokenPipeError, OSError):\n   413\t            pass\n   414\t\n   415\t    def _drain_stderr(self) -> None:\n   416\t        remaining = MAX_STDERR_BYTES\n   417\t        retained = bytearray()\n   418\t        try:\n   419\t            while chunk := self.proc.stderr.read(IO_CHUNK_BYTES):\n   420\t                if remaining:\n   421\t                    retained.extend(chunk[:remaining])\n   422\t                    remaining = max(0, remaining - len(chunk))\n   423\t        except Exception:  # noqa: BLE001 - вторичный поток, ошибку терять нельзя молча\n   424\t            pass\n   425\t        finally:\n   426\t            self.err_box.append(retained.decode(\"utf-8\", \"replace\"))\n   427\t\n   428\t    def _enqueue(self, event: tuple) -> None:\n   429\t        \"\"\"Ограниченная очередь с прерыванием ожидания при закрытии хода.\"\"\"\n   430\t        while not self._closed.is_set():\n   431\t            try:\n   432\t                self.q.put(event, timeout=POLL_INTERVAL_S)\n   433\t                return\n   434\t            except queue.Full:\n   435\t                continue\n   436\t\n   437\t    def _pump(self) -> None:\n   438\t        \"\"\"Разбор stream-json: content_block_delta -> text/thinking, result -> итог.\"\"\"\n   439\t        try:\n   440\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n   441\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n   442\t                if not line.startswith(\"{\"):\n   443\t                    continue\n   444\t                try:\n   445\t                    ev = json.loads(line)\n   446\t                except ValueError:\n   447\t                    continue\n   448\t                etype = ev.get(\"type\")\n   449\t                if etype == \"stream_event\":\n   450\t                    inner = ev.get(\"event\") or {}\n   451\t                    if inner.get(\"type\") == \"content_block_delta\":\n   452\t                        delta = inner.get(\"delta\") or {}\n   453\t                        dtype = delta.get(\"type\")\n   454\t                        if dtype == \"text_delta\" and delta.get(\"text\"):\n   455\t                            self._enqueue((\"text\", delta[\"text\"]))\n   456\t                        elif dtype == \"thinking_delta\":\n   457\t                            thinking = extract_thinking_delta(delta)\n   458\t                            if thinking:\n   459\t                                self._enqueue((\"thinking\", thinking))\n   460\t                elif etype == \"result\":\n   461\t                    self._enqueue((\"result\", ev))\n   462\t            rc = self.proc.wait()\n   463\t        except Exception as exc:  # noqa: BLE001 - читатель не должен умирать молча\n   464\t            self._enqueue((\"pump_error\", repr(exc)))\n   465\t            return\n   466\t        time.sleep(STDERR_DRAIN_S)  # дать стоку stderr дозавершиться\n   467\t        self._enqueue((\"done\", rc))\n   468\t\n   469\t    def close(self) -> None:\n   470\t        self._closed.set()\n   471\t        if self.proc.poll() is None:\n   472\t            _kill_group(self.proc)\n   473\t        self.proc.wait(timeout=PROCESS_WAIT_S)\n   474\t        with _active_lock:\n   475\t            _active.pop(self.proc.pid, None)\n   476\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   477\t            try:\n   478\t                if stream is not None:\n   479\t                    stream.close()\n   480\t            except OSError:\n   481\t                pass\n   482\t\n   483\t\n   484\tdef _client_gone(sock: socket.socket) -> bool:\n   485\t    try:\n   486\t        ready, _, _ = select.select([sock], [], [], 0)\n   487\t        return bool(ready) and sock.recv(1, socket.MSG_PEEK) == b\"\"\n   488\t    except (OSError, ValueError):\n   489\t        return True\n   490\t\n   491\t\n   492\tclass Handler(BaseHTTPRequestHandler):\n   493\t    protocol_version = \"HTTP/1.1\"\n   494\t    timeout = HTTP_TIMEOUT_S\n   495\t\n   496\t    def log_message(self, format: str, *args: Any) -> None:\n   497\t        _log(\"http \" + (format % args))\n   498\t\n   499\t    def handle_error(self, request: Any, client_address: Any) -> None:\n   500\t        _log(f\"http accept error from {client_address}\")\n   501\t\n   502\t    def _send(self, code: int, payload: dict) -> None:\n   503\t        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n   504\t        self.send_response(int(code))\n   505\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n   506\t        self.send_header(\"Content-Length\", str(len(body)))\n   507\t        self.end_headers()\n   508\t        self.wfile.write(body)\n   509\t\n   510\t    def _emit(self, data: str) -> bool:\n   511\t        try:\n   512\t            self.wfile.write(data.encode(\"utf-8\"))\n   513\t            self.wfile.flush()\n   514\t            return True\n   515\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   516\t            return False\n   517\t\n   518\t    def _acquire_slot(self, keepalive):\n   519\t        \"\"\"Ждём слот семафора до QUEUE_TIMEOUT_S, попутно keepalive и проверка клиента.\"\"\"\n   520\t        waited = time.monotonic()\n   521\t        last_ka = 0.0\n   522\t        while not _slots.acquire(timeout=POLL_INTERVAL_S):\n   523\t            if _client_gone(self.connection):\n   524\t                return \"client_gone\"\n   525\t            if time.monotonic() - waited > QUEUE_TIMEOUT_S:\n   526\t                return \"queue_timeout\"\n   527\t            if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   528\t                last_ka = time.monotonic()\n   529\t                if not keepalive():\n   530\t                    return \"client_gone\"\n   531\t        return \"\"\n   532\t\n   533\t    def _execute(self, run: Run, on_text, on_reasoning, on_tool_call,\n   534\t                 keepalive, emulate_tools: bool, tools: list | None = None) -> dict:\n   535\t        \"\"\"Гнать ход до конца.\n   536\t\n   537\t        on_text/on_reasoning/on_tool_call/keepalive возвращают False, если клиент ушёл.\n   538\t        Весь текстовый поток ВСЕГДА проходит через `StreamNormalizer` поверх\n   539\t        `ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON — в том числе без\n   540\t        tools и при tool_choice=none): повреждённый `<tool_call>` поднимает\n   541\t        `LiveParserError`, сырой XML в content не уходит; распознанный вызов без\n   542\t        эмуляции — ошибка протокола, а не опубликованный инструмент. Reasoning\n   543\t        (нативный thinking и теги в тексте) публикуется до терминального события.\n   544\t        \"\"\"\n   545\t        pieces = []\n   546\t        reasoning_pieces: list = []\n   547\t        tool_calls: list = []\n   548\t        usage = {}\n   549\t        result_ev = {}\n   550\t        tool_schemas = build_tool_schemas(tools or [])\n   551\t        last_ka = time.monotonic()\n   552\t        gone = [False]\n   553\t\n   554\t        def state(name: str, rc: int, err: str = \"\") -> dict:\n   555\t            return {\"rc\": rc, \"text\": \"\".join(pieces), \"usage\": usage,\n   556\t                    \"reasoning\": \"\".join(reasoning_pieces),\n   557\t                    \"result\": result_ev, \"state\": name, \"err\": err,\n   558\t                    \"tool_calls\": tool_calls}\n   559\t\n   560\t        def add_content(text: str) -> None:\n   561\t            if gone[0] or not text:\n   562\t                return\n   563\t            pieces.append(text)\n   564\t            if not on_text(text):\n   565\t                gone[0] = True\n   566\t\n   567\t        def add_reasoning(text: str) -> None:\n   568\t            if gone[0] or not text:\n   569\t                return\n   570\t            reasoning_pieces.append(text)\n   571\t            if not on_reasoning(text):\n   572\t                gone[0] = True\n   573\t\n   574\t        def add_call(call: dict) -> None:\n   575\t            if gone[0]:\n   576\t                return\n   577\t            if not emulate_tools:\n   578\t                raise LiveParserError(\"tool_call published without tool emulation\")\n   579\t            entry = {\n   580\t                \"index\": len(tool_calls),\n   581\t                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n   582\t                \"type\": \"function\",\n   583\t                \"function\": {\n   584\t                    \"name\": call[\"name\"],\n   585\t                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n   586\t                },\n   587\t            }\n   588\t            # Схемная санитизация — ровно один раз на владельце маршрута (AD-004).\n   589\t            for item in sanitize_tool_call(entry, tool_schemas):\n   590\t                item = dict(item, index=len(tool_calls))\n   591\t                tool_calls.append(item)\n   592\t                if not on_tool_call(item):\n   593\t                    gone[0] = True\n   594\t                    return\n   595\t\n   596\t        normalizer = StreamNormalizer(\n   597\t            add_content, add_reasoning, add_call, strict_live=True\n   598\t        )\n   599\t\n   600\t        while True:\n   601\t            if _client_gone(self.connection):\n   602\t                return state(\"client_gone\", 1)\n   603\t            try:\n   604\t                kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   605\t            except queue.Empty:\n   606\t                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   607\t                    last_ka = time.monotonic()\n   608\t                    if not keepalive():\n   609\t                        return state(\"client_gone\", 1)\n   610\t                continue\n   611\t            if kind == \"text\":\n   612\t                normalizer.feed_text(str(payload))\n   613\t                if gone[0]:\n   614\t                    return state(\"client_gone\", 1)\n   615\t            elif kind == \"thinking\":\n   616\t                normalizer.feed_thinking(str(payload))\n   617\t                if gone[0]:\n   618\t                    return state(\"client_gone\", 1)\n   619\t            elif kind == \"result\":\n   620\t                result_ev = payload\n   621\t                usage = payload.get(\"usage\") or {}\n   622\t            elif kind == \"pump_error\":\n   623\t                return state(\"pump_error\", 1, str(payload))\n   624\t            elif kind == \"done\":\n   625\t                # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n   626\t                # сырой XML текстом не досбрасываем. Fallback на терминальный\n   627\t                # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n   628\t                normalizer.finish()\n   629\t                if gone[0]:\n   630\t                    return state(\"client_gone\", 1)\n   631\t                time.sleep(STDERR_DRAIN_S)\n   632\t                return state(\"done\", payload, \"\".join(run.err_box))\n   633\t\n   634\t    def _run_once(self, req: dict, on_text, on_reasoning, on_tool_call, keepalive) -> dict:\n   635\t        raw_messages = req.get(\"messages\")\n   636\t        messages: list = raw_messages if isinstance(raw_messages, list) else []\n   637\t        raw_tools = req.get(\"tools\")\n   638\t        tools = [t for t in raw_tools if isinstance(t, dict)] if isinstance(raw_tools, list) else []\n   639\t        tool_choice = req.get(\"tool_choice\")\n   640\t        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n   641\t        model, model_err = _resolve_model(req)\n   642\t        if model_err is not None:\n   643\t            return {\"state\": \"bad_model\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   644\t                    \"err\": model_err[\"message\"], \"tool_calls\": []}\n   645\t        try:\n   646\t            images = _extract_request_images(req)\n   647\t        except ImageInputError as exc:\n   648\t            return {\"state\": \"bad_image\", \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   649\t                    \"err\": exc.code, \"tool_calls\": []}\n   650\t        prompt = _messages_to_prompt(messages, tools, tool_choice, images or None)\n   651\t        effort = _effort(req.get(\"reasoning_effort\"), model)\n   652\t        tag = (f\"client={self.client_address[0]}:{self.client_address[1]} \"\n   653\t               f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\")\n   654\t        reason = self._acquire_slot(keepalive)\n   655\t        if reason:\n   656\t            _log(f\"no slot ({reason}) model={model} effort={effort} {tag}\")\n   657\t            return {\"state\": reason, \"rc\": 1, \"text\": \"\", \"usage\": {}, \"result\": {},\n   658\t                    \"err\": \"\", \"tool_calls\": []}\n   659\t        t0 = time.monotonic()\n   660\t        img_dir = None\n   661\t        can_cleanup = True\n   662\t        try:\n   663\t            try:\n   664\t                img_dir = _stage_images(images)\n   665\t                run = Run(prompt, model, effort, tag, img_dir=img_dir)\n   666\t                can_cleanup = False\n   667\t            except OSError as exc:\n   668\t                _log(f\"image stage/spawn failed model={model} err={exc!r:.200} {tag}\")\n   669\t                return {\"state\": \"image_error\", \"rc\": 1, \"text\": \"\", \"usage\": {},\n   670\t                        \"result\": {}, \"err\": str(exc)[:200], \"tool_calls\": []}\n   671\t            try:\n   672\t                out = self._execute(run, on_text, on_reasoning, on_tool_call,\n   673\t                                    keepalive, emulate_tools, tools)\n   674\t            except LiveParserError as exc:\n   675\t                # AD-004: битый поток — 502 proxy_error; сырой XML клиенту не уходит.\n   676\t                _log(f\"parser_error model={model} err={exc} {tag}\")\n   677\t                out = {\"state\": \"parser_error\", \"rc\": 1, \"text\": \"\", \"reasoning\": \"\",\n   678\t                       \"usage\": {}, \"result\": {}, \"err\": str(exc), \"tool_calls\": []}\n   679\t            finally:\n   680\t                run.close()  # сначала завершить и reap своего ребёнка\n   681\t                can_cleanup = True\n   682\t        finally:\n   683\t            if can_cleanup:\n   684\t                _cleanup_img_dir(img_dir)\n   685\t            _slots.release()\n   686\t        out_calls = out.get(\"tool_calls\")\n   687\t        out_text = out.get(\"text\")\n   688\t        _log(f\"done model={model} effort={effort} rc={out['rc']} state={out['state']} \"\n   689\t             f\"tools={len(out_calls) if isinstance(out_calls, list) else 0} \"\n   690\t             f\"out_bytes={len(out_text.encode()) if isinstance(out_text, str) else 0} \"\n   691\t             f\"wall_s={time.monotonic() - t0:.1f} {tag}\")\n   692\t        return out\n   693\t\n   694\t    @staticmethod\n   695\t    def _error_body(out: dict) -> Any:\n   696\t        st = out.get(\"state\")\n   697\t        if st == \"bad_model\":\n   698\t            return {\"message\": str(out.get(\"err\")), \"type\": \"invalid_request_error\", \"code\": 400}\n   699\t        if st == \"bad_image\":\n   700\t            return {\"message\": f\"invalid image input: {out.get('err')}\",\n   701\t                    \"type\": \"invalid_request_error\", \"code\": 400}\n   702\t        if st == \"parser_error\":\n   703\t            return {\"message\": \"malformed tool_call stream\",\n   704\t                    \"type\": \"proxy_error\", \"code\": 502}\n   705\t        if st == \"image_error\":\n   706\t            return {\"message\": \"image staging or spawn failed\",\n   707\t                    \"type\": \"proxy_error\", \"code\": 502}\n   708\t        if st == \"queue_timeout\":\n   709\t            return {\"message\": f\"bridge busy: queue full over {QUEUE_TIMEOUT_S}s\",\n   710\t                    \"type\": \"overloaded\", \"code\": 503}\n   711\t        if st == \"client_gone\":\n   712\t            return {\"message\": \"client gone\", \"type\": \"client_gone\", \"code\": 499}\n   713\t        if st == \"pump_error\":\n   714\t            return {\"message\": \"bridge reader failed\", \"detail\": str(out.get(\"err\"))[:500],\n   715\t                    \"type\": \"proxy_error\", \"code\": 502}\n   716\t        if (out.get(\"result\") or {}).get(\"is_error\"):\n   717\t            detail = str((out[\"result\"].get(\"result\")) or out.get(\"err\") or \"claude reported an error\")\n   718\t            if \"<tool_call\" in detail:  # сырой XML не публикуется даже в тексте ошибки\n   719\t                detail = \"claude reported an error\"\n   720\t            return {\"message\": detail[:500], \"type\": \"claude_error\", \"code\": 502}\n   721\t        if out.get(\"rc\") != 0 or not (out.get(\"text\") or out.get(\"tool_calls\")):\n   722\t            return {\"message\": f\"claude exited rc={out.get('rc')}\",\n   723\t                    \"detail\": str(out.get(\"err\"))[:500], \"type\": \"proxy_error\", \"code\": 502}\n   724\t        return None\n   725\t\n   726\t    # ---- HTTP --------------------------------------------------------------------\n   727\t    def do_GET(self) -> None:  # noqa: N802\n   728\t        path = self.path.split(\"?\", 1)[0]\n   729\t        if path in (\"/health\", \"/v1/health\"):\n   730\t            with _active_lock:\n   731\t                active = len(_active)\n   732\t            self._send(200, {\n   733\t                \"ok\": True, \"transport\": \"claude-p\", \"model\": MODEL_ID,\n   734\t                \"models\": list(SUPPORTED_MODELS),\n   735\t                \"active\": active, \"max_concurrent\": MAX_CONCURRENT,\n   736\t                \"tool_emulation\": True, \"images\": True, \"live_reasoning\": True,\n   737\t                \"uptime_s\": int(time.time() - _started),\n   738\t            })\n   739\t            return\n   740\t        if not _auth_ok(self):\n   741\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   742\t            return\n   743\t        if path in (\"/v1/models\", \"/models\"):\n   744\t            self._send(200, {\"object\": \"list\", \"data\": [{\n   745\t                \"id\": model_id, \"object\": \"model\", \"owned_by\": \"anthropic\",\n   746\t                \"created\": 0, \"context_length\": MODEL_CONTEXT.get(model_id, CONTEXT_LENGTH),\n   747\t            } for model_id in SUPPORTED_MODELS]})\n   748\t            return\n   749\t        self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   750\t\n   751\t    def do_POST(self) -> None:  # noqa: N802\n   752\t        if not _auth_ok(self):\n   753\t            # Непрочитанное тело иначе будет разобрано как следующий запрос keep-alive.\n   754\t            self.close_connection = True\n   755\t            self._send(401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}})\n   756\t            return\n   757\t        path = self.path.split(\"?\", 1)[0]\n   758\t        try:\n   759\t            length = int(self.headers.get(\"Content-Length\") or \"0\")\n   760\t        except ValueError:\n   761\t            length = -1\n   762\t        if length < 0 or length > MAX_REQUEST_BYTES:\n   763\t            self.close_connection = True\n   764\t            self._send(413 if length > MAX_REQUEST_BYTES else 400,\n   765\t                       {\"error\": {\"message\": \"invalid request body length\"}})\n   766\t            return\n   767\t        raw = self.rfile.read(length) if length else b\"{}\"\n   768\t        try:\n   769\t            req = json.loads(raw.decode(\"utf-8\") or \"{}\")\n   770\t        except ValueError:\n   771\t            self._send(400, {\"error\": {\"message\": \"invalid json\"}})\n   772\t            return\n   773\t        if path not in (\"/v1/chat/completions\", \"/chat/completions\"):\n   774\t            self._send(404, {\"error\": {\"message\": f\"not found: {path}\"}})\n   775\t            return\n   776\t        # Невалидную модель отсекаем до SSE-заголовков, иначе 400 уже не отправить.\n   777\t        _model, model_err = _resolve_model(req)\n   778\t        if model_err is not None:\n   779\t            self._send(400, {\"error\": {\"message\": model_err[\"message\"],\n   780\t                                       \"type\": model_err[\"type\"]}})\n   781\t            return\n   782\t        # Невалидные изображения отсекаем там же, до спавна и SSE-заголовков.\n   783\t        try:\n   784\t            _extract_request_images(req)\n   785\t        except ImageInputError as exc:\n   786\t            self._send(400, {\"error\": {\"message\": f\"invalid image input: {exc.code}\",\n   787\t                                       \"type\": \"invalid_request_error\"}})\n   788\t            return\n   789\t        if req.get(\"stream\"):\n   790\t            self._serve_sse(req)\n   791\t        else:\n   792\t            self._serve_json(req)\n   793\t\n   794\t    def _serve_json(self, req: dict) -> None:\n   795\t        out = self._run_once(req, lambda _v: True, lambda _v: True, lambda _e: True, None)\n   796\t        if out.get(\"state\") == \"client_gone\":\n   797\t            return\n   798\t        err = self._error_body(out)\n   799\t        if err is not None:\n   800\t            self._send(err[\"code\"], {\"error\": err})\n   801\t            return\n   802\t        usage = out.get(\"usage\") or {}\n   803\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n   804\t        if out.get(\"reasoning\"):\n   805\t            message[\"reasoning_content\"] = out[\"reasoning\"]\n   806\t        finish = \"stop\"\n   807\t        if out.get(\"tool_calls\"):\n   808\t            message[\"tool_calls\"] = out[\"tool_calls\"]\n   809\t            finish = \"tool_calls\"\n   810\t        self._send(200, {\n   811\t            \"id\": f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\", \"object\": \"chat.completion\",\n   812\t            \"created\": int(time.time()), \"model\": req.get(\"model\") or MODEL_ID,\n   813\t            \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n   814\t            \"usage\": {\n   815\t                \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n   816\t                \"completion_tokens\": usage.get(\"output_tokens\", 0),\n   817\t                \"total_tokens\": usage.get(\"input_tokens\", 0) + usage.get(\"output_tokens\", 0),\n   818\t            },\n   819\t        })\n   820\t\n   821\t    def _serve_sse(self, req: dict) -> None:\n   822\t        completion_id = f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\"\n   823\t        created = int(time.time())\n   824\t        shown_model = str(req.get(\"model\") or MODEL_ID)\n   825\t        try:\n   826\t            self.send_response(200)\n   827\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n   828\t            self.send_header(\"Cache-Control\", \"no-cache\")\n   829\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n   830\t            self.end_headers()\n   831\t            self.close_connection = True\n   832\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   833\t            _log(\"client gone before headers\")\n   834\t            return\n   835\t\n   836\t        def chunk(delta: dict, finish=None) -> str:\n   837\t            return \"data: \" + json.dumps({\n   838\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n   839\t                \"model\": shown_model,\n   840\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n","exit_code":0,"status":"completed"}}
