{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba '/Users/aazhiry1/work/src/cli-agent-bridge/core/watchdog.py'\"","aggregated_output":"     1\t\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n     2\t\n     3\tМодуль реализует двухконтурный контроль времени хода исключительно средствами\n     4\tстандартной библиотеки Python на macOS (Darwin):\n     5\t1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n     6\t   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n     7\t   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n     8\t   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n     9\t   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n    10\t2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n    11\t   абсолютный потолок длительности хода независимо от активности.\n    12\t\n    13\tПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\n    14\tфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n    15\t\"\"\"\n    16\t\n    17\tfrom __future__ import annotations\n    18\t\n    19\tfrom collections.abc import Callable\n    20\tfrom dataclasses import dataclass, field\n    21\timport math\n    22\timport os\n    23\timport re\n    24\timport subprocess\n    25\timport threading\n    26\timport time\n    27\t\n    28\tIDLE_TIMEOUT_S: float = 300.0\n    29\tSAFETY_CAP_S: float = 3600.0\n    30\tFINISH_RESERVE_S: float = 35.0\n    31\tWATCHDOG_INTERVAL_S: float = 5.0\n    32\tPS_TIMEOUT_S: float = 2.0\n    33\t\n    34\tDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\n    35\tDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\n    36\tDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n    37\t\n    38\t\n    39\tdef positive_env(name: str, default: float) -> float:\n    40\t    \"\"\"Читает конечное положительное число, сохраняя безопасный fallback.\"\"\"\n    41\t    try:\n    42\t        value = float(os.environ.get(name, str(default)))\n    43\t    except (TypeError, ValueError, OverflowError):\n    44\t        return default\n    45\t    return value if math.isfinite(value) and value > 0 else default\n    46\t\n    47\t\n    48\tdef io_grace_enabled() -> bool:\n    49\t    \"\"\"Читает явный булев переключатель; некорректное значение даёт дефолт true.\"\"\"\n    50\t    value = os.environ.get(\"BRIDGE_IO_GRACE_ENABLED\", \"true\").strip().lower()\n    51\t    if value in (\"0\", \"false\", \"no\", \"off\"):\n    52\t        return False\n    53\t    return True\n    54\t\n    55\t\n    56\t_PS_LINE_RE = re.compile(\n    57\t    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n    58\t)\n    59\t\n    60\t\n    61\tdef parse_cputime(raw: str) -> float:\n    62\t    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    63\t    token = (raw or \"\").strip()\n    64\t    if not token:\n    65\t        return 0.0\n    66\t    days = 0\n    67\t    if \"-\" in token:\n    68\t        day_part, token = token.split(\"-\", 1)\n    69\t        try:\n    70\t            days = int(day_part)\n    71\t        except ValueError:\n    72\t            return 0.0\n    73\t    parts = token.split(\":\")\n    74\t    try:\n    75\t        if len(parts) == 3:\n    76\t            hours = int(parts[0])\n    77\t            minutes = int(parts[1])\n    78\t            seconds = float(parts[2])\n    79\t        elif len(parts) == 2:\n    80\t            hours = 0\n    81\t            minutes = int(parts[0])\n    82\t            seconds = float(parts[1])\n    83\t        elif len(parts) == 1:\n    84\t            hours = 0\n    85\t            minutes = 0\n    86\t            seconds = float(parts[0])\n    87\t        else:\n    88\t            return 0.0\n    89\t    except ValueError:\n    90\t        return 0.0\n    91\t    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n    92\t    return max(0.0, float(total))\n    93\t\n    94\t\n    95\t@dataclass(frozen=True)\n    96\tclass WatchdogMetrics:\n    97\t    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n    98\t\n    99\t    pgid: int\n   100\t    alive: bool\n   101\t    descendant_pids: tuple[int, ...]\n   102\t    new_descendants: tuple[int, ...]\n   103\t    cpu_time_s: float\n   104\t    cpu_delta_s: float\n   105\t    ps_degraded: bool = False\n   106\t    sample_ts: float = 0.0\n   107\t    states: list[str] = field(default_factory=list)\n   108\t\n   109\t    def is_waiting_io(self) -> bool:\n   110\t        \"\"\"Живая группа ожидает I/O; учитывается первая буква stat без флагов ps.\"\"\"\n   111\t        return (\n   112\t            self.alive\n   113\t            and not self.ps_degraded\n   114\t            and any(state[:1].upper() in {\"S\", \"D\", \"I\", \"U\"} for state in self.states)\n   115\t        )\n   116\t\n   117\t    @property\n   118\t    def has_progress(self) -> bool:\n   119\t        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n   120\t        if self.ps_degraded or not self.alive:\n   121\t            return False\n   122\t        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n   123\t\n   124\t    has_activity = has_progress\n   125\t\n   126\t\n   127\tclass ProcessWatchdog:\n   128\t    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n   129\t\n   130\t    def __init__(\n   131\t        self,\n   132\t        ps_timeout_s: float = PS_TIMEOUT_S,\n   133\t        log_fn: Callable[[str], None] | None = None,\n   134\t        rid: str = \"\",\n   135\t        turn_id: str = \"\",\n   136\t    ) -> None:\n   137\t        self.ps_timeout_s = float(ps_timeout_s)\n   138\t        self._log_fn = log_fn\n   139\t        self.rid = rid\n   140\t        self.turn_id = turn_id\n   141\t        self._lock = threading.Lock()\n   142\t        self._prev_cpu_by_pgid: dict[int, dict[int, float]] = {}\n   143\t        self._seen_descendants_by_pgid: dict[int, set[int]] = {}\n   144\t        self._seeded_pgids: set[int] = set()\n   145\t\n   146\t    def _log(self, msg: str) -> None:\n   147\t        if self._log_fn is not None:\n   148\t            try:\n   149\t                self._log_fn(msg)\n   150\t            except Exception:  # noqa: BLE001\n   151\t                pass\n   152\t\n   153\t    @staticmethod\n   154\t    def is_group_alive(pgid: int) -> bool:\n   155\t        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n   156\t        if not isinstance(pgid, int) or pgid <= 0:\n   157\t            return False\n   158\t        try:\n   159\t            os.killpg(pgid, 0)\n   160\t        except ProcessLookupError:\n   161\t            return False\n   162\t        except PermissionError:\n   163\t            return True\n   164\t        except OSError:\n   165\t            return False\n   166\t        return True\n   167\t\n   168\t    def forget(self, pgid: int) -> None:\n   169\t        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n   170\t        with self._lock:\n   171\t            self._prev_cpu_by_pgid.pop(pgid, None)\n   172\t            self._seen_descendants_by_pgid.pop(pgid, None)\n   173\t            self._seeded_pgids.discard(pgid)\n   174\t\n   175\t    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n   176\t        return subprocess.run(\n   177\t            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n   178\t            capture_output=True,\n   179\t            text=True,\n   180\t            timeout=self.ps_timeout_s,\n   181\t            check=False,\n   182\t        )\n   183\t\n   184\t    def _parse_ps_output(\n   185\t        self, stdout: str, target_pgid: int\n   186\t    ) -> tuple[list[int], dict[int, float], list[str]]:\n   187\t        \"\"\"Возвращает PID, CPU и реальные состояния незавершённых членов группы.\"\"\"\n   188\t        descendants: list[int] = []\n   189\t        cpu_by_pid: dict[int, float] = {}\n   190\t        states: list[str] = []\n   191\t        for raw_line in (stdout or \"\").splitlines():\n   192\t            line = raw_line.strip()\n   193\t            if not line:\n   194\t                continue\n   195\t            match = _PS_LINE_RE.match(line)\n   196\t            if match is None:\n   197\t                continue\n   198\t            try:\n   199\t                pid = int(match.group(1))\n   200\t                _ppid = int(match.group(2))\n   201\t                pgid_col = int(match.group(3))\n   202\t            except ValueError:\n   203\t                continue\n   204\t            if pgid_col != target_pgid:\n   205\t                continue\n   206\t            stat = match.group(4) or \"\"\n   207\t            cputime_str = match.group(5) or \"\"\n   208\t            if stat[:1].upper() in {\"Z\", \"X\"}:\n   209\t                continue\n   210\t            states.append(stat)\n   211\t            cpu_by_pid[pid] = parse_cputime(cputime_str)\n   212\t            if pid != target_pgid:\n   213\t                descendants.append(pid)\n   214\t        descendants.sort()\n   215\t        return descendants, cpu_by_pid, states\n   216\t\n   217\t    def seed(self, pgid: int, *, rid: str = \"\", turn_id: str = \"\") -> WatchdogMetrics:\n   218\t        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n   219\t        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n   220\t        return metrics\n   221\t\n   222\t    def sample(\n   223\t        self,\n   224\t        pgid: int,\n   225\t        *,\n   226\t        rid: str = \"\",\n   227\t        turn_id: str = \"\",\n   228\t        _seed_only: bool = False,\n   229\t    ) -> WatchdogMetrics:\n   230\t        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n   231\t        now = time.monotonic()\n   232\t        eff_rid = rid or self.rid or \"-\"\n   233\t        eff_turn = turn_id or self.turn_id or \"-\"\n   234\t        if not self.is_group_alive(pgid):\n   235\t            return WatchdogMetrics(\n   236\t                pgid=pgid,\n   237\t                alive=False,\n   238\t                descendant_pids=(),\n   239\t                new_descendants=(),\n   240\t                cpu_time_s=0.0,\n   241\t                cpu_delta_s=0.0,\n   242\t                ps_degraded=False,\n   243\t                sample_ts=now,\n   244\t            )\n   245\t\n   246\t        try:\n   247\t            proc = self._run_ps(pgid)\n   248\t        except (subprocess.TimeoutExpired, OSError) as exc:\n   249\t            if not self.is_group_alive(pgid):\n   250\t                return WatchdogMetrics(\n   251\t                    pgid=pgid,\n   252\t                    alive=False,\n   253\t                    descendant_pids=(),\n   254\t                    new_descendants=(),\n   255\t                    cpu_time_s=0.0,\n   256\t                    cpu_delta_s=0.0,\n   257\t                    ps_degraded=False,\n   258\t                    sample_ts=now,\n   259\t                )\n   260\t            self._log(\n   261\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n   262\t                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n   263\t            )\n   264\t            return WatchdogMetrics(\n   265\t                pgid=pgid,\n   266\t                alive=True,\n   267\t                descendant_pids=(),\n   268\t                new_descendants=(),\n   269\t                cpu_time_s=0.0,\n   270\t                cpu_delta_s=0.0,\n   271\t                ps_degraded=True,\n   272\t                sample_ts=now,\n   273\t            )\n   274\t\n   275\t        if proc.returncode != 0:\n   276\t            if not self.is_group_alive(pgid):\n   277\t                return WatchdogMetrics(\n   278\t                    pgid=pgid,\n   279\t                    alive=False,\n   280\t                    descendant_pids=(),\n   281\t                    new_descendants=(),\n   282\t                    cpu_time_s=0.0,\n   283\t                    cpu_delta_s=0.0,\n   284\t                    ps_degraded=False,\n   285\t                    sample_ts=now,\n   286\t                )\n   287\t            self._log(\n   288\t                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n   289\t                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n   290\t            )\n   291\t            return WatchdogMetrics(\n   292\t                pgid=pgid,\n   293\t                alive=True,\n   294\t                descendant_pids=(),\n   295\t                new_descendants=(),\n   296\t                cpu_time_s=0.0,\n   297\t                cpu_delta_s=0.0,\n   298\t                ps_degraded=True,\n   299\t                sample_ts=now,\n   300\t            )\n   301\t\n   302\t        descendants, cpu_s, states = self._parse_ps_output(proc.stdout, pgid)\n   303\t        if not states and not self.is_group_alive(pgid):\n   304\t            return WatchdogMetrics(\n   305\t                pgid=pgid,\n   306\t                alive=False,\n   307\t                descendant_pids=(),\n   308\t                new_descendants=(),\n   309\t                cpu_time_s=0.0,\n   310\t                cpu_delta_s=0.0,\n   311\t                ps_degraded=False,\n   312\t                sample_ts=now,\n   313\t            )\n   314\t\n   315\t        with self._lock:\n   316\t            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n   317\t            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n   318\t            if _seed_only:\n   319\t                for pid, val in cpu_s.items():\n   320\t                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n   321\t                seen_desc.update(descendants)\n   322\t                self._seeded_pgids.add(pgid)\n   323\t                total_cpu = sum(cpu_s.values())\n   324\t                return WatchdogMetrics(\n   325\t                    pgid=pgid,\n   326\t                    alive=True,\n   327\t                    descendant_pids=tuple(descendants),\n   328\t                    new_descendants=(),\n   329\t                    cpu_time_s=total_cpu,\n   330\t                    cpu_delta_s=0.0,\n   331\t                    ps_degraded=False,\n   332\t                    sample_ts=now,\n   333\t                    states=states,\n   334\t                )\n   335\t\n   336\t            cpu_delta = sum(\n   337\t                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n   338\t            )\n   339\t            new_desc = tuple(sorted(set(descendants) - seen_desc))\n   340\t            for pid, val in cpu_s.items():\n   341\t                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n   342\t            seen_desc.update(descendants)\n   343\t            self._seeded_pgids.add(pgid)\n   344\t            total_cpu = sum(cpu_s.values())\n   345\t\n   346\t        return WatchdogMetrics(\n   347\t            pgid=pgid,\n   348\t            alive=True,\n   349\t            descendant_pids=tuple(descendants),\n   350\t            new_descendants=new_desc,\n   351\t            cpu_time_s=total_cpu,\n   352\t            cpu_delta_s=cpu_delta,\n   353\t            ps_degraded=False,\n   354\t            sample_ts=now,\n   355\t            states=states,\n   356\t        )\n   357\t\n   358\t\n   359\tclass AdaptiveTimeoutController:\n   360\t    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n   361\t\n   362\t    def __init__(\n   363\t        self,\n   364\t        idle_timeout_s: float = IDLE_TIMEOUT_S,\n   365\t        safety_cap_s: float | None = None,\n   366\t        finish_reserve_s: float = FINISH_RESERVE_S,\n   367\t        watchdog: ProcessWatchdog | None = None,\n   368\t        watchdog_enabled: bool = True,\n   369\t        clock: Callable[[], float] = time.monotonic,\n   370\t        rid: str = \"\",\n   371\t        turn_id: str = \"\",\n   372\t        log_fn: Callable[[str], None] | None = None,\n   373\t        io_wait_cap_s: float | None = None,\n   374\t        watchdog_interval_s: float | None = None,\n   375\t    ) -> None:\n   376\t        self.watchdog_interval_s = (\n   377\t            positive_env(\"BRIDGE_WATCHDOG_INTERVAL_S\", WATCHDOG_INTERVAL_S)\n   378\t            if watchdog_interval_s is None\n   379\t            else float(watchdog_interval_s)\n   380\t        )\n   381\t        self.idle_timeout_s = max(\n   382\t            10.0, float(idle_timeout_s), 2 * self.watchdog_interval_s\n   383\t        )\n   384\t        self.safety_cap_s = (\n   385\t            positive_env(\n   386\t                \"BRIDGE_SAFETY_CAP_S\",\n   387\t                positive_env(\"DROID_DSH_BRIDGE_SAFETY_CAP_S\", SAFETY_CAP_S),\n   388\t            )\n   389\t            if safety_cap_s is None\n   390\t            else float(safety_cap_s)\n   391\t        )\n   392\t        self.io_wait_cap_s = (\n   393\t            positive_env(\"BRIDGE_IO_WAIT_CAP_S\", 900.0)\n   394\t            if io_wait_cap_s is None\n   395\t            else float(io_wait_cap_s)\n   396\t        )\n   397\t        self.io_grace_enabled = io_grace_enabled()\n   398\t        self.finish_reserve_s = float(finish_reserve_s)\n   399\t        self.watchdog_enabled = bool(watchdog_enabled)\n   400\t        self._clock = clock\n   401\t        self.rid = rid\n   402\t        self.turn_id = turn_id\n   403\t        self._log_fn = log_fn\n   404\t        self.watchdog = watchdog or ProcessWatchdog(\n   405\t            log_fn=log_fn, rid=rid, turn_id=turn_id\n   406\t        )\n   407\t        self._lock = threading.Lock()\n   408\t        now = self._clock()\n   409\t        self.started_at: float = now\n   410\t        self.last_activity_ts: float = now\n   411\t        self.last_activity_kind: str = \"start\"\n   412\t        self.pgid: int | None = None\n   413\t        self.terminated_reason: str = \"\"\n   414\t\n   415\t    def effective_cap_s(self) -> float:\n   416\t        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n   417\t        if self.safety_cap_s > self.finish_reserve_s:\n   418\t            return self.safety_cap_s - self.finish_reserve_s\n   419\t        return max(0.01, self.safety_cap_s)\n   420\t\n   421\t    def record_activity(self, kind: str = \"protocol\") -> None:\n   422\t        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n   423\t        now = self._clock()\n   424\t        with self._lock:\n   425\t            self.last_activity_ts = now\n   426\t            self.last_activity_kind = kind or \"protocol\"\n   427\t\n   428\t    def on_activity(self, kind: str = \"protocol\") -> None:\n   429\t        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n   430\t        self.record_activity(kind)\n   431\t\n   432\t    def register_pgid(self, pgid: int) -> None:\n   433\t        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n   434\t        if not isinstance(pgid, int) or pgid <= 0:\n   435\t            return\n   436\t        with self._lock:\n   437\t            self.pgid = pgid\n   438\t        if self.watchdog_enabled and self.watchdog is not None:\n   439\t            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n   440\t\n   441\t    def check(\n   442\t        self, pgid: int | None = None\n   443\t    ) -> tuple[bool, str, WatchdogMetrics | None]:\n   444\t        \"\"\"Проверяет условия завершения хода.\n   445\t\n   446\t        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n   447\t        `should_stop == True` принимает одно из значений:\n   448\t        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n   449\t        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n   450\t        - `\"child_exited\"` — процессная группа завершилась.\n   451\t        \"\"\"\n   452\t        with self._lock:\n   453\t            target_pgid = pgid if pgid is not None else self.pgid\n   454\t            started_at = self.started_at\n   455\t\n   456\t        now = self._clock()\n   457\t        if now - started_at >= self.effective_cap_s():\n   458\t            with self._lock:\n   459\t                self.terminated_reason = \"absolute_cap\"\n   460\t            return True, \"absolute_cap\", None\n   461\t\n   462\t        metrics: WatchdogMetrics | None = None\n   463\t        if (\n   464\t            self.watchdog_enabled\n   465\t            and self.watchdog is not None\n   466\t            and isinstance(target_pgid, int)\n   467\t            and target_pgid > 0\n   468\t        ):\n   469\t            metrics = self.watchdog.sample(\n   470\t                target_pgid, rid=self.rid, turn_id=self.turn_id\n   471\t            )\n   472\t            if not metrics.alive:\n   473\t                with self._lock:\n   474\t                    self.terminated_reason = \"child_exited\"\n   475\t                return True, \"child_exited\", metrics\n   476\t            if metrics.has_progress:\n   477\t                with self._lock:\n   478\t                    self.last_activity_ts = now\n   479\t                    self.last_activity_kind = (\n   480\t                        \"new_descendants\"\n   481\t                        if metrics.new_descendants\n   482\t                        else \"cpu_delta\"\n   483\t                    )\n   484\t\n   485\t        with self._lock:\n   486\t            idle_elapsed = now - self.last_activity_ts\n   487\t            if idle_elapsed >= self.idle_timeout_s and not self.has_io_grace(\n   488\t                metrics, idle_elapsed\n   489\t            ):\n   490\t                self.terminated_reason = \"idle_timeout\"\n   491\t                return True, \"idle_timeout\", metrics\n   492\t\n   493\t        return False, \"\", metrics\n   494\t\n   495\t    def has_io_grace(\n   496\t        self, metrics: WatchdogMetrics | None, idle_elapsed: float\n   497\t    ) -> bool:\n   498\t        \"\"\"Даёт ограниченную отсрочку I/O без подмены last_activity_ts.\"\"\"\n   499\t        return bool(\n   500\t            self.io_grace_enabled\n   501\t            and metrics is not None\n   502\t            and metrics.is_waiting_io()\n   503\t            and idle_elapsed < self.io_wait_cap_s\n   504\t        )\n   505\t\n   506\t    def close(self) -> None:\n   507\t        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n   508\t        with self._lock:\n   509\t            pgid = self.pgid\n   510\t        if pgid is not None and self.watchdog is not None:\n   511\t            self.watchdog.forget(pgid)\n   512\t\n   513\t\n   514\t# Имя из контракта контроллера хода; прежний импорт остаётся совместимым.\n   515\tTurnTimeoutController = AdaptiveTimeoutController\n","exit_code":0,"status":"completed"}}
