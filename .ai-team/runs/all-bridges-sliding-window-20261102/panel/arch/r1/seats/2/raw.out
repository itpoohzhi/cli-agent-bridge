   204\t      \"verification_ids\": [\n   205\t        \"VER-002\"\n   206\t      ]\n   207\t    },\n   208\t    {\n   209\t      \"id\": \"QA-003\",\n   210\t      \"quality\": \"compatibility\",\n   211\t      \"source\": \"unit-тесты test_claude_bridge.py с FakeRun\",\n   212\t      \"stimulus\": \"запуск тестов без реального процесса ОС (proc=None)\",\n   213\t      \"environment\": \"pytest тестовое окружение\",\n   214\t      \"artifact\": \"bridges/claude-p-bridge/server.py\",\n   215\t      \"response\": \"безопасный доступ getattr(run, 'proc', None) предотвращает AttributeError и сохраняет прохождение тестов\",\n   216\t      \"response_measure\": \"100% существующих тестов проходят успешно\",\n   217\t      \"verification_ids\": [\n   218\t        \"VER-003\"\n   219\t      ]\n   220\t    },\n   221\t    {\n   222\t      \"id\": \"QA-004\",\n   223\t      \"quality\": \"maintainability\",\n   224\t      \"source\": \"эксплуатационная среда\",\n   225\t      \"stimulus\": \"необходимость изменить порог сброса stall в opencode-zen-bridge без правок кода\",\n   226\t      \"environment\": \"рантайм opencode-zen-bridge\",\n   227\t      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n   228\t      \"response\": \"STALL_TIMEOUT_S читается из OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\",\n   229\t      \"response_measure\": \"порог настраивается через env переменную\",\n   230\t      \"verification_ids\": [\n   231\t        \"VER-004\"\n   232\t      ]\n   233\t    },\n   234\t    {\n   235\t      \"id\": \"QA-005\",\n   236\t      \"quality\": \"operability\",\n   237\t      \"source\": \"клиент хаба :9882\",\n   238\t      \"stimulus\": \"настройка таймаута записи стрима через системную переменную BRIDGE_CLIENT_WRITE_TIMEOUT_S\",\n   239\t      \"environment\": \"рантайм server.py\",\n   240\t      \"artifact\": \"server.py\",\n   241\t      \"response\": \"parse_live_write_timeout успешно читает и валидирует BRIDGE_CLIENT_WRITE_TIMEOUT_S\",\n   242\t      \"response_measure\": \"таймаут применяется корректно\",\n   243\t      \"verification_ids\": [\n   244\t        \"VER-005\"\n   245\t      ]\n   246\t    }\n   247\t  ],\n   248\t  \"boundaries\": [\n   249\t    {\n   250\t      \"id\": \"BND-001\",\n   251\t      \"component\": \"ClaudePBridgeWatchdog\",\n   252\t      \"responsibility\": \"Мониторинг активности CLI claude -p через AdaptiveTimeoutController и аварийное завершение группы процесса\",\n   253\t      \"allowed_dependencies\": [\n   254\t        \"core/watchdog.py\",\n   255\t        \"bridges/claude-p-bridge/server.py\"\n   256\t      ],\n   257\t      \"forbidden_dependencies\": [\n   258\t        \"vendor binary patches\",\n   259\t        \"hardcoded wall-clock kills\"\n   260\t      ],\n   261\t      \"verification_ids\": [\n   262\t        \"VER-001\"\n   263\t      ]\n   264\t    },\n   265\t    {\n   266\t      \"id\": \"BND-002\",\n   267\t      \"component\": \"DshEnvSecurityParser\",\n   268\t      \"responsibility\": \"Безопасное извлечение несекретных настроек таймаутов из ~/.dsh/.env без загрязнения os.environ\",\n   269\t      \"allowed_dependencies\": [\n   270\t        \"pathlib.Path\"\n   271\t      ],\n   272\t      \"forbidden_dependencies\": [\n   273\t        \"os.environ.update\",\n   274\t        \"reading sensitive keys\"\n   275\t      ],\n   276\t      \"verification_ids\": [\n   277\t        \"VER-002\"\n   278\t      ]\n   279\t    },\n   280\t    {\n   281\t      \"id\": \"BND-003\",\n   282\t      \"component\": \"OpenCodeZenBridgeConfig\",\n   283\t      \"responsibility\": \"Конфигурируемое чтение STALL_TIMEOUT_S через изолированный хелпер _zen_positive_float\",\n   284\t      \"allowed_dependencies\": [\n   285\t        \"bridges/opencode-zen-bridge/server.py\"\n   286\t      ],\n   287\t      \"forbidden_dependencies\": [\n   288\t        \"unisolated environment collisions\"\n   289\t      ],\n   290\t      \"verification_ids\": [\n   291\t        \"VER-004\"\n   292\t      ]\n   293\t    },\n   294\t    {\n   295\t      \"id\": \"BND-004\",\n   296\t      \"component\": \"ServerLiveWriteFallback\",\n   297\t      \"responsibility\": \"Двухступенчатый каскадный парсинг таймаута записи стрима клиенту\",\n   298\t      \"allowed_dependencies\": [\n   299\t        \"server.py\"\n   300\t      ],\n   301\t      \"forbidden_dependencies\": [\n   302\t        \"vendor lock-in\"\n   303\t      ],\n   304\t      \"verification_ids\": [\n   305\t        \"VER-005\"\n   306\t      ]\n   307\t    }\n   308\t  ],\n   309\t  \"contract_deltas\": [\n   310\t    {\n   311\t      \"id\": \"CD-001\",\n   312\t      \"type\": \"behavior\",\n   313\t      \"producer\": \"bridges/claude-p-bridge/server.py\",\n   314\t      \"consumer\": \"HTTP client\",\n   315\t      \"change\": \"Возврат 504 Gateway Timeout вместо вечного ожидания при зависании процесса claude -p\",\n   316\t      \"compatibility\": \"Обратно совместимо со спецификацией OpenAI API\",\n   317\t      \"verification_ids\": [\n   318\t        \"VER-001\"\n   319\t      ]\n   320\t    },\n   321\t    {\n   322\t      \"id\": \"CD-002\",\n   323\t      \"type\": \"behavior\",\n   324\t      \"producer\": \"server.py\",\n   325\t      \"consumer\": \"HTTP client\",\n   326\t      \"change\": \"Поддержка переменной BRIDGE_CLIENT_WRITE_TIMEOUT_S с приоритетом над DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\",\n   327\t      \"compatibility\": \"Полная обратная совместимость с существующим поведением Droid\",\n   328\t      \"verification_ids\": [\n   329\t        \"VER-005\"\n   330\t      ]\n   331\t    },\n   332\t    {\n   333\t      \"id\": \"CD-003\",\n   334\t      \"type\": \"behavior\",\n   335\t      \"producer\": \"bridges/opencode-zen-bridge/server.py\",\n   336\t      \"consumer\": \"Zen bridge client\",\n   337\t      \"change\": \"Возможность настройки STALL_TIMEOUT_S через OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\",\n   338\t      \"compatibility\": \"Дефолт 60.0с сохранен\",\n   339\t      \"verification_ids\": [\n   340\t        \"VER-004\"\n   341\t      ]\n   342\t    },\n   343\t    {\n   344\t      \"id\": \"CD-004\",\n   345\t      \"type\": \"data\",\n   346\t      \"producer\": \"~/.dsh/.env\",\n   347\t      \"consumer\": \"bridges/claude-p-bridge/server.py\",\n   348\t      \"change\": \"Чтение только разрешенных ключей таймаутов в локальный словарь _DSH_ENV\",\n   349\t      \"compatibility\": \"Не затрагивает другие приложения, использующие ~/.dsh/.env\",\n   350\t      \"verification_ids\": [\n   351\t        \"VER-002\"\n   352\t      ]\n   353\t    }\n   354\t  ],\n   355\t  \"views\": [\n   356\t    {\n   357\t      \"id\": \"VIEW-001\",\n   358\t      \"type\": \"dynamic\",\n   359\t      \"question\": \"Как AdaptiveTimeoutController обеспечивает скользящее окно активности и защищает от stall?\",\n   360\t      \"artifact_ref\": \"analysis/all-bridges-sliding-activity-window/handoff-architect.md\"\n   361\t    }\n   362\t  ],\n   363\t  \"risks\": [\n   364\t    {\n   365\t      \"id\": \"RISK-001\",\n   366\t      \"scenario\": \"Ложное прерывание операции при нормальном выходе процесса claude -p\",\n   367\t      \"probability\": \"low\",\n   368\t      \"impact\": \"high\",\n   369\t      \"mitigation\": \"При reason == 'child_exited' цикл _execute не прерывается, а ожидает дочитывания очереди done\",\n   370\t      \"verification_ids\": [\n   371\t        \"VER-001\"\n   372\t      ]\n   373\t    },\n   374\t    {\n   375\t      \"id\": \"RISK-002\",\n   376\t      \"scenario\": \"Утечка API-токенов из ~/.dsh/.env в дочерние процессы\",\n   377\t      \"probability\": \"low\",\n   378\t      \"impact\": \"high\",\n   379\t      \"mitigation\": \"Строгий whitelist _ALLOWED_SETTINGS_KEYS отсекает любые секреты, словарь хранится локально без мутации os.environ\",\n   380\t      \"verification_ids\": [\n   381\t        \"VER-002\"\n   382\t      ]\n   383\t    },\n   384\t    {\n   385\t      \"id\": \"RISK-003\",\n   386\t      \"scenario\": \"Падение существующих unit-тестов, использующих FakeRun без proc\",\n   387\t      \"probability\": \"low\",\n   388\t      \"impact\": \"medium\",\n   389\t      \"mitigation\": \"Безопасное получение proc и proc_pid через getattr(..., None)\",\n   390\t      \"verification_ids\": [\n   391\t        \"VER-003\"\n   392\t      ]\n   393\t    },\n   394\t    {\n   395\t      \"id\": \"RISK-004\",\n   396\t      \"scenario\": \"Загрязнение окружения pytest переменными из тестовых файлов\",\n   397\t      \"probability\": \"low\",\n   398\t      \"impact\": \"medium\",\n   399\t      \"mitigation\": \"Использование контекстного менеджера MonkeyPatch и изолированной фикстуры с временным fake HOME\",\n   400\t      \"verification_ids\": [\n   401\t        \"VER-004\"\n   402\t      ]\n   403\t    }\n   404\t  ],\n   405\t  \"threat_model\": {\n   406\t    \"required\": false,\n   407\t    \"assets\": [],\n   408\t    \"trust_boundaries\": [],\n   409\t    \"threats\": []\n   410\t  },\n   411\t  \"evolution\": {\n   412\t    \"compatibility\": \"Полная обратная совместимость с OpenAI API, CLI-агентами и существующими тестовыми наборами\",\n   413\t    \"migration\": \"Не требуется; все параметры имеют безопасные значения по умолчанию\",\n   414\t    \"rollout\": \"Бесшовный перезапуск мостов через kickstart launchd службы\",\n   415\t    \"rollback\": \"Установка CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=0 полностью отключает контроллер вотчдога\"\n   416\t  },\n   417\t  \"verification_surface\": [\n   418\t    {\n   419\t      \"id\": \"VER-001\",\n   420\t      \"requirement_ids\": [\n   421\t        \"REQ-ALL-001\",\n   422\t        \"AD-001\",\n   423\t        \"QA-001\",\n   424\t        \"BND-001\",\n   425\t        \"CD-001\"\n   426\t      ],\n   427\t      \"kind\": \"command\",\n   428\t      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -k test_watchdog_timeout_trigger -v\",\n   429\t      \"expected\": \"exit 0; timeout trigger verified\",\n   430\t      \"environment\": \"local python virtualenv\",\n   431\t      \"owner\": \"architect\"\n   432\t    },\n   433\t    {\n   434\t      \"id\": \"VER-002\",\n   435\t      \"requirement_ids\": [\n   436\t        \"REQ-ALL-004\",\n   437\t        \"AD-002\",\n   438\t        \"QA-002\",\n   439\t        \"BND-002\",\n   440\t        \"CD-004\"\n   441\t      ],\n   442\t      \"kind\": \"command\",\n   443\t      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -k test_claude_p_env_loader_security -v\",\n   444\t      \"expected\": \"exit 0; security whitelist verified\",\n   445\t      \"environment\": \"local python virtualenv\",\n   446\t      \"owner\": \"architect\"\n   447\t    },\n   448\t    {\n   449\t      \"id\": \"VER-003\",\n   450\t      \"requirement_ids\": [\n   451\t        \"REQ-ALL-001\",\n   452\t        \"QA-003\"\n   453\t      ],\n   454\t      \"kind\": \"command\",\n   455\t      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_bridge.py -v\",\n   456\t      \"expected\": \"exit 0; existing tests pass with FakeRun\",\n   457\t      \"environment\": \"local python virtualenv\",\n   458\t      \"owner\": \"architect\"\n   459\t    },\n   460\t    {\n   461\t      \"id\": \"VER-004\",\n   462\t      \"requirement_ids\": [\n   463\t        \"REQ-ALL-002\",\n   464\t        \"AD-003\",\n   465\t        \"QA-004\",\n   466\t        \"BND-003\",\n   467\t        \"CD-003\"\n   468\t      ],\n   469\t      \"kind\": \"command\",\n   470\t      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -v\",\n   471\t      \"expected\": \"exit 0; full watchdog test suite passes\",\n   472\t      \"environment\": \"local python virtualenv\",\n   473\t      \"owner\": \"architect\"\n   474\t    },\n   475\t    {\n   476\t      \"id\": \"VER-005\",\n   477\t      \"requirement_ids\": [\n   478\t        \"REQ-ALL-003\",\n   479\t        \"AD-004\",\n   480\t        \"QA-005\",\n   481\t        \"BND-004\",\n   482\t        \"CD-002\"\n   483\t      ],\n   484\t      \"kind\": \"command\",\n   485\t      \"command\": \"uv run pytest -o pythonpath=. tests/test_stream_timeout_config.py -v\",\n   486\t      \"expected\": \"exit 0; fallback priority verified\",\n   487\t      \"environment\": \"local python virtualenv\",\n   488\t      \"owner\": \"architect\"\n   489\t    }\n   490\t  ],\n   491\t  \"protected_paths\": [],\n   492\t  \"materialization\": [],\n   493\t  \"approval\": {\n   494\t    \"status\": \"APPROVED\",\n   495\t    \"decision_ids\": []\n   496\t  },\n   497\t  \"independent_review\": {\n   498\t    \"required\": false,\n   499\t    \"status\": \"NOT_REQUIRED\"\n   500\t  },\n   501\t  \"open_questions\": [],\n   502\t  \"deferred\": []\n   503\t}","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' core/watchdog.py | nl -ba; sed -n '820,920p' bridges/claude-p-bridge/server.py | nl -ba -v820; sed -n '388,478p' bridges/claude-p-bridge/server.py | nl -ba -v388; sed -n '238,390p' analysis/all-bridges-sliding-activity-window/handoff-architect.md | nl -ba -v238; nl -ba analysis/all-bridges-sliding-activity-window/research-plan.md; nl -ba tests/test_stream_timeout_config.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' core/watchdog.py | nl -ba; sed -n '820,920p' bridges/claude-p-bridge/server.py | nl -ba -v820; sed -n '388,478p' bridges/claude-p-bridge/server.py | nl -ba -v388; sed -n '238,390p' analysis/all-bridges-sliding-activity-window/handoff-architect.md | nl -ba -v238; nl -ba analysis/all-bridges-sliding-activity-window/research-plan.md; nl -ba tests/test_stream_timeout_config.py\"","aggregated_output":"     1\t\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n     2\t\n     3\tМодуль реализует двухконтурный контроль времени хода исключительно средствами\n     4\tстандартной библиотеки Python на macOS (Darwin):\n     5\t1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n     6\t   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n     7\t   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n     8\t   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n     9\t   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n    10\t2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n    11\t   абсолютный потолок длительности хода независимо от активности.\n    12\t\n    13\tПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\n    14\tфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n    15\t\"\"\"\n    16\t\n    17\tfrom __future__ import annotations\n    18\t\n    19\tfrom collections.abc import Callable\n    20\tfrom dataclasses import dataclass, field\n    21\timport math\n    22\timport os\n    23\timport re\n    24\timport subprocess\n    25\timport threading\n    26\timport time\n    27\t\n    28\tIDLE_TIMEOUT_S: float = 300.0\n    29\tSAFETY_CAP_S: float = 3600.0\n    30\tFINISH_RESERVE_S: float = 35.0\n    31\tWATCHDOG_INTERVAL_S: float = 5.0\n    32\tPS_TIMEOUT_S: float = 2.0\n    33\t\n    34\tDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\n    35\tDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\n    36\tDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n    37\t\n    38\t\n    39\tdef positive_env(name: str, default: float) -> float:\n    40\t    \"\"\"Читает конечное положительное число, сохраняя безопасный fallback.\"\"\"\n    41\t    try:\n    42\t        value = float(os.environ.get(name, str(default)))\n    43\t    except (TypeError, ValueError, OverflowError):\n    44\t        return default\n    45\t    return value if math.isfinite(value) and value > 0 else default\n    46\t\n    47\t\n    48\tdef io_grace_enabled() -> bool:\n    49\t    \"\"\"Читает явный булев переключатель; некорректное значение даёт дефолт true.\"\"\"\n    50\t    value = os.environ.get(\"BRIDGE_IO_GRACE_ENABLED\", \"true\").strip().lower()\n    51\t    if value in (\"0\", \"false\", \"no\", \"off\"):\n    52\t        return False\n    53\t    return True\n    54\t\n    55\t\n    56\t_PS_LINE_RE = re.compile(\n    57\t    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n    58\t)\n    59\t\n    60\t\n    61\tdef parse_cputime(raw: str) -> float:\n    62\t    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    63\t    token = (raw or \"\").strip()\n    64\t    if not token:\n    65\t        return 0.0\n   820\t\n   821\t    def _serve_sse(self, req: dict) -> None:\n   822\t        completion_id = f\"chatcmpl-claudep-{uuid.uuid4().hex[:12]}\"\n   823\t        created = int(time.time())\n   824\t        shown_model = str(req.get(\"model\") or MODEL_ID)\n   825\t        try:\n   826\t            self.send_response(200)\n   827\t            self.send_header(\"Content-Type\", \"text/event-stream\")\n   828\t            self.send_header(\"Cache-Control\", \"no-cache\")\n   829\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n   830\t            self.end_headers()\n   831\t            self.close_connection = True\n   832\t        except (BrokenPipeError, ConnectionResetError, OSError):\n   833\t            _log(\"client gone before headers\")\n   834\t            return\n   835\t\n   836\t        def chunk(delta: dict, finish=None) -> str:\n   837\t            return \"data: \" + json.dumps({\n   838\t                \"id\": completion_id, \"object\": \"chat.completion.chunk\", \"created\": created,\n   839\t                \"model\": shown_model,\n   840\t                \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n   841\t            }, ensure_ascii=False) + \"\\n\\n\"\n   842\t\n   843\t        def on_text(value: str) -> bool:\n   844\t            return self._emit(chunk({\"content\": value}))\n   845\t\n   846\t        def on_reasoning(value: str) -> bool:\n   847\t            return self._emit(chunk({\"reasoning_content\": value}))\n   848\t\n   849\t        def on_tool_call(entry: dict) -> bool:\n   850\t            return self._emit(chunk({\"tool_calls\": [entry]}))\n   851\t\n   852\t        def keepalive() -> bool:\n   853\t            return self._emit(\": keepalive\\n\\n\")\n   854\t\n   855\t        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n   856\t            return\n   857\t        out = self._run_once(req, on_text, on_reasoning, on_tool_call, keepalive)\n   858\t        if out.get(\"state\") == \"client_gone\":\n   859\t            _log(\"client gone mid-stream, child killed\")\n   860\t            return\n   861\t        err = self._error_body(out)\n   862\t        if err is None:\n   863\t            finish = \"tool_calls\" if out.get(\"tool_calls\") else \"stop\"\n   864\t            self._emit(chunk({}, finish))\n   865\t        else:\n   866\t            error_msg = str(err.get(\"message\") or \"\") if isinstance(err, dict) else str(err)\n   867\t            error_chunk = format_stream_error_sse(str(error_msg), finish_reason=\"stop\")\n   868\t            self._emit(error_chunk)\n   869\t            return\n   870\t        self._emit(\"data: [DONE]\\n\\n\")\n   871\t\n   872\t\n   873\tclass Server(ThreadingHTTPServer):\n   874\t    daemon_threads = True\n   875\t    request_queue_size = HTTP_BACKLOG\n   876\t    allow_reuse_address = True\n   877\t\n   878\t\n   879\tdef main() -> None:\n   880\t    if not AUTH_KEY:\n   881\t        sys.stderr.write(\"CLAUDE_P_BRIDGE_KEY is required; refusing to start\\n\")\n   882\t        raise SystemExit(1)\n   883\t    WORKSPACE.mkdir(parents=True, exist_ok=True)\n   884\t    signal.signal(signal.SIGTERM, _kill_all)\n   885\t    signal.signal(signal.SIGINT, _kill_all)\n   886\t    server = Server((HOST, PORT), Handler)\n   887\t    _log(f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\n   888\t         f\"queue_timeout={QUEUE_TIMEOUT_S}s keepalive={KEEPALIVE_S}s\")\n   889\t    print(f\"[claude-p-bridge] listening on http://{HOST}:{PORT}/v1\", flush=True)\n   890\t    server.serve_forever()\n   891\t\n   892\t\n   893\tif __name__ == \"__main__\":\n   894\t    main()\n   388\t        child_env = os.environ.copy()\n   389\t        child_env[\"HOME\"] = str(_prepare_claude_home())\n   390\t        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n   391\t        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n   392\t\n   393\t        self.proc = subprocess.Popen(\n   394\t            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n   395\t            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n   396\t            start_new_session=True, env=child_env,\n   397\t        )\n   398\t        with _active_lock:\n   399\t            _active[self.proc.pid] = self.proc\n   400\t        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n   401\t        self._closed = threading.Event()\n   402\t        self.err_box = []\n   403\t        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n   404\t        threading.Thread(target=self._drain_stderr, daemon=True).start()\n   405\t        threading.Thread(target=self._pump, daemon=True).start()\n   406\t\n   407\t    def _feed(self, prompt: str) -> None:\n   408\t        \"\"\"Промпт уходит только через stdin.\"\"\"\n   409\t        try:\n   410\t            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n   411\t            self.proc.stdin.close()\n   412\t        except (BrokenPipeError, OSError):\n   413\t            pass\n   414\t\n   415\t    def _drain_stderr(self) -> None:\n   416\t        remaining = MAX_STDERR_BYTES\n   417\t        retained = bytearray()\n   418\t        try:\n   419\t            while chunk := self.proc.stderr.read(IO_CHUNK_BYTES):\n   420\t                if remaining:\n   421\t                    retained.extend(chunk[:remaining])\n   422\t                    remaining = max(0, remaining - len(chunk))\n   423\t        except Exception:  # noqa: BLE001 - вторичный поток, ошибку терять нельзя молча\n   424\t            pass\n   425\t        finally:\n   426\t            self.err_box.append(retained.decode(\"utf-8\", \"replace\"))\n   427\t\n   428\t    def _enqueue(self, event: tuple) -> None:\n   429\t        \"\"\"Ограниченная очередь с прерыванием ожидания при закрытии хода.\"\"\"\n   430\t        while not self._closed.is_set():\n   431\t            try:\n   432\t                self.q.put(event, timeout=POLL_INTERVAL_S)\n   433\t                return\n   434\t            except queue.Full:\n   435\t                continue\n   436\t\n   437\t    def _pump(self) -> None:\n   438\t        \"\"\"Разбор stream-json: content_block_delta -> text/thinking, result -> итог.\"\"\"\n   439\t        try:\n   440\t            for raw in iter(self.proc.stdout.readline, b\"\"):\n   441\t                line = raw.decode(\"utf-8\", \"replace\").strip()\n   442\t                if not line.startswith(\"{\"):\n   443\t                    continue\n   444\t                try:\n   445\t                    ev = json.loads(line)\n   446\t                except ValueError:\n   447\t                    continue\n   448\t                etype = ev.get(\"type\")\n   449\t                if etype == \"stream_event\":\n   450\t                    inner = ev.get(\"event\") or {}\n   451\t                    if inner.get(\"type\") == \"content_block_delta\":\n   452\t                        delta = inner.get(\"delta\") or {}\n   453\t                        dtype = delta.get(\"type\")\n   454\t                        if dtype == \"text_delta\" and delta.get(\"text\"):\n   455\t                            self._enqueue((\"text\", delta[\"text\"]))\n   456\t                        elif dtype == \"thinking_delta\":\n   457\t                            thinking = extract_thinking_delta(delta)\n   458\t                            if thinking:\n   459\t                                self._enqueue((\"thinking\", thinking))\n   460\t                elif etype == \"result\":\n   461\t                    self._enqueue((\"result\", ev))\n   462\t            rc = self.proc.wait()\n   463\t        except Exception as exc:  # noqa: BLE001 - читатель не должен умирать молча\n   464\t            self._enqueue((\"pump_error\", repr(exc)))\n   465\t            return\n   466\t        time.sleep(STDERR_DRAIN_S)  # дать стоку stderr дозавершиться\n   467\t        self._enqueue((\"done\", rc))\n   468\t\n   469\t    def close(self) -> None:\n   470\t        self._closed.set()\n   471\t        if self.proc.poll() is None:\n   472\t            _kill_group(self.proc)\n   473\t        self.proc.wait(timeout=PROCESS_WAIT_S)\n   474\t        with _active_lock:\n   475\t            _active.pop(self.proc.pid, None)\n   476\t        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n   477\t            try:\n   478\t                if stream is not None:\n   238\t             \"type\": \"upstream_timeout\",\n   239\t             \"code\": 504,\n   240\t         }\n   241\t     ```\n   242\t   *(Примечание по SSE: в потоковом ответе ошибка транслируется через `format_stream_error_sse(..., finish_reason=\"stop\")` согласно существующему контракту).*\n   243\t\n   244\t### 3.2. Настройка в `bridges/opencode-zen-bridge/server.py`\n   245\tИспользование существующего хелпера `_zen_positive_float` (`:338`):\n   246\t```python\n   247\tSTALL_TIMEOUT_S = _zen_positive_float(\n   248\t    \"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\",\n   249\t    60.0,\n   250\t)\n   251\t```\n   252\t\n   253\t---\n   254\t\n   255\t## 4. Верификационные требования и изоляция тестов\n   256\t\n   257\t### 4.1. Набор тестов для claude-p вотчдога (`tests/test_claude_p_watchdog.py`)\n   258\tРазрабатывается новый тестовый файл с детерминированными моками. Для полной изоляции от реального `~/.dsh/.env` разработчика используется модульная фикстура, которая изолирует `HOME` / `Path.home` и очищает окружение **до загрузки модуля** моста под уникальным именем:\n   259\t```python\n   260\timport importlib.util\n   261\tfrom pathlib import Path\n   262\timport sys\n   263\timport uuid\n   264\timport pytest\n   265\t\n   266\tREPO_ROOT = Path(__file__).resolve().parents[1]\n   267\t\n   268\t@pytest.fixture(scope=\"module\")\n   269\tdef isolated_claude_bridge(tmp_path_factory):\n   270\t    tmp_home = tmp_path_factory.mktemp(\"fake_home\")\n   271\t    with pytest.MonkeyPatch.context() as mp:\n   272\t        mp.setenv(\"HOME\", str(tmp_home))\n   273\t        for key in list(sys.modules.get(\"os\", __import__(\"os\")).environ.keys()):\n   274\t            if key.startswith(\"CLAUDE_P_BRIDGE_\") or key.startswith(\"BRIDGE_\"):\n   275\t                mp.delenv(key, raising=False)\n   276\t        module_name = f\"claude_p_bridge_isolated_{uuid.uuid4().hex[:8]}\"\n   277\t        spec = importlib.util.spec_from_file_location(\n   278\t            module_name,\n   279\t            REPO_ROOT / \"bridges\" / \"claude-p-bridge\" / \"server.py\",\n   280\t        )\n   281\t        mod = importlib.util.module_from_spec(spec)\n   282\t        sys.modules[module_name] = mod\n   283\t        try:\n   284\t            spec.loader.exec_module(mod)\n   285\t            yield mod\n   286\t        finally:\n   287\t            sys.modules.pop(module_name, None)\n   288\t```\n   289\tТестовые сценарии:\n   290\t1. `test_claude_p_env_loader_security`: проверка, что `_read_dsh_env_file` изолирован, не мутирует `os.environ`, читает только разрешенные ключи из whitelist, последнее значение перезаписывает предыдущее, категорически игнорируя секреты (`CLAUDE_P_BRIDGE_KEY`, `BRIDGE_KEY`, `CODEX_LB_*`, `CURSOR_*`, `MUSE_*`).\n   291\t2. `test_watchdog_timeout_trigger`: мокируется `_kill_group` (защита от вызова `os.killpg` на фейковом pid). Проверка, что при возврате `(True, \"idle_timeout\", ...)` вызывается мок `_kill_group`, возвращается статус `state(\"timeout\", 1, ...)` и `_error_body` выдаёт код 504.\n   292\t3. `test_child_exited_no_false_timeout`: проверка, что при возврате `(True, \"child_exited\", ...)` ход не прерывается ложным таймаутом, а очередь успешно дочитывает `done`.\n   293\t4. `test_watchdog_throttle`: проверка, что `controller.check()` вызывается не чаще чем раз в `controller.watchdog_interval_s`.\n   294\t5. `test_record_activity_calls`: проверка вызова `record_activity(kind)` на события `text`, `thinking` и `result`.\n   295\t6. `test_controller_closed_in_finally`: проверка гарантированного вызова `controller.close()` при любом исходе хода.\n   296\t\n   297\t### 4.2. Изоляция тестов конфигурации таймаутов (`tests/test_stream_timeout_config.py`)\n   298\t1. Во всех тестах функции `parse_live_write_timeout` (`:9-37`) добавить `monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)` для защиты от фонового окружения.\n   299\t2. Добавить тест `test_live_write_timeout_priority`:\n   300\t   - При валидном `BRIDGE_CLIENT_WRITE_TIMEOUT_S` берется оно.\n   301\t   - При невалидном `BRIDGE_CLIENT_WRITE_TIMEOUT_S` и валидном `DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S` берется legacy.\n   302\t   - При обоих невалидных возвращается переданный `default`.\n   303\t\n   304\t### 4.3. Интеграционный прогон регрессий:\n   305\tОбязательный прогон полного набора тестов моста:\n   306\t`uv run pytest -o pythonpath=. tests/test_claude_bridge.py tests/test_claude_p_watchdog.py tests/test_stream_timeout_config.py tests/test_stream_resilience.py tests/test_http_presend_resilience.py` -> 100% PASS.\n     1\t# Research Plan — Сквозное внедрение скользящих окон активности во все мосты (All Bridges Sliding Activity Window)\n     2\t\n     3\t## Карточка задачи (Task Envelope)\n     4\tРЕЖИМ | development\n     5\tЦЕЛЬ ИЗМЕНЕНИЯ | Системно устранить все статические настенные таймауты и жесткие лимиты во всех мостах контура (agy-bridge, opencode-zen-bridge, claude-p-bridge, muse-bridge, core), заменив их на скользящие окна активности (Sliding Activity Window): сброс таймера тишины при поступлении каждого полезного чанка (content, reasoning_content, tool_calls) и аварийный safety cap.\n     6\tЧТО МЕНЯЕТСЯ | `bridges/agy-bridge/server.py`, `bridges/opencode-zen-bridge/server.py`, `bridges/claude-p-bridge/server.py`, `bridges/muse-bridge/`, `core/watchdog.py`, `core/turn_session_manager.py`.\n     7\tЧТО НЕЛЬЗЯ МЕНЯТЬ | OpenAI-совместимый контракт `/v1/chat/completions`, протоколы SSE, формат tool_calls, целостность и порядок следования чанков, изоляцию процессов.\n     8\tГРАНИЦА ВЛИЯНИЯ (гипотеза) | Модули стриминга и управления жизненным циклом сессий и процессов во всех мостах.\n     9\tКРИТЕРИЙ ПРИЁМКИ | 1) Ни один мост не обрывает живой стрим при наличии входящих токенов; 2) Скользящее окно тишины адаптивно сдвигается вперед (`now + idle_timeout_s`); 3) При бесконечном потоке срабатывает настраиваемый аварийный safety cap (`BRIDGE_SAFETY_CAP_S`); 4) 100% существующих тестов всех мостов зелёные.\n    10\tИСТОЧНИК ТРЕБОВАНИЯ | Запрос владельца: «потом запусти доработки контура по скилу панель аналитиков техлидов для доработки всех таких кейсов. чтобы были скользящие окна а не тупые лимиты. где что то шевелится, отправляется и тп.»\n    11\tNFR-ИСТОЧНИК | Hot-Path & HL-ENV: Data Plane SSE Streaming, RPS_peak=50, T_budget ≤1ms overhead, S_frame_max=32MB.\n    12\t\n    13\t## Зоны исследования шляп\n    14\t- **INV-01 (Белая шляпа):** Ревизия всех мест с `deadline`, `timeout`, `sleep`, `wait()` во всех мостах (`agy-bridge`, `opencode-zen-bridge`, `claude-p-bridge`, `muse-bridge`). Фиксация as-is поведения и замеры.\n    15\t- **INV-02 (Чёрная шляпа):** Риск-анализ: утечки сокетов, зависание зомби-процессов при медленном апстриме, дедлоки очередей, ложное продление по паразитным keepalive-комментариям, исчерпание пула семафоров.\n    16\t- **INV-03 (Зелёная шляпа):** Унифицированный контракт и архитектурные варианты системного решения (V1: адаптерный уровень, V2: унифицированное ядро `core/streaming_watchdog.py`).\n     1\t\"\"\"Регрессии безопасной настройки таймаута записи SSE.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport pytest\n     6\t\n     7\timport server\n     8\t\n     9\t\n    10\t@pytest.mark.parametrize(\"raw\", [None, \"\", \"   \"])\n    11\tdef test_live_write_timeout_default(\n    12\t    monkeypatch: pytest.MonkeyPatch, raw: str | None\n    13\t) -> None:\n    14\t    if raw is None:\n    15\t        monkeypatch.delenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raising=False)\n    16\t    else:\n    17\t        monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n    18\t    assert server.parse_live_write_timeout() == 30.0\n    19\t\n    20\t\n    21\t@pytest.mark.parametrize(\n    22\t    \"raw, expected\", [(\"45.5\", 45.5), (\" 45.5 \", 45.5), (\"1\", 1.0), (\"300\", 300.0)]\n    23\t)\n    24\tdef test_live_write_timeout_valid(\n    25\t    monkeypatch: pytest.MonkeyPatch, raw: str, expected: float\n    26\t) -> None:\n    27\t    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n    28\t    assert server.parse_live_write_timeout() == expected\n    29\t\n    30\t\n    31\t@pytest.mark.parametrize(\n    32\t    \"raw\", [\"0\", \"-1\", \"0.99\", \"300.01\", \"inf\", \"-inf\", \"nan\", \"invalid\"]\n    33\t)\n    34\tdef test_live_write_timeout_fallback(monkeypatch: pytest.MonkeyPatch, raw: str) -> None:\n    35\t    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n    36\t    assert server.parse_live_write_timeout() == 30.0\n    37\t    assert server.parse_live_write_timeout(12.0) == 12.0\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"В пакете обнаружено несоответствие проверки Zen: VER-004 запускает тесты Claude. Дополнительно сверяю, покрывает ли план исходную цель «все мосты» и не добавляет ли синхронный опрос процессов задержки в выдачу SSE.\n"}}
