   \"source\": \"клиент хаба :9882\",\n      \"stimulus\": \"настройка таймаута записи стрима через системную переменную BRIDGE_CLIENT_WRITE_TIMEOUT_S\",\n      \"environment\": \"рантайм server.py\",\n      \"artifact\": \"server.py\",\n      \"response\": \"parse_live_write_timeout успешно читает и валидирует BRIDGE_CLIENT_WRITE_TIMEOUT_S\",\n      \"response_measure\": \"таймаут применяется корректно\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    }\n  ],\n  \"boundaries\": [\n    {\n      \"id\": \"BND-001\",\n      \"component\": \"ClaudePBridgeWatchdog\",\n      \"responsibility\": \"Мониторинг активности CLI claude -p через AdaptiveTimeoutController и аварийное завершение группы процесса\",\n      \"allowed_dependencies\": [\n        \"core/watchdog.py\",\n        \"bridges/claude-p-bridge/server.py\"\n      ],\n      \"forbidden_dependencies\": [\n        \"vendor binary patches\",\n        \"hardcoded wall-clock kills\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    },\n    {\n      \"id\": \"BND-002\",\n      \"component\": \"DshEnvSecurityParser\",\n      \"responsibility\": \"Безопасное извлечение несекретных настроек таймаутов из ~/.dsh/.env без загрязнения os.environ\",\n      \"allowed_dependencies\": [\n        \"pathlib.Path\"\n      ],\n      \"forbidden_dependencies\": [\n        \"os.environ.update\",\n        \"reading sensitive keys\"\n      ],\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"BND-003\",\n      \"component\": \"OpenCodeZenBridgeConfig\",\n      \"responsibility\": \"Конфигурируемое чтение STALL_TIMEOUT_S через изолированный хелпер _zen_positive_float\",\n      \"allowed_dependencies\": [\n        \"bridges/opencode-zen-bridge/server.py\"\n      ],\n      \"forbidden_dependencies\": [\n        \"unisolated environment collisions\"\n      ],\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    },\n    {\n      \"id\": \"BND-004\",\n      \"component\": \"ServerLiveWriteFallback\",\n      \"responsibility\": \"Двухступенчатый каскадный парсинг таймаута записи стрима клиенту\",\n      \"allowed_dependencies\": [\n        \"server.py\"\n      ],\n      \"forbidden_dependencies\": [\n        \"vendor lock-in\"\n      ],\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    }\n  ],\n  \"contract_deltas\": [\n    {\n      \"id\": \"CD-001\",\n      \"type\": \"behavior\",\n      \"producer\": \"bridges/claude-p-bridge/server.py\",\n      \"consumer\": \"HTTP client\",\n      \"change\": \"Возврат 504 Gateway Timeout вместо вечного ожидания при зависании процесса claude -p\",\n      \"compatibility\": \"Обратно совместимо со спецификацией OpenAI API\",\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    },\n    {\n      \"id\": \"CD-002\",\n      \"type\": \"behavior\",\n      \"producer\": \"server.py\",\n      \"consumer\": \"HTTP client\",\n      \"change\": \"Поддержка переменной BRIDGE_CLIENT_WRITE_TIMEOUT_S с приоритетом над DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\",\n      \"compatibility\": \"Полная обратная совместимость с существующим поведением Droid\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"CD-003\",\n      \"type\": \"behavior\",\n      \"producer\": \"bridges/opencode-zen-bridge/server.py\",\n      \"consumer\": \"Zen bridge client\",\n      \"change\": \"Возможность настройки STALL_TIMEOUT_S через OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\",\n      \"compatibility\": \"Дефолт 60.0с сохранен\",\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    },\n    {\n      \"id\": \"CD-004\",\n      \"type\": \"data\",\n      \"producer\": \"~/.dsh/.env\",\n      \"consumer\": \"bridges/claude-p-bridge/server.py\",\n      \"change\": \"Чтение только разрешенных ключей таймаутов в локальный словарь _DSH_ENV\",\n      \"compatibility\": \"Не затрагивает другие приложения, использующие ~/.dsh/.env\",\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    }\n  ],\n  \"views\": [\n    {\n      \"id\": \"VIEW-001\",\n      \"type\": \"dynamic\",\n      \"question\": \"Как AdaptiveTimeoutController обеспечивает скользящее окно активности и защищает от stall?\",\n      \"artifact_ref\": \"analysis/all-bridges-sliding-activity-window/handoff-architect.md\"\n    }\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-001\",\n      \"scenario\": \"Ложное прерывание операции при нормальном выходе процесса claude -p\",\n      \"probability\": \"low\",\n      \"impact\": \"high\",\n      \"mitigation\": \"При reason == 'child_exited' цикл _execute не прерывается, а ожидает дочитывания очереди done\",\n      \"verification_ids\": [\n        \"VER-001\"\n      ]\n    },\n    {\n      \"id\": \"RISK-002\",\n      \"scenario\": \"Утечка API-токенов из ~/.dsh/.env в дочерние процессы\",\n      \"probability\": \"low\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Строгий whitelist _ALLOWED_SETTINGS_KEYS отсекает любые секреты, словарь хранится локально без мутации os.environ\",\n      \"verification_ids\": [\n        \"VER-002\"\n      ]\n    },\n    {\n      \"id\": \"RISK-003\",\n      \"scenario\": \"Падение существующих unit-тестов, использующих FakeRun без proc\",\n      \"probability\": \"low\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Безопасное получение proc и proc_pid через getattr(..., None)\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"RISK-004\",\n      \"scenario\": \"Загрязнение окружения pytest переменными из тестовых файлов\",\n      \"probability\": \"low\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Использование контекстного менеджера MonkeyPatch и изолированной фикстуры с временным fake HOME\",\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    }\n  ],\n  \"threat_model\": {\n    \"required\": false,\n    \"assets\": [],\n    \"trust_boundaries\": [],\n    \"threats\": []\n  },\n  \"evolution\": {\n    \"compatibility\": \"Полная обратная совместимость с OpenAI API, CLI-агентами и существующими тестовыми наборами\",\n    \"migration\": \"Не требуется; все параметры имеют безопасные значения по умолчанию\",\n    \"rollout\": \"Бесшовный перезапуск мостов через kickstart launchd службы\",\n    \"rollback\": \"Установка CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=0 полностью отключает контроллер вотчдога\"\n  },\n  \"verification_surface\": [\n    {\n      \"id\": \"VER-001\",\n      \"requirement_ids\": [\n        \"REQ-ALL-001\",\n        \"AD-001\",\n        \"QA-001\",\n        \"BND-001\",\n        \"CD-001\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -k test_watchdog_timeout_trigger -v\",\n      \"expected\": \"exit 0; timeout trigger verified\",\n      \"environment\": \"local python virtualenv\",\n      \"owner\": \"architect\"\n    },\n    {\n      \"id\": \"VER-002\",\n      \"requirement_ids\": [\n        \"REQ-ALL-004\",\n        \"AD-002\",\n        \"QA-002\",\n        \"BND-002\",\n        \"CD-004\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -k test_claude_p_env_loader_security -v\",\n      \"expected\": \"exit 0; security whitelist verified\",\n      \"environment\": \"local python virtualenv\",\n      \"owner\": \"architect\"\n    },\n    {\n      \"id\": \"VER-003\",\n      \"requirement_ids\": [\n        \"REQ-ALL-001\",\n        \"QA-003\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_bridge.py -v\",\n      \"expected\": \"exit 0; existing tests pass with FakeRun\",\n      \"environment\": \"local python virtualenv\",\n      \"owner\": \"architect\"\n    },\n    {\n      \"id\": \"VER-004\",\n      \"requirement_ids\": [\n        \"REQ-ALL-002\",\n        \"AD-003\",\n        \"QA-004\",\n        \"BND-003\",\n        \"CD-003\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"uv run pytest -o pythonpath=. tests/test_claude_p_watchdog.py -v\",\n      \"expected\": \"exit 0; full watchdog test suite passes\",\n      \"environment\": \"local python virtualenv\",\n      \"owner\": \"architect\"\n    },\n    {\n      \"id\": \"VER-005\",\n      \"requirement_ids\": [\n        \"REQ-ALL-003\",\n        \"AD-004\",\n        \"QA-005\",\n        \"BND-004\",\n        \"CD-002\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"uv run pytest -o pythonpath=. tests/test_stream_timeout_config.py -v\",\n      \"expected\": \"exit 0; fallback priority verified\",\n      \"environment\": \"local python virtualenv\",\n      \"owner\": \"architect\"\n    }\n  ],\n  \"protected_paths\": [],\n  \"materialization\": [],\n  \"approval\": {\n    \"status\": \"APPROVED\",\n    \"decision_ids\": []\n  },\n  \"independent_review\": {\n    \"required\": false,\n    \"status\": \"NOT_REQUIRED\"\n  },\n  \"open_questions\": [],\n  \"deferred\": []\n}        return model, {\"message\": f\"model not allowed: {model}\",\n                       \"type\": \"invalid_request_error\", \"code\": 400}\n    return model, None\n\n\ndef _kill_group(proc: subprocess.Popen) -> None:\n    \"\"\"SIGTERM процессной группе, затем SIGKILL, если не завершилась.\"\"\"\n    for sig in (signal.SIGTERM, signal.SIGKILL):\n        try:\n            os.killpg(proc.pid, sig)\n        except (ProcessLookupError, PermissionError):\n            return\n        try:\n            proc.wait(timeout=PROCESS_WAIT_S)\n            return\n        except subprocess.TimeoutExpired:\n            continue\n\n\ndef _kill_all(*_: Any) -> None:\n    with _active_lock:\n        procs = list(_active.values())\n        img_dirs = list(_active_img_dirs)\n    reaped = True\n    for proc in procs:\n        try:\n            os.killpg(proc.pid, signal.SIGKILL)\n        except (ProcessLookupError, PermissionError):\n            pass\n    for proc in procs:\n        try:\n            proc.wait(timeout=PROCESS_WAIT_S)\n        except subprocess.TimeoutExpired:\n            reaped = False\n    if reaped:\n        for img_dir in img_dirs:  # только свои сессионные каталоги картинок\n            _cleanup_img_dir(img_dir)\n    _log(f\"shutdown: killed {len(procs)} child process group(s)\")\n    os._exit(0)\n\n\nclass Run:\n    \"\"\"Один процесс `claude -p`; поток-читатель превращает stdout в события очереди.\"\"\"\n\n    def __init__(self, prompt: str, model: str, effort: str, tag: str,\n                 img_dir: Path | None = None):\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n        # С картинками Claude работает из сессионного каталога вложений: пути\n        # в секции [attachments] относительные, Read ограничен этим каталогом.\n        cmd = _build_claude_cmd(model, effort, img_dir)\n        self.cmd = cmd\n        self.img_dir = img_dir\n        _log(f\"exec model={model} effort={effort} prompt_bytes={len(prompt.encode())} {tag}\")\n        child_env = os.environ.copy()\n        child_env[\"HOME\"] = str(_prepare_claude_home())\n        child_env[\"BRIDGE_ZERO_CANON\"] = \"1\"\n        child_env.pop(\"CLAUDE_P_BRIDGE_KEY\", None)\n\n        self.proc = subprocess.Popen(\n            cmd, cwd=str(img_dir if img_dir is not None else WORKSPACE),\n            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n            start_new_session=True, env=child_env,\n        )\n        with _active_lock:\n            _active[self.proc.pid] = self.proc\n        self.q = queue.Queue(maxsize=QUEUE_MAXSIZE)\n        self._closed = threading.Event()\n        self.err_box = []\n        threading.Thread(target=self._feed, args=(prompt,), daemon=True).start()\n        threading.Thread(target=self._drain_stderr, daemon=True).start()\n        threading.Thread(target=self._pump, daemon=True).start()\n\n    def _feed(self, prompt: str) -> None:\n        \"\"\"Промпт уходит только через stdin.\"\"\"\n        try:\n            self.proc.stdin.write(prompt.encode(\"utf-8\"))\n            self.proc.stdin.close()\n        except (BrokenPipeError, OSError):\n            pass\n\n    def _drain_stderr(self) -> None:\n        remaining = MAX_STDERR_BYTES\n        retained = bytearray()\n        try:\n            while chunk := self.proc.stderr.read(IO_CHUNK_BYTES):\n                if remaining:\n                    retained.extend(chunk[:remaining])\n                    remaining = max(0, remaining - len(chunk))\n        except Exception:  # noqa: BLE001 - вторичный поток, ошибку терять нельзя молча\n            pass\n        finally:\n            self.err_box.append(retained.decode(\"utf-8\", \"replace\"))\n\n    def _enqueue(self, event: tuple) -> None:\n        \"\"\"Ограниченная очередь с прерыванием ожидания при закрытии хода.\"\"\"\n        while not self._closed.is_set():\n            try:\n                self.q.put(event, timeout=POLL_INTERVAL_S)\n                return\n            except queue.Full:\n                continue\n\n    def _pump(self) -> None:\n        \"\"\"Разбор stream-json: content_block_delta -> text/thinking, result -> итог.\"\"\"\n        try:\n            for raw in iter(self.proc.stdout.readline, b\"\"):\n                line = raw.decode(\"utf-8\", \"replace\").strip()\n                if not line.startswith(\"{\"):\n                    continue\n                try:\n                    ev = json.loads(line)\n                except ValueError:\n                    continue\n                etype = ev.get(\"type\")\n                if etype == \"stream_event\":\n                    inner = ev.get(\"event\") or {}\n                    if inner.get(\"type\") == \"content_block_delta\":\n                        delta = inner.get(\"delta\") or {}\n                        dtype = delta.get(\"type\")\n                        if dtype == \"text_delta\" and delta.get(\"text\"):\n                            self._enqueue((\"text\", delta[\"text\"]))\n                        elif dtype == \"thinking_delta\":\n                            thinking = extract_thinking_delta(delta)\n                            if thinking:\n                                self._enqueue((\"thinking\", thinking))\n                elif etype == \"result\":\n                    self._enqueue((\"result\", ev))\n            rc = self.proc.wait()\n        except Exception as exc:  # noqa: BLE001 - читатель не должен умирать молча\n            self._enqueue((\"pump_error\", repr(exc)))\n            return\n        time.sleep(STDERR_DRAIN_S)  # дать стоку stderr дозавершиться\n        self._enqueue((\"done\", rc))\n\n    def close(self) -> None:\n        self._closed.set()\n        if self.proc.poll() is None:\n            _kill_group(self.proc)\n        self.proc.wait(timeout=PROCESS_WAIT_S)\n        with _active_lock:\n            _active.pop(self.proc.pid, None)\n        for stream in (self.proc.stdin, self.proc.stdout, self.proc.stderr):\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n    def _execute(self, run: Run, on_text, on_reasoning, on_tool_call,\n                 keepalive, emulate_tools: bool, tools: list | None = None) -> dict:\n        \"\"\"Гнать ход до конца.\n\n        on_text/on_reasoning/on_tool_call/keepalive возвращают False, если клиент ушёл.\n        Весь текстовый поток ВСЕГДА проходит через `StreamNormalizer` поверх\n        `ToolCallParser(strict_live=True)` (AD-004, ALWAYS-ON — в том числе без\n        tools и при tool_choice=none): повреждённый `<tool_call>` поднимает\n        `LiveParserError`, сырой XML в content не уходит; распознанный вызов без\n        эмуляции — ошибка протокола, а не опубликованный инструмент. Reasoning\n        (нативный thinking и теги в тексте) публикуется до терминального события.\n        \"\"\"\n        pieces = []\n        reasoning_pieces: list = []\n        tool_calls: list = []\n        usage = {}\n        result_ev = {}\n        tool_schemas = build_tool_schemas(tools or [])\n        last_ka = time.monotonic()\n        gone = [False]\n\n        def state(name: str, rc: int, err: str = \"\") -> dict:\n            return {\"rc\": rc, \"text\": \"\".join(pieces), \"usage\": usage,\n                    \"reasoning\": \"\".join(reasoning_pieces),\n                    \"result\": result_ev, \"state\": name, \"err\": err,\n                    \"tool_calls\": tool_calls}\n\n        def add_content(text: str) -> None:\n            if gone[0] or not text:\n                return\n            pieces.append(text)\n            if not on_text(text):\n                gone[0] = True\n\n        def add_reasoning(text: str) -> None:\n            if gone[0] or not text:\n                return\n            reasoning_pieces.append(text)\n            if not on_reasoning(text):\n                gone[0] = True\n\n        def add_call(call: dict) -> None:\n            if gone[0]:\n                return\n            if not emulate_tools:\n                raise LiveParserError(\"tool_call published without tool emulation\")\n            entry = {\n                \"index\": len(tool_calls),\n                \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                \"type\": \"function\",\n                \"function\": {\n                    \"name\": call[\"name\"],\n                    \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False),\n                },\n            }\n            # Схемная санитизация — ровно один раз на владельце маршрута (AD-004).\n            for item in sanitize_tool_call(entry, tool_schemas):\n                item = dict(item, index=len(tool_calls))\n                tool_calls.append(item)\n                if not on_tool_call(item):\n                    gone[0] = True\n                    return\n\n        normalizer = StreamNormalizer(\n            add_content, add_reasoning, add_call, strict_live=True\n        )\n\n        controller = None\n        last_check_ts = time.monotonic()\n        proc = getattr(run, \"proc\", None)\n        proc_pid = getattr(proc, \"pid\", None) if proc is not None else None\n\n        if _is_watchdog_enabled() and AdaptiveTimeoutController is not None and proc_pid:\n            controller = AdaptiveTimeoutController(\n                idle_timeout_s=CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S,\n                safety_cap_s=CLAUDE_P_BRIDGE_SAFETY_CAP_S,\n                io_wait_cap_s=CLAUDE_P_BRIDGE_IO_WAIT_CAP_S,\n                watchdog_interval_s=CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S,\n            )\n            controller.register_pgid(proc_pid)\n\n        try:\n            while True:\n                if _client_gone(self.connection):\n                    return state(\"client_gone\", 1)\n\n                now = time.monotonic()\n                if controller is not None and proc is not None and proc_pid and (\n                    now - last_check_ts >= controller.watchdog_interval_s\n                ):\n                    last_check_ts = now\n                    should_stop, reason, _ = controller.check(proc_pid)\n                    if should_stop and reason in (\"idle_timeout\", \"absolute_cap\"):\n                        _kill_group(proc)\n                        return state(\"timeout\", 1, f\"claude-p watchdog: {reason}\")\n                    # Если reason == \"child_exited\" — нормальный выход потомка,\n                    # не убиваем, ждём done из очереди.\n\n                try:\n                    kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n                except queue.Empty:\n                    if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n                        last_ka = time.monotonic()\n                        if not keepalive():\n                            return state(\"client_gone\", 1)\n                    continue\n\n                if controller is not None and kind in (\"text\", \"thinking\", \"result\"):\n                    controller.record_activity(kind)\n\n                if kind == \"text\":\n                    normalizer.feed_text(str(payload))\n                    if gone[0]:\n                        return state(\"client_gone\", 1)\n                elif kind == \"thinking\":\n                    normalizer.feed_thinking(str(payload))\n                    if gone[0]:\n                        return state(\"client_gone\", 1)\n                elif kind == \"result\":\n                    result_ev = payload\n                    usage = payload.get(\"usage\") or {}\n                elif kind == \"pump_error\":\n                    return state(\"pump_error\", 1, str(payload))\n                elif kind == \"done\":\n                    # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n                    # сырой XML текстом не досбрасываем. Fallback на терминальный\n                    # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n                    normalizer.finish()\n                    if gone[0]:\n                        return state(\"client_gone\", 1)\n                    time.sleep(STDERR_DRAIN_S)\n                    return state(\"done\", payload, \"\".join(run.err_box))\n        finally:\n            if controller is not None:\n                controller.close()\n\n    def _run_once(self, req: dict, on_text, on_reasoning, on_tool_call, keepalive) -> dict:\n    ),\n}\n\n\ndef _normalize_tool_calls(\n    calls: list[dict[str, Any]], schemas: dict[str, Any]\n) -> list[dict[str, Any]]:\n    \"\"\"Применить общий санитизатор на единой границе всех маршрутов ответа.\"\"\"\n    if not BRIDGE_SANITIZE_TOOL_CALLS:\n        return calls\n    return sanitize_tool_calls_list(calls, schemas, **_SANITIZE_LIMITS)\n\n\nHOST = os.environ.get(\"OPENCODE_ZEN_BRIDGE_HOST\", \"127.0.0.1\").strip() or \"127.0.0.1\"\nPORT = _positive_int(os.environ.get(\"OPENCODE_ZEN_BRIDGE_PORT\"), 9883)\nAUTH_KEY = os.environ.get(\"OPENCODE_ZEN_BRIDGE_KEY\", \"\").strip()\n\nTIMEOUT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_TIMEOUT_S\", \"1800\"))\n\n\ndef _zen_positive_float(name: str, default: float) -> float:\n    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\n    try:\n        value = float(os.environ.get(name, str(default)))\n        return value if 0 < value < float(\"inf\") else default\n    except ValueError:\n        return default\n\n    def _execute(\n        self,\n        run: Run,\n        keepalive,\n        emulate_tools: bool,\n        sse_writer: \"StreamSink | None\" = None,\n    ) -> dict:\n        \"\"\"Гнать ход до конца; сквозной таймаут TIMEOUT_S на весь ход.\n\n        Без sse_writer вывод копится в out[\"events\"] и уходит клиенту отдельным этапом после\n        освобождения T/L (RW-009), как прежде. С sse_writer (живой SSE-ход, AD-001..AD-003)\n        content/reasoning_content уходят сюда же, по мере готовности text_delta/reasoning_delta\n        от Run — с коалесацией ~40мс (AD-003), чтобы не дробить кадры на один символ. Пока\n        дельта мессенджа копится, вперёд подсматривается один элемент очереди (pushback): смена\n        mid/вида завершает текущую группу, а fail-close вид (stream_error/pump_error/\n        live_invalidated) или уже выставленный run.live_invalidated — отбрасывает НЕотданный\n        буфер целиком и завершает ход ошибкой (ничего незакоммиченного клиенту не покажется).\n        Размышления идут мимо ToolCallParser. При emulate_tools текстовый поток проходит через\n        ToolCallParser (в живом ходе — в strict_live режиме: сырой `<tool_call>` не утечёт).\n        Превышение deadline -> kill группы (в run.close()), state=timeout.\n        \"\"\"\n        pieces = []\n        events: list = []\n        tool_calls: list = []\n        usage = {}\n        result_ev = {}\n        last_ka = time.monotonic()\n        deadline = time.monotonic() + min(TIMEOUT_S, SAFETY_CAP_S)\n        cur_mid = [\n            None\n        ]  # mid последнего content-куска в pieces (разделитель \"\\n\\n\" между сообщениями)\n        pushback = None  # элемент очереди, подсмотренный при коалесации, но не обработанный сейчас\n        managed_turn = getattr(self, \"_active_managed_turn\", None)\n        detach_on_disconnect = bool(getattr(self, \"_detach_on_disconnect\", False))\n        watchdog_enabled = os.environ.get(\n            \"BRIDGE_ADAPTIVE_WATCHDOG_ENABLED\", \"true\"\n        ).strip().lower() in (\"1\", \"true\", \"yes\", \"on\")\n        proc_watchdog = ProcessWatchdog(log_fn=_log) if watchdog_enabled else None\n        io_policy = AdaptiveTimeoutController(watchdog_enabled=False)\n        watchdog_seeded_pid = [0]\n        watchdog_metrics: WatchdogMetrics | None = None\n        next_watchdog_sample = 0.0\n\n\n        def take():\n            nonlocal pushback\n            if pushback is not None:\n                item, pushback = pushback, None\n                return item\n            return run.q.get(timeout=1.0)\n\n        while True:\n            rproc = getattr(run, \"proc\", None)\n            if (\n                rproc is not None\n                and getattr(rproc, \"pid\", 0)\n                and watchdog_seeded_pid[0] != rproc.pid\n            ):\n                watchdog_seeded_pid[0] = rproc.pid\n                watchdog_metrics = None\n                next_watchdog_sample = 0.0\n                if proc_watchdog is not None:\n                    proc_watchdog.seed(rproc.pid)\n                if managed_turn is not None:\n                    managed_turn.bind_process(pgid=rproc.pid, terminate_fn=run.close)\n            if managed_turn is not None and managed_turn.cancel_event.is_set():\n                run.cancel.set()\n                return state(\"client_gone\", 1, \"turn cancelled\")\n            if time.monotonic() > deadline:\n                return state(\"timeout\", 124, f\"proxy timeout after {TIMEOUT_S}s\")\n            if (\n                not run.got_event\n                and time.monotonic() - run.started > FIRST_TOKEN_TIMEOUT_S\n            ):\n                return state(\n                    \"first_token_timeout\",\n                    124,\n                    f\"no droid event within {FIRST_TOKEN_TIMEOUT_S:g}s\",\n                )\n            if (\n                run.got_event\n                and run.last_progress\n                and time.monotonic() - run.last_progress > SILENCE_WATCHDOG_S\n            ):\n                sampled_now = False\n                if (\n                    proc_watchdog is not None\n                    and rproc is not None\n                    and getattr(rproc, \"pid\", 0)\n                    and (\n                        watchdog_metrics is None\n            )\n            return None\n        return instr\n\n    def _dispatch(\n        self, ctx: dict, keepalive, sse_writer: \"StreamSink | None\" = None\n    ) -> dict:\n        \"\"\"Ход через адаптер бэкенда модели; общий разбор `<tool_call>` и итог в формате фасада.\n\n        sse_writer не None только у настоящего живого SSE-хода (_serve_sse): адаптеры, умеющие\n        отдавать content/reasoning по мере готовности (сейчас — droid), сами вызывают его из\n        своего пути выполнения. Остальные (muse) его просто игнорируют — поведение не меняется.\n        \"\"\"\n        managed_turn: ManagedTurn | None = ctx.get(\"managed_turn\") or getattr(\n            self, \"_active_managed_turn\", None\n        )\n        if ctx.get(\"attached_existing\") and managed_turn is not None:\n            managed_turn.done_event.wait(timeout=TIMEOUT_S)\n            if managed_turn.final_dict is not None:\n                return dict(managed_turn.final_dict)\n        adapter = BACKENDS.get(ctx[\"backend\"])\n        if adapter is None:\n            return {\n                \"state\": \"launcher_unavailable\",\n                \"rc\": 1,\n                \"text\": \"\",\n                \"usage\": {},\n                \"result\": {},\n                \"err\": \"\",\n                \"tool_calls\": [],\n                \"events\": [],\n            }\n        transcript = ctx[\"rpc\"]\n        turn = TurnContext(\n            **{\n                key: value\n                for key, value in ctx.items()\n                if key\n                not in (\n                    \"rpc\",\n                    \"request_id\",\n            raw_autonomy = req.get(\"autonomy\")\n            if raw_autonomy is None:\n                autonomy = AUTONOMY_DEFAULT\n                autonomy_source = \"default\"\n            elif isinstance(raw_autonomy, str):\n                candidate = raw_autonomy.strip()\n                if not candidate:\n                    autonomy = AUTONOMY_DEFAULT\n                    autonomy_source = \"default\"\n                elif candidate in AUTONOMY_LEVELS or candidate == AUTONOMY_OFF:\n                    autonomy = candidate\n                    autonomy_source = \"request\"\n                else:\n                    self._reject(\n                        400,\n                        \"unsupported_autonomy\",\n                        \"autonomy is not allowed (low|medium|high|off)\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n            else:\n                self._reject(\n                    400,\n                    \"unsupported_autonomy\",\n                    \"autonomy must be a string\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (10) reasoning-объект не поддерживаем.\n            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n                self._reject(\n                    400,\n                    \"unsupported_parameter\",\n                    \"reasoning parameter is not supported\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (10a) отказоустойчивость контекста: история вмещается в окно модели до всего прочего.\n            gated = self._context_gate(req, model_id, model, model_len)\n            if gated is None:\n                return\n            req, self._context_pruned = gated\n            # (11) изображения (C-08…C-11).\n            try:\n                images = _collect_images(req, model, effort)\n            except ImageReject as exc:\n                self._reject(\n                    400,\n                    exc.reason,\n                    f\"image rejected: {exc.reason}\",\n                    model_id,\n                    model_len,\n                )\n                return\n            # (12) бэкенд модели: допуск/лончер проверяются до SSE и до любого запуска.\n            adapter = BACKENDS.get(model[\"backend\"])\n            ok, why = (\n                (False, \"backend_disabled\") if adapter is None else adapter.preflight()\n            )\n            if not ok:\n                self._reject(\n                    503,\n                    \"launcher_unavailable\",\n                    \"canonical launcher is missing or not executable\"\n                    if why == \"launcher_unavailable\"\n                    else f\"backend {model['backend']} is unavailable: {why}\",\n                    model_id,\n                    model_len,\n                )\n                return\n            raw_messages = req.get(\"messages\")\n            messages = raw_messages if isinstance(raw_messages, list) else []\n            raw_tools = req.get(\"tools\")\n            tools = (\n                [t for t in raw_tools if isinstance(t, dict)]\n                if isinstance(raw_tools, list)\n                else []\n            )\n            tool_choice = req.get(\"tool_choice\")\n            emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n            prompt = _messages_to_prompt(messages, tools, tool_choice, images)\n            extra = (\n                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            )\n            cwd = str(extra.get(\"cwd\") or \"\")\n            fwd_env = self._forwarded_env(extra, model_id, model_len)\n            if fwd_env is False:\n                return\n            req_turn_id = (\n                self.headers.get(\"X-Turn-Id\") or str(extra.get(\"turn_id\") or \"\")\n            ).strip()\n            resume_turn_id = (\n                self.headers.get(\"X-Resume-Turn-Id\")\n                or str(extra.get(\"resume_turn_id\") or \"\")\n            ).strip()\n            for candidate_tid in (req_turn_id, resume_turn_id):\n                if candidate_tid and not validate_turn_id(candidate_tid):\n                    self._reject(\n                        400,\n                        \"invalid_request\",\n                        \"invalid turn_id\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n            # Маршрут хода: нового 400 на ключ нет — плохой/отсутствующий ключ = холодная\n            # изолированная сессия с replay истории запроса.\n            transcript = _transcribe(messages, tools, tool_choice, images)\n            raw_key = req.get(\"prompt_cache_key\")\n            keyed = isinstance(raw_key, str) and 0 < len(raw_key) <= KEY_MAX_LEN\n            if images:\n                route = \"image\"\n            elif _is_title_request(messages, tools, req):\n                route = \"title\"\n            elif not transcript[\"runnable\"]:\n                route = \"fallback\"\n                transcript = {\n                    \"system\": None,\n                    \"runnable\": True,\n                    \"items\": [\n                        {\"role\": \"user\", \"text\": prompt, \"digest\": _digest(prompt)}\n                    ],\n                }\n            elif keyed:\n                route = \"keyed\"\n            else:\n                route = \"nokey\"\n            instr = self._prompt_guard(\n                messages, route, raw_key, cwd, model_id, model_len, adapter\n            )\n            if instr is None:\n                return\n            is_legacy_muse_sleep = (\n                model[\"backend\"] == \"muse\"\n                and not req_turn_id\n                and not resume_turn_id\n                and not keyed\n                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\").is_file()\n                and (Path(getattr(adapter, \"wrapper\", \"\")).parent / \"mode\")\n                .read_text(encoding=\"utf-8\", errors=\"ignore\")\n                .strip()\n                == \"sleep\"\n            )\n            detach_on_disconnect = (\n                _is_detached_enabled()\n                and (\n                    _client_gone is _DEFAULT_CLIENT_GONE\n                    or bool(req_turn_id or resume_turn_id)\n                )\n                and not is_legacy_muse_sleep\n            )\n            managed_turn: ManagedTurn | None = None\n            attached_existing = False\n            if _is_detached_enabled():\n                try:\n                    managed_turn, attached_existing = (\n                        TURN_MANAGER.create_or_attach_turn(\n                            model=model_id,\n                            backend=model[\"backend\"],\n                            cwd=cwd,\n                            messages=messages,\n                            session_id=raw_key if keyed else \"\",\n                            owner_token_hash=_owner_token_hash(self),\n                            requested_turn_id=req_turn_id or None,\n                            resume_turn_id=resume_turn_id or None,\n                            stream=bool(req.get(\"stream\")),\n                            emulate_tools=emulate_tools,\n                            idle_timeout_s=(\n                                SILENCE_WATCHDOG_S\n                                if _is_watchdog_enabled()\n                                else TIMEOUT_S\n                            ),\n                            safety_cap_s=min(TIMEOUT_S, SAFETY_CAP_S),\n                        )\n                    )\n                except PermissionError:\n                    self._reject(\n                        403,\n                        \"forbidden\",\n                        \"turn belongs to another token\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n                except ValueError as exc:\n                    self._reject(400, \"invalid_request\", str(exc), model_id, model_len)\n                    return\n            self._active_managed_turn = managed_turn\n            ctx = {\n                \"request_id\": self._trace.request_id if self._trace else None,\n                \"subagent_id\": self._trace.subagent_id if self._trace else None,\n                \"route\": route,\n                \"key_hash\": _key_hash(raw_key)\n","exit_code":0,"status":"completed"}}
