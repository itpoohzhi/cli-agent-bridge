rn state(\"timeout\", 1, f\"claude-p watchdog: {reason}\")\n   718\t                    # Если reason == \"child_exited\" — нормальный выход потомка,\n   719\t                    # не убиваем, ждём done из очереди.\n   720\t\n   721\t                try:\n   722\t                    kind, payload = run.q.get(timeout=POLL_INTERVAL_S)\n   723\t                except queue.Empty:\n   724\t                    if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n   725\t                        last_ka = time.monotonic()\n   726\t                        if not keepalive():\n   727\t                            return state(\"client_gone\", 1)\n   728\t                    continue\n   729\t\n   730\t                if controller is not None and kind in (\"text\", \"thinking\", \"result\"):\n   731\t                    controller.record_activity(kind)\n   732\t\n   733\t                if kind == \"text\":\n   734\t                    normalizer.feed_text(str(payload))\n   735\t                    if gone[0]:\n   736\t                        return state(\"client_gone\", 1)\n   737\t                elif kind == \"thinking\":\n   738\t                    normalizer.feed_thinking(str(payload))\n   739\t                    if gone[0]:\n   740\t                        return state(\"client_gone\", 1)\n   741\t                elif kind == \"result\":\n   742\t                    result_ev = payload\n   743\t                    usage = payload.get(\"usage\") or {}\n   744\t                elif kind == \"pump_error\":\n   745\t                    return state(\"pump_error\", 1, str(payload))\n   746\t                elif kind == \"done\":\n   747\t                    # Fail-closed финал: незакрытый/битый хвост — LiveParserError наверх,\n   748\t                    # сырой XML текстом не досбрасываем. Fallback на терминальный\n   749\t                    # `result` исключён (AD-004): пустой ход — ошибка 502 в _error_body.\n   750\t                    normalizer.f