tempts_t0(attempts, model, prompt),\n                     is_client_gone=self._client_gone_check,\n                     on_status=lambda _t: None,\n                     thinking_enabled=thinking,\n@@ -9284,7 +9436,7 @@ class Handler(BaseHTTPRequestHandler):\n             return\n         attempts = _RequestAttempts(\n             res,\n-            time.monotonic() + _zen_execution_timeout(model, prompt),\n+            time.monotonic() + _zen_total_timeout(model, prompt),\n             use_breaker=not _is_google_direct_model(model),\n         )\n         xs[\"attempts\"] = attempts\ndiff --git a/server.py b/server.py\nindex feda0ba..6d4eb41 100644\n--- a/server.py\n+++ b/server.py\n@@ -392,17 +392,18 @@ SAFETY_CAP_S = positive_env(\n # socket-таймаута соединения) — зависший/нечитающий клиент не держит T/L (см. sse_writer в\n # _serve_sse и add_content/add_reasoning в Handler._execute).\n def parse_live_write_timeout(default: float = 30.0) -> float:\n-    \"\"\"Читает таймаут записи, возвращая default при неверном значении ENV.\"\"\"\n-    raw = os.environ.get(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"\").strip()\n-    if not raw:\n-        return default\n-    try:\n-        val = float(raw)\n-        if not (1.0 <= val <= 300.0):\n-            return default\n-        return val\n-    except (ValueError, TypeError):\n-        return default\n+    \"\"\"Читает таймаут записи, поддерживая BRIDGE_CLIENT_WRITE_TIMEOUT_S с fallback на DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S.\"\"\"\n+    for key in (\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", \"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\"):\n+        raw = os.environ.get(key, \"\").strip()\n+        if not raw:\n+            continue\n+        try:\n+            val = float(raw)\n+            if 1.0 <= val <= 300.0:\n+                return val\n+        except (ValueError, TypeError):\n+            continue\n+    return default\n \n \n LIVE_WRITE_TIMEOUT_S: float = parse_live_write_timeout(30.0)\ndiff --git a/tests/test_stream_timeout_config.py b/tests/test_stream_timeout_config.py\nindex d8bcc18..00b350a 100644\n--- a/tests/test_stream_timeout_config.py\n+++ b/tests/test_stream_timeout_config.py\n@@ -11,6 +11,7 @@ import server\n def test_live_write_timeout_default(\n     monkeypatch: pytest.MonkeyPatch, raw: str | None\n ) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     if raw is None:\n         monkeypatch.delenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raising=False)\n     else:\n@@ -24,6 +25,7 @@ def test_live_write_timeout_default(\n def test_live_write_timeout_valid(\n     monkeypatch: pytest.MonkeyPatch, raw: str, expected: float\n ) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n     assert server.parse_live_write_timeout() == expected\n \n@@ -32,6 +34,27 @@ def test_live_write_timeout_valid(\n     \"raw\", [\"0\", \"-1\", \"0.99\", \"300.01\", \"inf\", \"-inf\", \"nan\", \"invalid\"]\n )\n def test_live_write_timeout_fallback(monkeypatch: pytest.MonkeyPatch, raw: str) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n     assert server.parse_live_write_timeout() == 30.0\n     assert server.parse_live_write_timeout(12.0) == 12.0\n+\n+\n+def test_live_write_timeout_priority(monkeypatch: pytest.MonkeyPatch) -> None:\n+    \"\"\"BRIDGE_CLIENT_WRITE_TIMEOUT_S приоритетнее legacy DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S.\"\"\"\n+    # Валидный общий ключ побеждает legacy.\n+    monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", \"45\")\n+    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"60\")\n+    assert server.parse_live_write_timeout() == 45.0\n+\n+    # Невалидный общий ключ -> валидный legacy.\n+    for bad in (\"invalid\", \"0\", \"500\", \"nan\"):\n+        monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", bad)\n+        monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"60\")\n+        assert server.parse_live_write_timeout() == 60.0\n+\n+    # Оба невалидны -> default.\n+    monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", \"invalid\")\n+    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"-1\")\n+    assert server.parse_live_write_timeout() == 30.0\n+    assert server.parse_live_write_timeout(12.0) == 12.0\n.ai-team/runs/all-bridges-sliding-window-20261102/code-panel/panel/council/r1/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/architecture/architecture-packet.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r2/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r4/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r1/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r3/manifest.json\n\"\"\"Скользящее окно активности claude-p-bridge (AD-001..AD-004).\n\nПокрытие: whitelist-чтение ~/.dsh/.env без мутации os.environ, срабатывание\nвотчдога (`idle_timeout`/`absolute_cap` -> kill + 504), отсутствие ложного\nтаймаута на `child_exited`, троттлинг `check()` по `watchdog_interval_s`,\nсброс таймера простоя на полезных событиях и закрытие контроллера в finally.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport os\nimport queue\nimport sys\nimport uuid\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any\n\nimport pytest\n\nREPO = Path(__file__).resolve().parent.parent\nBRIDGE_SERVER = REPO / \"bridges\" / \"claude-p-bridge\" / \"server.py\"\n_ENV_PREFIXES = (\"CLAUDE_P_BRIDGE_\", \"BRIDGE_\")\n\n\n@pytest.fixture(scope=\"module\")\ndef isolated_claude_bridge(tmp_path_factory: pytest.TempPathFactory):\n    \"\"\"Загружает мост с изолированным HOME и без внешних CLAUDE_P_BRIDGE_*/BRIDGE_* env.\"\"\"\n    home = tmp_path_factory.mktemp(\"claude-p-home\")\n    name = f\"claude_p_bridge_watchdog_{uuid.uuid4().hex}\"\n    with pytest.MonkeyPatch.context() as mp:\n        mp.setenv(\"HOME\", str(home))\n        for key in list(os.environ):\n            if key.startswith(_ENV_PREFIXES):\n                mp.delenv(key, raising=False)\n        spec = importlib.util.spec_from_file_location(name, BRIDGE_SERVER)\n        assert spec is not None and spec.loader is not None\n        mod = importlib.util.module_from_spec(spec)\n        sys.modules[name] = mod\n        try:\n            spec.loader.exec_module(mod)\n            yield SimpleNamespace(mod=mod, home=home)\n        finally:\n            sys.modules.pop(name, None)\n\n\nclass FakeController:\n    \"\"\"Фейковый AdaptiveTimeoutController: скриптованный check() и журнал вызовов.\"\"\"\n\n    instances: list = []\n    verdict: tuple = (False, \"\", None)\n\n    def __init__(self, idle_timeout_s, safety_cap_s, io_wait_cap_s, watchdog_interval_s):\n        self.idle_timeout_s = idle_timeout_s\n        self.safety_cap_s = safety_cap_s\n        self.io_wait_cap_s = io_wait_cap_s\n        self.watchdog_interval_s = watchdog_interval_s\n        self.registered: list = []\n        self.checks: list = []\n        self.activity: list = []\n        self.closed = False\n        type(self).instances.append(self)\n\n    def register_pgid(self, pgid: int) -> None:\n        self.registered.append(pgid)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.checks.append(pgid)\n        return type(self).verdict\n\n    def record_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n\n    def close(self) -> None:\n        self.closed = True\n\n\nclass FakeClock:\n    def __init__(self) -> None:\n        self.t = 0.0\n\n    def monotonic(self) -> float:\n        return self.t\n\n    def sleep(self, _s: float) -> None:\n        return None\n\n\nclass ScriptedQueue:\n    \"\"\"Очередь хода: каждый get() сдвигает фейковые часы на `step` секунд.\"\"\"\n\n    def __init__(self, items: list, clock: FakeClock | None = None, step: float = 0.0,\n                 error: Exception | None = None) -> None:\n        self.items = list(items)\n        self.clock = clock\n        self.step = step\n        self.error = error\n\n    def get(self, timeout: float | None = None) -> Any:\n        if self.clock is not None:\n            self.clock.t += self.step\n        if self.error is not None:\n            raise self.error\n        if not self.items:\n            raise queue.Empty\n        return self.items.pop(0)\n\n\ndef _make_run(items: list, **kw: Any) -> SimpleNamespace:\n    return SimpleNamespace(\n        q=ScriptedQueue(items, **kw), err_box=[], proc=SimpleNamespace(pid=424242)\n    )\n\n\n@pytest.fixture()\ndef bridge(isolated_claude_bridge, monkeypatch: pytest.MonkeyPatch):\n    mod = isolated_claude_bridge.mod\n    FakeController.instances = []\n    FakeController.verdict = (False, \"\", None)\n    killed: list = []\n    monkeypatch.setattr(mod, \"AdaptiveTimeoutController\", FakeController)\n    monkeypatch.setattr(mod, \"_kill_group\", lambda proc: killed.append(proc))\n    monkeypatch.setattr(mod, \"_client_gone\", lambda _sock: False)\n    monkeypatch.setattr(mod, \"_is_watchdog_enabled\", lambda: True)\n    monkeypatch.setattr(mod, \"POLL_INTERVAL_S\", 0.0)\n    monkeypatch.setattr(mod, \"STDERR_DRAIN_S\", 0.0)\n    return SimpleNamespace(mod=mod, killed=killed)\n\n\ndef _execute(mod: Any, run: Any) -> dict:\n    handler = mod.Handler.__new__(mod.Handler)\n    handler.connection = None\n    sink = lambda *_a: True  # noqa: E731\n    return handler._execute(run, sink, sink, sink, None, False, None)\n\n\ndef test_claude_p_env_loader_security(isolated_claude_bridge) -> None:\n    mod = isolated_claude_bridge.mod\n    env_dir = isolated_claude_bridge.home / \".dsh\"\n    env_dir.mkdir(exist_ok=True)\n    env_file = env_dir / \".env\"\n    env_file.write_text(\n        \"\\n\".join([\n            \"# comment\",\n            \"\",\n            \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=111\",\n            \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=222\",\n            \"export BRIDGE_SAFETY_CAP_S='1800'\",\n            'CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=\"0\"',\n            \"CLAUDE_P_BRIDGE_KEY=super-secret\",\n            \"OPENAI_API_KEY=sk-should-not-leak\",\n            \"NOT_A_PAIR\",\n        ]) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n    before = dict(os.environ)\n    try:\n        got = mod._read_dsh_env_file()\n    finally:\n        env_file.unlink()\n    assert dict(os.environ) == before  # os.environ не мутирован\n    assert got == {\n        \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\": \"222\",  # дубликат — последнее значение\n        \"BRIDGE_SAFETY_CAP_S\": \"1800\",\n        \"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\": \"0\",\n    }\n    assert not any(k.endswith(\"_KEY\") for k in got)\n    assert \"super-secret\" not in got.values()\n    # Без файла — пустой словарь.\n    assert mod._read_dsh_env_file() == {}\n\n\n@pytest.mark.parametrize(\"reason\", [\"idle_timeout\", \"absolute_cap\"])\ndef test_watchdog_timeout_trigger(bridge, monkeypatch: pytest.MonkeyPatch, reason: str) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 0.0)\n    FakeController.verdict = (True, reason, None)\n    run = _make_run([(\"text\", \"partial\"), (\"done\", 0)])\n    out = _execute(mod, run)\n    assert bridge.killed == [run.proc]\n    assert out[\"state\"] == \"timeout\"\n    assert out[\"rc\"] == 1\n    assert reason in out[\"err\"]\n    err = mod.Handler._error_body(out)\n    assert err[\"code\"] == 504\n    assert err[\"type\"] == \"upstream_timeout\"\n    assert reason in err[\"message\"]\n    (ctl,) = FakeController.instances\n    assert ctl.registered == [run.proc.pid]\n    assert ctl.closed\n\n\ndef test_child_exited_no_false_timeout(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 0.0)\n    FakeController.verdict = (True, \"child_exited\", None)\n    run = _make_run([\n        (\"text\", \"hello\"),\n        (\"result\", {\"usage\": {\"output_tokens\": 1}}),\n        (\"done\", 0),\n    ])\n    out = _execute(mod, run)\n    assert bridge.killed == []\n    assert out[\"state\"] == \"done\"\n    assert out[\"rc\"] == 0\n    assert out[\"text\"] == \"hello\"\n    (ctl,) = FakeController.instances\n    assert len(ctl.checks) >= 1  # вердикт child_exited получен, но ход не прерван\n\n\ndef test_watchdog_throttle(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    clock = FakeClock()\n    monkeypatch.setattr(mod, \"time\", clock)\n    interval = 3.0\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", interval)\n    check_ts: list = []\n    orig_check = FakeController.check\n\n    def timed_check(self, pgid=None):\n        check_ts.append(clock.t)\n        return orig_check(self, pgid)\n\n    monkeypatch.setattr(FakeController, \"check\", timed_check)\n    items = [(\"text\", f\"t{i} \") for i in range(10)] + [(\"done\", 0)]\n    run = _make_run(items, clock=clock, step=1.0)\n    out = _execute(mod, run)\n    assert out[\"state\"] == \"done\"\n    # 11 итераций по 1 с: проверки только на t=3, 6, 9.\n    assert check_ts == [3.0, 6.0, 9.0]\n    assert all(b - a >= interval for a, b in zip(check_ts, check_ts[1:]))\n    assert len(check_ts) <= clock.t / interval\n\n\ndef test_record_activity_calls(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 1e9)\n    run = _make_run([\n        (\"text\", \"a\"),\n        (\"thinking\", \"b\"),\n        (\"result\", {\"usage\": {}}),\n        (\"done\", 0),\n    ])\n    out = _execute(mod, run)\n    assert out[\"state\"] == \"done\"\n    (ctl,) = FakeController.instances\n    assert ctl.activity == [\"text\", \"thinking\", \"result\"]\n    assert ctl.checks == []\n\n\ndef test_controller_closed_in_finally(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 1e9)\n\n    # Штатный выход.\n    out = _execute(mod, _make_run([(\"text\", \"ok\"), (\"done\", 0)]))\n    assert out[\"state\"] == \"done\"\n    # Аварийный выход по pump_error.\n    out = _execute(mod, _make_run([(\"pump_error\", \"boom\")]))\n    assert out[\"state\"] == \"pump_error\"\n    # Исключение внутри цикла.\n    with pytest.raises(RuntimeError, match=\"queue broken\"):\n        _execute(mod, _make_run([], error=RuntimeError(\"queue broken\")))\n\n    assert len(FakeController.instances) == 3\n    assert all(ctl.closed for ctl in FakeController.instances)\n\"\"\"Адаптивный таймер неактивности и мониторинг дерева процессов (ADR-0005 / AD-002).\n\nМодуль реализует двухконтурный контроль времени хода исключительно средствами\nстандартной библиотеки Python на macOS (Darwin):\n1. Контур активности (`IDLE_TIMEOUT_S = 300.0` с): таймер неактивности сбрасывается\n   только при наличии реального прогресса — протокольных событий от CLI (`on_activity`),\n   положительного прироста процессорного времени (`cputime` delta > 0) в группе `pgid`,\n   или появления новых дочерних PID (`new_descendants`). Спящий дочерний процесс\n   без прироста CPU и без новых потомков таймер не сбрасывает (RW-005).\n2. Предохранительный потолок (`SAFETY_CAP_S = 3600.0` с, `FINISH_RESERVE_S = 35.0` с):\n   абсолютный потолок длительности хода независимо от активности.\n\nПри деградации/таймауте вызова `ps` применяется политика fail-closed: событие\nфиксируется в логе (`watchdog_ps_degraded`), а `last_activity_ts` не обновляется.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nimport math\nimport os\nimport re\nimport subprocess\nimport threading\nimport time\n\nIDLE_TIMEOUT_S: float = 300.0\nSAFETY_CAP_S: float = 3600.0\nFINISH_RESERVE_S: float = 35.0\nWATCHDOG_INTERVAL_S: float = 5.0\nPS_TIMEOUT_S: float = 2.0\n\nDEFAULT_IDLE_TIMEOUT_S: float = IDLE_TIMEOUT_S\nDEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\nDEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\n\n\ndef positive_env(name: str, default: float) -> float:\n    \"\"\"Читает конечное положительное число, сохраняя безопасный fallback.\"\"\"\n    try:\n        value = float(os.environ.get(name, str(default)))\n    except (TypeError, ValueError, OverflowError):\n        return default\n    return value if math.isfinite(value) and value > 0 else default\n\n\ndef io_grace_enabled() -> bool:\n    \"\"\"Читает явный булев переключатель; некорректное значение даёт дефолт true.\"\"\"\n    value = os.environ.get(\"BRIDGE_IO_GRACE_ENABLED\", \"true\").strip().lower()\n    if value in (\"0\", \"false\", \"no\", \"off\"):\n        return False\n    return True\n\n\n_PS_LINE_RE = re.compile(\n    r\"^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+)\\s+(\\S+)\\s*(.*)$\"\n)\n\n\ndef parse_cputime(raw: str) -> float:\n    \"\"\"Разбирает поле `cputime` вывода `ps` (`[[dd-]hh:]mm:ss[.xx]`) в секунды.\"\"\"\n    token = (raw or \"\").strip()\n    if not token:\n        return 0.0\n    days = 0\n    if \"-\" in token:\n        day_part, token = token.split(\"-\", 1)\n        try:\n            days = int(day_part)\n        except ValueError:\n            return 0.0\n    parts = token.split(\":\")\n    try:\n        if len(parts) == 3:\n            hours = int(parts[0])\n            minutes = int(parts[1])\n            seconds = float(parts[2])\n        elif len(parts) == 2:\n            hours = 0\n            minutes = int(parts[0])\n            seconds = float(parts[1])\n        elif len(parts) == 1:\n            hours = 0\n            minutes = 0\n            seconds = float(parts[0])\n        else:\n            return 0.0\n    except ValueError:\n        return 0.0\n    total = ((days * 24 + hours) * 60 + minutes) * 60 + seconds\n    return max(0.0, float(total))\n\n\n@dataclass(frozen=True)\nclass WatchdogMetrics:\n    \"\"\"Снимок состояния процессной группы `pgid` на одном тике `ProcessWatchdog`.\"\"\"\n\n    pgid: int\n    alive: bool\n    descendant_pids: tuple[int, ...]\n    new_descendants: tuple[int, ...]\n    cpu_time_s: float\n    cpu_delta_s: float\n    ps_degraded: bool = False\n    sample_ts: float = 0.0\n    states: list[str] = field(default_factory=list)\n\n    def is_waiting_io(self) -> bool:\n        \"\"\"Живая группа ожидает I/O; учитывается первая буква stat без флагов ps.\"\"\"\n        return (\n            self.alive\n            and not self.ps_degraded\n            and any(state[:1].upper() in {\"S\", \"D\", \"I\", \"U\"} for state in self.states)\n        )\n\n    @property\n    def has_progress(self) -> bool:\n        \"\"\"Есть ли подтверждённый прогресс (новые потомки или прирост CPU > 0).\"\"\"\n        if self.ps_degraded or not self.alive:\n            return False\n        return bool(self.new_descendants) or self.cpu_delta_s > 0.0\n\n    has_activity = has_progress\n\n\nclass ProcessWatchdog:\n    \"\"\"Мониторинг процессной группы `pgid` на macOS/POSIX через `os.killpg` и `ps`.\"\"\"\n\n    def __init__(\n        self,\n        ps_timeout_s: float = PS_TIMEOUT_S,\n        log_fn: Callable[[str], None] | None = None,\n        rid: str = \"\",\n        turn_id: str = \"\",\n    ) -> None:\n        self.ps_timeout_s = float(ps_timeout_s)\n        self._log_fn = log_fn\n        self.rid = rid\n        self.turn_id = turn_id\n        self._lock = threading.Lock()\n        self._prev_cpu_by_pgid: dict[int, dict[int, float]] = {}\n        self._seen_descendants_by_pgid: dict[int, set[int]] = {}\n        self._seeded_pgids: set[int] = set()\n\n    def _log(self, msg: str) -> None:\n        if self._log_fn is not None:\n            try:\n                self._log_fn(msg)\n            except Exception:  # noqa: BLE001\n                pass\n\n    @staticmethod\n    def is_group_alive(pgid: int) -> bool:\n        \"\"\"Проверяет живость процессной группы `os.killpg(pgid, 0)`.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return False\n        try:\n            os.killpg(pgid, 0)\n        except ProcessLookupError:\n            return False\n        except PermissionError:\n            return True\n        except OSError:\n            return False\n        return True\n\n    def forget(self, pgid: int) -> None:\n        \"\"\"Очищает накопленное состояние группы после завершения хода.\"\"\"\n        with self._lock:\n            self._prev_cpu_by_pgid.pop(pgid, None)\n            self._seen_descendants_by_pgid.pop(pgid, None)\n            self._seeded_pgids.discard(pgid)\n\n    def _run_ps(self, pgid: int) -> subprocess.CompletedProcess[str]:\n        return subprocess.run(\n            [\"ps\", \"-o\", \"pid=,ppid=,pgid=,stat=,cputime=,command=\", \"-g\", str(pgid)],\n            capture_output=True,\n            text=True,\n            timeout=self.ps_timeout_s,\n            check=False,\n        )\n\n    def _parse_ps_output(\n        self, stdout: str, target_pgid: int\n    ) -> tuple[list[int], dict[int, float], list[str]]:\n        \"\"\"Возвращает PID, CPU и реальные состояния незавершённых членов группы.\"\"\"\n        descendants: list[int] = []\n        cpu_by_pid: dict[int, float] = {}\n        states: list[str] = []\n        for raw_line in (stdout or \"\").splitlines():\n            line = raw_line.strip()\n            if not line:\n                continue\n            match = _PS_LINE_RE.match(line)\n            if match is None:\n                continue\n            try:\n                pid = int(match.group(1))\n                _ppid = int(match.group(2))\n                pgid_col = int(match.group(3))\n            except ValueError:\n                continue\n            if pgid_col != target_pgid:\n                continue\n            stat = match.group(4) or \"\"\n            cputime_str = match.group(5) or \"\"\n            if stat[:1].upper() in {\"Z\", \"X\"}:\n                continue\n            states.append(stat)\n            cpu_by_pid[pid] = parse_cputime(cputime_str)\n            if pid != target_pgid:\n                descendants.append(pid)\n        descendants.sort()\n        return descendants, cpu_by_pid, states\n\n    def seed(self, pgid: int, *, rid: str = \"\", turn_id: str = \"\") -> WatchdogMetrics:\n        \"\"\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\"\"\"\n        metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\n        return metrics\n\n    def sample(\n        self,\n        pgid: int,\n        *,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        _seed_only: bool = False,\n    ) -> WatchdogMetrics:\n        \"\"\"Опрашивает группу `pgid` и вычисляет прирост `cputime` и новых потомков.\"\"\"\n        now = time.monotonic()\n        eff_rid = rid or self.rid or \"-\"\n        eff_turn = turn_id or self.turn_id or \"-\"\n        if not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        try:\n            proc = self._run_ps(pgid)\n        except (subprocess.TimeoutExpired, OSError) as exc:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason={exc.__class__.__name__}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        if proc.returncode != 0:\n            if not self.is_group_alive(pgid):\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=False,\n                    descendant_pids=(),\n                    new_descendants=(),\n                    cpu_time_s=0.0,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                )\n            self._log(\n                f\"watchdog_ps_degraded rid={eff_rid} turn_id={eff_turn} \"\n                f\"pgid={pgid} reason=rc_{proc.returncode}\"\n            )\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=True,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=True,\n                sample_ts=now,\n            )\n\n        descendants, cpu_s, states = self._parse_ps_output(proc.stdout, pgid)\n        if not states and not self.is_group_alive(pgid):\n            return WatchdogMetrics(\n                pgid=pgid,\n                alive=False,\n                descendant_pids=(),\n                new_descendants=(),\n                cpu_time_s=0.0,\n                cpu_delta_s=0.0,\n                ps_degraded=False,\n                sample_ts=now,\n            )\n\n        with self._lock:\n            prev_cpu = self._prev_cpu_by_pgid.setdefault(pgid, {})\n            seen_desc = self._seen_descendants_by_pgid.setdefault(pgid, set())\n            if _seed_only:\n                for pid, val in cpu_s.items():\n                    prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n                seen_desc.update(descendants)\n                self._seeded_pgids.add(pgid)\n                total_cpu = sum(cpu_s.values())\n                return WatchdogMetrics(\n                    pgid=pgid,\n                    alive=True,\n                    descendant_pids=tuple(descendants),\n                    new_descendants=(),\n                    cpu_time_s=total_cpu,\n                    cpu_delta_s=0.0,\n                    ps_degraded=False,\n                    sample_ts=now,\n                    states=states,\n                )\n\n            cpu_delta = sum(\n                max(0.0, val - prev_cpu.get(pid, 0.0)) for pid, val in cpu_s.items()\n            )\n            new_desc = tuple(sorted(set(descendants) - seen_desc))\n            for pid, val in cpu_s.items():\n                prev_cpu[pid] = max(prev_cpu.get(pid, 0.0), val)\n            seen_desc.update(descendants)\n            self._seeded_pgids.add(pgid)\n            total_cpu = sum(cpu_s.values())\n\n        return WatchdogMetrics(\n            pgid=pgid,\n            alive=True,\n            descendant_pids=tuple(descendants),\n            new_descendants=new_desc,\n            cpu_time_s=total_cpu,\n            cpu_delta_s=cpu_delta,\n            ps_degraded=False,\n            sample_ts=now,\n            states=states,\n        )\n\n\nclass AdaptiveTimeoutController:\n    \"\"\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\"\"\"\n\n    def __init__(\n        self,\n        idle_timeout_s: float = IDLE_TIMEOUT_S,\n        safety_cap_s: float | None = None,\n        finish_reserve_s: float = FINISH_RESERVE_S,\n        watchdog: ProcessWatchdog | None = None,\n        watchdog_enabled: bool = True,\n        clock: Callable[[], float] = time.monotonic,\n        rid: str = \"\",\n        turn_id: str = \"\",\n        log_fn: Callable[[str], None] | None = None,\n        io_wait_cap_s: float | None = None,\n        watchdog_interval_s: float | None = None,\n    ) -> None:\n        self.watchdog_interval_s = (\n            positive_env(\"BRIDGE_WATCHDOG_INTERVAL_S\", WATCHDOG_INTERVAL_S)\n            if watchdog_interval_s is None\n            else float(watchdog_interval_s)\n        )\n        self.idle_timeout_s = max(\n            10.0, float(idle_timeout_s), 2 * self.watchdog_interval_s\n        )\n        self.safety_cap_s = (\n            positive_env(\n                \"BRIDGE_SAFETY_CAP_S\",\n                positive_env(\"DROID_DSH_BRIDGE_SAFETY_CAP_S\", SAFETY_CAP_S),\n            )\n            if safety_cap_s is None\n            else float(safety_cap_s)\n        )\n        self.io_wait_cap_s = (\n            positive_env(\"BRIDGE_IO_WAIT_CAP_S\", 900.0)\n            if io_wait_cap_s is None\n            else float(io_wait_cap_s)\n        )\n        self.io_grace_enabled = io_grace_enabled()\n        self.finish_reserve_s = float(finish_reserve_s)\n        self.watchdog_enabled = bool(watchdog_enabled)\n        self._clock = clock\n        self.rid = rid\n        self.turn_id = turn_id\n        self._log_fn = log_fn\n        self.watchdog = watchdog or ProcessWatchdog(\n            log_fn=log_fn, rid=rid, turn_id=turn_id\n        )\n        self._lock = threading.Lock()\n        now = self._clock()\n        self.started_at: float = now\n        self.last_activity_ts: float = now\n        self.last_activity_kind: str = \"start\"\n        self.pgid: int | None = None\n        self.terminated_reason: str = \"\"\n\n    def effective_cap_s(self) -> float:\n        \"\"\"Эффективный бюджет времени до срабатывания `absolute_cap`.\"\"\"\n        if self.safety_cap_s > self.finish_reserve_s:\n            return self.safety_cap_s - self.finish_reserve_s\n        return max(0.01, self.safety_cap_s)\n\n    def record_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Сбрасывает таймер простоя при получении протокольного события от бэкенда.\"\"\"\n        now = self._clock()\n        with self._lock:\n            self.last_activity_ts = now\n            self.last_activity_kind = kind or \"protocol\"\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        \"\"\"Синоним `record_activity` для прямой передачи в `TurnContext.on_activity`.\"\"\"\n        self.record_activity(kind)\n\n    def register_pgid(self, pgid: int) -> None:\n        \"\"\"Привязывает PGID дочернего процесса и снимает стартовый базовый срез.\"\"\"\n        if not isinstance(pgid, int) or pgid <= 0:\n            return\n        with self._lock:\n            self.pgid = pgid\n        if self.watchdog_enabled and self.watchdog is not None:\n            self.watchdog.seed(pgid, rid=self.rid, turn_id=self.turn_id)\n\n    def check(\n        self, pgid: int | None = None\n    ) -> tuple[bool, str, WatchdogMetrics | None]:\n        \"\"\"Проверяет условия завершения хода.\n\n        Возвращает кортеж `(should_stop, reason, metrics)`, где `reason` при\n        `should_stop == True` принимает одно из значений:\n        - `\"absolute_cap\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\n        - `\"idle_timeout\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\n        - `\"child_exited\"` — процессная группа завершилась.\n        \"\"\"\n        with self._lock:\n            target_pgid = pgid if pgid is not None else self.pgid\n            started_at = self.started_at\n\n        now = self._clock()\n        if now - started_at >= self.effective_cap_s():\n            with self._lock:\n                self.terminated_reason = \"absolute_cap\"\n            return True, \"absolute_cap\", None\n\n        metrics: WatchdogMetrics | None = None\n        if (\n            self.watchdog_enabled\n            and self.watchdog is not None\n            and isinstance(target_pgid, int)\n            and target_pgid > 0\n        ):\n            metrics = self.watchdog.sample(\n                target_pgid, rid=self.rid, turn_id=self.turn_id\n            )\n            if not metrics.alive:\n                with self._lock:\n                    self.terminated_reason = \"child_exited\"\n                return True, \"child_exited\", metrics\n            if metrics.has_progress:\n                with self._lock:\n                    self.last_activity_ts = now\n                    self.last_activity_kind = (\n                        \"new_descendants\"\n                        if metrics.new_descendants\n                        else \"cpu_delta\"\n                    )\n\n        with self._lock:\n            idle_elapsed = now - self.last_activity_ts\n            if idle_elapsed >= self.idle_timeout_s and not self.has_io_grace(\n                metrics, idle_elapsed\n            ):\n                self.terminated_reason = \"idle_timeout\"\n                return True, \"idle_timeout\", metrics\n\n        return False, \"\", metrics\n\n    def has_io_grace(\n        self, metrics: WatchdogMetrics | None, idle_elapsed: float\n    ) -> bool:\n        \"\"\"Даёт ограниченную отсрочку I/O без подмены last_activity_ts.\"\"\"\n        return bool(\n            self.io_grace_enabled\n            and metrics is not None\n            and metrics.is_waiting_io()\n            and idle_elapsed < self.io_wait_cap_s\n        )\n\n    def close(self) -> None:\n        \"\"\"Освобождает состояние отслеживаемой группы в `ProcessWatchdog`.\"\"\"\n        with self._lock:\n            pgid = self.pgid\n        if pgid is not None and self.watchdog is not None:\n            self.watchdog.forget(pgid)\n\n\n# Имя из контракта контроллера хода; прежний импорт остаётся совместимым.\nTurnTimeoutController = AdaptiveTimeoutController\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"ls -la .ai-team/runs/all-bridges-sliding-window-20261102; rg --files .ai-team/runs/all-bridges-sliding-window-20261102 -g '*packet*' -g '*.patch' -g '*.diff' -g '*manifest*'; cat tests/test_claude_p_watchdog.py; git diff -U5 -- tests/test_stream_timeout_config.py; rg -n 'parse_live_write_timeout|_kill_group|_pump|class Run|def _execute|TIMEOUT|tool_use|tool_call' bridges/claude-p-bridge/server.py server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"ls -la .ai-team/runs/all-bridges-sliding-window-20261102; rg --files .ai-team/runs/all-bridges-sliding-window-20261102 -g '*packet*' -g '*.patch' -g '*.diff' -g '*manifest*'; cat tests/test_claude_p_watchdog.py; git diff -U5 -- tests/test_stream_timeout_config.py; rg -n 'parse_live_write_timeout|_kill_group|_pump|class Run|def _execute|TIMEOUT|tool_use|tool_call' bridges/claude-p-bridge/server.py server.py\"","aggregated_output":"total 32\ndrwxr-xr-x@  9 aazhiry1  staff   288 Nov  2 18:08 .\ndrwxr-xr-x@ 42 aazhiry1  staff  1344 Nov  2 17:54 ..\ndrwxr-xr-x@  3 aazhiry1  staff    96 Nov  2 17:36 architecture\ndrwxr-xr-x@  5 aazhiry1  staff   160 Nov  2 18:08 code-panel\n-rw-r--r--@  1 aazhiry1  staff  6135 Nov  2 18:08 code-review-package.md\ndrwxr-xr-x@  9 aazhiry1  staff   288 Nov  2 17:54 consensus\ndrwxr-xr-x@  4 aazhiry1  staff   128 Nov  2 17:36 panel\ndrwxr-xr-x@  3 aazhiry1  staff    96 Nov  2 17:35 plans\n-rw-r--r--@  1 aazhiry1  staff  5064 Nov  2 17:54 processes.tsv\n.ai-team/runs/all-bridges-sliding-window-20261102/code-panel/panel/council/r1/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/architecture/architecture-packet.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r2/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r4/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r3/manifest.json\n.ai-team/runs/all-bridges-sliding-window-20261102/panel/arch/r1/manifest.json\n\"\"\"Скользящее окно активности claude-p-bridge (AD-001..AD-004).\n\nПокрытие: whitelist-чтение ~/.dsh/.env без мутации os.environ, срабатывание\nвотчдога (`idle_timeout`/`absolute_cap` -> kill + 504), отсутствие ложного\nтаймаута на `child_exited`, троттлинг `check()` по `watchdog_interval_s`,\nсброс таймера простоя на полезных событиях и закрытие контроллера в finally.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib.util\nimport os\nimport queue\nimport sys\nimport uuid\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any\n\nimport pytest\n\nREPO = Path(__file__).resolve().parent.parent\nBRIDGE_SERVER = REPO / \"bridges\" / \"claude-p-bridge\" / \"server.py\"\n_ENV_PREFIXES = (\"CLAUDE_P_BRIDGE_\", \"BRIDGE_\")\n\n\n@pytest.fixture(scope=\"module\")\ndef isolated_claude_bridge(tmp_path_factory: pytest.TempPathFactory):\n    \"\"\"Загружает мост с изолированным HOME и без внешних CLAUDE_P_BRIDGE_*/BRIDGE_* env.\"\"\"\n    home = tmp_path_factory.mktemp(\"claude-p-home\")\n    name = f\"claude_p_bridge_watchdog_{uuid.uuid4().hex}\"\n    with pytest.MonkeyPatch.context() as mp:\n        mp.setenv(\"HOME\", str(home))\n        for key in list(os.environ):\n            if key.startswith(_ENV_PREFIXES):\n                mp.delenv(key, raising=False)\n        spec = importlib.util.spec_from_file_location(name, BRIDGE_SERVER)\n        assert spec is not None and spec.loader is not None\n        mod = importlib.util.module_from_spec(spec)\n        sys.modules[name] = mod\n        try:\n            spec.loader.exec_module(mod)\n            yield SimpleNamespace(mod=mod, home=home)\n        finally:\n            sys.modules.pop(name, None)\n\n\nclass FakeController:\n    \"\"\"Фейковый AdaptiveTimeoutController: скриптованный check() и журнал вызовов.\"\"\"\n\n    instances: list = []\n    verdict: tuple = (False, \"\", None)\n\n    def __init__(self, idle_timeout_s, safety_cap_s, io_wait_cap_s, watchdog_interval_s):\n        self.idle_timeout_s = idle_timeout_s\n        self.safety_cap_s = safety_cap_s\n        self.io_wait_cap_s = io_wait_cap_s\n        self.watchdog_interval_s = watchdog_interval_s\n        self.registered: list = []\n        self.checks: list = []\n        self.activity: list = []\n        self.closed = False\n        type(self).instances.append(self)\n\n    def register_pgid(self, pgid: int) -> None:\n        self.registered.append(pgid)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.checks.append(pgid)\n        return type(self).verdict\n\n    def record_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n\n    def close(self) -> None:\n        self.closed = True\n\n\nclass FakeClock:\n    def __init__(self) -> None:\n        self.t = 0.0\n\n    def monotonic(self) -> float:\n        return self.t\n\n    def sleep(self, _s: float) -> None:\n        return None\n\n\nclass ScriptedQueue:\n    \"\"\"Очередь хода: каждый get() сдвигает фейковые часы на `step` секунд.\"\"\"\n\n    def __init__(self, items: list, clock: FakeClock | None = None, step: float = 0.0,\n                 error: Exception | None = None) -> None:\n        self.items = list(items)\n        self.clock = clock\n        self.step = step\n        self.error = error\n\n    def get(self, timeout: float | None = None) -> Any:\n        if self.clock is not None:\n            self.clock.t += self.step\n        if self.error is not None:\n            raise self.error\n        if not self.items:\n            raise queue.Empty\n        return self.items.pop(0)\n\n\ndef _make_run(items: list, **kw: Any) -> SimpleNamespace:\n    return SimpleNamespace(\n        q=ScriptedQueue(items, **kw), err_box=[], proc=SimpleNamespace(pid=424242)\n    )\n\n\n@pytest.fixture()\ndef bridge(isolated_claude_bridge, monkeypatch: pytest.MonkeyPatch):\n    mod = isolated_claude_bridge.mod\n    FakeController.instances = []\n    FakeController.verdict = (False, \"\", None)\n    killed: list = []\n    monkeypatch.setattr(mod, \"AdaptiveTimeoutController\", FakeController)\n    monkeypatch.setattr(mod, \"_kill_group\", lambda proc: killed.append(proc))\n    monkeypatch.setattr(mod, \"_client_gone\", lambda _sock: False)\n    monkeypatch.setattr(mod, \"_is_watchdog_enabled\", lambda: True)\n    monkeypatch.setattr(mod, \"POLL_INTERVAL_S\", 0.0)\n    monkeypatch.setattr(mod, \"STDERR_DRAIN_S\", 0.0)\n    return SimpleNamespace(mod=mod, killed=killed)\n\n\ndef _execute(mod: Any, run: Any) -> dict:\n    handler = mod.Handler.__new__(mod.Handler)\n    handler.connection = None\n    sink = lambda *_a: True  # noqa: E731\n    return handler._execute(run, sink, sink, sink, None, False, None)\n\n\ndef test_claude_p_env_loader_security(isolated_claude_bridge) -> None:\n    mod = isolated_claude_bridge.mod\n    env_dir = isolated_claude_bridge.home / \".dsh\"\n    env_dir.mkdir(exist_ok=True)\n    env_file = env_dir / \".env\"\n    env_file.write_text(\n        \"\\n\".join([\n            \"# comment\",\n            \"\",\n            \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=111\",\n            \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=222\",\n            \"export BRIDGE_SAFETY_CAP_S='1800'\",\n            'CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=\"0\"',\n            \"CLAUDE_P_BRIDGE_KEY=super-secret\",\n            \"OPENAI_API_KEY=sk-should-not-leak\",\n            \"NOT_A_PAIR\",\n        ]) + \"\\n\",\n        encoding=\"utf-8\",\n    )\n    before = dict(os.environ)\n    try:\n        got = mod._read_dsh_env_file()\n    finally:\n        env_file.unlink()\n    assert dict(os.environ) == before  # os.environ не мутирован\n    assert got == {\n        \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\": \"222\",  # дубликат — последнее значение\n        \"BRIDGE_SAFETY_CAP_S\": \"1800\",\n        \"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\": \"0\",\n    }\n    assert not any(k.endswith(\"_KEY\") for k in got)\n    assert \"super-secret\" not in got.values()\n    # Без файла — пустой словарь.\n    assert mod._read_dsh_env_file() == {}\n\n\n@pytest.mark.parametrize(\"reason\", [\"idle_timeout\", \"absolute_cap\"])\ndef test_watchdog_timeout_trigger(bridge, monkeypatch: pytest.MonkeyPatch, reason: str) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 0.0)\n    FakeController.verdict = (True, reason, None)\n    run = _make_run([(\"text\", \"partial\"), (\"done\", 0)])\n    out = _execute(mod, run)\n    assert bridge.killed == [run.proc]\n    assert out[\"state\"] == \"timeout\"\n    assert out[\"rc\"] == 1\n    assert reason in out[\"err\"]\n    err = mod.Handler._error_body(out)\n    assert err[\"code\"] == 504\n    assert err[\"type\"] == \"upstream_timeout\"\n    assert reason in err[\"message\"]\n    (ctl,) = FakeController.instances\n    assert ctl.registered == [run.proc.pid]\n    assert ctl.closed\n\n\ndef test_child_exited_no_false_timeout(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 0.0)\n    FakeController.verdict = (True, \"child_exited\", None)\n    run = _make_run([\n        (\"text\", \"hello\"),\n        (\"result\", {\"usage\": {\"output_tokens\": 1}}),\n        (\"done\", 0),\n    ])\n    out = _execute(mod, run)\n    assert bridge.killed == []\n    assert out[\"state\"] == \"done\"\n    assert out[\"rc\"] == 0\n    assert out[\"text\"] == \"hello\"\n    (ctl,) = FakeController.instances\n    assert len(ctl.checks) >= 1  # вердикт child_exited получен, но ход не прерван\n\n\ndef test_watchdog_throttle(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    clock = FakeClock()\n    monkeypatch.setattr(mod, \"time\", clock)\n    interval = 3.0\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", interval)\n    check_ts: list = []\n    orig_check = FakeController.check\n\n    def timed_check(self, pgid=None):\n        check_ts.append(clock.t)\n        return orig_check(self, pgid)\n\n    monkeypatch.setattr(FakeController, \"check\", timed_check)\n    items = [(\"text\", f\"t{i} \") for i in range(10)] + [(\"done\", 0)]\n    run = _make_run(items, clock=clock, step=1.0)\n    out = _execute(mod, run)\n    assert out[\"state\"] == \"done\"\n    # 11 итераций по 1 с: проверки только на t=3, 6, 9.\n    assert check_ts == [3.0, 6.0, 9.0]\n    assert all(b - a >= interval for a, b in zip(check_ts, check_ts[1:]))\n    assert len(check_ts) <= clock.t / interval\n\n\ndef test_record_activity_calls(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 1e9)\n    run = _make_run([\n        (\"text\", \"a\"),\n        (\"thinking\", \"b\"),\n        (\"result\", {\"usage\": {}}),\n        (\"done\", 0),\n    ])\n    out = _execute(mod, run)\n    assert out[\"state\"] == \"done\"\n    (ctl,) = FakeController.instances\n    assert ctl.activity == [\"text\", \"thinking\", \"result\"]\n    assert ctl.checks == []\n\n\ndef test_controller_closed_in_finally(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\n    mod = bridge.mod\n    monkeypatch.setattr(mod, \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", 1e9)\n\n    # Штатный выход.\n    out = _execute(mod, _make_run([(\"text\", \"ok\"), (\"done\", 0)]))\n    assert out[\"state\"] == \"done\"\n    # Аварийный выход по pump_error.\n    out = _execute(mod, _make_run([(\"pump_error\", \"boom\")]))\n    assert out[\"state\"] == \"pump_error\"\n    # Исключение внутри цикла.\n    with pytest.raises(RuntimeError, match=\"queue broken\"):\n        _execute(mod, _make_run([], error=RuntimeError(\"queue broken\")))\n\n    assert len(FakeController.instances) == 3\n    assert all(ctl.closed for ctl in FakeController.instances)\ndiff --git a/tests/test_stream_timeout_config.py b/tests/test_stream_timeout_config.py\nindex d8bcc18..00b350a 100644\n--- a/tests/test_stream_timeout_config.py\n+++ b/tests/test_stream_timeout_config.py\n@@ -9,10 +9,11 @@ import server\n \n @pytest.mark.parametrize(\"raw\", [None, \"\", \"   \"])\n def test_live_write_timeout_default(\n     monkeypatch: pytest.MonkeyPatch, raw: str | None\n ) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     if raw is None:\n         monkeypatch.delenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raising=False)\n     else:\n         monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n     assert server.parse_live_write_timeout() == 30.0\n@@ -22,16 +23,38 @@ def test_live_write_timeout_default(\n     \"raw, expected\", [(\"45.5\", 45.5), (\" 45.5 \", 45.5), (\"1\", 1.0), (\"300\", 300.0)]\n )\n def test_live_write_timeout_valid(\n     monkeypatch: pytest.MonkeyPatch, raw: str, expected: float\n ) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n     assert server.parse_live_write_timeout() == expected\n \n \n @pytest.mark.parametrize(\n     \"raw\", [\"0\", \"-1\", \"0.99\", \"300.01\", \"inf\", \"-inf\", \"nan\", \"invalid\"]\n )\n def test_live_write_timeout_fallback(monkeypatch: pytest.MonkeyPatch, raw: str) -> None:\n+    monkeypatch.delenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", raising=False)\n     monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", raw)\n     assert server.parse_live_write_timeout() == 30.0\n     assert server.parse_live_write_timeout(12.0) == 12.0\n+\n+\n+def test_live_write_timeout_priority(monkeypatch: pytest.MonkeyPatch) -> None:\n+    \"\"\"BRIDGE_CLIENT_WRITE_TIMEOUT_S приоритетнее legacy DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S.\"\"\"\n+    # Валидный общий ключ побеждает legacy.\n+    monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", \"45\")\n+    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"60\")\n+    assert server.parse_live_write_timeout() == 45.0\n+\n+    # Невалидный общий ключ -> валидный legacy.\n+    for bad in (\"invalid\", \"0\", \"500\", \"nan\"):\n+        monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", bad)\n+        monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"60\")\n+        assert server.parse_live_write_timeout() == 60.0\n+\n+    # Оба невалидны -> default.\n+    monkeypatch.setenv(\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\", \"invalid\")\n+    monkeypatch.setenv(\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\", \"-1\")\n+    assert server.parse_live_write_timeout() == 30.0\n+    assert server.parse_live_write_timeout(12.0) == 12.0\nbridges/claude-p-bridge/server.py:11:`<tool_call>{\"name\":…,\"arguments\":{…}}</tool_call>`; потоковые блоки переводятся\nbridges/claude-p-bridge/server.py:12:в OpenAI-чанки `delta.tool_calls`, история с `tool_calls`/`role:\"tool\"`\nbridges/claude-p-bridge/server.py:82:        sanitize_tool_call,\nbridges/claude-p-bridge/server.py:108:    \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\",\nbridges/claude-p-bridge/server.py:112:    \"BRIDGE_IDLE_TIMEOUT_S\",\nbridges/claude-p-bridge/server.py:177:CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S = _get_positive_float(\nbridges/claude-p-bridge/server.py:178:    \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\", \"BRIDGE_IDLE_TIMEOUT_S\", 300.0\nbridges/claude-p-bridge/server.py:269:QUEUE_TIMEOUT_S = int(os.environ.get(\"CLAUDE_P_BRIDGE_QUEUE_TIMEOUT\", \"900\"))\nbridges/claude-p-bridge/server.py:278:HTTP_TIMEOUT_S = float(os.environ.get(\"CLAUDE_P_BRIDGE_HTTP_TIMEOUT_S\", \"300\"))\nbridges/claude-p-bridge/server.py:296:TOOL_CALL_OPEN = \"<tool_call>\"\nbridges/claude-p-bridge/server.py:297:TOOL_CALL_CLOSE = \"</tool_call>\"\nbridges/claude-p-bridge/server.py:430:def _kill_group(proc: subprocess.Popen) -> None:\nbridges/claude-p-bridge/server.py:466:class Run:\nbridges/claude-p-bridge/server.py:495:        threading.Thread(target=self._pump, daemon=True).start()\nbridges/claude-p-bridge/server.py:527:    def _pump(self) -> None:\nbridges/claude-p-bridge/server.py:562:            _kill_group(self.proc)\nbridges/claude-p-bridge/server.py:584:    timeout = HTTP_TIMEOUT_S\nbridges/claude-p-bridge/server.py:609:        \"\"\"Ждём слот семафора до QUEUE_TIMEOUT_S, попутно keepalive и проверка клиента.\"\"\"\nbridges/claude-p-bridge/server.py:615:            if time.monotonic() - waited > QUEUE_TIMEOUT_S:\nbridges/claude-p-bridge/server.py:623:    def _execute(self, run: Run, on_text, on_reasoning, on_tool_call,\nbridges/claude-p-bridge/server.