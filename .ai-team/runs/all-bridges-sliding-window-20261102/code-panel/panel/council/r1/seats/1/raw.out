   162\t    raw = _get_setting(name, fallback_name)\n   163\t    if not raw:\n   164\t        return default\n   165\t    try:\n   166\t        val = float(raw)\n   167\t        return val if 0 < val < float(\"inf\") else default\n   168\t    except (ValueError, TypeError):\n   169\t        return default\n   170\t\n   171\t\n   172\tdef _is_watchdog_enabled() -> bool:\n   173\t    raw = _get_setting(\"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\", default=\"1\").lower()\n   174\t    return raw not in (\"0\", \"false\", \"no\", \"off\")\n   175\t\n   176\t\n   177\tCLAUDE_P_BRIDGE_IDLE_TIMEOUT_S = _get_positive_float(\n   178\t    \"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\", \"BRIDGE_IDLE_TIMEOUT_S\", 300.0\n   179\t)\n   180\tCLAUDE_P_BRIDGE_IO_WAIT_CAP_S = _get_positive_float(\n   181\t    \"CLAUDE_P_BRIDGE_IO_WAIT_CAP_S\", \"BRIDGE_IO_WAIT_CAP_S\", 900.0\n   182\t)\n   183\tCLAUDE_P_BRIDGE_SAFETY_CAP_S = _get_positive_float(\n   184\t    \"CLAUDE_P_BRIDGE_SAFETY_CAP_S\", \"BRIDGE_SAFETY_CAP_S\", 3600.0\n   185\t)\n   186\tCLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S = _get_positive_float(\n   187\t    \"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\", \"BRIDGE_WATCHDOG_INTERVAL_S\", 5.0\n   188\t)\n   189\t\n   190\t\n   191\tROOT = Path(__file__).resolve().parent\n   192\tHOST = os.environ.get(\"CLAUDE_P_BRIDGE_HOST\", \"127.0.0.1\")\n   193\tPORT = int(os.environ.get(\"CLAUDE_P_BRIDGE_PORT\", \"9881\"))\n    26\t\n    27\t@pytest.fixture(scope=\"module\")\n    28\tdef isolated_claude_bridge(tmp_path_factory: pytest.TempPathFactory):\n    29\t    \"\"\"Загружает мост с изолированным HOME и без внешних CLAUDE_P_BRIDGE_*/BRIDGE_* env.\"\"\"\n    30\t    home = tmp_path_factory.mktemp(\"claude-p-home\")\n    31\t    name = f\"claude_p_bridge_watchdog_{uuid.uuid4().hex}\"\n    32\t    with pytest.MonkeyPatch.context() as mp:\n    33\t        mp.setenv(\"HOME\", str(home))\n    34\t        for key in list(os.environ):\n    35\t            if key.startswith(_ENV_PREFIXES):\n    36\t                mp.delenv(key, raising=False)\n    37\t        spec = importlib.util.spec_from_file_location(name, BRIDGE_SERVER)\n    38\t        assert spec is not None and spec.loader is not None\n    39\t        mod = importlib.util.module_from_spec(spec)\n    40\t        sys.modules[name] = mod\n    41\t        try:\n    42\t            spec.loader.exec_module(mod)\n    43\t            yield SimpleNamespace(mod=mod, home=home)\n    44\t        finally:\n    45\t            sys.modules.pop(name, None)\n    46\t\n    47\t\n   365\t        safety_cap_s: float | None = None,\n   366\t        finish_reserve_s: float = FINISH_RESERVE_S,\n   367\t        watchdog: ProcessWatchdog | None = None,\n   368\t        watchdog_enabled: bool = True,\n   369\t        clock: Callable[[], float] = time.monotonic,\n   370\t        rid: str = \"\",\n   371\t        turn_id: str = \"\",\n   372\t        log_fn: Callable[[str], None] | None = None,\n   373\t        io_wait_cap_s: float | None = None,\n   374\t        watchdog_interval_s: float | None = None,\n   375\t    ) -> None:\n   376\t        self.watchdog_interval_s = (\n   377\t            positive_env(\"BRIDGE_WATCHDOG_INTERVAL_S\", WATCHDOG_INTERVAL_S)\n   378\t            if watchdog_interval_s is None\n   379\t            else float(watchdog_interval_s)\n   380\t        )\n   381\t        self.idle_timeout_s = max(\n   382\t            10.0, float(idle_timeout_s), 2 * self.watchdog_interval_s\n   383\t        )\n   384\t        self.safety_cap_s = (\n   385\t            positive_env(\n   386\t                \"BRIDGE_SAFETY_CAP_S\",\n   387\t                positive_env(\"DROID_DSH_BRIDGE_SAFETY_CAP_S\", SAFETY_CAP_S),\n   388\t            )\n   389\t            if safety_cap_s is None\n   390\t            else float(safety_cap_s)\n   391\t        )\n   392\t        self.io_wait_cap_s = (\n   393\t            positive_env(\"BRIDGE_IO_WAIT_CAP_S\", 900.0)\n   394\t            if io_wait_cap_s is None\n   395\t            else float(io_wait_cap_s)\n   396\t        )\n   397\t        self.io_grace_enabled = io_grace_enabled()\n   398\t        self.finish_reserve_s = float(finish_reserve_s)\n   399\t        self.watchdog_enabled = bool(watchdog_enabled)\n   400\t        self._clock = clock\n   401\t        self.rid = rid\n   402\t        self.turn_id = turn_id\n   403\t        self._log_fn = log_fn\n   404\t        self.watchdog = watchdog or ProcessWatchdog(\n                    \"data\": path.read_bytes(),\n                }\n            type(self).captured[\"img_dir_mode\"] = stat.S_IMODE(root.stat().st_mode)\n            type(self).captured[\"img_files\"] = files\n        self.q = queue.Queue()\n        for item in type(self).script:\n            self.q.put(item)\n        self.err_box = []\n\n    def close(self):\n        type(self).captured[\"closed\"] = True\n\n\n@pytest.fixture()\ndef http_bridge(bridge, monkeypatch):\n    FakeRun.script = []\n    FakeRun.captured = {}\n    monkeypatch.setattr(bridge, \"Run\", FakeRun)\n    server = bridge.Server((\"127.0.0.1\", 0), bridge.Handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    yield bridge, server.server_address[1]\n    server.shutdown()\n    server.server_close()\n    thread.join(timeout=5)\n\n\ndef _post(port: int, payload: dict):\n    conn = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=30)\n    try:\n        conn.request(\n            \"POST\",\n            \"/v1/chat/completions\",\n            body=json.dumps(payload),\n            headers={\n                \"Content-Type\": \"application/json\",\n                \"Authorization\": \"Bearer test-key\",\n            },\n        )\n        resp = conn.getresponse()\n        body = resp.read().decode(\"utf-8\", \"replace\")\n        return resp.status, body\n    finally:\n        conn.close()\n\n\ndef _sse_payloads(body: str) -> list:\n    out = []\n    for line in body.splitlines():\n        if line.startswith(\"data: \") and line[6:] != \"[DONE]\":\n            out.append(json.loads(line[6:]))\n    return out\n\n\ndef _sse_delta_text(body: str, field: str) -> str:\n    parts = []\n    for payload in _sse_payloads(body):\n        for choice in payload.get(\"choices\") or []:\n            value = (choice.get(\"delta\") or {}).get(field)\n            if value:\n                parts.append(value)\n291:def test_state_sampling_reads_actual_sleeping_group() -> None:\n292-    proc = subprocess.Popen(\n293-        [\n294-            sys.executable,\n295-            \"-c\",\n296-            \"import time; print('ready', flush=True); time.sleep(60)\",\n297-        ],\n298-        start_new_session=True,\n299-        stdout=subprocess.PIPE,\n300-    )\n301-    try:\n302-        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n303-        sample = ProcessWatchdog().sample(proc.pid)\n304-        assert sample.alive\n305-        assert sample.states\n306-        assert sample.is_waiting_io()\n307-        assert all(state[0] not in \"ZX\" for state in sample.states)\n308-    finally:\n309-        os.killpg(proc.pid, signal.SIGTERM)\n310-        _ = proc.wait(timeout=5)\n311-\nls: .agents: No such file or directory\n","exit_code":1,"status":"failed"}}
