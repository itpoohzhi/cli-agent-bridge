ve_start(attempt_deadline, is_client_gone)\n4584:                        deadline=call_deadline,\n4588:                    _check_serve_start(attempt_deadline, is_client_gone)\n4594:                    if attempt or time.monotonic() >= call_deadline:\n4663:        ready_deadline = min(\n4664:            time.monotonic() + 3.0, attempt_deadline, aux.deadline(attempt_deadline)\n4673:                        phase_deadline=ready_deadline,\n4677:                    _check_serve_start(attempt_deadline, is_client_gone)\n4678:                    if time.monotonic() >= ready_deadline:\n4717:                phase_deadline=min(\n4719:                    attempt_deadline,\n4720:                    aux.deadline(attempt_deadline),\n4742:                port, password, aux.deadline(attempt_deadline), is_client_gone\n4753:        first_event_deadline = min(first_event_limit, aux.deadline(attempt_deadline))\n4807:            prompt_deadline = aux.deadline(attempt_deadline)\n4819:                    65.0, max(0.05, prompt_deadline - time.monotonic())\n4829:                    deadline=prompt_deadline,\n4840:                if time.monotonic() >= prompt_deadline or aux.exhausted():\n4857:        deadline = min(\n4858:            deadline if deadline is not None else prompt_send_start + TIMEOUT_S,\n4863:        last_token_at = prompt_send_start\n4866:        while time.monotonic() < deadline:\n4882:                    now, last_token_at, idle_timeout, tool_state.has_active()\n4889:                result[\"first_event_at\"] is None and now >= first_event_deadline\n4894:                    or first_event_deadline < first_event_limit\n4907:            if result[\"first_token_at\"] is not None and now - last_token_at > float(\n4908:                STALL_TIMEOUT_S\n4946:                elif now - last_token_at >= float(STALL_HEARTBEAT_INTERVAL_S):\n5058:                    last_token_at = time.monotonic()\n5069:                    last_token_at = time.monotonic()\n5078:                    last_token_at = result[\"first_token_at\"]\n5080:                    last_token_at = time.monotonic()\n5093:                        last_token_at = time.monotonic()\n5108:                                min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\n5113:                                attempt_deadline=deadline,\n5146:                        last_token_at = time.monotonic()\n5179:            and time.monotonic() >= deadline\n5192:            exc, attempt_deadline, is_client_gone, _is_delivered()\n6678:        deadline = (\n6679:            self.attempts.deadline\n6684:        gate.acquire(deadline=deadline, is_client_gone=self.is_client_gone)\n6686:            max_wait_s=min(SPAWN_WAIT_MAX_S, max(0.0, deadline - time.monotonic())),\n6687:            deadline=deadline,\n6698:                \"err\": \"spawn rate limit: deadline exceeded\",\n6706:        ) or time.monotonic() >= deadline:\n6716:                \"err\": \"request cancelled or deadline exceeded\",\n6752:        last_token_at: float | None = None\n6791:                last_token_at is not None\n6794:                    now, last_token_at, idle_timeout, bool(tool_activity)\n6812:                last_token_at is not None\n6814:                and now - last_token_at > float(STALL_TIMEOUT_S)\n6827:                deadline, idle_s=_STDOUT_POLL_S, on_idle=on_idle\n6859:                        last_token_at = now_ev\n7032:        deadline: float | None = None,\n7033:        deadline_fn: Callable[[], float | None] | None = None,\n7039:        self._deadline: float | None = deadline\n7040:        self._deadline_fn: Callable[[], float | None] | None = deadline_fn\n7048:    def _effective_deadline(self) -> float | None:\n7049:        \"\"\"Дедлайн записи: явный или от deadline_fn.\"\"\"\n7050:        if self._deadline_fn is not None:\n7051:            return self._deadline_fn()\n7052:        return self._deadline\n7062:        effective_deadline = self._effective_deadline()\n7063:        if effective_deadline is None:\n7066:            remaining = effective_deadline - time.monotonic()\n7087:    def cancel_deadline_timer(self) -> None:\n7455:                    deadline=attempts.aux_budget.deadline(attempts.deadline),\n7468:                    deadline=attempts.aux_budget.deadline(attempts.deadline),\n7520:                    deadline=attempts.deadline,\n8081:                deadline=attempts.deadline,\n8144:            deadline = attempts.deadline\n8298:                    deadline=attempts.deadline, is_client_gone=self._client_gone_check\n8302:                    deadline=attempts.deadline,\n8315:                        \"stream spawn skipped: spawn rate limiter wait exceeds the request deadline\"\n8393:                    \"last_token_at\": attempt_start,\n8439:                            float(watchdog_state[\"last_token_at\"]),\n8462:                        watchdog_state[\"last_token_at\"]\n8463:                    ) > float(STALL_TIMEOUT_S):\n8495:                                watchdog_state[\"last_token_at\"]\n8517:                for raw in feed.lines(deadline, 0.25, send_keepalive):\n8533:                            watchdog_state[\"last_token_at\"] = time.monotonic()\n8569:                            watchdog_state[\"last_token_at\"] = time.monotonic()\n8746:                        and time.monotonic() < deadline\n8766:                if not emulate_tools or tool_calls or time.monotonic() > deadline:\n8942:                self.wfile.cancel_deadline_timer()\n9063:                    deadline=attempts.aux_budget.deadline(attempts.deadline),\n9076:                    deadline=attempts.aux_budget.deadline(attempts.deadline),\n9131:                    deadline=attempts.deadline,\n\ndef _zen_positive_float(name: str, default: float) -> float:\n    \"\"\"Нечисловое, неконечное и неположительное значение заменяется default.\"\"\"\n    try:\n        value = float(os.environ.get(name, str(default)))\n        return value if 0 < value < float(\"inf\") else default\n    except ValueError:\n        return default\n\n\ndef _zen_targeted(model: str, prompt: str) -> bool:\n    \"\"\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\"\"\"\n    models = {\n        \"deepseek-v4.1-flash-free\",\n        *filter(\n            None, re.split(r\"[,\\s]+\", os.environ.get(\"BRIDGE_ZEN_TIMEOUT_MODELS\", \"\"))\n        ),\n    }\n    threshold = _positive_int(os.environ.get(\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\"), 8192)\n    return model in models and len(prompt.encode(\"utf-8\")) > threshold\n\n\ndef _zen_ttft_timeout(model: str, prompt: str) -> float:\n    \"\"\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\"\"\"\n    if _zen_targeted(model, prompt):\n        return min(\n            TIMEOUT_S,\n            _zen_positive_float(\n                \"BRIDGE_ZEN_TTFT_TIMEOUT_S\",\n                _zen_positive_float(\"BRIDGE_ZEN_TIMEOUT_S\", 25.0),\n            ),\n        )\n    return TIMEOUT_S\n\n\ndef _zen_idle_timeout(model: str, prompt: str) -> float:\n    \"\"\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\"\"\"\n    if not _zen_targeted(model, prompt):\n        return TIMEOUT_S\n    return min(TIMEOUT_S, _zen_positive_float(\"BRIDGE_ZEN_IDLE_TIMEOUT_S\", 15.0))\n\n\ndef _zen_total_timeout(model: str, prompt: str) -> float:\n    \"\"\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\"\"\"\n    if not _zen_targeted(model, prompt):\n        return TIMEOUT_S\n    return min(\n        TIMEOUT_S,\n        _zen_positive_float(\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\", min(180.0, TIMEOUT_S)),\n    )\n\n\ndef _zen_execution_timeout(model: str, prompt: str) -> float:\n    \"\"\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\"\"\"\n    return _zen_ttft_timeout(model, prompt)\n\n\ndef _zen_idle_expired(\n    now: float, last_token_at: float, idle_timeout: float, tools_active: bool\n) -> bool:\n    \"\"\"Idle-таймаут между чанками; не применяется, пока исполняется tool/сабагент (остаются stall и total).\"\"\"\n    return not tools_active and now - last_token_at >= idle_timeout\n\n\nclass _ToolActivity:\n    \"\"\"Активные tool/сабагент по событиям `opencode run`: единое условие освобождения от Idle.\"\"\"\n\n    def __init__(self) -> None:\n        self._running: set[str] = set()\n        self._anonymous = 0\n\n    def observe(self, etype: str, event: object) -> None:\n        \"\"\"Учесть tool_use/tool_call: pending/running — активен, иной статус — завершён.\"\"\"\n        if etype not in (\"tool_use\", \"tool_call\"):\nrg: pyproject.toml: IO error for operation on pyproject.toml: No such file or directory (os error 2)\n-rwxr-xr-x@ 1 aazhiry1  staff  360 Oct 31 11:36 .venv/bin/pytest\nlrwxr-xr-x@ 1 aazhiry1  staff   51 Oct  9 08:53 .venv/bin/python -> /Library/Developer/CommandLineTools/usr/bin/python3\n/Users/aazhiry1/.local/bin/run-guarded\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"Новые тесты подменяют контроллер целиком, поэтому ещё проверю связку с настоящим `AdaptiveTimeoutController`. Также сверю оставшиеся настенные дедлайны с заявленной целью и запущу регрессии и обязательный L2.\n"}}
