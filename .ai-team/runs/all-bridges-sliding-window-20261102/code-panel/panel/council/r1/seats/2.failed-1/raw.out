{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c559","stream":{"kind":"session","id":"01a19cce-09d5-7de2-8e12-1eacc58dccf4"},"sequence":263,"recorded_at":1780531400000521,"record_type":"event","durability":"durable","causation_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","run_stream":{"kind":"run","id":"01a19cce-0f25-76e1-b45d-25cc5822927d"},"task_stream":{"kind":"task","id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a"},"task_id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a","event":{"kind":"output","task_id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a","chunk":"{\n  \"chunk_id\": \"exec-8-1\",\n  \"command\": \"cat /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_claude_p_watchdog.py\",\n  \"description\": \"Read new watchdog tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\\"\\\"\\\"Скользящее окно активности claude-p-bridge (AD-001..AD-004).\\n\\nПокрытие: whitelist-чтение ~/.dsh/.env без мутации os.environ, срабатывание\\nвотчдога (`idle_timeout`/`absolute_cap` -> kill + 504), отсутствие ложного\\nтаймаута на `child_exited`, троттлинг `check()` по `watchdog_interval_s`,\\nсброс таймера простоя на полезных событиях и закрытие контроллера в finally.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport os\\nimport queue\\nimport sys\\nimport uuid\\nfrom pathlib import Path\\nfrom types import SimpleNamespace\\nfrom typing import Any\\n\\nimport pytest\\n\\nREPO = Path(__file__).resolve().parent.parent\\nBRIDGE_SERVER = REPO / \\\"bridges\\\" / \\\"claude-p-bridge\\\" / \\\"server.py\\\"\\n_ENV_PREFIXES = (\\\"CLAUDE_P_BRIDGE_\\\", \\\"BRIDGE_\\\")\\n\\n\\n@pytest.fixture(scope=\\\"module\\\")\\ndef isolated_claude_bridge(tmp_path_factory: pytest.TempPathFactory):\\n    \\\"\\\"\\\"Загружает мост с изолированным HOME и без внешних CLAUDE_P_BRIDGE_*/BRIDGE_* env.\\\"\\\"\\\"\\n    home = tmp_path_factory.mktemp(\\\"claude-p-home\\\")\\n    name = f\\\"claude_p_bridge_watchdog_{uuid.uuid4().hex}\\\"\\n    with pytest.MonkeyPatch.context() as mp:\\n        mp.setenv(\\\"HOME\\\", str(home))\\n        for key in list(os.environ):\\n            if key.startswith(_ENV_PREFIXES):\\n                mp.delenv(key, raising=False)\\n        spec = importlib.util.spec_from_file_location(name, BRIDGE_SERVER)\\n        assert spec is not None and spec.loader is not None\\n        mod = importlib.util.module_from_spec(spec)\\n        sys.modules[name] = mod\\n        try:\\n            spec.loader.exec_module(mod)\\n            yield SimpleNamespace(mod=mod, home=home)\\n        finally:\\n            sys.modules.pop(name, None)\\n\\n\\nclass FakeController:\\n    \\\"\\\"\\\"Фейковый AdaptiveTimeoutController: скриптованный check() и журнал вызовов.\\\"\\\"\\\"\\n\\n    instances: list = []\\n    verdict: tuple = (False, \\\"\\\", None)\\n\\n    def __init__(self, idle_timeout_s, safety_cap_s, io_wait_cap_s, watchdog_interval_s):\\n        self.idle_timeout_s = idle_timeout_s\\n        self.safety_cap_s = safety_cap_s\\n        self.io_wait_cap_s = io_wait_cap_s\\n        self.watchdog_interval_s = watchdog_interval_s\\n        self.registered: list = []\\n        self.checks: list = []\\n        self.activity: list = []\\n        self.closed = False\\n        type(self).instances.append(self)\\n\\n    def register_pgid(self, pgid: int) -> None:\\n        self.registered.append(pgid)\\n\\n    def check(self, pgid: int | None = None) -> tuple:\\n        self.checks.append(pgid)\\n        return type(self).verdict\\n\\n    def record_activity(self, kind: str = \\\"protocol\\\") -> None:\\n        self.activity.append(kind)\\n\\n    def close(self) -> None:\\n        self.closed = True\\n\\n\\nclass FakeClock:\\n    def __init__(self) -> None:\\n        self.t = 0.0\\n\\n    def monotonic(self) -> float:\\n        return self.t\\n\\n    def sleep(self, _s: float) -> None:\\n        return None\\n\\n\\nclass ScriptedQueue:\\n    \\\"\\\"\\\"Очередь хода: каждый get() сдвигает фейковые часы на `step` секунд.\\\"\\\"\\\"\\n\\n    def __init__(self, items: list, clock: FakeClock | None = None, step: float = 0.0,\\n                 error: Exception | None = None) -> None:\\n        self.items = list(items)\\n        self.clock = clock\\n        self.step = step\\n        self.error = error\\n\\n    def get(self, timeout: float | None = None) -> Any:\\n        if self.clock is not None:\\n            self.clock.t += self.step\\n        if self.error is not None:\\n            raise self.error\\n        if not self.items:\\n            raise queue.Empty\\n        return self.items.pop(0)\\n\\n\\ndef _make_run(items: list, **kw: Any) -> SimpleNamespace:\\n    return SimpleNamespace(\\n        q=ScriptedQueue(items, **kw), err_box=[], proc=SimpleNamespace(pid=424242)\\n    )\\n\\n\\n@pytest.fixture()\\ndef bridge(isolated_claude_bridge, monkeypatch: pytest.MonkeyPatch):\\n    mod = isolated_claude_bridge.mod\\n    FakeController.instances = []\\n    FakeController.verdict = (False, \\\"\\\", None)\\n    killed: list = []\\n    monkeypatch.setattr(mod, \\\"AdaptiveTimeoutController\\\", FakeController)\\n    monkeypatch.setattr(mod, \\\"_kill_group\\\", lambda proc: killed.append(proc))\\n    monkeypatch.setattr(mod, \\\"_client_gone\\\", lambda _sock: False)\\n    monkeypatch.setattr(mod, \\\"_is_watchdog_enabled\\\", lambda: True)\\n    monkeypatch.setattr(mod, \\\"POLL_INTERVAL_S\\\", 0.0)\\n    monkeypatch.setattr(mod, \\\"STDERR_DRAIN_S\\\", 0.0)\\n    return SimpleNamespace(mod=mod, killed=killed)\\n\\n\\ndef _execute(mod: Any, run: Any) -> dict:\\n    handler = mod.Handler.__new__(mod.Handler)\\n    handler.connection = None\\n    sink = lambda *_a: True  # noqa: E731\\n    return handler._execute(run, sink, sink, sink, None, False, None)\\n\\n\\ndef test_claude_p_env_loader_security(isolated_claude_bridge) -> None:\\n    mod = isolated_claude_bridge.mod\\n    env_dir = isolated_claude_bridge.home / \\\".dsh\\\"\\n    env_dir.mkdir(exist_ok=True)\\n    env_file = env_dir / \\\".env\\\"\\n    env_file.write_text(\\n        \\\"\\\\n\\\".join([\\n            \\\"# comment\\\",\\n            \\\"\\\",\\n            \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=111\\\",\\n            \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=222\\\",\\n            \\\"export BRIDGE_SAFETY_CAP_S='1800'\\\",\\n            'CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=\\\"0\\\"',\\n            \\\"CLAUDE_P_BRIDGE_KEY=super-secret\\\",\\n            \\\"OPENAI_API_KEY=[REDACTED]\\\",\\n            \\\"NOT_A_PAIR\\\",\\n        ]) + \\\"\\\\n\\\",\\n        encoding=\\\"utf-8\\\",\\n    )\\n    before = dict(os.environ)\\n    try:\\n        got = mod._read_dsh_env_file()\\n    finally:\\n        env_file.unlink()\\n    assert dict(os.environ) == before  # os.environ не мутирован\\n    assert got == {\\n        \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\\\": \\\"222\\\",  # дубликат — последнее значение\\n        \\\"BRIDGE_SAFETY_CAP_S\\\": \\\"1800\\\",\\n        \\\"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\\\": \\\"0\\\",\\n    }\\n    assert not any(k.endswith(\\\"_KEY\\\") for k in got)\\n    assert \\\"super-secret\\\" not in got.values()\\n    # Без файла — пустой словарь.\\n    assert mod._read_dsh_env_file() == {}\\n\\n\\n@pytest.mark.parametrize(\\\"reason\\\", [\\\"idle_timeout\\\", \\\"absolute_cap\\\"])\\ndef test_watchdog_timeout_trigger(bridge, monkeypatch: pytest.MonkeyPatch, reason: str) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 0.0)\\n    FakeController.verdict = (True, reason, None)\\n    run = _make_run([(\\\"text\\\", \\\"partial\\\"), (\\\"done\\\", 0)])\\n    out = _execute(mod, run)\\n    assert bridge.killed == [run.proc]\\n    assert out[\\\"state\\\"] == \\\"timeout\\\"\\n    assert out[\\\"rc\\\"] == 1\\n    assert reason in out[\\\"err\\\"]\\n    err = mod.Handler._error_body(out)\\n    assert err[\\\"code\\\"] == 504\\n    assert err[\\\"type\\\"] == \\\"upstream_timeout\\\"\\n    assert reason in err[\\\"message\\\"]\\n    (ctl,) = FakeController.instances\\n    assert ctl.registered == [run.proc.pid]\\n    assert ctl.closed\\n\\n\\ndef test_child_exited_no_false_timeout(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 0.0)\\n    FakeController.verdict = (True, \\\"child_exited\\\", None)\\n    run = _make_run([\\n        (\\\"text\\\", \\\"hello\\\"),\\n        (\\\"result\\\", {\\\"usage\\\": {\\\"output_tokens\\\": 1}}),\\n        (\\\"done\\\", 0),\\n    ])\\n    out = _execute(mod, run)\\n    assert bridge.killed == []\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    assert out[\\\"rc\\\"] == 0\\n    assert out[\\\"text\\\"] == \\\"hello\\\"\\n    (ctl,) = FakeController.instances\\n    assert len(ctl.checks) >= 1  # вердикт child_exited получен, но ход не прерван\\n\\n\\ndef test_watchdog_throttle(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    clock = FakeClock()\\n    monkeypatch.setattr(mod, \\\"time\\\", clock)\\n    interval = 3.0\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", interval)\\n    check_ts: list = []\\n    orig_check = FakeController.check\\n\\n    def timed_check(self, pgid=None):\\n        check_ts.append(clock.t)\\n        return orig_check(self, pgid)\\n\\n    monkeypatch.setattr(FakeController, \\\"check\\\", timed_check)\\n    items = [(\\\"text\\\", f\\\"t{i} \\\") for i in range(10)] + [(\\\"done\\\", 0)]\\n    run = _make_run(items, clock=clock, step=1.0)\\n    out = _execute(mod, run)\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    # 11 итераций по 1 с: проверки только на t=3, 6, 9.\\n    assert check_ts == [3.0, 6.0, 9.0]\\n    assert all(b - a >= interval for a, b in zip(check_ts, check_ts[1:]))\\n    assert len(check_ts) <= clock.t / interval\\n\\n\\ndef test_record_activity_calls(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 1e9)\\n    run = _make_run([\\n        (\\\"text\\\", \\\"a\\\"),\\n        (\\\"thinking\\\", \\\"b\\\"),\\n        (\\\"result\\\", {\\\"usage\\\": {}}),\\n        (\\\"done\\\", 0),\\n    ])\\n    out = _execute(mod, run)\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    (ctl,) = FakeController.instances\\n    assert ctl.activity == [\\\"text\\\", \\\"thinking\\\", \\\"result\\\"]\\n    assert ctl.checks == []\\n\\n\\ndef test_controller_closed_in_finally(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 1e9)\\n\\n    # Штатный выход.\\n    out = _execute(mod, _make_run([(\\\"text\\\", \\\"ok\\\"), (\\\"done\\\", 0)]))\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    # Аварийный выход по pump_error.\\n    out = _execute(mod, _make_run([(\\\"pump_error\\\", \\\"boom\\\")]))\\n    assert out[\\\"state\\\"] == \\\"pump_error\\\"\\n    # Исключение внутри цикла.\\n    with pytest.raises(RuntimeError, match=\\\"queue broken\\\"):\\n        _execute(mod, _make_run([], error=RuntimeError(\\\"queue broken\\\")))\\n\\n    assert len(FakeController.instances) == 3\\n    assert all(ctl.closed for ctl in FakeController.instances)\\n\",\n  \"original_output_bytes\": 9766,\n  \"original_output_tokens\": 2442,\n  \"truncated\": false\n}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55b","stream":{"kind":"session","id":"01a19cce-09d5-7de2-8e12-1eacc58dccf4"},"sequence":264,"recorded_at":1780531400000523,"record_type":"event","durability":"durable","causation_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","run_stream":{"kind":"run","id":"01a19cce-0f25-76e1-b45d-25cc5822927d"},"task_stream":{"kind":"task","id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a"},"task_id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a","event":{"kind":"completed","task_id":"01a19ce0-2d8c-7b61-a364-9d9716f0552a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55d","stream":{"kind":"session","id":"01a19cce-09d5-7de2-8e12-1eacc58dccf4"},"sequence":265,"recorded_at":1780531400000525,"record_type":"event","durability":"durable","causation_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","run_stream":{"kind":"run","id":"01a19cce-0f25-76e1-b45d-25cc5822927d"},"call_id":"call_01a19ce026e77725bbb5877f3fb2c07b","text":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"grep -n \\\"STALL_TIMEOUT\\\\|_zen_positive\\\\|AdaptiveTimeout\\\\|watchdog\\\\|BRIDGE_\\\" /tmp/d2.txt | head -n 80; echo =====; cat /tmp/d2.txt | head -n 180\",\n  \"description\": \"Inspect opencode bridge diff\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"5:@@ -344,8 +344,8 @@ def _zen_positive_float(name: str, default: float) -> float:\\n12:+    \\\"\\\"\\\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\\\"\\\"\\\"\\n19:     threshold = _positive_int(os.environ.get(\\\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\\\"), 8192)\\n21:-        return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0))\\n30:+            _zen_positive_float(\\n31:+                \\\"BRIDGE_ZEN_TTFT_TIMEOUT_S\\\",\\n32:+                _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0),\\n42:+    return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_IDLE_TIMEOUT_S\\\", 15.0))\\n46:+    \\\"\\\"\\\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\\\"\\\"\\\"\\n51:+        _zen_positive_float(\\\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\\\", min(180.0, TIMEOUT_S)),\\n110:     os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S\\\", \\\"60.0\\\")\\n112:-STALL_TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\\\", \\\"60.0\\\"))\\n113:+STALL_TIMEOUT_S = _zen_positive_float(\\n114:+    \\\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\\\",\\n204:         watchdog_reason: list[str] = []\\n216:-            if watchdog_reason:\\n217:+            if watchdog_reason or split_timeout[0]:\\n300:                 watchdog_state: _WatchdogState = {\\n320:+                        watchdog_state[\\\"first_token_at\\\"] is None\\n323:+                        watchdog_state[\\\"first_token_at\\\"] is not None\\n326:+                            float(watchdog_state[\\\"last_token_at\\\"]),\\n334:                     if watchdog_state[\\n344:+                            watchdog_state[\\\"last_token_at\\\"] = time.monotonic()\\n345:+                            if watchdog_state[\\\"first_token_at\\\"] is None:\\n346:+                                watchdog_state[\\\"first_token_at\\\"] = time.monotonic()\\n347:                         if watchdog_state[\\\"first_event_at\\\"] is None:\\n348:                             watchdog_state[\\\"first_event_at\\\"] = time.monotonic()\\n=====\\ndiff --git a/bridges/opencode-zen-bridge/server.py b/bridges/opencode-zen-bridge/server.py\\nindex fd1d4c9..9c140eb 100755\\n--- a/bridges/opencode-zen-bridge/server.py\\n+++ b/bridges/opencode-zen-bridge/server.py\\n@@ -344,8 +344,8 @@ def _zen_positive_float(name: str, default: float) -> float:\\n         return default\\n \\n \\n-def _zen_execution_timeout(model: str, prompt: str) -> float:\\n-    \\\"\\\"\\\"Сужение execution deadline только для явно выбранных моделей и большого UTF-8 входа.\\\"\\\"\\\"\\n+def _zen_targeted(model: str, prompt: str) -> bool:\\n+    \\\"\\\"\\\"Целевая модель (BRIDGE_ZEN_TIMEOUT_MODELS) на большом промпте: к ней применяются split-таймауты.\\\"\\\"\\\"\\n     models = {\\n         \\\"deepseek-v4.1-flash-free\\\",\\n         *filter(\\n@@ -353,11 +353,89 @@ def _zen_execution_timeout(model: str, prompt: str) -> float:\\n         ),\\n     }\\n     threshold = _positive_int(os.environ.get(\\\"BRIDGE_ZEN_LARGE_PROMPT_BYTES\\\"), 8192)\\n-    if model in models and len(prompt.encode(\\\"utf-8\\\")) > threshold:\\n-        return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0))\\n+    return model in models and len(prompt.encode(\\\"utf-8\\\")) > threshold\\n+\\n+\\n+def _zen_ttft_timeout(model: str, prompt: str) -> float:\\n+    \\\"\\\"\\\"Сужение таймаута до первого токена (TTFT) только для целевых моделей на большом промпте.\\\"\\\"\\\"\\n+    if _zen_targeted(model, prompt):\\n+        return min(\\n+            TIMEOUT_S,\\n+            _zen_positive_float(\\n+                \\\"BRIDGE_ZEN_TTFT_TIMEOUT_S\\\",\\n+                _zen_positive_float(\\\"BRIDGE_ZEN_TIMEOUT_S\\\", 25.0),\\n+            ),\\n+        )\\n     return TIMEOUT_S\\n \\n \\n+def _zen_idle_timeout(model: str, prompt: str) -> float:\\n+    \\\"\\\"\\\"Таймаут неактивности между чанками после первого токена; только для целевых моделей.\\\"\\\"\\\"\\n+    if not _zen_targeted(model, prompt):\\n+        return TIMEOUT_S\\n+    return min(TIMEOUT_S, _zen_positive_float(\\\"BRIDGE_ZEN_IDLE_TIMEOUT_S\\\", 15.0))\\n+\\n+\\n+def _zen_total_timeout(model: str, prompt: str) -> float:\\n+    \\\"\\\"\\\"Общий дедлайн запроса: для целевых моделей BRIDGE_ZEN_TOTAL_TIMEOUT_S (180 с), иначе TIMEOUT_S.\\\"\\\"\\\"\\n+    if not _zen_targeted(model, prompt):\\n+        return TIMEOUT_S\\n+    return min(\\n+        TIMEOUT_S,\\n+        _zen_positive_float(\\\"BRIDGE_ZEN_TOTAL_TIMEOUT_S\\\", min(180.0, TIMEOUT_S)),\\n+    )\\n+\\n+\\n+def _zen_execution_timeout(model: str, prompt: str) -> float:\\n+    \\\"\\\"\\\"Обратная совместимость: TTFT-таймаут для целевых моделей, иначе TIMEOUT_S.\\\"\\\"\\\"\\n+    return _zen_ttft_timeout(model, prompt)\\n+\\n+\\n+def _zen_idle_expired(\\n+    now: float, last_token_at: float, idle_timeout: float, tools_active: bool\\n+) -> bool:\\n+    \\\"\\\"\\\"Idle-таймаут между чанками; не применяется, пока исполняется tool/сабагент (остаются stall и total).\\\"\\\"\\\"\\n+    return not tools_active and now - last_token_at >= idle_timeout\\n+\\n+\\n+class _ToolActivity:\\n+    \\\"\\\"\\\"Активные tool/сабагент по событиям `opencode run`: единое условие освобождения от Idle.\\\"\\\"\\\"\\n+\\n+    def __init__(self) -> None:\\n+        self._running: set[str] = set()\\n+        self._anonymous = 0\\n+\\n+    def observe(self, etype: str, event: object) -> None:\\n+        \\\"\\\"\\\"Учесть tool_use/tool_call: pending/running — активен, иной статус — завершён.\\\"\\\"\\\"\\n+        if etype not in (\\\"tool_use\\\", \\\"tool_call\\\"):\\n+            return\\n+        part = _as_dict(_as_dict(event).get(\\\"part\\\"))\\n+        call_id = str(part.get(\\\"callID\\\") or part.get(\\\"id\\\") or \\\"\\\")\\n+        status = _as_dict(part.get(\\\"state\\\")).get(\\\"status\\\")\\n+        running = status in (\\\"pending\\\", \\\"running\\\")\\n+        if call_id:\\n+            if running:\\n+                self._running.add(call_id)\\n+            else:\\n+                self._running.discard(call_id)\\n+            return\\n+        # Без callID/id параллельные вызовы одного tool не схлопываем: ведём счётчик активных.\\n+        if running:\\n+            self._anonymous += 1\\n+        elif self._anonymous:\\n+            self._anonymous -= 1\\n+\\n+    def __bool__(self) -> bool:\\n+        return bool(self._running) or self._anonymous > 0\\n+\\n+\\n+def _attempts_t0(attempts: Any, model: str, prompt: str) -> float:\\n+    \\\"\\\"\\\"Момент старта запроса: attempts.t0, а для совместимых заглушек — выводим из deadline.\\\"\\\"\\\"\\n+    if hasattr(attempts, \\\"t0\\\"):\\n+        return attempts.t0\\n+    return attempts.deadline - _zen_total_timeout(model, prompt)\\n+\\n+\\n def _zen_error(status: int) -> dict[str, Any]:\\n     \\\"\\\"\\\"Согласованный контракт ошибок zen, одинаковый для JSON и terminal SSE.\\\"\\\"\\\"\\n     message, kind = (\\n@@ -1865,7 +1943,10 @@ FIRST_EVENT_TIMEOUT_S = float(\\n FIRST_TOKEN_TIMEOUT_S = float(\\n     os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S\\\", \\\"60.0\\\")\\n )\\n-STALL_TIMEOUT_S = float(os.environ.get(\\\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\\\", \\\"60.0\\\"))\\n+STALL_TIMEOUT_S = _zen_positive_float(\\n+    \\\"OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S\\\",\\n+    60.0,\\n+)\\n FIRST_STATUS_DELAY_S = 0.65\\n STATUS_WAITING_INTERVAL_S = 5.0\\n STALL_HEARTBEAT_INTERVAL_S = 15.0\\n@@ -2946,6 +3027,7 @@ class _RequestAttempts:\\n         max_quota_rotations: int | None = None,\\n     ) -> None:\\n         self.res = res\\n+        self.t0 = time.monotonic()\\n         self.deadline = deadline\\n         self.use_breaker = (\\n             use_breaker  # False: прямой Google-маршрут без `opencode run`\\n@@ -3777,6 +3859,10 @@ class _ServeToolState:\\n         if isinstance(input_value, dict):\\n             item[\\\"input\\\"] = _as_dict(input_value)\\n \\n+    def has_active(self) -> bool:\\n+        \\\"\\\"\\\"Есть вызов, начатый (feed), но ещё не завершённый (complete): tool исполняется.\\\"\\\"\\\"\\n+        return any(call_id not in self.emitted for call_id in self.tools)\\n+\\n     def complete(\\n         self, call_id: str, event_type: str = \\\"\\\"\\n     ) -> tuple[str, dict[str, object]] | None:\\n@@ -4775,6 +4861,8 @@ def _serve_one_attempt(\\n         status_next = max(t0 + FIRST_STATUS_DELAY_S, prompt_send_start + 0.25)\\n         _status_emitted = [0]\\n         last_token_at = prompt_send_start\\n+        ttft_timeout = _zen_ttft_timeout(model, prompt)\\n+        idle_timeout = _zen_idle_timeout(model, prompt)\\n         while time.monotonic() < deadline:\\n             if is_client_gone is not None and is_client_gone():\\n                 result[\\\"exit_reason\\\"] = \\\"client_gone\\\"\\n@@ -4783,6 +4871,20 @@ def _serve_one_attempt(\\n                 result[\\\"exit_reason\\\"] = \\\"invalid_serve_event\\\"\\n                 return result\\n             now = time.monotonic()\\n+            # Раздельные таймауты: TTFT до первого токена, Idle между чанками после него.\\n+            if (\\n+                result[\\\"first_token_at\\\"] is None\\n+                and not tool_state.has_active()\\n+                and now - prompt_send_start >= ttft_timeout\\n+            ) or (\\n+                result[\\\"first_token_at\\\"] is not None\\n+                and _zen_idle_expired(\\n+                    now, last_token_at, idle_timeout, tool_state.has_active()\\n+                )\\n+            ):\\n+                result[\\\"exit_reason\\\"] = \\\"timeout\\\"\\n+                result[\\\"delivered\\\"] = _is_delivered()\\n+                break\\n             if prompt_status.get(\\\"aux_exhausted\\\") or (\\n                 result[\\\"first_event_at\\\"] is None and now >= first_event_deadline\\n             ):\\n@@ -4967,6 +5069,13 @@ def _serve_one_attempt(\\n                     last_token_at = time.monotonic()\\n                     on_text(text_value)\\n             elif etype == \\\"tool_event\\\":\\n+                if result[\\\"first_token_at\\\"] is None:\\n+                    # Генерация аргументов tool — это уже вывод модели: TTFT не должен её обрывать.\\n+                    result[\\\"first_token_at\\\"] = time.monotonic()\\n+                    result[\\\"ttft_ms\\\"] = int(\\n+                        ((result[\\\"first_token_at\\\"] or 0.0) - t0) * 1000\\n+                    )\\n+                    last_token_at = result[\\\"first_token_at\\\"]\\n                 if etype_raw == \\\"session.tool.input.delta\\\":\\n\",\n  \"original_output_bytes\": 10534,\n  \"original_output_tokens\": 2634,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a19cce-09d5-7de2-8e12-1eacc58dccf4"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","run_stream":{"kind":"run","id":"01a19cce-0f25-76e1-b45d-25cc5822927d"},"call_id":"call_01a19ce027cf7358acdd9368b8a82bb7","text":"{\n  \"chunk_id\": \"exec-8-1\",\n  \"command\": \"cat /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_claude_p_watchdog.py\",\n  \"description\": \"Read new watchdog tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\\"\\\"\\\"Скользящее окно активности claude-p-bridge (AD-001..AD-004).\\n\\nПокрытие: whitelist-чтение ~/.dsh/.env без мутации os.environ, срабатывание\\nвотчдога (`idle_timeout`/`absolute_cap` -> kill + 504), отсутствие ложного\\nтаймаута на `child_exited`, троттлинг `check()` по `watchdog_interval_s`,\\nсброс таймера простоя на полезных событиях и закрытие контроллера в finally.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport importlib.util\\nimport os\\nimport queue\\nimport sys\\nimport uuid\\nfrom pathlib import Path\\nfrom types import SimpleNamespace\\nfrom typing import Any\\n\\nimport pytest\\n\\nREPO = Path(__file__).resolve().parent.parent\\nBRIDGE_SERVER = REPO / \\\"bridges\\\" / \\\"claude-p-bridge\\\" / \\\"server.py\\\"\\n_ENV_PREFIXES = (\\\"CLAUDE_P_BRIDGE_\\\", \\\"BRIDGE_\\\")\\n\\n\\n@pytest.fixture(scope=\\\"module\\\")\\ndef isolated_claude_bridge(tmp_path_factory: pytest.TempPathFactory):\\n    \\\"\\\"\\\"Загружает мост с изолированным HOME и без внешних CLAUDE_P_BRIDGE_*/BRIDGE_* env.\\\"\\\"\\\"\\n    home = tmp_path_factory.mktemp(\\\"claude-p-home\\\")\\n    name = f\\\"claude_p_bridge_watchdog_{uuid.uuid4().hex}\\\"\\n    with pytest.MonkeyPatch.context() as mp:\\n        mp.setenv(\\\"HOME\\\", str(home))\\n        for key in list(os.environ):\\n            if key.startswith(_ENV_PREFIXES):\\n                mp.delenv(key, raising=False)\\n        spec = importlib.util.spec_from_file_location(name, BRIDGE_SERVER)\\n        assert spec is not None and spec.loader is not None\\n        mod = importlib.util.module_from_spec(spec)\\n        sys.modules[name] = mod\\n        try:\\n            spec.loader.exec_module(mod)\\n            yield SimpleNamespace(mod=mod, home=home)\\n        finally:\\n            sys.modules.pop(name, None)\\n\\n\\nclass FakeController:\\n    \\\"\\\"\\\"Фейковый AdaptiveTimeoutController: скриптованный check() и журнал вызовов.\\\"\\\"\\\"\\n\\n    instances: list = []\\n    verdict: tuple = (False, \\\"\\\", None)\\n\\n    def __init__(self, idle_timeout_s, safety_cap_s, io_wait_cap_s, watchdog_interval_s):\\n        self.idle_timeout_s = idle_timeout_s\\n        self.safety_cap_s = safety_cap_s\\n        self.io_wait_cap_s = io_wait_cap_s\\n        self.watchdog_interval_s = watchdog_interval_s\\n        self.registered: list = []\\n        self.checks: list = []\\n        self.activity: list = []\\n        self.closed = False\\n        type(self).instances.append(self)\\n\\n    def register_pgid(self, pgid: int) -> None:\\n        self.registered.append(pgid)\\n\\n    def check(self, pgid: int | None = None) -> tuple:\\n        self.checks.append(pgid)\\n        return type(self).verdict\\n\\n    def record_activity(self, kind: str = \\\"protocol\\\") -> None:\\n        self.activity.append(kind)\\n\\n    def close(self) -> None:\\n        self.closed = True\\n\\n\\nclass FakeClock:\\n    def __init__(self) -> None:\\n        self.t = 0.0\\n\\n    def monotonic(self) -> float:\\n        return self.t\\n\\n    def sleep(self, _s: float) -> None:\\n        return None\\n\\n\\nclass ScriptedQueue:\\n    \\\"\\\"\\\"Очередь хода: каждый get() сдвигает фейковые часы на `step` секунд.\\\"\\\"\\\"\\n\\n    def __init__(self, items: list, clock: FakeClock | None = None, step: float = 0.0,\\n                 error: Exception | None = None) -> None:\\n        self.items = list(items)\\n        self.clock = clock\\n        self.step = step\\n        self.error = error\\n\\n    def get(self, timeout: float | None = None) -> Any:\\n        if self.clock is not None:\\n            self.clock.t += self.step\\n        if self.error is not None:\\n            raise self.error\\n        if not self.items:\\n            raise queue.Empty\\n        return self.items.pop(0)\\n\\n\\ndef _make_run(items: list, **kw: Any) -> SimpleNamespace:\\n    return SimpleNamespace(\\n        q=ScriptedQueue(items, **kw), err_box=[], proc=SimpleNamespace(pid=424242)\\n    )\\n\\n\\n@pytest.fixture()\\ndef bridge(isolated_claude_bridge, monkeypatch: pytest.MonkeyPatch):\\n    mod = isolated_claude_bridge.mod\\n    FakeController.instances = []\\n    FakeController.verdict = (False, \\\"\\\", None)\\n    killed: list = []\\n    monkeypatch.setattr(mod, \\\"AdaptiveTimeoutController\\\", FakeController)\\n    monkeypatch.setattr(mod, \\\"_kill_group\\\", lambda proc: killed.append(proc))\\n    monkeypatch.setattr(mod, \\\"_client_gone\\\", lambda _sock: False)\\n    monkeypatch.setattr(mod, \\\"_is_watchdog_enabled\\\", lambda: True)\\n    monkeypatch.setattr(mod, \\\"POLL_INTERVAL_S\\\", 0.0)\\n    monkeypatch.setattr(mod, \\\"STDERR_DRAIN_S\\\", 0.0)\\n    return SimpleNamespace(mod=mod, killed=killed)\\n\\n\\ndef _execute(mod: Any, run: Any) -> dict:\\n    handler = mod.Handler.__new__(mod.Handler)\\n    handler.connection = None\\n    sink = lambda *_a: True  # noqa: E731\\n    return handler._execute(run, sink, sink, sink, None, False, None)\\n\\n\\ndef test_claude_p_env_loader_security(isolated_claude_bridge) -> None:\\n    mod = isolated_claude_bridge.mod\\n    env_dir = isolated_claude_bridge.home / \\\".dsh\\\"\\n    env_dir.mkdir(exist_ok=True)\\n    env_file = env_dir / \\\".env\\\"\\n    env_file.write_text(\\n        \\\"\\\\n\\\".join([\\n            \\\"# comment\\\",\\n            \\\"\\\",\\n            \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=111\\\",\\n            \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S=222\\\",\\n            \\\"export BRIDGE_SAFETY_CAP_S='1800'\\\",\\n            'CLAUDE_P_BRIDGE_WATCHDOG_ENABLED=\\\"0\\\"',\\n            \\\"CLAUDE_P_BRIDGE_KEY=super-secret\\\",\\n            \\\"OPENAI_API_KEY=[REDACTED]\\\",\\n            \\\"NOT_A_PAIR\\\",\\n        ]) + \\\"\\\\n\\\",\\n        encoding=\\\"utf-8\\\",\\n    )\\n    before = dict(os.environ)\\n    try:\\n        got = mod._read_dsh_env_file()\\n    finally:\\n        env_file.unlink()\\n    assert dict(os.environ) == before  # os.environ не мутирован\\n    assert got == {\\n        \\\"CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S\\\": \\\"222\\\",  # дубликат — последнее значение\\n        \\\"BRIDGE_SAFETY_CAP_S\\\": \\\"1800\\\",\\n        \\\"CLAUDE_P_BRIDGE_WATCHDOG_ENABLED\\\": \\\"0\\\",\\n    }\\n    assert not any(k.endswith(\\\"_KEY\\\") for k in got)\\n    assert \\\"super-secret\\\" not in got.values()\\n    # Без файла — пустой словарь.\\n    assert mod._read_dsh_env_file() == {}\\n\\n\\n@pytest.mark.parametrize(\\\"reason\\\", [\\\"idle_timeout\\\", \\\"absolute_cap\\\"])\\ndef test_watchdog_timeout_trigger(bridge, monkeypatch: pytest.MonkeyPatch, reason: str) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 0.0)\\n    FakeController.verdict = (True, reason, None)\\n    run = _make_run([(\\\"text\\\", \\\"partial\\\"), (\\\"done\\\", 0)])\\n    out = _execute(mod, run)\\n    assert bridge.killed == [run.proc]\\n    assert out[\\\"state\\\"] == \\\"timeout\\\"\\n    assert out[\\\"rc\\\"] == 1\\n    assert reason in out[\\\"err\\\"]\\n    err = mod.Handler._error_body(out)\\n    assert err[\\\"code\\\"] == 504\\n    assert err[\\\"type\\\"] == \\\"upstream_timeout\\\"\\n    assert reason in err[\\\"message\\\"]\\n    (ctl,) = FakeController.instances\\n    assert ctl.registered == [run.proc.pid]\\n    assert ctl.closed\\n\\n\\ndef test_child_exited_no_false_timeout(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 0.0)\\n    FakeController.verdict = (True, \\\"child_exited\\\", None)\\n    run = _make_run([\\n        (\\\"text\\\", \\\"hello\\\"),\\n        (\\\"result\\\", {\\\"usage\\\": {\\\"output_tokens\\\": 1}}),\\n        (\\\"done\\\", 0),\\n    ])\\n    out = _execute(mod, run)\\n    assert bridge.killed == []\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    assert out[\\\"rc\\\"] == 0\\n    assert out[\\\"text\\\"] == \\\"hello\\\"\\n    (ctl,) = FakeController.instances\\n    assert len(ctl.checks) >= 1  # вердикт child_exited получен, но ход не прерван\\n\\n\\ndef test_watchdog_throttle(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    clock = FakeClock()\\n    monkeypatch.setattr(mod, \\\"time\\\", clock)\\n    interval = 3.0\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", interval)\\n    check_ts: list = []\\n    orig_check = FakeController.check\\n\\n    def timed_check(self, pgid=None):\\n        check_ts.append(clock.t)\\n        return orig_check(self, pgid)\\n\\n    monkeypatch.setattr(FakeController, \\\"check\\\", timed_check)\\n    items = [(\\\"text\\\", f\\\"t{i} \\\") for i in range(10)] + [(\\\"done\\\", 0)]\\n    run = _make_run(items, clock=clock, step=1.0)\\n    out = _execute(mod, run)\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    # 11 итераций по 1 с: проверки только на t=3, 6, 9.\\n    assert check_ts == [3.0, 6.0, 9.0]\\n    assert all(b - a >= interval for a, b in zip(check_ts, check_ts[1:]))\\n    assert len(check_ts) <= clock.t / interval\\n\\n\\ndef test_record_activity_calls(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 1e9)\\n    run = _make_run([\\n        (\\\"text\\\", \\\"a\\\"),\\n        (\\\"thinking\\\", \\\"b\\\"),\\n        (\\\"result\\\", {\\\"usage\\\": {}}),\\n        (\\\"done\\\", 0),\\n    ])\\n    out = _execute(mod, run)\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    (ctl,) = FakeController.instances\\n    assert ctl.activity == [\\\"text\\\", \\\"thinking\\\", \\\"result\\\"]\\n    assert ctl.checks == []\\n\\n\\ndef test_controller_closed_in_finally(bridge, monkeypatch: pytest.MonkeyPatch) -> None:\\n    mod = bridge.mod\\n    monkeypatch.setattr(mod, \\\"CLAUDE_P_BRIDGE_WATCHDOG_INTERVAL_S\\\", 1e9)\\n\\n    # Штатный выход.\\n    out = _execute(mod, _make_run([(\\\"text\\\", \\\"ok\\\"), (\\\"done\\\", 0)]))\\n    assert out[\\\"state\\\"] == \\\"done\\\"\\n    # Аварийный выход по pump_error.\\n    out = _execute(mod, _make_run([(\\\"pump_error\\\", \\\"boom\\\")]))\\n    assert out[\\\"state\\\"] == \\\"pump_error\\\"\\n    # Исключение внутри цикла.\\n    with pytest.raises(RuntimeError, match=\\\"queue broken\\\"):\\n        _execute(mod, _make_run([], error=RuntimeError(\\\"queue broken\\\")))\\n\\n    assert len(FakeController.instances) == 3\\n    assert all(ctl.closed for ctl in FakeController.instances)\\n\",\n  \"original_output_bytes\": 9766,\n  \"original_output_tokens\": 2442,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
