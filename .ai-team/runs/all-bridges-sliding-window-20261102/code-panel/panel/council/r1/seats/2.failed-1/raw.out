{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c505","stream":{"kind":"session","id":"01a19cce-09d5-7de2-8e12-1eacc58dccf4"},"sequence":221,"recorded_at":1780531400000437,"record_type":"event","durability":"durable","causation_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19cce-0f25-76e1-b45d-25cc5822927d","run_stream":{"kind":"run","id":"01a19cce-0f25-76e1-b45d-25cc5822927d"},"task_stream":{"kind":"task","id":"01a19cdd-0772-7621-afba-be11c5aa0b3e"},"task_id":"01a19cdd-0772-7621-afba-be11c5aa0b3e","event":{"kind":"output","task_id":"01a19cdd-0772-7621-afba-be11c5aa0b3e","chunk":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"cat /tmp/d3.txt; echo =====D4=====; cat /tmp/d4.txt; echo =====DW head=====; head -n 100 /tmp/dw.txt\",\n  \"description\": \"Read server diffs and watchdog diff\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"diff --git a/server.py b/server.py\\nindex feda0ba..6d4eb41 100644\\n--- a/server.py\\n+++ b/server.py\\n@@ -392,17 +392,18 @@ SAFETY_CAP_S = positive_env(\\n # socket-таймаута соединения) — зависший/нечитающий клиент не держит T/L (см. sse_writer в\\n # _serve_sse и add_content/add_reasoning в Handler._execute).\\n def parse_live_write_timeout(default: float = 30.0) -> float:\\n-    \\\"\\\"\\\"Читает таймаут записи, возвращая default при неверном значении ENV.\\\"\\\"\\\"\\n-    raw = os.environ.get(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", \\\"\\\").strip()\\n-    if not raw:\\n-        return default\\n-    try:\\n-        val = float(raw)\\n-        if not (1.0 <= val <= 300.0):\\n-            return default\\n-        return val\\n-    except (ValueError, TypeError):\\n-        return default\\n+    \\\"\\\"\\\"Читает таймаут записи, поддерживая BRIDGE_CLIENT_WRITE_TIMEOUT_S с fallback на DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S.\\\"\\\"\\\"\\n+    for key in (\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", \\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\"):\\n+        raw = os.environ.get(key, \\\"\\\").strip()\\n+        if not raw:\\n+            continue\\n+        try:\\n+            val = float(raw)\\n+            if 1.0 <= val <= 300.0:\\n+                return val\\n+        except (ValueError, TypeError):\\n+            continue\\n+    return default\\n \\n \\n LIVE_WRITE_TIMEOUT_S: float = parse_live_write_timeout(30.0)\\n=====D4=====\\ndiff --git a/tests/test_stream_timeout_config.py b/tests/test_stream_timeout_config.py\\nindex d8bcc18..00b350a 100644\\n--- a/tests/test_stream_timeout_config.py\\n+++ b/tests/test_stream_timeout_config.py\\n@@ -11,6 +11,7 @@ import server\\n def test_live_write_timeout_default(\\n     monkeypatch: pytest.MonkeyPatch, raw: str | None\\n ) -> None:\\n+    monkeypatch.delenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", raising=False)\\n     if raw is None:\\n         monkeypatch.delenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", raising=False)\\n     else:\\n@@ -24,6 +25,7 @@ def test_live_write_timeout_default(\\n def test_live_write_timeout_valid(\\n     monkeypatch: pytest.MonkeyPatch, raw: str, expected: float\\n ) -> None:\\n+    monkeypatch.delenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", raising=False)\\n     monkeypatch.setenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", raw)\\n     assert server.parse_live_write_timeout() == expected\\n \\n@@ -32,6 +34,27 @@ def test_live_write_timeout_valid(\\n     \\\"raw\\\", [\\\"0\\\", \\\"-1\\\", \\\"0.99\\\", \\\"300.01\\\", \\\"inf\\\", \\\"-inf\\\", \\\"nan\\\", \\\"invalid\\\"]\\n )\\n def test_live_write_timeout_fallback(monkeypatch: pytest.MonkeyPatch, raw: str) -> None:\\n+    monkeypatch.delenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", raising=False)\\n     monkeypatch.setenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", raw)\\n     assert server.parse_live_write_timeout() == 30.0\\n     assert server.parse_live_write_timeout(12.0) == 12.0\\n+\\n+\\n+def test_live_write_timeout_priority(monkeypatch: pytest.MonkeyPatch) -> None:\\n+    \\\"\\\"\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S приоритетнее legacy DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S.\\\"\\\"\\\"\\n+    # Валидный общий ключ побеждает legacy.\\n+    monkeypatch.setenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", \\\"45\\\")\\n+    monkeypatch.setenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", \\\"60\\\")\\n+    assert server.parse_live_write_timeout() == 45.0\\n+\\n+    # Невалидный общий ключ -> валидный legacy.\\n+    for bad in (\\\"invalid\\\", \\\"0\\\", \\\"500\\\", \\\"nan\\\"):\\n+        monkeypatch.setenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", bad)\\n+        monkeypatch.setenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", \\\"60\\\")\\n+        assert server.parse_live_write_timeout() == 60.0\\n+\\n+    # Оба невалидны -> default.\\n+    monkeypatch.setenv(\\\"BRIDGE_CLIENT_WRITE_TIMEOUT_S\\\", \\\"invalid\\\")\\n+    monkeypatch.setenv(\\\"DROID_BRIDGE_LIVE_WRITE_TIMEOUT_S\\\", \\\"-1\\\")\\n+    assert server.parse_live_write_timeout() == 30.0\\n+    assert server.parse_live_write_timeout(12.0) == 12.0\\n=====DW head=====\\ndiff --git a/core/watchdog.py b/core/watchdog.py\\nindex 78c369b..23f61cf 100644\\n--- a/core/watchdog.py\\n+++ b/core/watchdog.py\\n@@ -17,7 +17,8 @@\\n from __future__ import annotations\\n \\n from collections.abc import Callable\\n-from dataclasses import dataclass\\n+from dataclasses import dataclass, field\\n+import math\\n import os\\n import re\\n import subprocess\\n@@ -35,6 +36,23 @@ DEFAULT_SAFETY_CAP_S: float = SAFETY_CAP_S\\n DEFAULT_FINISH_RESERVE_S: float = FINISH_RESERVE_S\\n \\n \\n+def positive_env(name: str, default: float) -> float:\\n+    \\\"\\\"\\\"Читает конечное положительное число, сохраняя безопасный fallback.\\\"\\\"\\\"\\n+    try:\\n+        value = float(os.environ.get(name, str(default)))\\n+    except (TypeError, ValueError, OverflowError):\\n+        return default\\n+    return value if math.isfinite(value) and value > 0 else default\\n+\\n+\\n+def io_grace_enabled() -> bool:\\n+    \\\"\\\"\\\"Читает явный булев переключатель; некорректное значение даёт дефолт true.\\\"\\\"\\\"\\n+    value = os.environ.get(\\\"BRIDGE_IO_GRACE_ENABLED\\\", \\\"true\\\").strip().lower()\\n+    if value in (\\\"0\\\", \\\"false\\\", \\\"no\\\", \\\"off\\\"):\\n+        return False\\n+    return True\\n+\\n+\\n _PS_LINE_RE = re.compile(\\n     r\\\"^\\\\s*(\\\\d+)\\\\s+(\\\\d+)\\\\s+(\\\\d+)\\\\s+(\\\\S+)\\\\s+(\\\\S+)\\\\s*(.*)$\\\"\\n )\\n@@ -86,6 +104,15 @@ class WatchdogMetrics:\\n     cpu_delta_s: float\\n     ps_degraded: bool = False\\n     sample_ts: float = 0.0\\n+    states: list[str] = field(default_factory=list)\\n+\\n+    def is_waiting_io(self) -> bool:\\n+        \\\"\\\"\\\"Живая группа ожидает I/O; учитывается первая буква stat без флагов ps.\\\"\\\"\\\"\\n+        return (\\n+            self.alive\\n+            and not self.ps_degraded\\n+            and any(state[:1].upper() in {\\\"S\\\", \\\"D\\\", \\\"I\\\", \\\"U\\\"} for state in self.states)\\n+        )\\n \\n     @property\\n     def has_progress(self) -> bool:\\n@@ -156,11 +183,11 @@ class ProcessWatchdog:\\n \\n     def _parse_ps_output(\\n         self, stdout: str, target_pgid: int\\n-    ) -> tuple[list[int], dict[int, float], bool]:\\n-        \\\"\\\"\\\"Возвращает `(descendant_pids, cpu_by_pid, any_non_zombie_in_group)`.\\\"\\\"\\\"\\n+    ) -> tuple[list[int], dict[int, float], list[str]]:\\n+        \\\"\\\"\\\"Возвращает PID, CPU и реальные состояния незавершённых членов группы.\\\"\\\"\\\"\\n         descendants: list[int] = []\\n         cpu_by_pid: dict[int, float] = {}\\n-        any_alive_proc = False\\n+        states: list[str] = []\\n         for raw_line in (stdout or \\\"\\\").splitlines():\\n             line = raw_line.strip()\\n             if not line:\\n@@ -178,18 +205,16 @@ class ProcessWatchdog:\\n                 continue\\n             stat = match.group(4) or \\\"\\\"\\n             cputime_str = match.group(5) or \\\"\\\"\\n-            if stat.upper().startswith(\\\"Z\\\"):\\n+            if stat[:1].upper() in {\\\"Z\\\", \\\"X\\\"}:\\n                 continue\\n-            any_alive_proc = True\\n+            states.append(stat)\\n             cpu_by_pid[pid] = parse_cputime(cputime_str)\\n             if pid != target_pgid:\\n                 descendants.append(pid)\\n         descendants.sort()\\n-        return descendants, cpu_by_pid, any_alive_proc\\n+        return descendants, cpu_by_pid, states\\n \\n-    def seed(\\n-        self, pgid: int, *, rid: str = \\\"\\\", turn_id: str = \\\"\\\"\\n-    ) -> WatchdogMetrics:\\n+    def seed(self, pgid: int, *, rid: str = \\\"\\\", turn_id: str = \\\"\\\") -> WatchdogMetrics:\\n         \\\"\\\"\\\"Фиксирует базовый срез PID и cputime группы при старте хода без сброса таймера.\\\"\\\"\\\"\\n         metrics = self.sample(pgid, rid=rid, turn_id=turn_id, _seed_only=True)\\n         return metrics\\n@@ -274,8 +299,8 @@ class ProcessWatchdog:\\n                 sample_ts=now,\\n             )\\n \\n-        descendants, cpu_s, any_alive = self._parse_ps_output(proc.stdout, pgid)\\n-        if not any_alive and not self.is_group_alive(pgid):\\n+        descendants, cpu_s, states = self._parse_ps_output(proc.stdout, pgid)\\n+        if not states and not self.is_group_alive(pgid):\\n\",\n  \"original_output_bytes\": 7941,\n  \"original_output_tokens\": 1986,\n  \"truncated\": false\n}","final_result":true}}}
