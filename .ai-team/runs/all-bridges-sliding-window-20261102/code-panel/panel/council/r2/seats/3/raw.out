360:    \\\"\\\"\\\"Контроллер двухконтурного таймаута хода (`idle_timeout` + `absolute_cap`).\\\"\\\"\\\"\\n362:    def __init__(\\n364:        idle_timeout_s: float = IDLE_TIMEOUT_S,\\n381:        self.idle_timeout_s = max(\\n382:            10.0, float(idle_timeout_s), 2 * self.watchdog_interval_s\\n410:        self.last_activity_ts: float = now\\n411:        self.last_activity_kind: str = \\\"start\\\"\\n416:        \\\"\\\"\\\"Эффективный бюджет времени до срабатывания `absolute_cap`.\\\"\\\"\\\"\\n421:    def record_activity(self, kind: str = \\\"protocol\\\") -> None:\\n425:            self.last_activity_ts = now\\n426:            self.last_activity_kind = kind or \\\"protocol\\\"\\n441:    def check(\\n448:        - `\\\"absolute_cap\\\"` — превышен предохранительный потолок `SAFETY_CAP_S`;\\n449:        - `\\\"idle_timeout\\\"` — превышен порог неактивности `IDLE_TIMEOUT_S`;\\n459:                self.terminated_reason = \\\"absolute_cap\\\"\\n460:            return True, \\\"absolute_cap\\\", None\\n478:                    self.last_activity_ts = now\\n479:                    self.last_activity_kind = (\\n486:            idle_elapsed = now - self.last_activity_ts\\n487:            if idle_elapsed >= self.idle_timeout_s and not self.has_io_grace(\\n490:                self.terminated_reason = \\\"idle_timeout\\\"\\n491:                return True, \\\"idle_timeout\\\", metrics\\n498:        \\\"\\\"\\\"Даёт ограниченную отсрочку I/O без подмены last_activity_ts.\\\"\\\"\\\"\\n=== claude-p defaults ===\\n177:CLAUDE_P_BRIDGE_IDLE_TIMEOUT_S = _get_positive_float(\\n180:CLAUDE_P_BRIDGE_IO_WAIT_CAP_S = _get_positive_float(\\n183:CLAUDE_P_BRIDGE_SAFETY_CAP_S = _get_positive_float(\\n276:POLL_INTERVAL_S = float(os.environ.get(\\\"CLAUDE_P_BRIDGE_POLL_INTERVAL_S\\\", \\\"1\\\"))\\n=== candidate diff stat ===\\n bridges/claude-p-bridge/server.py     | 197 +++++++++++++++++++++++++++------\\n bridges/opencode-zen-bridge/server.py | 198 ++++++++++++++++++++++++++++++-