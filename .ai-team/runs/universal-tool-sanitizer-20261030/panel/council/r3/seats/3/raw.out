{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py | sed -n '725,752p'; nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_tool_sanitizer.py | sed -n '105,132p'\"","aggregated_output":"   725\t    return list(required) if isinstance(required, list) else []\n   726\t\n   727\t\n   728\tdef _is_blank(value: Any) -> bool:\n   729\t    return isinstance(value, str) and value.strip() == \"\"\n   730\t\n   731\t\n   732\tdef _sanitize_arguments_dict(args: dict, required: list | None) -> dict:\n   733\t    \"\"\"Очистка пустых строк в аргументах; исходный словарь не меняется.\"\"\"\n   734\t    cleaned = dict(args)\n   735\t    for key in list(cleaned):\n   736\t        value = cleaned[key]\n   737\t        if not _is_blank(value):\n   738\t            continue\n   739\t        if key in ROUTE_FIELDS:\n   740\t            del cleaned[key]  # пустой маршрут — потребитель берёт дефолтный\n   741\t        elif key == \"justification\":\n   742\t            permissions = args.get(\"sandbox_permissions\")\n   743\t            if permissions is not None and not _is_blank(permissions):\n   744\t                cleaned[key] = JUSTIFICATION_FALLBACK\n   745\t            else:\n   746\t                del cleaned[key]\n   747\t        elif required is not None and key not in required:\n   748\t            del cleaned[key]\n   749\t    return cleaned\n   750\t\n   751\t\n   752\tdef _sanitize_arguments(name: str, arguments: Any, tool_schemas: dict | None) -> Any:\n   105\t\n   106\t    def test_original_call_is_not_mutated(self):\n   107\t        source = as_dict(\"subagent\", {\"provider\": \"\", \"prompt\": \"p\"})\n   108\t        before = json.dumps(source, sort_keys=True)\n   109\t        sanitize_tool_call(source)\n   110\t        self.assertEqual(json.dumps(source, sort_keys=True), before)\n   111\t\n   112\t\n   113\tclass TestJustification(Sanitiz