mmand\\\":\\\"ls\\\",\\\"sandbox_permissions\\\":\\\"\\\",\\\"justification\\\":\\\"\\\"}))))\\n# 5) justification required в схеме, без sandbox\\ns2={\\\"bash\\\":{\\\"parameters\\\":{\\\"required\\\":[\\\"command\\\",\\\"justification\\\"]}}}\\nprint(\\\"required-just:\\\", out(sanitize_tool_call(mk(\\\"bash\\\",{\\\"command\\\":\\\"ls\\\",\\\"justification\\\":\\\"\\\"}), s2)))\\nEOF\",\n  \"description\": \"Probe required route fields and no-schema behavior\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"===PROBE===\\nrequired-provider: {'prompt': 'p'}\\ncwd-noschema: {'cwd': '', 'prompt': 'p'}\\nnote-noschema: {'command': 'ls', 'note': ''}\\nempty-sandbox: {'command': 'ls', 'sandbox_permissions': ''}\\nrequired-just: {'command': 'ls'}\\n\",\n  \"original_output_bytes\": 226,\n  \"original_output_tokens\": 57,\n  \"truncated\": false\n}","final_result":true}}}
