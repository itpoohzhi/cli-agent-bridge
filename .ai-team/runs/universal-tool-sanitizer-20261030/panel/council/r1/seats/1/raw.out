{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c599","stream":{"kind":"session","id":"01a18c89-c868-7a01-9820-a10a6cf0d3ec"},"sequence":295,"recorded_at":1780531400000585,"record_type":"event","durability":"durable","causation_id":"01a18c89-cc96-7b42-84d4-422481d92c42","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c89-cc96-7b42-84d4-422481d92c42","run_stream":{"kind":"run","id":"01a18c89-cc96-7b42-84d4-422481d92c42"},"task_stream":{"kind":"task","id":"01a18c8c-b20c-7d21-945e-7f087d9886be"},"task_id":"01a18c8c-b20c-7d21-945e-7f087d9886be","event":{"kind":"output","task_id":"01a18c8c-b20c-7d21-945e-7f087d9886be","chunk":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && sed -n '90,140p' adapters/droid_adapter.py; echo ===TSM2===; sed -n '1470,1540p' core/turn_session_manager.py\",\n  \"description\": \"Check droid events source and final dict events\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"                    ctx.on_activity(kind)\\n                return sse_writer(kind, text)\\n\\n            wrapped_writer = _wrapped_writer\\n        raw = handler._run_once(legacy, ctx.keepalive, wrapped_writer)\\n        if callable(ctx.on_activity):\\n            ctx.on_activity(\\\"done\\\")\\n        usage = raw.get(\\\"usage\\\") or {}\\n\\n        def tool_call(call: dict) -> ToolCall:\\n            fn = call[\\\"function\\\"]\\n            return ToolCall(\\n                call[\\\"index\\\"],\\n                call[\\\"id\\\"],\\n                ToolFunction(fn[\\\"name\\\"], fn[\\\"arguments\\\"]),\\n                call[\\\"type\\\"],\\n            )\\n\\n        events = (\\n            tuple(\\n                TurnEvent(kind, tool_call(value) if kind == \\\"tool_call\\\" else str(value))\\n                for kind, value in raw[\\\"events\\\"]\\n            )\\n            if \\\"events\\\" in raw\\n            else None\\n        )\\n        return TurnResult(\\n            state=raw[\\\"state\\\"],\\n            rc=raw[\\\"rc\\\"],\\n            text=raw.get(\\\"text\\\") or \\\"\\\",\\n            reasoning=raw.get(\\\"reasoning\\\") or \\\"\\\",\\n            err=raw.get(\\\"err\\\") or \\\"\\\",\\n            usage=Usage(\\n                input_tokens=usage.get(\\\"input_tokens\\\", 0),\\n                output_tokens=usage.get(\\\"output_tokens\\\", 0),\\n                cache_read_tokens=usage.get(\\\"cache_read_tokens\\\"),\\n                cache_creation_tokens=usage.get(\\\"cache_creation_tokens\\\"),\\n            ),\\n            tool_calls=tuple(tool_call(call) for call in raw.get(\\\"tool_calls\\\") or ()),\\n            events=events,\\n        )\\n\\n    def close_session(self, sid: str) -> None:\\n        \\\"\\\"\\\"Закрыть процесс droid с данным SID (term); неизвестный SID — тихо.\\\"\\\"\\\"\\n        with self.host._active_lock:\\n            procs = list(self.host._rpc_procs.values())\\n        for proc in procs:\\n            if getattr(proc, \\\"sid\\\", \\\"\\\") == sid:\\n                self.host._close_async(proc, \\\"term\\\")\\n\\n    def shutdown(self) -> None:\\n===TSM2===\\n                            turn.buffer.append(\\\"content\\\", ev.value)\\n                    elif ev.kind == \\\"tool_call\\\" and not had_tool_calls:\\n                        call_val = (\\n                            asdict(ev.value)\\n                            if isinstance(ev.value, ToolCall)\\n                            else ev.value\\n                        )\\n                        turn.buffer.append(\\\"tool_call\\\", call_val)\\n                if not final_res.events:\\n                    if final_res.reasoning and not had_reasoning:\\n                        turn.buffer.append(\\\"reasoning\\\", final_res.reasoning)\\n                    if final_res.text and not had_content:\\n                        turn.buffer.append(\\\"content\\\", final_res.text)\\n                    if not had_tool_calls:\\n                        for tc in final_res.tool_calls or ():\\n                            turn.buffer.append(\\\"tool_call\\\", asdict(tc))\\n\\n            res_state = str(final_res.state or \\\"done\\\")\\n            term_reason = (\\n                turn.timeout_controller.terminated_reason\\n                if turn.timeout_controller is not None\\n                else \\\"\\\"\\n            )\\n            if term_reason == \\\"idle_timeout\\\" or res_state == \\\"idle_timeout\\\":\\n                turn.status = STATE_TIMED_OUT_IDLE\\n            elif term_reason == \\\"absolute_cap\\\" or res_state in (\\n                \\\"timeout\\\",\\n                \\\"safety_cap\\\",\\n            ):\\n                turn.status = STATE_TIMED_OUT_CAP\\n            elif res_state == \\\"done\\\" and int(final_res.rc or 0) == 0:\\n                turn.status = STATE_COMPLETED\\n            elif res_state == \\\"client_gone\\\":\\n                turn.status = STATE_CANCELLED\\n            else:\\n                turn.status = STATE_FAILED_BACKEND\\n\\n            if not turn.buffer.sealed:\\n                if turn.status == STATE_COMPLETED:\\n                    finish_reason = (\\n                        \\\"tool_calls\\\" if final_res.tool_calls else \\\"stop\\\"\\n                    )\\n                    turn.buffer.append(\\n                        \\\"done\\\",\\n                        {\\n                            \\\"finish_reason\\\": finish_reason,\\n                            \\\"usage\\\": dict(turn.buffer.usage),\\n                        },\\n                    )\\n                else:\\n                    turn.buffer.append(\\n                        \\\"error\\\",\\n                        {\\n                            \\\"message\\\": str(final_res.err or res_state),\\n                            \\\"type\\\": (\\n                                \\\"timeout_error\\\"\\n                                if turn.status\\n                                in (STATE_TIMED_OUT_IDLE, STATE_TIMED_OUT_CAP)\\n                                else \\\"proxy_error\\\"\\n                            ),\\n                            \\\"code\\\": turn.status.lower(),\\n                        },\\n                    )\\n                turn.buffer.seal()\\n\\n            turn.updated_at = time.time()\\n            if self._active_by_key.get(turn.turn_key) == turn.turn_id:\\n                self._active_by_key.pop(turn.turn_key, None)\\n            if turn.pgid is not None:\\n                self.unregister_child_pgid(turn.pgid)\\n            if turn.timeout_controller is not None:\\n\",\n  \"original_output_bytes\": 5088,\n  \"original_output_tokens\": 1272,\n  \"truncated\": false\n}","final_result":true}}}
