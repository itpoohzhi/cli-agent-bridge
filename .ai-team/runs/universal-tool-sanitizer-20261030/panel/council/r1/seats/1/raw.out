{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c553","stream":{"kind":"session","id":"01a18c89-c868-7a01-9820-a10a6cf0d3ec"},"sequence":260,"recorded_at":1780531400000515,"record_type":"event","durability":"durable","causation_id":"01a18c89-cc96-7b42-84d4-422481d92c42","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c89-cc96-7b42-84d4-422481d92c42","run_stream":{"kind":"run","id":"01a18c89-cc96-7b42-84d4-422481d92c42"},"task_stream":{"kind":"task","id":"01a18c8c-73d2-74d0-9b49-9814c93916aa"},"task_id":"01a18c8c-73d2-74d0-9b49-9814c93916aa","event":{"kind":"output","task_id":"01a18c8c-73d2-74d0-9b49-9814c93916aa","chunk":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"cd /Users/aazhiry1/work/src/cli-agent-bridge && sed -n '5890,5965p' server.py; echo ===TSM===; sed -n '1424,1470p' core/turn_session_manager.py\",\n  \"description\": \"Read SSE emit loop and turn completion\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"                self._client_write_dead = True\\n            return ok\\n\\n        if not self._emit(chunk({\\\"role\\\": \\\"assistant\\\", \\\"content\\\": \\\"\\\"})):\\n            if managed_turn is not None and ctx.get(\\\"detach_on_disconnect\\\"):\\n                self._client_write_dead = True\\n                TURN_MANAGER.mark_detached(managed_turn.turn_id)\\n            else:\\n                return\\n        try:\\n            out = self._dispatch(ctx, keepalive, sse_writer)\\n        except Exception as exc:  # noqa: BLE001 - RW-211: клиенту нужен конверт, а не сырой сбой\\n            if self._client_write_dead:\\n                _log(\\n                    f\\\"client_write_dead: dispatch error suppressed \\\"\\n                    f\\\"err={_err_summary(repr(exc), 160)!r}\\\"\\n                )\\n                return\\n            if not live_sent[0]:\\n                raise  # живых байт не было: прежнее поведение (сбой наружу)\\n            _log(f\\\"live_dispatch_failed err={_err_summary(repr(exc), 160)!r}\\\")\\n            self._emit(stream_error_frame(str(exc)[:500] or exc.__class__.__name__))\\n            self._emit(\\\"data: [DONE]\\\\n\\\\n\\\")\\n            return\\n        if self._client_write_dead:\\n            # RW-203: сокет отверг живую запись — терминальные кадры (tool_call, stop,\\n            # usage, error) и [DONE] мёртвому клиенту не отправляются.\\n            _log(\\\"client_write_dead: terminal frames suppressed\\\")\\n            return\\n        if out.get(\\\"state\\\") == \\\"client_gone\\\":\\n            _log(\\\"client gone mid-stream, child killed\\\")\\n            return\\n        err = self._error_body(out) or self._reserve_delivery(out)\\n        if err is None:\\n            # Доставка — отдельный этап: T/L уже свободны, checkpoint записан; обрыв клиента\\n            # здесь ни на что, кроме самого ответа, не влияет. У droid content/reasoning уже ушли\\n            # живьём из _execute (sse_writer выше): здесь остаются только tool_call-кадры.\\n            live_backend = out.get(\\\"backend_kind\\\") == \\\"droid\\\"\\n            for kind, value in out.get(\\\"events\\\") or []:\\n                if kind in (\\\"content\\\", \\\"reasoning\\\"):\\n                    if live_backend:\\n                        continue\\n                    field = \\\"content\\\" if kind == \\\"content\\\" else \\\"reasoning_content\\\"\\n                    # Большое событие выдаётся срезами: в памяти одновременно только один срез SSE-кадра.\\n                    delivered = (\\n                        all(\\n                            self._emit(chunk({field: piece}))\\n                            for piece in _text_slices(value)\\n                        )\\n                        if value\\n                        else self._emit(chunk({field: value}))\\n                    )\\n                else:\\n                    delivered = self._emit_tool_call(chunk, value)\\n                if not delivered:\\n                    _log(\\\"client gone during delivery; turn already committed\\\")\\n                    return\\n            finish = \\\"tool_calls\\\" if out.get(\\\"tool_calls\\\") else \\\"stop\\\"\\n            self._emit(chunk({}, finish))\\n            # Harness считает tok/s и % контекста только из usage в потоке\\n            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage ->\\n            # tokenUsage/contextPressure). Без этого чанка метрики пустые.\\n            # Шлём только при ненулевых токенах, чтобы нулевой usage от droid\\n            # не превращался в ложные \\\"0 tok/s / 0%\\\".\\n            out_usage = out.get(\\\"usage\\\") or {}\\n            prompt_toks = out_usage.get(\\\"input_tokens\\\", 0)\\n            compl_toks = out_usage.get(\\\"output_tokens\\\", 0)\\n            if prompt_toks or compl_toks:\\n                self._emit(\\n                    \\\"data: \\\"\\n                    + json.dumps(\\n                        {\\n                            \\\"id\\\": completion_id,\\n                            \\\"object\\\": \\\"chat.completion.chunk\\\",\\n                            \\\"created\\\": created,\\n                            \\\"model\\\": shown_model,\\n===TSM===\\n    def complete_turn_from_result(\\n        self,\\n        turn: ManagedTurn,\\n        raw_result: TurnResult,\\n        *,\\n        backend_kind: str = \\\"\\\",\\n    ) -> dict[str, Any]:\\n        \\\"\\\"\\\"Финализирует `ManagedTurn` по `TurnResult` от `BackendAdapter.execute_turn`.\\\"\\\"\\\"\\n        final_res = (\\n            self._finalize_fn(raw_result, turn.emulate_tools)\\n            if self._finalize_fn is not None\\n            else raw_result\\n        )\\n        turn.release_slot_once()\\n\\n        with self._lock:\\n            if turn.status in (STATE_CANCELLED, STATE_INTERRUPTED_DRAIN):\\n                if turn.final_dict is not None:\\n                    return turn.final_dict\\n                return {\\n                    \\\"state\\\": \\\"client_gone\\\",\\n                    \\\"rc\\\": 1,\\n                    \\\"text\\\": turn.buffer.get_content_text(),\\n                    \\\"err\\\": \\\"cancelled\\\",\\n                    \\\"usage\\\": dict(turn.buffer.usage),\\n                    \\\"result\\\": {},\\n                    \\\"tool_calls\\\": list(turn.buffer.tool_calls),\\n                    \\\"events\\\": [],\\n                    \\\"backend_kind\\\": backend_kind or turn.backend,\\n                    \\\"turn_id\\\": turn.turn_id,\\n                }\\n\\n            turn.result = final_res\\n            turn.buffer.set_usage(final_res.usage)\\n\\n            # Если адаптер не стримил события живьём, докладываем их в TurnBuffer.\\n            had_content = bool(turn.buffer.get_content_text())\\n            had_reasoning = bool(turn.buffer.get_reasoning_text())\\n            had_tool_calls = bool(turn.buffer.tool_calls)\\n            if not turn.buffer.sealed:\\n                for ev in final_res.events or ():\\n                    if ev.kind == \\\"reasoning\\\" and isinstance(ev.value, str):\\n                        if not had_reasoning:\\n                            turn.buffer.append(\\\"reasoning\\\", ev.value)\\n                    elif ev.kind == \\\"content\\\" and isinstance(ev.value, str):\\n                        if not had_content:\\n                            turn.buffer.append(\\\"content\\\", ev.value)\\n\",\n  \"original_output_bytes\": 6423,\n  \"original_output_tokens\": 1606,\n  \"truncated\": false\n}","final_result":true}}}
