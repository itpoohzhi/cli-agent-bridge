lse:\\n            self._emit(\\n                \\\"data: \\\" + json.dumps({\\\"error\\\": err}, ensure_ascii=False) + \\\"\\\\n\\\\n\\\"\\n            )\\n        self._emit(\\\"data: [DONE]\\\\n\\\\n\\\")\\n\\n\\nclass Server(ThreadingHTTPServer):\\n    \\\"\\\"\\\"HTTP-сервер с семафором числа соединений на уровне приёма (C-11).\\\"\\\"\\\"\\n\\n    daemon_threads = True\\n    request_queue_size = 64\\n    allow_reuse_address = True\\n\\n    def __init__(self, *args: Any, **kwargs: Any):\\n        super().__init__(*args, **kwargs)\\n        self._conn_sem = threading.BoundedSemaphore(\\n            int(FLEET[\\\"admission\\\"][\\\"max_http_connections\\\"])\\n        )\\n\\n    def _send_raw_503(self, request: socket.socket) -> None:\\n        body = json.dumps(\\n            {\\n===\\ncore/backend_adapter.py:130:class ToolCall:\\ncore/backend_adapter.py:177:        \\\"required\\\",\\ncore/backend_adapter.py:212:    for flag, default in ((\\\"enabled\\\", True), (\\\"required\\\", False)):\\ncore/backend_adapter.py:305:    \\\"required\\\": True,\\ncore/backend_adapter.py:383:                required=entry.get(\\\"required\\\", False),\\ncore/backend_adapter.py:597:    def required(self) -> bool:\\ncore/backend_adapter.py:598:        return bool(self.config.get(\\\"required\\\", False))\\ncore/tool_emulation.py:143:    if tool_choice == \\\"required\\\":\\ncore/tool_emulation.py:518:class ToolCallParser:\\ncore/tool_emulation.py:661:def finalize_turn(raw: TurnResult, emulate_tools: bool) -> TurnResult:\\nserver.py:116:    finalize_turn,\\nserver.py:573:    \\\"\\\"\\\"ok | invalid | not_required: состояние допуска образа для /health (без деталей и путей).\\\"\\\"\\\"\\nserver.py:575:        return \\\"not_required\\\"\\nserver.py:2217:    finalize_fn=finalize_turn,\\nserver.py:4860:            required = [a for a in BACKENDS.adapters() if a.required]\\nserver.py:4865:                    \\\"ok\\\": all(a.is_healthy() for a in required),\\nserver.py:5621:      