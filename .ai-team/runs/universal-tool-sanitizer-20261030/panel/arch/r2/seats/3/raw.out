{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c435","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":117,"recorded_at":1780531400000229,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"task_stream":{"kind":"task","id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4"},"task_id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4","event":{"kind":"output","task_id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py`.\n1|\"\"\"Общее ядро эмуляции OpenAI function calling (чистые функции, без I/O).\n2|\n3|Единый источник для всех бэкендов хаба: рендер истории и протокола инструментов в\n4|текстовый промпт, разбор блоков `<tool_call>…</tool_call>` из потока текстовых дельт.\n5|Модуль не импортирует `server` и адаптеры; `server.py` реэкспортирует имена для\n6|существующих тестов и совместимости.\n7|\"\"\"\n8|\n9|from __future__ import annotations\n10|\n11|import json\n12|import uuid\n13|from dataclasses import replace\n14|from typing import Any\n15|from core.backend_adapter import ToolCall, ToolFunction, TurnEvent, TurnResult\n16|\n17|TOOL_CALL_OPEN = \"<tool_call>\"\n18|TOOL_CALL_CLOSE = \"</tool_call>\"\n19|\n20|\n21|def _flatten_content(content: Any) -> str:\n22|    if content is None:\n23|        return \"\"\n24|    if isinstance(content, str):\n25|        return content\n26|    if isinstance(content, list):\n27|        parts = []\n28|        for item in content:\n29|            if isinstance(item, str):\n30|                parts.append(item)\n31|            elif isinstance(item, dict) and \"text\" in item:\n32|                parts.append(str(item[\"text\"]))\n33|        return \"\\n\".join(p for p in parts if p)\n34|    return str(content)\n35|\n36|\n37|def _render_content(content: Any, counter: list) -> str:\n38|    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\n39|\n40|    Нумерация сквозная по порядку появления во всей истории. Неизвестные\n41|    НЕ-image части (например input_audio) молча пропускаются, как раньше.\n42|    \"\"\"\n43|    if content is None:\n44|        return \"\"\n45|    if isinstance(content, str):\n46|        return content\n47|    if isinstance(content, list):\n48|        parts = []\n49|        for item in content:\n50|            if isinstance(item, str):\n51|                parts.append(item)\n52|            elif isinstance(item, dict):\n53|                if item.get(\"type\") == \"image_url\":\n54|                    counter[0] += 1\n55|                    parts.append(f\"[image {counter[0]}]\")\n56|                elif \"text\" in item and item.get(\"text\") is not None:\n57|                    parts.append(str(item[\"text\"]))\n58|        return \"\\n\".join(p for p in parts if p)\n59|    return str(content)\n60|\n61|\n62|def _normalize_arguments(value: Any) -> dict | None:\n63|    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n64|\n65|    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n66|    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n67|    и запускать инструмент с пустыми аргументами.\n68|    \"\"\"\n69|    if isinstance(value, dict):\n70|        return value\n71|    if isinstance(value, str):\n72|        text = value.strip()\n73|        if text:\n74|            try:\n75|                parsed = json.loads(text)\n76|            except ValueError:\n77|                return None\n78|            if isinstance(parsed, dict):\n79|                return parsed\n80|    return None\n81|\n82|\n83|def _normalize_tool_call(item: Any) -> dict:\n84|    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n85|\n86|    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n87|    с конкретным вызовом при нескольких одинаковых инструментах.\n88|    \"\"\"\n89|    if not isinstance(item, dict):\n90|        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n91|    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n92|    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n93|    args = fn.get(\"arguments\")\n94|    if args is None:\n95|        args = item.get(\"arguments\")\n96|    normalized = _normalize_arguments(args)\n97|    return {\n98|        \"id\": str(item.get(\"id\") or \"\"),\n99|        \"name\": str(name),\n100|        \"arguments\": normalized if normalized is not None else {},\n101|    }\n102|\n103|\n104|def _render_tool_call(item: Any) -> str:\n105|    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n106|    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n107|    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n108|\n109|\n110|def _tool_choice_none(tool_choice: Any) -> bool:\n111|    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n112|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n113|\n114|\n115|def _tool_choice_name(tool_choice: Any) -> str:\n116|    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n117|    if not isinstance(tool_choice, dict):\n118|        return \"\"\n119|    fn = (\n120|        tool_choice.get(\"function\")\n121|        if isinstance(tool_choice.get(\"function\"), dict)\n122|        else {}\n123|    )\n124|    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n125|    return str(name) if name else \"\"\n126|\n127|\n128|def _tools_section(tools: list, tool_choice: Any, has_attachments: bool = False) -> str:\n129|    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n130|    lines = [\n131|        \"[system]\",\n132|        \"# Tool calling protocol\",\n133|        \"You may call the external tools listed below.\",\n134|        \"When you need a tool, output ONLY blocks exactly in this form:\",\n135|        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n136|        \"You may output several such blocks in a row. Do not narrate around them.\",\n137|        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n138|        \"If no tool is needed, reply normally in plain text.\",\n139|        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n140|    ]\n141|    if has_attachments:\n142|        lines[-1] += \", except Read on the attachment files listed under [attachments].\"\n143|    if tool_choice == \"required\":\n144|        lines.append(\"You MUST call at least one tool now.\")\n145|    else:\n146|        forced = _tool_choice_name(tool_choice)\n147|        if forced:\n148|            lines.append(f'You MUST call the tool \"{forced}\" now.')\n149|    lines.append(\"\")\n150|    lines.append(\"Available tools:\")\n151|    for item in tools:\n152|        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n153|        if not isinstance(fn, dict):\n154|            continue\n155|        name = str(fn.get(\"name\") or \"\")\n156|        desc = str(fn.get(\"description\") or \"\")\n157|        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n158|        lines.append(f\"- {name}: {desc}\")\n159|        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n160|    return \"\\n\".join(lines)\n161|\n162|\n163|def _render_message(msg: Any, counter: list) -> str:\n164|    \"\"\"Одно сообщение истории -> текстовый блок (с рендером tool-вызовов/результатов).\"\"\"\n165|    if not isinstance(msg, dict):\n166|        return \"\"\n167|    role = str(msg.get(\"role\") or \"user\")\n168|    if role == \"tool\":\n169|        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n170|        name = str(msg.get(\"name\") or \"\")\n171|        text = _render_content(msg.get(\"content\"), counter)\n172|        header = f\"[tool result {call_id}]\"\n173|        if name:\n174|            header += f\" ({name})\"\n175|        return f\"{header}\\n{text}\" if text.strip() else header\n176|    text = _render_content(msg.get(\"content\"), counter)\n177|    if role == \"assistant\":\n178|        parts = []\n179|        if text.strip():\n180|            parts.append(text)\n181|        calls = msg.get(\"tool_calls\")\n182|        if isinstance(calls, list):\n183|            parts.extend(_render_tool_call(tc) for tc in calls)\n184|        body = \"\\n\".join(p for p in parts if p)\n185|        return f\"[assistant]\\n{body}\" if body.strip() else \"\"\n186|    if text.strip():\n187|        return f\"[{role}]\\n{text}\"\n188|    return \"\"\n189|\n190|\n191|def _attachments_section(images: list) -> str:\n192|    \"\"\"Хвост промпта метода workspace-read (эталон — kit/mkprompt.py).\"\"\"\n193|    lines = [\n194|        \"[attachments]\",\n195|        \"This request includes %d image(s) as local files in the working directory. \"\n196|        \"The markers [image N] in the conversation refer to them in order.\"\n197|        % len(images),\n198|    ]\n199|    for index, image in enumerate(images, 1):\n200|        lines.append(\n201|            \"- [image %d] ./%s (%s, %d bytes)\"\n202|            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\n203|        )\n204|    lines.append(\n205|        \"Open each image with the Read tool on exactly these paths before answering about it \"\n206|        \"(Read is the only built-in tool you may use, and only on these files). Do not claim to \"\n207|        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\n208|        \"instead of guessing.\"\n209|    )\n210|    return \"\\n\".join(lines)\n211|\n212|\n213|def _messages_to_prompt(\n214|    messages: list,\n215|    tools: list | None = None,\n216|    tool_choice: Any = None,\n217|    images: list | None = None,\n218|) -> str:\n219|    \"\"\"Собрать единый текстовый промпт; при наличии tools — с секцией протокола.\n220|\n221|    При наличии изображений в конец добавляется секция [attachments], а строка\n222|    протокола инструментов получает исключение для Read (C-09).\n223|    \"\"\"\n224|    tools = tools or []\n225|    counter = [0]\n226|    blocks = []\n227|    for msg in messages:\n228|        rendered = _render_message(msg, counter)\n229|        if rendered:\n230|            blocks.append(rendered)\n231|    head = []\n232|    if tools and not _tool_choice_none(tool_choice):\n233|        head.append(_tools_section(tools, tool_choice, bool(images)))\n234|    text = \"\\n\\n\".join(head + blocks).strip() or \"Reply with exactly: PONG\"\n235|    if images:\n236|        text = text + \"\\n\\n\" + _attachments_section(images)\n237|    return text\n238|\n239|\n240|def _strip_code_fence(text: str) -> str:\n241|    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n242|    body = text.strip()\n243|    if body.startswith((\"```\", \"~~~\")):\n244|        newline = body.find(\"\\n\")\n245|        body = body[newline + 1 :] if newline != -1 else body[3:]\n246|    if body.rstrip().endswith((\"```\", \"~~~\")):\n247|        body = body.rstrip()[:-3]\n248|    return body.strip()\n249|\n250|\n251|_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n252|\n253|\n254|def _recover_trailing_braces(text: str) -> dict | None:\n255|    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n256|    body = text.lstrip()\n257|    try:\n258|        obj, end = json.JSONDecoder().raw_decode(body)\n259|    except (ValueError, RecursionError):\n260|        return None\n261|    tail = body[end:]\n262|    if (\n263|        isinstance(obj, dict)\n264|        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n265|        and not tail.strip(\" \\t\\r\\n}\")\n266|    ):\n267|        return obj\n268|    return None\n269|\n270|\n271|def _loads_tolerant(text: str) -> Any:\n272|    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n273|\n274|    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n275|    \"\"\"\n276|    try:\n277|        return json.loads(text)\n278|    except (ValueError, RecursionError) as exc:\n279|        recovered = _recover_trailing_braces(text)\n280|        if recovered is None:\n281|            if isinstance(exc, RecursionError):\n282|                raise ValueError(\"JSON is nested too deeply\") from exc\n283|            raise\n284|        return recovered\n285|\n286|\n287|def _parse_tool_call_block(inner: str) -> dict | None:\n288|    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n289|\n290|    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n291|    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n292|    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n293|    \"\"\"\n294|    try:\n295|        obj = _loads_tolerant(_strip_code_fence(inner))\n296|    except ValueError:\n297|        return None\n298|    if not isinstance(obj, dict):\n299|        return None\n300|    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n301|        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n302|        obj = obj[\"function\"]\n303|    name = obj.get(\"name\")\n304|    if not isinstance(name, str) or not name.strip():\n305|        return None\n306|    if \"arguments\" not in obj:\n307|        arguments: dict = {}\n308|    else:\n309|        normalized = _normalize_arguments(obj.get(\"arguments\"))\n310|        if normalized is None:\n311|            return None\n312|        arguments = normalized\n313|    return {\"name\": name.strip(), \"arguments\": arguments}\n314|\n315|\n316|class LiveParserError(Exception):\n317|    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n318|\n319|    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n320|    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n321|    fail-close всего live-хода (сырой XML клиенту не уходит).\n322|    \"\"\"\n323|\n324|\n325|def _is_quoted_open(text: str, start: int) -> bool:\n326|    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n327|    if start > 0 and text[start - 1] == \"`\":\n328|        return True\n329|    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n330|    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n331|\n332|\n333|def _split_tool_call_inner(inner: str) -> list[str]:\n334|    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n335|\n336|    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n337|    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n338|    границей не считается (та же логика, что в `_find_close_outside_string`).\n339|    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n340|    \"\"\"\n341|    segments: list[str] = []\n342|    seg_start = 0\n343|    index = 0\n344|    length = len(inner)\n345|    in_string = False\n346|    escaped = False\n347|    while index < length:\n348|        char = inner[index]\n349|        if in_string:\n350|            if escaped:\n351|                escaped = False\n352|            elif char == \"\\\\\":\n353|                escaped = True\n354|            elif char == '\"':\n355|                in_string = False\n356|        elif char == '\"':\n357|            in_string = True\n358|        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n359|            inner, index\n360|        ):\n361|            segments.append(inner[seg_start:index])\n362|            index += len(TOOL_CALL_OPEN)\n363|            seg_start = index\n364|            continue\n365|        index += 1\n366|    segments.append(inner[seg_start:])\n367|    return segments\n368|\n369|\n370|def _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n371|    \"\"\"Содержимое блока -> список вызовов; None, если блок (или любой его член) невалиден.\n372|\n373|    Обычный блок даёт один вызов. Если он не разбирается, но внутри есть\n374|    несколько `<tool_call>` без промежуточных закрывающих тегов, блок делится на\n375|    сегменты; пачка принимается только целиком (все сегменты валидны).\n376|    \"\"\"\n377|    single = _parse_tool_call_block(inner)\n378|    if single is not None:\n379|        return [single]\n380|    if TOOL_CALL_OPEN not in inner:\n381|        return None\n382|    segments = _split_tool_call_inner(inner)\n383|    if len(segments) < 2:\n384|        return None\n385|    calls: list[dict] = []\n386|    for segment in segments:\n387|        call = _parse_tool_call_block(segment)\n388|        if call is None:\n389|            return None\n390|        calls.append(call)\n391|    return calls\n392|\n393|\n394|_OPAQUE_BLOCK = \"￼\"  # в `_history` на месте разобранного блока вызова\n395|\n396|\n397|def _fence_run(line: str) -> tuple[str, int, str]:\n398|    \"\"\"Строка -> (символ, длина серии, остаток), если это строка-забор fenced-блока.\n399|\n400|    Забор — серия от 3 одинаковых бэктиков или тильд после отступа до 3 пробелов;\n401|    (\"\", 0, \"\") — не забор.\n402|    \"\"\"\n403|    stripped = line.lstrip(\" \")\n404|    if len(line) - len(stripped) > 3 or stripped[:1] not in (\"`\", \"~\"):\n405|        return \"\", 0, \"\"\n406|    char = stripped[0]\n407|    rest = stripped.lstrip(char)\n408|    run = len(stripped) - len(rest)\n409|    return (char, run, rest) if run >= 3 else (\"\", 0, \"\")\n410|\n411|\n412|def _is_fence_open(char: str, run: int, rest: str) -> bool:\n413|    \"\"\"Строка-забор открывает блок: в info-строке бэктик-забора нет бэктиков.\"\"\"\n414|    return bool(run) and (char == \"~\" or \"`\" not in rest)\n415|\n416|\n417|def _find_closing_run(doc: str, start: int, end: int, ticks: int) -> int:\n418|    \"\"\"Конец первой серии ровно из `ticks` бэктиков в `doc[start:end]`, или -1.\"\"\"\n419|    index = start\n420|    while index < end:\n421|        if doc[index] != \"`\":\n422|            index += 1\n423|            continue\n424|        run_start = index\n425|        while index < end and doc[index] == \"`\":\n426|            index += 1\n427|        if index - run_start == ticks:\n428|            return index\n429|    return -1\n430|\n431|\n432|def _is_atx_heading(line: str) -> bool:\n433|    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n434|    stripped = line.lstrip(\" \")\n435|    if len(line) - len(stripped) > 3:\n436|        return False\n437|    rest = stripped.lstrip(\"#\")\n438|    return 1 <= len(stripped) - len(rest) <= 6 and (\n439|        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n440|    )\n441|\n442|\n443|def _code_context(doc: str, pos: int, final: bool) -> str:\n444|    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n445|\n446|    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n447|    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n448|    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n449|    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n450|    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n451|    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n452|    \"\"\"\n453|    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n454|    fence_char, fence_len, para, index = \"\", 0, 0, 0\n455|    while index < line_start:\n456|        eol = doc.index(\"\\n\", index)\n457|        line = doc[index:eol]\n458|        char, run, rest = _fence_run(line)\n459|        if fence_len:\n460|            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n461|                fence_len, para = 0, eol + 1\n462|        elif _is_fence_open(char, run, rest):\n463|            fence_char, fence_len = char, run\n464|        elif not line.strip() or _is_atx_heading(line):\n465|            para = eol + 1\n466|        index = eol + 1\n467|    if fence_len:\n468|        return \"code\"\n469|    eol = doc.find(\"\\n\", pos)\n470|    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n471|    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n472|        return \"code\" if eol != -1 or final else \"wait\"\n473|    para_end, decided = len(doc), final\n474|    index = len(doc) if eol == -1 else eol + 1\n475|    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n476|        para = line_start  # заголовок — отдельный однострочный блок\n477|        if eol != -1:\n478|            para_end, decided, index = eol, True, len(doc)\n479|    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n480|        nxt = doc.find(\"\\n\", index)\n481|        line = doc[index : len(doc) if nxt == -1 else nxt]\n482|        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n483|        if (\n484|            nxt == -1\n485|            and not final\n486|            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n487|        ):\n488|            break\n489|        char, run, rest = _fence_run(line)\n490|        if not line.strip() or _is_fence_open(char, run, rest) or _is_atx_heading(line):\n491|            para_end, decided = index, True\n492|            break\n493|        if nxt == -1:\n494|            break\n495|        index = nxt + 1\n496|    index = para\n497|    while index < pos:\n498|        char = doc[index]\n499|        if char == \"\\\\\":\n500|            index += 2\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"task_stream":{"kind":"task","id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4"},"task_id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4","event":{"kind":"completed","task_id":"01a18c62-6ad0-7f60-8c07-d1f5d90028d4"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c439","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":119,"recorded_at":1780531400000233,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"task_stream":{"kind":"task","id":"01a18c62-6b26-7813-a607-8b1677983659"},"task_id":"01a18c62-6b26-7813-a607-8b1677983659","event":{"kind":"output","task_id":"01a18c62-6b26-7813-a607-8b1677983659","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/universal-tool-sanitizer-20261030/architecture/architecture-packet.json`.\n1|{\n2|  \"schema_version\": \"1.0\",\n3|  \"task_id\": \"universal-tool-sanitizer-20261030\",\n4|  \"run_id\": \"universal-tool-sanitizer-20261030\",\n5|  \"criticality\": \"S2\",\n6|  \"profile\": \"python-aisdlc-gcge\",\n7|  \"status\": \"PROPOSED\",\n8|  \"delta\": \"A1\",\n9|  \"title\": \"Универсальная нормализация аргументов tool_calls и распаковка parallel в cli-agent-bridge\",\n10|  \"requirements\": [\n11|    {\n12|      \"id\": \"REQ-01\",\n13|      \"text\": \"Изоляция от вендорских сред (Vendor Zero-Touch): Никаких модификаций или оверлеев во внешние вендорские приложения (DSH и др.). Все изменения — строго в нашем репозитории cli-agent-bridge на универсальном слое.\",\n14|      \"source\": \"Инвариант владельца в AGENTS.md\",\n15|      \"verification_ids\": [\"VER-001\", \"VER-004\"]\n16|    },\n17|    {\n18|      \"id\": \"REQ-02\",\n19|      \"text\": \"Универсальная санитизация пустых строковых аргументов: Очистка пустых строк (\\\"\\\") из необязательных параметров вызова инструментов (provider, model, reasoning_effort, justification и др.) в исходящих tool_calls перед отправкой клиенту.\",\n20|      \"source\": \"Session 38008581 rca: Error: child LLM provider must be non-empty\",\n21|      \"verification_ids\": [\"VER-002\", \"VER-003\"]\n22|    },\n23|    {\n24|      \"id\": \"REQ-03\",\n25|      \"text\": \"Распаковка синтетического инструмента parallel: Вызовы name='parallel' с массивом tool_uses автоматически распаковываются в стандартные независимые ToolCall первого уровня.\",\n26|      \"source\": \"Session 38008581 rca: Error: unknown tool parallel\",\n27|      \"verification_ids\": [\"VER-002\"]\n28|    },\n29|    {\n30|      \"id\": \"REQ-04\",\n31|      \"text\": \"Безопасный fallback для justification: При наличии sandbox_permissions и пустом justification подставлять безопасный дефолт, предотвращая ошибку invalid justification.\",\n32|      \"source\": \"Session 38008581 rca: Error: invalid justification: expected a non-empty sentence\",\n33|      \"verification_ids\": [\"VER-002\"]\n34|    },\n35|    {\n36|      \"id\": \"REQ-05\",\n37|      \"text\": \"Поддержка non-streaming и SSE streaming: Санитизация работает одинаково корректно в обоих режимах генерации.\",\n38|      \"source\": \"Архитектурный контракт server.py\",\n39|      \"verification_ids\": [\"VER-003\", \"VER-005\"]\n40|    }\n41|  ],\n42|  \"decisions\": [\n43|    {\n44|      \"id\": \"AD-001\",\n45|      \"status\": \"PROPOSED\",\n46|      \"kind\": \"two-way\",\n47|      \"question\": \"На каком слое реализовать очистку пустых аргументов и распаковку parallel?\",\n48|      \"choice\": \"В модуле core/tool_emulation.py как универсальный чистый конвейер sanitize_tool_call / sanitize_tool_calls_list, не зависящий от конкретного бэкенда или клиента.\",\n49|      \"alternatives\": [\n50|        \"A: В core/tool_emulation.py (выбрано: централизованно, переиспользуемо всеми бэкендами и фасадом)\",\n51|        \"B: В отдельных адаптерах бэкендов (дублирование логики между droid, muse, codex)\",\n52|        \"C: Через патчинг клиентского DSH (запрещено владельцем)\"\n53|      ],\n54|      \"drivers\": [\"REQ-01\", \"REQ-02\", \"REQ-03\", \"Инвариант AGENTS.md\"],\n55|      \"consequences\": [\"Все исходящие вызовы инструментов автоматически санитизируются до попадания к клиенту\"],\n56|      \"verification_ids\": [\"VER-002\"]\n57|    },\n58|    {\n59|      \"id\": \"AD-002\",\n60|      \"status\": \"PROPOSED\",\n61|      \"kind\": \"two-way\",\n62|      \"question\": \"Как интегрировать санитизацию в фасад server.py?\",\n63|      \"choice\": \"Применять sanitize_tool_calls_list в ChatCompletionResponse перед сериализацией JSON, а также в потоковом цикле SSE перед отправкой финальных дельт tool_calls.\",\n64|      \"alternatives\": [\n65|        \"A: Фасадный хук на сериализации ответа (выбрано)\",\n66|        \"B: Модификация входящих запросов (не решает проблему генерации модели)\"\n67|      ],\n68|      \"drivers\": [\"REQ-05\"],\n69|      \"consequences\": [\"Клиент гарантированно получает валидный OpenAI-совместимый JSON без пустых опциональных строк\"],\n70|      \"verification_ids\": [\"VER-003\", \"VER-005\"]\n71|    },\n72|    {\n73|      \"id\": \"AD-003\",\n74|      \"status\": \"PROPOSED\",\n75|      \"kind\": \"one-way\",\n76|      \"question\": \"Политика модификации вендорских компонентов (DSH, Claude Code, Cursor)?\",\n77|      \"choice\": \"Zero-Touch: внешний софт не модифицируется, файлы ~/.dsh, app.asar и чужие профили остаются нетронутыми.\",\n78|      \"alternatives\": [\n79|        \"A: Zero-Touch (выбрано)\",\n80|        \"B: Overlay в ~/.dsh (отклонено владельцем)\"\n81|      ],\n82|      \"drivers\": [\"REQ-01\", \"Принцип независимости от вендоров в AGENTS.md\"],\n83|      \"consequences\": [\"Обновления DSH или смена клиента больше не ломают работоспособность решения\"],\n84|      \"verification_ids\": [\"VER-001\", \"VER-004\"]\n85|    }\n86|  ],\n87|  \"risks\": [\n88|    {\n89|      \"id\": \"RISK-001\",\n90|      \"scenario\": \"Инструмент легитимно ожидает пустую строку в качестве валидного аргумента.\",\n91|      \"probability\": \"LOW\",\n92|      \"impact\": \"MEDIUM\",\n93|      \"mitigation\": \"Удалять пустые строки только если поле не входит в required-схему инструмента, либо является известным опциональным параметром (provider, model, reasoning_effort, justification).\"\n94|    }\n95|  ]\n96|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43b","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":120,"recorded_at":1780531400000235,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"task_stream":{"kind":"task","id":"01a18c62-6b26-7813-a607-8b1677983659"},"task_id":"01a18c62-6b26-7813-a607-8b1677983659","event":{"kind":"completed","task_id":"01a18c62-6b26-7813-a607-8b1677983659"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43d","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":121,"recorded_at":1780531400000237,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"call_id":"call_01a18c625c0376d184011cce3216e992","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/core/tool_emulation.py`.\n1|\"\"\"Общее ядро эмуляции OpenAI function calling (чистые функции, без I/O).\n2|\n3|Единый источник для всех бэкендов хаба: рендер истории и протокола инструментов в\n4|текстовый промпт, разбор блоков `<tool_call>…</tool_call>` из потока текстовых дельт.\n5|Модуль не импортирует `server` и адаптеры; `server.py` реэкспортирует имена для\n6|существующих тестов и совместимости.\n7|\"\"\"\n8|\n9|from __future__ import annotations\n10|\n11|import json\n12|import uuid\n13|from dataclasses import replace\n14|from typing import Any\n15|from core.backend_adapter import ToolCall, ToolFunction, TurnEvent, TurnResult\n16|\n17|TOOL_CALL_OPEN = \"<tool_call>\"\n18|TOOL_CALL_CLOSE = \"</tool_call>\"\n19|\n20|\n21|def _flatten_content(content: Any) -> str:\n22|    if content is None:\n23|        return \"\"\n24|    if isinstance(content, str):\n25|        return content\n26|    if isinstance(content, list):\n27|        parts = []\n28|        for item in content:\n29|            if isinstance(item, str):\n30|                parts.append(item)\n31|            elif isinstance(item, dict) and \"text\" in item:\n32|                parts.append(str(item[\"text\"]))\n33|        return \"\\n\".join(p for p in parts if p)\n34|    return str(content)\n35|\n36|\n37|def _render_content(content: Any, counter: list) -> str:\n38|    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\n39|\n40|    Нумерация сквозная по порядку появления во всей истории. Неизвестные\n41|    НЕ-image части (например input_audio) молча пропускаются, как раньше.\n42|    \"\"\"\n43|    if content is None:\n44|        return \"\"\n45|    if isinstance(content, str):\n46|        return content\n47|    if isinstance(content, list):\n48|        parts = []\n49|        for item in content:\n50|            if isinstance(item, str):\n51|                parts.append(item)\n52|            elif isinstance(item, dict):\n53|                if item.get(\"type\") == \"image_url\":\n54|                    counter[0] += 1\n55|                    parts.append(f\"[image {counter[0]}]\")\n56|                elif \"text\" in item and item.get(\"text\") is not None:\n57|                    parts.append(str(item[\"text\"]))\n58|        return \"\\n\".join(p for p in parts if p)\n59|    return str(content)\n60|\n61|\n62|def _normalize_arguments(value: Any) -> dict | None:\n63|    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n64|\n65|    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n66|    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n67|    и запускать инструмент с пустыми аргументами.\n68|    \"\"\"\n69|    if isinstance(value, dict):\n70|        return value\n71|    if isinstance(value, str):\n72|        text = value.strip()\n73|        if text:\n74|            try:\n75|                parsed = json.loads(text)\n76|            except ValueError:\n77|                return None\n78|            if isinstance(parsed, dict):\n79|                return parsed\n80|    return None\n81|\n82|\n83|def _normalize_tool_call(item: Any) -> dict:\n84|    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n85|\n86|    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n87|    с конкретным вызовом при нескольких одинаковых инструментах.\n88|    \"\"\"\n89|    if not isinstance(item, dict):\n90|        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n91|    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n92|    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n93|    args = fn.get(\"arguments\")\n94|    if args is None:\n95|        args = item.get(\"arguments\")\n96|    normalized = _normalize_arguments(args)\n97|    return {\n98|        \"id\": str(item.get(\"id\") or \"\"),\n99|        \"name\": str(name),\n100|        \"arguments\": normalized if normalized is not None else {},\n101|    }\n102|\n103|\n104|def _render_tool_call(item: Any) -> str:\n105|    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n106|    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n107|    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n108|\n109|\n110|def _tool_choice_none(tool_choice: Any) -> bool:\n111|    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n112|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n113|\n114|\n115|def _tool_choice_name(tool_choice: Any) -> str:\n116|    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n117|    if not isinstance(tool_choice, dict):\n118|        return \"\"\n119|    fn = (\n120|        tool_choice.get(\"function\")\n121|        if isinstance(tool_choice.get(\"function\"), dict)\n122|        else {}\n123|    )\n124|    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n125|    return str(name) if name else \"\"\n126|\n127|\n128|def _tools_section(tools: list, tool_choice: Any, has_attachments: bool = False) -> str:\n129|    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n130|    lines = [\n131|        \"[system]\",\n132|        \"# Tool calling protocol\",\n133|        \"You may call the external tools listed below.\",\n134|        \"When you need a tool, output ONLY blocks exactly in this form:\",\n135|        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n136|        \"You may output several such blocks in a row. Do not narrate around them.\",\n137|        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n138|        \"If no tool is needed, reply normally in plain text.\",\n139|        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n140|    ]\n141|    if has_attachments:\n142|        lines[-1] += \", except Read on the attachment files listed under [attachments].\"\n143|    if tool_choice == \"required\":\n144|        lines.append(\"You MUST call at least one tool now.\")\n145|    else:\n146|        forced = _tool_choice_name(tool_choice)\n147|        if forced:\n148|            lines.append(f'You MUST call the tool \"{forced}\" now.')\n149|    lines.append(\"\")\n150|    lines.append(\"Available tools:\")\n151|    for item in tools:\n152|        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n153|        if not isinstance(fn, dict):\n154|            continue\n155|        name = str(fn.get(\"name\") or \"\")\n156|        desc = str(fn.get(\"description\") or \"\")\n157|        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n158|        lines.append(f\"- {name}: {desc}\")\n159|        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n160|    return \"\\n\".join(lines)\n161|\n162|\n163|def _render_message(msg: Any, counter: list) -> str:\n164|    \"\"\"Одно сообщение истории -> текстовый блок (с рендером tool-вызовов/результатов).\"\"\"\n165|    if not isinstance(msg, dict):\n166|        return \"\"\n167|    role = str(msg.get(\"role\") or \"user\")\n168|    if role == \"tool\":\n169|        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n170|        name = str(msg.get(\"name\") or \"\")\n171|        text = _render_content(msg.get(\"content\"), counter)\n172|        header = f\"[tool result {call_id}]\"\n173|        if name:\n174|            header += f\" ({name})\"\n175|        return f\"{header}\\n{text}\" if text.strip() else header\n176|    text = _render_content(msg.get(\"content\"), counter)\n177|    if role == \"assistant\":\n178|        parts = []\n179|        if text.strip():\n180|            parts.append(text)\n181|        calls = msg.get(\"tool_calls\")\n182|        if isinstance(calls, list):\n183|            parts.extend(_render_tool_call(tc) for tc in calls)\n184|        body = \"\\n\".join(p for p in parts if p)\n185|        return f\"[assistant]\\n{body}\" if body.strip() else \"\"\n186|    if text.strip():\n187|        return f\"[{role}]\\n{text}\"\n188|    return \"\"\n189|\n190|\n191|def _attachments_section(images: list) -> str:\n192|    \"\"\"Хвост промпта метода workspace-read (эталон — kit/mkprompt.py).\"\"\"\n193|    lines = [\n194|        \"[attachments]\",\n195|        \"This request includes %d image(s) as local files in the working directory. \"\n196|        \"The markers [image N] in the conversation refer to them in order.\"\n197|        % len(images),\n198|    ]\n199|    for index, image in enumerate(images, 1):\n200|        lines.append(\n201|            \"- [image %d] ./%s (%s, %d bytes)\"\n202|            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\n203|        )\n204|    lines.append(\n205|        \"Open each image with the Read tool on exactly these paths before answering about it \"\n206|        \"(Read is the only built-in tool you may use, and only on these files). Do not claim to \"\n207|        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\n208|        \"instead of guessing.\"\n209|    )\n210|    return \"\\n\".join(lines)\n211|\n212|\n213|def _messages_to_prompt(\n214|    messages: list,\n215|    tools: list | None = None,\n216|    tool_choice: Any = None,\n217|    images: list | None = None,\n218|) -> str:\n219|    \"\"\"Собрать единый текстовый промпт; при наличии tools — с секцией протокола.\n220|\n221|    При наличии изображений в конец добавляется секция [attachments], а строка\n222|    протокола инструментов получает исключение для Read (C-09).\n223|    \"\"\"\n224|    tools = tools or []\n225|    counter = [0]\n226|    blocks = []\n227|    for msg in messages:\n228|        rendered = _render_message(msg, counter)\n229|        if rendered:\n230|            blocks.append(rendered)\n231|    head = []\n232|    if tools and not _tool_choice_none(tool_choice):\n233|        head.append(_tools_section(tools, tool_choice, bool(images)))\n234|    text = \"\\n\\n\".join(head + blocks).strip() or \"Reply with exactly: PONG\"\n235|    if images:\n236|        text = text + \"\\n\\n\" + _attachments_section(images)\n237|    return text\n238|\n239|\n240|def _strip_code_fence(text: str) -> str:\n241|    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n242|    body = text.strip()\n243|    if body.startswith((\"```\", \"~~~\")):\n244|        newline = body.find(\"\\n\")\n245|        body = body[newline + 1 :] if newline != -1 else body[3:]\n246|    if body.rstrip().endswith((\"```\", \"~~~\")):\n247|        body = body.rstrip()[:-3]\n248|    return body.strip()\n249|\n250|\n251|_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n252|\n253|\n254|def _recover_trailing_braces(text: str) -> dict | None:\n255|    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n256|    body = text.lstrip()\n257|    try:\n258|        obj, end = json.JSONDecoder().raw_decode(body)\n259|    except (ValueError, RecursionError):\n260|        return None\n261|    tail = body[end:]\n262|    if (\n263|        isinstance(obj, dict)\n264|        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n265|        and not tail.strip(\" \\t\\r\\n}\")\n266|    ):\n267|        return obj\n268|    return None\n269|\n270|\n271|def _loads_tolerant(text: str) -> Any:\n272|    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n273|\n274|    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n275|    \"\"\"\n276|    try:\n277|        return json.loads(text)\n278|    except (ValueError, RecursionError) as exc:\n279|        recovered = _recover_trailing_braces(text)\n280|        if recovered is None:\n281|            if isinstance(exc, RecursionError):\n282|                raise ValueError(\"JSON is nested too deeply\") from exc\n283|            raise\n284|        return recovered\n285|\n286|\n287|def _parse_tool_call_block(inner: str) -> dict | None:\n288|    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n289|\n290|    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n291|    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n292|    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n293|    \"\"\"\n294|    try:\n295|        obj = _loads_tolerant(_strip_code_fence(inner))\n296|    except ValueError:\n297|        return None\n298|    if not isinstance(obj, dict):\n299|        return None\n300|    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n301|        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n302|        obj = obj[\"function\"]\n303|    name = obj.get(\"name\")\n304|    if not isinstance(name, str) or not name.strip():\n305|        return None\n306|    if \"arguments\" not in obj:\n307|        arguments: dict = {}\n308|    else:\n309|        normalized = _normalize_arguments(obj.get(\"arguments\"))\n310|        if normalized is None:\n311|            return None\n312|        arguments = normalized\n313|    return {\"name\": name.strip(), \"arguments\": arguments}\n314|\n315|\n316|class LiveParserError(Exception):\n317|    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n318|\n319|    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n320|    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n321|    fail-close всего live-хода (сырой XML клиенту не уходит).\n322|    \"\"\"\n323|\n324|\n325|def _is_quoted_open(text: str, start: int) -> bool:\n326|    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n327|    if start > 0 and text[start - 1] == \"`\":\n328|        return True\n329|    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n330|    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n331|\n332|\n333|def _split_tool_call_inner(inner: str) -> list[str]:\n334|    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n335|\n336|    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n337|    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n338|    границей не считается (та же логика, что в `_find_close_outside_string`).\n339|    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n340|    \"\"\"\n341|    segments: list[str] = []\n342|    seg_start = 0\n343|    index = 0\n344|    length = len(inner)\n345|    in_string = False\n346|    escaped = False\n347|    while index < length:\n348|        char = inner[index]\n349|        if in_string:\n350|            if escaped:\n351|                escaped = False\n352|            elif char == \"\\\\\":\n353|                escaped = True\n354|            elif char == '\"':\n355|                in_string = False\n356|        elif char == '\"':\n357|            in_string = True\n358|        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n359|            inner, index\n360|        ):\n361|            segments.append(inner[seg_start:index])\n362|            index += len(TOOL_CALL_OPEN)\n363|            seg_start = index\n364|            continue\n365|        index += 1\n366|    segments.append(inner[seg_start:])\n367|    return segments\n368|\n369|\n370|def _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n371|    \"\"\"Содержимое блока -> список вызовов; None, если блок (или любой его член) невалиден.\n372|\n373|    Обычный блок даёт один вызов. Если он не разбирается, но внутри есть\n374|    несколько `<tool_call>` без промежуточных закрывающих тегов, блок делится на\n375|    сегменты; пачка принимается только целиком (все сегменты валидны).\n376|    \"\"\"\n377|    single = _parse_tool_call_block(inner)\n378|    if single is not None:\n379|        return [single]\n380|    if TOOL_CALL_OPEN not in inner:\n381|        return None\n382|    segments = _split_tool_call_inner(inner)\n383|    if len(segments) < 2:\n384|        return None\n385|    calls: list[dict] = []\n386|    for segment in segments:\n387|        call = _parse_tool_call_block(segment)\n388|        if call is None:\n389|            return None\n390|        calls.append(call)\n391|    return calls\n392|\n393|\n394|_OPAQUE_BLOCK = \"￼\"  # в `_history` на месте разобранного блока вызова\n395|\n396|\n397|def _fence_run(line: str) -> tuple[str, int, str]:\n398|    \"\"\"Строка -> (символ, длина серии, остаток), если это строка-забор fenced-блока.\n399|\n400|    Забор — серия от 3 одинаковых бэктиков или тильд после отступа до 3 пробелов;\n401|    (\"\", 0, \"\") — не забор.\n402|    \"\"\"\n403|    stripped = line.lstrip(\" \")\n404|    if len(line) - len(stripped) > 3 or stripped[:1] not in (\"`\", \"~\"):\n405|        return \"\", 0, \"\"\n406|    char = stripped[0]\n407|    rest = stripped.lstrip(char)\n408|    run = len(stripped) - len(rest)\n409|    return (char, run, rest) if run >= 3 else (\"\", 0, \"\")\n410|\n411|\n412|def _is_fence_open(char: str, run: int, rest: str) -> bool:\n413|    \"\"\"Строка-забор открывает блок: в info-строке бэктик-забора нет бэктиков.\"\"\"\n414|    return bool(run) and (char == \"~\" or \"`\" not in rest)\n415|\n416|\n417|def _find_closing_run(doc: str, start: int, end: int, ticks: int) -> int:\n418|    \"\"\"Конец первой серии ровно из `ticks` бэктиков в `doc[start:end]`, или -1.\"\"\"\n419|    index = start\n420|    while index < end:\n421|        if doc[index] != \"`\":\n422|            index += 1\n423|            continue\n424|        run_start = index\n425|        while index < end and doc[index] == \"`\":\n426|            index += 1\n427|        if index - run_start == ticks:\n428|            return index\n429|    return -1\n430|\n431|\n432|def _is_atx_heading(line: str) -> bool:\n433|    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n434|    stripped = line.lstrip(\" \")\n435|    if len(line) - len(stripped) > 3:\n436|        return False\n437|    rest = stripped.lstrip(\"#\")\n438|    return 1 <= len(stripped) - len(rest) <= 6 and (\n439|        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n440|    )\n441|\n442|\n443|def _code_context(doc: str, pos: int, final: bool) -> str:\n444|    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n445|\n446|    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n447|    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n448|    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n449|    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n450|    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n451|    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n452|    \"\"\"\n453|    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n454|    fence_char, fence_len, para, index = \"\", 0, 0, 0\n455|    while index < line_start:\n456|        eol = doc.index(\"\\n\", index)\n457|        line = doc[index:eol]\n458|        char, run, rest = _fence_run(line)\n459|        if fence_len:\n460|            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n461|                fence_len, para = 0, eol + 1\n462|        elif _is_fence_open(char, run, rest):\n463|            fence_char, fence_len = char, run\n464|        elif not line.strip() or _is_atx_heading(line):\n465|            para = eol + 1\n466|        index = eol + 1\n467|    if fence_len:\n468|        return \"code\"\n469|    eol = doc.find(\"\\n\", pos)\n470|    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n471|    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n472|        return \"code\" if eol != -1 or final else \"wait\"\n473|    para_end, decided = len(doc), final\n474|    index = len(doc) if eol == -1 else eol + 1\n475|    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n476|        para = line_start  # заголовок — отдельный однострочный блок\n477|        if eol != -1:\n478|            para_end, decided, index = eol, True, len(doc)\n479|    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n480|        nxt = doc.find(\"\\n\", index)\n481|        line = doc[index : len(doc) if nxt == -1 else nxt]\n482|        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n483|        if (\n484|            nxt == -1\n485|            and not final\n486|            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n487|        ):\n488|            break\n489|        char, run, rest = _fence_run(line)\n490|        if not line.strip() or _is_fence_open(char, run, rest) or _is_atx_heading(line):\n491|            para_end, decided = index, True\n492|            break\n493|        if nxt == -1:\n494|            break\n495|        index = nxt + 1\n496|    index = para\n497|    while index < pos:\n498|        char = doc[index]\n499|        if char == \"\\\\\":\n500|            index += 2\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"call_id":"call_01a18c625eda732c8be3fd44478459c3","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/AGENTS.md`.\n1|# AGENTS.md — cli-agent-bridge\n2|\n3|Проектные правила для агентов. Общие правила владельца — канон `~/Мой диск/Context/AGENTS.md` (здесь не дублируются).\n4|\n5|## ⭐ Главный архитектурный принцип: универсальность и независимость от вендоров\n6|\n7|1. **Максимальная универсальность:** все доработки делаются максимально универсальными, чтобы не зависеть от вендоров и сторонних сред исполнения.\n8|2. **Запрет на правку вендорского кода:** категорически запрещено модифицировать, патчить или внедрять оверлеи во внешние вендорские приложения и среды (включая DeepSeek Harness, Claude Code, Cursor, Factory Droid и др.) — ни напрямую в исходники/бинари/asar, ни через подмену модулей в профилях (`~/.dsh/`, `~/.claude/` и т.п.).\n9|3. **Реализация только на нашем универсальном слое:** любые исправления дефектов интеграции, нормализация протоколов, санитизация параметров вызова инструментов (tool calls), эмуляция API и адаптация форматов выполняются **только в нашем собственном коде (`cli-agent-bridge`)** на том слое абстракции (фасад, ядро эмуляции, адаптеры), где решение работает единообразно и универсально для всех потребителей.\n10|\n11|## О проекте cli-agent-bridge\n12|\n13|Универсальный шлюз (мост/фасад), объединяющий CLI-агентов и LLM различных провайдеров в единый OpenAI-совместимый эндпоинт (`POST /v1/chat/completions`, `GET /v1/models`, SSE-стриминг, `tools`/`tool_calls`).\n14|\n15|### Архитектурные слои\n16|- `server.py` — единый HTTP-фасад (OpenAI-compatible API, маршрутизация запросов, управление подключениями).\n17|- `core/` — универсальное ядро:\n18|  - `core/tool_emulation.py` — протокол и эмуляция function calling, парсинг и санитизация `<tool_call>`.\n19|  - `core/backend_adapter.py` — базовые абстракции и контракты адаптеров бэкендов.\n20|  - `core/turn_session_manager.py` — управление сессиями, контекстом и процессами.\n21|  - `core/context_resilience.py` — устойчивость к переполнению контекста и сжатие.\n22|- `adapters/` — адаптеры к конкретным CLI-транспортам и средам (Droid, Muse, Codex и др.).\n23|- `bridges/` — специализированные мосты (`agy-bridge`, `muse-bridge`, `opencode-zen-bridge`).\n24|\n25|## Верификация и тесты\n26|\n27|Перед фиксацией любых изменений запускать набор тестов:\n28|```bash\n29|pytest tests/ -v\n30|```\n31|Код должен следовать правилам строгой типизации, не ломать обратную совместимость API и изолировать особенности конкретных вендоров внутри соответствующих адаптеров.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c441","stream":{"kind":"session","id":"01a18c5f-eb14-77e3-ad64-036ff1dd8760"},"sequence":123,"recorded_at":1780531400000241,"record_type":"event","durability":"durable","causation_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70","run_stream":{"kind":"run","id":"01a18c5f-ef67-7953-bf21-bd75bd2b0f70"},"call_id":"call_01a18c6261f47563b7c27e676812dcf1","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/universal-tool-sanitizer-20261030/architecture/architecture-packet.json`.\n1|{\n2|  \"schema_version\": \"1.0\",\n3|  \"task_id\": \"universal-tool-sanitizer-20261030\",\n4|  \"run_id\": \"universal-tool-sanitizer-20261030\",\n5|  \"criticality\": \"S2\",\n6|  \"profile\": \"python-aisdlc-gcge\",\n7|  \"status\": \"PROPOSED\",\n8|  \"delta\": \"A1\",\n9|  \"title\": \"Универсальная нормализация аргументов tool_calls и распаковка parallel в cli-agent-bridge\",\n10|  \"requirements\": [\n11|    {\n12|      \"id\": \"REQ-01\",\n13|      \"text\": \"Изоляция от вендорских сред (Vendor Zero-Touch): Никаких модификаций или оверлеев во внешние вендорские приложения (DSH и др.). Все изменения — строго в нашем репозитории cli-agent-bridge на универсальном слое.\",\n14|      \"source\": \"Инвариант владельца в AGENTS.md\",\n15|      \"verification_ids\": [\"VER-001\", \"VER-004\"]\n16|    },\n17|    {\n18|      \"id\": \"REQ-02\",\n19|      \"text\": \"Универсальная санитизация пустых строковых аргументов: Очистка пустых строк (\\\"\\\") из необязательных параметров вызова инструментов (provider, model, reasoning_effort, justification и др.) в исходящих tool_calls перед отправкой клиенту.\",\n20|      \"source\": \"Session 38008581 rca: Error: child LLM provider must be non-empty\",\n21|      \"verification_ids\": [\"VER-002\", \"VER-003\"]\n22|    },\n23|    {\n24|      \"id\": \"REQ-03\",\n25|      \"text\": \"Распаковка синтетического инструмента parallel: Вызовы name='parallel' с массивом tool_uses автоматически распаковываются в стандартные независимые ToolCall первого уровня.\",\n26|      \"source\": \"Session 38008581 rca: Error: unknown tool parallel\",\n27|      \"verification_ids\": [\"VER-002\"]\n28|    },\n29|    {\n30|      \"id\": \"REQ-04\",\n31|      \"text\": \"Безопасный fallback для justification: При наличии sandbox_permissions и пустом justification подставлять безопасный дефолт, предотвращая ошибку invalid justification.\",\n32|      \"source\": \"Session 38008581 rca: Error: invalid justification: expected a non-empty sentence\",\n33|      \"verification_ids\": [\"VER-002\"]\n34|    },\n35|    {\n36|      \"id\": \"REQ-05\",\n37|      \"text\": \"Поддержка non-streaming и SSE streaming: Санитизация работает одинаково корректно в обоих режимах генерации.\",\n38|      \"source\": \"Архитектурный контракт server.py\",\n39|      \"verification_ids\": [\"VER-003\", \"VER-005\"]\n40|    }\n41|  ],\n42|  \"decisions\": [\n43|    {\n44|      \"id\": \"AD-001\",\n45|      \"status\": \"PROPOSED\",\n46|      \"kind\": \"two-way\",\n47|      \"question\": \"На каком слое реализовать очистку пустых аргументов и распаковку parallel?\",\n48|      \"choice\": \"В модуле core/tool_emulation.py как универсальный чистый конвейер sanitize_tool_call / sanitize_tool_calls_list, не зависящий от конкретного бэкенда или клиента.\",\n49|      \"alternatives\": [\n50|        \"A: В core/tool_emulation.py (выбрано: централизованно, переиспользуемо всеми бэкендами и фасадом)\",\n51|        \"B: В отдельных адаптерах бэкендов (дублирование логики между droid, muse, codex)\",\n52|        \"C: Через патчинг клиентского DSH (запрещено владельцем)\"\n53|      ],\n54|      \"drivers\": [\"REQ-01\", \"REQ-02\", \"REQ-03\", \"Инвариант AGENTS.md\"],\n55|      \"consequences\": [\"Все исходящие вызовы инструментов автоматически санитизируются до попадания к клиенту\"],\n56|      \"verification_ids\": [\"VER-002\"]\n57|    },\n58|    {\n59|      \"id\": \"AD-002\",\n60|      \"status\": \"PROPOSED\",\n61|      \"kind\": \"two-way\",\n62|      \"question\": \"Как интегрировать санитизацию в фасад server.py?\",\n63|      \"choice\": \"Применять sanitize_tool_calls_list в ChatCompletionResponse перед сериализацией JSON, а также в потоковом цикле SSE перед отправкой финальных дельт tool_calls.\",\n64|      \"alternatives\": [\n65|        \"A: Фасадный хук на сериализации ответа (выбрано)\",\n66|        \"B: Модификация входящих запросов (не решает проблему генерации модели)\"\n67|      ],\n68|      \"drivers\": [\"REQ-05\"],\n69|      \"consequences\": [\"Клиент гарантированно получает валидный OpenAI-совместимый JSON без пустых опциональных строк\"],\n70|      \"verification_ids\": [\"VER-003\", \"VER-005\"]\n71|    },\n72|    {\n73|      \"id\": \"AD-003\",\n74|      \"status\": \"PROPOSED\",\n75|      \"kind\": \"one-way\",\n76|      \"question\": \"Политика модификации вендорских компонентов (DSH, Claude Code, Cursor)?\",\n77|      \"choice\": \"Zero-Touch: внешний софт не модифицируется, файлы ~/.dsh, app.asar и чужие профили остаются нетронутыми.\",\n78|      \"alternatives\": [\n79|        \"A: Zero-Touch (выбрано)\",\n80|        \"B: Overlay в ~/.dsh (отклонено владельцем)\"\n81|      ],\n82|      \"drivers\": [\"REQ-01\", \"Принцип независимости от вендоров в AGENTS.md\"],\n83|      \"consequences\": [\"Обновления DSH или смена клиента больше не ломают работоспособность решения\"],\n84|      \"verification_ids\": [\"VER-001\", \"VER-004\"]\n85|    }\n86|  ],\n87|  \"risks\": [\n88|    {\n89|      \"id\": \"RISK-001\",\n90|      \"scenario\": \"Инструмент легитимно ожидает пустую строку в качестве валидного аргумента.\",\n91|      \"probability\": \"LOW\",\n92|      \"impact\": \"MEDIUM\",\n93|      \"mitigation\": \"Удалять пустые строки только если поле не входит в required-схему инструмента, либо является известным опциональным параметром (provider, model, reasoning_effort, justification).\"\n94|    }\n95|  ]\n96|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
