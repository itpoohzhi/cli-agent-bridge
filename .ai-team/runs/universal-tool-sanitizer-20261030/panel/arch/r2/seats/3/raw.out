\\n            except Exception:  # noqa: BLE001\\n                pass\\n\\n    def reset(self) -> None:\\n        \\\"\\\"\\\"Сбрасывает состояние менеджера (для изоляции тестов).\\\"\\\"\\\"\\n        with self._cond:\\n            active = [t for t in self._turns_by_id.values() if t.is_active]\\n        for turn in active:\\n            try:\\n                self.cancel_turn(turn.turn_id, reason=\\\"reset\\\")\\n            except Exception:  # noqa: BLE001\\n                pass\\n        with self._cond:\\n            self._turns_by_id.clear()\\n            self._active_by_key.clear()\\n            self._children.clear()\\n            self._cond.notify_all()\\n\\n    reset_state = reset\\n\\n===tools-in-request\\nserver.py:68:sys.path.insert(0, str(ROOT / \\\"tools\\\"))\\nserver.py:3025:        tools = result.get(\\\"tools\\\")\\nserver.py:5303:            raw_tools = req.get(\\\"tools\\\")\\ncore/context_resilience.py:1135:    for field_name in (\\\"tools\\\", \\\"functions\\\"):\\n\",\n  \"original_output_bytes\": 5600,\n  \"original_output_tokens\": 1400,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
