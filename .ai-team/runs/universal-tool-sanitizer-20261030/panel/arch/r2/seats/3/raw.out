 \\\"tool_calls\\\": [],\\n4507:                        \\\"tool_calls\\\": [],\\n4546:                        \\\"tool_calls\\\": [],\\n4557:                    out.get(\\\"text\\\") or out.get(\\\"tool_calls\\\") or run._live_mids\\n4723:        if out.get(\\\"rc\\\") != 0 or not (out.get(\\\"text\\\") or out.get(\\\"tool_calls\\\")):\\n5599:                \\\"tool_calls\\\": [],\\n5634:            \\\"tool_calls\\\": [asdict(call) for call in result.tool_calls],\\n5680:        if out.get(\\\"tool_calls\\\"):\\n5682:            for call in out[\\\"tool_calls\\\"]:\\n5690:            message[\\\"tool_calls\\\"] = calls\\n5691:            finish = \\\"tool_calls\\\"\\n5737:            return self._emit(chunk({\\\"tool_calls\\\": [call]}))\\n5739:        if not self._emit(chunk({\\\"tool_calls\\\": [first]})):\\n5745:                        \\\"tool_calls\\\": [\\n5929:            finish = \\\"tool_calls\\\" if out.get(\\\"tool_calls\\\") else \\\"stop\\\"\\n5951:                            # \\\"stop\\\"/\\\"tool_calls\\\" на том же кадре. Для остальных бэкендов это\\n===FEATURE-FLAGS\\n)\\n\\n# Токеноподобные последовательности: длинные (>=24) и явные Factory-ключи `fk-`\\n# любой длины — короткий ключ иначе проходил мимо маскировщика в журнал.\\n_SECRET = re.compile(r\\\"[A-Za-z0-9_\\\\-]{24,}|fk-[A-Za-z0-9_\\\\-]{4,}\\\")\\n_NOISE = re.compile(\\n    r\\\"NODE_TLS_REJECT_UNAUTHORIZED|--trace-warnings|^\\\\(node:\\\\d+\\\\)\\\", re.I\\n)\\n\\n_slots = threading.BoundedSemaphore(MAX_CONCURRENT)\\n_active = {}\\n_active_lock = threading.Lock()\\n_started = time.time()\\n# Монотонная метка последнего успешного хода (0.0 = не было / последний провалился).\\n_last_ok = [0.0]\\n# Байтовый бюджет admission; включается в main() (в тестах/импорте — None).\\n_budget = None\\n\\n# ---- ОТКАЗОУСТОЙЧИВОСТЬ КОНТЕКСТА (EYE-33873, ADR-0006): общее ядро core/context_resilience.\\n# Флаги читаются из локального снимка GigaRC (дефолт false = прежнее поведение хаба).\\nCONTEXT_FLAGS = ctxres.FlagSource()\\nCONTEXT_EPOCHS = ctxres.EpochStore()\\n# Droid-маршрут хаба не квалифицирован (VER-006): строгий admission включается только флагом\\n# DYNAMIC_PRUNER_ENABLED; после паспорта счётчика владелец переводит маршрут в enrolled.\\nCONTEXT_ENROLLED = False\\nCONTEXT_DEFAULT_MAX_OUTPUT = 65536\\n_CONTEXT_OWNER_SECRET = os.urandom(32)\\n_sha_cache = {}\\n_sha_cache_lock = threading.Lock()\\n\\n# ---- RPC-СОСТОЯНИЕ: долгоживущий `droid exec --input-format stream-jsonrpc` на чат.\\n# Ключ чата — prompt_cache_key запроса (никогда не путь/argv: только sha256).\\n# Часы и пауза подменяются в тестах (fake clock): idle-реап и ретраи 2/4 с не\\n# должны замедлять набор.\\nRPC_NAMESPACE = \\\"droid-bridge/v1\\\"\\n# Idle-гашение процесса чата (по monotonic времени последнего terminal/release).\\nIDLE_SECONDS = float(os.environ.get(\\\"DROID_DSH_BRIDGE_IDLE_SECONDS\\\", \\\"2700\\\"))\\nREAPER_TICK_S = 1.0\\n# Тишина без событий ТЕКУЩЕГО хода после первого события (сбрасывают только они).\\nSILENCE_WATCHDOG_S = float(os.environ.get(\\\"DROID_BRIDGE_SILENCE_WATCHDOG_S\\\", \\\"120\\\"))\\n# Ожидание ответа на служебный запрос (initialize/load/update/list_tools/add).\\nRPC_CALL_TIMEOUT_S = float(os.environ.get(\\\"DROID_BRIDGE_RPC_CALL_TIMEOUT_S\\\", \\\"60\\\"))\\n# После interrupt ждём terminal столько, затем процесс закрывается принудительно.\\nINTERRUPT_GRACE_S = 3.0\\n# Не больше пяти restore на один SID: шестой — свежая generation (вторичный предел).\\nRESTORE_MAX = 5\\n# Общий грейс остановки моста (< exit timeout 5 с), SIGTERM->waitpid при вытеснении.\\nSHUTDOWN_GRACE_S = 4.5\\nTERM_WAIT_S = 2.0\\nKEY_MAX_LEN = 512\\n# Структурные признаки title-запроса DSH (F-512): размер сообщения не критерий.\\nTITLE_SYSTEM_PREFIX = (\\n    \\\"Create a concise title for an AI coding-assistant session \\\"\\n    \\\"from the supplied human messages.\\\"\\n)\\nTITLE_USER_PREFIX = \\\"Generate the session title from this JSON array of human messages:\\\"\\nTITLE_MAX_TOKENS = 64\\n# Допуск Droid-бинаря (AD-010, RW-007): spawn только по receipt квалификации неизменяемого\\n# образа; `DROID_DSH_BRIDGE_RECEIPT_REQUIRED=0` отключает gate (только стенд/разработка).\\nRECEIPT_REQUIRED = os.environ.get(\\\"DROID_DSH_BRIDGE_RECEIPT_REQUIRED\\\", \\\"1\\\") != \\\"0\\\"\\n# Байтовые бюджеты (AD-011/TM-020, RW-008): превышение — предусмотренная ошибка, процесс и\\n===CANON-GigaRC-check\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:28:      \\\"verification_ids\\\": [\\\"VER-001\\\", \\\"VER-004\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:34:      \\\"verification_ids\\\": [\\\"VER-002\\\", \\\"VER-003\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:40:      \\\"verification_ids\\\": [\\\"VER-002\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:46:      \\\"verification_ids\\\": [\\\"VER-002\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:52:      \\\"verification_ids\\\": [\\\"VER-003\\\", \\\"VER-005\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:69:      \\\"verification_ids\\\": [\\\"VER-002\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:83:      \\\"verification_ids\\\": [\\\"VER-003\\\", \\\"VER-005\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat1.md:97:      \\\"verification_ids\\\": [\\\"VER-001\\\", \\\"VER-004\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat2.md:28:      \\\"verification_ids\\\": [\\\"VER-001\\\", \\\"VER-004\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat2.md:34:      \\\"verification_ids\\\": [\\\"VER-002\\\", \\\"VER-003\\\"]\\n.ai-team/runs/universal-tool-sanitizer-20261030/consensus/briefs/r1/seat2.md:40:      \\\"verification_ids\\\": [\\\"VER-002\\\"]\\n.ai-team/runs