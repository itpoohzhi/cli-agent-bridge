{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'cat core/tool_emulation.py'","aggregated_output":"\"\"\"Общее ядро эмуляции OpenAI function calling (чистые функции, без I/O).\n\nЕдиный источник для всех бэкендов хаба: рендер истории и протокола инструментов в\nтекстовый промпт, разбор блоков `<tool_call>…</tool_call>` из потока текстовых дельт.\nМодуль не импортирует `server` и адаптеры; `server.py` реэкспортирует имена для\nсуществующих тестов и совместимости.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import replace\nfrom typing import Any\nfrom core.backend_adapter import ToolCall, ToolFunction, TurnEvent, TurnResult\n\nTOOL_CALL_OPEN = \"<tool_call>\"\nTOOL_CALL_CLOSE = \"</tool_call>\"\n\n\ndef _flatten_content(content: Any) -> str:\n    if content is None:\n        return \"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        parts = []\n        for item in content:\n            if isinstance(item, str):\n                parts.append(item)\n            elif isinstance(item, dict) and \"text\" in item:\n                parts.append(str(item[\"text\"]))\n        return \"\\n\".join(p for p in parts if p)\n    return str(content)\n\n\ndef _render_content(content: Any, counter: list) -> str:\n    \"\"\"Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.\n\n    Нумерация сквозная по порядку появления во всей истории. Неизвестные\n    НЕ-image части (например input_audio) молча пропускаются, как раньше.\n    \"\"\"\n    if content is None:\n        return \"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        parts = []\n        for item in content:\n            if isinstance(item, str):\n                parts.append(item)\n            elif isinstance(item, dict):\n                if item.get(\"type\") == \"image_url\":\n                    counter[0] += 1\n                    parts.append(f\"[image {counter[0]}]\")\n                elif \"text\" in item and item.get(\"text\") is not None:\n                    parts.append(str(item[\"text\"]))\n        return \"\\n\".join(p for p in parts if p)\n    return str(content)\n\n\ndef _normalize_arguments(value: Any) -> dict | None:\n    \"\"\"arguments -> JSON-объект; None, если значение задано, но объектом не является.\n\n    None отличает невалидные аргументы (строку-не-JSON, список, число, null) от\n    отсутствия ключа: вызывающий код не вправе молча подменять их на пустой словарь\n    и запускать инструмент с пустыми аргументами.\n    \"\"\"\n    if isinstance(value, dict):\n        return value\n    if isinstance(value, str):\n        text = value.strip()\n        if text:\n            try:\n                parsed = json.loads(text)\n            except ValueError:\n                return None\n            if isinstance(parsed, dict):\n                return parsed\n    return None\n\n\ndef _normalize_tool_call(item: Any) -> dict:\n    \"\"\"Один OpenAI tool_call -> {\"id\", \"name\", \"arguments\"}.\n\n    id сохраняется, чтобы результат [tool result <id>] однозначно сопоставлялся\n    с конкретным вызовом при нескольких одинаковых инструментах.\n    \"\"\"\n    if not isinstance(item, dict):\n        return {\"id\": \"\", \"name\": \"\", \"arguments\": {}}\n    fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else {}\n    name = fn.get(\"name\") or item.get(\"name\") or \"\"\n    args = fn.get(\"arguments\")\n    if args is None:\n        args = item.get(\"arguments\")\n    normalized = _normalize_arguments(args)\n    return {\n        \"id\": str(item.get(\"id\") or \"\"),\n        \"name\": str(name),\n        \"arguments\": normalized if normalized is not None else {},\n    }\n\n\ndef _render_tool_call(item: Any) -> str:\n    \"\"\"Историю вызова рендерим тем же блоком, что просим от модели.\"\"\"\n    payload = json.dumps(_normalize_tool_call(item), ensure_ascii=False)\n    return f\"{TOOL_CALL_OPEN}{payload}{TOOL_CALL_CLOSE}\"\n\n\ndef _tool_choice_none(tool_choice: Any) -> bool:\n    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n\n\ndef _tool_choice_name(tool_choice: Any) -> str:\n    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n    if not isinstance(tool_choice, dict):\n        return \"\"\n    fn = (\n        tool_choice.get(\"function\")\n        if isinstance(tool_choice.get(\"function\"), dict)\n        else {}\n    )\n    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n    return str(name) if name else \"\"\n\n\ndef _tools_section(tools: list, tool_choice: Any, has_attachments: bool = False) -> str:\n    \"\"\"Английская секция протокола и схем инструментов для промпта.\"\"\"\n    lines = [\n        \"[system]\",\n        \"# Tool calling protocol\",\n        \"You may call the external tools listed below.\",\n        \"When you need a tool, output ONLY blocks exactly in this form:\",\n        f'{TOOL_CALL_OPEN}{{\"name\": \"<tool_name>\", \"arguments\": {{<json>}}}}{TOOL_CALL_CLOSE}',\n        \"You may output several such blocks in a row. Do not narrate around them.\",\n        \"Tool results arrive later as lines like [tool result <id>] with the result text.\",\n        \"If no tool is needed, reply normally in plain text.\",\n        \"Never attempt to use built-in tools; the only tools available are the ones listed here.\",\n    ]\n    if has_attachments:\n        lines[-1] += \", except Read on the attachment files listed under [attachments].\"\n    if tool_choice == \"required\":\n        lines.append(\"You MUST call at least one tool now.\")\n    else:\n        forced = _tool_choice_name(tool_choice)\n        if forced:\n            lines.append(f'You MUST call the tool \"{forced}\" now.')\n    lines.append(\"\")\n    lines.append(\"Available tools:\")\n    for item in tools:\n        fn = item.get(\"function\") if isinstance(item.get(\"function\"), dict) else item\n        if not isinstance(fn, dict):\n            continue\n        name = str(fn.get(\"name\") or \"\")\n        desc = str(fn.get(\"description\") or \"\")\n        params = fn.get(\"parameters\") if isinstance(fn.get(\"parameters\"), dict) else {}\n        lines.append(f\"- {name}: {desc}\")\n        lines.append(\"  parameters: \" + json.dumps(params, ensure_ascii=False))\n    return \"\\n\".join(lines)\n\n\ndef _render_message(msg: Any, counter: list) -> str:\n    \"\"\"Одно сообщение истории -> текстовый блок (с рендером tool-вызовов/результатов).\"\"\"\n    if not isinstance(msg, dict):\n        return \"\"\n    role = str(msg.get(\"role\") or \"user\")\n    if role == \"tool\":\n        call_id = str(msg.get(\"tool_call_id\") or msg.get(\"id\") or \"\")\n        name = str(msg.get(\"name\") or \"\")\n        text = _render_content(msg.get(\"content\"), counter)\n        header = f\"[tool result {call_id}]\"\n        if name:\n            header += f\" ({name})\"\n        return f\"{header}\\n{text}\" if text.strip() else header\n    text = _render_content(msg.get(\"content\"), counter)\n    if role == \"assistant\":\n        parts = []\n        if text.strip():\n            parts.append(text)\n        calls = msg.get(\"tool_calls\")\n        if isinstance(calls, list):\n            parts.extend(_render_tool_call(tc) for tc in calls)\n        body = \"\\n\".join(p for p in parts if p)\n        return f\"[assistant]\\n{body}\" if body.strip() else \"\"\n    if text.strip():\n        return f\"[{role}]\\n{text}\"\n    return \"\"\n\n\ndef _attachments_section(images: list) -> str:\n    \"\"\"Хвост промпта метода workspace-read (эталон — kit/mkprompt.py).\"\"\"\n    lines = [\n        \"[attachments]\",\n        \"This request includes %d image(s) as local files in the working directory. \"\n        \"The markers [image N] in the conversation refer to them in order.\"\n        % len(images),\n    ]\n    for index, image in enumerate(images, 1):\n        lines.append(\n            \"- [image %d] ./%s (%s, %d bytes)\"\n            % (index, image[\"name\"], image[\"mime\"], len(image[\"data\"]))\n        )\n    lines.append(\n        \"Open each image with the Read tool on exactly these paths before answering about it \"\n        \"(Read is the only built-in tool you may use, and only on these files). Do not claim to \"\n        \"see an image you have not opened. If an image cannot be opened, say so explicitly \"\n        \"instead of guessing.\"\n    )\n    return \"\\n\".join(lines)\n\n\ndef _messages_to_prompt(\n    messages: list,\n    tools: list | None = None,\n    tool_choice: Any = None,\n    images: list | None = None,\n) -> str:\n    \"\"\"Собрать единый текстовый промпт; при наличии tools — с секцией протокола.\n\n    При наличии изображений в конец добавляется секция [attachments], а строка\n    протокола инструментов получает исключение для Read (C-09).\n    \"\"\"\n    tools = tools or []\n    counter = [0]\n    blocks = []\n    for msg in messages:\n        rendered = _render_message(msg, counter)\n        if rendered:\n            blocks.append(rendered)\n    head = []\n    if tools and not _tool_choice_none(tool_choice):\n        head.append(_tools_section(tools, tool_choice, bool(images)))\n    text = \"\\n\\n\".join(head + blocks).strip() or \"Reply with exactly: PONG\"\n    if images:\n        text = text + \"\\n\\n\" + _attachments_section(images)\n    return text\n\n\ndef _strip_code_fence(text: str) -> str:\n    \"\"\"Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока.\"\"\"\n    body = text.strip()\n    if body.startswith((\"```\", \"~~~\")):\n        newline = body.find(\"\\n\")\n        body = body[newline + 1 :] if newline != -1 else body[3:]\n    if body.rstrip().endswith((\"```\", \"~~~\")):\n        body = body.rstrip()[:-3]\n    return body.strip()\n\n\n_MAX_EXTRA_BRACES = 16  # предел лишних `}` после полного объекта вызова\n\n\ndef _recover_trailing_braces(text: str) -> dict | None:\n    \"\"\"Первый JSON-объект, за которым идут только пробелы и 1..16 лишних `}`; иначе None (холодный путь).\"\"\"\n    body = text.lstrip()\n    try:\n        obj, end = json.JSONDecoder().raw_decode(body)\n    except (ValueError, RecursionError):\n        return None\n    tail = body[end:]\n    if (\n        isinstance(obj, dict)\n        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n        and not tail.strip(\" \\t\\r\\n}\")\n    ):\n        return obj\n    return None\n\n\ndef _loads_tolerant(text: str) -> Any:\n    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n\n    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n    \"\"\"\n    try:\n        return json.loads(text)\n    except (ValueError, RecursionError) as exc:\n        recovered = _recover_trailing_braces(text)\n        if recovered is None:\n            if isinstance(exc, RecursionError):\n                raise ValueError(\"JSON is nested too deeply\") from exc\n            raise\n        return recovered\n\n\ndef _parse_tool_call_block(inner: str) -> dict | None:\n    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n\n    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n    \"\"\"\n    try:\n        obj = _loads_tolerant(_strip_code_fence(inner))\n    except ValueError:\n        return None\n    if not isinstance(obj, dict):\n        return None\n    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n        obj = obj[\"function\"]\n    name = obj.get(\"name\")\n    if not isinstance(name, str) or not name.strip():\n        return None\n    if \"arguments\" not in obj:\n        arguments: dict = {}\n    else:\n        normalized = _normalize_arguments(obj.get(\"arguments\"))\n        if normalized is None:\n            return None\n        arguments = normalized\n    return {\"name\": name.strip(), \"arguments\": arguments}\n\n\nclass LiveParserError(Exception):\n    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n\n    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n    fail-close всего live-хода (сырой XML клиенту не уходит).\n    \"\"\"\n\n\ndef _is_quoted_open(text: str, start: int) -> bool:\n    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n    if start > 0 and text[start - 1] == \"`\":\n        return True\n    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n\n\ndef _split_tool_call_inner(inner: str) -> list[str]:\n    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n\n    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n    границей не считается (та же логика, что в `_find_close_outside_string`).\n    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n    \"\"\"\n    segments: list[str] = []\n    seg_start = 0\n    index = 0\n    length = len(inner)\n    in_string = False\n    escaped = False\n    while index < length:\n        char = inner[index]\n        if in_string:\n            if escaped:\n                escaped = False\n            elif char == \"\\\\\":\n                escaped = True\n            elif char == '\"':\n                in_string = False\n        elif char == '\"':\n            in_string = True\n        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n            inner, index\n        ):\n            segments.append(inner[seg_start:index])\n            index += len(TOOL_CALL_OPEN)\n            seg_start = index\n            continue\n        index += 1\n    segments.append(inner[seg_start:])\n    return segments\n\n\ndef _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n    \"\"\"Содержимое блока -> список вызовов; None, если блок (или любой его член) невалиден.\n\n    Обычный блок даёт один вызов. Если он не разбирается, но внутри есть\n    несколько `<tool_call>` без промежуточных закрывающих тегов, блок делится на\n    сегменты; пачка принимается только целиком (все сегменты валидны).\n    \"\"\"\n    single = _parse_tool_call_block(inner)\n    if single is not None:\n        return [single]\n    if TOOL_CALL_OPEN not in inner:\n        return None\n    segments = _split_tool_call_inner(inner)\n    if len(segments) < 2:\n        return None\n    calls: list[dict] = []\n    for segment in segments:\n        call = _parse_tool_call_block(segment)\n        if call is None:\n            return None\n        calls.append(call)\n    return calls\n\n\n_OPAQUE_BLOCK = \"￼\"  # в `_history` на месте разобранного блока вызова\n\n\ndef _fence_run(line: str) -> tuple[str, int, str]:\n    \"\"\"Строка -> (символ, длина серии, остаток), если это строка-забор fenced-блока.\n\n    Забор — серия от 3 одинаковых бэктиков или тильд после отступа до 3 пробелов;\n    (\"\", 0, \"\") — не забор.\n    \"\"\"\n    stripped = line.lstrip(\" \")\n    if len(line) - len(stripped) > 3 or stripped[:1] not in (\"`\", \"~\"):\n        return \"\", 0, \"\"\n    char = stripped[0]\n    rest = stripped.lstrip(char)\n    run = len(stripped) - len(rest)\n    return (char, run, rest) if run >= 3 else (\"\", 0, \"\")\n\n\ndef _is_fence_open(char: str, run: int, rest: str) -> bool:\n    \"\"\"Строка-забор открывает блок: в info-строке бэктик-забора нет бэктиков.\"\"\"\n    return bool(run) and (char == \"~\" or \"`\" not in rest)\n\n\ndef _find_closing_run(doc: str, start: int, end: int, ticks: int) -> int:\n    \"\"\"Конец первой серии ровно из `ticks` бэктиков в `doc[start:end]`, или -1.\"\"\"\n    index = start\n    while index < end:\n        if doc[index] != \"`\":\n            index += 1\n            continue\n        run_start = index\n        while index < end and doc[index] == \"`\":\n            index += 1\n        if index - run_start == ticks:\n            return index\n    return -1\n\n\ndef _is_atx_heading(line: str) -> bool:\n    \"\"\"Строка — ATX-заголовок: отступ до 3 пробелов, 1-6 `#`, затем пробел/таб/конец.\"\"\"\n    stripped = line.lstrip(\" \")\n    if len(line) - len(stripped) > 3:\n        return False\n    rest = stripped.lstrip(\"#\")\n    return 1 <= len(stripped) - len(rest) <= 6 and (\n        not rest.rstrip(\"\\r\") or rest[0] in \" \\t\"\n    )\n\n\ndef _code_context(doc: str, pos: int, final: bool) -> str:\n    \"\"\"Положение `pos` в `doc` относительно markdown-кода: \"code\" | \"text\" | \"wait\".\n\n    \"code\" — внутри fenced-блока (CommonMark: забор с отступом до 3 пробелов, закрывает\n    серия того же символа (``` или ~~~) не короче открывающей, без текста после неё) или парного inline-кода (серия из\n    k бэктиков и ближайшая серия ровно из k в том же абзаце; абзац обрывают пустая\n    строка, забор и ATX-заголовок — он сам отдельный блок). Непарная серия — обычный\n    текст. \"wait\" — ответ зависит от ещё не пришедшего текста (только при `final=False`).\n    Результат определяется одним `doc`, поэтому не зависит от нарезки потока на чанки.\n    \"\"\"\n    line_start = doc.rfind(\"\\n\", 0, pos) + 1\n    fence_char, fence_len, para, index = \"\", 0, 0, 0\n    while index < line_start:\n        eol = doc.index(\"\\n\", index)\n        line = doc[index:eol]\n        char, run, rest = _fence_run(line)\n        if fence_len:\n            if char == fence_char and run >= fence_len and not rest.strip(\" \\t\\r\"):\n                fence_len, para = 0, eol + 1\n        elif _is_fence_open(char, run, rest):\n            fence_char, fence_len = char, run\n        elif not line.strip() or _is_atx_heading(line):\n            para = eol + 1\n        index = eol + 1\n    if fence_len:\n        return \"code\"\n    eol = doc.find(\"\\n\", pos)\n    char, run, rest = _fence_run(doc[line_start : len(doc) if eol == -1 else eol])\n    if _is_fence_open(char, run, rest):  # тег в info-строке забора\n        return \"code\" if eol != -1 or final else \"wait\"\n    para_end, decided = len(doc), final\n    index = len(doc) if eol == -1 else eol + 1\n    if _is_atx_heading(doc[line_start : len(doc) if eol == -1 else eol]):\n        para = line_start  # заголовок — отдельный однострочный блок\n        if eol != -1:\n            para_end, decided, index = eol, True, len(doc)\n    while index < len(doc):  # абзац кончается пустой строкой, забором или заголовком\n        nxt = doc.find(\"\\n\", index)\n        line = doc[index : len(doc) if nxt == -1 else nxt]\n        # заголовок с текстом после `#` решён по префиксу, не дожидаясь конца строки\n        if (\n            nxt == -1\n            and not final\n            and not (_is_atx_heading(line) and line.lstrip(\" \").lstrip(\"#\"))\n        ):\n            break\n        char, run, rest = _fence_run(line)\n        if not line.strip() or _is_fence_open(char, run, rest) or _is_atx_heading(line):\n            para_end, decided = index, True\n            break\n        if nxt == -1:\n            break\n        index = nxt + 1\n    index = para\n    while index < pos:\n        char = doc[index]\n        if char == \"\\\\\":\n            index += 2\n        elif char != \"`\":\n            index += 1\n        else:\n            open_start = index\n            while index < para_end and doc[index] == \"`\":\n                index += 1\n            close_end = _find_closing_run(doc, index, para_end, index - open_start)\n            if close_end == -1:\n                if not decided:  # пара может прийти позже\n                    return \"wait\"\n            elif close_end > pos:\n                return \"wait\" if close_end == len(doc) and not final else \"code\"\n            else:\n                index = close_end\n    return \"text\"\n\n\nclass ToolCallParser:\n    \"\"\"Поток текстовых дельт -> content и завершённые вызовы инструментов.\n\n    Тег <tool_call> может прийти разорванным между дельтами: хвост, который может\n    оказаться началом тега, удерживается и не уходит в content до разрешения.\n\n    `strict_live=True` (AD-002, только Droid stream=true с живым sink) запрещает\n    malformed/unclosed recognized-блокам уйти в content как текст: вместо\n    `_flush_all()`/raw-passthrough поднимается `LiveParserError`. `strict_live=False`\n    (умолчание, legacy nonstream/без sink) ведёт себя абсолютно без изменений.\n    \"\"\"\n\n    def __init__(self, on_content, on_tool_call, strict_live: bool = False):\n        self._buf = \"\"\n        self._on_content = on_content\n        self._on_tool_call = on_tool_call\n        self.strict_live = strict_live\n        self._history = \"\"  # весь текст, ушедший в content\n\n    def feed(self, text: str) -> None:\n        self._buf += text\n        self._drain(final=False)\n\n    def finish(self) -> None:\n        self._drain(final=True)\n\n    def _classify_open(self, after: int, final: bool) -> str:\n        \"\"\"`<tool_call>` в буфере: \"real\" | \"quoted\" (inline-код markdown) | \"wait\" (нужен следующий символ).\"\"\"\n        context = _code_context(self._history + self._buf, len(self._history), final)\n        if context != \"text\":\n            return \"quoted\" if context == \"code\" else \"wait\"\n        tail = self._buf[after : after + 3]\n        if not tail:\n            return \"real\" if final else \"wait\"\n        # ```json-обёртка внутри блока — настоящий вызов\n        if tail[0] != \"`\" or tail == \"```\":\n            return \"real\"\n        if not final and tail == \"`\" * len(tail) and len(tail) < 3:\n            return \"wait\"\n        return \"quoted\"\n\n    def _drain(self, final: bool) -> None:\n        while True:\n            start = self._buf.find(TOOL_CALL_OPEN)\n            if start == -1:\n                if final:\n                    if (\n                        self.strict_live\n                        and self._pending_prefix()\n                        and not self._tail_in_code()\n                    ):\n                        raise LiveParserError(\"unresolved tool_call prefix at finish\")\n                    self._flush_all()\n                    return\n                keep = self._pending_prefix()\n                if keep:\n                    self._emit(self._buf[:-keep])\n                    self._buf = self._buf[-keep:]\n                else:\n                    self._flush_all()\n                return\n            if start > 0:\n                # всё до тега завершено: текст уходит в content и в `_history`\n                self._emit(self._buf[:start])\n                self._buf = self._buf[start:]\n            after = len(TOOL_CALL_OPEN)\n            verdict = self._classify_open(after, final)\n            if verdict == \"quoted\":\n                self._emit(self._buf[:after])\n                self._buf = self._buf[after:]\n                continue\n            if verdict == \"wait\":\n                return\n            end = self._find_close_outside_string(len(TOOL_CALL_OPEN))\n            if end == -1:\n                if final:\n                    if self.strict_live:\n                        raise LiveParserError(\"unclosed tool_call block\")\n                    self._flush_all()  # незакрытый/невалидный блок отдаём текстом\n                return\n            inner = self._buf[len(TOOL_CALL_OPEN) : end]\n            self._buf = self._buf[end + len(TOOL_CALL_CLOSE) :]\n            calls = _parse_tool_call_blocks(inner)\n            if calls is None:\n                if self.strict_live:\n                    raise LiveParserError(\"malformed tool_call block\")\n                self._emit(TOOL_CALL_OPEN + inner + TOOL_CALL_CLOSE)\n            else:\n                self._history += _OPAQUE_BLOCK\n                for call in calls:\n                    self._on_tool_call(call)\n\n    def _find_close_outside_string(self, start: int) -> int:\n        \"\"\"Позиция `</tool_call>` вне строковых литералов JSON, или -1.\n\n        Закрывающий тег внутри JSON-строки (например значение аргумента содержит\n        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n        строку не закрывают.\n        \"\"\"\n        index = start\n        length = len(self._buf)\n        in_string = False\n        escaped = False\n        while index < length:\n            char = self._buf[index]\n            if in_string:\n                if escaped:\n                    escaped = False\n                elif char == \"\\\\\":\n                    escaped = True\n                elif char == '\"':\n                    in_string = False\n            elif char == '\"':\n                in_string = True\n            elif self._buf.startswith(TOOL_CALL_CLOSE, index):\n                return index\n            index += 1\n        return -1\n\n    def _pending_prefix(self) -> int:\n        \"\"\"Длина хвоста — префикса открывающего тега (его нельзя отдать в content).\"\"\"\n        limit = min(len(TOOL_CALL_OPEN) - 1, len(self._buf))\n        for length in range(limit, 0, -1):\n            if self._buf[-length:] == TOOL_CALL_OPEN[:length]:\n                return length\n        return 0\n\n    def _tail_in_code(self) -> bool:\n        \"\"\"Хвост-префикс тега в буфере лежит внутри markdown-кода.\"\"\"\n        doc = self._history + self._buf\n        return _code_context(doc, len(doc) - self._pending_prefix(), True) == \"code\"\n\n    def _emit(self, text: str) -> None:\n        if text:\n            self._history += text\n            self._on_content(text)\n\n    def _flush_all(self) -> None:\n        if self._buf:\n            text, self._buf = self._buf, \"\"\n            self._emit(text)\n\n\ndef finalize_turn(raw: TurnResult, emulate_tools: bool) -> TurnResult:\n    \"\"\"Сырой итог адаптера -> `out` фасада с буфером `events` (content/reasoning/tool_call).\n\n    Готовый `out` (в нём уже есть `events`, как у droid-пути, где разбор идёт по потоку)\n    возвращается без изменений. Для остальных: размышления идут мимо парсера, текст — через\n    `ToolCallParser` при `emulate_tools`, вызовы получают `call_<hex>` как в droid-пути.\n    \"\"\"\n    if raw.events is not None:\n        return raw\n    events: list[TurnEvent] = []\n    tool_calls: list[ToolCall] = []\n    pieces: list[str] = []\n    reasoning = raw.reasoning\n    if reasoning:\n        events.append(TurnEvent(\"reasoning\", reasoning))\n\n    def add_content(text: str) -> None:\n        if text:\n            pieces.append(text)\n            events.append(TurnEvent(\"content\", text))\n\n    def add_call(call: dict) -> None:\n        entry = ToolCall(\n            index=len(tool_calls),\n            id=\"call_\" + uuid.uuid4().hex[:24],\n            function=ToolFunction(\n                call[\"name\"], json.dumps(call[\"arguments\"], ensure_ascii=False)\n            ),\n        )\n        tool_calls.append(entry)\n        events.append(TurnEvent(\"tool_call\", entry))\n\n    text = raw.text\n    if emulate_tools:\n        parser = ToolCallParser(add_content, add_call)\n        parser.feed(text)\n        parser.finish()\n    else:\n        add_content(text)\n    return replace(\n        raw, text=\"\".join(pieces), tool_calls=tuple(tool_calls), events=tuple(events)\n    )\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5520,6005p' server.py\"","aggregated_output":"        try:\n            blocks = _instr_blocks(messages, in_kb) if route != \"title\" else []\n            instr = _instr_scan(messages, in_kb) if blocks else (0, \"-\", 0)\n        except CanonPersistError:\n            # Код из базовой таксономии (503 launcher_unavailable): ход без подтверждённой истории канона не идёт.\n            self._reject(\n                503,\n                \"launcher_unavailable\",\n                \"canon history is not persisted: request refused before launch\",\n                model_id,\n                model_len,\n            )\n            return None\n        guard_state, guard_reasons, guard_max = GUARD.snapshot()\n        over = _instr_violation(blocks, guard_max)\n        if guard_state == \"unsafe\" and blocks:\n            # Профиль DSH небезопасен (alert уже в журнале): размер не режем немым 400, а явно\n            # отказываем только НОВЫМ чатам; живые резидентные чаты продолжают (RW-008).\n            refuse = not _chat_known(route, raw_key, adapter)\n            if refuse or over is not None:\n                top = over or (\n                    instr[2],\n                    _instr_limit(max(blocks, key=lambda b: b[\"bytes\"]), guard_max),\n                )\n                _log(\n                    f\"instr_gate_alert guard=unsafe refused={int(refuse)} bytes={top[0]} limit={top[1]}\"\n                )\n            if refuse:\n                # Код из базовой таксономии отказов (503 launcher_unavailable), клиенты DSH нового кода не знают.\n                self._reject(\n                    503,\n                    \"launcher_unavailable\",\n                    \"instruction guard is unsafe (\"\n                    + \"; \".join(guard_reasons)[:200]\n                    + \"): new chats are refused until the DSH profile is fixed\",\n                    model_id,\n                    model_len,\n                )\n                return None\n        elif over is not None:\n            # REQ-003: блок agent-instructions сверх применимого предела не доходит ни до spawn, ни до add.\n            _log(\n                f\"instr_gate_alert reason=REQ003_SIZE_EXCEEDED bytes={over[0]} limit={over[1]}\"\n            )\n            self._reject(\n                503,\n                \"launcher_unavailable\",\n                f\"agent-instructions block {over[0]} bytes exceeds {over[1]}: request refused before launch\",\n                model_id,\n                model_len,\n            )\n            return None\n        return instr\n\n    def _dispatch(\n        self, ctx: dict, keepalive, sse_writer: \"StreamSink | None\" = None\n    ) -> dict:\n        \"\"\"Ход через адаптер бэкенда модели; общий разбор `<tool_call>` и итог в формате фасада.\n\n        sse_writer не None только у настоящего живого SSE-хода (_serve_sse): адаптеры, умеющие\n        отдавать content/reasoning по мере готовности (сейчас — droid), сами вызывают его из\n        своего пути выполнения. Остальные (muse) его просто игнорируют — поведение не меняется.\n        \"\"\"\n        managed_turn: ManagedTurn | None = ctx.get(\"managed_turn\") or getattr(\n            self, \"_active_managed_turn\", None\n        )\n        if ctx.get(\"attached_existing\") and managed_turn is not None:\n            managed_turn.done_event.wait(timeout=TIMEOUT_S)\n            if managed_turn.final_dict is not None:\n                return dict(managed_turn.final_dict)\n        adapter = BACKENDS.get(ctx[\"backend\"])\n        if adapter is None:\n            return {\n                \"state\": \"launcher_unavailable\",\n                \"rc\": 1,\n                \"text\": \"\",\n                \"usage\": {},\n                \"result\": {},\n                \"err\": \"\",\n                \"tool_calls\": [],\n                \"events\": [],\n            }\n        transcript = ctx[\"rpc\"]\n        turn = TurnContext(\n            **{\n                key: value\n                for key, value in ctx.items()\n                if key not in (\"rpc\", \"images\", \"attached_existing\")\n            },\n            rpc=Transcript(\n                system=transcript[\"system\"],\n                runnable=transcript[\"runnable\"],\n                items=tuple(TranscriptItem(**item) for item in transcript[\"items\"]),\n            ),\n            images=tuple(ImageAttachment(**image) for image in ctx[\"images\"]),\n            handler=self,\n            keepalive=keepalive,\n            client_gone=lambda: _client_gone(self.connection),\n        )\n        t0 = time.monotonic()\n        raw_turn_result = adapter.execute_turn(turn, sse_writer)\n        result = finalize_turn(raw_turn_result, turn.emulate_tools)\n        if managed_turn is not None:\n            TURN_MANAGER.complete_turn_from_result(\n                managed_turn, result, backend_kind=adapter.kind\n            )\n        # Только локальный HTTP-буфер: межмодульный seam уже вернул DTO.\n        out = {\n            \"state\": result.state,\n            \"rc\": result.rc,\n            \"text\": result.text,\n            \"err\": result.err,\n            \"usage\": asdict(result.usage),\n            \"result\": {},\n            \"tool_calls\": [asdict(call) for call in result.tool_calls],\n            \"events\": [\n                (\n                    event.kind,\n                    asdict(event.value)\n                    if not isinstance(event.value, str)\n                    else event.value,\n                )\n                for event in result.events or ()\n            ],\n            \"backend_kind\": adapter.kind,\n        }\n        if (\n            adapter.kind != \"droid\"\n        ):  # droid-путь пишет свои done/usage строки в _run_once\n            # RW-007: сырой stderr/terminal reason бэкенда может содержать пользовательский\n            # текст; в постоянный журнал идут только коды и размеры (сырой err — в ответ клиенту).\n            _log(\n                f\"done model={ctx['model']} backend={adapter.id} rc={out.get('rc')} \"\n                f\"state={out.get('state')} out_bytes={len(str(out.get('text') or '').encode())} \"\n                f\"wall_s={time.monotonic() - t0:.1f} \"\n                f\"err_bytes={len(str(out.get('err') or '').encode())} {ctx['tag']}\"\n            )\n        return out\n\n    def _serve_json(self, ctx: dict) -> None:\n        out = self._dispatch(ctx, None)\n        if out.get(\"state\") == \"client_gone\":\n            return\n        err = self._error_body(out) or self._reserve_delivery(out)\n        if err is not None:\n            self._send(err[\"code\"], {\"error\": err})\n            return\n        usage = out.get(\"usage\") or {}\n        wire_usage = _wire_usage(\n            usage.get(\"input_tokens\", 0),\n            usage.get(\"output_tokens\", 0),\n            usage.get(\"cache_read_tokens\"),\n        )\n        # content и arguments вызовов сериализуются отдельно и вставляются на место меток: большой текст\n        # не проходит через дополнительный dict -> dumps -> encode (RW-012).\n        marker = \"@@content-\" + uuid.uuid4().hex + \"@@\"\n        message: dict = {\"role\": \"assistant\", \"content\": marker}\n        finish = \"stop\"\n        arg_markers: list = []\n        values = [out[\"text\"]]\n        if out.get(\"tool_calls\"):\n            calls = []\n            for call in out[\"tool_calls\"]:\n                arg_markers.append(\"@@args-\" + uuid.uuid4().hex + \"@@\")\n                values.append(call[\"function\"][\"arguments\"])\n                calls.append(\n                    dict(\n                        call, function=dict(call[\"function\"], arguments=arg_markers[-1])\n                    )\n                )\n            message[\"tool_calls\"] = calls\n            finish = \"tool_calls\"\n        shell = json.dumps(\n            {\n                \"id\": f\"chatcmpl-droid-{uuid.uuid4().hex[:12]}\",\n                \"object\": \"chat.completion\",\n                \"created\": int(time.time()),\n                \"model\": ctx[\"model\"],\n                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n                \"usage\": wire_usage,\n            },\n            ensure_ascii=False,\n        )\n        segments = []\n        rest = shell\n        for mark in [marker] + arg_markers:\n            head, rest = rest.split(json.dumps(mark), 1)\n            segments.append(head.encode(\"utf-8\"))\n        segments.append(rest.encode(\"utf-8\"))\n        # Content-Length считается проходом по срезам, тело пишется вторым проходом: целиком\n        # экранированная копия текста (до MAX_TURN_TEXT_BYTES) в памяти не строится.\n        total = sum(len(seg) for seg in segments) + 2 * len(values)\n        for value in values:\n            for piece in _text_slices(value):\n                total += len(_escape_json_piece(piece))\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(total))\n        active_turn = getattr(self, \"_active_managed_turn\", None)\n        if active_turn is not None:\n            self.send_header(\"X-Turn-Id\", active_turn.turn_id)\n        if self._context_pruned:\n            self.send_header(ctxres.PRUNED_HEADER, self._context_pruned)\n        self.end_headers()\n        for index, value in enumerate(values):\n            self.wfile.write(segments[index] + b'\"')\n            for piece in _text_slices(value):\n                self.wfile.write(_escape_json_piece(piece))\n            self.wfile.write(b'\"')\n        self.wfile.write(segments[-1])\n\n    def _emit_tool_call(self, chunk: Any, call: dict) -> bool:\n        \"\"\"Вызов инструмента одним кадром; arguments больше среза — фрагментами (OpenAI-стриминг, RW-012).\"\"\"\n        slices = _text_slices(call[\"function\"][\"arguments\"])\n        first_piece = next(slices, \"\")\n        second_piece = next(slices, None)\n        if second_piece is None:\n            return self._emit(chunk({\"tool_calls\": [call]}))\n        first = dict(call, function=dict(call[\"function\"], arguments=first_piece))\n        if not self._emit(chunk({\"tool_calls\": [first]})):\n            return False\n        return all(\n            self._emit(\n                chunk(\n                    {\n                        \"tool_calls\": [\n                            {\"index\": call[\"index\"], \"function\": {\"arguments\": piece}}\n                        ]\n                    }\n                )\n            )\n            for piece in itertools.chain([second_piece], slices)\n        )\n\n    def _serve_sse(self, ctx: dict) -> None:\n        # RW-203: состояние отказа живой записи не наследуется следующим запросом.\n        self._client_write_dead = False\n        completion_id = f\"chatcmpl-droid-{uuid.uuid4().hex[:12]}\"\n        created = int(time.time())\n        shown_model = ctx[\"model\"]\n        managed_turn: ManagedTurn | None = ctx.get(\"managed_turn\") or getattr(\n            self, \"_active_managed_turn\", None\n        )\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            if managed_turn is not None:\n                self.send_header(\"X-Turn-Id\", managed_turn.turn_id)\n            if self._context_pruned:\n                # CD-003: сигнал до первого SSE-байта, после старта потока не меняется.\n                self.send_header(ctxres.PRUNED_HEADER, self._context_pruned)\n            self.end_headers()\n            self.close_connection = True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            _log(\"client gone before headers\")\n            if managed_turn is not None and ctx.get(\"detach_on_disconnect\"):\n                TURN_MANAGER.mark_detached(managed_turn.turn_id)\n            return\n\n        if ctx.get(\"attached_existing\") and managed_turn is not None:\n            from_seq = self._parse_from_seq() or 0\n            for frame in TURN_MANAGER.iter_sse_stream(\n                managed_turn,\n                from_seq=from_seq,\n                keepalive_interval_s=min(10.0, KEEPALIVE_S),\n                client_gone_fn=lambda: _client_gone(self.connection),\n            ):\n                if not self._emit(frame):\n                    TURN_MANAGER.mark_detached(managed_turn.turn_id)\n                    return\n            return\n\n        def chunk(delta: dict, finish=None) -> str:\n            return (\n                \"data: \"\n                + json.dumps(\n                    {\n                        \"id\": completion_id,\n                        \"object\": \"chat.completion.chunk\",\n                        \"created\": created,\n                        \"model\": shown_model,\n                        \"choices\": [\n                            {\"index\": 0, \"delta\": delta, \"finish_reason\": finish}\n                        ],\n                    },\n                    ensure_ascii=False,\n                )\n                + \"\\n\\n\"\n            )\n\n        live_sent = [0]  # RW-211: байты content/reasoning, реально отданные этим запросом\n\n        def stream_error_frame(message: str) -> str:\n            # RW-202/RW-211: fail-close кадр chat.completion.chunk, а не плоский\n            # {\"error\": ...}: id/created/model те же, что у предыдущих кадров,\n            # пустая delta и finish_reason=null.\n            return (\n                \"data: \"\n                + json.dumps(\n                    {\n                        \"id\": completion_id,\n                        \"object\": \"chat.completion.chunk\",\n                        \"created\": created,\n                        \"model\": shown_model,\n                        \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": None}],\n                        \"error\": {\n                            \"message\": message,\n                            \"type\": \"stream_error\",\n                            \"code\": \"live_prefix_invalidated\",\n                            \"param\": None,\n                        },\n                    },\n                    ensure_ascii=False,\n                )\n                + \"\\n\\n\"\n            )\n\n        def keepalive() -> bool:\n            # RW-201/RW-009: та же защита, что у sse_writer ниже — запись ограничена\n            # LIVE_WRITE_TIMEOUT_S, а не таймаутом соединения (300с), иначе клиент,\n            # который просто не читает, держит T/L все 300с на одном keepalive.\n            prev_timeout = self.connection.gettimeout()\n            try:\n                self.connection.settimeout(LIVE_WRITE_TIMEOUT_S)\n                return self._emit(\": keepalive\\n\\n\")\n            finally:\n                self.connection.settimeout(prev_timeout)\n\n        def sse_writer(kind: str, text: str) -> bool:\n            # AD-002/AD-003: честная живая доставка — content/reasoning_content уходят прямо\n            # отсюда, по мере готовности (с коалесацией ~40мс на стороне _execute), а не одним\n            # куском после полного хода. Разрыв соединения здесь — тот же сигнал, что у keepalive.\n            # RW-009: пишем с коротким таймаутом (не 300с socket-таймаута соединения) — клиент,\n            # который не читает SSE (окно забито), не держит T/L всю длину connection timeout;\n            # TimeoutError/socket.timeout — подвид OSError, _emit его уже превращает в False.\n            field = \"content\" if kind == \"content\" else \"reasoning_content\"\n            ok = True\n            prev_timeout = self.connection.gettimeout()\n            try:\n                self.connection.settimeout(LIVE_WRITE_TIMEOUT_S)\n                for piece in _text_slices(text) if text else [text]:\n                    if not self._emit(chunk({field: piece})):\n                        ok = False\n                        break\n                    live_sent[0] += len(piece.encode(\"utf-8\"))\n            finally:\n                self.connection.settimeout(prev_timeout)\n            if not ok:\n                # RW-203: отказ фиксируется на Handler — _serve_sse больше не отправит\n                # этому клиенту ни одного терминального кадра (включая keepalive).\n                self._client_write_dead = True\n            return ok\n\n        if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n            if managed_turn is not None and ctx.get(\"detach_on_disconnect\"):\n                self._client_write_dead = True\n                TURN_MANAGER.mark_detached(managed_turn.turn_id)\n            else:\n                return\n        try:\n            out = self._dispatch(ctx, keepalive, sse_writer)\n        except Exception as exc:  # noqa: BLE001 - RW-211: клиенту нужен конверт, а не сырой сбой\n            if self._client_write_dead:\n                _log(\n                    f\"client_write_dead: dispatch error suppressed \"\n                    f\"err={_err_summary(repr(exc), 160)!r}\"\n                )\n                return\n            if not live_sent[0]:\n                raise  # живых байт не было: прежнее поведение (сбой наружу)\n            _log(f\"live_dispatch_failed err={_err_summary(repr(exc), 160)!r}\")\n            self._emit(stream_error_frame(str(exc)[:500] or exc.__class__.__name__))\n            self._emit(\"data: [DONE]\\n\\n\")\n            return\n        if self._client_write_dead:\n            # RW-203: сокет отверг живую запись — терминальные кадры (tool_call, stop,\n            # usage, error) и [DONE] мёртвому клиенту не отправляются.\n            _log(\"client_write_dead: terminal frames suppressed\")\n            return\n        if out.get(\"state\") == \"client_gone\":\n            _log(\"client gone mid-stream, child killed\")\n            return\n        err = self._error_body(out) or self._reserve_delivery(out)\n        if err is None:\n            # Доставка — отдельный этап: T/L уже свободны, checkpoint записан; обрыв клиента\n            # здесь ни на что, кроме самого ответа, не влияет. У droid content/reasoning уже ушли\n            # живьём из _execute (sse_writer выше): здесь остаются только tool_call-кадры.\n            live_backend = out.get(\"backend_kind\") == \"droid\"\n            for kind, value in out.get(\"events\") or []:\n                if kind in (\"content\", \"reasoning\"):\n                    if live_backend:\n                        continue\n                    field = \"content\" if kind == \"content\" else \"reasoning_content\"\n                    # Большое событие выдаётся срезами: в памяти одновременно только один срез SSE-кадра.\n                    delivered = (\n                        all(\n                            self._emit(chunk({field: piece}))\n                            for piece in _text_slices(value)\n                        )\n                        if value\n                        else self._emit(chunk({field: value}))\n                    )\n                else:\n                    delivered = self._emit_tool_call(chunk, value)\n                if not delivered:\n                    _log(\"client gone during delivery; turn already committed\")\n                    return\n            finish = \"tool_calls\" if out.get(\"tool_calls\") else \"stop\"\n            self._emit(chunk({}, finish))\n            # Harness считает tok/s и % контекста только из usage в потоке\n            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage ->\n            # tokenUsage/contextPressure). Без этого чанка метрики пустые.\n            # Шлём только при ненулевых токенах, чтобы нулевой usage от droid\n            # не превращался в ложные \"0 tok/s / 0%\".\n            out_usage = out.get(\"usage\") or {}\n            prompt_toks = out_usage.get(\"input_tokens\", 0)\n            compl_toks = out_usage.get(\"output_tokens\", 0)\n            if prompt_toks or compl_toks:\n                self._emit(\n                    \"data: \"\n                    + json.dumps(\n                        {\n                            \"id\": completion_id,\n                            \"object\": \"chat.completion.chunk\",\n                            \"created\": created,\n                            \"model\": shown_model,\n                            # AD-004/RW-206: finish уже ушёл отдельным кадром выше ТОЛЬКО\n                            # для живого Droid-стриминга — там finish_reason здесь null (как\n                            # у настоящего OpenAI stream_options.include_usage), а не повтор\n                            # \"stop\"/\"tool_calls\" на том же кадре. Для остальных бэкендов это\n                            # поведение не менялось: finish_reason в usage-кадре повторяет finish.\n                            \"choices\": [\n                                {\n                                    \"index\": 0,\n                                    \"delta\": {},\n                                    \"finish_reason\": None if live_backend else finish,\n                                }\n                            ],\n                            \"usage\": _wire_usage(\n                                prompt_toks,\n                                compl_toks,\n                                out_usage.get(\"cache_read_tokens\"),\n                            ),\n                        },\n                        ensure_ascii=False,\n                    )\n                    + \"\\n\\n\"\n                )\n        elif err.get(\"type\") == \"live_prefix_invalidated\" or live_sent[0] > 0:\n            # RW-202/RW-211/AD-001: fail-close конверт chat.completion.chunk, а не плоский\n            # {\"error\": ...} — id/created/model совпадают с уже отправленными кадрами,\n            # finish_reason=null; успешного finish/usage после этого не идёт (ветка err —\n            # последний кадр перед [DONE]). Живой префикс уже отдан (live_sent > 0) — любой\n            # терминальный сбой (state=error, ненулевой rc, исключение) тоже fail-close,\n            # без повтора уже отданного префикса.\n            self._emit(stream_error_frame(str(err[\"message\"])))\n        else:\n            self._emit(\n                \"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\"\n            )\n        self._emit(\"data: [DONE]\\n\\n\")\n\n\nclass Server(ThreadingHTTPServer):\n    \"\"\"HTTP-сервер с семафором числа соединений на уровне приёма (C-11).\"\"\"\n\n    daemon_threads = True\n    request_queue_size = 64\n    allow_reuse_address = True\n\n    def __init__(self, *args: Any, **kwargs: Any):\n        super().__init__(*args, **kwargs)\n        self._conn_sem = threading.BoundedSemaphore(\n            int(FLEET[\"admission\"][\"max_http_connections\"])\n        )\n\n    def _send_raw_503(self, request: socket.socket) -> None:\n        body = json.dumps(\n            {\n                \"error\": {\n                    \"message\": \"bridge overloaded: connection limit\",\n                    \"type\": \"overloaded\",\n                    \"code\": 503,\n                },\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba core/tool_emulation.py | sed -n '260,370p;540,710p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba core/tool_emulation.py | sed -n '260,370p;540,710p'\"","aggregated_output":"   260\t        return None\n   261\t    tail = body[end:]\n   262\t    if (\n   263\t        isinstance(obj, dict)\n   264\t        and 1 <= tail.count(\"}\") <= _MAX_EXTRA_BRACES\n   265\t        and not tail.strip(\" \\t\\r\\n}\")\n   266\t    ):\n   267\t        return obj\n   268\t    return None\n   269\t\n   270\t\n   271\tdef _loads_tolerant(text: str) -> Any:\n   272\t    \"\"\"json.loads, допускающий лишние `}` после полного объекта (модель закрыла скобок больше нужного).\n   273\t\n   274\t    Слишком глубокая вложенность (RecursionError) — невалидный JSON (ValueError).\n   275\t    \"\"\"\n   276\t    try:\n   277\t        return json.loads(text)\n   278\t    except (ValueError, RecursionError) as exc:\n   279\t        recovered = _recover_trailing_braces(text)\n   280\t        if recovered is None:\n   281\t            if isinstance(exc, RecursionError):\n   282\t                raise ValueError(\"JSON is nested too deeply\") from exc\n   283\t            raise\n   284\t        return recovered\n   285\t\n   286\t\n   287\tdef _parse_tool_call_block(inner: str) -> dict | None:\n   288\t    \"\"\"Содержимое блока -> {\"name\",\"arguments\"}; None, если блок невалиден.\n   289\t\n   290\t    Отсутствие ключа arguments — допустимый вызов с {}; присутствующее, но\n   291\t    не-объектное значение (строка-не-JSON, список, число, null) — вызов\n   292\t    отклоняем, чтобы не запускать инструмент с пустыми аргументами.\n   293\t    \"\"\"\n   294\t    try:\n   295\t        obj = _loads_tolerant(_strip_code_fence(inner))\n   296\t    except ValueError:\n   297\t        return None\n   298\t    if not isinstance(obj, dict):\n   299\t        return None\n   300\t    if \"name\" not in obj and isinstance(obj.get(\"function\"), dict):\n   301\t        # OpenAI tool_calls: {\"id\", \"type\", \"function\": {\"name\", \"arguments\"}}\n   302\t        obj = obj[\"function\"]\n   303\t    name = obj.get(\"name\")\n   304\t    if not isinstance(name, str) or not name.strip():\n   305\t        return None\n   306\t    if \"arguments\" not in obj:\n   307\t        arguments: dict = {}\n   308\t    else:\n   309\t        normalized = _normalize_arguments(obj.get(\"arguments\"))\n   310\t        if normalized is None:\n   311\t            return None\n   312\t        arguments = normalized\n   313\t    return {\"name\": name.strip(), \"arguments\": arguments}\n   314\t\n   315\t\n   316\tclass LiveParserError(Exception):\n   317\t    \"\"\"Strict-live (AD-002): recognized `<tool_call>` блок невалиден либо не закрыт.\n   318\t\n   319\t    Поднимается только при `strict_live=True`; legacy-режим (stream=false либо\n   320\t    без sink) этот блок, как раньше, молча отдаёт текстом — исключение означает\n   321\t    fail-close всего live-хода (сырой XML клиенту не уходит).\n   322\t    \"\"\"\n   323\t\n   324\t\n   325\tdef _is_quoted_open(text: str, start: int) -> bool:\n   326\t    \"\"\"`<tool_call>` в inline-коде markdown (`` `<tool_call>` ``) — не тег.\"\"\"\n   327\t    if start > 0 and text[start - 1] == \"`\":\n   328\t        return True\n   329\t    tail = text[start + len(TOOL_CALL_OPEN) : start + len(TOOL_CALL_OPEN) + 3]\n   330\t    return bool(tail) and tail[0] == \"`\" and tail != \"```\"\n   331\t\n   332\t\n   333\tdef _split_tool_call_inner(inner: str) -> list[str]:\n   334\t    \"\"\"Разбить содержимое блока по вложенным `<tool_call>` вне строковых литералов JSON.\n   335\t\n   336\t    Модель иногда пропускает `</tool_call>` между соседними вызовами пачки и ставит\n   337\t    один общий закрывающий тег в конце. Литерал `<tool_call>` внутри JSON-строки\n   338\t    границей не считается (та же логика, что в `_find_close_outside_string`).\n   339\t    Пустые сегменты сохраняются: пустой элемент делает всю пачку невалидной.\n   340\t    \"\"\"\n   341\t    segments: list[str] = []\n   342\t    seg_start = 0\n   343\t    index = 0\n   344\t    length = len(inner)\n   345\t    in_string = False\n   346\t    escaped = False\n   347\t    while index < length:\n   348\t        char = inner[index]\n   349\t        if in_string:\n   350\t            if escaped:\n   351\t                escaped = False\n   352\t            elif char == \"\\\\\":\n   353\t                escaped = True\n   354\t            elif char == '\"':\n   355\t                in_string = False\n   356\t        elif char == '\"':\n   357\t            in_string = True\n   358\t        elif inner.startswith(TOOL_CALL_OPEN, index) and not _is_quoted_open(\n   359\t            inner, index\n   360\t        ):\n   361\t            segments.append(inner[seg_start:index])\n   362\t            index += len(TOOL_CALL_OPEN)\n   363\t            seg_start = index\n   364\t            continue\n   365\t        index += 1\n   366\t    segments.append(inner[seg_start:])\n   367\t    return segments\n   368\t\n   369\t\n   370\tdef _parse_tool_call_blocks(inner: str) -> list[dict] | None:\n   540\t\n   541\t    def finish(self) -> None:\n   542\t        self._drain(final=True)\n   543\t\n   544\t    def _classify_open(self, after: int, final: bool) -> str:\n   545\t        \"\"\"`<tool_call>` в буфере: \"real\" | \"quoted\" (inline-код markdown) | \"wait\" (нужен следующий символ).\"\"\"\n   546\t        context = _code_context(self._history + self._buf, len(self._history), final)\n   547\t        if context != \"text\":\n   548\t            return \"quoted\" if context == \"code\" else \"wait\"\n   549\t        tail = self._buf[after : after + 3]\n   550\t        if not tail:\n   551\t            return \"real\" if final else \"wait\"\n   552\t        # ```json-обёртка внутри блока — настоящий вызов\n   553\t        if tail[0] != \"`\" or tail == \"```\":\n   554\t            return \"real\"\n   555\t        if not final and tail == \"`\" * len(tail) and len(tail) < 3:\n   556\t            return \"wait\"\n   557\t        return \"quoted\"\n   558\t\n   559\t    def _drain(self, final: bool) -> None:\n   560\t        while True:\n   561\t            start = self._buf.find(TOOL_CALL_OPEN)\n   562\t            if start == -1:\n   563\t                if final:\n   564\t                    if (\n   565\t                        self.strict_live\n   566\t                        and self._pending_prefix()\n   567\t                        and not self._tail_in_code()\n   568\t                    ):\n   569\t                        raise LiveParserError(\"unresolved tool_call prefix at finish\")\n   570\t                    self._flush_all()\n   571\t                    return\n   572\t                keep = self._pending_prefix()\n   573\t                if keep:\n   574\t                    self._emit(self._buf[:-keep])\n   575\t                    self._buf = self._buf[-keep:]\n   576\t                else:\n   577\t                    self._flush_all()\n   578\t                return\n   579\t            if start > 0:\n   580\t                # всё до тега завершено: текст уходит в content и в `_history`\n   581\t                self._emit(self._buf[:start])\n   582\t                self._buf = self._buf[start:]\n   583\t            after = len(TOOL_CALL_OPEN)\n   584\t            verdict = self._classify_open(after, final)\n   585\t            if verdict == \"quoted\":\n   586\t                self._emit(self._buf[:after])\n   587\t                self._buf = self._buf[after:]\n   588\t                continue\n   589\t            if verdict == \"wait\":\n   590\t                return\n   591\t            end = self._find_close_outside_string(len(TOOL_CALL_OPEN))\n   592\t            if end == -1:\n   593\t                if final:\n   594\t                    if self.strict_live:\n   595\t                        raise LiveParserError(\"unclosed tool_call block\")\n   596\t                    self._flush_all()  # незакрытый/невалидный блок отдаём текстом\n   597\t                return\n   598\t            inner = self._buf[len(TOOL_CALL_OPEN) : end]\n   599\t            self._buf = self._buf[end + len(TOOL_CALL_CLOSE) :]\n   600\t            calls = _parse_tool_call_blocks(inner)\n   601\t            if calls is None:\n   602\t                if self.strict_live:\n   603\t                    raise LiveParserError(\"malformed tool_call block\")\n   604\t                self._emit(TOOL_CALL_OPEN + inner + TOOL_CALL_CLOSE)\n   605\t            else:\n   606\t                self._history += _OPAQUE_BLOCK\n   607\t                for call in calls:\n   608\t                    self._on_tool_call(call)\n   609\t\n   610\t    def _find_close_outside_string(self, start: int) -> int:\n   611\t        \"\"\"Позиция `</tool_call>` вне строковых литералов JSON, или -1.\n   612\t\n   613\t        Закрывающий тег внутри JSON-строки (например значение аргумента содержит\n   614\t        `</tool_call>`) границей блока не является. Экранированные кавычки `\\\\\"`\n   615\t        строку не закрывают.\n   616\t        \"\"\"\n   617\t        index = start\n   618\t        length = len(self._buf)\n   619\t        in_string = False\n   620\t        escaped = False\n   621\t        while index < length:\n   622\t            char = self._buf[index]\n   623\t            if in_string:\n   624\t                if escaped:\n   625\t                    escaped = False\n   626\t                elif char == \"\\\\\":\n   627\t                    escaped = True\n   628\t                elif char == '\"':\n   629\t                    in_string = False\n   630\t            elif char == '\"':\n   631\t                in_string = True\n   632\t            elif self._buf.startswith(TOOL_CALL_CLOSE, index):\n   633\t                return index\n   634\t            index += 1\n   635\t        return -1\n   636\t\n   637\t    def _pending_prefix(self) -> int:\n   638\t        \"\"\"Длина хвоста — префикса открывающего тега (его нельзя отдать в content).\"\"\"\n   639\t        limit = min(len(TOOL_CALL_OPEN) - 1, len(self._buf))\n   640\t        for length in range(limit, 0, -1):\n   641\t            if self._buf[-length:] == TOOL_CALL_OPEN[:length]:\n   642\t                return length\n   643\t        return 0\n   644\t\n   645\t    def _tail_in_code(self) -> bool:\n   646\t        \"\"\"Хвост-префикс тега в буфере лежит внутри markdown-кода.\"\"\"\n   647\t        doc = self._history + self._buf\n   648\t        return _code_context(doc, len(doc) - self._pending_prefix(), True) == \"code\"\n   649\t\n   650\t    def _emit(self, text: str) -> None:\n   651\t        if text:\n   652\t            self._history += text\n   653\t            self._on_content(text)\n   654\t\n   655\t    def _flush_all(self) -> None:\n   656\t        if self._buf:\n   657\t            text, self._buf = self._buf, \"\"\n   658\t            self._emit(text)\n   659\t\n   660\t\n   661\tdef finalize_turn(raw: TurnResult, emulate_tools: bool) -> TurnResult:\n   662\t    \"\"\"Сырой итог адаптера -> `out` фасада с буфером `events` (content/reasoning/tool_call).\n   663\t\n   664\t    Готовый `out` (в нём уже есть `events`, как у droid-пути, где разбор идёт по потоку)\n   665\t    возвращается без изменений. Для остальных: размышления идут мимо парсера, текст — через\n   666\t    `ToolCallParser` при `emulate_tools`, вызовы получают `call_<hex>` как в droid-пути.\n   667\t    \"\"\"\n   668\t    if raw.events is not None:\n   669\t        return raw\n   670\t    events: list[TurnEvent] = []\n   671\t    tool_calls: list[ToolCall] = []\n   672\t    pieces: list[str] = []\n   673\t    reasoning = raw.reasoning\n   674\t    if reasoning:\n   675\t        events.append(TurnEvent(\"reasoning\", reasoning))\n   676\t\n   677\t    def add_content(text: str) -> None:\n   678\t        if text:\n   679\t            pieces.append(text)\n   680\t            events.append(TurnEvent(\"content\", text))\n   681\t\n   682\t    def add_call(call: dict) -> None:\n   683\t        entry = ToolCall(\n   684\t            index=len(tool_calls),\n   685\t            id=\"call_\" + uuid.uuid4().hex[:24],\n   686\t            function=ToolFunction(\n   687\t                call[\"name\"], json.dumps(call[\"arguments\"], ensure_ascii=False)\n   688\t            ),\n   689\t        )\n   690\t        tool_calls.append(entry)\n   691\t        events.append(TurnEvent(\"tool_call\", entry))\n   692\t\n   693\t    text = raw.text\n   694\t    if emulate_tools:\n   695\t        parser = ToolCallParser(add_content, add_call)\n   696\t        parser.feed(text)\n   697\t        parser.finish()\n   698\t    else:\n   699\t        add_content(text)\n   700\t    return replace(\n   701\t        raw, text=\"\".join(pieces), tool_calls=tuple(tool_calls), events=tuple(events)\n   702\t    )\n","exit_code":0,"status":"completed"}}
