rce_envelope', 'handoff_state', 'owner_questions', 'tooling_deviations', 'role_plan']\\ninvariants: ['INV-01', 'INV-02', 'INV-03', 'INV-04', 'INV-05', 'INV-06', 'INV-07', 'INV-08', 'INV-09', 'INV-10', 'INV-11', 'INV-12']\\ndecisions: ['AD-001', 'AD-002', 'AD-003', 'AD-004', 'AD-005']\\nschema_version str 1.0\\nprotocol str AP/v1\\ntask_id str agy-universal-image-fallback\\nrun_id str agy-universal-image-fallback-20261029\\ncriticality str S2\\nprofile str python-aisdlc-gcge\\nstatus str APPROVED\\napproval_scope str Author-finalized reversible design and mechanical schema/integrity gate only. No external council verdict, resource acceptance, Coder authorization or production acceptance is implied.\\nbaseline dict {'branch': 'feat/agy-universal-image-fallback', 'commit': '012da99905ec27a6133afb4f3e768ff9b4426a8f', 'test_prefix_bytes': 249933, 'test_prefix_lines': 6008, 'test_prefix_sha256': 'f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5', 'test_line_discrepancy': 'Owner specified 1..6009; a\\nrequirement_ids list ['REQ-01', 'REQ-02', 'REQ-03', 'REQ-04', 'REQ-05', 'REQ-06']\\nrisk_triggers list ['security', 'trust-boundary']\\nassumptions list [{'id': 'ASM-001', 'source_id': 'ASSUMP-01', 'class': 'continuable', 'status': 'ASSUMED', 'statement': 'Owner200 requirement is media-safe admission plus a real text attempt, not guaranteed backend availability. Successful text gives200; independent protocol/admission/launcher/second failure remain \\nquality_scenarios list [{'id': 'QA-001', 'quality': 'reliability', 'source': 'DSH client / release owner', 'stimulus': 'media validation, spool or attached CLI fails', 'environment': 'local fake and existing owner DSH chat', 'artifact': 'do_POST/_run_once', 'response': 'clean downgrade and real text attempt', 'response_me\\nboundaries list [{'id': 'BND-001', 'component': 'Ingress policy', 'responsibility': 'Authenticate/frame/validate body and catalog effort before universal media handling', 'allowed_dependencies': ['existing HTTPHandler', 'FLEET_MODELS', 'bounded body admission'], 'forbidden_dependencies': ['image gate may not waive \\ncontract_deltas list [{'id': 'CD-001', 'type': 'behavior', 'producer': 'agy do_POST', 'consumer': 'DSH', 'change': 'With universal=true media failures strip to text instead of strict image400/spool500; eligible image attempt failure gets one text retry.', 'compatibility': 'Explicitly requested REQ01..03; flag absent/fal\\nviews list [{'id': 'VIEW-001', 'type': 'dynamic', 'question': 'Where are the three downgrade points and what survives attempt2?', 'artifact_ref': 'architecture/architecture-packet.json#/runtime_view'}, {'id': 'VIEW-002', 'type': 'dfd', 'question': 'Which trust boundary prevents payload leakage/fetch and filesy\\nrisks list [{'id': 'RISK-001', 'source_id': 'RISK-01', 'scenario': 'Backend/native-tool side effects may precede failure even without client delivery.', 'probability': 'medium', 'impact': 'high', 'mitigation': 'Bounded one text retry; no exactly-once claim; delivered tool/text/reasoning forbids retry; live saf\\nprotected_paths list ['bridges/agy-bridge/fleet.json', 'analysis/agy-universal-image-fallback/', '.ai-team/runs/agy-universal-image-fallback-20261029/architecture/', '.ai-team/runs/agy-universal-image-fallback-20261029/teamlead/verification-surface.json', '.ai-team/runs/agy-universal-image-fallback-20261029/task.json', \\nmaterialization list []\\napproval dict {'status': 'NOT_REQUIRED', 'decision_ids': [], 'approved_by': None, 'evidence_ref': None}\\nindependent_review dict {'required': False, 'status': 'PENDING', 'reviewer': None, 'evidence_ref': None, 'scope': 'S2 schema does not require S3 review. teamlead-with-architect still REQUIRES independent external three-family ARCH_PANEL proof before Coder; none claimed here.'}\\nopen_questions list []\\ndeferred list ['Product implementation and append-only tests are Coder work after external ARCH_PANEL PASS.', 'Production deployment/config writes/restart and e