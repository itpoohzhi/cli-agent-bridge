{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c413","stream":{"kind":"session","id":"01a18818-8a95-7650-8f97-acf8c05d8dc6"},"sequence":100,"recorded_at":1780531400000195,"record_type":"event","durability":"durable","causation_id":"01a18818-8eec-7e70-9235-67f86c11c7d1","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18818-8eec-7e70-9235-67f86c11c7d1","run_stream":{"kind":"run","id":"01a18818-8eec-7e70-9235-67f86c11c7d1"},"call_id":"call_01a18819099874e6b57099e6073eb296","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json`.\n(499 line(s) above)\n500|      \"kind\": \"document\",\n501|      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-403\",\n502|      \"claim\": \"После анализа server/fleet/test файл не изменены; strict baseline diff по-прежнему2205 added/0 deleted | git diff --exit-code -- bridges/agy-bridge/server.py bridges/agy-bridge/fleet.json tests/test_agy_bridge_resilience.py → exit0; git diff --numstat 5a19559426de7508d525e2bd465eff648665a6a7 -- tests/test_agy_bridge_resilience.py → 2205 0 | 2026-10-29\",\n503|      \"source_id\": \"F-403\"\n504|    },\n505|    {\n506|      \"id\": \"EVD-060\",\n507|      \"kind\": \"document\",\n508|      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-404\",\n509|      \"claim\": \"Repo defaults: execution slots4, retry capacity3 tokens, credit0.2/request, cost1/retry и jitter cap2s; это default constants, не измеренные production env/throughput | bridges/agy-bridge/server.py:109,181–187,1396–1417 MAX_CONCURRENT/RETRY constants | 2026-10-29\",\n510|      \"source_id\": \"F-404\"\n511|    },\n512|    {\n513|      \"id\": \"EVD-061\",\n514|      \"kind\": \"document\",\n515|      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-405\",\n516|      \"claim\": \"Repo timeout defaults: queue900s, execution1800s, first event120s; это controller ceilings, не SLA/p99 | bridges/agy-bridge/server.py:110–115 QUEUE_TIMEOUT_S/TIMEOUT_S/FIRST_TOKEN_TIMEOUT_S | 2026-10-29\",\n517|      \"source_id\": \"F-405\"\n518|    },\n519|    {\n520|      \"id\": \"EVD-100\",\n521|      \"kind\": \"code\",\n522|      \"ref\": \"bridges/agy-bridge/server.py:do_GET / _cid_release / Run.__init__ / _run_once; tests/test_agy_bridge_resilience.py:test_ao06_health_has_four_additive_fields_and_keeps_existing_ones\",\n523|      \"claim\": \"Direct gap checks: health.images is bool, no _log_token or log.info logger exists, _cid_release(cid,turn_id) is owner-safe, no local conv_id in _run_once; Run gets new CLI conversation when conversation_id empty; baseline6008lines/249933bytes.\"\n524|    }\n525|  ],\n526|  \"risk_triggers\": [\n527|    \"security\",\n528|    \"trust-boundary\"\n529|  ],\n530|  \"assumptions\": [\n531|    {\n532|      \"id\": \"ASM-001\",\n533|      \"source_id\": \"ASSUMP-01\",\n534|      \"class\": \"continuable\",\n535|      \"status\": \"ASSUMED\",\n536|      \"statement\": \"Owner200 requirement is media-safe admission plus a real text attempt, not guaranteed backend availability. Successful text gives200; independent protocol/admission/launcher/second failure remain truthful errors. User direct guard excludes done/client_gone.\",\n537|      \"evidence_ids\": [\n538|        \"EVD-100\"\n539|      ],\n540|      \"verification_ids\": [\n541|        \"VER-003\",\n542|        \"VER-010\"\n543|      ]\n544|    },\n545|    {\n546|      \"id\": \"ASM-002\",\n547|      \"source_id\": \"ASSUMP-02\",\n548|      \"class\": \"continuable\",\n549|      \"status\": \"ASSUMED\",\n550|      \"statement\": \"Valid decodable raster describes positive test corpus. Universal safety retains signature-only validation and no pixel decoder/dependency; this is not a proof that every signature-bearing file decodes safely.\",\n551|      \"evidence_ids\": [\n552|        \"EVD-100\"\n553|      ],\n554|      \"verification_ids\": [\n555|        \"VER-003\",\n556|        \"VER-006\"\n557|      ]\n558|    }\n559|  ],\n560|  \"decisions\": [\n561|    {\n562|      \"id\": \"AD-001\",\n563|      \"title\": \"Universal Policy Flag & Dynamic Config Activation\",\n564|      \"status\": \"APPROVED\",\n565|      \"kind\": \"two-way\",\n566|      \"question\": \"How to enable universal acceptance without changing legacy strict fixtures?\",\n567|      \"choice\": \"An independent fail-closed IMAGE_FALLBACK_ENABLED controls universal policy; IMAGE_INPUT_ENABLED continues to control staging. Capture universal once per accepted request and recheck input after slot acquisition.\",\n568|      \"alternatives\": [\n569|        \"Universal enabled by default: rejected because it breaks strict baseline and res03/hist05/life02.\",\n570|        \"Reuse IMAGE_INPUT_ENABLED as universal: rejected because _ImgEnv sets only this flag and must remain strict.\"\n571|      ],\n572|      \"drivers\": [\n573|        \"REQ-01\",\n574|        \"REQ-02\",\n575|        \"REQ-04\",\n576|        \"REQ-05\",\n577|        \"CON-04\",\n578|        \"INV-01\",\n579|        \"INV-09\",\n580|        \"RISK-05\"\n581|      ],\n582|      \"consequences\": [\n583|        \"No fleet mutation or fake proofs.\",\n584|        \"Rollback universal=false restores strict behavior for new requests; in-flight requests retain captured universal policy.\",\n585|        \"Input disable propagates on next post-slot check subject to its existing <=1s cache; accepted running CLI is not retroactively cancelled.\"\n586|      ],\n587|      \"approval_required\": false,\n588|      \"confirmation\": {\n589|        \"kind\": \"test\",\n590|        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n591|        \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-010 must pass after implementation.\"\n592|      },\n593|      \"verification_ids\": [\n594|        \"VER-003\",\n595|        \"VER-006\",\n596|        \"VER-008\",\n597|        \"VER-010\"\n598|      ],\n599|      \"details\": {\n600|        \"names\": {\n601|          \"config\": \"IMAGE_FALLBACK_ENABLED\",\n602|          \"env\": \"AGY_IMAGE_FALLBACK_ENABLED\",\n603|          \"reader\": \"_read_image_fallback_flag()\",\n604|          \"predicate\": \"_is_image_fallback_enabled()\",\n605|          \"cache\": \"_image_fallback_flag_cache = (0.0, False)\",\n606|          \"ttl_s\": 1.0\n607|        },\n608|        \"reader_contract\": \"Bounded read of DYNAMIC_CONFIG_PATH; reject missing/unreadable/oversize/invalid JSON/non-object; only data.get(\\\"IMAGE_FALLBACK_ENABLED\\\") is True enables. Strings, integers, null and missing key are False. No env parsing inside JSON reader.\",\n609|        \"env_contract\": \"Read env every predicate call, strip whitespace and lowercase. Nonempty 1/true/yes=>True; 0/false/no=>False; other nonempty token=>False (including on/off for NEW flag). Empty/unset falls through to JSON. Env overrides cache immediately and does not mutate JSON; no production global env export in test runner.\",\n610|        \"cache_contract\": \"Monotonic TTL<1.0s serves cached config; age>=1.0s rereads; bounded dedicated lock _image_fallback_flag_lock protects tuple. Initialize (0.0,False); reset under that lock inside _reset_sqlite_guards_for_tests(); independent from old input, SHA and SQLite caches. Cold cache always reads current fixture path. Existing _ImgEnv/_Fixture tests need no edits.\",\n611|        \"policy_matrix\": [\n612|          {\n613|            \"universal\": false,\n614|            \"input_enabled\": false,\n615|            \"images\": \"legacy strict reject\",\n616|            \"response\": \"400 image_input_not_supported for image requests; pure text unchanged\"\n617|          },\n618|          {\n619|            \"universal\": false,\n620|            \"input_enabled\": true,\n621|            \"images\": \"legacy _image_gate proof/SHA/efforts gate\",\n622|            \"response\": \"legacy admission/retry same files, all old error outcomes unchanged\"\n623|          },\n624|          {\n625|            \"universal\": true,\n626|            \"input_enabled\": false,\n627|            \"images\": \"no staging, strip all media from full history\",\n628|            \"response\": \"real pure-text attempt1; collect/flag_disabled event; HTTP200 iff text backend succeeds\"\n629|          },\n630|          {\n631|            \"universal\": true,\n632|            \"input_enabled\": true,\n633|            \"images\": \"optimistic known catalog + valid effort + all safety checks; no model proof eligibility\",\n634|            \"response\": \"valid raster attached attempt1; validation/recheck/spool failure strips before attempt1; runtime guard strips before attempt2\"\n635|          }\n636|        ],\n637|        \"universal_gate\": \"_image_gate_universal(model_id,effort) validates catalog membership and declared valid model effort and current input flag; never calls _image_proof_reason/_file_sha256 nor uses images.status/proof/agy_binary_sha256/efforts_proven/formats proof. Unknown model/invalid effort remain ingress400, never rescued by media fallback. Startup fleet schema remains unchanged.\",\n638|        \"collector_contract\": \"_collect_images(messages,model_id,effort,universal=False): default strict exactly preserves existing path/order/taxonomy. universal=True uses complete media classification, canonical image aliases and _image_gate_universal, then same limits/role/dataURL/base64/MIME/signature checks. No _stage_images before slot. Any ImageReject discards ALL collected entries; no partially valid image subset is sent.\",\n639|        \"safety_limits\": {\n640|          \"images_max\": 16,\n641|          \"per_image_bytes_max\": 20971520,\n642|          \"total_image_bytes_max\": 20971520,\n643|          \"http_body_bytes_max\": 33554432,\n644|          \"allowed_roles\": [\n645|            \"user\"\n646|          ],\n647|          \"mime\": [\n648|            \"image/png\",\n649|            \"image/jpeg\",\n650|            \"image/gif\",\n651|            \"image/webp\"\n652|          ],\n653|          \"encoding\": \"data:<allowed-mime>;base64,<strict-base64>; signature must match declared MIME\",\n654|          \"remote_reads\": \"forbidden including HTTP(S), file:// and relative paths\",\n655|          \"proof_is_not_safety\": \"Signature-only validation retained; no new pixel decoder.\"\n656|        },\n657|        \"production_activation\": {\n658|          \"path\": \"~/.dsh/bridges/agy-bridge/dynamic_config.json\",\n659|          \"required_projection\": {\n660|            \"IMAGE_INPUT_ENABLED\": true,\n661|            \"IMAGE_FALLBACK_ENABLED\": true\n662|          },\n663|          \"status\": \"PLANNED_NOT_APPLIED_STAGE2\",\n664|          \"procedure\": \"After architecture and code council acceptance deploy candidate server only, verify unchanged fleet SHA, preserve unrelated config keys and atomically set both strict JSON booleans true in DEPLOYED ROOT. Code replacement needs managed bridge restart; flag toggles reload <=1s without restart. Read back flags and effective capability; then existing owner DSH chat must pass VER010 live scenarios. Never add tracked dynamic_config.json.\",\n665|          \"owner_override\": \"Current owner explicitly selects local dynamic_config.json plus env override; this is scoped exception to general GigaRC/no-new-env preference, not a claim that GigaRC is integrated.\"\n666|        }\n667|      }\n668|    },\n669|    {\n670|      \"id\": \"AD-002\",\n671|      \"title\": \"Complete Media Normalization & Stripping Contract\",\n672|      \"status\": \"APPROVED\",\n673|      \"kind\": \"two-way\",\n674|      \"question\": \"How to remove media from all history and both prompt representations without payload leakage?\",\n675|      \"choice\": \"Pure non-mutating content normalization classifies media by type AND payload keys before considering text. Precompute stripped full-history prompt in ctx before any session delta selection.\",\n676|      \"alternatives\": [\n677|        \"Set images=[] only: rejected, leaves [image N], full_prompt attachments and old CID.\",\n678|        \"str(content)/text-first generic renderer: rejected, exposes media dict.text and inline payloads.\"\n679|      ],\n680|      \"drivers\": [\n681|        \"REQ-06\",\n682|        \"INV-02\",\n683|        \"INV-03\",\n684|        \"INV-04\",\n685|        \"INV-07\",\n686|        \"AC-04\",\n687|        \"AC-07\"\n688|      ],\n689|      \"consequences\": [\n690|        \"No in-place edits to caller messages or test fixtures.\",\n691|        \"Plain textual URLs are preserved verbatim; only structured attachment payloads are removed.\",\n692|        \"Normal universal raster rendering omits other media, fallback rendering replaces it with stable placeholders.\"\n693|      ],\n694|      \"approval_required\": false,\n695|      \"confirmation\": {\n696|        \"kind\": \"test\",\n697|        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n698|        \"expected\": \"Independent execution VER003 plus VER-003, VER-007, VER-009 must pass after implementation.\"\n699|      },\n700|      \"verification_ids\": [\n701|        \"VER-003\",\n702|        \"VER-007\",\n703|        \"VER-009\"\n704|      ],\n705|      \"details\": {\n706|        \"helper_contracts\": {\n707|          \"_flatten_content_stripped(content)\": \"Return safe string with unchanged ordinary text order and newline joining; None=>empty; recognized image=>[image omitted]; other recognized media=>[media omitted]; unknown dict/object never str(dict).\",\n708|          \"_strip_media_from_messages(messages)\": \"Return fresh JSON-safe message list with roles/order/name/tool-call protocol metadata preserved, content replaced by safe string, nested content structures copied/normalized without mutation. Do not use copy.deepcopy on hot path: normalization is deep by visiting content recursively once.\",\n709|          \"_messages_to_stripped_prompt(messages)\": \"Render normalized messages through existing role/tool message envelope with images=[] and no image counter-driven media parts; zero generated [attachments], generated [image N], media paths/URLs/base64. Existing user text is not censored.\"\n710|        },\n711|        \"classification_order\": [\n712|          \"If structured object is image type or has image payload key, emit image placeholder BEFORE looking at text, even type=text plus image_url.\",\n713|          \"Else if other media type or media payload key, emit media placeholder BEFORE looking at text.\",\n714|          \"Else known text type/plain text value -> string text only; dict(text) supported only if safe string. Never serialize nested text object.\",\n715|          \"Lists process entries in order; plain strings pass through; None/numbers/unknown structured objects omitted; unknown object-only message gets [media omitted] to keep safe nonempty context.\"\n716|        ],\n717|        \"image_types\": [\n718|          \"image_url\",\n719|          \"image\",\n720|          \"input_image\"\n721|        ],\n722|        \"image_payload_keys\": [\n723|          \"image_url\",\n724|          \"image\"\n725|        ],\n726|        \"other_media_types\": [\n727|          \"input_audio\",\n728|          \"audio\",\n729|          \"video\",\n730|          \"video_url\",\n731|          \"file\",\n732|          \"document\",\n733|          \"inlineData\",\n734|          \"inline_data\",\n735|          \"fileData\",\n736|          \"file_data\"\n737|        ],\n738|        \"other_media_payload_keys\": [\n739|          \"input_audio\",\n740|          \"audio\",\n741|          \"video\",\n742|          \"video_url\",\n743|          \"file\",\n744|          \"document\",\n745|          \"inlineData\",\n746|          \"inline_data\",\n747|          \"fileData\",\n748|          \"file_data\"\n749|        ],\n750|        \"dict_content\": \"Identical handling to list parts: recognized media types/keys win; type=text with safe str text yields that text. Dict is never rendered via str(content).\",\n751|        \"aliases_for_optimistic_collection\": \"Classify image aliases across list and dict content. Canonicalize on a private normalized copy to type=image_url with image_url={url:...}; URL source is string image_url/image payload or payload.url, including type=input_image with image_url string. Prefer image_url key over image if both; malformed/missing URL is ImageReject -> whole-request stripped fallback, never guessed local/file or raw base64. Preserve original role/msg_index and global image numbering. Type=image_url lacking payload remains an invalid image candidate, not silently dropped.\",\n752|        \"normal_universal_render\": \"For universal normal/optimistic render only: retain canonical validated raster image references and text; silently omit other media parts, including their text keys, and never serialize unknown dicts. If there are ONLY non-image media/unknown structured parts and no raster, use stripped placeholders and text-only admission (stage=collect reason=unsupported_media). Mixed valid raster + non-image media retains valid raster, excludes non-image media without forcing downgrade.\",\n753|        \"idempotency\": \"For normalized list N: _strip_media_from_messages(N)==N; repeated normalization yields byte-identical rendered prompt. Placeholder strings are ordinary safe strings: never wrapped/replaced/appended again.\",\n754|        \"nonempty\": \"Each image/media-only message retains its [image omitted]/[media omitted] marker; never becomes empty and never causes generated Reply with exactly: PONG. Truly empty/non-media requests retain existing behavior.\",\n755|        \"ctx_contract\": \"Always store ctx[\\\"stripped_full_prompt\\\"]=_messages_to_stripped_prompt(original messages). ctx[\\\"universal_fallback\\\"] is admission snapshot. For any actual downgrade assign BOTH ctx[\\\"prompt\\\"] and ctx[\\\"full_prompt\\\"] from stripped_full_prompt, ctx[\\\"images\\\"]=[], ctx[\\\"img_dir\\\"]=None. Never recompute from original _messages_to_prompt(messages,[]) during downgrade.\",\n756|        \"resumed_contract\": \"If any current or historical media was stripped, force cold text turn with full stripped history; do not resume dirty explicit or cached CID. This conservative choice is owner-permitted. Normal universal with valid raster may still use existing resumed slice numbering; stripped_full_prompt was computed from the full original history before selecting that slice.\",\n757|        \"strict_isolation\": \"When universal=False continue existing collector/render paths exactly, including existing strict truncated PNG and same-files retry assertions; new normalizer does not redefine strict inputs.\"\n758|      }\n759|    },\n760|    {\n761|      \"id\": \"AD-003\",\n762|      \"title\": \"Three Safe Downgrade Points\",\n763|      \"status\": \"APPROVED\",\n764|      \"kind\": \"two-way\",\n765|      \"question\": \"Where exactly does fallback override strict early exits and retry branches?\",\n766|      \"choice\": \"Central bounded media-to-text state transition at admission, post-slot/spool, and runtime attempt1, before both legacy retry paths. Keep all response and resource ownership invariants.\",\n767|      \"alternatives\": [\n768|        \"Only generic transient retry: rejected, misses timeouts, hot early continue, flag and spool failures.\",\n769|        \"Always replay same image attachments on failure: rejected by owner text-only fallback contract.\"\n770|      ],\n771|      \"drivers\": [\n772|        \"REQ-02\",\n773|        \"REQ-03\",\n774|        \"INV-05\",\n775|        \"INV-06\",\n776|        \"INV-07\",\n777|        \"INV-08\",\n778|        \"INV-09\",\n779|        \"INV-11\"\n780|      ],\n781|      \"consequences\": [\n782|        \"Exactly at most2 CLI executions/request; degradation reserve is request-scoped and unavailable to generic retries.\",\n783|        \"Failures after client delivery, client_gone and state done never trigger this fallback.\",\n784|        \"External side effects can occur before delivery; no exactly-once promise.\"\n785|      ],\n786|      \"approval_required\": false,\n787|      \"confirmation\": {\n788|        \"kind\": \"test\",\n789|        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n790|        \"expected\": \"Independent execution VER003 plus VER-003, VER-005, VER-009, VER-010 must pass after implementation.\"\n791|      },\n792|      \"verification_ids\": [\n793|        \"VER-003\",\n794|        \"VER-005\",\n795|        \"VER-009\",\n796|        \"VER-010\"\n797|      ],\n798|      \"details\": {\n799|        \"point1_collect\": {\n800|          \"when\": \"do_POST after normal auth/body/model/effort validation, before slot, spool or response\",\n801|          \"logic\": [\n802|            \"Capture universal flag. Detect structured media throughout history using AD002. Precompute stripped_full_prompt.\",\n803|            \"universal and media and input_disabled -> log stage=collect reason=flag_disabled, images=[], img_dir=None, use stripped full history as prompt/full_prompt, prohibit resume.\",\n804|            \"universal and input_enabled -> _collect_images(...,universal=True); any ImageReject -> log stage=collect reason=rejected.reason, code sanitized separately if logged, images=[], img_dir=None; both prompts stripped; prohibit resume; no image-derived HTTP400.\",\n805|            \"Non-image media without raster -> use markers and pure text as AD002; mixed valid raster/media -> optimistic raster only.\",\n806|            \"strict -> retain exact existing exception->400 path, reason taxonomy and normal legacy render.\",\n807|            \"No valid images means do not allocate/spool img_dir. Any preallocated path is only metadata and never passed to Run.\"\n808|          ]\n809|        },\n810|        \"point2_post_slot\": {\n811|          \"when\": \"_run_once after acquire, before register/mkdir/stage/Run\",\n812|          \"logic\": [\n813|            \"If images and universal snapshot true: recheck _is_image_input_enabled ONLY; do not perform strict proof/SHA check. If False, log post_slot/flag_disabled and execute downgrade transition; continue attempt1 as text.\",\n814|            \"If !universal keep _image_gate recheck and existing image_reject terminal state exactly.\",\n815|            \"Register only the own actual img_dir under _active_lock before mkdir. _stage_images exception ImageSpoolError in universal -> log spool/image_spool_error; cleanup partial dir and registry, img_registered=False, img_dir=None; downgrade both prompts/CID/images; proceed attempt1 text with add_dir=None.\",\n816|            \"Strict spool failure remains image_spool_error500/no spawn. No broad catch of programming errors as media fallback.\"\n817|          ]\n818|        },\n819|        \"downgrade_transition_order\": [\n820|          \"Close any completed Run before deleting files (existing finally run.close). Snapshot old image count, old CID and session key for sanitized event and own CAS invalidation.\",\n821|          \"Call _cleanup_img_dir(own img_dir) if non-null; unregister under _active_lock using existing helper. Clear local img_dir and images, img_registered=False; ctx images=[], img_dir=None. Cleanup helper is idempotent; no cleanup of another request directory.\",\n822|          \"For any nonempty old/resume/explicit CID: if sess_key exists, _session_invalidate(sess_key,old_cid) (compare-and-swap); always _cid_release(old_cid,str(ctx.get(\\\"turn_id\\\") or \\\"\\\")) for own claim. Set ctx.hot_resumed=False, ctx.conversation_id=\\\"\\\" and any local resume_conv_id=None. Plain turns with sess_key=None never mutate session store.\",\n823|          \"The brief conv_id=str(uuid.uuid4()) means allocate a fresh logical conversation if implementation has such local; this HEAD has none. Contract is zero old --resume CID and Run conversation_id=\\\"\\\" so CLI creates NEW conversation, not pass a fabricated resume ID.\",\n824|          \"Set both ctx.prompt and ctx.full_prompt to ctx.stripped_full_prompt. Keep model/effort/cwd/tool protocol and acquired slot; subsequent Run.add_dir=None.\",\n825|          \"Commit only successful new text session under existing ownership rules; CAS cannot remove a concurrently replaced store value. Outer do_POST ownership cleanup remains idempotent for already released old CID.\"\n826|        ],\n827|        \"point3_runtime\": {\n828|          \"placement\": \"Immediately after attempt1 _execute returns and run.close() completes, before hot_resumed early continue (baseline3280..3295) AND before transient/_retry_take branch (3297..3310). Existing done break may precede guard because guard excludes done.\",\n829|          \"guard\": \"attempt==1 AND ctx.universal_fallback AND bool(images) AND img_dir is not None (actually attached Run) AND out.state not in (done,client_gone) AND NOT delivered\",\n830|          \"delivery\": \"delivered_reasoning=bool(out.get(\\\"delivered_reasoning\\\")) OR bool(ctx.get(\\\"stream\\\") and out.get(\\\"reasoning\\\")); delivered=bool(out.get(\\\"text\\\")) OR bool(out.get(\\\"tool_calls\\\")) OR delivered_reasoning. No delivered_reasoning field exists in this HEAD; do not accidentally ignore already emitted SSE reasoning. JSON buffered reasoning alone is not delivered. Empty role delta/keepalive is not delivery.\",\n831|          \"actions\": [\n832|            \"Emit runtime/state sanitized event exactly once, count BEFORE clearing images.\",\n833|            \"Execute full downgrade transition including immediate cleanup and full history reset before text constructor.\",\n834|            \"Call _retry_take() exactly once; consume one token if available. If unavailable, consume the one per-request media-degradation reserve; do not decrement global balance below0, replenish global bucket, loop, or fail this text retry.\",\n835|            \"Always sleep pause=_rng()*RETRY_PAUSE_CAP_S (equivalent to _retry_pause_s(1)); then continue into attempt2, add_dir=None, images=[], no old CID.\",\n836|            \"No third attempt; failed second text run preserves normal JSON/SSE error. No fallback for state done even nonzero rc/empty text (RISK03), client_gone or any delivered output.\"\n837|          ]\n838|        },\n839|        \"reserve_budget\": {\n840|          \"capacity\": \"1 fallback token per request ONLY after eligible image-attached attempt1; never reusable and never generic.\",\n841|          \"maximum\": \"generic+reserve still <=1 retry per request because fixed (1,2) loop. Slot retained across pause/retry; active CLI <=MAX_CONCURRENT (default4), body admission remains unchanged.\",\n842|          \"owner_override\": \"Owner explicitly requires degradation even when _retry_tenths<RETRY_COST_TENTHS. Therefore generic formula floor(.2*N)+3 is preserved for strict/generic-only traffic, but NOT claimed for universal fallback traffic. Total retries <= min(N, floor(.2*N)+3 + N_media_degradation_reserve). Worst all-image-fail batch reaches2N attempts; RISK08 quota and capacity must be measured before production acceptance.\"\n843|        },\n844|        \"exclusions\": \"LauncherUnavailable preflight, constructor OSError before a real attached _execute, auth/framing/invalid model/invalid effort/admission/queue failures remain existing errors; do not synthesize successful text result or emit second HTTP headers. No general Exception catch or transport refactor in this patch.\",\n845|        \"error_semantics\": \"200 means real text completion success. Failed text retry -> existing502/504/etc JSON or SSE error event+DONE. SSE initial200 alone never proves success. Keep legacy _error_body mapping for done/bad rc/empty text, missing executable, and queue overload.\",\n846|        \"lifecycle\": \"Cleanup of img_dir/partial spool before downgrade; outer finally releases slot exactly once. If physical deletion fails, report safe cleanup error and NEVER reattach or falsely assert deletion; existing orphan sweep remains recovery. Cancellation/client_gone skips all retries and closes Run/resources.\"\n847|      }\n848|    },\n849|    {\n850|      \"id\": \"AD-004\",\n851|      \"title\": \"Observability & Discoverability\",\n852|      \"status\": \"APPROVED\",\n853|      \"kind\": \"two-way\",\n854|      \"question\": \"How to report optimistic support while keeping strict health/models types and proofs intact?\",\n855|      \"choice\": \"Preserve existing boolean images fields; effective supports=universal&&input_enabled for all catalog models, otherwise strict predicate. Add a separate structured image_fallback object, never replace health.images with a dict.\",\n856|      \"alternatives\": [\n857|        \"Rewrite fleet proofs as confirmed: rejected by ao10 and evidence semantics.\",\n858|        \"Replace /health.images bool with dict: rejected by actual code/test_ao01 type semantics.\"\n859|      ],\n860|      \"drivers\": [\n861|        \"REQ-01\",\n862|        \"REQ-04\",\n863|        \"REQ-05\",\n864|        \"CON-05\",\n865|        \"INV-10\",\n866|        \"AC-08\"\n867|      ],\n868|      \"consequences\": [\n869|        \"Optimistic acceptance is distinguished from historical proof.\",\n870|        \"No fleet.json or old _model_supports_images strict semantics changes.\",\n871|        \"No auth/payload/prompt/path leakage in new events.\"\n872|      ],\n873|      \"approval_required\": false,\n874|      \"confirmation\": {\n875|        \"kind\": \"test\",\n876|        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n877|        \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-009, VER-010 must pass after implementation.\"\n878|      },\n879|      \"verification_ids\": [\n880|        \"VER-003\",\n881|        \"VER-006\",\n882|        \"VER-008\",\n883|        \"VER-009\",\n884|        \"VER-010\"\n885|      ],\n886|      \"details\": {\n887|        \"as_is_checks\": {\n888|          \"test_ao01\": \"With universal false, /v1/models data.images true ONLY gemini-4-argon and gemini-3.8-flash under _ImgEnv; aggregate images is True; health.images is True identity assertion.\",\n889|          \"test_ao06_health\": \"test_ao06_health_has_four_additive_fields_and_keeps_existing_ones at line2764 checks presence of old health keys and sqlite reasoning fields; does not license changing images type.\",\n890|          \"test_ao10\": \"Static fleet binary/version/default limits/proofs and text-only unsupported entries unchanged byte-for-byte.\"\n891|        },\n892|        \"effective_predicate\": \"At GET request start read universal,input once. If universal=True, effective_images(mid)=input_enabled and mid in FLEET_MODELS. If universal=False, effective_images(mid)=_model_supports_images(mid) exactly as now. _model_supports_images itself remains strict so no proof consumers silently change.\",\n893|        \"models\": \"Each data row retains id/object/owned_by/created/context_length/images boolean. Universal+input true => every catalog data.images=True, top-level images=any(effective flags). Add top-level image_fallback object for both policy states; never relabel static images.status/proof as confirmed.\",\n894|        \"health\": \"Keep health[\\\"images\\\"] boolean any(effective support) and existing image_input_mode string/sqlite fields. Add health[\\\"image_fallback\\\"]={\\\"fallback_enabled\\\":bool,\\\"input_enabled\\\":bool,\\\"mode\\\":\\\"universal\\\"|\\\"strict\\\",\\\"acceptance\\\":\\\"optimistic\\\"|\\\"proof-gated\\\"|\\\"text-only\\\",\\\"method\\\":\\\"workspace-read\\\",\\\"limits\\\":copy of IMAGE_LIMITS,\\\"models\\\":[effective supported catalog IDs]}. Same object on /v1/models. acceptance=text-only iff universal and input disabled, otherwise optimistic iff universal, else proof-gated. Brief suggestion health[\\\"images\\\"][\\\"fallback_enabled\\\"] is inapplicable to actual bool schema.\",\n895|        \"log_contract\": {\n896|          \"event\": \"image_fallback\",\n897|          \"template\": \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\",\n898|          \"stages\": [\n899|            \"collect\",\n900|            \"post_slot\",\n901|            \"spool\",\n902|            \"runtime\"\n903|          ],\n904|          \"attempts\": \"collect/post_slot/spool =>1 upcoming attempt; runtime=>1 failed attached attempt\",\n905|          \"reason\": \"flag_disabled; ImageReject.reason; image_spool_error; unsupported_media; runtime state token\",\n906|          \"sanitizer\": \"Introduce _log_token(value,max_len=64): only ASCII identifier chars A-Za-z0-9_.- survive, all others _, length capped64; empty->unknown. Stage from finite allowlist, model validated catalog, reason/state sanitized. Counts coerced bounded integers; code if extra uses same sanitizer.\",\n907|          \"sink\": \"HEAD uses _log(str) -> stderr + _mask_secrets; no log.info object exists. Preserve native sink and emit exact formatted event via _log helper (semantically INFO), no new logger dependency. If log.info introduced locally, it MUST route through same masking/sink; no requirement to rewire logging.\",\n908|          \"never\": [\n909|            \"auth keys\",\n910|            \"base64 payload\",\n911|            \"URLs\",\n912|            \"prompts\",\n913|            \"file paths\",\n914|            \"raw exception repr\"\n915|          ],\n916|          \"frequency\": \"Exactly one event per actual downgrade transition, no fallback event for strict path/pure-text or simply omitted audio beside valid raster. Strict reject/proof logs unchanged.\"\n917|        }\n918|      }\n919|    },\n920|    {\n921|      \"id\": \"AD-005\",\n922|      \"title\": \"Test Suite Append-Only Architecture uf01..uf10\",\n923|      \"status\": \"APPROVED\",\n924|      \"kind\": \"two-way\",\n925|      \"question\": \"How to prove new policy and retry contracts without weakening strict coverage?\",\n926|      \"choice\": \"Append UniversalImageFallbackTests at EOF, retaining entire baseline file bytes. Use import discovery, true raster fixtures and local flag patches; freeze assertion, execution and full suite commands independently.\",\n927|      \"alternatives\": [\n928|        \"Edit legacy _ImgEnv/_Fixture/tests to expect universal behavior: rejected, changes frozen strict baseline.\",\n929|        \"AST ID presence only: rejected, not evidence of behavior execution.\"\n930|      ],\n931|      \"drivers\": [\n932|        \"REQ-04\",\n933|        \"AC-01\",\n934|        \"AC-02\",\n935|        \"SCN-uf01\",\n936|        \"SCN-uf10\",\n937|        \"SCN-B01\",\n938|        \"SCN-B02\",\n939|        \"SCN-R01\",\n940|        \"SCN-R02\",\n941|        \"SCN-I01\"\n942|      ],\n943|      \"consequences\": [\n944|        \"Existing __main__ guard remains; direct python tests/file.py would miss appended classes, so VER003/005 use import/discovery.\",\n945|        \"No suite-wide environment override enables universal.\",\n946|        \"Red regressions before product fix, then green full legacy+universal execution; future tests are not executed or claimed Stage2.\"\n947|      ],\n948|      \"approval_required\": false,\n949|      \"confirmation\": {\n950|        \"kind\": \"test\",\n951|        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n952|        \"expected\": \"Independent execution VER003 plus VER-001, VER-002, VER-003, VER-004, VER-005, VER-006, VER-007, VER-008 must pass after implementation.\"\n953|      },\n954|      \"verification_ids\": [\n955|        \"VER-001\",\n956|        \"VER-002\",\n957|        \"VER-003\",\n958|        \"VER-004\",\n959|        \"VER-005\",\n960|        \"VER-006\",\n961|        \"VER-007\",\n962|        \"VER-008\"\n963|      ],\n964|      \"details\": {\n965|        \"prefix\": {\n966|          \"path\": \"tests/test_agy_bridge_resilience.py\",\n967|          \"bytes\": 249933,\n968|          \"sha256\": \"f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5\",\n969|          \"deleted_lines_allowed\": 0,\n970|          \"preserve\": \"Entire BASE blob is a prefix; additions strictly after byte249933. This includes all old tests/helpers/__main__, stronger than a diff numstat check.\"\n971|        },\n972|        \"new_class\": \"UniversalImageFallbackTests(unittest.TestCase)\",\n973|        \"test_methods\": [\n974|          {\n975|            \"name\": \"test_uf01_all_catalog_models_and_efforts_optimistic\",\n976|            \"scenarios\": [\n977|              \"SCN-uf01\",\n978|              \"SCN-B01\"\n979|            ],\n980|            \"assertions\": \"Every catalog model x declared effort, true raster PNG/JPEG/GIF/WebP fixture; runtime proof/SHA/status/efforts_proven corrupted or absent without startup schema violation; no strict gate invocation, attachment/files/add-dir attempt1 and real successful JSON/SSE. Catalog negatives remain ingress errors.\"\n981|          },\n982|          {\n983|            \"name\": \"test_uf02_image_rejections_strip_all_media\",\n984|            \"scenarios\": [\n985|              \"SCN-uf02\",\n986|              \"SCN-B01\",\n987|              \"SCN-B02\"\n988|            ],\n989|            \"assertions\": \"Whole taxonomy incl malformed alias/dict content, MIME/base64/magic/roles/16vs17/size cap±1, mixed invalid+valid image; one stripped run/no partial staging/no fetch; media failure no400; auth/JSON/body413/model/effort/admission503 retain errors.\"\n990|          },\n991|          {\n992|            \"name\": \"test_uf03_policy_matrix_recheck_and_cache\",\n993|            \"scenarios\": [\n994|              \"SCN-uf03\"\n995|            ],\n996|            \"assertions\": \"Four policy states, missing/false/malformed/string/int/null/oversize config; env token map, TTL boundary, reset; input flip while queued strips before mkdir/Run, SHA flip ignored universal; rollback/re-enable without restart and slots restored.\"\n997|          },\n998|          {\n999|            \"name\": \"test_uf04_spool_failures_downgrade_before_attempt1\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
