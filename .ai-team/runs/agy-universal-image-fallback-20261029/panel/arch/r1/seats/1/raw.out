]\n1347\t    },\n1348\t    {\n1349\t      \"id\": \"RISK-003\",\n1350\t      \"source_id\": \"RISK-03\",\n1351\t      \"scenario\": \"done badrc/empty output and constructor exceptions do not match owner runtime guard.\",\n1352\t      \"probability\": \"medium\",\n1353\t      \"impact\": \"high\",\n1354\t      \"mitigation\": \"Exclude done and pre-execute constructor errors; preserve mapping and one header response; test explicitly uf08.\",\n1355\t      \"verification_ids\": [\n1356\t        \"VER-003\"\n1357\t      ]\n1358\t    },\n1359\t    {\n1360\t      \"id\": \"RISK-004\",\n1361\t      \"source_id\": \"RISK-04\",\n1362\t      \"scenario\": \"Pixel decoder can break magic-only strict fixtures or admit decompression bombs.\",\n1363\t      \"probability\": \"medium\",\n1364\t      \"impact\": \"high\",\n1365\t      \"mitigation\": \"No new pixel decoder; signature and byte safety unchanged; real decodable positive corpus does not assert arbitrary pixel validity.\",\n1366\t      \"verification_ids\": [\n1367\t        \"VER-003\",\n1368\t        \"VER-006\"\n1369\t      ]\n1370\t    },\n1371\t    {\n1372\t      \"id\": \"RISK-005\",\n1373\t      \"source_id\": \"RISK-05\",\n1374\t      \"scenario\": \"Flag cache leaks fixture/policy state or hot CID survives stripping.\",\n1375\t      \"probability\": \"medium\",\n1376\t      \"impact\": \"high\",\n1377\t      \"mitigation\": \"Independent cache reset; consistent universal snapshot, input recheck, env contexts, full stripped prompts and owner-safe CID reset.\",\n1378\t      \"verification_ids\": [\n1379\t        \"VER-003\",\n1380\t        \"VER-009\"\n1381\t      ]\n1382\t    },\n1383\t    {\n1384\t      \"id\": \"RISK-006\",\n1385\t      \"source_id\": \"RISK-06\",\n1386\t      \"scenario\": \"Checkout, deployed runtime and config diverge.\",\n1387\t      \"probability\": \"medium\",\n1388\t      \"impact\": \"high\",\n1389\t      \"mitigation\": \"Pair hash readback, actual deployed ROOT booleans; controlled code restart then dynamic rollback and same-owner live receipt.\",\n1390\t      \"verification_ids\": [\n1391\t        \"VER-008\",\n1392\t        \"VER-010\"\n1393\t      ]\n1394\t    },\n1395\t    {\n1396\t      \"id\": \"RISK-007\",\n1397\t      \"source_id\": \"RISK-07\",\n1398\t      \"scenario\": \"Universal mode accidentally bypasses body/connection/admission safety.\",\n1399\t      \"probability\": \"medium\",\n1400\t      \"impact\": \"high\",\n1401\t      \"mitigation\": \"Ingress auth/framing/model/effort/body limits run before media fallback unchanged; whole-request strip never means unlimited parsing/fetching.\",\n1402\t      \"verification_ids\": [\n1403\t        \"VER-003\",\n1404\t        \"VER-005\",\n1405\t        \"VER-009\"\n1406\t      ]\n1407\t    },\n1408\t    {\n1409\t      \"id\": \"RISK-008\",\n1410\t      \"source_id\": \"RISK-08\",\n1411\t      \"scenario\": \"No measured quota/RPS/p99/memory/CPU/FD budget, plus reserve allows up to2N CLI executions.\",\n1412\t      \"probability\": \"medium\",\n1413\t      \"impact\": \"high\",\n1414\t      \"mitigation\": \"Record all46 HL fields with UNKNOWN facts; no capacity PASS; require release resource measurement and owner quota/SLA before production acceptance. Do not claim generic retry bound for universal reserve.\",\n1415\t      \"verification_ids\": [\n1416\t        \"VER-003\",\n1417\t        \"VER-010\"\n1418\t      ]\n1419\t    }\n1420\t  ],\n1421\t  \"verification_surface\": [\n1422\t    {\n1423\t      \"id\": \"VER-001\",\n1424\t      \"requirement_ids\": [\n1425\t        \"REQ-04\"\n1426\t      ],\n1427\t      \"kind\": \"command\",\n1428\t      \"command\": \"run-guarded -- env uvx ruff@0.17.3 check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\n1429\t      \"expected\": \"exit 0; no lint errors; never use --fix on frozen baseline\",\n1430\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1431\t      \"owner\": \"Verifier\"\n1432\t    },\n1433\t    {\n1434\t      \"id\": \"VER-002\",\n1435\t      \"requirement_ids\": [\n1436\t        \"REQ-04\"\n1437\t      ],\n1438\t      \"kind\": \"command\",\n1439\t      \"command\": \"run-guarded -- env uvx ruff@0.17.3 format --check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\n1440\t      \"expected\": \"exit 0; no formatting writes to original prefix\",\n1441\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1442\t      \"owner\": \"Verifier\"\n1443\t    },\n1444\t    {\n1445\t      \"id\": \"VER-003\",\n1446\t      \"requirement_ids\": [\n1447\t        \"REQ-01\",\n1448\t        \"REQ-02\",\n1449\t        \"REQ-03\",\n1450\t        \"REQ-04\",\n1451\t        \"REQ-05\",\n1452\t        \"REQ-06\"\n1453\t      ],\n1454\t      \"kind\": \"command\",\n1455\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n1456\t      \"expected\": \">=56 tests: all 46 legacy image-related methods plus UniversalImageFallbackTests uf01..uf10 execute and pass; not AST-only\",\n1457\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1458\t      \"owner\": \"Verifier\"\n1459\t    },\n1460\t    {\n1461\t      \"id\": \"VER-004\",\n1462\t      \"requirement_ids\": [\n1463\t        \"REQ-04\"\n1464\t      ],\n1465\t      \"kind\": \"command\",\n1466\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import collections, io, json, subprocess, tarfile, tempfile\\nfrom pathlib import Path\\nroot=Path.cwd(); temp_base_dir=Path.home()/\\\"work/tmp\\\"; temp_base_dir.mkdir(parents=True,exist_ok=True)\\nargs=[\\\"uvx\\\",\\\"basedpyright@1.40.2\\\",\\\"--outputjson\\\",\\\"bridges/agy-bridge/server.py\\\",\\\"tests/test_agy_bridge_resilience.py\\\"]\\ndef diagnostics(cwd):\\n r=subprocess.run(args,cwd=cwd,capture_output=True,text=True)\\n assert r.returncode in (0,1),(r.returncode,r.stderr)\\n d=json.loads(r.stdout); assert \\\"generalDiagnostics\\\" in d,d\\n c=collections.Counter()\\n for x in d[\\\"generalDiagnostics\\\"]:\\n  f=str(Path(x[\\\"file\\\"]).relative_to(cwd)); c[(f,x.get(\\\"severity\\\"),x.get(\\\"rule\\\"),x[\\\"message\\\"])]+=1\\n return c\\nwith tempfile.TemporaryDirectory(prefix=\\\"agy-type-baseline-\\\",dir=temp_base_dir) as tmp:\\n old=Path(tmp); archive=subprocess.check_output([\\\"git\\\",\\\"archive\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'])\\n with tarfile.open(fileobj=io.BytesIO(archive)) as tf: tf.extractall(old,filter=\\\"data\\\")\\n before=diagnostics(old); after=diagnostics(root); delta=after-before\\n assert not delta,dict(delta)\\n print(\\\"TYPECHECK_NO_NEW_DIAGNOSTICS_PASS\\\",\\\"baseline\\\",sum(before.values()),\\\"candidate\\\",sum(after.values()))'\",\n1467\t      \"expected\": \"same pinned basedpyright executable checks archived BASE and candidate; exact multiset file/severity/rule/message delta is empty; inherited diagnostics recorded, no baseline suppression\",\n1468\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1469\t      \"owner\": \"Verifier\"\n1470\t    },\n1471\t    {\n1472\t      \"id\": \"VER-005\",\n1473\t      \"requirement_ids\": [\n1474\t        \"REQ-01\",\n1475\t        \"REQ-02\",\n1476\t        \"REQ-03\",\n1477\t        \"REQ-04\",\n1478\t        \"REQ-05\",\n1479\t        \"REQ-06\"\n1480\t      ],\n1481\t      \"kind\": \"command\",\n1482\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider\",\n1483\t      \"expected\": \"exit 0; full repository suite including all agy/strict tests. No pyproject.toml exists; use pinned uvx, do not invent uv run project config.\",\n1484\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1485\t      \"owner\": \"Verifier\"\n1486\t    },\n1487\t    {\n1488\t      \"id\": \"VER-006\",\n1489\t      \"requirement_ids\": [\n1490\t        \"REQ-04\"\n1491\t      ],\n1492\t      \"kind\": \"command\",\n1493\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\np='\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'; old=subprocess.check_output([\\\"git\\\",\\\"show\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'+\\\":\\\"+p]); new=Path(p).read_bytes()\\nassert len(old)==249933 and hashlib.sha256(old).hexdigest()=='\\\"'\\\"'f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5'\\\"'\\\"'\\nassert new[:len(old)]==old, \\\"Baseline prefix changed\\\"\\nfor b in ['\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"','\\\"'\\\"'5a19559426de7508d525e2bd465eff648665a6a7'\\\"'\\\"']:\\n rows=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--numstat\\\",b,\\\"--\\\",p],text=True).splitlines()\\n assert all(row.split()[1]==\\\"0\\\" for row in rows), rows\\nsubprocess.run([\\\"python3\\\",\\\"-B\\\",\\\"-m\\\",\\\"unittest\\\",\\\"discover\\\",\\\"-s\\\",\\\"tests\\\",\\\"-p\\\",\\\"test_images_strict.py\\\",\\\"-q\\\"],check=True)\\nprint(\\\"APPEND_ONLY_STRICT_PASS\\\",len(old))'\",\n1494\t      \"expected\": \"whole baseline blob is exact prefix; 0 deleted lines against both baselines; test_images_strict.py executes successfully\",\n1495\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1496\t      \"owner\": \"Teamlead\"\n1497\t    },\n1498\t    {\n1499\t      \"id\": \"VER-007\",\n1500\t      \"requirement_ids\": [\n1501\t        \"REQ-01\",\n1502\t        \"REQ-02\",\n1503\t        \"REQ-03\",\n1504\t        \"REQ-04\",\n1505\t        \"REQ-06\"\n1506\t      ],\n1507\t      \"kind\": \"command\",\n1508\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast, re\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"tests/test_agy_bridge_resilience.py\\\").read_text())\\nexpected={f\\\"{p}{i:02}\\\" for p,n in [(\\\"img\\\",10),(\\\"hist\\\",10),(\\\"life\\\",5),(\\\"log\\\",2),(\\\"res\\\",3),(\\\"ao\\\",10),(\\\"uf\\\",10)] for i in range(1,n+1)}\\nfound=set(); uf=set()\\nfor f in ast.walk(t):\\n if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith(\\\"test_\\\") and any(isinstance(a,ast.Assert) or isinstance(a,ast.Call) and isinstance(a.func,ast.Attribute) and isinstance(a.func.value,ast.Name) and a.func.value.id==\\\"self\\\" and a.func.attr.startswith(\\\"assert\\\") for a in ast.walk(f)):\\n  ids={k for k in expected if re.search(r\\\"(?:^|_)\\\"+k+r\\\"(?:_|$)\\\",f.name)}; found.update(ids)\\nfor c in t.body:\\n if isinstance(c,ast.ClassDef) and c.name==\\\"UniversalImageFallbackTests\\\":\\n  assert c.lineno>6008, c.lineno\\n  uf={f\\\"uf{i:02}\\\" for f in c.body if isinstance(f,ast.FunctionDef) for i in range(1,11) if re.match(f\\\"test_uf{i:02}_\\\",f.name)}\\nassert not expected-found, sorted(expected-found)\\nassert uf=={f\\\"uf{i:02}\\\" for i in range(1,11)},uf\\nprint(\\\"QA_ASSERT_COVERAGE_PASS\\\",len(expected))'\",\n1509\t      \"expected\": \"all 40 inherited QA IDs + uf01..uf10 have assertion-bearing test methods; appended UniversalImageFallbackTests exists; execution independently VER003/005\",\n1510\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1511\t      \"owner\": \"Teamlead\"\n1512\t    },\n1513\t    {\n1514\t      \"id\": \"VER-008\",\n1515\t      \"requirement_ids\": [\n1516\t        \"REQ-01\",\n1517\t        \"REQ-02\",\n1518\t        \"REQ-03\",\n1519\t        \"REQ-04\",\n1520\t        \"REQ-05\",\n1521\t        \"REQ-06\"\n1522\t      ],\n1523\t      \"kind\": \"command\",\n1524\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\nbase='\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'; allowed={'\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"','\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'}\\npaths=set(subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--name-only\\\",base,\\\"--\\\"],text=True).splitlines())|set(subprocess.check_output([\\\"git\\\",\\\"ls-files\\\",\\\"--others\\\",\\\"--exclude-standard\\\"],text=True).splitlines())\\npaths={p for p in paths if not p.startswith(\\\".ai-team/runs/\\\") and p not in {'\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/research-plan.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/open-questions.md'\\\"'\\\"'}}\\nassert paths<=allowed,paths-allowed\\nassert Path('\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"').read_bytes()==subprocess.check_output([\\\"git\\\",\\\"show\\\",base+\\\":\\\"+'\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"'])\\nfrozen={'\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"': '\\\"'\\\"'ae5bc560087d180ce4f20333028c5ad472ea772dbccf6a7b82bcb6ce7d8db59f'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"': '\\\"'\\\"'7e5f684041b65986f4ff7c8f05f67e930f497165ce5c26fd74d8ee95df9f92f6'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"': '\\\"'\\\"'6a71c3352f56f012e6c3e406cabad0ebbf43aad5afc325399b767b2753877377'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/open-questions.md'\\\"'\\\"': '\\\"'\\\"'f4d2914546a192f16993873c1c2d91365a65e93d2dc611963fb5eeb0af2e740e'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/research-plan.md'\\\"'\\\"': '\\\"'\\\"'e639555a5c7df5f6f4a9a7876e8902e0ee2989b410f8569e9d640ff3332cf898'\\\"'\\\"'}\\nfor p,h in frozen.items(): assert hashlib.sha256(Path(p).read_bytes()).hexdigest()==h,p\\ntracked=subprocess.check_output([\\\"git\\\",\\\"ls-files\\\"],text=True).splitlines(); assert not any(Path(p).name==\\\"dynamic_config.json\\\" for p in tracked)\\nprint(\\\"SCOPE_FROZEN_PASS\\\")'\",\n1525\t      \"expected\": \"only two permitted product paths; fleet byte-identical; all five Stage1 hashes unchanged; production dynamic config not tracked\",\n1526\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1527\t      \"owner\": \"Teamlead\"\n1528\t    },\n1529\t    {\n1530\t      \"id\": \"VER-009\",\n1531\t      \"requirement_ids\": [\n1532\t        \"REQ-01\",\n1533\t        \"REQ-02\",\n1534\t        \"REQ-03\",\n1535\t        \"REQ-06\"\n1536\t      ],\n1537\t      \"kind\": \"command\",\n1538\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast,sys\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"bridges/agy-bridge/server.py\\\").read_text()); funcs={n.name:n for n in ast.walk(t) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}\\nrequired={\\\"_read_image_fallback_flag\\\",\\\"_is_image_fallback_enabled\\\",\\\"_image_gate_universal\\\",\\\"_strip_media_from_messages\\\",\\\"_flatten_content_stripped\\\",\\\"_messages_to_stripped_prompt\\\",\\\"_log_token\\\"}\\nassert required<=funcs.keys(),required-funcs.keys()\\nr=funcs[\\\"_reset_sqlite_guards_for_tests\\\"]\\nassert any(isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id==\\\"_image_fallback_flag_cache\\\" for x in n.targets) and ast.literal_eval(n.value)==(0.0,False) for n in ast.walk(r)),\\\"cache reset\\\"\\nimports={a.name.split(\\\".\\\")[0] for n in ast.walk(t) if isinstance(n,ast.Import) for a in n.names}|{n.module.split(\\\".\\\")[0] for n in ast.walk(t) if isinstance(n,ast.ImportFrom) and n.module}\\nassert imports<=set(sys.stdlib_module_names)|{\\\"core\\\"},imports-set(sys.stdlib_module_names)-{\\\"core\\\"}\\nseen=set(); todo=[n for n in funcs if \\\"image\\\" in n or \\\"media\\\" in n or \\\"stripped\\\" in n]\\nwhile todo:\\n n=todo.pop()\\n if n in seen: continue\\n seen.add(n)\\n for c in ast.walk(funcs[n]):\\n  if isinstance(c,ast.Call):\\n   name=ast.unparse(c.func)\\n   assert not any(x in name for x in [\\\"urlopen\\\",\\\"urlretrieve\\\",\\\"urllib.request\\\",\\\"HTTPConnection\\\",\\\"HTTPSConnection\\\"]),name\\n   if isinstance(c.func,ast.Name) and c.func.id in funcs: todo.append(c.func.id)\\nprint(\\\"STATIC_IMAGE_SECURITY_CONTRACT_PASS\\\")'\",\n1539\t      \"expected\": \"named helper/cache reset/static no-fetch boundary passes; actual guard ordering, prompts, delivery, CID and reserve behavior must also pass uf03..uf10 under VER003\",\n1540\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1541\t      \"owner\": \"Verifier\"\n1542\t    },\n1543\t    {\n1544\t      \"id\": \"VER-010\",\n1545\t      \"requirement_ids\": [\n1546\t        \"REQ-01\",\n1547\t        \"REQ-02\",\n1548\t        \"REQ-03\",\n1549\t        \"REQ-05\",\n1550\t        \"REQ-06\"\n1551\t      ],\n1552\t      \"kind\": \"command\",\n1553\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib,json\\nfrom pathlib import Path\\nroot=Path.home()/\\\".dsh/bridges/agy-bridge\\\"; cfg=json.loads((root/\\\"dynamic_config.json\\\").read_text())\\nassert cfg.get(\\\"IMAGE_INPUT_ENABLED\\\") is True and cfg.get(\\\"IMAGE_FALLBACK_ENABLED\\\") is True\\nassert hashlib.sha256((root/\\\"server.py\\\").read_bytes()).hexdigest()==hashlib.sha256(Path('\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"').read_bytes()).hexdigest()\\nassert (root/\\\"fleet.json\\\").read_bytes()==Path('\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"').read_bytes()\\nr=json.loads(Path(\\\".ai-team/runs/agy-universal-image-fallback-20261029/teamlead/live-acceptance.json\\\").read_text())\\nassert r[\\\"status\\\"]==\\\"PASS\\\" and r[\\\"existing_owner_chat\\\"] is True\\nassert r[\\\"candidate_server_sha256\\\"]==hashlib.sha256(Path('\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"').read_bytes()).hexdigest()\\nneeded={\\\"image_then_text_fallback_then_history\\\",\\\"previously_text_only_model\\\",\\\"cold_and_hot\\\",\\\"explicit_cid\\\",\\\"repeat_and_parallel\\\",\\\"sse_completion_no_error\\\",\\\"cleanup_before_retry\\\",\\\"flag_rollback_reload\\\",\\\"resource_profile\\\",\\\"side_effect_safe_failure\\\"}\\nassert needed<=set(r[\\\"scenarios_passed\\\"]),needed-set(r[\\\"scenarios_passed\\\"])\\nassert r[\\\"unverified\\\"]==[] and r[\\\"evidence_refs\\\"] and all(isinstance(x,str) and x for x in r[\\\"evidence_refs\\\"])\\nprint(\\\"LIVE_RELEASE_RECEIPT_PRESENT_CONFIG_AND_HASH_PASS\\\")'\",\n1554\t      \"expected\": \"deployed server SHA/fleet pair and both strict JSON booleans true; independently collected same-owner-chat live receipt covers all listed scenarios and resource profile. Receipt presence is NOT itself proof: Teamlead must inspect referenced evidence.\",\n1555\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n1556\t      \"owner\": \"Teamlead\"\n1557\t    }\n1558\t  ],\n1559\t  \"protected_paths\": [\n1560\t    \"bridges/agy-bridge/fleet.json\",\n1561\t    \"analysis/agy-universal-image-fallback/\",\n1562\t    \".ai-team/runs/agy-universal-image-fallback-20261029/architecture/\",\n1563\t    \".ai-team/runs/agy-universal-image-fallback-20261029/teamlead/verification-surface.json\",\n1564\t    \".ai-team/runs/agy-universal-image-fallback-20261029/task.json\",\n1565\t    \".ai-team/runs/agy-universal-image-fallback-20261029/plans/architect-01.json\"\n1566\t  ],\n1567\t  \"materialization\": [],\n1568\t  \"approval\": {\n1569\t    \"status\": \"NOT_REQUIRED\",\n1570\t    \"decision_ids\": [],\n1571\t    \"approved_by\": null,\n1572\t    \"evidence_ref\": null\n1573\t  },\n1574\t  \"independent_review\": {\n1575\t    \"required\": false,\n1576\t    \"status\": \"PENDING\",\n1577\t    \"reviewer\": null,\n1578\t    \"evidence_ref\": null,\n1579\t    \"scope\": \"S2 schema does not require S3 review. teamlead-with-architect still REQUIRES independent external three-family ARCH_PANEL proof before Coder; none claimed here.\"\n1580\t  },\n1581\t  \"open_questions\": [],\n1582\t  \"deferred\": [\n1583\t    \"Product implementation and append-only tests are Coder work after external ARCH_PANEL PASS.\",\n1584\t    \"Production deployment/config writes/restart and existing DSH chat live acceptance are release work.\",\n1585\t    \"Full pixel decoder and audio/video/document decoders are outside this change.\",\n1586\t    \"Unknown production SLA/RPS/quota/memory/CPU/FD numbers are NOT measured or fabricated; resource acceptance remains blocked.\"\n1587\t  ],\n1588\t  \"source_contracts\": [\n1589\t    {\n1590\t      \"id\": \"CON-01\",\n1591\t      \"baseline\": \"ingress: `POST /v1/chat/completions`, HTTP JSON messages и JSON/SSE output; DSH → agy bridge, владелец локального моста. Auth/header/framing/model/effort/body/admission проверки самостоятельны (F-130). Нет доказанного Idempotency-Key/dedup контракта: повтор CLI не равен exactly-once. Test contour: localhost `_HttpBridge`, fake agy (F-216).\",\n1592\t      \"decision_ids\": [\n1593\t        \"AD-003\"\n1594\t      ],\n1595\t      \"verification_ids\": [\n1596\t        \"VER-003\",\n1597\t        \"VER-010\"\n1598\t      ]\n1599\t    },\n1600\t    {\n1601\t      \"id\": \"CON-02\",\n1602\t      \"baseline\": \"image input: только user `image_url` data/base64 raster; пределы 16, individual/total20971520 bytes, body33554432 bytes. External URLs не читаются; ссылки не должны попасть в CLI fallback. Rejection taxonomy сохранена в strict mode (F-105/F-106/F-206/F-310).\",\n1603\t      \"decision_ids\": [\n1604\t        \"AD-001\",\n1605\t        \"AD-002\"\n1606\t      ],\n1607\t      \"verification_ids\": [\n1608\t        \"VER-003\",\n1609\t        \"VER-010\"\n1610\t      ]\n1611\t    },\n1612\t    {\n1613\t      \"id\": \"CON-03\",\n1614\t      \"baseline\": \"egress CLI: argv `--add-dir <dir>` и prompt attachments, рабочий cwd отдельно; stdout JSON events, stderr diagnostics; lifecycle `Run.close` и controller. Состояния/error mapping F-114/F-120/F-123/F-125. Не меняется контракт CLI под универсальное inline media API.\",\n1615\t      \"decision_ids\": [\n1616\t        \"AD-003\"\n1617\t      ],\n1618\t      \"verification_ids\": [\n1619\t        \"VER-003\",\n1620\t        \"VER-010\"\n1621\t      ]\n1622\t    },\n1623\t    {\n1624\t      \"id\": \"CON-04\",\n1625\t      \"baseline\": \"local config: путь из resolved server ROOT, strict JSON flag read с TTL1s, env override только существующего input flag; production — отдельные files. `start.sh` config не устанавливает (F-101/F-303/F-306/F-307). Новый policy обязан иметь явные чтение, default, cache reset/reload и rollout/rollback; имя ключа решает архитектор.\",\n1626\t      \"decision_ids\": [\n1627\t        \"AD-001\"\n1628\t      ],\n1629\t      \"verification_ids\": [\n1630\t        \"VER-003\",\n1631\t        \"VER-010\"\n1632\t      ]\n1633\t    },\n1634\t    {\n1635\t      \"id\": \"CON-05\",\n1636\t      \"baseline\": \"discoverability: `/v1/models`, `/health` сейчас отражают доказанный допуск, не optimistic attempt (F-129). В strict режиме ответы неизменны. Universal effective capability нельзя выдавать за confirmed proof; модель остаётся под catalog validation. Требуются различимые policy/staging/optimistic-attempt поля либо согласованное расширение semantics без мутации static fleet (F-205).\",\n1637\t      \"decision_ids\": [\n1638\t        \"AD-004\"\n1639\t      ],\n1640\t      \"verification_ids\": [\n1641\t        \"VER-003\",\n1642\t        \"VER-010\"\n1643\t      ]\n1644\t    },\n1645\t    {\n1646\t      \"id\": \"CON-06\",\n1647\t      \"baseline\": \"fault boundary: ImageReject и ImageSpoolError fail-open к **санитизированному тексту** только при universal=true. Auth/admission/framing/unknown model/unsupported reasoning effort fail-closed по прежнему контракту. Конфиг/его неверный тип fail-closed к strict policy. CLI missing/offline, timeout текстового повтора и оборванный клиент не становятся фиктивным success (F-125/F-130).\",\n1648\t      \"decision_ids\": [\n1649\t        \"AD-003\"\n1650\t      ],\n1651\t      \"verification_ids\": [\n1652\t        \"VER-003\",\n1653\t        \"VER-010\"\n1654\t      ]\n1655\t    }\n1656\t  ],\n1657\t  \"invariants\": [\n1658\t    {\n1659\t      \"id\": \"INV-01\",\n1660\t      \"statement\": \"bypass proof не bypass safety validation. Ни fetch/file://, ни MIME expansion, ни превышение resource limits. Strict path сохраняет прежний signature-only контракт. Valid decodable fixtures обязательны для universal positive tests; полноценное pixel decoding — отдельное решение с ограничениями памяти (F-107/F-217).\",\n1661\t      \"decision_ids\": [\n1662\t        \"AD-001\"\n1663\t      ],\n1664\t      \"verification_ids\": [\n1665\t        \"VER-003\",\n1666\t        \"VER-009\"\n1667\t      ]\n1668\t    },\n1669\t    {\n1670\t      \"id\": \"INV-02\",\n1671\t      \"statement\": \"normalized media-free history имеет только разрешённые text parts; classification media выполняется раньше чтения `text`. `image_url`, `image`, `input_image` → `[image omitted]`; `input_audio`, `audio`, `video`, `file`, `document`, `inlineData`, `fileData` → `[media omitted]` либо удаление. Проверять и `type`, и соответствующие payload keys, в том числе dict-content; не использовать `str(media_dict)`. Неизвестный structured block не сериализовать целиком. Обычный текст пользователя с URL не цензурировать как вложение (REQ-06/F-112).\",\n1672\t      \"decision_ids\": [\n1673\t        \"AD-002\"\n1674\t      ],\n1675\t      \"verification_ids\": [\n1676\t        \"VER-003\",\n1677\t        \"VER-009\"\n1678\t      ]\n1679\t    },\n1680\t    {\n1681\t      \"id\": \"INV-03\",\n1682\t      \"statement\": \"сбой любого изображения в universal admission убирает **все** media данного запроса/истории, без частичного spool/поднабора. Mixed valid raster + unsupported non-image media: raster допускается к optimistic send, прочее media не передаётся agy и не сериализуется. Если режим уже downgraded, никакие старые media не возвращаются через full_prompt (F-111/F-115).\",\n1683\t      \"decision_ids\": [\n1684\t        \"AD-002\",\n1685\t        \"AD-003\"\n1686\t      ],\n1687\t      \"verification_ids\": [\n1688\t        \"VER-003\",\n1689\t        \"VER-009\"\n1690\t      ]\n1691\t    },\n1692\t    {\n1693\t      \"id\": \"INV-04\",\n1694\t      \"statement\": \"image fallback должен иметь очищенные prompt **и** full_prompt. Перед runtime retry необходим доступ к очищенной истории/предвычисленному full text prompt: в текущем ctx исходных messages нет (F-124). Простой вызов `_messages_to_prompt(original_messages, [])` оставляет image N (F-111). Media-only → placeholder или существующий непустой safe fallback, без attachments (F-113).\",\n1695\t      \"decision_ids\": [\n1696\t        \"AD-002\",\n1697\t        \"AD-003\"\n1698\t      ],\n1699\t      \"verification_ids\": [\n1700\t        \"VER-003\",\n1701\t        \"VER-009\"\n1702\t      ]\n1703\t    },\n1704\t    {\n1705\t      \"id\": \"INV-05\",\n1706\t      \"statement\": \"runtime guard в точности: attempt1, фактически передан add_dir и непустые images, state не done/client_gone, delivered=false. Его нужно обработать до **обоих** legacy retry-переходов, включая ранний hot continue (F-121). Timeout/idle/first-token states подпадают под owner guard в universal mode, хотя legacy transient их не повторяет (F-122). Только одна text retry, никогда третья.\",\n1707\t      \"decision_ids\": [\n1708\t        \"AD-003\"\n1709\t      ],\n1710\t      \"verification_ids\": [\n1711\t        \"VER-003\",\n1712\t        \"VER-009\"\n1713\t      ]\n1714\t    },\n1715\t    {\n1716\t      \"id\": \"INV-06\",\n1717\t      \"statement\": \"немедленно cleanup зарегистрированного img_dir, затем обнулить local и ctx img_dir/images; повтор с `add_dir=None`. Partial-stage failure также cleanup/registry removal. Сохранить slot на текущий ход, освободить ровно один раз; завершение каждого Run до cleanup (F-109/F-110/F-119).\",\n1718\t      \"decision_ids\": [\n1719\t        \"AD-003\"\n1720\t      ],\n1721\t      \"verification_ids\": [\n1722\t        \"VER-003\",\n1723\t        \"VER-009\"\n1724\t      ]\n1725\t    },\n1726\t    {\n1727\t      \"id\": \"INV-07\",\n1728\t      \"statement\": \"использовать существующий CAS `_session_invalidate(sess_key,cid)` вместо несуществующего имени из брифа; снять собственный cid claim через `_cid_release`, сбросить hot_resumed/conversation_id и переключить на full **stripped** prompt. Text fallback не должен resume прежний explicit CID, который может сохранять attachment context. Plain turn не меняет чужой store; конкурентно обновлённый CID не инвалидировать (F-116/F-117/F-121).\",\n1729\t      \"decision_ids\": [\n1730\t        \"AD-003\"\n1731\t      ],\n1732\t      \"verification_ids\": [\n1733\t        \"VER-003\",\n1734\t        \"VER-009\"\n1735\t      ]\n1736\t    },\n1737\t    {\n1738\t      \"id\": \"INV-08\",\n1739\t      \"statement\": \"delivered=text/tool_calls/stream reasoning; initial empty SSE delta и keepalive не означают delivery. После delivery или client_gone retry запрещён, файлы всё равно убрать. JSON reasoning ещё не доставлен и не блокирует downgrade (F-120/F-126).\",\n1740\t      \"decision_ids\": [\n1741\t        \"AD-003\"\n1742\t      ],\n1743\t      \"verification_ids\": [\n1744\t        \"VER-003\",\n1745\t        \"VER-009\"\n1746\t      ]\n1747\t    },\n1748\t    {"}]},"parent_tool_use_id":null,"session_id":"f57c395a-b445-4654-9da4-7c261a073f36","uuid":"b04050a6-3eb6-4455-9f5f-879cfe64cdbe","timestamp":"2026-10-29T14:37:59.016Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json","content":"        \"kind\": \"test\",\n        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n        \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-009, VER-010 must pass after implementation.\"\n      },\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-006\",\n        \"VER-008\",\n        \"VER-009\",\n        \"VER-010\"\n      ],\n      \"details\": {\n        \"as_is_checks\": {\n          \"test_ao01\": \"With universal false, /v1/models data.images true ONLY gemini-4-argon and gemini-3.8-flash under _ImgEnv; aggregate images is True; health.images is True identity assertion.\",\n          \"test_ao06_health\": \"test_ao06_health_has_four_additive_fields_and_keeps_existing_ones at line2764 checks presence of old health keys and sqlite reasoning fields; does not license changing images type.\",\n          \"test_ao10\": \"Static fleet binary/version/default limits/proofs and text-only unsupported entries unchanged byte-for-byte.\"\n        },\n        \"effective_predicate\": \"At GET request start read universal,input once. If universal=True, effective_images(mid)=input_enabled and mid in FLEET_MODELS. If universal=False, effective_images(mid)=_model_supports_images(mid) exactly as now. _model_supports_images itself remains strict so no proof consumers silently change.\",\n        \"models\": \"Each data row retains id/object/owned_by/created/context_length/images boolean. Universal+input true => every catalog data.images=True, top-level images=any(effective flags). Add top-level image_fallback object for both policy states; never relabel static images.status/proof as confirmed.\",\n        \"health\": \"Keep health[\\\"images\\\"] boolean any(effective support) and existing image_input_mode string/sqlite fields. Add health[\\\"image_fallback\\\"]={\\\"fallback_enabled\\\":bool,\\\"input_enabled\\\":bool,\\\"mode\\\":\\\"universal\\\"|\\\"strict\\\",\\\"acceptance\\\":\\\"optimistic\\\"|\\\"proof-gated\\\"|\\\"text-only\\\",\\\"method\\\":\\\"workspace-read\\\",\\\"limits\\\":copy of IMAGE_LIMITS,\\\"models\\\":[effective supported catalog IDs]}. Same object on /v1/models. acceptance=text-only iff universal and input disabled, otherwise optimistic iff universal, else proof-gated. Brief suggestion health[\\\"images\\\"][\\\"fallback_enabled\\\"] is inapplicable to actual bool schema.\",\n        \"log_contract\": {\n          \"event\": \"image_fallback\",\n          \"template\": \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\",\n          \"stages\": [\n            \"collect\",\n            \"post_slot\",\n            \"spool\",\n            \"runtime\"\n          ],\n          \"attempts\": \"collect/post_slot/spool =>1 upcoming attempt; runtime=>1 failed attached attempt\",\n          \"reason\": \"flag_disabled; ImageReject.reason; image_spool_error; unsupported_media; runtime state token\",\n          \"sanitizer\": \"Introduce _log_token(value,max_len=64): only ASCII identifier chars A-Za-z0-9_.- survive, all others _, length capped64; empty->unknown. Stage from finite allowlist, model validated catalog, reason/state sanitized. Counts coerced bounded integers; code if extra uses same sanitizer.\",\n          \"sink\": \"HEAD uses _log(str) -> stderr + _mask_secrets; no log.info object exists. Preserve native sink and emit exact formatted event via _log helper (semantically INFO), no new logger dependency. If log.info introduced locally, it MUST route through same masking/sink; no requirement to rewire logging.\",\n          \"never\": [\n            \"auth keys\",\n            \"base64 payload\",\n            \"URLs\",\n            \"prompts\",\n            \"file paths\",\n            \"raw exception repr\"\n          ],\n          \"frequency\": \"Exactly one event per actual downgrade transition, no fallback event for strict path/pure-text or simply omitted audio beside valid raster. Strict reject/proof logs unchanged.\"\n        }\n      }\n    },\n    {\n      \"id\": \"AD-005\",\n      \"title\": \"Test Suite Append-Only Architecture uf01..uf10\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"How to prove new policy and retry contracts without weakening strict coverage?\",\n      \"choice\": \"Append UniversalImageFallbackTests at EOF, retaining entire baseline file bytes. Use import discovery, true raster fixtures and local flag patches; freeze assertion, execution and full suite commands independently.\",\n      \"alternatives\": [\n        \"Edit legacy _ImgEnv/_Fixture/tests to expect universal behavior: rejected, changes frozen strict baseline.\",\n        \"AST ID presence only: rejected, not evidence of behavior execution.\"\n      ],\n      \"drivers\": [\n        \"REQ-04\",\n        \"AC-01\",\n        \"AC-02\",\n        \"SCN-uf01\",\n        \"SCN-uf10\",\n        \"SCN-B01\",\n        \"SCN-B02\",\n        \"SCN-R01\",\n        \"SCN-R02\",\n        \"SCN-I01\"\n      ],\n      \"consequences\": [\n        \"Existing __main__ guard remains; direct python tests/file.py would miss appended classes, so VER003/005 use import/discovery.\",\n        \"No suite-wide environment override enables universal.\",\n        \"Red regressions before product fix, then green full legacy+universal execution; future tests are not executed or claimed Stage2.\"\n      ],\n      \"approval_required\": false,\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n        \"expected\": \"Independent execution VER003 plus VER-001, VER-002, VER-003, VER-004, VER-005, VER-006, VER-007, VER-008 must pass after implementation.\"\n      },\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\",\n        \"VER-003\",\n        \"VER-004\",\n        \"VER-005\",\n        \"VER-006\",\n        \"VER-007\",\n        \"VER-008\"\n      ],\n      \"details\": {\n        \"prefix\": {\n          \"path\": \"tests/test_agy_bridge_resilience.py\",\n          \"bytes\": 249933,\n          \"sha256\": \"f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5\",\n          \"deleted_lines_allowed\": 0,\n          \"preserve\": \"Entire BASE blob is a prefix; additions strictly after byte249933. This includes all old tests/helpers/__main__, stronger than a diff numstat check.\"\n        },\n        \"new_class\": \"UniversalImageFallbackTests(unittest.TestCase)\",\n        \"test_methods\": [\n          {\n            \"name\": \"test_uf01_all_catalog_models_and_efforts_optimistic\",\n            \"scenarios\": [\n              \"SCN-uf01\",\n              \"SCN-B01\"\n            ],\n            \"assertions\": \"Every catalog model x declared effort, true raster PNG/JPEG/GIF/WebP fixture; runtime proof/SHA/status/efforts_proven corrupted or absent without startup schema violation; no strict gate invocation, attachment/files/add-dir attempt1 and real successful JSON/SSE. Catalog negatives remain ingress errors.\"\n          },\n          {\n            \"name\": \"test_uf02_image_rejections_strip_all_media\",\n            \"scenarios\": [\n              \"SCN-uf02\",\n              \"SCN-B01\",\n              \"SCN-B02\"\n            ],\n            \"assertions\": \"Whole taxonomy incl malformed alias/dict content, MIME/base64/magic/roles/16vs17/size cap±1, mixed invalid+valid image; one stripped run/no partial staging/no fetch; media failure no400; auth/JSON/body413/model/effort/admission503 retain errors.\"\n          },\n          {\n            \"name\": \"test_uf03_policy_matrix_recheck_and_cache\",\n            \"scenarios\": [\n              \"SCN-uf03\"\n            ],\n            \"assertions\": \"Four policy states, missing/false/malformed/string/int/null/oversize config; env token map, TTL boundary, reset; input flip while queued strips before mkdir/Run, SHA flip ignored universal; rollback/re-enable without restart and slots restored.\"\n          },\n          {\n            \"name\": \"test_uf04_spool_failures_downgrade_before_attempt1\",\n            \"scenarios\": [\n              \"SCN-uf04\",\n              \"SCN-R02\"\n            ],\n            \"assertions\": \"mkdir/EACCES/ENOSPC/second-file/O_EXCL errors, registry and actual partial cleanup; one text constructor, no attach; unsafe permissions never broaden; cleanup-error branch accurately logged and not reattached.\"\n          },\n          {\n            \"name\": \"test_uf05_runtime_retry_cold_text_with_empty_budget\",\n            \"scenarios\": [\n              \"SCN-uf05\",\n              \"SCN-R01\"\n            ],\n            \"assertions\": \"Each eligible agy/pump/timeout/idle/first-token state with zero/30 tenths; two runs only, immediate file cleanup before second constructor, add_dir=None, both prompts stripped, jitter invoked and tokens consumed only if available. Second failure truthful, done excluded, no third.\"\n          },\n          {\n            \"name\": \"test_uf06_hot_and_explicit_cid_cold_reset\",\n            \"scenarios\": [\n              \"SCN-uf06\",\n              \"SCN-R02\"\n            ],\n            \"assertions\": \"Three-turn tools history, early hot agy_error must hit media guard before hot continue; CAS invalidate matching CID only, release(cid,turn_id), no resume on retry; postslot/spool/collect also cold after media removal; next history turn works.\"\n          },\n          {\n            \"name\": \"test_uf07_media_normalization_is_complete\",\n            \"scenarios\": [\n              \"SCN-uf07\",\n              \"SCN-I01\"\n            ],\n            \"assertions\": \"All specified media types+keys incl snake_case and video_url, dict and list content, media.text taint, unknown dict not serialized; mixed raster/audio optimistic retains raster only; media-only placeholders nonempty; original input unchanged.\"\n          },\n          {\n            \"name\": \"test_uf08_delivery_and_non_media_failures_do_not_replay\",\n            \"scenarios\": [\n              \"SCN-uf08\"\n            ],\n            \"assertions\": \"Delivered text/tool_calls/SSE reasoning/client_gone ->one run cleanup; JSON buffered reasoning/empty SSE delta allow guarded retry; done badrc/empty output no image retry; missing launcher/OSError no double headers/fake success.\"\n          },\n          {\n            \"name\": \"test_uf09_full_history_idempotency_and_reentry\",\n            \"scenarios\": [\n              \"SCN-uf09\",\n              \"SCN-I01\"\n            ],\n            \"assertions\": \"Normalization fixed point, exact role/text/Unicode/order/ordinary URL preservation, old images/latest-image-only/no-assistant/history hot↔cold, both prompts no generated attachments/imageN/base64. Next request re-evaluates policy, no permanent deny.\"\n          },\n          {\n            \"name\": \"test_uf10_observability_isolation_and_lifecycle\",\n            \"scenarios\": [\n              \"SCN-uf10\",\n              \"SCN-R01\",\n              \"SCN-R02\"\n            ],\n            \"assertions\": \"strict→universal→strict and reverse; bool capabilities+additive policy fields and no fake fleet proof; safe logs counts/stages/no secrets; two simultaneous distinct requests, same-key CAS replacement, active sweep, cancellation/repeated fallbacks restore slots/dirs/FD/children. Production receipt only release VER010, no unit claim.\"\n          }\n        ],\n        \"fixture_policy\": \"New helpers/classes are appended ONLY; use _ImgEnv then write BOTH config keys because env.flag rewrites file. Context-managed env patch/new cache reset restores state. No process-wide fallback env in test execution. Use actual small decodable raster corpus embedded as fixtures; no Pillow/new dependency; existing magic-only strict fixtures unchanged.\",\n        \"counts\": \"Baseline146 methods total,46 image-related (36 Image*+10 AcceptanceOracleTests), inherited VER007 IDs40 because duplicate log01 and5 f-methods are not represented by those40. Preserve all146 methods and execute full project suite.\",\n        \"boundaries\": \"Use small patched caps for individual/total boundary corpus, but real HTTP body/admission boundary tests remain; no gratuitous16x20MiB allocation.\",\n        \"red_green\": \"Coder first appends regression tests and records failing universal assertions against BASE, then fixes server only. Existing tests may not be edited for lint/type/format convenience.\"\n      }\n    }\n  ],\n  \"quality_scenarios\": [\n    {\n      \"id\": \"QA-001\",\n      \"quality\": \"reliability\",\n      \"source\": \"DSH client / release owner\",\n      \"stimulus\": \"media validation, spool or attached CLI fails\",\n      \"environment\": \"local fake and existing owner DSH chat\",\n      \"artifact\": \"do_POST/_run_once\",\n      \"response\": \"clean downgrade and real text attempt\",\n      \"response_measure\": \"eligible runtime exactly2 runs; pre-stage exactly1 text run; never add-dir on downgrade\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"QA-002\",\n      \"quality\": \"compatibility\",\n      \"source\": \"DSH client / release owner\",\n      \"stimulus\": \"fallback policy absent or false\",\n      \"environment\": \"same process strict/universal ordering\",\n      \"artifact\": \"strict image path and fleet\",\n      \"response\": \"preserve all legacy behavior\",\n      \"response_measure\": \"146 baseline tests remain,46 image tests pass,0 deleted lines and exact249933byte prefix\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-005\",\n        \"VER-006\",\n        \"VER-008\"\n      ]\n    },\n    {\n      