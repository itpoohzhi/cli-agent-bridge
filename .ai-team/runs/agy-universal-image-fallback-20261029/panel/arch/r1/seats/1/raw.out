h.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n38\t      \"expected\": \">=56 tests: all 46 legacy image-related methods plus UniversalImageFallbackTests uf01..uf10 execute and pass; not AST-only\",\n39\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n40\t      \"owner\": \"Verifier\"\n41\t    },\n42\t    {\n43\t      \"id\": \"VER-004\",\n44\t      \"requirement_ids\": [\n45\t        \"REQ-04\"\n46\t      ],\n47\t      \"kind\": \"command\",\n48\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import collections, io, json, subprocess, tarfile, tempfile\\nfrom pathlib import Path\\nroot=Path.cwd(); temp_base_dir=Path.home()/\\\"work/tmp\\\"; temp_base_dir.mkdir(parents=True,exist_ok=True)\\nargs=[\\\"uvx\\\",\\\"basedpyright@1.40.2\\\",\\\"--outputjson\\\",\\\"bridges/agy-bridge/server.py\\\",\\\"tests/test_agy_bridge_resilience.py\\\"]\\ndef diagnostics(cwd):\\n r=subprocess.run(args,cwd=cwd,capture_output=True,text=True)\\n assert r.returncode in (0,1),(r.returncode,r.stderr)\\n d=json.loads(r.stdout); assert \\\"generalDiagnostics\\\" in d,d\\n c=collections.Counter()\\n for x in d[\\\"generalDiagnostics\\\"]:\\n  f=str(Path(x[\\\"file\\\"]).relative_to(cwd)); c[(f,x.get(\\\"severity\\\"),x.get(\\\"rule\\\"),x[\\\"message\\\"])]+=1\\n return c\\nwith tempfile.TemporaryDirectory(prefix=\\\"agy-type-baseline-\\\",dir=temp_base_dir) as tmp:\\n old=Path(tmp); archive=subprocess.check_output([\\\"git\\\",\\\"archive\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'])\\n with tarfile.open(fileobj=io.BytesIO(archive)) as tf: tf.extractall(old,filter=\\\"data\\\")\\n before=diagnostics(old); after=diagnostics(root); delta=after-before\\n assert not delta,dict(delta)\\n print(\\\"TYPECHECK_NO_NEW_DIAGNOSTICS_PASS\\\",\\\"baseline\\\",sum(before.values()),\\\"candidate\\\",sum(after.values()))'\",\n49\t      \"expected\": \"same pinned basedpyright executable checks archived BASE and candidate; exact multiset file/severity/rule/message delta is empty; inherited diagnostics recorded, no baseline suppression\",\n50\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n51\t      \"owner\": \"Verifier\"\n52\t    },\n53\t    {\n54\t      \"id\": \"VER-005\",\n55\t      \"requirement_ids\": [\n56\t        \"REQ-01\",\n57\t        \"REQ-02\",\n58\t        \"REQ-03\",\n59\t        \"REQ-04\",\n60\t        \"REQ-05\",\n61\t        \"REQ-06\"\n62\t      ],\n63\t      \"kind\": \"command\",\n64\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider\",\n65\t      \"expected\": \"exit 0; full repository suite including all agy/strict tests. No pyproject.toml exists; use pinned uvx, do not invent uv run project config.\",\n66\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n67\t      \"owner\": \"Verifier\"\n68\t    },\n69\t    {\n70\t      \"id\": \"VER-006\",\n71\t      \"requirement_ids\": [\n72\t        \"REQ-04\"\n73\t      ],\n74\t      \"kind\": \"command\",\n75\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\np='\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'; old=subprocess.check_output([\\\"git\\\",\\\"show\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'+\\\":\\\"+p]); new=Path(p).read_bytes()\\nassert len(old)==249933 and hashlib.sha256(old).hexdigest()=='\\\"'\\\"'f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5'\\\"'\\\"'\\nassert new[:len(old)]==old, \\\"Baseline prefix changed\\\"\\nfor b in ['\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"','\\\"'\\\"'5a19559426de7508d525e2bd465eff648665a6a7'\\\"'\\\"']:\\n rows=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--numstat\\\",b,\\\"--\\\",p],text=True).splitlines()\\n assert all(row.split()[1]==\\\"0\\\" for row in rows), rows\\nsubprocess.run([\\\"python3\\\",\\\"-B\\\",\\\"-m\\\",\\\"unittest\\\",\\\"discover\\\",\\\"-s\\\",\\\"tests\\\",\\\"-p\\\",\\\"test_images_strict.py\\\",\\\"-q\\\"],check=True)\\nprint(\\\"APPEND_ONLY_STRICT_PASS\\\",len(old))'\",\n76\t      \"expected\": \"whole baseline blob is exact prefix; 0 deleted lines against both baselines; test_images_strict.py executes successfully\",\n77\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n78\t      \"owner\": \"Teamlead\"\n79\t    },\n80\t    {\n81\t      \"id\": \"VER-007\",\n82\t      \"requirement_ids\": [\n83\t        \"REQ-01\",\n84\t        \"REQ-02\",\n85\t        \"REQ-03\",\n86\t        \"REQ-04\",\n87\t        \"REQ-06\"\n88\t      ],\n89\t      \"kind\": \"command\",\n90\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast, re\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"tests/test_agy_bridge_resilience.py\\\").read_text())\\nexpected={f\\\"{p}{i:02}\\\" for p,n in [(\\\"img\\\",10),(\\\"hist\\\",10),(\\\"life\\\",5),(\\\"log\\\",2),(\\\"res\\\",3),(\\\"ao\\\",10),(\\\"uf\\\",10)] for i in range(1,n+1)}\\nfound=set(); uf=set()\\nfor f in ast.walk(t):\\n if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith(\\\"test_\\\") and any(isinstance(a,ast.Assert) or isinstance(a,ast.Call) and isinstance(a.func,ast.Attribute) and isinstance(a.func.value,ast.Name) and a.func.value.id==\\\"self\\\" and a.func.attr.startswith(\\\"assert\\\") for a in ast.walk(f)):\\n  ids={k for k in expected if re.search(r\\\"(?:^|_)\\\"+k+r\\\"(?:_|$)\\\",f.name)}; found.update(ids)\\nfor c in t.body:\\n if isinstance(c,ast.ClassDef) and c.name==\\\"UniversalImageFallbackTests\\\":\\n  assert c.lineno>6008, c.lineno\\n  uf={f\\\"uf{i:02}\\\" for f in c.body if isinstance(f,ast.FunctionDef) for i in range(1,11) if re.match(f\\\"test_uf{i:02}_\\\",f.name)}\\nassert not expected-found, sorted(expected-found)\\nassert uf=={f\\\"uf{i:02}\\\" for i in range(1,11)},uf\\nprint(\\\"QA_ASSERT_COVERAGE_PASS\\\",len(expected))'\",\n91\t      \"expected\": \"all 40 inherited QA IDs + uf01..uf10 have assertion-bearing test methods; appended UniversalImageFallbackTests exists; execution independently VER003/005\",\n92\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n93\t      \"owner\": \"Teamlead\"\n94\t    },\n95\t    {\n96\t      \"id\": \"VER-008\",\n97\t      \"requirement_ids\": [\n98\t        \"REQ-01\",\n99\t        \"REQ-02\",\n100\t        \"REQ-03\",\n101\t        \"REQ-04\",\n102\t        \"REQ-05\",\n103\t        \"REQ-06\"\n104\t      ],\n105\t      \"kind\": \"command\",\n106\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\nbase='\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'; allowed={'\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"','\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'}\\npaths=set(subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--name-only\\\",base,\\\"--\\\"],text=True).splitlines())|set(subprocess.check_output([\\\"git\\\",\\\"ls-files\\\",\\\"--others\\\",\\\"--exclude-standard\\\"],text=True).splitlines())\\npaths={p for p in paths if not p.startswith(\\\".ai-team/runs/\\\") and p not in {'\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/research-plan.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/open-questions.md'\\\"'\\\"'}}\\nassert paths<=allowed,paths-allowed\\nassert Path('\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"').read_bytes()==subprocess.check_output([\\\"git\\\",\\\"show\\\",base+\\\":\\\"+'\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"'])\\nfrozen={'\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"': '\\\"'\\\"'ae5bc560087d180ce4f20333028c5ad472ea772dbccf6a7b82bcb6ce7d8db59f'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"': '\\\"'\\\"'7e5f684041b65986f4ff7c8f05f67e930f497165ce5c26fd74d8ee95df9f92f6'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"': '\\\"'\\\"'6a71c3352f56f012e6c3e406cabad0ebbf43aad5afc325399b767b2753877377'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/o