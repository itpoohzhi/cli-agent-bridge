3\t            try:\n3644\t                _launcher()\n3645\t            except LauncherUnavailable:\n3646\t                self._reject(\n3647\t                    503,\n3648\t                    \"launcher_unavailable\",\n3649\t                    \"canonical launcher is missing or not executable\",\n3650\t                    model_id,\n3651\t                    model_len,\n3652\t                )\n3653\t                return\n3654\t            raw_tools = req.get(\"tools\")\n3655\t            tools = (\n3656\t                [t for t in raw_tools if isinstance(t, dict)]\n3657\t                if isinstance(raw_tools, list)\n3658\t                else []\n3659\t            )\n3660\t            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n3661\t            full_prompt = _messages_to_prompt(messages, images)\n3662\t            extra = (\n3663\t                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n3664\t            )\n3665\t            cwd = str(extra.get(\"cwd\") or \"\")\n3666\t            if len(cwd) > CWD_MAX_LEN:\n3667\t                cwd = \"\"\n3668\t            conversation_id = str(\n3669\t                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n3670\t            )\n3671\t            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n3672\t            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n3673\t            # и не пишут: ни claim, ни commit, ни invalidate.\n3674\t            use_session_store = tools_count > 0\n3675\t            sess_key: tuple[str, str, str] | None = (\n3676\t                (cast(str, model_id), cwd, cast(str, effort))\n3677\t                if use_session_store\n3678\t                else None\n3679\t            )\n3680\t            is_resumed = False\n3681\t            prompt = full_prompt\n3682\t            if conversation_id:\n3683\t                if _cid_acquire(conversation_id, turn_id):\n3684\t                    owned_cid = conversation_id\n3685\t                else:\n3686\t                    # cid занят другим активным ходом: два хода не делят один разговор.\n3687\t                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n3688\t                    conversation_id = \"\"\n3689\t            elif sess_key is not None:\n3690\t                use_cid = _session_claim(sess_key, turn_id)\n3691\t                if use_cid:\n3692\t                    conversation_id = use_cid\n3693\t                    is_resumed = True\n3694\t                    prompt = _get_resumed_turn_prompt(messages, images)\n3695\t            ctx: dict[str, object] = {\n3696\t                \"turn_id\": turn_id,\n3697\t                \"sess_key\": sess_key,\n3698\t                \"hot_resumed\": is_resumed,\n3699\t                \"full_prompt\": full_prompt,\n3700\t                \"model\": model_id,\n3701\t                \"model_len\": model_len,\n3702\t                \"effort\": effort,\n3703\t                \"effort_source\": effort_source,\n3704\t                \"prompt\": prompt,\n3705\t                \"cwd\": cwd,\n3706\t                \"tools_count\": tools_count,\n3707\t                \"conversation_id\": conversation_id,\n3708\t                \"tag\": (\n3709\t                    f\"client={self._client_tag()} \"\n3710\t                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n3711\t                ),\n3712\t                \"stream\": bool(req.get(\"stream\")),\n3713\t                \"images\": images,\n3714\t                \"img_dir\": img_dir,\n3715\t            }\n3716\t            if ctx[\"stream\"]:\n3717\t                self._serve_sse(ctx)\n3718\t            else:\n3719\t                self._serve_json(ctx)\n3720\t        finally:\n3721\t            if use_cid:\n3722\t                with _session_store_lock:\n3723\t                    _in_flight_cids.discard(use_cid)\n3724\t            _cid_release(use_cid or owned_cid, turn_id)\n3725\t            if reserved and budget is not None:\n3726\t                budget.release(reserved)\n3727\t\n3728\t    def _serve_json(self, ctx: dict) -> None:\n3729\t        out = self._run_once(\n3730\t            ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n3731\t        )\n3732\t        if out.get(\"state\") == \"client_gone\":\n3733\t            return\n3734\t        err = self._error_body(out)\n3735\t        if err is not None:\n3736\t            self._send(err[\"code\"], {\"error\": err})\n3737\t            return\n3738\t        usage = out.get(\"usage\") or {}\n3739\t        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}"}]},"parent_tool_use_id":null,"session_id":"f57c395a-b445-4654-9da4-7c261a073f36","uuid":"3023a1a2-865a-4d95-8520-3cfe9bd87e12","timestamp":"2026-10-29T14:38:09.759Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py","content":"                        model_id,\n                        model_len,\n                    )\n                    return\n            else:\n                self._reject(\n                    400,\n                    \"unsupported_reasoning_effort\",\n                    \"reasoning_effort must be a string\",\n                    model_id,\n                    model_len,\n                )\n                return\n            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n                self._reject(\n                    400,\n                    \"unsupported_parameter\",\n                    \"reasoning parameter is not supported\",\n                    model_id,\n                    model_len,\n                )\n                return\n            messages_raw = cast(object, req.get(\"messages\"))\n            messages = (\n                cast(\"list[object]\", messages_raw)\n                if isinstance(messages_raw, list)\n                else []\n            )\n            try:\n                images = _collect_images(\n                    messages, cast(str, model_id), cast(str, effort)\n                )\n            except ImageReject as rejected:\n                _log(\"image_reject detail=%s\" % rejected.reason)\n                self._reject(\n                    400,\n                    rejected.code,\n                    f\"image rejected: {rejected.code}\",\n                    model_id,\n                    model_len,\n                )\n                return\n            img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n            try:\n                _launcher()\n            except LauncherUnavailable:\n                self._reject(\n                    503,\n                    \"launcher_unavailable\",\n                    \"canonical launcher is missing or not executable\",\n                    model_id,\n                    model_len,\n                )\n                return\n            raw_tools = req.get(\"tools\")\n            tools = (\n                [t for t in raw_tools if isinstance(t, dict)]\n                if isinstance(raw_tools, list)\n                else []\n            )\n            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n            full_prompt = _messages_to_prompt(messages, images)\n            extra = (\n                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            )\n            cwd = str(extra.get(\"cwd\") or \"\")\n            if len(cwd) > CWD_MAX_LEN:\n                cwd = \"\"\n            conversation_id = str(\n                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n            )\n            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n            # и не пишут: ни claim, ни commit, ни invalidate.\n            use_session_store = tools_count > 0\n            sess_key: tuple[str, str, str] | None = (\n                (cast(str, model_id), cwd, cast(str, effort))\n                if use_session_store\n                else None\n            )\n            is_resumed = False\n            prompt = full_prompt\n            if conversation_id:\n                if _cid_acquire(conversation_id, turn_id):\n                    owned_cid = conversation_id\n                else:\n                    # cid занят другим активным ходом: два хода не делят один разговор.\n                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n                    conversation_id = \"\"\n            elif sess_key is not None:\n                use_cid = _session_claim(sess_key, turn_id)\n                if use_cid:\n                    conversation_id = use_cid\n                    is_resumed = True\n                    prompt = _get_resumed_turn_prompt(messages, images)\n            ctx: dict[str, object] = {\n                \"turn_id\": turn_id,\n                \"sess_key\": sess_key,\n                \"hot_resumed\": is_resumed,\n                \"full_prompt\": full_prompt,\n                \"model\": model_id,\n                \"model_len\": model_len,\n                \"effort\": effort,\n                \"effort_source\": effort_source,\n                \"prompt\": prompt,\n                \"cwd\": cwd,\n                \"tools_count\": tools_count,\n                \"conversation_id\": conversation_id,\n                \"tag\": (\n                    f\"client={self._client_tag()} \"\n                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n                ),\n                \"stream\": bool(req.get(\"stream\")),\n                \"images\": images,\n                \"img_dir\": img_dir,\n            }\n            if ctx[\"stream\"]:\n                self._serve_sse(ctx)\n            else:\n                self._serve_json(ctx)\n        finally:\n            if use_cid:\n                with _session_store_lock:\n                    _in_flight_cids.discard(use_cid)\n            _cid_release(use_cid or owned_cid, turn_id)\n            if reserved and budget is not None:\n                budget.release(reserved)\n\n    def _serve_json(self, ctx: dict) -> None:\n        out = self._run_once(\n            ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n        )\n        if out.get(\"state\") == \"client_gone\":\n            return\n        err = self._error_body(out)\n        if err is not None:\n            self._send(err[\"code\"], {\"error\": err})\n            return\n        usage = out.get(\"usage\") or {}\n        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}","numLines":140,"startLine":3600,"totalLines":3964}},"tool_result_meta":[{"id":"toolu_01T4eEtypRBJj7x9HE5vzPS3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
