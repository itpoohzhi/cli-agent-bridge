1 покрыты все46 image-related methods | run-guarded -- python3 -m unittest discover -s tests -p test_agy_bridge_resilience.py -k AcceptanceOracleTests -q → Ran10 tests OK; exec session5402 | 2026-10-29\",\n496\t      \"source_id\": \"F-402\"\n497\t    },\n498\t    {\n499\t      \"id\": \"EVD-059\",\n500\t      \"kind\": \"document\",\n501\t      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-403\",\n502\t      \"claim\": \"После анализа server/fleet/test файл не изменены; strict baseline diff по-прежнему2205 added/0 deleted | git diff --exit-code -- bridges/agy-bridge/server.py bridges/agy-bridge/fleet.json tests/test_agy_bridge_resilience.py → exit0; git diff --numstat 5a19559426de7508d525e2bd465eff648665a6a7 -- tests/test_agy_bridge_resilience.py → 2205 0 | 2026-10-29\",\n503\t      \"source_id\": \"F-403\"\n504\t    },\n505\t    {\n506\t      \"id\": \"EVD-060\",\n507\t      \"kind\": \"document\",\n508\t      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-404\",\n509\t      \"claim\": \"Repo defaults: execution slots4, retry capacity3 tokens, credit0.2/request, cost1/retry и jitter cap2s; это default constants, не измеренные production env/throughput | bridges/agy-bridge/server.py:109,181–187,1396–1417 MAX_CONCURRENT/RETRY constants | 2026-10-29\",\n510\t      \"source_id\": \"F-404\"\n511\t    },\n512\t    {\n513\t      \"id\": \"EVD-061\",\n514\t      \"kind\": \"document\",\n515\t      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-405\",\n516\t      \"claim\": \"Repo timeout defaults: queue900s, execution1800s, first event120s; это controller ceilings, не SLA/p99 | bridges/agy-bridge/server.py:110–115 QUEUE_TIMEOUT_S/TIMEOUT_S/FIRST_TOKEN_TIMEOUT_S | 2026-10-29\",\n517\t      \"source_id\": \"F-405\"\n518\t    },\n519\t    {\n520\t      \"id\": \"EVD-100\",\n521\t      \"kind\": \"code\",\n522\t      \"ref\": \"bridges/agy-bridge/server.py:do_GET / _cid_release / Run.__init__ / _run_once; tests/test_agy_bridge_resilience.py:test_ao06_health_has_four_additive_fields_and_keeps_existing_ones\",\n523\t      \"claim\": \"Direct gap checks: health.images is bool, no _log_token or log.info logger exists, _cid_release(cid,turn_id) is owner-safe, no local conv_id in _run_once; Run gets new CLI conversation when conversation_id empty; baseline6008lines/249933bytes.\"\n524\t    }\n525\t  ],\n526\t  \"risk_triggers\": [\n527\t    \"security\",\n528\t    \"trust-boundary\"\n529\t  ],\n530\t  \"assumptions\": [\n531\t    {\n532\t      \"id\": \"ASM-001\",\n533\t      \"source_id\": \"ASSUMP-01\",\n534\t      \"class\": \"continuable\",\n535\t      \"status\": \"ASSUMED\",\n536\t      \"statement\": \"Owner200 requirement is media-safe admission plus a real text attempt, not guaranteed backend availability. Successful text gives200; independent protocol/admission/launcher/second failure remain truthful errors. User direct guard excludes done/client_gone.\",\n537\t      \"evidence_ids\": [\n538\t        \"EVD-100\"\n539\t      ],\n540\t      \"verification_ids\": [\n541\t        \"VER-003\",\n542\t        \"VER-010\"\n543\t      ]\n544\t    },\n545\t    {\n546\t      \"id\": \"ASM-002\",\n547\t      \"source_id\": \"ASSUMP-02\",\n548\t      \"class\": \"continuable\",\n549\t      \"status\": \"ASSUMED\",\n550\t      \"statement\": \"Valid decodable raster describes positive test corpus. Universal safety retains signature-only validation and no pixel decoder/dependency; this is not a proof that every signature-bearing file decodes safely.\",\n551\t      \"evidence_ids\": [\n552\t        \"EVD-100\"\n553\t      ],\n554\t      \"verification_ids\": [\n555\t        \"VER-003\",\n556\t        \"VER-006\"\n557\t      ]\n558\t    }\n559\t  ],\n560\t  \"decisions\": [\n561\t    {\n562\t      \"id\": \"AD-001\",\n563\t      \"title\": \"Universal Policy Flag & Dynamic Config Activation\",\n564\t      \"status\": \"APPROVED\",\n565\t      \"kind\": \"two-way\",\n566\t      \"question\": \"How to enable universal acceptance without changing legacy strict fixtures?\",\n567\t      \"choice\": \"An independent fail-closed IMAGE_FALLBACK_ENABLED controls universal policy; IMAGE_INPUT_ENABLED continues to control staging. Capture universal once per accepted request and recheck input after slot acquisition.\",\n568\t      \"alternatives\": [\n569\t        \"Universal enabled by default: rejected because it breaks strict baseline and res03/hist05/life02.\",\n570\t        \"Reuse IMAGE_INPUT_ENABLED as universal: rejected because _ImgEnv sets only this flag and must remain strict.\"\n571\t      ],\n572\t      \"drivers\": [\n573\t        \"REQ-01\",\n574\t        \"REQ-02\",\n575\t        \"REQ-04\",\n576\t        \"REQ-05\",\n577\t        \"CON-04\",\n578\t        \"INV-01\",\n579\t        \"INV-09\",\n580\t        \"RISK-05\"\n581\t      ],\n582\t      \"consequences\": [\n583\t        \"No fleet mutation or fake proofs.\",\n584\t        \"Rollback universal=false restores strict behavior for new requests; in-flight requests retain captured universal policy.\",\n585\t        \"Input disable propagates on next post-slot check subject to its existing <=1s cache; accepted running CLI is not retroactively cancelled.\"\n586\t      ],\n587\t      \"approval_required\": false,\n588\t      \"confirmation\": {\n589\t        \"kind\": \"test\",\n590\t        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n591\t        \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-010 must pass after implementation.\"\n592\t      },\n593\t      \"verification_ids\": [\n594\t        \"VER-003\",\n595\t        \"VER-006\",\n596\t        \"VER-008\",\n597\t        \"VER-010\"\n598\t      ],\n599\t      \"details\": {\n600\t        \"names\": {\n601\t          \"config\": \"IMAGE_FALLBACK_ENABLED\",\n602\t          \"env\": \"AGY_IMAGE_FALLBACK_ENABLED\",\n603\t          \"reader\": \"_read_image_fallback_flag()\",\n604\t          \"predicate\": \"_is_image_fallback_enabled()\",\n605\t          \"cache\": \"_image_fallback_flag_cache = (0.0, False)\",\n606\t          \"ttl_s\": 1.0\n607\t        },\n608\t        \"reader_contract\": \"Bounded read of DYNAMIC_CONFIG_PATH; reject missing/unreadable/oversize/invalid JSON/non-object; only data.get(\\\"IMAGE_FALLBACK_ENABLED\\\") is True enables. Strings, integers, null and missing key are False. No env parsing inside JSON reader.\",\n609\t        \"env_contract\": \"Read env every predicate call, strip whitespace and lowercase. Nonempty 1/true/yes=>True; 0/false/no=>False; other nonempty token=>False (including on/off for NEW flag). Empty/unset falls through to JSON. Env overrides cache immediately and does not mutate JSON; no production global env export in test runner.\",\n610\t        \"cache_contract\": \"Monotonic TTL<1.0s serves cached config; age>=1.0s rereads; bounded dedicated lock _image_fallback_flag_lock protects tuple. Initialize (0.0,False); reset under that lock inside _reset_sqlite_guards_for_tests(); independent from old input, SHA and SQLite caches. Cold cache always reads current fixture path. Existing _ImgEnv/_Fixture tests need no edits.\",\n611\t        \"policy_matrix\": [\n612\t          {\n613\t            \"universal\": false,\n614\t            \"input_enabled\": false,\n615\t            \"images\": \"legacy strict reject\",\n616\t            \"response\": \"400 image_input_not_supported for image requests; pure text unchanged\"\n617\t          },\n618\t          {\n619\t            \"universal\": false,\n620\t            \"input_enabled\": true,\n621\t            \"images\": \"legacy _image_gate proof/SHA/efforts gate\",\n622\t            \"response\": \"legacy admission/retry same files, all old error outcomes unchanged\"\n623\t          },\n624\t          {\n625\t            \"universal\": true,\n626\t            \"input_enabled\": false,\n627\t            \"images\": \"no staging, strip all media from full history\",\n628\t            \"response\": \"real pure-text attempt1; collect/flag_disabled event; HTTP200 iff text backend succeeds\"\n629\t          },\n630\t          {\n631\t            \"universal\": true,\n632\t            \"input_enabled\": true,\n633\t            \"images\": \"optimistic known catalog + valid effort + all safety checks; no model proof eligibility\",\n634\t            \"response\": \"valid raster attached attempt1; validation/recheck/spool failure strips before attempt1; runtime guard strips before attempt2\"\n635\t          }\n636\t        ],\n637\t        \"universal_gate\": \"_image_gate_universal(model_id,effort) validates catalog membership and declared valid model effort and current input flag; never calls _image_proof_reason/_file_sha256 nor uses images.status/proof/agy_binary_sha256/efforts_proven/formats proof. Unknown model/invalid effort remain ingress400, never rescued by media fallback. Startup fleet schema remains unchanged.\",\n638\t        \"collector_contract\": \"_collect_images(messages,model_id,effort,universal=False): default strict exactly preserves existing path/order/taxonomy. universal=True uses complete media classification, canonical image aliases and _image_gate_universal, then same limits/role/dataURL/base64/MIME/signature checks. No _stage_images before slot. Any ImageReject discards ALL collected entries; no partially valid image subset is sent.\",\n639\t        \"safety_limits\": {\n640\t          \"images_max\": 16,\n641\t          \"per_image_bytes_max\": 20971520,\n642\t          \"total_image_bytes_max\": 20971520,\n643\t          \"http_body_bytes_max\": 33554432,\n644\t          \"allowed_roles\": [\n645\t            \"user\"\n646\t          ],\n647\t          \"mime\": [\n648\t            \"image/png\",\n649\t            \"image/jpeg\",\n650\t            \"image/gif\",\n651\t            \"image/webp\"\n652\t          ],\n653\t          \"encoding\": \"data:<allowed-mime>;base64,<strict-base64>; signature must match declared MIME\",\n654\t          \"remote_reads\": \"forbidden including HTTP(S), file:// and relative paths\",\n655\t          \"proof_is_not_safety\": \"Signature-only validation retained; no new pixel decoder.\"\n656\t        },\n657\t        \"production_activation\": {\n658\t          \"path\": \"~/.dsh/bridges/agy-bridge/dynamic_config.json\",\n659\t          \"required_projection\": {\n660\t            \"IMAGE_INPUT_ENABLED\": true,\n661\t            \"IMAGE_FALLBACK_ENABLED\": true\n662\t          },\n663\t          \"status\": \"PLANNED_NOT_APPLIED_STAGE2\",\n664\t          \"procedure\": \"After architecture and code council acceptance deploy candidate server only, verify unchanged fleet SHA, preserve unrelated config keys and atomically set both strict JSON booleans true in DEPLOYED ROOT. Code replacement needs managed bridge restart; flag toggles reload <=1s without restart. Read back flags and effective capability; then existing owner DSH chat must pass VER010 live scenarios. Never add tracked dynamic_config.json.\",\n665\t          \"owner_override\": \"Current owner explicitly selects local dynamic_config.json plus env override; this is scoped exception to general GigaRC/no-new-env preference, not a claim that GigaRC is integrated.\"\n666\t        }\n667\t      }\n668\t    },\n669\t    {\n670\t      \"id\": \"AD-002\",\n671\t      \"title\": \"Complete Media Normalization & Stripping Contract\",\n672\t      \"status\": \"APPROVED\",\n673\t      \"kind\": \"two-way\",\n674\t      \"question\": \"How to remove media from all history and both prompt representations without payload leakage?\",\n675\t      \"choice\": \"Pure non-mutating content normalization classifies media by type AND payload keys before considering text. Precompute stripped full-history prompt in ctx before any session delta selection.\",\n676\t      \"alternatives\": [\n677\t        \"Set images=[] only: rejected, leaves [image N], full_prompt attachments and old CID.\",\n678\t        \"str(content)/text-first generic renderer: rejected, exposes media dict.text and inline payloads.\"\n679\t      ],\n680\t      \"drivers\": [\n681\t        \"REQ-06\",\n682\t        \"INV-02\",\n683\t        \"INV-03\",\n684\t        \"INV-04\",\n685\t        \"INV-07\",\n686\t        \"AC-04\",\n687\t        \"AC-07\"\n688\t      ],\n689\t      \"consequences\": [\n690\t        \"No in-place edits to caller messages or test fixtures.\",\n691\t        \"Plain textual URLs are preserved verbatim; only structured attachment payloads are removed.\",\n692\t        \"Normal universal raster rendering omits other media, fallback rendering replaces it with stable placeholders.\"\n693\t      ],\n694\t      \"approval_required\": false,\n695\t      \"confirmation\": {\n696\t        \"kind\": \"test\",\n697\t        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n698\t        \"expected\": \"Independent execution VER003 plus VER-003, VER-007, VER-009 must pass after implementation.\"\n699\t      },\n700\t      \"verification_ids\": [\n701\t        \"VER-003\",\n702\t        \"VER-007\",\n703\t        \"VER-009\"\n704\t      ],\n705\t      \"details\": {\n706\t        \"helper_contracts\": {\n707\t          \"_flatten_content_stripped(content)\": \"Return safe string with unchanged ordinary text order and newline joining; None=>empty; recognized image=>[image omitted]; other recognized media=>[media omitted]; unknown dict/object never str(dict).\",\n708\t          \"_strip_media_from_messages(messages)\": \"Return fresh JSON-safe message list with roles/order/name/tool-call protocol metadata preserved, content replaced by safe string, nested content structures copied/normalized without mutation. Do not use copy.deepcopy on hot path: normalization is deep by visiting content recursively once.\",\n709\t          \"_messages_to_stripped_prompt(messages)\": \"Render normalized messages through existing role/tool message envelope with images=[] and no image counter-driven media parts; zero generated [attachments], generated [image N], media paths/URLs/base64. Existing user text is not censored.\"\n710\t        },\n711\t        \"classification_order\": [\n712\t          \"If structured object is image type or has image payload key, emit image placeholder BEFORE looking at text, even type=text plus image_url.\",\n713\t          \"Else if other media type or media payload key, emit media placeholder BEFORE looking at text.\",\n714\t          \"Else known text type/plain text value -> string text only; dict(text) supported only if safe string. Never serialize nested text object.\",\n715\t          \"Lists process entries in order; plain strings pass through; None/numbers/unknown structured objects omitted; unknown object-only message gets [media omitted] to keep safe nonempty context.\"\n716\t        ],\n717\t        \"image_types\": [\n718\t          \"image_url\",\n719\t          \"image\",\n720\t          \"input_image\"\n721\t        ],\n722\t        \"image_payload_keys\": [\n723\t          \"image_url\",\n724\t          \"image\"\n725\t        ],\n726\t        \"other_media_types\": [\n727\t          \"input_audio\",\n728\t          \"audio\",\n729\t          \"video\",\n730\t          \"video_url\",\n731\t          \"file\",\n732\t          \"document\",\n733\t          \"inlineData\",\n734\t          \"inline_data\",\n735\t          \"fileData\",\n736\t          \"file_data\"\n737\t        ],\n738\t        \"other_media_payload_keys\": [\n739\t          \"input_audio\",\n740\t          \"audio\",\n741\t          \"video\",\n742\t          \"video_url\",\n743\t          \"file\",\n744\t          \"document\",\n745\t          \"inlineData\",\n746\t          \"inline_data\",\n747\t          \"fileData\",\n748\t          \"file_data\"\n749\t        ],\n750\t        \"dict_content\": \"Identical handling to list parts: recognized media types/keys win; type=text with safe str text yields that text. Dict is never rendered via str(content).\",\n751\t        \"aliases_for_optimistic_collection\": \"Classify image aliases across list and dict content. Canonicalize on a private normalized copy to type=image_url with image_url={url:...}; URL source is string image_url/image payload or payload.url, including type=input_image with image_url string. Prefer image_url key over image if both; malformed/missing URL is ImageReject -> whole-request stripped fallback, never guessed local/file or raw base64. Preserve original role/msg_index and global image numbering. Type=image_url lacking payload remains an invalid image candidate, not silently dropped.\",\n752\t        \"normal_universal_render\": \"For universal normal/optimistic render only: retain canonical validated raster image references and text; silently omit other media parts, including their text keys, and never serialize unknown dicts. If there are ONLY non-image media/unknown structured parts and no raster, use stripped placeholders and text-only admission (stage=collect reason=unsupported_media). Mixed valid raster + non-image media retains valid raster, excludes non-image media without forcing downgrade.\",\n753\t        \"idempotency\": \"For normalized list N: _strip_media_from_messages(N)==N; repeated normalization yields byte-identical rendered prompt. Placeholder strings are ordinary safe strings: never wrapped/replaced/appended again.\",\n754\t        \"nonempty\": \"Each image/media-only message retains its [image omitted]/[media omitted] marker; never becomes empty and never causes generated Reply with exactly: PONG. Truly empty/non-media requests retain existing behavior.\",\n755\t        \"ctx_contract\": \"Always store ctx[\\\"stripped_full_prompt\\\"]=_messages_to_stripped_prompt(original messages). ctx[\\\"universal_fallback\\\"] is admission snapshot. For any actual downgrade assign BOTH ctx[\\\"prompt\\\"] and ctx[\\\"full_prompt\\\"] from stripped_full_prompt, ctx[\\\"images\\\"]=[], ctx[\\\"img_dir\\\"]=None. Never recompute from original _messages_to_prompt(messages,[]) during downgrade.\",\n756\t        \"resumed_contract\": \"If any current or historical media was stripped, force cold text turn with full stripped history; do not resume dirty explicit or cached CID. This conservative choice is owner-permitted. Normal universal with valid raster may still use existing resumed slice numbering; stripped_full_prompt was computed from the full original history before selecting that slice.\",\n757\t        \"strict_isolation\": \"When universal=False continue existing collector/render paths exactly, including existing strict truncated PNG and same-files retry assertions; new normalizer does not redefine strict inputs.\"\n758\t      }\n759\t    },\n760\t    {\n761\t      \"id\": \"AD-003\",\n762\t      \"title\": \"Three Safe Downgrade Points\",\n763\t      \"status\": \"APPROVED\",\n764\t      \"kind\": \"two-way\",\n765\t      \"question\": \"Where exactly does fallback override strict early exits and retry branches?\",\n766\t      \"choice\": \"Central bounded media-to-text state transition at admission, post-slot/spool, and runtime attempt1, before both legacy retry paths. Keep all response and resource ownership invariants.\",\n767\t      \"alternatives\": [\n768\t        \"Only generic transient retry: rejected, misses timeouts, hot early continue, flag and spool failures.\",\n769\t        \"Always replay same image attachments on failure: rejected by owner text-only fallback contract.\"\n770\t      ],\n771\t      \"drivers\": [\n772\t        \"REQ-02\",\n773\t        \"REQ-03\",\n774\t        \"INV-05\",\n775\t        \"INV-06\",\n776\t        \"INV-07\",\n777\t        \"INV-08\",\n778\t        \"INV-09\",\n779\t        \"INV-11\"\n780\t      ],\n781\t      \"consequences\": [\n782\t        \"Exactly at most2 CLI executions/request; degradation reserve is request-scoped and unavailable to generic retries.\",\n783\t        \"Failures after client delivery, client_gone and state done never trigger this fallback.\",\n784\t        \"External side effects can occur before delivery; no exactly-once promise.\"\n785\t      ],\n786\t      \"approval_required\": false,\n787\t      \"confirmation\": {\n788\t        \"kind\": \"test\",\n789\t        \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n790\t        \"expected\": \"Independent execution VER003 plus VER-003, VER-005, VER-009, VER-010 must pass after implementation.\"\n791\t      },\n792\t      \"verification_ids\": [\n793\t        \"VER-003\",\n794\t        \"VER-005\",\n795\t        \"VER-009\",\n796\t        \"VER-010\"\n797\t      ],\n798\t      \"details\": {\n799\t        \"point1_collect\": {\n800\t          \"when\": \"do_POST after normal auth/body/model/effort validation, before slot, spool or response\",\n801\t          \"logic\": [\n802\t            \"Capture universal flag. Detect structured media throughout history using AD002. Precompute stripped_full_prompt.\",\n803\t            \"universal and media and input_disabled -> log stage=collect reason=flag_disabled, images=[], img_dir=None, use stripped full history as prompt/full_prompt, prohibit resume.\",\n804\t            \"universal and input_enabled -> _collect_images(...,universal=True); any ImageReject -> log stage=collect reason=rejected.reason, code sanitized separately if logged, images=[], img_dir=None; both prompts stripped; prohibit resume; no image-derived HTTP400.\",\n805\t            \"Non-image media without raster -> use markers and pure text as AD002; mixed valid raster/media -> optimistic raster only.\",\n806\t            \"strict -> retain exact existing exception->400 path, reason taxonomy and normal legacy render.\",\n807\t            \"No valid images means do not allocate/spool img_dir. Any preallocated path is only metadata and never passed to Run.\"\n808\t          ]\n809\t        },\n810\t        \"point2_post_slot\": {\n811\t          \"when\": \"_run_once after acquire, before register/mkdir/stage/Run\",\n812\t          \"logic\": [\n813\t            \"If images and universal snapshot true: recheck _is_image_input_enabled ONLY; do not perform strict proof/SHA check. If False, log post_slot/flag_disabled and execute downgrade transition; continue attempt1 as text.\",\n814\t            \"If !universal keep _image_gate recheck and existing image_reject terminal state exactly.\",\n815\t            \"Register only the own actual img_dir under _active_lock before mkdir. _stage_images exception ImageSpoolError in universal -> log spool/image_spool_error; cleanup partial dir and registry, img_registered=False, img_dir=None; downgrade both prompts/CID/images; proceed attempt1 text with add_dir=None.\",\n816\t            \"Strict spool failure remains image_spool_error500/no spawn. No broad catch of programming errors as media fallback.\"\n817\t          ]\n818\t        },\n819\t        \"downgrade_transition_order\": [\n820\t          \"Close any completed Run before deleting files (existing finally run.close). Snapshot old image count, old CID and session key for sanitized event and own CAS invalidation.\",\n821\t          \"Call _cleanup_img_dir(own img_dir) if non-null; unregister under _active_lock using existing helper. Clear local img_dir and images, img_registered=False; ctx images=[], img_dir=None. Cleanup helper is idempotent; no cleanup of another request directory.\",\n822\t          \"For any nonempty old/resume/explicit CID: if sess_key exists, _session_invalidate(sess_key,old_cid) (compare-and-swap); always _cid_release(old_cid,str(ctx.get(\\\"turn_id\\\") or \\\"\\\")) for own claim. Set ctx.hot_resumed=False, ctx.conversation_id=\\\"\\\" and any local resume_conv_id=None. Plain turns with sess_key=None never mutate session store.\",\n823\t          \"The brief conv_id=str(uuid.uuid4()) means allocate a fresh logical conversation if implementation has such local; this HEAD has none. Contract is zero old --resume CID and Run conversation_id=\\\"\\\" so CLI creates NEW conversation, not pass a fabricated resume ID.\",\n824\t          \"Set both ctx.prompt and ctx.full_prompt to ctx.stripped_full_prompt. Keep model/effort/cwd/tool protocol and acquired slot; subsequent Run.add_dir=None.\",\n825\t          \"Commit only successful new text session under existing ownership rules; CAS cannot remove a concurrently replaced store value. Outer do_POST ownership cleanup remains idempotent for already released old CID.\"\n826\t        ],\n827\t        \"point3_runtime\": {\n828\t          \"placement\": \"Immediately after attempt1 _execute returns and run.close() completes, before hot_resumed early continue (baseline3280..3295) AND before transient/_retry_take branch (3297..3310). Existing done break may precede guard because guard excludes done.\",\n829\t          \"guard\": \"attempt==1 AND ctx.universal_fallback AND bool(images) AND img_dir is not None (actually attached Run) AND out.state not in (done,client_gone) AND NOT delivered\",\n830\t          \"delivery\": \"delivered_reasoning=bool(out.get(\\\"delivered_reasoning\\\")) OR bool(ctx.get(\\\"stream\\\") and out.get(\\\"reasoning\\\")); delivered=bool(out.get(\\\"text\\\")) OR bool(out.get(\\\"tool_calls\\\")) OR delivered_reasoning. No delivered_reasoning field exists in this HEAD; do not accidentally ignore already emitted SSE reasoning. JSON buffered reasoning alone is not delivered. Empty role delta/keepalive is not delivery.\",\n831\t          \"actions\": [\n832\t            \"Emit runtime/state sanitized event exactly once, count BEFORE clearing images.\",\n833\t            \"Execute full downgrade transition including immediate cleanup and full history reset before text constructor.\",\n834\t            \"Call _retry_take() exactly once; consume one token if available. If unavailable, consume the one per-request media-degradation reserve; do not decrement global balance below0, replenish global bucket, loop, or fail this text retry.\",\n835\t            \"Always sleep pause=_rng()*RETRY_PAUSE_CAP_S (equivalent to _retry_pause_s(1)); then continue into attempt2, add_dir=None, images=[], no old CID.\",\n836\t            \"No third attempt; failed second text run preserves normal JSON/SSE error. No fallback for state done even nonzero rc/empty text (RISK03), client_gone or any delivered output.\"\n837\t          ]\n838\t        },\n839\t        \"reserve_budget\": {\n840\t          \"capacity\": \"1 fallback token per request ONLY after eligible image-attached attempt1; never reusable and never generic.\",\n841\t          \"maximum\": \"generic+reserve still <=1 retry per request because fixed (1,2) loop. Slot retained across pause/retry; active CLI <=MAX_CONCURRENT (default4), body admission remains unchanged.\",\n842\t          \"owner_override\": \"Owner explicitly requires degradation even when _retry_tenths<RETRY_COST_TENTHS. Therefore generic formula floor(.2*N)+3 is preserved for strict/generic-only traffic, but NOT claimed for universal fallback traffic. Total retries <= min(N, floor(.2*N)+3 + N_media_degradation_reserve). Worst all-image-fail batch reaches2N attempts; RISK08 quota and capacity must be measured before production acceptance.\"\n843\t        },\n844\t        \"exclusions\": \"LauncherUnavailable preflight, constructor OSError before a real attached _execute, auth/framing/invalid model/invalid effort/admission/queue failures remain existing errors; do not synthesize successful text result or emit second HTTP headers. No general Exception catch or transport refactor in this patch.\",\n845\t        \"error_semantics\": \"200 means real text completion success. Failed text retry -> existing502/504/etc JSON or SSE error event+DONE. SSE initial200 alone never proves success. Keep legacy _error_body mapping for done/bad rc/empty text, missing executable, and queue overload.\",\n846\t        \"lifecycle\": \"Cleanup of img_dir/partial spool before downgrade; outer finally releases slot exactly once. If physical deletion fails, report safe cleanup error and NEVER reattach or falsely assert deletion; existing orphan sweep remains recovery. Cancellation/client_gone skips all retries and closes Run/resources.\"\n847\t      }\n848\t    },\n849\t    {\n850\t      \"id\": \"AD-004\",\n851\t      \"title\": \"Observability & Discoverability\",\n852\t      \"status\": \"APPROVED\",\n853\t      \"kind\": \"two-way\",\n854\t      \"question\": \"How to report optimistic support while keeping strict health/models types and proofs intact?\",\n855\t      \"choice\": \"Preserve existing boolean images fields; effective supports=universal&&input_enabled for all catalog models, otherwise strict predicate. Add a separate structured image_fallback object, never replace health.images with a dict.\",\n856\t      \"alternatives\": [\n857\t        \"Rewrite fleet proofs as confirmed: rejected by ao10 and evidence semantics.\",\n858\t        \"Replace /health.images bool with dict: rejected by actual code/test_ao01 type semantics.\"\n859\t      ],\n860\t      \"drivers\": [\n861\t        \"REQ-01\",\n862\t        \"REQ-04\",\n863\t        \"REQ-05\",\n864\t        \"CON-05\",\n865\t        \"INV-10\",\n866\t        \"AC-08\"\n867\t      ],\n868\t      \"consequences\": [\n869\t        \"Optimistic acceptance is distinguished from historical proof.\",\n870\t        \"No fleet.json or old _model_supports_images strict semantics changes.\",\n871\t        \"No auth/payload/prompt/path leakage in new events.\"\n872\t      ],\n873\t      \"approval_required\": false,\n874\t      \"confirmation\": {"}]},"parent_tool_use_id":null,"session_id":"f57c395a-b445-4654-9da4-7c261a073f36","uuid":"344baae4-4950-484e-86bc-3437af47b584","timestamp":"2026-10-29T14:37:56.336Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json","content":"{\n  \"schema_version\": \"1.0\",\n  \"protocol\": \"AP/v1\",\n  \"task_id\": \"agy-universal-image-fallback\",\n  \"run_id\": \"agy-universal-image-fallback-20261029\",\n  \"criticality\": \"S2\",\n  \"profile\": \"python-aisdlc-gcge\",\n  \"status\": \"APPROVED\",\n  \"approval_scope\": \"Author-finalized reversible design and mechanical schema/integrity gate only. No external council verdict, resource acceptance, Coder authorization or production acceptance is implied.\",\n  \"baseline\": {\n    \"branch\": \"feat/agy-universal-image-fallback\",\n    \"commit\": \"012da99905ec27a6133afb4f3e768ff9b4426a8f\",\n    \"test_prefix_bytes\": 249933,\n    \"test_prefix_lines\": 6008,\n    \"test_prefix_sha256\": \"f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5\",\n    \"test_line_discrepancy\": \"Owner specified 1..6009; actual baseline contains 6008 lines. Preserve the ENTIRE 249933-byte blob verbatim, including trailing newline and __main__ guard; append only.\"\n  },\n  \"requirement_ids\": [\n    \"REQ-01\",\n    \"REQ-02\",\n    \"REQ-03\",\n    \"REQ-04\",\n    \"REQ-05\",\n    \"REQ-06\"\n  ],\n  \"requirements\": [\n    {\n      \"id\": \"REQ-01\",\n      \"statement\": \"в universal mode любой **известный каталогу** model/поддерживаемый effort принимает image request без per-model proof/SHA/efforts_proven допуска. Валидные user raster PNG/JPEG/GIF/WebP в пределах лимитов при staging=true идут в attempt1 через img_dir, `--add-dir` и attachments. Источники: постановка; разрыв F-102/F-308.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-007\",\n        \"VER-009\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"REQ-02\",\n      \"statement\": \"ImageReject, включая malformed image content, flag-off, remote/file URLs, non-user role, unsupported MIME/base64/signature/limits, а также ImageSpoolError ведут к text-only turn в universal mode; никаких media-derived400/500 до него. Источники: постановка; F-105/F-118/F-124/F-125.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-005\",\n        \"VER-009\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"REQ-03\",\n      \"statement\": \"если первая реально image-attached попытка вернула state не done/client_gone и delivered=false, до attempt2 убрать media, файлы, прежний CID и hot eligibility. Повтор ровно один, text-only; успешный text turn возвращает обычный200 JSON/успешный SSE. Источники: постановка; F-119..F-123/F-126.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-005\",\n        \"VER-009\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"REQ-04\",\n      \"statement\": \"все существующие строки тестового файла неизменны; только append новых uf-тестов. Strict поведение и fleet/default constants сохраняются. Источники: постановка VER-006/007; F-203..F-218/F-314/F-315.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\",\n        \"VER-003\",\n        \"VER-004\",\n        \"VER-005\",\n        \"VER-006\",\n        \"VER-007\",\n        \"VER-008\"\n      ]\n    },\n    {\n      \"id\": \"REQ-05\",\n      \"statement\": \"universal acceptance и fallback фактически включены в установленном production bridge для всех catalog models. Проверка checkout/config-file или `/health` сама по себе не равна живой приёмке. Источники: постановка; F-301..F-307/F-129.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-008\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"REQ-06\",\n      \"statement\": \"stripping действует на всю историю, включая media-only сообщения, dict-content и non-image media; сохраняет текст, порядок, роли и непустой безопасный запрос. Никаких media payload/URL/path/attachments-инструкций от вложений после downgrade. Источники: постановка; F-104/F-111..F-115/F-312.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-007\",\n        \"VER-009\",\n        \"VER-010\"\n      ]\n    }\n  ],\n  \"evidence\": [\n    {\n      \"id\": \"EVD-001\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-101\",\n      \"claim\": \"Image flag: env имеет приоритет; strict JSON boolean true; default false и TTL 1 s | bridges/agy-bridge/server.py:681–715 _read_image_flag/_is_image_input_enabled | 2026-10-29\",\n      \"source_id\": \"F-101\"\n    },\n    {\n      \"id\": \"EVD-002\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-102\",\n      \"claim\": \"Eligibility требует image input, confirmed/probe, method/proof version, formats, effort и binary SHA; _model_supports_images зависит от flag/proof | bridges/agy-bridge/server.py:718–786 _image_proof_reason/_image_gate | 2026-10-29\",\n      \"source_id\": \"F-102\"\n    },\n    {\n      \"id\": \"EVD-003\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-104\",\n      \"claim\": \"Коллектор обнаруживает только type=image_url в list-content всей истории; прочие media-типы и dict-content не охватываются | bridges/agy-bridge/server.py:789–809 _collect_image_parts | 2026-10-29\",\n      \"source_id\": \"F-104\"\n    },\n    {\n      \"id\": \"EVD-004\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-105\",\n      \"claim\": \"Gate предшествует count/role/URL/MIME/base64/size/signature проверкам; без image_url коллектор возвращает пустой список без gate | bridges/agy-bridge/server.py:835–930 _collect_images | 2026-10-29\",\n      \"source_id\": \"F-105\"\n    },\n    {\n      \"id\": \"EVD-005\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-106\",\n      \"claim\": \"URL кроме data: не читаются/не скачиваются; image_url в non-user role отклоняется | bridges/agy-bridge/server.py:871–881 _collect_images | 2026-10-29\",\n      \"source_id\": \"F-106\"\n    },\n    {\n      \"id\": \"EVD-006\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-107\",\n      \"claim\": \"Sniff проверяет только PNG/JPEG/GIF/WebP magic bytes, не декодируемость пикселей | bridges/agy-bridge/server.py:812–822 _sniff_image_type | 2026-10-29\",\n      \"source_id\": \"F-107\"\n    },\n    {\n      \"id\": \"EVD-007\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-image-fallback/evidence-ledger.md#F-108\",\n      \"claim\": \"Collector не пишет файлы; хранит base64 и пути img-UUID/img-N.ext; размер проверяется до b64decode | bridges/agy-bridge/server.py:830–930 _new_img_dir/_collect_images | 2026-10-29\",\n      \"source_id\": \"F-108\"\n    },\n    {\n      \"id\": \"EVD-008\",\n      \"kind\": \"document\",\n      \"ref\": \"analysis/agy-universal-i