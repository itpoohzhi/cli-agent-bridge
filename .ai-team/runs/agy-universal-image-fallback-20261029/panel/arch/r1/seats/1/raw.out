" in d,d\\n c=collections.Counter()\\n for x in d[\\\"generalDiagnostics\\\"]:\\n  f=str(Path(x[\\\"file\\\"]).relative_to(cwd)); c[(f,x.get(\\\"severity\\\"),x.get(\\\"rule\\\"),x[\\\"message\\\"])]+=1\\n return c\\nwith tempfile.TemporaryDirectory(prefix=\\\"agy-type-baseline-\\\",dir=temp_base_dir) as tmp:\\n old=Path(tmp); archive=subprocess.check_output([\\\"git\\\",\\\"archive\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'])\\n with tarfile.open(fileobj=io.BytesIO(archive)) as tf: tf.extractall(old,filter=\\\"data\\\")\\n before=diagnostics(old); after=diagnostics(root); delta=after-before\\n assert not delta,dict(delta)\\n print(\\\"TYPECHECK_NO_NEW_DIAGNOSTICS_PASS\\\",\\\"baseline\\\",sum(before.values()),\\\"candidate\\\",sum(after.values()))'\",\n      \"expected\": \"same pinned basedpyright executable checks archived BASE and candidate; exact multiset file/severity/rule/message delta is empty; inherited diagnostics recorded, no baseline suppression\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Verifier\"\n    },\n    {\n      \"id\": \"VER-005\",\n      \"requirement_ids\": [\n        \"REQ-01\",\n        \"REQ-02\",\n        \"REQ-03\",\n        \"REQ-04\",\n        \"REQ-05\",\n        \"REQ-06\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider\",\n      \"expected\": \"exit 0; full repository suite including all agy/strict tests. No pyproject.toml exists; use pinned uvx, do not invent uv run project config.\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Verifier\"\n    },\n    {\n      \"id\": \"VER-006\",\n      \"requirement_ids\": [\n        \"REQ-04\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\np='\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'; old=subprocess.check_output([\\\"git\\\",\\\"show\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'+\\\":\\\"+p]); new=Path(p).read_bytes()\\nassert len(old)==249933 and hashlib.sha256(old).hexdigest()=='\\\"'\\\"'f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5'\\\"'\\\"'\\nassert new[:len(old)]==old, \\\"Baseline prefix changed\\\"\\nfor b in ['\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"','\\\"'\\\"'5a19559426de7508d525e2bd465eff648665a6a7'\\\"'\\\"']:\\n rows=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--numstat\\\",b,\\\"--\\\",p],text=True).splitlines()\\n assert all(row.split()[1]==\\\"0\\\" for row in rows), rows\\nsubprocess.run([\\\"python3\\\",\\\"-B\\\",\\\"-m\\\",\\\"unittest\\\",\\\"discover\\\",\\\"-s\\\",\\\"tests\\\",\\\"-p\\\",\\\"test_images_strict.py\\\",\\\"-q\\\"],check=True)\\nprint(\\\"APPEND_ONLY_STRICT_PASS\\\",len(old))'\",\n      \"expected\": \"whole baseline blob is exact prefix; 0 deleted lines against both baselines; test_images_strict.py executes successfully\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Teamlead\"\n    },\n    {\n      \"id\": \"VER-007\",\n      \"requirement_ids\": [\n        \"REQ-01\",\n        \"REQ-02\",\n        \"REQ-03\",\n        \"REQ-04\",\n        \"REQ-06\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast, re\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"tests/test_agy_bridge_resilience.py\\\").read_text())\\nexpected={f\\\"{p}{i:02}\\\" for p,n in [(\\\"img\\\",10),(\\\"hist\\\",10),(\\\"life\\\",5),(\\\"log\\\",2),(\\\"res\\\",3),(\\\"ao\\\",10),(\\\"uf\\\",10)] for i in range(1,n+1)}\\nfound=set(); uf=set()\\nfor f in ast.walk(t):\\n if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith(\\\"test_\\\") and any(isinstance(a,ast.Assert) or isinstance(a,ast.Call) and isinstance(a.func,ast.Attribute) and isinstance(a.func.value,ast.Name) and a.func.value.id==\\\"self\\\" and a.func.attr.startswith(\\\"assert\\\") for a in ast.walk(f)):\\n  ids={k for k in expected if re.search(r\\\"(?:^|_)\\\"+k+r\\\"(?:_|$)\\\",f.name)}; found.update(ids)\\nfor c in t.body:\\n if isinstance(c,ast.ClassDef) and c.name==\\\"UniversalImageFallbackTests\\\":\\n  assert c.lineno>6008, c.lineno\\n  uf={f\\\"uf{i:02}\\\" for f in c.body if isinstance(f,ast.FunctionDef) for i in range(1,11) if re.match(f\\\"test_uf{i:02}_\\\",f.name)}\\nassert not expected-found, sorted(expected-found)\\nassert uf=={f\\\"uf{i:02}\\\" for i in range(1,11)},uf\\nprint(\\\"QA_ASSERT_COVERAGE_PASS\\\",len(expected))'\",\n      \"expected\": \"all 40 inherited QA IDs + uf01..uf10 have assertion-bearing test methods; appended UniversalImageFallbackTests exists; execution independently VER003/005\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Teamlead\"\n    },\n    {\n      \"id\": \"VER-008\",\n      \"requirement_ids\": [\n        \"REQ-01\",\n        \"REQ-02\",\n        \"REQ-03\",\n        \"REQ-04\",\n        \"REQ-05\",\n        \"REQ-06\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\nbase='\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'; allowed={'\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"','\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'}\\npaths=set(subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--name-only\\\",base,\\\"--\\\"],text=True).splitlines())|set(subprocess.check_output([\\\"git\\\",\\\"ls-files\\\",\\\"--others\\\",\\\"--exclude-standard\\\"],text=True).splitlines())\\npaths={p for p in paths if not p.startswith(\\\".ai-team/runs/\\\") and p not in {'\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/research-plan.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/open-questions.md'\\\"'\\\"'}}\\nassert paths<=allowed,paths-allowed\\nassert Path('\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"').read_bytes()==subprocess.check_output([\\\"git\\\",\\\"show\\\",base+\\\":\\\"+'\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"'])\\nfrozen={'\\\"'\\\"'analysis/agy-universal-image-fallback/evidence-ledger.md'\\\"'\\\"': '\\\"'\\\"'ae5bc560087d180ce4f20333028c5ad472ea772dbccf6a7b82bcb6ce7d8db59f'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-architect.md'\\\"'\\\"': '\\\"'\\\"'7e5f684041b65986f4ff7c8f05f67e930f497165ce5c26fd74d8ee95df9f92f6'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/handoff-qa.md'\\\"'\\\"': '\\\"'\\\"'6a71c3352f56f012e6c3e406cabad0ebbf43aad5afc325399b767b2753877377'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/open-questions.md'\\\"'\\\"': '\\\"'\\\"'f4d2914546a192f16993873c1c2d91365a65e93d2dc611963fb5eeb0af2e740e'\\\"'\\\"', '\\\"'\\\"'analysis/agy-universal-image-fallback/research-plan.md'\\\"'\\\"': '\\\"'\\\"'e639555a5c7df5f6f4a9a7876e8902e0ee2989b410f8569e9d640ff3332cf898'\\\"'\\\"'}\\nfor p,h in frozen.items(): assert hashlib.sha256(Path(p).read_bytes()).hexdigest()==h,p\\ntracked=subprocess.check_output([\\\"git\\\",\\\"ls-files\\\"],text=True).splitlines(); assert not any(Path(p).name==\\\"dynamic_config.json\\\" for p in tracked)\\nprint(\\\"SCOPE_FROZEN_PASS\\\")'\",\n      \"expected\": \"only two permitted product paths; fleet byte-identical; all five Stage1 hashes unchanged; production dynamic config not tracked\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Teamlead\"\n    },\n    {\n      \"id\": \"VER-009\",\n      \"requirement_ids\": [\n        \"REQ-01\",\n        \"REQ-02\",\n        \"REQ-03\",\n        \"REQ-06\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast,sys\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"bridges/agy-bridge/server.py\\\").read_text()); funcs={n.name:n for n in ast.walk(t) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}\\nrequired={\\\"_read_image_fallback_flag\\\",\\\"_is_image_fallback_enabled\\\",\\\"_image_gate_universal\\\",\\\"_strip_media_from_messages\\\",\\\"_flatten_content_stripped\\\",\\\"_messages_to_stripped_prompt\\\",\\\"_log_token\\\"}\\nassert required<=funcs.keys(),required-funcs.keys()\\nr=funcs[\\\"_reset_sqlite_guards_for_tests\\\"]\\nassert any(isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id==\\\"_image_fallback_flag_cache\\\" for x in n.targets) and ast.literal_eval(n.value)==(0.0,False) for n in ast.walk(r)),\\\"cache reset\\\"\\nimports={a.name.split(\\\".\\\")[0] for n in ast.walk(t) if isinstance(n,ast.Import) for a in n.names}|{n.module.split(\\\".\\\")[0] for n in ast.walk(t) if isinstance(n,ast.ImportFrom) and n.module}\\nassert imports<=set(sys.stdlib_module_names)|{\\\"core\\\"},imports-set(sys.stdlib_module_names)-{\\\"core\\\"}\\nseen=set(); todo=[n for n in funcs if \\\"image\\\" in n or \\\"media\\\" in n or \\\"stripped\\\" in n]\\nwhile todo:\\n n=todo.pop()\\n if n in seen: continue\\n seen.add(n)\\n for c in ast.walk(funcs[n]):\\n  if isinstance(c,ast.Call):\\n   name=ast.unparse(c.func)\\n   assert not any(x in name for x in [\\\"urlopen\\\",\\\"urlretrieve\\\",\\\"urllib.request\\\",\\\"HTTPConnection\\\",\\\"HTTPSConnection\\\"]),name\\n   if isinstance(c.func,ast.Name) and c.func.id in funcs: todo.append(c.func.id)\\nprint(\\\"STATIC_IMAGE_SECURITY_CONTRACT_PASS\\\")'\",\n      \"expected\": \"named helper/cache reset/static no-fetch boundary passes; actual guard ordering, prompts, delivery, CID and reserve behavior must also pass uf03..uf10 under VER003\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Verifier\"\n    },\n    {\n      \"id\": \"VER-010\",\n      \"requirement_ids\": [\n        \"REQ-01\",\n        \"REQ-02\",\n        \"REQ-03\",\n        \"REQ-05\",\n        \"REQ-06\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib,json\\nfrom pathlib import Path\\nroot=Path.home()/\\\".dsh/bridges/agy-bridge\\\"; cfg=json.loads((root/\\\"dynamic_config.json\\\").read_text())\\nassert cfg.get(\\\"IMAGE_INPUT_ENABLED\\\") is True and cfg.get(\\\"IMAGE_FALLBACK_ENABLED\\\") is True\\nassert hashlib.sha256((root/\\\"server.py\\\").read_bytes()).hexdigest()==hashlib.sha256(Path('\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"').read_bytes()).hexdigest()\\nassert (root/\\\"fleet.json\\\").read_bytes()==Path('\\\"'\\\"'bridges/agy-bridge/fleet.json'\\\"'\\\"').read_bytes()\\nr=json.loads(Path(\\\".ai-team/runs/agy-universal-image-fallback-20261029/teamlead/live-acceptance.json\\\").read_text())\\nassert r[\\\"status\\\"]==\\\"PASS\\\" and r[\\\"existing_owner_chat\\\"] is True\\nassert r[\\\"candidate_server_sha256\\\"]==hashlib.sha256(Path('\\\"'\\\"'bridges/agy-bridge/server.py'\\\"'\\\"').read_bytes()).hexdigest()\\nneeded={\\\"image_then_text_fallback_then_history\\\",\\\"previously_text_only_model\\\",\\\"cold_and_hot\\\",\\\"explicit_cid\\\",\\\"repeat_and_parallel\\\",\\\"sse_completion_no_error\\\",\\\"cleanup_before_retry\\\",\\\"flag_rollback_reload\\\",\\\"resource_profile\\\",\\\"side_effect_safe_failure\\\"}\\nassert needed<=set(r[\\\"scenarios_passed\\\"]),needed-set(r[\\\"scenarios_passed\\\"])\\nassert r[\\\"unverified\\\"]==[] and r[\\\"evidence_refs\\\"] and all(isinstance(x,str) and x for x in r[\\\"evidence_refs\\\"])\\nprint(\\\"LIVE_RELEASE_RECEIPT_PRESENT_CONFIG_AND_HASH_PASS\\\")'\",\n      \"expected\": \"deployed server SHA/fleet pair and both strict JSON booleans true; independently collected same-owner-chat live receipt covers all listed scenarios and resource profile. Receipt presence is NOT itself proof: Teamlead must inspect referenced evidence.\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Teamlead\"\n    }\n  ],\n  \"protected_paths\": [\n    \"bridges/agy-bridge/fleet.json\",\n    \"analysis/agy-universal-image-fallback/\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/architecture/\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/teamlead/verification-surface.json\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/task.json\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/plans/architect-01.json\"\n  ],\n  \"materialization\": [],\n  \"approval\": {\n    \"status\": \"NOT_REQUIRED\",\n    \"decision_ids\": [],\n    \"approved_by\": null,\n    \"evidence_ref\": null\n  },\n  \"independent_review\": {\n    \"required\": false,\n    \"status\": \"PENDING\",\n    \"reviewer\": null,\n    \"evidence_ref\": null,\n    \"scope\": \"S2 schema does not require S3 review. teamlead-with-architect still REQUIRES independent external three-family ARCH_PANEL proof before Coder; none claimed here.\"\n  },\n  \"open_questions\": [],\n  \"deferred\": [\n    \"Product implementation and append-only tests are Coder work after external ARCH_PANEL PASS.\",\n    \"Production deployment/config writes/restart and existing DSH chat live acceptance are release work.\",\n    \"Full pixel decoder and audio/video/document decoders are outside this change.\",\n    \"Unknown production SLA/RPS/quota/memory/CPU/FD numbers are NOT measured or fabricated; resource acceptance remains blocked.\"\n  ],\n  \"source_contracts\": [\n    {\n      \"id\": \"CON-01\",\n      \"baseline\": \"ingress: `POST /v1/chat/completions`, HTTP JSON messages и JSON/SSE output; DSH → agy bridge, владелец локального моста. Auth/header/framing/model/effort/body/admission проверки самостоятельны (F-130). Нет доказанного Idempotency-Key/dedup контракта: повтор CLI не равен exactly-once. Test contour: localhost `_HttpBridge`, fake agy (F-216).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-02\",\n      \"baseline\": \"image input: только user `image_url` data/base64 raster; пределы 16, individual/total20971520 bytes, body33554432 bytes. External URLs не читаются; ссылки не должны попасть в CLI fallback. Rejection taxonomy сохранена в strict mode (F-105/F-106/F-206/F-310).\",\n      \"decision_ids\": [\n        \"AD-001\",\n        \"AD-002\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-03\",\n      \"baseline\": \"egress CLI: argv `--add-dir <dir>` и prompt attachments, рабочий cwd отдельно; stdout JSON events, stderr diagnostics; lifecycle `Run.close` и controller. Состояния/error mapping F-114/F-120/F-123/F-125. Не меняется контракт CLI под универсальное inline media API.\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-04\",\n      \"baseline\": \"local config: путь из resolved server ROOT, strict JSON flag read с TTL1s, env override только существующего input flag; production — отдельные files. `start.sh` config не устанавливает (F-101/F-303/F-306/F-307). Новый policy обязан иметь явные чтение, default, cache reset/reload и rollout/rollback; имя ключа решает архитектор.\",\n      \"decision_ids\": [\n        \"AD-001\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-05\",\n      \"baseline\": \"discoverability: `/v1/models`, `/health` сейчас отражают доказанный допуск, не optimistic attempt (F-129). В strict режиме ответы неизменны. Universal effective capability нельзя выдавать за confirmed proof; модель остаётся под catalog validation. Требуются различимые policy/staging/optimistic-attempt поля либо согласованное расширение semantics без мутации static fleet (F-205).\",\n      \"decision_ids\": [\n        \"AD-004\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-06\",\n      \"baseline\": \"fault boundary: ImageReject и ImageSpoolError fail-open к **санитизированному тексту** только при universal=true. Auth/admission/framing/unknown model/unsupported reasoning effort fail-closed по прежнему контракту. Конфиг/его неверный тип fail-closed к strict policy. CLI missing/offline, timeout текстового повтора и оборванный клиент не становятся фиктивным success (F-125/F-130).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    }\n  ],\n  \"invariants\": [\n    {\n      \"id\": \"INV-01\",\n      \"statement\": \"bypass proof не bypass safety validation. Ни fetch/file://, ни MIME expansion, ни превышение resource limits. Strict path сохраняет прежний signature-only контракт. Valid decodable fixtures обязательны для universal positive tests; полноценное pixel decoding — отдельное решение с ограничениями памяти (F-107/F-217).\",\n      \"decision_ids\": [\n        \"AD-001\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-02\",\n      \"statement\": \"normalized media-free history имеет только разрешённые text parts; classification media выполняется раньше чтения `text`. `image_url`, `image`, `input_image` → `[image omitted]`; `input_audio`, `audio`, `video`, `file`, `document`, `inlineData`, `fileData` → `[media omitted]` либо удаление. Проверять и `type`, и соответствующие payload keys, в том числе dict-content; не использовать `str(media_dict)`. Неизвестный structured block не сериализовать целиком. Обычный текст пользователя с URL не цензурировать как вложение (REQ-06/F-112).\",\n      \"decision_ids\": [\n        \"AD-002\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-03\",\n      \"statement\": \"сбой любого изображения в universal admission убирает **все** media данного запроса/истории, без частичного spool/поднабора. Mixed valid raster + unsupported non-image media: raster допускается к optimistic send, прочее media не передаётся agy и не сериализуется. Если режим уже downgraded, никакие старые media не возвращаются через full_prompt (F-111/F-115).\",\n      \"decision_ids\": [\n        \"AD-002\",\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-04\",\n      \"statement\": \"image fallback должен иметь очищенные prompt **и** full_prompt. Перед runtime retry необходим доступ к очищенной истории/предвычисленному full text prompt: в текущем ctx исходных messages нет (F-124). Простой вызов `_messages_to_prompt(original_messages, [])` оставляет image N (F-111). Media-only → placeholder или существующий непустой safe fallback, без attachments (F-113).\",\n      \"decision_ids\": [\n        \"AD-002\",\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-05\",\n      \"statement\": \"runtime guard в точности: attempt1, фактически передан add_dir и непустые images, state не done/client_gone, delivered=false. Его нужно обработать до **обоих** legacy retry-переходов, включая ранний hot continue (F-121). Timeout/idle/first-token states подпадают под owner guard в universal mode, хотя legacy transient их не повторяет (F-122). Только одна text retry, никогда третья.\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-06\",\n      \"statement\": \"немедленно cleanup зарегистрированного img_dir, затем обнулить local и ctx img_dir/images; повтор с `add_dir=None`. Partial-stage failure также cleanup/registry removal. Сохранить slot на текущий ход, освободить ровно один раз; завершение каждого Run до cleanup (F-109/F-110/F-119).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-07\",\n      \"statement\": \"использовать существующий CAS `_session_invalidate(sess_key,cid)` вместо несуществующего имени из брифа; снять собственный cid claim через `_cid_release`, сбросить hot_resumed/conversation_id и переключить на full **stripped** prompt. Text fallback не должен resume прежний explicit CID, который может сохранять attachment context. Plain turn не меняет чужой store; конкурентно обновлённый CID не инвалидировать (F-116/F-117/F-121).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-08\",\n      \"statement\": \"delivered=text/tool_calls/stream reasoning; initial empty SSE delta и keepalive не означают delivery. После delivery или client_gone retry запрещён, файлы всё равно убрать. JSON reasoning ещё не доставлен и не блокирует downgrade (F-120/F-126).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {","numLines":874,"startLine":875,"totalLines":2586}},"tool_result_meta":[{"id":"toolu_011qarjauP9ubMKTxzqV8DZW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
