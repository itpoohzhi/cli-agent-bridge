   ]\n1205\t    },\n1206\t    {\n1207\t      \"id\": \"BND-004\",\n1208\t      \"component\": \"Retry/session controller\",\n1209\t      \"responsibility\": \"Close Run, guard delivery, reset CID via CAS, bounded reserve\",\n1210\t      \"allowed_dependencies\": [\n1211\t        \"existing Run\",\n1212\t        \"_session_invalidate\",\n1213\t        \"_cid_release(cid,turn_id)\",\n1214\t        \"_retry_take\"\n1215\t      ],\n1216\t      \"forbidden_dependencies\": [\n1217\t        \"third attempt\",\n1218\t        \"resume old explicit CID after stripping\",\n1219\t        \"invalidating concurrently replaced session\"\n1220\t      ],\n1221\t      \"verification_ids\": [\n1222\t        \"VER-003\",\n1223\t        \"VER-008\"\n1224\t      ]\n1225\t    },\n1226\t    {\n1227\t      \"id\": \"BND-005\",\n1228\t      \"component\": \"Observability/config\",\n1229\t      \"responsibility\": \"Expose effective optimistic support while preserving proof evidence\",\n1230\t      \"allowed_dependencies\": [\n1231\t        \"bounded local JSON\",\n1232\t        \"existing masked _log sink\",\n1233\t        \"strict boolean API fields\"\n1234\t      ],\n1235\t      \"forbidden_dependencies\": [\n1236\t        \"fleet mutation\",\n1237\t        \"logging content/paths/auth\",\n1238\t        \"confusing optimistic eligibility with proof\"\n1239\t      ],\n1240\t      \"verification_ids\": [\n1241\t        \"VER-003\",\n1242\t        \"VER-008\"\n1243\t      ]\n1244\t    },\n1245\t    {\n1246\t      \"id\": \"BND-006\",\n1247\t      \"component\": \"Verification/release\",\n1248\t      \"responsibility\": \"Enforce frozen independent tests and paired deployed evidence\",\n1249\t      \"allowed_dependencies\": [\n1250\t        \"VER001..010\",\n1251\t        \"external3family architecture/code councils\"\n1252\t      ],\n1253\t      \"forbidden_dependencies\": [\n1254\t        \"Coder editing verification contract\",\n1255\t        \"Stage2 production write/acceptance claim\"\n12