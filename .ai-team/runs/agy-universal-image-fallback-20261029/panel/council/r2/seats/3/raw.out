{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"task_stream":{"kind":"task","id":"01a18869-a9a9-74b1-b244-b1c96b644730"},"task_id":"01a18869-a9a9-74b1-b244-b1c96b644730","event":{"kind":"output","task_id":"01a18869-a9a9-74b1-b244-b1c96b644730","chunk":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(4089 line(s) above)\n4090|                self._reject(\n4091|                    400,\n4092|                    \"unsupported_reasoning_effort\",\n4093|                    \"reasoning_effort must be a string\",\n4094|                    model_id,\n4095|                    model_len,\n4096|                )\n4097|                return\n4098|            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n4099|                self._reject(\n4100|                    400,\n4101|                    \"unsupported_parameter\",\n4102|                    \"reasoning parameter is not supported\",\n4103|                    model_id,\n4104|                    model_len,\n4105|                )\n4106|                return\n4107|            messages_raw = cast(object, req.get(\"messages\"))\n4108|            messages = (\n4109|                cast(\"list[object]\", messages_raw)\n4110|                if isinstance(messages_raw, list)\n4111|                else []\n4112|            )\n4113|            # Универсальная политика фиксируется один раз на принятый запрос.\n4114|            universal = _is_image_fallback_enabled()\n4115|            images: list[dict[str, object]] = []\n4116|            render_messages: list[object] = messages\n4117|            stripped_full_prompt = \"\"\n4118|            force_cold = False\n4119|            if universal:\n4120|                image_parts, other_media = _media_part_counts(messages)\n4121|                # Всегда нормализуем историю: любой cold/downgrade-путь берёт\n4122|                # промпт только отсюда, а не из legacy `_flatten_content`.\n4123|                stripped_full_prompt = _messages_to_stripped_prompt(messages)\n4124|                if image_parts or other_media:\n4125|                    if not _is_image_input_enabled():\n4126|                        _log_image_fallback(\n4127|                            \"collect\",\n4128|                            \"flag_disabled\",\n4129|                            cast(str, model_id),\n4130|                            1,\n4131|                            image_parts,\n4132|                        )\n4133|                        force_cold = True\n4134|                    else:\n4135|                        try:\n4136|                            images = _collect_images(\n4137|                                messages,\n4138|                                cast(str, model_id),\n4139|                                cast(str, effort),\n4140|                                universal=True,\n4141|                            )\n4142|                        except ImageReject as rejected:\n4143|                            _log_image_fallback(\n4144|                                \"collect\",\n4145|                                rejected.reason,\n4146|                                cast(str, model_id),\n4147|                                1,\n4148|                                image_parts,\n4149|                            )\n4150|                            images = []\n4151|                            force_cold = True\n4152|                        else:\n4153|                            if images:\n4154|                                render_messages = _universal_render_messages(messages)\n4155|                            else:\n4156|                                _log_image_fallback(\n4157|                                    \"collect\",\n4158|                                    \"unsupported_media\",\n4159|                                    cast(str, model_id),\n4160|                                    1,\n4161|                                    other_media,\n4162|                                )\n4163|                                force_cold = True\n4164|            else:\n4165|                try:\n4166|                    images = _collect_images(\n4167|                        messages, cast(str, model_id), cast(str, effort)\n4168|                    )\n4169|                except ImageReject as rejected:\n4170|                    _log(\"image_reject detail=%s\" % rejected.reason)\n4171|                    self._reject(\n4172|                        400,\n4173|                        rejected.code,\n4174|                        f\"image rejected: {rejected.code}\",\n4175|                        model_id,\n4176|                        model_len,\n4177|                    )\n4178|                    return\n4179|            img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n4180|            try:\n4181|                _launcher()\n4182|            except LauncherUnavailable:\n4183|                self._reject(\n4184|                    503,\n4185|                    \"launcher_unavailable\",\n4186|                    \"canonical launcher is missing or not executable\",\n4187|                    model_id,\n4188|                    model_len,\n4189|                )\n4190|                return\n4191|            raw_tools = req.get(\"tools\")\n4192|            tools = (\n4193|                [t for t in raw_tools if isinstance(t, dict)]\n4194|                if isinstance(raw_tools, list)\n4195|                else []\n4196|            )\n4197|            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n4198|            if force_cold:\n4199|                full_prompt = stripped_full_prompt\n4200|            else:\n4201|                full_prompt = _messages_to_prompt(render_messages, images)\n4202|                if universal:\n4203|                    stripped_full_prompt = stripped_full_prompt or full_prompt\n4204|            extra = (\n4205|                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n4206|            )\n4207|            cwd = str(extra.get(\"cwd\") or \"\")\n4208|            if len(cwd) > CWD_MAX_LEN:\n4209|                cwd = \"\"\n4210|            conversation_id = str(\n4211|                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n4212|            )\n4213|            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n4214|            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n4215|            # и не пишут: ни claim, ни commit, ни invalidate.\n4216|            use_session_store = tools_count > 0\n4217|            sess_key: tuple[str, str, str] | None = (\n4218|                (cast(str, model_id), cwd, cast(str, effort))\n4219|                if use_session_store\n4220|                else None\n4221|            )\n4222|            is_resumed = False\n4223|            prompt = full_prompt\n4224|            if force_cold:\n4225|                # Media убраны из истории: «грязный» явный или кэшированный CID\n4226|                # не возобновляем, ход идёт холодным text-only с полной историей.\n4227|                conversation_id = \"\"\n4228|            elif conversation_id:\n4229|                if _cid_acquire(conversation_id, turn_id):\n4230|                    owned_cid = conversation_id\n4231|                else:\n4232|                    # cid занят другим активным ходом: два хода не делят один разговор.\n4233|                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n4234|                    conversation_id = \"\"\n4235|            elif sess_key is not None:\n4236|                use_cid = _session_claim(sess_key, turn_id)\n4237|                if use_cid:\n4238|                    conversation_id = use_cid\n4239|                    is_resumed = True\n4240|                    prompt = _get_resumed_turn_prompt(render_messages, images)\n4241|            ctx: dict[str, object] = {\n4242|                \"turn_id\": turn_id,\n4243|                \"sess_key\": sess_key,\n4244|                \"hot_resumed\": is_resumed,\n4245|                \"full_prompt\": full_prompt,\n4246|                \"model\": model_id,\n4247|                \"model_len\": model_len,\n4248|                \"effort\": effort,\n4249|                \"effort_source\": effort_source,\n4250|                \"prompt\": prompt,\n4251|                \"cwd\": cwd,\n4252|                \"tools_count\": tools_count,\n4253|                \"conversation_id\": conversation_id,\n4254|                \"tag\": (\n4255|                    f\"client={self._client_tag()} \"\n4256|                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n4257|                ),\n4258|                \"stream\": bool(req.get(\"stream\")),\n4259|                \"images\": images,\n4260|                \"img_dir\": img_dir,\n4261|                \"universal_fallback\": universal,\n4262|                \"stripped_full_prompt\": stripped_full_prompt,\n4263|            }\n4264|            if ctx[\"stream\"]:\n4265|                self._serve_sse(ctx)\n4266|            else:\n4267|                self._serve_json(ctx)\n4268|        finally:\n4269|            if use_cid:\n4270|                with _session_store_lock:\n4271|                    _in_flight_cids.discard(use_cid)\n4272|            _cid_release(use_cid or owned_cid, turn_id)\n4273|            if reserved and budget is not None:\n4274|                budget.release(reserved)\n4275|\n4276|    def _serve_json(self, ctx: dict) -> None:\n4277|        out = self._run_once(\n4278|            ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n4279|        )\n4280|        if out.get(\"state\") == \"client_gone\":\n4281|            return\n4282|        err = self._error_body(out)\n4283|        if err is not None:\n4284|            self._send(err[\"code\"], {\"error\": err})\n4285|            return\n4286|        usage = out.get(\"usage\") or {}\n4287|        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n4288|        reasoning = out.get(\"reasoning\") or \"\"\n4289|        if reasoning:\n(more lines below)","final_result":true}}}
