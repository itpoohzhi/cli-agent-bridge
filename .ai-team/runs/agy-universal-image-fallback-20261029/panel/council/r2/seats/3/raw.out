{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f3","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":84,"recorded_at":1780531400000163,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"task_stream":{"kind":"task","id":"01a18868-406f-7d02-917a-16d747812d0c"},"task_id":"01a18868-406f-7d02-917a-16d747812d0c","event":{"kind":"output","task_id":"01a18868-406f-7d02-917a-16d747812d0c","chunk":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/.ai-team/runs/agy-universal-image-fallback-20261029/teamlead/candidate.patch`.\n1|diff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\n2|index f5d7405..1a3817c 100644\n3|--- a/bridges/agy-bridge/server.py\n4|+++ b/bridges/agy-bridge/server.py\n5|@@ -197,6 +197,7 @@ IMAGE_STATUSES = (\"unsupported\", \"unverified\", \"probe\", \"confirmed\")\n6| IMPLEMENTED_METHODS = {\"workspace-read\": 1}\n7| METHOD_IMPL_VERSION = 1\n8| IMAGE_FLAG_NAME = \"IMAGE_INPUT_ENABLED\"\n9|+IMAGE_FALLBACK_FLAG_NAME = \"IMAGE_FALLBACK_ENABLED\"\n10| IMAGE_PROBE = os.environ.get(\"AGY_IMAGE_PROBE\", \"\").strip().lower() in (\n11|     \"1\",\n12|     \"true\",\n13|@@ -261,6 +262,8 @@ _sha_compute_lock = threading.Lock()\n14| _sha_cache: dict[str, tuple[tuple[int, int, int, int], str]] = {}\n15| _image_flag_lock = threading.Lock()\n16| _image_flag_cache: tuple[float, bool] = (0.0, False)\n17|+_image_fallback_flag_lock = threading.Lock()\n18|+_image_fallback_flag_cache: tuple[float, bool] = (0.0, False)\n19| _active_img_dirs: set[str] = set()\n20| \n21| # Токеноподобные последовательности в логах: сам ключ моста и длинные hex/base64.\n22|@@ -520,6 +523,7 @@ _LOG_EVENT_NAMES = frozenset(\n23|         \"image_spool_error\",\n24|         \"image_cleanup_error\",\n25|         \"image_sweep_removed\",\n26|+        \"media-degradation-reserve\",\n27|     }\n28| )\n29| \n30|@@ -786,6 +790,326 @@ def _image_gate(model_id: str, effort: str | None) -> ImageReject | None:\n31|     return ImageReject(\"image_proof_invalid\")\n32| \n33| \n34|+def _read_image_fallback_flag() -> bool:\n35|+    \"\"\"IMAGE_FALLBACK_ENABLED из dynamic_config.json: строго `true`, иначе False.\"\"\"\n36|+    try:\n37|+        path = DYNAMIC_CONFIG_PATH\n38|+        if not path.is_file() or path.stat().st_size > DYNAMIC_CONFIG_MAX_BYTES:\n39|+            return False\n40|+        data = cast(object, json.loads(path.read_text(encoding=\"utf-8\")))\n41|+    except (OSError, ValueError):\n42|+        return False\n43|+    if not isinstance(data, dict):\n44|+        return False\n45|+    return cast(\"dict[str, object]\", data).get(IMAGE_FALLBACK_FLAG_NAME) is True\n46|+\n47|+\n48|+def _is_image_fallback_enabled() -> bool:\n49|+    \"\"\"Универсальная политика image-входа (по умолчанию False = строгий режим).\n50|+\n51|+    Env `AGY_IMAGE_FALLBACK_ENABLED` (непустой) решает сразу: 1|true|yes -> True,\n52|+    любое иное значение (в т. ч. 0|false|no|on|off) -> False. Без env — флаг\n53|+    `IMAGE_FALLBACK_ENABLED` в dynamic_config.json с кэшем TTL 1.0 с и отдельным\n54|+    замком; не-boolean, битый или отсутствующий файл дают False. Не зависит от\n55|+    `IMAGE_INPUT_ENABLED` (он по-прежнему управляет только staging файлов).\n56|+    \"\"\"\n57|+    global _image_fallback_flag_cache\n58|+    env = os.environ.get(\"AGY_IMAGE_FALLBACK_ENABLED\", \"\").strip().lower()\n59|+    if env:\n60|+        return env in (\"1\", \"true\", \"yes\")\n61|+    now = time.monotonic()\n62|+    with _image_fallback_flag_lock:\n63|+        checked_at, cached = _image_fallback_flag_cache\n64|+        if checked_at > 0.0 and now - checked_at < FLAG_TTL_S:\n65|+            return cached\n66|+    value = _read_image_fallback_flag()\n67|+    with _image_fallback_flag_lock:\n68|+        _image_fallback_flag_cache = (now, value)\n69|+    return value\n70|+\n71|+\n72|+def _image_gate_universal(model_id: str, effort: str | None) -> ImageReject | None:\n73|+    \"\"\"Универсальный допуск: staging включён, модель из каталога, effort валиден.\n74|+\n75|+    Per-model proof, SHA бинаря и `efforts_proven` не проверяются и не читаются.\n76|+    \"\"\"\n77|+    if not _is_image_input_enabled():\n78|+        return ImageReject(\"image_input_disabled\")\n79|+    model = FLEET_MODELS.get(model_id)\n80|+    if model is None:\n81|+        return ImageReject(\"model_unknown\")\n82|+    if effort:\n83|+        efforts = model.get(\"efforts\")\n84|+        if not isinstance(efforts, list) or effort not in cast(\"list[object]\", efforts):\n85|+            return ImageReject(\"effort_not_proven\", \"unsupported_reasoning_effort\")\n86|+    return None\n87|+\n88|+\n89|+# ---- Универсальная нормализация медиа (AD-002) ---------------------------------------\n90|+\n91|+_IMAGE_PART_TYPES = frozenset({\"image_url\", \"image\", \"input_image\"})\n92|+_IMAGE_PAYLOAD_KEYS = (\"image_url\", \"image\")\n93|+_MEDIA_PART_NAMES = (\n94|+    \"input_audio\",\n95|+    \"audio\",\n96|+    \"video\",\n97|+    \"video_url\",\n98|+    \"file\",\n99|+    \"document\",\n100|+    \"inlineData\",\n101|+    \"inline_data\",\n102|+    \"fileData\",\n103|+    \"file_data\",\n104|+)\n105|+_MEDIA_PART_TYPES = frozenset(name.lower() for name in _MEDIA_PART_NAMES)\n106|+_TEXT_PART_TYPES = frozenset({\"text\", \"input_text\", \"output_text\"})\n107|+_IMAGE_OMITTED = \"[image omitted]\"\n108|+_MEDIA_OMITTED = \"[media omitted]\"\n109|+_JSON_COPY_MAX_DEPTH = 32\n110|+\n111|+\n112|+def _lower_keys(part: dict[str, object]) -> dict[str, object]:\n113|+    \"\"\"Копия part с ключами в нижнем регистре: `InlineData`/`Image_Url` не обходят классификацию.\"\"\"\n114|+    lowered: dict[str, object] = {}\n115|+    for key, value in part.items():\n116|+        lowered_key = str(key).lower()\n117|+        if lowered_key not in lowered:\n118|+            lowered[lowered_key] = value\n119|+    return lowered\n120|+\n121|+\n122|+def _classify_part(part: dict[str, object]) -> str:\n123|+    \"\"\"'image' | 'media' | 'text' | 'unknown'; медиа определяется ДО чтения `text`.\n124|+\n125|+    `text` с не-строковым значением (dict/list) — структурный payload, не текст.\n126|+    \"\"\"\n127|+    lowered = _lower_keys(part)\n128|+    raw_kind = lowered.get(\"type\")\n129|+    kind = raw_kind.strip().lower() if isinstance(raw_kind, str) else \"\"\n130|+    if kind in _IMAGE_PART_TYPES or any(\n131|+        lowered.get(key) is not None for key in _IMAGE_PAYLOAD_KEYS\n132|+    ):\n133|+        return \"image\"\n134|+    if kind in _MEDIA_PART_TYPES or any(\n135|+        lowered.get(key) is not None for key in _MEDIA_PART_TYPES\n136|+    ):\n137|+        return \"media\"\n138|+    text = lowered.get(\"text\")\n139|+    if kind in _TEXT_PART_TYPES and (text is None or isinstance(text, str)):\n140|+        return \"text\"\n141|+    if not kind and isinstance(text, str):\n142|+        return \"text\"\n143|+    return \"unknown\"\n144|+\n145|+\n146|+def _part_text(part: dict[str, object]) -> str:\n147|+    \"\"\"Текст text-части (`\"\"` для отсутствующего/None); только после `_classify_part == 'text'`.\"\"\"\n148|+    value = _lower_keys(part).get(\"text\")\n149|+    return value if isinstance(value, str) else \"\"\n150|+\n151|+\n152|+def _content_items(content: object) -> list[object]:\n153|+    \"\"\"Части контента: list как есть, dict-content — одна часть, прочее — пусто.\"\"\"\n154|+    if isinstance(content, list):\n155|+        return cast(\"list[object]\", content)\n156|+    if isinstance(content, dict):\n157|+        return [content]\n158|+    return []\n159|+\n160|+\n161|+def _image_part_canonical(part: dict[str, object]) -> dict[str, object]:\n162|+    \"\"\"Image-алиас в форме `image_url`; `image_url` приоритетнее `image`, URL не угадывается.\"\"\"\n163|+    lowered = _lower_keys(part)\n164|+    payload = lowered.get(\"image_url\")\n165|+    if payload is None:\n166|+        payload = lowered.get(\"image\")\n167|+    url: object = None\n168|+    if isinstance(payload, str):\n169|+        url = payload\n170|+    elif isinstance(payload, dict):\n171|+        url = cast(\"dict[str, object]\", payload).get(\"url\")\n172|+    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n173|+\n174|+\n175|+def _media_part_counts(messages: object) -> tuple[int, int]:\n176|+    \"\"\"(image-частей, прочих media/неизвестных структурных частей) во всей истории.\n177|+\n178|+    dict-content считается одной частью (`_content_items`); не-text часть любого вида\n179|+    попадает в счёт, чтобы нормализация не обходилась неизвестным payload.\n180|+    \"\"\"\n181|+    images = 0\n182|+    other = 0\n183|+    if not isinstance(messages, list):\n184|+        return images, other\n185|+    for msg in cast(\"list[object]\", messages):\n186|+        if not isinstance(msg, dict):\n187|+            continue\n188|+        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n189|+            if not isinstance(item, dict):\n190|+                continue\n191|+            kind = _classify_part(cast(\"dict[str, object]\", item))\n192|+            if kind == \"image\":\n193|+                images += 1\n194|+            elif kind != \"text\":\n195|+                other += 1\n196|+    return images, other\n197|+\n198|+\n199|+def _collect_image_parts_universal(\n200|+    messages: object,\n201|+) -> list[tuple[int, int, dict[str, object]]]:\n202|+    \"\"\"Все image-части истории (любой алиас, list и dict-content) в форме `image_url`.\"\"\"\n203|+    found: list[tuple[int, int, dict[str, object]]] = []\n204|+    if not isinstance(messages, list):\n205|+        return found\n206|+    number = 0\n207|+    for msg_index, msg in enumerate(cast(\"list[object]\", messages)):\n208|+        if not isinstance(msg, dict):\n209|+            continue\n210|+        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n211|+            if not isinstance(item, dict):\n212|+                continue\n213|+            part = cast(\"dict[str, object]\", item)\n214|+            if _classify_part(part) == \"image\":\n215|+                number += 1\n216|+                found.append((msg_index, number, _image_part_canonical(part)))\n217|+    return found\n218|+\n219|+\n220|+def _json_copy(value: object, depth: int = 0) -> object:\n221|+    \"\"\"Копия JSON-значения без разделяемых контейнеров (глубина ограничена).\"\"\"\n222|+    if depth > _JSON_COPY_MAX_DEPTH:\n223|+        return None\n224|+    if isinstance(value, dict):\n225|+        return {\n226|+            str(k): _json_copy(v, depth + 1)\n227|+            for k, v in cast(\"dict[object, object]\", value).items()\n228|+        }\n229|+    if isinstance(value, list):\n230|+        return [_json_copy(v, depth + 1) for v in cast(\"list[object]\", value)]\n231|+    if value is None or isinstance(value, (str, int, float, bool)):\n232|+        return value\n233|+    return str(value)\n234|+\n235|+\n236|+def _flatten_content_stripped(content: object) -> str:\n237|+    \"\"\"Контент в безопасный текст без media: image -> `[image omitted]`, media -> `[media omitted]`.\n238|+\n239|+    Обычный текст сохраняется в порядке следования (склейка `\\\\n`), неизвестные\n240|+    структурные объекты не сериализуются; сообщение только из них даёт\n241|+    `[media omitted]`, чтобы контекст не стал пустым.\n242|+    \"\"\"\n243|+    if content is None:\n244|+        return \"\"\n245|+    if isinstance(content, str):\n246|+        return content\n247|+    parts: list[str] = []\n248|+    dropped = False\n249|+    for item in _content_items(content):\n250|+        if isinstance(item, str):\n251|+            parts.append(item)\n252|+        elif isinstance(item, dict):\n253|+            part = cast(\"dict[str, object]\", item)\n254|+            kind = _classify_part(part)\n255|+            if kind == \"image\":\n256|+                parts.append(_IMAGE_OMITTED)\n257|+            elif kind == \"media\":\n258|+                parts.append(_MEDIA_OMITTED)\n259|+            elif kind == \"text\":\n260|+                parts.append(_part_text(part))\n261|+            else:\n262|+                dropped = True\n263|+        elif isinstance(item, list):\n264|+            dropped = True\n265|+    if not parts and dropped:\n266|+        parts.append(_MEDIA_OMITTED)\n267|+    return \"\\n\".join(p for p in parts if p)\n268|+\n269|+\n270|+def _strip_media_from_messages(messages: object) -> list[dict[str, object]]:\n271|+    \"\"\"Новый список сообщений без media; вход не мутируется, роли и порядок сохранены.\"\"\"\n272|+    out: list[dict[str, object]] = []\n273|+    if not isinstance(messages, list):\n274|+        return out\n275|+    for msg in cast(\"list[object]\", messages):\n276|+        if not isinstance(msg, dict):\n277|+            continue\n278|+        fresh: dict[str, object] = {}\n279|+        for key, value in cast(\"dict[object, object]\", msg).items():\n280|+            if key == \"content\":\n281|+                fresh[\"content\"] = _flatten_content_stripped(value)\n282|+            else:\n283|+                fresh[str(key)] = _json_copy(value)\n284|+        out.append(fresh)\n285|+    return out\n286|+\n287|+\n288|+def _messages_to_stripped_prompt(messages: object) -> str:\n289|+    \"\"\"Промпт всей истории без media: нет `[image N]`, `[attachments]`, путей и payload.\"\"\"\n290|+    return _messages_to_prompt(\n291|+        cast(\"list[object]\", _strip_media_from_messages(messages))\n292|+    )\n293|+\n294|+\n295|+def _universal_render_messages(messages: object) -> list[object]:\n296|+    \"\"\"Копия истории для оптимистичной отправки: image — каноничные, прочее media — вон.\n297|+\n298|+    Длина и индексы сохранены (нужны сквозной нумерации `[image N]` и resume-срезу).\n299|+    \"\"\"\n300|+    out: list[object] = []\n301|+    if not isinstance(messages, list):\n302|+        return out\n303|+    for msg in cast(\"list[object]\", messages):\n304|+        if not isinstance(msg, dict):\n305|+            out.append(msg)\n306|+            continue\n307|+        src = cast(\"dict[str, object]\", msg)\n308|+        fresh = dict(src)\n309|+        raw_content = src.get(\"content\")\n310|+        if isinstance(raw_content, (list, dict)):\n311|+            items: list[object] = []\n312|+            for item in _content_items(src.get(\"content\")):\n313|+                if isinstance(item, str):\n314|+                    items.append(item)\n315|+                elif isinstance(item, dict):\n316|+                    part = cast(\"dict[str, object]\", item)\n317|+                    kind = _classify_part(part)\n318|+                    if kind == \"image\":\n319|+                        items.append(_image_part_canonical(part))\n320|+                    elif kind == \"text\":\n321|+                        items.append({\"type\": \"text\", \"text\": _part_text(part)})\n322|+            fresh[\"content\"] = items\n323|+        out.append(fresh)\n324|+    return out\n325|+\n326|+\n327|+def _log_token(value: object, max_len: int = 64) -> str:\n328|+    \"\"\"Идентификатор для журнала: только `A-Za-z0-9_.-`, остальное `_`, длина ограничена.\"\"\"\n329|+    text = re.sub(r\"[^A-Za-z0-9_.\\-]\", \"_\", str(value))[:max_len]\n330|+    return text or \"unknown\"\n331|+\n332|+\n333|+_IMAGE_FALLBACK_STAGES = frozenset({\"collect\", \"post_slot\", \"spool\", \"runtime\"})\n334|+\n335|+\n336|+def _log_image_fallback(\n337|+    stage: str, reason: str, model: str, attempt: int, count: int\n338|+) -> None:\n339|+    \"\"\"Одна структурная строка `image_fallback` на фактический downgrade (без payload).\"\"\"\n340|+    stage_token = stage if stage in _IMAGE_FALLBACK_STAGES else \"unknown\"\n341|+    model_token = _log_token(model) if model in FLEET_MODELS else \"unknown\"\n342|+    _log(\n343|+        \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\"\n344|+        % (\n345|+            stage_token,\n346|+            _log_token(reason),\n347|+            model_token,\n348|+            max(0, min(int(attempt), 9)),\n349|+            max(0, min(int(count), 1000000)),\n350|+        )\n351|+    )\n352|+\n353|+\n354| def _collect_image_parts(\n355|     messages: object,\n356| ) -> list[tuple[int, int, dict[str, object]]]:\n357|@@ -833,7 +1157,7 @@ def _new_img_dir() -> Path:\n358| \n359| \n360| def _collect_images(\n361|-    messages: object, model_id: str, effort: str | None\n362|+    messages: object, model_id: str, effort: str | None, universal: bool = False\n363| ) -> list[dict[str, object]]:\n364|     \"\"\"Проверить image-части всей истории; вернуть записи для prompt и spool.\n365| \n366|@@ -842,11 +1166,23 @@ def _collect_images(\n367|     оценка размера base64 ДО decode, строгий base64, сигнатура, лимиты. Ничего не\n368|     пишется на диск и не запускается. Декодированные байты не удерживаются\n369|     (`data` пуст): в spool они пересоздаются из base64 уже после захвата слота.\n370|+\n371|+    `universal=True`: image-алиасы (`image`, `input_image`, dict-content) приводятся\n372|+    к `image_url`, а вместо proof-гейта работает `_image_gate_universal`; остальные\n373|+    проверки те же. Любой отказ отбрасывает ВСЕ записи (исключение, без частичного набора).\n374|     \"\"\"\n375|-    parts = _collect_image_parts(messages)\n376|+    parts = (\n377|+        _collect_image_parts_universal(messages)\n378|+        if universal\n379|+        else _collect_image_parts(messages)\n380|+    )\n381|     if not parts:\n382|         return []\n383|-    gate = _image_gate(model_id, effort)\n384|+    gate = (\n385|+        _image_gate_universal(model_id, effort)\n386|+        if universal\n387|+        else _image_gate(model_id, effort)\n388|+    )\n389|     if gate is not None:\n390|         raise gate\n391|     max_images = _limit(\"max_images\", 16)\n392|@@ -977,6 +1313,62 @@ def _cleanup_img_dir(img_dir: Path) -> None:\n393|             _active_img_dirs.discard(str(img_dir))\n394| \n395| \n396|+_IMAGE_MARKER = re.compile(r\"\\[image \\d+\\]\")\n397|+\n398|+\n399|+def _text_only_prompt_fallback(prompt: str) -> str:\n400|+    \"\"\"Безопасный media-free промпт из готового: без `[attachments]` и `[image N]`.\n401|+\n402|+    Запасной путь для вызывающих `_run_once` без предвычисленного\n403|+    `stripped_full_prompt`; штатно промпт берётся из `_messages_to_stripped_prompt`.\n404|+    \"\"\"\n405|+    cut = prompt.rfind(\"[attachments]\\n\")\n406|+    if cut == 0 or (cut > 0 and prompt[cut - 2 : cut] == \"\\n\\n\"):\n407|+        prompt = prompt[:cut].rstrip()\n408|+    text = _IMAGE_MARKER.sub(_IMAGE_OMITTED, prompt).strip()\n409|+    return text or \"Reply with exactly: PONG\"\n410|+\n411|+\n412|+def _downgrade_to_text_in_run_once(\n413|+    ctx: dict[str, object],\n414|+    stage: str,\n415|+    reason: str,\n416|+    attempt: int,\n417|+    img_dir: Path | None,\n418|+) -> None:\n419|+    \"\"\"Перевести ход в text-only: журнал, каталог, CID и оба промпта (AD-003).\n420|+\n421|+    Порядок: событие (счёт ДО обнуления) -> удаление собственного каталога ->\n422|+    CAS-инвалидация и снятие владения старым CID -> `prompt`/`full_prompt` из\n423|+    предвычисленной media-free истории. Run вызывающий уже закрыл; повторный\n424|+    вызов безопасен (cleanup идемпотентен, CID уже пуст).\n425|+    \"\"\"\n426|+    held = cast(\"list[dict[str, object]]\", ctx.get(\"images\") or [])\n427|+    _log_image_fallback(stage, reason, str(ctx.get(\"model\") or \"\"), attempt, len(held))\n428|+    if img_dir is not None:\n429|+        _cleanup_img_dir(img_dir)\n430|+    old_cid = str(ctx.get(\"conversation_id\") or \"\")\n431|+    if old_cid:\n432|+        sess_key = ctx.get(\"sess_key\")\n433|+        if sess_key:\n434|+            _session_invalidate(cast(tuple, sess_key), old_cid)\n435|+        _cid_release(old_cid, str(ctx.get(\"turn_id\") or \"\"))\n436|+        if ctx.get(\"hot_resumed\"):\n437|+            with _session_store_lock:\n438|+                _in_flight_cids.discard(old_cid)\n439|+    stripped = ctx.get(\"stripped_full_prompt\")\n440|+    if not isinstance(stripped, str) or not stripped:\n441|+        stripped = _text_only_prompt_fallback(\n442|+            str(ctx.get(\"full_prompt\") or ctx.get(\"prompt\") or \"\")\n443|+        )\n444|+    ctx[\"hot_resumed\"] = False\n445|+    ctx[\"conversation_id\"] = \"\"\n446|+    ctx[\"images\"] = []\n447|+    ctx[\"img_dir\"] = None\n448|+    ctx[\"prompt\"] = stripped\n449|+    ctx[\"full_prompt\"] = stripped\n450|+\n451|+\n452| def _attachments_block(images: list[dict[str, object]]) -> str:\n453|     lines = [\n454|         \"[attachments]\",\n455|@@ -1234,9 +1626,11 @@ def _reset_sqlite_guards_for_tests() -> None:\n456|     global _compat_ident, _compat_state, _flag_value, _flag_key, _flag_checked_at\n457|     global _sqlite_divergence_count, _sqlite_drain_deadline_count\n458|     global _sqlite_open_connections, _sqlite_max_open_connections, _rng\n459|-    global _image_flag_cache\n460|+    global _image_flag_cache, _image_fallback_flag_cache\n461|     with _image_flag_lock:\n462|         _image_flag_cache = (0.0, False)\n463|+    with _image_fallback_flag_lock:\n464|+        _image_fallback_flag_cache = (0.0, False)\n465|     with _sha_cache_lock:\n466|         _sha_cache.clear()\n467|     with _sqlite_guard_lock:\n468|@@ -2853,6 +3247,35 @@ class _ByteBudget:\n469|             self.used = max(0, self.used - amount)\n470| \n471| \n472|+def _image_fallback_view() -> tuple[dict[str, object], dict[str, bool]]:\n473|+    \"\"\"Эффективная image-поддержка по каталогу и объект `image_fallback` для GET.\n474|+\n475|+    universal -> поддержка = staging включён (для каждой модели каталога, proof не\n476|+    подделывается); иначе строгий `_model_supports_images`. Булевы `images` остаются\n477|+    булевыми, новая информация — только в отдельном объекте.\n478|+    \"\"\"\n479|+    universal = _is_image_fallback_enabled()\n480|+    input_enabled = _is_image_input_enabled()\n481|+    effective = {\n482|+        mid: (input_enabled if universal else _model_supports_images(mid))\n483|+        for mid in FLEET_MODELS\n484|+    }\n485|+    if universal:\n486|+        acceptance = \"optimistic\" if input_enabled else \"text-only\"\n487|+    else:\n488|+        acceptance = \"proof-gated\"\n489|+    info: dict[str, object] = {\n490|+        \"fallback_enabled\": universal,\n491|+        \"input_enabled\": input_enabled,\n492|+        \"mode\": \"universal\" if universal else \"strict\",\n493|+        \"acceptance\": acceptance,\n494|+        \"method\": \"workspace-read\",\n495|+        \"limits\": dict(IMAGE_LIMITS),\n496|+        \"models\": [mid for mid, ok in effective.items() if ok],\n497|+    }\n498|+    return info, effective\n499|+\n500|+\n(more lines below)","final_result":true}}}
