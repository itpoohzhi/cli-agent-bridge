n89|\n90|    def advance(self, seconds: float) -> None:\n91|        self.now += seconds\n92|\n93|\n94|class _TickQueue:\n95|    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n96|\n97|    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n98|        self.clock = clock\n99|        self.empty_ticks = empty_ticks\n(more lines below)","final_result":true}}}
