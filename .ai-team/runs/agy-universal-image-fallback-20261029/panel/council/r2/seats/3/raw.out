l prefix\",\n23|      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n24|      \"owner\": \"Verifier\"\n25|    },\n26|    {\n27|      \"id\": \"VER-003\",\n28|      \"requirement_ids\": [\n29|        \"REQ-01\",\n30|        \"REQ-02\",\n31|        \"REQ-03\",\n32|        \"REQ-04\",\n33|        \"REQ-05\",\n34|        \"REQ-06\"\n35|      ],\n36|      \"kind\": \"command\",\n37|      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n38|      \"expected\": \">=56 tests: all 46 legacy image-related methods plus UniversalImageFallbackTests uf01..uf10 execute and pass; not AST-only\",\n39|      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n40|      \"owner\": \"Verifier\"\n41|    },\n42|    {\n43|      \"id\": \"VER-004\",\n44|      \"requirement_ids\": [\n45|        \"REQ-04\"\n46|      ],\n47|      \"kind\": \"command\",\n48|      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import collections, io, json, subprocess, tarfile, tempfile\\nfrom pathlib import Path\\nroot=Path.cwd(); temp_base_dir=Path.home()/\\\"work/tmp\\\"; temp_base_dir.mkdir(parents=True,exist_ok=True)\\nargs=[\\\"uvx\\\",\\\"basedpyright@1.40.2\\\",\\\"--outputjson\\\",\\\"bridges/agy-bridge/server.py\\\",\\\"tests/test_agy_bridge_resilience.py\\\"]\\ndef diagnostics(cwd):\\n r=subprocess.run(args,cwd=cwd,capture_output=True,text=True)\\n assert r.returncode in (0,1),(r.returncode,r.stderr)\\n d=json.loads(r.stdout); assert \\\"generalDiagnostics\\\" in d,d\\n c=collections.Counter()\\n for x in d[\\\"generalDiagnostics\\\"]:\\n  f=str(Path(x[\\\"file\\\"]).relative_to(cwd)); c[(f,x.get(\\\"severity\\\"),x.get(\\\"rule\\\"),x[\\\"message\\\"])]+=1\\n return c\\nwith tempfile.TemporaryDirectory(prefix=\\\"agy-type-baseline-\\\",dir=temp_base_dir) as tmp:\\n old=Path(tmp); archive=subprocess.check_output([\\\"git\\\",\\\"archive\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'])\\n with tarfile.open(fileobj=io.BytesIO(archive)) as tf: tf.extractall(old,filter=\\\"data\\\")\\n before=diagnostics(old); after=diagnostics(root); delta=after-before\\n assert not delta,dict(delta)\\n print(\\\"TYPECHECK_NO_NEW_DIAGNOSTICS_PASS\\\",\\\"baseline\\\",sum(before.values()),\\\"candidate\\\",sum(after.values()))'\",\n49|      \"expected\": \"same pinned basedpyright executable checks archived BASE and candidate; exact multiset file/severity/rule/message delta is empty; inherited diagnostics recorded, no baseline suppression\",\n50|      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\