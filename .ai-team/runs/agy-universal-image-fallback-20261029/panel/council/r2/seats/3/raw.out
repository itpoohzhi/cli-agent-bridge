{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c517","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":230,"recorded_at":1780531400000455,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"task_stream":{"kind":"task","id":"01a18869-aa06-7892-a5c5-01da367deb4a"},"task_id":"01a18869-aa06-7892-a5c5-01da367deb4a","event":{"kind":"output","task_id":"01a18869-aa06-7892-a5c5-01da367deb4a","chunk":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(499 line(s) above)\n500|    raw = os.environ.get(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", \"1\").strip().lower()\n501|    return raw not in (\"0\", \"false\", \"no\", \"off\")\n502|\n503|\n504|# Имена диагностических событий и причин отказа (мышление, изображения) длиннее 24\n505|# символов, но секретами не являются: без исключения маска скрыла бы их в логах.\n506|# Только точное совпадение токена целиком, не префикс и не подстрока.\n507|_LOG_EVENT_NAMES = frozenset(\n508|    {\n509|        \"sqlite_snapshot_divergence\",\n510|        \"sqlite_transcript_divergence\",\n511|        \"image_input_not_supported\",\n512|        \"unsupported_reasoning_effort\",\n513|        \"invalid_reasoning_effort\",\n514|        \"unsupported_image_type\",\n515|        \"invalid_image_content\",\n516|        \"invalid_image_base64\",\n517|        \"image_url_not_allowed\",\n518|        \"image_type_mismatch\",\n519|        \"image_proof_invalid\",\n520|        \"images_too_large\",\n521|        \"image_too_large\",\n522|        \"too_many_images\",\n523|        \"image_spool_error\",\n524|        \"image_cleanup_error\",\n525|        \"image_sweep_removed\",\n526|        \"media-degradation-reserve\",\n527|    }\n528|)\n529|\n530|\n531|def _mask_token(match: re.Match[str]) -> str:\n532|    token = match.group(0)\n533|    return token if token in _LOG_EVENT_NAMES else \"***\"\n534|\n535|\n536|def _mask_secrets(text: str) -> str:\n537|    \"\"\"Погасить токеноподобные последовательности и сам ключ моста.\"\"\"\n538|    out = str(text)\n539|    if AUTH_KEY:\n540|        out = out.replace(AUTH_KEY, \"***\")\n541|    return _SECRET.sub(_mask_token, out)\n542|\n543|\n544|def _err_summary(err: Any, limit: int = 200) -> str:\n545|    text = \" \".join(str(err or \"\").split())\n546|    return text[:limit]\n547|\n548|\n549|# Порог неактивности хода (без протокольных событий и без прироста CPU/потомков группы).\n550|IDLE_TIMEOUT_S = _idle_timeout_from_env()\n551|# Зачистка группы: сколько ждать после SIGTERM и сколько — reap лидера после SIGKILL.\n552|KILL_TERM_GRACE_S = 2.0\n553|KILL_WAIT_S = 5.0\n554|# После result ERROR процесс обязан выйти сам: сколько ждать done, прежде чем сдаться.\n555|RESULT_EXIT_GRACE_S = 5.0\n556|# События очереди, считающиеся активностью агента (result/done/pump_error — терминальные).\n557|_ACTIVITY_KINDS = frozenset({\"init\", \"text\", \"reasoning\", \"tool_trace\"})\n558|\n559|\n560|def _launch_env() -> dict:\n561|    \"\"\"Окружение для `agy`. Ключ моста потомку не передаётся.\n562|\n563|    Прокси-переменные (HTTPS_PROXY/HTTP_PROXY/NO_PROXY) выставляет сам лончер\n564|    agy-cli.sh — мост их не дублирует и не переопределяет.\n565|    \"\"\"\n566|    env = os.environ.copy()\n567|    env.pop(\"AGY_BRIDGE_KEY\", None)\n568|    return env\n569|\n570|\n571|class LauncherUnavailable(Exception):\n572|    \"\"\"Канонический лончер отсутствует или не исполняем.\"\"\"\n573|\n574|\n575|def _launcher() -> str:\n576|    \"\"\"Канонический лончер обязателен; запасного пути на голый бинарь нет.\n577|\n578|    Без лончера agy гео-заблокирован (РФ), поэтому «fallback на голый бинарник»\n579|    запрещён: это дало бы тихий отказ вместо честной ошибки.\n580|    \"\"\"\n581|    if os.path.isfile(LAUNCHER) and os.access(LAUNCHER, os.X_OK):\n582|        return LAUNCHER\n583|    raise LauncherUnavailable(LAUNCHER)\n584|\n585|\n586|def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n587|    hdr = handler.headers.get(\"Authorization\", \"\")\n588|    if hdr.startswith(\"Bearer \"):\n589|        return hdr[7:].strip() == AUTH_KEY\n590|    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n591|\n592|\n593|def _flatten_content(content: Any, img_counter: list[int] | None = None) -> str:\n594|    \"\"\"Контент сообщения в текст; с `img_counter` image-части дают маркеры `[image N]`.\"\"\"\n595|    if content is None:\n596|        return \"\"\n597|    if isinstance(content, str):\n598|        return content\n599|    if isinstance(content, list):\n600|        parts: list[str] = []\n601|        for item in content:\n602|            if isinstance(item, str):\n603|                parts.append(item)\n604|            elif (\n605|                img_counter is not None\n606|                and isinstance(item, dict)\n607|                and item.get(\"type\") == \"image_url\"\n608|            ):\n609|                img_counter[0] += 1\n610|                parts.append(\"[image %d]\" % img_counter[0])\n611|            elif isinstance(item, dict) and \"text\" in item:\n612|                parts.append(str(item[\"text\"]))\n613|        return \"\\n\".join(p for p in parts if p)\n614|    return str(content)\n615|\n616|\n617|def _tool_choice_none(tool_choice: Any) -> bool:\n618|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n619|\n620|\n621|@final\n622|class ImageReject(ValueError):\n623|    \"\"\"Отказ по изображениям: `reason` — деталь для журнала, `code` — тип HTTP 400.\"\"\"\n624|\n625|    def __init__(self, reason: str, code: str = \"image_input_not_supported\") -> None:\n626|        super().__init__(reason)\n627|        self.reason = reason\n628|        self.code = code\n629|\n630|\n631|@final\n632|class ImageSpoolError(RuntimeError):\n633|    \"\"\"Проверенные изображения не удалось материализовать на диск.\"\"\"\n634|\n635|\n636|_B64_WS = re.compile(r\"[ \\t\\r\\n\\f\\v]\")\n637|_STATUS_REASONS = frozenset(\n638|    {\"status_unsupported\", \"status_probe\", \"model_unknown\", \"input_not_image\"}\n639|)\n640|\n641|\n642|def _safe_log_value(value: object) -> str:\n643|    \"\"\"Значение из запроса для строки журнала: управляющие символы -> `_`.\"\"\"\n644|    return re.sub(r\"[\\x00-\\x1f\\x7f]\", \"_\", str(value))\n645|\n646|\n647|def _file_sha256(path: object) -> str:\n648|    \"\"\"SHA-256 файла чанками по 1 MiB; '' — файл недоступен или изменился при чтении.\n649|\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"task_stream":{"kind":"task","id":"01a18869-aa06-7892-a5c5-01da367deb4a"},"task_id":"01a18869-aa06-7892-a5c5-01da367deb4a","event":{"kind":"completed","task_id":"01a18869-aa06-7892-a5c5-01da367deb4a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51b","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":232,"recorded_at":1780531400000459,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"task_stream":{"kind":"task","id":"01a18869-a96e-7801-8ad7-41e937b5fba2"},"task_id":"01a18869-a96e-7801-8ad7-41e937b5fba2","event":{"kind":"output","task_id":"01a18869-a96e-7801-8ad7-41e937b5fba2","chunk":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(859 line(s) above)\n860|    \"inline_data\",\n861|    \"fileData\",\n862|    \"file_data\",\n863|)\n864|_MEDIA_PART_TYPES = frozenset(name.lower() for name in _MEDIA_PART_NAMES)\n865|_TEXT_PART_TYPES = frozenset({\"text\", \"input_text\", \"output_text\"})\n866|_IMAGE_OMITTED = \"[image omitted]\"\n867|_MEDIA_OMITTED = \"[media omitted]\"\n868|_JSON_COPY_MAX_DEPTH = 32\n869|\n870|\n871|def _lower_keys(part: dict[str, object]) -> dict[str, object]:\n872|    \"\"\"Копия part с ключами в нижнем регистре: `InlineData`/`Image_Url` не обходят классификацию.\"\"\"\n873|    lowered: dict[str, object] = {}\n874|    for key, value in part.items():\n875|        lowered_key = str(key).lower()\n876|        if lowered_key not in lowered:\n877|            lowered[lowered_key] = value\n878|    return lowered\n879|\n880|\n881|def _classify_part(part: dict[str, object]) -> str:\n882|    \"\"\"'image' | 'media' | 'text' | 'unknown'; медиа определяется ДО чтения `text`.\n883|\n884|    `text` с не-строковым значением (dict/list) — структурный payload, не текст.\n885|    \"\"\"\n886|    lowered = _lower_keys(part)\n887|    raw_kind = lowered.get(\"type\")\n888|    kind = raw_kind.strip().lower() if isinstance(raw_kind, str) else \"\"\n889|    if kind in _IMAGE_PART_TYPES or any(\n890|        lowered.get(key) is not None for key in _IMAGE_PAYLOAD_KEYS\n891|    ):\n892|        return \"image\"\n893|    if kind in _MEDIA_PART_TYPES or any(\n894|        lowered.get(key) is not None for key in _MEDIA_PART_TYPES\n895|    ):\n896|        return \"media\"\n897|    text = lowered.get(\"text\")\n898|    if kind in _TEXT_PART_TYPES and (text is None or isinstance(text, str)):\n899|        return \"text\"\n900|    if not kind and isinstance(text, str):\n901|        return \"text\"\n902|    return \"unknown\"\n903|\n904|\n905|def _part_text(part: dict[str, object]) -> str:\n906|    \"\"\"Текст text-части (`\"\"` для отсутствующего/None); только после `_classify_part == 'text'`.\"\"\"\n907|    value = _lower_keys(part).get(\"text\")\n908|    return value if isinstance(value, str) else \"\"\n909|\n910|\n911|def _content_items(content: object) -> list[object]:\n912|    \"\"\"Части контента: list как есть, dict-content — одна часть, прочее — пусто.\"\"\"\n913|    if isinstance(content, list):\n914|        return cast(\"list[object]\", content)\n915|    if isinstance(content, dict):\n916|        return [content]\n917|    return []\n918|\n919|\n920|def _image_part_canonical(part: dict[str, object]) -> dict[str, object]:\n921|    \"\"\"Image-алиас в форме `image_url`; `image_url` приоритетнее `image`, URL не угадывается.\"\"\"\n922|    lowered = _lower_keys(part)\n923|    payload = lowered.get(\"image_url\")\n924|    if payload is None:\n925|        payload = lowered.get(\"image\")\n926|    url: object = None\n927|    if isinstance(payload, str):\n928|        url = payload\n929|    elif isinstance(payload, dict):\n930|        url = cast(\"dict[str, object]\", payload).get(\"url\")\n931|    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n932|\n933|\n934|def _media_part_counts(messages: object) -> tuple[int, int]:\n935|    \"\"\"(image-частей, прочих media/неизвестных структурных частей) во всей истории.\n936|\n937|    dict-content считается одной частью (`_content_items`); не-text часть любого вида\n938|    попадает в счёт, чтобы нормализация не обходилась неизвестным payload.\n939|    \"\"\"\n940|    images = 0\n941|    other = 0\n942|    if not isinstance(messages, list):\n943|        return images, other\n944|    for msg in cast(\"list[object]\", messages):\n945|        if not isinstance(msg, dict):\n946|            continue\n947|        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n948|            if not isinstance(item, dict):\n949|                continue\n950|            kind = _classify_part(cast(\"dict[str, object]\", item))\n951|            if kind == \"image\":\n952|                images += 1\n953|            elif kind != \"text\":\n954|                other += 1\n955|    return images, other\n956|\n957|\n958|def _collect_image_parts_universal(\n959|    messages: object,\n960|) -> list[tuple[int, int, dict[str, object]]]:\n961|    \"\"\"Все image-части истории (любой алиас, list и dict-content) в форме `image_url`.\"\"\"\n962|    found: list[tuple[int, int, dict[str, object]]] = []\n963|    if not isinstance(messages, list):\n964|        return found\n965|    number = 0\n966|    for msg_index, msg in enumerate(cast(\"list[object]\", messages)):\n967|        if not isinstance(msg, dict):\n968|            continue\n969|        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n970|            if not isinstance(item, dict):\n971|                continue\n972|            part = cast(\"dict[str, object]\", item)\n973|            if _classify_part(part) == \"image\":\n974|                number += 1\n975|                found.append((msg_index, number, _image_part_canonical(part)))\n976|    return found\n977|\n978|\n979|def _json_copy(value: object, depth: int = 0) -> object:\n980|    \"\"\"Копия JSON-значения без разделяемых контейнеров (глубина ограничена).\"\"\"\n981|    if depth > _JSON_COPY_MAX_DEPTH:\n982|        return None\n983|    if isinstance(value, dict):\n984|        return {\n985|            str(k): _json_copy(v, depth + 1)\n986|            for k, v in cast(\"dict[object, object]\", value).items()\n987|        }\n988|    if isinstance(value, list):\n989|        return [_json_copy(v, depth + 1) for v in cast(\"list[object]\", value)]\n990|    if value is None or isinstance(value, (str, int, float, bool)):\n991|        return value\n992|    return str(value)\n993|\n994|\n995|def _flatten_content_stripped(content: object) -> str:\n996|    \"\"\"Контент в безопасный текст без media: image -> `[image omitted]`, media -> `[media omitted]`.\n997|\n998|    Обычный текст сохраняется в порядке следования (склейка `\\\\n`), неизвестные\n999|    структурные объекты не сериализуются; сообщение только из них даёт\n1000|    `[media omitted]`, чтобы контекст не стал пустым.\n1001|    \"\"\"\n1002|    if content is None:\n1003|        return \"\"\n1004|    if isinstance(content, str):\n1005|        return content\n1006|    parts: list[str] = []\n1007|    dropped = False\n1008|    for item in _content_items(content):\n1009|        if isinstance(item, str):\n1010|            parts.append(item)\n1011|        elif isinstance(item, dict):\n1012|            part = cast(\"dict[str, object]\", item)\n1013|            kind = _classify_part(part)\n1014|            if kind == \"image\":\n1015|                parts.append(_IMAGE_OMITTED)\n1016|            elif kind == \"media\":\n1017|                parts.append(_MEDIA_OMITTED)\n1018|            elif kind == \"text\":\n1019|                parts.append(_part_text(part))\n1020|            else:\n1021|                dropped = True\n1022|        elif isinstance(item, list):\n1023|            dropped = True\n1024|    if not parts and dropped:\n1025|        parts.append(_MEDIA_OMITTED)\n1026|    return \"\\n\".join(p for p in parts if p)\n1027|\n1028|\n1029|def _strip_media_from_messages(messages: object) -> list[dict[str, object]]:\n1030|    \"\"\"Новый список сообщений без media; вход не мутируется, роли и порядок сохранены.\"\"\"\n1031|    out: list[dict[str, object]] = []\n1032|    if not isinstance(messages, list):\n1033|        return out\n1034|    for msg in cast(\"list[object]\", messages):\n1035|        if not isinstance(msg, dict):\n1036|            continue\n1037|        fresh: dict[str, object] = {}\n1038|        for key, value in cast(\"dict[object, object]\", msg).items():\n1039|            if key == \"content\":\n1040|                fresh[\"content\"] = _flatten_content_stripped(value)\n1041|            else:\n1042|                fresh[str(key)] = _json_copy(value)\n1043|        out.append(fresh)\n1044|    return out\n1045|\n1046|\n1047|def _messages_to_stripped_prompt(messages: object) -> str:\n1048|    \"\"\"Промпт всей истории без media: нет `[image N]`, `[attachments]`, путей и payload.\"\"\"\n1049|    return _messages_to_prompt(\n1050|        cast(\"list[object]\", _strip_media_from_messages(messages))\n1051|    )\n1052|\n1053|\n1054|def _universal_render_messages(messages: object) -> list[object]:\n1055|    \"\"\"Копия истории для оптимистичной отправки: image — каноничные, прочее media — вон.\n1056|\n1057|    Длина и индексы сохранены (нужны сквозной нумерации `[image N]` и resume-срезу).\n1058|    \"\"\"\n1059|    out: list[object] = []\n1060|    if not isinstance(messages, list):\n1061|        return out\n1062|    for msg in cast(\"list[object]\", messages):\n1063|        if not isinstance(msg, dict):\n1064|            out.append(msg)\n1065|            continue\n1066|        src = cast(\"dict[str, object]\", msg)\n1067|        fresh = dict(src)\n1068|        raw_content = src.get(\"content\")\n1069|        if isinstance(raw_content, (list, dict)):\n1070|            items: list[object] = []\n1071|            for item in _content_items(src.get(\"content\")):\n1072|                if isinstance(item, str):\n1073|                    items.append(item)\n1074|                elif isinstance(item, dict):\n1075|                    part = cast(\"dict[str, object]\", item)\n1076|                    kind = _classify_part(part)\n1077|                    if kind == \"image\":\n1078|                        items.append(_image_part_canonical(part))\n1079|                    elif kind == \"text\":\n1080|                        items.append({\"type\": \"text\", \"text\": _part_text(part)})\n1081|            fresh[\"content\"] = items\n1082|        out.append(fresh)\n1083|    return out\n1084|\n1085|\n1086|def _log_token(value: object, max_len: int = 64) -> str:\n1087|    \"\"\"Идентификатор для журнала: только `A-Za-z0-9_.-`, остальное `_`, длина ограничена.\"\"\"\n1088|    text = re.sub(r\"[^A-Za-z0-9_.\\-]\", \"_\", str(value))[:max_len]\n1089|    return text or \"unknown\"\n1090|\n1091|\n1092|_IMAGE_FALLBACK_STAGES = frozenset({\"collect\", \"post_slot\", \"spool\", \"runtime\"})\n1093|\n1094|\n1095|def _log_image_fallback(\n1096|    stage: str, reason: str, model: str, attempt: int, count: int\n1097|) -> None:\n1098|    \"\"\"Одна структурная строка `image_fallback` на фактический downgrade (без payload).\"\"\"\n1099|    stage_token = stage if stage in _IMAGE_FALLBACK_STAGES else \"unknown\"\n1100|    model_token = _log_token(model) if model in FLEET_MODELS else \"unknown\"\n1101|    _log(\n1102|        \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\"\n1103|        % (\n1104|            stage_token,\n1105|            _log_token(reason),\n1106|            model_token,\n1107|            max(0, min(int(attempt), 9)),\n1108|            max(0, min(int(count), 1000000)),\n1109|        )\n1110|    )\n1111|\n1112|\n1113|def _collect_image_parts(\n1114|    messages: object,\n1115|) -> list[tuple[int, int, dict[str, object]]]:\n1116|    \"\"\"Все image_url-части истории: (индекс сообщения с 0, сквозной номер с 1, часть).\"\"\"\n1117|    found: list[tuple[int, int, dict[str, object]]] = []\n1118|    if not isinstance(messages, list):\n1119|        return found\n(more lines below)","final_result":true}}}
