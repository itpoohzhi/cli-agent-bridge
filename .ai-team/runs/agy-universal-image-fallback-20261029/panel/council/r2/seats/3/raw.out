{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"call_id":"call_01a188699c2d76ae9b6e8545313e86f4","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(859 line(s) above)\n860|    \"inline_data\",\n861|    \"fileData\",\n862|    \"file_data\",\n863|)\n864|_MEDIA_PART_TYPES = frozenset(name.lower() for name in _MEDIA_PART_NAMES)\n865|_TEXT_PART_TYPES = frozenset({\"text\", \"input_text\", \"output_text\"})\n866|_IMAGE_OMITTED = \"[image omitted]\"\n867|_MEDIA_OMITTED = \"[media omitted]\"\n868|_JSON_COPY_MAX_DEPTH = 32\n869|\n870|\n871|def _lower_keys(part: dict[str, object]) -> dict[str, object]:\n872|    \"\"\"Копия part с ключами в нижнем регистре: `InlineData`/`Image_Url` не обходят классификацию.\"\"\"\n873|    lowered: dict[str, object] = {}\n874|    for key, value in part.items():\n875|        lowered_key = str(key).lower()\n876|        if lowered_key not in lowered:\n877|            lowered[lowered_key] = value\n878|    return lowered\n879|\n880|\n881|def _classify_part(part: dict[str, object]) -> str:\n882|    \"\"\"'image' | 'media' | 'text' | 'unknown'; медиа определяется ДО чтения `text`.\n883|\n884|    `text` с не-строковым значением (dict/list) — структурный payload, не текст.\n885|    \"\"\"\n886|    lowered = _lower_keys(part)\n887|    raw_kind = lowered.get(\"type\")\n888|    kind = raw_kind.strip().lower() if isinstance(raw_kind, str) else \"\"\n889|    if kind in _IMAGE_PART_TYPES or any(\n890|        lowered.get(key) is not None for key in _IMAGE_PAYLOAD_KEYS\n891|    ):\n892|        return \"image\"\n893|    if kind in _MEDIA_PART_TYPES or any(\n894|        lowered.get(key) is not None for key in _MEDIA_PART_TYPES\n895|    ):\n896|        return \"media\"\n897|    text = lowered.get(\"text\")\n898|    if kind in _TEXT_PART_TYPES and (text is None or isinstance(text, str)):\n899|        return \"text\"\n900|    if not kind and isinstance(text, str):\n901|        return \"text\"\n902|    return \"unknown\"\n903|\n904|\n905|def _part_text(part: dict[str, object]) -> str:\n906|    \"\"\"Текст text-части (`\"\"` для отсутствующего/None); только после `_classify_part == 'text'`.\"\"\"\n907|    value = _lower_keys(part).get(\"text\")\n908|    return value if isinstance(value, str) else \"\"\n909|\n910|\n911|def _content_items(content: object) -> list[object]:\n912|    \"\"\"Части контента: list как есть, dict-content — одна часть, прочее — пусто.\"\"\"\n913|    if isinstance(content, list):\n914|        return cast(\"list[object]\", content)\n915|    if isinstance(content, dict):\n916|        return [content]\n917|    return []\n918|\n919|\n920|def _image_part_canonical(part: dict[str, object]) -> dict[str, object]:\n921|    \"\"\"Image-алиас в форме `image_url`; `image_url` приоритетнее `image`, URL не угадывается.\"\"\"\n922|    lowered = _lower_keys(part)\n923|    payload = lowered.get(\"image_url\")\n924|    if payload is None:\n925|        payload = lowered.get(\"image\")\n926|    url: object = None\n927|    if isinstance(payload, str):\n928|        url = payload\n929|    elif isinstance(payload, dict):\n930|        url = cast(\"dict[str, object]\", payload).get(\"url\")\n931|    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n932|\n933|\n934|def _media_part_counts(messages: object) -> tuple[int, int]:\n935|    \"\"\"(image-частей, прочих media/неизвестных структурных частей) во всей истории.\n936|\n937|    dict-content считается одной частью (`_content_items`); не-text часть любого вида\n938|    попадает в счёт, чтобы нормализация не обходилась неизвестным payload.\n939|    \"\"\"\n940|    images = 0\n941|    other = 0\n942|    if not isinstance(messages, list):\n943|        return images, other\n944|    for msg in cast(\"list[object]\", messages):\n945|        if not isinstance(msg, dict):\n946|            continue\n947|        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n948|            if not isinstance(item, dict):\n949|                continue\n950|            kind = _classify_part(cast(\"dict[str, object]\", item))\n951|            if kind == \"image\":\n952|                images += 1\n953|            elif kind != \"text\":\n954|                other += 1\n955|    return images, other\n956|\n957|\n958|def _collect_image_parts_universal(\n959|    messages: object,\n960|) -> list[tuple[int, int, dict[str, object]]]:\n961|    \"\"\"Все image-части истории (любой алиас, list и dict-content) в форме `image_url`.\"\"\"\n962|    found: list[tuple[int, int, dict[str, object]]] = []\n963|    if not isinstance(messages, list):\n964|        return found\n965|    number = 0\n966|    for msg_index, msg in enumerate(cast(\"list[object]\", messages)):\n967|        if not isinstance(msg, dict):\n968|            continue\n969|        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n970|            if not isinstance(item, dict):\n971|                continue\n972|            part = cast(\"dict[str, object]\", item)\n973|            if _classify_part(part) == \"image\":\n974|                number += 1\n975|                found.append((msg_index, number, _image_part_canonical(part)))\n976|    return found\n977|\n978|\n979|def _json_copy(value: object, depth: int = 0) -> object:\n980|    \"\"\"Копия JSON-значения без разделяемых контейнеров (глубина ограничена).\"\"\"\n981|    if depth > _JSON_COPY_MAX_DEPTH:\n982|        return None\n983|    if isinstance(value, dict):\n984|        return {\n985|            str(k): _json_copy(v, depth + 1)\n986|            for k, v in cast(\"dict[object, object]\", value).items()\n987|        }\n988|    if isinstance(value, list):\n989|        return [_json_copy(v, depth + 1) for v in cast(\"list[object]\", value)]\n990|    if value is None or isinstance(value, (str, int, float, bool)):\n991|        return value\n992|    return str(value)\n993|\n994|\n995|def _flatten_content_stripped(content: object) -> str:\n996|    \"\"\"Контент в безопасный текст без media: image -> `[image omitted]`, media -> `[media omitted]`.\n997|\n998|    Обычный текст сохраняется в порядке следования (склейка `\\\\n`), неизвестные\n999|    структурные объекты не сериализуются; сообщение только из них даёт\n1000|    `[media omitted]`, чтобы контекст не стал пустым.\n1001|    \"\"\"\n1002|    if content is None:\n1003|        return \"\"\n1004|    if isinstance(content, str):\n1005|        return content\n1006|    parts: list[str] = []\n1007|    dropped = False\n1008|    for item in _content_items(content):\n1009|        if isinstance(item, str):\n1010|            parts.append(item)\n1011|        elif isinstance(item, dict):\n1012|            part = cast(\"dict[str, object]\", item)\n1013|            kind = _classify_part(part)\n1014|            if kind == \"image\":\n1015|                parts.append(_IMAGE_OMITTED)\n1016|            elif kind == \"media\":\n1017|                parts.append(_MEDIA_OMITTED)\n1018|            elif kind == \"text\":\n1019|                parts.append(_part_text(part))\n1020|            else:\n1021|                dropped = True\n1022|        elif isinstance(item, list):\n1023|            dropped = True\n1024|    if not parts and dropped:\n1025|        parts.append(_MEDIA_OMITTED)\n1026|    return \"\\n\".join(p for p in parts if p)\n1027|\n1028|\n1029|def _strip_media_from_messages(messages: object) -> list[dict[str, object]]:\n1030|    \"\"\"Новый список сообщений без media; вход не мутируется, роли и порядок сохранены.\"\"\"\n1031|    out: list[dict[str, object]] = []\n1032|    if not isinstance(messages, list):\n1033|        return out\n1034|    for msg in cast(\"list[object]\", messages):\n1035|        if not isinstance(msg, dict):\n1036|            continue\n1037|        fresh: dict[str, object] = {}\n1038|        for key, value in cast(\"dict[object, object]\", msg).items():\n1039|            if key == \"content\":\n1040|                fresh[\"content\"] = _flatten_content_stripped(value)\n1041|            else:\n1042|                fresh[str(key)] = _json_copy(value)\n1043|        out.append(fresh)\n1044|    return out\n1045|\n1046|\n1047|def _messages_to_stripped_prompt(messages: object) -> str:\n1048|    \"\"\"Промпт всей истории без media: нет `[image N]`, `[attachments]`, путей и payload.\"\"\"\n1049|    return _messages_to_prompt(\n1050|        cast(\"list[object]\", _strip_media_from_messages(messages))\n1051|    )\n1052|\n1053|\n1054|def _universal_render_messages(messages: object) -> list[object]:\n1055|    \"\"\"Копия истории для оптимистичной отправки: image — каноничные, прочее media — вон.\n1056|\n1057|    Длина и индексы сохранены (нужны сквозной нумерации `[image N]` и resume-срезу).\n1058|    \"\"\"\n1059|    out: list[object] = []\n1060|    if not isinstance(messages, list):\n1061|        return out\n1062|    for msg in cast(\"list[object]\", messages):\n1063|        if not isinstance(msg, dict):\n1064|            out.append(msg)\n1065|            continue\n1066|        src = cast(\"dict[str, object]\", msg)\n1067|        fresh = dict(src)\n1068|        raw_content = src.get(\"content\")\n1069|        if isinstance(raw_content, (list, dict)):\n1070|            items: list[object] = []\n1071|            for item in _content_items(src.get(\"content\")):\n1072|                if isinstance(item, str):\n1073|                    items.append(item)\n1074|                elif isinstance(item, dict):\n1075|                    part = cast(\"dict[str, object]\", item)\n1076|                    kind = _classify_part(part)\n1077|                    if kind == \"image\":\n1078|                        items.append(_image_part_canonical(part))\n1079|                    elif kind == \"text\":\n1080|                        items.append({\"type\": \"text\", \"text\": _part_text(part)})\n1081|            fresh[\"content\"] = items\n1082|        out.append(fresh)\n1083|    return out\n1084|\n1085|\n1086|def _log_token(value: object, max_len: int = 64) -> str:\n1087|    \"\"\"Идентификатор для журнала: только `A-Za-z0-9_.-`, остальное `_`, длина ограничена.\"\"\"\n1088|    text = re.sub(r\"[^A-Za-z0-9_.\\-]\", \"_\", str(value))[:max_len]\n1089|    return text or \"unknown\"\n1090|\n1091|\n1092|_IMAGE_FALLBACK_STAGES = frozenset({\"collect\", \"post_slot\", \"spool\", \"runtime\"})\n1093|\n1094|\n1095|def _log_image_fallback(\n1096|    stage: str, reason: str, model: str, attempt: int, count: int\n1097|) -> None:\n1098|    \"\"\"Одна структурная строка `image_fallback` на фактический downgrade (без payload).\"\"\"\n1099|    stage_token = stage if stage in _IMAGE_FALLBACK_STAGES else \"unknown\"\n1100|    model_token = _log_token(model) if model in FLEET_MODELS else \"unknown\"\n1101|    _log(\n1102|        \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\"\n1103|        % (\n1104|            stage_token,\n1105|            _log_token(reason),\n1106|            model_token,\n1107|            max(0, min(int(attempt), 9)),\n1108|            max(0, min(int(count), 1000000)),\n1109|        )\n1110|    )\n1111|\n1112|\n1113|def _collect_image_parts(\n1114|    messages: object,\n1115|) -> list[tuple[int, int, dict[str, object]]]:\n1116|    \"\"\"Все image_url-части истории: (индекс сообщения с 0, сквозной номер с 1, часть).\"\"\"\n1117|    found: list[tuple[int, int, dict[str, object]]] = []\n1118|    if not isinstance(messages, list):\n1119|        return found\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"call_id":"call_01a188699c38741ca9bfab4a06f3849e","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(4089 line(s) above)\n4090|                self._reject(\n4091|                    400,\n4092|                    \"unsupported_reasoning_effort\",\n4093|                    \"reasoning_effort must be a string\",\n4094|                    model_id,\n4095|                    model_len,\n4096|                )\n4097|                return\n4098|            if \"reasoning\" in req and req.get(\"reasoning\") is not None:\n4099|                self._reject(\n4100|                    400,\n4101|                    \"unsupported_parameter\",\n4102|                    \"reasoning parameter is not supported\",\n4103|                    model_id,\n4104|                    model_len,\n4105|                )\n4106|                return\n4107|            messages_raw = cast(object, req.get(\"messages\"))\n4108|            messages = (\n4109|                cast(\"list[object]\", messages_raw)\n4110|                if isinstance(messages_raw, list)\n4111|                else []\n4112|            )\n4113|            # Универсальная политика фиксируется один раз на принятый запрос.\n4114|            universal = _is_image_fallback_enabled()\n4115|            images: list[dict[str, object]] = []\n4116|            render_messages: list[object] = messages\n4117|            stripped_full_prompt = \"\"\n4118|            force_cold = False\n4119|            if universal:\n4120|                image_parts, other_media = _media_part_counts(messages)\n4121|                # Всегда нормализуем историю: любой cold/downgrade-путь берёт\n4122|                # промпт только отсюда, а не из legacy `_flatten_content`.\n4123|                stripped_full_prompt = _messages_to_stripped_prompt(messages)\n4124|                if image_parts or other_media:\n4125|                    if not _is_image_input_enabled():\n4126|                        _log_image_fallback(\n4127|                            \"collect\",\n4128|                            \"flag_disabled\",\n4129|                            cast(str, model_id),\n4130|                            1,\n4131|                            image_parts,\n4132|                        )\n4133|                        force_cold = True\n4134|                    else:\n4135|                        try:\n4136|                            images = _collect_images(\n4137|                                messages,\n4138|                                cast(str, model_id),\n4139|                                cast(str, effort),\n4140|                                universal=True,\n4141|                            )\n4142|                        except ImageReject as rejected:\n4143|                            _log_image_fallback(\n4144|                                \"collect\",\n4145|                                rejected.reason,\n4146|                                cast(str, model_id),\n4147|                                1,\n4148|                                image_parts,\n4149|                            )\n4150|                            images = []\n4151|                            force_cold = True\n4152|                        else:\n4153|                            if images:\n4154|                                render_messages = _universal_render_messages(messages)\n4155|                            else:\n4156|                                _log_image_fallback(\n4157|                                    \"collect\",\n4158|                                    \"unsupported_media\",\n4159|                                    cast(str, model_id),\n4160|                                    1,\n4161|                                    other_media,\n4162|                                )\n4163|                                force_cold = True\n4164|            else:\n4165|                try:\n4166|                    images = _collect_images(\n4167|                        messages, cast(str, model_id), cast(str, effort)\n4168|                    )\n4169|                except ImageReject as rejected:\n4170|                    _log(\"image_reject detail=%s\" % rejected.reason)\n4171|                    self._reject(\n4172|                        400,\n4173|                        rejected.code,\n4174|                        f\"image rejected: {rejected.code}\",\n4175|                        model_id,\n4176|                        model_len,\n4177|                    )\n4178|                    return\n4179|            img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n4180|            try:\n4181|                _launcher()\n4182|            except LauncherUnavailable:\n4183|                self._reject(\n4184|                    503,\n4185|                    \"launcher_unavailable\",\n4186|                    \"canonical launcher is missing or not executable\",\n4187|                    model_id,\n4188|                    model_len,\n4189|                )\n4190|                return\n4191|            raw_tools = req.get(\"tools\")\n4192|            tools = (\n4193|                [t for t in raw_tools if isinstance(t, dict)]\n4194|                if isinstance(raw_tools, list)\n4195|                else []\n4196|            )\n4197|            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n4198|            if force_cold:\n4199|                full_prompt = stripped_full_prompt\n4200|            else:\n4201|                full_prompt = _messages_to_prompt(render_messages, images)\n4202|                if universal:\n4203|                    stripped_full_prompt = stripped_full_prompt or full_prompt\n4204|            extra = (\n4205|                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n4206|            )\n4207|            cwd = str(extra.get(\"cwd\") or \"\")\n4208|            if len(cwd) > CWD_MAX_LEN:\n4209|                cwd = \"\"\n4210|            conversation_id = str(\n4211|                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n4212|            )\n4213|            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n4214|            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n4215|            # и не пишут: ни claim, ни commit, ни invalidate.\n4216|            use_session_store = tools_count > 0\n4217|            sess_key: tuple[str, str, str] | None = (\n4218|                (cast(str, model_id), cwd, cast(str, effort))\n4219|                if use_session_store\n4220|                else None\n4221|            )\n4222|            is_resumed = False\n4223|            prompt = full_prompt\n4224|            if force_cold:\n4225|                # Media убраны из истории: «грязный» явный или кэшированный CID\n4226|                # не возобновляем, ход идёт холодным text-only с полной историей.\n4227|                conversation_id = \"\"\n4228|            elif conversation_id:\n4229|                if _cid_acquire(conversation_id, turn_id):\n4230|                    owned_cid = conversation_id\n4231|                else:\n4232|                    # cid занят другим активным ходом: два хода не делят один разговор.\n4233|                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n4234|                    conversation_id = \"\"\n4235|            elif sess_key is not None:\n4236|                use_cid = _session_claim(sess_key, turn_id)\n4237|                if use_cid:\n4238|                    conversation_id = use_cid\n4239|                    is_resumed = True\n4240|                    prompt = _get_resumed_turn_prompt(render_messages, images)\n4241|            ctx: dict[str, object] = {\n4242|                \"turn_id\": turn_id,\n4243|                \"sess_key\": sess_key,\n4244|                \"hot_resumed\": is_resumed,\n4245|                \"full_prompt\": full_prompt,\n4246|                \"model\": model_id,\n4247|                \"model_len\": model_len,\n4248|                \"effort\": effort,\n4249|                \"effort_source\": effort_source,\n4250|                \"prompt\": prompt,\n4251|                \"cwd\": cwd,\n4252|                \"tools_count\": tools_count,\n4253|                \"conversation_id\": conversation_id,\n4254|                \"tag\": (\n4255|                    f\"client={self._client_tag()} \"\n4256|                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n4257|                ),\n4258|                \"stream\": bool(req.get(\"stream\")),\n4259|                \"images\": images,\n4260|                \"img_dir\": img_dir,\n4261|                \"universal_fallback\": universal,\n4262|                \"stripped_full_prompt\": stripped_full_prompt,\n4263|            }\n4264|            if ctx[\"stream\"]:\n4265|                self._serve_sse(ctx)\n4266|            else:\n4267|                self._serve_json(ctx)\n4268|        finally:\n4269|            if use_cid:\n4270|                with _session_store_lock:\n4271|                    _in_flight_cids.discard(use_cid)\n4272|            _cid_release(use_cid or owned_cid, turn_id)\n4273|            if reserved and budget is not None:\n4274|                budget.release(reserved)\n4275|\n4276|    def _serve_json(self, ctx: dict) -> None:\n4277|        out = self._run_once(\n4278|            ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n4279|        )\n4280|        if out.get(\"state\") == \"client_gone\":\n4281|            return\n4282|        err = self._error_body(out)\n4283|        if err is not None:\n4284|            self._send(err[\"code\"], {\"error\": err})\n4285|            return\n4286|        usage = out.get(\"usage\") or {}\n4287|        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n4288|        reasoning = out.get(\"reasoning\") or \"\"\n4289|        if reasoning:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"call_id":"call_01a188699f6a7500854ef61c41848058","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/tests/test_agy_bridge_resilience.py`.\n(6978 line(s) above)\n6979|    def test_uf07_media_normalization_is_complete(self) -> None:\n6980|        flatten = _bfn(\"_flatten_content_stripped\")\n6981|        names = (\n6982|            \"image_url\",\n6983|            \"image\",\n6984|            \"input_image\",\n6985|            \"input_audio\",\n6986|            \"audio\",\n6987|            \"video\",\n6988|            \"video_url\",\n6989|            \"file\",\n6990|            \"document\",\n6991|            \"inlineData\",\n6992|            \"inline_data\",\n6993|            \"fileData\",\n6994|            \"file_data\",\n6995|        )\n6996|        image_names = {\"image_url\", \"image\", \"input_image\"}\n6997|        for name in names:\n6998|            want = \"[image omitted]\" if name in image_names else \"[media omitted]\"\n6999|            tainted: dict[str, object] = {\n7000|                \"type\": name,\n7001|                \"text\": \"LEAK-T\",\n7002|                name: {\"data\": \"PAYLOAD-P\", \"url\": \"http://leak.example/x\"},\n7003|            }\n7004|            with self.subTest(kind=\"type\", name=name):\n7005|                for content in ([tainted], tainted):\n7006|                    got = _str(flatten(content))\n7007|                    self.assertEqual(got, want)\n7008|            if name != \"input_image\":\n7009|                keyed: dict[str, object] = {\n7010|                    \"text\": \"LEAK-K\",\n7011|                    name: {\"data\": \"PAYLOAD-K\"},\n7012|                }\n7013|                with self.subTest(kind=\"key\", name=name):\n7014|                    for content in ([keyed], keyed):\n7015|                        self.assertEqual(_str(flatten(content)), want)\n7016|        self.assertEqual(_str(flatten({\"foo\": {\"bar\": \"SECRET\"}})), \"[media omitted]\")\n7017|        self.assertEqual(\n7018|            _str(flatten([\"a\", {\"foo\": 1}, 7, {\"type\": \"text\", \"text\": \"b\"}])), \"a\\nb\"\n7019|        )\n7020|        self.assertEqual(_str(flatten(None)), \"\")\n7021|        original: list[dict[str, object]] = [\n7022|            {\"role\": \"system\", \"content\": \"Система: ✓\"},\n7023|            {\n7024|                \"role\": \"user\",\n7025|                \"content\": [\n7026|                    {\"type\": \"text\", \"text\": \"привет https://example.test/doc\"},\n7027|                    _uf_part(\"image/png\"),\n7028|                    {\"type\": \"input_audio\", \"input_audio\": {\"data\": \"PAYLOAD\"}},\n7029|                ],\n7030|            },\n7031|            {\n7032|                \"role\": \"assistant\",\n7033|                \"content\": None,\n7034|                \"tool_calls\": [\n7035|                    {\"id\": \"c1\", \"function\": {\"name\": \"f\", \"arguments\": \"{}\"}}\n7036|                ],\n7037|            },\n7038|            {\n7039|                \"role\": \"tool\",\n7040|                \"tool_call_id\": \"c1\",\n7041|                \"content\": {\"type\": \"file\", \"file\": {\"file_data\": \"PAYLOAD\"}},\n7042|            },\n7043|            {\"role\": \"user\", \"content\": {\"foo\": \"SECRET\"}},\n7044|        ]\n7045|        snapshot = json.dumps(original, sort_keys=True)\n7046|        stripped = cast(\n7047|            \"list[dict[str, object]]\", _bfn(\"_strip_media_from_messages\")(original)\n7048|        )\n7049|        self.assertEqual(json.dumps(original, sort_keys=True), snapshot)\n7050|        self.assertEqual(\n7051|            [m[\"role\"] for m in stripped],\n7052|            [\"system\", \"user\", \"assistant\", \"tool\", \"user\"],\n7053|        )\n7054|        self.assertIsNot(stripped[1], original[1])\n7055|        self.assertEqual(stripped[3][\"content\"], \"[media omitted]\")\n7056|        self.assertEqual(stripped[4][\"content\"], \"[media omitted]\")\n7057|        prompt = _str(_bfn(\"_messages_to_stripped_prompt\")(original))\n7058|        for kept in (\n7059|            \"Система: ✓\",\n7060|            \"привет https://example.test/doc\",\n7061|            \"[image omitted]\",\n7062|        ):\n7063|            self.assertIn(kept, prompt)\n7064|        self.assertIn(\"[media omitted]\", prompt)\n7065|        _uf_assert_media_free(self, prompt, (\"PAYLOAD\", \"SECRET\", \"leak.example\"))\n7066|        again = cast(\n7067|            \"list[dict[str, object]]\", _bfn(\"_strip_media_from_messages\")(stripped)\n7068|        )\n7069|        self.assertEqual(again, stripped)\n7070|        self.assertEqual(_str(_bfn(\"_messages_to_stripped_prompt\")(stripped)), prompt)\n7071|        with _UniEnv() as env:\n7072|            mixed: list[dict[str, object]] = [\n7073|                {\n7074|                    \"role\": \"user\",\n7075|                    \"content\": [\n7076|                        {\"type\": \"text\", \"text\": \"сравни\"},\n7077|                        {\"type\": \"input_image\", \"image_url\": _uf_url(\"image/png\")},\n7078|                        {\"type\": \"image\", \"image\": {\"url\": _uf_url(\"image/jpeg\")}},\n7079|                        {\n7080|                            \"type\": \"input_audio\",\n7081|                            \"text\": \"LEAK\",\n7082|                            \"input_audio\": {\"data\": \"PAYLOAD\"},\n7083|                        },\n7084|                    ],\n7085|                },\n7086|                {\"role\": \"assistant\", \"content\": \"ок\"},\n7087|                {\"role\": \"user\", \"content\": _uf_part(\"image/gif\")},\n7088|            ]\n7089|            images = cast(\n7090|                \"list[dict[str, object]]\",\n7091|                _bfn(\"_collect_images\")(mixed, \"gemini-4-argon\", \"low\", True),\n7092|            )\n7093|            self.assertEqual(\n7094|                [(_int(i[\"index\"]), i[\"mime\"]) for i in images],\n7095|                [(1, \"image/png\"), (2, \"image/jpeg\"), (3, \"image/gif\")],\n7096|            )\n7097|            bridge = _HttpBridge()\n7098|            try:\n7099|                code, _b = bridge.post(_img_body(mixed[:1], model=_UF_TEXT_ONLY))\n7100|                code_all, _ba = bridge.post(_img_body(mixed, model=_UF_TEXT_ONLY))\n7101|                audio_only: list[dict[str, object]] = [\n7102|                    {\n7103|                        \"role\": \"user\",\n7104|                        \"content\": [\n7105|                            {\"type\": \"text\", \"text\": \"послушай\"},\n7106|                            {\n7107|                                \"type\": \"audio\",\n7108|                                \"text\": \"LEAK\",\n7109|                                \"audio\": {\"data\": \"PAYLOAD\"},\n7110|                            },\n7111|                        ],\n7112|                    }\n7113|                ]\n7114|                env.clear_records()\n7115|                with _UfLog() as log:\n7116|                    code_a, _bu = bridge.post(\n7117|                        _img_body(audio_only, model=_UF_TEXT_ONLY)\n7118|                    )\n7119|            finally:\n7120|                bridge.close()\n7121|            self.assertEqual((code, code_all, code_a), (200, 200, 200))\n7122|            only_audio = env.records()\n7123|            self.assertEqual(len(only_audio), 1)\n7124|            self.assertNotIn(\"--add-dir\", _argv_of(only_audio[0]))\n7125|            self.assertIn(\"[media omitted]\", _str(only_audio[0][\"prompt\"]))\n7126|            self.assertIn(\"послушай\", _str(only_audio[0][\"prompt\"]))\n7127|            _uf_assert_media_free(\n7128|                self, _str(only_audio[0][\"prompt\"]), (\"LEAK\", \"PAYLOAD\")\n7129|            )\n7130|            self.assertEqual(len(log.events()), 1)\n7131|            self.assertIn(\"reason=unsupported_media\", log.events()[0])\n7132|            env.assert_clean(self)\n7133|        secret = \"PAYLOAD_SECRET_12345\"\n7134|        unknown_only: list[tuple[str, object]] = [\n7135|            (\"A_dict_input_video\", {\"type\": \"input_video\", \"data\": secret}),\n7136|            (\"B_list_input_video_text\", [{\"type\": \"input_video\", \"text\": secret}]),\n7137|            (\"C_text_with_struct\", [{\"type\": \"text\", \"text\": {\"inlineData\": secret}}]),\n7138|            (\"D_case_variant_key\", {\"InlineData\": secret}),\n7139|            (\"E_foo_bar\", {\"foo\": {\"bar\": secret}}),\n7140|        ]\n7141|        with _UniEnv() as env_u:\n7142|            bridge_u = _HttpBridge()\n7143|            try:\n7144|                for name, content in unknown_only:\n7145|                    for stream in (False, True):\n7146|                        with self.subTest(case=name, stream=stream):\n7147|                            env_u.clear_records()\n7148|                            body = _img_body(\n7149|                                [{\"role\": \"user\", \"content\": content}],\n7150|                                model=_UF_TEXT_ONLY,\n7151|                                stream=stream,\n7152|                            )\n7153|                            with _UfLog() as log_u:\n7154|                                if stream:\n7155|                                    sse = _sse_post(bridge_u.port, body)\n7156|                                    self.assertNotIn('\"error\"', sse)\n7157|                                    self.assertTrue(sse.endswith(\"data: [DONE]\\n\\n\"))\n7158|                                    code_u = 200\n7159|                                else:\n7160|                                    code_u, _bu2 = bridge_u.post(body)\n7161|                            self.assertEqual(code_u, 200)\n7162|                            recs_u = env_u.records()\n7163|                            self.assertEqual(len(recs_u), 1)\n7164|                            prompt_u = _str(recs_u[0][\"prompt\"])\n7165|                            self.assertNotIn(secret, prompt_u)\n7166|                            self.assertNotIn(secret, \" \".join(_argv_of(recs_u[0])))\n7167|                            self.assertIn(\"[media omitted]\", prompt_u)\n7168|                            self.assertNotIn(\"--add-dir\", _argv_of(recs_u[0]))\n7169|                            events_u = log_u.events()\n7170|                            self.assertEqual(len(events_u), 1, events_u)\n7171|                            self.assertIn(\"stage=collect\", events_u[0])\n7172|                            self.assertIn(\"reason=unsupported_media\", events_u[0])\n7173|                            self.assertNotIn(secret, log_u.text())\n7174|                            env_u.assert_clean(self)\n7175|            finally:\n7176|                bridge_u.close()\n7177|\n7178|    def test_uf07b_optimistic_mixed_media_keeps_raster_drops_audio(self) -> None:\n7179|        with _UniEnv() as env:\n7180|            msgs: list[dict[str, object]] = [\n7181|                {\n7182|                    \"role\": \"user\",\n7183|                    \"content\": [\n7184|                        {\"type\": \"text\", \"text\": \"сравни\"},\n7185|                        {\"type\": \"input_image\", \"image_url\": _uf_url(\"image/png\")},\n7186|                        {\"type\": \"image\", \"image\": {\"url\": _uf_url(\"image/jpeg\")}},\n7187|                        {\n7188|                            \"type\": \"input_audio\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52d","stream":{"kind":"session","id":"01a18867-6e63-7e20-94f6-182c50533d35"},"sequence":241,"recorded_at":1780531400000477,"record_type":"event","durability":"durable","causation_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18867-7752-7bf0-a25d-29f7e2be7882","run_stream":{"kind":"run","id":"01a18867-7752-7bf0-a25d-29f7e2be7882"},"call_id":"call_01a18869a2aa735fb2df1d1e51d7ee08","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(499 line(s) above)\n500|    raw = os.environ.get(\"BRIDGE_ENABLE_ADAPTIVE_WATCHDOG\", \"1\").strip().lower()\n501|    return raw not in (\"0\", \"false\", \"no\", \"off\")\n502|\n503|\n504|# Имена диагностических событий и причин отказа (мышление, изображения) длиннее 24\n505|# символов, но секретами не являются: без исключения маска скрыла бы их в логах.\n506|# Только точное совпадение токена целиком, не префикс и не подстрока.\n507|_LOG_EVENT_NAMES = frozenset(\n508|    {\n509|        \"sqlite_snapshot_divergence\",\n510|        \"sqlite_transcript_divergence\",\n511|        \"image_input_not_supported\",\n512|        \"unsupported_reasoning_effort\",\n513|        \"invalid_reasoning_effort\",\n514|        \"unsupported_image_type\",\n515|        \"invalid_image_content\",\n516|        \"invalid_image_base64\",\n517|        \"image_url_not_allowed\",\n518|        \"image_type_mismatch\",\n519|        \"image_proof_invalid\",\n520|        \"images_too_large\",\n521|        \"image_too_large\",\n522|        \"too_many_images\",\n523|        \"image_spool_error\",\n524|        \"image_cleanup_error\",\n525|        \"image_sweep_removed\",\n526|        \"media-degradation-reserve\",\n527|    }\n528|)\n529|\n530|\n531|def _mask_token(match: re.Match[str]) -> str:\n532|    token = match.group(0)\n533|    return token if token in _LOG_EVENT_NAMES else \"***\"\n534|\n535|\n536|def _mask_secrets(text: str) -> str:\n537|    \"\"\"Погасить токеноподобные последовательности и сам ключ моста.\"\"\"\n538|    out = str(text)\n539|    if AUTH_KEY:\n540|        out = out.replace(AUTH_KEY, \"***\")\n541|    return _SECRET.sub(_mask_token, out)\n542|\n543|\n544|def _err_summary(err: Any, limit: int = 200) -> str:\n545|    text = \" \".join(str(err or \"\").split())\n546|    return text[:limit]\n547|\n548|\n549|# Порог неактивности хода (без протокольных событий и без прироста CPU/потомков группы).\n550|IDLE_TIMEOUT_S = _idle_timeout_from_env()\n551|# Зачистка группы: сколько ждать после SIGTERM и сколько — reap лидера после SIGKILL.\n552|KILL_TERM_GRACE_S = 2.0\n553|KILL_WAIT_S = 5.0\n554|# После result ERROR процесс обязан выйти сам: сколько ждать done, прежде чем сдаться.\n555|RESULT_EXIT_GRACE_S = 5.0\n556|# События очереди, считающиеся активностью агента (result/done/pump_error — терминальные).\n557|_ACTIVITY_KINDS = frozenset({\"init\", \"text\", \"reasoning\", \"tool_trace\"})\n558|\n559|\n560|def _launch_env() -> dict:\n561|    \"\"\"Окружение для `agy`. Ключ моста потомку не передаётся.\n562|\n563|    Прокси-переменные (HTTPS_PROXY/HTTP_PROXY/NO_PROXY) выставляет сам лончер\n564|    agy-cli.sh — мост их не дублирует и не переопределяет.\n565|    \"\"\"\n566|    env = os.environ.copy()\n567|    env.pop(\"AGY_BRIDGE_KEY\", None)\n568|    return env\n569|\n570|\n571|class LauncherUnavailable(Exception):\n572|    \"\"\"Канонический лончер отсутствует или не исполняем.\"\"\"\n573|\n574|\n575|def _launcher() -> str:\n576|    \"\"\"Канонический лончер обязателен; запасного пути на голый бинарь нет.\n577|\n578|    Без лончера agy гео-заблокирован (РФ), поэтому «fallback на голый бинарник»\n579|    запрещён: это дало бы тихий отказ вместо честной ошибки.\n580|    \"\"\"\n581|    if os.path.isfile(LAUNCHER) and os.access(LAUNCHER, os.X_OK):\n582|        return LAUNCHER\n583|    raise LauncherUnavailable(LAUNCHER)\n584|\n585|\n586|def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n587|    hdr = handler.headers.get(\"Authorization\", \"\")\n588|    if hdr.startswith(\"Bearer \"):\n589|        return hdr[7:].strip() == AUTH_KEY\n590|    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n591|\n592|\n593|def _flatten_content(content: Any, img_counter: list[int] | None = None) -> str:\n594|    \"\"\"Контент сообщения в текст; с `img_counter` image-части дают маркеры `[image N]`.\"\"\"\n595|    if content is None:\n596|        return \"\"\n597|    if isinstance(content, str):\n598|        return content\n599|    if isinstance(content, list):\n600|        parts: list[str] = []\n601|        for item in content:\n602|            if isinstance(item, str):\n603|                parts.append(item)\n604|            elif (\n605|                img_counter is not None\n606|                and isinstance(item, dict)\n607|                and item.get(\"type\") == \"image_url\"\n608|            ):\n609|                img_counter[0] += 1\n610|                parts.append(\"[image %d]\" % img_counter[0])\n611|            elif isinstance(item, dict) and \"text\" in item:\n612|                parts.append(str(item[\"text\"]))\n613|        return \"\\n\".join(p for p in parts if p)\n614|    return str(content)\n615|\n616|\n617|def _tool_choice_none(tool_choice: Any) -> bool:\n618|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n619|\n620|\n621|@final\n622|class ImageReject(ValueError):\n623|    \"\"\"Отказ по изображениям: `reason` — деталь для журнала, `code` — тип HTTP 400.\"\"\"\n624|\n625|    def __init__(self, reason: str, code: str = \"image_input_not_supported\") -> None:\n626|        super().__init__(reason)\n627|        self.reason = reason\n628|        self.code = code\n629|\n630|\n631|@final\n632|class ImageSpoolError(RuntimeError):\n633|    \"\"\"Проверенные изображения не удалось материализовать на диск.\"\"\"\n634|\n635|\n636|_B64_WS = re.compile(r\"[ \\t\\r\\n\\f\\v]\")\n637|_STATUS_REASONS = frozenset(\n638|    {\"status_unsupported\", \"status_probe\", \"model_unknown\", \"input_not_image\"}\n639|)\n640|\n641|\n642|def _safe_log_value(value: object) -> str:\n643|    \"\"\"Значение из запроса для строки журнала: управляющие символы -> `_`.\"\"\"\n644|    return re.sub(r\"[\\x00-\\x1f\\x7f]\", \"_\", str(value))\n645|\n646|\n647|def _file_sha256(path: object) -> str:\n648|    \"\"\"SHA-256 файла чанками по 1 MiB; '' — файл недоступен или изменился при чтении.\n649|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
