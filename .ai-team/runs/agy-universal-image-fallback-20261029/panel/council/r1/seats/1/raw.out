{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c45f","stream":{"kind":"session","id":"01a18848-1677-7cd0-8ed1-1686210acc41"},"sequence":138,"recorded_at":1780531400000271,"record_type":"event","durability":"durable","causation_id":"01a18848-1f5a-7b43-8448-1cadd826db81","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18848-1f5a-7b43-8448-1cadd826db81","run_stream":{"kind":"run","id":"01a18848-1f5a-7b43-8448-1cadd826db81"},"call_id":"call_01a18848d8df728ca0d71090f8ef1117","text":"Read text file `/tmp/council-server.diff`.\n1|diff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\n2|index f5d7405..a6bf02d 100644\n3|--- a/bridges/agy-bridge/server.py\n4|+++ b/bridges/agy-bridge/server.py\n5|@@ -197,6 +197,7 @@ IMAGE_STATUSES = (\"unsupported\", \"unverified\", \"probe\", \"confirmed\")\n6| IMPLEMENTED_METHODS = {\"workspace-read\": 1}\n7| METHOD_IMPL_VERSION = 1\n8| IMAGE_FLAG_NAME = \"IMAGE_INPUT_ENABLED\"\n9|+IMAGE_FALLBACK_FLAG_NAME = \"IMAGE_FALLBACK_ENABLED\"\n10| IMAGE_PROBE = os.environ.get(\"AGY_IMAGE_PROBE\", \"\").strip().lower() in (\n11|     \"1\",\n12|     \"true\",\n13|@@ -261,6 +262,8 @@ _sha_compute_lock = threading.Lock()\n14| _sha_cache: dict[str, tuple[tuple[int, int, int, int], str]] = {}\n15| _image_flag_lock = threading.Lock()\n16| _image_flag_cache: tuple[float, bool] = (0.0, False)\n17|+_image_fallback_flag_lock = threading.Lock()\n18|+_image_fallback_flag_cache: tuple[float, bool] = (0.0, False)\n19| _active_img_dirs: set[str] = set()\n20| \n21| # Токеноподобные последовательности в логах: сам ключ моста и длинные hex/base64.\n22|@@ -786,6 +789,298 @@ def _image_gate(model_id: str, effort: str | None) -> ImageReject | None:\n23|     return ImageReject(\"image_proof_invalid\")\n24| \n25| \n26|+def _read_image_fallback_flag() -> bool:\n27|+    \"\"\"IMAGE_FALLBACK_ENABLED из dynamic_config.json: строго `true`, иначе False.\"\"\"\n28|+    try:\n29|+        path = DYNAMIC_CONFIG_PATH\n30|+        if not path.is_file() or path.stat().st_size > DYNAMIC_CONFIG_MAX_BYTES:\n31|+            return False\n32|+        data = cast(object, json.loads(path.read_text(encoding=\"utf-8\")))\n33|+    except (OSError, ValueError):\n34|+        return False\n35|+    if not isinstance(data, dict):\n36|+        return False\n37|+    return cast(\"dict[str, object]\", data).get(IMAGE_FALLBACK_FLAG_NAME) is True\n38|+\n39|+\n40|+def _is_image_fallback_enabled() -> bool:\n41|+    \"\"\"Универсальная политика image-входа (по умолчанию False = строгий режим).\n42|+\n43|+    Env `AGY_IMAGE_FALLBACK_ENABLED` (непустой) решает сразу: 1|true|yes -> True,\n44|+    любое иное значение (в т. ч. 0|false|no|on|off) -> False. Без env — флаг\n45|+    `IMAGE_FALLBACK_ENABLED` в dynamic_config.json с кэшем TTL 1.0 с и отдельным\n46|+    замком; не-boolean, битый или отсутствующий файл дают False. Не зависит от\n47|+    `IMAGE_INPUT_ENABLED` (он по-прежнему управляет только staging файлов).\n48|+    \"\"\"\n49|+    global _image_fallback_flag_cache\n50|+    env = os.environ.get(\"AGY_IMAGE_FALLBACK_ENABLED\", \"\").strip().lower()\n51|+    if env:\n52|+        return env in (\"1\", \"true\", \"yes\")\n53|+    now = time.monotonic()\n54|+    with _image_fallback_flag_lock:\n55|+        checked_at, cached = _image_fallback_flag_cache\n56|+        if checked_at > 0.0 and now - checked_at < FLAG_TTL_S:\n57|+            return cached\n58|+    value = _read_image_fallback_flag()\n59|+    with _image_fallback_flag_lock:\n60|+        _image_fallback_flag_cache = (now, value)\n61|+    return value\n62|+\n63|+\n64|+def _image_gate_universal(model_id: str, effort: str | None) -> ImageReject | None:\n65|+    \"\"\"Универсальный допуск: staging включён, модель из каталога, effort валиден.\n66|+\n67|+    Per-model proof, SHA бинаря и `efforts_proven` не проверяются и не читаются.\n68|+    \"\"\"\n69|+    if not _is_image_input_enabled():\n70|+        return ImageReject(\"image_input_disabled\")\n71|+    model = FLEET_MODELS.get(model_id)\n72|+    if model is None:\n73|+        return ImageReject(\"model_unknown\")\n74|+    if effort:\n75|+        efforts = model.get(\"efforts\")\n76|+        if not isinstance(efforts, list) or effort not in cast(\"list[object]\", efforts):\n77|+            return ImageReject(\"effort_not_proven\", \"unsupported_reasoning_effort\")\n78|+    return None\n79|+\n80|+\n81|+# ---- Универсальная нормализация медиа (AD-002) ---------------------------------------\n82|+\n83|+_IMAGE_PART_TYPES = frozenset({\"image_url\", \"image\", \"input_image\"})\n84|+_IMAGE_PAYLOAD_KEYS = (\"image_url\", \"image\")\n85|+_MEDIA_PART_NAMES = (\n86|+    \"input_audio\",\n87|+    \"audio\",\n88|+    \"video\",\n89|+    \"video_url\",\n90|+    \"file\",\n91|+    \"document\",\n92|+    \"inlineData\",\n93|+    \"inline_data\",\n94|+    \"fileData\",\n95|+    \"file_data\",\n96|+)\n97|+_MEDIA_PART_TYPES = frozenset(name.lower() for name in _MEDIA_PART_NAMES)\n98|+_TEXT_PART_TYPES = frozenset({\"text\", \"input_text\", \"output_text\"})\n99|+_IMAGE_OMITTED = \"[image omitted]\"\n100|+_MEDIA_OMITTED = \"[media omitted]\"\n101|+_JSON_COPY_MAX_DEPTH = 32\n102|+\n103|+\n104|+def _classify_part(part: dict[str, object]) -> str:\n105|+    \"\"\"'image' | 'media' | 'text' | 'unknown'; медиа определяется ДО чтения `text`.\"\"\"\n106|+    raw_kind = part.get(\"type\")\n107|+    kind = raw_kind.strip().lower() if isinstance(raw_kind, str) else \"\"\n108|+    if kind in _IMAGE_PART_TYPES or any(\n109|+        part.get(key) is not None for key in _IMAGE_PAYLOAD_KEYS\n110|+    ):\n111|+        return \"image\"\n112|+    if kind in _MEDIA_PART_TYPES or any(\n113|+        part.get(key) is not None for key in _MEDIA_PART_NAMES\n114|+    ):\n115|+        return \"media\"\n116|+    if (not kind or kind in _TEXT_PART_TYPES) and isinstance(part.get(\"text\"), str):\n117|+        return \"text\"\n118|+    return \"unknown\"\n119|+\n120|+\n121|+def _content_items(content: object) -> list[object]:\n122|+    \"\"\"Части контента: list как есть, dict-content — одна часть, прочее — пусто.\"\"\"\n123|+    if isinstance(content, list):\n124|+        return cast(\"list[object]\", content)\n125|+    if isinstance(content, dict):\n126|+        return [content]\n127|+    return []\n128|+\n129|+\n130|+def _image_part_canonical(part: dict[str, object]) -> dict[str, object]:\n131|+    \"\"\"Image-алиас в форме `image_url`; `image_url` приоритетнее `image`, URL не угадывается.\"\"\"\n132|+    payload = part.get(\"image_url\")\n133|+    if payload is None:\n134|+        payload = part.get(\"image\")\n135|+    url: object = None\n136|+    if isinstance(payload, str):\n137|+        url = payload\n138|+    elif isinstance(payload, dict):\n139|+        url = cast(\"dict[str, object]\", payload).get(\"url\")\n140|+    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n141|+\n142|+\n143|+def _media_part_counts(messages: object) -> tuple[int, int]:\n144|+    \"\"\"(image-частей, прочих media-частей) во всей истории.\"\"\"\n145|+    images = 0\n146|+    other = 0\n147|+    if not isinstance(messages, list):\n148|+        return images, other\n149|+    for msg in cast(\"list[object]\", messages):\n150|+        if not isinstance(msg, dict):\n151|+            continue\n152|+        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n153|+            if not isinstance(item, dict):\n154|+                continue\n155|+            kind = _classify_part(cast(\"dict[str, object]\", item))\n156|+            if kind == \"image\":\n157|+                images += 1\n158|+            elif kind == \"media\":\n159|+                other += 1\n160|+    return images, other\n161|+\n162|+\n163|+def _collect_image_parts_universal(\n164|+    messages: object,\n165|+) -> list[tuple[int, int, dict[str, object]]]:\n166|+    \"\"\"Все image-части истории (любой алиас, list и dict-content) в форме `image_url`.\"\"\"\n167|+    found: list[tuple[int, int, dict[str, object]]] = []\n168|+    if not isinstance(messages, list):\n169|+        return found\n170|+    number = 0\n171|+    for msg_index, msg in enumerate(cast(\"list[object]\", messages)):\n172|+        if not isinstance(msg, dict):\n173|+            continue\n174|+        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n175|+            if not isinstance(item, dict):\n176|+                continue\n177|+            part = cast(\"dict[str, object]\", item)\n178|+            if _classify_part(part) == \"image\":\n179|+                number += 1\n180|+                found.append((msg_index, number, _image_part_canonical(part)))\n181|+    return found\n182|+\n183|+\n184|+def _json_copy(value: object, depth: int = 0) -> object:\n185|+    \"\"\"Копия JSON-значения без разделяемых контейнеров (глубина ограничена).\"\"\"\n186|+    if depth > _JSON_COPY_MAX_DEPTH:\n187|+        return None\n188|+    if isinstance(value, dict):\n189|+        return {\n190|+            str(k): _json_copy(v, depth + 1)\n191|+            for k, v in cast(\"dict[object, object]\", value).items()\n192|+        }\n193|+    if isinstance(value, list):\n194|+        return [_json_copy(v, depth + 1) for v in cast(\"list[object]\", value)]\n195|+    if value is None or isinstance(value, (str, int, float, bool)):\n196|+        return value\n197|+    return str(value)\n198|+\n199|+\n200|+def _flatten_content_stripped(content: object) -> str:\n201|+    \"\"\"Контент в безопасный текст без media: image -> `[image omitted]`, media -> `[media omitted]`.\n202|+\n203|+    Обычный текст сохраняется в порядке следования (склейка `\\\\n`), неизвестные\n204|+    структурные объекты не сериализуются; сообщение только из них даёт\n205|+    `[media omitted]`, чтобы контекст не стал пустым.\n206|+    \"\"\"\n207|+    if content is None:\n208|+        return \"\"\n209|+    if isinstance(content, str):\n210|+        return content\n211|+    parts: list[str] = []\n212|+    dropped = False\n213|+    for item in _content_items(content):\n214|+        if isinstance(item, str):\n215|+            parts.append(item)\n216|+        elif isinstance(item, dict):\n217|+            part = cast(\"dict[str, object]\", item)\n218|+            kind = _classify_part(part)\n219|+            if kind == \"image\":\n220|+                parts.append(_IMAGE_OMITTED)\n221|+            elif kind == \"media\":\n222|+                parts.append(_MEDIA_OMITTED)\n223|+            elif kind == \"text\":\n224|+                parts.append(cast(str, part[\"text\"]))\n225|+            else:\n226|+                dropped = True\n227|+        elif isinstance(item, list):\n228|+            dropped = True\n229|+    if not parts and dropped:\n230|+        parts.append(_MEDIA_OMITTED)\n231|+    return \"\\n\".join(p for p in parts if p)\n232|+\n233|+\n234|+def _strip_media_from_messages(messages: object) -> list[dict[str, object]]:\n235|+    \"\"\"Новый список сообщений без media; вход не мутируется, роли и порядок сохранены.\"\"\"\n236|+    out: list[dict[str, object]] = []\n237|+    if not isinstance(messages, list):\n238|+        return out\n239|+    for msg in cast(\"list[object]\", messages):\n240|+        if not isinstance(msg, dict):\n241|+            continue\n242|+        fresh: dict[str, object] = {}\n243|+        for key, value in cast(\"dict[object, object]\", msg).items():\n244|+            if key == \"content\":\n245|+                fresh[\"content\"] = _flatten_content_stripped(value)\n246|+            else:\n247|+                fresh[str(key)] = _json_copy(value)\n248|+        out.append(fresh)\n249|+    return out\n250|+\n251|+\n252|+def _messages_to_stripped_prompt(messages: object) -> str:\n253|+    \"\"\"Промпт всей истории без media: нет `[image N]`, `[attachments]`, путей и payload.\"\"\"\n254|+    return _messages_to_prompt(\n255|+        cast(\"list[object]\", _strip_media_from_messages(messages))\n256|+    )\n257|+\n258|+\n259|+def _universal_render_messages(messages: object) -> list[object]:\n260|+    \"\"\"Копия истории для оптимистичной отправки: image — каноничные, прочее media — вон.\n261|+\n262|+    Длина и индексы сохранены (нужны сквозной нумерации `[image N]` и resume-срезу).\n263|+    \"\"\"\n264|+    out: list[object] = []\n265|+    if not isinstance(messages, list):\n266|+        return out\n267|+    for msg in cast(\"list[object]\", messages):\n268|+        if not isinstance(msg, dict):\n269|+            out.append(msg)\n270|+            continue\n271|+        src = cast(\"dict[str, object]\", msg)\n272|+        fresh = dict(src)\n273|+        raw_content = src.get(\"content\")\n274|+        if isinstance(raw_content, (list, dict)):\n275|+            items: list[object] = []\n276|+            for item in _content_items(src.get(\"content\")):\n277|+                if isinstance(item, str):\n278|+                    items.append(item)\n279|+                elif isinstance(item, dict):\n280|+                    part = cast(\"dict[str, object]\", item)\n281|+                    kind = _classify_part(part)\n282|+                    if kind == \"image\":\n283|+                        items.append(_image_part_canonical(part))\n284|+                    elif kind == \"text\":\n285|+                        items.append({\"type\": \"text\", \"text\": part[\"text\"]})\n286|+            fresh[\"content\"] = items\n287|+        out.append(fresh)\n288|+    return out\n289|+\n290|+\n291|+def _log_token(value: object, max_len: int = 64) -> str:\n292|+    \"\"\"Идентификатор для журнала: только `A-Za-z0-9_.-`, остальное `_`, длина ограничена.\"\"\"\n293|+    text = re.sub(r\"[^A-Za-z0-9_.\\-]\", \"_\", str(value))[:max_len]\n294|+    return text or \"unknown\"\n295|+\n296|+\n297|+_IMAGE_FALLBACK_STAGES = frozenset({\"collect\", \"post_slot\", \"spool\", \"runtime\"})\n298|+\n299|+\n300|+def _log_image_fallback(\n301|+    stage: str, reason: str, model: str, attempt: int, count: int\n302|+) -> None:\n303|+    \"\"\"Одна структурная строка `image_fallback` на фактический downgrade (без payload).\"\"\"\n304|+    stage_token = stage if stage in _IMAGE_FALLBACK_STAGES else \"unknown\"\n305|+    model_token = _log_token(model) if model in FLEET_MODELS else \"unknown\"\n306|+    _log(\n307|+        \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\"\n308|+        % (\n309|+            stage_token,\n310|+            _log_token(reason),\n311|+            model_token,\n312|+            max(0, min(int(attempt), 9)),\n313|+            max(0, min(int(count), 1000000)),\n314|+        )\n315|+    )\n316|+\n317|+\n318| def _collect_image_parts(\n319|     messages: object,\n320| ) -> list[tuple[int, int, dict[str, object]]]:\n321|@@ -833,7 +1128,7 @@ def _new_img_dir() -> Path:\n322| \n323| \n324| def _collect_images(\n325|-    messages: object, model_id: str, effort: str | None\n326|+    messages: object, model_id: str, effort: str | None, universal: bool = False\n327| ) -> list[dict[str, object]]:\n328|     \"\"\"Проверить image-части всей истории; вернуть записи для prompt и spool.\n329| \n330|@@ -842,11 +1137,23 @@ def _collect_images(\n331|     оценка размера base64 ДО decode, строгий base64, сигнатура, лимиты. Ничего не\n332|     пишется на диск и не запускается. Декодированные байты не удерживаются\n333|     (`data` пуст): в spool они пересоздаются из base64 уже после захвата слота.\n334|+\n335|+    `universal=True`: image-алиасы (`image`, `input_image`, dict-content) приводятся\n336|+    к `image_url`, а вместо proof-гейта работает `_image_gate_universal`; остальные\n337|+    проверки те же. Любой отказ отбрасывает ВСЕ записи (исключение, без частичного набора).\n338|     \"\"\"\n339|-    parts = _collect_image_parts(messages)\n340|+    parts = (\n341|+        _collect_image_parts_universal(messages)\n342|+        if universal\n343|+        else _collect_image_parts(messages)\n344|+    )\n345|     if not parts:\n346|         return []\n347|-    gate = _image_gate(model_id, effort)\n348|+    gate = (\n349|+        _image_gate_universal(model_id, effort)\n350|+        if universal\n351|+        else _image_gate(model_id, effort)\n352|+    )\n353|     if gate is not None:\n354|         raise gate\n355|     max_images = _limit(\"max_images\", 16)\n356|@@ -977,6 +1284,62 @@ def _cleanup_img_dir(img_dir: Path) -> None:\n357|             _active_img_dirs.discard(str(img_dir))\n358| \n359| \n360|+_IMAGE_MARKER = re.compile(r\"\\[image \\d+\\]\")\n361|+\n362|+\n363|+def _text_only_prompt_fallback(prompt: str) -> str:\n364|+    \"\"\"Безопасный media-free промпт из готового: без `[attachments]` и `[image N]`.\n365|+\n366|+    Запасной путь для вызывающих `_run_once` без предвычисленного\n367|+    `stripped_full_prompt`; штатно промпт берётся из `_messages_to_stripped_prompt`.\n368|+    \"\"\"\n369|+    cut = prompt.rfind(\"[attachments]\\n\")\n370|+    if cut == 0 or (cut > 0 and prompt[cut - 2 : cut] == \"\\n\\n\"):\n371|+        prompt = prompt[:cut].rstrip()\n372|+    text = _IMAGE_MARKER.sub(_IMAGE_OMITTED, prompt).strip()\n373|+    return text or \"Reply with exactly: PONG\"\n374|+\n375|+\n376|+def _downgrade_to_text_in_run_once(\n377|+    ctx: dict[str, object],\n378|+    stage: str,\n379|+    reason: str,\n380|+    attempt: int,\n381|+    img_dir: Path | None,\n382|+) -> None:\n383|+    \"\"\"Перевести ход в text-only: журнал, каталог, CID и оба промпта (AD-003).\n384|+\n385|+    Порядок: событие (счёт ДО обнуления) -> удаление собственного каталога ->\n386|+    CAS-инвалидация и снятие владения старым CID -> `prompt`/`full_prompt` из\n387|+    предвычисленной media-free истории. Run вызывающий уже закрыл; повторный\n388|+    вызов безопасен (cleanup идемпотентен, CID уже пуст).\n389|+    \"\"\"\n390|+    held = cast(\"list[dict[str, object]]\", ctx.get(\"images\") or [])\n391|+    _log_image_fallback(stage, reason, str(ctx.get(\"model\") or \"\"), attempt, len(held))\n392|+    if img_dir is not None:\n393|+        _cleanup_img_dir(img_dir)\n394|+    old_cid = str(ctx.get(\"conversation_id\") or \"\")\n395|+    if old_cid:\n396|+        sess_key = ctx.get(\"sess_key\")\n397|+        if sess_key:\n398|+            _session_invalidate(cast(tuple, sess_key), old_cid)\n399|+        _cid_release(old_cid, str(ctx.get(\"turn_id\") or \"\"))\n400|+        if ctx.get(\"hot_resumed\"):\n401|+            with _session_store_lock:\n402|+                _in_flight_cids.discard(old_cid)\n403|+    stripped = ctx.get(\"stripped_full_prompt\")\n404|+    if not isinstance(stripped, str) or not stripped:\n405|+        stripped = _text_only_prompt_fallback(\n406|+            str(ctx.get(\"full_prompt\") or ctx.get(\"prompt\") or \"\")\n407|+        )\n408|+    ctx[\"hot_resumed\"] = False\n409|+    ctx[\"conversation_id\"] = \"\"\n410|+    ctx[\"images\"] = []\n411|+    ctx[\"img_dir\"] = None\n412|+    ctx[\"prompt\"] = stripped\n413|+    ctx[\"full_prompt\"] = stripped\n414|+\n415|+\n416| def _attachments_block(images: list[dict[str, object]]) -> str:\n417|     lines = [\n418|         \"[attachments]\",\n419|@@ -1234,9 +1597,11 @@ def _reset_sqlite_guards_for_tests() -> None:\n420|     global _compat_ident, _compat_state, _flag_value, _flag_key, _flag_checked_at\n421|     global _sqlite_divergence_count, _sqlite_drain_deadline_count\n422|     global _sqlite_open_connections, _sqlite_max_open_connections, _rng\n423|-    global _image_flag_cache\n424|+    global _image_flag_cache, _image_fallback_flag_cache\n425|     with _image_flag_lock:\n426|         _image_flag_cache = (0.0, False)\n427|+    with _image_fallback_flag_lock:\n428|+        _image_fallback_flag_cache = (0.0, False)\n429|     with _sha_cache_lock:\n430|         _sha_cache.clear()\n431|     with _sqlite_guard_lock:\n432|@@ -2853,6 +3218,35 @@ class _ByteBudget:\n433|             self.used = max(0, self.used - amount)\n434| \n435| \n436|+def _image_fallback_view() -> tuple[dict[str, object], dict[str, bool]]:\n437|+    \"\"\"Эффективная image-поддержка по каталогу и объект `image_fallback` для GET.\n438|+\n439|+    universal -> поддержка = staging включён (для каждой модели каталога, proof не\n440|+    подделывается); иначе строгий `_model_supports_images`. Булевы `images` остаются\n441|+    булевыми, новая информация — только в отдельном объекте.\n442|+    \"\"\"\n443|+    universal = _is_image_fallback_enabled()\n444|+    input_enabled = _is_image_input_enabled()\n445|+    effective = {\n446|+        mid: (input_enabled if universal else _model_supports_images(mid))\n447|+        for mid in FLEET_MODELS\n448|+    }\n449|+    if universal:\n450|+        acceptance = \"optimistic\" if input_enabled else \"text-only\"\n451|+    else:\n452|+        acceptance = \"proof-gated\"\n453|+    info: dict[str, object] = {\n454|+        \"fallback_enabled\": universal,\n455|+        \"input_enabled\": input_enabled,\n456|+        \"mode\": \"universal\" if universal else \"strict\",\n457|+        \"acceptance\": acceptance,\n458|+        \"method\": \"workspace-read\",\n459|+        \"limits\": dict(IMAGE_LIMITS),\n460|+        \"models\": [mid for mid, ok in effective.items() if ok],\n461|+    }\n462|+    return info, effective\n463|+\n464|+\n465| def _terminal_state(name: str, err: str = \"\") -> dict[str, object]:\n466|     \"\"\"Итог хода без запуска agy (отказ до spawn).\"\"\"\n467|     return {\n468|@@ -3173,38 +3567,62 @@ class Handler(BaseHTTPRequestHandler):\n469|                     cast(str, ctx[\"model\"]), unavailable, t_enter, cast(str, ctx[\"tag\"])\n470|                 )\n471|                 return unavailable\n472|+            universal = bool(typed_ctx.get(\"universal_fallback\"))\n473|             if images and img_dir is not None:\n474|-                # Флаг и proof могли смениться, пока ход ждал слот: повторная проверка\n475|-                # до mkdir и spawn.\n476|-                gate = _image_gate(cast(str, model), cast(str, effort))\n477|-                if gate is not None:\n478|-                    self._log_reject(\n479|-                        gate.code, cast(str, model), cast(int, ctx[\"model_len\"])\n480|-                    )\n481|-                    rejected = _terminal_state(\"image_reject\", gate.code)\n482|-                    self._log_done(\n483|-                        cast(str, ctx[\"model\"]),\n484|-                        rejected,\n485|-                        t_enter,\n486|-                        cast(str, ctx[\"tag\"]),\n487|+                if universal and not _is_image_input_enabled():\n488|+                    # Staging выключили, пока ход ждал слот: media не отправляем,\n489|+                    # ход идёт текстом (без mkdir и --add-dir).\n490|+                    _downgrade_to_text_in_run_once(\n491|+                        typed_ctx, \"post_slot\", \"flag_disabled\", 1, img_dir\n492|                     )\n493|-                    return rejected\n494|-                # Реестр активных каталогов ПЕРЕД mkdir: sweep не тронет живой ход.\n495|-                with _active_lock:\n496|-                    _active_img_dirs.add(str(img_dir))\n497|-                img_registered = True\n498|-                try:\n499|-                    _stage_images(img_dir, images)\n500|-                except ImageSpoolError as exc:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
