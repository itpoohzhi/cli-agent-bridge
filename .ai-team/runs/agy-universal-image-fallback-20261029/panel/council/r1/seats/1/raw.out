_bridge_resilience.py\",\n20|      \"exit_code\": 0\n21|    },\n22|    {\n23|      \"command\": \"VER-002 run-guarded -- env uvx ruff@0.17.3 format --check --no-cache server.py tests/test_agy_bridge_resilience.py\",\n24|      \"exit_code\": 0\n25|    },\n26|    {\n27|      \"command\": \"VER-003 run-guarded -- python3 -B (unittest: Image*, AcceptanceOracleTests, UniversalImageFallbackTests) Ran 58 OK\",\n28|      \"exit_code\": 0\n29|    },\n30|    {\n31|      \"command\": \"VER-004 run-guarded -- basedpyright@1.40.2 delta vs BASE (baseline 792, candidate 787, new 0)\",\n32|      \"exit_code\": 0\n33|    },\n34|    {\n35|      \"command\": \"VER-006 run-guarded -- append-only prefix 249933 bytes + test_images_strict.py\",\n36|      \"exit_code\": 0\n37|    },\n38|    {\n39|      \"command\": \"VER-007 run-guarded -- AST assertion coverage 40+10 IDs\",\n40|      \"exit_code\": 0\n41|    },\n42|    {\n43|      \"command\": \"VER-008 run-guarded -- scope frozen (2 allowed paths, fleet byte-identical, 5 Stage1 hashes)\",\n44|      \"exit_code\": 0\n45|    },\n46|    {\n47|      \"command\": \"VER-009 run-guarded -- static image security contract / helpers / cache reset\",\n48|      \"exit_code\": 0\n49|    },\n50|    {\n51|      \"command\": \"VER-005 run-guarded -- env PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider (3 collection errors, identical on BASE)\",\n52|      \"exit_code\": 2\n53|    },\n54|    {\n55|      \"command\": \"pytest==9.0.3 tests/test_agy_bridge_resilience.py tests/test_images_strict.py -> 176 passed, 273 subtests passed\",\n56|      \"exit_code\": 0\n57|    },\n58|    {\n59|      \"command\": \"python3 -B -m unittest discover -s tests -p test_agy_bridge_resilience.py (146 legacy tests on candidate server.py)\",\n60|      \"exit_code\": 0\n61|    },\n62|    {\n63|      \"command\": \"uf tests against BASE server.py (red check): 12 tests, failures=36 errors=55\",\n64|      \"exit_code\": 1\n65|    },\n66|    {\n67|      \"command\": \"VER-010 run-guarded -- deployed config/hash + live-acceptance.json receipt (release scope, not applied)\",\n68|      \"exit_code\": 1\n69|    }\n70|  ],\n71|  \"acceptance_coverage\": [\n72|    {\n73|      \"requirement\": \"REQ-01 optimistic admission любой catalog model/effort без proof/SHA\",\n74|      \"verification\": [\n75|        \"VER-003\",\n76|        \"uf01\",\n77|        \"uf03b\"\n78|      ]\n79|    },\n80|    {\n81|      \"requirement\": \"REQ-02 ImageReject/ImageSpoolError/flag-off -> text-only turn, без media-derived 400/500\",\n82|      \"verification\": [\n83|        \"VER-003\",\n84|        \"uf02\",\n85|        \"uf03\",\n86|        \"uf04\"\n87|      ]\n88|    },\n89|    {\n90|      \"requirement\": \"REQ-03 runtime guard: ровно один text-only повтор до обеих legacy-веток, очистка dir/CID/hot\",\n91|      \"verification\": [\n92|        \"VER-003\",\n93|        \"uf05\",\n94|        \"uf06\",\n95|        \"uf08\"\n96|      ]\n97|    },\n98|    {\n99|      \"requirement\": \"REQ-04 append-only, strict и fleet не изменены\",\n100|      \"verification\": [\n101|        \"VER-001\",\n102|        \"VER-002\",\n103|        \"VER-004\",\n104|        \"VER-006\",\n105|        \"VER-007\",\n106|        \"VER-008\",\n107|        \"146 legacy tests\"\n108|      ]\n109|    },\n110|    {\n111|      \"requirement\": \"REQ-05 production activation\",\n112|      \"verification\": [\n113|        \"НЕ ВЫПОЛНЕНО: VER-010, release scope\"\n114|      ]\n115|    },\n116|    {\n117|      \"requirement\": \"REQ-06 полный stripping истории, dict-content, non-image media, идемпотентность\",\n118|      \"verification\": [\n119|        \"VER-003\",\n120|        \"VER-009\",\n121|        \"uf07\",\n122|        \"uf07b\",\n123|        \"uf09\"\n124|      ]\n125|    }\n126|  ],\n127|  \"assumptions\": [\n128|    \"Скилл universal/coder/SKILL.md отсутствует на диске; применены orchestrate-coder-reviewer-summarizer, references/steps.md и aisdlc-gcge/skills/feature.md.\",\n129|    \"Строковый image_url/image и type=input_image принимаются universal-канонизацией (AD-002 aliases), поэтому taxonomy-кейс string_image_url в universal не отклоняется, а отправляется оптимистично.\",\n130|    \"stripped_full_prompt вычисляется только если в истории есть структурное media (иначе равен full_prompt): downgrade возможен только при images, то есть при наличии media.\",\n131|    \"Reserve деградации реализован как однократный повтор после _retry_take(): токен списывается если есть, при нехватке глобальный бюджет не уменьшается и не пополняется.\"\n132|  ],\n133|  \"risks\": [\n134|    \"VER-005 как заморожен красный на BASE и кандидате: сбор tests/test_cache_usage.py, test_fleet_v3.py, test_tool_parser.py падает (module 'server' коллизия, нет tests.bridge_testlib); эквивалентный прогон agy+strict под pytest: 176 passed.\",\n135|    \"VER-010 не PASS: нет деплоя server.py и IMAGE_FALLBACK_ENABLED=true в ~/.dsh/bridges/agy-bridge/dynamic_config.json, нет live-acceptance.json; нужны Teamlead/release и живой чат владельца.\",\n136|    \"До 2N запусков CLI в худшем батче image-failure (RISK-008): квоты/p99/CPU/RSS/FD не измерены.\",\n137|    \"Retry без доставки не даёт exactly-once: нативные побочные эффекты CLI до сбоя возможны (RISK-001).\",\n138|    \"Полноценного pixel-decode нет: валидация по сигнатуре сохранена (ASM-002).\"\n139|  ],\n140|  \"open_questions\": [\n141|    \"Нужен ли Teamlead отдельный фикс сбора полного pytest-набора (3 несвязанных модуля) для VER-005, или принять эквивалентный прогон?\",\n142|    \"Когда и кем будет выполнен деплой server.py + запись IMAGE_INPUT_ENABLED/IMAGE_FALLBACK_ENABLED=true и live-приёмка VER-010?\"\n143|  ],\n144|  \"artifacts\": {\n145|    \"server_py_sha256\": \"2e76b99f789c4a37906aeae107e37551249643588ce231a78ef57b89477f9cb4\",\n146|    \"tests_sha256\": \"ce5360d5722a71b1faffb087292d0268a03582844a16c392f47029bd4f7e706d\",\n147|    \"fingerprint_after\": \".ai-team/runs/agy-universal-image-fallback-20