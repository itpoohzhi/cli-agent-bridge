{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a18848-1677-7cd0-8ed1-1686210acc41"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"01a18848-1f5a-7b43-8448-1cadd826db81","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a18848-1f5a-7b43-8448-1cadd826db81","run_stream":{"kind":"run","id":"01a18848-1f5a-7b43-8448-1cadd826db81"},"task_stream":{"kind":"task","id":"01a1884a-f289-7ab0-bcdc-7093d4d955ac"},"task_id":"01a1884a-f289-7ab0-bcdc-7093d4d955ac","event":{"kind":"output","task_id":"01a1884a-f289-7ab0-bcdc-7093d4d955ac","chunk":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(3689 line(s) above)\n3690|                    break\n3691|                # Выдача клиенту: текст, tool_calls или уже отданное в поток мышление.\n3692|                # JSON-режим мышление клиенту ещё не отдавал — там повтор безопасен.\n3693|                typed_out = cast(\"dict[str, object]\", out)\n3694|                delivered_reasoning = bool(\n3695|                    typed_out.get(\"delivered_reasoning\")\n3696|                ) or bool(typed_ctx.get(\"stream\") and typed_out.get(\"reasoning\"))\n3697|                delivered = bool(\n3698|                    typed_out.get(\"text\")\n3699|                    or typed_out.get(\"tool_calls\")\n3700|                    or delivered_reasoning\n3701|                )\n3702|                if (\n3703|                    attempt == 1\n3704|                    and universal\n3705|                    and images\n3706|                    and img_dir is not None\n3707|                    and out[\"state\"] not in (\"done\", \"client_gone\")\n3708|                    and not delivered\n3709|                ):\n3710|                    # Реальная image-попытка упала без выдачи: один text-only повтор\n3711|                    # ДО обеих legacy-веток (hot continue и transient). Один токен\n3712|                    # бюджета, если есть; иначе — разовый резерв деградации запроса.\n3713|                    _downgrade_to_text_in_run_once(\n3714|                        typed_ctx,\n3715|                        \"runtime\",\n3716|                        _log_token(typed_out.get(\"state\")),\n3717|                        attempt,\n3718|                        img_dir,\n3719|                    )\n3720|                    images = []\n3721|                    img_dir = None\n3722|                    img_registered = False\n3723|                    if not _retry_take():\n3724|                        _log(f\"media-degradation-reserve state={out['state']} {tag}\")\n3725|                    time.sleep(_retry_pause_s(attempt))\n3726|                    continue\n3727|                if ctx.get(\"hot_resumed\") and out[\"state\"] != \"client_gone\":\n3728|                    # Горячая сессия сломалась: больше её не используем, а повтор\n3729|                    # идёт холодным вызовом с полной историей.\n3730|                    _session_invalidate(ctx[\"sess_key\"], ctx[\"conversation_id\"])\n3731|                    _cid_release(\n3732|                        str(ctx[\"conversation_id\"]), str(ctx.get(\"turn_id\") or \"\")\n3733|                    )\n3734|                    ctx[\"hot_resumed\"] = False\n3735|                    ctx[\"conversation_id\"] = \"\"\n3736|                    ctx[\"prompt\"] = ctx[\"full_prompt\"]\n3737|                    if out[\"state\"] == \"agy_error\" and not delivered:\n3738|                        if not _retry_take():\n3739|                            _log(f\"retry-budget-exhausted state={out['state']} {tag}\")\n3740|                            break\n3741|                        _log(\n3742|                            f\"hot session failed err={_err_summary(out.get('err'), 120)!r}, \"\n3743|                            f\"cold fallback {tag}\"\n3744|                        )\n3745|                        continue\n3746|                # Транзиентный сбой до выдачи клиенту — один невидимый повтор.\n3747|                transient = (\n3748|                    out[\"state\"] in (\"agy_error\", \"pump_error\", \"done\")\n3749|                    and not delivered\n3750|                )\n3751|                if not transient or attempt == 2:\n3752|                    break\n3753|                if not _retry_take():\n3754|                    _log(f\"retry-budget-exhausted state={out['state']} {tag}\")\n3755|                    break\n3756|                _log(\n3757|                    f\"transient failure state={out['state']} rc={out.get('rc')} \"\n3758|                    f\"err={_err_summary(out.get('err'), 120)!r}, retry {attempt} {tag}\"\n3759|                )\n3760|                time.sleep(_retry_pause_s(attempt))\n3761|            if (\n3762|                out.get(\"state\") == \"done\"\n3763|                and out.get(\"conversation_id\")\n3764|                and ctx.get(\"sess_key\")\n3765|            ):\n3766|                _session_commit(ctx[\"sess_key\"], str(out[\"conversation_id\"]))\n3767|            if out.get(\"state\") != \"client_gone\":\n3768|                _last_ok[0] = (\n3769|                    time.monotonic()\n3770|                    if (out.get(\"state\") == \"done\" and out.get(\"rc\") == 0)\n3771|                    else 0.0\n3772|                )\n3773|        finally:\n3774|            # Каталог изображений живёт весь ход (все попытки) и уходит до слота.\n3775|            if img_registered and img_dir is not None:\n3776|                _cleanup_img_dir(img_dir)\n3777|            _slots.release()\n3778|        self._log_done(\n3779|            cast(str, ctx[\"model\"]),\n3780|            cast(\"dict[str, object]\", out),\n3781|            t0,\n3782|            cast(str, ctx[\"tag\"]),\n3783|        )\n3784|        return out\n3785|\n3786|    @staticmethod\n3787|    def _usage_payload(usage: dict) -> dict:\n3788|        \"\"\"usage agy -> OpenAI-поля. thinking_tokens прибавляем к completion.\"\"\"\n3789|        return {\n3790|            \"prompt_tokens\": usage.get(\"input_tokens\", 0),\n3791|            \"completion_tokens\": usage.get(\"output_tokens\", 0)\n3792|            + usage.get(\"thinking_tokens\", 0),\n3793|            \"total_tokens\": usage.get(\"total_tokens\", 0),\n3794|        }\n3795|\n3796|    @staticmethod\n3797|    def _error_body(out: dict) -> Any:\n3798|        st = out.get(\"state\")\n3799|        if st == \"timeout\":\n3800|            return {\n3801|                \"message\": f\"agy timed out after {TIMEOUT_S}s\",\n3802|                \"type\": \"timeout\",\n3803|                \"code\": 504,\n3804|            }\n3805|        if st == \"idle_timeout\":\n3806|            return {\n3807|                \"message\": f\"agy execution idle timeout after {IDLE_TIMEOUT_S:g}s \"\n3808|                \"(no activity or progress in process group)\",\n3809|                \"type\": \"idle_timeout\",\n3810|                \"code\": 504,\n3811|            }\n3812|        if st == \"first_token_timeout\":\n3813|            return {\n3814|                \"message\": f\"first_token_timeout: agy gave no event within \"\n3815|                f\"{FIRST_TOKEN_TIMEOUT_S:g}s\",\n3816|                \"type\": \"first_token_timeout\",\n3817|                \"code\": 504,\n3818|            }\n3819|        if st == \"queue_timeout\":\n(more lines below)","final_result":true}}}
