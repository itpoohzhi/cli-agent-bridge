                          cast(str, ctx[\"model\"]),\n526|+                            rejected,\n527|+                            t_enter,\n528|+                            cast(str, ctx[\"tag\"]),\n529|+                        )\n530|+                        return rejected\n531|+                    # Реестр активных каталогов ПЕРЕД mkdir: sweep не тронет живой ход.\n532|+                    with _active_lock:\n533|+                        _active_img_dirs.add(str(img_dir))\n534|+                    img_registered = True\n535|+                    try:\n536|+                        _stage_images(img_dir, images)\n537|+                    except ImageSpoolError as exc:\n538|+                        _log(\n539|+                            \"image_spool_error model=%s err=%s\"\n540|+                            % (_safe_log_value(cast(str, model)), exc)\n541|+                        )\n542|+                        if not universal:\n543|+                            failed = _terminal_state(\"image_spool_error\", str(exc))\n544|+                            self._log_done(\n545|+                                cast(str, ctx[\"model\"]),\n546|+                                failed,\n547|+                                t_enter,\n548|+                                cast(str, ctx[\"tag\"]),\n549|+                            )\n550|+                            return failed\n551|+                        _downgrade_to_text_in_run_once(\n552|+                            typed_ctx, \"spool\", \"image_spool_error\", 1, img_dir\n553|+                        )\n554|+                        images = []\n555|+                        img_dir = None\n556|+                        img_registered = False\n557|             _retry_credit()\n558|             for attempt in (1, 2):\n559|                 _log(\n560|@@ -3272,11 +3690,40 @@ class Handler(BaseHTTPRequestHandler):\n561|                     break\n562|                 # Выдача клиенту: текст, tool_calls или уже отданное в поток мышление.\n563|                 # JSON-режим мышление клиенту ещё не отдавал — там повтор безопасен.\n564|+                typed_out = cast(\"dict[str, object]\", out)\n565|+                delivered_reasoning = bool(\n566|+                    typed_out.get(\"delivered_reasoning\")\n567|+                ) or bool(typed_ctx.get(\"stream\") and typed_out.get(\"reasoning\"))\n568|                 delivered = bool(\n569|-                    out.get(\"text\")\n570|-                    or out.get(\"tool_calls\")\n571|-                    or (ctx.get(\"stream\") and out.get(\"reasoning\"))\n572|+                    typed_out.get(\"text\")\n573|+                    or typed_out.get(\"tool_calls\")\n574|+                    or delivered_reasoning\n575|                 )\n576|+                if (\n577|+                    attempt == 1\n578|+                    and universal\n579|+                    and images\n580|+                    and img_dir is not None\n581|+                    and out[\"state\"] not in (\"done\", \"client_gone\")\n582|+                    and not delivered\n583|+                ):\n584|+                    # Реальная image-попытка упала без выдачи: один text-only повтор\n585|+                    # ДО обеих legacy-веток (hot continue и transient). Один токен\n586|+                    # бюджета, если есть; иначе — разовый резерв деградации запроса.\n587|+                    _downgrade_to_text_in_run_once(\n588|+                        typed_ctx,\n589|+                        \"runtime\",\n590|+                        _log_token(typed_out.get(\"state\")),\n591|+                        attempt,\n592|+                        img_dir,\n593|+                    )\n594|+                    images = []\n595|+                    img_dir = None\n596|+                    img_registered = False\n597|+                    if not _retry_take():\n598|+                        _log(f\"media-degradation-reserve state={out['state']} {tag}\")\n599|+                    time.sleep(_retry_pause_s(attempt))\n600|+                    continue\n601|                 if ctx.get(\"hot_resumed\") and out[\"state\"] != \"client_gone\":\n602|                     # Горячая сессия сломалась: больше её не используем, а повтор\n603|                     # идёт холодным вызовом с полной историей.\n604|@@ -3420,6 +3867,7 @@ class Handler(BaseHTTPRequestHandler):\n605|         if path in (\"/health\", \"/v1/health\"):\n606|             with _active_lock:\n607|                 active = len(_active)\n608|+            fallback_info, effective = _image_fallback_view()\n609|             health: dict[str, object] = {\n610|                 \"ok\": True,\n611|                 \"transport\": \"agy-stream-json\",\n612|@@ -3430,7 +3878,8 @@ class Handler(BaseHTTPRequestHandler):\n613|                 \"tool_emulation\": False,\n614|                 \"tool_translation\": False,\n615|                 \"native_tools\": True,\n616|-                \"images\": any(_model_supports_images(mid) for mid in FLEET_MODELS),\n617|+                \"images\": any(effective.values()),\n618|+                \"image_fallback\": fallback_info,\n619|                 \"image_input_mode\": (\n620|                     \"enabled\" if _is_image_input_enabled() else \"disabled\"\n621|                 ),\n622|@@ -3455,9 +3904,10 @@ class Handler(BaseHTTPRequestHandler):\n623|             data = []\n624|             order = [MODEL_ID] + [mid for mid in FLEET[\"order\"] if mid != MODEL_ID]\n625|             image_flags: list[bool] = []\n626|+            fallback_info, effective = _image_fallback_view()\n627|             for mid in order:\n628|                 model = FLEET[\"models\"][mid]\n629|-                supports = _model_supports_images(cast(str, mid))\n630|+                supports = effective[cast(str, mid)]\n631|                 image_flags.append(supports)\n632|                 data.append(\n633|                     {\n634|@@ -3470,7 +3920,13 @@ class Handler(BaseHTTPRequestHandler):\n635|                     }\n636|                 )\n637|             self._send(\n638|-                200, {\"object\": \"list\", \"data\": data, \"images\": any(image_flags)}\n639|+                200,\n640|+                {\n641|+                    \"object\": \"list\",\n642|+                    \"data\": data,\n643|+                    \"images\": any(image_flags),\n644|+                    \"image_fallback\": fallback_info,\n645|+                },\n646|             )\n647|             return\n648|         self._send(\n649|@@ -3625,20 +4081,70 @@ class Handler(BaseHTTPRequestHandler):\n650|                 if isinstance(messages_raw, list)\n651|                 else []\n652|             )\n653|-            try:\n654|-                images = _collect_images(\n655|-                    messages, cast(str, model_id), cast(str, effort)\n656|-                )\n657|-            except ImageReject as rejected:\n658|-                _log(\"image_reject detail=%s\" % rejected.reason)\n659|-                self._reject(\n660|-                    400,\n661|-                    rejected.code,\n662|-                    f\"image rejected: {rejected.code}\",\n663|-                    model_id,\n664|-                    model_len,\n665|-                )\n666|-                return\n667|+            # Универсальная политика фиксируется один раз на принятый запрос.\n668|+            universal = _is_image_fallback_enabled()\n669|+            images: list[dict[str, object]] = []\n670|+            render_messages: list[object] = messages\n671|+            stripped_full_prompt = \"\"\n672|+            force_cold = False\n673|+            if universal:\n674|+                image_parts, other_media = _media_part_counts(messages)\n675|+                if image_parts or other_media:\n676|+                    stripped_full_prompt = _messages_to_stripped_prompt(messages)\n677|+                    if not _is_image_input_enabled():\n678|+                        _log_image_fallback(\n679|+                            \"collect\",\n680|+                            \"flag_disabled\",\n681|+                            cast(str, model_id),\n682|+                            1,\n683|+                            image_parts,\n684|+                        )\n685|+                        force_cold = True\n686|+                    else:\n687|+                        try:\n688|+                            images = _collect_images(\n689|+                                messages,\n690|+                                cast(str, model_id),\n691|+                                cast(str, effort),\n692|+                                universal=True,\n693|+                            )\n694|+                        except ImageReject as rejected:\n695|+                            _log_image_fallback(\n696|+                                \"collect\",\n697|+                                rejected.reason,\n698|+                                cast(str, model_id),\n699|+                                1,\n700|+                                image_parts,\n701|+                            )\n702|+                            images = []\n703|+                            force_cold = True\n704|+                        else:\n705|+                            if images:\n706|+                                render_messages = _universal_render_messages(messages)\n707|+                            else:\n708|+                                _log_image_fallback(\n709|+                                    \"collect\",\n710|+                                    \"unsupported_media\",\n711|+                                    cast(str, model_id),\n712|+                                    1,\n713|+                                    other_media,\n714|+                                )\n715|+                                force_cold = True\n716|+            else:\n717|+                try:\n718|+                    images = _collect_images(\n719|+                        messages, cast(str, model_id), cast(str, effort)\n720|+                    )\n721|+                except ImageReject as rejected:\n722|+                    _log(\"image_reject detail=%s\" % rejected.reason)\n723|+                    self._reject(\n724|+                        400,\n725|+                        rejected.code,\n726|+                        f\"image rejected: {rejected.code}\",\n727|+                        model_id,\n728|+                        model_len,\n729|+                    )\n730|+                    return\n731|             img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n732|             try:\n733|                 _launcher()\n734|@@ -3658,7 +4164,12 @@ class Handler(BaseHTTPRequestHandler):\n735|                 else []\n736|             )\n737|             tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n738|-            full_prompt = _messages_to_prompt(messages, images)\n739|+            if force_cold:\n740|+                full_prompt = stripped_full_prompt\n741|+            else:\n742|+                full_prompt = _messages_to_prompt(render_messages, images)\n743|+                if universal:\n744|+                    stripped_full_prompt = stripped_full_prompt or full_prompt\n745|             extra = (\n746|                 req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n747|             )\n748|@@ -3679,7 +4190,11 @@ class Handler(BaseHTTPRequestHandler):\n749|             )\n750|             is_resumed = False\n751|             prompt = full_prompt\n752|-            if conversation_id:\n753|+            if force_cold:\n754|+                # Media убраны из истории: «грязный» явный или кэшированный CID\n755|+                # не возобновляем, ход идёт холодным text-only с полной историей.\n756|+                conversation_id = \"\"\n757|+            elif conversation_id:\n758|                 if _cid_acquire(conversation_id, turn_id):\n759|                     owned_cid = conversation_id\n760|                 else:\n761|@@ -3691,7 +4206,7 @@ class Handler(BaseHTTPRequestHandler):\n762|                 if use_cid:\n763|                     conversation_id = use_cid\n764|                     is_resumed = True\n765|-                    prompt = _get_resumed_turn_prompt(messages, images)\n766|+                    prompt = _get_resumed_turn_prompt(render_messages, images)\n767|             ctx: dict[str, object] = {\n768|                 \"turn_id\": turn_id,\n769|                 \"sess_key\": sess_key,\n770|@@ -3712,6 +4227,8 @@ class Handler(BaseHTTPRequestHandler):\n771|                 \"stream\": bool(req.get(\"stream\")),\n772|                 \"images\": images,\n773|                 \"img_dir\": img_dir,\n774|+                \"universal_fallback\": universal,\n775|+                \"stripped_full_prompt\": stripped_full_prompt,\n776|             }\n777|             if ctx[\"stream\"]:\n778|                 self._serve_sse(ctx)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
