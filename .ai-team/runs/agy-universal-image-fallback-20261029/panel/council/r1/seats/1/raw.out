{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c593","stream":{"kind":"session","id":"01a18848-1677-7cd0-8ed1-1686210acc41"},"sequence":292,"recorded_at":1780531400000579,"record_type":"event","durability":"durable","causation_id":"01a18848-1f5a-7b43-8448-1cadd826db81","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18848-1f5a-7b43-8448-1cadd826db81","run_stream":{"kind":"run","id":"01a18848-1f5a-7b43-8448-1cadd826db81"},"call_id":"call_01a1884a92417766b642c8e3f4c8ff8c","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(584 line(s) above)\n585|def _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n586|    hdr = handler.headers.get(\"Authorization\", \"\")\n587|    if hdr.startswith(\"Bearer \"):\n588|        return hdr[7:].strip() == AUTH_KEY\n589|    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n590|\n591|\n592|def _flatten_content(content: Any, img_counter: list[int] | None = None) -> str:\n593|    \"\"\"Контент сообщения в текст; с `img_counter` image-части дают маркеры `[image N]`.\"\"\"\n594|    if content is None:\n595|        return \"\"\n596|    if isinstance(content, str):\n597|        return content\n598|    if isinstance(content, list):\n599|        parts: list[str] = []\n600|        for item in content:\n601|            if isinstance(item, str):\n602|                parts.append(item)\n603|            elif (\n604|                img_counter is not None\n605|                and isinstance(item, dict)\n606|                and item.get(\"type\") == \"image_url\"\n607|            ):\n608|                img_counter[0] += 1\n609|                parts.append(\"[image %d]\" % img_counter[0])\n610|            elif isinstance(item, dict) and \"text\" in item:\n611|                parts.append(str(item[\"text\"]))\n612|        return \"\\n\".join(p for p in parts if p)\n613|    return str(content)\n614|\n615|\n616|def _tool_choice_none(tool_choice: Any) -> bool:\n617|    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n618|\n619|\n620|@final\n621|class ImageReject(ValueError):\n622|    \"\"\"Отказ по изображениям: `reason` — деталь для журнала, `code` — тип HTTP 400.\"\"\"\n623|\n624|    def __init__(self, reason: str, code: str = \"image_input_not_supported\") -> None:\n625|        super().__init__(reason)\n626|        self.reason = reason\n627|        self.code = code\n628|\n629|\n630|@final\n631|class ImageSpoolError(RuntimeError):\n632|    \"\"\"Проверенные изображения не удалось материализовать на диск.\"\"\"\n633|\n634|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c595","stream":{"kind":"session","id":"01a18848-1677-7cd0-8ed1-1686210acc41"},"sequence":293,"recorded_at":1780531400000581,"record_type":"event","durability":"durable","causation_id":"01a18848-1f5a-7b43-8448-1cadd826db81","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a18848-1f5a-7b43-8448-1cadd826db81","run_stream":{"kind":"run","id":"01a18848-1f5a-7b43-8448-1cadd826db81"},"call_id":"call_01a1884a96627535b87b84a55664cefe","text":"Read text file `/Users/aazhiry1/tmp/cli-agent-bridge/agy-universal-image-fallback/bridges/agy-bridge/server.py`.\n(1364 line(s) above)\n1365|\n1366|\n1367|def _render_message(\n1368|    msg: Any, counter: list, img_counter: list[int] | None = None\n1369|) -> str:\n1370|    \"\"\"Сообщение OpenAI в текстовый блок промпта (роли не теряются).\"\"\"\n1371|    if not isinstance(msg, dict):\n1372|        return \"\"\n1373|    role = str(msg.get(\"role\") or \"user\")\n1374|    name = msg.get(\"name\")\n1375|    label = role if not name else \"%s(%s)\" % (role, name)\n1376|    body = _flatten_content(msg.get(\"content\"), img_counter)\n1377|    lines = []\n1378|    calls = msg.get(\"tool_calls\")\n1379|    if isinstance(calls, list):\n1380|        for call in calls:\n1381|            if not isinstance(call, dict):\n1382|                continue\n1383|            fn = call.get(\"function\") if isinstance(call.get(\"function\"), dict) else {}\n1384|            fname = str(fn.get(\"name\") or \"unknown\")\n1385|            fargs = fn.get(\"arguments\")\n1386|            if not isinstance(fargs, str):\n1387|                fargs = (\n1388|                    json.dumps(fargs, ensure_ascii=False) if fargs is not None else \"{}\"\n1389|                )\n1390|            lines.append(\n1391|                \"[tool call %s] %s(%s)\" % (call.get(\"id\") or \"call\", fname, fargs)\n1392|            )\n1393|    if role == \"tool\":\n1394|        cid = msg.get(\"tool_call_id\") or \"call\"\n1395|        lines.append(\"[tool result %s] %s\" % (cid, body))\n1396|    elif body:\n1397|        lines.append(body)\n1398|    prepared = \"\\n\".join(lines).strip()\n1399|    if not prepared:\n1400|        return \"\"\n1401|    counter[0] += 1\n1402|    return \"### %d. %s\\n%s\" % (counter[0], label, prepared)\n1403|\n1404|\n1405|def _messages_to_prompt(\n1406|    messages: list,\n1407|    images: list[dict[str, object]] | None = None,\n1408|    img_start: int = 0,\n1409|) -> str:\n1410|    \"\"\"Собрать единый текстовый промпт хода.\n1411|\n1412|    Секции протокола инструментов нет намеренно: agy исполняет СВОИ нативные\n1413|    инструменты, а не инструменты DSH (см. README, раздел «Инструменты»).\n1414|    Image-части получают сквозные маркеры `[image N]` (нумерация с `img_start + 1`),\n1415|    а `images` описываются блоком `[attachments]` с абсолютными путями файлов.\n1416|    \"\"\"\n1417|    counter = [0]\n1418|    img_counter = [img_start]\n1419|    blocks: list[str] = []\n1420|    for msg in messages:\n1421|        rendered = _render_message(msg, counter, img_counter)\n1422|        if rendered:\n1423|            blocks.append(rendered)\n1424|    if images:\n1425|        blocks.append(_attachments_block(images))\n1426|    text = \"\\n\\n\".join(blocks).strip()\n1427|    if not text:\n1428|        text = \"Reply with exactly: PONG\"\n1429|    return text\n1430|\n1431|\n1432|def _get_resumed_turn_prompt(\n1433|    messages: list, images: list[dict[str, object]] | None = None\n1434|) -> str:\n1435|    \"\"\"Промпт хода продолжения: сообщения после последнего assistant.\n1436|\n1437|    Маркеры сохраняют сквозные номера всей истории; `[attachments]` — только для\n1438|    изображений новых сообщений. Без assistant в истории — вся история целиком.\n1439|    \"\"\"\n1440|    last_asst = -1\n1441|    for i in range(len(messages) - 1, -1, -1):\n1442|        if isinstance(messages[i], dict) and messages[i].get(\"role\") == \"assistant\":\n1443|            last_asst = i\n1444|            break\n1445|    if last_asst >= 0 and last_asst + 1 < len(messages):\n1446|        new_msgs = messages[last_asst + 1 :]\n1447|        skipped = len(\n1448|            _collect_image_parts(cast(\"list[object]\", messages[: last_asst + 1]))\n1449|        )\n1450|        delta = [\n1451|            img\n1452|            for img in (images or [])\n1453|            if cast(int, img.get(\"msg_index\", 0)) > last_asst\n1454|        ]\n1455|        prompt = _messages_to_prompt(new_msgs, delta, skipped)\n1456|        if prompt:\n1457|            return prompt\n1458|    return _messages_to_prompt(messages, images)\n1459|\n1460|\n1461|def _session_claim(sess_key: tuple, turn_id: str = \"\") -> str:\n1462|    \"\"\"Найти живую свободную сессию и занять её; '' — сессии нет.\n1463|\n1464|    Проверка и занятие идут под одним замком: два параллельных запроса не\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
