{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '6870,7450p' tests/test_agy_bridge_resilience.py\"","aggregated_output":"        store = cast(\"dict[object, object]\", _bval(\"_session_store\"))\n        owners = cast(\"dict[str, str]\", _bval(\"_active_cid_owners\"))\n        in_flight = cast(\"set[str]\", _bval(\"_in_flight_cids\"))\n        with _UniEnv() as env:\n            variants = (\n                \"hot_commit\",\n                \"hot_cas\",\n                \"hot_empty_budget\",\n                \"explicit\",\n                \"plain\",\n            )\n            for variant in variants:\n                with self.subTest(variant=variant):\n                    _uf_reset_runs()\n                    store.clear()\n                    owners.clear()\n                    in_flight.clear()\n                    turn = \"turn-\" + variant\n                    _uf_set_tenths(0 if variant == \"hot_empty_budget\" else 30)\n                    hot = variant.startswith(\"hot\")\n                    over: dict[str, object] = {\n                        \"turn_id\": turn,\n                        \"conversation_id\": _CID,\n                        \"hot_resumed\": hot,\n                        \"sess_key\": None if variant == \"plain\" else key,\n                        \"tools_count\": 0 if variant == \"plain\" else 1,\n                    }\n                    if hot:\n                        store[key] = _uf_store_entry(_CID)\n                        in_flight.add(_CID)\n                    elif variant == \"explicit\":\n                        store[key] = _uf_store_entry(_CID_C)\n                    self.assertTrue(_bfn(\"_cid_acquire\")(_CID, turn))\n                    ctx = _uf_ctx(msgs, over=over)\n                    self.assertIn(\"[attachments]\", _str(ctx[\"full_prompt\"]))\n                    state = {\"calls\": 0}\n\n                    def execute(\n                        _self: object,\n                        _run: object,\n                        *_a: object,\n                        _variant: str = variant,\n                        _state: dict[str, int] = state,\n                    ) -> dict[str, object]:\n                        _state[\"calls\"] += 1\n                        if _state[\"calls\"] == 1:\n                            if _variant == \"hot_cas\":\n                                store[key] = _uf_store_entry(_CID_C)\n                            return _scripted_out(\"agy_error\")\n                        cid = _CID_B if _variant in (\"hot_commit\", \"explicit\") else \"\"\n                        return _scripted_out(\"done\", conversation_id=cid)\n\n                    out = _uf_run_once(ctx, execute)\n                    self.assertEqual(out[\"state\"], \"done\")\n                    self.assertEqual(len(_UfRun.calls), 2)\n                    self.assertEqual(_UfRun.calls[0][\"conversation_id\"], _CID)\n                    self.assertEqual(_UfRun.calls[1][\"conversation_id\"], \"\")\n                    self.assertIsNone(_UfRun.calls[1][\"add_dir\"])\n                    _uf_assert_media_free(self, _str(_UfRun.calls[1][\"prompt\"]))\n                    self.assertIs(ctx[\"hot_resumed\"], False)\n                    self.assertEqual(ctx[\"conversation_id\"], \"\")\n                    self.assertEqual(ctx[\"prompt\"], ctx[\"full_prompt\"])\n                    self.assertNotIn(_CID, owners)\n                    if hot:\n                        self.assertNotIn(_CID, in_flight)\n                    entry = _dict(store.get(key) or {})\n                    if variant == \"hot_commit\":\n                        self.assertEqual(entry.get(\"cid\"), _CID_B)\n                    elif variant == \"hot_cas\":\n                        self.assertEqual(entry.get(\"cid\"), _CID_C)  # чужое не тронуто\n                    elif variant == \"hot_empty_budget\":\n                        self.assertEqual(entry, {})  # устаревший CID инвалидирован\n                    elif variant == \"explicit\":\n                        self.assertEqual(entry.get(\"cid\"), _CID_B)\n                    else:\n                        self.assertEqual(store, {})\n                    env.assert_clean(self)\n            env.scen_uf([{\"cid\": _CID}, {\"cid\": _CID_B}, {\"cid\": _CID_C}])\n            store.clear()\n            bridge = _HttpBridge()\n            valid: list[dict[str, object]] = [\n                _img_msg(_uf_part(\"image/png\")),\n                _txt_msg(\"assistant\", \"ок\"),\n                _txt_msg(\"user\", \"дальше\"),\n            ]\n            dirty: list[dict[str, object]] = [\n                _img_msg(_uf_part(\"image/png\")),\n                _txt_msg(\"assistant\", \"ок\"),\n                _img_msg(_uf_bad_part(), text=\"дальше\"),\n            ]\n            try:\n                self.assertEqual(bridge.post(_img_body(valid[:1], tools=True))[0], 200)\n                self.assertEqual(\n                    bridge.post(_img_body(dirty, tools=True, conv=_CID))[0], 200\n                )\n                self.assertEqual(bridge.post(_img_body(valid, tools=True))[0], 200)\n            finally:\n                bridge.close()\n            first, second, third = env.records()\n            self.assertIn(\"--add-dir\", _argv_of(first))\n            self.assertNotIn(\"--conversation\", _argv_of(second))  # явный CID не resume\n            self.assertNotIn(\"--add-dir\", _argv_of(second))\n            self.assertIn(\"[image omitted]\", _str(second[\"prompt\"]))\n            _uf_assert_media_free(self, _str(second[\"prompt\"]))\n            self.assertEqual(\n                _argv_of(third)[_argv_of(third).index(\"--conversation\") + 1], _CID_B\n            )\n            env.assert_clean(self)\n\n    def test_uf07_media_normalization_is_complete(self) -> None:\n        flatten = _bfn(\"_flatten_content_stripped\")\n        names = (\n            \"image_url\",\n            \"image\",\n            \"input_image\",\n            \"input_audio\",\n            \"audio\",\n            \"video\",\n            \"video_url\",\n            \"file\",\n            \"document\",\n            \"inlineData\",\n            \"inline_data\",\n            \"fileData\",\n            \"file_data\",\n        )\n        image_names = {\"image_url\", \"image\", \"input_image\"}\n        for name in names:\n            want = \"[image omitted]\" if name in image_names else \"[media omitted]\"\n            tainted: dict[str, object] = {\n                \"type\": name,\n                \"text\": \"LEAK-T\",\n                name: {\"data\": \"PAYLOAD-P\", \"url\": \"http://leak.example/x\"},\n            }\n            with self.subTest(kind=\"type\", name=name):\n                for content in ([tainted], tainted):\n                    got = _str(flatten(content))\n                    self.assertEqual(got, want)\n            if name != \"input_image\":\n                keyed: dict[str, object] = {\n                    \"text\": \"LEAK-K\",\n                    name: {\"data\": \"PAYLOAD-K\"},\n                }\n                with self.subTest(kind=\"key\", name=name):\n                    for content in ([keyed], keyed):\n                        self.assertEqual(_str(flatten(content)), want)\n        self.assertEqual(_str(flatten({\"foo\": {\"bar\": \"SECRET\"}})), \"[media omitted]\")\n        self.assertEqual(\n            _str(flatten([\"a\", {\"foo\": 1}, 7, {\"type\": \"text\", \"text\": \"b\"}])), \"a\\nb\"\n        )\n        self.assertEqual(_str(flatten(None)), \"\")\n        original: list[dict[str, object]] = [\n            {\"role\": \"system\", \"content\": \"Система: ✓\"},\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": \"привет https://example.test/doc\"},\n                    _uf_part(\"image/png\"),\n                    {\"type\": \"input_audio\", \"input_audio\": {\"data\": \"PAYLOAD\"}},\n                ],\n            },\n            {\n                \"role\": \"assistant\",\n                \"content\": None,\n                \"tool_calls\": [\n                    {\"id\": \"c1\", \"function\": {\"name\": \"f\", \"arguments\": \"{}\"}}\n                ],\n            },\n            {\n                \"role\": \"tool\",\n                \"tool_call_id\": \"c1\",\n                \"content\": {\"type\": \"file\", \"file\": {\"file_data\": \"PAYLOAD\"}},\n            },\n            {\"role\": \"user\", \"content\": {\"foo\": \"SECRET\"}},\n        ]\n        snapshot = json.dumps(original, sort_keys=True)\n        stripped = cast(\n            \"list[dict[str, object]]\", _bfn(\"_strip_media_from_messages\")(original)\n        )\n        self.assertEqual(json.dumps(original, sort_keys=True), snapshot)\n        self.assertEqual(\n            [m[\"role\"] for m in stripped],\n            [\"system\", \"user\", \"assistant\", \"tool\", \"user\"],\n        )\n        self.assertIsNot(stripped[1], original[1])\n        self.assertEqual(stripped[3][\"content\"], \"[media omitted]\")\n        self.assertEqual(stripped[4][\"content\"], \"[media omitted]\")\n        prompt = _str(_bfn(\"_messages_to_stripped_prompt\")(original))\n        for kept in (\n            \"Система: ✓\",\n            \"привет https://example.test/doc\",\n            \"[image omitted]\",\n        ):\n            self.assertIn(kept, prompt)\n        self.assertIn(\"[media omitted]\", prompt)\n        _uf_assert_media_free(self, prompt, (\"PAYLOAD\", \"SECRET\", \"leak.example\"))\n        again = cast(\n            \"list[dict[str, object]]\", _bfn(\"_strip_media_from_messages\")(stripped)\n        )\n        self.assertEqual(again, stripped)\n        self.assertEqual(_str(_bfn(\"_messages_to_stripped_prompt\")(stripped)), prompt)\n        with _UniEnv() as env:\n            mixed: list[dict[str, object]] = [\n                {\n                    \"role\": \"user\",\n                    \"content\": [\n                        {\"type\": \"text\", \"text\": \"сравни\"},\n                        {\"type\": \"input_image\", \"image_url\": _uf_url(\"image/png\")},\n                        {\"type\": \"image\", \"image\": {\"url\": _uf_url(\"image/jpeg\")}},\n                        {\n                            \"type\": \"input_audio\",\n                            \"text\": \"LEAK\",\n                            \"input_audio\": {\"data\": \"PAYLOAD\"},\n                        },\n                    ],\n                },\n                {\"role\": \"assistant\", \"content\": \"ок\"},\n                {\"role\": \"user\", \"content\": _uf_part(\"image/gif\")},\n            ]\n            images = cast(\n                \"list[dict[str, object]]\",\n                _bfn(\"_collect_images\")(mixed, \"gemini-4-argon\", \"low\", True),\n            )\n            self.assertEqual(\n                [(_int(i[\"index\"]), i[\"mime\"]) for i in images],\n                [(1, \"image/png\"), (2, \"image/jpeg\"), (3, \"image/gif\")],\n            )\n            bridge = _HttpBridge()\n            try:\n                code, _b = bridge.post(_img_body(mixed[:1], model=_UF_TEXT_ONLY))\n                code_all, _ba = bridge.post(_img_body(mixed, model=_UF_TEXT_ONLY))\n                audio_only: list[dict[str, object]] = [\n                    {\n                        \"role\": \"user\",\n                        \"content\": [\n                            {\"type\": \"text\", \"text\": \"послушай\"},\n                            {\n                                \"type\": \"audio\",\n                                \"text\": \"LEAK\",\n                                \"audio\": {\"data\": \"PAYLOAD\"},\n                            },\n                        ],\n                    }\n                ]\n                env.clear_records()\n                with _UfLog() as log:\n                    code_a, _bu = bridge.post(\n                        _img_body(audio_only, model=_UF_TEXT_ONLY)\n                    )\n            finally:\n                bridge.close()\n            self.assertEqual((code, code_all, code_a), (200, 200, 200))\n            only_audio = env.records()\n            self.assertEqual(len(only_audio), 1)\n            self.assertNotIn(\"--add-dir\", _argv_of(only_audio[0]))\n            self.assertIn(\"[media omitted]\", _str(only_audio[0][\"prompt\"]))\n            self.assertIn(\"послушай\", _str(only_audio[0][\"prompt\"]))\n            _uf_assert_media_free(\n                self, _str(only_audio[0][\"prompt\"]), (\"LEAK\", \"PAYLOAD\")\n            )\n            self.assertEqual(len(log.events()), 1)\n            self.assertIn(\"reason=unsupported_media\", log.events()[0])\n            env.assert_clean(self)\n\n    def test_uf07b_optimistic_mixed_media_keeps_raster_drops_audio(self) -> None:\n        with _UniEnv() as env:\n            msgs: list[dict[str, object]] = [\n                {\n                    \"role\": \"user\",\n                    \"content\": [\n                        {\"type\": \"text\", \"text\": \"сравни\"},\n                        {\"type\": \"input_image\", \"image_url\": _uf_url(\"image/png\")},\n                        {\"type\": \"image\", \"image\": {\"url\": _uf_url(\"image/jpeg\")}},\n                        {\n                            \"type\": \"input_audio\",\n                            \"text\": \"LEAK\",\n                            \"input_audio\": {\"data\": \"PAYLOAD\"},\n                        },\n                    ],\n                }\n            ]\n            bridge = _HttpBridge()\n            try:\n                with _UfLog() as log:\n                    code, _b = bridge.post(_img_body(msgs, model=_UF_TEXT_ONLY))\n            finally:\n                bridge.close()\n            self.assertEqual(code, 200)\n            rec = env.records()[0]\n            _expect_files(\n                self,\n                rec,\n                {\n                    1: (\"image/png\", _UF_RASTER[\"image/png\"]),\n                    2: (\"image/jpeg\", _UF_RASTER[\"image/jpeg\"]),\n                },\n            )\n            prompt = _str(rec[\"prompt\"])\n            for kept in (\"сравни\", \"[image 1]\", \"[image 2]\", \"[attachments]\"):\n                self.assertIn(kept, prompt)\n            for dropped in (\"LEAK\", \"PAYLOAD\", \"omitted\"):\n                self.assertNotIn(dropped, prompt)\n            self.assertEqual(log.events(), [])  # лишнее аудио downgrade не вызывает\n            env.assert_clean(self)\n\n    def test_uf08_delivery_and_non_media_failures_do_not_replay(self) -> None:\n        msgs = _uf_msgs(_uf_part(\"image/png\"))\n        with _UniEnv() as env:\n            cases: list[tuple[str, dict[str, object], dict[str, object], int]] = [\n                (\"text_delivered\", {}, {\"text\": \"частично\"}, 1),\n                (\"tool_calls_delivered\", {}, {\"tool_calls\": [{\"id\": \"t\"}]}, 1),\n                (\n                    \"sse_reasoning_delivered\",\n                    {\"stream\": True},\n                    {\"reasoning\": \"мысль\"},\n                    1,\n                ),\n                (\"delivered_reasoning_flag\", {}, {\"delivered_reasoning\": True}, 1),\n                (\"json_reasoning_only\", {\"stream\": False}, {\"reasoning\": \"мысль\"}, 2),\n                (\"sse_empty_reasoning\", {\"stream\": True}, {\"reasoning\": \"\"}, 2),\n            ]\n            for name, over, patch, attempts in cases:\n                with self.subTest(case=name):\n                    _uf_reset_runs()\n                    ctx = _uf_ctx(msgs, over=over)\n                    out = _uf_run_once(\n                        ctx,\n                        _sequence_execute(\n                            [_scripted_out(\"agy_error\", **patch), _scripted_out(\"done\")]\n                        ),\n                    )\n                    self.assertEqual(len(_UfRun.calls), attempts)\n                    self.assertEqual(\n                        out[\"state\"], \"agy_error\" if attempts == 1 else \"done\"\n                    )\n                    if attempts == 1:\n                        self.assertIsNotNone(_UfRun.calls[0][\"add_dir\"])\n                    env.assert_clean(self)\n            with self.subTest(case=\"client_gone\"):\n                _uf_reset_runs()\n                ctx = _uf_ctx(msgs)\n                out = _uf_run_once(\n                    ctx, _sequence_execute([_scripted_out(\"client_gone\")])\n                )\n                self.assertEqual(out[\"state\"], \"client_gone\")\n                self.assertEqual(len(_UfRun.calls), 1)\n                env.assert_clean(self)\n            with self.subTest(case=\"done_bad_rc_empty_output\"):\n                _uf_reset_runs()\n                ctx = _uf_ctx(msgs)\n                out = _uf_run_once(\n                    ctx, _sequence_execute([_scripted_out(\"done\", rc=1, text=\"\")])\n                )\n                self.assertEqual(len(_UfRun.calls), 1)\n                self.assertEqual(out[\"state\"], \"done\")\n                env.assert_clean(self)\n            with self.subTest(case=\"constructor_oserror\"):\n                _uf_reset_runs()\n                ctx = _uf_ctx(msgs)\n                out = _uf_run_once(\n                    ctx, _sequence_execute([_scripted_out(\"done\")]), _UfRaisingRun\n                )\n                self.assertEqual(out[\"state\"], \"pump_error\")\n                self.assertEqual(_UfRaisingRun.calls, 1)\n                env.assert_clean(self)\n            with self.subTest(case=\"launcher_unavailable_direct\"):\n                _uf_reset_runs()\n                ctx = _uf_ctx(msgs)\n                unavailable = cast(\"type[Exception]\", _bval(\"LauncherUnavailable\"))\n\n                def missing() -> str:\n                    raise unavailable(\"x\")\n\n                with (\n                    mock.patch.object(_bridge(), \"_launcher\", missing),\n                    mock.patch.object(_bridge(), \"Run\", _UfRun),\n                    _Sock() as sock,\n                ):\n                    handler = cast(object, _make_handler(sock))\n                    setattr(handler, \"client_address\", (\"127.0.0.1\", 1))\n                    out = _dict(\n                        _ofn(handler, \"_run_once\")(\n                            ctx, _text_sink, _tool_sink, _text_sink, None\n                        )\n                    )\n                self.assertEqual(out[\"state\"], \"launcher_unavailable\")\n                self.assertEqual(_UfRun.calls, [])\n                env.assert_clean(self)\n            with self.subTest(case=\"launcher_unavailable_http_single_response\"):\n                env.fx.patch(\"LAUNCHER\", str(env.fx.tmp / \"no-such-launcher\"))\n                bridge = _HttpBridge()\n                try:\n                    code, body = bridge.post(_img_body(msgs))\n                finally:\n                    bridge.close()\n                self.assertEqual(\n                    (code, _err(body)[\"type\"]), (503, \"launcher_unavailable\")\n                )\n                env.assert_clean(self)\n\n    def test_uf09_full_history_idempotency_and_reentry(self) -> None:\n        history: list[dict[str, object]] = [\n            {\"role\": \"system\", \"content\": \"Правила ✓\"},\n            {\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": \"смотри https://example.test/x?a=1\"},\n                    _uf_part(\"image/webp\"),\n                ],\n            },\n            {\"role\": \"assistant\", \"content\": \"вижу\"},\n            {\"role\": \"tool\", \"tool_call_id\": \"t\", \"content\": \"результат\"},\n            {\"role\": \"user\", \"content\": [_uf_bad_part()]},\n        ]\n        normalize = _bfn(\"_strip_media_from_messages\")\n        render = _bfn(\"_messages_to_stripped_prompt\")\n        once = normalize(history)\n        self.assertEqual(normalize(once), once)\n        prompt = _str(render(history))\n        self.assertEqual(_str(render(once)), prompt)\n        self.assertEqual(prompt.count(\"[image omitted]\"), 2)\n        for kept in (\"Правила ✓\", \"https://example.test/x?a=1\", \"вижу\", \"результат\"):\n            self.assertIn(kept, prompt)\n        self.assertLess(prompt.index(\"Правила\"), prompt.index(\"вижу\"))\n        _uf_assert_media_free(self, prompt)\n        with _UniEnv() as env:\n            env.scen_uf([{\"cid\": _CID}, {\"cid\": _CID_B}, {\"cid\": _CID_C}])\n            bridge = _HttpBridge()\n            cast(\"dict[object, object]\", _bval(\"_session_store\")).clear()\n            old_only: list[dict[str, object]] = [\n                _img_msg(_uf_part(\"image/png\")),\n                _txt_msg(\"assistant\", \"ок\"),\n                _txt_msg(\"user\", \"дальше\"),\n            ]\n            broken_old: list[dict[str, object]] = [\n                _img_msg(_uf_bad_part()),\n                _txt_msg(\"assistant\", \"ок\"),\n                _txt_msg(\"user\", \"дальше\"),\n            ]\n            try:\n                results = [\n                    bridge.post(_img_body(old_only[:1], tools=True))[0],  # холодный\n                    bridge.post(_img_body(old_only, tools=True))[0],  # горячий\n                    bridge.post(_img_body(broken_old, tools=True))[\n                        0\n                    ],  # грязная история\n                    bridge.post(_img_body(old_only, tools=True))[0],  # политика заново\n                ]\n                latest_only = bridge.post(_img_body([_img_msg(_uf_bad_part())]))[0]\n                empty = bridge.post(_img_body([_txt_msg(\"user\", \"\")]))[0]\n            finally:\n                bridge.close()\n            self.assertEqual(results + [latest_only, empty], [200] * 6)\n            recs = env.records()\n            self.assertEqual(len(recs), 6)\n            cold, hot, dirty, again, image_only, empty_rec = recs\n            self.assertNotIn(\"--conversation\", _argv_of(cold))\n            self.assertIn(\"--conversation\", _argv_of(hot))\n            self.assertNotIn(\n                \"[attachments]\", _str(hot[\"prompt\"])\n            )  # вложения только в старой части\n            self.assertNotIn(\"--conversation\", _argv_of(dirty))\n            self.assertNotIn(\"--add-dir\", _argv_of(dirty))\n            _uf_assert_media_free(self, _str(dirty[\"prompt\"]))\n            self.assertIn(\"[image omitted]\", _str(dirty[\"prompt\"]))\n            self.assertIn(\n                \"--conversation\", _argv_of(again)\n            )  # новый CID после деградации\n            self.assertIn(\"[image omitted]\", _str(image_only[\"prompt\"]))\n            self.assertNotIn(\"PONG\", _str(image_only[\"prompt\"]))\n            self.assertIn(\n                \"PONG\", _str(empty_rec[\"prompt\"])\n            )  # прежнее поведение пустого запроса\n            env.assert_clean(self)\n\n    def test_uf10_observability_isolation_and_lifecycle(self) -> None:\n        models = _dict(_bval(\"FLEET_MODELS\"))\n        with _UniEnv() as env:\n            fleet_before = json.dumps(models, sort_keys=True, default=str)\n            bridge = _HttpBridge()\n            try:\n                states: list[tuple[str, object, object, str, set[str]]] = [\n                    (\"strict\", True, False, \"proof-gated\", set(_IMG_TARGETS)),\n                    (\"universal\", True, True, \"optimistic\", set(models)),\n                    (\"universal\", False, True, \"text-only\", set()),\n                    (\"strict\", False, False, \"proof-gated\", set()),\n                ]\n                for mode, input_on, fallback, acceptance, supported in states:\n                    with self.subTest(mode=mode, input=input_on):\n                        env.cfg(input_on, fallback)\n                        code_h, health = bridge.get(\"/health\")\n                        self.assertEqual(code_h, 200)\n                        self.assertIs(health[\"images\"], bool(supported))\n                        info = _dict(health[\"image_fallback\"])\n                        self.assertEqual(info[\"mode\"], mode)\n                        self.assertEqual(info[\"acceptance\"], acceptance)\n                        self.assertIs(info[\"fallback_enabled\"], fallback)\n                        self.assertIs(info[\"input_enabled\"], input_on)\n                        self.assertEqual(\n                            set(cast(\"list[str]\", info[\"models\"])), supported\n                        )\n                        self.assertEqual(info[\"method\"], \"workspace-read\")\n                        self.assertEqual(info[\"limits\"], _bval(\"IMAGE_LIMITS\"))\n                        listing = _get_auth(bridge.port, \"/v1/models\")\n                        rows = cast(\"list[dict[str, object]]\", listing[\"data\"])\n                        self.assertEqual(\n                            {r[\"id\"] for r in rows if r[\"images\"]}, supported\n                        )\n                        self.assertTrue(all(type(r[\"images\"]) is bool for r in rows))\n                        self.assertIs(listing[\"images\"], bool(supported))\n                        self.assertEqual(listing[\"image_fallback\"], info)\n                self.assertEqual(\n                    json.dumps(models, sort_keys=True, default=str), fleet_before\n                )\n                outcomes: list[int] = []\n                for universal in (False, True, False, True, False):\n                    env.cfg(True, universal)\n                    outcomes.append(\n                        bridge.post(\n                            _img_body(\n                                _uf_msgs(_uf_part(\"image/png\")), model=_UF_TEXT_ONLY\n                            )\n                        )[0]\n                    )\n                self.assertEqual(outcomes, [400, 200, 400, 200, 400])\n                env.cfg(True, True)\n                env.clear_records()\n                env.scen_uf([{}], fail_attached=True)\n                fds_before = _open_fds()\n                results: dict[str, int] = {}\n\n                def worker(model: str) -> None:\n                    msgs = _uf_msgs(_uf_part(\"image/png\"), text=\"параллельно \" + model)\n                    results[model] = bridge.post(_img_body(msgs, model=model))[0]\n\n                with _UfLog() as log:\n                    threads = [\n                        threading.Thread(target=worker, args=(m,))\n                        for m in (\"gemini-4-argon\", _UF_TEXT_ONLY)\n                    ]\n                    for thread in threads:\n                        thread.start()\n                    for thread in threads:\n                        thread.join(60)\n                self.assertEqual(set(results.values()), {200})\n                recs = env.records()\n                self.assertEqual(len(recs), 4)\n                self.assertEqual(sum(\"--add-dir\" in _argv_of(r) for r in recs), 2)\n                self.assertEqual(len(log.events()), 2)\n                for line in log.events():\n                    self.assertIsNotNone(_UF_EVENT_RE.match(line), line)\n                    self.assertIn(\"stage=runtime reason=agy_error\", line)\n                text = log.text()\n                self.assertNotIn(_str(_bval(\"AUTH_KEY\")), text)\n                self.assertNotIn(_UF_B64[\"image/png\"], text)\n                self.assertNotIn(\"data:image\", text)\n                self.assertEqual(\n                    cast(\"dict[str, str]\", _bval(\"_active_cid_owners\")), {}\n                )\n                self.assertLessEqual(_open_fds(), fds_before + 2)\n                env.assert_clean(self)\n            finally:\n                bridge.close()\n            ws = Path(_str(str(_bval(\"WORKSPACE\"))))\n            ws.mkdir(parents=True, exist_ok=True)\n            live = ws / \"img-live-uf10\"\n            live.mkdir()\n            with cast(\"threading.Lock\", _bval(\"_active_lock\")):\n                cast(\"set[str]\", _bval(\"_active_img_dirs\")).add(str(live))\n            _ = _bfn(\"_sweep_workspace\")(-1.0)\n            self.assertTrue(live.exists())  # активный каталог sweep не трогает\n            with cast(\"threading.Lock\", _bval(\"_active_lock\")):\n                cast(\"set[str]\", _bval(\"_active_img_dirs\")).discard(str(live))\n            _ = _bfn(\"_sweep_workspace\")(-1.0)\n            self.assertFalse(live.exists())\n            self.assertEqual(env.active_dirs(), set())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"agent_message","text":"Проверил все ветки downgrade и новые тесты uf01–uf10. Проверки охватывают основные сбои, но некоторые сценарии CID и нормализации обходят HTTP-слой через моки. Теперь сверяю их с инвариантами, чтобы отделить дефекты от явно разрешённых допущений.\n"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json')\nd=json.loads(p.read_text())\nprint('KEYS',list(d))\nfor k in d:\n if any(s in k for s in ['decision','invariant','contract','scope','assumption']):\n  print(k,json.dumps(d[k],ensure_ascii=False,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\np=Path('.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json')\nd=json.loads(p.read_text())\nprint('KEYS',list(d))\nfor k in d:\n if any(s in k for s in ['decision','invariant','contract','scope','assumption']):\n  print(k,json.dumps(d[k],ensure_ascii=False,indent=2))\nPY\"","aggregated_output":"KEYS ['schema_version', 'protocol', 'task_id', 'run_id', 'criticality', 'profile', 'status', 'approval_scope', 'baseline', 'requirement_ids', 'requirements', 'evidence', 'risk_triggers', 'assumptions', 'decisions', 'quality_scenarios', 'boundaries', 'contract_deltas', 'views', 'risks', 'verification_surface', 'protected_paths', 'materialization', 'approval', 'independent_review', 'open_questions', 'deferred', 'source_contracts', 'invariants', 'acceptance_criteria', 'test_scenarios', 'frozen_inputs', 'runtime_view', 'threat_model', 'pre_mortem', 'evolution', 'reuse_brief', 'resource_envelope', 'handoff_state', 'owner_questions', 'tooling_deviations', 'role_plan']\napproval_scope \"Author-finalized reversible design and mechanical schema/integrity gate only. No external council verdict, resource acceptance, Coder authorization or production acceptance is implied.\"\nassumptions [\n  {\n    \"id\": \"ASM-001\",\n    \"source_id\": \"ASSUMP-01\",\n    \"class\": \"continuable\",\n    \"status\": \"ASSUMED\",\n    \"statement\": \"Owner200 requirement is media-safe admission plus a real text attempt, not guaranteed backend availability. Successful text gives200; independent protocol/admission/launcher/second failure remain truthful errors. User direct guard excludes done/client_gone.\",\n    \"evidence_ids\": [\n      \"EVD-100\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"ASM-002\",\n    \"source_id\": \"ASSUMP-02\",\n    \"class\": \"continuable\",\n    \"status\": \"ASSUMED\",\n    \"statement\": \"Valid decodable raster describes positive test corpus. Universal safety retains signature-only validation and no pixel decoder/dependency; this is not a proof that every signature-bearing file decodes safely.\",\n    \"evidence_ids\": [\n      \"EVD-100\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-006\"\n    ]\n  }\n]\ndecisions [\n  {\n    \"id\": \"AD-001\",\n    \"title\": \"Universal Policy Flag & Dynamic Config Activation\",\n    \"status\": \"APPROVED\",\n    \"kind\": \"two-way\",\n    \"question\": \"How to enable universal acceptance without changing legacy strict fixtures?\",\n    \"choice\": \"An independent fail-closed IMAGE_FALLBACK_ENABLED controls universal policy; IMAGE_INPUT_ENABLED continues to control staging. Capture universal once per accepted request and recheck input after slot acquisition.\",\n    \"alternatives\": [\n      \"Universal enabled by default: rejected because it breaks strict baseline and res03/hist05/life02.\",\n      \"Reuse IMAGE_INPUT_ENABLED as universal: rejected because _ImgEnv sets only this flag and must remain strict.\"\n    ],\n    \"drivers\": [\n      \"REQ-01\",\n      \"REQ-02\",\n      \"REQ-04\",\n      \"REQ-05\",\n      \"CON-04\",\n      \"INV-01\",\n      \"INV-09\",\n      \"RISK-05\"\n    ],\n    \"consequences\": [\n      \"No fleet mutation or fake proofs.\",\n      \"Rollback universal=false restores strict behavior for new requests; in-flight requests retain captured universal policy.\",\n      \"Input disable propagates on next post-slot check subject to its existing <=1s cache; accepted running CLI is not retroactively cancelled.\"\n    ],\n    \"approval_required\": false,\n    \"confirmation\": {\n      \"kind\": \"test\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n      \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-010 must pass after implementation.\"\n    },\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-006\",\n      \"VER-008\",\n      \"VER-010\"\n    ],\n    \"details\": {\n      \"names\": {\n        \"config\": \"IMAGE_FALLBACK_ENABLED\",\n        \"env\": \"AGY_IMAGE_FALLBACK_ENABLED\",\n        \"reader\": \"_read_image_fallback_flag()\",\n        \"predicate\": \"_is_image_fallback_enabled()\",\n        \"cache\": \"_image_fallback_flag_cache = (0.0, False)\",\n        \"ttl_s\": 1.0\n      },\n      \"reader_contract\": \"Bounded read of DYNAMIC_CONFIG_PATH; reject missing/unreadable/oversize/invalid JSON/non-object; only data.get(\\\"IMAGE_FALLBACK_ENABLED\\\") is True enables. Strings, integers, null and missing key are False. No env parsing inside JSON reader.\",\n      \"env_contract\": \"Read env every predicate call, strip whitespace and lowercase. Nonempty 1/true/yes=>True; 0/false/no=>False; other nonempty token=>False (including on/off for NEW flag). Empty/unset falls through to JSON. Env overrides cache immediately and does not mutate JSON; no production global env export in test runner.\",\n      \"cache_contract\": \"Monotonic TTL<1.0s serves cached config; age>=1.0s rereads; bounded dedicated lock _image_fallback_flag_lock protects tuple. Initialize (0.0,False); reset under that lock inside _reset_sqlite_guards_for_tests(); independent from old input, SHA and SQLite caches. Cold cache always reads current fixture path. Existing _ImgEnv/_Fixture tests need no edits.\",\n      \"policy_matrix\": [\n        {\n          \"universal\": false,\n          \"input_enabled\": false,\n          \"images\": \"legacy strict reject\",\n          \"response\": \"400 image_input_not_supported for image requests; pure text unchanged\"\n        },\n        {\n          \"universal\": false,\n          \"input_enabled\": true,\n          \"images\": \"legacy _image_gate proof/SHA/efforts gate\",\n          \"response\": \"legacy admission/retry same files, all old error outcomes unchanged\"\n        },\n        {\n          \"universal\": true,\n          \"input_enabled\": false,\n          \"images\": \"no staging, strip all media from full history\",\n          \"response\": \"real pure-text attempt1; collect/flag_disabled event; HTTP200 iff text backend succeeds\"\n        },\n        {\n          \"universal\": true,\n          \"input_enabled\": true,\n          \"images\": \"optimistic known catalog + valid effort + all safety checks; no model proof eligibility\",\n          \"response\": \"valid raster attached attempt1; validation/recheck/spool failure strips before attempt1; runtime guard strips before attempt2\"\n        }\n      ],\n      \"universal_gate\": \"_image_gate_universal(model_id,effort) validates catalog membership and declared valid model effort and current input flag; never calls _image_proof_reason/_file_sha256 nor uses images.status/proof/agy_binary_sha256/efforts_proven/formats proof. Unknown model/invalid effort remain ingress400, never rescued by media fallback. Startup fleet schema remains unchanged.\",\n      \"collector_contract\": \"_collect_images(messages,model_id,effort,universal=False): default strict exactly preserves existing path/order/taxonomy. universal=True uses complete media classification, canonical image aliases and _image_gate_universal, then same limits/role/dataURL/base64/MIME/signature checks. No _stage_images before slot. Any ImageReject discards ALL collected entries; no partially valid image subset is sent.\",\n      \"safety_limits\": {\n        \"images_max\": 16,\n        \"per_image_bytes_max\": 20971520,\n        \"total_image_bytes_max\": 20971520,\n        \"http_body_bytes_max\": 33554432,\n        \"allowed_roles\": [\n          \"user\"\n        ],\n        \"mime\": [\n          \"image/png\",\n          \"image/jpeg\",\n          \"image/gif\",\n          \"image/webp\"\n        ],\n        \"encoding\": \"data:<allowed-mime>;base64,<strict-base64>; signature must match declared MIME\",\n        \"remote_reads\": \"forbidden including HTTP(S), file:// and relative paths\",\n        \"proof_is_not_safety\": \"Signature-only validation retained; no new pixel decoder.\"\n      },\n      \"production_activation\": {\n        \"path\": \"~/.dsh/bridges/agy-bridge/dynamic_config.json\",\n        \"required_projection\": {\n          \"IMAGE_INPUT_ENABLED\": true,\n          \"IMAGE_FALLBACK_ENABLED\": true\n        },\n        \"status\": \"PLANNED_NOT_APPLIED_STAGE2\",\n        \"procedure\": \"After architecture and code council acceptance deploy candidate server only, verify unchanged fleet SHA, preserve unrelated config keys and atomically set both strict JSON booleans true in DEPLOYED ROOT. Code replacement needs managed bridge restart; flag toggles reload <=1s without restart. Read back flags and effective capability; then existing owner DSH chat must pass VER010 live scenarios. Never add tracked dynamic_config.json.\",\n        \"owner_override\": \"Current owner explicitly selects local dynamic_config.json plus env override; this is scoped exception to general GigaRC/no-new-env preference, not a claim that GigaRC is integrated.\"\n      }\n    }\n  },\n  {\n    \"id\": \"AD-002\",\n    \"title\": \"Complete Media Normalization & Stripping Contract\",\n    \"status\": \"APPROVED\",\n    \"kind\": \"two-way\",\n    \"question\": \"How to remove media from all history and both prompt representations without payload leakage?\",\n    \"choice\": \"Pure non-mutating content normalization classifies media by type AND payload keys before considering text. Precompute stripped full-history prompt in ctx before any session delta selection.\",\n    \"alternatives\": [\n      \"Set images=[] only: rejected, leaves [image N], full_prompt attachments and old CID.\",\n      \"str(content)/text-first generic renderer: rejected, exposes media dict.text and inline payloads.\"\n    ],\n    \"drivers\": [\n      \"REQ-06\",\n      \"INV-02\",\n      \"INV-03\",\n      \"INV-04\",\n      \"INV-07\",\n      \"AC-04\",\n      \"AC-07\"\n    ],\n    \"consequences\": [\n      \"No in-place edits to caller messages or test fixtures.\",\n      \"Plain textual URLs are preserved verbatim; only structured attachment payloads are removed.\",\n      \"Normal universal raster rendering omits other media, fallback rendering replaces it with stable placeholders.\"\n    ],\n    \"approval_required\": false,\n    \"confirmation\": {\n      \"kind\": \"test\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n      \"expected\": \"Independent execution VER003 plus VER-003, VER-007, VER-009 must pass after implementation.\"\n    },\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-007\",\n      \"VER-009\"\n    ],\n    \"details\": {\n      \"helper_contracts\": {\n        \"_flatten_content_stripped(content)\": \"Return safe string with unchanged ordinary text order and newline joining; None=>empty; recognized image=>[image omitted]; other recognized media=>[media omitted]; unknown dict/object never str(dict).\",\n        \"_strip_media_from_messages(messages)\": \"Return fresh JSON-safe message list with roles/order/name/tool-call protocol metadata preserved, content replaced by safe string, nested content structures copied/normalized without mutation. Do not use copy.deepcopy on hot path: normalization is deep by visiting content recursively once.\",\n        \"_messages_to_stripped_prompt(messages)\": \"Render normalized messages through existing role/tool message envelope with images=[] and no image counter-driven media parts; zero generated [attachments], generated [image N], media paths/URLs/base64. Existing user text is not censored.\"\n      },\n      \"classification_order\": [\n        \"If structured object is image type or has image payload key, emit image placeholder BEFORE looking at text, even type=text plus image_url.\",\n        \"Else if other media type or media payload key, emit media placeholder BEFORE looking at text.\",\n        \"Else known text type/plain text value -> string text only; dict(text) supported only if safe string. Never serialize nested text object.\",\n        \"Lists process entries in order; plain strings pass through; None/numbers/unknown structured objects omitted; unknown object-only message gets [media omitted] to keep safe nonempty context.\"\n      ],\n      \"image_types\": [\n        \"image_url\",\n        \"image\",\n        \"input_image\"\n      ],\n      \"image_payload_keys\": [\n        \"image_url\",\n        \"image\"\n      ],\n      \"other_media_types\": [\n        \"input_audio\",\n        \"audio\",\n        \"video\",\n        \"video_url\",\n        \"file\",\n        \"document\",\n        \"inlineData\",\n        \"inline_data\",\n        \"fileData\",\n        \"file_data\"\n      ],\n      \"other_media_payload_keys\": [\n        \"input_audio\",\n        \"audio\",\n        \"video\",\n        \"video_url\",\n        \"file\",\n        \"document\",\n        \"inlineData\",\n        \"inline_data\",\n        \"fileData\",\n        \"file_data\"\n      ],\n      \"dict_content\": \"Identical handling to list parts: recognized media types/keys win; type=text with safe str text yields that text. Dict is never rendered via str(content).\",\n      \"aliases_for_optimistic_collection\": \"Classify image aliases across list and dict content. Canonicalize on a private normalized copy to type=image_url with image_url={url:...}; URL source is string image_url/image payload or payload.url, including type=input_image with image_url string. Prefer image_url key over image if both; malformed/missing URL is ImageReject -> whole-request stripped fallback, never guessed local/file or raw base64. Preserve original role/msg_index and global image numbering. Type=image_url lacking payload remains an invalid image candidate, not silently dropped.\",\n      \"normal_universal_render\": \"For universal normal/optimistic render only: retain canonical validated raster image references and text; silently omit other media parts, including their text keys, and never serialize unknown dicts. If there are ONLY non-image media/unknown structured parts and no raster, use stripped placeholders and text-only admission (stage=collect reason=unsupported_media). Mixed valid raster + non-image media retains valid raster, excludes non-image media without forcing downgrade.\",\n      \"idempotency\": \"For normalized list N: _strip_media_from_messages(N)==N; repeated normalization yields byte-identical rendered prompt. Placeholder strings are ordinary safe strings: never wrapped/replaced/appended again.\",\n      \"nonempty\": \"Each image/media-only message retains its [image omitted]/[media omitted] marker; never becomes empty and never causes generated Reply with exactly: PONG. Truly empty/non-media requests retain existing behavior.\",\n      \"ctx_contract\": \"Always store ctx[\\\"stripped_full_prompt\\\"]=_messages_to_stripped_prompt(original messages). ctx[\\\"universal_fallback\\\"] is admission snapshot. For any actual downgrade assign BOTH ctx[\\\"prompt\\\"] and ctx[\\\"full_prompt\\\"] from stripped_full_prompt, ctx[\\\"images\\\"]=[], ctx[\\\"img_dir\\\"]=None. Never recompute from original _messages_to_prompt(messages,[]) during downgrade.\",\n      \"resumed_contract\": \"If any current or historical media was stripped, force cold text turn with full stripped history; do not resume dirty explicit or cached CID. This conservative choice is owner-permitted. Normal universal with valid raster may still use existing resumed slice numbering; stripped_full_prompt was computed from the full original history before selecting that slice.\",\n      \"strict_isolation\": \"When universal=False continue existing collector/render paths exactly, including existing strict truncated PNG and same-files retry assertions; new normalizer does not redefine strict inputs.\"\n    }\n  },\n  {\n    \"id\": \"AD-003\",\n    \"title\": \"Three Safe Downgrade Points\",\n    \"status\": \"APPROVED\",\n    \"kind\": \"two-way\",\n    \"question\": \"Where exactly does fallback override strict early exits and retry branches?\",\n    \"choice\": \"Central bounded media-to-text state transition at admission, post-slot/spool, and runtime attempt1, before both legacy retry paths. Keep all response and resource ownership invariants.\",\n    \"alternatives\": [\n      \"Only generic transient retry: rejected, misses timeouts, hot early continue, flag and spool failures.\",\n      \"Always replay same image attachments on failure: rejected by owner text-only fallback contract.\"\n    ],\n    \"drivers\": [\n      \"REQ-02\",\n      \"REQ-03\",\n      \"INV-05\",\n      \"INV-06\",\n      \"INV-07\",\n      \"INV-08\",\n      \"INV-09\",\n      \"INV-11\"\n    ],\n    \"consequences\": [\n      \"Exactly at most2 CLI executions/request; degradation reserve is request-scoped and unavailable to generic retries.\",\n      \"Failures after client delivery, client_gone and state done never trigger this fallback.\",\n      \"External side effects can occur before delivery; no exactly-once promise.\"\n    ],\n    \"approval_required\": false,\n    \"confirmation\": {\n      \"kind\": \"test\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n      \"expected\": \"Independent execution VER003 plus VER-003, VER-005, VER-009, VER-010 must pass after implementation.\"\n    },\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-005\",\n      \"VER-009\",\n      \"VER-010\"\n    ],\n    \"details\": {\n      \"point1_collect\": {\n        \"when\": \"do_POST after normal auth/body/model/effort validation, before slot, spool or response\",\n        \"logic\": [\n          \"Capture universal flag. Detect structured media throughout history using AD002. Precompute stripped_full_prompt.\",\n          \"universal and media and input_disabled -> log stage=collect reason=flag_disabled, images=[], img_dir=None, use stripped full history as prompt/full_prompt, prohibit resume.\",\n          \"universal and input_enabled -> _collect_images(...,universal=True); any ImageReject -> log stage=collect reason=rejected.reason, code sanitized separately if logged, images=[], img_dir=None; both prompts stripped; prohibit resume; no image-derived HTTP400.\",\n          \"Non-image media without raster -> use markers and pure text as AD002; mixed valid raster/media -> optimistic raster only.\",\n          \"strict -> retain exact existing exception->400 path, reason taxonomy and normal legacy render.\",\n          \"No valid images means do not allocate/spool img_dir. Any preallocated path is only metadata and never passed to Run.\"\n        ]\n      },\n      \"point2_post_slot\": {\n        \"when\": \"_run_once after acquire, before register/mkdir/stage/Run\",\n        \"logic\": [\n          \"If images and universal snapshot true: recheck _is_image_input_enabled ONLY; do not perform strict proof/SHA check. If False, log post_slot/flag_disabled and execute downgrade transition; continue attempt1 as text.\",\n          \"If !universal keep _image_gate recheck and existing image_reject terminal state exactly.\",\n          \"Register only the own actual img_dir under _active_lock before mkdir. _stage_images exception ImageSpoolError in universal -> log spool/image_spool_error; cleanup partial dir and registry, img_registered=False, img_dir=None; downgrade both prompts/CID/images; proceed attempt1 text with add_dir=None.\",\n          \"Strict spool failure remains image_spool_error500/no spawn. No broad catch of programming errors as media fallback.\"\n        ]\n      },\n      \"downgrade_transition_order\": [\n        \"Close any completed Run before deleting files (existing finally run.close). Snapshot old image count, old CID and session key for sanitized event and own CAS invalidation.\",\n        \"Call _cleanup_img_dir(own img_dir) if non-null; unregister under _active_lock using existing helper. Clear local img_dir and images, img_registered=False; ctx images=[], img_dir=None. Cleanup helper is idempotent; no cleanup of another request directory.\",\n        \"For any nonempty old/resume/explicit CID: if sess_key exists, _session_invalidate(sess_key,old_cid) (compare-and-swap); always _cid_release(old_cid,str(ctx.get(\\\"turn_id\\\") or \\\"\\\")) for own claim. Set ctx.hot_resumed=False, ctx.conversation_id=\\\"\\\" and any local resume_conv_id=None. Plain turns with sess_key=None never mutate session store.\",\n        \"The brief conv_id=str(uuid.uuid4()) means allocate a fresh logical conversation if implementation has such local; this HEAD has none. Contract is zero old --resume CID and Run conversation_id=\\\"\\\" so CLI creates NEW conversation, not pass a fabricated resume ID.\",\n        \"Set both ctx.prompt and ctx.full_prompt to ctx.stripped_full_prompt. Keep model/effort/cwd/tool protocol and acquired slot; subsequent Run.add_dir=None.\",\n        \"Commit only successful new text session under existing ownership rules; CAS cannot remove a concurrently replaced store value. Outer do_POST ownership cleanup remains idempotent for already released old CID.\"\n      ],\n      \"point3_runtime\": {\n        \"placement\": \"Immediately after attempt1 _execute returns and run.close() completes, before hot_resumed early continue (baseline3280..3295) AND before transient/_retry_take branch (3297..3310). Existing done break may precede guard because guard excludes done.\",\n        \"guard\": \"attempt==1 AND ctx.universal_fallback AND bool(images) AND img_dir is not None (actually attached Run) AND out.state not in (done,client_gone) AND NOT delivered\",\n        \"delivery\": \"delivered_reasoning=bool(out.get(\\\"delivered_reasoning\\\")) OR bool(ctx.get(\\\"stream\\\") and out.get(\\\"reasoning\\\")); delivered=bool(out.get(\\\"text\\\")) OR bool(out.get(\\\"tool_calls\\\")) OR delivered_reasoning. No delivered_reasoning field exists in this HEAD; do not accidentally ignore already emitted SSE reasoning. JSON buffered reasoning alone is not delivered. Empty role delta/keepalive is not delivery.\",\n        \"actions\": [\n          \"Emit runtime/state sanitized event exactly once, count BEFORE clearing images.\",\n          \"Execute full downgrade transition including immediate cleanup and full history reset before text constructor.\",\n          \"Call _retry_take() exactly once; consume one token if available. If unavailable, consume the one per-request media-degradation reserve; do not decrement global balance below0, replenish global bucket, loop, or fail this text retry.\",\n          \"Always sleep pause=_rng()*RETRY_PAUSE_CAP_S (equivalent to _retry_pause_s(1)); then continue into attempt2, add_dir=None, images=[], no old CID.\",\n          \"No third attempt; failed second text run preserves normal JSON/SSE error. No fallback for state done even nonzero rc/empty text (RISK03), client_gone or any delivered output.\"\n        ]\n      },\n      \"reserve_budget\": {\n        \"capacity\": \"1 fallback token per request ONLY after eligible image-attached attempt1; never reusable and never generic.\",\n        \"maximum\": \"generic+reserve still <=1 retry per request because fixed (1,2) loop. Slot retained across pause/retry; active CLI <=MAX_CONCURRENT (default4), body admission remains unchanged.\",\n        \"owner_override\": \"Owner explicitly requires degradation even when _retry_tenths<RETRY_COST_TENTHS. Therefore generic formula floor(.2*N)+3 is preserved for strict/generic-only traffic, but NOT claimed for universal fallback traffic. Total retries <= min(N, floor(.2*N)+3 + N_media_degradation_reserve). Worst all-image-fail batch reaches2N attempts; RISK08 quota and capacity must be measured before production acceptance.\"\n      },\n      \"exclusions\": \"LauncherUnavailable preflight, constructor OSError before a real attached _execute, auth/framing/invalid model/invalid effort/admission/queue failures remain existing errors; do not synthesize successful text result or emit second HTTP headers. No general Exception catch or transport refactor in this patch.\",\n      \"error_semantics\": \"200 means real text completion success. Failed text retry -> existing502/504/etc JSON or SSE error event+DONE. SSE initial200 alone never proves success. Keep legacy _error_body mapping for done/bad rc/empty text, missing executable, and queue overload.\",\n      \"lifecycle\": \"Cleanup of img_dir/partial spool before downgrade; outer finally releases slot exactly once. If physical deletion fails, report safe cleanup error and NEVER reattach or falsely assert deletion; existing orphan sweep remains recovery. Cancellation/client_gone skips all retries and closes Run/resources.\"\n    }\n  },\n  {\n    \"id\": \"AD-004\",\n    \"title\": \"Observability & Discoverability\",\n    \"status\": \"APPROVED\",\n    \"kind\": \"two-way\",\n    \"question\": \"How to report optimistic support while keeping strict health/models types and proofs intact?\",\n    \"choice\": \"Preserve existing boolean images fields; effective supports=universal&&input_enabled for all catalog models, otherwise strict predicate. Add a separate structured image_fallback object, never replace health.images with a dict.\",\n    \"alternatives\": [\n      \"Rewrite fleet proofs as confirmed: rejected by ao10 and evidence semantics.\",\n      \"Replace /health.images bool with dict: rejected by actual code/test_ao01 type semantics.\"\n    ],\n    \"drivers\": [\n      \"REQ-01\",\n      \"REQ-04\",\n      \"REQ-05\",\n      \"CON-05\",\n      \"INV-10\",\n      \"AC-08\"\n    ],\n    \"consequences\": [\n      \"Optimistic acceptance is distinguished from historical proof.\",\n      \"No fleet.json or old _model_supports_images strict semantics changes.\",\n      \"No auth/payload/prompt/path leakage in new events.\"\n    ],\n    \"approval_required\": false,\n    \"confirmation\": {\n      \"kind\": \"test\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n      \"expected\": \"Independent execution VER003 plus VER-003, VER-006, VER-008, VER-009, VER-010 must pass after implementation.\"\n    },\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-006\",\n      \"VER-008\",\n      \"VER-009\",\n      \"VER-010\"\n    ],\n    \"details\": {\n      \"as_is_checks\": {\n        \"test_ao01\": \"With universal false, /v1/models data.images true ONLY gemini-4-argon and gemini-3.8-flash under _ImgEnv; aggregate images is True; health.images is True identity assertion.\",\n        \"test_ao06_health\": \"test_ao06_health_has_four_additive_fields_and_keeps_existing_ones at line2764 checks presence of old health keys and sqlite reasoning fields; does not license changing images type.\",\n        \"test_ao10\": \"Static fleet binary/version/default limits/proofs and text-only unsupported entries unchanged byte-for-byte.\"\n      },\n      \"effective_predicate\": \"At GET request start read universal,input once. If universal=True, effective_images(mid)=input_enabled and mid in FLEET_MODELS. If universal=False, effective_images(mid)=_model_supports_images(mid) exactly as now. _model_supports_images itself remains strict so no proof consumers silently change.\",\n      \"models\": \"Each data row retains id/object/owned_by/created/context_length/images boolean. Universal+input true => every catalog data.images=True, top-level images=any(effective flags). Add top-level image_fallback object for both policy states; never relabel static images.status/proof as confirmed.\",\n      \"health\": \"Keep health[\\\"images\\\"] boolean any(effective support) and existing image_input_mode string/sqlite fields. Add health[\\\"image_fallback\\\"]={\\\"fallback_enabled\\\":bool,\\\"input_enabled\\\":bool,\\\"mode\\\":\\\"universal\\\"|\\\"strict\\\",\\\"acceptance\\\":\\\"optimistic\\\"|\\\"proof-gated\\\"|\\\"text-only\\\",\\\"method\\\":\\\"workspace-read\\\",\\\"limits\\\":copy of IMAGE_LIMITS,\\\"models\\\":[effective supported catalog IDs]}. Same object on /v1/models. acceptance=text-only iff universal and input disabled, otherwise optimistic iff universal, else proof-gated. Brief suggestion health[\\\"images\\\"][\\\"fallback_enabled\\\"] is inapplicable to actual bool schema.\",\n      \"log_contract\": {\n        \"event\": \"image_fallback\",\n        \"template\": \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\",\n        \"stages\": [\n          \"collect\",\n          \"post_slot\",\n          \"spool\",\n          \"runtime\"\n        ],\n        \"attempts\": \"collect/post_slot/spool =>1 upcoming attempt; runtime=>1 failed attached attempt\",\n        \"reason\": \"flag_disabled; ImageReject.reason; image_spool_error; unsupported_media; runtime state token\",\n        \"sanitizer\": \"Introduce _log_token(value,max_len=64): only ASCII identifier chars A-Za-z0-9_.- survive, all others _, length capped64; empty->unknown. Stage from finite allowlist, model validated catalog, reason/state sanitized. Counts coerced bounded integers; code if extra uses same sanitizer.\",\n        \"sink\": \"HEAD uses _log(str) -> stderr + _mask_secrets; no log.info object exists. Preserve native sink and emit exact formatted event via _log helper (semantically INFO), no new logger dependency. If log.info introduced locally, it MUST route through same masking/sink; no requirement to rewire logging.\",\n        \"never\": [\n          \"auth keys\",\n          \"base64 payload\",\n          \"URLs\",\n          \"prompts\",\n          \"file paths\",\n          \"raw exception repr\"\n        ],\n        \"frequency\": \"Exactly one event per actual downgrade transition, no fallback event for strict path/pure-text or simply omitted audio beside valid raster. Strict reject/proof logs unchanged.\"\n      }\n    }\n  },\n  {\n    \"id\": \"AD-005\",\n    \"title\": \"Test Suite Append-Only Architecture uf01..uf10\",\n    \"status\": \"APPROVED\",\n    \"kind\": \"two-way\",\n    \"question\": \"How to prove new policy and retry contracts without weakening strict coverage?\",\n    \"choice\": \"Append UniversalImageFallbackTests at EOF, retaining entire baseline file bytes. Use import discovery, true raster fixtures and local flag patches; freeze assertion, execution and full suite commands independently.\",\n    \"alternatives\": [\n      \"Edit legacy _ImgEnv/_Fixture/tests to expect universal behavior: rejected, changes frozen strict baseline.\",\n      \"AST ID presence only: rejected, not evidence of behavior execution.\"\n    ],\n    \"drivers\": [\n      \"REQ-04\",\n      \"AC-01\",\n      \"AC-02\",\n      \"SCN-uf01\",\n      \"SCN-uf10\",\n      \"SCN-B01\",\n      \"SCN-B02\",\n      \"SCN-R01\",\n      \"SCN-R02\",\n      \"SCN-I01\"\n    ],\n    \"consequences\": [\n      \"Existing __main__ guard remains; direct python tests/file.py would miss appended classes, so VER003/005 use import/discovery.\",\n      \"No suite-wide environment override enables universal.\",\n      \"Red regressions before product fix, then green full legacy+universal execution; future tests are not executed or claimed Stage2.\"\n    ],\n    \"approval_required\": false,\n    \"confirmation\": {\n      \"kind\": \"test\",\n      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import importlib.util, os, sys, unittest\\nos.environ.pop(\\\"AGY_IMAGE_FALLBACK_ENABLED\\\", None)\\nsys.path.insert(0, \\\"tests\\\"); sys.path.insert(0, \\\".\\\")\\nspec=importlib.util.spec_from_file_location(\\\"agy_frozen_suite\\\", \\\"tests/test_agy_bridge_resilience.py\\\")\\nm=importlib.util.module_from_spec(spec); sys.modules[spec.name]=m; spec.loader.exec_module(m)\\nclasses=[c for n,c in vars(m).items() if isinstance(c,type) and issubclass(c,unittest.TestCase) and (n.startswith(\\\"Image\\\") or n in {\\\"AcceptanceOracleTests\\\",\\\"UniversalImageFallbackTests\\\"})]\\nassert any(c.__name__==\\\"UniversalImageFallbackTests\\\" for c in classes), \\\"Missing universal tests\\\"\\nloader=unittest.TestLoader(); suite=unittest.TestSuite(loader.loadTestsFromTestCase(c) for c in classes)\\nassert suite.countTestCases()>=56, suite.countTestCases()\\nresult=unittest.TextTestRunner(verbosity=2).run(suite); assert result.wasSuccessful()\\nprint(\\\"UNIVERSAL_AND_LEGACY_EXECUTION_PASS\\\")'\",\n      \"expected\": \"Independent execution VER003 plus VER-001, VER-002, VER-003, VER-004, VER-005, VER-006, VER-007, VER-008 must pass after implementation.\"\n    },\n    \"verification_ids\": [\n      \"VER-001\",\n      \"VER-002\",\n      \"VER-003\",\n      \"VER-004\",\n      \"VER-005\",\n      \"VER-006\",\n      \"VER-007\",\n      \"VER-008\"\n    ],\n    \"details\": {\n      \"prefix\": {\n        \"path\": \"tests/test_agy_bridge_resilience.py\",\n        \"bytes\": 249933,\n        \"sha256\": \"f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5\",\n        \"deleted_lines_allowed\": 0,\n        \"preserve\": \"Entire BASE blob is a prefix; additions strictly after byte249933. This includes all old tests/helpers/__main__, stronger than a diff numstat check.\"\n      },\n      \"new_class\": \"UniversalImageFallbackTests(unittest.TestCase)\",\n      \"test_methods\": [\n        {\n          \"name\": \"test_uf01_all_catalog_models_and_efforts_optimistic\",\n          \"scenarios\": [\n            \"SCN-uf01\",\n            \"SCN-B01\"\n          ],\n          \"assertions\": \"Every catalog model x declared effort, true raster PNG/JPEG/GIF/WebP fixture; runtime proof/SHA/status/efforts_proven corrupted or absent without startup schema violation; no strict gate invocation, attachment/files/add-dir attempt1 and real successful JSON/SSE. Catalog negatives remain ingress errors.\"\n        },\n        {\n          \"name\": \"test_uf02_image_rejections_strip_all_media\",\n          \"scenarios\": [\n            \"SCN-uf02\",\n            \"SCN-B01\",\n            \"SCN-B02\"\n          ],\n          \"assertions\": \"Whole taxonomy incl malformed alias/dict content, MIME/base64/magic/roles/16vs17/size cap±1, mixed invalid+valid image; one stripped run/no partial staging/no fetch; media failure no400; auth/JSON/body413/model/effort/admission503 retain errors.\"\n        },\n        {\n          \"name\": \"test_uf03_policy_matrix_recheck_and_cache\",\n          \"scenarios\": [\n            \"SCN-uf03\"\n          ],\n          \"assertions\": \"Four policy states, missing/false/malformed/string/int/null/oversize config; env token map, TTL boundary, reset; input flip while queued strips before mkdir/Run, SHA flip ignored universal; rollback/re-enable without restart and slots restored.\"\n        },\n        {\n          \"name\": \"test_uf04_spool_failures_downgrade_before_attempt1\",\n          \"scenarios\": [\n            \"SCN-uf04\",\n            \"SCN-R02\"\n          ],\n          \"assertions\": \"mkdir/EACCES/ENOSPC/second-file/O_EXCL errors, registry and actual partial cleanup; one text constructor, no attach; unsafe permissions never broaden; cleanup-error branch accurately logged and not reattached.\"\n        },\n        {\n          \"name\": \"test_uf05_runtime_retry_cold_text_with_empty_budget\",\n          \"scenarios\": [\n            \"SCN-uf05\",\n            \"SCN-R01\"\n          ],\n          \"assertions\": \"Each eligible agy/pump/timeout/idle/first-token state with zero/30 tenths; two runs only, immediate file cleanup before second constructor, add_dir=None, both prompts stripped, jitter invoked and tokens consumed only if available. Second failure truthful, done excluded, no third.\"\n        },\n        {\n          \"name\": \"test_uf06_hot_and_explicit_cid_cold_reset\",\n          \"scenarios\": [\n            \"SCN-uf06\",\n            \"SCN-R02\"\n          ],\n          \"assertions\": \"Three-turn tools history, early hot agy_error must hit media guard before hot continue; CAS invalidate matching CID only, release(cid,turn_id), no resume on retry; postslot/spool/collect also cold after media removal; next history turn works.\"\n        },\n        {\n          \"name\": \"test_uf07_media_normalization_is_complete\",\n          \"scenarios\": [\n            \"SCN-uf07\",\n            \"SCN-I01\"\n          ],\n          \"assertions\": \"All specified media types+keys incl snake_case and video_url, dict and list content, media.text taint, unknown dict not serialized; mixed raster/audio optimistic retains raster only; media-only placeholders nonempty; original input unchanged.\"\n        },\n        {\n          \"name\": \"test_uf08_delivery_and_non_media_failures_do_not_replay\",\n          \"scenarios\": [\n            \"SCN-uf08\"\n          ],\n          \"assertions\": \"Delivered text/tool_calls/SSE reasoning/client_gone ->one run cleanup; JSON buffered reasoning/empty SSE delta allow guarded retry; done badrc/empty output no image retry; missing launcher/OSError no double headers/fake success.\"\n        },\n        {\n          \"name\": \"test_uf09_full_history_idempotency_and_reentry\",\n          \"scenarios\": [\n            \"SCN-uf09\",\n            \"SCN-I01\"\n          ],\n          \"assertions\": \"Normalization fixed point, exact role/text/Unicode/order/ordinary URL preservation, old images/latest-image-only/no-assistant/history hot↔cold, both prompts no generated attachments/imageN/base64. Next request re-evaluates policy, no permanent deny.\"\n        },\n        {\n          \"name\": \"test_uf10_observability_isolation_and_lifecycle\",\n          \"scenarios\": [\n            \"SCN-uf10\",\n            \"SCN-R01\",\n            \"SCN-R02\"\n          ],\n          \"assertions\": \"strict→universal→strict and reverse; bool capabilities+additive policy fields and no fake fleet proof; safe logs counts/stages/no secrets; two simultaneous distinct requests, same-key CAS replacement, active sweep, cancellation/repeated fallbacks restore slots/dirs/FD/children. Production receipt only release VER010, no unit claim.\"\n        }\n      ],\n      \"fixture_policy\": \"New helpers/classes are appended ONLY; use _ImgEnv then write BOTH config keys because env.flag rewrites file. Context-managed env patch/new cache reset restores state. No process-wide fallback env in test execution. Use actual small decodable raster corpus embedded as fixtures; no Pillow/new dependency; existing magic-only strict fixtures unchanged.\",\n      \"counts\": \"Baseline146 methods total,46 image-related (36 Image*+10 AcceptanceOracleTests), inherited VER007 IDs40 because duplicate log01 and5 f-methods are not represented by those40. Preserve all146 methods and execute full project suite.\",\n      \"boundaries\": \"Use small patched caps for individual/total boundary corpus, but real HTTP body/admission boundary tests remain; no gratuitous16x20MiB allocation.\",\n      \"red_green\": \"Coder first appends regression tests and records failing universal assertions against BASE, then fixes server only. Existing tests may not be edited for lint/type/format convenience.\"\n    }\n  }\n]\ncontract_deltas [\n  {\n    \"id\": \"CD-001\",\n    \"type\": \"behavior\",\n    \"producer\": \"agy do_POST\",\n    \"consumer\": \"DSH\",\n    \"change\": \"With universal=true media failures strip to text instead of strict image400/spool500; eligible image attempt failure gets one text retry.\",\n    \"compatibility\": \"Explicitly requested REQ01..03; flag absent/false exactly old behavior.\",\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-005\"\n    ]\n  },\n  {\n    \"id\": \"CD-002\",\n    \"type\": \"api\",\n    \"producer\": \"GET /v1/models and /health\",\n    \"consumer\": \"DSH capability consumers\",\n    \"change\": \"Existing images booleans use effective optimistic eligibility in universal+input; additive image_fallback object.\",\n    \"compatibility\": \"Keep bool schema and all old fields; strict expected model set unchanged, fleet proof untouched.\",\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-008\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CD-003\",\n    \"type\": \"data\",\n    \"producer\": \"deployed local dynamic_config.json\",\n    \"consumer\": \"agy runtime flags\",\n    \"change\": \"Add strict boolean IMAGE_FALLBACK_ENABLED with independent env/TTL/defaultfalse.\",\n    \"compatibility\": \"Owner explicit local JSON override; old config without key strict; no tracked config/new dependency.\",\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  }\n]\nsource_contracts [\n  {\n    \"id\": \"CON-01\",\n    \"baseline\": \"ingress: `POST /v1/chat/completions`, HTTP JSON messages и JSON/SSE output; DSH → agy bridge, владелец локального моста. Auth/header/framing/model/effort/body/admission проверки самостоятельны (F-130). Нет доказанного Idempotency-Key/dedup контракта: повтор CLI не равен exactly-once. Test contour: localhost `_HttpBridge`, fake agy (F-216).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CON-02\",\n    \"baseline\": \"image input: только user `image_url` data/base64 raster; пределы 16, individual/total20971520 bytes, body33554432 bytes. External URLs не читаются; ссылки не должны попасть в CLI fallback. Rejection taxonomy сохранена в strict mode (F-105/F-106/F-206/F-310).\",\n    \"decision_ids\": [\n      \"AD-001\",\n      \"AD-002\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CON-03\",\n    \"baseline\": \"egress CLI: argv `--add-dir <dir>` и prompt attachments, рабочий cwd отдельно; stdout JSON events, stderr diagnostics; lifecycle `Run.close` и controller. Состояния/error mapping F-114/F-120/F-123/F-125. Не меняется контракт CLI под универсальное inline media API.\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CON-04\",\n    \"baseline\": \"local config: путь из resolved server ROOT, strict JSON flag read с TTL1s, env override только существующего input flag; production — отдельные files. `start.sh` config не устанавливает (F-101/F-303/F-306/F-307). Новый policy обязан иметь явные чтение, default, cache reset/reload и rollout/rollback; имя ключа решает архитектор.\",\n    \"decision_ids\": [\n      \"AD-001\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CON-05\",\n    \"baseline\": \"discoverability: `/v1/models`, `/health` сейчас отражают доказанный допуск, не optimistic attempt (F-129). В strict режиме ответы неизменны. Universal effective capability нельзя выдавать за confirmed proof; модель остаётся под catalog validation. Требуются различимые policy/staging/optimistic-attempt поля либо согласованное расширение semantics без мутации static fleet (F-205).\",\n    \"decision_ids\": [\n      \"AD-004\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  },\n  {\n    \"id\": \"CON-06\",\n    \"baseline\": \"fault boundary: ImageReject и ImageSpoolError fail-open к **санитизированному тексту** только при universal=true. Auth/admission/framing/unknown model/unsupported reasoning effort fail-closed по прежнему контракту. Конфиг/его неверный тип fail-closed к strict policy. CLI missing/offline, timeout текстового повтора и оборванный клиент не становятся фиктивным success (F-125/F-130).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-010\"\n    ]\n  }\n]\ninvariants [\n  {\n    \"id\": \"INV-01\",\n    \"statement\": \"bypass proof не bypass safety validation. Ни fetch/file://, ни MIME expansion, ни превышение resource limits. Strict path сохраняет прежний signature-only контракт. Valid decodable fixtures обязательны для universal positive tests; полноценное pixel decoding — отдельное решение с ограничениями памяти (F-107/F-217).\",\n    \"decision_ids\": [\n      \"AD-001\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-02\",\n    \"statement\": \"normalized media-free history имеет только разрешённые text parts; classification media выполняется раньше чтения `text`. `image_url`, `image`, `input_image` → `[image omitted]`; `input_audio`, `audio`, `video`, `file`, `document`, `inlineData`, `fileData` → `[media omitted]` либо удаление. Проверять и `type`, и соответствующие payload keys, в том числе dict-content; не использовать `str(media_dict)`. Неизвестный structured block не сериализовать целиком. Обычный текст пользователя с URL не цензурировать как вложение (REQ-06/F-112).\",\n    \"decision_ids\": [\n      \"AD-002\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-03\",\n    \"statement\": \"сбой любого изображения в universal admission убирает **все** media данного запроса/истории, без частичного spool/поднабора. Mixed valid raster + unsupported non-image media: raster допускается к optimistic send, прочее media не передаётся agy и не сериализуется. Если режим уже downgraded, никакие старые media не возвращаются через full_prompt (F-111/F-115).\",\n    \"decision_ids\": [\n      \"AD-002\",\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-04\",\n    \"statement\": \"image fallback должен иметь очищенные prompt **и** full_prompt. Перед runtime retry необходим доступ к очищенной истории/предвычисленному full text prompt: в текущем ctx исходных messages нет (F-124). Простой вызов `_messages_to_prompt(original_messages, [])` оставляет image N (F-111). Media-only → placeholder или существующий непустой safe fallback, без attachments (F-113).\",\n    \"decision_ids\": [\n      \"AD-002\",\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-05\",\n    \"statement\": \"runtime guard в точности: attempt1, фактически передан add_dir и непустые images, state не done/client_gone, delivered=false. Его нужно обработать до **обоих** legacy retry-переходов, включая ранний hot continue (F-121). Timeout/idle/first-token states подпадают под owner guard в universal mode, хотя legacy transient их не повторяет (F-122). Только одна text retry, никогда третья.\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-06\",\n    \"statement\": \"немедленно cleanup зарегистрированного img_dir, затем обнулить local и ctx img_dir/images; повтор с `add_dir=None`. Partial-stage failure также cleanup/registry removal. Сохранить slot на текущий ход, освободить ровно один раз; завершение каждого Run до cleanup (F-109/F-110/F-119).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-07\",\n    \"statement\": \"использовать существующий CAS `_session_invalidate(sess_key,cid)` вместо несуществующего имени из брифа; снять собственный cid claim через `_cid_release`, сбросить hot_resumed/conversation_id и переключить на full **stripped** prompt. Text fallback не должен resume прежний explicit CID, который может сохранять attachment context. Plain turn не меняет чужой store; конкурентно обновлённый CID не инвалидировать (F-116/F-117/F-121).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-08\",\n    \"statement\": \"delivered=text/tool_calls/stream reasoning; initial empty SSE delta и keepalive не означают delivery. После delivery или client_gone retry запрещён, файлы всё равно убрать. JSON reasoning ещё не доставлен и не блокирует downgrade (F-120/F-126).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-09\",\n    \"statement\": \"legacy token budget остаётся strict. В universal mode owner требует attempt2 даже при generic retry budget0: архитектура должна предусмотреть одну ограниченную media-degradation попытку/резерв без возможности бесконечных повторов. Это отдельная ветвь, не глобальная отмена retry budget (F-213).\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-10\",\n    \"statement\": \"новый structured event `image_fallback` на каждый фактический downgrade с reason/stage/model/attempt/policy/count и bounded sanitized identifiers. Без auth, base64, media URLs, полного prompt, файловых путей/персональных данных. Старые strict logs и masking не менять (F-209). Причины: collect validation, flag/proof/recheck, spool, attached CLI state; log не заменяет успешную text completion.\",\n    \"decision_ids\": [\n      \"AD-004\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-11\",\n    \"statement\": \"не ловить произвольный Exception как media issue. Constructor LauncherUnavailable/OSError находятся до общей ветви и частично пишут response сами (F-123): не посылать вторые HTTP headers, не выполнять фиктивный успешный fallback. Проверить возможность bounded text retry при безопасном spawn failure отдельно от отсутствующего executable.\",\n    \"decision_ids\": [\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  },\n  {\n    \"id\": \"INV-12\",\n    \"statement\": \"после downgrade и успешного text ответа следующий cold/history turn вновь обрабатывает вход через policy; не оставлять навсегда пометку «model unsupported». Статическое доказательство capability не переписывается из единичного отказа. История с прежними media либо повторно optimistic принимается, либо безопасно stripping по той же политике.\",\n    \"decision_ids\": [\n      \"AD-001\",\n      \"AD-003\"\n    ],\n    \"verification_ids\": [\n      \"VER-003\",\n      \"VER-009\"\n    ]\n  }\n]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '580,630p' bridges/agy-bridge/server.py; sed -n '1875,1925p' bridges/agy-bridge/server.py; sed -n '3250,3465p' bridges/agy-bridge/server.py; sed -n '1,140p' tests/test_agy_bridge_resilience.py; nl -ba bridges/agy-bridge/server.py | sed -n '4080,4168p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '580,630p' bridges/agy-bridge/server.py; sed -n '1875,1925p' bridges/agy-bridge/server.py; sed -n '3250,3465p' bridges/agy-bridge/server.py; sed -n '1,140p' tests/test_agy_bridge_resilience.py; nl -ba bridges/agy-bridge/server.py | sed -n '4080,4168p'\"","aggregated_output":"    if os.path.isfile(LAUNCHER) and os.access(LAUNCHER, os.X_OK):\n        return LAUNCHER\n    raise LauncherUnavailable(LAUNCHER)\n\n\ndef _auth_ok(handler: BaseHTTPRequestHandler) -> bool:\n    hdr = handler.headers.get(\"Authorization\", \"\")\n    if hdr.startswith(\"Bearer \"):\n        return hdr[7:].strip() == AUTH_KEY\n    return handler.headers.get(\"x-api-key\", \"\") == AUTH_KEY or hdr.strip() == AUTH_KEY\n\n\ndef _flatten_content(content: Any, img_counter: list[int] | None = None) -> str:\n    \"\"\"Контент сообщения в текст; с `img_counter` image-части дают маркеры `[image N]`.\"\"\"\n    if content is None:\n        return \"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        parts: list[str] = []\n        for item in content:\n            if isinstance(item, str):\n                parts.append(item)\n            elif (\n                img_counter is not None\n                and isinstance(item, dict)\n                and item.get(\"type\") == \"image_url\"\n            ):\n                img_counter[0] += 1\n                parts.append(\"[image %d]\" % img_counter[0])\n            elif isinstance(item, dict) and \"text\" in item:\n                parts.append(str(item[\"text\"]))\n        return \"\\n\".join(p for p in parts if p)\n    return str(content)\n\n\ndef _tool_choice_none(tool_choice: Any) -> bool:\n    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n\n\n@final\nclass ImageReject(ValueError):\n    \"\"\"Отказ по изображениям: `reason` — деталь для журнала, `code` — тип HTTP 400.\"\"\"\n\n    def __init__(self, reason: str, code: str = \"image_input_not_supported\") -> None:\n        super().__init__(reason)\n        self.reason = reason\n        self.code = code\n\n\n@final\n    disabled = _sqlite_disabled_reason()\n    with _sqlite_guard_lock:\n        if disabled:\n            mode = \"off\"\n        elif _breaker_state == \"OPEN\":\n            mode = \"breaker_open\"\n        else:\n            mode = _compat_state.lower()\n        return {\n            \"sqlite_reasoning_mode\": mode,\n            \"sqlite_breaker_state\": _breaker_state.lower(),\n            \"sqlite_divergence_count\": _sqlite_divergence_count,\n            \"sqlite_drain_deadline_count\": _sqlite_drain_deadline_count,\n        }\n\n\ndef _cid_acquire(cid: str, turn_id: str) -> bool:\n    \"\"\"Занять разговор за ходом; False — cid занят другим активным ходом.\"\"\"\n    if not cid or not turn_id:\n        return True\n    with _session_store_lock:\n        owner = _active_cid_owners.get(cid)\n        if owner is not None and owner != turn_id:\n            return False\n        _active_cid_owners[cid] = turn_id\n        return True\n\n\ndef _cid_release(cid: str, turn_id: str) -> None:\n    \"\"\"Снять владение, только если оно принадлежит этому ходу.\"\"\"\n    if not cid or not turn_id:\n        return\n    with _session_store_lock:\n        if _active_cid_owners.get(cid) == turn_id:\n            _ = _active_cid_owners.pop(cid, None)\n\n\n# ---- Чтение SQLite разговора agy: только на чтение, без побочных эффектов --------\n\n\ndef _db_path_for(cid: str) -> Path | None:\n    \"\"\"Путь к <cid>.db строго внутри CONV_DIR; невалидный cid -> None.\"\"\"\n    if _CID_RE.fullmatch(cid) is None:\n        return None\n    path = CONV_DIR / (cid + \".db\")\n    try:\n        if path.resolve().parent != CONV_DIR.resolve():\n            return None\n    except (OSError, RuntimeError):\n        return None\n    return path\ndef _terminal_state(name: str, err: str = \"\") -> dict[str, object]:\n    \"\"\"Итог хода без запуска agy (отказ до spawn).\"\"\"\n    return {\n        \"state\": name,\n        \"rc\": 1,\n        \"text\": \"\",\n        \"usage\": {},\n        \"result\": {},\n        \"err\": err,\n        \"tool_calls\": [],\n        \"tool_events\": 0,\n        \"conversation_id\": \"\",\n        \"num_turns\": None,\n        \"duration_s\": None,\n    }\n\n\nclass Handler(BaseHTTPRequestHandler):\n    protocol_version = \"HTTP/1.1\"\n    server_version = \"agy-bridge/1.0\"\n\n    def log_message(self, format: str, *args: Any) -> None:  # noqa: A003\n        del format, args\n\n    def handle_error(self, request: Any, client_address: Any) -> None:\n        return\n\n    def _client_tag(self) -> str:\n        try:\n            return \"%s:%s\" % (self.client_address[0], self.client_address[1])\n        except (TypeError, IndexError):\n            return \"-\"\n\n    def _send(self, code: int, payload: dict) -> None:\n        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n        try:\n            self.send_response(code)\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n\n    def _emit(self, data: str) -> bool:\n        \"\"\"Отправить SSE-строку; False — клиент ушёл.\"\"\"\n        try:\n            self.wfile.write(data.encode(\"utf-8\"))\n            self.wfile.flush()\n            return True\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            return False\n\n    def _log_reject(\n        self, reason: str, model: str = \"unknown\", model_len: int = 0\n    ) -> None:\n        _log(\n            f\"reject reason={reason} model={_safe_log_value(model)} \"\n            f\"model_len={model_len} client={self._client_tag()}\"\n        )\n\n    def _reject(\n        self,\n        code: int,\n        reason: str,\n        message: str,\n        model: str = \"unknown\",\n        model_len: int = 0,\n    ) -> None:\n        self._log_reject(reason, model, model_len)\n        self._send(code, {\"error\": {\"message\": message, \"type\": reason, \"code\": code}})\n\n    def _acquire_slot(self, keepalive) -> str:\n        \"\"\"Занять слот исполнения; '' — успех, иначе причина отказа.\"\"\"\n        if _slots.acquire(blocking=False):\n            return \"\"\n        deadline = time.monotonic() + QUEUE_TIMEOUT_S\n        while time.monotonic() < deadline:\n            if _slots.acquire(timeout=1.0):\n                return \"\"\n            if keepalive is not None and not keepalive():\n                return \"client_gone\"\n        return \"queue_timeout\"\n\n    def _execute(\n        self, run: Run, on_text, on_tool_trace, on_reasoning, keepalive\n    ) -> dict:\n        \"\"\"Гнать ход до конца; сквозной таймаут TIMEOUT_S на весь ход.\n\n        Колбэки возвращают False, если клиент ушёл.\n        Превышение deadline -> kill группы (в run.close()), state=timeout.\n        \"\"\"\n        pieces = []\n        reasoning_pieces = []\n        usage = {}\n        result_ev = {}\n        conversation_id = \"\"\n        result_error = \"\"\n        result_error_at = 0.0\n        tool_events = 0\n        last_ka = time.monotonic()\n        last_wd_check = time.monotonic()\n        deadline = time.monotonic() + TIMEOUT_S\n        gone = [False]\n\n        def state(name: str, rc: int, err: str = \"\") -> dict:\n            return {\n                \"rc\": rc,\n                \"text\": \"\".join(pieces),\n                \"reasoning\": \"\".join(reasoning_pieces),\n                \"usage\": usage,\n                \"result\": result_ev,\n                \"state\": name,\n                \"err\": err,\n                \"conversation_id\": conversation_id,\n                \"duration_s\": result_ev.get(\"duration_s\"),\n                \"num_turns\": result_ev.get(\"num_turns\"),\n                \"tool_events\": tool_events,\n                \"tool_calls\": [],\n            }\n\n        def add_content(text: str) -> None:\n            if gone[0] or not text:\n                return\n            pieces.append(text)\n            if not on_text(text):\n                gone[0] = True\n\n        def add_reasoning(text: str) -> None:\n            if gone[0] or not text:\n                return\n            ok = on_reasoning(text)\n            reasoning_pieces.append(text)\n            # Диагностический след эмита мышления: что хвост добыл и дошло ли до клиента.\n            _log(\n                f\"reasoning-emit cid={conversation_id[:8] or '-'} \"\n                f\"n={len(reasoning_pieces)} len={len(text)} ok={int(bool(ok))}\"\n            )\n            if not ok:\n                gone[0] = True\n\n        while True:\n            if time.monotonic() > deadline:\n                return state(\"timeout\", 124, f\"proxy timeout after {TIMEOUT_S}s\")\n            if (\n                not run.got_event\n                and time.monotonic() - run.started > FIRST_TOKEN_TIMEOUT_S\n            ):\n                return state(\n                    \"first_token_timeout\",\n                    124,\n                    f\"no agy event within {FIRST_TOKEN_TIMEOUT_S:g}s\",\n                )\n            if _client_gone(self.connection):\n                return state(\"client_gone\", 1)\n            if (\n                result_error\n                and time.monotonic() - result_error_at > RESULT_EXIT_GRACE_S\n            ):\n                # agy прислал result ERROR, но не завершился: ждать done бесконечно нельзя.\n                return state(\"agy_error\", 1, result_error)\n            try:\n                kind, payload = run.q.get(timeout=1.0)\n            except queue.Empty:\n                # check() запускает `ps`: не чаще WATCHDOG_INTERVAL_S. Пока идут события,\n                # on_activity() и так сбрасывает таймер, поэтому пропуск безопасен.\n                now = time.monotonic()\n                if now - last_wd_check >= WATCHDOG_INTERVAL_S:\n                    last_wd_check = now\n                    should_stop, wd_reason, _metrics = run.controller.check(\n                        run.proc.pid\n                    )\n                    if should_stop and wd_reason == \"idle_timeout\":\n                        _log(\n                            f\"watchdog idle_timeout pgid={run.proc.pid} \"\n                            f\"idle>={IDLE_TIMEOUT_S:g}s\"\n                        )\n                        return state(\n                            \"idle_timeout\",\n                            124,\n                            f\"proxy idle timeout after {IDLE_TIMEOUT_S:g}s \"\n                            \"(no activity in process group)\",\n                        )\n                    if should_stop and wd_reason == \"absolute_cap\":\n                        return state(\n                            \"timeout\", 124, f\"proxy timeout after {TIMEOUT_S}s\"\n                        )\n                    # wd_reason == \"child_exited\": штатно, \"done\"/\"pump_error\" придут из очереди\n                if keepalive is not None and time.monotonic() - last_ka >= KEEPALIVE_S:\n                    last_ka = time.monotonic()\n                    if not keepalive():\n                        return state(\"client_gone\", 1)\n                continue\n            if kind in _ACTIVITY_KINDS:\n                run.controller.on_activity(kind)\n            if kind == \"init\":\n                conversation_id = str(payload.get(\"conversation_id\") or \"\")\n                _log(\n                    f\"init conversation={conversation_id[:8] or '-'} \"\n                    f\"tools={payload.get('tools')} \"\n                    f\"permission_mode={payload.get('permission_mode')}\"\n                )\n            elif kind == \"reasoning\":\n                add_reasoning(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"text\":\n                add_content(str(payload))\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n            elif kind == \"tool_trace\":\n                tool_events += 1\n                if not on_tool_trace(payload):\n                    gone[0] = True\n                    return state(\"client_gone\", 1)\n            elif kind == \"result\":\n\"\"\"Тесты отказоустойчивости agy-bridge (ADR-0007, arch-spec r2 §6, RW-008).\n\nПокрыто 15 сценариев: детекция неактивности группы, сброс таймера по CPU и по\nпротокольным событиям, fail-closed при деградации `ps`, троттлинг `check()` в\n`_execute`, `child_exited` как штатное завершение, `absolute_cap` -> `timeout`,\nkill-switch, контракт ошибки `idle_timeout` (HTTP 504 / SSE), зачистка группы\nпроцессов и reap лидера, изоляция таймаута источника в `fetch_via_playwright.py`.\n\nМост `bridges/agy-bridge/server.py` лежит в каталоге с дефисом, поэтому грузится\nчерез `importlib`. Таймауты малые (`idle_timeout_s=0.2`) либо мок-часы; процессы\nсоздаются с `start_new_session=True` и убираются в `finally`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport base64\nimport contextlib\nimport hashlib\nimport http.client\nimport importlib.util\nimport io\nimport json\nimport os\nimport queue\nimport re\nimport resource\nimport shutil\nimport signal\nimport socket\nimport sqlite3\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport unittest\nfrom pathlib import Path\nfrom types import ModuleType\nfrom types import SimpleNamespace\nfrom typing import Any\nfrom typing import Callable, cast\nfrom unittest import mock\n\n_REPO_ROOT = Path(__file__).resolve().parents[1]\nif str(_REPO_ROOT) not in sys.path:\n    sys.path.insert(0, str(_REPO_ROOT))\n\nfrom core.watchdog import (  # noqa: E402\n    AdaptiveTimeoutController,\n    ProcessWatchdog,\n    WatchdogMetrics,\n)\n\n_BRIDGE_PY = _REPO_ROOT / \"bridges\" / \"agy-bridge\" / \"server.py\"\n_FETCH_SCRIPT = Path(\n    os.environ.get(\"AIBUNKER_FETCH_SCRIPT\")\n    or \"~/Мой диск/Workshop/aibunker-workshop/scripts/fetch_via_playwright.py\"\n).expanduser()\n\n_POSIX = sys.platform != \"win32\"\n_DARWIN = sys.platform == \"darwin\"\n\n\ndef _load_bridge() -> Any:\n    os.environ.setdefault(\"AGY_BRIDGE_KEY\", \"test-key-agy-resilience\")\n    os.environ.pop(\"AGY_BRIDGE_FLEET\", None)\n    spec = importlib.util.spec_from_file_location(\n        \"agy_bridge_server_under_test\", _BRIDGE_PY\n    )\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nsrv = _load_bridge()\n\n\nclass _FakeClock:\n    \"\"\"Ручные часы: время движется только через advance().\"\"\"\n\n    def __init__(self, now: float = 1000.0) -> None:\n        self.now = now\n\n    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass _TickQueue:\n    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n\n    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n        self.clock = clock\n        self.empty_ticks = empty_ticks\n        self.events = list(events)\n\n    def get(self, timeout: float = 0.0) -> Any:\n        if self.empty_ticks > 0:\n            self.empty_ticks -= 1\n            self.clock.advance(float(timeout))\n            raise queue.Empty\n        if self.events:\n            return self.events.pop(0)\n        self.clock.advance(float(timeout))\n        raise queue.Empty\n\n\nclass _SpyController:\n    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n\n    def __init__(\n        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n    ) -> None:\n        self.inner = inner\n        self.forced = forced\n        self.check_calls = 0\n        self.activity: list[str] = []\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n        self.inner.on_activity(kind)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.check_calls += 1\n        if self.forced is not None:\n            return self.forced\n        return self.inner.check(pgid)\n\n\ndef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n\n\ndef _hard_kill(proc: subprocess.Popen) -> None:\n    try:\n  4080\t                cast(\"list[object]\", messages_raw)\n  4081\t                if isinstance(messages_raw, list)\n  4082\t                else []\n  4083\t            )\n  4084\t            # Универсальная политика фиксируется один раз на принятый запрос.\n  4085\t            universal = _is_image_fallback_enabled()\n  4086\t            images: list[dict[str, object]] = []\n  4087\t            render_messages: list[object] = messages\n  4088\t            stripped_full_prompt = \"\"\n  4089\t            force_cold = False\n  4090\t            if universal:\n  4091\t                image_parts, other_media = _media_part_counts(messages)\n  4092\t                if image_parts or other_media:\n  4093\t                    stripped_full_prompt = _messages_to_stripped_prompt(messages)\n  4094\t                    if not _is_image_input_enabled():\n  4095\t                        _log_image_fallback(\n  4096\t                            \"collect\",\n  4097\t                            \"flag_disabled\",\n  4098\t                            cast(str, model_id),\n  4099\t                            1,\n  4100\t                            image_parts,\n  4101\t                        )\n  4102\t                        force_cold = True\n  4103\t                    else:\n  4104\t                        try:\n  4105\t                            images = _collect_images(\n  4106\t                                messages,\n  4107\t                                cast(str, model_id),\n  4108\t                                cast(str, effort),\n  4109\t                                universal=True,\n  4110\t                            )\n  4111\t                        except ImageReject as rejected:\n  4112\t                            _log_image_fallback(\n  4113\t                                \"collect\",\n  4114\t                                rejected.reason,\n  4115\t                                cast(str, model_id),\n  4116\t                                1,\n  4117\t                                image_parts,\n  4118\t                            )\n  4119\t                            images = []\n  4120\t                            force_cold = True\n  4121\t                        else:\n  4122\t                            if images:\n  4123\t                                render_messages = _universal_render_messages(messages)\n  4124\t                            else:\n  4125\t                                _log_image_fallback(\n  4126\t                                    \"collect\",\n  4127\t                                    \"unsupported_media\",\n  4128\t                                    cast(str, model_id),\n  4129\t                                    1,\n  4130\t                                    other_media,\n  4131\t                                )\n  4132\t                                force_cold = True\n  4133\t            else:\n  4134\t                try:\n  4135\t                    images = _collect_images(\n  4136\t                        messages, cast(str, model_id), cast(str, effort)\n  4137\t                    )\n  4138\t                except ImageReject as rejected:\n  4139\t                    _log(\"image_reject detail=%s\" % rejected.reason)\n  4140\t                    self._reject(\n  4141\t                        400,\n  4142\t                        rejected.code,\n  4143\t                        f\"image rejected: {rejected.code}\",\n  4144\t                        model_id,\n  4145\t                        model_len,\n  4146\t                    )\n  4147\t                    return\n  4148\t            img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n  4149\t            try:\n  4150\t                _launcher()\n  4151\t            except LauncherUnavailable:\n  4152\t                self._reject(\n  4153\t                    503,\n  4154\t                    \"launcher_unavailable\",\n  4155\t                    \"canonical launcher is missing or not executable\",\n  4156\t                    model_id,\n  4157\t                    model_len,\n  4158\t                )\n  4159\t                return\n  4160\t            raw_tools = req.get(\"tools\")\n  4161\t            tools = (\n  4162\t                [t for t in raw_tools if isinstance(t, dict)]\n  4163\t                if isinstance(raw_tools, list)\n  4164\t                else []\n  4165\t            )\n  4166\t            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n  4167\t            if force_cold:\n  4168\t                full_prompt = stripped_full_prompt\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\nd=json.loads(Path('.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json').read_text())\nfor dec in d['decisions']:\n if dec['id'] in ['AD-003','AD-004']:\n  print(dec['id'],json.dumps(dec.get('details'),ensure_ascii=False,indent=2))\nPY\nrg -n '\"'^###|''^####|''^'\"\\\\|.*[0-9]|подкатегори' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/council.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json\nfrom pathlib import Path\nd=json.loads(Path('.ai-team/runs/agy-universal-image-fallback-20261029/architecture/architecture-packet.json').read_text())\nfor dec in d['decisions']:\n if dec['id'] in ['AD-003','AD-004']:\n  print(dec['id'],json.dumps(dec.get('details'),ensure_ascii=False,indent=2))\nPY\nrg -n '\"'^###|''^####|''^'\"\\\\|.*[0-9]|подкатегори' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/council.md'\"","aggregated_output":"AD-003 {\n  \"point1_collect\": {\n    \"when\": \"do_POST after normal auth/body/model/effort validation, before slot, spool or response\",\n    \"logic\": [\n      \"Capture universal flag. Detect structured media throughout history using AD002. Precompute stripped_full_prompt.\",\n      \"universal and media and input_disabled -> log stage=collect reason=flag_disabled, images=[], img_dir=None, use stripped full history as prompt/full_prompt, prohibit resume.\",\n      \"universal and input_enabled -> _collect_images(...,universal=True); any ImageReject -> log stage=collect reason=rejected.reason, code sanitized separately if logged, images=[], img_dir=None; both prompts stripped; prohibit resume; no image-derived HTTP400.\",\n      \"Non-image media without raster -> use markers and pure text as AD002; mixed valid raster/media -> optimistic raster only.\",\n      \"strict -> retain exact existing exception->400 path, reason taxonomy and normal legacy render.\",\n      \"No valid images means do not allocate/spool img_dir. Any preallocated path is only metadata and never passed to Run.\"\n    ]\n  },\n  \"point2_post_slot\": {\n    \"when\": \"_run_once after acquire, before register/mkdir/stage/Run\",\n    \"logic\": [\n      \"If images and universal snapshot true: recheck _is_image_input_enabled ONLY; do not perform strict proof/SHA check. If False, log post_slot/flag_disabled and execute downgrade transition; continue attempt1 as text.\",\n      \"If !universal keep _image_gate recheck and existing image_reject terminal state exactly.\",\n      \"Register only the own actual img_dir under _active_lock before mkdir. _stage_images exception ImageSpoolError in universal -> log spool/image_spool_error; cleanup partial dir and registry, img_registered=False, img_dir=None; downgrade both prompts/CID/images; proceed attempt1 text with add_dir=None.\",\n      \"Strict spool failure remains image_spool_error500/no spawn. No broad catch of programming errors as media fallback.\"\n    ]\n  },\n  \"downgrade_transition_order\": [\n    \"Close any completed Run before deleting files (existing finally run.close). Snapshot old image count, old CID and session key for sanitized event and own CAS invalidation.\",\n    \"Call _cleanup_img_dir(own img_dir) if non-null; unregister under _active_lock using existing helper. Clear local img_dir and images, img_registered=False; ctx images=[], img_dir=None. Cleanup helper is idempotent; no cleanup of another request directory.\",\n    \"For any nonempty old/resume/explicit CID: if sess_key exists, _session_invalidate(sess_key,old_cid) (compare-and-swap); always _cid_release(old_cid,str(ctx.get(\\\"turn_id\\\") or \\\"\\\")) for own claim. Set ctx.hot_resumed=False, ctx.conversation_id=\\\"\\\" and any local resume_conv_id=None. Plain turns with sess_key=None never mutate session store.\",\n    \"The brief conv_id=str(uuid.uuid4()) means allocate a fresh logical conversation if implementation has such local; this HEAD has none. Contract is zero old --resume CID and Run conversation_id=\\\"\\\" so CLI creates NEW conversation, not pass a fabricated resume ID.\",\n    \"Set both ctx.prompt and ctx.full_prompt to ctx.stripped_full_prompt. Keep model/effort/cwd/tool protocol and acquired slot; subsequent Run.add_dir=None.\",\n    \"Commit only successful new text session under existing ownership rules; CAS cannot remove a concurrently replaced store value. Outer do_POST ownership cleanup remains idempotent for already released old CID.\"\n  ],\n  \"point3_runtime\": {\n    \"placement\": \"Immediately after attempt1 _execute returns and run.close() completes, before hot_resumed early continue (baseline3280..3295) AND before transient/_retry_take branch (3297..3310). Existing done break may precede guard because guard excludes done.\",\n    \"guard\": \"attempt==1 AND ctx.universal_fallback AND bool(images) AND img_dir is not None (actually attached Run) AND out.state not in (done,client_gone) AND NOT delivered\",\n    \"delivery\": \"delivered_reasoning=bool(out.get(\\\"delivered_reasoning\\\")) OR bool(ctx.get(\\\"stream\\\") and out.get(\\\"reasoning\\\")); delivered=bool(out.get(\\\"text\\\")) OR bool(out.get(\\\"tool_calls\\\")) OR delivered_reasoning. No delivered_reasoning field exists in this HEAD; do not accidentally ignore already emitted SSE reasoning. JSON buffered reasoning alone is not delivered. Empty role delta/keepalive is not delivery.\",\n    \"actions\": [\n      \"Emit runtime/state sanitized event exactly once, count BEFORE clearing images.\",\n      \"Execute full downgrade transition including immediate cleanup and full history reset before text constructor.\",\n      \"Call _retry_take() exactly once; consume one token if available. If unavailable, consume the one per-request media-degradation reserve; do not decrement global balance below0, replenish global bucket, loop, or fail this text retry.\",\n      \"Always sleep pause=_rng()*RETRY_PAUSE_CAP_S (equivalent to _retry_pause_s(1)); then continue into attempt2, add_dir=None, images=[], no old CID.\",\n      \"No third attempt; failed second text run preserves normal JSON/SSE error. No fallback for state done even nonzero rc/empty text (RISK03), client_gone or any delivered output.\"\n    ]\n  },\n  \"reserve_budget\": {\n    \"capacity\": \"1 fallback token per request ONLY after eligible image-attached attempt1; never reusable and never generic.\",\n    \"maximum\": \"generic+reserve still <=1 retry per request because fixed (1,2) loop. Slot retained across pause/retry; active CLI <=MAX_CONCURRENT (default4), body admission remains unchanged.\",\n    \"owner_override\": \"Owner explicitly requires degradation even when _retry_tenths<RETRY_COST_TENTHS. Therefore generic formula floor(.2*N)+3 is preserved for strict/generic-only traffic, but NOT claimed for universal fallback traffic. Total retries <= min(N, floor(.2*N)+3 + N_media_degradation_reserve). Worst all-image-fail batch reaches2N attempts; RISK08 quota and capacity must be measured before production acceptance.\"\n  },\n  \"exclusions\": \"LauncherUnavailable preflight, constructor OSError before a real attached _execute, auth/framing/invalid model/invalid effort/admission/queue failures remain existing errors; do not synthesize successful text result or emit second HTTP headers. No general Exception catch or transport refactor in this patch.\",\n  \"error_semantics\": \"200 means real text completion success. Failed text retry -> existing502/504/etc JSON or SSE error event+DONE. SSE initial200 alone never proves success. Keep legacy _error_body mapping for done/bad rc/empty text, missing executable, and queue overload.\",\n  \"lifecycle\": \"Cleanup of img_dir/partial spool before downgrade; outer finally releases slot exactly once. If physical deletion fails, report safe cleanup error and NEVER reattach or falsely assert deletion; existing orphan sweep remains recovery. Cancellation/client_gone skips all retries and closes Run/resources.\"\n}\nAD-004 {\n  \"as_is_checks\": {\n    \"test_ao01\": \"With universal false, /v1/models data.images true ONLY gemini-4-argon and gemini-3.8-flash under _ImgEnv; aggregate images is True; health.images is True identity assertion.\",\n    \"test_ao06_health\": \"test_ao06_health_has_four_additive_fields_and_keeps_existing_ones at line2764 checks presence of old health keys and sqlite reasoning fields; does not license changing images type.\",\n    \"test_ao10\": \"Static fleet binary/version/default limits/proofs and text-only unsupported entries unchanged byte-for-byte.\"\n  },\n  \"effective_predicate\": \"At GET request start read universal,input once. If universal=True, effective_images(mid)=input_enabled and mid in FLEET_MODELS. If universal=False, effective_images(mid)=_model_supports_images(mid) exactly as now. _model_supports_images itself remains strict so no proof consumers silently change.\",\n  \"models\": \"Each data row retains id/object/owned_by/created/context_length/images boolean. Universal+input true => every catalog data.images=True, top-level images=any(effective flags). Add top-level image_fallback object for both policy states; never relabel static images.status/proof as confirmed.\",\n  \"health\": \"Keep health[\\\"images\\\"] boolean any(effective support) and existing image_input_mode string/sqlite fields. Add health[\\\"image_fallback\\\"]={\\\"fallback_enabled\\\":bool,\\\"input_enabled\\\":bool,\\\"mode\\\":\\\"universal\\\"|\\\"strict\\\",\\\"acceptance\\\":\\\"optimistic\\\"|\\\"proof-gated\\\"|\\\"text-only\\\",\\\"method\\\":\\\"workspace-read\\\",\\\"limits\\\":copy of IMAGE_LIMITS,\\\"models\\\":[effective supported catalog IDs]}. Same object on /v1/models. acceptance=text-only iff universal and input disabled, otherwise optimistic iff universal, else proof-gated. Brief suggestion health[\\\"images\\\"][\\\"fallback_enabled\\\"] is inapplicable to actual bool schema.\",\n  \"log_contract\": {\n    \"event\": \"image_fallback\",\n    \"template\": \"image_fallback stage=%s reason=%s model=%s attempt=%d images=%d\",\n    \"stages\": [\n      \"collect\",\n      \"post_slot\",\n      \"spool\",\n      \"runtime\"\n    ],\n    \"attempts\": \"collect/post_slot/spool =>1 upcoming attempt; runtime=>1 failed attached attempt\",\n    \"reason\": \"flag_disabled; ImageReject.reason; image_spool_error; unsupported_media; runtime state token\",\n    \"sanitizer\": \"Introduce _log_token(value,max_len=64): only ASCII identifier chars A-Za-z0-9_.- survive, all others _, length capped64; empty->unknown. Stage from finite allowlist, model validated catalog, reason/state sanitized. Counts coerced bounded integers; code if extra uses same sanitizer.\",\n    \"sink\": \"HEAD uses _log(str) -> stderr + _mask_secrets; no log.info object exists. Preserve native sink and emit exact formatted event via _log helper (semantically INFO), no new logger dependency. If log.info introduced locally, it MUST route through same masking/sink; no requirement to rewire logging.\",\n    \"never\": [\n      \"auth keys\",\n      \"base64 payload\",\n      \"URLs\",\n      \"prompts\",\n      \"file paths\",\n      \"raw exception repr\"\n    ],\n    \"frequency\": \"Exactly one event per actual downgrade transition, no fallback event for strict path/pure-text or simply omitted audio beside valid raster. Strict reject/proof logs unchanged.\"\n  }\n}\n44:### Backend gate: PASS/FAIL\n70:`execution-evidence.md` и логи гейтов (тесты судья не гоняет), но покрой ВСЕ подкатегории рубрики\n71:на уровне строк кода; пропуск подкатегории = malformed (§3). Если reviewer.json в пакете есть —\n100:1. Найденный FAIL проход НЕ завершает. Дойди до последней подкатегории рубрики и\n111:5. Перед вердиктом пройди список подкатегорий второй раз (self-sweep) и допиши\n113:6. Последние строки ответа: `COVERAGE: <k>/<K> подкатегорий` и\n132:### Ревью брифа судей (brief-review)\n170:### Запуск, контроль живости и fallback\n373:Один проход судьи обязан покрыть все подкатегории всех 6 критериев; повторный\n378:### Рубрика судьи: SUB-строки по подкатегориям\n380:- Нумерованный перечень подкатегорий — в шапке брифа судьи; судья идёт по\n387:- Формат строки: `SUB <критерий>/<подкатегория>: PASS|FAIL|N/A — evidence\n389:- Malformed вердикта: нет SUB-строки по любой подкатегории ИЛИ сплошные N/A\n390:  больше 2/3 подкатегорий при нуле содержательных наблюдений. Один\n393:- Свёртка: FAIL любой подкатегории = FAIL критерия; N/A не голосует;\n396:### Полнота прохода: батч, не капельница\n419:### F-NNN и кумулятивный дедуп-леджер циклов\n438:### Diff-scope повторного цикла\n456:### R2-дебаты и early-exit\n458:- Дебаты — `council-consensus.md` (активный режим: `fast` k≤1, `default`/`quality` k≤2, ранний выход при `OPEN = 0`; полный `v1` k≤3; `0/3 PASS` и `≥2 RED FLAG` тоже проходят `RECHECK` и `D1`). Новые подкатегории/темы после R1 — только с приоритетом blocking\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,155p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; sed -n '370,437p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/council.md'; rg -n 'fingerprint|manifest|BASE|VER-005|DEFERRED|PREEXISTING' .ai-team/runs/agy-universal-image-fallback-20261029/teamlead/execution-evidence.md; ls .ai-team/runs/agy-universal-image-fallback-20261029/teamlead\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,155p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; sed -n '370,437p' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/council.md'; rg -n 'fingerprint|manifest|BASE|VER-005|DEFERRED|PREEXISTING' .ai-team/runs/agy-universal-image-fallback-20261029/teamlead/execution-evidence.md; ls .ai-team/runs/agy-universal-image-fallback-20261029/teamlead\"","aggregated_output":"## Корп-VPN упал — не стоп, поднять\n\nУпавший корп-VPN и timeout до корп-хоста — не `BLOCKED`: поднять и повторить. Прочитай `references/report-vpn-formats.md` § 2, когда корп-хост недоступен.\n\n## Границы\n\nСовет оценивает пригодность к merge; продукт глазами пользователя — `acceptance-gate` после ACCEPT. В `main`/`dev` не коммитить; merge — человек, кроме «кати» (PASS → ACCEPT → MR → CI 100% → merge с read-back). Каждый spawn — в `trace/index.json`.\n\n## Отчёт заказчику (формат)\n\nПрочитай `references/report-vpn-formats.md` § 3, когда пишешь отчёт; блок «Как совет договорился» — `references/council-consensus.md` § 11.\n\n## DoD сдачи\n\n- [ ] Цикл закрыт вердиктом `ACCEPT` повторного Совета, не самоотчётом Coder; MR открыт только после ACCEPT.\n- [ ] Каждый судья обеих панелей запущен строго через `launch_seat.py` и подтверждён `verify_panel_proof.py` (`panel-proof.json` PASS, `exit=0`); строка `PANEL PROOF: …` в отчёте.\n- [ ] Выход после `R1` — только по единому инварианту `consensus-debate.md`; `--replace-failed-seat` (≤2 на раунд) и `run_kind` brief-review (`full` на `R1`, `delta_prelint` на повторных) применены по правилам Шага 4; `final-panel-verdict.md` (А–Г) выпущен после прохода и показан владельцу первым блоком.\n- [ ] Дебаты исполнены раннером `scripts/run_consensus_council.py` (FSM `R1 → RECHECK → D1 → [D2] → C1 → AGGREGATE`, чекпоинты и `--resume`); первичный `consensus/consensus-ledger.json` (`pol-consensus/1.0`) записан, `BLOCKER-SAFETY` не снят большинством/переклассификацией, кворум 2/3 посчитан по независимым семействам, производные Markdown совпадают с JSON.\n- [ ] Clean-room evidence опечатан, матрица без обязательных `FAIL`/`NOT_RUN`/`STALE`, L3-гейт до MR закрыт.\n\n## Неснимаемые стоп-коды: `HL-ENV-01`, `C-MULT-I1..I5`, `S-HERD-I1..I5`, `H-CPU-I1..I5`, `R-BULK-I1..I5`\n\nПеред `ACCEPT` каждый судья проверяет все 21 стоп-код и самостоятельно пересчитывает численные инварианты. Прочитай `references/council-gates.md` § «Неснимаемые стоп-коды HL (полный текст)», когда проверяешь high-load кандидат: нарушение или отсутствие детерминированного теста — безусловный `BLOCKER` (`NEEDS WORK`), в техдолг не списывается.\n\n## Remote-first контракт репозитория\n\n\n## 3. Рубрика одного прохода и дедуп циклов Совета\n\nОдин проход судьи обязан покрыть все подкатегории всех 6 критериев; повторный\nцикл верифицирует закрытое и ищет новое только в дельте. Обоснование и\nисточники — предложение\n`skills-proposals/applied/2026-10-02-teamlead-gate-one-pass-panel.md`.\n\n### Рубрика судьи: SUB-строки по подкатегориям\n\n- Нумерованный перечень подкатегорий — в шапке брифа судьи; судья идёт по\n  номерам (лечит satisfaction-of-search). Стартовый состав (2–3 на критерий):\n  Корректность — логика / граничные условия / обработка ошибок; Полнота —\n  покрытие AC / пропущенные ветки; Риски — безопасность / данные / прод\n  (mode=code добавляет в Риски: regression red→green / Full Suite (L2) /\n  scope-diff); Реализуемость, Альтернативы, Соответствие контексту — без\n  дробления.\n- Формат строки: `SUB <критерий>/<подкатегория>: PASS|FAIL|N/A — evidence\n  (файл:строка/правило)`, evidence — одна строка.\n- Malformed вердикта: нет SUB-строки по любой подкатегории ИЛИ сплошные N/A\n  больше 2/3 подкатегорий при нуле содержательных наблюдений. Один\n  malformed-retry на судью тем же слотом — не ест лимит «≤2 судей в\n  retry/fallback за прогон». SUB-строки — в R1; формат D-раунда — `council-consensus.md` §4.\n- Свёртка: FAIL любой подкатегории = FAIL критерия; N/A не голосует;\n  majority-агрегация и взвешенная сумма по 6 критериям не меняются.\n\n### Полнота прохода: батч, не капельница\n\n- Цель: один тимлид-цикл закрывает ВСЕ известные дефекты кандидата; режим «одна\n  ошибка за итерацию» — дефект процесса.\n- Судья: запреты и предписания блока «ПОЛНОТА ВЫДАЧИ» (§1).\n- Malformed (дополнение к рубрике; в R1 — D-раунд и C1 по `council-consensus.md` §4): нет COVERAGE/FINDINGS_COMPLETE; k<K; N ≠ числу\n  F-блоков; F-блок без file:line/evidence/priority; «и т.п.» вместо перечня мест.\n  Один malformed-retry тем же слотом, как для SUB-строк.\n- В батч идут все F-блоки леджера; перепроверка FAIL (universal-panel ШАГ 1)\n  передаётся судьям строками RECHECK, находку вычёркивает только совещание\n  (`council-consensus.md` §3, §6); отсев — `WITHDRAWN` и `outcome` excluded (причина —\n  `invalid_after_recheck`/`duplicate_of`/`out_of_scope`/`foreign_key`), фиксируется в леджере.\n- D-раунды (бывший R2) не для вброса отложенных находок: новые blocking после R1\n  имеют метку [late-R2] и идут в отдельный счётчик `r2_late` (не в `late_miss`);\n  метка прежняя, новых имён нет.\n- Метрика цикла N≥2: `late_miss` = число новых blocking вне дельты (кроме регрессий\n  самой правки). Регрессию правки (дефект, внесённый строками дельты sha-N..sha-N+1)\n  классифицирует оркестратор по git-дельте. late_miss ≥1 → «пропуск судьи» в\n  traceability; ≥1 два цикла подряд → эскалация владельцу.\n- Словарь меток: `[pre-existing]` — замечание вне дельты цикла; `late_miss` — метрика\n  (в SKILL.md и леджере то же событие зовётся «пропуск судьи»); `[late-R2]` →\n  счётчик `r2_late`. Других имён (LATE-MISS и т.п.) не вводить.\n\n### F-NNN и кумулятивный дедуп-леджер циклов\n\n- Каждый finding судьи получает ID F-NNN; RW-NNN в `panel-rework-brief.json`\n  наследует номера F. Классификацию повторов ведёт оркестратор по леджеру —\n  судьи новых замечаний ID не знают.\n- Леджер цикла `cycle-<N>/findings-ledger.md` содержит находки этого цикла\n  (`findings_total` = их число) — не открытые на конец совещания, а все выданные в\n  цикле, со статусами завершённого совещания (в том числе `WITHDRAWN` и `outcome`\n  excluded, они уходят в `excluded[]`; `council-consensus.md` §9); кумулятивный\n  дедуп-леджер хранит историю циклов и статусы open/closed. Закрытые находки прошлых\n  циклов в леджер цикла не переносятся — их id встречаются лишь в прозе (`excluded` не нужен).\n- Ключ дедупа: совпадение места (file:line-диапазон) И мета-класса/критерия И\n  сути претензии; совпадение только места ≠ дубль (другой root cause в том же\n  месте — НОВОЕ). Fail-safe: не уверен — считай НОВЫМ с пометкой «спорно».\n  Спор об одном и том же ID два цикла подряд — эскалация владельцу.\n- Finding гасится только «закрыто кодером И верифицировано повторным Советом»\n  (verify-fixed зелёный); повторный FAIL по погашенному ID = «повтор без\n  нового основания», в агрегацию не идёт.\n\n90:### VER-005 (exit `2`, `6.94s`)\n254:### VER-005-SCOPED-PYTEST (exit `0`, `186.63s`)\n264:### VER-005-FULL-UNITTEST-RESILIENCE (exit `0`, `155.70s`)\ncandidate.patch\nexecution-evidence.md\npackage.md\nverification-surface.json\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"cat .ai-team/runs/agy-universal-image-fallback-20261029/teamlead/verification-surface.json; shasum -a 256 .ai-team/runs/agy-universal-image-fallback-20261029/teamlead/package.md .ai-team/runs/agy-universal-image-fallback-20261029/teamlead/candidate.patch bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py; git diff --numstat 012da99905ec27a6133afb4f3e768ff9b4426a8f -- bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py; rg -n 'HL-ENV|Неснимаемые стоп|L2|PREEXISTING|collect|baseline' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/verification-integrity.md' '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/references/council-gates.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
