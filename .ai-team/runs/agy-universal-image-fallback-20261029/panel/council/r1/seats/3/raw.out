ack-20261029/architecture/\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/teamlead/verification-surface.json\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/task.json\",\n    \".ai-team/runs/agy-universal-image-fallback-20261029/plans/architect-01.json\"\n  ],\n  \"materialization\": [],\n  \"approval\": {\n    \"status\": \"NOT_REQUIRED\",\n    \"decision_ids\": [],\n    \"approved_by\": null,\n    \"evidence_ref\": null\n  },\n  \"independent_review\": {\n    \"required\": false,\n    \"status\": \"PENDING\",\n    \"reviewer\": null,\n    \"evidence_ref\": null,\n    \"scope\": \"S2 schema does not require S3 review. teamlead-with-architect still REQUIRES independent external three-family ARCH_PANEL proof before Coder; none claimed here.\"\n  },\n  \"open_questions\": [],\n  \"deferred\": [\n    \"Product implementation and append-only tests are Coder work after external ARCH_PANEL PASS.\",\n    \"Production deployment/config writes/restart and existing DSH chat live acceptance are release work.\",\n    \"Full pixel decoder and audio/video/document decoders are outside this change.\",\n    \"Unknown production SLA/RPS/quota/memory/CPU/FD numbers are NOT measured or fabricated; resource acceptance remains blocked.\"\n  ],\n  \"source_contracts\": [\n    {\n      \"id\": \"CON-01\",\n      \"baseline\": \"ingress: `POST /v1/chat/completions`, HTTP JSON messages и JSON/SSE output; DSH → agy bridge, владелец локального моста. Auth/header/framing/model/effort/body/admission проверки самостоятельны (F-130). Нет доказанного Idempotency-Key/dedup контракта: повтор CLI не равен exactly-once. Test contour: localhost `_HttpBridge`, fake agy (F-216).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-02\",\n      \"baseline\": \"image input: только user `image_url` data/base64 raster; пределы 16, individual/total20971520 bytes, body33554432 bytes. External URLs не читаются; ссылки не должны попасть в CLI fallback. Rejection taxonomy сохранена в strict mode (F-105/F-106/F-206/F-310).\",\n      \"decision_ids\": [\n        \"AD-001\",\n        \"AD-002\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-03\",\n      \"baseline\": \"egress CLI: argv `--add-dir <dir>` и prompt attachments, рабочий cwd отдельно; stdout JSON events, stderr diagnostics; lifecycle `Run.close` и controller. Состояния/error mapping F-114/F-120/F-123/F-125. Не меняется контракт CLI под универсальное inline media API.\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-04\",\n      \"baseline\": \"local config: путь из resolved server ROOT, strict JSON flag read с TTL1s, env override только существующего input flag; production — отдельные files. `start.sh` config не устанавливает (F-101/F-303/F-306/F-307). Новый policy обязан иметь явные чтение, default, cache reset/reload и rollout/rollback; имя ключа решает архитектор.\",\n      \"decision_ids\": [\n        \"AD-001\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-05\",\n      \"baseline\": \"discoverability: `/v1/models`, `/health` сейчас отражают доказанный допуск, не optimistic attempt (F-129). В strict режиме ответы неизменны. Universal effective capability нельзя выдавать за confirmed proof; модель остаётся под catalog validation. Требуются различимые policy/staging/optimistic-attempt поля либо согласованное расширение semantics без мутации static fleet (F-205).\",\n      \"decision_ids\": [\n        \"AD-004\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"CON-06\",\n      \"baseline\": \"fault boundary: ImageReject и ImageSpoolError fail-open к **санитизированному тексту** только при universal=true. Auth/admission/framing/unknown model/unsupported reasoning effort fail-closed по прежнему контракту. Конфиг/его неверный тип fail-closed к strict policy. CLI missing/offline, timeout текстового повтора и оборванный клиент не становятся фиктивным success (F-125/F-130).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    }\n  ],\n  \"invariants\": [\n    {\n      \"id\": \"INV-01\",\n      \"statement\": \"bypass proof не bypass safety validation. Ни fetch/file://, ни MIME expansion, ни превышение resource limits. Strict path сохраняет прежний signature-only контракт. Valid decodable fixtures обязательны для universal positive tests; полноценное pixel decoding — отдельное решение с ограничениями памяти (F-107/F-217).\",\n      \"decision_ids\": [\n        \"AD-001\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-02\",\n      \"statement\": \"normalized media-free history имеет только разрешённые text parts; classification media выполняется раньше чтения `text`. `image_url`, `image`, `input_image` → `[image omitted]`; `input_audio`, `audio`, `video`, `file`, `document`, `inlineData`, `fileData` → `[media omitted]` либо удаление. Проверять и `type`, и соответствующие payload keys, в том числе dict-content; не использовать `str(media_dict)`. Неизвестный structured block не сериализовать целиком. Обычный текст пользователя с URL не цензурировать как вложение (REQ-06/F-112).\",\n      \"decision_ids\": [\n        \"AD-002\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-03\",\n      \"statement\": \"сбой любого изображения в universal admission убирает **все** media данного запроса/истории, без частичного spool/поднабора. Mixed valid raster + unsupported non-image media: raster допускается к optimistic send, прочее media не передаётся agy и не сериализуется. Если режим уже downgraded, никакие старые media не возвращаются через full_prompt (F-111/F-115).\",\n      \"decision_ids\": [\n        \"AD-002\",\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-04\",\n      \"statement\": \"image fallback должен иметь очищенные prompt **и** full_prompt. Перед runtime retry необходим доступ к очищенной истории/предвычисленному full text prompt: в текущем ctx исходных messages нет (F-124). Простой вызов `_messages_to_prompt(original_messages, [])` оставляет image N (F-111). Media-only → placeholder или существующий непустой safe fallback, без attachments (F-113).\",\n      \"decision_ids\": [\n        \"AD-002\",\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-05\",\n      \"statement\": \"runtime guard в точности: attempt1, фактически передан add_dir и непустые images, state не done/client_gone, delivered=false. Его нужно обработать до **обоих** legacy retry-переходов, включая ранний hot continue (F-121). Timeout/idle/first-token states подпадают под owner guard в universal mode, хотя legacy transient их не повторяет (F-122). Только одна text retry, никогда третья.\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-06\",\n      \"statement\": \"немедленно cleanup зарегистрированного img_dir, затем обнулить local и ctx img_dir/images; повтор с `add_dir=None`. Partial-stage failure также cleanup/registry removal. Сохранить slot на текущий ход, освободить ровно один раз; завершение каждого Run до cleanup (F-109/F-110/F-119).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-07\",\n      \"statement\": \"использовать существующий CAS `_session_invalidate(sess_key,cid)` вместо несуществующего имени из брифа; снять собственный cid claim через `_cid_release`, сбросить hot_resumed/conversation_id и переключить на full **stripped** prompt. Text fallback не должен resume прежний explicit CID, который может сохранять attachment context. Plain turn не меняет чужой store; конкурентно обновлённый CID не инвалидировать (F-116/F-117/F-121).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-08\",\n      \"statement\": \"delivered=text/tool_calls/stream reasoning; initial empty SSE delta и keepalive не означают delivery. После delivery или client_gone retry запрещён, файлы всё равно убрать. JSON reasoning ещё не доставлен и не блокирует downgrade (F-120/F-126).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-09\",\n      \"statement\": \"legacy token budget остаётся strict. В universal mode owner требует attempt2 даже при generic retry budget0: архитектура должна предусмотреть одну ограниченную media-degradation попытку/резерв без возможности бесконечных повторов. Это отдельная ветвь, не глобальная отмена retry budget (F-213).\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-10\",\n      \"statement\": \"новый structured event `image_fallback` на каждый фактический downgrade с reason/stage/model/attempt/policy/count и bounded sanitized identifiers. Без auth, base64, media URLs, полного prompt, файловых путей/персональных данных. Старые strict logs и masking не менять (F-209). Причины: collect validation, flag/proof/recheck, spool, attached CLI state; log не заменяет успешную text completion.\",\n      \"decision_ids\": [\n        \"AD-004\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-11\",\n      \"statement\": \"не ловить произвольный Exception как media issue. Constructor LauncherUnavailable/OSError находятся до общей ветви и частично пишут response сами (F-123): не посылать вторые HTTP headers, не выполнять фиктивный успешный fallback. Проверить возможность bounded text retry при безопасном spawn failure отдельно от отсутствующего executable.\",\n      \"decision_ids\": [\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"INV-12\",\n      \"statement\": \"после downgrade и успешного text ответа следующий cold/history turn вновь обрабатывает вход через policy; не оставлять навсегда пометку «model unsupported». Статическое доказательство capability не переписывается из единичного отказа. История с прежними media либо повторно optimistic принимается, либо безопасно stripping по той же политике.\",\n      \"decision_ids\": [\n        \"AD-001\",\n        \"AD-003\"\n      ],\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    }\n  ],\n  \"acceptance_criteria\": [\n    {\n      \"id\": \"AC-01\",\n      \"oracle\": \"REQ-04: полный исходный тестовый файл является неизменным prefix. Сравнить bytes от HEAD с prefix нового файла, а также `git diff --numstat 5a19559426de7508d525e2bd465eff648665a6a7 -- tests/test_agy_bridge_resilience.py`: deleted=0. Одного numstat недостаточно для гарантии «ни одна старая строка не менялась», нужны prefix check и отсутствие замен/переносов. Не удалять `unittest.main` в конце. Appended classes выполнять import discovery: unittest discover или pytest, а не прямым запуском файла (F-218).\",\n      \"verification_ids\": [\n        \"VER-006\"\n      ]\n    },\n    {\n      \"id\": \"AC-02\",\n      \"oracle\": \"REQ-04: все146 существующих методов по полному файлу и отдельно46 image methods должны проходить, включая два log01 и пять f-methods (F-214). Старый VER-007 проверяет40 IDs с asserts, не44 и не execution. VER-006 включает ещё `test_images_strict.py`; его не пропускать (F-314/F-315). `ao10` фиксирует static fleet/defaults и должен остаться зелёным. Полный project suite нужен перед downstream review/MR, Stage1 его не заменяет.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-005\",\n        \"VER-007\"\n      ]\n    },\n    {\n      \"id\": \"AC-03\",\n      \"oracle\": \"REQ-01: policy отсутствует/false/malformed → strict. Policy=true,input=true → любой catalog model и допустимый effort может выполнить real image-attached fake CLI attempt без proof/SHA/efforts_proven. Никакого fabricated confirmed proof. Policy=true,input=false → text-only200 при успешном backend. Unknown model или invalid reasoning effort остаются обычной validation error, это не media fallback (F-130).\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"AC-04\",\n      \"oracle\": \"REQ-02/06: любое media admission/spool failure universal превращается в корректный text-only attempt, с сохранённым текстом и marker/nonempty prompt. В снимке CLI argv/prompt нет add-dir, attachments header, img-N paths, media data/base64/URL/inline objects и `[image N]`. Проверять весь prompt/full_prompt и downstream cold retry, а не только images=[] (F-111/F-124).\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"AC-05\",\n      \"oracle\": \"REQ-03: image-attached error без delivered → ровно две попытки; первая имеет files/attachments, вторая media-free/add_dir=None, clean old dir до запуска второй. JSON200 с реальным completion, SSE200 без error event и с нормальной terminal completion/[DONE]. No retry после delivered/client_gone. Нельзя принимать один SSE status200 за успех (F-126).\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"AC-06\",\n      \"oracle\": \"REQ-05: production deployment должен содержать candidate server/fleet и явный universal=true,input=true в config именно deployed ROOT. Затем живой существующий DSH Desktop чат: image→text fallback→следующий history turn, обе целевые модели и одна ранее text-only catalog запись, повтор и parallel scenario. Зафиксировать безопасный request/run id, model, timings, CLI attempts и response completion, log fallback и отсутствие каталога; не писать payload/auth в отчёт. Если upstream отклоняет даже text данной модели, честно зафиксировать backend limitation, а не назвать200 достигнутым.\",\n      \"verification_ids\": [\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"AC-07\",\n      \"oracle\": \"REQ-06: stripping повторяемо и не мутирует исходный caller payload; после повторной нормализации rendered text и роли/порядок совпадают, placeholders не умножаются. Text-only запросы имеют прежние prompt/protocol и не порождают fallback logs/spool.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"AC-08\",\n      \"oracle\": \"REQ-02/03: media fallback структурно логируется ровно при downgrade, reason/stage/attempt безопасны, нет auth/base64/URL/path/prompt. Старый strict reject log contract остаётся прежним (F-209).\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    }\n  ],\n  \"test_scenarios\": [\n    {\n      \"id\": \"SCN-uf01\",\n      \"oracle\": \"AC-03 / REQ-01: universal enabled и input enabled, прогнать все шесть FLEET_MODELS и допустимые efforts. Убрать/испортить runtime proof SHA, impl_version, formats, efforts_proven без нарушения startup schema; проверить не вызывается strict eligibility gate для universal admission, первый spawn с нужными files и attachments, response200. Отдельно stale binary SHA и catalog unsupported модель. Static FLEET не менять глобально и восстановить patches.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf02\",\n      \"oracle\": \"AC-03/04 / REQ-02: коллектор ImageReject taxonomy: image_url missing/неправильная структура, пустой URL, remote http/https/file/relative, SVG/BMP, corrupt/empty/padding base64, MIME mismatch, unknown magic, assistant/system/tool images,17 images, individual/total overflow. В universal media handling нет400, нет download/local-file read, нет partial image spawn: один stripped text run200 и image_fallback stage=collect. Это параметризованная новая ветка тех же данных `_taxonomy_cases`, старый strict outcome не менять.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf03\",\n      \"oracle\": \"AC-03/04 / REQ-02: policy=true,input=false; затем очередь и flip input true→false после acquire; затем старый proof SHA меняется во время очереди. При выключенном staging только text, без mkdir/add-dir400; proof mismatch при input=true не блокирует universal image send. Во всех cases все slot доступны в конце. Policy malformed/string/int/oversize config → strict по согласованному контракту; re-enable проверяется после TTL/cache reset без process restart.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf04\",\n      \"oracle\": \"AC-04/08 / REQ-02: ENOSPC/EACCES/O_EXCL collision/OSError во втором staged file и mkdir failure → ImageSpoolError. Text-only200, zero media CLI attempts, один text spawn, partial dir отсутствует, registry пуст, permissions не расширены, slots полностью возвращены, image_fallback stage=spool. Cleanup failure отдельно: bounded safe error log без повторного attachments; не утверждать физическое удаление файла без факта, фиксировать cleanup error.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf05\",\n      \"oracle\": \"AC-05 / REQ-03: первый `_execute` agy_error/pump_error/timeout/idle_timeout/first_token_timeout при images, text/tool_calls/stream reasoning пусты; вторая успешна. Exactly2 Run, разные attach modes, файлы удалены **до** второго constructor, оба ctx prompts очищены. Generic retry budget0 и budget30 в universal дают bounded одну text деградацию по owner constraint, strict res03 остаётся прежним. Первый state done — guard не включается, третий run невозможен. Второй failure — честный error, не fabricated200.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf06\",\n      \"oracle\": \"AC-04/05 / REQ-03/06: три хода с tools: cold image, hot new image с injected failure, успешный cold text fallback и следующий history text turn. Проверить ранний hot continue тоже downgrade; `_session_invalidate` вызывается с ожидаемым key/cid, собственный claim снят, hot_resumed=false и conversation_id пуст до text retry; новый CID commit только после success. В full prompt нет old/new attachments/media. Явный conversation_id тоже не должен resume загрязнённую сессию после downgrade.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf07\",\n      \"oracle\": \"AC-04/07 / REQ-06: типы `image_url`, `image`, `input_image`, `input_audio`, `audio`, `video`, `file`, `document`, а также `inlineData`/`fileData` в type/key и dict-content. Media part с собственным `text` не проходит как текст. Unknown structured object не сериализуется. Mixed normal text/valid raster/audio: text сохранён, допустимое image отправляется на первой optimistic попытке, audio удалено; при последующем downgrade нет вообще медиа. Media-only сообщение остаётся безопасно непустым. Исходные messages равны deep copy после обработки.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf08\",\n      \"oracle\": \"AC-05 / REQ-03: первый error после delivered text, tool_calls или SSE reasoning — один run и cleanup, без второго ответа. JSON reasoning-only ещё не delivered: text fallback допустим. Client disconnect не запускает fallback, убирает текущий Run/каталог и возвращает slot. Initial empty assistant delta/keepalive не блокирует допустимый retry. State done + bad rc/empty output и missing launcher/constructor OSError проверить как отдельные исключения RISK-03: ни двойных headers, ни fake success.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf09\",\n      \"oracle\": \"AC-04/07 / REQ-02/06: повтор одинаковой mixed-media history и повторная normalization, роли system/user/assistant/tool и исходный Unicode/порядок/обычные текстовые URL сохраняются; placeholders стабильны. Hot→cold и cold→hot, images только в старой истории, отсутствующий assistant, latest image-only, empty content и все media rejected: ни новый attachments из full_prompt, ни зависание/empty output. После успешной деградации следующий request снова проходит policy, нет permanent model deny-cache.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-uf10\",\n      \"oracle\": \"AC-01/02/06/08 / REQ-04/05: strict→universal→strict cache/config isolation; static ao10; effective health/models optimistic policy без fake proof; two concurrent tools requests с разными model/cwd и одинаковым cwd/CID CAS race; один media-fallback не удаляет чужие dirs/не инвалидирует обновлённый CID. Sweep во время staging и cleanup, повторные requests на фоне, rollback universal flag без restart, production config read-back. Structured logs sanitized, FD/dirs/children/slots после серии возвращаются к baseline. Запись production config и реальные DSH ходы — release, не unit тест и не Stage1.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"SCN-B01\",\n      \"oracle\": \"REQ-01/02:0/1/16/17 images; exactly byte cap и cap+1 для individual/total, base64 padding0/1/2, MIME case; invalid MIME → omission, не попытка decode произвольного формата. Global count учитывает всю историю. Count/encoded length rejection до expensive decode по прежнему контракту.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-B02\",\n      \"oracle\": \"REQ-02: HTTP body cap±1, inflight body budget и connections cap. Для body/admission overflow сохраняются413/503 (F-130/F-310); universal не должен читать бесконечный body ради удаления images. Auth failures401, invalid JSON/framing400, unknown model400 и invalid reasoning_effort400 не переклассифицируются в image fallback.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    },\n    {\n      \"id\": \"SCN-R01\",\n      \"oracle\": \"REQ-03: две попытки ограничивают call amplification до2; при batch с проваленными images измерить длительность/CPU/RSS/FD и admission. Сравнить исходные/candidate значения, не обещать throughput по одному local fake run. Native tool side effects до failure не исключаются delivered guard; для неидемпотентного сценария необходим отдельный безопасный oracle, без внешней записи.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"SCN-R02\",\n      \"oracle\": \"REQ-02/03: lifecycle permissions0700/0600, no symlink traversal, no overwrite O_EXCL, stale orphan cleanup, active protected, cancellation во время stage/run/fallback, cleanup errors. Проверять живое существование/отсутствие dir на каждой фазе, а не только возврат функции.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    },\n    {\n      \"id\": \"SCN-I01\",\n      \"oracle\": \"REQ-06: normalize(normalize(messages)) эквивалентен normalize(messages), повтор клиентского запроса может сделать второй CLI turn — не заявлять exactly-once без dedup контракта. No duplicate chunks в пределах одного запроса после fallback; tool-call delivery блокирует replay.\",\n      \"verification_ids\": [\n        \"VER-003\"\n      ]\n    }\n  ],\n  \"frozen_inputs\": {\n    \"analysis/agy-universal-image-fallback/evidence-ledger.md\": \"ae5bc560087d180ce4f20333028c5ad472ea772dbccf6a7b82bcb6ce7d8db59f\",\n    \"analysis/agy-universal-image-fallback/handoff-architect.md\": \"7e5f684041b65986f4ff7c8f05f67e930f497165ce5c26fd74d8ee95df9f92f6\",\n    \"analysis/agy-universal-image-fallback/handoff-qa.md\": \"6a71c3352f56f012e6c3e406cabad0ebbf43aad5afc325399b767b2753877377\",\n    \"analysis/agy-universal-image-fallback/open-questions.md\": \"f4d2914546a192f16993873c1c2d91365a65e93d2dc611963fb5eeb0af2e740e\",\n    \"analysis/agy-universal-image-fallback/research-plan.md\": \"e639555a5c7df5f6f4a9a7876e8902e0ee2989b410f8569e9d640ff3332cf898\"\n  },\n  \"runtime_view\": {\n    \"flow\": [\n      \"HTTP validation -> capture universal/input -> full stripped prompt\",\n      \"collect: disabled/invalid -> media-free cold text; valid raster -> optimistic image metadata\",\n      \"slot acquired -> input recheck -> register/stage; flag/spool failure -> cleanup/CID reset -> text attempt1\",\n      \"Run(image attempt1) -> close -> done/client_gone/delivered stop\",\n      \"eligible undelivered failure -> runtime guard BEFORE hot/transient -> log/cleanup/CAS+claim release/prompts stripped\",\n      \"budget token OR one request reserve -> jitter -> Run(text attempt2,add_dir=None,no old --resume)\",\n      \"success new CID commit or truthful failure -> slot release exactly once -> JSON completion/SSE terminal\"\n    ],\n    \"no_transport_rewrite\": true\n  },\n  \"threat_model\": {\n    \"required\": true,\n    \"assets\": [\n      \"auth key\",\n      \"user text/media base64\",\n      \"private file paths\",\n      \"other requests CID/slot/spool\",\n      \"backend capacity\"\n    ],\n    \"trust_boundaries\": [\n      \"untrusted structured content -> validated local raster bytes\",\n      \"private spool -> CLI add-dir sandbox\",\n      \"one request/session owner -> shared registry/session map\",\n      \"private request -> structured stderr logs\",\n      \"checkout -> deployed runtime\"\n    ],\n    \"threats\": [\n      {\n        \"id\": \"THREAT-001\",\n        \"scenario\": \"SSRF/local file exfil via image URL, inline object or media.text\",\n        \"mitigation\": \"Never fetch URL; bounded dataURL raster validation; image/media classification before text; unknown structured payload never str(dict).\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-009\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-002\",\n        \"scenario\": \"Secret/base64/path disclosure through fallback log or full_prompt\",\n        \"mitigation\": \"Safe identifiers only, preserve masked native log sink; both prompts replaced with precomputed stripped full history.\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-009\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-003\",\n        \"scenario\": \"Cross-request CID/dir deletion or retained dirty resume\",\n        \"mitigation\": \"Private directory identity, owner-safe _cid_release(cid,turn_id), CAS matching invalidation; no plain store writes; concurrency/sweep interleaving tests.\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-010\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-004\",\n        \"scenario\": \"Resource exhaustion through invalid images and unlimited fallbacks\",\n        \"mitigation\": \"Same max16/20MiB/body/admission caps, no pre-slot spool, two attempts maximum, reserve single-use; release profile cannot be waived by local suite.\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-005\",\n          \"VER-010\"\n        ]\n      }\n    ]\n  },\n  \"pre_mortem\": [\n    \"If hot agy_error branch runs first, retry retains attachments: uf06 and runtime ordering evidence are mandatory.\",\n    \"If only ctx.prompt changed, full_prompt reintroduces old media: uf05/06/09 inspect BOTH prompts before next Run.\",\n    \"If generic bucket exhausted, fallback silently omitted: uf05 tests0tenths with one reserve and jitter.\",\n    \"If health.images becomes dict, strict ao01 identity breaks: keep boolean and add image_fallback object.\",\n    \"If normalization checks text first, media.text leaks: all media forms include tainted text in uf07.\",\n    \"If new config enabled globally in test environment, strict suite changes behavior: process runner unsets new env and every new fixture restores scoped state.\"\n  ],\n  \"evolution\": {\n    \"compatibility\": \"No storage/schema migration. universal flag absent/false preserves strict gates, proofs, retries and error semantics; bool API images fields retained; no changes fleet/default constants. Explicitly requested behavior activates only when flagtrue.\",\n    \"migration\": \"No persisted data migration; runtime server is a separate regular file from checkout. Deployed JSON is untracked, update only specified booleans preserving unrelated keys. Existing dirty image CIDs are invalidated only on their own downgrade; no blanket store wipe.\",\n    \"rollout\": \"Stage2 author packet -> mechanical gate -> EXTERNAL3-family ARCH_PANEL proof -> Coder append regressions+server fix -> independent VER001..009/full suite -> external code council ACCEPT -> managed runtime server deployment/restart -> both flags true -> VER010 evidence in EXISTING owner DSH conversation. Stage2 does none of deployment/flags/live acceptance.\",\n    \"rollback\": \"Set IMAGE_FALLBACK_ENABLED=false in deployed JSON or immediate envfalse; TTL<=1s next evaluation; preserve IMAGE_INPUT_ENABLED as deliberate strict staging choice. Captured in-flight policy completes its bounded path, not retroactively mutated. If rollback code, restore backed-up server and verify fleet pair via managed restart. Config-only rollback needs no restart.\",\n    \"mixed_versions\": \"Old server ignores unknown fallback key and remains strict; new server missing key remains strict. Do not advertise activation solely from JSON or health; deployed hash + real request evidence required. Env override must be accounted for independently.\"\n  },\n  \"reuse_brief\": {\n    \"reference\": [\n      \"analysis/agy-image-input-fix/\",\n      \"evidence-ledger F109/F117/F202/F313/F314/F315\",\n      \"existing _collect_images/_stage_images/_cleanup_img_dir/_session_invalidate/_cid_release and _ImgEnv fake HTTP corpus\"\n    ],\n    \"KEEP\": [\n      \"body and slot admission\",\n      \"size-before-decode\",\n      \"secure staging/active registry/sweep\",\n      \"cwd/argv\",\n      \"strict gate/proof and same-files retry\",\n      \"delivery guard\",\n      \"native JSON/SSE protocol\",\n      \"whole baseline tests\"\n    ],\n    \"CHANGE\": [\n      \"independent policy\",\n      \"safe normalization\",\n      \"three targeted downgrade transitions\",\n      \"one bounded media reserve\",\n      \"effective observability\",\n      \"explicit deployed activation\"\n    ],\n    \"BLOCKER\": \"Literal old flow requires400/spool500 and retains images on retry; sibling text-first placeholder renderer is unsafe for media.text/dict-content. Adapt existing machinery; do not build a new transport.\"\n  },\n  \"resource_envelope\": {\n    \"schema\": \"HL-ENV/v1\",\n    \"fields\": {\n      \"P_steady\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"pod count не задан; локальный server entry F-303/F-307.\"\n      },\n      \"P_hpa_max\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"HPA manifest не предоставлен; F-302.\"\n      },\n      \"maxSurge_pct\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не задано в текущем entry; F-307.\"\n      },\n      \"maxSurge_abs\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не задано; F-307.\"\n      },\n      \"maxUnavailable_pct\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не задано; F-307.\"\n      },\n      \"maxUnavailable_abs\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не задано; F-307.\"\n      },\n      \"P_terminating_overlap\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не измерено; F-307.\"\n      },\n      \"P_live\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"production process count не измерен; F-306 не является PID proof.\"\n      },\n      \"P_avail_min\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не установлен контракт доступности; CON-01.\"\n      },\n      \"W\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"UNKNOWN effective OS worker process count; Stage1 reports MAX_CONCURRENT=4 execution slots, which is NOT proc/pod W. Do not substitute slots for process multiplicity.\"\n      },\n      \"N_proc\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"Python server + ограниченные CLI children, фактический count не измерен; F-119/F-307.\"\n      },\n      \"N_proc_steady\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не измерено; CON-03.\"\n      },\n      \"N_proc_avail_min\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не задано; CON-03.\"\n      },\n      \"CPU_limit_per_pod\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"CPU quota не задана local entry; F-307.\"\n      },\n      \"κ_skew\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"профиль перекоса запросов не измерен; CON-01.\"\n      },\n      \"u_bg_worker\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"CPU background utilisation не измерена; F-132.\"\n      },\n      \"U_pod_sidecars\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"sidecar topology не предоставлена; F-302/F-307.\"\n      },\n      \"Mem_limit_per_pod\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"RSS hard quota не задана; F-307.\"\n      },\n      \"Mem_rss_worker_max\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"high-water RSS не измерен; F-310 — лишь payload caps.\"\n      },\n      \"Mem_shared_max\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"shared RSS не измерен; CON-03.\"\n      },\n      \"RPS_peak\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"не измерен; CON-01.\"\n      },\n      \"A_max\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"≤2 CLI attempts/request as-is; F-119. Universal не увеличивает выше2.\",\n        \"design_value\": 2\n      },\n      \"SLA_p99_s\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"контрактный SLA не предоставлен; CON-03.\"\n      },\n      \"N_entities_max\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"≤16 images/request; F-310.\"\n      },\n      \"Limit_dep_share[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"upstream agy quota/share не предоставлена; CON-03.\"\n      },\n      \"Limit_dep_rps[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"upstream RPS quota не предоставлена; CON-03.\"\n      },\n      \"W_fetchers[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"remote media fetchers отсутствуют в текущем collector; F-106; agy internal upstream concurrency не исследована.\"\n      },\n      \"J_init_s[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"startup jitter не установлен входами; CON-03.\"\n      },\n      \"J_pod_s[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"pod jitter не установлен; F-307.\"\n      },\n      \"T_poll_s[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"image config TTL1 s и sweep600 s; F-101/F-132.\"\n      },\n      \"K_calls[d]\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"≤2 CLI attempts/request, network calls внутри agy не измерены; F-119.\"\n      },\n      \"T_base_s[d]\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"legacy full jitter U(0,2 s) на единственном retry; F-404.\"\n      },\n      \"T_cap_s[d]\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"retry pause cap2 s; queue900 s / execution1800 s / first event120 s — repo ceilings, не SLA; F-404/F-405.\"\n      },\n      \"Max_stale_age_s[c]\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"image flag cache TTL1 s, fallback policy ещё не существует; F-101/F-301.\",\n        \"design_value_s\": {\n          \"image_input\": 1.0,\n          \"image_fallback\": 1.0\n        }\n      },\n      \"Min_healthy_ratio\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"routing panic threshold здесь не найден; catalog predicate не health quorum; F-129.\"\n      },\n      \"B_retry_max\": {\n        \"value_status\": \"KNOWN_DEFAULT_OR_CAP\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"generic capacity3 tokens, cost1, credit0.2/request; fixture0/30 задаётся в tenths, не quota RPS; F-404/F-213.\"\n      },\n      \"min_reserve_retry_rps\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"No timed global replenishment introduced. New reserve is1 per eligible request, not a fabricated measured req/s. Distinguish generic strict .2/request budget from universal reserve amplification.\"\n      },\n      \"FD_worker\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-ENV\",\n        \"statement\": \"FD high-water не измерен; F-109 описывает permissions, не FD budget.\"\n      },\n      \"ulimit_n\": {\n        \"value_status\": \"UNKNOWN_OR_PARTIAL\",\n        \"source\": \"analysis/agy-universal-image-fallback/handoff-architect.md#HL-