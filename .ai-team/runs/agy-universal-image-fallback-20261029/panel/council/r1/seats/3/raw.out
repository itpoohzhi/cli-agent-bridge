ation\": \"Ingress auth/framing/model/effort/body limits run before media fallback unchanged; whole-request strip never means unlimited parsing/fetching.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-005\",\n        \"VER-009\"\n      ]\n    },\n    {\n      \"id\": \"RISK-008\",\n      \"source_id\": \"RISK-08\",\n      \"scenario\": \"No measured quota/RPS/p99/memory/CPU/FD budget, plus reserve allows up to2N CLI executions.\",\n      \"probability\": \"medium\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Record all46 HL fields with UNKNOWN facts; no capacity PASS; require release resource measurement and owner quota/SLA before production acceptance. Do not claim generic retry bound for universal reserve.\",\n      \"verification_ids\": [\n        \"VER-003\",\n        \"VER-010\"\n      ]\n    }\n  ],\n  \"verification_surface\": [\n    {\n      \"id\": \"VER-001\",\n      \"requirement_ids\": [\n        \"REQ-04\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env uvx ruff@0.17.3 check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\n      \"expected\": \"exit 0; no lint errors; never use --fix on frozen baseline\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n      \"owner\": \"Verifier\"\n    },\n    {\n      \"id\": \"VER-002\",\n      \"requirement_ids\": [\n        \"REQ-04\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"run-guarded -- env uvx ruff@0.17.3 format --check --no-cache bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\",\n      \"expected\": \"exit 0; no formatting writes to original prefix\",\n      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not execu