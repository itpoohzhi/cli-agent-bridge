lable\n+            universal = bool(typed_ctx.get(\"universal_fallback\"))\n             if images and img_dir is not None:\n-                # Флаг и proof могли смениться, пока ход ждал слот: повторная проверка\n-                # до mkdir и spawn.\n-                gate = _image_gate(cast(str, model), cast(str, effort))\n-                if gate is not None:\n-                    self._log_reject(\n-                        gate.code, cast(str, model), cast(int, ctx[\"model_len\"])\n-                    )\n-                    rejected = _terminal_state(\"image_reject\", gate.code)\n-                    self._log_done(\n-                        cast(str, ctx[\"model\"]),\n-                        rejected,\n-                        t_enter,\n-                        cast(str, ctx[\"tag\"]),\n+                if universal and not _is_image_input_enabled():\n+                    # Staging выключили, пока ход ждал слот: media не отправляем,\n+                    # ход идёт текстом (без mkdir и --add-dir).\n+                    _downgrade_to_text_in_run_once(\n+                        typed_ctx, \"post_slot\", \"flag_disabled\", 1, img_dir\n                     )\n-                    return rejected\n-                # Реестр активных каталогов ПЕРЕД mkdir: sweep не тронет живой ход.\n-                with _active_lock:\n-                    _active_img_dirs.add(str(img_dir))\n-                img_registered = True\n-                try:\n-                    _stage_images(img_dir, images)\n-                except ImageSpoolError as exc:\n-                    _log(\n-                        \"image_spool_error model=%s err=%s\"\n-                        % (_safe_log_value(cast(str, model)), exc)\n-                    )\n-                    failed = _terminal_state(\"image_spool_error\", str(exc))\n-                    self._log_done(\n-                        cast(str, ctx[\"model\"]), failed, t_enter, cast(str, ctx[\"tag\"])\n+                    images = []\n+                    img_dir = None\n+                else:\n+                    # Флаг и proof могли смениться, пока ход ждал слот: повторная\n+                    # проверка до mkdir и spawn (universal — только флаг, выше).\n+                    gate = (\n+                        None\n+                        if universal\n+                        else _image_gate(cast(str, model), cast(str, effort))\n                     )\n-                    return failed\n+                    if gate is not None:\n+                        self._log_reject(\n+                            gate.code, cast(str, model), cast(int, ctx[\"model_len\"])\n+                        )\n+                        rejected = _terminal_state(\"image_reject\", gate.code)\n+                        self._log_done(\n+                            cast(str, ctx[\"model\"]),\n+                            rejected,\n+                            t_enter,\n+                            cast(str, ctx[\"tag\"]),\n+                        )\n+                        return rejected\n+                    # Реестр активных каталогов ПЕРЕД mkdir: sweep не тронет живой ход.\n+                    with _active_lock:\n+                        _active_img_dirs.add(str(img_dir))\n+                    img_registered = True\n+                    try:\n+                        _stage_images(img_dir, images)\n+                    except ImageSpoolError as exc:\n+                        _log(\n+                            \"image_spool_error model=%s err=%s\"\n+                            % (_safe_log_value(cast(str, model)), exc)\n+                        )\n+                        if not universal:\n+                            failed = _terminal_state(\"image_spool_error\", str(exc))\n+                            self._log_done(\n+                                cast(str, ctx[\"model\"]),\n+                                failed,\n+                                t_enter,\n+                                cast(str, ctx[\"tag\"]),\n+                            )\n+                            return failed\n+                        _downgrade_to_text_in_run_once(\n+                            typed_ctx, \"spool\", \"image_spool_error\", 1, img_dir\n+                        )\n+                        images = []\n+                        img_dir = None\n+                        img_registered = False\n             _retry_credit()\n             for attempt in (1, 2):\n                 _log(\n@@ -3272,11 +3690,40 @@ class Handler(BaseHTTPRequestHandler):\n                     break\n                 # Выдача клиенту: текст, tool_calls или уже отданное в поток мышление.\n                 # JSON-режим мышление клиенту ещё не отдавал — там повтор безопасен.\n+                typed_out = cast(\"dict[str, object]\", out)\n+                delivered_reasoning = bool(\n+                    typed_out.get(\"delivered_reasoning\")\n+                ) or bool(typed_ctx.get(\"stream\") and typed_out.get(\"reasoning\"))\n                 delivered = bool(\n-                    out.get(\"text\")\n-                    or out.get(\"tool_calls\")\n-                    or (ctx.get(\"stream\") and out.get(\"reasoning\"))\n+                    typed_out.get(\"text\")\n+                    or typed_out.get(\"tool_calls\")\n+                    or delivered_reasoning\n                 )\n+                if (\n+                    attempt == 1\n+                    and universal\n+                    and images\n+                    and img_dir is not None\n+                    and out[\"state\"] not in (\"done\", \"client_gone\")\n+                    and not delivered\n+                ):\n+                    # Реальная image-попытка упала без выдачи: один text-only повтор\n+                    # ДО обеих legacy-веток (hot continue и transient). Один токен\n+                    # бюджета, если есть; иначе — разовый резерв деградации запроса.\n+                    _downgrade_to_text_in_run_once(\n+                        typed_ctx,\n+                        \"runtime\",\n+                        _log_token(typed_out.get(\"state\")),\n+                        attempt,\n+                        img_dir,\n+                    )\n+                    images = []\n+                    img_dir = None\n+                    img_registered = False\n+                    if not _retry_take():\n+                        _log(f\"media-degradation-reserve state={out['state']} {tag}\")\n+                    time.sleep(_retry_pause_s(attempt))\n+                    continue\n                 if ctx.get(\"hot_resumed\") and out[\"state\"] != \"client_gone\":\n                     # Горячая сессия сломалась: больше её не используем, а повтор\n                     # идёт холодным вызовом с полной историей.\n@@ -3420,6 +3867,7 @@ class Handler(BaseHTTPRequestHandler):\n         if path in (\"/health\", \"/v1/health\"):\n             with _active_lock:\n                 active = len(_active)\n+            fallback_info, effective = _image_fallback_view()\n             health: dict[str, object] = {\n                 \"ok\": True,\n                 \"transport\": \"agy-stream-json\",\n@@ -3430,7 +3878,8 @@ class Handler(BaseHTTPRequestHandler):\n                 \"tool_emulation\": False,\n                 \"tool_translation\": False,\n                 \"native_tools\": True,\n-                \"images\": any(_model_supports_images(mid) for mid in FLEET_MODELS),\n+                \"images\": any(effective.values()),\n+                \"image_fallback\": fallback_info,\n                 \"image_input_mode\": (\n                     \"enabled\" if _is_image_input_enabled() else \"disabled\"\n                 ),\n@@ -3455,9 +3904,10 @@ class Handler(BaseHTTPRequestHandler):\n             data = []\n             order = [MODEL_ID] + [mid for mid in FLEET[\"order\"] if mid != MODEL_ID]\n             image_flags: list[bool] = []\n+            fallback_info, effective = _image_fallback_view()\n             for mid in order:\n                 model = FLEET[\"models\"][mid]\n-                supports = _model_supports_images(cast(str, mid))\n+                supports = effective[cast(str, mid)]\n                 image_flags.append(supports)\n                 data.append(\n                     {\n@@ -3470,7 +3920,13 @@ class Handler(BaseHTTPRequestHandler):\n                     }\n                 )\n             self._send(\n-                200, {\"object\": \"list\", \"data\": data, \"images\": any(image_flags)}\n+                200,\n+                {\n+                    \"object\": \"list\",\n+                    \"data\": data,\n+                    \"images\": any(image_flags),\n+                    \"image_fallback\": fallback_info,\n+                },\n             )\n             return\n         self._send(\n@@ -3625,20 +4081,70 @@ class Handler(BaseHTTPRequestHandler):\n                 if isinstance(messages_raw, list)\n                 else []\n             )\n-            try:\n-                images = _collect_images(\n-                    messages, cast(str, model_id), cast(str, effort)\n-                )\n-            except ImageReject as rejected:\n-                _log(\"image_reject detail=%s\" % rejected.reason)\n-                self._reject(\n-                    400,\n-                    rejected.code,\n-                    f\"image rejected: {rejected.code}\",\n-                    model_id,\n-                    model_len,\n-                )\n-                return\n+            # Универсальная политика фиксируется один раз на принятый запрос.\n+            universal = _is_image_fallback_enabled()\n+            images: list[dict[str, object]] = []\n+            render_messages: list[object] = messages\n+            stripped_full_prompt = \"\"\n+            force_cold = False\n+            if universal:\n+                image_parts, other_media = _media_part_counts(messages)\n+                if image_parts or other_media:\n+                    stripped_full_prompt = _messages_to_stripped_prompt(messages)\n+                    if not _is_image_input_enabled():\n+                        _log_image_fallback(\n+                            \"collect\",\n+                            \"flag_disabled\",\n+                            cast(str, model_id),\n+                            1,\n+                            image_parts,\n+                        )\n+                        force_cold = True\n+                    else:\n+                        try:\n+                            images = _collect_images(\n+                                messages,\n+                                cast(str, model_id),\n+                                cast(str, effort),\n+                                universal=True,\n+                            )\n+                        except ImageReject as rejected:\n+                            _log_image_fallback(\n+                                \"collect\",\n+                                rejected.reason,\n+                                cast(str, model_id),\n+                                1,\n+                                image_parts,\n+                            )\n+                            images = []\n+                            force_cold = True\n+                        else:\n+                            if images:\n+                                render_messages = _universal_render_messages(messages)\n+                            else:\n+                                _log_image_fallback(\n+                                    \"collect\",\n+                                    \"unsupported_media\",\n+                                    cast(str, model_id),\n+                                    1,\n+                                    other_media,\n+                                )\n+                                force_cold = True\n+            else:\n+                try:\n+                    images = _collect_images(\n+                        messages, cast(str, model_id), cast(str, effort)\n+                    )\n+                except ImageReject as rejected:\n+                    _log(\"image_reject detail=%s\" % rejected.reason)\n+                    self._reject(\n+                        400,\n+                        rejected.code,\n+                        f\"image rejected: {rejected.code}\",\n+                        model_id,\n+                        model_len,\n+                    )\n+                    return\n             img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n             try:\n                 _launcher()\n@@ -3658,7 +4164,12 @@ class Handler(BaseHTTPRequestHandler):\n                 else []\n             )\n             tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n-            full_prompt = _messages_to_prompt(messages, images)\n+            if force_cold:\n+                full_prompt = stripped_full_prompt\n+            else:\n+                full_prompt = _messages_to_prompt(render_messages, images)\n+                if universal:\n+                    stripped_full_prompt = stripped_full_prompt or full_prompt\n             extra = (\n                 req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n             )\n@@ -3679,7 +4190,11 @@ class Handler(BaseHTTPRequestHandler):\n             )\n             is_resumed = False\n             prompt = full_prompt\n-            if conversation_id:\n+            if force_cold:\n+                # Media убраны из истории: «грязный» явный или кэшированный CID\n+                # не возобновляем, ход идёт холодным text-only с полной историей.\n+                conversation_id = \"\"\n+            elif conversation_id:\n                 if _cid_acquire(conversation_id, turn_id):\n                     owned_cid = conversation_id\n                 else:\n@@ -3691,7 +4206,7 @@ class Handler(BaseHTTPRequestHandler):\n                 if use_cid:\n                     conversation_id = use_cid\n                     is_resumed = True\n-                    prompt = _get_resumed_turn_prompt(messages, images)\n+                    prompt = _get_resumed_turn_prompt(render_messages, images)\n             ctx: dict[str, object] = {\n                 \"turn_id\": turn_id,\n                 \"sess_key\": sess_key,\n@@ -3712,6 +4227,8 @@ class Handler(BaseHTTPRequestHandler):\n                 \"stream\": bool(req.get(\"stream\")),\n                 \"images\": images,\n                 \"img_dir\": img_dir,\n+                \"universal_fallback\": universal,\n+                \"stripped_full_prompt\": stripped_full_prompt,\n             }\n             if ctx[\"stream\"]:\n                 self._serve_sse(ctx)\ndiff --git a/tests/test_agy_bridge_resilience.py b/tests/test_agy_bridge_resilience.py\nindex 929414a..ac6c211 100644\n--- a/tests/test_agy_bridge_resilience.py\n+++ b/tests/test_agy_bridge_resilience.py\n            elif kind == \"tool_trace\":\n                tool_events += 1\n                if not on_tool_trace(payload):\n                    gone[0] = True\n                    return state(\"client_gone\", 1)\n            elif kind == \"result\":\n                result_ev = payload\n                usage = payload.get(\"usage\") or {}\n                conversation_id = str(payload.get(\"conversation_id\") or conversation_id)\n                if str(payload.get(\"status\") or \"\").upper() == \"ERROR\":\n                    # Не выходим по result ERROR: мышление последнего шага ещё в очереди\n                    # перед done, и оно обязано попасть в out до решения о повторе.\n                    message = str(payload.get(\"error\") or \"agy reported an error\")\n                    result_error = message[:500]\n                    result_error_at = time.monotonic()\n            elif kind == \"pump_error\":\n                return state(\"pump_error\", 1, str(payload))\n            elif kind == \"done\":\n                rc, final_text, raw_result = payload\n                if result_error:\n                    return state(\"agy_error\", 1, result_error)\n                if not result_ev and raw_result:\n                    result_ev = raw_result\n                if not pieces and final_text:\n                    add_content(final_text)\n                if gone[0]:\n                    return state(\"client_gone\", 1)\n                time.sleep(0.05)\n                err = \"\".join(run.err_box).strip()\n                status = str(result_ev.get(\"status\") or \"\").upper()\n                if rc != 0 and (status == \"ERROR\" or not pieces):\n                    return state(\n                        \"agy_error\",\n                        rc,\n                        (str(result_ev.get(\"error\") or \"\") or err)[:500],\n                    )\n                return state(\"done\", rc, err)\n\n    def _log_done(\n        self, model: str, out: dict[str, object], t0: float, tag: str\n    ) -> None:\n        \"\"\"Одна строка done на каждом выходе _run_once (O-EXIT).\"\"\"\n        conversation = str(out.get(\"conversation_id\") or \"-\")[:8]\n        out_bytes = len(str(out.get(\"text\") or \"\").encode())\n        _log(\n            f\"done model={model} rc={out.get('rc')} state={out.get('state')} \"\n            f\"conversation={conversation} \"\n            f\"turns={out.get('num_turns')} tool_events={out.get('tool_events')} \"\n            f\"out_bytes={out_bytes} \"\n            f\"wall_s={time.monotonic() - t0:.1f} \"\n            f\"err={_err_summary(out.get('err'))!r} {tag}\"\n        )\n\n    def _run_once(\n        self, ctx: dict, on_text, on_tool_trace, on_reasoning, keepalive\n    ) -> dict:\n        model = ctx[\"model\"]\n        effort = ctx[\"effort\"]\n        tag = ctx[\"tag\"]\n        t_enter = time.monotonic()\n        reason = self._acquire_slot(keepalive)\n        if reason:\n            _log(f\"no slot ({reason}) model={model} {tag}\")\n            if reason == \"queue_timeout\":\n                self._log_reject(\"overloaded\", model, ctx[\"model_len\"])\n            early: dict[str, object] = {\n                \"state\": reason,\n                \"rc\": 1,\n                \"text\": \"\",\n                \"usage\": {},\n                \"result\": {},\n                \"err\": \"\",\n                \"tool_calls\": [],\n                \"tool_events\": 0,\n                \"conversation_id\": \"\",\n                \"num_turns\": None,\n                \"duration_s\": None,\n            }\n            self._log_done(\n                cast(str, ctx[\"model\"]), early, t_enter, cast(str, ctx[\"tag\"])\n            )\n            return early\n        t0 = time.monotonic()\n        out: dict = {}\n        typed_ctx = cast(\"dict[str, object]\", ctx)\n        images = cast(\"list[dict[str, object]]\", typed_ctx.get(\"images\") or [])\n        img_dir = cast(\"Path | None\", typed_ctx.get(\"img_dir\")) if images else None\n        img_registered = False\n        try:\n            try:\n                _launcher()\n            except LauncherUnavailable:\n                self._log_reject(\"launcher_unavailable\", model, ctx[\"model_len\"])\n                unavailable: dict[str, object] = {\n                    \"state\": \"launcher_unavailable\",\n                    \"rc\": 1,\n                    \"text\": \"\",\n                    \"usage\": {},\n                    \"result\": {},\n                    \"err\": \"\",\n                    \"tool_calls\": [],\n                    \"tool_events\": 0,\n                    \"conversation_id\": \"\",\n                    \"num_turns\": None,\n                    \"duration_s\": None,\n                }\n                self._log_done(\n                    cast(str, ctx[\"model\"]), unavailable, t_enter, cast(str, ctx[\"tag\"])\n                )\n                return unavailable\n            universal = bool(typed_ctx.get(\"universal_fallback\"))\n            if images and img_dir is not None:\n                if universal and not _is_image_input_enabled():\n                    # Staging выключили, пока ход ждал слот: media не отправляем,\n                    # ход идёт текстом (без mkdir и --add-dir).\n                    _downgrade_to_text_in_run_once(\n                        typed_ctx, \"post_slot\", \"flag_disabled\", 1, img_dir\n                    )\n                    images = []\n                    img_dir = None\n                else:\n                    # Флаг и proof могли смениться, пока ход ждал слот: повторная\n                    # проверка до mkdir и spawn (universal — только флаг, выше).\n                    gate = (\n                        None\n                        if universal\n                        else _image_gate(cast(str, model), cast(str, effort))\n                    )\n                    if gate is not None:\n                        self._log_reject(\n                            gate.code, cast(str, model), cast(int, ctx[\"model_len\"])\n                        )\n                        rejected = _terminal_state(\"image_reject\", gate.code)\n                        self._log_done(\n                            cast(str, ctx[\"model\"]),\n                            rejected,\n                            t_enter,\n                            cast(str, ctx[\"tag\"]),\n                        )\n                        return rejected\n                    # Реестр активных каталогов ПЕРЕД mkdir: sweep не тронет живой ход.\n                    with _active_lock:\n                        _active_img_dirs.add(str(img_dir))\n                    img_registered = True\n                    try:\n                        _stage_images(img_dir, images)\n                    except ImageSpoolError as exc:\n                        _log(\n                            \"image_spool_error model=%s err=%s\"\n                            % (_safe_log_value(cast(str, model)), exc)\n                        )\n                        if not universal:\n                            failed = _terminal_state(\"image_spool_error\", str(exc))\n                            self._log_done(\n                                cast(str, ctx[\"model\"]),\n                                failed,\n                                t_enter,\n                                cast(str, ctx[\"tag\"]),\n                            )\n                            return failed\n                        _downgrade_to_text_in_run_once(\n                            typed_ctx, \"spool\", \"image_spool_error\", 1, img_dir\n                        )\n                        images = []\n                        img_dir = None\n                        img_registered = False\n            _retry_credit()\n            for attempt in (1, 2):\n                _log(\n                    f\"exec model={model} effort={effort} effort_source={ctx['effort_source']} \"\n                    f\"prompt_bytes={len(ctx['prompt'].encode())} \"\n                    f\"tools={ctx['tools_count']} resume={1 if ctx.get('conversation_id') else 0} \"\n                    f\"sess={'agentic' if ctx.get('sess_key') else 'plain'} {tag}\"\n                )\n                try:\n                    run = Run(\n                        ctx[\"prompt\"],\n                        model,\n                        effort,\n                        ctx[\"effort_source\"],\n                        ctx[\"cwd\"],\n                        tag,\n                        conversation_id=ctx.get(\"conversation_id\") or \"\",\n                        turn_id=str(ctx.get(\"turn_id\") or \"\"),\n                        add_dir=img_dir if images else None,\n                    )\n                except LauncherUnavailable:\n                    self._reject(\n                        503,\n                        \"launcher_unavailable\",\n                        \"canonical launcher is missing or not executable\",\n                        model=model,\n                        model_len=ctx[\"model_len\"],\n                    )\n                    out = {\n                        \"state\": \"launcher_unavailable\",\n                        \"rc\": 1,\n                        \"text\": \"\",\n                        \"usage\": {},\n                        \"result\": {},\n                        \"err\": \"\",\n                        \"tool_calls\": [],\n                        \"tool_events\": 0,\n                        \"conversation_id\": \"\",\n                        \"num_turns\": None,\n                        \"duration_s\": None,\n                    }\n                    break\n                except OSError as exc:\n                    out = {\n                        \"state\": \"pump_error\",\n                        \"rc\": 1,\n                        \"text\": \"\",\n                        \"usage\": {},\n                        \"result\": {},\n                        \"err\": repr(exc),\n                        \"tool_calls\": [],\n                        \"tool_events\": 0,\n                        \"conversation_id\": \"\",\n                        \"num_turns\": None,\n                        \"duration_s\": None,\n                    }\n                    break\n                try:\n                    out = self._execute(\n                        run, on_text, on_tool_trace, on_reasoning, keepalive\n                    )\n                finally:\n                    run.close()\n                if out[\"state\"] == \"done\":\n                    break\n                # Выдача клиенту: текст, tool_calls или уже отданное в поток мышление.\n                # JSON-режим мышление клиенту ещё не отдавал — там повтор безопасен.\n                typed_out = cast(\"dict[str, object]\", out)\n                delivered_reasoning = bool(\n                    typed_out.get(\"delivered_reasoning\")\n                ) or bool(typed_ctx.get(\"stream\") and typed_out.get(\"reasoning\"))\n                delivered = bool(\n                    typed_out.get(\"text\")\n                    or typed_out.get(\"tool_calls\")\n                    or delivered_reasoning\n                )\n                if (\n                    attempt == 1\n                    and universal\n                    and images\n                    and img_dir is not None\n                    and out[\"state\"] not in (\"done\", \"client_gone\")\n                    and not delivered\n                ):\n                    # Реальная image-попытка упала без выдачи: один text-only повтор\n                    # ДО обеих legacy-веток (hot continue и transient). Один токен\n                    # бюджета, если есть; иначе — разовый резерв деградации запроса.\n                    _downgrade_to_text_in_run_once(\n                        typed_ctx,\n                        \"runtime\",\n                        _log_token(typed_out.get(\"state\")),\n                        attempt,\n                        img_dir,\n                    )\n                    images = []\n                    img_dir = None\n                    img_registered = False\n                    if not _retry_take():\n                        _log(f\"media-degradation-reserve state={out['state']} {tag}\")\n                    time.sleep(_retry_pause_s(attempt))\n                    continue\n                if ctx.get(\"hot_resumed\") and out[\"state\"] != \"client_gone\":\n                    # Горячая сессия сломалась: больше её не используем, а повтор\n                    # идёт холодным вызовом с полной историей.\n                    _session_invalidate(ctx[\"sess_key\"], ctx[\"conversation_id\"])\n                    _cid_release(\n                        str(ctx[\"conversation_id\"]), str(ctx.get(\"turn_id\") or \"\")\n                    )\n                    ctx[\"hot_resumed\"] = False\n                    ctx[\"conversation_id\"] = \"\"\n                    ctx[\"prompt\"] = ctx[\"full_prompt\"]\n                    if out[\"state\"] == \"agy_error\" and not delivered:\n                        if not _retry_take():\n                            _log(f\"retry-budget-exhausted state={out['state']} {tag}\")\n                            break\n                        _log(\n                            f\"hot session failed err={_err_summary(out.get('err'), 120)!r}, \"\n                            f\"cold fallback {tag}\"\n                        )\n                        continue\n                # Транзиентный сбой до выдачи клиенту — один невидимый повтор.\n                transient = (\n                    out[\"state\"] in (\"agy_error\", \"pump_error\", \"done\")\n                    and not delivered\n                )\n                if not transient or attempt == 2:\n                    break\n                if not _retry_take():\n                    _log(f\"retry-budget-exhausted state={out['state']} {tag}\")\n                    break\n                _log(\n                    f\"transient failure state={out['state']} rc={out.get('rc')} \"\n                    f\"err={_err_summary(out.get('err'), 120)!r}, retry {attempt} {tag}\"\n                )\n                time.sleep(_retry_pause_s(attempt))\n            if (\n                out.get(\"state\") == \"done\"\n                and out.get(\"conversation_id\")\n                and ctx.get(\"sess_key\")\n            ):\n                _session_commit(ctx[\"sess_key\"], str(out[\"conversation_id\"]))\n            if out.get(\"state\") != \"client_gone\":\n                _last_ok[0] = (\n                    time.monotonic()\n                    if (out.get(\"state\") == \"done\" and out.get(\"rc\") == 0)\n                    else 0.0\n                )\n        finally:\n            # Каталог изображений живёт весь ход (все попытки) и уходит до слота.\n            if img_registered and img_dir is not None:\n                _cleanup_img_dir(img_dir)\n            _slots.release()\n        self._log_done(\n            cast(str, ctx[\"model\"]),\n            cast(\"dict[str, object]\", out),\n            t0,\n            cast(str, ctx[\"tag\"]),\n        )\n        return out\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'def _session_|def _cid_|_in_flight_cids|delivered_reasoning|def _messages_to_prompt|def _flatten_content|def _get_resumed_turn_prompt' bridges/agy-bridge/server.py; sed -n '1370,1525p' bridges/agy-bridge/server.py; sed -n '4155,4260p' bridges/agy-bridge/server.py; sed -n '6010,6380p' tests/test_agy_bridge_resilience.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'def _session_|def _cid_|_in_flight_cids|delivered_reasoning|def _messages_to_prompt|def _flatten_content|def _get_resumed_turn_prompt' bridges/agy-bridge/server.py; sed -n '1370,1525p' bridges/agy-bridge/server.py; sed -n '4155,4260p' bridges/agy-bridge/server.py; sed -n '6010,6380p' tests/test_agy_bridge_resilience.py\"","aggregated_output":"232:_in_flight_cids: set[str] = set()\n592:def _flatten_content(content: Any, img_counter: list[int] | None = None) -> str:\n966:def _flatten_content_stripped(content: object) -> str:\n1329:                _in_flight_cids.discard(old_cid)\n1405:def _messages_to_prompt(\n1432:def _get_resumed_turn_prompt(\n1461:def _session_claim(sess_key: tuple, turn_id: str = \"\") -> str:\n1481:        if cid in _in_flight_cids:\n1486:        _in_flight_cids.add(cid)\n1492:def _session_invalidate(sess_key: tuple, cid: str) -> None:\n1499:def _session_commit(sess_key: tuple, cid: str) -> None:\n1891:def _cid_acquire(cid: str, turn_id: str) -> bool:\n1903:def _cid_release(cid: str, turn_id: str) -> None:\n3694:                delivered_reasoning = bool(\n3695:                    typed_out.get(\"delivered_reasoning\")\n3700:                    or delivered_reasoning\n4240:                    _in_flight_cids.discard(use_cid)\n    \"\"\"Сообщение OpenAI в текстовый блок промпта (роли не теряются).\"\"\"\n    if not isinstance(msg, dict):\n        return \"\"\n    role = str(msg.get(\"role\") or \"user\")\n    name = msg.get(\"name\")\n    label = role if not name else \"%s(%s)\" % (role, name)\n    body = _flatten_content(msg.get(\"content\"), img_counter)\n    lines = []\n    calls = msg.get(\"tool_calls\")\n    if isinstance(calls, list):\n        for call in calls:\n            if not isinstance(call, dict):\n                continue\n            fn = call.get(\"function\") if isinstance(call.get(\"function\"), dict) else {}\n            fname = str(fn.get(\"name\") or \"unknown\")\n            fargs = fn.get(\"arguments\")\n            if not isinstance(fargs, str):\n                fargs = (\n                    json.dumps(fargs, ensure_ascii=False) if fargs is not None else \"{}\"\n                )\n            lines.append(\n                \"[tool call %s] %s(%s)\" % (call.get(\"id\") or \"call\", fname, fargs)\n            )\n    if role == \"tool\":\n        cid = msg.get(\"tool_call_id\") or \"call\"\n        lines.append(\"[tool result %s] %s\" % (cid, body))\n    elif body:\n        lines.append(body)\n    prepared = \"\\n\".join(lines).strip()\n    if not prepared:\n        return \"\"\n    counter[0] += 1\n    return \"### %d. %s\\n%s\" % (counter[0], label, prepared)\n\n\ndef _messages_to_prompt(\n    messages: list,\n    images: list[dict[str, object]] | None = None,\n    img_start: int = 0,\n) -> str:\n    \"\"\"Собрать единый текстовый промпт хода.\n\n    Секции протокола инструментов нет намеренно: agy исполняет СВОИ нативные\n    инструменты, а не инструменты DSH (см. README, раздел «Инструменты»).\n    Image-части получают сквозные маркеры `[image N]` (нумерация с `img_start + 1`),\n    а `images` описываются блоком `[attachments]` с абсолютными путями файлов.\n    \"\"\"\n    counter = [0]\n    img_counter = [img_start]\n    blocks: list[str] = []\n    for msg in messages:\n        rendered = _render_message(msg, counter, img_counter)\n        if rendered:\n            blocks.append(rendered)\n    if images:\n        blocks.append(_attachments_block(images))\n    text = \"\\n\\n\".join(blocks).strip()\n    if not text:\n        text = \"Reply with exactly: PONG\"\n    return text\n\n\ndef _get_resumed_turn_prompt(\n    messages: list, images: list[dict[str, object]] | None = None\n) -> str:\n    \"\"\"Промпт хода продолжения: сообщения после последнего assistant.\n\n    Маркеры сохраняют сквозные номера всей истории; `[attachments]` — только для\n    изображений новых сообщений. Без assistant в истории — вся история целиком.\n    \"\"\"\n    last_asst = -1\n    for i in range(len(messages) - 1, -1, -1):\n        if isinstance(messages[i], dict) and messages[i].get(\"role\") == \"assistant\":\n            last_asst = i\n            break\n    if last_asst >= 0 and last_asst + 1 < len(messages):\n        new_msgs = messages[last_asst + 1 :]\n        skipped = len(\n            _collect_image_parts(cast(\"list[object]\", messages[: last_asst + 1]))\n        )\n        delta = [\n            img\n            for img in (images or [])\n            if cast(int, img.get(\"msg_index\", 0)) > last_asst\n        ]\n        prompt = _messages_to_prompt(new_msgs, delta, skipped)\n        if prompt:\n            return prompt\n    return _messages_to_prompt(messages, images)\n\n\ndef _session_claim(sess_key: tuple, turn_id: str = \"\") -> str:\n    \"\"\"Найти живую свободную сессию и занять её; '' — сессии нет.\n\n    Проверка и занятие идут под одним замком: два параллельных запроса не\n    получат один и тот же conversation_id. При непустом `turn_id` владение cid\n    регистрируется в `_active_cid_owners` в той же критической секции.\n    \"\"\"\n    now = time.time()\n    with _session_store_lock:\n        entry = _session_store.get(sess_key)\n        if entry is None:\n            return \"\"\n        if (\n            now - entry[\"last_used\"] > SESSION_IDLE_TTL_S\n            or now - entry[\"created\"] > SESSION_MAX_TTL_S\n            or entry[\"turns\"] >= SESSION_MAX_TURNS\n        ):\n            _session_store.pop(sess_key, None)\n            return \"\"\n        cid = cast(str, entry[\"cid\"])\n        if cid in _in_flight_cids:\n            return \"\"\n        owner = _active_cid_owners.get(cid)\n        if owner is not None and owner != turn_id:\n            return \"\"\n        _in_flight_cids.add(cid)\n        if turn_id:\n            _active_cid_owners[cid] = turn_id\n        return cid\n\n\ndef _session_invalidate(sess_key: tuple, cid: str) -> None:\n    with _session_store_lock:\n        entry = _session_store.get(sess_key)\n        if entry is not None and entry[\"cid\"] == cid:\n            _session_store.pop(sess_key, None)\n\n\ndef _session_commit(sess_key: tuple, cid: str) -> None:\n    now = time.time()\n    with _session_store_lock:\n        entry = _session_store.get(sess_key)\n        if entry is not None and entry[\"cid\"] == cid:\n            entry[\"last_used\"] = now\n            entry[\"turns\"] += 1\n        else:\n            _session_store[sess_key] = {\n                \"cid\": cid,\n                \"last_used\": now,\n                \"created\": now,\n                \"turns\": 1,\n            }\n\n\ndef _ndjson_user_line(prompt: str) -> str:\n    \"\"\"Строка NDJSON для stdin agy — единственный поддерживаемый вход промпта.\"\"\"\n    payload = {\n        \"event\": \"user\",\n        \"message\": {\n            \"role\": \"user\",\n            \"content\": [{\"type\": \"text\", \"text\": prompt}],\n        },\n    }\n    return json.dumps(payload, ensure_ascii=False) + \"\\n\"\n\n                    \"canonical launcher is missing or not executable\",\n                    model_id,\n                    model_len,\n                )\n                return\n            raw_tools = req.get(\"tools\")\n            tools = (\n                [t for t in raw_tools if isinstance(t, dict)]\n                if isinstance(raw_tools, list)\n                else []\n            )\n            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n            if force_cold:\n                full_prompt = stripped_full_prompt\n            else:\n                full_prompt = _messages_to_prompt(render_messages, images)\n                if universal:\n                    stripped_full_prompt = stripped_full_prompt or full_prompt\n            extra = (\n                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            )\n            cwd = str(extra.get(\"cwd\") or \"\")\n            if len(cwd) > CWD_MAX_LEN:\n                cwd = \"\"\n            conversation_id = str(\n                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n            )\n            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n            # и не пишут: ни claim, ни commit, ни invalidate.\n            use_session_store = tools_count > 0\n            sess_key: tuple[str, str, str] | None = (\n                (cast(str, model_id), cwd, cast(str, effort))\n                if use_session_store\n                else None\n            )\n            is_resumed = False\n            prompt = full_prompt\n            if force_cold:\n                # Media убраны из истории: «грязный» явный или кэшированный CID\n                # не возобновляем, ход идёт холодным text-only с полной историей.\n                conversation_id = \"\"\n            elif conversation_id:\n                if _cid_acquire(conversation_id, turn_id):\n                    owned_cid = conversation_id\n                else:\n                    # cid занят другим активным ходом: два хода не делят один разговор.\n                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n                    conversation_id = \"\"\n            elif sess_key is not None:\n                use_cid = _session_claim(sess_key, turn_id)\n                if use_cid:\n                    conversation_id = use_cid\n                    is_resumed = True\n                    prompt = _get_resumed_turn_prompt(render_messages, images)\n            ctx: dict[str, object] = {\n                \"turn_id\": turn_id,\n                \"sess_key\": sess_key,\n                \"hot_resumed\": is_resumed,\n                \"full_prompt\": full_prompt,\n                \"model\": model_id,\n                \"model_len\": model_len,\n                \"effort\": effort,\n                \"effort_source\": effort_source,\n                \"prompt\": prompt,\n                \"cwd\": cwd,\n                \"tools_count\": tools_count,\n                \"conversation_id\": conversation_id,\n                \"tag\": (\n                    f\"client={self._client_tag()} \"\n                    f\"ua={(self.headers.get('User-Agent') or '-')[:60]}\"\n                ),\n                \"stream\": bool(req.get(\"stream\")),\n                \"images\": images,\n                \"img_dir\": img_dir,\n                \"universal_fallback\": universal,\n                \"stripped_full_prompt\": stripped_full_prompt,\n            }\n            if ctx[\"stream\"]:\n                self._serve_sse(ctx)\n            else:\n                self._serve_json(ctx)\n        finally:\n            if use_cid:\n                with _session_store_lock:\n                    _in_flight_cids.discard(use_cid)\n            _cid_release(use_cid or owned_cid, turn_id)\n            if reserved and budget is not None:\n                budget.release(reserved)\n\n    def _serve_json(self, ctx: dict) -> None:\n        out = self._run_once(\n            ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n        )\n        if out.get(\"state\") == \"client_gone\":\n            return\n        err = self._error_body(out)\n        if err is not None:\n            self._send(err[\"code\"], {\"error\": err})\n            return\n        usage = out.get(\"usage\") or {}\n        message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n        reasoning = out.get(\"reasoning\") or \"\"\n        if reasoning:\n            # OpenAI-совместимое поле мышления: Harness читает его из сообщения\n            # ассистента так же, как из дельты потока.\n\nfrom typing import override  # noqa: E402\n\n# ---- Universal image/media fallback: AD-001..AD-005, UF-01..UF-10 --------------------\n# Блок только дописывается после исходных строк файла: все прежние тесты, фикстуры и\n# защитный `__main__` остаются нетронутыми. Новые классы доступны import-discovery\n# (`unittest discover` / pytest), прямой запуск файла их не видит.\n\n_UF_B64: dict[str, str] = {\n    \"image/png\": \"\".join(\n        (\n            \"iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAEklEQVR4nGM8IWfDwMDAxAAGAA5O\",\n            \"ASau9k65AAAAAElFTkSuQmCC\",\n        )\n    ),\n    \"image/jpeg\": \"\".join(\n        (\n            \"/9j/4AAQSkZJRgABAQAAAQABAAD/2wBDAAgGBgcGBQgHBwcJCQgKDBQNDAsLDBkSEw8UHRofHh0aHB\",\n            \"wgJC4nICIsIxwcKDcpLDAxNDQ0Hyc5PTgyPC4zNDL/2wBDAQkJCQwLDBgNDRgyIRwhMjIyMjIyMjIy\",\n            \"MjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjL/wAARCAACAAIDASIAAhEBAxEB/8\",\n            \"QAHwAAAQUBAQEBAQEAAAAAAAAAAAECAwQFBgcICQoL/8QAtRAAAgEDAwIEAwUFBAQAAAF9AQIDAAQR\",\n            \"BRIhMUEGE1FhByJxFDKBkaEII0KxwRVS0fAkM2JyggkKFhcYGRolJicoKSo0NTY3ODk6Q0RFRkdISU\",\n            \"pTVFVWV1hZWmNkZWZnaGlqc3R1dnd4eXqDhIWGh4iJipKTlJWWl5iZmqKjpKWmp6ipqrKztLW2t7i5\",\n            \"usLDxMXGx8jJytLT1NXW19jZ2uHi4+Tl5ufo6erx8vP09fb3+Pn6/8QAHwEAAwEBAQEBAQEBAQAAAA\",\n            \"AAAAECAwQFBgcICQoL/8QAtREAAgECBAQDBAcFBAQAAQJ3AAECAxEEBSExBhJBUQdhcRMiMoEIFEKR\",\n            \"obHBCSMzUvAVYnLRChYkNOEl8RcYGRomJygpKjU2Nzg5OkNERUZHSElKU1RVVldYWVpjZGVmZ2hpan\",\n            \"N0dXZ3eHl6goOEhYaHiImKkpOUlZaXmJmaoqOkpaanqKmqsrO0tba3uLm6wsPExcbHyMnK0tPU1dbX\",\n            \"2Nna4uPk5ebn6Onq8vP09fb3+Pn6/9oADAMBAAIRAxEAPwDk6KKK4z9KP//Z\",\n        )\n    ),\n    \"image/gif\": \"R0lGODdhAgACAIEAAMgePAAAAAAAAAAAACwAAAAAAgACAAAIBgABCAQQEAA7\",\n    \"image/webp\": \"UklGRh4AAABXRUJQVlA4TBEAAAAvAUAAAAdQjyKXp/+BiOh/AAA=\",\n}\n_UF_RASTER: dict[str, bytes] = {m: base64.b64decode(v) for m, v in _UF_B64.items()}\n_UF_TEXT_ONLY = \"gpt-oss-120b\"\n_UF_FAIL_ATTACHED_MODE = (\n    'mode = \"error\" if (scen.get(\"fail_attached\") and \"--add-dir\" in argv) else '\n    + 'beh.get(\"mode\", \"ok\")'\n)\n_UF_FAKE_SOURCE = _FAKE_IMG_SOURCE.replace(\n    'mode = beh.get(\"mode\", \"ok\")', _UF_FAIL_ATTACHED_MODE\n)\nassert _UF_FAKE_SOURCE != _FAKE_IMG_SOURCE\n_UF_MEDIA_NEEDLES = (\"[attachments]\", \"--add-dir\", \"data:image\", \"base64,\", \"/img-\")\n\n\ndef _uf_part(mime: str) -> dict[str, object]:\n    url = \"data:%s;base64,%s\" % (mime, _UF_B64[mime])\n    return {\"type\": \"image_url\", \"image_url\": {\"url\": url}}\n\n\ndef _uf_url(mime: str) -> str:\n    return \"data:%s;base64,%s\" % (mime, _UF_B64[mime])\n\n\ndef _uf_bad_part() -> dict[str, object]:\n    return {\"type\": \"image_url\", \"image_url\": {\"url\": \"http://example.test/a.png\"}}\n\n\ndef _uf_assert_media_free(\n    test: unittest.TestCase, text: str, extra: tuple[str, ...] = ()\n) -> None:\n    test.assertIsNone(re.search(r\"\\[image \\d+\\]\", text), text)\n    for needle in _UF_MEDIA_NEEDLES + extra:\n        test.assertNotIn(needle, text)\n\n\nclass _UfLog:\n    \"\"\"Перехват stderr моста (журнал `_log`) на время блока.\"\"\"\n\n    buffer: io.StringIO\n    _patch: contextlib.AbstractContextManager[object]\n\n    def __init__(self) -> None:\n        self.buffer = io.StringIO()\n        self._patch = cast(\n            \"contextlib.AbstractContextManager[object]\",\n            mock.patch.object(sys, \"stderr\", self.buffer),\n        )\n\n    def __enter__(self) -> _UfLog:\n        _ = self._patch.__enter__()\n        return self\n\n    def __exit__(self, *_exc: object) -> None:\n        _ = self._patch.__exit__(None, None, None)\n\n    def text(self) -> str:\n        return self.buffer.getvalue()\n\n    def events(self) -> list[str]:\n        return [ln for ln in self.text().splitlines() if \" image_fallback \" in ln]\n\n\n_UF_EVENT_RE = re.compile(\n    r\"^\\[agy-bridge\\] \\S+ image_fallback stage=(collect|post_slot|spool|runtime)\"\n    + r\" reason=[A-Za-z0-9_.-]+ model=[A-Za-z0-9_.-]+ attempt=\\d images=\\d+$\"\n)\n\n\nclass _UniEnv(_ImgEnv):\n    \"\"\"_ImgEnv + универсальная политика; оба флага пишутся вместе, всё восстанавливается.\"\"\"\n\n    @override\n    def __enter__(self) -> _UniEnv:\n        _ = _ImgEnv.__enter__(self)\n        _ = self.fake.write_text(\n            \"#!\" + sys.executable + \"\\n\" + _UF_FAKE_SOURCE, encoding=\"utf-8\"\n        )\n        self.fx.set_env(\"AGY_IMAGE_FALLBACK_ENABLED\", None)\n        self.cfg(True, True)\n        return self\n\n    def reset_flag_caches(self) -> None:\n        setattr(_bridge(), \"_image_flag_cache\", (0.0, False))\n        setattr(_bridge(), \"_image_fallback_flag_cache\", (0.0, False))\n\n    def cfg(self, input_enabled: object = True, fallback: object = True) -> None:\n        \"\"\"Оба ключа сразу (`_ImgEnv.flag` перезаписывает файл целиком); None — ключа нет.\"\"\"\n        body: dict[str, object] = {}\n        if input_enabled is not None:\n            body[\"IMAGE_INPUT_ENABLED\"] = input_enabled\n        if fallback is not None:\n            body[\"IMAGE_FALLBACK_ENABLED\"] = fallback\n        self.raw_cfg(json.dumps(body))\n\n    def raw_cfg(self, text: str) -> None:\n        _ = self.fx.config.write_text(text, encoding=\"utf-8\")\n        self.reset_flag_caches()\n\n    def scen_uf(\n        self, spawns: list[dict[str, object]], fail_attached: bool = False\n    ) -> None:\n        body = {\n            \"marks\": str(self.marks),\n            \"recs\": str(self.recs),\n            \"spawns\": spawns,\n            \"fail_attached\": fail_attached,\n        }\n        _ = self.scen.write_text(json.dumps(body), encoding=\"utf-8\")\n\n    def clear_records(self) -> None:\n        for folder in (self.marks, self.recs):\n            for child in folder.iterdir():\n                if child.is_dir():\n                    child.rmdir()\n                else:\n                    child.unlink()\n\n    def assert_clean(self, test: unittest.TestCase) -> None:\n        test.assertEqual(self.img_dirs(), [])\n        test.assertEqual(self.active_dirs(), set())\n        test.assertEqual(self.free_slots(), 4)\n\n\nclass _UfRun(_SnapRun):\n    \"\"\"_SnapRun + промпт, conversation_id и существование прежних каталогов в момент конструктора.\"\"\"\n\n    calls: list[dict[str, object]] = []\n\n    def __init__(self, *args: object, **kwargs: object) -> None:\n        previous = [c[\"add_dir\"] for c in _UfRun.calls if c[\"add_dir\"] is not None]\n        _UfRun.calls.append(\n            {\n                \"prompt\": args[0],\n                \"conversation_id\": kwargs.get(\"conversation_id\"),\n                \"add_dir\": None\n                if kwargs.get(\"add_dir\") is None\n                else str(kwargs.get(\"add_dir\")),\n                \"previous_dirs_exist\": [os.path.exists(str(d)) for d in previous],\n            }\n        )\n        super().__init__(*args, **kwargs)\n\n\nclass _UfRaisingRun:\n    \"\"\"Run, чей конструктор падает OSError (до реального spawn).\"\"\"\n\n    calls: int = 0\n\n    def __init__(self, *_args: object, **_kwargs: object) -> None:\n        _UfRaisingRun.calls += 1\n        raise OSError(24, \"Too many open files\")\n\n    def close(self) -> None:\n        return None\n\n\ndef _uf_reset_runs() -> None:\n    _UfRun.calls.clear()\n    _SnapRun.attempts.clear()\n    _UfRaisingRun.calls = 0\n\n\ndef _uf_ctx(\n    messages: list[dict[str, object]],\n    model: str = \"gemini-4-argon\",\n    effort: str = \"low\",\n    over: dict[str, object] | None = None,\n) -> dict[str, object]:\n    \"\"\"ctx оптимистичного universal-хода: как собирает его do_POST.\"\"\"\n    images = cast(\n        \"list[dict[str, object]]\",\n        _bfn(\"_collect_images\")(messages, model, effort, True),\n    )\n    render = _bfn(\"_universal_render_messages\")(messages)\n    prompt = _str(_bfn(\"_messages_to_prompt\")(render, images))\n    ctx = _ctx(\n        model=model,\n        model_len=len(model),\n        effort=effort,\n        prompt=prompt,\n        full_prompt=prompt,\n        images=images,\n        img_dir=cast(Path, images[0][\"path\"]).parent if images else None,\n        stream=False,\n        universal_fallback=True,\n        stripped_full_prompt=_str(_bfn(\"_messages_to_stripped_prompt\")(messages)),\n        turn_id=\"turn-uf\",\n    )\n    ctx.update(over or {})\n    return ctx\n\n\ndef _uf_run_once(\n    ctx: dict[str, object],\n    execute: Callable[..., dict[str, object]],\n    run_cls: type | None = None,\n) -> dict[str, object]:\n    handler_cls = _bval(\"Handler\")\n    with contextlib.ExitStack() as stack:\n        _ = stack.enter_context(mock.patch.object(_bridge(), \"Run\", run_cls or _UfRun))\n        _ = stack.enter_context(\n            mock.patch.object(_bridge(), \"_launcher\", _fake_launcher_path)\n        )\n        _ = stack.enter_context(mock.patch.object(handler_cls, \"_execute\", execute))\n        with _Sock() as sock:\n            handler = cast(object, _make_handler(sock))\n            setattr(handler, \"client_address\", (\"127.0.0.1\", 1))\n            return _dict(\n                _ofn(handler, \"_run_once\")(\n                    ctx, _text_sink, _tool_sink, _text_sink, None\n                )\n            )\n\n\ndef _uf_set_tenths(value: int) -> None:\n    with cast(\"threading.Lock\", _bval(\"_sqlite_guard_lock\")):\n        setattr(_bridge(), \"_retry_tenths\", value)\n\n\ndef _uf_tenths() -> int:\n    return _int(_bval(\"_retry_tenths\"))\n\n\ndef _uf_store_entry(cid: str) -> dict[str, object]:\n    now = time.time()\n    return {\"cid\": cid, \"last_used\": now, \"created\": now, \"turns\": 1}\n\n\ndef _uf_msgs(*parts: dict[str, object], text: str = \"опиши\") -> list[dict[str, object]]:\n    return [_img_msg(*parts, text=text)]\n\n\nclass UniversalImageFallbackTests(unittest.TestCase):\n    \"\"\"AD-005: universal image/media fallback (UF-01..UF-10), strict-режим не меняется.\"\"\"\n\n    def test_uf01_all_catalog_models_and_efforts_optimistic(self) -> None:\n        models = _dict(_bval(\"FLEET_MODELS\"))\n        gate_spy = mock.patch.object(\n            _bridge(), \"_image_proof_reason\", side_effect=AssertionError(\"proof\")\n        )\n        sha_spy = mock.patch.object(\n            _bridge(), \"_file_sha256\", side_effect=AssertionError(\"sha\")\n        )\n        with _UniEnv() as env:\n            bridge = _HttpBridge()\n            argon = _proof_of(\"gemini-4-argon\")\n            broken = {\"agy_binary_sha256\": \"0\" * 64, \"impl_version\": 99}\n            try:\n                with (\n                    gate_spy,\n                    sha_spy,\n                    mock.patch.dict(argon, broken),\n                    mock.patch.dict(\n                        _dict(_dict(models[\"gemini-4-argon\"])[\"images\"]),\n                        {\"status\": \"unsupported\"},\n                    ),\n                ):\n                    spawned = 0\n                    for model_id in models:\n                        efforts = cast(\"list[str]\", _dict(models[model_id])[\"efforts\"])\n                        for effort in efforts:\n                            with self.subTest(model=model_id, effort=effort):\n                                body = _img_body(\n                                    _uf_msgs(_uf_part(\"image/png\")), model=model_id\n                                )\n                                body[\"reasoning_effort\"] = effort\n                                code, _b = bridge.post(body)\n                                self.assertEqual(code, 200)\n                                spawned += 1\n                                rec = env.records()[-1]\n                                self.assertEqual(len(env.records()), spawned)\n                                self.assertEqual(\n                                    _argv_of(rec)[_argv_of(rec).index(\"--effort\") + 1],\n                                    effort,\n                                )\n                                _expect_files(\n                                    self,\n                                    rec,\n                                    {1: (\"image/png\", _UF_RASTER[\"image/png\"])},\n                                )\n                                prompt = _str(rec[\"prompt\"])\n                                self.assertIn(\"[attachments]\", prompt)\n                                self.assertIn(\"[image 1]\", prompt)\n                    for mime in _IMG_MIMES:\n                        with self.subTest(mime=mime):\n                            code, _b = bridge.post(\n                                _img_body(_uf_msgs(_uf_part(mime)), model=_UF_TEXT_ONLY)\n                            )\n                            self.assertEqual(code, 200)\n                            spawned += 1\n                            _expect_files(\n                                self,\n                                env.records()[-1],\n                                {1: (mime, _UF_RASTER[mime])},\n                            )\n                    sse = _sse_post(\n                        bridge.port,\n                        _img_body(\n                            _uf_msgs(_uf_part(\"image/gif\")),\n                            model=_UF_TEXT_ONLY,\n                            stream=True,\n                        ),\n                    )\n                    spawned += 1\n                    self.assertIn(\"ответ\", sse)\n                    self.assertNotIn('\"error\"', sse)\n                    self.assertTrue(sse.endswith(\"data: [DONE]\\n\\n\"))\n                    code_m, body_m = bridge.post(\n                        _img_body(_uf_msgs(_uf_part(\"image/png\")), model=\"nope\")\n                    )\n                    self.assertEqual(\n                        (code_m, _err(body_m)[\"type\"]), (400, \"model_not_allowed\")\n                    )\n                    bad_effort = _img_body(\n                        _uf_msgs(_uf_part(\"image/png\")), model=_UF_TEXT_ONLY\n                    )\n                    bad_effort[\"reasoning_effort\"] = \"high\"\n                    code_e, body_e = bridge.post(bad_effort)\n                    self.assertEqual(\n                        (code_e, _err(body_e)[\"type\"]),\n                        (400, \"unsupported_reasoning_effort\"),\n                    )\n                    self.assertEqual(len(env.records()), spawned)\n                env.cfg(True, False)\n                code_s, body_s = bridge.post(\n                    _img_body(_uf_msgs(_uf_part(\"image/png\")), model=_UF_TEXT_ONLY)\n                )\n                self.assertEqual(\n                    (code_s, _err(body_s)[\"type\"]), (400, \"image_input_not_supported\")\n                )\n            finally:\n                bridge.close()\n            env.assert_clean(self)\n\n    def test_uf02_image_rejections_strip_all_media(self) -> None:\n        cap = 1000\n        with (\n            _UniEnv() as env,\n            _small_limits(max_image_bytes=cap, max_total_image_bytes=cap),\n","exit_code":0,"status":"completed"}}
