"R-BULK-I4\",\n        \"status\": \"NOT_PROVEN\",\n        \"acceptance_ref\": \"~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/agents/architecture.md#7.2\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-010\"\n        ]\n      },\n      {\n        \"id\": \"R-BULK-I5\",\n        \"status\": \"NOT_PROVEN\",\n        \"acceptance_ref\": \"~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/agents/architecture.md#7.2\",\n        \"verification_ids\": [\n          \"VER-003\",\n          \"VER-010\"\n        ]\n      }\n    ],\n    \"additional_gates\": {\n      \"T-LIFE/v1\": \"own Run close, registry cleanup,slot/CID ownership tests and live scenario required\",\n      \"O-EXIT/v1\": \"keep one done/terminal response per request, new fallback event does not replace existing done\",\n      \"M-SEM/v1\": \"model/effort/cwd session isolation and never bypass ingress catalog/auth\"\n    },\n    \"explicit_owner_override\": \"Owner mandates one media degradation attempt despite empty generic bucket; genericR-BULK-I2 inequality NOT asserted for universal requests. All remaining capacity/latency/FD claims remain unproven; no council or author may label them measured PASS.\",\n    \"failure_matrix\": [\n      {\n        \"dependency\": \"local config read\",\n        \"path\": \"control/request TTL\",\n        \"timeout\": \"bounded file max existing DYNAMIC_CONFIG_MAX_BYTES; no network\",\n        \"bulkhead\": \"per-flag cache lock\",\n        \"failure\": \"fail-closed fallback flag ->strict; input flagoff in universal ->text-only\"\n      },\n      {\n        \"dependency\": \"spool FS\",\n        \"path\": \"hot/post-slot\",\n        \"timeout\": \"existing local FS behavior; no new unsupported hard deadline claim\",\n        \"bulkhead\": \"same execution slot, no new pool\",\n        \"failure\": \"typed ImageSpoolError->strip/CID reset/text; strict500 unchanged\"\n      },\n      {\n        \"dependency\": \"agy CLI/upstream\",\n        \"path\": \"