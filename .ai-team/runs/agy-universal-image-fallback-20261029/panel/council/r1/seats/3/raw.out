    \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=. uvx --from pytest==9.0.3 pytest -q -p no:cacheprovider\",\n    65\t      \"expected\": \"exit 0; full repository suite including all agy/strict tests. No pyproject.toml exists; use pinned uvx, do not invent uv run project config.\",\n    66\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n    67\t      \"owner\": \"Verifier\"\n    68\t    },\n    69\t    {\n    70\t      \"id\": \"VER-006\",\n    71\t      \"requirement_ids\": [\n    72\t        \"REQ-04\"\n    73\t      ],\n    74\t      \"kind\": \"command\",\n    75\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import hashlib, subprocess\\nfrom pathlib import Path\\np='\\\"'\\\"'tests/test_agy_bridge_resilience.py'\\\"'\\\"'; old=subprocess.check_output([\\\"git\\\",\\\"show\\\",'\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"'+\\\":\\\"+p]); new=Path(p).read_bytes()\\nassert len(old)==249933 and hashlib.sha256(old).hexdigest()=='\\\"'\\\"'f318d60537ad862b11313d303644ace3ff5ae74e5d581ceeba86bcf7bddeeff5'\\\"'\\\"'\\nassert new[:len(old)]==old, \\\"Baseline prefix changed\\\"\\nfor b in ['\\\"'\\\"'012da99905ec27a6133afb4f3e768ff9b4426a8f'\\\"'\\\"','\\\"'\\\"'5a19559426de7508d525e2bd465eff648665a6a7'\\\"'\\\"']:\\n rows=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--numstat\\\",b,\\\"--\\\",p],text=True).splitlines()\\n assert all(row.split()[1]==\\\"0\\\" for row in rows), rows\\nsubprocess.run([\\\"python3\\\",\\\"-B\\\",\\\"-m\\\",\\\"unittest\\\",\\\"discover\\\",\\\"-s\\\",\\\"tests\\\",\\\"-p\\\",\\\"test_images_strict.py\\\",\\\"-q\\\"],check=True)\\nprint(\\\"APPEND_ONLY_STRICT_PASS\\\",len(old))'\",\n    76\t      \"expected\": \"whole baseline blob is exact prefix; 0 deleted lines against both baselines; test_images_strict.py executes successfully\",\n    77\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n    78\t      \"owner\": \"Teamlead\"\n    79\t    },\n    80\t    {\n    81\t      \"id\": \"VER-007\",\n    82\t      \"requirement_ids\": [\n    83\t        \"REQ-01\",\n    84\t        \"REQ-02\",\n    85\t        \"REQ-03\",\n    86\t        \"REQ-04\",\n    87\t        \"REQ-06\"\n    88\t      ],\n    89\t      \"kind\": \"command\",\n    90\t      \"command\": \"run-guarded -- env PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast, re\\nfrom pathlib import Path\\nt=ast.parse(Path(\\\"tests/test_agy_bridge_resilience.py\\\").read_text())\\nexpected={f\\\"{p}{i:02}\\\" for p,n in [(\\\"img\\\",10),(\\\"hist\\\",10),(\\\"life\\\",5),(\\\"log\\\",2),(\\\"res\\\",3),(\\\"ao\\\",10),(\\\"uf\\\",10)] for i in range(1,n+1)}\\nfound=set(); uf=set()\\nfor f in ast.walk(t):\\n if isinstance(f,(ast.FunctionDef,ast.AsyncFunctionDef)) and f.name.startswith(\\\"test_\\\") and any(isinstance(a,ast.Assert) or isinstance(a,ast.Call) and isinstance(a.func,ast.Attribute) and isinstance(a.func.value,ast.Name) and a.func.value.id==\\\"self\\\" and a.func.attr.startswith(\\\"assert\\\") for a in ast.walk(f)):\\n  ids={k for k in expected if re.search(r\\\"(?:^|_)\\\"+k+r\\\"(?:_|$)\\\",f.name)}; found.update(ids)\\nfor c in t.body:\\n if isinstance(c,ast.ClassDef) and c.name==\\\"UniversalImageFallbackTests\\\":\\n  assert c.lineno>6008, c.lineno\\n  uf={f\\\"uf{i:02}\\\" for f in c.body if isinstance(f,ast.FunctionDef) for i in range(1,11) if re.match(f\\\"test_uf{i:02}_\\\",f.name)}\\nassert not expected-found, sorted(expected-found)\\nassert uf=={f\\\"uf{i:02}\\\" for i in range(1,11)},uf\\nprint(\\\"QA_ASSERT_COVERAGE_PASS\\\",len(expected))'\",\n    91\t      \"expected\": \"all 40 inherited QA IDs + uf01..uf10 have assertion-bearing test methods; appended UniversalImageFallbackTests exists; execution independently VER003/005\",\n    92\t      \"environment\": \"cwd=repo_root; after Coder, independent clean-room worktree; unset AGY_IMAGE_FALLBACK_ENABLED except scoped tests; PYTHONDONTWRITEBYTECODE=1. Not executed during Stage2.\",\n    93\t      \"owner\": \"Teamlead\"\n    94\t    },\n    95\t    {\n    96\t      \"id\": \"VER-008\",\n    97\t      \"requirement_ids\": [\n    98\t        \"REQ-01\",\n    99\t        \"REQ-02\",\n   100\t        \"REQ-03\",\n   908\t\n   909\tdef _media_part_counts(messages: object) -> tuple[int, int]:\n   910\t    \"\"\"(image-частей, прочих media-частей) во всей истории.\"\"\"\n   911\t    images = 0\n   912\t    other = 0\n   913\t    if not isinstance(messages, list):\n   914\t        return images, other\n   915\t    for msg in cast(\"list[object]\", messages):\n   916\t        if not isinstance(msg, dict):\n   917\t            continue\n   918\t        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n   919\t            if not isinstance(item, dict):\n   920\t                continue\n   921\t            kind = _classify_part(cast(\"dict[str, object]\", item))\n   922\t            if kind == \"image\":\n   923\t                images += 1\n   924\t            elif kind == \"media\":\n   925\t                other += 1\n   926\t    return images, other\n   927\t\n   928\t\n   929\tdef _collect_image_parts_universal(\n   930\t    messages: object,\n   931\t) -> list[tuple[int, int, dict[str, object]]]:\n   932\t    \"\"\"Все image-части истории (любой алиас, list и dict-content) в форме `image_url`.\"\"\"\n   933\t    found: list[tuple[int, int, dict[str, object]]] = []\n   934\t    if not isinstance(messages, list):\n   935\t        return found\n   936\t    number = 0\n   937\t    for msg_index, msg in enumerate(cast(\"list[object]\", messages)):\n   938\t        if not isinstance(msg, dict):\n   939\t            continue\n   940\t        for item in _content_items(cast(\"dict[str, object]\", msg).get(\"content\")):\n   941\t            if not isinstance(item, dict):\n   942\t                continue\n   943\t            part = cast(\"dict[str, object]\", item)\n   944\t            if _classify_part(part) == \"image\":\n   945\t                number += 1\n   960\t        return [_json_copy(v, depth + 1) for v in cast(\"list[object]\", value)]\n   961\t    if value is None or isinstance(value, (str, int, float, bool)):\n   962\t        return value\n   963\t    return str(value)\n   964\t\n   965\t\n   966\tdef _flatten_content_stripped(content: object) -> str:\n   967\t    \"\"\"Контент в безопасный текст без media: image -> `[image omitted]`, media -> `[media omitted]`.\n   968\t\n   969\t    Обычный текст сохраняется в порядке следования (склейка `\\\\n`), неизвестные\n   970\t    структурные объекты не сериализуются; сообщение только из них даёт\n   971\t    `[media omitted]`, чтобы контекст не стал пустым.\n   972\t    \"\"\"\n   973\t    if content is None:\n   974\t        return \"\"\n   975\t    if isinstance(content, str):\n   976\t        return content\n   977\t    parts: list[str] = []\n   978\t    dropped = False\n   979\t    for item in _content_items(content):\n   980\t        if isinstance(item, str):\n   981\t            parts.append(item)\n   982\t        elif isinstance(item, dict):\n   983\t            part = cast(\"dict[str, object]\", item)\n   984\t            kind = _classify_part(part)\n   985\t            if kind == \"image\":\n   986\t                parts.append(_IMAGE_OMITTED)\n   987\t            elif kind == \"media\":\n   988\t                parts.append(_MEDIA_OMITTED)\n   989\t            elif kind == \"text\":\n   990\t                parts.append(cast(str, part[\"text\"]))\n   991\t            else:\n   992\t                dropped = True\n   993\t        elif isinstance(item, list):\n   994\t            dropped = True\n   995\t    if not parts and dropped:\n   996\t        parts.append(_MEDIA_OMITTED)\n   997\t    return \"\\n\".join(p for p in parts if p)\n   998\t\n   999\t\n  1000\tdef _strip_media_from_messages(messages: object) -> list[dict[str, object]]:\n  1001\t    \"\"\"Новый список сообщений без media; вход не мутируется, роли и порядок сохранены.\"\"\"\n  1002\t    out: list[dict[str, object]] = []\n  1003\t    if not isinstance(messages, list):\n  1004\t        return out\n  1005\t    for msg in cast(\"list[object]\", messages):\n  1006\t        if not isinstance(msg, dict):\n  1007\t            continue\n  1008\t        fresh: dict[str, object] = {}\n  1009\t        for key, value in cast(\"dict[object, object]\", msg).items():\n  1010\t            if key == \"content\":\n  1011\t                fresh[\"content\"] = _flatten_content_stripped(value)\n  1012\t            else:\n  1013\t                fresh[str(key)] = _json_copy(value)\n  1014\t        out.append(fresh)\n  1015\t    return out\n  1016\t\n  1017\t\n  1018\tdef _messages_to_stripped_prompt(messages: object) -> str:\n  1019\t    \"\"\"Промпт всей истории без media: нет `[image N]`, `[attachments]`, путей и payload.\"\"\"\n  1020\t    return _messages_to_prompt(\n  1021\t        cast(\"list[object]\", _strip_media_from_messages(messages))\n  1022\t    )\n  1023\t\n  1024\t\n  1025\tdef _universal_render_messages(messages: object) -> list[object]:\n  1026\t    \"\"\"Копия истории для оптимистичной отправки: image — каноничные, прочее media — вон.\n  1027\t\n  1028\t    Длина и индексы сохранены (нужны сквозной нумерации `[image N]` и resume-срезу).\n  1029\t    \"\"\"\n  1030\t    out: list[object] = []\n  1031\t    if not isinstance(messages, list):\n  1032\t        return out\n  1033\t    for msg in cast(\"list[object]\", messages):\n  1034\t        if not isinstance(msg, dict):\n  1035\t            out.append(msg)\n  1036\t            continue\n  1037\t        src = cast(\"dict[str, object]\", msg)\n  1038\t        fresh = dict(src)\n  1039\t        raw_content = src.get(\"content\")\n  1040\t        if isinstance(raw_content, (list, dict)):\n  1041\t            items: list[object] = []\n  1042\t            for item in _content_items(src.get(\"content\")):\n  1043\t                if isinstance(item, str):\n  1044\t                    items.append(item)\n  1045\t                elif isinstance(item, dict):\n  1046\t                    part = cast(\"dict[str, object]\", item)\n  1047\t                    kind = _classify_part(part)\n  1048\t                    if kind == \"image\":\n  1049\t                        items.append(_image_part_canonical(part))\n  1050\t                    elif kind == \"text\":\n  1051\t                        items.append({\"type\": \"text\", \"text\": part[\"text\"]})\n  1052\t            fresh[\"content\"] = items\n  4164\t                else []\n  4165\t            )\n  4166\t            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n  4167\t            if force_cold:\n  4168\t                full_prompt = stripped_full_prompt\n  4169\t            else:\n  4170\t                full_prompt = _messages_to_prompt(render_messages, images)\n  4171\t                if universal:\n  4172\t                    stripped_full_prompt = stripped_full_prompt or full_prompt\n  4173\t            extra = (\n  4174\t                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n  4175\t            )\n  4176\t            cwd = str(extra.get(\"cwd\") or \"\")\n  4177\t            if len(cwd) > CWD_MAX_LEN:\n  4178\t                cwd = \"\"\n  6990\t            \"document\",\n  6991\t            \"inlineData\",\n  6992\t            \"inline_data\",\n  6993\t            \"fileData\",\n  6994\t            \"file_data\",\n  6995\t        )\n  6996\t        image_names = {\"image_url\", \"image\", \"input_image\"}\n  6997\t        for name in names:\n  6998\t            want = \"[image omitted]\" if name in image_names else \"[media omitted]\"\n  6999\t            tainted: dict[str, object] = {\n  7000\t                \"type\": name,\n  7001\t                \"text\": \"LEAK-T\",\n  7002\t                name: {\"data\": \"PAYLOAD-P\", \"url\": \"http://leak.example/x\"},\n  7003\t            }\n  7004\t            with self.subTest(kind=\"type\", name=name):\n  7005\t                for content in ([tainted], tainted):\n  7006\t                    got = _str(flatten(content))\n  7007\t                    self.assertEqual(got, want)\n  7008\t            if name != \"input_image\":\n  7009\t                keyed: dict[str, object] = {\n  7010\t                    \"text\": \"LEAK-K\",\n  7011\t                    name: {\"data\": \"PAYLOAD-K\"},\n  7012\t                }\n  7013\t                with self.subTest(kind=\"key\", name=name):\n  7014\t                    for content in ([keyed], keyed):\n  7015\t                        self.assertEqual(_str(flatten(content)), want)\n  7016\t        self.assertEqual(_str(flatten({\"foo\": {\"bar\": \"SECRET\"}})), \"[media omitted]\")\n  7017\t        self.assertEqual(\n  7018\t            _str(flatten([\"a\", {\"foo\": 1}, 7, {\"type\": \"text\", \"text\": \"b\"}])), \"a\\nb\"\n  7019\t        )\n  7020\t        self.assertEqual(_str(flatten(None)), \"\")\n  7021\t        original: list[dict[str, object]] = [\n  7022\t            {\"role\": \"system\", \"content\": \"Система: ✓\"},\n  7023\t            {\n  7024\t                \"role\": \"user\",\n  7025\t                \"content\": [\n  7026\t                    {\"type\": \"text\", \"text\": \"привет https://example.test/doc\"},\n  7027\t                    _uf_part(\"image/png\"),\n  7028\t                    {\"type\": \"input_audio\", \"input_audio\": {\"data\": \"PAYLOAD\"}},\n  7029\t                ],\n  7030\t            },\n## Неснимаемые стоп-коды HL (полный текст)\n\nВынесено из `SKILL.md` дословно при разгрузке до гейта `skill-authoring` (маркер `<!-- HL-RESILIENCE-GATES-V5 -->`); в `SKILL.md` — краткий гейт и императивная ссылка сюда.\n\nКанонический SSoT — `~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/agents/architecture.md` (`#hl-env-and-four-gates-ssot`); таблица из 21 детерминированного тест-оракула — в `aisdlc-gcge/agents/testing.md` (`<!-- HL-RESILIENCE-ORACLES-V3 -->`). Перед вынесением вердикта `ACCEPT` каждый судья Совета Тимлидов обязан:\n\n1. **Самостоятельно пересчитать численные инварианты** по реальным константам кода и манифестов: полноту 46 полей `REQUIRED_HL_ENV_FIELDS` и бюджет памяти (`HL-ENV-01`), потолок соединений $C_{\\text{dep}}(d) \\le 0.60 \\times \\text{Limit\\_dep\\_share}[d]$ по всем ролям и $G_{\\text{reload}}$ (`C-MULT-I1`), пачечный стартовый залп $B_{\\text{dep, 1s}}(d) \\le 0.50 \\times \\text{Limit\\_dep\\_rps}[d]$ (`S-HERD-I1`), тройное замыкание CPU на $P_{\\text{avail\\_min}}$ (`H-CPU-I5`), бюджет дедлайнов $\\le 0.30 \\times \\text{SLA}_{\\text{p99\\_s}}$ (`R-BULK-I1`), Token-Bucket Retry Budget (`R-BULK-I2`) и post-eviction предикат `Panic-Open` $|V_{\\text{healthy}}| - 1 \\ge N_{\\text{floor}}$ внутри $V_{\\text{eligible}}$ (`R-BULK-I4`).\n2. **Проверить все 21 неснимаемый стоп-код (`HL-ENV-01`, `C-MULT-I1..I5`, `S-HERD-I1..I5`, `H-CPU-I1..I5`, `R-BULK-I1..I5`) + `T-LIFE/v1`, `O-EXIT/v1`, `M-SEM/v1`**: любое нарушение или отсутствие детерминированного теста из `<!-- HL-RESILIENCE-ORACLES-V3 -->` является безусловным `BLOCKER` (`NEEDS WORK`) и не может быть списано в техдолг.\n\n## Инвариант: ВСЕ ЗАМЕЧАНИЯ БАТЧЕМ ЗА ОДИН ПРОХОД\n\n1. Каждый судья за один проход выдаёт ВСЕ замечания сразу; поштучная выдача и обрыв на первой ошибке — malformed (council §1, §3).\n2. Оркестратор сводит F-блоки судей (R1 + D-раунды + особые мнения) в один консенсус-леджер; summarizer — один бриф на ВЕСЬ батч, без «топ-N» (Шаг 5).\n3. `late_miss` — число новых blocking вне дельты (кроме регрессий самой правки; регрессию классифицирует оркестратор по\n   SHA-дельте): «пропуск судьи», в леджер и traceability. Метка `[late-R2]` — отдельный счётчик `r2_late` (council §3).\n\n\n## Обязательные дебаты и исполняемый раннер (консенсус коллегии 28.10.2026)\n\n- Выход после слепого `R1` разрешён только при единогласном `3/3 PASS/ACCEPT`, отсутствии блокирующих находок и расхождений. Любой иной исход обязывает провести анонимизированные дебаты `D1` (при спорных блокерах — один `D2`), затем `C1`; раунд `D3` и повторный запуск того же спора под новым именем запрещены.\n- Исполнитель протокола — `scripts/run_consensus_council.py` (FSM `R1 → RECHECK → D1 → [D2] → C1 → AGGREGATE`, атомарные чекпоинты, `--resume`): три `launch_seat.py` раунда стартуют веером до завершения любого; селектор раундов `r>=2` вызывается только с `--prior-ledger` на неизменяемый снимок леджера прошлого раунда, брифы несут `PRIOR-LEDGER-SHA256`; `verdict.md` извлекается из `raw.out` экстрактором верификатора; `C1` — всегда настоящий раунд, отметка без вызова моделей запрещена. Ручная сборка консенсуса оркестратором и скриптовая генерация итоговых файлов вместо опроса моделей запрещены.\n- Раннер не сертифицирует себя: каждый раунд заново проверяется внешним `verify_panel_proof.py` (`exit=0`, `PASS`); присланному `panel-proof.json` не доверяют. Поддельный или повторный `PANEL-NONCE`, расхождение хеша артефакта и подмена raw-ответа — fail closed (exit 1), переход запрещён.\n- Кворум считается по независимым семействам: нужно 3 семейства, решение по `BLOCKER-OPINION` — не менее 2/3 семейств. Два места одного семейства — один голос. Меньше 3 семейств — `BLOCKED: QUORUM_UNAVAILABLE` (exit 3), а не отмена панели и не одиночное вето. `PAUSED_OWNER` селектора (его exit 3 с готовым манифестом при повторе троицы пула 3of3) кворумом не является: раннер останавливается с exit 4 до явного `--owner-ack-reason` вызывающего; ack пишет сам селектор.\n- Разделение блокеров: `BLOCKER-SAFETY` (доказанный дефект безопасности, утечка данных, сбой обязательных тестов) большинством 2/3 и переклассификацией в `BLOCKER-OPINION` не снимается. Его закрывает только проверяемое контр-доказательство (`REFUTE` с `COUNTER-EVIDENCE`) или принятие конкретного риска владельцем (`RATIFIED_RISK` с ack на находку и хеш артефакта); иначе — `ESCALATED` владельцу (exit 4). `BLOCKER-OPINION` проходит дебаты `R1 → D1 → C1` и решается большинством семейств.\n- Первичный реестр — машинный `consensus/consensus-ledger.json` (`pol-consensus/1.0`); `consensus-ledger.md` и `final-panel-verdict.md` рендерятся только из JSON. Конфликт не стирается ради `CONFLICT=0`: допустимые исходы — `RESOLVED`, `RATIFIED_RISK`, `ESCALATED`; открытый блокер после потолка дебатов эскалируется с сохранением особого мнения.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"Подтвердились два препятствия для ACCEPT: запросы с неизвестным структурным content обходят нормализацию и попадают в старый `str(content)`; обязательный VER-005 прерван с exit 2, а скилл не разрешает заменить L2 узким прогоном.\n\nХеши пакета, патча и обоих файлов совпадают с заявленными. Завершаю проверку безопасности staging, cleanup и полного списка замечаний.\n"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1127,1288p' bridges/agy-bridge/server.py; sed -n '2850,2965p' bridges/agy-bridge/server.py; rg -n '\"'^    def close|''^    def __init__|MAX_CONCURRENT|MAX_PENDING|ADMISSION|RETRY_COST|RETRY_PAUSE'\"' bridges/agy-bridge/server.py; python3 -B - <<'PY'\nimport hashlib,subprocess\nfrom pathlib import Path\nr=Path('.ai-team/runs/agy-universal-image-fallback-20261029/teamlead')\npatch=subprocess.check_output(['git','diff','012da99905ec27a6133afb4f3e768ff9b4426a8f','--','bridges/agy-bridge/server.py','tests/test_agy_bridge_resilience.py'])\nprint('CURRENT_DIFF_MATCHES_CANDIDATE', patch== (r/'candidate.patch').read_bytes())\np='tests/test_agy_bridge_resilience.py'\nb=subprocess.check_output(['git','show','012da99905ec27a6133afb4f3e768ff9b4426a8f:'+p])\nprint('BASE_PREFIX_PRESERVED',len(b),Path(p).read_bytes().startswith(b))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1127,1288p' bridges/agy-bridge/server.py; sed -n '2850,2965p' bridges/agy-bridge/server.py; rg -n '\"'^    def close|''^    def __init__|MAX_CONCURRENT|MAX_PENDING|ADMISSION|RETRY_COST|RETRY_PAUSE'\"' bridges/agy-bridge/server.py; python3 -B - <<'PY'\nimport hashlib,subprocess\nfrom pathlib import Path\nr=Path('.ai-team/runs/agy-universal-image-fallback-20261029/teamlead')\npatch=subprocess.check_output(['git','diff','012da99905ec27a6133afb4f3e768ff9b4426a8f','--','bridges/agy-bridge/server.py','tests/test_agy_bridge_resilience.py'])\nprint('CURRENT_DIFF_MATCHES_CANDIDATE', patch== (r/'candidate.patch').read_bytes())\np='tests/test_agy_bridge_resilience.py'\nb=subprocess.check_output(['git','show','012da99905ec27a6133afb4f3e768ff9b4426a8f:'+p])\nprint('BASE_PREFIX_PRESERVED',len(b),Path(p).read_bytes().startswith(b))\nPY\"","aggregated_output":"    return Path(os.path.abspath(str(WORKSPACE))) / (\"img-\" + uuid.uuid4().hex)\n\n\ndef _collect_images(\n    messages: object, model_id: str, effort: str | None, universal: bool = False\n) -> list[dict[str, object]]:\n    \"\"\"Проверить image-части всей истории; вернуть записи для prompt и spool.\n\n    Нет image-частей — `[]` сразу, без stat/хеша/флага. Порядок отказов: флаг и\n    proof -> число частей -> по каждой части: роль, форма, `data:` URL, MIME,\n    оценка размера base64 ДО decode, строгий base64, сигнатура, лимиты. Ничего не\n    пишется на диск и не запускается. Декодированные байты не удерживаются\n    (`data` пуст): в spool они пересоздаются из base64 уже после захвата слота.\n\n    `universal=True`: image-алиасы (`image`, `input_image`, dict-content) приводятся\n    к `image_url`, а вместо proof-гейта работает `_image_gate_universal`; остальные\n    проверки те же. Любой отказ отбрасывает ВСЕ записи (исключение, без частичного набора).\n    \"\"\"\n    parts = (\n        _collect_image_parts_universal(messages)\n        if universal\n        else _collect_image_parts(messages)\n    )\n    if not parts:\n        return []\n    gate = (\n        _image_gate_universal(model_id, effort)\n        if universal\n        else _image_gate(model_id, effort)\n    )\n    if gate is not None:\n        raise gate\n    max_images = _limit(\"max_images\", 16)\n    if max_images <= 0:\n        raise ImageReject(\"images_disabled\")\n    if len(parts) > max_images:\n        raise ImageReject(\"too_many_images\", \"too_many_images\")\n    max_bytes = _limit(\"max_image_bytes\", 0)\n    max_total = _limit(\"max_total_image_bytes\", 0)\n    allowed_raw = IMAGE_LIMITS.get(\"types\")\n    allowed = {\n        str(t).lower()\n        for t in (\n            cast(\"list[object]\", allowed_raw) if isinstance(allowed_raw, list) else []\n        )\n    }\n    msgs = cast(\"list[object]\", messages)\n    img_dir = _new_img_dir()\n    entries: list[dict[str, object]] = []\n    total = 0\n    for msg_index, number, part in parts:\n        msg = cast(\"dict[str, object]\", msgs[msg_index])\n        if msg.get(\"role\") != \"user\":\n            raise ImageReject(\"non_user_image\", \"invalid_image_content\")\n        ref = part.get(\"image_url\")\n        url = (\n            cast(\"dict[str, object]\", ref).get(\"url\") if isinstance(ref, dict) else None\n        )\n        if not isinstance(url, str) or not url:\n            raise ImageReject(\"invalid_image_url\", \"invalid_image_content\")\n        if url[:5].lower() != \"data:\":\n            raise ImageReject(\"remote_or_file_url\", \"image_url_not_allowed\")\n        comma = url.find(\",\")\n        if comma < 0:\n            raise ImageReject(\"malformed_data_url\", \"invalid_image_content\")\n        header = [h.strip().lower() for h in url[5:comma].split(\";\")]\n        mime = header[0]\n        if not mime or \"base64\" not in header[1:]:\n            raise ImageReject(\"malformed_data_url\", \"invalid_image_content\")\n        if mime not in allowed or mime not in _EXT:\n            raise ImageReject(\"unsupported_mime\", \"unsupported_image_type\")\n        payload = url[comma + 1 :]\n        if _B64_WS.search(payload) is not None:\n            payload = _B64_WS.sub(\"\", payload)\n        if not payload:\n            raise ImageReject(\"empty_payload\", \"invalid_image_base64\")\n        pad = 2 if payload.endswith(\"==\") else (1 if payload.endswith(\"=\") else 0)\n        if (len(payload) * 3) // 4 - pad > max_bytes:\n            raise ImageReject(\"image_too_large\", \"image_too_large\")\n        try:\n            raw = base64.b64decode(payload, validate=True)\n        except Exception:\n            raise ImageReject(\"invalid_base64\", \"invalid_image_base64\") from None\n        if not raw:\n            raise ImageReject(\"empty_image\", \"invalid_image_content\")\n        actual = _sniff_image_type(raw)\n        if actual is None:\n            raise ImageReject(\"unknown_magic\", \"unsupported_image_type\")\n        if actual != mime:\n            raise ImageReject(\"mime_mismatch\", \"image_type_mismatch\")\n        size = len(raw)\n        del raw\n        if size > max_bytes:\n            raise ImageReject(\"image_too_large\", \"image_too_large\")\n        if total + size > max_total:\n            raise ImageReject(\"images_too_large\", \"images_too_large\")\n        total += size\n        ext = _EXT[mime]\n        entries.append(\n            {\n                \"index\": number,\n                \"msg_index\": msg_index,\n                \"mime\": mime,\n                \"ext\": ext,\n                \"size\": size,\n                \"data\": b\"\",\n                \"b64\": payload,\n                \"path\": img_dir / (\"img-%d.%s\" % (number, ext)),\n            }\n        )\n    return entries\n\n\ndef _stage_images(img_dir: Path, images: list[dict[str, object]]) -> None:\n    \"\"\"Материализовать проверенные изображения: каталог 0700, файлы 0600, O_EXCL.\n\n    Байты берутся из base64 здесь, после захвата слота, и сразу сбрасываются.\n    Любая ошибка ввода-вывода удаляет частичный каталог и даёт ImageSpoolError.\n    \"\"\"\n    try:\n        os.makedirs(str(img_dir.parent), exist_ok=True)\n        os.mkdir(str(img_dir), 0o700)\n        for img in images:\n            held = img.get(\"data\")\n            data = (\n                bytes(cast(bytes, held))\n                if held\n                else base64.b64decode(cast(str, img[\"b64\"]), validate=True)\n            )\n            if len(data) != cast(int, img[\"size\"]):\n                raise ValueError(\"size mismatch\")\n            fd = os.open(str(img[\"path\"]), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n            try:\n                handle = os.fdopen(fd, \"wb\")\n            except BaseException:\n                os.close(fd)\n                raise\n            with handle:\n                _ = handle.write(data)\n            img[\"data\"] = b\"\"\n            _ = img.pop(\"b64\", None)\n    except (OSError, ValueError) as exc:\n        shutil.rmtree(str(img_dir), ignore_errors=True)\n        raise ImageSpoolError(type(exc).__name__) from None\n\n\ndef _cleanup_img_dir(img_dir: Path) -> None:\n    \"\"\"Удалить каталог хода и снять его с реестра активных (ошибка видна в журнале).\"\"\"\n    try:\n        shutil.rmtree(str(img_dir))\n    except FileNotFoundError:\n        pass\n    except OSError as exc:\n        _log(\"image_cleanup_error err=%s\" % type(exc).__name__)\n        shutil.rmtree(str(img_dir), ignore_errors=True)\n    finally:\n        with _active_lock:\n            _active_img_dirs.discard(str(img_dir))\n\n\n_IMAGE_MARKER = re.compile(r\"\\[image \\d+\\]\")\n\n        _log(\n            f\"drain cid={self._cid8()} ms={ms} emitted={self.emitted - emitted_before} outcome={self.drain_outcome} pending_steps={pending} exit={exit_kind}\"\n        )\n\n\n@final\nclass Run:\n    \"\"\"Один процесс `agy`; поток-читатель превращает stdout NDJSON в события очереди.\n\n    Промпт подаётся на stdin одной NDJSON-строкой и поток закрывается (`communicate`\n    через отдельный поток-писатель): CLI читает stdin до EOF. `-p` не передаётся\n    никогда — см. модуль-docstring.\n\n    Очередь закрывается атомарно: ни одно (\"reasoning\", …) не ставится после\n    (\"done\", …) — оба события кладутся под `_emit_lock`.\n    \"\"\"\n\n    def __init__(\n        self,\n        prompt: str,\n        model: str,\n        effort: str,\n        effort_source: str,\n        cwd: str,\n        tag: str,\n        conversation_id: str = \"\",\n        turn_id: str = \"\",\n        add_dir: Path | None = None,\n    ):\n        launcher = _launcher()\n        WORKSPACE.mkdir(parents=True, exist_ok=True)\n        work_dir = cwd if (cwd and os.path.isdir(cwd)) else str(WORKSPACE)\n        self.work_dir = work_dir\n        self.stdin_line = _ndjson_user_line(prompt)\n        cmd = [\n            launcher,\n            \"--input-format\",\n            \"stream-json\",\n            \"--output-format\",\n            \"stream-json\",\n            \"--dangerously-skip-permissions\",\n            \"--model\",\n            model,\n            \"--effort\",\n            effort,\n            \"--print-timeout=\" + str(PRINT_TIMEOUT),\n        ]\n        # Изображения хода: каталог файлов отдельным аргументом, cwd не подменяется.\n        if add_dir is not None:\n            cmd += [\"--add-dir\", str(add_dir)]\n        # RESUME: продолжение треда — отдельным флагом, промпт всё равно через stdin.\n        self.run_cid = conversation_id or \"\"\n        self.turn_id: str = turn_id or uuid.uuid4().hex\n        if self.run_cid:\n            cmd += [\"--conversation\", self.run_cid]\n        # Водяной знак resume снимается ДО spawn: история разговора не переотдаётся.\n        plan = _prespawn_plan(self.run_cid, bool(self.run_cid))\n        if self.run_cid and not _cid_acquire(self.run_cid, self.turn_id):\n            plan.anchored = False\n            plan.reason = \"cid_busy\"\n        try:\n            self.proc = subprocess.Popen(\n                cmd,\n                cwd=work_dir,\n                stdin=subprocess.PIPE,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n                start_new_session=True,\n                env=_launch_env(),\n            )\n        except BaseException:\n            _cid_release(self.run_cid, self.turn_id)\n            raise\n        self.started = time.monotonic()\n        enabled = _is_watchdog_enabled()\n        # Kill-switch выключен: порог неактивности = сквозной таймаут, `ps` не вызывается.\n        self.controller = AdaptiveTimeoutController(\n            idle_timeout_s=IDLE_TIMEOUT_S if enabled else float(TIMEOUT_S),\n            safety_cap_s=float(TIMEOUT_S),  # дефолт core (3600 с) не используется\n            finish_reserve_s=0.0,  # эффективный потолок ровно TIMEOUT_S\n            watchdog_enabled=enabled,\n            log_fn=_log,\n        )\n        self.controller.register_pgid(self.proc.pid)\n        self.got_event = False  # True после первого валидного JSON-события stdout\n        self.stderr_head: list = []\n        with _active_lock:\n            _active[self.proc.pid] = self.proc\n        self.q = queue.Queue()\n        self.err_box = []\n        # Последний виденный текст agent_response по id шага: CLI присылает\n        # накопительный снимок, новым считается только хвост сверх него.\n        self._text_seen: dict = {}\n        # Выдача мышления: счётчик байт и закрытие очереди под одним замком.\n        self._emit_lock = threading.Lock()\n        self.drain_closed: bool = False\n        self._done_put: bool = False\n        self._reasoning_bytes: int = 0\n        self._cap_logged: bool = False\n        # Мышление шагов: отдельный поток следит за транскриптом и SQLite разговора и\n        # кладёт в очередь события (\"reasoning\", текст).\n        self._proc_done = threading.Event()\n        self._stop_watch = threading.Event()\n        _decide_turn_mode(plan)\n        self._tail = _TranscriptTail(\n            emit=self._emit_reasoning,\n            stop_event=self._stop_watch,\n            done_event=self._proc_done,\n            resumed=bool(self.run_cid),\n            plan=plan,\n            turn_id=self.turn_id,\n        )\n        if self.run_cid:\n            self._tail.bind(self.run_cid)\n        threading.Thread(target=self._feed_stdin, daemon=True).start()\n        threading.Thread(target=self._drain_stderr, daemon=True).start()\n109:MAX_CONCURRENT = int(os.environ.get(\"AGY_BRIDGE_MAX_CONCURRENT\", \"4\"))\n183:RETRY_COST_TENTHS = 10\n187:RETRY_PAUSE_CAP_S = 2.0\n227:_slots = threading.BoundedSemaphore(MAX_CONCURRENT)\n279:    def __init__(self, reason: str, model: str = \"-\"):\n624:    def __init__(self, reason: str, code: str = \"image_input_not_supported\") -> None:\n1772:        if _retry_tenths < RETRY_COST_TENTHS:\n1774:        _retry_tenths -= RETRY_COST_TENTHS\n1780:    cap = min(RETRY_PAUSE_CAP_S, RETRY_PAUSE_CAP_S * float(1 << max(0, attempt - 1)))\n1793:    def __init__(self) -> None:\n2035:    def __init__(self) -> None:\n2232:    def __init__(self) -> None:\n2284:    def __init__(\n2867:    def __init__(\n3163:    def close(self) -> None:\n3204:    def __init__(self, total: int):\n3876:                \"max_concurrent\": MAX_CONCURRENT,\n4355:    def __init__(self, *args: Any, **kwargs: Any):\n4471:        f\"listen {HOST}:{PORT} model={MODEL_ID} max_concurrent={MAX_CONCURRENT} \"\nCURRENT_DIFF_MATCHES_CANDIDATE True\nBASE_PREFIX_PRESERVED 249933 True\n","exit_code":0,"status":"completed"}}
