       images = _collect_images(\n                                messages,\n                                cast(str, model_id),\n                                cast(str, effort),\n                                universal=True,\n                            )\n                        except ImageReject as rejected:\n                            _log_image_fallback(\n                                \"collect\",\n                                rejected.reason,\n                                cast(str, model_id),\n                                1,\n                                image_parts,\n                            )\n                            images = []\n                            force_cold = True\n                        else:\n                            if not images:\n                                _log_image_fallback(\n                                    \"collect\",\n                                    \"unsupported_media\",\n                                    cast(str, model_id),\n                                    1,\n                                    other_media,\n                                )\n                                force_cold = True\n            else:\n                try:\n                    images = _collect_images(\n                        messages, cast(str, model_id), cast(str, effort)\n                    )\n                except ImageReject as rejected:\n                    _log(\"image_reject detail=%s\" % rejected.reason)\n                    self._reject(\n                        400,\n                        rejected.code,\n                        f\"image rejected: {rejected.code}\",\n                        model_id,\n                        model_len,\n                    )\n                    return\n            img_dir = cast(Path, images[0][\"path\"]).parent if images else None\n            try:\n                _launcher()\n            except LauncherUnavailable:\n                self._reject(\n                    503,\n                    \"launcher_unavailable\",\n                    \"canonical launcher is missing or not executable\",\n                    model_id,\n                    model_len,\n                )\n                return\n            raw_tools = req.get(\"tools\")\n            tools = (\n                [t for t in raw_tools if isinstance(t, dict)]\n                if isinstance(raw_tools, list)\n                else []\n            )\n            tools_count = 0 if _tool_choice_none(req.get(\"tool_choice\")) else len(tools)\n            if force_cold or (universal and not images):\n                full_prompt = stripped_full_prompt\n            else:\n                full_prompt = _messages_to_prompt(render_messages, images)\n                if universal:\n                    stripped_full_prompt = stripped_full_prompt or full_prompt\n            extra = (\n                req.get(\"extra_body\") if isinstance(req.get(\"extra_body\"), dict) else {}\n            )\n            cwd = str(extra.get(\"cwd\") or \"\")\n            if len(cwd) > CWD_MAX_LEN:\n                cwd = \"\"\n            conversation_id = str(\n                extra.get(\"conversation_id\") or req.get(\"conversation_id\") or \"\"\n            )\n            # Горячие сессии — только агентным запросам с инструментами. Фоновые и\n            # plain-запросы (в т. ч. генерация заголовка DSH, tools=0) стор не читают\n            # и не пишут: ни claim, ни commit, ни invalidate.\n            use_session_store = tools_count > 0\n            sess_key: tuple[str, str, str] | None = (\n                (cast(str, model_id), cwd, cast(str, effort))\n                if use_session_store\n                else None\n            )\n            is_resumed = False\n            prompt = full_prompt\n            if force_cold:\n                # Media убраны из истории: «грязный» явный или кэшированный CID\n                # не возобновляем, ход идёт холодным text-only с полной историей.\n                conversation_id = \"\"\n            elif conversation_id:\n                if _cid_acquire(conversation_id, turn_id):\n                    owned_cid = conversation_id\n                else:\n                    # cid занят другим активным ходом: два хода не делят один разговор.\n                    _log(f\"cid-busy-fresh cid={conversation_id[:8]}\")\n                    conversation_id = \"\"\n            elif sess_key is not None:\n                use_cid = _session_claim(sess_key, turn_id)\n                if use_cid:\n                    conversation_id = use_cid\n                    is_resumed = True\n                    prompt = _get_resumed_turn_prompt(render_messages, images)\n            ctx: dict[str, object] = {\n                \"turn_id\": turn_id,\n                \"sess_key\": sess_key,\n                \"hot_resumed\": is_resumed,\n                \"full_prompt\": full_prompt,\n                                    code_u, _bu2 = bridge_u.post(body)\n                            self.assertEqual(code_u, 200)\n                            recs_u = env_u.records()\n                            self.assertEqual(len(recs_u), 1)\n                            prompt_u = _str(recs_u[0][\"prompt\"])\n                            self.assertNotIn(secret, prompt_u)\n                            self.assertNotIn(secret, \" \".join(_argv_of(recs_u[0])))\n                            self.assertIn(\"[media omitted]\", prompt_u)\n                            self.assertNotIn(\"--add-dir\", _argv_of(recs_u[0]))\n                            events_u = log_u.events()\n                            self.assertEqual(len(events_u), 1, events_u)\n                            self.assertIn(\"stage=collect\", events_u[0])\n                            self.assertIn(\"reason=unsupported_media\", events_u[0])\n                            self.assertNotIn(secret, log_u.text())\n                            env_u.assert_clean(self)\n            finally:\n                bridge_u.close()\n        secret2 = \"PAYLOAD_SECRET_99999\"\n        dict_text: list[tuple[str, object, str]] = [\n            (\n                \"F_dict_text_extra_data\",\n                {\"type\": \"text\", \"text\": \"hello\", \"data\": secret2},\n                \"hello\",\n            ),\n            (\n                \"G_dict_notype_text_extra\",\n                {\"text\": \"hello\", \"source\": {\"data\": secret2}},\n                \"hello\",\n            ),\n            (\n                \"H_dict_text_none_payload\",\n                {\"type\": \"text\", \"text\": None, \"payload\": secret2},\n                \"[media omitted]\",\n            ),\n            (\n                \"K_dict_input_text_extra\",\n                {\"type\": \"input_text\", \"text\": \"hello\", \"attachment\": secret2},\n                \"hello\",\n            ),\n            (\"I_dict_text_only\", {\"type\": \"text\", \"text\": \"hello\"}, \"hello\"),\n            (\n                \"J_dict_text_empty_payload\",\n                {\"type\": \"text\", \"text\": \"\", \"payload\": secret2},\n                \"[media omitted]\",\n            ),\n        ]\n        classify = _bfn(\"_classify_part\")\n        counts = _bfn(\"_media_part_counts\")\n        render = _bfn(\"_universal_render_messages\")\n        for name, content, want in dict_text:\n            with self.subTest(unit=name):\n                msgs_d: list[dict[str, object]] = [{\"role\": \"user\", \"content\": content}]\n                is_text = want == \"hello\" or name == \"I_dict_text_only\"\n                self.assertEqual(\n                    _str(classify(cast(\"dict[str, object]\", content))),\n                    \"text\" if is_text else \"unknown\",\n                )\n                self.assertEqual(counts(msgs_d), (0, 0 if is_text else 1))\n                self.assertEqual(_str(flatten(content)), want)\n                rendered = cast(\"list[dict[str, object]]\", render(msgs_d))\n                self.assertIsInstance(rendered[0][\"content\"], list)\n                self.assertNotIn(secret2, json.dumps(rendered))\n                stripped_p = _str(_bfn(\"_messages_to_stripped_prompt\")(msgs_d))\n                self.assertIn(want, stripped_p)\n                self.assertNotIn(secret2, stripped_p)\n                self.assertNotIn(\"{'\", stripped_p)\n        with _UniEnv() as env_d:\n            bridge_d = _HttpBridge()\n            store_d = cast(\"dict[object, object]\", _bval(\"_session_store\"))\n            try:\n                for name, content, want in dict_text:\n                    cold = want == \"[media omitted]\"\n                    for stream in (False, True):\n                        with self.subTest(case=name, stream=stream, path=\"cold\"):\n                            env_d.clear_records()\n                            body_d = _img_body(\n                                [{\"role\": \"user\", \"content\": content}],\n                                model=_UF_TEXT_ONLY,\n                                stream=stream,\n                            )\n                            with _UfLog() as log_d:\n                                if stream:\n                                    sse_d = _sse_post(bridge_d.port, body_d)\n                                    self.assertNotIn('\"error\"', sse_d)\n                                    self.assertTrue(sse_d.endswith(\"data: [DONE]\\n\\n\"))\n                                else:\n                                    self.assertEqual(bridge_d.post(body_d)[0], 200)\n                            recs_d = env_d.records()\n                            self.assertEqual(len(recs_d), 1)\n                            prompt_d = _str(recs_d[0][\"prompt\"])\n                            self.assertIn(want, prompt_d)\n                            self.assertNotIn(secret2, prompt_d)\n                            self.assertNotIn(secret2, \" \".join(_argv_of(recs_d[0])))\n                            self.assertNotIn(\"{'type'\", pr