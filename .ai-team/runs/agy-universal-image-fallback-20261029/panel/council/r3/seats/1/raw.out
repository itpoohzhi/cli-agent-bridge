ntegrity.md` §6 & §8, L3 execution fields remain deferred until Council `ACCEPT` and are mandatory before MR/completion).\nimport gc\nimport importlib\nimport sys\nimport time\nfrom pathlib import Path\n\n_SAVED = {\"zen\": {}, \"root\": {}}\n_CURRENT = None\n_MOD_NAMES = (\n    \"server\",\n    \"zen_catalog\",\n    \"_fake_cli\",\n    \"_fixtures\",\n    \"_http\",\n    \"rpc_testlib\",\n    \"bridge_testlib\",\n    \"tests\",\n    \"tests._fake_cli\",\n    \"tests._fixtures\",\n    \"tests._http\",\n    \"tests.bridge_testlib\",\n    \"tests.rpc_testlib\",\n)\n\n\ndef _activate(mode: str, repo_root: Path) -> None:\n    global _CURRENT\n    zen_dir = str(repo_root / \"bridges\" / \"opencode-zen-bridge\")\n    zen_tests = str(repo_root / \"bridges\" / \"opencode-zen-bridge\" / \"tests\")\n    root_dir = str(repo_root)\n    root_tests = str(repo_root / \"tests\")\n    if _CURRENT == mode:\n        return\n    if _CURRENT is not None:\n        for name in list(sys.modules):\n            if name in _MOD_NAMES or name.startswith(\"tests.\"):\n                _SAVED[_CURRENT][name] = sys.modules.pop(name)\n    else:\n        for name in list(sys.modules):\n            if name in _MOD_NAMES or name.startswith(\"tests.\"):\n                sys.modules.pop(name, None)\n    for p in (zen_dir, zen_tests, root_dir, root_tests):\n        while p in sys.path:\n            sys.path.remove(p)\n    if mode == \"zen\":\n        sys.path.insert(0, zen_tests)\n        sys.path.insert(0, zen_dir)\n        sys.path.insert(2, root_dir)\n    else:\n        sys.path.insert(0, root_tests)\n        sys.path.insert(0, root_dir)\n    for name, mod in _SAVED[mode].items():\n        sys.modules[name] = mod\n    if \"server\" not in sys.modules:\n        importlib.import_module(\"server\")\n    _CURRENT = mode\n    gc.collect()\n\n\ndef _mode_for_path(fspath) -> str:\n    s = str(fspath)\n    return \"zen\" if \"opencode-zen-bridge\" in s else \"root\"\n\n\ndef pytest_collectstart(collector):\n    p = getattr(collector, \"path\", None) or getattr(collector, \"fspath\", None)\n    if p is not None and str(p).endswith(\".py\"):\n        _activate(_mode_for_path(p), Path.cwd())\n\n\ndef pytest_collection_modifyitems(session, config, items):\n    items.sort(\n        key=lambda item: (\n            0\n            if \"test_agy_bridge_resilience.py\" in str(item.fspath)\n            else (1 if _mode_for_path(item.fspath) == \"root\" else 2)\n        )\n    )\n\n\ndef pytest_runtest_setup(item):\n    _activate(_mode_for_path(item.fspath), Path.cwd())\n    if \"test_tc93\" in item.name:\n        gc.collect()\n\n\ndef pytest_runtest_teardown(item):\n    s = str(item.fspath)\n    if \"test_rpc_\" in s:\n        time.sleep(0.15)\n        srv = sys.modules.get(\"server\")\n        if srv is not None and hasattr(srv, \"shutdown_all\"):\n            try:\n                srv.shutdown_all()\n            except Exception:\n                pass\n            time.sleep(0.05)\n# Verification Traceability Matrix (`agy-universal-image-fallback-20261029`)\n\n| Requirement / ADR / Invariant | Verification Check IDs | Test Oracles (`tests/test_agy_bridge_resilience.py`) | Clean-Room Status |\n|---|---|---|---|\n| `AD-001`, `REQ-01`, `INV-01`, `INV-09` (Independent fail-closed `IMAGE_FALLBACK_ENABLED` flag, universal catalog acceptance without `proof`/`sha256`, strict validation preserved) | `VER-003`, `VER-006`, `VER-007`, `VER-009` | `test_uf01_default_flag_off_keeps_strict_rejection_behavior`, `test_uf02_universal_accepts_all_catalog_models_and_efforts_without_proof`, `test_uf09_validation_limits_and_non_user_role_still_guarded` | `PASS` (`exit=0`) |\n| `AD-002`, `REQ-06`, `INV-02..04` (Complete media normalization & stripping across full history, including `A..E` unknown-only and `F..K` `dict`-content with `type=\"text\"` and extra payload keys) | `VER-003`, `VER-005`, `VER-007`, `VER-009` | `test_uf07_media_normalization_is_complete`, `test_uf07b_collect_downgrade_clears_hot_and_explicit_cid` | `PASS` (`exit=0`) |\n| `AD-003`, `REQ-02..03`, `INV-05..09, 11..12` (Three safe downgrade points: `collect`, `post_slot`/`spool`, and `runtime`; `img_dir` cleanup; CAS session invalidation; 1-attempt media reserve; SSE delivery lock) | `VER-003`, `VER-005`, `VER-007` | `test_uf03_collect_downgrade_when_image_input_disabled_sends_text_only`, `test_uf03b_post_slot_and_spool_downgrade_to_text_only`, `test_uf04_runtime_rejection_retries_once_without_images_json_and_sse`, `test_uf05_sse_no_fallback_after_first_delivered_token`, `test_uf06_hot_session_invalidated_and_not_poisoned_on_fallback`, `test_uf08_retry_budget_and_temp_dir_cleanup_under_concurrency`, `test_uf08b_runtime_fallback_runs_even_when_retry_budget_pre_exhausted` | `PASS` (`exit=0`) |\n| `AD-004`, `REQ-04`, `INV-10` (`/health` and `/v1/models` effective `images` + `image_fallback` metadata; sanitized `image_fallback` log event with `media-degradation-reserve` in `_LOG_EVENT_NAMES`) | `VER-003`, `VER-007`, `VER-009` | `test_uf10_health_models_and_structured_fallback_logs` | `PASS` (`exit=0`) |\n| `AD-005`, `INV-12` (Zero deletions in `tests/test_agy_bridge_resilience.py`, frozen `fleet.json`, `test_images_strict.py` green, full repository suite `VER-005` parity) | `VER-001`, `VER-002`, `VER-004`, `VER-005`, `VER-006`, `VER-008` | `UniversalImageFallbackTests` (`+1,615 / -0` lines after byte `249,933`), `VER-005` (`1,562` passed vs `1,550` on `BASE`, `2 == 2` identical pre-existing failures) | `PASS` / `PASS_WITH_PREEXISTING` |\n| `REQ-05` (Production deploy to `~/.dsh/bridges/agy-bridge/` + live DSH chat acceptance) | `VER-010` | `teamlead/live-acceptance.json` | `DEFERRED_L3` (mandatory post-Council before MR/close) |\nver-001.log\nver-002.log\nver-003.log\nver-004.log\nver-005-base-collect.log\nver-005-base.exit\nver-005-base.log\nver-005-candidate-collect.log\nver-005-candidate.exit\nver-005-candidate.log\nver-006.log\nver-007.log\nver-008.log\nver-009.log\n","exit_code":0,"status":"c