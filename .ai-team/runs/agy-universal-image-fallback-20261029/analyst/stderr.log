                    f"err={_err_summary(out.get('err'), 120)!r}, retry {attempt} {tag}"
                )
                time.sleep(_retry_pause_s(attempt))
            if (
                out.get("state") == "done"
                and out.get("conversation_id")
                and ctx.get("sess_key")
            ):
                _session_commit(ctx["sess_key"], str(out["conversation_id"]))
            if out.get("state") != "client_gone":
                _last_ok[0] = (
                    time.monotonic()
                    if (out.get("state") == "done" and out.get("rc") == 0)
                    else 0.0
                )
        finally:
            # Каталог изображений живёт весь ход (все попытки) и уходит до слота.
            if img_registered and img_dir is not None:
                _cleanup_img_dir(img_dir)
            _slots.release()
        self._log_done(
            cast(str, ctx["model"]),
            cast("dict[str, object]", out),
            t0,
            cast(str, ctx["tag"]),
        )
        return out

    @staticmethod
    def _usage_payload(usage: dict) -> dict:
        """usage agy -> OpenAI-поля. thinking_tokens прибавляем к completion."""
        return {
            "prompt_tokens": usage.get("input_tokens", 0),
            "completion_tokens": usage.get("output_tokens", 0)
            + usage.get("thinking_tokens", 0),
        return "method_not_implemented"
    proof_raw = images.get("proof")
    if not isinstance(proof_raw, dict):
        return "proof_missing"
    proof = cast("dict[str, object]", proof_raw)
    if proof.get("impl_version") != IMPLEMENTED_METHODS[method]:
        return "impl_version_mismatch"
    formats_raw = proof.get("formats")
    types_raw = IMAGE_LIMITS.get("types")
    types = cast("list[object]", types_raw) if isinstance(types_raw, list) else []
    if not isinstance(formats_raw, list) or not formats_raw:
        return "formats_mismatch"
    if not {str(t).lower() for t in types} <= {
        str(f).lower() for f in cast("list[object]", formats_raw)
    }:
        return "formats_mismatch"
    efforts_raw = proof.get("efforts_proven")
    if not isinstance(efforts_raw, list):
        return "efforts_missing"
    if effort is not None and effort not in cast("list[object]", efforts_raw):
        return "effort_not_proven"
    expected = proof.get("agy_binary_sha256")
    if not isinstance(expected, str) or len(expected) != 64:
        return "binary_sha_missing"
    actual = _file_sha256(AGY_BIN)
    if not actual or actual != expected.lower():
        return "binary_sha_mismatch"
    return None


def _model_supports_images(model_id: str) -> bool:
    return _is_image_input_enabled() and _image_proof_reason(model_id) is None


def _image_gate(model_id: str, effort: str | None) -> ImageReject | None:
    """Флаг и proof для image-запроса: None — можно, иначе отказ (без I/O с телом)."""
    if not _is_image_input_enabled():
        return ImageReject("image_input_disabled")
    reason = _image_proof_reason(model_id, effort)
    if reason is None:
        return None
    if reason in _STATUS_REASONS:
        return ImageReject(reason)
    if reason == "effort_not_proven":
        return ImageReject(reason, "unsupported_reasoning_effort")
    _log("image_proof_invalid model=%s reason=%s" % (_safe_log_value(model_id), reason))
    return ImageReject("image_proof_invalid")


def _collect_image_parts(
    messages: object,
) -> list[tuple[int, int, dict[str, object]]]:
    """Все image_url-части истории: (индекс сообщения с 0, сквозной номер с 1, часть)."""
    found: list[tuple[int, int, dict[str, object]]] = []
    if not isinstance(messages, list):
        return found
    number = 0
    for msg_index, msg in enumerate(cast("list[object]", messages)):
        if not isinstance(msg, dict):
            continue
        content = cast("dict[str, object]", msg).get("content")
        if not isinstance(content, list):
            continue
        for item in cast("list[object]", content):
            if isinstance(item, dict):
                part = cast("dict[str, object]", item)
                if part.get("type") == "image_url":
                    number += 1
                    found.append((msg_index, number, part))
    return found


def _sniff_image_type(raw: bytes) -> str | None:
    """MIME по сигнатуре (не декодирование пикселей); None — формат неизвестен."""
    if raw.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if raw.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    if raw.startswith((b"GIF87a", b"GIF89a")):
        return "image/gif"
    if raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
        return "image/webp"
    return None


def _limit(name: str, default: int) -> int:
    value = IMAGE_LIMITS.get(name, default)
    return value if isinstance(value, int) and not isinstance(value, bool) else default


def _new_img_dir() -> Path:
        _ = self.fx.__enter__()
        fx = self.fx
        _ = self.fake.write_text(
            "#!" + sys.executable + "\n" + _FAKE_IMG_SOURCE, encoding="utf-8"
        )
        self.fake.chmod(0o755)
        self.marks.mkdir()
        self.recs.mkdir()
        fx.patch("LAUNCHER", str(self.fake))
        fx.patch("_slots", threading.BoundedSemaphore(4))
        fx.patch("_rng", _zero)
        fx.set_env("FAKE_IMG_SCEN", str(self.scen))
        fx.set_env("AGY_IMAGE_INPUT_ENABLED", None)
        sha = hashlib.sha256(fx.agy_bin.read_bytes()).hexdigest()
        for model_id in _IMG_TARGETS:
            proof = _proof_of(model_id)
            original = proof["agy_binary_sha256"]
            proof["agy_binary_sha256"] = sha
            _ = fx.stack.callback(_restore_key, proof, "agy_binary_sha256", original)
        self.write_scen([{}])
        self.flag(True)
        return self

    def __exit__(self, *_exc: object) -> None:
        self.fx.__exit__()

    def write_scen(self, spawns: list[dict[str, object]]) -> None:
        body = {"marks": str(self.marks), "recs": str(self.recs), "spawns": spawns}
        _ = self.scen.write_text(json.dumps(body), encoding="utf-8")

    def flag(self, value: bool | None) -> None:
        """IMAGE_INPUT_ENABLED в dynamic_config.json (None — файла нет) + сброс кэша."""
        if value is None:
            self.fx.config.unlink(missing_ok=True)
        else:
            _ = self.fx.config.write_text(
                json.dumps({"IMAGE_INPUT_ENABLED": value}), encoding="utf-8"
            )
        setattr(_bridge(), "_image_flag_cache", (0.0, False))

    def records(self) -> list[dict[str, object]]:
        rows = [
            _dict(cast(object, json.loads(p.read_text(encoding="utf-8"))))
            for p in self.recs.glob("*.json")
        ]
        return sorted(rows, key=lambda r: _int(r["idx"]))

    def img_dirs(self) -> list[Path]:
        ws = Path(_str(str(_bval("WORKSPACE"))))
        return sorted(ws.glob("img-*")) if ws.exists() else []

    def free_slots(self) -> int:
        slots = cast(threading.BoundedSemaphore, _bval("_slots"))
        taken = 0
        while slots.acquire(blocking=False):
            taken += 1
        for _i in range(taken):
            _ = slots.release()
        return taken

    def active_dirs(self) -> set[str]:
        return set(cast("set[str]", _bval("_active_img_dirs")))


def _file_map(rec: dict[str, object]) -> dict[str, dict[str, object]]:
    files = _dict(rec.get("files") or {})
---
name: knowledge-persistence
description: >-
  Куда сохранять, чтобы не повторять одно и то же, и как компилировать новый источник в Karpathy-style wiki.
  Роутер персистенции: знания/контекст/вижен/решения → вики-база
  (knowledge-base/{область}); процедуры/плейбуки/правила → skills-proposals/open/
  (живой скилл — только по фразе «поправь скилл X»); факты о пользователе →
  canonical memory (скилл `memory`); снапшот задачи → session-guard handoff.
  Source ingest: неизменяемый артефакт из raw/inbox или явного пути → затронутые страницы →
  обновление канона → противоречия/пробелы → append-only ingest record → read-back и lint.
  Канон непрерывности агентов: knowledge-base/start-here/agent-continuity.md.
  Триггеры: «сохрани знания», «запиши в базу», «предложи в базу», «устойчивый вывод», «чтобы не повторять»,
  «сделай вики», «сохрани контекст сессии», «куда это записать»,
  «сохрани чтобы продолжить в другой сессии», «обработай/ингестируй новый источник»,
  «скомпилируй артефакт в вики», новый файл в raw/inbox, «knowledge base», «база знаний».
---

# Персистенция знаний и процедур — куда что писать

## Зачем
Чтобы пользователь **не повторял одно и то же 1000 раз**. Всё, что узнали/решили/договорились и что переживёт сессию, попадает в правильное долговременное место и **поднимается в следующей сессии** — агент открывает и продолжает без потерь.

## 🚦 Роутер: 4 адреса (главное правило)

| Что это | Куда | Формат |
|---|---|---|
| **Знания / контекст / вижен / решения / «как устроено» / факты о проекте** | **вики-база** `~/Мой диск/Работа/Sber/knowledge-base/<область>/` | markdown, разделами, перелинковано; дуально — и вики, и контекст для новой сессии |
| **Многоразовые ПРОЦЕДУРЫ / плейбуки / правила «как делать X» / промпты** | **очередь** `~/Мой диск/Работа/Sber/knowledge-base/skills-proposals/open/` (живой `~/Мой диск/skils/` — только по «поправь скилл X») | файл по `TEMPLATE.md`; сначала grep `open/` |
| **Короткие факты о пользователе / фидбек / предпочтения** | **canonical memory** — `~/Мой диск/skils/memory/SKILL.md` (заявка → designated writer → receipt); auto-memory — необязательный pointer cache | 1 факт = 1 файл, frontmatter type |
| **Снимок/дельта ОДНОЙ сессии** | **session-guard** → `current-sessions/<slug>/YYYY-MM-DDTHHMM.md` (append каждые ~15 мин) | Не overwrite; resume = все timestamp-файлы каталога по порядку |


**Разница, чтобы не путать:**
- **вики** = долговременное знание «ЧТО / ПОЧЕМУ / как устроено» (живёт долго, растёт, перелинковано);
- **скил** = исполнимая процедура «КАК делать» (агент читает и выполняет). Живой `~/Мой диск/skils/` по инициативе не править;
- **proposal скилла** = очередь `~/Мой диск/Работа/Sber/knowledge-base/skills-proposals/open/` по `TEMPLATE.md` (grep `open/` сначала);
- **memory** = короткий факт о пользователе/фидбек;
- **handoff** = снимок прогресса **этой** сессии (эфемерный; чужие папки не трогать).

Одно и то же **не дублировать**: durable-знание → вики (не только в handoff), новую/изменённую процедуру → proposal (вики ссылается на уже существующий скилл).

## После устойчивого вывода — не заканчивать молча

Чеклист (порядок обязателен):

1. **Устойчивость.** Есть устойчивый вывод (причина бага, развилка, рабочая процедура, ограничение) — не молчать.
2. **Роутер.** Знание/контекст/решение → wiki. Новая или изменённая процедура/правило/скилл → очередь `~/Мой диск/Работа/Sber/knowledge-base/skills-proposals/open/` по `TEMPLATE.md`; сначала grep `open/`. Живой `~/Мой диск/skils/` не писать, пока владелец не сказал «поправь скилл X» / «напиши скилл».
3. **Записать сразу без вопросов.** В KB (`knowledge-base/<область>/`) и в очередь `skills-proposals/open/` агент пишет **сразу по факту устойчивого вывода, без вопросов «Записать?» и без ожидания подтверждения владельца**. Спрашивать разрешение перед записью в KB запрещено. Живой `~/Мой диск/skils/` без прямой фразы владельца («поправь скилл X») не трогать.
4. **Блок-отчёт в чат** (после выполненной записи):

```
ЗАПИСАНО В KB:
Куда: KB <путь> | proposal скилла <путь>
Что: <1–3 предложения>
Доказательство: <путь+символ / команда / URL+дата>
Не пишу в живой скилл.
```

## Два режима — не смешивать

1. **Filing back после работы** — агент уже получил устойчивый вывод, выставляет блок в чат
   и точечно обновляет каноническую страницу wiki (живой скилл — нет). Источник — живая проверка, код, команда, исследование или решение текущей задачи.
2. **Source ingest** — появился новый артефакт. Агент регистрирует неизменяемый источник и
   перекомпилирует все затронутые страницы, а не создаёт рядом ещё один конспект.

Скилл задаёт **операцию компиляции**. Режим по умолчанию — декларативный pull: общий `AGENTS.md`
заставляет следующего активного агента проверить `raw/inbox/` и вызвать этот скилл. Это не требует
кода, но не работает в полном простое. Опциональный watcher нужен только для немедленного запуска;
wiki в обоих режимах изменяет агент по процедуре ниже.

## Dual-write с session-guard (знания реже)

Лимиты кончаются внезапно. **Работу** чекпоинтить часто; **знания** — реже:

1. **Session** (часто) — `current-sessions/<slug>/` через `session-guard` (дельты в каталоге сессии).
2. **Wiki** (этот скилл) — **раз в ~30 минут** с прошлого filing-back (`kb_last_at` в meta), или по явной просьбе «запиши в базу» / «сохрани знания».
3. Между 30-мин тиками — не гадать «durable или нет» (модели ошибаются): в handoff §5 → `KB: deferred`.
4. На тике 30 мин: обнови/создай страницу в разделе + README раздела (корневой INDEX не трогать, если тема не верхнего уровня); WIP/гипотезы всё равно не в wiki.
5. Перед сменой агента: опционально дописать, если есть что сказать; иначе `KB: без изменений`.

Канон: `knowledge-base/start-here/agent-continuity.md`. Точка входа: `knowledge-base/INDEX.md`.

## 📂 Структура вики-базы (соглашения)
- Каталог области — **говорящее имя** (кебаб/русское): `workshops/`, `infra/`, `vpn/`.
- В каждой области — точка входа **`00-НАЧАТЬ-ЗДЕСЬ.md`** (или `README.md`): что это, как пользоваться, карта раздела со ссылками.
- Файлы перелинкованы: `[текст](другой-файл.md)`; при расхождении — **обновляй файл, а не плоди дубли** (правило одного места).
- Каждый файл самодостаточен для холодного старта (агент без доступа к диалогу понимает контекст).

## Корневой INDEX — роутер, не журнал

- Держи `knowledge-base/INDEX.md` короткой картой: одна компактная строка на раздел или
  каноническую страницу, с понятным названием, ссылкой и поисковыми словами.
- Не добавляй в корень длинные датированные абзацы `> Дополнено`. Durable-факты
  записывай в профильную страницу, прогресс — в `current-sessions/<slug>/`, а отдельный
  поисковый указатель при необходимости — в небольшой
  `current-sessions/INDEX.d/YYYY-MM-DD-<slug>.md`.
- Делай файл `INDEX.d` самодостаточным: `topic`, `status`, `updated`, ссылка на
  каноническую страницу/сессию и синонимы для `rg`. Корневой INDEX должен вести в
  раздел, а поиск по `INDEX.d` — находить подробный след.
- После каждого изменения измеряй размер `knowledge-base/INDEX.md` через
  `python3 scripts/kb-index-budget.py`: рабочий диапазон ≤115 KiB, warning >120 KiB,
  жёсткий предел ≤128 KiB (131 072 байта). При приближении к 120 KiB эвакуируй устаревшие записи
  в `current-sessions/INDEX.d/`. За правила навигации и лимиты канонически отвечает `KB-GUIDE.md`.
- Если тема не видна в корневом роутере, ищи так:
  `rg -n -i -F -m 20 -- 'термин' KEYWORDS.md INDEX.md <профильный-раздел>/`,
  затем открывай найденную каноническую страницу. Большой архив не читай целиком.

### Пример структуры для воркшопов (эталон)
```
knowledge-base/workshops/                      # МЕТА — как вообще строим воркшопы
  00-НАЧАТЬ-ЗДЕСЬ.md
  videnie-i-trebovaniya.md                     # вижен/требования (процессы первичны, код руками не пишем, ...)
  process-sborki-vorkshopa.md                  # конвейер сборки
  ekspertnye-paneli-dvizhok.md                 # панели = центральный движок
  moduli-harness-struktura.md                  # модули, двухслойность, анатомия harness
  skily-stroiteli-katalog.md                   # каталог скилов + пути в ~/skils
  aiweekend/                                    # КОНКРЕТНЫЙ воркшоп
    README.md · programma-4-dnya.md · skvoznoy-keys-*.md · dvizhok-*.md · artefakty-puti-*.md · status-resheniya-*.md
```
Общий принцип: **`<область>/` = мета (как делаем это вообще), `<область>/<экземпляр>/` = данные конкретного экземпляра.**

**Метод (по Карпати):** wiki — **территория агента**: агент компилирует и поддерживает её из
источников/работы, человек в основном читает (руками правим редко). Модель — компилятор: raw-источники =
исходники, wiki = бинарь. Выводы после работы — **filing back** в нужные страницы, чтобы каждое
исследование складывалось. Слой неизменяемых `raw/`-источников заводим по необходимости. Полный формат,
слои и правила — [wiki-principles.md](~/Мой%20диск/Работа/Sber/knowledge-base/start-here/wiki-principles.md).
Поддержание в чистоте (противоречия/битые ссылки/пробелы) — регулярный линт-проход, скилл
`~/Мой диск/skils/kb-lint/SKILL.md`.

## Source ingest — операция компилятора

Канонический drop-каталог этой базы: `knowledge-base/raw/inbox/`. Допускай иной явный путь или URL,
но долговечный источник по возможности сохраняй в `raw/`; после появления там агент его **не меняет**.
Не помещай в raw секреты и временные логи, которые нельзя безопасно хранить.

Независимые чтения (INDEX, README, `rg`, страницы) и проверки (kb-dup-triage, kb-index-budget, ссылки, kb-lint) — одним сообщением, списком заранее (`~/Мой диск/skils/panel-backends/references/parallelism-params.md` §1).

1. **Зафиксируй источник.** Дождись атомарной готовности файла (`*.part` не обрабатывать), вычисли
   SHA-256 и проверь по `current-sessions/INDEX.d/`, не был ли этот hash уже успешно обработан.
   Повторный hash = no-op с отчётом, а не повторная запись в wiki.
2. **Прочитай и разметь.** Извлеки сущности, факты, решения, даты, provenance и ПРОБЕЛЫ. Для PDF,
   таблиц и других форматов используй профильный скилл, не изменяя оригинал.
3. **Найди затронутый канон.** Прочитай `INDEX.md`, локальный README и найди через `rg` все страницы,
   где уже живут эти сущности/утверждения. До записи составь список `KEEP / UPDATE / CREATE`.
4. **Сверь противоречия.** Для каждого несовпадения запиши: старое утверждение + его источник,
   новое утверждение + источник, вердикт `superseded / unresolved / scoped`. Не перетирай молча:
   подтверждённо устаревшее исправь, неразрешённое явно оставь как противоречие или ПРОБЕЛ.
5. **Скомпилируй wiki.** Обнови существующие страницы и summaries; новую страницу создавай только
   когда нет канонического места. Добавь provenance, дату проверки и связи, убери уже опровергнутое,
   не копируй источник целиком и не превращай wiki в журнал сессии.
6. **Обнови навигацию.** Поправь локальный README/оглавление; корневой `INDEX.md` — только если
   появился новый маршрут верхнего уровня. Не добавляй туда хронологический отчёт об ingest.
7. **Залогируй append-only.** Создай новый файл
   `current-sessions/INDEX.d/YYYY-MM-DD-wiki-ingest-<slug>-<hash8>.md`; старые ingest-записи не
   переписывай. Обязательные поля: `source`, `sha256`, `status`, `updated_pages`, `created_pages`,
   `contradictions`, `gaps`, `verified_at`. При неуспехе status не должен быть `complete`.
8. **Проверь результат.** Повторно вычисли hash источника; прочитай изменённые страницы как новый
   агент; проверь локальные ссылки, отсутствие параллельного источника правды, отсутствие
   конфликтов Google Drive (`cd ~/Мой\ диск/Работа/Sber/knowledge-base && python3 scripts/kb-dup-triage.py --check`) и размер корневого
   INDEX (проверки независимы — одним сообщением). Для крупного ingest после точечной проверки запусти `kb-lint` по затронутому разделу.

### Декларативный триггер и опциональная автоматика

- По умолчанию не пиши watcher: на каждом рабочем запросе общий `AGENTS.md` делает дешёвую проверку
  `raw/inbox/`; пустой каталог и уже успешно обработанные hash = no-op без отчёта.
- Если нужна обработка во время полного простоя, watcher **не пишет wiki**: он только передаёт
  агенту путь готового файла и запускает `knowledge-persistence` в режиме source ingest.
- Producer кладёт `name.part`, завершает запись и атомарно переименовывает в финальное имя;
  частичный файл не является событием ingest.
- Дедупликация — по SHA-256 и успешной ingest-записи, не по имени или mtime.
- Одновременно разрешай одного writer на затронутый раздел; второй запуск ждёт либо завершается
  без записи. Снятие зависшего lock требует проверки, что writer действительно умер.
- Автоматический ingest без пользовательского диалога может менять только локальную wiki;
  публикация в Jira/Confluence/Drive и другие внешние записи требуют отдельной авторизации.

## ⏱️ Когда срабатывать (знания)
- **Раз в ~30 минут** активной работы (ориентир по `kb_last_at`), не на каждом session-чекпоинте.
- Пользователь сказал «сохрани знания / запиши в базу / предложи в базу / чтобы не повторять / сделай вики».
- Сразу как получен **устойчивый вывод** — чеклист выше, не заканчивать молча.
- Опционально перед сменой агента, если с прошлого тика есть что записать.
- Сессионный handoff (~60–70% / после шага) — это `session-guard`, не повод каждый раз трогать wiki.

## ✍️ Процедура
Эта короткая процедура — для **filing back**. Для нового артефакта выполняй полный Source ingest выше.

1. **Классифицируй** каждый кусок по роутеру выше (знание / proposal процедуры / факт / снапшот), сразу запиши в целевой файл KB (без вопроса «Записать?») и выведи в чат отчётный блок «ЗАПИСАНО В KB:».
2. **Проверь существующее** (`grep`/просмотр каталога) — есть файл по теме? Обнови его, не создавай дубль. Для процедуры — сначала grep `skills-proposals/open/`.
3. **Запиши** в целевой адрес говорящими именами; вики — разделами и с перелинковкой. Процедуру/правило — файл в `skills-proposals/open/` по `TEMPLATE.md`, не в живой `~/Мой диск/skils/`.
4. **Свяжи**: вики ссылается на уже существующие скилы (`~/Мой диск/skils/<name>`); proposal ссылается на целевой скилл; handoff — на оба.
5. **Точка входа** актуальна: обнови `00-НАЧАТЬ-ЗДЕСЬ.md` или `README.md` целевого раздела. В корневой `INDEX.md` запись вносится **исключительно при появлении новой темы верхнего уровня** (нового раздела базы); внутритемные и сессионные обновления идут в `README.md` раздела и `current-sessions/INDEX.d/`.
6. **Бюджет** корневого `INDEX.md` держится: рабочий диапазон ≤115 KiB, warning >120 KiB, жёсткий предел ≤128 KiB (131 072 байта); превышение не допускается. Проверить можно, например: `python3 scripts/kb-index-budget.py`.
7. **Защита от потери правок со второго Mac:** к завершению работы в KB не остаётся дубликатов, конфликтов и сирот. Проверить можно, например: `cd ~/Мой\ диск/Работа/Sber/knowledge-base && python3 scripts/kb-dup-triage.py --check` (код выхода `1` — есть находки). Находки триажатся: правки переносятся в канон, конфликтная копия удаляется; идентичные дубликаты удаляются сразу (пример команды: `cd ~/Мой\ диск/Работа/Sber/knowledge-base && python3 scripts/kb-dup-triage.py --dump <дубль>`).

## Связанные
- `wiki-principles.md` (в knowledge-base/start-here) — формат вики и метод Карпати (слои, компилятор, filing back).
- `kb-lint` — health-check уже записанного (противоречия, битые ссылки, пробелы). Персистенция кладёт — kb-lint поддерживает.
- `session-guard` — multi-session vault + dual-write; эфемерный прогресс, не заменяет вики.
- `start-here/agent-continuity.md` — канон: hard-stop лимитов, поиск «про X», INDEX.d.
- `memory` — короткие факты о пользователе (canonical workflow: `~/Мой диск/skils/memory/SKILL.md`); auto-memory — необязательный pointer cache.
- `web-search` — актуализация перед записью фактов, которые могли устареть.

