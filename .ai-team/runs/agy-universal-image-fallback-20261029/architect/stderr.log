#!/usr/bin/env python3
"""Fail-closed ARCH_GATE между Architect и Coder для S2/S3."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


ARCHITECT_SCRIPTS = (
    Path(__file__).resolve().parents[2] / "architect-software-product" / "scripts"
)
sys.path.insert(0, str(ARCHITECT_SCRIPTS))

from validate_architecture_packet import (  # noqa: E402
    PacketError,
    require_object,
    validate_packet,
)
from worktree_fingerprint import compare  # noqa: E402


class ArchGateError(ValueError):
    """Architecture gate не доказан."""


def load_object(path: Path, label: str) -> tuple[dict[str, Any], bytes]:
    try:
        raw = path.read_bytes()
        value = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ArchGateError(f"{label}: cannot read JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise ArchGateError(f"{label}: expected object")
    return value, raw


def canonical_hash(value: Any) -> str:
    raw = json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(raw).hexdigest()


def packet_freeze(packet_path: Path) -> dict[str, str]:
    packet, raw = load_object(packet_path, "architecture packet")
    return {
        "packet_sha256": hashlib.sha256(raw).hexdigest(),
        "verification_surface_sha256": canonical_hash(
            packet.get("verification_surface")
        ),
        "protected_paths_sha256": canonical_hash(packet.get("protected_paths")),
    }


def validate_fingerprints(before_path: Path, after_path: Path) -> str:
    before, _ = load_object(before_path, "architect fingerprint before")
    after, _ = load_object(after_path, "architect fingerprint after")
    if before.get("root") != after.get("root"):
        raise ArchGateError("architect fingerprints use different roots")
    if before.get("exclude") != after.get("exclude"):
        raise ArchGateError("architect fingerprints use different exclusions")
    changes = compare(before, after)
    if changes:
        preview = "; ".join(changes[:5])
        raise ArchGateError(f"Architect changed product worktree: {preview}")
    digest = before.get("sha256")
    if not isinstance(digest, str) or len(digest) != 64:
        raise ArchGateError("architect fingerprint has invalid sha256")
    return digest


def validate_materialized_targets(packet: dict[str, Any], repo_root: Path) -> int:
    root = repo_root.resolve()
    items = packet.get("materialization")
    if not isinstance(items, list):
        raise ArchGateError("materialization: expected array")
    for index, raw_item in enumerate(items):
        if not isinstance(raw_item, dict):
            raise ArchGateError(f"materialization[{index}]: expected object")
        target_raw = raw_item.get("target")
        expected = raw_item.get("sha256")
        if not isinstance(target_raw, str) or not target_raw:
            raise ArchGateError(f"materialization[{index}].target: invalid")
        target = (root / target_raw).resolve()
        try:
            target.relative_to(root)
        except ValueError as exc:
            raise ArchGateError(
                f"materialization[{index}].target escapes repository"
            ) from exc
        if not target.is_file():
            raise ArchGateError(f"materialization[{index}].target is not materialized")
        actual = hashlib.sha256(target.read_bytes()).hexdigest()
        if actual != expected:
            raise ArchGateError(f"materialization[{index}].target sha256 mismatch")
    return len(items)


def validate_task_freeze(
    task_path: Path,
    packet_hash: str,
    verification_hash: str,
    protected_paths_hash: str,
) -> None:
    task, _ = load_object(task_path, "task envelope")
    freeze = task.get("architecture_gate")
    if not isinstance(freeze, dict):
        raise ArchGateError("task envelope misses architecture_gate freeze")
    expected = {
        "packet_sha256": packet_hash,
        "verification_surface_sha256": verification_hash,
        "protected_paths_sha256": protected_paths_hash,
    }
    for key, value in expected.items():
        if freeze.get(key) != value:
            raise ArchGateError(f"task envelope architecture_gate.{key} mismatch")


def validate_arch_gate(
    *,
    packet_path: Path,
    run_dir: Path,
    role_plan_path: Path,
    repo_root: Path,
    fingerprint_before: Path,
    fingerprint_after: Path,
    task_path: Path,
) -> dict[str, Any]:
    packet, raw = load_object(packet_path, "architecture packet")
    try:
        validate_packet(
            require_object(packet, "architecture packet"),
            "approved",
            run_dir=run_dir.resolve(),
            role_plan_path=role_plan_path,
        )
    except PacketError as exc:
        raise ArchGateError(f"architecture packet: {exc}") from exc

    fingerprint_hash = validate_fingerprints(fingerprint_before, fingerprint_after)
    materialized = validate_materialized_targets(packet, repo_root)
    packet_hash = hashlib.sha256(raw).hexdigest()
    verification_hash = canonical_hash(packet.get("verification_surface"))
    protected_paths_hash = canonical_hash(packet.get("protected_paths"))
    validate_task_freeze(
        task_path,
        packet_hash,
        verification_hash,
        protected_paths_hash,
    )

    return {
        "schema_version": "1.0",
        "gate": "ARCH_GATE",
        "status": "PASS",
        "run_id": packet.get("run_id"),
        "criticality": packet.get("criticality"),
        "packet_sha256": packet_hash,
        "verification_surface_sha256": verification_hash,
        "protected_paths_sha256": protected_paths_hash,
        "architect_worktree_sha256": fingerprint_hash,
        "materialized_targets": materialized,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--packet", type=Path, required=True)
    parser.add_argument("--print-freeze", action="store_true")
    parser.add_argument("--run-dir", type=Path)
    parser.add_argument("--role-plan", type=Path)
    parser.add_argument("--repo-root", type=Path)
    parser.add_argument("--fingerprint-before", type=Path)
    parser.add_argument("--fingerprint-after", type=Path)
    parser.add_argument("--task", type=Path)
    parser.add_argument("--receipt", type=Path)
    args = parser.parse_args()

    try:
        if args.print_freeze:
            print(
                json.dumps(
                    {"architecture_gate": packet_freeze(args.packet)},
                    ensure_ascii=False,
                    indent=2,
                )
            )
            return 0
        required = {
            "--run-dir": args.run_dir,
            "--role-plan": args.role_plan,
            "--repo-root": args.repo_root,
            "--fingerprint-before": args.fingerprint_before,
            "--fingerprint-after": args.fingerprint_after,
            "--task": args.task,
            "--receipt": args.receipt,
        }
        missing = [name for name, value in required.items() if value is None]
        if missing:
            raise ArchGateError(f"check mode misses arguments: {', '.join(missing)}")
        assert args.run_dir is not None
        assert args.role_plan is not None
        assert args.repo_root is not None
        assert args.fingerprint_before is not None
        assert args.fingerprint_after is not None
        assert args.task is not None
        assert args.receipt is not None
        receipt = validate_arch_gate(
            packet_path=args.packet,
            run_dir=args.run_dir,
            role_plan_path=args.role_plan,
            repo_root=args.repo_root,
            fingerprint_before=args.fingerprint_before,
            fingerprint_after=args.fingerprint_after,
            task_path=args.task,
        )
        args.receipt.parent.mkdir(parents=True, exist_ok=True)
        args.receipt.write_text(
            json.dumps(receipt, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
    except (ArchGateError, OSError) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    print(f"PASS: ARCH_GATE; receipt={args.receipt}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
#!/usr/bin/env python3
"""Проверка плана роли до и после её работы."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


ROLES = {"explorer", "architect", "coder", "reviewer", "verifier", "summarizer"}
STEP_KINDS = {"inspect", "decide", "change", "verify", "report"}
BEFORE_STATUSES = {"PENDING", "IN_PROGRESS"}
AFTER_STATUSES = {"DONE", "BLOCKED"}
GENERIC_ACTIONS = {
    "выполнить задачу",
    "изучить код",
    "написать код",
    "проанализировать задачу",
    "проверить результат",
    "запустить тесты",
    "сделать работу",
}
REQUIRED_KINDS = {
    "explorer": {"inspect", "report"},
    "architect": {"inspect", "decide", "report"},
    "coder": {"change", "verify"},
    "reviewer": {"inspect", "report"},
    "verifier": {"verify", "report"},
    "summarizer": {"inspect", "report"},
}


class RolePlanError(ValueError):
    """Ошибка контракта ROLE PLAN."""


def require_string(data: dict[str, Any], key: str, prefix: str = "") -> str:
    value = data.get(key)
    if not isinstance(value, str) or not value.strip():
        raise RolePlanError(f"{prefix}{key}: expected non-empty string")
    return value.strip()


def require_string_list(data: dict[str, Any], key: str) -> list[str]:
    value = data.get(key)
    if not isinstance(value, list) or not value:
        raise RolePlanError(f"{key}: expected non-empty array")
    if any(not isinstance(item, str) or not item.strip() for item in value):
        raise RolePlanError(f"{key}: every item must be a non-empty string")
    return value


def validate_step(step: dict[str, Any], index: int, role: str, phase: str) -> None:
    prefix = f"steps[{index}]."
    step_id = require_string(step, "id", prefix)
    if step_id != f"RP-{index + 1:02d}":
        raise RolePlanError(f"{prefix}id: expected RP-{index + 1:02d}")

    kind = require_string(step, "kind", prefix)
    if kind not in STEP_KINDS:
        raise RolePlanError(f"{prefix}kind: expected one of {sorted(STEP_KINDS)}")

    action = require_string(step, "action", prefix)
    normalized_action = " ".join(action.lower().rstrip(".").split())
    if len(action) < 18 or normalized_action in GENERIC_ACTIONS:
        raise RolePlanError(
            f"{prefix}action: too generic; name a target and observable result"
        )

    evidence = require_string(step, "expected_evidence", prefix)
    if len(evidence) < 8 or evidence.lower() in {"результат", "evidence", "лог"}:
        raise RolePlanError(f"{prefix}expected_evidence: too generic")

    if role == "verifier" and kind == "verify":
        require_string(step, "command", prefix)

    status = step.get("status")
    allowed_statuses = BEFORE_STATUSES if phase == "before" else AFTER_STATUSES
    if status not in allowed_statuses:
        raise RolePlanError(
            f"{prefix}status: expected one of {sorted(allowed_statuses)}"
        )

    actual_evidence = step.get("actual_evidence")
    if phase == "before" and actual_evidence not in (None, ""):
        raise RolePlanError(f"{prefix}actual_evidence: must be empty before execution")
    if phase == "after":
        if not isinstance(actual_evidence, str) or not actual_evidence.strip():
            raise RolePlanError(f"{prefix}actual_evidence: required for {status}")


def validate_role_plan(data: dict[str, Any], phase: str) -> None:
    if data.get("schema_version") != "1.0":
        raise RolePlanError("schema_version: expected '1.0'")
    require_string(data, "run_id")
    role = require_string(data, "role")
    if role not in ROLES:
        raise RolePlanError(f"role: expected one of {sorted(ROLES)}")
    iteration = data.get("iteration")
    if not isinstance(iteration, int) or isinstance(iteration, bool) or iteration < 1:
        raise RolePlanError("iteration: expected integer >= 1")
    require_string(data, "objective")
    require_string_list(data, "inputs_read")
    require_string_list(data, "stop_conditions")

    plan_kind = data.get("plan_kind")
    if plan_kind not in {"full", "delta"}:
        raise RolePlanError("plan_kind: expected full or delta")
    if plan_kind == "delta":
        require_string(data, "parent_plan")
        require_string_list(data, "trigger_ids")

    steps = data.get("steps")
    max_steps = 5 if plan_kind == "delta" else 7
    if not isinstance(steps, list) or not 2 <= len(steps) <= max_steps:
        raise RolePlanError(f"steps: expected 2..{max_steps} items")
    for index, step in enumerate(steps):
        if not isinstance(step, dict):
            raise RolePlanError(f"steps[{index}]: expected object")
        validate_step(step, index, role, phase)

    kinds = {str(step.get("kind")) for step in steps}
    missing_kinds = REQUIRED_KINDS[role] - kinds
    if missing_kinds:
        raise RolePlanError(f"steps: {role} plan misses kinds {sorted(missing_kinds)}")

    deviations = data.get("deviations")
    if not isinstance(deviations, list):
        raise RolePlanError("deviations: expected array")
    if phase == "before" and deviations:
        raise RolePlanError("deviations: must be empty before execution")
    if phase == "after" and any(
        not isinstance(item, str) or not item.strip() for item in deviations
    ):
        raise RolePlanError("deviations: every item must be a non-empty string")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plan", type=Path)
    parser.add_argument("--phase", required=True, choices=("before", "after"))
    args = parser.parse_args()

    try:
        raw = args.plan.read_bytes()
        data = json.loads(raw.decode("utf-8"))
        if not isinstance(data, dict):
            raise RolePlanError("plan root must be an object")
        validate_role_plan(data, args.phase)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RolePlanError) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    digest = hashlib.sha256(raw).hexdigest()
    print(f"PASS: {data['role']} role plan is valid for {args.phase}; sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

