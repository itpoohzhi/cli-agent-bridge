#!/usr/bin/env python3
"""Fail-closed проверка Architecture Packet до запуска Coder."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any


CRITICALITIES = {"S2", "S3"}
QUALITY_TYPES = {
    "compatibility",
    "cost",
    "maintainability",
    "operability",
    "performance",
    "privacy",
    "reliability",
    "safety",
    "security",
    "sustainability",
    "testability",
    "usability",
}
VIEW_TYPES = {"context", "container", "component", "dynamic", "deployment", "dfd"}
DECISION_STATUSES = {"PROPOSED", "APPROVED", "REJECTED", "INHERITED"}
CONFIRMATION_KINDS = {"test", "arch-test", "deps-gate", "ci-gate", "smoke", "manual"}
ASSUMPTION_STATUSES = {"OPEN", "VALIDATED", "REJECTED", "ASSUMED"}
THREAT_RISK_TRIGGERS = {
    "auth",
    "external-attack-surface",
    "pii",
    "security",
    "trust-boundary",
}
HEX_64 = re.compile(r"[0-9a-f]{64}")


class PacketError(ValueError):
    """Architecture Packet нарушает контракт."""


def require_object(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PacketError(f"{label}: expected object")
    return value


def require_list(value: Any, label: str, *, nonempty: bool = False) -> list[Any]:
    if not isinstance(value, list):
        raise PacketError(f"{label}: expected array")
    if nonempty and not value:
        raise PacketError(f"{label}: must not be empty")
    return value


def require_string(data: dict[str, Any], key: str, prefix: str = "") -> str:
    value = data.get(key)
    if not isinstance(value, str) or not value.strip():
        raise PacketError(f"{prefix}{key}: expected non-empty string")
    return value.strip()


def string_list(
    data: dict[str, Any], key: str, *, nonempty: bool = False, prefix: str = ""
) -> list[str]:
    values = require_list(data.get(key), f"{prefix}{key}", nonempty=nonempty)
    result: list[str] = []
    for index, value in enumerate(values):
        if not isinstance(value, str) or not value.strip():
            raise PacketError(f"{prefix}{key}[{index}]: expected non-empty string")
        result.append(value.strip())
    if len(result) != len(set(result)):
        raise PacketError(f"{prefix}{key}: duplicate values")
    return result


def require_bool(data: dict[str, Any], key: str, prefix: str = "") -> bool:
    value = data.get(key)
    if not isinstance(value, bool):
        raise PacketError(f"{prefix}{key}: expected boolean")
    return value


def require_enum(
    data: dict[str, Any], key: str, allowed: set[str], prefix: str = ""
) -> str:
    value = require_string(data, key, prefix)
    if value not in allowed:
        raise PacketError(f"{prefix}{key}: expected one of {sorted(allowed)}")
    return value


def safe_relative_path(raw: str, label: str) -> Path:
    path = Path(raw)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        raise PacketError(f"{label}: path must stay inside its base")
    return path


def validate_ids(items: list[Any], label: str, prefix: str) -> list[dict[str, Any]]:
    objects: list[dict[str, Any]] = []
    seen: set[str] = set()
    pattern = re.compile(rf"{re.escape(prefix)}-[0-9]{{3}}")
    for index, raw in enumerate(items):
        item = require_object(raw, f"{label}[{index}]")
        item_id = require_string(item, "id", f"{label}[{index}].")
        if pattern.fullmatch(item_id) is None:
            raise PacketError(f"{label}[{index}].id: expected {prefix}-NNN")
        if item_id in seen:
            raise PacketError(f"{label}: duplicate id {item_id}")
        seen.add(item_id)
        objects.append(item)
    return objects


def validate_ref_ids(values: list[str], known: set[str], label: str) -> None:
    unknown = sorted(set(values) - known)
    if unknown:
        raise PacketError(f"{label}: unknown ids {unknown}")


def validate_role_plan_ref(
    packet: dict[str, Any], phase: str, role_plan_path: Path | None
) -> None:
    raw_ref = packet.get("role_plan")
    if phase == "draft" and raw_ref is None:
        return
    ref = require_object(raw_ref, "role_plan")
    referenced_path = safe_relative_path(require_string(ref, "path"), "role_plan.path")
    digest = require_string(ref, "sha256")
    if HEX_64.fullmatch(digest) is None:
        raise PacketError("role_plan.sha256: expected 64 lowercase hex characters")
    if phase == "approved" and role_plan_path is None:
        raise PacketError("approved phase requires --role-plan")
    if role_plan_path is None:
        return

    try:
        raw = role_plan_path.read_bytes()
        plan = require_object(json.loads(raw.decode("utf-8")), "role plan")
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise PacketError(f"role_plan: cannot read completed plan: {exc}") from exc
    if referenced_path.name != role_plan_path.name:
        raise PacketError("role_plan.path does not match supplied plan")
    if hashlib.sha256(raw).hexdigest() != digest:
        raise PacketError("role_plan.sha256 does not match supplied plan")
    if plan.get("role") != "architect":
        raise PacketError("role_plan.role must be architect")
    steps = require_list(plan.get("steps"), "role_plan.steps", nonempty=True)
    for index, raw_step in enumerate(steps):
        step = require_object(raw_step, f"role_plan.steps[{index}]")
        if step.get("status") != "DONE":
            raise PacketError(
                f"role_plan.steps[{index}]: approved packet requires DONE"
            )
        require_string(step, "actual_evidence", f"role_plan.steps[{index}].")


def validate_evidence(data: dict[str, Any]) -> set[str]:
    items = validate_ids(
        require_list(data.get("evidence"), "evidence", nonempty=True), "evidence", "EVD"
    )
    for index, item in enumerate(items):
        require_enum(
            item, "kind", {"code", "command", "document", "url"}, f"evidence[{index}]."
        )
        require_string(item, "ref", f"evidence[{index}].")
        require_string(item, "claim", f"evidence[{index}].")
    return {str(item["id"]) for item in items}


def validate_verification(
    data: dict[str, Any],
) -> tuple[set[str], list[dict[str, Any]]]:
    items = validate_ids(
        require_list(
            data.get("verification_surface"), "verification_surface", nonempty=True
        ),
        "verification_surface",
        "VER",
    )
    command_count = 0
    for index, item in enumerate(items):
        prefix = f"verification_surface[{index}]."
        string_list(item, "requirement_ids", nonempty=True, prefix=prefix)
        kind = require_enum(item, "kind", {"command", "manual"}, prefix)
        command = item.get("command")
        if kind == "command":
            require_string(item, "command", prefix)
            command_count += 1
        elif command not in (None, ""):
            raise PacketError(f"{prefix}command: manual gate must not fake a command")
        require_string(item, "expected", prefix)
        require_string(item, "environment", prefix)
        owner = require_string(item, "owner", prefix)
        if owner.lower() == "coder":
            raise PacketError(f"{prefix}owner: Coder cannot own frozen verification")
    if command_count == 0:
        raise PacketError(
            "verification_surface: at least one exact command is required"
        )
    return {str(item["id"]) for item in items}, items


def validate_decisions(
    data: dict[str, Any], phase: str, evidence_ids: set[str]
) -> tuple[set[str], set[str]]:
    items = validate_ids(
        require_list(data.get("decisions"), "decisions", nonempty=True),
        "decisions",
        "AD",
    )
    approval_required: set[str] = set()
    for index, item in enumerate(items):
        prefix = f"decisions[{index}]."
        status = require_enum(item, "status", DECISION_STATUSES, prefix)
        kind = require_enum(item, "kind", {"one-way", "two-way", "inherited"}, prefix)
        require_string(item, "question", prefix)
        require_string(item, "choice", prefix)
        alternatives = string_list(item, "alternatives", prefix=prefix)
        if kind != "inherited" and len(alternatives) < 2:
            raise PacketError(f"{prefix}alternatives: two real options are required")
        string_list(item, "drivers", nonempty=True, prefix=prefix)
        string_list(item, "consequences", nonempty=True, prefix=prefix)
        needs_approval = require_bool(item, "approval_required", prefix)
        if kind == "one-way" and not needs_approval:
            raise PacketError(
                f"{prefix}approval_required: one-way decision needs approval"
            )
        if needs_approval:
            approval_required.add(str(item["id"]))
        if phase == "approved" and status in {"PROPOSED", "REJECTED"}:
            raise PacketError(
                f"{prefix}status: {status} decision blocks approved packet"
            )
        if kind == "inherited":
            inherited_ids = string_list(
                item, "evidence_ids", nonempty=True, prefix=prefix
            )
            validate_ref_ids(inherited_ids, evidence_ids, f"{prefix}evidence_ids")
        confirmation = require_object(item.get("confirmation"), f"{prefix}confirmation")
        confirmation_kind = require_enum(
            confirmation, "kind", CONFIRMATION_KINDS, f"{prefix}confirmation."
        )
        if confirmation_kind != "manual":
            require_string(confirmation, "command", f"{prefix}confirmation.")
        elif confirmation.get("command") not in (None, ""):
            raise PacketError(
                f"{prefix}confirmation.command: manual gate must be empty"
            )
        require_string(confirmation, "expected", f"{prefix}confirmation.")
    return {str(item["id"]) for item in items}, approval_required


def validate_quality(data: dict[str, Any], verification_ids: set[str]) -> set[str]:
    items = validate_ids(
        require_list(data.get("quality_scenarios"), "quality_scenarios", nonempty=True),
        "quality_scenarios",
        "QA",
    )
    for index, item in enumerate(items):
        prefix = f"quality_scenarios[{index}]."
        require_enum(item, "quality", QUALITY_TYPES, prefix)
        for key in (
            "source",
            "stimulus",
            "environment",
            "artifact",
            "response",
            "response_measure",
        ):
            require_string(item, key, prefix)
        refs = string_list(item, "verification_ids", nonempty=True, prefix=prefix)
        validate_ref_ids(refs, verification_ids, f"{prefix}verification_ids")
    return {str(item["id"]) for item in items}


def validate_boundaries(data: dict[str, Any], verification_ids: set[str]) -> set[str]:
    items = validate_ids(
        require_list(data.get("boundaries"), "boundaries", nonempty=True),
        "boundaries",
        "BND",
    )
    for index, item in enumerate(items):
        prefix = f"boundaries[{index}]."
        require_string(item, "component", prefix)
        require_string(item, "responsibility", prefix)
        string_list(item, "allowed_dependencies", prefix=prefix)
        string_list(item, "forbidden_dependencies", prefix=prefix)
        refs = string_list(item, "verification_ids", nonempty=True, prefix=prefix)
        validate_ref_ids(refs, verification_ids, f"{prefix}verification_ids")
    return {str(item["id"]) for item in items}


def validate_contracts(data: dict[str, Any], verification_ids: set[str]) -> set[str]:
    items = validate_ids(
        require_list(data.get("contract_deltas"), "contract_deltas"),
        "contract_deltas",
        "CD",
    )
    for index, item in enumerate(items):
        prefix = f"contract_deltas[{index}]."
        require_enum(
            item, "type", {"api", "behavior", "data", "dependency", "event"}, prefix
        )
        for key in ("producer", "consumer", "change", "compatibility"):
            require_string(item, key, prefix)
        refs = string_list(item, "verification_ids", nonempty=True, prefix=prefix)
        validate_ref_ids(refs, verification_ids, f"{prefix}verification_ids")
    return {str(item["id"]) for item in items}


def validate_views(data: dict[str, Any]) -> None:
    items = validate_ids(
        require_list(data.get("views"), "views", nonempty=True), "views", "VIEW"
    )
    for index, item in enumerate(items):
        prefix = f"views[{index}]."
        require_enum(item, "type", VIEW_TYPES, prefix)
        require_string(item, "question", prefix)
        require_string(item, "artifact_ref", prefix)


def validate_risks(data: dict[str, Any], verification_ids: set[str]) -> set[str]:
    items = validate_ids(
        require_list(data.get("risks"), "risks", nonempty=True), "risks", "RISK"
    )
    for index, item in enumerate(items):
        prefix = f"risks[{index}]."
        require_string(item, "scenario", prefix)
        require_enum(item, "probability", {"low", "medium", "high"}, prefix)
        require_enum(item, "impact", {"low", "medium", "high"}, prefix)
        require_string(item, "mitigation", prefix)
        refs = string_list(item, "verification_ids", nonempty=True, prefix=prefix)
        validate_ref_ids(refs, verification_ids, f"{prefix}verification_ids")
    return {str(item["id"]) for item in items}


def validate_threat_model(
    data: dict[str, Any],
    criticality: str,
    risk_triggers: set[str],
    verification_ids: set[str],
) -> set[str]:
    model = require_object(data.get("threat_model"), "threat_model")
    required = require_bool(model, "required", "threat_model.")
    if criticality == "S3" and not required:
        raise PacketError("threat_model.required must be true for S3")
    if criticality == "S2" and risk_triggers and not required:
        raise PacketError("threat_model.required must be true for risk-triggered S2")
    assets = string_list(model, "assets", prefix="threat_model.")
    boundaries = string_list(model, "trust_boundaries", prefix="threat_model.")
    items = validate_ids(
        require_list(model.get("threats"), "threat_model.threats"),
        "threat_model.threats",
        "THREAT",
    )
    if required and (not assets or not boundaries or not items):
        raise PacketError(
            "required threat model needs assets, trust boundaries and threats"
        )
    for index, item in enumerate(items):
        prefix = f"threat_model.threats[{index}]."
        require_string(item, "scenario", prefix)
        require_string(item, "mitigation", prefix)
        refs = string_list(item, "verification_ids", nonempty=True, prefix=prefix)
        validate_ref_ids(refs, verification_ids, f"{prefix}verification_ids")
    return {str(item["id"]) for item in items}


def validate_assumptions(
    data: dict[str, Any], phase: str, evidence_ids: set[str]
) -> None:
    items = validate_ids(
        require_list(data.get("assumptions"), "assumptions"),
        "assumptions",
        "ASM",
    )
    for index, item in enumerate(items):
        prefix = f"assumptions[{index}]."
        require_string(item, "statement", prefix)
        status = require_enum(item, "status", ASSUMPTION_STATUSES, prefix)
        refs = string_list(item, "evidence_ids", prefix=prefix)
        validate_ref_ids(refs, evidence_ids, f"{prefix}evidence_ids")
        if status in {"VALIDATED", "REJECTED"} and not refs:
            raise PacketError(
                f"{prefix}evidence_ids: resolved assumption needs evidence"
            )
        if phase == "approved" and status == "OPEN":
            raise PacketError(f"{prefix}status: OPEN assumption blocks approved packet")


def validate_evolution(data: dict[str, Any]) -> None:
    evolution = require_object(data.get("evolution"), "evolution")
    for key in ("compatibility", "migration", "rollout", "rollback"):
        value = require_string(evolution, key, "evolution.")
        if value == "NOT_APPLICABLE":
            raise PacketError(f"evolution.{key}: NOT_APPLICABLE requires a reason")


def validate_approval(
    data: dict[str, Any],
    phase: str,
    required_decisions: set[str],
    decision_ids: set[str],
) -> None:
    approval = require_object(data.get("approval"), "approval")
    status = require_enum(
        approval, "status", {"NOT_REQUIRED", "PENDING", "APPROVED"}, "approval."
    )
    listed = set(string_list(approval, "decision_ids", prefix="approval."))
    validate_ref_ids(list(listed), decision_ids, "approval.decision_ids")
    if listed != required_decisions:
        raise PacketError(
            "approval.decision_ids must equal all approval_required decisions"
        )
    if phase == "approved" and required_decisions:
        if status != "APPROVED":
            raise PacketError("approval.status must be APPROVED")
        require_string(approval, "approved_by", "approval.")
        require_string(approval, "evidence_ref", "approval.")
    if not required_decisions and status not in {"NOT_REQUIRED", "APPROVED"}:
        raise PacketError(
            "approval.status cannot stay PENDING without required decisions"
        )


def validate_review(data: dict[str, Any], phase: str, criticality: str) -> None:
    review = require_object(data.get("independent_review"), "independent_review")
    required = require_bool(review, "required", "independent_review.")
    if criticality == "S3" and not required:
        raise PacketError("independent_review.required must be true for S3")
    status = require_enum(
        review,
        "status",
        {"NOT_REQUIRED", "PENDING", "PASS", "FAIL", "INCONCLUSIVE"},
        "independent_review.",
    )
    if phase == "approved" and required:
        if status != "PASS":
            raise PacketError("required independent review must PASS")
        require_string(review, "reviewer", "independent_review.")
        require_string(review, "evidence_ref", "independent_review.")


def validate_open_questions(data: dict[str, Any], phase: str) -> None:
    items = validate_ids(
        require_list(data.get("open_questions"), "open_questions"),
        "open_questions",
        "Q",
    )
    for index, item in enumerate(items):
        prefix = f"open_questions[{index}]."
        require_string(item, "question", prefix)
        blocking = require_bool(item, "blocking", prefix)
        if phase == "approved" and blocking:
            raise PacketError(f"{prefix}blocking: unresolved blocker forbids approval")


def validate_materialization(data: dict[str, Any], run_dir: Path | None) -> None:
    protected = set(string_list(data, "protected_paths"))
    items = require_list(data.get("materialization"), "materialization")
    for index, raw in enumerate(items):
        item = require_object(raw, f"materialization[{index}]")
        source_raw = require_string(item, "source", f"materialization[{index}].")
        target_raw = require_string(item, "target", f"materialization[{index}].")
        source = safe_relative_path(source_raw, f"materialization[{index}].source")
        target = safe_relative_path(target_raw, f"materialization[{index}].target")
        if source.parts[:2] != ("architecture", "proposals"):
            raise PacketError(
                f"materialization[{index}].source: expected architecture/proposals/"
            )
        if target.parts[0] in {".git", ".ai-team"}:
            raise PacketError(
                f"materialization[{index}].target: protected internal path"
            )
        if target_raw not in protected:
            raise PacketError(
                f"materialization[{index}].target: must be in protected_paths"
            )
        digest = require_string(item, "sha256", f"materialization[{index}].")
        if HEX_64.fullmatch(digest) is None:
            raise PacketError(
                f"materialization[{index}].sha256: expected 64 lowercase hex"
            )
        if run_dir is not None:
            source_path = (run_dir / source).resolve()
            try:
                source_path.relative_to(run_dir.resolve())
            except ValueError as exc:
                raise PacketError(
                    f"materialization[{index}].source escapes run dir"
                ) from exc
            if not source_path.is_file():
                raise PacketError(f"materialization[{index}].source does not exist")
            if hashlib.sha256(source_path.read_bytes()).hexdigest() != digest:
                raise PacketError(f"materialization[{index}].sha256 mismatch")


def validate_packet(
    data: dict[str, Any],
    phase: str,
    *,
    run_dir: Path | None = None,
    role_plan_path: Path | None = None,
) -> None:
    if data.get("schema_version") != "1.0":
        raise PacketError("schema_version: expected '1.0'")
    require_string(data, "task_id")
    require_string(data, "run_id")
    criticality = require_enum(data, "criticality", CRITICALITIES)
    require_string(data, "profile")
    status = require_enum(data, "status", {"DRAFT", "BLOCKED", "APPROVED"})
    if phase == "draft" and status not in {"DRAFT", "BLOCKED"}:
        raise PacketError("draft phase expects status DRAFT or BLOCKED")
    if phase == "approved" and status != "APPROVED":
        raise PacketError("approved phase expects status APPROVED")

    requirement_ids = set(string_list(data, "requirement_ids", nonempty=True))
    evidence_ids = validate_evidence(data)
    risk_triggers = set(string_list(data, "risk_triggers"))
    unknown_triggers = sorted(risk_triggers - THREAT_RISK_TRIGGERS)
    if unknown_triggers:
        raise PacketError(f"risk_triggers: unknown values {unknown_triggers}")
    validate_assumptions(data, phase, evidence_ids)
    verification_ids, checks = validate_verification(data)
    decision_ids, required_decisions = validate_decisions(data, phase, evidence_ids)
    quality_ids = validate_quality(data, verification_ids)
    boundary_ids = validate_boundaries(data, verification_ids)
    contract_ids = validate_contracts(data, verification_ids)
    validate_views(data)
    risk_ids = validate_risks(data, verification_ids)
    threat_ids = validate_threat_model(
        data, criticality, risk_triggers, verification_ids
    )
    validate_evolution(data)
    validate_approval(data, phase, required_decisions, decision_ids)
    validate_review(data, phase, criticality)
    validate_open_questions(data, phase)
    validate_materialization(data, run_dir)
    validate_role_plan_ref(data, phase, role_plan_path)
    string_list(data, "deferred")

    traceable = (
        requirement_ids
        | decision_ids
        | quality_ids
        | boundary_ids
        | contract_ids
        | risk_ids
        | threat_ids
    )
    for index, check in enumerate(checks):
        refs = string_list(
            check,
            "requirement_ids",
            nonempty=True,
            prefix=f"verification_surface[{index}].",
        )
        validate_ref_ids(
            refs, traceable, f"verification_surface[{index}].requirement_ids"
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("packet", type=Path)
    parser.add_argument("--phase", required=True, choices=("draft", "approved"))
    parser.add_argument("--run-dir", type=Path)
    parser.add_argument("--role-plan", type=Path)
    args = parser.parse_args()

    try:
        raw = args.packet.read_bytes()
        data = require_object(json.loads(raw.decode("utf-8")), "packet")
        run_dir = args.run_dir.resolve() if args.run_dir else None
        validate_packet(
            data, args.phase, run_dir=run_dir, role_plan_path=args.role_plan
        )
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, PacketError) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1

    digest = hashlib.sha256(raw).hexdigest()
    print(f"PASS: architecture packet is valid for {args.phase}; sha256={digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

