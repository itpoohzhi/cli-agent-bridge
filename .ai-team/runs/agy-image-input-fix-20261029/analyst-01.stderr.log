   636	def _collect_image_parts(messages: Any) -> list:
   637	    """Все image-части сообщений с их ролью, по порядку истории."""
   638	    found = []
   639	    if not isinstance(messages, list):
   640	        return found
   641	    for msg in messages:
   642	        if not isinstance(msg, dict):
   643	            continue
   644	        content = msg.get("content")
   645	        if not isinstance(content, list):
   646	            continue
   647	        for item in content:
   648	            if isinstance(item, dict) and item.get("type") == "image_url":
   649	                found.append((str(msg.get("role") or ""), item))
   650	    return found
