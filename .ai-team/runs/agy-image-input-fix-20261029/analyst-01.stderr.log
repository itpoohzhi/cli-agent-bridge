   191	def _attachments_section(images: list) -> str:
   192	    """Хвост промпта метода workspace-read (эталон — kit/mkprompt.py)."""
   193	    lines = [
   194	        "[attachments]",
   195	        "This request includes %d image(s) as local files in the working directory. "
   196	        "The markers [image N] in the conversation refer to them in order."
   197	        % len(images),
   198	    ]
   199	    for index, image in enumerate(images, 1):
   200	        lines.append(
   201	            "- [image %d] ./%s (%s, %d bytes)"
   202	            % (index, image["name"], image["mime"], len(image["data"]))
   203	        )
   204	    lines.append(
   205	        "Open each image with the Read tool on exactly these paths before answering about it "
   206	        "(Read is the only built-in tool you may use, and only on these files). Do not claim to "
   207	        "see an image you have not opened. If an image cannot be opened, say so explicitly "
   208	        "instead of guessing."
   209	    )
   210	    return "\n".join(lines)
