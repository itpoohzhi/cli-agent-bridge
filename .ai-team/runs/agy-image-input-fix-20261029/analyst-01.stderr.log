   594	def _messages_to_prompt(messages: list) -> str:
   595	    """Собрать единый текстовый промпт хода.
   596	
   597	    Секции протокола инструментов нет намеренно: agy исполняет СВОИ нативные
   598	    инструменты, а не инструменты DSH (см. README, раздел «Инструменты»).
   599	    """
   600	    counter = [0]
   601	    blocks = []
   602	    for msg in messages:
   603	        rendered = _render_message(msg, counter)
   604	        if rendered:
   605	            blocks.append(rendered)
   606	    text = "\n\n".join(blocks).strip()
   607	    if not text:
   608	        text = "Reply with exactly: PONG"
   609	    return text
