   626	def _sniff_image(data: bytes) -> str:
   627	    """MIME по магическим байтам ('' — сигнатура неизвестна)."""
   628	    for prefix, mime in IMAGE_SIGNATURES:
   629	        if data.startswith(prefix):
   630	            return mime
   631	    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
   632	        return "image/webp"
   633	    return ""
