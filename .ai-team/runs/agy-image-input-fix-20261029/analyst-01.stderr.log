   558	def _render_message(msg: Any, counter: list) -> str:
   559	    """Сообщение OpenAI в текстовый блок промпта (роли не теряются)."""
   560	    if not isinstance(msg, dict):
   561	        return ""
   562	    role = str(msg.get("role") or "user")
   563	    name = msg.get("name")
   564	    label = role if not name else "%s(%s)" % (role, name)
   565	    body = _flatten_content(msg.get("content"))
   566	    lines = []
   567	    calls = msg.get("tool_calls")
   568	    if isinstance(calls, list):
   569	        for call in calls:
   570	            if not isinstance(call, dict):
   580	                "[tool call %s] %s(%s)" % (call.get("id") or "call", fname, fargs)
   581	            )
   582	    if role == "tool":
   583	        cid = msg.get("tool_call_id") or "call"
   584	        lines.append("[tool result %s] %s" % (cid, body))
   585	    elif body:
   586	        lines.append(body)
   587	    prepared = "\n".join(lines).strip()
   588	    if not prepared:
   589	        return ""
   590	    counter[0] += 1
   591	    return "### %d. %s\n%s" % (counter[0], label, prepared)
