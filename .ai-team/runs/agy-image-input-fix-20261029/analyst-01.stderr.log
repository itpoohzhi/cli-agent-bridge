   240	def _strip_code_fence(text: str) -> str:
   241	    """Снять обёртку ```…``` или ~~~…~~~ (в т.ч. ```json) вокруг JSON внутри блока."""
   242	    body = text.strip()
   243	    if body.startswith(("```", "~~~")):
   244	        newline = body.find("\n")
   245	        body = body[newline + 1 :] if newline != -1 else body[3:]
   246	    if body.rstrip().endswith(("```", "~~~")):
   247	        body = body.rstrip()[:-3]
   248	    return body.strip()
