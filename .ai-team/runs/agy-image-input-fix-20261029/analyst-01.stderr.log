                _result_ev(0.15),
                _late_ev(0.16, 0.09, 3, thinking),
                _exit_ev(0.17),
            ]
            _ = fx.write_scenario(events)
            turns = _run_many(20)
            self.assertEqual(len(turns), 20)
            hits = sum(1 for turn in turns if turn.reasoning() == thinking)
            self.assertEqual(hits, 20)
            frames = _sse_frames(_ctx())
