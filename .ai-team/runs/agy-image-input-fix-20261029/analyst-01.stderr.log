   430	    def test_cleanup_after_client_gone(self):
   431	        server.IMAGE_PROBE = True
   432	        self.probe_stand()
   433	        real_gone = server._client_gone
   434	        server._client_gone = lambda sock: True
   435	        try:
   436	            raw = self._raw_request(
   437	                json.dumps(
   438	                    {
   439	                        "model": "claude-sonnet-5-5",
   440	                        "reasoning_effort": "high",
   441	                        "messages": [user_message([image_part(make_png(64))])],
   442	                    }
   443	                ).encode()
   444	            )
   445	            sock = __import__("socket").create_connection(
   446	                ("127.0.0.1", self.port), timeout=5
   447	            )
   448	            sock.sendall(raw)
   449	            time.sleep(0.7)
   450	            sock.close()
   451	        finally:
   452	            server._client_gone = real_gone
   453	        deadline = time.time() + 5
   454	        while time.time() < deadline and list(server.WORKSPACE.glob("img-*")):
   455	            time.sleep(0.1)
   456	        self.assertEqual(list(server.WORKSPACE.glob("img-*")), [])
   457	        # Клиент ушёл раньше хода: ход не доходит до модели, процесс не остаётся.
   458	        self.assertLessEqual(len(self.hub.spawns()), 1)
   459	        self.assertEqual(len(self.hub.admissions()), 0)
