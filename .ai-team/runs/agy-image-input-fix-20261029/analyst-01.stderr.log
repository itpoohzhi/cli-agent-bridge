   675	def _collect_images(request: dict, model: dict, effort: str) -> list:
   676	    """Проверить изображения запроса (C-08); [] — изображений нет.
   677	
   678	    Порядок: применимость модели/proof (класс II) -> форма частей -> data-URL ->
   679	    сигнатура -> формат -> лимиты (число, размер, сумма).
   680	    """
   681	    messages = request.get("messages")
   682	    parts = _collect_image_parts(messages)
   683	    if not parts:
   684	        return []
   685	    status = (model.get("images") or {}).get("status")
   686	    capable = status == "confirmed" or (status == "probe" and IMAGE_PROBE)
   687	    if not capable:
   688	        raise ImageReject("image_input_not_supported")
   689	    reason = _image_proof_reason(model, effort)
   690	    if reason:
   691	        _log(f"image_proof_invalid model={model.get('id')} reason={reason}")
   692	        raise ImageReject("image_input_not_supported")
   693	    limits = FLEET.get("image_limits") or {}
   694	    max_images = int(limits.get("max_images") or 0)
   695	    max_image_bytes = int(limits.get("max_image_bytes") or 0)
   696	    max_total = int(limits.get("max_total_image_bytes") or 0)
   697	    allowed = [str(t).lower() for t in (limits.get("max_types") or [])]
   698	    images = []
   699	    total = 0
   700	    for role, item in parts:
   701	        if role != "user":
   702	            raise ImageReject("invalid_image_content")
   703	        image_url = item.get("image_url")
   704	        if not isinstance(image_url, dict):
   705	            raise ImageReject("invalid_image_content")
   706	        url = image_url.get("url")
   707	        if not isinstance(url, str):
   708	            raise ImageReject("invalid_image_content")
   709	        if not url.startswith("data:"):
   710	            raise ImageReject("image_url_not_allowed")
   711	        mime, data = _parse_data_url(url)
   712	        sniffed = _sniff_image(data)
   713	        if not sniffed:
   714	            raise ImageReject("unsupported_image_type")
   715	        if sniffed != mime:
   716	            raise ImageReject("image_type_mismatch")
   717	        if mime not in allowed:
   718	            raise ImageReject("unsupported_image_type")
   719	        if len(images) + 1 > max_images:
   720	            raise ImageReject("too_many_images")
   721	        if len(data) > max_image_bytes:
   722	            raise ImageReject("image_too_large")
   723	        total += len(data)
   724	        if total > max_total:
   725	            raise ImageReject("images_too_large")
   726	        images.append({"mime": mime, "data": data})
   727	    for index, image in enumerate(images, 1):
   728	        image["name"] = "img-%d.%s" % (
   729	            index,
   730	            IMAGE_EXTENSIONS.get(image["mime"], "bin"),
   731	        )
   732	    return images
