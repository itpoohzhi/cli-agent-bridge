   213	def _messages_to_prompt(
   214	    messages: list,
   215	    tools: list | None = None,
   216	    tool_choice: Any = None,
   217	    images: list | None = None,
   218	) -> str:
   219	    """Собрать единый текстовый промпт; при наличии tools — с секцией протокола.
   220	
   221	    При наличии изображений в конец добавляется секция [attachments], а строка
   222	    протокола инструментов получает исключение для Read (C-09).
   223	    """
   224	    tools = tools or []
   225	    counter = [0]
   226	    blocks = []
   227	    for msg in messages:
   228	        rendered = _render_message(msg, counter)
   229	        if rendered:
   230	            blocks.append(rendered)
   231	    head = []
   232	    if tools and not _tool_choice_none(tool_choice):
   233	        head.append(_tools_section(tools, tool_choice, bool(images)))
   234	    text = "\n\n".join(head + blocks).strip() or "Reply with exactly: PONG"
   235	    if images:
   236	        text = text + "\n\n" + _attachments_section(images)
   237	    return text
