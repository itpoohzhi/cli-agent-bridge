   522	def _flatten_content(content: Any) -> str:
   523	    if content is None:
   524	        return ""
   525	    if isinstance(content, str):
   526	        return content
   527	    if isinstance(content, list):
   528	        parts = []
   529	        for item in content:
   530	            if isinstance(item, str):
   531	                parts.append(item)
   532	            elif isinstance(item, dict) and "text" in item:
   533	                parts.append(str(item["text"]))
   534	        return "\n".join(p for p in parts if p)
   535	    return str(content)
