            _ = _poll(tail)
            self.assertEqual(len(calls), 2)
            self.assertEqual(emitted, [(3, "aaaa")])  # непрефиксный снимок заморожен

    def test_ao05_stop_inside_sixteen_rows_stops_the_parser(self) -> None:
        with _Fixture() as fx:
