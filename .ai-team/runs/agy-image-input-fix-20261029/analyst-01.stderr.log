   568	    """Применимость proof (класс II) -> '' (ок) или причина деградации.
   569	
   570	    Сверяются sha256 файла technical_ref.droid_binary_path, версия реализации
   571	    метода, форматы image_limits.types ⊆ proof.formats и применимый effort
   572	    запроса ∈ proof.efforts_proven. Ошибка чтения бинаря — тоже несовпадение.
   573	    """
   574	    proof = (model.get("images") or {}).get("proof")
   575	    if not proof:
   576	        return ""
   577	    ref = FLEET.get("technical_ref") or {}
   578	    path = os.path.expanduser(str(ref.get("droid_binary_path") or ""))
   579	    if not path or _file_sha256(path) != str(proof.get("droid_binary_sha256") or ""):
   580	        return "droid_binary_sha"
   581	    if proof.get("impl_version") != METHOD_IMPL_VERSION:
   582	        return "impl_version"
   583	    formats = proof.get("formats") or []
   584	    types = (FLEET.get("image_limits") or {}).get("types") or []
   585	    if not set(types).issubset(set(formats)):
   586	        return "formats"
   587	    if effort and effort not in (proof.get("efforts_proven") or []):
   588	        return "effort"
   589	    return ""
