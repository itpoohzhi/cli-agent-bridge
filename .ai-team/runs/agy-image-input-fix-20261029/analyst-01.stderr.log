   612	def _get_resumed_turn_prompt(messages: list) -> str:
   613	    last_asst = -1
   614	    for i in range(len(messages) - 1, -1, -1):
   615	        if isinstance(messages[i], dict) and messages[i].get("role") == "assistant":
   616	            last_asst = i
   617	            break
   618	    if last_asst >= 0 and last_asst + 1 < len(messages):
   619	        new_msgs = messages[last_asst + 1 :]
   620	        prompt = _messages_to_prompt(new_msgs)
   621	        if prompt:
   622	            return prompt
   623	    return _messages_to_prompt(messages)
