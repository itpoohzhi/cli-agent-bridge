   653	def _parse_data_url(url: str) -> tuple:
   654	    """data-URL -> (mime, bytes); ошибки — ImageReject из таксономии C-10."""
   655	    comma = url.find(",")
   656	    if comma == -1:
   657	        raise ImageReject("invalid_image_content")
   658	    head = url[5:comma]
   659	    payload = url[comma + 1 :]
   660	    fields = [f.strip().lower() for f in head.split(";")]
   661	    mime = fields[0] if fields else ""
   662	    if not mime or "base64" not in fields[1:]:
   663	        raise ImageReject("invalid_image_content")
   664	    if mime not in KNOWN_IMAGE_MIMES:
   665	        raise ImageReject("unsupported_image_type")
   666	    if not payload:
   667	        raise ImageReject("invalid_image_base64")
   668	    try:
   669	        data = base64.b64decode(payload, validate=True)
   670	    except (binascii.Error, ValueError):
   671	        raise ImageReject("invalid_image_base64")
   672	    return mime, data
