    21	def _flatten_content(content: Any) -> str:
    22	    if content is None:
    23	        return ""
    24	    if isinstance(content, str):
    25	        return content
    26	    if isinstance(content, list):
    27	        parts = []
    28	        for item in content:
    29	            if isinstance(item, str):
    30	                parts.append(item)
    31	            elif isinstance(item, dict) and "text" in item:
    32	                parts.append(str(item["text"]))
    33	        return "\n".join(p for p in parts if p)
    34	    return str(content)
