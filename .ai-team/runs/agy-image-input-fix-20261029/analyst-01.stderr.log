if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from core.watchdog import (  # noqa: E402
    AdaptiveTimeoutController,
    ProcessWatchdog,
    WatchdogMetrics,
)

