    37	def _render_content(content: Any, counter: list) -> str:
    38	    """Содержимое сообщения -> текст; на месте изображений маркер `[image N]`.
    39	
    40	    Нумерация сквозная по порядку появления во всей истории. Неизвестные
    41	    НЕ-image части (например input_audio) молча пропускаются, как раньше.
    42	    """
    43	    if content is None:
    44	        return ""
    45	    if isinstance(content, str):
    46	        return content
    47	    if isinstance(content, list):
    48	        parts = []
    49	        for item in content:
    50	            if isinstance(item, str):
    51	                parts.append(item)
    52	            elif isinstance(item, dict):
    53	                if item.get("type") == "image_url":
    54	                    counter[0] += 1
    55	                    parts.append(f"[image {counter[0]}]")
    56	                elif "text" in item and item.get("text") is not None:
    57	                    parts.append(str(item["text"]))
    58	        return "\n".join(p for p in parts if p)
    59	    return str(content)
