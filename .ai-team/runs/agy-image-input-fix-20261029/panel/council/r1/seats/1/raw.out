elf._log_done(\n3145:                 cast(str, ctx[\"model\"]), early, t_enter, cast(str, ctx[\"tag\"])\n3146:             )\n3147:             return early\n3148:         t0 = time.monotonic()\n3149:         out: dict = {}\n3150:         typed_ctx = cast(\"dict[str, object]\", ctx)\n3151:         images = cast(\"list[dict[str, object]]\", typed_ctx.get(\"images\") or [])\n3152:         img_dir = cast(\"Path | None\", typed_ctx.get(\"img_dir\")) if images else None\n3153:         img_registered = False\n3154:         try:\n3155:             try:\n3156:                 _launcher()\n3157:             except LauncherUnavailable:\n3158:                 self._log_reject(\"launcher_unavailable\", model, ctx[\"model_len\"])\n3159:                 unavailable: dict[str, object] = {\n3160:                     \"state\": \"launcher_unavailable\",\n3161:                     \"rc\": 1,\n3162:                     \"text\": \"\",\n3163:                     \"usage\": {},\n3164:                     \"result\": {},\n3165:                     \"err\": \"\",\n3166:                     \"tool_calls\": [],\n3167:                     \"tool_events\": 0,\n3168:                     \"conversation_id\": \"\",\n3169:                     \"num_turns\": None,\n3170:                     \"duration_s\": None,\n3171:                 }\n3172:                 self._log_done(\n3173:                     cast(str, ctx[\"model\"]), unavailable, t_enter, cast(str, ctx[\"tag\"])\n3174:                 )\n3175:                 return unavailable\n3176:             if images and img_dir is not None:\n3177:                 # Флаг и proof могли смениться, пока ход ждал слот: повторная проверка\n3178:                 # до mkdir и spawn.\n3179:                 gate = _image_gate(cast(str, model), cast(str, effort))\n3180:                 if gate is not None:\n3181:                     self._log_reject(\n3182:                         gate.code, cast(str, model), cast(int, ctx[\"model_len\"])\n3183:           