38: \nserver.py 3730 3865\n3730:             ctx, lambda _v: True, lambda _e: True, lambda _r: True, None\n3731:         )\n3732:         if out.get(\"state\") == \"client_gone\":\n3733:             return\n3734:         err = self._error_body(out)\n3735:         if err is not None:\n3736:             self._send(err[\"code\"], {\"error\": err})\n3737:             return\n3738:         usage = out.get(\"usage\") or {}\n3739:         message = {\"role\": \"assistant\", \"content\": out[\"text\"]}\n3740:         reasoning = out.get(\"reasoning\") or \"\"\n3741:         if reasoning:\n3742:             # OpenAI-совместимое поле мышления: Harness читает его из сообщения\n3743:             # ассистента так же, как из дельты потока.\n3744:             message[\"reasoning_content\"] = reasoning\n3745:         payload = {\n3746:             \"id\": f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\",\n3747:             \"object\": \"chat.completion\",\n3748:             \"created\": int(time.time()),\n3749:             \"model\": ctx[\"model\"],\n3750:             \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": \"stop\"}],\n3751:             \"usage\": self._usage_payload(usage),\n3752:         }\n3753:         if out.get(\"conversation_id\"):\n3754:             payload[\"conversation_id\"] = out[\"conversation_id\"]\n3755:         self._send(200, payload)\n3756: \n3757:     def _serve_sse(self, ctx: dict) -> None:\n3758:         completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n3759:         created = int(time.time())\n3760:         shown_model = ctx[\"model\"]\n3761:         try:\n3762:             self.send_response(200)\n3763:             self.send_header(\"Content-Type\", \"text/event-stream\")\n3764:             self.send_header(\"Cache-Control\", \"no-cache\")\n3765:             self.send_header(\"X-Accel-Buffering\", \"no\")\n3766:             self.end_headers()\n3767:             self.close_connection = True\n3768:         except (BrokenPipeError, ConnectionResetError, OSError):\n3769:             _log(\"client gone before headers\")\n3770:             return\n3771: \n3772:         def chunk(\n3773:             delta: dict,\n3774:             finish=None,\n3775:             usage: dict | None = None,\n3776:             conversation_id: str = \"\",\n3777:         ) -> str:\n3778:             body: dict = {\n3779:                 \"id\": completion_id,\n3780:                 \"object\": \"chat.completion.chunk\",\n3781:                 \"created\": created,\n3782:                 \"model\": shown_model,\n3783:                 \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish}],\n3784:             }\n3785:             if usage is not None:\n3786:                 body[\"usage\"] = usage\n3787:             if conversation_id:\n3788:                 body[\"conversation_id\"] = conversation_id\n3789:             return \"data: \" + json.dumps(body, ensure_ascii=False) + \"\\n\\n\"\n3790: \n3791:         def on_text(value: str) -> bool:\n3792:             return self._emit(chunk({\"content\": value}))\n3793: \n3794:         def on_reasoning(value: str) -> bool:\n3795:             # Мышление шага: Harness читает первое непустое из\n3796:             # reasoning_content|reasoning|reasoning_text — отдаём только первое.\n3797:             return self._emit(chunk({\"reasoning_content\": value}))\n3798: \n3799:         def on_tool_trace(_event: dict) -> bool:\n3800:             # Нативный инструмент agy исполняется внутри CLI и наружу не транслируется:\n3801:             # клиенту нечего добавлять к его же истории вызовов. Трассировка — в stderr.\n3802:             return True\n3803: \n3804:         def keepalive() -> bool:\n3805:             return self._emit(\": keepalive\\n\\n\")\n3806: \n3807:         if not self._emit(chunk({\"role\": \"assistant\", \"content\": \"\"})):\n3808:             return\n3809:         out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n3810:         if out.get(\"state\") == \"client_gone\":\n3811:             _log(\"client gone mid-stream, child killed\")\n3812:             return\n3813:         err = self._error_body(out)\n3814:         if err is None:\n3815:             conv_id = str(out.get(\"conversation_id\") or \"\")\n3816:             self._emit(chunk({}, \"stop\", conversation_id=conv_id))\n3817:             # Harness считает tok/s и % контекста только из usage в потоке\n3818:             # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage).\n3819:             # Шлём только при ненулевых токенах, чтобы пустой usage от agy\n3820:             # не превращался в ложные «0 tok/s / 0%».\n3821:             usage = self._usage_payload(out.get(\"usage\") or {})\n3822:             if usage[\"prompt_tokens\"] or usage[\"completion_tokens\"]:\n3823:                 self._emit(chunk({}, \"stop\", usage, conversation_id=conv_id))\n3824:         else:\n3825:             self._emit(\n3826:                 \"data: \" + json.dumps({\"error\": err}, ensure_ascii=False) + \"\\n\\n\"\n3827:             )\n3828:         self._emit(\"data: [DONE]\\n\\n\")\n3829: \n3830: \n3831: class Server(ThreadingHTTPServer):\n3832:     \"\"\"HTTP-сервер с семафором числа соединений на уровне приёма.\"\"\"\n3833: \n3834:     daemon_threads = True\n3835:     request_queue_size = 64\n3836:     allow_reuse_address = True\n3837: \n3838:     def __init__(self, *args: Any, **kwargs: Any):\n3839:         super().__init__(*args, **kwargs)\n3840:         self._conn_sem = threading.BoundedSemaphore(\n3841:             int(FLEET[\"admission\"][\"max_http_connections\"])\n3842:         )\n3843: \n3844:     def _send_raw_503(self, request: socket.socket) -> None:\n3845:         body = json.dumps(\n3846:             {\n3847:                 \"error\": {\n3848:                     \"message\": \"bridge overloaded: connection limit\",\n3849:                     \"type\": \"overloaded\",\n3850:                     \"code\": 503,\n3851:                 },\n3852:             }\n3853:         ).encode(\"utf-8\")\n3854:         head = (\n3855:             b\"HTTP/1.1 503 Service Unavailable\\r\\n\"\n3856:             b\"Content-Type: application/json; charset=utf-8\\r\\n\"\n3857:             b\"Content-Length: \" + str(len(body)).encode() + b\"\\r\\n\"\n3858:             b\"Connection: close\\r\\n\\r\\n\"\n3859:         )\n3860:         request.sendall(head + body)\n3861: \n3862:     def process_request(\n3863:         self, request: socket.socket | tuple[bytes, socket.socket], client_address: Any\n3864:     ) -> None:\n3865:         if not self._conn_sem.acquire(blocking=False):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"Жеребьёвка совпала с указанными хешами. Найден разрыв HTTP-контракта: SSE отправляет статус 200 до повторной проверки флага и записи файлов, поэтому поздние отказы 400/500 уходят только внутри потока. Также проверяю освобождение буфера и покрытие требований к ресурсам.\n"}}
