r.py\\\",\\\"tests/test_agy_bridge_resilience.py\\\"}; names=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--name-only\\\",b,\\\"HEAD\\\"],text=True).splitlines(); actual={n for n in names if not n.startswith((\\\".ai-team/\\\",\\\"analysis/\\\"))}; assert actual==expected,(actual,expected); tracked=subprocess.check_output([\\\"git\\\",\\\"ls-files\\\"],text=True).splitlines(); assert not any(Path(n).name==\\\"dynamic_config.json\\\" for n in tracked); frozen={'\\\"'\\\"'research-plan'\\\"'\\\"': '\\\"'\\\"'67f3bfffc4e9df6b95ee8571c34ded4a397ad164f86787b3b935fe51dcf1243a'\\\"'\\\"', '\\\"'\\\"'evidence-ledger'\\\"'\\\"': '\\\"'\\\"'aba34816b5cf6425d4fbf19187a09edd5f7158797e442d488d68626576f887a9'\\\"'\\\"', '\\\"'\\\"'open-questions'\\\"'\\\"': '\\\"'\\\"'63fe13ce25d80cb7bad68d25a57c8d1d6e58847b5b8be79dc395b555c55e5b76'\\\"'\\\"', '\\\"'\\\"'handoff-architect'\\\"'\\\"': '\\\"'\\\"'6c22f4a0ab4fc71d2e7cd88e1fe7d2df8c327193eb75bfc9d922af68a4710a8f'\\\"'\\\"', '\\\"'\\\"'handoff-qa'\\\"'\\\"': '\\\"'\\\"'007cdac728cdd6754c6617cd749ed3361f0d19c9e1adae16a3c31a90ee352cee'\\\"'\\\"'};\\nfor n,h in frozen.items(): assert hashlib.sha256(Path(\\\"analysis/agy-image-input-fix\\\",n+\\\".md\\\").read_bytes()).hexdigest()==h,n\\nprint(\\\"SCOPE_FROZEN_PASS\\\")'\",\n      \"expected\": \"exact three product files in baseline..HEAD, no tracked dynamic_config.json, 5 frozen hashes pass\",\n      \"environment\": \"cwd=repo_root; pinned versions; clean-room no repo caches; not run during Stage 2\",\n      \"owner\": \"Teamlead\"\n    },\n    {\n      \"id\": \"VER-009\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-004\",\n        \"REQ-005\",\n        \"REQ-006\",\n        \"REQ-007\",\n        \"REQ-008\",\n        \"REQ-009\",\n        \"REQ-010\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import ast,sys; from pathlib import Path; s=Path(\\\"bridg