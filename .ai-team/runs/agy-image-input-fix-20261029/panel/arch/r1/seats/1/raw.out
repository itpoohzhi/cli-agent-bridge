nc.attr.startswith(\\\"assert\\\") for a in ast.walk(f)):\\n  found.update(k for k in expected if re.search(r\\\"(?:^|_)\\\"+k+r\\\"(?:_|$)\\\",f.name))\\nassert not expected-found,sorted(expected-found); print(\\\"QA_ASSERT_COVERAGE_PASS\\\",len(expected))'\",\n      \"expected\": \"40 IDs img01..10/hist01..10/life01..05/log01..02/res01..03/ao01..10; each mapped test_* has assert or self.assert*\",\n      \"environment\": \"cwd=repo_root; pinned versions; clean-room no repo caches; not run during Stage 2\",\n      \"owner\": \"Teamlead\"\n    },\n    {\n      \"id\": \"VER-008\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-004\",\n        \"REQ-005\",\n        \"REQ-006\",\n        \"REQ-007\",\n        \"REQ-008\",\n        \"REQ-009\",\n        \"REQ-010\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"PYTHONDONTWRITEBYTECODE=1 python3 -B -c 'import subprocess,hashlib; from pathlib import Path; b=\\\"5a19559426de7508d525e2bd465eff648665a6a7\\\"; expected={\\\"bridges/agy-bridge/fleet.json\\\",\\\"bridges/agy-bridge/server.py\\\",\\\"tests/test_agy_bridge_resilience.py\\\"}; names=subprocess.check_output([\\\"git\\\",\\\"diff\\\",\\\"--name-only\\\",b,\\\"HEAD\\\"],text=True).splitlines(); actual={n for n in names if not n.startswith((\\\".ai-team/\\\",\\\"analysis/\\\"))}; assert actual==expected,(actual,expected); tracked=subprocess.check_output([\\\"git\\\",\\\"ls-files\\\"],text=True).splitlines(); assert not any(Path(n).name==\\\"dynamic_config.json\\\" for n in tracked); frozen={'\\\"'\\\"'research-plan'\\\"'\\\"': '\\\"'\\\"'67f3bfffc4e9df6b95ee8571c34ded4a397ad164f86787b3b935fe51dcf1243a'\\\"'\\\"', '\\\"'\\\"'evidence-ledger'\\\"'\\\"': '\\\"'\\\"'aba34816b5cf6425d4fbf19187a09edd5f7158797e442d488d68626576f887a9'\\\"'\\\"', '\\\"'\\\"'open-questions'\\\"'\\\"': '\\\"'\\\"'63fe13ce25d80cb7bad68d25a57c8d1d6e58847b5b8be79dc395b555c55e5b76'\\\"'\\\"', '\\\"'\\\"'handoff-architect