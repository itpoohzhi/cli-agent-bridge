son == \"exec_fallback_disabled\":\n3276|                        err = (\n3277|                            \"exec_fallback_disabled(denyUnmatched): \"\n3278|                            f\"serve unavailable: {safe_exc}\"\n3279|                        )\n3280|                    else:\n3281|                        err = exc_text\n3282|                    _log(\n3283|                        f\"serve unavailable ({safe_exc}), exec fallback blocked \"\n3284|                        f\"reason={exec_reason}\"\n3285|                    )\n3286|                    return _blocked_out(err), \"serve\"\n3287|                _log(f\"serve unavailable ({safe_exc}), fallback exec model={model}\")\n3288|                exec_run = Run(model, attempt_prompt, effort, WORKSPACE)\n3289|                exec_run.exec_deadline = _exec_deadline\n3290|                exec_run.action_possible = True\n3291|                agg[\"action\"] = True\n3292|                runs.append(exec_run)\n3293|                self._current_run = exec_run\n3294|                attempt_out = exec_run.execute()\n3295|                _update_agg(exec_run, attempt_out)\n3296|                return attempt_out, \"exec-after-serve-fallback\"\n3297|\n3298|        out: dict[str, Any] = {\n3299|            \"rc\": 1,\n3300|            \"text\": \"\",\n3301|            \"err\": \"no attempt\",\n3302|            \"state\": \"terminal_failed\",\n3303|        }\n3304|        via = \"none\"\n3305|        try:\n3306|            out, via = run_attempt(prompt)\n3307|            while True:\n3308|                if out.get(\"rc\") == 0 and out.get(\"state\") == \"ok\":\n3309|                    break\n3310|                if self._client_gone or getattr(self, \"_delivery_failed\", False):\n3311|                    break\n3312|                raw_err = str(out.get(\"err\") or \"\")\n3313|                is_hard_threshold = (\n3314|                    out.get(\"rc\") != 0\n3315|                    and out.get(\"state\") == \"termin