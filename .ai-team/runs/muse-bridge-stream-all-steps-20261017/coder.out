ind not in (\"reasoning\", \"agentMessage\"):\n2221|                    self.observed_barrier = True\n2222|                    if iid:\n2223|                        tool_item_ids.add(iid)\n2224|                        self.tool_item_count = len(tool_item_ids)\n2225|                    _log(\n2226|                        f\"tool_item kind={_render_tool_token(kind)} \"\n2227|                        f\"tool={_render_tool_token(item.get('toolName'))}\"\n2228|                    )\n2229|                if method == \"item/completed\" and kind == \"reasoning\":\n2230|                    self._live_frozen = True\n2231|                if (\n2232|                    method == \"item/completed\"\n2233|                    and turn_id is not None\n2234|                    and item.get(\"turnId\") == turn_id\n2235|                ):\n2236|                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n2237|                        final_text = item[\"text\"]\n2238|                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n2239|                        summaries.extend(\n2240|                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n2241|                        )\n2242|            elif method == \"item/delta\":\n2243|                iid = str(params.get(\"itemId\") or \"\")\n2244|                field = str(params.get(\"field\") or \"text\")\n2245|                piece = params.get(\"delta\")\n2246|                if not isinstance(piece, str) or not piece:\n2247|                    return\n2248|                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n2249|                    try:\n2250|                        idx = int(field.split(\".\", 1)[1])\n2251|                    except (IndexError, ValueError):\n2252|                        idx = len(summary_parts)\n2253|                    if not first_summary_logged[0]:\n2254|                        first_summary_logged[0] =