{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc0b","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":1120,"recorded_at":1780531400002235,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149f4-7ebe-73e1-9996-42bd84515351"},"task_id":"01a149f4-7ebe-73e1-9996-42bd84515351","event":{"kind":"output","task_id":"01a149f4-7ebe-73e1-9996-42bd84515351","chunk":"edited\nchanged lines: lines 3912-3920\n--- original\n+++ updated\n@@\n-        install_fake_msp(self, serve_plans=[plan])\n-        status, body = bridge_request(self, turn_request(stream=True))\n-        self.assertEqual(status, 200, body)\n-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"ac\\n\\nb\")\n-        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n-        install_fake_msp(self, serve_plans=[plan])\n-        status, body = bridge_request(self, turn_request(stream=True))\n-        self.assertEqual(status, 200, body)\n-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\")\n+        install_fake_msp(self, serve_plans=[plan])\n+        status, body = bridge_request(self, turn_request(stream=True))\n+        self.assertEqual(status, 200, body)\n+        # oracle_change (ADR-0004/AD-001): без заморозки live — append-only\n+        # stream в порядке поступления дельт; монотонность префикса сохранена,\n+        # сортировка по idx остаётся только в финальных summaries.\n+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nbc\")\n+        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n+        install_fake_msp(self, serve_plans=[plan])\n+        status, body = bridge_request(self, turn_request(stream=True))\n+        self.assertEqual(status, 200, body)\n+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"b\\n\\na\")\n","final_result":true}}}
