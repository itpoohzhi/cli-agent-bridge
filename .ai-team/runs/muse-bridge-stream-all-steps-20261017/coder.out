c_deadline = float(\"inf\")\n2992|            self._request_deadline = float(\"inf\")\n2993|            self._delivery_failed = False\n2994|\n2995|    def _serve_json(self, req: dict) -> None:\n2996|        # Абсолютный бюджет запроса a4: t0 при приёме, до очереди и вычислений.\n2997|        _t0 = time.monotonic()\n2998|        _req_deadline = _t0 + min(TIMEOUT_S, REQUEST_CAP_S)\n2999|        _exec_deadline = _req_deadline - FINISH_RESERVE_S\n3000|        _write_deadline = _req_deadline - CLOSE_RESERVE_S\n3001|        self._request_deadline = _req_deadline\n3002|        self._exec_deadline = _exec_deadline\n3003|        self._write_deadline = _write_deadline\n3004|        self._live_sent_text = \"\"\n3005|        self._delivery_failed = False\n3006|        _req_done = threading.Event()\n3007|        self._req_done = _req_done\n3008|\n3009|        def _supervise_w() -> None:\n3010|            while not _req_done.wait(0.05):\n3011|                if time.monotonic() >= _write_deadline:\n3012|                    self._delivery_failed = True\n3013|                    _log(\"delivery_deadline W reached: closing connection\")\n3014|                    self._kill_current_run()\n3015|                    self._force_close_connection()\n3016|                    return\n3017|\n3018|        threading.Thread(target=_supervise_w, daemon=True).start()\n3019|        model = str(req.get(\"model\") or DEFAULT_MODEL).strip()\n3020|        if model not in ALLOWED_MODELS:\n3021|            self._send(\n3022|                400,\n3023|                {\n3024|                    \"error\": {\n3025|                        \"message\": f\"unknown model '{model}'; allowed: {sorted(ALLOWED_MODELS)}\",\n3026|                        \"type\": \"invalid_request_error\",\n3027|                        \"code\": \"model_not_found\",\n3028|                    }\n3029|                },\n3030|            )\n3031|            return\n3032|\n3033|        raw_tools = req.get(\"tools\")\n3034|        tools = (\n3035|            [t for t in raw_tools if isinstance(t, dict)]\n3036|            if isinstance(raw_tools, list)\n3037|            else []\n3038|        )\n3039|        tool_choice = req.get(\"tool_choice\")\n3040|        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n3041|\n3042|        raw_messages = req.get(\"messages\") or []\n3043|        _, raw_turns_text = _messages_to_prompt(raw_messages)\n3044|        if not raw_turns_text:\n3045|            self._send(\n3046|                400,\n3047|                {\n3048|                    \"error\": {\n3049|                        \"message\": \"no user content\",\n3050|                        \"type\": \"invalid_request_error\",\n3051|                    }\n3052|                },\n3053|            )\n3054|            return\n3055|\n3056|        rid = uuid.uuid4().hex[:8]\n3057|        limit = _context_limit(model)\n3058|        target = _context_target(limit)\n3059|        retry_target = _context_retry_target(limit)\n3060|        prune_res = _prune_messages(\n3061|            raw_messages,\n3062|            limit=limit,\n3063|            target=target,\n3064|            tools=tools,\n3065|            tool_choice=tool_choice,\n3066|            raw_tools=raw_tools,\n3067|        )\n3068|        if prune_res.status == \"refused\":\n3069|            _log_context_prune(\n3070|                rid, model, \"refused_mandatory\", 1, limit, target, prune_res\n3071|            )\n3072|            detail = (\n3073|                f\"mandatory context exceeds budget \"\n3074|                f\"(est_tokens={prune_res.mandatory_est}, limit={limit})\"\n3075|            )\n3076|            err_msg = f\"muse turn failed (rc=1, state=terminal_failed): {detail}\"\n3077|            _log(\n3078|                _format_err_log(\n3079|                    model,\n3080|                    \"refused\",\n3081|                    {\"rc\": 1, \"state\": \"terminal_failed\", \"err\": detail},\n3082|                    req.get(\"stream\") is True,\n3083|                )\n3084|            )\n3085|            self._send(\n3086|                502,\n3087|                {\n3088|                    \"error\": {\n3089|                        \"message\": _redact_secrets(err_msg),\n3090|                        \"detail\": _redact_secrets(detail)[:500],\n3091|                        \"type\": \"proxy_error\",\n3092|                        \"code\": 502,\n3093|                    }\n3094|                },\n3095|            )\n3096|            return\n3097|        if prune_res.status == \"pruned\":\n3098|            _log_context_prune(\n3099|                rid, model, \"proactive_prune\", 1, limit, target, prune_res\n3100|            )\n3101|\n3102|        prompt = prune_res.prompt\n3103|        current_est = prune_res.est_after\n3104|        reflected_prompts: list[str] = [prompt]\n3105|\n3106|        effort = _map_effort(req)\n3107|\n3108|        if req.get(\"stream\") is True and not self._sse_begin(model):\n3109|            return\n3110|        while not _slots.acquire(timeout=1.0):\n3111|            if self._client_gone or self._client_gone_probe():\n3112|                self._client_gone = True\n3113|                _log(\"client gone while waiting for a slot\")\n3114|                return\n3115|            if time.monotonic() >= _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3116|                _log(\"insufficient remaining budget while waiting for a slot\")\n3117|                self._send(\n3118|                    503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}}\n3119|                )\n3120|                return\n3121|        if self._client_gone or self._client_gone_probe():\n3122|            # Клиент ушёл на границе получения слота: ход без надзора не стартует.\n3123|            self._client_gone = True\n3124|            _log(\"client gone while waiting for a slot\")\n3125|            _slots.release()\n3126|            return\n3127|        if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3128|            _log(\"insufficient remaining budget after slot acquire\")\n3129|            _slots.release()\n3130|            self._send(503, {\"error\": {\"message\": \"bridge busy\", \"type\": \"overloaded\"}})\n3131|            return\n3132|        watch_stop = threading.Event()\n3133|        watcher = threading.Thread(\n3134|            target=self._watch_client, args=(watch_stop,), daemon=True\n3135|        )\n3136|        watcher.start()\n3137|        runs: list = []\n3138|        terminal_context_err: str | None = None\n3139|        context_retry_count = 0\n3140|        transient_retry_count = 0\n3141|        attempt_calls = [0]\n3142|        agg: dict[str, bool] = {\n3143|            \"approval_seen\": False,\n3144|            \"action\": False,\n3145|            \"allowing\": False,\n3146|            \"degraded\": False,\n3147|            \"observed\": False,\n3148|        }\n3149|\n3150|        def _update_agg(run: Any, out: dict[str, Any] | None) -> None:\n3151|            if run is not None:\n3152|                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n3153|                    getattr(run, \"approval_seen\", False)\n3154|                )\n3155|                agg[\"action\"] = agg[\"action\"] or bool(\n3156|                    getattr(run, \"action_possible\", False)\n3157|                )\n3158|                agg[\"allowing\"] = agg[\"allowing\"] or bool(\n3159|                    getattr(run, \"allowing_decide_attempted\", False)\n3160|                )\n3161|                agg[\"degraded\"] = agg[\"degraded\"] or bool(\n3162|                    getattr(run, \"approval_degraded\", False)\n3163|                )\n3164|                agg[\"observed\"] = agg[\"observed\"] or bool(\n3165|                    getattr(run, \"observed_barrier\", False)\n3166|                )\n3167|            if out:\n3168|                agg[\"approval_seen\"] = agg[\"approval_seen\"] or bool(\n3169|                    out.get(\"approval_seen\")\n3170|                )\n3171|                agg[\"action\"] = agg[\"action\"] or bool(out.get(\"action_possible\"))\n3172|                agg[\"allowing\"] = agg[\"allowing\"] or bool(out.get(\"allowing_decide\"))\n3173|                agg[\"degraded\"] = agg[\"degraded\"] or bool(out.get(\"approval_degraded\"))\n3174|                observed = out.get(\"observed_barrier\")\n3175|                if observed is None:\n3176|                    observed = bool(out.get(\"text\") or out.get(\"summaries\"))\n3177|                agg[\"observed\"] = agg[\"observed\"] or bool(observed)\n3178|\n3179|        def _can_start(is_exec: bool, *, context: bool = False) -> tuple[bool, str]:\n3180|            if self._client_gone or self._client_gone_probe():\n3181|                self._client_gone = True\n3182|                return False, \"client_gone\"\n3183|            if getattr(self, \"_content_started\", False):\n3184|                return False, \"content_started\"\n3185|            if getattr(self, \"_delivery_failed\", False):\n3186|                return False, \"delivery_failed\"\n3187|            if agg[\"degraded\"]:\n3188|                return False, \"approval_degraded\"\n3189|            if agg[\"approval_seen\"] or agg[\"allowing\"]:\n3190|                return False, \"approval_barrier\"\n3191|            if is_exec and APPROVAL_MODE == \"denyUnmatched\":\n3192|                return False, \"exec_fallback_disabled\"\n3193|            if runs and not all(getattr(r, \"dead_confirmed\", True) for r in runs):\n3194|                return False, \"group_not_dead\"\n3195|            if time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S:\n3196|                return False, \"insufficient_remaining\"\n3197|            if context or TRANSIENT_RETRY_SCOPE == \"observed-items\":\n3198|                if agg[\"observed\"]:\n3199|                    return False, \"observed_barrier\"\n3200|            elif agg[\"action\"]:\n3201|                return False, \"action_possible\"\n3202|            return True, \"\"\n3203|\n3204|        def _blocked_out(err: str) -> dict[str, Any]:\n3205|            return {\n3206|                \"rc\": 1,\n3207|                \"text\": \"\",\n3208|                \"chunks\": [],\n3209|                \"err\": err,\n3210|                \"state\": \"terminal_failed\",\n3211|                \"approval_seen\": agg[\"approval_seen\"],\n3212|                \"action_possible\": agg[\"action\"],\n3213|                \"approval_degraded\": agg[\"degraded\"],\n3214|                \"observed_barrier\": agg[\"observed\"],\n3215|                \"transient\": False,\n3216|            }\n3217|\n3218|        def run_attempt(\n3219|            attempt_prompt: str, *, context: bool = False\n3220|        ) -> tuple[dict[str, Any], str]:\n3221|            attempt_calls[0] += 1\n3222|            ok_gate, gate_reason = _can_start(False, context=context)\n3223|            if not ok_gate:\n3224|                _log(f\"new serve process blocked reason={gate_reason}\")\n3225|                return _blocked_out(f\"new process blocked: {gate_reason}\"), \"blocked\"\n3226|            serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n3227|            serve_run.exec_deadline = _exec_deadline\n3228|            serve_run.write_deadline = _write_deadline\n3229|            serve_run.request_deadline = _req_deadline\n3230|            if req.get(\"stream\") is True and self._sse_open:\n3231|                serve_run.live_sink = self._live_reasoning_sink\n3232|            runs.append(serve_run)\n3233|            self._current_run = serve_run\n3234|            try:\n3235|                attempt_out = serve_run.execute()\n3236|                _update_agg(serve_run, attempt_out)\n3237|                return attempt_out, \"serve\"\n3238|            except ServeUnavailable as exc:\n3239|                _update_agg(serve_run, None)\n3240|                if self.