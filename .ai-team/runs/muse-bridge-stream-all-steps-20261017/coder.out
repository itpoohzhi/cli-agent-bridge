entId\": snapshot.get(\"currentRequirementId\"),\n2027|                    \"sessionId\": snapshot.get(\"sessionId\") or session_id or \"\",\n2028|                },\n2029|                control=True,\n2030|            )\n2031|            pending[rid] = \"decide\"\n2032|\n2033|        def _latch_degradation(\n2034|            reason: str, snapshot: dict[str, Any] | None = None\n2035|        ) -> None:\n2036|            if self.approval_degraded:\n2037|                return\n2038|            self.approval_degraded = True\n2039|            now = time.monotonic()\n2040|            self.degraded_at = now\n2041|            grace_end = now + APPROVAL_CANCEL_GRACE_S\n2042|            if self.write_deadline != float(\"inf\"):\n2043|                grace_end = min(\n2044|                    grace_end, self.write_deadline - 2 * LIVE_WRITE_TIMEOUT_S\n2045|                )\n2046|            self.grace_end = grace_end\n2047|            _log(\n2048|                f\"approval_degraded reason={reason} approval_seen={int(self.approval_seen)} \"\n2049|                f\"action_possible={int(self.action_possible)} \"\n2050|                f\"barrier={int(self.observed_barrier)} tool_items={self.tool_item_count} \"\n2051|                f\"grace_s={max(0.0, grace_end - now):.2f}\"\n2052|            )\n2053|            snap = (\n2054|                snapshot\n2055|                if snapshot is not None\n2056|                else (last_snapshot[0] if last_snapshot else None)\n2057|            )\n2058|            try:\n2059|                deny = ApprovalPolicy.deny_choice(snap)\n2060|                if deny is not None and self.decide_count < MAX_APPROVAL_DECIDE:\n2061|                    _send_decide(snap or {}, deny, allowing=False)\n2062|                elif turn_id:\n2063|                    rid = self._send(\n2064|                        \"turn/cancel\",\n2065|                        {\n2066|                            \"commandId\": _uuid7(),\n2067|                            \"sessionId\": session_id or \"\",\n2068|                            \"turnId\": turn_id,\n2069|                        },\n2070|                        control=True,\n2071|                    )\n2072|                    pending[rid] = \"turn_cancel\"\n2073|            except ServeUnavailable as exc:\n2074|                _log(f\"approval degrade command failed: {exc}\")\n2075|\n2076|        def _handle_ack(msg: dict[str, Any]) -> None:\n2077|            raw_id = msg.get(\"id\")\n2078|            if not isinstance(raw_id, int):\n2079|                return\n2080|            kind = pending.pop(raw_id, None)\n2081|            if kind is None:\n2082|                return\n2083|            if \"error\" in msg:\n2084|                err = msg.get(\"error\") if isinstance(msg.get(\"error\"), dict) else {}\n2085|                code = err.get(\"code\")\n2086|                if kind == \"decide\" and code == -32051:\n2087|                    _log(\"approval decide benign -32051 already resolved\")\n2088|                    return\n2089|                if kind in (\"decide\", \"user_cancel\"):\n2090|                    _latch_degradation(f\"{kind}_error_{code}\")\n2091|                return\n2092|            result = msg.get(\"result\") if isinstance(msg.get(\"result\"), dict) else {}\n2093|            if result.get(\"terminal\") is False:\n2094|                _log(\"approval decide terminal=false awaiting updated request\")\n2095|\n2096|        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n2097|            while True:\n2098|                msg = read_msg(timeout_at)\n2099|                if \"method\" in msg:\n2100|                    self._handle_event(msg, None)\n2101|                    continue\n2102|                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n2103|                    if \"error\" in msg:\n2104|                        err = msg[\"error\"]\n2105|                        if isinstance(err, dict) and err.get(\"code\") == -32030:\n2106|                            self.ceiling_seen = True\n2107|                            _log(\n2108|                                f\"serve approval ceiling -32030 version={self.server_version} \"\n2109|                                \"warning approvalMode not applied\"\n2110|                            )\n2111|                        self.last_error_text = str(err)\n2112|                        raise ServeUnavailable(f\"serve RPC error: {err}\")\n2113|                    result = msg.get(\"result\")\n2114|                    return result if isinstance(result, dict) else {}\n2115|                _handle_ack(msg)\n2116|\n2117|        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n2118|            nonlocal final_text\n2119|            method = msg.get(\"method\")\n2120|            _raw_params = msg.get(\"params\")\n2121|            params: dict[str, Any] = (\n2122|                _raw_params if isinstance(_raw_params, dict) else {}\n2123|            )\n2124|            if method in (\n2125|                \"approval/request\",\n2126|                \"approval/requested\",\n2127|                \"userInput/request\",\n2128|            ):\n2129|                # a4: защёлки ДО receipt/дедупликации/политики, включая setup.\n2130|                self.approval_seen = True\n2131|                self.action_possible = True\n2132|                self.observed_barrier = True\n2133|                if self.approval_degraded:\n2134|                    _log(f\"approval after degraded ignored method={method}\")\n2135|                    return\n2136|                server_id = msg.get(\"id\")\n2137|                try:\n2138|                    if server_id is not None:\n2139|                        self._send_response(server_id, {})\n2140|                except ServeUnavailable:\n2141|                    _latch_degradation(\"receipt_write_failed\", params)\n2142|                    return\n2143|                if method == \"userInput/request\":\n2144|                    last_snapshot[:] = [params]\n2145|                    policy = ApprovalPolicy(APPROVAL_MODE)\n2146|                    _log(policy.evaluate_user_input(params)[\"audit\"])\n2147|                    if self.user_input_cancel_count >= MAX_USER_INPUT_CANCEL:\n2148|                        _latch_degradation(\"user_input_limit\", params)\n2149|                        return\n2150|                    self.user_input_cancel_count += 1\n2151|                    try:\n2152|                        rid = self._send(\n2153|                            \"userInput/cancel\",\n2154|                            {\n2155|                                \"commandId\": _uuid7(),\n2156|                                \"sessionId\": params.get(\"sessionId\")\n2157|                                or session_id\n2158|                                or \"\",\n2159|                                \"userInputId\": params.get(\"userInputId\"),\n2160|                            },\n2161|                            control=True,\n2162|                        )\n2163|                        pending[rid] = \"user_cancel\"\n2164|                    except ServeUnavailable:\n2165|                        _latch_degradation(\"user_input_write_failed\", params)\n2166|                    return\n2167|                pair = _pair_key(params)\n2168|                if pair in seen_pairs:\n2169|                    _log(\"approval duplicate suppressed\")\n2170|                    return\n2171|                seen_pairs.add(pair)\n2172|                last_snapshot[:] = [params]\n2173|                if self.decide_count >= MAX_APPROVAL_DECIDE:\n2174|                    _latch_degradation(\"decide_limit\", params)\n2175|                    return\n2176|                verdict = ApprovalPolicy(APPROVAL_MODE).evaluate(params)\n2177|                _log(f\"{verdict['audit']} n={self.decide_count + 1}\")\n2178|                if verdict[\"action\"] == \"approve\":\n2179|                    choice = next(\n2180|                        (\n2181|                            c\n2182|                            for c in ApprovalPolicy._choices(params)\n2183|                            if c.get(\"choiceId\") == verdict[\"choice_id\"]\n2184|                        ),\n2185|                        {\"choiceId\": verdict[\"choice_id\"]},\n2186|                    )\n2187|                    try:\n2188|                        _send_decide(params, choice, allowing=True)\n2189|                    except ServeUnavailable:\n2190|                        _latch_degradation(\"decide_write_failed\", params)\n2191|                elif verdict[\"action\"] == \"deny\":\n2192|                    _latch_degradation(\"no_approve_choice\", params)\n2193|                else:\n2194|                    _latch_degradation(\"no_choice\", params)\n2195|                return\n2196|            if method == \"turn/modelRetryScheduled\":\n2197|                _log(\n2198|                    \"turn modelRetryScheduled \"\n2199|                    f\"attempt={params.get('attempt')} maxAttempts={params.get('maxAttempts')} \"\n2200|                    f\"retryDelayMs={params.get('retryDelayMs')} \"\n2201|                    f\"errorKind={_render_audit_token(params.get('errorKind'))}\"\n2202|                )\n2203|                return\n2204|            if method in (\n2205|                \"approval/updated\",\n2206|                \"approval/resolved\",\n2207|                \"session/approvalModeChanged\",\n2208|                \"userInput/settled\",\n2209|            ):\n2210|                if method == \"approval/resolved\":\n2211|                    _log(\"approval resolved\")\n2212|                return\n2213|            if method in (\"item/started\", \"item/completed\"):\n2214|                raw_item = params.get(\"item\")\n2215|                item: dict[str, Any] = raw_item if isinstance(raw_item, dict) else {}\n2216|                iid = str(item.get(\"itemId\") or \"\")\n2217|                kind = str(item.get(\"kind\") or \"\")\n2218|                if iid:\n2219|                    kinds[iid] = kind\n2220|                if kind and kind not in (\"reasoning\", \"agentMessage\"):\n2221|                    self.observed_barrier = True\n2222|                    if iid:\n2223|                        tool_item_ids.add(iid)\n2224|                        self.tool_item_count = len(tool_item_ids)\n2225|                    _log(\n2226|                        f\"tool_item kind={_render_tool_token(kind)} \"\n2227|                        f\"tool={_render_tool_token(item.get('toolName'))}\"\n2228|                    )\n2229|                if method == \"item/completed\" and kind == \"reasoning\":\n2230|                    self._live_frozen = True\n2231|                if (\n2232|                    method == \"item/completed\"\n2233|                    and turn_id is not None\n2234|                    and item.get(\"turnId\") == turn_id\n2235|                ):\n2236|                    if kind == \"agentMessage\" and isinstance(item.get(\"text\"), str):\n2237|                        final_text = item[\"text\"]\n2238|                    if kind == \"reasoning\" and isinstance(item.get(\"summary\"), list):\n2239|                        summaries.extend(\n2240|                            str(p) for p in item[\"summary\"] if isinstance(p, str)\n2241|                        )\n2242|            elif method == \"item/delta\":\n2243|                iid = str(params.get(\"itemId\") or \"\")\n2244|                field = str(params.get(\"field\") or \"text\")\n2245|                piece = params.get(\"delta\")\n2246|                if not isinstance(piece, str) or not piece:\n2247|                    return\n2248|                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n2249|                    try:\n2250|                        idx = int(field.split(\".\", 1)[1])\n2251|                    except (IndexError, ValueError):\n2252| 