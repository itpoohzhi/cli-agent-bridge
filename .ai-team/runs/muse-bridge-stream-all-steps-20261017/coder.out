{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48d","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":161,"recorded_at":1780531400000317,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149ea716c76019fd706c3f2034af2","text":"Read text file `bridges/muse-bridge/server.py`.\n(1739 line(s) above)\n1740|            \"chunks\": chunks,\n1741|            \"err\": \"\\n\".join(err_lines[-6:]),\n1742|            \"state\": state,\n1743|            \"hard_threshold\": _has_hard_threshold_marker(err_lines, reason),\n1744|            \"action_possible\": self.action_possible,\n1745|            \"approval_seen\": False,\n1746|            \"observed_barrier\": bool(text),\n1747|            \"transient\": state != \"ok\" and _is_transient_text(err_lines, reason),\n1748|        }\n1749|\n1750|\n1751|class ServeRun:\n1752|    \"\"\"Один запрос через `muse serve` (MSP v1 по stdio, NDJSON JSON-RPC).\n1753|\n1754|    Поток: initialize -> notify initialized -> session/start\n1755|    (approvalMode из AD-001/AD-007; провайдер meta) -> turn/start\n1756|    (reasoningEffort=тир) -> ждём turn/completed; остаточные\n1757|    approval/userInput обрабатывает ApprovalPolicy в том же ходе (AD-002).\n1758|    Текст — из agentMessage (item/completed.text, fallback — item/delta);\n1759|    reasoning summaries — из reasoning-item (summary[] + item/delta\n1760|    field \"summary.N\"); токены — из session/tokenUsage (reasoningTokens\n1761|    включительно). Сырой reasoning-текст в v1 не стримится (только\n1762|    summaries) — ограничение протокола, не моста.\n1763|\n1764|    Транспортная неполадка до ACTION_POSSIBLE -> ServeUnavailable;\n1765|    допуск exec-fallback решает единый предикат Handler (AD-003).\n1766|    Ошибка самой модели\n1767|    (terminal != completed) — НЕ ServeUnavailable: ход реально выполнен,\n1768|    fallback лишь удвоил бы вызов.\n1769|    \"\"\"\n1770|\n1771|    def __init__(self, model_id: str, prompt: str, effort: str, workdir: Path) -> None:\n1772|        self.model_id = model_id\n1773|        self.prompt = prompt\n1774|        self.effort = effort\n1775|        self.workdir = workdir\n1776|        self.proc: subprocess.Popen | None = None\n1777|        self._rid = 0\n1778|        self._closed = False\n1779|        self._cleanup_lock = threading.Lock()\n1780|        self._handle_event: Any = None  # обработчик событий; ставится в execute\n1781|        self.dead_confirmed = (\n1782|            True  # False — группа не подтверждена мёртвой (карантин слота)\n1783|        )\n1784|        # Запись в stdin serve ограничена дедлайном (ставится в execute): зависший читатель\n1785|        # не держит слот бессрочно, при истечении ход завершается, группа убивается.\n1786|        self._write_until = float(\"inf\")\n1787|        # Барьеры и состояние approval/повторов (AD-002/AD-003, пакет a4).\n1788|        self.approval_seen = False\n1789|        self.action_possible = False\n1790|        self.allowing_decide_attempted = False\n1791|        self.approval_degraded = False\n1792|        self.degraded_at: float | None = None\n1793|        self.grace_end: float | None = None\n1794|        self.observed_barrier = False\n1795|        self.tool_item_count = 0\n1796|        self.decide_count = 0\n1797|        self.user_input_cancel_count = 0\n1798|        self.ceiling_seen = False\n1799|        self.server_version = \"?\"\n1800|        self.last_error_text = \"\"\n1801|        self.live_sink: Any = None\n1802|        self.exec_deadline = float(\"inf\")\n1803|        self.write_deadline = float(\"inf\")\n1804|        self.request_deadline = float(\"inf\")\n1805|        self.turn_started_at: float | None = None\n1806|        self._live_frozen = False\n1807|\n1808|    def close(self) -> None:\n1809|        \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n1810|        proc = self.proc\n1811|        if proc is None:\n1812|            return\n1813|        _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n1814|\n1815|    def _control_limit(self) -> float:\n1816|        limit = min(\n1817|            self._write_until,\n1818|            time.monotonic() + CONTROL_WRITE_TIMEOUT_S,\n1819|            self.exec_deadline,\n1820|        )\n1821|        if self.grace_end is not None:\n1822|            limit = min(limit, self.grace_end)\n1823|        return limit\n1824|\n1825|    def _write_bytes(self, data: bytes, limit: float) -> None:\n1826|        assert self.proc is not None and self.proc.stdin is not None\n1827|        try:\n1828|            fd = self.proc.stdin.fileno()\n1829|            view = memoryview(data)\n1830|            sent = 0\n1831|            while sent < len(data):\n1832|                remaining = limit - time.monotonic()\n1833|                if remaining <= 0:\n1834|                    raise ServeUnavailable(\n1835|                        \"serve stdin write timed out: child does not read\"\n1836|                    )\n1837|                _, writable, _ = select.select([], [fd], [], min(0.5, remaining))\n1838|                if not writable:\n1839|                    continue\n1840|                try:\n1841|                    sent += os.write(fd, view[sent:])\n1842|                except BlockingIOError:\n1843|                    continue\n1844|        except ServeUnavailable:\n1845|            raise\n1846|        except (OSError, ValueError) as exc:\n1847|            raise ServeUnavailable(f\"stdio write failed: {exc}\")\n1848|\n1849|    def _send(\n1850|        self,\n1851|        method: str,\n1852|        params: dict | None = None,\n1853|        notify: bool = False,\n1854|        *,\n1855|        control: bool = False,\n1856|    ) -> int:\n1857|        self._rid += 1\n1858|        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"method\": method}\n1859|        if not notify:\n1860|            msg[\"id\"] = self._rid\n1861|        if params is not None:\n1862|            msg[\"params\"] = params\n1863|        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n1864|        self._write_bytes(data, self._control_limit() if control else self._write_until)\n1865|        return self._rid\n1866|\n1867|    def _send_response(self, server_id: Any, result: dict) -> None:\n1868|        \"\"\"Receipt по серверному id дословно (AD-002).\"\"\"\n1869|        msg: dict[str, Any] = {\"jsonrpc\": \"2.0\", \"id\": server_id, \"result\": result}\n1870|        data = (json.dumps(msg, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n1871|        self._write_bytes(data, self._control_limit())\n1872|\n1873|    def _note_allowing_decide(self) -> None:\n1874|        \"\"\"Защёлкивание ДО первой попытки записи разрешающего decide (a4).\"\"\"\n1875|        self.allowing_decide_attempted = True\n1876|        self.action_possible = True\n1877|\n1878|    def execute(self) -> dict[str, Any]:\n1879|        if not os.access(MUSE_WRAPPER, os.X_OK):\n1880|            raise ServeUnavailable(f\"muse wrapper not executable: {MUSE_WRAPPER}\")\n1881|        self.workdir.mkdir(parents=True, exist_ok=True)\n1882|        env = dict(os.environ)\n1883|        env.setdefault(\n1884|            \"PATH\",\n1885|            \"/Users/aazhiry1/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin\",\n1886|        )\n1887|        env.pop(\"META_API_KEY\", None)\n1888|        cmd = [\n1889|            MUSE_WRAPPER,\n1890|            \"serve\",\n1891|            \"--provider\",\n1892|            \"meta\",\n1893|            \"--model\",\n1894|            self.model_id,\n1895|            \"--no-session-log\",\n1896|            \"--trust-workspace\",\n1897|            *_cli_permission_flags(),\n1898|        ]\n1899|        try:\n1900|            self.proc = subprocess.Popen(\n1901|                cmd,\n1902|                cwd=str(self.workdir),\n1903|                env=env,\n1904|                stdin=subprocess.PIPE,\n1905|                stdout=subprocess.PIPE,\n1906|                stderr=subprocess.PIPE,\n1907|                text=True,\n1908|                encoding=\"utf-8\",\n1909|                errors=\"replace\",\n1910|                bufsize=1,\n1911|                start_new_session=True,\n1912|            )\n1913|        except OSError as exc:\n1914|            raise ServeUnavailable(f\"serve spawn failed: {exc}\")\n1915|        assert self.proc.stdout is not None and self.proc.stdin is not None\n1916|        # stdin неблокирующий: запись идёт срезами с дедлайном (см. _send).\n1917|        os.set_blocking(self.proc.stdin.fileno(), False)\n1918|\n1919|        err_lines: list[str] = []\n1920|        turn_diag_lines: list[str] = []\n1921|        stderr_joined = False\n1922|\n1923|        def drain_stderr() -> None:\n1924|            try:\n1925|                assert self.proc is not None and self.proc.stderr is not None\n1926|                for line in self.proc.stderr:\n1927|                    line = line.strip()\n1928|                    if line:\n1929|                        err_lines.append(line)\n1930|            except (OSError, ValueError):\n1931|                pass\n1932|\n1933|        err_thread = threading.Thread(target=drain_stderr, daemon=True)\n1934|        err_thread.start()\n1935|        _now0 = time.monotonic()\n1936|        _exec_dl = self.exec_deadline\n1937|        deadline = (\n1938|            min(_now0 + TIMEOUT_S, _exec_dl)\n1939|            if _exec_dl != float(\"inf\")\n1940|            else _now0 + TIMEOUT_S\n1941|        )\n1942|        if self.exec_deadline == float(\"inf\"):\n1943|            self.exec_deadline = deadline\n1944|        setup_deadline = min(_now0 + SERVE_SPAWN_TIMEOUT_S, deadline)\n1945|        self._write_until = setup_deadline\n1946|\n1947|        # Чтение stdout serve — собственным буфером поверх os.read: select по fd не видит строки,\n1948|        # уже вычитанные в буфер TextIOWrapper (пачка строк за один write зависала бы).\n1949|        rbuf = bytearray()\n1950|\n1951|        def read_msg(timeout_at: float) -> dict[str, Any]:\n1952|            while time.monotonic() < timeout_at:\n1953|                if self.proc is None or self.proc.stdout is None:\n1954|                    raise ServeUnavailable(\"serve stdout closed\")\n1955|                newline = rbuf.find(b\"\\n\")\n1956|                if newline < 0:\n1957|                    _remain = max(0.0, timeout_at - time.monotonic())\n1958|                    ready, _, _ = select.select(\n1959|                        [self.proc.stdout], [], [], min(0.5, _remain)\n1960|                    )\n1961|                    if not ready:\n1962|                        if self.proc.poll() is not None:\n1963|                            raise ServeUnavailable(\n1964|                                f\"serve exited rc={self.proc.returncode}: \"\n1965|                                + \" \".join(err_lines[-3:])\n1966|                            )\n1967|                        continue\n1968|                    chunk = os.read(self.proc.stdout.fileno(), 65536)\n1969|                    if not chunk:\n1970|                        raise ServeUnavailable(\n1971|                            f\"serve stdout EOF rc={self.proc.poll()}: \"\n1972|                            + \" \".join(err_lines[-3:])\n1973|                        )\n1974|                    rbuf.extend(chunk)\n1975|                    continue\n1976|                line = bytes(rbuf[:newline]).decode(\"utf-8\", \"replace\").strip()\n1977|                del rbuf[: newline + 1]\n1978|                if not line:\n1979|                    continue\n1980|                try:\n1981|                    msg = json.loads(line)\n1982|                except ValueError:\n1983|           