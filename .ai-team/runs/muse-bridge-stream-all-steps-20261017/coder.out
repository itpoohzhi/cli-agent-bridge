In(\"tool_item\", logs)\n3393|        self.assertIn(\"web_search\", logs)\n3394|        self.assertIn(\"tool_items=1\", logs)\n3395|        self.assertIn(\"ttft=1\", logs)\n3396|        self.assertNotIn(canary, logs)\n3397|\n3398|    def test_t_a16_setup_approval_blocks_any_new_process(self) -> None:\n3399|        for when in (\"initialize\", \"session/start\"):\n3400|            for req_mode in (\"request\", \"requested\"):\n3401|                with self.subTest(when=when, mode=req_mode):\n3402|                    plan = {\n3403|                        \"setup_approval\": {\n3404|                            \"when\": when,\n(more lines below)","final_result":true}}}
