{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5af","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":306,"recorded_at":1780531400000607,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149eb-df02-7030-bf07-df28bd162de1"},"task_id":"01a149eb-df02-7030-bf07-df28bd162de1","event":{"kind":"output","task_id":"01a149eb-df02-7030-bf07-df28bd162de1","chunk":"Read text file `tests/test_muse_bridge_killpg.py`.\n(1079 line(s) above)\n1080|        fh.write(json.dumps(msg) + \"\\\\n\")\n1081|    return msg\n1082|_decide_i = [0]\n1083|def decide_reply(rid):\n1084|    reps = plan.get(\"decide_replies\") or [{\"result\": {\"terminal\": True}}]\n1085|    rep = reps[min(_decide_i[0], len(reps) - 1)]; _decide_i[0] += 1\n1086|    if \"error\" in rep: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"error\": rep[\"error\"]})\n1087|    else: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": rep.get(\"result\", {})})\n1088|def cancel_reply(rid):\n1089|    rep = plan.get(\"cancel_reply\") or {}\n1090|    if \"error\" in rep: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"error\": rep[\"error\"]})\n1091|    else: send({\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": rep.get(\"result\", {})})\n1092|def await_command():\n1093|    while True:\n1094|        msg = read_msg(); m = msg.get(\"method\")\n1095|        if m == \"approval/decide\": decide_reply(msg[\"id\"]); return msg\n1096|        if m in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"]); return msg\n1097|def appr_payload(over=None, n=0):\n1098|    aid = \"appr-%d\" % n\n1099|    base = {\"approvalId\": aid, \"availableChoices\": [\n1100|        {\"choiceId\": \"c-approve\", \"decision\": \"approved\", \"label\": \"Allow\", \"scope\": \"once\"},\n1101|        {\"choiceId\": \"c-abort\", \"decision\": \"abort\", \"label\": \"Abort\", \"scope\": \"once\"}],\n1102|        \"currentRequirementId\": {\"approvalId\": aid, \"sourceIndex\": n}, \"itemId\": \"item-1\",\n1103|        \"judgeEscalated\": False, \"protectedWrite\": False, \"rawArgs\": \"{}\", \"sessionId\": \"sess-1\",\n1104|        \"sourceRange\": {}, \"subject\": {\"kind\": \"tool\", \"toolName\": \"web_search\"}, \"taskId\": \"task-1\",\n1105|        \"toolCallId\": \"tc-1\", \"toolName\": \"web_search\", \"turnId\": \"turn-1\", \"viewCursor\": \"0\"}\n1106|    if over: base.update(over)\n1107|    return base\n1108|def do_approval(over=None, req_mode=\"request\", n=0):\n1109|    payload = appr_payload(over, n)\n1110|    if req_mode == \"requested\":\n1111|        send({\"jsonrpc\": \"2.0\", \"method\": \"approval/requested\", \"params\": payload})\n1112|    else:\n1113|        send({\"jsonrpc\": \"2.0\", \"id\": 9000 + n, \"method\": \"approval/request\", \"params\": payload})\n1114|    return await_command()\n1115|def ui_payload(over=None, n=0):\n1116|    base = {\"userInputId\": \"ui-%d\" % n, \"sessionId\": \"sess-1\", \"toolName\": \"ask_user\",\n1117|            \"itemId\": \"item-1\", \"toolCallId\": \"tc-1\", \"turnId\": \"turn-1\", \"viewCursor\": \"0\",\n1118|            \"sourceRange\": {}, \"questions\": [{\"questionId\": \"q1\", \"text\": \"question\"}]}\n1119|    if over: base.update(over)\n1120|    return base\n1121|def do_user_input(over=None, n=0):\n1122|    send({\"jsonrpc\": \"2.0\", \"id\": 9100 + n, \"method\": \"userInput/request\", \"params\": ui_payload(over, n)})\n1123|    return await_command()\n1124|\"\"\"\n1125|\n1126|_FAKE_MSP_TAIL = \"\"\"_started = set()\n1127|def ensure_item(kind):\n1128|    iid = \"r1\" if kind == \"reasoning\" else \"a1\" if kind == \"agentMessage\" else \"t1\"\n1129|    if iid not in _started:\n1130|        _started.add(iid)\n1131|        send({\"jsonrpc\": \"2.0\", \"method\": \"item/started\", \"params\": {\"item\": {\"itemId\": iid, \"turnId\": \"turn-1\", \"kind\": kind}}})\n1132|    return iid\n1133|def run_steps():\n1134|    for step in plan.get(\"steps\") or []:\n1135|        if \"delay\" in step: time.sleep(float(step[\"delay\"]))\n1136|        elif \"effect\" in step: effect(step[\"effect\"])\n1137|        elif \"approval\" in step: do_approval(step[\"approval\"] if isinstance(step[\"approval\"], dict) else None, step.get(\"mode\", \"request\"), int(step.get(\"n\", 0)))\n1138|        elif \"approval_repeat\" in step:\n1139|            for i in range(int(step[\"approval_repeat\"])): do_approval(None, \"request\", i)\n1140|        elif \"approval_nowait\" in step:\n1141|            over = step[\"approval_nowait\"] if isinstance(step[\"approval_nowait\"], dict) else None\n1142|            n = int(step.get(\"n\", 7))\n1143|            send({\"jsonrpc\": \"2.0\", \"id\": 9200 + n, \"method\": \"approval/request\", \"params\": appr_payload(over, n)})\n1144|        elif \"approval_then_exit\" in step:\n1145|            over = step[\"approval_then_exit\"] if isinstance(step[\"approval_then_exit\"], dict) else None\n1146|            send({\"jsonrpc\": \"2.0\", \"id\": 9300, \"method\": \"approval/request\", \"params\": appr_payload(over, 0)})\n1147|            sys.stdout.flush(); os._exit(0)\n1148|        elif \"user_input\" in step: do_user_input(step[\"user_input\"] if isinstance(step[\"user_input\"], dict) else None, int(step.get(\"n\", 0)))\n1149|        elif \"user_input_repeat\" in step:\n1150|            for i in range(int(step[\"user_input_repeat\"])): do_user_input(None, i)\n1151|        elif \"summary\" in step:\n1152|            ensure_item(\"reasoning\")\n1153|            sidx, text = step[\"summary\"]\n1154|            send({\"jsonrpc\": \"2.0\", \"method\": \"item/delta\", \"params\": {\"itemId\": \"r1\", \"field\": \"summary.%s\" % sidx, \"delta\": text}})\n1155|        elif \"reasoning_completed\" in step:\n1156|            ensure_item(\"reasoning\")\n1157|            send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"r1\", \"turnId\": \"turn-1\", \"kind\": \"reasoning\", \"summary\": list(step[\"reasoning_completed\"])}}})\n1158|        elif \"tool_item\" in step:\n1159|            ti = step[\"tool_item\"] if isinstance(step[\"tool_item\"], dict) else {}\n1160|            item = {\"itemId\": \"t1\", \"turnId\": \"turn-1\", \"kind\": ti.get(\"kind\", \"toolCall\"), \"toolName\": ti.get(\"toolName\", \"web_search\"), \"rawArgs\": ti.get(\"rawArgs\", \"{}\")}\n1161|            send({\"jsonrpc\": \"2.0\", \"method\": \"item/started\", \"params\": {\"item\": item}})\n1162|            send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": item}})\n1163|        elif \"model_retry\" in step:\n1164|            send({\"jsonrpc\": \"2.0\", \"method\": \"turn/modelRetryScheduled\", \"params\": dict(step[\"model_retry\"])})\n1165|        elif \"text_delta\" in step:\n1166|            ensure_item(\"agentMessage\")\n1167|            send({\"jsonrpc\": \"2.0\", \"method\": \"item/delta\", \"params\": {\"itemId\": \"a1\", \"field\": \"text\", \"delta\": step[\"text_delta\"]}})\n1168|        elif \"eof\" in step:\n1169|            sys.stdout.flush(); os._exit(0)\n1170|        elif \"hang\" in step:\n1171|            while True:\n1172|                msg = read_msg(); m = msg.get(\"method\")\n1173|                if m == \"approval/decide\": decide_reply(msg[\"id\"])\n1174|                elif m in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"])\n1175|        elif \"no_read_hang\" in step:\n1176|            while True: time.sleep(1)\n1177|        elif \"terminal\" in step:\n1178|            t = step[\"terminal\"] if isinstance(step[\"terminal\"], dict) else {}\n1179|            if t.get(\"text\"):\n1180|                ensure_item(\"agentMessage\")\n1181|                send({\"jsonrpc\": \"2.0\", \"method\": \"item/completed\", \"params\": {\"item\": {\"itemId\": \"a1\", \"turnId\": \"turn-1\", \"kind\": \"agentMessage\", \"text\": t[\"text\"]}}})\n1182|            params = {\"turnId\": \"turn-1\", \"sessionId\": \"sess-1\", \"terminal\": t.get(\"terminal\", \"completed\")}\n1183|            for key in (\"error\", \"reason\", \"timeToFirstTokenMs\", \"usage\", \"durationMs\"):\n1184|                if key in t: params[key] = t[key]\n1185|            send({\"jsonrpc\": \"2.0\", \"method\": \"turn/completed\", \"params\": params})\n1186|            return\n1187|def maybe_setup(when):\n1188|    sa = plan.get(\"setup_approval\")\n1189|    if not sa or sa.get(\"when\") != when: return False\n1190|    do_approval(sa.get(\"payload\") if isinstance(sa.get(\"payload\"), dict) else None, sa.get(\"mode\", \"request\"), 0)\n1191|    if sa.get(\"effect\"): effect(sa[\"effect\"])\n1192|    return sa.get(\"after\") == \"break\"\n1193|try:\n1194|    while True:\n1195|        msg = read_msg(); method = msg.get(\"method\")\n1196|        if method == \"initialize\":\n1197|            if maybe_setup(\"initialize\"):\n1198|                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": {\"code\": -32603, \"message\": plan.get(\"setup_approval\", {}).get(\"break_message\", \"[net-timeout] setup break\")}}); break\n1199|            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"serverInfo\": {\"version\": \"1.4.9-test\"}, \"schema\": {\"fingerprint\": \"fp-test-1234567890abcdef\"}}})\n1200|        elif method == \"session/start\":\n1201|            if maybe_setup(\"session/start\"):\n1202|                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": {\"code\": -32603, \"message\": plan.get(\"setup_approval\", {}).get(\"break_message\", \"[net-timeout] setup break\")}}); break\n1203|            if plan.get(\"setup_delay\"): time.sleep(float(plan[\"setup_delay\"]))\n1204|            se = plan.get(\"session_error\")\n1205|            if se:\n1206|                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"error\": se}); break\n1207|            if plan.get(\"no_session_id\"):\n1208|                send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"session\": {}}}); continue\n1209|            reqmode = (msg.get(\"params\") or {}).get(\"approvalMode\") or \"allowAll\"\n1210|            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"session\": {\"sessionId\": \"sess-1\", \"approvalMode\": {\"mode\": reqmode, \"source\": \"startup\", \"lastCommandId\": None}}}})\n1211|        elif method == \"turn/start\":\n1212|            if plan.get(\"turn_start_eof\"): os._exit(0)\n1213|            if plan.get(\"turn_delay\"): time.sleep(float(plan[\"turn_delay\"]))\n1214|            send({\"jsonrpc\": \"2.0\", \"id\": msg[\"id\"], \"result\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"}})\n1215|            run_steps(); break\n1216|        elif method == \"approval/decide\": decide_reply(msg[\"id\"])\n1217|        elif method in (\"userInput/cancel\", \"turn/cancel\"): cancel_reply(msg[\"id\"])\n1218|except EOFError:\n1219|    pass\n1220|finally:\n1221|    if active_file is not None:\n1222|        try: active_file.unlink()\n1223|        except OSError: pass\n1224|\"\"\"\n1225|\n1226|FAKE_MSP_SCRIPT = _FAKE_MSP_HEAD + _FAKE_MSP_TAIL\n1227|\n1228|_OK_STEP = {\"terminal\": {\"terminal\": \"completed\", \"text\": \"hello\"}}\n1229|\n1230|\n1231|def ok_plan(*steps: dict) -> dict:\n1232|    \"\"\"План serve, завершающийся успешным hello после шагов.\"\"\"\n1233|    return {\"steps\": [*steps, _OK_STEP]}\n1234|\n1235|\n1236|def fail_terminal(marker: str, **extra: Any) -> dict:\n1237|    \"\"\"Шаг транзиентного терминального провала serve.\"\"\"\n1238|    term: dict[str, Any] = {\n1239|        \"terminal\": \"failed\",\n1240|        \"error\": {\"kind\": \"network\", \"message\": marker},\n1241|    }\n1242|    term.update(extra)\n1243|    return {\"terminal\": term}\n1244|\n1245|\n1246|def install_fake_msp(\n1247|    scenario: Any,\n1248|    serve_plans: list[dict] | None = None,\n1249|    exec_plans: list[dict] | None = None,\n1250|    track_concurrency: bool = False,\n1251|) -> None:\n1252|    \"\"\"Расширенный фейковый MSP (a4): планы по вызовам, rpc.jsonl, счётчики.\"\"\"\n1253|    import shlex\n1254|\n1255|    for name in (\n1256|        \"rpc.jsonl\",\n1257|        \"effects.log\",\n1258|        \"serve-count.txt\",\n1259|        \"exec-count.txt\",\n1260|        \"serve-argv.jsonl\",\n1261|        \"exec-argv.jsonl\",\n1262|        \"serve-pids.log\",\n1263|        \"concurrency.log\",\n1264|    ):\n1265|        try:\n1266|            (scenario.tmp / name).unlink()\n1267|        except OSError:\n1268|            pass\n1269|    cfg = {\n1270|        \"root\": str(scenario.tmp),\n1271|        \"serve_plans\": serve_plans or [ok_plan()],\n1272|        \"exec_plans\": exec_plans or [{\"text\": \"fallback-ok\"}],\n1273|        \"track_concurrency\": track_concurrency,\n1274|    }\n1275|    cfg_path = scenario.tmp / \"fake-cfg.json\"\n1276|    cfg_path.write_text(json.dumps(cfg), encoding=\"utf-8\")\n1277|    script = scenario.tmp / \"fake_msp.py\"\n1278|    script.write_text(FAKE_MSP_SCRIPT, encoding=\"utf-8\")\n1279|    wrapper = scenario.tmp / \"muse-cli.sh\"\n1280|    wrapper.write_text(\n1281|        f\"#!/bin/sh\\nexec {shlex.quote(sys.executable)} {shlex.quote(str(script))} \"\n1282|        f'{shlex.quote(str(cfg_path))} \"$@\"\\n',\n1283|        encoding=\"utf-8\",\n1284|    )\n1285|    wrapper.chmod(0o755)\n1286|    scenario.mod.MUSE_WRAPPER = str(wrapper)\n1287|\n1288|\n1289|def rpc_msgs(scenario: Any) -> list[dict]:\n1290|    \"\"\"Все входящие RPC фейка (мост -> serve), включая receipt-ответы.\"\"\"\n1291|    path = scenario.tmp / \"rpc.jsonl\"\n1292|    if not path.exists():\n1293|        return []\n1294|    return [\n1295|        json.loads(line)\n1296|        for line in path.read_text(encoding=\"utf-8\").splitlines()\n1297|        if line.strip()\n1298|    ]\n1299|\n1300|\n1301|def rpc_by_method(scenario: Any, method: str) -> list[dict]:\n1302|    return [m for m in rpc_msgs(scenario) if m.get(\"method\") == method]\n1303|\n1304|\n1305|def proc_count(scenario: Any, mode: str) -> int:\n1306|    \"\"\"Число запусков serve/exec по argv-журналу фейка.\"\"\"\n1307|    path = scenario.tmp / f\"{mode}-argv.jsonl\"\n1308|    if not path.exists():\n1309|        return 0\n1310|    return len(\n1311|        [ln for ln in path.read_text(encoding=\"utf-8\").splitlines() if ln.strip()]\n1312|    )\n1313|\n1314|\n1315|def effect_lines(scenario: Any) -> list[str]:\n1316|    path = scenario.tmp / \"effects.log\"\n1317|    if not path.exists():\n1318|        return []\n1319|    return [ln for ln in path.read_text(encoding=\"utf-8\").splitlines() if ln.strip()]\n1320|\n1321|\n1322|def sse_frames(body: bytes) -> list[dict]:\n1323|    return [\n1324|        json.loads(line[6:])\n1325|        for line in body.decode(\"utf-8\", \"replace\").splitlines()\n1326|        if line.startswith(\"data: {\")\n1327|    ]\n1328|\n1329|\n1330|def sse_deltas(body: bytes, key: str) -> list[str]:\n1331|    out: list[str] = []\n1332|    for frame in sse_frames(body):\n1333|        for choice in frame.get(\"choices\") or []:\n1334|            delta = choice.get(\"delta\") or {}\n1335|            if isinstance(delta.get(key), str):\n1336|                out.append(delta[key])\n1337|    return out\n1338|\n1339|\n1340|class ServeTurnErrorExtractionTest(_BridgeScenario):\n1341|    \"\"\"AD-002: приоритет, защитный разбор и точные лимиты терминальной причины.\"\"\"\n1342|\n1343|    def _execute(self, params: dict, noise: bool = False) -> dict:\n1344|        install_protocol_wrapper(self, params, noise)\n1345|        return self.mod.ServeRun(\n1346|            \"muse-spark-1.3\", \"p\", \"max\", self.tmp / \"workspace\"\n1347|        ).execute()\n1348|\n1349|    def test_r2_prompt_parts_redacted_before_and_after_normalization(self) -> None:\n1350|        content = \"private-owner-content-\" + \"Q\" * 220\n1351|        prompt = \"User: \" + content + \"\\n\\nAssistant: prior\\tprivate\\nSystem: hi\"\n1352|        parts = self.mod._prompt_reflected_parts(prompt)\n1353|        self.assertEqual(parts, sorted(parts, key=len, reverse=True))\n1354|        self.assertIn(content, parts)\n1355|        self.assertIn(\"prior\\tprivate\", parts)\n1356|        self.assertNotIn(\"hi\", parts)\n1357|        for reflected in (content, \"prior\\tprivate\", \"prior private\"):\n1358|            with self.subTest(reflected=reflected):\n1359|                diagnostic = self.mod._turn_diagnostics(\n(more lines below)","final_result":true}}}
