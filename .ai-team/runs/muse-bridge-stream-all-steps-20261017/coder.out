{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c807","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":606,"recorded_at":1780531400001207,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ef-a9a8-7e11-a2da-2f0b3183a48f"},"task_id":"01a149ef-a9a8-7e11-a2da-2f0b3183a48f","event":{"kind":"output","task_id":"01a149ef-a9a8-7e11-a2da-2f0b3183a48f","chunk":"edited\nchanged lines: lines 2375-2396\n--- original\n+++ updated\n@@\n-                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n-                    try:\n-                        idx = int(field.split(\".\", 1)[1])\n-                    except (IndexError, ValueError):\n-                        idx = len(summary_parts)\n-                    if not first_summary_logged[0]:\n-                        first_summary_logged[0] = True\n-                        _t0 = self.turn_started_at or _now0\n-                        _log(\n-                            f\"first summary delta idx={idx} \"\n-                            f\"after_s={time.monotonic() - _t0:.2f}\"\n-                        )\n-                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n-                    if idx > 0:\n-                        self._live_frozen = True\n-                    elif not self._live_frozen and self.live_sink is not None:\n-                        try:\n-                            delivered = bool(self.live_sink(summary_parts.get(0, \"\")))\n-                        except Exception:  # noqa: BLE001, S112\n-                            delivered = False\n-                        if not delivered:\n-                            self._live_frozen = True\n+                if kinds.get(iid) == \"reasoning\" and field.startswith(\"summary\"):\n+                    try:\n+                        idx = int(field.split(\".\", 1)[1])\n+                    except (IndexError, ValueError):\n+                        with self._acc_lock:\n+                            idx = len(\n+                                [k for k in self._reasoning_items if k[0] == iid]\n+                            )\n+                    if not first_summary_logged[0]:\n+                        first_summary_logged[0] = True\n+                        _t0 = self.turn_started_at or _now0\n+                        _log(\n+                            f\"first summary delta idx={idx} \"\n+                            f\"after_s={time.monotonic() - _t0:.2f}\"\n+                        )\n+                    summary_parts[idx] = summary_parts.get(idx, \"\") + piece\n+                    # AD-001: заморозки нет — все summary.0..N стримятся\n+                    # непрерывно; сбой live-записи ход не останавливает (S1).\n+                    self._accumulate_reasoning(iid, idx, piece)\n+                    self._emit_live()\n","final_result":true}}}
