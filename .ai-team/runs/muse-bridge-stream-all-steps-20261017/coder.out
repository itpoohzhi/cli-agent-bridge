                       )\n3357|                        terminal_context_err = (\n3358|                            f\"mandatory context exceeds budget \"\n3359|                            f\"(est_tokens={retry_res.mandatory_est}, limit={retry_target})\"\n3360|                        )\n3361|                        break\n3362|                    if retry_res.est_after >= current_est or (\n3363|                        time.monotonic() > _exec_deadline - MIN_ATTEMPT_REMAINING_S\n3364|                    ):\n3365|                        _log_context_prune(\n3366|                            rid,\n3367|                            model,\n3368|                            \"refused_retry\",\n3369|                            2,\n3370|                            limit,\n3371|                            retry_target,\n3372|                            retry_res,\n3373|                        )\n3374|                        terminal_context_err = (\n3375|                            \"context hard threshold exceeded after single \"\n3376|                            f\"compaction retry (est_tokens={retry_res.est_after}, \"\n3377|                            f\"target={retry_target})\"\n3378|                        )\n3379|                        break\n3380|                    if self._client_gone or self._client_gone_probe():\n3381|                        self._client_gone = True\n3382|                        break\n3383|                    context_retry_count = 1\n3384|                    _log_context_prune(\n3385|                        rid,\n3386|                        model,\n3387|                        \"hard_threshold_retry\",\n3388|                        2,\n3389|                        limit,\n3390|                        retry_target,\n3391|                        retry_res,\n3392|                    )\n3393|                    prompt = retry_res.prompt\n3394|                    current_est = retry_res.est_after\n3395|                    reflected_prompts.append(prompt)\n3396|                    out, via = run_attempt(prompt, context=True)\n3397|                    raw_err_2 = str(out.get(\"err\") or \"\")\n3398|                    if (\n3399|                        out.get(\"rc\") != 0\n3400|                        and out.get(\"state\") == \"terminal_failed\"\n3401|                        and (\n3402|                            bool(out.get(\"hard_threshold\"))\n3403|                            or HARD_THRESHOLD_ERR_SUBSTR in raw_err_2\n3404|                        )\n3405|                    ):\n3406|                        terminal_context_err = (\n3407|                            \"context hard threshold exceeded after single \"\n3408|                            f\"compaction retry (est_tokens={current_est}, \"\n3409|                            f\"target={retry_target})\"\n3410|                        )\n3411|                    continue\n3412|                is_transient = (\n3413|                    out.get(\"rc\") != 0\n3414|                    and str(out.get(\"state\") or \"\") not in NON_RETRYABLE_STATES\n3415|                    and (bool(out.get(\"transient\")) or _is_transient_text(raw_err))\n3416|                )\n3417|                max_calls = 4 if context_retry_count else 3\n3418|                if (\n3419|                    not is_transient\n3420|                    or transient_retry_count >= TRANSIENT_MAX_RETRIES\n3421|                    or attempt_calls[0] >= max_calls\n3422|                ):\n3423|                    if is_transient and getattr(self, \"_content_started\", False):\n3424|                        _log(\"retry_blocked reason=content_started\")\n3425|                    break\n3426|                for run in runs:\n3427|                    run.close()\n3428|                ok_retry, retry_reason = _can_start(False)\n3429|                if not ok_retry:\n3430|                    if getattr(self, \"_content_started\", False):\n3431|                        _log(f\"retry_blocked reason={retry_r