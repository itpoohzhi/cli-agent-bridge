   _log(\n2294|                f\"serve init server={self.server_version} \"\n2295|                f\"schema_fp={str(schema.get('fingerprint', ''))[:19]}\"\n2296|            )\n2297|            if self.approval_degraded:\n2298|                raise ServeUnavailable(\"serve approval degraded during setup\")\n2299|            self._send(\"initialized\", {}, notify=True)\n2300|            sess_rid = self._send(\n2301|                \"session/start\",\n2302|                {\n2303|                    \"commandId\": _uuid7(),\n2304|                    \"workspaceRoot\": str(self.workdir),\n2305|                    \"providerId\": \"meta\",\n2306|                    \"modelId\": self.model_id,\n2307|                    \"approvalMode\": APPROVAL_MODE,\n2308|                },\n2309|            )\n2310|            sess = await_result(sess_rid, setup_deadline)\n2311|            session = (\n2312|                sess.get(\"session\") if isinstance(sess.get(\"session\"), dict) else {}\n2313|            )\n2314|            session_id = str(session.get(\"sessionId\") or \"\")\n2315|            if not session_id:\n2316|                raise ServeUnavailable(\"session/start gave no sessionId\")\n2317|            _eff = session.get(\"approvalMode\")\n2318|            if isinstance(_eff, dict):\n2319|                _eff_mode = str(_eff.get(\"mode\") or APPROVAL_MODE)\n2320|            elif isinstance(_eff, str) and _eff:\n2321|                _eff_mode = _eff\n2322|            else:\n2323|                _eff_mode = APPROVAL_MODE\n2324|            _log(f\"serve session approvalMode={_eff_mode}\")\n2325|            if self.approval_degraded:\n2326|                raise ServeUnavailable(\"serve approval degraded during setup\")\n2327|            tier = _MSP_EFFORT.get(self.effort, \"max\")\n2328|            # ACTION_POSSIBLE защёлкивается ДО первого байта turn/start (a3/a4).\n2329|            self.action_possible = True\n2330|            turn_rid = self._send(\n2331|                \"turn/start\",\n2332|                {\n2333|                    \"commandId\": _uuid7(),\n2334|                    \"sessionId\": session_id,\n2335|                    \"reasoningEffort\": tier,\n2336|                    \"input\": [{\"type\": \"text\", \"text\": self.prompt}],\n2337|                },\n2338|            )\n2339|            self._write_until = deadline\n2340|            self.turn_started_at = time.monotonic()\n2341|            turn = await_result(turn_rid, setup_deadline)\n2342|            if turn.get(\"status\") != \"accepted\":\n2343|                raise ServeUnavailable(f\"turn/start not accepted: {turn}\")\n2344|            turn_id = str(turn.get(\"turnId\") or \"\")\n2345|            _log(\n2346|                f\"serve turn session={session_id[:8]} turn={turn_id[:8]} effort={tier}\"\n2347|            )\n2348|            terminal: str | None = None\n2349|            hard_threshold = False\n2350|            while True:\n2351|                _limit = (\n2352|                    self.grace_end\n2353|                    if self.approval_degraded and self.grace_end is not None\n2354|                    else deadline\n2355|                )\n2356|                if time.monotonic() >= _limit:\n2357|                    if self.approval_degraded:\n2358|                        break\n2359|                    raise ServeUnavailable(\"serve turn deadline exceeded\")\n2360|                try:\n2361|                    msg = read_msg(_limit)\n2362|                except ServeUnavailable:\n2363|                    if self.approval_degraded:\n2364|                        break  # EOF после cancel — подтверждение уборки\n2365|                    raise\n2366|                if msg.get(\"method\") == \"turn/completed\" and isinstance(\n2367|                    msg.get(\"params\"), dict\n2368|                ):\n2369|                    p = msg[\"params\"]\n2370|                    if turn_id is not None and p.get(\"turnId\") not in (turn_id, None):\n2371|                        _handle_event(msg, None)\n2372|                        continue\n2373|                    terminal = str(p.get(\"terminal\") or \"unknown\")\n2374|                    if isinstance(p.get(\"usage\"), dict):\n2375|                        usage.update(p[\"usage\"])  # type: ignore[arg-type]\n2376|                    if terminal != \"completed\":\n2377|                        hard_threshold = _has_hard_threshold_marker(\n2378|                            p.get(\"error\"), p.get(\"reason\")\n2379|                        )\n2380|                        turn_diag_lines = _turn_diagnostics(p, self.prompt)\n2381|                        _err_raw = p.get(\"error\")\n2382|                        transient_terminal[0] = _is_transient_text(\n2383|                            _err_raw, p.get(\"reason\")\n2384|                        )\n2385|                        if transient_terminal[0]:\n2386|                            _log(\n2387|                                \"transient_terminal \"\n2388|                                f\"ttft={1 if p.get('timeToFirstTokenMs') is not None else 0} \"\n2389|                                f\"usage={1 if usage else 0} \"\n2390|                                f\"tool_items={self.tool_item_count}\"\n2391|                            )\n2392|                    break\n2393|                if \"method\" not in msg and (\"result\" in msg or \"error\" in msg):\n2394|                    _handle_ack(msg)\n2395|                    continue\n2396|                _handle_event(msg, None)\n2397|            flags: dict[str, Any] = {\n2398|                \"action_possible\": self.action_possible,\n2399|                \"approval_seen\": self.approval_seen,\n2400|                \"approval_degraded\": self.approval_degraded,\n2401|                \"allowing_decide\": self.allowing_decide_attempted,\n2402|                \"observed_barrier\": self.observed_barrier,\n2403|                \"tool_items\": self.tool_item_count,\n2404|                \"transient\": bool(transient_terminal[0]),\n2405|            }\n2406|            if self.approval_degraded:\n2407|                _log(f\"serve turn degraded outcome tool_items={self.tool_item_count}\")\n2408|                return {\n2409|                    \"rc\": 1,\n2410|                    \"text\": \"\",\n2411|                    \"chunks\": [],\n2412|                    \"err\": \"approval_degraded\",\n2413|                    \"state\": \"terminal_failed\",\n2414|                    \"summaries\": [],\n2415|                    \"usage\": usage,\n2416|                    \"via\": \"serve\",\n2417|                    \"hard_threshold\": False,\n2418|                    **flags,\n2419|                }\n2420|            serve_rc: int | None = None\n2421|            if terminal == \"completed\":\n2422|                # D-A3-1: после completed — тот же грейс, что у exec: serve вышел сам с rc != 0 ->\n2423|                # ошибка; жив -> мост закрывает группу (сигнал моста rc не определяет).\n2424|                try:\n2425|                    self.proc.wait(timeout=TERMINAL_EXIT_GRACE_S)\n2426|                except subprocess.TimeoutExpired:\n2427|                    pass\n2428|                self.close()\n2429|                serve_rc = self.proc.returncode\n2430|            ordered = [\n2431|                summary_parts[i] for i in sorted(summary_parts) if summary_parts[i]\n2432|            ]\n2433|            for part in ordered:\n2434|                if part not in summaries:\n2435|                    summaries.append(part)\n2436|            text = final_text if final_text is not None else \"\".join(deltas)\n2437|            if terminal != \"completed\":\n2438|                self.close()\n2439|            # Прежнее ожидание drain_stderr переносится до снимка: шум после terminal\n2440|            # не теряется; приоритетный носитель не зависит от хвоста сборщика.\n2441|            err_thread.join(timeout=5)\n2442|            stderr_joined = True\n2443|            hard_threshold = hard_threshold or _has_hard_threshold_marker(err_lines)\n2444|            stderr_tail = _redact_secrets(\"\\n\".join(list(err_lines)[-6:]))\n2445|            if self.prompt:\n2446|                stderr_tail = stderr_tail.replace(self.prompt, \"[REDACTED]\")\n2447|            err = \"\\n\".join(turn_diag_lines)\n2448|            if err:\n2449|                if stderr_tail:\n2450|                    err += \"\\n\" + _clip_diagnostic(stderr_tail, 499 - len(err))\n2451|            else:\n2452|                err = stderr_tail\n2453|            if terminal == \"completed\" and serve_rc not in (None, 0, *_SIGNAL_RCS):\n2454|                return {\n2455|                    \"rc\": serve_rc,\n2456|                    \"text\": text,\n2457|                    \"chunks\": [text] if text else [],\n2458|                    \"err\": err,\n2459|                    \"state\": \"nonzero_exit\",\n2460|                    \"summaries\": summaries,\n2461|                    \"usage\": usage,\n2462|                    \"via\": \"serve\",\n2463|                    \"hard_threshold\": hard_threshold,\n2464|                    **flags,\n2465|                }\n2466|            if terminal != \"completed\":\n2467|                return {\n2468|                    \"rc\": 1,\n2469|                    \"text\": text,\n2470|                    \"chunks\": [text] if text else [],\n2471|                    \"err\": err,\n2472|                    \"state\": f\"terminal_{terminal}\",\n2473|                    \"summaries\": summaries,\n2474|                    \"usage\": usage,\n2475|                    \"via\": \"serve\",\n2476|                    \"hard_threshold\": hard_threshold,\n2477|                    **flags,\n2478|                }\n2479|            return {\n2480|                \"rc\": 0,\n2481|                \"text\": text,\n2482|                \"chunks\": [text] if text else [],\n2483|                \"err\": err,\n2484|                \"state\": \"ok\",\n2485|                \"summaries\": summaries,\n2486|                \"usage\": usage,\n2487|                \"via\": \"serve\",\n2488|                \"hard_threshold\": hard_threshold,\n2489|                **flags,\n2490|            }\n2491|        finally:\n2492|            self.close()\n2493|            if not stderr_joined:\n2494|                err_thread.join(timeout=1)\n2495|\n2496|\n2497|class Handler(BaseHTTPRequestHandler):\n2498|    protocol_version = \"HTTP/1.1\"\n2499|    timeout = 300\n2500|\n2501|    def log_message(self, format: str, *args: Any) -> None:\n2502|        _log(\"http \" + (format % args))\n2503|\n2504|    def handle_error(self, request: Any, client_address: Any) -> None:\n2505|        _log(f\"http accept error from {client_address}\")\n2506|\n2507|    # Обрыв клиента и текущий ход: значения инициализируются в setup() каждого соединения.\n2508|    _client_gone: bool = False\n2509|    _current_run: Run | ServeRun | None = None\n2510|    # Ранний SSE (stream=true): состояние потока и keepalive текущего соединения.\n2511|    _sse_open: bool = False\n2512|    _content_started: bool = False\n2513|    _sse_id: str = \"\"\n2514|    _sse_created: int = 0\n2515|    _sse_model: str = \"\"\n2516|    _wlock: threading.Lock = threading.Lock()\n2517|    _sse_phase: str = \"OPEN\"\n2518|    _keepalive_stop: threading.Event | None = None\n2519|    _ka_thread: threading.Thread | None = None\n2520|    _live_sent_text: str = \"\"\n2521|    _write_deadline: float = float(\"inf\")\n2522|    _exec_deadline: float = float(\"inf\")\n2523|    _request_deadline: float = float(\"inf\")\n2524|    _delivery_failed: bool = False\n2525|    _req_done: threading.Event | None = None\n2526|\n2527|    def setup(self) -> None:\n2528|        # Состояние обрыва клиента и ссылка на текущий ход — на каждое соединение.\n2529|        self._client_gone = False\n2530|        self._current_run = None\n2531|        self._sse_open = False\n2532|        self._content_started = False\n2533|        self._sse_id = \"\"\n2534|        self._sse_created = 0\n2535|        self._sse_model = \"\"\n2536|        self._wlock = threading.Lock()\n2537|        with self._wlock:\n2538|            self._sse_phase = \"OPEN\"\n2539|        self._keepalive_stop: threading.Event | None = None\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
