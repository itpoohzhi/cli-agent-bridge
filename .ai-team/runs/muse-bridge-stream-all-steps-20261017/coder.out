dget)\\\"\\n2800:            return self._note_write_failure(fatal, \\\"client gone mid-stream\\\")\\n2819:        fatal: bool = True,\\n2823:            fatal,\\n2831:        Запись нефатальна (S1): при сбое `_live_degraded=True`, ход жив,\\n2836:        if getattr(self, \\\"_live_degraded\\\", False):\\n2848:                fatal=False,\\n2854:                self._live_degraded = True\\n2862:        getter = getattr(run, \\\"get_accumulated_reasoning\\\", None)\\n2899:                fatal=False,\\n2927:        self._live_degraded = False\\n3264:        self._live_degraded = False\\nCOMPILE_OK\\nAll checks passed!\\n\",\n  \"original_output_bytes\": 1646,\n  \"original_output_tokens\": 412,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
