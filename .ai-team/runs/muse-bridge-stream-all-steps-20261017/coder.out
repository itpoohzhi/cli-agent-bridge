{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f9","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":343,"recorded_at":1780531400000681,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149ec669e75d6b2ec5644090ecae4","text":"Read text file `bridges/muse-bridge/server.py`.\n(3437 line(s) above)\n3438|                    pause += random.uniform(0, TRANSIENT_JITTER_S)\n3439|                transient_retry_count += 1\n3440|                if TRANSIENT_RETRY_SCOPE == \"observed-items\":\n3441|                    _log(\n3442|                        \"transient retry retry_scope=observed-items \"\n3443|                        f\"n={transient_retry_count}\"\n3444|                    )\n3445|                else:\n3446|                    _log(\n3447|                        \"transient retry retry_scope=pre-action \"\n3448|                        f\"n={transient_retry_count} pause_s={pause:.2f}\"\n3449|                    )\n3450|                pause_end = min(time.monotonic() + pause, _exec_deadline)\n3451|                client_left = False\n3452|                while time.monotonic() < pause_end:\n3453|                    if self._client_gone or self._client_gone_probe():\n3454|                        self._client_gone = True\n3455|                        client_left = True\n3456|                        break\n3457|                    time.sleep(min(0.05, max(0.0, pause_end - time.monotonic())))\n3458|                if client_left:\n3459|                    break\n3460|                out, via = run_attempt(prompt)\n3461|        finally:\n3462|            # Слот отпускаем после остановки надзора (kill -> wait уже внутри execute).\n3463|            watch_stop.set()\n3464|            watcher.join(timeout=2)\n3465|            # close() идемпотентен и ждёт уборку, начатую другим потоком (надзор, таймер):\n3466|            # dead_confirmed читается только после её конца. Заодно страхует ход, упавший\n3467|            # между Popen и собственным finally execute().\n3468|            for run in runs:\n3469|                run.close()\n3470|            if all(run.dead_confirmed for run in runs):\n3471|                _slots.release()\n3472|            else:\n3473|                # Смерть группы не подтверждена: слот не освобождается, пока она жива (карантин).\n3474|                _quarantine_slot([run for run in runs if not run.dead_confirmed])\n3475|\n3476|        if self._client_gone:\n3477|            # Клиент ушёл: ответ в закрытый сокет не пишется (ни JSON, ни кадр ошибки).\n3478|            _log(\"client gone — response skipped\")\n3479|            return\n3480|        # Только локальная граница запроса знает отражённый промпт; глобально его не храним.\n3481|        out = dict(out)\n3482|        diagnostic = _sanitize_reflected(\n3483|            str(out.get(\"err\") or \"\"), reflected_prompts, raw_messages\n3484|        )\n3485|        if terminal_context_err is not None:\n3486|            diagnostic = _redact_secrets(terminal_context_err)\n3487|        out[\"err\"] = _redact_secrets(diagnostic)\n3488|        if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\"):\n3489|            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n3490|            self._send(\n3491|                502,\n3492|                {\n3493|                    \"error\": {\n3494|                        \"message\": _redact_secrets(str(out.get(\"err\") or out[\"state\"])),\n3495|                        \"detail\": _redact_secrets(str(out.get(\"err\") or \"\"))[:500],\n3496|                        \"type\": \"proxy_error\",\n3497|                        \"code\": 502,\n3498|                    }\n3499|                },\n3500|            )\n3501|            return\n3502|        if out.get(\"state\") != \"ok\" or out.get(\"rc\") != 0:\n3503|            # Провал хода (failed terminal, rc != 0, таймаут): частичный текст и tool-блоки\n3504|            # не выдаются как успешный финал — SSE error + [DONE] либо 502 (Q-004).\n3505|            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n3506|            _log(_format_err_log(model, via, out, req.get(\"stream\") is True))\n3507|            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n3508|            err_message = (\n3509|                f\"muse turn failed (rc={out.get('rc')}, state={out.get('state')}){hint}\"\n3510|            )\n3511|            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n3512|                err_message = f\"{err_message}: {detail}\"\n3513|            self._send(\n3514|                502,\n3515|                {\n3516|                    \"error\": {\n3517|                        \"message\": _redact_secrets(err_message),\n3518|                        \"detail\": detail,\n3519|                        \"type\": \"proxy_error\",\n3520|                        \"code\": 502,\n3521|                    }\n3522|                },\n3523|            )\n3524|            return\n3525|        content = out[\"text\"]\n3526|        tool_calls: list[dict] = []\n3527|        if emulate_tools and content:\n3528|            content, tool_calls = _split_tool_calls(out.get(\"chunks\") or [content])\n3529|        if not content and not tool_calls:\n3530|            hint = \" (proxy :10816 DOWN?)\" if out.get(\"rc\") == 42 else \"\"\n3531|            _log(\n3532|                _format_err_log(\n3533|                    model, via, out, req.get(\"stream\") is True, \"empty_output\"\n3534|                )\n3535|            )\n3536|            detail = _redact_secrets(str(out.get(\"err\") or \"\"))[:500]\n3537|            err_message = (\n3538|                f\"muse exec produced no text (rc={out.get('rc')}, \"\n3539|                f\"state={out.get('state')}){hint}\"\n3540|            )\n3541|            if detail and detail != f\"state={out.get('state')} rc={out.get('rc')}\":\n3542|                err_message = f\"{err_message}: {detail}\"\n3543|            self._send(\n3544|                502,\n3545|                {\n3546|                    \"error\": {\n3547|                        \"message\": _redact_secrets(err_message),\n3548|                        \"detail\": detail,\n3549|                        \"type\": \"proxy_error\",\n3550|                        \"code\": 502,\n3551|                    }\n3552|                },\n3553|            )\n3554|            return\n3555|\n3556|        prompt_tokens = _estimate_usage_tokens(prompt)\n3557|        completion_tokens = _estimate_usage_tokens(out[\"text\"])\n3558|        # Serve даёт настоящие токены (session/tokenUsage); exec — оценку.\n3559|        # tokenUsage serve не даёт promptTokens — фолбэк на оценку по каждому\n3560|        # полю отдельно (раньше общий if занулял prompt при пустом поле).\n3561|        ru = out.get(\"usage\") if isinstance(out.get(\"usage\"), dict) else {}\n3562|        ru_prompt = ru.get(\"promptTokens\") or ru.get(\"prompt_tokens\") or 0\n3563|        ru_output = ru.get(\"outputTokens\") or ru.get(\"output_tokens\") or 0\n3564|        try:\n3565|            ru_prompt = int(ru_prompt)\n3566|        except (TypeError, ValueError):\n3567|            ru_prompt = 0\n3568|        try:\n3569|            ru_output = int(ru_output)\n3570|        except (TypeError, ValueError):\n3571|            ru_output = 0\n3572|        if ru_prompt > 0:\n3573|            prompt_tokens = ru_prompt\n3574|        if ru_output > 0:\n3575|            completion_tokens = ru_output\n3576|        ru_reasoning = ru.get(\"reasoningTokens\") or ru.get(\"reasoning_tokens\") or 0\n3577|        try:\n3578|            reasoning_tokens = int(ru_reasoning)\n3579|        except (TypeError, ValueError):\n3580|            reasoning_tokens = 0\n3581|        if reasoning_tokens < 0:\n3582|            reasoning_tokens = 0\n3583|        raw_summaries = out.get(\"summaries\")\n3584|        summaries: list[str] = (\n3585|            [s for s in raw_summaries if isinstance(s, str)]\n3586|            if isinstance(raw_summaries, list)\n3587|            else []\n3588|        )\n3589|        sum_chars = sum(len(s) for s in summaries)\n3590|        if summaries:\n3591|            preview = next((s for s in summaries if s), \"\")[:300]\n3592|            _log(\n3593|                f\"reasoning summaries={len(summaries)} chars={sum_chars} \"\n3594|                f\"reasoning_tokens={reasoning_tokens} preview={preview!r}\"\n3595|            )\n3596|        message: dict[str, Any] = {\"role\": \"assistant\", \"content\": content}\n3597|        finish = \"stop\"\n3598|        if tool_calls:\n3599|            message[\"tool_calls\"] = tool_calls\n3600|            finish = \"tool_calls\"\n3601|        _log(\n3602|            f\"done model={model} via={via} rc={out.get('rc')} state={out.get('state')} \"\n3603|            f\"tools={len(tool_calls)} out_chars={len(out['text'])} \"\n3604|            f\"stream={req.get('stream') is True}\"\n3605|        )\n3606|        if req.get(\"stream\") is True:\n3607|            self._send_sse(\n3608|                model,\n3609|                content,\n3610|                tool_calls,\n3611|                prompt_tokens,\n3612|                completion_tokens,\n3613|                reasoning_tokens,\n3614|                summaries,\n3615|            )\n3616|            return\n3617|        self._send(\n3618|            200,\n3619|            {\n3620|                \"id\": f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\",\n3621|                \"object\": \"chat.completion\",\n3622|                \"created\": int(time.time()),\n3623|                \"model\": model,\n3624|                \"choices\": [{\"index\": 0, \"message\": message, \"finish_reason\": finish}],\n3625|                \"usage\": {\n3626|                    \"prompt_tokens\": prompt_tokens,\n3627|                    \"completion_tokens\": completion_tokens,\n3628|                    \"total_tokens\": prompt_tokens + completion_tokens,\n3629|                    \"reasoning_tokens\": reasoning_tokens,\n3630|                },\n3631|                \"reasoning_summaries\": summaries,\n3632|            },\n3633|        )\n3634|\n3635|\n3636|class Server(ThreadingHTTPServer):\n3637|    daemon_threads = True\n3638|    allow_reuse_address = True\n3639|\n3640|\n3641|def main() -> int:\n3642|    if not AUTH_KEY:\n3643|        sys.stderr.write(\"MUSE_BRIDGE_KEY is required; refusing to start\\n\")\n3644|        return 2\n3645|    try:\n3646|        _validate_startup_config()\n3647|    except RuntimeError as exc:\n3648|        sys.stderr.write(f\"{exc}; refusing to start\\n\")\n3649|        _log(f\"startup config invalid: {exc}\")\n3650|        return 2\n3651|    if TRANSIENT_RETRY_SCOPE == \"observed-items\":\n3652|        _log(\"warning retry_scope=observed-items at-least-once accepted by operator\")\n3653|    try:\n3654|        WORKSPACE.mkdir(parents=True, exist_ok=True)\n3655|    except OSError as exc:\n3656|        _log(f\"workspace mkdir failed: {exc}\")\n3657|    _log(\n3658|        f\"start host={HOST} port={PORT} models={sorted(ALLOWED_MODELS)} wrapper={MUSE_WRAPPER}\"\n3659|    )\n3660|    server = Server((HOST, PORT), Handler)\n3661|    try:\n3662|        server.serve_forever()\n3663|    except KeyboardInterrupt:\n3664|        pass\n3665|    finally:\n3666|        server.server_close()\n3667|    return 0\n3668|\n3669|\n3670|if __name__ == \"__main__\":\n3671|    raise SystemExit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
