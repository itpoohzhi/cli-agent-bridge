{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-b597-7eb2-83c8-9fb454a5d4e7"},"task_id":"01a149ea-b597-7eb2-83c8-9fb454a5d4e7","event":{"kind":"output","task_id":"01a149ea-b597-7eb2-83c8-9fb454a5d4e7","chunk":"Read text file `bridges/muse-bridge/server.py`.\n(199 line(s) above)\n200|            text = \" \".join(\n201|                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n202|            )\n203|            if not text.strip():\n204|                text = str(value)\n205|        else:\n206|            text = str(value)\n207|        if any(marker in text for marker in TRANSIENT_MARKERS):\n208|            return True\n209|    return False\n210|\n211|\n212|_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n213|_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n214|\n215|\n216|def _render_audit_token(value: Any) -> str:\n217|    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n218|    text = value if isinstance(value, str) else \"\"\n219|    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n220|        return text\n221|    raw = text if isinstance(value, str) else str(value or \"\")\n222|    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n223|    return f\"redacted(len={len(raw)},sha256={digest})\"\n224|\n225|\n226|def _render_tool_token(value: Any) -> str:\n227|    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n228|    text = value if isinstance(value, str) else \"\"\n229|    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n230|        return text\n231|    return f\"redacted(len={len(text)})\"\n232|\n233|\n234|class ApprovalPolicy:\n235|    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n236|\n237|    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n238|    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n239|    \"\"\"\n240|\n241|    def __init__(self, mode: str) -> None:\n242|        self.mode = mode\n243|\n244|    @staticmethod\n245|    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n246|        raw = params.get(\"availableChoices\")\n247|        if not isinstance(raw, list):\n248|            return []\n249|        return [c for c in raw if isinstance(c, dict)]\n250|\n251|    @staticmethod\n252|    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n253|        if not params:\n254|            return None\n255|        for choice in ApprovalPolicy._choices(params):\n256|            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n257|                return choice\n258|        return None\n259|\n(more lines below)","final_result":true}}}
