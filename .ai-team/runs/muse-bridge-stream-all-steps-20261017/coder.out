{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c907","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":734,"recorded_at":1780531400001463,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149f0-271a-79f3-b900-128560bdb649"},"task_id":"01a149f0-271a-79f3-b900-128560bdb649","event":{"kind":"output","task_id":"01a149f0-271a-79f3-b900-128560bdb649","chunk":"Read text file `bridges/muse-bridge/server.py`.\n(2697 line(s) above)\n2698|        self._request_deadline = float(\"inf\")\n2699|        self._delivery_failed = False\n2700|        self._req_done = None\n2701|        super().setup()\n2702|\n2703|    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n2704|    def _sse_write(\n2705|        self, text: str, *, keepalive: bool = False, mark_content: bool = False\n2706|    ) -> bool:\n2707|        \"\"\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\n2708|\n2709|        Ожидание замка, запись и flush делят единый остаток; исчерпание =\n2710|        зависший клиент (client_gone + killpg). Действует на всех писателей.\n2711|        \"\"\"\n2712|        started = time.monotonic()\n2713|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2714|        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\n2715|        if limit <= started:\n2716|            if not self._client_gone:\n2717|                self._client_gone = True\n2718|                self._delivery_failed = True\n2719|                _log(\"delivery_deadline write budget exhausted before frame\")\n2720|                self._kill_current_run()\n2721|            return False\n2722|        if not self._wlock.acquire(timeout=max(0.0, limit - time.monotonic())):\n2723|            if not self._client_gone:\n2724|                self._client_gone = True\n2725|                self._delivery_failed = True\n2726|                _log(\"client gone mid-stream (sse lock wait budget)\")\n2727|                self._kill_current_run()\n2728|            return False\n2729|        try:\n2730|            if self._sse_phase == \"CLOSED\" or self._client_gone:\n2731|                return False\n2732|            if keepalive and (\n2733|                self._sse_phase != \"OPEN\"\n2734|                or (self._keepalive_stop is not None and self._keepalive_stop.is_set())\n2735|            ):\n2736|                return False\n2737|            if time.monotonic() >= limit:\n2738|                raise TimeoutError(\"sse write budget exhausted\")\n2739|            if mark_content:\n2740|                self._content_started = True\n2741|            conn = getattr(self, \"connection\", None)\n2742|            prev_timeout: Any = None\n2743|            have_conn = False\n2744|            if conn is not None and hasattr(conn, \"settimeout\"):\n2745|                try:\n2746|                    prev_timeout = conn.gettimeout()\n2747|                    conn.settimeout(max(0.001, limit - time.monotonic()))\n2748|                    have_conn = True\n2749|                except (OSError, ValueError, AttributeError):\n2750|                    have_conn = False\n2751|            try:\n2752|                self.wfile.write(text.encode(\"utf-8\"))\n2753|                if have_conn:\n2754|                    try:\n2755|                        conn.settimeout(max(0.001, limit - time.monotonic()))\n2756|                    except (OSError, ValueError, AttributeError):\n2757|                        pass\n2758|                self.wfile.flush()\n2759|            finally:\n2760|                if text == \"data: [DONE]\\n\\n\":\n2761|                    self._sse_phase = \"CLOSED\"\n2762|                if have_conn:\n2763|                    try:\n2764|                        conn.settimeout(prev_timeout)\n2765|                    except (OSError, ValueError, AttributeError):\n2766|                        pass\n2767|            return True\n2768|        except (BrokenPipeError, ConnectionResetError, OSError):\n2769|            if not self._client_gone:\n2770|                self._client_gone = True\n2771|                self._delivery_failed = True\n2772|                _log(\"client gone mid-stream\")\n2773|                self._kill_current_run()\n2774|            return False\n2775|        finally:\n2776|            self._wlock.release()\n2777|\n2778|    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n2779|        return {\n2780|            \"id\": self._sse_id,\n2781|            \"object\": \"chat.completion.chunk\",\n2782|            \"created\": self._sse_created,\n2783|            \"model\": self._sse_model,\n2784|            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n2785|        }\n2786|\n2787|    def _sse_emit(\n2788|        self, obj: dict, *, keepalive: bool = False, mark_content: bool = False\n2789|    ) -> bool:\n2790|        return self._sse_write(\n2791|            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\",\n2792|            keepalive=keepalive,\n2793|            mark_content=mark_content,\n2794|        )\n2795|\n2796|    def _live_reasoning_sink(self, full_text: str) -> bool:\n2797|        \"\"\"Sink ServeRun: публикует только прирост summary.0 до заморозки.\"\"\"\n2798|        if not full_text or not getattr(self, \"_sse_open\", False):\n2799|            return True\n2800|        sent = getattr(self, \"_live_sent_text\", \"\")\n2801|        if full_text == sent or not full_text.startswith(sent):\n2802|            return True\n2803|        delta = full_text[len(sent) :]\n2804|        if not delta:\n2805|            return True\n2806|        ok = self._sse_emit(\n2807|            self._sse_chunk({\"reasoning_content\": delta}), mark_content=True\n2808|        )\n2809|        if ok:\n2810|            self._live_sent_text = full_text\n2811|        return ok\n2812|\n2813|    def _force_close_connection(self) -> None:\n2814|        \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n2815|        self._client_gone = True\n2816|        conn = getattr(self, \"connection\", None)\n2817|        if conn is None:\n2818|            return\n2819|        try:\n2820|            conn.shutdown(socket.SHUT_RDWR)\n2821|        except (OSError, ValueError, AttributeError):\n2822|            pass\n2823|        try:\n2824|            conn.close()\n2825|        except (OSError, ValueError, AttributeError):\n2826|            pass\n2827|\n2828|    def _sse_begin(self, model: str) -> bool:\n2829|        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n2830|        if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2831|            self._delivery_failed = True\n2832|            self._client_gone = True\n2833|            return False\n2834|        self._live_sent_text = \"\"\n2835|        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n2836|        self._sse_created = int(time.time())\n2837|        self._sse_model = model\n(more lines below)","final_result":true}}}
