{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149eaa86573d7ade9ef16303c1734","text":"Read text file `bridges/muse-bridge/server.py`.\n(199 line(s) above)\n200|            text = \" \".join(\n201|                str(value.get(key) or \"\") for key in (\"kind\", \"message\", \"code\")\n202|            )\n203|            if not text.strip():\n204|                text = str(value)\n205|        else:\n206|            text = str(value)\n207|        if any(marker in text for marker in TRANSIENT_MARKERS):\n208|            return True\n209|    return False\n210|\n211|\n212|_AUDIT_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:-]+$\")\n213|_TOOL_TOKEN_RE = re.compile(r\"^[A-Za-z0-9_.:/-]+$\")\n214|\n215|\n216|def _render_audit_token(value: Any) -> str:\n217|    \"\"\"Безопасный рендер свободной строки в аудит-лог (FU-009).\"\"\"\n218|    text = value if isinstance(value, str) else \"\"\n219|    if text and len(text) <= 64 and _AUDIT_TOKEN_RE.match(text):\n220|        return text\n221|    raw = text if isinstance(value, str) else str(value or \"\")\n222|    digest = hashlib.sha256(raw.encode(\"utf-8\", \"replace\")).hexdigest()[:8]\n223|    return f\"redacted(len={len(raw)},sha256={digest})\"\n224|\n225|\n226|def _render_tool_token(value: Any) -> str:\n227|    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n228|    text = value if isinstance(value, str) else \"\"\n229|    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n230|        return text\n231|    return f\"redacted(len={len(text)})\"\n232|\n233|\n234|class ApprovalPolicy:\n235|    \"\"\"Чистая политика решения по снимку approval (BND-001): без I/O.\n236|\n237|    Читает только разрешённые поля снимка; rawArgs и тела не трогает.\n238|    Выход: approve / deny (ветка деградации) / fail_turn + аудит-строка.\n239|    \"\"\"\n240|\n241|    def __init__(self, mode: str) -> None:\n242|        self.mode = mode\n243|\n244|    @staticmethod\n245|    def _choices(params: dict[str, Any]) -> list[dict[str, Any]]:\n246|        raw = params.get(\"availableChoices\")\n247|        if not isinstance(raw, list):\n248|            return []\n249|        return [c for c in raw if isinstance(c, dict)]\n250|\n251|    @staticmethod\n252|    def deny_choice(params: dict[str, Any] | None) -> dict[str, Any] | None:\n253|        if not params:\n254|            return None\n255|        for choice in ApprovalPolicy._choices(params):\n256|            if choice.get(\"decision\") in (\"abort\", \"denied\"):\n257|                return choice\n258|        return None\n259|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149eaaad172ad8dacdee2339c1026","text":"Read text file `tests/test_muse_bridge_killpg.py`.\n(1559 line(s) above)\n1560|        self.assertEqual(handler._sse_phase, \"CLOSED\")\n1561|        self.assertTrue(handler._client_gone)\n1562|\n1563|\n1564|class CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n1565|    \"\"\"Реальные argv фейка; транспортный fallback до turn/start сохранён.\"\"\"\n1566|\n1567|    def test_serve_argv_allows_write_shell_by_default(self) -> None:\n1568|        install_protocol_wrapper(self, {\"terminal\": \"completed\"})\n1569|        for model in self.mod.ALLOWED_MODELS:\n1570|            with self.subTest(model=model):\n1571|                request = turn_request()\n1572|                request[\"model\"] = model\n1573|                self.assertEqual(bridge_request(self, request)[0], 200)\n1574|                argv = json.loads((self.tmp / \"serve-argv.json\").read_text())\n1575|                self.assertNotIn(\"--disable-write\", argv)\n1576|                self.assertNotIn(\"--disable-shell\", argv)\n1577|        for flag in (\n1578|            \"--provider\",\n1579|            \"meta\",\n1580|            \"--model\",\n1581|            \"--no-session-log\",\n1582|            \"--trust-workspace\",\n1583|        ):\n1584|            self.assertIn(flag, argv)\n1585|\n1586|    def test_transport_fallback_exec_flags(self) -> None:\n1587|        # oracle_change (REQ-MUSE-002): approval больше не уходит в exec;\n1588|        # проверки exec-флагов сохранены на транспортном ServeUnavailable\n1589|        # (EOF рукопожатия до turn/start), approval-контракт — класс Approval.\n1590|        install_fake_msp(self, serve_plans=[{\"handshake_eof\": True}])\n1591|        for model in self.mod.ALLOWED_MODELS:\n1592|            with self.subTest(model=model):\n1593|                request = turn_request()\n1594|                request[\"model\"] = model\n1595|                status, body = bridge_request(self, request)\n1596|                self.assertEqual(status, 200, body)\n1597|                self.assertIn(\"fallback-ok\", body.decode())\n1598|                argv = json.loads((self.tmp / \"exec-argv.json\").read_text())\n1599|                self.assertNotIn(\"--disable-write\", argv)\n1600|                self.assertNotIn(\"--disable-shell\", argv)\n1601|        for flag in (\n1602|            \"--disable-web-tools\",\n1603|            \"--disable-reminders\",\n1604|            \"--yolo\",\n1605|            \"--provider\",\n1606|            \"meta\",\n1607|            \"--model\",\n1608|            \"--reasoning-effort\",\n1609|            \"--trust-workspace\",\n1610|            \"--workspace\",\n1611|            \"--json\",\n1612|            \"--no-session-log\",\n1613|            \"--prompt-file\",\n1614|        ):\n1615|            self.assertIn(flag, argv)\n1616|        self.assertIn(\"fallback exec\", self.mod.LOG_PATH.read_text())\n1617|\n1618|    def test_write_shell_restrictions_are_independent_opt_ins(self) -> None:\n1619|        for mode in (\"serve\", \"exec\"):\n1620|            for disable_write, disable_shell in itertools.product((\"0\", \"1\"), repeat=2):\n1621|                with (\n1622|                    self.subTest(mode=mode, write=disable_write, shell=disable_shell),\n1623|                    mock.patch.dict(\n1624|                        os.environ,\n1625|                        {\n1626|                            \"MUSE_BRIDGE_DISABLE_WRITE\": disable_write,\n1627|                            \"MUSE_BRIDGE_DISABLE_SHELL\": disable_shell,\n1628|                        },\n1629|                    ),\n1630|                ):\n1631|                    install_fake_msp(\n1632|                        self,\n1633|                        serve_plans=[\n1634|                            ok_plan() if mode == \"serve\" else {\"handshake_eof\": True}\n1635|                        ],\n1636|                    )\n1637|                    status, body = bridge_request(self, turn_request())\n1638|                    self.assertEqual(status, 200, body)\n1639|                    argv = json.loads((self.tmp / f\"{mode}-argv.json\").read_text())\n1640|                    self.assertEqual(\"--disable-write\" in argv, disable_write == \"1\")\n1641|                    self.assertEqual(\"--disable-shell\" in argv, disable_shell == \"1\")\n1642|\n1643|\n1644|class AllowedModelsSyncTest(_BridgeScenario):\n1645|    \"\"\"T-00 / AD-001: wonder-модели объявляют context_length=400000, spark без изменений.\"\"\"\n1646|\n1647|    def test_t00_models_and_health_include_wonder_models_400k(self) -> None:\n1648|        wonder_models = (\"muse-wonder-1.0\", \"muse-wonder-full-1.0\")\n1649|        for model in wonder_models:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
