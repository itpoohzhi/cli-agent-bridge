{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c565","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":269,"recorded_at":1780531400000533,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2"},"task_id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2","event":{"kind":"output","task_id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2","chunk":"Read text file `tests/test_muse_bridge_killpg.py`.\n1|\"\"\"Regression-тесты утечки слотов muse-bridge: killpg группы и обрыв клиента.\n2|\n3|2026-10-09: close() Run/ServeRun бил только прямого ребёнка (proc.kill),\n4|sleep-«внук» в группе хода выживал; обрыв клиента во время exec/serve ход не\n5|прерывал — слот держался всю длительность прогона (до TIMEOUT_S), /health\n6|показывал active=1. Тесты гоняют зеркальную копию моста\n7|bridges/muse-bridge/server.py без живого muse-bin: вместо CLI — фейк-обёртка\n8|на sh (serve сразу rc=42 → безусловный fallback на exec, exec держит ход:\n9|лидер + спящий «внук», как реальное дерево muse); для serve-хода — фейк на python,\n10|который проходит handshake и держит turn/start без завершения.\n11|\"\"\"\n12|\n13|from __future__ import annotations\n14|\n15|import importlib.util\n16|import http.client\n17|import io\n18|import itertools\n19|import json\n20|import os\n21|import re\n22|import shutil\n23|import signal\n24|import socket\n25|import subprocess\n26|import sys\n27|import tempfile\n28|import threading\n29|import time\n30|import unittest\n31|from pathlib import Path\n32|from types import SimpleNamespace\n33|from typing import Any, Callable\n34|from unittest import mock\n35|\n36|_REPO_BRIDGE_PY = (\n37|    Path(__file__).resolve().parents[1] / \"bridges\" / \"muse-bridge\" / \"server.py\"\n38|)\n39|BRIDGE_PY = (\n40|    _REPO_BRIDGE_PY\n41|    if _REPO_BRIDGE_PY.exists()\n42|    else Path(__file__).resolve().parents[1] / \"server.py\"\n43|)\n44|\n45|_LOAD_SEQ = itertools.count()\n46|DISCONNECT_AFTER_S = 1.0\n47|SCENARIO_DEADLINE_S = 5.0\n48|GROUP_EXIT_WAIT_S = 5.0\n49|\n50|# Фейк muse-cli.sh: транспорт serve «недоступен» (мост уходит в fallback exec),\n51|# exec пишет pid лидера группы и держит ход 30 с.\n52|FAKE_WRAPPER = \"\"\"#!/bin/sh\n53|case \"$1\" in\n54|  serve)\n55|    exit 42\n56|    ;;\n57|  exec)\n58|    echo $$ > \"{pidfile}\"\n59|    sleep 30 &\n60|    wait\n61|    ;;\n62|esac\n63|exit 0\n64|\"\"\"\n65|\n66|# Фейк muse-cli.sh для serve-хода: serve принимает turn/start и держит ход (без\n67|# turn/completed), exec-fallback отмечается отдельным pid-файлом — его появление\n68|# означает, что сценарий serve не удался.\n69|SERVE_WRAPPER = \"\"\"#!/bin/sh\n70|case \"$1\" in\n71|  serve)\n72|    exec \"{python}\" \"{script}\" \"{servepid}\"\n73|    ;;\n74|  exec)\n75|    echo $$ > \"{pidfile}\"\n76|    sleep 30 &\n77|    wait\n78|    ;;\n79|esac\n80|exit 0\n81|\"\"\"\n82|\n83|# Python-скрипт serve: handshake по NDJSON JSON-RPC, после turn/start — «внук» sleep\n84|# в той же группе и pid-файл лидера (сигнал «serve удерживает ход»), дальше тишина.\n85|FAKE_SERVE_SCRIPT = \"\"\"import json, os, subprocess, sys, time\n86|\n87|pidfile = sys.argv[1]\n88|RESULTS = {\n89|    \"session/start\": {\"session\": {\"sessionId\": \"sess-1\"}},\n90|    \"turn/start\": {\"status\": \"accepted\", \"turnId\": \"turn-1\"},\n91|}\n92|for line in sys.stdin:\n93|    msg = json.loads(line)\n94|    rid = msg.get(\"id\")\n95|    if rid is None:\n96|        continue\n97|    reply = {\"jsonrpc\": \"2.0\", \"id\": rid, \"result\": RESULTS.get(msg[\"method\"], {})}\n98|    sys.stdout.write(json.dumps(reply) + \"\\\\n\")\n99|    sys.stdout.flush()\n100|    if msg[\"method\"] == \"turn/start\":\n101|        subprocess.Popen([\"sleep\", \"30\"])\n102|        with open(pidfile, \"w\") as fh:\n103|            fh.write(str(os.getpid()))\n104|        while True:\n105|            time.sleep(1)\n106|\"\"\"\n107|\n108|\n109|def load_bridge() -> Any:\n110|    \"\"\"Свежий экземпляр модуля моста: изолированные _slots/_active на каждый тест.\"\"\"\n111|    spec = importlib.util.spec_from_file_location(\n112|        f\"muse_bridge_server_{next(_LOAD_SEQ)}\", BRIDGE_PY\n113|    )\n114|    assert spec is not None and spec.loader is not None\n115|    module = importlib.util.module_from_spec(spec)\n116|    spec.loader.exec_module(module)\n117|    return module\n118|\n119|\n120|def group_alive(pgid: int) -> bool:\n121|    \"\"\"Жива ли группа pgid (сигнал 0 ничего не убивает).\"\"\"\n122|    try:\n123|        os.killpg(pgid, 0)\n124|    except ProcessLookupError:\n125|        return False\n126|    except OSError:\n127|        return True\n128|    return True\n129|\n130|\n131|def wait_until(predicate: Callable[[], bool], timeout: float) -> bool:\n132|    \"\"\"Опрос predicate каждые 50 мс до timeout (замер и на последней границе).\"\"\"\n133|    deadline = time.monotonic() + timeout\n134|    while True:\n135|        if predicate():\n136|            return True\n137|        if time.monotonic() >= deadline:\n138|            return predicate()\n139|        time.sleep(0.05)\n140|\n141|\n142|class CloseKillsGroupTest(unittest.TestCase):\n143|    \"\"\"R1: close() убивает всю группу хода, а не только прямого ребёнка.\"\"\"\n144|\n145|    @staticmethod\n146|    def _spawn_group() -> subprocess.Popen:\n147|        \"\"\"Лидер-шелл + sleep-«внук» в собственной группе (start_new_session).\"\"\"\n148|        return subprocess.Popen(\n149|            [\"/bin/sh\", \"-c\", \"sleep 60 & wait\"],\n150|            start_new_session=True,\n151|        )\n152|\n153|    @staticmethod\n154|    def _reap_group(proc: subprocess.Popen) -> None:\n155|        \"\"\"Добить и реапнуть свою мок-группу (только свой PGID, чужие не трогаем).\"\"\"\n156|        try:\n157|            os.killpg(proc.pid, signal.SIGKILL)\n158|        except (ProcessLookupError, OSError):\n159|            pass\n160|        try:\n161|            proc.wait(timeout=5)\n162|        except subprocess.TimeoutExpired:\n163|            pass\n164|\n165|    def _assert_close_kills_group(self, run: Any) -> None:\n166|        proc = self._spawn_group()\n167|        self.addCleanup(self._reap_group, proc)\n168|        run.proc = proc\n169|        run.close()\n170|        gone = wait_until(lambda: not group_alive(proc.pid), GROUP_EXIT_WAIT_S)\n171|        self.assertTrue(\n172|            gone,\n173|            f\"sleep-внук в группе {proc.pid} пережил close() — утечка процессов\",\n174|        )\n175|\n176|    def test_r1_run_close_kills_group(self) -> None:\n177|        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-r1-\") as tmp:\n178|            run = load_bridge().Run(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n179|            self._assert_close_kills_group(run)\n180|\n181|    def test_r1_serve_run_close_kills_group(self) -> None:\n182|        with tempfile.TemporaryDirectory(prefix=\"muse-bridge-r1-\") as tmp:\n183|            run = load_bridge().ServeRun(\"muse-spark-1.3\", \"p\", \"max\", Path(tmp))\n184|            self._assert_close_kills_group(run)\n185|\n186|\n187|class _BridgeScenario(unittest.TestCase):\n188|    \"\"\"Общий стенд: мост на временном порту с фейк-обёрткой вместо muse-cli.\"\"\"\n189|\n190|    # Значения инициализируются в setUp() каждого теста.\n191|    tmp: Path = Path()\n192|    mod: Any = None\n193|    pidfile: Path = Path()\n194|    servepid: Path = Path()\n195|    server: Any = None\n196|\n197|    def wrapper_text(self) -> str:\n198|        \"\"\"Текст фейк-обёртки; наследники подменяют транспорт.\"\"\"\n199|        return FAKE_WRAPPER.format(pidfile=self.pidfile)\n200|\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c567","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":270,"recorded_at":1780531400000535,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2"},"task_id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2","event":{"kind":"completed","task_id":"01a149ea-ceb7-7651-8b8a-26dcb031d4b2"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c569","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":271,"recorded_at":1780531400000537,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-ce7e-78d2-ad08-9dfbcf35ebf9"},"task_id":"01a149ea-ce7e-78d2-ad08-9dfbcf35ebf9","event":{"kind":"output","task_id":"01a149ea-ce7e-78d2-ad08-9dfbcf35ebf9","chunk":"Read text file `tests/test_muse_bridge_killpg.py`.\n(3779 line(s) above)\n3780|                        \"effect\": \"setup-fx\",\n3781|                        \"after\": \"break\",\n3782|                    },\n3783|                    \"steps\": [_OK_STEP],\n3784|                }\n3785|                install_fake_msp(self, serve_plans=[plan, ok_plan()])\n3786|                status, _ = bridge_request(self, turn_request())\n3787|                self.assertEqual(status, 502)\n3788|                self.assertEqual(proc_count(self, \"serve\"), 1)\n3789|                self.assertEqual(proc_count(self, \"exec\"), 0)\n3790|                self.assertEqual(effect_lines(self), [\"setup-fx\"])\n3791|\n3792|    def test_t_r12_slow_steady_delivery_cut_at_w(self) -> None:\n3793|        # Детерминированный транспорт: каждый кадр быстрее L, сумма — дольше W.\n3794|        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n3795|        self.mod.SSE_CHUNK_SIZE = 10\n3796|        self.mod.SSE_CHUNK_DELAY_S = 0.0\n3797|        handler = self.mod.Handler.__new__(self.mod.Handler)\n3798|        starts: list[float] = []\n3799|\n3800|        class SlowWriter(io.BytesIO):\n3801|            def write(self, data):  # type: ignore[override]\n3802|                starts.append(time.monotonic())\n3803|                time.sleep(0.05)\n3804|                return super().write(data)\n3805|\n3806|        writer = SlowWriter()\n3807|        handler._wlock = threading.Lock()\n3808|        handler.wfile = writer\n3809|        handler._sse_open = True\n3810|        handler._live_sent_text = \"\"\n3811|        w = time.monotonic() + 0.32\n3812|        handler._write_deadline = w\n3813|        handler._send_sse(\"muse-spark-1.3\", \"x\" * 200, [], 1, 1, 0)\n3814|        self.assertNotIn(b\"data: [DONE]\", writer.getvalue())\n3815|        self.assertTrue(all(s <= w + 0.06 for s in starts), starts)\n3816|        # Контроль: малый N успевает до W целиком с одним [DONE].\n3817|        writer2 = SlowWriter()\n3818|        handler.wfile = writer2\n3819|        handler._sse_phase = \"OPEN\"\n3820|        handler._client_gone = False\n3821|        handler._write_deadline = time.monotonic() + 5\n3822|        handler._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0)\n3823|        self.assertEqual(writer2.getvalue().count(b\"data: [DONE]\"), 1)\n3824|        self.assertIn(b\"hi\", writer2.getvalue())\n3825|\n3826|\n3827|class LiveReasoningTest(_BridgeScenario):\n3828|    \"\"\"REQ-MUSE-004 / AD-004 (T-L01..T-L09).\"\"\"\n3829|\n3830|    def test_t_l01_live_deltas_concat_equals_buffered(self) -> None:\n3831|        plan = ok_plan(\n3832|            {\"summary\": [0, \"think-\"]},\n3833|            {\"summary\": [0, \"more\"]},\n3834|            {\"summary\": [1, \"second\"]},\n3835|        )\n3836|        install_fake_msp(self, serve_plans=[plan])\n3837|        status, body = bridge_request(self, turn_request(stream=True))\n3838|        self.assertEqual(status, 200, body)\n3839|        deltas = sse_deltas(body, \"reasoning_content\")\n3840|        self.assertGreaterEqual(len(deltas), 3)\n3841|        self.assertEqual(\"\".join(deltas), \"think-more\\n\\nsecond\")\n3842|        self.assertEqual(\"\".join(sse_deltas(body, \"content\")), \"hello\")\n3843|        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n3844|\n3845|    def test_t_l02_completed_only_summaries_not_lost(self) -> None:\n3846|        plan = ok_plan({\"reasoning_completed\": [\"alpha\", \"beta\"]})\n3847|        install_fake_msp(self, serve_plans=[plan])\n3848|        status, body = bridge_request(self, turn_request(stream=True))\n3849|        self.assertEqual(status, 200, body)\n3850|        self.assertEqual(\n3851|            \"\".join(sse_deltas(body, \"reasoning_content\")), \"alpha\\n\\nbeta\"\n3852|        )\n3853|        install_fake_msp(self, serve_plans=[plan])\n3854|        status, body = bridge_request(self, turn_request())\n3855|        self.assertEqual(status, 200, body)\n3856|        self.assertEqual(json.loads(body)[\"reasoning_summaries\"], [\"alpha\", \"beta\"])\n3857|\n3858|    def test_t_l03_keepalive_data_chunks_preserved(self) -> None:\n3859|        self.mod.KEEPALIVE_S = 0.05\n3860|        install_fake_msp(self, serve_plans=[ok_plan({\"delay\": 0.25})])\n3861|        status, body = bridge_request(self, turn_request(stream=True))\n3862|        self.assertEqual(status, 200, body)\n3863|        self.assertNotIn(b\": keepalive\", body)\n3864|        self.assertEqual(body.count(b\"data: [DONE]\"), 1)\n3865|        self.assertTrue(any(d == \"\" for d in sse_deltas(body, \"content\")[:-1]))\n3866|\n3867|    def test_t_l04_live_write_failure_is_terminal_not_exception(self) -> None:\n3868|        handler = self.mod.Handler.__new__(self.mod.Handler)\n3869|\n3870|        class BrokenWriter(io.BytesIO):\n3871|            def write(self, data):  # type: ignore[override]\n3872|                raise OSError(\"closed peer\")\n3873|\n3874|        handler._wlock = threading.Lock()\n3875|        handler.wfile = BrokenWriter()\n3876|        handler._sse_open = True\n3877|        handler._live_sent_text = \"\"\n3878|        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n3879|        self.assertTrue(handler._client_gone)\n3880|\n3881|    def test_t_l05_model_retry_scheduled_log_only(self) -> None:\n3882|        plan = ok_plan(\n3883|            {\n3884|                \"model_retry\": {\n3885|                    \"attempt\": 1,\n3886|                    \"maxAttempts\": 4,\n3887|                    \"retryDelayMs\": 500,\n3888|                    \"errorKind\": \"network\",\n3889|                    \"turnId\": \"turn-1\",\n3890|                }\n3891|            }\n3892|        )\n3893|        install_fake_msp(self, serve_plans=[plan])\n3894|        status, body = bridge_request(self, turn_request(stream=True))\n3895|        self.assertEqual(status, 200, body)\n3896|        self.assertEqual(sse_deltas(body, \"reasoning_content\"), [])\n3897|        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n3898|        self.assertIn(\"modelRetryScheduled\", logs)\n3899|        self.assertIn(\"attempt=1\", logs)\n3900|\n3901|    def test_t_l06_out_of_order_summaries_prefix_monotone(self) -> None:\n3902|        plan = ok_plan(\n3903|            {\"summary\": [0, \"a\"]},\n3904|            {\"summary\": [1, \"b\"]},\n3905|            {\"summary\": [0, \"c\"]},\n3906|        )\n3907|        install_fake_msp(self, serve_plans=[plan])\n3908|        status, body = bridge_request(self, turn_request(stream=True))\n3909|        self.assertEqual(status, 200, body)\n3910|        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"ac\\n\\nb\")\n3911|        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n3912|        install_fake_msp(self, serve_plans=[plan])\n3913|        status, body = bridge_request(self, turn_request(stream=True))\n3914|        self.assertEqual(status, 200, body)\n3915|        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\")\n3916|\n3917|    def test_t_l07_diverged_snapshot_sends_authoritative_full(self) -> None:\n3918|        handler = self.mod.Handler.__new__(self.mod.Handler)\n3919|        handler._wlock = threading.Lock()\n3920|        handler.wfile = io.BytesIO()\n3921|        handler._sse_open = True\n3922|        handler._live_sent_text = \"a\"\n3923|        handler._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0, [\"b\", \"c\"])\n3924|        deltas = sse_deltas(handler.wfile.getvalue(), \"reasoning_content\")\n3925|        self.assertEqual(deltas, [\"\\n\\nb\\n\\nc\"])\n3926|        logs = self.mod.LOG_PATH.read_text(encoding=\"utf-8\")\n3927|        self.assertIn(\"reasoning_diverged\", logs)\n3928|        handler2 = self.mod.Handler.__new__(self.mod.Handler)\n3929|        handler2._wlock = threading.Lock()\n3930|        handler2.wfile = io.BytesIO()\n3931|        handler2._sse_open = True\n3932|        handler2._live_sent_text = \"a\"\n3933|        handler2._send_sse(\"muse-spark-1.3\", \"hi\", [], 1, 1, 0, [\"ab\"])\n3934|        self.assertEqual(\n3935|            sse_deltas(handler2.wfile.getvalue(), \"reasoning_content\"), [\"b\"]\n3936|        )\n3937|\n3938|    def _timing_handler(self) -> Any:\n3939|        handler = self.mod.Handler.__new__(self.mod.Handler)\n3940|        handler._wlock = threading.Lock()\n3941|        handler._sse_open = True\n3942|        handler._live_sent_text = \"\"\n3943|        handler._write_deadline = time.monotonic() + 30\n3944|        conn = SimpleNamespace(_timeout=None)\n3945|\n3946|        def gettimeout() -> Any:\n3947|            return conn._timeout\n3948|\n3949|        def settimeout(value: Any) -> None:\n3950|            conn._timeout = value\n3951|\n3952|        conn.gettimeout = gettimeout  # type: ignore[attr-defined]\n3953|        conn.settimeout = settimeout  # type: ignore[attr-defined]\n3954|        handler.connection = conn\n3955|        return handler\n3956|\n3957|    def test_t_l08a_live_write_bounded_by_single_budget(self) -> None:\n3958|        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n3959|        handler = self._timing_handler()\n3960|\n3961|        class TimeoutWriter(io.BytesIO):\n3962|            def write(self, data):  # type: ignore[override]\n3963|                limit = handler.connection.gettimeout() or 5.0\n3964|                time.sleep(min(float(limit), 5.0))\n3965|                raise TimeoutError(\"socket timeout\")\n3966|\n3967|        handler.wfile = TimeoutWriter()\n3968|        started = time.monotonic()\n3969|        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n3970|        self.assertLess(time.monotonic() - started, 1.0)\n3971|        self.assertTrue(handler._client_gone)\n3972|\n3973|    def test_t_l08b_keepalive_blocking_first_bounds_sink(self) -> None:\n3974|        self.mod.LIVE_WRITE_TIMEOUT_S = 0.25\n3975|        handler = self._timing_handler()\n3976|        release = threading.Event()\n3977|        self.addCleanup(release.set)\n3978|\n3979|        class BlockWriter(io.BytesIO):\n3980|            def write(self, data):  # type: ignore[override]\n3981|                limit = handler.connection.gettimeout() or 5.0\n3982|                if not release.wait(timeout=float(limit)):\n3983|                    raise TimeoutError(\"socket timeout\")\n3984|                return super().write(data)\n3985|\n3986|        handler.wfile = BlockWriter()\n3987|        results: dict[str, Any] = {}\n3988|        ka = threading.Thread(\n3989|            target=lambda: results.__setitem__(\n3990|                \"ka\", handler._sse_write(\"data: ka\\n\\n\", keepalive=True)\n3991|            ),\n3992|            daemon=True,\n3993|        )\n3994|        ka.start()\n3995|        time.sleep(0.05)\n3996|        started = time.monotonic()\n3997|        self.assertFalse(handler._live_reasoning_sink(\"summary\"))\n3998|        self.assertLess(time.monotonic() - started, 1.0)\n3999|        ka.join(timeout=2)\n4000|        self.assertFalse(ka.is_alive())\n4001|\n4002|    def test_t_l08c_terminal_delivery_and_stop_bounded(self) -> None:\n4003|        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n4004|        handler = self._timing_handler()\n4005|\n4006|        class TimeoutWriter(io.BytesIO):\n4007|            def write(self, data):  # type: ignore[override]\n4008|                limit = handler.connection.gettimeout() or 5.0\n4009|                time.sleep(min(float(limit), 5.0))\n4010|                raise TimeoutError(\"socket timeout\")\n4011|\n4012|        handler.wfile = TimeoutWriter()\n4013|        started = time.monotonic()\n4014|        handler._send_sse(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0)\n4015|        self.assertLess(time.monotonic() - started, 1.5)\n4016|        self.assertTrue(handler._client_gone)\n4017|\n4018|    def test_t_l09_slow_steady_frames_stop_at_w(self) -> None:\n4019|        self.mod.LIVE_WRITE_TIMEOUT_S = 0.2\n4020|        self.mod.SSE_CHUNK_SIZE = 10\n4021|        self.mod.SSE_CHUNK_DELAY_S = 0.0\n4022|        handler = self.mod.Handler.__new__(self.mod.Handler)\n4023|        starts: list[float] = []\n4024|\n4025|        class SlowWriter(io.BytesIO):\n4026|            def write(self, data):  # type: ignore[override]\n4027|                starts.append(time.monotonic())\n4028|                time.sleep(0.05)\n4029|                return super().write(data)\n4030|\n4031|        writer = SlowWriter()\n4032|        handler._wlock = threading.Lock()\n4033|        handler.wfile = writer\n4034|        handler._sse_open = True\n4035|        handler._live_sent_text = \"\"\n4036|        w = time.monotonic() + 0.32\n4037|        handler._write_deadline = w\n4038|        handler._send_sse(\"muse-spark-1.3\", \"y\" * 200, [], 1, 1, 0)\n4039|        self.assertNotIn(b\"data: [DONE]\", writer.getvalue())\n4040|        self.assertTrue(all(s <= w + 0.06 for s in starts), starts)\n4041|        self.assertNotIn(b'\"finish_reason\": \"stop\"', writer.getvalue())\n4042|\n4043|\n4044|if __name__ == \"__main__\":\n4045|    unittest.main(verbosity=2)","final_result":true}}}
