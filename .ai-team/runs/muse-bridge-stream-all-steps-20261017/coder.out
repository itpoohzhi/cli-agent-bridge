True,\n2071|                    )\n2072|                    pending[rid] = \"turn_cancel\"\n2073|            except ServeUnavailable as exc:\n2074|                _log(f\"approval degrade command failed: {exc}\")\n2075|\n2076|        def _handle_ack(msg: dict[str, Any]) -> None:\n2077|            raw_id = msg.get(\"id\")\n2078|            if not isinstance(raw_id, int):\n2079|                return\n2080|            kind = pending.pop(raw_id, None)\n2081|            if kind is None:\n2082|                return\n2083|            if \"error\" in msg:\n2084|                err = msg.get(\"error\") if isinstance(msg.get(\"error\"), dict) else {}\n2085|                code = err.get(\"code\")\n2086|                if kind == \"decide\" and code == -32051:\n2087|                    _log(\"approval decide benign -32051 already resolved\")\n2088|                    return\n2089|                if kind in (\"decide\", \"user_cancel\"):\n2090|                    _latch_degradation(f\"{kind}_error_{code}\")\n2091|                return\n2092|            result = msg.get(\"result\") if isinstance(msg.get(\"result\"), dict) else {}\n2093|            if result.get(\"terminal\") is False:\n2094|                _log(\"approval decide terminal=false awaiting updated request\")\n2095|\n2096|        def await_result(rid: int, timeout_at: float) -> dict[str, Any]:\n2097|            while True:\n2098|                msg = read_msg(timeout_at)\n2099|                if \"method\" in msg:\n2100|                    self._handle_event(msg, None)\n2101|                    continue\n2102|                if isinstance(msg, dict) and msg.get(\"id\") == rid:\n2103|                    if \"error\" in msg:\n2104|                        err = msg[\"error\"]\n2105|                        if isinstance(err, dict) and err.get(\"code\") == -32030:\n2106|                            self.ceiling_seen = True\n2107|                            _log(\n2108|                                f\"serve approval ceiling -32030 version={self.server_version} \"\n2109|                                \"warning approvalMode not applied\"\n2110|                            )\n2111|                        self.last_error_text = str(err)\n2112|                        raise ServeUnavailable(f\"serve RPC error: {err}\")\n2113|                    result = msg.get(\"result\")\n2114|                    return result if isinstance(result, dict) else {}\n2115|                _handle_ack(msg)\n2116|\n2117|        def _handle_event(msg: dict[str, Any], _unused: Any) -> None:\n2118|            nonlocal final_text\n2119|            method = msg.get(\"method\")\n2120|            _raw_params = msg.get(\"params\")\n2121|            params: dict[str, Any] = (\n2122|                _raw_params if isinstance(_raw_params, dict) else {}\n2123|            )\n2124|            if method in (\n2125|                \"approval/request\",\n2126|                \"approval/requested\",\n2127|                \"userInput/request\",\n2128|            ):\n2129|                # a4: защёлки ДО receipt/дедупликации/политики, включая setup.\n2130|                self.approval_seen = True\n2131|                self.action_possible = True\n2132|                self.observed_barrier = True\n2133|                if self.approval_degraded:\n2134|                    _log(f\"approval after degraded ignored method={method}\")\n2135|                    return\n2136|                server_id = msg.get(\"id\")\n2137|                try:\n2138|                    if server_id is not None:\n2139|                        self._send_response(server_id, {})\n2140|                except ServeUnavailable:\n2141|                    _latch_degradation(\"receipt_write_failed\", params)\n2142|                    return\n2143|                if method == \"userInput/request\":\n2144|                    last_snapshot[:] = [params]\n2145|                    policy = ApprovalPolicy(APPROVAL_MODE)\n2146|                    _log(policy.evaluate_user_input(params)[\"audit\"])\n2147|                    if self.user_input_cancel_count >= MAX_USER_INPUT_CANCEL:\n2148|                        _latch_degradation(\"user_input_limit\", params)\n2149|                        return\n2150|                    self.user_input_cancel_count += 1\n2151|                    try:\n2152|                        rid = self._send(\n2153|                            \"userInput/cancel\",\n2154|                            {\n2155|                                \"commandId\": _uuid7(),\n2156|                                \"sessionId\": params.get(\"sessionId\")\n2157|                                or session_id\n2158|                                or \"\",\n2159|                                \"userInputId\": params.get(\"userInputId\"),\n2160|                            },\n2161|                            control=True,\n2162|                        )\n2163|                        pending[rid] = \"user_cancel\"\n2164|                    except ServeUnavailable:\n2165|                        _latch_degradation(\"user_input_write_failed\", params)\n2166|                    return\n2167|                pair = _pair_key(params)\n2168|                if pair in seen_pairs:\n2169|                    _log(\"approval duplicate suppressed\")\n2170|                    return\n2171|                seen_pairs.add(pair)\n2172|                last_snapshot[:] = [params]\n2173|                if self.decide_count >= MAX_APPROVAL_DECIDE:\n2174|                    _latch_degradation(\"decide_limit\", params)\n2175|                    return\n2176|                verdict = ApprovalPolicy(APPROVAL_MODE).evaluate(params)\n2177|                _log(f\"{verdict['audit']} n={self.decide_count + 1}\")\n2178|                if verdict[\"action\"] == \"approve\":\n2179|                    choice = next(\n2180|                        (\n2181|                            c\n2182|                            for c in ApprovalPolicy._choices(params)\n2183|    