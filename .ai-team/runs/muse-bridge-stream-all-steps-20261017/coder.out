{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc15","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":1125,"recorded_at":1780531400002245,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149f45c8d7772ae6d20b50baf206d","text":"edited\nchanged lines: lines 3876-3881\n--- original\n+++ updated\n@@\n-        handler._wlock = threading.Lock()\n-        handler.wfile = BrokenWriter()\n-        handler._sse_open = True\n-        handler._live_sent_text = \"\"\n-        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n-        self.assertTrue(handler._client_gone)\n+        handler._wlock = threading.Lock()\n+        handler.wfile = BrokenWriter()\n+        handler._sse_open = True\n+        handler._live_sent_text = \"\"\n+        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n+        # oracle_change (ADR-0004/S1): live-запись нефатальна — деградация,\n+        # а не client_gone/kill; ход продолжается, буфер уйдёт в финале.\n+        self.assertTrue(handler._live_degraded)\n+        self.assertFalse(handler._client_gone)\n","edit_facts":{"tool_name":"edit_file","path":"tests/test_muse_bridge_killpg.py","added":9,"removed":6},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc17","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":1126,"recorded_at":1780531400002247,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149f464fa77118f4cf0c07bbbaa8f","text":"edited\nchanged lines: lines 3912-3920\n--- original\n+++ updated\n@@\n-        install_fake_msp(self, serve_plans=[plan])\n-        status, body = bridge_request(self, turn_request(stream=True))\n-        self.assertEqual(status, 200, body)\n-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"ac\\n\\nb\")\n-        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n-        install_fake_msp(self, serve_plans=[plan])\n-        status, body = bridge_request(self, turn_request(stream=True))\n-        self.assertEqual(status, 200, body)\n-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\")\n+        install_fake_msp(self, serve_plans=[plan])\n+        status, body = bridge_request(self, turn_request(stream=True))\n+        self.assertEqual(status, 200, body)\n+        # oracle_change (ADR-0004/AD-001): без заморозки live — append-only\n+        # stream в порядке поступления дельт; монотонность префикса сохранена,\n+        # сортировка по idx остаётся только в финальных summaries.\n+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nbc\")\n+        plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n+        install_fake_msp(self, serve_plans=[plan])\n+        status, body = bridge_request(self, turn_request(stream=True))\n+        self.assertEqual(status, 200, body)\n+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"b\\n\\na\")\n","edit_facts":{"tool_name":"edit_file","path":"tests/test_muse_bridge_killpg.py","added":12,"removed":9},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
