{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-94e6-7c53-8a86-78e9cf930af2"},"task_id":"01a149ea-94e6-7c53-8a86-78e9cf930af2","event":{"kind":"output","task_id":"01a149ea-94e6-7c53-8a86-78e9cf930af2","chunk":"{\n  \"chunk_id\": \"exec-3-1\",\n  \"command\": \"grep -n \\\"_render_tool_token\\\\|_TOOL\\\\|LIVE_WRITE_TIMEOUT\\\\|TIMEOUT_S\\\\|REQUEST_CAP\\\\|^TIMEOUT\\\\|^LIVE\\\\|import re\\\\|^import\\\\|^from\\\" bridges/muse-bridge/server.py | head -n 120\",\n  \"description\": \"Find constants and helpers\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"39:from __future__ import annotations\\n41:import hashlib\\n42:import json\\n43:import logging\\n44:import os\\n45:import random\\n46:import re\\n47:import select\\n48:import signal\\n49:import socket\\n50:import subprocess\\n51:import sys\\n52:import tempfile\\n53:import threading\\n54:import time\\n55:import uuid\\n56:from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n57:from pathlib import Path\\n58:from typing import Any, NamedTuple\\n66:TIMEOUT_S = float(os.environ.get(\\\"MUSE_BRIDGE_TIMEOUT_S\\\", \\\"1800\\\"))\\n132:# Грейс вне бюджета хода (таймер TIMEOUT_S отменяется по completed), но ограничен.\\n139:SERVE_SPAWN_TIMEOUT_S = 30.0  # handshake+session/start должны уложиться сюда\\n148:REQUEST_CAP_S = 1800.0\\n150:CONTROL_WRITE_TIMEOUT_S = 5.0\\n151:LIVE_WRITE_TIMEOUT_S = 3.0\\n177:    if TIMEOUT_S < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S:\\n179:            \\\"MUSE_BRIDGE_TIMEOUT_S too small: \\\"\\n180:            f\\\"{TIMEOUT_S} < FINISH_RESERVE_S + MIN_ATTEMPT_REMAINING_S \\\"\\n213:_TOOL_TOKEN_RE = re.compile(r\\\"^[A-Za-z0-9_.:/-]+$\\\")\\n226:def _render_tool_token(value: Any) -> str:\\n229:    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\\n1639:            _timer_s = min(TIMEOUT_S, _remain) if _remain != float(\\\"inf\\\") else TIMEOUT_S\\n1818:            time.monotonic() + CONTROL_WRITE_TIMEOUT_S,\\n1938:            min(_now0 + TIMEOUT_S, _exec_dl)\\n1940:            else _now0 + TIMEOUT_S\\n1944:        setup_deadline = min(_now0 + SERVE_SPAWN_TIMEOUT_S, deadline)\\n2044:                    grace_end, self.write_deadline - 2 * LIVE_WRITE_TIMEOUT_S\\n2226:                        f\\\"tool_item kind={_render_tool_token(kind)} \\\"\\n2227:                        f\\\"tool={_render_tool_token(item.get('toolName'))}\\\"\\n2553:        \\\"\\\"\\\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\\n2560:        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\\n2722:            budget = LIVE_WRITE_TIMEOUT_S\\n2724:            budget = min(LIVE_WRITE_TIMEOUT_S, max(0.0, w_deadline - time.monotonic()))\\n2998:        _req_deadline = _t0 + min(TIMEOUT_S, REQUEST_CAP_S)\\n\",\n  \"original_output_bytes\": 2127,\n  \"original_output_tokens\": 532,\n  \"truncated\": false\n}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ea-94e6-7c53-8a86-78e9cf930af2"},"task_id":"01a149ea-94e6-7c53-8a86-78e9cf930af2","event":{"kind":"completed","task_id":"01a149ea-94e6-7c53-8a86-78e9cf930af2"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"call_id":"call_01a149ea89eb70f5b68cc34b8cdfaa62","text":"Read text file `bridges/muse-bridge/server.py`.\n(2538 line(s) above)\n2539|        self._keepalive_stop: threading.Event | None = None\n2540|        self._ka_thread: threading.Thread | None = None\n2541|        self._live_sent_text = \"\"\n2542|        self._write_deadline = float(\"inf\")\n2543|        self._exec_deadline = float(\"inf\")\n2544|        self._request_deadline = float(\"inf\")\n2545|        self._delivery_failed = False\n2546|        self._req_done = None\n2547|        super().setup()\n2548|\n2549|    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n2550|    def _sse_write(\n2551|        self, text: str, *, keepalive: bool = False, mark_content: bool = False\n2552|    ) -> bool:\n2553|        \"\"\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\n2554|\n2555|        Ожидание замка, запись и flush делят единый остаток; исчерпание =\n2556|        зависший клиент (client_gone + killpg). Действует на всех писателей.\n2557|        \"\"\"\n2558|        started = time.monotonic()\n2559|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2560|        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\n2561|        if limit <= started:\n2562|            if not self._client_gone:\n2563|                self._client_gone = True\n2564|                self._delivery_failed = True\n2565|                _log(\"delivery_deadline write budget exhausted before frame\")\n2566|                self._kill_current_run()\n2567|            return False\n2568|        if not self._wlock.acquire(timeout=max(0.0, limit - time.monotonic())):\n2569|            if not self._client_gone:\n2570|                self._client_gone = True\n2571|                self._delivery_failed = True\n2572|                _log(\"client gone mid-stream (sse lock wait budget)\")\n2573|                self._kill_current_run()\n2574|            return False\n2575|        try:\n2576|            if self._sse_phase == \"CLOSED\" or self._client_gone:\n2577|                return False\n2578|            if keepalive and (\n2579|                self._sse_phase != \"OPEN\"\n2580|                or (self._keepalive_stop is not None and self._keepalive_stop.is_set())\n2581|            ):\n2582|                return False\n2583|            if time.monotonic() >= limit:\n2584|                raise TimeoutError(\"sse write budget exhausted\")\n2585|            if mark_content:\n2586|                self._content_started = True\n2587|            conn = getattr(self, \"connection\", None)\n2588|            prev_timeout: Any = None\n2589|            have_conn = False\n2590|            if conn is not None and hasattr(conn, \"settimeout\"):\n2591|                try:\n2592|                    prev_timeout = conn.gettimeout()\n2593|                    conn.settimeout(max(0.001, limit - time.monotonic()))\n2594|                    have_conn = True\n2595|                except (OSError, ValueError, AttributeError):\n2596|                    have_conn = False\n2597|            try:\n2598|                self.wfile.write(text.encode(\"utf-8\"))\n2599|                if have_conn:\n2600|                    try:\n2601|                        conn.settimeout(max(0.001, limit - time.monotonic()))\n2602|                    except (OSError, ValueError, AttributeError):\n2603|                        pass\n2604|                self.wfile.flush()\n2605|            finally:\n2606|                if text == \"data: [DONE]\\n\\n\":\n2607|                    self._sse_phase = \"CLOSED\"\n2608|                if have_conn:\n2609|                    try:\n2610|                        conn.settimeout(prev_timeout)\n2611|                    except (OSError, ValueError, AttributeError):\n2612|                        pass\n2613|            return True\n2614|        except (BrokenPipeError, ConnectionResetError, OSError):\n2615|            if not self._client_gone:\n2616|                self._client_gone = True\n2617|                self._delivery_failed = True\n2618|                _log(\"client gone mid-stream\")\n2619|                self._kill_current_run()\n2620|            return False\n2621|        finally:\n2622|            self._wlock.release()\n2623|\n2624|    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n2625|        return {\n2626|            \"id\": self._sse_id,\n2627|            \"object\": \"chat.completion.chunk\",\n2628|            \"created\": self._sse_created,\n2629|            \"model\": self._sse_model,\n2630|            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n2631|        }\n2632|\n2633|    def _sse_emit(\n2634|        self, obj: dict, *, keepalive: bool = False, mark_content: bool = False\n2635|    ) -> bool:\n2636|        return self._sse_write(\n2637|            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\",\n2638|            keepalive=keepalive,\n2639|            mark_content=mark_content,\n2640|        )\n2641|\n2642|    def _live_reasoning_sink(self, full_text: str) -> bool:\n2643|        \"\"\"Sink ServeRun: публикует только прирост summary.0 до заморозки.\"\"\"\n2644|        if not full_text or not getattr(self, \"_sse_open\", False):\n2645|            return True\n2646|        sent = getattr(self, \"_live_sent_text\", \"\")\n2647|        if full_text == sent or not full_text.startswith(sent):\n2648|            return True\n2649|        delta = full_text[len(sent) :]\n2650|        if not delta:\n2651|            return True\n2652|        ok = self._sse_emit(\n2653|            self._sse_chunk({\"reasoning_content\": delta}), mark_content=True\n2654|        )\n2655|        if ok:\n2656|            self._live_sent_text = full_text\n2657|        return ok\n2658|\n2659|    def _force_close_connection(self) -> None:\n2660|        \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n2661|        self._client_gone = True\n2662|        conn = getattr(self, \"connection\", None)\n2663|        if conn is None:\n2664|            return\n2665|        try:\n2666|            conn.shutdown(socket.SHUT_RDWR)\n2667|        except (OSError, ValueError, AttributeError):\n2668|            pass\n2669|        try:\n2670|            conn.close()\n2671|        except (OSError, ValueError, AttributeError):\n2672|            pass\n2673|\n2674|    def _sse_begin(self, model: str) -> bool:\n2675|        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n2676|        if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2677|            self._delivery_failed = True\n2678|            self._client_gone = True\n2679|            return False\n2680|        self._live_sent_text = \"\"\n2681|        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n2682|        self._sse_created = int(time.time())\n2683|        self._sse_model = model\n2684|        with self._wlock:\n2685|            self._sse_phase = \"OPEN\"\n2686|        self.close_connection = True\n2687|        try:\n2688|            self.send_response(200)\n2689|            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n2690|            self.send_header(\"Cache-Control\", \"no-cache\")\n2691|            self.send_header(\"Connection\", \"close\")\n2692|            self.send_header(\"X-Accel-Buffering\", \"no\")\n2693|            self.end_headers()\n2694|        except (BrokenPipeError, ConnectionResetError, OSError):\n2695|            self._client_gone = True\n2696|            _log(\"client gone before headers\")\n2697|            return False\n2698|        self._sse_open = True\n2699|        if not self._sse_emit(self._sse_chunk({\"role\": \"assistant\", \"content\": \"\"})):\n2700|            return False\n2701|        stop = threading.Event()\n2702|        self._keepalive_stop = stop\n2703|        self._ka_thread = threading.Thread(\n2704|            target=self._keepalive_loop, args=(stop,), daemon=True\n2705|        )\n2706|        self._ka_thread.start()\n2707|        return True\n2708|\n2709|    def _keepalive_loop(self, stop: threading.Event) -> None:\n2710|        \"\"\"Пустые data-чанки держат SSE; эффект на idle проверяется живым ходом.\"\"\"\n2711|        while not stop.wait(KEEPALIVE_S):\n2712|            if self._client_gone or stop.is_set():\n2713|                return\n2714|            if not self._sse_emit(self._sse_chunk({\"content\": \"\"}), keepalive=True):\n2715|                return\n2716|\n2717|    def _sse_stop_keepalive(self) -> None:\n2718|        if self._keepalive_stop is not None:\n2719|            self._keepalive_stop.set()\n2720|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2721|        if w_deadline == float(\"inf\"):\n2722|            budget = LIVE_WRITE_TIMEOUT_S\n2723|        else:\n2724|            budget = min(LIVE_WRITE_TIMEOUT_S, max(0.0, w_deadline - time.monotonic()))\n2725|        if self._wlock.acquire(timeout=budget):\n2726|            try:\n2727|                if self._sse_phase == \"OPEN\":\n2728|                    self._sse_phase = \"FINALIZING\"\n2729|            finally:\n2730|                self._wlock.release()\n2731|        if self._ka_thread is not None:\n2732|            join_budget = 2.0\n2733|            if w_deadline != float(\"inf\"):\n2734|                join_budget = min(join_budget, max(0.0, w_deadline - time.monotonic()))\n2735|            self._ka_thread.join(timeout=join_budget)\n2736|        self._keepalive_stop = None\n2737|        self._ka_thread = None\n2738|\n2739|    def _client_gone_probe(self) -> bool:\n2740|        \"\"\"Обрыв клиента: FIN даёт пустой peek; ошибки сокета считаем обрывом.\n2741|\n2742|        Режим сокета (timeout/blocking) не меняется: сокет общий с _sse_write\n2743|        в соседних потоках, смена режима из пробы ломала бы их запись. Peek идёт\n2744|        флагом MSG_DONTWAIT; select(0) заранее отсекает случай «данных нет».\n2745|        \"\"\"\n2746|        conn = self.connection\n2747|        if conn is None:\n2748|            return False\n2749|        try:\n2750|            ready, _, _ = select.select([conn], [], [], 0)\n2751|        except (OSError, ValueError):\n2752|            return True\n2753|        if not ready:\n2754|            return False\n2755|        try:\n2756|            data = conn.recv(1, socket.MSG_PEEK | getattr(socket, \"MSG_DONTWAIT\", 0))\n2757|        except (BlockingIOError, InterruptedError):\n2758|            return False\n2759|        except OSError:\n2760|            return True\n2761|        return data == b\"\"\n2762|\n2763|    def _kill_current_run(self) -> None:\n2764|        \"\"\"Убить группу текущего хода: призраки не переживают обрыв клиента.\"\"\"\n2765|        run = self._current_run\n2766|        if run is not None:\n2767|            run.close()\n2768|\n2769|    def _watch_client(self, stop: threading.Event) -> None:\n2770|        \"\"\"Надзор за клиентом во время хода: обрыв -> флаг + killpg группы хода.\n2771|\n2772|        Не выходит после первого убийства: ход может зарегистрироваться (или запустить\n2773|        процесс) уже после обрыва — kill идемпотентен и повторяется каждый тик до stop.\n2774|        \"\"\"\n2775|        reported = False\n2776|        while not stop.wait(0.25):\n2777|            if self._client_gone or self._client_gone_probe():\n2778|                self._client_gone = True\n2779|                if not reported:\n2780|                    reported = True\n2781|                    _log(\"client gone during run — killing process group\")\n2782|                self._kill_current_run()\n2783|\n2784|    def _send(self, code: int, payload: dict) -> None:\n2785|        if self._sse_open:\n2786|            # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n2787|            self._sse_stop_keepalive()\n2788|            error = payload.get(\"error\") if isinstance(payload, dict) else None\n2789|            if isinstance(error, dict):\n2790|                error = dict(error)\n2791|                error.setdefault(\"code\", int(code))\n2792|            self._sse_emit({\"error\": error or payload})\n2793|            self._sse_write(\"data: [DONE]\\n\\n\")\n2794|            return\n2795|        body = json.dumps(payload, ensure_ascii=False).encode(\"utf-8\")\n2796|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2797|        if time.monotonic() >= w_deadline:\n2798|            self._delivery_failed = True\n2799|            _log(\"delivery_deadline json response skipped\")\n2800|            self._force_close_connection()\n2801|            return\n2802|        conn = getattr(self, \"connection\", None)\n2803|        prev_timeout: Any = None\n2804|        have_conn = False\n2805|        if (\n2806|            conn is not None\n2807|            and hasattr(conn, \"settimeout\")\n2808|            and w_deadline != float(\"inf\")\n2809|        ):\n2810|            try:\n2811|                prev_timeout = conn.gettimeout()\n2812|                conn.settimeout(max(0.001, w_deadline - time.monotonic()))\n2813|                have_conn = True\n2814|            except (OSError, ValueError, AttributeError):\n2815|                have_conn = False\n2816|        try:\n2817|            self.send_response(int(code))\n2818|            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n2819|            self.send_header(\"Content-Length\", str(len(body)))\n2820|            self.end_headers()\n2821|            self.wfile.write(body)\n2822|        except (BrokenPipeError, ConnectionResetError, OSError):\n2823|            self._client_gone = True\n2824|            _log(\"client gone before response\")\n2825|            self._kill_current_run()\n2826|        finally:\n2827|            if have_conn:\n2828|                try:\n2829|                    conn.settimeout(prev_timeout)\n2830|                except (OSError, ValueError, AttributeError):\n2831|                    pass\n2832|\n2833|    def _send_sse(\n2834|        self,\n2835|        model: str,\n2836|        content: str,\n2837|        tool_calls: list[dict],\n2838|        prompt_tokens: int,\n2839|        completion_tokens: int,\n2840|        reasoning_tokens: int,\n2841|        summaries: list[str] | None = None,\n2842|    ) -> None:\n2843|        \"\"\"Выдача готового хода в поток SSE (см. модуль-docstring).\n2844|\n2845|        Заголовки и role-кадр обычно уже ушли (_sse_begin до запуска хода); здесь —\n2846|        reasoning_content (summaries размышлений) -> tool_calls -> content-чанки\n2847|        (~SSE_CHUNK_SIZE символов) -> финал с finish_reason + usage -> `data: [DONE]`.\n2848|        \"\"\"\n2849|        finish = \"tool_calls\" if tool_calls else \"stop\"\n2850|        if not self._sse_open and not self._sse_begin(model):\n2851|            return\n2852|        self._sse_stop_keepalive()\n2853|        chunk = self._sse_chunk\n2854|        reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n2855|        live_sent = getattr(self, \"_live_sent_text\", \"\")\n2856|        if reasoning:\n2857|            if not live_sent:\n2858|                tail = reasoning\n2859|            elif reasoning.startswith(live_sent):\n2860|                tail = reasoning[len(live_sent) :]\n2861|            else:\n2862|                common = 0\n2863|                for a_ch, b_ch in zip(live_sent, reasoning):\n2864|                    if a_ch != b_ch:\n2865|                        break\n2866|                    common += 1\n2867|                _log(\n2868|                    f\"reasoning_diverged p_len={len(live_sent)} f_len={len(reasoning)} \"\n2869|                    f\"common={common} count=1\"\n2870|                )\n2871|                tail = \"\\n\\n\" + reasoning\n2872|            if tail and not self._sse_emit(\n2873|                chunk({\"reasoning_content\": tail}), mark_content=True\n2874|            ):\n2875|                return\n2876|        for tc in tool_calls:\n2877|            fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n2878|            delta = {\n2879|                \"tool_calls\": [\n2880|                    {\n2881|                        \"index\": tc.get(\"index\", 0),\n2882|                        \"id\": tc.get(\"id\", \"\"),\n2883|                        \"type\": \"function\",\n2884|                        \"function\": {\n2885|                            \"name\": fn.get(\"name\", \"\"),\n2886|                            \"arguments\": fn.get(\"arguments\", \"\"),\n2887|                        },\n2888|                    }\n2889|                ]\n2890|            }\n2891|            if not self._sse_emit(chunk(delta), mark_content=True):\n2892|                return\n2893|        for piece in _split_sse_chunks(content):\n2894|            if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2895|                self._delivery_failed = True\n2896|                return\n2897|            if not self._sse_emit(chunk({\"content\": piece}), mark_content=True):\n2898|                return\n2899|            if SSE_CHUNK_DELAY_S > 0:\n2900|                _w = getattr(self, \"_write_deadline\", float(\"inf\"))\n2901|                if _w - time.monotonic() <= SSE_CHUNK_DELAY_S:\n2902|                    self._delivery_failed = True\n2903|                    return\n2904|                time.sleep(SSE_CHUNK_DELAY_S)\n2905|        final = chunk({}, finish)\n2906|        final[\"usage\"] = {\n2907|            \"prompt_tokens\": prompt_tokens,\n2908|            \"completion_tokens\": completion_tokens,\n2909|            \"total_tokens\": prompt_tokens + completion_tokens,\n2910|            \"reasoning_tokens\": reasoning_tokens,\n2911|        }\n2912|        if self._sse_emit(final):\n2913|            self._sse_write(\"data: [DONE]\\n\\n\")\n2914|\n2915|    def do_GET(self) -> None:  # noqa: N802\n2916|        path = self.path.split(\"?\", 1)[0]\n2917|        if path in (\"/health\", \"/v1/health\"):\n2918|            with _active_lock:\n2919|                active = len(_active)\n2920|                quarantined = len(_quarantined_slots)\n2921|            self._send(\n2922|                200,\n2923|                {\n2924|                    \"ok\": True,\n2925|                    \"transport\": \"muse-cli\",\n2926|                    \"wrapper\": MUSE_WRAPPER,\n2927|                    \"models\": sorted(ALLOWED_MODELS),\n2928|                    \"default_model\": DEFAULT_MODEL,\n2929|                    \"default_effort\": DEFAULT_EFFORT,\n2930|                    \"active\": active,\n2931|                    \"quarantined\": quarantined,\n2932|                    \"max_concurrent\": MAX_CONCURRENT,\n2933|                    \"stream\": True,\n2934|                    \"tool_emulation\": True,\n2935|                    \"uptime_s\": int(time.time() - _started),\n2936|                },\n2937|            )\n2938|            return\n2939|        if not _auth_ok(self):\n2940|            self._send(\n2941|                401, {\"error\": {\"message\": \"unauthorized\", \"type\": \"auth_error\"}}\n2942|            )\n2943|            return\n2944|        if path in (\"/v1/models\", \"/models\"):\n2945|            self._send(\n2946|                200,\n2947|                {\n2948|                    \"object\": \"list\",\n2949|                 