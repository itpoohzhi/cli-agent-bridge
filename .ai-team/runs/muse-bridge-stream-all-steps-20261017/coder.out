{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbf9","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":1111,"recorded_at":1780531400002217,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149f4-7e8c-78a3-b49b-92abc3e95b41"},"task_id":"01a149f4-7e8c-78a3-b49b-92abc3e95b41","event":{"kind":"output","task_id":"01a149f4-7e8c-78a3-b49b-92abc3e95b41","chunk":"edited\nchanged lines: lines 3876-3881\n--- original\n+++ updated\n@@\n-        handler._wlock = threading.Lock()\n-        handler.wfile = BrokenWriter()\n-        handler._sse_open = True\n-        handler._live_sent_text = \"\"\n-        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n-        self.assertTrue(handler._client_gone)\n+        handler._wlock = threading.Lock()\n+        handler.wfile = BrokenWriter()\n+        handler._sse_open = True\n+        handler._live_sent_text = \"\"\n+        self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n+        # oracle_change (ADR-0004/S1): live-запись нефатальна — деградация,\n+        # а не client_gone/kill; ход продолжается, буфер уйдёт в финале.\n+        self.assertTrue(handler._live_degraded)\n+        self.assertFalse(handler._client_gone)\n","final_result":true}}}
