{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c737","stream":{"kind":"session","id":"01a149e9-e523-7262-a03b-c2376ac3e32f"},"sequence":502,"recorded_at":1780531400000999,"record_type":"event","durability":"durable","causation_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a149e9-ecbb-7f22-9b48-df729b407e8e","run_stream":{"kind":"run","id":"01a149e9-ecbb-7f22-9b48-df729b407e8e"},"task_stream":{"kind":"task","id":"01a149ee-fcfd-7e23-a6cc-b607feaa8020"},"task_id":"01a149ee-fcfd-7e23-a6cc-b607feaa8020","event":{"kind":"output","task_id":"01a149ee-fcfd-7e23-a6cc-b607feaa8020","chunk":"edited\nchanged lines: lines 226-231\n--- original\n+++ updated\n@@\n-def _render_tool_token(value: Any) -> str:\n-    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n-    text = value if isinstance(value, str) else \"\"\n-    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n-        return text\n-    return f\"redacted(len={len(text)})\"\n+def _render_tool_token(value: Any) -> str:\n+    \"\"\"Рендер toolName в журнал инструментальных item (allowlist §4.3).\"\"\"\n+    text = value if isinstance(value, str) else \"\"\n+    if text and len(text) <= 64 and _TOOL_TOKEN_RE.match(text):\n+        return text\n+    return f\"redacted(len={len(text)})\"\n+\n+\n+_TOOL_MARKER_RE = re.compile(r\"^[A-Za-z0-9_.:-]{1,64}$\")\n+_TOOL_MARKER_INVALID_RE = re.compile(r\"[^A-Za-z0-9_.:-]\")\n+\n+\n+def _sanitize_tool_name(value: Any) -> str:\n+    \"\"\"Санитизация имени инструмента для live-маркеров reasoning (AD-002).\n+\n+    Допустимо только `^[A-Za-z0-9_.:-]{1,64}$`; недопустимые символы\n+    заменяются на `_`, длина обрезается до 64, пустое/None — `tool`.\n+    \"\"\"\n+    if not isinstance(value, str) or not value:\n+        return \"tool\"\n+    if _TOOL_MARKER_RE.match(value):\n+        return value\n+    cleaned = _TOOL_MARKER_INVALID_RE.sub(\"_\", value)[:64]\n+    return cleaned or \"tool\"\n","final_result":true}}}
