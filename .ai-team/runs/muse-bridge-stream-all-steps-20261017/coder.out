GE_TRANSIENT_RETRY_SCOPE\": \"bogus\"}\n3684|            ):\n3685|                with self.assertRaises(Exception):\n3686|                    load_bridge()\n3687|\n3688|    def test_t_r03c_client_gone_during_retry_pause(self) -> None:\n3689|        self.mod.TRANSIENT_BACKOFF_S = (1.0, 1.0)\n3690|        install_fake_msp(\n3691|            self,\n3692|            serve_plans=[\n3693|                {\"session_error\": {\"code\": -32603, \"message\": \"[net-timeout]\"}},\n3694|                ok_plan(),\n3695|            ],\n3696|        )\n3697|        sock = self._open_request()\n3698|        self.addCleanup(sock.close)\n3699|        self.assertTrue(\n(more lines below)","final_result":true}}}
