+                return\n487\t+            if acc.startswith(sent):\n488\t+                tail = acc[len(sent) :]\n489\t+            else:\n490\t+                common = 0\n491\t+                for a_ch, b_ch in zip(sent, acc):\n492\t+                    if a_ch != b_ch:\n493\t+                        break\n494\t+                    common += 1\n495\t+                tail = acc[common:]\n496\t+            if not tail:\n497\t+                return\n498\t+            _log(f\"flush_reasoning_before_502 chars={len(tail)}\")\n499\t+            if self._sse_emit(\n500\t+                self._sse_chunk({\"reasoning_content\": tail}),\n501\t+                mark_content=True,\n502\t+                fatal=False,\n503\t+            ):\n504\t+                self._live_sent_text = acc if acc.startswith(sent) else sent + tail\n505\t+                self._live_reasoning_sent = self._live_sent_text\n506\t \n507\t     def _force_close_connection(self) -> None:\n508\t         \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n509\t@@ -2678,6 +2913,9 @@ class Handler(BaseHTTPRequestHandler):\n510\t             self._client_gone = True\n511\t             return False\n512\t         self._live_sent_text = \"\"\n513\t+        self._live_reasoning_sent = \"\"\n514\t+        self._live_degraded = False\n515\t+        self._stream = True\n516\t         self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n517\t         self._sse_created = int(time.time())\n518\t         self._sse_model = model\n519\t@@ -2785,6 +3023,8 @@ class Handler(BaseHTTPRequestHandler):\n520\t         if self._sse_open:\n521\t             # Заголовки 200 уже ушли: ошибка — кадром SSE, как у OpenAI-совместимых прокси.\n522\t             self._sse_stop_keepalive()\n523\t+            if int(code) == 502:\n524\t+                self._flush_reasoning_before_error()\n525\t             error = payload.get(\"error\") if isinstance(payload, dict) else None\n526\t             if isinstance(error, 