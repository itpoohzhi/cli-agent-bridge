и.\n522|             self._sse_stop_keepalive()\n523|+            if int(code) == 502:\n524|+                self._flush_reasoning_before_error()\n525|             error = payload.get(\"error\") if isinstance(payload, dict) else None\n526|             if isinstance(error, dict):\n527|                 error = dict(error)\n528|@@ -2852,6 +3092,11 @@ class Handler(BaseHTTPRequestHandler):\n529|         self._sse_stop_keepalive()\n530|         chunk = self._sse_chunk\n531|         reasoning = \"\\n\\n\".join(s for s in (summaries or []) if s)\n532|+        # S2: единый stream-буфер ServeRun (с маркерами) авторитетен для\n533|+        # live/final — сравнение с _live_sent_text не даёт ложного diverged.\n534|+        accumulated = self._accumulated_reasoning()\n535|+        if accumulated:\n536|+            reasoning = accumulated\n537|         live_sent = getattr(self, \"_live_sent_text\", \"\")\n538|         if reasoning:\n539|             if not live_sent:\n540|@@ -2873,6 +3118,9 @@ class Handler(BaseHTTPRequestHandler):\n541|                 chunk({\"reasoning_content\": tail}), mark_content=True\n542|             ):\n543|                 return\n544|+            if tail:\n545|+                self._live_sent_text = live_sent + tail\n546|+                self._live_reasoning_sent = self._live_sent_text\n547|         for tc in tool_calls:\n548|             fn = tc.get(\"function\") if isinstance(tc.get(\"function\"), dict) else {}\n549|             delta = {\n550|@@ -3002,6 +3250,10 @@ class Handler(BaseHTTPRequestHandler):\n551|         self._exec_deadline = _exec_deadline\n552|         self._write_deadline = _write_deadline\n553|         self._live_sent_text = \"\"\n554|+        self._live_reasoning_sent = \"\"\n555|+        self._live_degraded = False\n556|+        self._current_serve_run = None\n557|+        self._stream = req.get(\"stream\") is True\n558|         self._delivery_failed = False\n559|         _req_done = threading.Event()\n560|         self._req_done = _req_done\n561|@@ -3223,6 +3475,8 @@ class Handler(BaseHTTPRequestHandler):\n562|             if not ok_gate:\n563|                 _log(f\"new serve process blocked reason={gate_reason}\")\n564|                 return _blocked_out(f\"new process blocked: {gate_reason}\"), \"blocked\"\n565|+            # S4: новый ServeRun (в т.ч. ретрай) стартует с чистого live-префикса.\n566|+            self._reset_live_for_attempt()\n567|             serve_run = ServeRun(model, attempt_prompt, effort, WORKSPACE)\n568|             serve_run.exec_deadline = _exec_deadline\n569|             serve_run.write_deadline = _write_deadline\n570|@@ -3231,6 +3485,7 @@ class Handler(BaseHTTPRequestHandler):\n571|                 serve_run.live_sink = self._live_reasoning_sink\n572|             runs.append(serve_run)\n573|             self._current_run = serve_run\n574|+            self._current_serve_run = serve_run\n575|             try:\n576|                 attempt_out = serve_run.execute()\n577|                 _update_agg(serve_run, attempt_out)\n578|diff --git a/tests/test_muse_bridge_killpg.py b/tests/test_muse_bridge_killpg.py\n579|index 0ddc128..7538209 100644\n580|--- a/tests/test_muse_bridge_killpg.py\n581|+++ b/tests/test_muse_bridge_killpg.py\n582|@@ -1565,6 +1565,7 @@ class CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n583|     \"\"\"Реальные argv фейка; транспортный fallback до turn/start сохранён.\"\"\"\n584| \n585|     def test_serve_argv_allows_write_shell_by_default(self) -> None:\n586|+        argv: list[str] = []\n587|         install_protocol_wrapper(self, {\"terminal\": \"completed\"})\n588|         for model in self.mod.ALLOWED_MODELS:\n589|             with self.subTest(model=model):\n590|@@ -1587,6 +1588,7 @@ class CliDisableFlagsAndApprovalFallbackTest(_BridgeScenario):\n591|         # oracle_change (REQ-MUSE-002): approval больше не уходит в exec;\n592|         # проверки exec-флагов сохранены на транспортном ServeUnavailable\n593|         # (EOF рукопожатия до turn/start), approval-контракт — класс Approval.\n594|+        argv: list[str] = []\n595|         install_fake_msp(self, serve_plans=[{\"handshake_eof\": True}])\n596|         for model in self.mod.ALLOWED_MODELS:\n597|             with self.subTest(model=model):\n598|@@ -3876,7 +3878,10 @@ class LiveReasoningTest(_BridgeScenario):\n599|         handler._sse_open = True\n600|         handler._live_sent_text = \"\"\n601|         self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n602|-        self.assertTrue(handler._client_gone)\n603|+        # oracle_change (ADR-0004/S1): live-запись нефатальна — деградация,\n604|+        # а не client_gone/kill; ход продолжается, буфер уйдёт в финале.\n605|+        self.assertTrue(handler._live_degraded)\n606|+        self.assertFalse(handler._client_gone)\n607| \n608|     def test_t_l05_model_retry_scheduled_log_only(self) -> None:\n609|         plan = ok_plan(\n610|@@ -3907,12 +3912,15 @@ class LiveReasoningTest(_BridgeScenario):\n611|         install_fake_msp(self, serve_plans=[plan])\n612|         status, body = bridge_request(self, turn_request(stream=True))\n613|         self.assertEqual(status, 200, body)\n614|-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"ac\\n\\nb\")\n615|+        # oracle_change (ADR-0004/AD-001): без заморозки live — append-only\n616|+        # stream в порядке поступления дельт; монотонность префикса сохранена,\n617|+        # сортировка по idx остаётся только в финальных summaries.\n618|+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nbc\")\n619|         plan = ok_plan({\"summary\": [1, \"b\"]}, {\"summary\": [0, \"a\"]})\n620|         install_fake_msp(self, serve_plans=[plan])\n621|         status, body = bridge_request(self, turn_request(stream=True))\n622|         self.assertEqual(status, 200, body)\n623|-        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\")\n624|+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"b\\n\\na\")\n625| \n626|     def test_t_l07_diverged_snapshot_sends_authoritative_full(self) -> None:\n627|         handler = self.mod.Handler.__new__(self.mod.Handler)\n628|@@ -3968,7 +3976,9 @@ class LiveReasoningTest(_BridgeScenario):\n629|         started = time.monotonic()\n630|         self.assertFalse(handler._live_reasoning_sink(\"thinking\"))\n631|         self.assertLess(time.monotonic() - started, 1.0)\n632|-        self.assertTrue(handler._client_gone)\n633|+        # oracle_change (ADR-0004/S1): таймаут live-записи — деградация, не kill.\n634|+        self.assertTrue(handler._live_degraded)\n635|+        self.assertFalse(handler._client_gone)\n636| \n637|     def test_t_l08b_keepalive_blocking_first_bounds_sink(self) -> None:\n638|         self.mod.LIVE_WRITE_TIMEOUT_S = 0.25\n639|@@ -4041,5 +4051,187 @@ class LiveReasoningTest(_BridgeScenario):\n640|         self.assertNotIn(b'\"finish_reason\": \"stop\"', writer.getvalue())\n641| \n642| \n643|+class LiveStreamingAllStepsTest(_BridgeScenario):\n644|+    \"\"\"ADR-0004/AD-001: непрерывный стриминг summary.0..N без заморозки.\"\"\"\n645|+\n646|+    def test_all_summary_steps_stream_live_without_freeze(self) -> None:\n647|+        plan = ok_plan(\n648|+            {\"summary\": [0, \"step0-\"]},\n649|+            {\"summary\": [1, \"step1-\"]},\n650|+            {\"summary\": [2, \"step2\"]},\n651|+            {\"summary\": [0, \"tail0\"]},\n652|+        )\n653|+        install_fake_msp(self, serve_plans=[plan])\n654|+        snapshots: list[str] = []\n655|+        run = self.mod.ServeRun(\"muse-spark-1.3\", \"p\", \"max\", self.tmp / \"workspace\")\n656|+        run.live_sink = lambda text: snapshots.append(text) or True\n657|+        out = run.execute()\n658|+        self.assertEqual(out[\"state\"], \"ok\", out)\n659|+        self.assertFalse(run._live_frozen)\n660|+        # Аккумулятор по составному ключу (item_id, idx) + инкрементные длины.\n661|+        self.assertEqual(run._reasoning_items[(\"r1\", 0)], \"step0-tail0\")\n662|+        self.assertEqual(run._reasoning_items[(\"r1\", 1)], \"step1-\")\n663|+        self.assertEqual(run._reasoning_items[(\"r1\", 2)], \"step2\")\n664|+        self.assertEqual(run._item_lengths[(\"r1\", 0)], len(\"step0-tail0\"))\n665|+        self.assertEqual(run._item_lengths[(\"r1\", 2)], len(\"step2\"))\n666|+        acc = run.get_accumulated_reasoning()\n667|+        for piece in (\"step0-\", \"step1-\", \"step2\", \"tail0\"):\n668|+            self.assertIn(piece, acc)\n669|+        # Каждый снимок sink монотонно расширяет предыдущий, шаги 1..N видны\n670|+        # до финала (не одним блоком в конце).\n671|+        self.assertGreaterEqual(len(snapshots), 4)\n672|+        for prev, cur in zip(snapshots, snapshots[1:]):\n673|+            self.assertTrue(cur.startswith(prev), (prev, cur))\n674|+        self.assertTrue(any(\"step1-\" in s for s in snapshots[:-1]))\n675|+\n676|+    def test_stream_concat_includes_all_steps_via_http(self) -> None:\n677|+        plan = ok_plan(\n678|+            {\"summary\": [0, \"a\"]},\n679|+            {\"summary\": [1, \"b\"]},\n680|+            {\"summary\": [2, \"c\"]},\n681|+        )\n682|+        install_fake_msp(self, serve_plans=[plan])\n683|+        status, body = bridge_request(self, turn_request(stream=True))\n684|+        self.assertEqual(status, 200, body)\n685|+        self.assertEqual(\"\".join(sse_deltas(body, \"reasoning_content\")), \"a\\n\\nb\\n\\nc\")\n686|+        self.assertNotIn(\"reasoning_diverged\", self.mod.LOG_PATH.read_text())\n687|+\n688|+\n689|+class ToolCallMarkersTest(_BridgeScenario):\n690|+    \"\"\"ADR-0004/AD-002: маркеры инструментов и строгая санитизация.\"\"\"\n691|+\n692|+    def test_sanitize_tool_name(self) -> None:\n693|+        sanitize = self.mod._sanitize_tool_name\n694|+        self.assertEqual(sanitize(\"bash\"), \"bash\")\n695|+        self.assertEqual(sanitize(\"muse.bash:run-1_2\"), \"muse.bash:run-1_2\")\n696|+        self.assertEqual(sanitize(\"a/b c\"), \"a_b_c\")\n697|+        self.assertEqual(sanitize(\"x]\\n[evil\"), \"x___evil\")\n698|+        self.assertEqual(sanitize(\"\"), \"tool\")\n699|+        self.assertEqual(sanitize(None), \"tool\")\n700|+        self.assertEqual(sanitize(123), \"tool\")\n701|+        self.assertEqual(len(sanitize(\"a\" * 100)), 64)\n702|+\n703|+    def test_tool_markers_only_in_stream(self) -> None:\n704|+        plan = ok_plan(\n705|+            {\"summary\": [0, \"think\"]},\n706|+            {\"tool_item\": {\"kind\": \"toolCall\", \"toolName\": \"web_search\"}},\n707|+            {\"summary\": [0, \"-done\"]},\n708|+        )\n709|+        install_fake_msp(self, serve_plans=[plan])\n710|+        status, body = bridge_request(self, turn_request(stream=True))\n711|+        self.assertEqual(status, 200, body)\n712|+        joined = \"\".join(sse_deltas(body, \"reasoning_content\"))\n713|+        self.assertIn(\"\\n\\n[Вызов инструмента: web_search]\\n\", joined)\n714|+        self.assertIn(\"\\n[Инструмент web_search завершён]\\n\", joined)\n715|+        self.assertLess(joined.index(\"[Вызов инструмента:\"), joined.index(\"завершён]\"))\n716|+        self.assertIn(\"think\", joined)\n717|+        self.assertIn(\"-done\", joined)\n718|+        # S2: маркеры в live не вызывают ложный diverged и повторный полный текст.\n719|+        self.assertNotIn(\"reasoning_diverged\", self.mod.LOG_PATH.read_text())\n720|+        self.assertEqual(joined.count(\"think\"), 1)\n721|+        install_fake_msp(self, serve_plans=[plan])\n722|+        status, body = bridge_request(self, turn_request())\n723|+        self.assertEqual(status, 200, body)\n724|+        self.assertNotIn(\"Вызов инструмента\", body.decode(\"utf-8\"))\n725|+        self.assertEqual(json.loads(body)[\"reasoning_summaries\"], [\"think-done\"])\n726|+\n727|+    def test_tool_marker_name_sanitized_in_stream(self) -> None:\n728|+        plan = ok_plan({\"tool_item\": {\"kind\": \"toolCall\", \"toolName\": \"a/b]evil name\"}})\n729|+        install_fake_msp(self, serve_plans=[plan])\n730|+        status, body = bridge_request(self, turn_request(stream=True))\n731|+        self.assertEqual(status, 200, body)\n732|+        joined = \"\".join(sse_deltas(body, \"reasoning_content\"))\n733|+        self.assertIn(\"[Вызов инструмента: a_b_evil_name]\", joined)\n734|+        self.assertNotIn(\"a/b]evil\", joined)\n735|+\n736|+\n737|+class TimeoutReasoningFlushTest(_BridgeScenario):\n738|+    \"\"\"ADR-0004/AD-003+S1/S4: flush перед 502, нефатальная деградация, ретрай.\"\"\"\n739|+\n740|+    def _handler(self) -> Any:\n741|+        handler = self.mod.Handler.__new__(self.mod.Handler)\n742|+        handler._wlock = threading.Lock()\n743|+        handler.wfile = io.BytesIO()\n744|+        handler._sse_open = True\n745|+        handler._stream = True\n746|+        handler._live_sent_text = \"\"\n747|+        handler._live_degraded = False\n748|+        handler._client_gone = False\n749|+        handler._write_deadline = float(\"inf\")\n750|+        return handler\n751|+\n752|+    def test_flush_reasoning_before_502_error_frame(self) -> None:\n753|+        handler = self._handler()\n754|+        handler._live_sent_text = \"think-\"\n755|+        handler._current_serve_run = SimpleNamespace(\n756|+            get_accumulated_reasoning=lambda: \"think-more-and-more\"\n757|+        )\n758|+        handler._send(502, {\"error\": {\"message\": \"boom\", \"type\": \"proxy_error\"}})\n759|+        raw = handler.wfile.getvalue()\n760|+        self.assertEqual(sse_deltas(raw, \"reasoning_content\"), [\"more-and-more\"])\n761|+        text = raw.decode(\"utf-8\")\n762|+        self.assertLess(text.index(\"more-and-more\"), text.index('\"error\"'))\n763|+        self.assertIn(\"data: [DONE]\", text)\n764|+        self.assertEqual(handler._live_sent_text, \"think-more-and-more\")\n765|+\n766|+    def test_no_flush_for_503_without_run(self) -> None:\n767|+        handler = self._handler()\n768|+        handler._current_serve_run = None\n769|+        handler._current_run = None\n770|+        handler._send(503, {\"error\": {\"message\": \"bridge busy\"}})\n771|+        self.assertEqual(sse_deltas(handler.wfile.getvalue(), \"reasoning_content\"), [])\n772|+\n773|+    def test_slow_socket_live_write_degrades_without_kill(self) -> None:\n774|+        handler = self._handler()\n775|+        killed: list[bool] = []\n776|+        handler._current_run = SimpleNamespace(close=lambda: killed.append(True))\n777|+\n778|+        class TimeoutWriter(io.BytesIO):\n779|+            def write(self, data):  # type: ignore[override]\n780|+                raise TimeoutError(\"socket timeout\")\n781|+\n782|+        handler.wfile = TimeoutWriter()\n783|+        self.assertFalse(handler._sse_write(\"data: x\\n\\n\", fatal=False))\n784|+        self.assertTrue(handler._live_degraded)\n785|+        self.assertFalse(handler._client_gone)\n786|+        self.assertEqual(killed, [])\n787|+        # Sink после деградации не блокирует reader повторными записями.\n788|+        self.assertTrue(handler._live_reasoning_sink(\"thinking-more\"))\n789|+        # Фатальный режим по умолчанию сохраняет прежний контракт.\n790|+        handler2 = self._handler()\n791|+        killed2: list[bool] = []\n792|+        handler2._current_run = SimpleNamespace(close=lambda: killed2.append(True))\n793|+        handler2.wfile = TimeoutWriter()\n794|+        self.assertFalse(handler2._sse_write(\"data: x\\n\\n\"))\n795|+        self.assertTrue(handler2._client_gone)\n796|+        self.assertEqual(killed2, [True])\n797|+\n798|+    def test_final_sse_delivers_buffer_after_live_degraded(self) -> None:\n799|+        handler = self._handler()\n800|+        handler._live_degraded = True\n801|+        handler._current_serve_run = SimpleNamespace(\n802|+            get_accumulated_reasoning=lambda: \"buffered-thoughts\"\n803|+        )\n804|+        handler._send_sse(\"muse-spark-1.3\", \"hello\", [], 1, 1, 0, [\"buffered-thoughts\"])\n805|+        raw = handler.wfile.getvalue()\n806|+        self.assertEqual(sse_deltas(raw, \"reasoning_content\"), [\"buffered-thoughts\"])\n807|+        self.assertIn(b\"data: [DONE]\", raw)\n808|+\n809|+    def test_reset_live_for_retry_attempt(self) -> None:\n810|+        handler = self._handler()\n811|+        handler._live_sent_text = \"old-prefix\"\n812|+        handler._live_reasoning_sent = \"old-prefix\"\n813|+        handler._live_degraded = True\n814|+        handler._reset_live_for_attempt()\n815|+        self.assertEqual(handler._live_sent_text, \"\")\n816|+        self.assertEqual(handler._live_reasoning_sent, \"\")\n817|+        self.assertFalse(handler._live_degraded)\n818|+        self.assertTrue(handler._live_reasoning_sink(\"fresh\"))\n819|+        self.assertEqual(\n820|+            sse_deltas(handler.wfile.getvalue(), \"reasoning_content\"),\n821|+            [\"fresh\"],\n822|+        )\n823|+\n824|+\n825| if __name__ == \"__main__\":\n826|     unittest.main(verbosity=2)\n827|\n828|```","final_result":true}}}
