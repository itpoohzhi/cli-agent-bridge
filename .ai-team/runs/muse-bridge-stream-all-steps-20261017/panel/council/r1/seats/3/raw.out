{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a14a03-1977-7a32-a353-e785b5fc2c28"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"01a14a03-1d8a-78f2-a14c-7748c006563c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14a03-1d8a-78f2-a14c-7748c006563c","run_stream":{"kind":"run","id":"01a14a03-1d8a-78f2-a14c-7748c006563c"},"call_id":"call_01a14a03cde973128279aa46dcdf28e8","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(1814 line(s) above)\n1815|        self.user_input_cancel_count = 0\n1816|        self.ceiling_seen = False\n1817|        self.server_version = \"?\"\n1818|        self.last_error_text = \"\"\n1819|        self.live_sink: Any = None\n1820|        self.exec_deadline = float(\"inf\")\n1821|        self.write_deadline = float(\"inf\")\n1822|        self.request_deadline = float(\"inf\")\n1823|        self.turn_started_at: float | None = None\n1824|        self._live_frozen = False\n1825|        # Сквозной live-стриминг всех шагов (ADR-0004): аккумулятор по\n1826|        # составному ключу (item_id, idx), единый append-only stream-текст\n1827|        # для live/final/flush (S2), доступ — только под _acc_lock (S3).\n1828|        self._acc_lock = threading.Lock()\n1829|        self._reasoning_items: dict[tuple[str, int], str] = {}\n1830|        self._item_lengths: dict[tuple[str, int], int] = {}\n1831|        self._reasoning_order: list[tuple[str, int]] = []\n1832|        self._stream_text = \"\"\n1833|        self._tool_names: dict[str, str] = {}\n1834|        self._tool_started: set[str] = set()\n1835|        self._tool_completed: set[str] = set()\n1836|\n1837|    def get_accumulated_reasoning(self) -> str:\n1838|        \"\"\"Потокобезопасный снимок накопленного reasoning (AD-003, S3).\n1839|\n1840|        Единый append-only stream-текст: дельты summary.* в порядке\n1841|        поступления + live-маркеры инструментов (только при stream).\n1842|        Тот же текст — база live, финала `_send_sse` и flush перед 502.\n1843|        \"\"\"\n1844|        with self._acc_lock:\n1845|            if self._stream_text:\n1846|                return self._stream_text\n1847|            return \"\\n\\n\".join(\n1848|                self._reasoning_items[key]\n1849|                for key in self._reasoning_order\n1850|                if self._reasoning_items.get(key)\n1851|            )\n1852|\n1853|    def _accumulate_reasoning(self, item_id: str, idx: int, piece: str) -> str:\n1854|        \"\"\"Добавить дельту в аккумулятор (item_id, idx); вернуть stream-текст.\"\"\"\n1855|        with self._acc_lock:\n1856|            key = (item_id, idx)\n1857|            is_new = key not in self._reasoning_items\n1858|            self._reasoning_items[key] = self._reasoning_items.get(key, \"\") + piece\n1859|            self._item_lengths[key] = len(self._reasoning_items[key])\n1860|            if is_new:\n1861|                self._reasoning_order.append(key)\n1862|                if self._stream_text and not self._stream_text.endswith(\"\\n\"):\n1863|                    self._stream_text += \"\\n\\n\"\n1864|            self._stream_text += piece\n1865|            return self._stream_text\n1866|\n1867|    def _accumulate_completed_summary(self, item_id: str, idx: int, full: str) -> str:\n1868|        \"\"\"Сверить завершённый summary[idx] с аккумулятором; дослать хвост.\"\"\"\n1869|        with self._acc_lock:\n1870|            key = (item_id, idx)\n1871|            existing = self._reasoning_items.get(key, \"\")\n1872|            if full == existing:\n1873|                return self._stream_text\n1874|            is_new = key not in self._reasoning_items\n1875|            self._reasoning_items[key] = full\n1876|            self._item_lengths[key] = len(full)\n1877|            if is_new:\n1878|                self._reasoning_order.append(key)\n1879|                if self._stream_text and not self._stream_text.endswith(\"\\n\"):\n1880|                    self._stream_text += \"\\n\\n\"\n1881|                self._stream_text += full\n1882|            elif full.startswith(existing):\n1883|                self._stream_text += full[len(existing) :]\n1884|            return self._stream_text\n1885|\n1886|    def _emit_live(self) -> None:\n1887|        \"\"\"Отправить текущий stream-текст в live_sink; сбой не замораживает ход.\"\"\"\n1888|        sink = self.live_sink\n1889|        if sink is None:\n1890|            return\n1891|        with self._acc_lock:\n1892|            snapshot = self._stream_text\n1893|        if not snapshot:\n1894|            return\n1895|        try:\n1896|            sink(snapshot)\n1897|        except Exception:  # noqa: BLE001, S110\n1898|            pass\n1899|\n1900|    def _emit_tool_marker(self, item_id: str, marker: str) -> None:\n1901|        \"\"\"Дописать маркер инструмента в stream-текст и отправить live (AD-002).\"\"\"\n1902|        del item_id\n1903|        if self.live_sink is None:\n1904|            return\n1905|        with self._acc_lock:\n1906|            self._stream_text += marker\n1907|        self._emit_live()\n1908|\n1909|    def close(self) -> None:\n1910|        \"\"\"Убить группу процессов хода и коротко дождаться её ухода (идемпотентно).\"\"\"\n1911|        proc = self.proc\n1912|        if proc is None:\n1913|            return\n1914|        _terminate_run(self, (proc.stdin, proc.stdout, proc.stderr))\n1915|\n1916|    def _control_limit(self) -> float:\n1917|        limit = min(\n1918|            self._write_until,\n1919|            time.monotonic() + CONTROL_WRITE_TIMEOUT_S,\n1920|            self.exec_deadline,\n1921|        )\n1922|        if self.grace_end is not None:\n1923|            limit = min(limit, self.grace_end)\n1924|        return limit\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c479","stream":{"kind":"session","id":"01a14a03-1977-7a32-a353-e785b5fc2c28"},"sequence":151,"recorded_at":1780531400000297,"record_type":"event","durability":"durable","causation_id":"01a14a03-1d8a-78f2-a14c-7748c006563c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a14a03-1d8a-78f2-a14c-7748c006563c","run_stream":{"kind":"run","id":"01a14a03-1d8a-78f2-a14c-7748c006563c"},"call_id":"call_01a14a03d0f47742b152173abce1d2cc","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/bridges/muse-bridge/server.py`.\n(2689 line(s) above)\n2690|        self._request_deadline = float(\"inf\")\n2691|        self._delivery_failed = False\n2692|        self._req_done = None\n2693|        super().setup()\n2694|\n2695|    def _get_live_lock(self) -> threading.Lock:\n2696|        \"\"\"Замок live-состояния; лениво для Handler без setup() в тестах.\"\"\"\n2697|        lock = self.__dict__.get(\"_live_lock\")\n2698|        if lock is None:\n2699|            lock = threading.Lock()\n2700|            self._live_lock = lock\n2701|        return lock\n2702|\n2703|    def _reset_live_for_attempt(self) -> None:\n2704|        \"\"\"Сброс live-префикса перед новым ServeRun в ретрае (S4).\"\"\"\n2705|        with self._get_live_lock():\n2706|            self._live_sent_text = \"\"\n2707|            self._live_reasoning_sent = \"\"\n2708|            self._live_degraded = False\n2709|\n2710|    def _note_write_failure(self, fatal: bool, message: str) -> bool:\n2711|        \"\"\"Сбой записи SSE: fatal — клиент ушёл+kill; иначе live-деградация (S1).\"\"\"\n2712|        if not fatal:\n2713|            if not getattr(self, \"_live_degraded\", False):\n2714|                _log(f\"live_degraded {message}\")\n2715|            self._live_degraded = True\n2716|            return False\n2717|        if not self._client_gone:\n2718|            self._client_gone = True\n2719|            self._delivery_failed = True\n2720|            _log(message)\n2721|            self._kill_current_run()\n2722|        return False\n2723|\n2724|    # ---- ранний SSE: заголовки сразу, keepalive во время хода ---------------------\n2725|    def _sse_write(\n2726|        self,\n2727|        data: str,\n2728|        fatal: bool = True,\n2729|        *,\n2730|        keepalive: bool = False,\n2731|        mark_content: bool = False,\n2732|    ) -> bool:\n2733|        \"\"\"Один ограниченный бюджет L=min(s+LIVE_WRITE_TIMEOUT_S, W) (AD-004).\n2734|\n2735|        Ожидание замка, запись и flush делят единый остаток. При\n2736|        `fatal=True` исчерпание = зависший клиент (client_gone + killpg).\n2737|        При `fatal=False` (live reasoning, S1) сбой лишь ставит\n2738|        `_live_degraded`: ход ServeRun не убивается, буфер уйдёт в финале.\n2739|        \"\"\"\n2740|        text = data\n2741|        started = time.monotonic()\n2742|        w_deadline = getattr(self, \"_write_deadline\", float(\"inf\"))\n2743|        limit = min(started + LIVE_WRITE_TIMEOUT_S, w_deadline)\n2744|        if limit <= started:\n2745|            return self._note_write_failure(\n2746|                fatal, \"delivery_deadline write budget exhausted before frame\"\n2747|            )\n2748|        if not self._wlock.acquire(timeout=max(0.0, limit - time.monotonic())):\n2749|            return self._note_write_failure(\n2750|                fatal, \"client gone mid-stream (sse lock wait budget)\"\n2751|            )\n2752|        try:\n2753|            if self._sse_phase == \"CLOSED\" or self._client_gone:\n2754|                return False\n2755|            if keepalive and (\n2756|                self._sse_phase != \"OPEN\"\n2757|                or (self._keepalive_stop is not None and self._keepalive_stop.is_set())\n2758|            ):\n2759|                return False\n2760|            if time.monotonic() >= limit:\n2761|                raise TimeoutError(\"sse write budget exhausted\")\n2762|            if mark_content:\n2763|                self._content_started = True\n2764|            conn = getattr(self, \"connection\", None)\n2765|            prev_timeout: Any = None\n2766|            have_conn = False\n2767|            if conn is not None and hasattr(conn, \"settimeout\"):\n2768|                try:\n2769|                    prev_timeout = conn.gettimeout()\n2770|                    conn.settimeout(max(0.001, limit - time.monotonic()))\n2771|                    have_conn = True\n2772|                except (OSError, ValueError, AttributeError):\n2773|                    have_conn = False\n2774|            try:\n2775|                self.wfile.write(text.encode(\"utf-8\"))\n2776|                if have_conn:\n2777|                    try:\n2778|                        conn.settimeout(max(0.001, limit - time.monotonic()))\n2779|                    except (OSError, ValueError, AttributeError):\n2780|                        pass\n2781|                self.wfile.flush()\n2782|            finally:\n2783|                if text == \"data: [DONE]\\n\\n\":\n2784|                    self._sse_phase = \"CLOSED\"\n2785|                if have_conn:\n2786|                    try:\n2787|                        conn.settimeout(prev_timeout)\n2788|                    except (OSError, ValueError, AttributeError):\n2789|                        pass\n2790|            return True\n2791|        except (BrokenPipeError, ConnectionResetError, OSError):\n2792|            return self._note_write_failure(fatal, \"client gone mid-stream\")\n2793|        finally:\n2794|            self._wlock.release()\n2795|\n2796|    def _sse_chunk(self, delta: dict, finish_reason: Any = None) -> dict:\n2797|        return {\n2798|            \"id\": self._sse_id,\n2799|            \"object\": \"chat.completion.chunk\",\n2800|            \"created\": self._sse_created,\n2801|            \"model\": self._sse_model,\n2802|            \"choices\": [{\"index\": 0, \"delta\": delta, \"finish_reason\": finish_reason}],\n2803|        }\n2804|\n2805|    def _sse_emit(\n2806|        self,\n2807|        obj: dict,\n2808|        *,\n2809|        keepalive: bool = False,\n2810|        mark_content: bool = False,\n2811|        fatal: bool = True,\n2812|    ) -> bool:\n2813|        return self._sse_write(\n2814|            \"data: \" + json.dumps(obj, ensure_ascii=False) + \"\\n\\n\",\n2815|            fatal,\n2816|            keepalive=keepalive,\n2817|            mark_content=mark_content,\n2818|        )\n2819|\n2820|    def _live_reasoning_sink(self, full_text: str) -> bool:\n2821|        \"\"\"Sink ServeRun: публикует прирост всего stream-текста (summary.*+маркеры).\n2822|\n2823|        Запись нефатальна (S1): при сбое `_live_degraded=True`, ход жив,\n2824|        повторные вызовы коротко возвращают True, буфер уйдёт в финале.\n2825|        \"\"\"\n2826|        if not full_text or not getattr(self, \"_sse_open\", False):\n2827|            return True\n2828|        if getattr(self, \"_live_degraded\", False):\n2829|            return True\n2830|        with self._get_live_lock():\n2831|            sent = getattr(self, \"_live_sent_text\", \"\")\n2832|            if full_text == sent or not full_text.startswith(sent):\n2833|                return True\n2834|            delta = full_text[len(sent) :]\n2835|            if not delta:\n2836|                return True\n2837|            ok = self._sse_emit(\n2838|                self._sse_chunk({\"reasoning_content\": delta}),\n2839|                mark_content=True,\n2840|                fatal=False,\n2841|            )\n2842|            if ok:\n2843|                self._live_sent_text = full_text\n2844|                self._live_reasoning_sent = full_text\n2845|            else:\n2846|                self._live_degraded = True\n2847|            return ok\n2848|\n2849|    def _accumulated_reasoning(self) -> str:\n2850|        \"\"\"Накопленный reasoning текущего ServeRun или пустая строка.\"\"\"\n2851|        run = getattr(self, \"_current_serve_run\", None) or getattr(\n2852|            self, \"_current_run\", None\n2853|        )\n2854|        getter = getattr(run, \"get_accumulated_reasoning\", None)\n2855|        if run is None or not callable(getter):\n2856|            return \"\"\n2857|        try:\n2858|            acc = getter()\n2859|        except Exception:  # noqa: BLE001\n2860|            return \"\"\n2861|        return acc if isinstance(acc, str) else \"\"\n2862|\n2863|    def _flush_reasoning_before_error(self) -> None:\n2864|        \"\"\"Опережающий сброс неотправленного reasoning перед 502 (AD-003).\"\"\"\n2865|        if not (getattr(self, \"_sse_open\", False) or getattr(self, \"_stream\", False)):\n2866|            return\n2867|        acc = self._accumulated_reasoning()\n2868|        if not acc:\n2869|            return\n2870|        with self._get_live_lock():\n2871|            sent = getattr(self, \"_live_sent_text\", \"\")\n2872|            if acc == sent or sent.startswith(acc):\n2873|                return\n2874|            if acc.startswith(sent):\n2875|                tail = acc[len(sent) :]\n2876|            else:\n2877|                common = 0\n2878|                for a_ch, b_ch in zip(sent, acc):\n2879|                    if a_ch != b_ch:\n2880|                        break\n2881|                    common += 1\n2882|                tail = acc[common:]\n2883|            if not tail:\n2884|                return\n2885|            _log(f\"flush_reasoning_before_502 chars={len(tail)}\")\n2886|            if self._sse_emit(\n2887|                self._sse_chunk({\"reasoning_content\": tail}),\n2888|                mark_content=True,\n2889|                fatal=False,\n2890|            ):\n2891|                self._live_sent_text = acc if acc.startswith(sent) else sent + tail\n2892|                self._live_reasoning_sent = self._live_sent_text\n2893|\n2894|    def _force_close_connection(self) -> None:\n2895|        \"\"\"Закрытие соединения надзором W без ожидания _wlock (a4).\"\"\"\n2896|        self._client_gone = True\n2897|        conn = getattr(self, \"connection\", None)\n2898|        if conn is None:\n2899|            return\n2900|        try:\n2901|            conn.shutdown(socket.SHUT_RDWR)\n2902|        except (OSError, ValueError, AttributeError):\n2903|            pass\n2904|        try:\n2905|            conn.close()\n2906|        except (OSError, ValueError, AttributeError):\n2907|            pass\n2908|\n2909|    def _sse_begin(self, model: str) -> bool:\n2910|        \"\"\"Заголовки 200 + role-кадр до запуска хода и поток keepalive; False — клиент ушёл.\"\"\"\n2911|        if time.monotonic() >= getattr(self, \"_write_deadline\", float(\"inf\")):\n2912|            self._delivery_failed = True\n2913|            self._client_gone = True\n2914|            return False\n2915|        self._live_sent_text = \"\"\n2916|        self._live_reasoning_sent = \"\"\n2917|        self._live_degraded = False\n2918|        self._stream = True\n2919|        self._sse_id = f\"chatcmpl-muse-{uuid.uuid4().hex[:12]}\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
