dge_killpg.py -k 'LiveReasoning'\",\n129|        \"expected\": \"passed\"\n130|      },\n131|      \"verification_ids\": [\n132|        \"VER-001\"\n133|      ]\n134|    },\n135|    {\n136|      \"id\": \"AD-002\",\n137|      \"status\": \"APPROVED\",\n138|      \"kind\": \"two-way\",\n139|      \"question\": \"Как информировать пользователя о вызове инструментов в UI DSH (REQ-002)?\",\n140|      \"choice\": \"Транслировать текстовые маркеры прогресса запуска и завершения инструментов в reasoning_content для немедленной видимости в UI DSH\",\n141|      \"alternatives\": [\n142|        \"Не отправлять статусы инструментов\",\n143|        \"Отправлять незаконченные дельты tool_calls\"\n144|      ],\n145|      \"drivers\": [\n146|        \"REQ-002\",\n147|        \"EVD-005\"\n148|      ],\n149|      \"consequences\": [\n150|        \"Пользователь видит текущую выполняемую команду в UI\",\n151|        \"В reasoning_content попадают статусные строки инструментов\"\n152|      ],\n153|      \"approval_required\": false,\n154|      \"confirmation\": {\n155|        \"kind\": \"test\",\n156|        \"command\": \"pytest tests/test_muse_bridge_killpg.py -k 'ToolCall'\",\n157|        \"expected\": \"passed\"\n158|      },\n159|      \"verification_ids\": [\n160|        \"VER-001\"\n161|      ]\n162|    },\n163|    {\n164|      \"id\": \"AD-003\",\n165|      \"status\": \"APPROVED\",\n166|      \"kind\": \"two-way\",\n167|      \"question\": \"Как сохранять контекст рассуждений при сбоях и таймаутах (REQ-003)?\",\n168|      \"choice\": \"Перед отправкой кадра error в _send(502) отдавать накопленные summaries в поток SSE\",\n169|      \"alternatives\": [\n170|        \"Сбрасывать соединение без отдачи мыслей\",\n171|        \"Не слать ошибку\"\n172|      ],\n173|      \"drivers\": [\n174|        \"REQ-003\",\n175|        \"EVD-006\"\n176|      ],\n177|      \"consequences\": [\n178|        \"Пользователь сохраняет контекст рассуждений при сбоях и таймаутах\",\n179|        \"Дополнительная отправка чанка перед закрытием\"\n180|      ],\n181|      \"approval_required\": false,\n182|      \"confirmation\": {\n183|        \"kind\": \"test\",\n184|        \"command\": \"pytest tests/test_muse_bridge_killpg.py -k 'TimeoutReasoning'\",\n185|        \"expected\": \"passed\"\n186|      },\n187|      \"verification_ids\": [\n188|        \"VER-002\"\n189|      ]\n190|    }\n191|  ],\n192|  \"quality_scenarios\": [\n193|    {\n194|      \"id\": \"QA-001\",\n195|      \"quality\": \"performance\",\n196|      \"source\": \"Пользователь DSH\",\n197|      \"stimulus\": \"Генерация моделью длинных шагов рассуждений summary.0..N\",\n198|      \"environment\": \"Рабочий мост muse-bridge под нагрузкой\",\n199|      \"artifact\": \"bridges/muse-bridge/server.py\",\n200|      \"response\": \"Каждый поступивший фрагмент мысли отправляется в SSE без задержек\",\n201|      \"response_measure\": \"Задержка доставки дельты reasoning < 100 мс\",\n202|      \"verification_ids\": [\n203|        \"VER-001\"\n204|      ]\n205|    },\n206|    {\n207|      \"id\": \"QA-002\",\n208|      \"quality\": \"reliability\",\n209|      \"source\": \"Дедлайн хода\",\n210|      \"stimulus\": \"Превышение TIMEOUT_S при выполнении 150+ инструментов\",\n211|      \"environment\": \"Длительный ход модели\",\n212|      \"artifact\": \"bridges/muse-bridge/server.py\",\n213|      \"response\": \"Накопленные мысли передаются в SSE перед завершением соединения\",\n214|      \"response_measure\": \"Число потерянных символов reasoning = 0\",\n215|      \"verification_ids\": [\n216|        \"VER-002\"\n217|      ]\n218|    }\n219|  ],\n220|  \"boundaries\": [\n221|    {\n222|      \"id\": \"BND-001\",\n223|      \"component\": \"ServeRun._handle_event\",\n224|      \"responsibility\": \"Разбор JSON-RPC событий serve и диспетчеризация дельт в live_sink\",\n225|      \"allowed_dependencies\": [\n226|        \"json\",\n227|        \"time\",\n228|        \"logging\",\n229|        \"typing\"\n230|    