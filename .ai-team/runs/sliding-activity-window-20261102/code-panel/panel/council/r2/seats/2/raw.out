{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NaoFiTVC6RnieCWLwKFG3m","type":"tool_result","content":"98:DEFAULT_IDLE_TIMEOUT_S = 300.0\n99:DEFAULT_TOTAL_TIMEOUT_S = 420.0\n100:DEFAULT_SAFETY_CAP_S = 3600.0\n179:    idle_timeout_s: float = DEFAULT_IDLE_TIMEOUT_S\n180:    total_timeout_s: float = DEFAULT_TOTAL_TIMEOUT_S\n181:    safety_cap_s: float = DEFAULT_SAFETY_CAP_S\n225:                env, \"BRIDGE_IDLE_TIMEOUT_S\", DEFAULT_IDLE_TIMEOUT_S\n228:                env, \"BRIDGE_TOTAL_TIMEOUT_S\", DEFAULT_TOTAL_TIMEOUT_S\n231:                env, \"BRIDGE_SAFETY_CAP_S\", DEFAULT_SAFETY_CAP_S\n        headers: Mapping[str, str],\n        sink: ResponseSink,\n    ) -> None:\n        \"\"\"Один запрос: байты тела уходят upstream без мутаций, ответ пишется в `sink`.\"\"\"\n        deadline = time.monotonic() + self.limits.total_timeout_s\n        queue_timeout = min(\n            float(getattr(self.host, \"QUEUE_TIMEOUT_S\", DEFAULT_QUEUE_TIMEOUT_S)),\n            self.limits.total_timeout_s,\n        )\n        if not self._slots.acquire(timeout=queue_timeout):\n            self._fail(sink, 503, \"overloaded\", \"passthrough backend is saturated\")\n            return\n        with self._lock:\n            self._active += 1\n        conn: Optional[http.client.HTTPConnection] = None\n        transport: list[socket.socket] = []\n        stop = threading.Event()\n\n        def abort() -> None:\n            for sock in transport:\n                try:\n                    sock.shutdown(socket.SHUT_RDWR)\n                except OSError:\n                    continue\n\n        streaming = threading.Event()\n\n        def watch() -> None:\n            # После начала SSE срок жизни держит скользящее окно ридера (idle + safety cap).\n            while True:\n                interval = self.limits.poll_interval_s\n                if not streaming.is_set():\n                    interval = min(interval, max(0.0, deadline - time.monotonic()))\n                if stop.wait(interval):\n                    return\n                if (\n                    not streaming.is_set() and time.monotonic() >= deadline\n                ) or sink.client_gone():\n                    abort()\n                    return\n\n        watcher = threading.Thread(\n            target=watch, daemon=True, name=\"passthrough-deadline\"\n        )\n        watcher.start()\n        try:\n            try:\n                conn = self._open(\n                    path,\n                    raw_body,\n                    headers,\n                    deadline=deadline,\n                    on_socket=transport.append,\n                    presend_deadline=getattr(sink, \"presend_deadline\", None),\n                )\n                if sink.client_gone():\n                    raise ClientGone()\n                if time.monotonic() >= deadline:\n                    raise TimeoutError()\n                resp = conn.getresponse()\n                if time.monotonic() >= deadline:\n                        \"upstream_timeout\",\n                        \"upstream did not respond in time\",\n                    )\n                else:\n                    self._fail(\n                        sink, 502, \"upstream_unavailable\", \"upstream is unavailable\"\n                    )\n                return\n            content_type = (resp.getheader(\"Content-Type\") or \"\").lower()\n            is_stream = resp.status == 200 and \"text/event-stream\" in content_type\n            if is_stream:\n                streaming.set()\n            self._respond(resp, request, sink, None if is_stream else deadline)\n        except ClientGone:\n            self._log(\"passthrough client_gone\")\n        finally:\n            stop.set()\n            abort()\n    trusted_tools: bool = False,\n    state: StreamOutcome | None = None,\n    deadline: float | None = None,\n) -> StreamOutcome:\n    \"\"\"Пробросить SSE-поток upstream клиенту с санитизацией `tool_calls` (AD-005).\n\n    Исходный порядок событий сохраняется; единственное изменение — вызовы choice выходят\n    одним кадром прямо перед терминальным чанком своей choice, после санитизации.\n    \"\"\"\n    reader = _TimedSseReader(\n        readline,\n        write,\n        limits,\n        deadline,\n    )\n    outcome = state if state is not None else StreamOutcome()\n    client_write = write\n\n    def write(frame: bytes) -> None:\n        \"\"\"До вызова sink: даже частичная запись запрещает повтор запроса.\"\"\"\n        outcome.committed = True\n1072:def test_passthrough_safety_limits_defaults_and_env() -> None:\n1073-    assert PassthroughLimits().safety_cap_s == 3600.0\n1074-    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\n1075-    assert (\n1076-        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\n1077-    )\n1078-    assert (\n1079-        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\n1080-    )\n1081-\n1082-\n1083:def test_passthrough_sliding_activity_window_extends_stream() -> None:\n1084-    # Полезные чанки идут чаще idle_timeout_s, но суммарно дольше total_timeout_s.\n1085-    limits = PassthroughLimits(\n1086-        total_timeout_s=0.5,\n1087-        idle_timeout_s=0.3,\n1088-        safety_cap_s=30.0,\n1089-        heartbeat_interval_s=30.0,\n1090-        poll_interval_s=0.01,\n1091-    )\n1092-    written: list[bytes] = []\n1093-    started = time.monotonic()\n1094-    outcome = relay_sse(\n1095-        paced_readline(12, 0.1),\n1096-        written.append,\n1097-        tool_schemas=None,\n1098-        limits=limits,\n1099-    )\n1100-    elapsed = time.monotonic() - started\n1101-    assert elapsed > limits.total_timeout_s\n1102-    assert outcome.done and not outcome.incomplete\n1103-    assert sum(1 for frame in written if b'\"content\": \"x\"' in frame) == 12\n1104-\n1105-\n1106:def test_passthrough_safety_cap_terminates_infinite_stream() -> None:\n1107-