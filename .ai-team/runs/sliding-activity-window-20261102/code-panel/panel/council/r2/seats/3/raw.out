nario == \"safety_cap\" else 100)\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:749:        last_progress=1000.0,\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:760:    assert cast(float, getattr(run, \"last_progress\")) == (\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1073:    assert PassthroughLimits().safety_cap_s == 3600.0\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1074:    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1076:        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1079:        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1083:def test_passthrough_sliding_activity_window_extends_stream() -> None:\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1088:        safety_cap_s=30.0,\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1106:def test_passthrough_safety_cap_terminates_infinite_stream() -> None:\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1111:        safety_cap_s=0.6,\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1127:    assert limits.safety_cap_s <= elapsed < limits.safety_cap_s + 1.0\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1136:        safety_cap_s=30.0,\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py:1164:        safety_cap_s=5,\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:181:    safety_cap_s: float = DEFAULT_SAFETY_CAP_S\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:230:            safety_cap_s=_positive_float(\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:642:class _TimedSseReader:\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:656:            deadline if deadline is not None else self.start_time + limits.safety_cap_s\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:664:        # last_upstream — только реальный ввод upstream, без heartbeat.\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:666:        self.last_upstream = self.start_time\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:667:        self.last_progress: float | None = None\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:700:                self.last_progress\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:701:                if self.last_progress is not None\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:702:                else self.last_upstream\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:724:                self.last_input = self.last_upstream = time.monotonic()\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:732:def relay_sse(\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:890:                    reader.last_progress = time.monotonic()\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:909:                        reader.last_progress = time.monotonic()\n/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py:1429:            conn.sock.settimeout(min(self.limits.read_timeout_s, remaining))\n            else:\n                idx = self._remap.get((choice, raw), raw)\n        elif delta.get(\"id\") and choice in self._last_index:\n            idx = self.next_tool_index(choice)  # без index: новый id — новый вызов\n        else:\n            idx = self._last_index.get(choice, 0)\n        self._last_index[choice] = idx\n        return idx\n\n    def add(self, choice: int, deltas: Any) -> None:\n        for delta in deltas if isinstance(deltas, list) else ():\n            if not isinstance(delta, dict):\n                continue\n            key = (choice, self._tool_index(choice, delta))\n            entry = self._entries.get(key)\n            if entry is None:\n                if len(self._entries) >= self._limits.accumulator_max_keys:\n                    raise AccumulatorOverflow(\"accumulator_keys\")\n                entry = _PartialCall()\n                self._entries[key] = entry\n            fn = (\n                delta.get(\"function\") if isinstance(delta.get(\"function\"), dict) else {}\n            )\n            call_id = delta.get(\"id\")\n            if isinstance(call_id, str) and call_id and not entry.id:\n                self._grow(len(call_id.encode(\"utf-8\")))\n                entry.id = call_id\n            if isinstance(delta.get(\"type\"), str) and delta[\"type\"]:\n                entry.type = delta[\"type\"]\n            name = fn.get(\"name\")\n            if isinstance(name, str) and name and not entry.name:\n                self._grow(len(name.encode(\"utf-8\")))\n                entry.name = name\n            fragment = fn.get(\"arguments\")\n            if isinstance(fragment, str) and fragment:\n                self._grow(len(fragment.encode(\"utf-8\")))\n                entry.arguments.append(fragment)\n\n    def has_choice(self, choice: int) -> bool:\n        return any(key[0] == choice for key in self._entries)\n\n    def pending_choices(self) -> list[int]:\n        return sorted({key[0] for key in self._entries})\n\n    def _release(self, entry: _PartialCall) -> None:\n        size = (\n            len(entry.id.encode(\"utf-8\"))\n            + len(entry.name.encode(\"utf-8\"))\n            + sum(len(part.encode(\"utf-8\")) for part in entry.arguments)\n        )\n        self._bytes = max(0, self._bytes - size)\n        if self._process is not None:\n            self._process.release(size)\n\n    def pop_choice(self, choice: int) -> list[dict[str, Any]]:\n        \"\"\"Собранные вызовы choice в порядке `tool_call.index` (OpenAI-форма); буфер освобождается.\"\"\"\n        keys = sorted(key for key in self._entries if key[0] == choice)\n        calls: list[dict[str, Any]] = []\n        for key in keys:\n            entry = self._entries.pop(key)\n            self._release(entry)\n            calls.append(\n                {\n                    \"index\": key[1],\n                    \"id\": entry.id or new_call_id(),\n                    \"type\": entry.type,\n                    \"function\": {\n                        \"name\": entry.name,\n                        \"arguments\": \"\".join(entry.arguments),\n                    },\n                }\n            )\n        self._last_index.pop(choice, None)\n        for remap_key in [k for k in self._remap if k[0] == choice]:\n            self._remap.pop(remap_key, None)\n        return calls\n\n    def drop_choice(self, choice: int) -> None:\n        self.pop_choice(choice)\n\n    def close(self) -> None:\n        for choice in self.pending_choices():\n            self.drop_choice(choice)\n\n\ndef sanitize_choice_calls(\n    calls: list[dict[str, Any]],\n    tool_schemas: Optional[dict[str, Any]],\n    limits: PassthroughLimits,\n) -> list[dict[str, Any]]:\n    \"\"\"Санитизация вызовов одной choice; `index` меняется только если `parallel` изменил число вызовов.\"\"\"\n    groups = [\n        sanitize_tool_call(\n            call,\n            tool_schemas,\n            max_parallel_calls=limits.max_parallel_calls,\n            max_parallel_depth=limits.max_parallel_depth,\n        )\n        for call in calls\n    ]\n    flat = [item for group in groups for item in group]\n    unpacked = any(\n        len(group) != 1 or group[0].get(\"id\") != call.get(\"id\")\n        for group, call in zip(groups, calls)\n    )\n    if not unpacked:\n        return flat\n    return [\n        dict(item, index=i) if \"index\" in item else item for i, item in enumerate(flat)\n    ]\n\n\ndef sanitize_completion_body(\n    body: bytes,\n    tool_schemas: Optional[dict[str, Any]],\n    limits: PassthroughLimits,\n) -> bytes:\n    \"\"\"Тело non-stream `chat.completion`: санитизируются `choices[].message.tool_calls`\n    и (при `limits.invoke_normalization_enabled`) извлекаются `<invoke>` из `message.content`.\n\n    Невалидный JSON, форма без `choices` и ответ без изменений возвращаются байт-в-байт.\n    \"\"\"\n    try:\n        data = json.loads(body.decode(\"utf-8\"))\n    except (ValueError, UnicodeDecodeError):\n        return body\n    choices = data.get(\"choices\") if isinstance(data, dict) else None\n    if not isinstance(choices, list):\n        return body\n    changed = False\n    for choice in choices:\n        message = choice.get(\"message\") if isinstance(choice, dict) else None\n        if not isinstance(message, dict):\n            continue\n        raw_calls = message.get(\"tool_calls\")\n        has_valid_native = (\n            isinstance(raw_calls, list)\n            and bool(raw_calls)\n            and all(isinstance(c, dict) for c in raw_calls)\n        )\n        merged_calls: list[dict[str, Any]] = list(raw_calls) if has_valid_native else []\n        extracted_calls: list[dict[str, Any]] = []\n        if limits.invoke_normalization_enabled:\n            content = message.get(\"content\")\n            if isinstance(content, str) and content:\n                content_parts: list[str] = []\n                parsed_calls: list[dict[str, Any]] = []\n                parser = ToolCallParser(\n                    content_parts.append,\n                    parsed_calls.append,\n                    invoke_normalization_enabled=True,\n                    repetition_guard_enabled=False,\n                )\n                parser.feed(content)\n                parser.finish()\n                new_content = \"\".join(content_parts)\n                if parsed_calls or new_content != content:\n                    message[\"content\"] = new_content\n                    changed = True\n                has_index = any(\"index\" in c for c in merged_calls)\n                next_idx = (\n                    max(\n                        (\n                            c[\"index\"]\n                            for c in merged_calls\n                            if isinstance(c.get(\"index\"), int)\n                            and not isinstance(c.get(\"index\"), bool)\n                        ),\n                        default=len(merged_calls) - 1,\n                    )\n                    + 1\n                )\n                for call in parsed_calls:\n                    arguments = call.get(\"arguments\")\n                    entry: dict[str, Any] = {\n                        \"id\": str(call.get(\"id\") or new_call_id()),\n                        \"type\": \"function\",\n                        \"function\": {\n                            \"name\": str(call.get(\"name\") or \"\"),\n                            \"arguments\": arguments\n                            if isinstance(arguments, str)\n                            else json.dumps(arguments or {}, ensure_ascii=False),\n                        },\n                    }\n                    if has_index:\n                        entry[\"index\"] = next_idx\n                        next_idx += 1\n                    extracted_calls.append(entry)\n                if extracted_calls:\n                    merged_calls.extend(extracted_calls)\n        if not merged_calls:\n            continue\n        cleaned = sanitize_choice_calls(merged_calls, tool_schemas, limits)\n        if extracted_calls or cleaned != raw_calls:\n            message[\"tool_calls\"] = cleaned\n            changed = True\n    return json.dumps(data, ensure_ascii=False).encode(\"utf-8\") if changed else body\n\n\ndef _data_frame(payload: Mapping[str, Any]) -> bytes:\n    return b\"data: \" + json.dumps(payload, ensure_ascii=False).encode(\"utf-8\") + b\"\\n\\n\"\n\n\ndef _error_frame(chunk: Mapping[str, Any], code: str, message: str) -> bytes:\n    \"\"\"Терминальный error-chunk в форме `chat.completion.chunk` (как fail-close кадр фасада).\"\"\"\n    return (\n        format_sse_event(\n            build_stream_error_chunk(\n                message=message,\n                model=str(chunk.get(\"model\") or \"\"),\n                code=code,\n                finish_reason=\"stop\" if is_graceful_error_framing_enabled() else None,\n                completion_id=str(chunk.get(\"id\") or \"chatcmpl-passthrough\"),\n                created=chunk.get(\"created\"),\n            )\n        ).encode(\"utf-8\")\n        + b\"data: [DONE]\\n\\n\"\n    )\n\n\ndef iter_sse_events(\n    readline: Callable[[int], bytes], max_line_bytes: int\n) -> Iterator[tuple[bytes, Optional[str]]]:\n    \"\"\"SSE-события upstream: (сырые байты события, склеенный `data:` либо None).\"\"\"\n    raw = bytearray()\n    data: list[str] = []\n    while True:\n        line = readline(max_line_bytes + 1)\n        if len(line) > max_line_bytes:\n            raise UpstreamBodyTooLarge(\"sse_line\")\n        if not line:\n            # Оборванная посреди строки (без перевода строки) запись — не событие: клиенту не уходит.\n            if raw and raw.endswith(b\"\\n\"):\n                yield bytes(raw), (\"\\n\".join(data) if data else None)\n            return\n        raw += line\n        if len(raw) > max_line_bytes * 2:\n            raise UpstreamBodyTooLarge(\"sse_event\")\n        text = line.rstrip(b\"\\r\\n\")\n        if text == b\"\":\n            yield bytes(raw), (\"\\n\".join(data) if data else None)\n            raw = bytearray()\n            data = []\n        elif text.startswith(b\"data:\"):\n            value = text[5:].decode(\"utf-8\", errors=\"replace\")\n            data.append(value[1:] if value.startswith(\" \") else value)\n\n\n@dataclass\nclass StreamOutcome:\n    \"\"\"Итог пробрасывания SSE (для журнала и тестов).\"\"\"\n\n    done: bool = False\n    incomplete: bool = False\n    overflow: bool = False\n    tool_calls_published: int = 0\n    committed: bool = False\n    repetition_loop: bool = False\n    last_chunk: Optional[dict[str, Any]] = None\n    unfinished_choices: Optional[set[int]] = None\n\n\nclass _TimedSseReader:\n    \"\"\"Один bounded reader; ожидание I/O не мешает heartbeat и дедлайну.\"\"\"\n\n    def __init__(\n        self,\n        readline: Callable[[int], bytes],\n        write: Callable[[bytes], None],\n        limits: PassthroughLimits,\n        deadline: float | None = None,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '642,940p' '/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py'; sed -n '1060,1195p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '642,940p' '/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py'; sed -n '1060,1195p' '/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py'\"","aggregated_output":"class _TimedSseReader:\n    \"\"\"Один bounded reader; ожидание I/O не мешает heartbeat и дедлайну.\"\"\"\n\n    def __init__(\n        self,\n        readline: Callable[[int], bytes],\n        write: Callable[[bytes], None],\n        limits: PassthroughLimits,\n        deadline: float | None = None,\n    ) -> None:\n        self.limits = limits\n        self.start_time = time.monotonic()\n        # Аварийный потолок жизни стрима; `deadline` (если задан) остаётся жёстким.\n        self.safety_deadline = (\n            deadline if deadline is not None else self.start_time + limits.safety_cap_s\n        )\n        self.write = write\n        self.items: queue.Queue[bytes | Exception] = queue.Queue(\n            maxsize=limits.read_queue_max_entries\n        )\n        self.stop = threading.Event()\n        # last_input — каденс heartbeat (вход upstream или свой keepalive);\n        # last_upstream — только реальный ввод upstream, без heartbeat.\n        self.last_input = self.start_time\n        self.last_upstream = self.start_time\n        self.last_progress: float | None = None\n\n        def read() -> None:\n            try:\n                while not self.stop.is_set():\n                    line = readline(limits.max_body_bytes + 1)\n                    while not self.stop.is_set():\n                        try:\n                            self.items.put(line, timeout=limits.poll_interval_s)\n                            break\n                        except queue.Full:\n                            continue\n                    if not line:\n                        return\n            except (OSError, http.client.HTTPException, ValueError) as exc:\n                while not self.stop.is_set():\n                    try:\n                        self.items.put(exc, timeout=limits.poll_interval_s)\n                        return\n                    except queue.Full:\n                        continue\n\n        self.thread = threading.Thread(target=read, daemon=True, name=\"passthrough-sse\")\n        self.thread.start()\n\n    def readline(self, _limit: int) -> bytes:\n        while True:\n            now = time.monotonic()\n            safety_remaining = self.safety_deadline - now\n            if safety_remaining <= 0:\n                raise TimeoutError(\"upstream stream safety cap exceeded\")\n            # Скользящее окно: срок тишины отсчитывается от последней активности.\n            activity_base = (\n                self.last_progress\n                if self.last_progress is not None\n                else self.last_upstream\n            )\n            idle_remaining = activity_base + self.limits.idle_timeout_s - now\n            if idle_remaining <= 0:\n                raise TimeoutError(\"upstream stream idle timeout exceeded\")\n            remaining = min(idle_remaining, safety_remaining)\n            heartbeat_due = self.last_input + self.limits.heartbeat_interval_s - now\n            if heartbeat_due <= 0:\n                self.write(b\": keepalive\\n\\n\")\n                self.last_input = time.monotonic()\n                heartbeat_due = self.limits.heartbeat_interval_s\n            try:\n                item = self.items.get(\n                    timeout=min(remaining, heartbeat_due, self.limits.poll_interval_s)\n                )\n            except queue.Empty:\n                continue\n            if time.monotonic() >= self.safety_deadline:\n                raise TimeoutError(\"upstream stream safety cap exceeded\")\n            if isinstance(item, Exception):\n                raise item\n            if item:\n                self.last_input = self.last_upstream = time.monotonic()\n            return item\n\n    def close(self) -> None:\n        self.stop.set()\n        self.thread.join(timeout=self.limits.reader_join_timeout_s)\n\n\ndef relay_sse(\n    readline: Callable[[int], bytes],\n    write: Callable[[bytes], None],\n    *,\n    tool_schemas: Optional[dict[str, Any]],\n    limits: PassthroughLimits,\n    process: Optional[ProcessBudget] = None,\n    sanitize: bool = True,\n    trusted_tools: bool = False,\n    state: StreamOutcome | None = None,\n    deadline: float | None = None,\n) -> StreamOutcome:\n    \"\"\"Пробросить SSE-поток upstream клиенту с санитизацией `tool_calls` (AD-005).\n\n    Исходный порядок событий сохраняется; единственное изменение — вызовы choice выходят\n    одним кадром прямо перед терминальным чанком своей choice, после санитизации.\n    \"\"\"\n    reader = _TimedSseReader(\n        readline,\n        write,\n        limits,\n        deadline,\n    )\n    outcome = state if state is not None else StreamOutcome()\n    client_write = write\n\n    def write(frame: bytes) -> None:\n        \"\"\"До вызова sink: даже частичная запись запрещает повтор запроса.\"\"\"\n        outcome.committed = True\n        client_write(frame)\n\n    acc = ToolCallAccumulator(limits, process)\n    seen: set[int] = set()\n    finished: set[int] = set()\n    last_chunk: dict[str, Any] = {}\n    guards: dict[int, RepetitionGuard] = {}\n    parsers: dict[int, ToolCallParser] = {}\n    parser_content: dict[int, list[str]] = {}\n    parser_calls: dict[int, list[dict]] = {}\n\n    def guard_for(index: int) -> RepetitionGuard:\n        if index not in guards:\n            guards[index] = RepetitionGuard(\n                max_repeats=limits.repetition_max_repeats,\n                max_token_len=limits.repetition_max_token_len,\n                enabled=limits.repetition_guard_enabled,\n            )\n        return guards[index]\n\n    def repetition_error() -> StreamOutcome:\n        acc.close()\n        outcome.repetition_loop = True\n        write(\n            _error_frame(\n                last_chunk,\n                \"upstream_repetition_loop\",\n                \"upstream repetition loop detected\",\n            )\n        )\n        return outcome\n\n    def check_repetition(index: int, text: str) -> bool:\n        if not limits.repetition_guard_enabled or not text:\n            return False\n        return guard_for(index).feed(text)[1]\n\n    def parser_for(index: int) -> ToolCallParser:\n        if index not in parsers:\n            parser_content[index] = []\n            parser_calls[index] = []\n            parsers[index] = ToolCallParser(\n                parser_content[index].append,\n                parser_calls[index].append,\n                tool_schemas=tool_schemas,\n                repetition_guard_enabled=False,\n            )\n        return parsers[index]\n\n    def add_invoke_calls(index: int) -> None:\n        for call in parser_calls.get(index, ()):\n            arguments = call.get(\"arguments\")\n            acc.add(\n                index,\n                [\n                    {\n                        \"index\": acc.next_tool_index(index),\n                        \"id\": str(call.get(\"id\") or new_call_id()),\n                        \"type\": \"function\",\n                        \"function\": {\n                            \"name\": str(call.get(\"name\") or \"\"),\n                            \"arguments\": arguments\n                            if isinstance(arguments, str)\n                            else json.dumps(arguments or {}, ensure_ascii=False),\n                        },\n                    }\n                ],\n            )\n        if index in parser_calls:\n            parser_calls[index].clear()\n\n    def content_frame(base: Mapping[str, Any], index: int, text: str) -> bytes:\n        payload: dict[str, Any] = {\n            k: base[k] for k in base if k not in (\"choices\", \"usage\", \"error\")\n        }\n        payload.setdefault(\"id\", last_chunk.get(\"id\") or \"chatcmpl-passthrough\")\n        payload.setdefault(\"object\", \"chat.completion.chunk\")\n        payload.setdefault(\"created\", last_chunk.get(\"created\") or int(time.time()))\n        payload.setdefault(\"model\", last_chunk.get(\"model\") or \"\")\n        payload[\"choices\"] = [\n            {\"index\": index, \"delta\": {\"content\": text}, \"finish_reason\": None}\n        ]\n        return _data_frame(payload)\n\n    def flush_parser(index: int, base: Mapping[str, Any]) -> Optional[StreamOutcome]:\n        \"\"\"`finish()` парсера choice: удержанный content уходит перед терминалом.\"\"\"\n        if index not in parsers:\n            return None\n        parser_content[index].clear()\n        add_invoke_calls(index)\n        parsers[index].finish()\n        flushed = \"\".join(parser_content[index])\n        parser_content[index].clear()\n        if flushed:\n            if check_repetition(index, flushed):\n                return repetition_error()\n            write(content_frame(base, index, flushed))\n        add_invoke_calls(index)\n        del parsers[index]\n        return None\n\n    try:\n        for raw, data in iter_sse_events(reader.readline, limits.max_body_bytes):\n            if data is None:\n                write(raw)  # комментарий/keepalive/event без data — дословно\n                continue\n            if data.strip() == \"[DONE]\":\n                for pending_index in sorted(list(parsers)):\n                    flushed_outcome = flush_parser(pending_index, last_chunk)\n                    if flushed_outcome is not None:\n                        return flushed_outcome\n                if acc.pending_choices() or (trusted_tools and seen - finished):\n                    acc.close()  # [DONE] без finish_reason у choice с вызовами: успеха нет\n                    outcome.incomplete = True\n                    write(\n                        _error_frame(\n                            last_chunk,\n                            \"upstream_incomplete_stream\",\n                            \"upstream stream ended before finish_reason\",\n                        )\n                    )\n                    return outcome\n                outcome.done = True\n                write(raw)\n                return outcome\n            try:\n                chunk = json.loads(data)\n            except ValueError:\n                if data.strip():\n                    reader.last_progress = time.monotonic()\n                write(raw)\n                continue\n            choices = chunk.get(\"choices\") if isinstance(chunk, dict) else None\n            if isinstance(choices, list):\n                # Role/usage — служебные кадры: TTFT защищён до первого полезного токена.\n                for choice in choices:\n                    delta = choice.get(\"delta\") if isinstance(choice, dict) else None\n                    if isinstance(delta, dict) and any(\n                        delta.get(key)\n                        for key in (\n                            \"content\",\n                            \"reasoning_content\",\n                            \"reasoning\",\n                            \"reasoning_text\",\n                            \"tool_calls\",\n                            \"function_call\",\n                        )\n                    ):\n                        reader.last_progress = time.monotonic()\n                        break\n            if not isinstance(choices, list):\n                if isinstance(chunk, dict):\n                    meta = {\n                        k: chunk.get(k)\n                        for k in (\"id\", \"created\", \"model\")\n                        if chunk.get(k) is not None\n                    }\n                    if meta:\n                        outcome.last_chunk = {**(outcome.last_chunk or {}), **meta}\n                write(raw)\n                continue\n            if not sanitize:\n                outcome.last_chunk = {k: chunk.get(k) for k in (\"id\", \"created\", \"model\")}\n                for choice in choices:\n                    if isinstance(choice, dict):\n                        raw_index = choice.get(\"index\")\n                        idx = (\n                            raw_index\n                            if isinstance(raw_index, int)\n                            and not isinstance(raw_index, bool)\n                            else 0\n                        )\n                        seen.add(idx)\n                        if choice.get(\"finish_reason\"):\n                            finished.add(idx)\n                        if limits.repetition_guard_enabled:\n                            delta = choice.get(\"delta\")\n                            text_value = (\n                                delta.get(\"content\")\n                                if isinstance(delta, dict)\n        yield b\"\\n\"\n        while True:\n            yield b\"\"\n\n    source = lines()\n\n    def readline(_limit: int) -> bytes:\n        return next(source)\n\n    return readline\n\n\ndef test_passthrough_safety_limits_defaults_and_env() -> None:\n    assert PassthroughLimits().safety_cap_s == 3600.0\n    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\n    assert (\n        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\n    )\n    assert (\n        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\n    )\n\n\ndef test_passthrough_sliding_activity_window_extends_stream() -> None:\n    # Полезные чанки идут чаще idle_timeout_s, но суммарно дольше total_timeout_s.\n    limits = PassthroughLimits(\n        total_timeout_s=0.5,\n        idle_timeout_s=0.3,\n        safety_cap_s=30.0,\n        heartbeat_interval_s=30.0,\n        poll_interval_s=0.01,\n    )\n    written: list[bytes] = []\n    started = time.monotonic()\n    outcome = relay_sse(\n        paced_readline(12, 0.1),\n        written.append,\n        tool_schemas=None,\n        limits=limits,\n    )\n    elapsed = time.monotonic() - started\n    assert elapsed > limits.total_timeout_s\n    assert outcome.done and not outcome.incomplete\n    assert sum(1 for frame in written if b'\"content\": \"x\"' in frame) == 12\n\n\ndef test_passthrough_safety_cap_terminates_infinite_stream() -> None:\n    # Апстрим активен вечно: идле не срабатывает, обрывает только аварийный потолок.\n    limits = PassthroughLimits(\n        total_timeout_s=0.2,\n        idle_timeout_s=30.0,\n        safety_cap_s=0.6,\n        heartbeat_interval_s=30.0,\n        poll_interval_s=0.01,\n    )\n    written: list[bytes] = []\n    outcome = StreamOutcome()\n    started = time.monotonic()\n    with pytest.raises(TimeoutError, match=\"safety cap exceeded\"):\n        _ = relay_sse(\n            paced_readline(None, 0.05),\n            written.append,\n            tool_schemas=None,\n            limits=limits,\n            state=outcome,\n        )\n    elapsed = time.monotonic() - started\n    assert limits.safety_cap_s <= elapsed < limits.safety_cap_s + 1.0\n    assert any(b'\"content\": \"x\"' in frame for frame in written)\n    assert not outcome.done\n\n\ndef test_passthrough_idle_timeout_not_reset_by_own_heartbeat() -> None:\n    # Тишина upstream: свои keepalive клиенту не продлевают окно неактивности.\n    limits = PassthroughLimits(\n        idle_timeout_s=0.3,\n        safety_cap_s=30.0,\n        heartbeat_interval_s=0.05,\n        poll_interval_s=0.01,\n    )\n    written: list[bytes] = []\n    stop = threading.Event()\n\n    def silent(_limit: int) -> bytes:\n        _ = stop.wait(30)\n        return b\"\"\n\n    started = time.monotonic()\n    try:\n        with pytest.raises(TimeoutError, match=\"idle timeout exceeded\"):\n            _ = relay_sse(silent, written.append, tool_schemas=None, limits=limits)\n    finally:\n        stop.set()\n    assert time.monotonic() - started < 2.0\n    assert b\": keepalive\\n\\n\" in written\n\n\ndef test_cap_terminates_real_group_term_then_kill(tmp_path: Path) -> None:\n    from core.backend_adapter import TurnResult\n\n    clock = Clock()\n    manager = TurnSessionManager(\n        state_root=tmp_path,\n        clock=clock,\n        safety_cap_s=5,\n        finish_reserve_s=0,\n        watchdog_interval_s=0.01,\n        cancel_grace_s=0.05,\n    )\n    turn, _ = manager.create_or_attach_turn(\n        model=\"test\", backend=\"test\", cwd=str(tmp_path), messages=[]\n    )\n    proc = subprocess.Popen(\n        [\n            sys.executable,\n            \"-c\",\n            \"import signal,time; signal.signal(signal.SIGTERM, signal.SIG_IGN); print('ready',flush=True); time.sleep(60)\",\n        ],\n        start_new_session=True,\n        stdout=subprocess.PIPE,\n    )\n    try:\n        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n        turn.bind_process(pgid=proc.pid)\n        clock.now += 6\n\n        def runner(_turn: object) -> TurnResult:\n            return TurnResult(state=\"done\", rc=proc.wait(timeout=3))\n\n        worker = manager.spawn_detached_execution(turn, runner)\n        assert turn.done_event.wait(5)\n        worker.join(timeout=1)\n        assert proc.returncode == -signal.SIGKILL\n        assert turn.status == \"TIMED_OUT_CAP\"\n        error = turn.buffer.error\n        assert error is not None\n","exit_code":0,"status":"completed"}}
