str\n51|    choices: list[Choice]\n52|\n53|\n54|class ErrorDetail(TypedDict):\n55|    type: str\n56|    code: int\n57|\n58|\n59|class ErrorBody(TypedDict):\n60|    error: ErrorDetail\n61|\n62|\n63|class ControllerOptions(TypedDict, total=False):\n64|    io_wait_cap_s: float\n65|    safety_cap_s: float\n66|\n67|\n68|class HandleArguments(TypedDict):\n69|    path: str\n70|    raw_body: bytes\n71|    request: Mapping[str, object]\n72|    headers: Mapping[str, str]\n73|    sink: ResponseSink\n74|\n75|\n76|class HandlerFixture(Protocol):\n77|    path: str\n78|    headers: dict[str, str]\n79|    wfile: io.BytesIO\n80|    connection: Mock\n81|    send_response: Mock\n82|    send_header: Mock\n83|    end_headers: Callable[[], None]\n84|    request_version: str\n85|\n86|    def handle_expect_100(self) -> bool: ...\n87|\n88|\n89|class MockSink(Protocol):\n90|    start: Mock\n91|    write: Mock\n92|    client_gone: Callable[[], bool]\n93|\n94|\n95|class OpenConnection(Protocol):\n96|    def __call__(\n97|        self,\n98|        path: str,\n99|        raw_body: bytes,\n100|        headers: Mapping[str, str],\n101|        *,\n102|        presend_deadline: float | None,\n103|    ) -> HTTPConnection: ...\n104|\n105|\n106|def serve_passthrough(\n107|    handler: HandlerFixture,\n108|    adapter: object,\n109|    raw: bytes,\n110|    request: dict[str, object],\n111|    model: str,\n112|) -> None:\n113|    \"\"\"Типизирует динамический шов настоящего Handler, не подменяя реализацию.\"\"\"\n114|    method = cast(\n115|        Callable[[object, bytes, dict[str, object], str], None],\n116|        getattr(handler, \"_serve_passthrough\"),\n117|    )\n118|    method(adapter, raw, request, model)\n119|\n120|\n121|def serve_sse(handler: HandlerFixture, context: dict[str, object]) -> None:\n122|    method = cast(\n123|        Callable[[dict[str, object]], None], getattr(handler, \"_serve_sse_body\")\n124|    )\n125|    method(context)\n126|\n127|\n128|def discard(_value: object) -> None:\n129|    return None\n130|\n131|\n132|@pytest.fixture(autouse=True)\n133|def fake_client_probe(monkeypatch: pytest.MonkeyPatch) -> None:\n134|    import server\n135|\n136|    def connected(_sock: object) -> bool:\n137|        return False\n138|\n139|    monkeypatch.setattr(server, \"_client_gone\", connected)\n140|\n141|\n142|class Clock:\n143|    \"\"\"Управляемое монотонное время без ожиданий в тестах.\"\"\"\n144|\n145|    def __init__(self) -> None:\n146|        self.now: float = 1000.0\n147|\n148|    def __call__(self) -> float:\n149|        return self.now\n150|\n151|\n152|def metrics(\n153|    state: str = \"S\", *, alive: bool = True, cpu: float = 0.0\n154|) -> WatchdogMetrics:\n155|    return WatchdogMetrics(4242, alive, (), (), cpu, cpu, states=[state])\n156|\n157|\n158|def controller(\n159|    clock: Clock, state: str = \"S\", **kwargs: Unpack[ControllerOptions]\n160|) -> AdaptiveTimeoutController:\n161|    watchdog = Mock(spec=ProcessWatchdog)\n162|    cast(Mock, getattr(watchdog, \"sample\")).return_value = metrics(state)\n163|    ctrl = AdaptiveTimeoutController(\n164|        idle_timeout_s=10,\n165|        finish_reserve_s=0,\n166|        clock=clock,\n167|        watchdog=cast(ProcessWatchdog, watchdog),\n168|        **kwargs,\n169|    )\n170|    ctrl.register_pgid(4242)\n171|    return ctrl\n172|\n173|\n174|def test_active_keepalive_resets_watchdog() -> None:\n175|    # Предикат pi-ai: только truthy content/reasoning_content считается прогрессом.\n176|    frame = KeepaliveController.sse_data_chunk(model=\"test\")\n177|    chunk = cast(Chunk, json.loads(frame.removeprefix(\"data: \").strip()))\n178|    delta = chunk[\"choices\"][0][\"delta\"]\n179|    idle_deadline = 300\n180|    for now in range(10, 1001, 10):\n181|        assert now < idle_deadline\n182|        if delta.get(\"content\") or delta.get(\"reasoning_content\"):\n183|            idle_deadline = now + 300\n184|    assert chunk[\"id\"].startswith(\"chatcmpl-ping-\")\n185|    assert chunk[\"object\"] == \"chat.completion.chunk\"\n186|    assert chunk[\"choices\"][0][\"finish_reason\"] is None\n187|    assert delta == {\"reasoning_content\": \" \"}\n188|    assert (\n189|        cast(\n190|            Chunk, json.loads(KeepaliveController.sse_data_chunk(reasoning=False)[6:])\n191|        )[\"choices\"][0][\"delta\"]\n192|        == {}\n193|    )\n194|\n195|\n196|@pytest.mark.parametrize(\"state\", [\"S\", \"S+\", \"Ss\", \"D\", \"D<\", \"I\", \"I+\", \"U\", \"U+\"])\n197|def test_process_watchdog_io_grace(state: str) -> None:\n198|    clock = Clock()\n199|    ctrl = controller(clock, state, io_wait_cap_s=900)\n200|    clock.now += 120\n201|    assert ctrl.check()[0] is False\n202|    assert ctrl.last_activity_ts == 1000\n203|    clock.now = 1899.9\n204|    assert ctrl.check()[0] is False\n205|    clock.now = 1900\n206|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n207|\n208|\n209|def test_process_watchdog_terminates_after_cap() -> None:\n210|    clock = Clock()\n211|    ctrl = controller(clock, safety_cap_s=3600)\n212|    clock.now += 3600\n213|    ctrl.record_activity(\"cpu\")\n214|    assert ctrl.check()[:2] == (True, \"absolute_cap\")\n215|\n216|\n217|@pytest.mark.parametrize(\"state\", [\"R\", \"T\", \"Z\", \"X\", \"?\", \"\"])\n218|def test_unknown_or_dead_states_get_no_io_grace(state: str) -> None:\n219|    clock = Clock()\n220|    ctrl = controller(clock, state)\n221|    clock.now += 11\n222|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n223|    assert not metrics(state, alive=False).is_waiting_io()\n224|\n225|\n226|def test_disabled_grace_and_idle_floor(monkeypatch: pytest.MonkeyPatch) -> None:\n227|    monkeypatch.setenv(\"BRIDGE_IO_GRACE_ENABLED\", \"false\")\n228|    clock = Clock()\n229|    ctrl = controller(clock)\n230|    clock.now += 11\n231|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n232|    assert AdaptiveTimeoutController(idle_timeout_s=1).idle_timeout_s >= 10\n233|\n234|\n235|def test_safety_cap_despite_cpu_progress() -> None:\n236|    clock = Clock()\n237|    ctrl = controller(clock, safety_cap_s=30)\n238|    cast(Mock, getattr(ctrl.watchdog, \"sample\")).return_value = metrics(\"R\", cpu=1)\n239|    for offset in (11, 22):\n240|        clock.now = 1000 + offset\n241|        assert ctrl.check()[0] is False\n242|    clock.now = 1030\n243|    assert ctrl.check()[:2] == (True, \"absolute_cap\")\n244|\n245|\n246|def test_env_configuration_parameters(monkeypatch: pytest.MonkeyPatch) -> None:\n247|    from core.lifecycle import PreSendRetry\n248|\n249|    for key, value in {\n250|        \"BRIDGE_IO_WAIT_CAP_S\": \"321.5\",\n251|        \"BRIDGE_SAFETY_CAP_S\": \"700.5\",\n252|        \"BRIDGE_MAX_RETRIES\": \"2\",\n253|        \"BRIDGE_RETRY_BUDGET_S\": \"19.5\",\n254|        \"BRIDGE_KEEPALIVE_INTERVAL_S\": \"0.1\",\n255|        \"BRIDGE_IO_GRACE_ENABLED\": \"off\",\n256|    }.items():\n257|        monkeypatch.setenv(key, value)\n258|    ctrl = AdaptiveTimeoutController()\n259|    assert (ctrl.io_wait_cap_s, ctrl.safety_cap_s, ctrl.io_grace_enabled) == (\n260|        321.5,\n261|        700.5,\n262|        False,\n263|    )\n264|    retry = PreSendRetry()\n265|    assert (retry.max_retries, retry.budget_s) == (2, 19.5)\n266|    assert KeepaliveController().effective_interval() == 0.1\n267|\n268|\n269|@pytest.mark.parametrize(\"bad\", [\"nan\", \"inf\", \"-1\", \"0\", \"broken\", \"\"])\n270|def test_invalid_env_uses_safe_fallback(\n271|    monkeypatch: pytest.MonkeyPatch, bad: str\n272|) -> None:\n273|    from core.lifecycle import PreSendRetry\n274|\n275|    for key in (\n276|        \"IO_WAIT_CAP_S\",\n277|        \"SAFETY_CAP_S\",\n278|        \"RETRY_BUDGET_S\",\n279|        \"KEEPALIVE_INTERVAL_S\",\n280|        \"MAX_RETRIES\",\n281|        \"IO_GRACE_ENABLED\",\n282|    ):\n283|        monkeypatch.setenv(\"BRIDGE_\" + key, bad)\n284|    ctrl = AdaptiveTimeoutController()\n285|    assert (ctrl.io_wait_cap_s, ctrl.safety_cap_s) == (900, 3600)\n286|    assert KeepaliveController().effective_interval() == 10\n287|    assert PreSendRetry().budget_s == 60\n288|    assert PreSendRetry().max_retries == (0 if bad == \"0\" else 3)\n289|\n290|\n291|def test_state_sampling_reads_actual_sleeping_group() -> None:\n292|    proc = subprocess.Popen(\n293|        [\n294|            sys.executable,\n295|            \"-c\",\n296|            \"import time; print('ready', flush=True); time.sleep(60)\",\n297|        ],\n298|        start_new_session=True,\n299|        stdout=subprocess.PIPE,\n300|    )\n301|    try:\n302|        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n303|        sample = ProcessWatchdog().sample(proc.pid)\n304|        assert sample.alive\n305|        assert sample.states\n306|        assert sample.is_waiting_io()\n307|        assert all(state[0] not in \"ZX\" for state in sample.states)\n308|    finally:\n309|        os.killpg(proc.pid, signal.SIGTERM)\n310|        _ = proc.wait(timeout=5)\n311|\n312|\n313|def test_turn_manager_heartbeat_preserves_identity_and_history(tmp_path: Path) -> None:\n314|    manager = TurnSessionManager(state_root=tmp_path)\n315|    turn, _ = manager.create_or_attach_turn(\n316|        model=\"test\", backend=\"test\", cwd=str(tmp_path), messages=[]\n317|    )\n318|    started = turn.timeout_controller.last_activity_ts\n319|    frames = manager.iter_sse_stream(turn, keepalive_interval_s=0.01)\n320|    try:\n321|        heartbeat = next(frames)\n322|        data = next(\n323|            line[6:] for line in heartbeat.splitlines() if line.startswith(\"data: \")\n324|        )\n325|        chunk = cast(Chunk, json.loads(data))\n326|        assert chunk[\"id\"] == f\"chatcmpl-turn-{turn.turn_id}\"\n327|        assert chunk[\"model\"] == \"test\"\n328|        assert chunk[\"choices\"][0][\"delta\"].get(\"reasoning_content\")\n329|        assert turn.buffer.get_reasoning_text() == \"\"\n330|        assert turn.buffer.get_content_text() == \"\"\n331|        assert turn.timeout_controller.last_activity_ts == started\n332|    finally:\n333|        cast(Generator[str, None, None], frames).close()\n334|        manager.finalize_abandoned_turn(turn)\n335|\n336|\n337|def make_handler() -> HandlerFixture:\n338|    import server\n339|\n340|    handler = cast(HandlerFixture, cast(object, server.Handler.__new__(server.Handler)))\n341|    setattr(handler, \"_trace\", None)\n342|    handler.path = \"/v1/chat/completions\"\n343|    handler.headers = {}\n344|    handler.wfile = io.BytesIO()\n345|    handler.connection = Mock()\n346|    setattr(handler, \"_current_lease\", lambda: Mock())\n347|    handler.send_response = Mock()\n348|    handler.send_header = Mock()\n349|    handler.end_headers = Mock()\n350|    return handler\n351|\n352|\n353|@pytest.mark.parametrize(\"status\", [502, 503, None])\n354|def test_presend_retry_resilience(\n355|    monkeypatch: pytest.MonkeyPatch, status: int | None\n356|) -> None:\n357|    from core.backend_adapter import PreSendTransientError\n358|\n359|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"0.001\")\n360|    handler = make_handler()\n361|    attempts: list[int] = []\n362|\n363|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n364|        attempts.append(1)\n365|        if len(attempts) < 3:\n366|            raise PreSendTransientError(\"not dispatched\", status_code=status)\n367|        sink = kwargs[\"sink\"]\n368|        sink.start(200, [])\n369|        sink.write(b\"ok\")\n370|\n371|    adapter = SimpleNamespace(id=\"test\", handle=handle)\n372|    serve_passthrough(handler, adapter, b\"{}\", {}, \"test\")\n373|    assert len(attempts) == 3\n374|    assert handler.wfile.getvalue() == b\"ok\"\n375|    cast(Mock, getattr(handler, \"send_response\")).assert_called_once_with(200)\n376|\n377|\n378|@pytest.mark.parametrize(\"emission\", [\"headers\", \"heartbeat\", \"content\"])\n379|def test_no_retry_after_first_downstream_emission(\n380|    monkeypatch: pytest.MonkeyPatch, emission: str\n381|) -> None:\n382|    from core.backend_adapter import PreSendTransientError\n383|\n384|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"0.001\")\n385|    handler = make_handler()\n386|    attempts: list[int] = []\n387|\n388|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n389|        attempts.append(1)\n390|        sink = kwargs[\"sink\"]\n391|        sink.start(200, [])\n392|        if emission != \"headers\":\n393|            sink.write(\n394|                KeepaliveController.sse_data_chunk().encode()\n395|                if emission == \"heartbeat\"\n396|                else b\"first\"\n397|            )\n398|        raise PreSendTransientError(\"late transport error\", status_code=502)\n399|\n400|    with pytest.raises(PreSendTransientError):\n401|        serve_passthrough(\n402|            handler, SimpleNamespace(id=\"test\", handle=handle), b\"{}\", {}, \"test\"\n403|        )\n404|    assert len(attempts) == 1\n405|\n406|\n407|def test_ambiguous_upstream_response_is_never_replayed() -> None:\n408|    handler = make_handler()\n409|    calls: list[int] = []\n410|\n411|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n412|        calls.append(1)\n413|        kwargs[\"sink\"].start(502, [])\n414|        kwargs[\"sink\"].write(b\"upstream may have started\")\n415|\n416|    serve_passthrough(\n417|        handler, SimpleNamespace(id=\"test\", handle=handle), b\"{}\", {}, \"test\"\n418|    )\n419|    assert len(calls) == 1\n420|\n421|\n422|def test_retry_exhaustion_budget_and_cancellation(\n423|    monkeypatch: pytest.MonkeyPatch,\n424|) -> None:\n425|    from core.backend_adapter import PreSendTransientError\n426|    from core.lifecycle import PreSendRetry\n427|\n428|    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", \"2\")\n429|    clock = Clock()\n430|    waits: list[float] = []\n431|\n432|    def wait(delay: float) -> bool:\n433|        waits.append(delay)\n434|        clock.now += delay\n435|        return False\n436|\n437|    op = Mock(side_effect=PreSendTransientError(\"connect refused\"))\n438|    with pytest.raises(PreSendTransientError):\n439|        PreSendRetry(clock=clock, wait=wait, rng=lambda _lo, hi: hi).run(op)\n440|    assert op.call_count == 3\n441|    assert len(waits) == 2\n442|    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"0.1\")\n443|    op.reset_mock()\n444|    with pytest.raises(PreSendTransientError):\n445|        PreSendRetry(clock=clock, wait=wait, rng=lambda _lo, hi: hi).run(op)\n446|    assert op.call_count == 1\n447|    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"60\")\n448|    op.reset_mock()\n449|    cancelled_wait = Mock(return_value=True)\n450|    with pytest.raises(PreSendTransientError):\n451|        PreSendRetry(wait=cancelled_wait).run(op)\n452|    assert op.call_count == 1\n453|    cancelled_wait.assert_called_once()\n454|\n455|\n456|def test_zero_retries_disables_replay(monkeypatch: pytest.MonkeyPatch) -> None:\n457|    from core.backend_adapter import PreSendTransientError\n458|    from core.lifecycle import PreSendRetry\n459|\n460|    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", \"0\")\n461|    op = Mock(side_effect=PreSendTransientError(\"not sent\"))\n462|    with pytest.raises(PreSendTransientError):\n463|        PreSendRetry().run(op)\n464|    assert op.call_count == 1\n465|\n466|\n467|def test_real_backoff_is_cancelled_promptly(monkeypatch: pytest.MonkeyPatch) -> None:\n468|    from core.backend_adapter import PreSendTransientError\n469|    from core.lifecycle import PreSendRetry\n470|\n471|    monkeypatch.setenv(\"BRIDGE_RETRY_CANCEL_POLL_S\", \"0.01\")\n472|    cancelled, attempted, stopped = (\n473|        threading.Event(),\n474|        threading.Event(),\n475|        threading.Event(),\n476|    )\n477|\n478|    def operation() -> None:\n479|        attempted.set()\n480|        raise PreSendTransientError(\"not sent\")\n481|\n482|    def run() -> None:\n483|        try:\n484|            PreSendRetry(cancelled=cancelled.is_set, rng=lambda _lo, hi: hi).run(\n485|                operation\n486|            )\n487|        except PreSendTransientError:\n488|            stopped.set()\n489|\n490|    worker = threading.Thread(target=run)\n491|    worker.start()\n492|    try:\n493|        assert attempted.wait(1)\n494|        cancelled.set()\n495|        assert stopped.wait(0.5), \"отмена должна прерывать реальный backoff\"\n496|    finally:\n497|        cancelled.set()\n498|        worker.join(timeout=2)\n499|\n500|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40f","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":98,"recorded_at":1780531400000191,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"call_id":"call_01a19c26f16a708aa6f5a293a4a5c5e6","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_http_presend_resilience.py`.\n1|\"\"\"HTTP-регрессии retry до первой клиентской записи на настоящих сокетах.\"\"\"\n2|\n3|from __future__ import annotations\n4|\n5|import functools\n6|import http.client\n7|import io\n8|import json\n9|import socket\n10|import threading\n11|from collections.abc import Callable, Generator\n12|from contextlib import contextmanager\n13|from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n14|from typing import cast, override\n15|\n16|import pytest\n17|\n18|import server\n19|from adapters.passthrough_adapter import PassthroughAdapter, PassthroughLimits\n20|from core.lifecycle import KeepaliveController, PreSendRetry\n21|\n22|SUCCESS = b'{\"id\":\"once\",\"choices\":[{\"message\":{\"content\":\"ok\"}}]}'\n23|CONTENT = b'data: {\"id\":\"once\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"first\"},\"finish_reason\":null}]}\\n\\n'\n24|TERMINAL = (\n25|    b'data: {\"id\":\"once\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\\n\\n'\n26|)\n27|DONE = b\"data: [DONE]\\n\\n\"\n28|WAIT_S = 5.0\n29|Action = Callable[[BaseHTTPRequestHandler], None]\n30|ServePassthrough = Callable[[PassthroughAdapter, bytes, dict[str, object], str], None]\n31|\n32|\n33|@pytest.fixture(autouse=True)\n34|def retry_settings(monkeypatch: pytest.MonkeyPatch) -> None:\n35|    \"\"\"Убирает случайность backoff, сохраняя настоящий retry и HTTP-транспорт.\"\"\"\n36|    for name, value in {\n37|        \"BRIDGE_MAX_RETRIES\": \"3\",\n38|        \"BRIDGE_RETRY_BUDGET_S\": \"60\",\n39|        \"BRIDGE_RETRY_BACKOFF_S\": \"0.001\",\n40|        \"BRIDGE_RETRY_MAX_BACKOFF_S\": \"0.001\",\n41|        \"BRIDGE_RETRY_CANCEL_POLL_S\": \"0.001\",\n42|    }.items():\n43|        monkeypatch.setenv(name, value)\n44|    monkeypatch.setattr(\n45|        server,\n46|        \"PreSendRetry\",\n47|        functools.partial(PreSendRetry, rng=lambda _low, high: high),\n48|    )\n49|\n50|\n51|def json_reply(status: int, body: bytes | None = None) -> Action:\n52|    payload = (\n53|        body\n54|        if body is not None\n55|        else (\n56|            SUCCESS\n57|            if status == 200\n58|            else json.dumps({\"error\": {\"code\": status}}).encode()\n59|        )\n60|    )\n61|\n62|    def respond(handler: BaseHTTPRequestHandler) -> None:\n63|        handler.send_response(status)\n64|        handler.send_header(\"Content-Type\", \"application/json\")\n65|        handler.send_header(\"Content-Length\", str(len(payload)))\n66|        handler.end_headers()\n67|        _ = handler.wfile.write(payload)\n68|        handler.wfile.flush()\n69|\n70|    return respond\n71|\n72|\n73|def sse_reply(body: bytes) -> Action:\n74|    def respond(handler: BaseHTTPRequestHandler) -> None:\n75|        handler.send_response(200)\n76|        handler.send_header(\"Content-Type\", \"text/event-stream\")\n77|        handler.end_headers()\n78|        _ = handler.wfile.write(body)\n79|        handler.wfile.flush()\n80|\n81|    return respond\n82|\n83|\n84|def reset_reply(handler: BaseHTTPRequestHandler) -> None:\n85|    \"\"\"Обрывает upstream после чтения POST, до первой строки HTTP-ответа.\"\"\"\n86|    connection = cast(socket.socket, handler.connection)\n87|    connection.shutdown(socket.SHUT_RDWR)\n88|    connection.close()\n89|\n90|\n91|class HttpStand:\n92|    \"\"\"Два локальных HTTP-сервера: upstream и настоящий passthrough-шов Handler.\"\"\"\n93|\n94|    def __init__(self, actions: list[Action]) -> None:\n95|        self.requests: list[bytes] = []\n96|        self.statuses: list[int] = []\n97|        self.emitted_at_attempt: list[int] = []\n98|        self.errors: list[BaseException] = []\n99|        self.finished: threading.Event = threading.Event()\n100|        outer = self\n101|\n102|        class Upstream(BaseHTTPRequestHandler):\n103|            @override\n104|            def log_message(self, format: str, *args: object) -> None:\n105|                return\n106|\n107|            def do_POST(self) -> None:\n108|                body = self.rfile.read(int(self.headers[\"Content-Length\"]))\n109|                outer.requests.append(body)\n110|                index = len(outer.requests) - 1\n111|                actions[min(index, len(actions) - 1)](self)\n112|\n113|        self.upstream: ThreadingHTTPServer = ThreadingHTTPServer(\n114|            (\"127.0.0.1\", 0), Upstream\n115|        )\n116|        self.upstream.daemon_threads = True\n117|        port = self.upstream.server_port\n118|        adapter = PassthroughAdapter(\n119|            \"http-retry-test\",\n120|            {\"base_url\": f\"http://127.0.0.1:{port}/v1\", \"kind\": \"passthrough\"},\n121|            dict,\n122|            limits=PassthroughLimits(\n123|                connect_timeout_s=1, read_timeout_s=1, total_timeout_s=2\n124|            ),\n125|        )\n126|\n127|        class Bridge(server.Handler):\n128|            @override\n129|            def log_message(self, fmt: str, *args: object) -> None:\n130|                return\n131|\n132|            @override\n133|            def send_response(self, code: int, message: str | None = None) -> None:\n134|                outer.statuses.append(code)\n135|                super().send_response(code, message)\n136|\n137|            @override\n138|            def end_headers(self) -> None:\n139|                outer.emitted_at_attempt.append(len(outer.requests))\n140|                super().end_headers()\n141|\n142|            @override\n143|            def do_POST(self) -> None:\n144|                raw = self.rfile.read(int(self.headers[\"Content-Length\"]))\n145|                try:\n146|                    request = cast(dict[str, object], json.loads(raw))\n147|                    serve = cast(ServePassthrough, getattr(self, \"_serve_passthrough\"))\n148|                    serve(adapter, raw, request, \"http-test\")\n149|                except BaseException as exc:\n150|                    outer.errors.append(exc)\n151|                    raise\n152|                finally:\n153|                    outer.finished.set()\n154|\n155|        self.bridge: ThreadingHTTPServer = ThreadingHTTPServer((\"127.0.0.1\", 0), Bridge)\n156|        self.bridge.daemon_threads = True\n157|        self.threads: list[threading.Thread] = [\n158|            threading.Thread(target=httpd.serve_forever, kwargs={\"poll_interval\": 0.01})\n159|            for httpd in (self.upstream, self.bridge)\n160|        ]\n161|        for thread in self.threads:\n162|            thread.start()\n163|\n164|    def connect(self, *, stream: bool = False) -> socket.socket:\n165|        body = json.dumps(\n166|            {\"model\": \"http-test\", \"stream\": stream, \"messages\": []}\n167|        ).encode()\n168|        sock = socket.create_connection((\"127.0.0.1\", self.bridge.server_port), WAIT_S)\n169|        sock.sendall(\n170|            b\"POST /v1/chat/completions HTTP/1.1\\r\\nHost: localhost\\r\\n\"\n171|            + b\"Connection: close\\r\\nContent-Type: application/json\\r\\nContent-Length: \"\n172|            + str(len(body)).encode()\n173|            + b\"\\r\\n\\r\\n\"\n174|            + body\n175|        )\n176|        return sock\n177|\n178|    def response(self, *, stream: bool = False) -> tuple[int, bytes]:\n179|        with self.connect(stream=stream) as sock:\n180|            received = bytearray()\n181|            while data := sock.recv(65536):\n182|                received.extend(data)\n183|        assert self.finished.wait(WAIT_S), \"HTTP handler не завершился\"\n184|        assert not self.errors\n185|        raw = bytes(received)\n186|        assert raw.count(b\"HTTP/1.1 \") == 1, raw\n187|\n188|        class ResponseSocket:\n189|            def makefile(self, _mode: str) -> io.BytesIO:\n190|                return io.BytesIO(raw)\n191|\n192|        response = http.client.HTTPResponse(\n193|            cast(socket.socket, cast(object, ResponseSocket()))\n194|        )\n195|        response.begin()\n196|        return response.status, response.read()\n197|\n198|    def close(self) -> None:\n199|        for httpd in (self.bridge, self.upstream):\n200|            httpd.shutdown()\n201|            httpd.server_close()\n202|        for thread in self.threads:\n203|            thread.join(timeout=WAIT_S)\n204|            assert not thread.is_alive()\n205|\n206|\n207|@contextmanager\n208|def stand(actions: list[Action]) -> Generator[HttpStand]:\n209|    instance = HttpStand(actions)\n210|    try:\n211|        yield instance\n212|    finally:\n213|        instance.close()\n214|\n215|\n216|@pytest.mark.parametrize(\"stream\", [False, True])\n217|def test_real_502_503_retry_before_any_client_bytes(stream: bool) -> None:\n218|    final = CONTENT + TERMINAL + DONE if stream else SUCCESS\n219|    success = sse_reply(final) if stream else json_reply(200, final)\n220|    with stand([json_reply(502), json_reply(503), success]) as instance:\n221|        status, body = instance.response(stream=stream)\n222|        assert (status, body) == (200, final)\n223|        assert len(instance.requests) == 3\n224|        assert len(set(instance.requests)) == 1\n225|        assert instance.statuses == [200]\n226|        assert instance.emitted_at_attempt == [3]\n227|\n228|\n229|@pytest.mark.parametrize(\"stream\", [False, True])\n230|def test_real_reset_before_response_retries(stream: bool) -> None:\n231|    final = CONTENT + TERMINAL + DONE if stream else SUCCESS\n232|    success = sse_reply(final) if stream else json_reply(200, final)\n233|    with stand([reset_reply, success]) as instance:\n234|        assert instance.response(stream=stream) == (200, final)\n235|        assert len(instance.requests) == 2\n236|        assert instance.statuses == [200]\n237|        assert instance.emitted_at_attempt == [2]\n238|\n239|\n240|@pytest.mark.parametrize(\n241|    \"prefix\",\n242|    [\n243|        b\"\",\n244|        b\": keepalive\\n\\n\",\n245|        KeepaliveController.sse_data_chunk(\n246|            \"http-test\", completion_id=\"heartbeat\", created=1\n247|        ).encode(),\n248|        CONTENT,\n249|    ],\n250|)\n251|def test_real_stream_eof_after_headers_heartbeat_or_content_never_replays(\n252|    prefix: bytes,\n253|) -> None:\n254|    with stand([sse_reply(prefix), sse_reply(CONTENT + TERMINAL + DONE)]) as instance:\n255|        status, body = instance.response(stream=True)\n256|        assert status == 200\n257|        assert body.startswith(prefix)\n258|        assert TERMINAL not in body\n259|        assert len(instance.requests) == 1\n260|        assert instance.statuses == [200]\n261|        assert instance.emitted_at_attempt == [1]\n262|\n263|\n264|@pytest.mark.parametrize(\"retries\", [0, 1, 3])\n265|def test_real_http_retry_exhaustion_is_bounded(\n266|    monkeypatch: pytest.MonkeyPatch, retries: int\n267|) -> None:\n268|    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", str(retries))\n269|    with stand([json_reply(503)]) as instance:\n270|        status, body = instance.response()\n271|        assert status == 503\n272|        assert json.loads(body)[\"error\"][\"code\"] == 503\n273|        assert len(instance.requests) == retries + 1\n274|        assert instance.statuses == [503]\n275|        assert instance.emitted_at_attempt == [retries + 1]\n276|\n277|\n278|def test_real_http_retry_budget_does_not_start_unaffordable_retry(\n279|    monkeypatch: pytest.MonkeyPatch,\n280|) -> None:\n281|    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"0.01\")\n282|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"1\")\n283|    monkeypatch.setenv(\"BRIDGE_RETRY_MAX_BACKOFF_S\", \"1\")\n284|    with stand([json_reply(502), json_reply(200)]) as instance:\n285|        status, body = instance.response()\n286|        assert status == 502\n287|        assert json.loads(body)[\"error\"][\"code\"] == 502\n288|        assert len(instance.requests) == 1\n289|        assert instance.statuses == [502]\n290|\n291|\n292|def test_real_client_cancel_during_retry_backoff_stops_upstream_posts(\n293|    monkeypatch: pytest.MonkeyPatch,\n294|) -> None:\n295|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"1\")\n296|    monkeypatch.setenv(\"BRIDGE_RETRY_MAX_BACKOFF_S\", \"1\")\n297|    failed = threading.Event()\n298|\n299|    def first(handler: BaseHTTPRequestHandler) -> None:\n300|        json_reply(503)(handler)\n301|        failed.set()\n302|\n303|    with stand([first, json_reply(200)]) as instance:\n304|        sock = instance.connect()\n305|        try:\n306|            assert failed.wait(WAIT_S)\n307|        finally:\n308|            sock.shutdown(socket.SHUT_RDWR)\n309|            sock.close()\n310|        assert instance.finished.wait(WAIT_S)\n311|        assert len(instance.requests) == 1\n312|        assert not instance.errors","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
