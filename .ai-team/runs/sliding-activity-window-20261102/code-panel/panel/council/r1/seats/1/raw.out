if total > limit:\n1127|            raise UpstreamBodyTooLarge(\"body\")\n1128|        chunks.append(piece)\n1129|\n1130|\n1131|class PassthroughAdapter(BackendAdapter):\n1132|    \"\"\"Бэкенд `kind=passthrough`: модели каталога, раw-шов исполнения вместо `execute_turn`.\"\"\"\n1133|\n1134|    kind = KIND\n1135|    capabilities = Capabilities(\n1136|        sessions=SESSIONS_NONE, streaming=STREAMING_NATIVE, usage=\"exact\"\n1137|    )\n1138|\n1139|    def __init__(\n1140|        self,\n1141|        backend_id: str,\n1142|        config: Mapping[str, Any],\n1143|        catalog_source: Callable[[], Mapping[str, Any]],\n1144|        host: Any = None,\n1145|        *,\n1146|        limits: Optional[PassthroughLimits] = None,\n1147|        process_budget: Optional[ProcessBudget] = None,\n1148|        sanitize: Optional[bool] = None,\n1149|    ) -> None:\n1150|        super().__init__(backend_id, config, catalog_source, host)\n1151|        api_key_env = self.config.get(\"api_key_env\")\n1152|        api_key = self.config.get(\"api_key\")\n1153|        self._upstream_key = (\n1154|            os.environ.get(api_key_env) if isinstance(api_key_env, str) else \"\"\n1155|        ) or (api_key if isinstance(api_key, str) else \"\")\n1156|        self._limits = limits\n1157|        initial_limits = self.limits\n1158|        self.process_budget = process_budget or ProcessBudget(\n1159|            initial_limits.accumulator_max_process_bytes\n1160|        )\n1161|        self._sanitize = sanitize\n1162|        self._active = 0\n1163|        self._lock = threading.Lock()\n1164|        self._slots = threading.BoundedSemaphore(self.max_concurrent)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
