{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ff","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":90,"recorded_at":1780531400000175,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"task_stream":{"kind":"task","id":"01a19c26-f6fc-7121-a320-74141d80d14d"},"task_id":"01a19c26-f6fc-7121-a320-74141d80d14d","event":{"kind":"output","task_id":"01a19c26-f6fc-7121-a320-74141d80d14d","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py`.\n1|\"\"\"Регрессии разделения прогресса процесса, клиентского heartbeat и безопасного retry.\"\"\"\n2|\n3|from __future__ import annotations\n4|\n5|import io\n6|import json\n7|import os\n8|import queue\n9|from pathlib import Path\n10|import signal\n11|import subprocess\n12|import sys\n13|import threading\n14|import time\n15|from collections.abc import Callable, Generator, Mapping\n16|from http.client import HTTPConnection\n17|from types import SimpleNamespace\n18|from typing import Protocol, TypedDict, Unpack, cast, override\n19|from unittest.mock import Mock\n20|\n21|import pytest\n22|\n23|from adapters.passthrough_adapter import (\n24|    PassthroughLimits,\n25|    ResponseSink,\n26|    StreamOutcome,\n27|    relay_sse,\n28|)\n29|from core.lifecycle import KeepaliveController\n30|from core.turn_session_manager import TurnSessionManager\n31|from core.watchdog import AdaptiveTimeoutController, ProcessWatchdog, WatchdogMetrics\n32|from tests.rpc_testlib import RpcCase\n33|from tests.test_http_presend_resilience import json_reply, stand\n34|\n35|\n36|class Delta(TypedDict, total=False):\n37|    content: str\n38|    reasoning_content: str\n39|\n40|\n41|class Choice(TypedDict):\n42|    delta: Delta\n43|    finish_reason: str | None\n44|\n45|\n46|class Chunk(TypedDict):\n47|    id: str\n48|    object: str\n49|    created: int\n50|    model: str\n51|    choices: list[Choice]\n52|\n53|\n54|class ErrorDetail(TypedDict):\n55|    type: str\n56|    code: int\n57|\n58|\n59|class ErrorBody(TypedDict):\n60|    error: ErrorDetail\n61|\n62|\n63|class ControllerOptions(TypedDict, total=False):\n64|    io_wait_cap_s: float\n65|    safety_cap_s: float\n66|\n67|\n68|class HandleArguments(TypedDict):\n69|    path: str\n70|    raw_body: bytes\n71|    request: Mapping[str, object]\n72|    headers: Mapping[str, str]\n73|    sink: ResponseSink\n74|\n75|\n76|class HandlerFixture(Protocol):\n77|    path: str\n78|    headers: dict[str, str]\n79|    wfile: io.BytesIO\n80|    connection: Mock\n81|    send_response: Mock\n82|    send_header: Mock\n83|    end_headers: Callable[[], None]\n84|    request_version: str\n85|\n86|    def handle_expect_100(self) -> bool: ...\n87|\n88|\n89|class MockSink(Protocol):\n90|    start: Mock\n91|    write: Mock\n92|    client_gone: Callable[[], bool]\n93|\n94|\n95|class OpenConnection(Protocol):\n96|    def __call__(\n97|        self,\n98|        path: str,\n99|        raw_body: bytes,\n100|        headers: Mapping[str, str],\n101|        *,\n102|        presend_deadline: float | None,\n103|    ) -> HTTPConnection: ...\n104|\n105|\n106|def serve_passthrough(\n107|    handler: HandlerFixture,\n108|    adapter: object,\n109|    raw: bytes,\n110|    request: dict[str, object],\n111|    model: str,\n112|) -> None:\n113|    \"\"\"Типизирует динамический шов настоящего Handler, не подменяя реализацию.\"\"\"\n114|    method = cast(\n115|        Callable[[object, bytes, dict[str, object], str], None],\n116|        getattr(handler, \"_serve_passthrough\"),\n117|    )\n118|    method(adapter, raw, request, model)\n119|\n120|\n121|def serve_sse(handler: HandlerFixture, context: dict[str, object]) -> None:\n122|    method = cast(\n123|        Callable[[dict[str, object]], None], getattr(handler, \"_serve_sse_body\")\n124|    )\n125|    method(context)\n126|\n127|\n128|def discard(_value: object) -> None:\n129|    return None\n130|\n131|\n132|@pytest.fixture(autouse=True)\n133|def fake_client_probe(monkeypatch: pytest.MonkeyPatch) -> None:\n134|    import server\n135|\n136|    def connected(_sock: object) -> bool:\n137|        return False\n138|\n139|    monkeypatch.setattr(server, \"_client_gone\", connected)\n140|\n141|\n142|class Clock:\n143|    \"\"\"Управляемое монотонное время без ожиданий в тестах.\"\"\"\n144|\n145|    def __init__(self) -> None:\n146|        self.now: float = 1000.0\n147|\n148|    def __call__(self) -> float:\n149|        return self.now\n150|\n151|\n152|def metrics(\n153|    state: str = \"S\", *, alive: bool = True, cpu: float = 0.0\n154|) -> WatchdogMetrics:\n155|    return WatchdogMetrics(4242, alive, (), (), cpu, cpu, states=[state])\n156|\n157|\n158|def controller(\n159|    clock: Clock, state: str = \"S\", **kwargs: Unpack[ControllerOptions]\n160|) -> AdaptiveTimeoutController:\n161|    watchdog = Mock(spec=ProcessWatchdog)\n162|    cast(Mock, getattr(watchdog, \"sample\")).return_value = metrics(state)\n163|    ctrl = AdaptiveTimeoutController(\n164|        idle_timeout_s=10,\n165|        finish_reserve_s=0,\n166|        clock=clock,\n167|        watchdog=cast(ProcessWatchdog, watchdog),\n168|        **kwargs,\n169|    )\n170|    ctrl.register_pgid(4242)\n171|    return ctrl\n172|\n173|\n174|def test_active_keepalive_resets_watchdog() -> None:\n175|    # Предикат pi-ai: только truthy content/reasoning_content считается прогрессом.\n176|    frame = KeepaliveController.sse_data_chunk(model=\"test\")\n177|    chunk = cast(Chunk, json.loads(frame.removeprefix(\"data: \").strip()))\n178|    delta = chunk[\"choices\"][0][\"delta\"]\n179|    idle_deadline = 300\n180|    for now in range(10, 1001, 10):\n181|        assert now < idle_deadline\n182|        if delta.get(\"content\") or delta.get(\"reasoning_content\"):\n183|            idle_deadline = now + 300\n184|    assert chunk[\"id\"].startswith(\"chatcmpl-ping-\")\n185|    assert chunk[\"object\"] == \"chat.completion.chunk\"\n186|    assert chunk[\"choices\"][0][\"finish_reason\"] is None\n187|    assert delta == {\"reasoning_content\": \" \"}\n188|    assert (\n189|        cast(\n190|            Chunk, json.loads(KeepaliveController.sse_data_chunk(reasoning=False)[6:])\n191|        )[\"choices\"][0][\"delta\"]\n192|        == {}\n193|    )\n194|\n195|\n196|@pytest.mark.parametrize(\"state\", [\"S\", \"S+\", \"Ss\", \"D\", \"D<\", \"I\", \"I+\", \"U\", \"U+\"])\n197|def test_process_watchdog_io_grace(state: str) -> None:\n198|    clock = Clock()\n199|    ctrl = controller(clock, state, io_wait_cap_s=900)\n200|    clock.now += 120\n201|    assert ctrl.check()[0] is False\n202|    assert ctrl.last_activity_ts == 1000\n203|    clock.now = 1899.9\n204|    assert ctrl.check()[0] is False\n205|    clock.now = 1900\n206|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n207|\n208|\n209|def test_process_watchdog_terminates_after_cap() -> None:\n210|    clock = Clock()\n211|    ctrl = controller(clock, safety_cap_s=3600)\n212|    clock.now += 3600\n213|    ctrl.record_activity(\"cpu\")\n214|    assert ctrl.check()[:2] == (True, \"absolute_cap\")\n215|\n216|\n217|@pytest.mark.parametrize(\"state\", [\"R\", \"T\", \"Z\", \"X\", \"?\", \"\"])\n218|def test_unknown_or_dead_states_get_no_io_grace(state: str) -> None:\n219|    clock = Clock()\n220|    ctrl = controller(clock, state)\n221|    clock.now += 11\n222|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n223|    assert not metrics(state, alive=False).is_waiting_io()\n224|\n225|\n226|def test_disabled_grace_and_idle_floor(monkeypatch: pytest.MonkeyPatch) -> None:\n227|    monkeypatch.setenv(\"BRIDGE_IO_GRACE_ENABLED\", \"false\")\n228|    clock = Clock()\n229|    ctrl = controller(clock)\n230|    clock.now += 11\n231|    assert ctrl.check()[:2] == (True, \"idle_timeout\")\n232|    assert AdaptiveTimeoutController(idle_timeout_s=1).idle_timeout_s >= 10\n233|\n234|\n235|def test_safety_cap_despite_cpu_progress() -> None:\n236|    clock = Clock()\n237|    ctrl = controller(clock, safety_cap_s=30)\n238|    cast(Mock, getattr(ctrl.watchdog, \"sample\")).return_value = metrics(\"R\", cpu=1)\n239|    for offset in (11, 22):\n240|        clock.now = 1000 + offset\n241|        assert ctrl.check()[0] is False\n242|    clock.now = 1030\n243|    assert ctrl.check()[:2] == (True, \"absolute_cap\")\n244|\n245|\n246|def test_env_configuration_parameters(monkeypatch: pytest.MonkeyPatch) -> None:\n247|    from core.lifecycle import PreSendRetry\n248|\n249|    for key, value in {\n250|        \"BRIDGE_IO_WAIT_CAP_S\": \"321.5\",\n251|        \"BRIDGE_SAFETY_CAP_S\": \"700.5\",\n252|        \"BRIDGE_MAX_RETRIES\": \"2\",\n253|        \"BRIDGE_RETRY_BUDGET_S\": \"19.5\",\n254|        \"BRIDGE_KEEPALIVE_INTERVAL_S\": \"0.1\",\n255|        \"BRIDGE_IO_GRACE_ENABLED\": \"off\",\n256|    }.items():\n257|        monkeypatch.setenv(key, value)\n258|    ctrl = AdaptiveTimeoutController()\n259|    assert (ctrl.io_wait_cap_s, ctrl.safety_cap_s, ctrl.io_grace_enabled) == (\n260|        321.5,\n261|        700.5,\n262|        False,\n263|    )\n264|    retry = PreSendRetry()\n265|    assert (retry.max_retries, retry.budget_s) == (2, 19.5)\n266|    assert KeepaliveController().effective_interval() == 0.1\n267|\n268|\n269|@pytest.mark.parametrize(\"bad\", [\"nan\", \"inf\", \"-1\", \"0\", \"broken\", \"\"])\n270|def test_invalid_env_uses_safe_fallback(\n271|    monkeypatch: pytest.MonkeyPatch, bad: str\n272|) -> None:\n273|    from core.lifecycle import PreSendRetry\n274|\n275|    for key in (\n276|        \"IO_WAIT_CAP_S\",\n277|        \"SAFETY_CAP_S\",\n278|        \"RETRY_BUDGET_S\",\n279|        \"KEEPALIVE_INTERVAL_S\",\n280|        \"MAX_RETRIES\",\n281|        \"IO_GRACE_ENABLED\",\n282|    ):\n283|        monkeypatch.setenv(\"BRIDGE_\" + key, bad)\n284|    ctrl = AdaptiveTimeoutController()\n285|    assert (ctrl.io_wait_cap_s, ctrl.safety_cap_s) == (900, 3600)\n286|    assert KeepaliveController().effective_interval() == 10\n287|    assert PreSendRetry().budget_s == 60\n288|    assert PreSendRetry().max_retries == (0 if bad == \"0\" else 3)\n289|\n290|\n291|def test_state_sampling_reads_actual_sleeping_group() -> None:\n292|    proc = subprocess.Popen(\n293|        [\n294|            sys.executable,\n295|            \"-c\",\n296|            \"import time; print('ready', flush=True); time.sleep(60)\",\n297|        ],\n298|        start_new_session=True,\n299|        stdout=subprocess.PIPE,\n300|    )\n301|    try:\n302|        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n303|        sample = ProcessWatchdog().sample(proc.pid)\n304|        assert sample.alive\n305|        assert sample.states\n306|        assert sample.is_waiting_io()\n307|        assert all(state[0] not in \"ZX\" for state in sample.states)\n308|    finally:\n309|        os.killpg(proc.pid, signal.SIGTERM)\n310|        _ = proc.wait(timeout=5)\n311|\n312|\n313|def test_turn_manager_heartbeat_preserves_identity_and_history(tmp_path: Path) -> None:\n314|    manager = TurnSessionManager(state_root=tmp_path)\n315|    turn, _ = manager.create_or_attach_turn(\n316|        model=\"test\", backend=\"test\", cwd=str(tmp_path), messages=[]\n317|    )\n318|    started = turn.timeout_controller.last_activity_ts\n319|    frames = manager.iter_sse_stream(turn, keepalive_interval_s=0.01)\n320|    try:\n321|        heartbeat = next(frames)\n322|        data = next(\n323|            line[6:] for line in heartbeat.splitlines() if line.startswith(\"data: \")\n324|        )\n325|        chunk = cast(Chunk, json.loads(data))\n326|        assert chunk[\"id\"] == f\"chatcmpl-turn-{turn.turn_id}\"\n327|        assert chunk[\"model\"] == \"test\"\n328|        assert chunk[\"choices\"][0][\"delta\"].get(\"reasoning_content\")\n329|        assert turn.buffer.get_reasoning_text() == \"\"\n330|        assert turn.buffer.get_content_text() == \"\"\n331|        assert turn.timeout_controller.last_activity_ts == started\n332|    finally:\n333|        cast(Generator[str, None, None], frames).close()\n334|        manager.finalize_abandoned_turn(turn)\n335|\n336|\n337|def make_handler() -> HandlerFixture:\n338|    import server\n339|\n340|    handler = cast(HandlerFixture, cast(object, server.Handler.__new__(server.Handler)))\n341|    setattr(handler, \"_trace\", None)\n342|    handler.path = \"/v1/chat/completions\"\n343|    handler.headers = {}\n344|    handler.wfile = io.BytesIO()\n345|    handler.connection = Mock()\n346|    setattr(handler, \"_current_lease\", lambda: Mock())\n347|    handler.send_response = Mock()\n348|    handler.send_header = Mock()\n349|    handler.end_headers = Mock()\n350|    return handler\n351|\n352|\n353|@pytest.mark.parametrize(\"status\", [502, 503, None])\n354|def test_presend_retry_resilience(\n355|    monkeypatch: pytest.MonkeyPatch, status: int | None\n356|) -> None:\n357|    from core.backend_adapter import PreSendTransientError\n358|\n359|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"0.001\")\n360|    handler = make_handler()\n361|    attempts: list[int] = []\n362|\n363|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n364|        attempts.append(1)\n365|        if len(attempts) < 3:\n366|            raise PreSendTransientError(\"not dispatched\", status_code=status)\n367|        sink = kwargs[\"sink\"]\n368|        sink.start(200, [])\n369|        sink.write(b\"ok\")\n370|\n371|    adapter = SimpleNamespace(id=\"test\", handle=handle)\n372|    serve_passthrough(handler, adapter, b\"{}\", {}, \"test\")\n373|    assert len(attempts) == 3\n374|    assert handler.wfile.getvalue() == b\"ok\"\n375|    cast(Mock, getattr(handler, \"send_response\")).assert_called_once_with(200)\n376|\n377|\n378|@pytest.mark.parametrize(\"emission\", [\"headers\", \"heartbeat\", \"content\"])\n379|def test_no_retry_after_first_downstream_emission(\n380|    monkeypatch: pytest.MonkeyPatch, emission: str\n381|) -> None:\n382|    from core.backend_adapter import PreSendTransientError\n383|\n384|    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"0.001\")\n385|    handler = make_handler()\n386|    attempts: list[int] = []\n387|\n388|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n389|        attempts.append(1)\n390|        sink = kwargs[\"sink\"]\n391|        sink.start(200, [])\n392|        if emission != \"headers\":\n393|            sink.write(\n394|                KeepaliveController.sse_data_chunk().encode()\n395|                if emission == \"heartbeat\"\n396|                else b\"first\"\n397|            )\n398|        raise PreSendTransientError(\"late transport error\", status_code=502)\n399|\n400|    with pytest.raises(PreSendTransientError):\n401|        serve_passthrough(\n402|            handler, SimpleNamespace(id=\"test\", handle=handle), b\"{}\", {}, \"test\"\n403|        )\n404|    assert len(attempts) == 1\n405|\n406|\n407|def test_ambiguous_upstream_response_is_never_replayed() -> None:\n408|    handler = make_handler()\n409|    calls: list[int] = []\n410|\n411|    def handle(**kwargs: Unpack[HandleArguments]) -> None:\n412|        calls.append(1)\n413|        kwargs[\"sink\"].start(502, [])\n414|        kwargs[\"sink\"].write(b\"upstream may have started\")\n415|\n416|    serve_passthrough(\n417|        handler, SimpleNamespace(id=\"test\", handle=handle), b\"{}\", {}, \"test\"\n418|    )\n419|    assert len(calls) == 1\n420|\n421|\n422|def test_retry_exhaustion_budget_and_cancellation(\n423|    monkeypatch: pytest.MonkeyPatch,\n424|) -> None:\n425|    from core.backend_adapter import PreSendTransientError\n426|    from core.lifecycle import PreSendRetry\n427|\n428|    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", \"2\")\n429|    clock = Clock()\n430|    waits: list[float] = []\n431|\n432|    def wait(delay: float) -> bool:\n433|        waits.append(delay)\n434|        clock.now += delay\n435|        return False\n436|\n437|    op = Mock(side_effect=PreSendTransientError(\"connect refused\"))\n438|    with pytest.raises(PreSendTransientError):\n439|        PreSendRetry(clock=clock, wait=wait, rng=lambda _lo, hi: hi).run(op)\n440|    assert op.call_count == 3\n441|    assert len(waits) == 2\n442|    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"0.1\")\n443|    op.reset_mock()\n444|    with pytest.raises(PreSendTransientError):\n445|        PreSendRetry(clock=clock, wait=wait, rng=lambda _lo, hi: hi).run(op)\n446|    assert op.call_count == 1\n447|    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"60\")\n448|    op.reset_mock()\n449|    cancelled_wait = Mock(return_value=True)\n450|    with pytest.raises(PreSendTransientError):\n451|        PreSendRetry(wait=cancelled_wait).run(op)\n452|    assert op.call_count == 1\n453|    cancelled_wait.assert_called_once()\n454|\n455|\n456|def test_zero_retries_disables_replay(monkeypatch: pytest.MonkeyPatch) -> None:\n457|    from core.backend_adapter import PreSendTransientError\n458|    from core.lifecycle import PreSendRetry\n459|\n460|    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", \"0\")\n461|    op = Mock(side_effect=PreSendTransientError(\"not sent\"))\n462|    with pytest.raises(PreSendTransientError):\n463|        PreSendRetry().run(op)\n464|    assert op.call_count == 1\n465|\n466|\n467|def test_real_backoff_is_cancelled_promptly(monkeypatch: pytest.MonkeyPatch) -> None:\n468|    from core.backend_adapter import PreSendTransientError\n469|    from core.lifecycle import PreSendRetry\n470|\n471|    monkeypatch.setenv(\"BRIDGE_RETRY_CANCEL_POLL_S\", \"0.01\")\n472|    cancelled, attempted, stopped = (\n473|        threading.Event(),\n474|        threading.Event(),\n475|        threading.Event(),\n476|    )\n477|\n478|    def operation() -> None:\n479|        attempted.set()\n480|        raise PreSendTransientError(\"not sent\")\n481|\n482|    def run() -> None:\n483|        try:\n484|            PreSendRetry(cancelled=cancelled.is_set, rng=lambda _lo, hi: hi).run(\n485|                operation\n486|            )\n487|        except PreSendTransientError:\n488|            stopped.set()\n489|\n490|    worker = threading.Thread(target=run)\n491|    worker.start()\n492|    try:\n493|        assert attempted.wait(1)\n494|        cancelled.set()\n495|        assert stopped.wait(0.5), \"отмена должна прерывать реальный backoff\"\n496|    finally:\n497|        cancelled.set()\n498|        worker.join(timeout=2)\n499|\n500|\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c401","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":91,"recorded_at":1780531400000177,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"task_stream":{"kind":"task","id":"01a19c26-f6fc-7121-a320-74141d80d14d"},"task_id":"01a19c26-f6fc-7121-a320-74141d80d14d","event":{"kind":"completed","task_id":"01a19c26-f6fc-7121-a320-74141d80d14d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c403","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":92,"recorded_at":1780531400000179,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"task_stream":{"kind":"task","id":"01a19c26-f6cd-7810-8a1a-8b233100d005"},"task_id":"01a19c26-f6cd-7810-8a1a-8b233100d005","event":{"kind":"output","task_id":"01a19c26-f6cd-7810-8a1a-8b233100d005","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py`.\n1|\"\"\"Сквозной OpenAI-совместимый passthrough хаба (ADR 0011, AD-003/AD-005/AD-007).\n2|\n3|Отдельный raw HTTP-шов вне `TurnContext`/`TurnResult`: запрос уходит upstream (`base_url`\n4|из `fleet.json`, например `codex-lb` на `127.0.0.1:2455`) дословно, ответ возвращается с\n5|единственной нормализацией — санитизацией `tool_calls` общим ядром `core.tool_emulation`.\n6|Модуль не знает ни об одном конкретном upstream, клиенте или модели и не импортирует `server`.\n7|\n8|Стриминг: `content`/`reasoning` идут без задержки; дельты `tool_calls` копятся по составному\n9|ключу `(choice.index, tool_call.index)` и выпускаются только вместе с терминальным\n10|`finish_reason` своей choice. Конец потока без `finish_reason` (обрыв upstream, RW-002)\n11|сбрасывает буфер choice: недособранные вызовы downstream не уходят, клиент получает\n12|терминальный error-chunk без `[DONE]`.\n13|\n14|Лимиты не зашиты в код: чтение env — здесь (адаптер, не ядро; BND-001), значения по\n15|умолчанию — параметры `PassthroughLimits`, ядру они передаются аргументами.\n16|\"\"\"\n17|\n18|from __future__ import annotations\n19|\n20|import hmac\n21|import http.client\n22|import json\n23|import math\n24|import os\n25|import queue\n26|import re\n27|import socket\n28|import threading\n29|import time\n30|import urllib.parse\n31|import uuid\n32|from dataclasses import dataclass, field\n33|from typing import Any, Callable, Iterator, Mapping, Optional\n34|\n35|from core.backend_adapter import (\n36|    SESSIONS_NONE,\n37|    STREAMING_NATIVE,\n38|    BackendAdapter,\n39|    BackendModel,\n40|    BackendNotSupported,\n41|    Capabilities,\n42|    Qualification,\n43|    PreSendTransientError,\n44|    StreamSink,\n45|    TurnContext,\n46|    TurnResult,\n47|)\n48|try:\n49|    from core.tool_emulation import (\n50|        DEFAULT_MAX_PARALLEL_CALLS,\n51|        DEFAULT_MAX_PARALLEL_DEPTH,\n52|        DEFAULT_MAX_REPETITION_REPEATS,\n53|        DEFAULT_MAX_REPETITION_TOKEN_LEN,\n54|        RepetitionGuard,\n55|        ToolCallParser,\n56|        build_tool_schemas,\n57|        sanitize_tool_call,\n58|    )\n59|except ImportError:\n60|    from core.tool_emulation import (  # type: ignore[no-redef]\n61|        DEFAULT_MAX_PARALLEL_CALLS,\n62|        DEFAULT_MAX_PARALLEL_DEPTH,\n63|        ToolCallParser,\n64|        build_tool_schemas,\n65|        sanitize_tool_call,\n66|    )\n67|    DEFAULT_MAX_REPETITION_REPEATS = 20\n68|    DEFAULT_MAX_REPETITION_TOKEN_LEN = 64\n69|    RepetitionGuard = None  # type: ignore[assignment,misc]\n70|from core.stream_framing import (\n71|    build_stream_error_chunk,\n72|    format_sse_event,\n73|    format_stream_error_sse,\n74|    is_graceful_error_framing_enabled,\n75|)\n76|\n77|# Имена env (таблица AD-005) и значения по умолчанию: defaults — не потолки, переопределяются.\n78|ENV_MAX_PARALLEL_CALLS = \"BRIDGE_MAX_PARALLEL_CALLS\"\n79|ENV_MAX_PARALLEL_DEPTH = \"BRIDGE_MAX_PARALLEL_DEPTH\"\n80|ENV_MAX_BODY_BYTES = \"BRIDGE_PASSTHROUGH_MAX_BODY_BYTES\"\n81|ENV_ACC_MAX_BYTES = \"BRIDGE_ACCUMULATOR_MAX_BYTES\"\n82|ENV_ACC_MAX_KEYS = \"BRIDGE_ACCUMULATOR_MAX_KEYS\"\n83|ENV_ACC_MAX_PROCESS_BYTES = \"BRIDGE_ACCUMULATOR_MAX_PROCESS_BYTES\"\n84|ENV_CONNECT_TIMEOUT_S = \"BRIDGE_PASSTHROUGH_CONNECT_TIMEOUT_S\"\n85|ENV_READ_TIMEOUT_S = \"BRIDGE_PASSTHROUGH_READ_TIMEOUT_S\"\n86|# ADR-0020: env читает адаптер (не ядро, BND-001) и передаёт значения аргументами.\n87|ENV_REPETITION_MAX_REPEATS = \"BRIDGE_REPETITION_MAX_REPEATS\"\n88|ENV_REPETITION_MAX_TOKEN_LEN = \"BRIDGE_REPETITION_MAX_TOKEN_LEN\"\n89|ENV_REPETITION_GUARD_ENABLED = \"BRIDGE_REPETITION_GUARD_ENABLED\"\n90|ENV_INVOKE_NORMALIZATION_ENABLED = \"BRIDGE_INVOKE_NORMALIZATION_ENABLED\"\n91|\n92|DEFAULT_MAX_BODY_BYTES = 16 * 1024 * 1024\n93|DEFAULT_ACC_MAX_BYTES = 8 * 1024 * 1024\n94|DEFAULT_ACC_MAX_KEYS = 64\n95|DEFAULT_ACC_MAX_PROCESS_BYTES = 32 * 1024 * 1024\n96|DEFAULT_CONNECT_TIMEOUT_S = 10.0\n97|DEFAULT_READ_TIMEOUT_S = 1800.0\n98|DEFAULT_IDLE_TIMEOUT_S = 300.0\n99|DEFAULT_TOTAL_TIMEOUT_S = 420.0\n100|DEFAULT_SAFETY_CAP_S = 3600.0\n101|DEFAULT_QUEUE_TIMEOUT_S = (\n102|    900.0  # ожидание слота `max_concurrent`, если хост своего не задал\n103|)\n104|\n105|KIND = \"passthrough\"\n106|\n107|# Заголовки соединения (RFC 9110 §7.6.1) не пробрасываются; Host/Content-Length ставит шов.\n108|_HOP_BY_HOP = frozenset(\n109|    {\n110|        \"connection\",\n111|        \"keep-alive\",\n112|        \"proxy-authenticate\",\n113|        \"proxy-authorization\",\n114|        \"proxy-connection\",\n115|        \"te\",\n116|        \"trailer\",\n117|        \"trailers\",\n118|        \"transfer-encoding\",\n119|        \"upgrade\",\n120|    }\n121|)\n122|_TOOL_SANITIZED_HEADER = \"x-bridge-tool-sanitized\"\n123|_REQUEST_DROP = _HOP_BY_HOP | {\n124|    \"host\",\n125|    \"content-length\",\n126|    \"accept-encoding\",\n127|    _TOOL_SANITIZED_HEADER,\n128|}\n129|_RESPONSE_DROP = _HOP_BY_HOP | {\"content-length\", _TOOL_SANITIZED_HEADER}\n130|\n131|\n132|def _positive_int(environ: Mapping[str, str], name: str, default: int) -> int:\n133|    try:\n134|        value = int(str(environ.get(name, \"\")).strip())\n135|    except ValueError:\n136|        return default\n137|    return value if value > 0 else default\n138|\n139|\n140|def _positive_float(environ: Mapping[str, str], name: str, default: float) -> float:\n141|    try:\n142|        value = float(str(environ.get(name, \"\")).strip())\n143|    except ValueError:\n144|        return default\n145|    return value if math.isfinite(value) and value > 0 else default\n146|\n147|\n148|def _bounded_int(\n149|    environ: Mapping[str, str], name: str, default: int, low: int, high: int\n150|) -> int:\n151|    try:\n152|        value = int(str(environ.get(name, \"\")).strip())\n153|    except ValueError:\n154|        return default\n155|    return value if low <= value <= high else default\n156|\n157|\n158|def _env_bool(environ: Mapping[str, str], name: str, default: bool) -> bool:\n159|    raw = str(environ.get(name, \"\")).strip().lower()\n160|    if raw in (\"1\", \"true\", \"yes\", \"on\"):\n161|        return True\n162|    if raw in (\"0\", \"false\", \"no\", \"off\"):\n163|        return False\n164|    return default\n165|\n166|\n167|@dataclass(frozen=True)\n168|class PassthroughLimits:\n169|    \"\"\"Эффективные лимиты шва; ядру `max_parallel_*` передаются параметрами.\"\"\"\n170|\n171|    max_parallel_calls: int = DEFAULT_MAX_PARALLEL_CALLS\n172|    max_parallel_depth: int = DEFAULT_MAX_PARALLEL_DEPTH\n173|    max_body_bytes: int = DEFAULT_MAX_BODY_BYTES\n174|    accumulator_max_bytes: int = DEFAULT_ACC_MAX_BYTES\n175|    accumulator_max_keys: int = DEFAULT_ACC_MAX_KEYS\n176|    accumulator_max_process_bytes: int = DEFAULT_ACC_MAX_PROCESS_BYTES\n177|    connect_timeout_s: float = DEFAULT_CONNECT_TIMEOUT_S\n178|    read_timeout_s: float = DEFAULT_READ_TIMEOUT_S  # совместимость старого конструктора\n179|    idle_timeout_s: float = DEFAULT_IDLE_TIMEOUT_S\n180|    total_timeout_s: float = DEFAULT_TOTAL_TIMEOUT_S\n181|    safety_cap_s: float = DEFAULT_SAFETY_CAP_S\n182|    heartbeat_interval_s: float = 12.0\n183|    poll_interval_s: float = 0.1\n184|    reader_join_timeout_s: float = 0.2\n185|    read_queue_max_entries: int = 1\n186|    repetition_max_repeats: int = DEFAULT_MAX_REPETITION_REPEATS\n187|    repetition_max_token_len: int = DEFAULT_MAX_REPETITION_TOKEN_LEN\n188|    repetition_guard_enabled: bool = False\n189|    invoke_normalization_enabled: bool = False\n190|\n191|    @classmethod\n192|    def from_env(\n193|        cls, environ: Optional[Mapping[str, str]] = None\n194|    ) -> \"PassthroughLimits\":\n195|        \"\"\"Лимиты из окружения; нечисловое и неположительное значение -> default.\"\"\"\n196|        env = os.environ if environ is None else environ\n197|        return cls(\n198|            max_parallel_calls=_positive_int(\n199|                env, ENV_MAX_PARALLEL_CALLS, DEFAULT_MAX_PARALLEL_CALLS\n200|            ),\n201|            max_parallel_depth=_positive_int(\n202|                env, ENV_MAX_PARALLEL_DEPTH, DEFAULT_MAX_PARALLEL_DEPTH\n203|            ),\n204|            max_body_bytes=_positive_int(\n205|                env, ENV_MAX_BODY_BYTES, DEFAULT_MAX_BODY_BYTES\n206|            ),\n207|            accumulator_max_bytes=_positive_int(\n208|                env, ENV_ACC_MAX_BYTES, DEFAULT_ACC_MAX_BYTES\n209|            ),\n210|            accumulator_max_keys=_positive_int(\n211|                env, ENV_ACC_MAX_KEYS, DEFAULT_ACC_MAX_KEYS\n212|            ),\n213|            accumulator_max_process_bytes=_positive_int(\n214|                env, ENV_ACC_MAX_PROCESS_BYTES, DEFAULT_ACC_MAX_PROCESS_BYTES\n215|            ),\n216|            connect_timeout_s=_positive_float(\n217|                env,\n218|                \"BRIDGE_CONNECT_TIMEOUT_S\",\n219|                _positive_float(env, ENV_CONNECT_TIMEOUT_S, DEFAULT_CONNECT_TIMEOUT_S),\n220|            ),\n221|            read_timeout_s=_positive_float(\n222|                env, ENV_READ_TIMEOUT_S, DEFAULT_READ_TIMEOUT_S\n223|            ),\n224|            idle_timeout_s=_positive_float(\n225|                env, \"BRIDGE_IDLE_TIMEOUT_S\", DEFAULT_IDLE_TIMEOUT_S\n226|            ),\n227|            total_timeout_s=_positive_float(\n228|                env, \"BRIDGE_TOTAL_TIMEOUT_S\", DEFAULT_TOTAL_TIMEOUT_S\n229|            ),\n230|            safety_cap_s=_positive_float(\n231|                env, \"BRIDGE_SAFETY_CAP_S\", DEFAULT_SAFETY_CAP_S\n232|            ),\n233|            heartbeat_interval_s=_positive_float(\n234|                env, \"BRIDGE_SSE_HEARTBEAT_INTERVAL_S\", 12.0\n235|            ),\n236|            poll_interval_s=_positive_float(\n237|                env, \"BRIDGE_PASSTHROUGH_POLL_INTERVAL_S\", 0.1\n238|            ),\n239|            reader_join_timeout_s=_positive_float(\n240|                env, \"BRIDGE_PASSTHROUGH_READER_JOIN_TIMEOUT_S\", 0.2\n241|            ),\n242|            read_queue_max_entries=_positive_int(\n243|                env, \"BRIDGE_PASSTHROUGH_READ_QUEUE_MAX_ENTRIES\", 1\n244|            ),\n245|            repetition_max_repeats=_bounded_int(\n246|                env, ENV_REPETITION_MAX_REPEATS, DEFAULT_MAX_REPETITION_REPEATS, 3, 1000\n247|            ),\n248|            repetition_max_token_len=_bounded_int(\n249|                env,\n250|                ENV_REPETITION_MAX_TOKEN_LEN,\n251|                DEFAULT_MAX_REPETITION_TOKEN_LEN,\n252|                8,\n253|                512,\n254|            ),\n255|            repetition_guard_enabled=_env_bool(\n256|                env, ENV_REPETITION_GUARD_ENABLED, False\n257|            ),\n258|            invoke_normalization_enabled=_env_bool(\n259|                env, ENV_INVOKE_NORMALIZATION_ENABLED, False\n260|            ),\n261|        )\n262|\n263|\n264|class ClientGone(Exception):\n265|    \"\"\"Запись клиенту невозможна (отмена/обрыв): upstream закрывается, повторов нет.\"\"\"\n266|\n267|\n268|class AccumulatorOverflow(Exception):\n269|    \"\"\"Бюджет аккумулятора `tool_calls` (запрос/ключи/процесс) исчерпан.\"\"\"\n270|\n271|\n272|class UpstreamBodyTooLarge(Exception):\n273|    \"\"\"Тело или строка upstream превысили лимит.\"\"\"\n274|\n275|\n276|class ProcessBudget:\n277|    \"\"\"Суммарный бюджет аккумуляторов процесса по параллельным passthrough-запросам.\"\"\"\n278|\n279|    def __init__(self, limit: int) -> None:\n280|        self._limit = limit\n281|        self._used = 0\n282|        self._lock = threading.Lock()\n283|\n284|    @property\n285|    def used(self) -> int:\n286|        with self._lock:\n287|            return self._used\n288|\n289|    def reserve(self, size: int) -> bool:\n290|        with self._lock:\n291|            if self._used + size > self._limit:\n292|                return False\n293|            self._used += size\n294|            return True\n295|\n296|    def release(self, size: int) -> None:\n297|        with self._lock:\n298|            self._used = max(0, self._used - size)\n299|\n300|\n301|class ResponseSink:\n302|    \"\"\"Куда шов пишет ответ клиенту; реализует хаб (`server.py`). Любая ошибка записи -> ClientGone.\"\"\"\n303|\n304|    accepts_presend_errors = False\n305|\n306|    def start(self, status: int, headers: list[tuple[str, str]]) -> None:\n307|        raise NotImplementedError\n308|\n309|    def write(self, data: bytes) -> None:\n310|        raise NotImplementedError\n311|\n312|    def client_gone(self) -> bool:\n313|        \"\"\"Необязательный неблокирующий сигнал отмены от HTTP-фасада.\"\"\"\n314|        return False\n315|\n316|\n317|def new_call_id() -> str:\n318|    return \"call_\" + uuid.uuid4().hex[:24]\n319|\n320|\n321|@dataclass\n322|class _PartialCall:\n323|    \"\"\"Собираемый вызов одного ключа `(choice.index, tool_call.index)`.\"\"\"\n324|\n325|    id: str = \"\"\n326|    type: str = \"function\"\n327|    name: str = \"\"\n328|    arguments: list[str] = field(default_factory=list)\n329|\n330|\n331|class ToolCallAccumulator:\n332|    \"\"\"Дельты `tool_calls` по составному ключу `(choice.index, tool_call.index)`.\n333|\n334|    Рост буфера проверяется ДО добавления фрагмента (запрос, число ключей, процесс);\n335|    освобождение бюджета — `pop_choice`/`drop_choice`/`close` (идемпотентно).\n336|    \"\"\"\n337|\n338|    def __init__(\n339|        self, limits: PassthroughLimits, process: Optional[ProcessBudget] = None\n340|    ) -> None:\n341|        self._limits = limits\n342|        self._process = process\n343|        self._entries: dict[tuple[int, int], _PartialCall] = {}\n344|        self._bytes = 0\n345|        self._last_index: dict[int, int] = {}\n346|        self._remap: dict[tuple[int, int], int] = {}\n347|\n348|    @property\n349|    def size_bytes(self) -> int:\n350|        return self._bytes\n351|\n352|    def _grow(self, size: int) -> None:\n353|        if size <= 0:\n354|            return\n355|        if self._bytes + size > self._limits.accumulator_max_bytes:\n356|            raise AccumulatorOverflow(\"accumulator_bytes\")\n357|        if self._process is not None and not self._process.reserve(size):\n358|            raise AccumulatorOverflow(\"accumulator_process_bytes\")\n359|        self._bytes += size\n360|\n361|    def next_tool_index(self, choice: int) -> int:\n362|        \"\"\"Следующий свободный индекс `tool_call` внутри `choice` (без коллизий с нативными).\"\"\"\n363|        indices = [key[1] for key in self._entries if key[0] == choice]\n364|        if choice in self._last_index:\n365|            indices.append(self._last_index[choice])\n366|        return (max(indices) + 1) if indices else 0\n367|\n368|    def _tool_index(self, choice: int, delta: Mapping[str, Any]) -> int:\n369|        raw = delta.get(\"index\")\n370|        if isinstance(raw, int) and not isinstance(raw, bool):\n371|            call_id = delta.get(\"id\")\n372|            if isinstance(call_id, str) and call_id:\n373|                existing = self._entries.get((choice, raw))\n374|                if existing is not None and existing.id and existing.id != call_id:\n375|                    idx = self.next_tool_index(choice)\n376|                    self._remap[(choice, raw)] = idx\n377|                else:\n378|                    self._remap.pop((choice, raw), None)\n379|                    idx = raw\n380|            else:\n381|                idx = self._remap.get((choice, raw), raw)\n382|        elif delta.get(\"id\") and choice in self._last_index:\n383|            idx = self.next_tool_index(choice)  # без index: новый id — новый вызов\n384|        else:\n385|            idx = self._last_index.get(choice, 0)\n386|        self._last_index[choice] = idx\n387|        return idx\n388|\n389|    def add(self, choice: int, deltas: Any) -> None:\n390|        for delta in deltas if isinstance(deltas, list) else ():\n391|            if not isinstance(delta, dict):\n392|                continue\n393|            key = (choice, self._tool_index(choice, delta))\n394|            entry = self._entries.get(key)\n395|            if entry is None:\n396|                if len(self._entries) >= self._limits.accumulator_max_keys:\n397|                    raise AccumulatorOverflow(\"accumulator_keys\")\n398|                entry = _PartialCall()\n399|                self._entries[key] = entry\n400|            fn = (\n401|                delta.get(\"function\") if isinstance(delta.get(\"function\"), dict) else {}\n402|            )\n403|            call_id = delta.get(\"id\")\n404|            if isinstance(call_id, str) and call_id and not entry.id:\n405|                self._grow(len(call_id.encode(\"utf-8\")))\n406|                entry.id = call_id\n407|            if isinstance(delta.get(\"type\"), str) and delta[\"type\"]:\n408|                entry.type = delta[\"type\"]\n409|            name = fn.get(\"name\")\n410|            if isinstance(name, str) and name and not entry.name:\n411|                self._grow(len(name.encode(\"utf-8\")))\n412|                entry.name = name\n413|            fragment = fn.get(\"arguments\")\n414|            if isinstance(fragment, str) and fragment:\n415|                self._grow(len(fragment.encode(\"utf-8\")))\n416|                entry.arguments.append(fragment)\n417|\n418|    def has_choice(self, choice: int) -> bool:\n419|        return any(key[0] == choice for key in self._entries)\n420|\n421|    def pending_choices(self) -> list[int]:\n422|        return sorted({key[0] for key in self._entries})\n423|\n424|    def _release(self, entry: _PartialCall) -> None:\n425|        size = (\n426|            len(entry.id.encode(\"utf-8\"))\n427|            + len(entry.name.encode(\"utf-8\"))\n428|            + sum(len(part.encode(\"utf-8\")) for part in entry.arguments)\n429|        )\n430|        self._bytes = max(0, self._bytes - size)\n431|        if self._process is not None:\n432|            self._process.release(size)\n433|\n434|    def pop_choice(self, choice: int) -> list[dict[str, Any]]:\n435|        \"\"\"Собранные вызовы choice в порядке `tool_call.index` (OpenAI-форма); буфер освобождается.\"\"\"\n436|        keys = sorted(key for key in self._entries if key[0] == choice)\n437|        calls: list[dict[str, Any]] = []\n438|        for key in keys:\n439|            entry = self._entries.pop(key)\n440|            self._release(entry)\n441|            calls.append(\n442|                {\n443|                    \"index\": key[1],\n444|                    \"id\": entry.id or new_call_id(),\n445|                    \"type\": entry.type,\n446|                    \"function\": {\n447|                        \"name\": entry.name,\n448|                        \"arguments\": \"\".join(entry.arguments),\n449|                    },\n450|                }\n451|            )\n452|        self._last_index.pop(choice, None)\n453|        for remap_key in [k for k in self._remap if k[0] == choice]:\n454|            self._remap.pop(remap_key, None)\n455|        return calls\n456|\n457|    def drop_choice(self, choice: int) -> None:\n458|        self.pop_choice(choice)\n459|\n460|    def close(self) -> None:\n461|        for choice in self.pending_choices():\n462|            self.drop_choice(choice)\n463|\n464|\n465|def sanitize_choice_calls(\n466|    calls: list[dict[str, Any]],\n467|    tool_schemas: Optional[dict[str, Any]],\n468|    limits: PassthroughLimits,\n469|) -> list[dict[str, Any]]:\n470|    \"\"\"Санитизация вызовов одной choice; `index` меняется только если `parallel` изменил число вызовов.\"\"\"\n471|    groups = [\n472|        sanitize_tool_call(\n473|            call,\n474|            tool_schemas,\n475|            max_parallel_calls=limits.max_parallel_calls,\n476|            max_parallel_depth=limits.max_parallel_depth,\n477|        )\n478|        for call in calls\n479|    ]\n480|    flat = [item for group in groups for item in group]\n481|    unpacked = any(\n482|        len(group) != 1 or group[0].get(\"id\") != call.get(\"id\")\n483|        for group, call in zip(groups, calls)\n484|    )\n485|    if not unpacked:\n486|        return flat\n487|    return [\n488|        dict(item, index=i) if \"index\" in item else item for i, item in enumerate(flat)\n489|    ]\n490|\n491|\n492|def sanitize_completion_body(\n493|    body: bytes,\n494|    tool_schemas: Optional[dict[str, Any]],\n495|    limits: PassthroughLimits,\n496|) -> bytes:\n497|    \"\"\"Тело non-stream `chat.completion`: санитизируются `choices[].message.tool_calls`\n498|    и (при `limits.invoke_normalization_enabled`) извлекаются `<invoke>` из `message.content`.\n499|\n500|    Невалидный JSON, форма без `choices` и ответ без изменений возвращаются байт-в-байт.\n(more lines below)","final_result":true}}}
