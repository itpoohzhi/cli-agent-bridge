{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c495","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":165,"recorded_at":1780531400000325,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"call_id":"call_01a19c27458974a5b4ca7f2ba39c81cb","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py`.\n(629 line(s) above)\n630|    \"\"\"Итог пробрасывания SSE (для журнала и тестов).\"\"\"\n631|\n632|    done: bool = False\n633|    incomplete: bool = False\n634|    overflow: bool = False\n635|    tool_calls_published: int = 0\n636|    committed: bool = False\n637|    repetition_loop: bool = False\n638|    last_chunk: Optional[dict[str, Any]] = None\n639|    unfinished_choices: Optional[set[int]] = None\n640|\n641|\n642|class _TimedSseReader:\n643|    \"\"\"Один bounded reader; ожидание I/O не мешает heartbeat и дедлайну.\"\"\"\n644|\n645|    def __init__(\n646|        self,\n647|        readline: Callable[[int], bytes],\n648|        write: Callable[[bytes], None],\n649|        limits: PassthroughLimits,\n650|        deadline: float | None = None,\n651|    ) -> None:\n652|        self.limits = limits\n653|        self.start_time = time.monotonic()\n654|        # Аварийный потолок жизни стрима; `deadline` (если задан) остаётся жёстким.\n655|        self.safety_deadline = (\n656|            deadline if deadline is not None else self.start_time + limits.safety_cap_s\n657|        )\n658|        self.write = write\n659|        self.items: queue.Queue[bytes | Exception] = queue.Queue(\n660|            maxsize=limits.read_queue_max_entries\n661|        )\n662|        self.stop = threading.Event()\n663|        # last_input — каденс heartbeat (вход upstream или свой keepalive);\n664|        # last_upstream — только реальный ввод upstream, без heartbeat.\n665|        self.last_input = self.start_time\n666|        self.last_upstream = self.start_time\n667|        self.last_progress: float | None = None\n668|\n669|        def read() -> None:\n670|            try:\n671|                while not self.stop.is_set():\n672|                    line = readline(limits.max_body_bytes + 1)\n673|                    while not self.stop.is_set():\n674|                        try:\n675|                            self.items.put(line, timeout=limits.poll_interval_s)\n676|                            break\n677|                        except queue.Full:\n678|                            continue\n679|                    if not line:\n680|                        return\n681|            except (OSError, http.client.HTTPException, ValueError) as exc:\n682|                while not self.stop.is_set():\n683|                    try:\n684|                        self.items.put(exc, timeout=limits.poll_interval_s)\n685|                        return\n686|                    except queue.Full:\n687|                        continue\n688|\n689|        self.thread = threading.Thread(target=read, daemon=True, name=\"passthrough-sse\")\n690|        self.thread.start()\n691|\n692|    def readline(self, _limit: int) -> bytes:\n693|        while True:\n694|            now = time.monotonic()\n695|            safety_remaining = self.safety_deadline - now\n696|            if safety_remaining <= 0:\n697|                raise TimeoutError(\"upstream stream safety cap exceeded\")\n698|            # Скользящее окно: срок тишины отсчитывается от последней активности.\n699|            activity_base = (\n700|                self.last_progress\n701|                if self.last_progress is not None\n702|                else self.last_upstream\n703|            )\n704|            idle_remaining = activity_base + self.limits.idle_timeout_s - now\n705|            if idle_remaining <= 0:\n706|                raise TimeoutError(\"upstream stream idle timeout exceeded\")\n707|            remaining = min(idle_remaining, safety_remaining)\n708|            heartbeat_due = self.last_input + self.limits.heartbeat_interval_s - now\n709|            if heartbeat_due <= 0:\n710|                self.write(b\": keepalive\\n\\n\")\n711|                self.last_input = time.monotonic()\n712|                heartbeat_due = self.limits.heartbeat_interval_s\n713|            try:\n714|                item = self.items.get(\n715|                    timeout=min(remaining, heartbeat_due, self.limits.poll_interval_s)\n716|                )\n717|            except queue.Empty:\n718|                continue\n719|            if time.monotonic() >= self.safety_deadline:\n720|                raise TimeoutError(\"upstream stream safety cap exceeded\")\n721|            if isinstance(item, Exception):\n722|                raise item\n723|            if item:\n724|                self.last_input = self.last_upstream = time.monotonic()\n725|            return item\n726|\n727|    def close(self) -> None:\n728|        self.stop.set()\n729|        self.thread.join(timeout=self.limits.reader_join_timeout_s)\n730|\n731|\n732|def relay_sse(\n733|    readline: Callable[[int], bytes],\n734|    write: Callable[[bytes], None],\n735|    *,\n736|    tool_schemas: Optional[dict[str, Any]],\n737|    limits: PassthroughLimits,\n738|    process: Optional[ProcessBudget] = None,\n739|    sanitize: bool = True,\n740|    trusted_tools: bool = False,\n741|    state: StreamOutcome | None = None,\n742|    deadline: float | None = None,\n743|) -> StreamOutcome:\n744|    \"\"\"Пробросить SSE-поток upstream клиенту с санитизацией `tool_calls` (AD-005).\n745|\n746|    Исходный порядок событий сохраняется; единственное изменение — вызовы choice выходят\n747|    одним кадром прямо перед терминальным чанком своей choice, после санитизации.\n748|    \"\"\"\n749|    reader = _TimedSseReader(\n750|        readline,\n751|        write,\n752|        limits,\n753|        deadline,\n754|    )\n755|    outcome = state if state is not None else StreamOutcome()\n756|    client_write = write\n757|\n758|    def write(frame: bytes) -> None:\n759|        \"\"\"До вызова sink: даже частичная запись запрещает повтор запроса.\"\"\"\n760|        outcome.committed = True\n761|        client_write(frame)\n762|\n763|    acc = ToolCallAccumulator(limits, process)\n764|    seen: set[int] = set()\n765|    finished: set[int] = set()\n766|    last_chunk: dict[str, Any] = {}\n767|    guards: dict[int, RepetitionGuard] = {}\n768|    parsers: dict[int, ToolCallParser] = {}\n769|    parser_content: dict[int, list[str]] = {}\n770|    parser_calls: dict[int, list[dict]] = {}\n771|\n772|    def guard_for(index: int) -> RepetitionGuard:\n773|        if index not in guards:\n774|            guards[index] = RepetitionGuard(\n775|                max_repeats=limits.repetition_max_repeats,\n776|                max_token_len=limits.repetition_max_token_len,\n777|                enabled=limits.repetition_guard_enabled,\n778|            )\n779|        return guards[index]\n780|\n781|    def repetition_error() -> StreamOutcome:\n782|        acc.close()\n783|        outcome.repetition_loop = True\n784|        write(\n785|            _error_frame(\n786|                last_chunk,\n787|                \"upstream_repetition_loop\",\n788|                \"upstream repetition loop detected\",\n789|            )\n790|        )\n791|        return outcome\n792|\n793|    def check_repetition(index: int, text: str) -> bool:\n794|        if not limits.repetition_guard_enabled or not text:\n795|            return False\n796|        return guard_for(index).feed(text)[1]\n797|\n798|    def parser_for(index: int) -> ToolCallParser:\n799|        if index not in parsers:\n800|            parser_content[index] = []\n801|            parser_calls[index] = []\n802|            parsers[index] = ToolCallParser(\n803|                parser_content[index].append,\n804|                parser_calls[index].append,\n805|                tool_schemas=tool_schemas,\n806|                repetition_guard_enabled=False,\n807|            )\n808|        return parsers[index]\n809|\n810|    def add_invoke_calls(index: int) -> None:\n811|        for call in parser_calls.get(index, ()):\n812|            arguments = call.get(\"arguments\")\n813|            acc.add(\n814|                index,\n815|                [\n816|                    {\n817|                        \"index\": acc.next_tool_index(index),\n818|                        \"id\": str(call.get(\"id\") or new_call_id()),\n819|                        \"type\": \"function\",\n820|                        \"function\": {\n821|                            \"name\": str(call.get(\"name\") or \"\"),\n822|                            \"arguments\": arguments\n823|                            if isinstance(arguments, str)\n824|                            else json.dumps(arguments or {}, ensure_ascii=False),\n825|                        },\n826|                    }\n827|                ],\n828|            )\n829|        if index in parser_calls:\n830|            parser_calls[index].clear()\n831|\n832|    def content_frame(base: Mapping[str, Any], index: int, text: str) -> bytes:\n833|        payload: dict[str, Any] = {\n834|            k: base[k] for k in base if k not in (\"choices\", \"usage\", \"error\")\n835|        }\n836|        payload.setdefault(\"id\", last_chunk.get(\"id\") or \"chatcmpl-passthrough\")\n837|        payload.setdefault(\"object\", \"chat.completion.chunk\")\n838|        payload.setdefault(\"created\", last_chunk.get(\"created\") or int(time.time()))\n839|        payload.setdefault(\"model\", last_chunk.get(\"model\") or \"\")\n840|        payload[\"choices\"] = [\n841|            {\"index\": index, \"delta\": {\"content\": text}, \"finish_reason\": None}\n842|        ]\n843|        return _data_frame(payload)\n844|\n845|    def flush_parser(index: int, base: Mapping[str, Any]) -> Optional[StreamOutcome]:\n846|        \"\"\"`finish()` парсера choice: удержанный content уходит перед терминалом.\"\"\"\n847|        if index not in parsers:\n848|            return None\n849|        parser_content[index].clear()\n850|        add_invoke_calls(index)\n851|        parsers[index].finish()\n852|        flushed = \"\".join(parser_content[index])\n853|        parser_content[index].clear()\n854|        if flushed:\n855|            if check_repetition(index, flushed):\n856|                return repetition_error()\n857|            write(content_frame(base, index, flushed))\n858|        add_invoke_calls(index)\n859|        del parsers[index]\n860|        return None\n861|\n862|    try:\n863|        for raw, data in iter_sse_events(reader.readline, limits.max_body_bytes):\n864|            if data is None:\n865|                write(raw)  # комментарий/keepalive/event без data — дословно\n866|                continue\n867|            if data.strip() == \"[DONE]\":\n868|                for pending_index in sorted(list(parsers)):\n869|                    flushed_outcome = flush_parser(pending_index, last_chunk)\n870|                    if flushed_outcome is not None:\n871|                        return flushed_outcome\n872|                if acc.pending_choices() or (trusted_tools and seen - finished):\n873|                    acc.close()  # [DONE] без finish_reason у choice с вызовами: успеха нет\n874|                    outcome.incomplete = True\n875|                    write(\n876|                        _error_frame(\n877|                            last_chunk,\n878|                            \"upstream_incomplete_stream\",\n879|                            \"upstream stream ended before finish_reason\",\n880|                        )\n881|                    )\n882|                    return outcome\n883|                outcome.done = True\n884|                write(raw)\n885|                return outcome\n886|            try:\n887|                chunk = json.loads(data)\n888|            except ValueError:\n889|                if data.strip():\n890|                    reader.last_progress = time.monotonic()\n891|                write(raw)\n892|                continue\n893|            choices = chunk.get(\"choices\") if isinstance(chunk, dict) else None\n894|            if isinstance(choices, list):\n895|                # Role/usage — служебные кадры: TTFT защищён до первого полезного токена.\n896|                for choice in choices:\n897|                    delta = choice.get(\"delta\") if isinstance(choice, dict) else None\n898|                    if isinstance(delta, dict) and any(\n899|                        delta.get(key)\n900|                        for key in (\n901|                            \"content\",\n902|                            \"reasoning_content\",\n903|                            \"reasoning\",\n904|                            \"reasoning_text\",\n905|                            \"tool_calls\",\n906|                            \"function_call\",\n907|                        )\n908|                    ):\n909|                        reader.last_progress = time.monotonic()\n910|                        break\n911|            if not isinstance(choices, list):\n912|                if isinstance(chunk, dict):\n913|                    meta = {\n914|                        k: chunk.get(k)\n915|                        for k in (\"id\", \"created\", \"model\")\n916|                        if chunk.get(k) is not None\n917|                    }\n918|                    if meta:\n919|                        outcome.last_chunk = {**(outcome.last_chunk or {}), **meta}\n920|                write(raw)\n921|                continue\n922|            if not sanitize:\n923|                outcome.last_chunk = {k: chunk.get(k) for k in (\"id\", \"created\", \"model\")}\n924|                for choice in choices:\n925|                    if isinstance(choice, dict):\n926|                        raw_index = choice.get(\"index\")\n927|                        idx = (\n928|                            raw_index\n929|                            if isinstance(raw_index, int)\n930|                            and not isinstance(raw_index, bool)\n931|                            else 0\n932|                        )\n933|                        seen.add(idx)\n934|                        if choice.get(\"finish_reason\"):\n935|                            finished.add(idx)\n936|                        if limits.repetition_guard_enabled:\n937|                            delta = choice.get(\"delta\")\n938|                            text_value = (\n939|                                delta.get(\"content\")\n940|                                if isinstance(delta, dict)\n941|                                else None\n942|                            )\n943|                            if isinstance(text_value, str) and check_repetition(\n944|                                idx, text_value\n945|                            ):\n946|                                return repetition_error()\n947|                outcome.unfinished_choices = set(seen - finished)\n948|                write(raw)\n949|                continue\n950|            last_chunk = {k: chunk.get(k) for k in (\"id\", \"created\", \"model\")}\n951|            outcome.last_chunk = last_chunk\n952|            modified = False\n953|            terminal: list[int] = []\n954|            terminal_content: dict[int, str] = {}\n955|            for choice in choices:\n956|                if not isinstance(choice, dict):\n957|                    continue\n958|                raw_index = choice.get(\"index\")\n959|                index = (\n960|                    raw_index\n961|                    if isinstance(raw_index, int) and not isinstance(raw_index, bool)\n962|                    else 0\n963|                )\n964|                seen.add(index)\n965|                delta = choice.get(\"delta\")\n966|                if isinstance(delta, dict) and \"tool_calls\" in delta:\n967|                    if trusted_tools:\n968|                        calls = delta[\"tool_calls\"]\n969|                        if isinstance(calls, list):\n970|                            outcome.tool_calls_published += sum(\n971|                                isinstance(call, dict) and bool(call.get(\"id\"))\n972|                                for call in calls\n973|                            )\n974|                    else:\n975|                        acc.add(index, delta[\"tool_calls\"])\n976|                        delta = {k: v for k, v in delta.items() if k != \"tool_calls\"}\n977|                        choice[\"delta\"] = delta\n978|                        modified = True\n979|                if isinstance(delta, dict):\n980|                    content_value = delta.get(\"content\")\n981|                    if isinstance(content_value, str) and content_value:\n982|                        text_out = content_value\n983|                        if limits.invoke_normalization_enabled:\n984|                            parser_content[index] = parser_content.get(index, [])\n985|                            parser = parser_for(index)\n986|                            parser_content[index].clear()\n987|                            parser.feed(content_value)\n988|                            text_out = \"\".join(parser_content[index])\n989|                            parser_content[index].clear()\n990|                            had_calls = bool(parser_calls.get(index))\n991|                            add_invoke_calls(index)\n992|                            if text_out != content_value or had_calls:\n993|                                delta = dict(delta)\n994|                                if text_out:\n995|                                    delta[\"content\"] = text_out\n996|                                else:\n997|                                    delta.pop(\"content\", None)\n998|                                choice[\"delta\"] = delta\n999|                                modified = True\n1000|                        if check_repetition(index, text_out):\n1001|                            return repetition_error()\n1002|                if choice.get(\"finish_reason\"):\n1003|                    finished.add(index)\n1004|                    terminal.append(index)\n1005|                    if (\n1006|                        isinstance(delta, dict)\n1007|                        and isinstance(delta.get(\"content\"), str)\n1008|                        and delta[\"content\"]\n1009|                    ):\n1010|                        terminal_content[index] = delta[\"content\"]\n1011|                        delta = {k: v for k, v in delta.items() if k != \"content\"}\n1012|                        choice[\"delta\"] = delta\n1013|                        modified = True\n1014|            outcome.unfinished_choices = set(seen - finished)\n1015|            for index in sorted(terminal):\n1016|                if index in terminal_content:\n1017|                    write(content_frame(chunk, index, terminal_content[index]))\n1018|                flushed_outcome = flush_parser(index, chunk)\n1019|                if flushed_outcome is not None:\n1020|                    return flushed_outcome\n1021|                if not acc.has_choice(index):\n1022|                    continue\n1023|                calls = sanitize_choice_calls(\n1024|                    acc.pop_choice(index), tool_schemas, limits\n1025|                )\n1026|                outcome.tool_calls_published += len(calls)\n1027|                write(\n1028|                    _data_frame(\n1029|                        {\n1030|                            **{\n1031|                                k: chunk[k]\n1032|                                for k in chunk\n1033|                                if k not in (\"choices\", \"usage\", \"error\")\n1034|                            },\n1035|                            \"choices\": [\n1036|                                {\n1037|                                    \"index\": index,\n1038|                                    \"delta\": {\"tool_calls\": calls},\n1039|                                    \"finish_reason\": None,\n1040|                                }\n1041|                            ],\n1042|                        }\n1043|                    )\n1044|                )\n1045|            if not modified:\n1046|                write(raw)\n1047|                continue\n1048|            only_empty = all(\n1049|                isinstance(c, dict)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c497","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":166,"recorded_at":1780531400000327,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"call_id":"call_01a19c2748d0735a8d6eb0d2e4f6b4fd","text":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/adapters/passthrough_adapter.py`.\n(1229 line(s) above)\n1230|        if self._sanitize is not None:\n1231|            return self._sanitize\n1232|        return bool(getattr(self.host, \"BRIDGE_SANITIZE_TOOL_CALLS\", True))\n1233|\n1234|    def handle(\n1235|        self,\n1236|        *,\n1237|        path: str,\n1238|        raw_body: bytes,\n1239|        request: Mapping[str, Any],\n1240|        headers: Mapping[str, str],\n1241|        sink: ResponseSink,\n1242|    ) -> None:\n1243|        \"\"\"Один запрос: байты тела уходят upstream без мутаций, ответ пишется в `sink`.\"\"\"\n1244|        deadline = time.monotonic() + self.limits.total_timeout_s\n1245|        queue_timeout = min(\n1246|            float(getattr(self.host, \"QUEUE_TIMEOUT_S\", DEFAULT_QUEUE_TIMEOUT_S)),\n1247|            self.limits.total_timeout_s,\n1248|        )\n1249|        if not self._slots.acquire(timeout=queue_timeout):\n1250|            self._fail(sink, 503, \"overloaded\", \"passthrough backend is saturated\")\n1251|            return\n1252|        with self._lock:\n1253|            self._active += 1\n1254|        conn: Optional[http.client.HTTPConnection] = None\n1255|        transport: list[socket.socket] = []\n1256|        stop = threading.Event()\n1257|\n1258|        def abort() -> None:\n1259|            for sock in transport:\n1260|                try:\n1261|                    sock.shutdown(socket.SHUT_RDWR)\n1262|                except OSError:\n1263|                    continue\n1264|\n1265|        streaming = threading.Event()\n1266|\n1267|        def watch() -> None:\n1268|            # После начала SSE срок жизни держит скользящее окно ридера (idle + safety cap).\n1269|            while True:\n1270|                interval = self.limits.poll_interval_s\n1271|                if not streaming.is_set():\n1272|                    interval = min(interval, max(0.0, deadline - time.monotonic()))\n1273|                if stop.wait(interval):\n1274|                    return\n1275|                if (\n1276|                    not streaming.is_set() and time.monotonic() >= deadline\n1277|                ) or sink.client_gone():\n1278|                    abort()\n1279|                    return\n1280|\n1281|        watcher = threading.Thread(\n1282|            target=watch, daemon=True, name=\"passthrough-deadline\"\n1283|        )\n1284|        watcher.start()\n1285|        try:\n1286|            try:\n1287|                conn = self._open(\n1288|                    path,\n1289|                    raw_body,\n1290|                    headers,\n1291|                    deadline=deadline,\n1292|                    on_socket=transport.append,\n1293|                    presend_deadline=getattr(sink, \"presend_deadline\", None),\n1294|                )\n1295|                if sink.client_gone():\n1296|                    raise ClientGone()\n1297|                if time.monotonic() >= deadline:\n1298|                    raise TimeoutError()\n1299|                resp = conn.getresponse()\n1300|                if time.monotonic() >= deadline:\n1301|                    raise TimeoutError()\n1302|                if resp.status in (502, 503) and getattr(\n1303|                    sink, \"accepts_presend_errors\", False\n1304|                ):\n1305|                    try:\n1306|                        body = _read_bounded(resp, self.limits.max_body_bytes)\n1307|                    except UpstreamBodyTooLarge:\n1308|                        self._fail(\n1309|                            sink,\n1310|                            502,\n1311|                            \"upstream_response_too_large\",\n1312|                            \"upstream response exceeds the bridge limit\",\n1313|                        )\n1314|                        return\n1315|                    raise PreSendTransientError(\n1316|                        \"transient upstream HTTP status\",\n1317|                        status_code=resp.status,\n1318|                        response_headers=tuple(\n1319|                            self._response_headers(resp)\n1320|                            + [(\"Content-Length\", str(len(body)))]\n1321|                        ),\n1322|                        response_body=body,\n1323|                    )\n1324|            except PreSendTransientError as exc:\n1325|                if getattr(sink, \"accepts_presend_errors\", False):\n1326|                    raise\n1327|                if exc.status_code == 504 or isinstance(exc.__cause__, TimeoutError):\n1328|                    self._fail(\n1329|                        sink,\n1330|                        504,\n1331|                        \"upstream_timeout\",\n1332|                        \"upstream did not respond in time\",\n1333|                    )\n1334|                else:\n1335|                    self._fail(\n1336|                        sink, 502, \"upstream_unavailable\", \"upstream is unavailable\"\n1337|                    )\n1338|                return\n1339|            except socket.timeout:\n1340|                self._fail(\n1341|                    sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n1342|                )\n1343|                return\n1344|            except (OSError, http.client.HTTPException) as exc:\n1345|                if isinstance(\n1346|                    exc, (ConnectionError, http.client.IncompleteRead)\n1347|                ) and getattr(sink, \"accepts_presend_errors\", False):\n1348|                    raise PreSendTransientError(\n1349|                        \"upstream reset before downstream response\"\n1350|                    ) from exc\n1351|                if time.monotonic() >= deadline:\n1352|                    self._fail(\n1353|                        sink,\n1354|                        504,\n1355|                        \"upstream_timeout\",\n1356|                        \"upstream did not respond in time\",\n1357|                    )\n1358|                else:\n1359|                    self._fail(\n1360|                        sink, 502, \"upstream_unavailable\", \"upstream is unavailable\"\n1361|                    )\n1362|                return\n1363|            content_type = (resp.getheader(\"Content-Type\") or \"\").lower()\n1364|            is_stream = resp.status == 200 and \"text/event-stream\" in content_type\n1365|            if is_stream:\n1366|                streaming.set()\n1367|            self._respond(resp, request, sink, None if is_stream else deadline)\n1368|        except ClientGone:\n1369|            self._log(\"passthrough client_gone\")\n1370|        finally:\n1371|            stop.set()\n1372|            abort()\n1373|            if conn is not None:\n1374|                conn.close()\n1375|            watcher.join(timeout=self.limits.reader_join_timeout_s)\n1376|            with self._lock:\n1377|                self._active -= 1\n1378|            self._slots.release()\n1379|\n1380|    def _open(\n1381|        self,\n1382|        path: str,\n1383|        raw_body: bytes,\n1384|        headers: Mapping[str, str],\n1385|        *,\n1386|        deadline: float | None = None,\n1387|        on_socket: Callable[[socket.socket], None] | None = None,\n1388|        presend_deadline: float | None = None,\n1389|    ) -> http.client.HTTPConnection:\n1390|        remaining = (\n1391|            self.limits.total_timeout_s\n1392|            if deadline is None\n1393|            else deadline - time.monotonic()\n1394|        )\n1395|        if remaining <= 0:\n1396|            raise TimeoutError(\"upstream total deadline exceeded\")\n1397|        connect_remaining = remaining\n1398|        if presend_deadline is not None:\n1399|            connect_remaining = min(remaining, presend_deadline - time.monotonic())\n1400|            if connect_remaining <= 0:\n1401|                raise PreSendTransientError(\n1402|                    \"upstream connect budget exhausted\", status_code=504\n1403|                )\n1404|        conn = http.client.HTTPConnection(\n1405|            self._host,\n1406|            self._port,\n1407|            timeout=min(self.limits.connect_timeout_s, connect_remaining),\n1408|        )\n1409|        try:\n1410|            conn.connect()\n1411|        except (ConnectionError, socket.gaierror, TimeoutError) as exc:\n1412|            # Запрос ещё не посылался: это транспортный отказ, безопасный для общего retry.\n1413|            conn.close()\n1414|            raise PreSendTransientError(\"upstream connect failed\") from exc\n1415|        except BaseException:\n1416|            conn.close()\n1417|            raise\n1418|        if conn.sock is not None:\n1419|            if on_socket is not None:\n1420|                on_socket(conn.sock)\n1421|            remaining = (\n1422|                self.limits.total_timeout_s\n1423|                if deadline is None\n1424|                else deadline - time.monotonic()\n1425|            )\n1426|            if remaining <= 0:\n1427|                conn.close()\n1428|                raise TimeoutError(\"upstream total deadline exceeded\")\n1429|            conn.sock.settimeout(min(self.limits.read_timeout_s, remaining))\n1430|        forwarded = {\n1431|            k: v\n1432|            for k, v in headers.items()\n1433|            if k.lower() not in _REQUEST_DROP\n1434|            and (not self._upstream_key or k.lower() != \"authorization\")\n1435|        }\n1436|        if self._upstream_key:\n1437|            forwarded[\"Authorization\"] = f\"Bearer {self._upstream_key}\"\n1438|        forwarded[\"Host\"] = f\"{self._host}:{self._port}\"\n1439|        forwarded[\"Content-Length\"] = str(len(raw_body))\n1440|        forwarded[\"Accept-Encoding\"] = (\n1441|            \"identity\"  # тело нужно разобрать, а не передать сжатым\n1442|        )\n1443|        forwarded[\"Connection\"] = \"close\"\n1444|        route, _, query = path.partition(\"?\")\n1445|        suffix = route[len(\"/v1\") :] if route.startswith(\"/v1/\") else route\n1446|        target = self._base_path + suffix + (\"?\" + query if query else \"\")\n1447|        try:\n1448|            conn.request(\"POST\", target, body=raw_body, headers=forwarded)\n1449|        except BaseException:\n1450|            conn.close()\n1451|            raise\n1452|        return conn\n1453|\n1454|    def _fail(\n1455|        self, sink: ResponseSink, status: int, error_type: str, message: str\n1456|    ) -> None:\n1457|        self._log(f\"passthrough fail status={status} type={error_type}\")\n1458|        headers, body = _json_error(status, error_type, message)\n1459|        sink.start(status, headers)\n1460|        sink.write(body)\n1461|\n1462|    def _response_headers(\n1463|        self, resp: http.client.HTTPResponse\n1464|    ) -> list[tuple[str, str]]:\n1465|        return [(k, v) for k, v in resp.getheaders() if k.lower() not in _RESPONSE_DROP]\n1466|\n1467|    def _respond(\n1468|        self,\n1469|        resp: http.client.HTTPResponse,\n1470|        request: Mapping[str, Any],\n1471|        sink: ResponseSink,\n1472|        deadline: float | None = None,\n1473|    ) -> None:\n1474|        content_type = (resp.getheader(\"Content-Type\") or \"\").lower()\n1475|        encoded = (\n1476|            resp.getheader(\"Content-Encoding\") or \"identity\"\n1477|        ).lower() != \"identity\"\n1478|        sanitize = self._sanitize_enabled()\n1479|        schemas = build_tool_schemas(request.get(\"tools\")) if sanitize else None\n1480|        if resp.status == 200 and \"text/event-stream\" in content_type:\n1481|            self._relay_stream(resp, schemas, sink, sanitize, deadline)\n1482|            return\n1483|        try:\n1484|            body = _read_bounded(resp, self.limits.max_body_bytes)\n1485|            if deadline is not None and time.monotonic() >= deadline:\n1486|                raise TimeoutError(\"upstream total deadline exceeded\")\n1487|        except UpstreamBodyTooLarge:\n1488|            self._fail(\n1489|                sink,\n1490|                502,\n1491|                \"upstream_response_too_large\",\n1492|                \"upstream response exceeds the bridge limit\",\n1493|            )\n1494|            return\n1495|        except socket.timeout:\n1496|            self._fail(\n1497|                sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n1498|            )\n1499|            return\n1500|        except (OSError, http.client.HTTPException) as exc:\n1501|            if isinstance(\n1502|                exc, (ConnectionError, http.client.IncompleteRead)\n1503|            ) and getattr(sink, \"accepts_presend_errors\", False):\n1504|                raise PreSendTransientError(\n1505|                    \"upstream reset before downstream body\"\n1506|                ) from exc\n1507|            if deadline is not None and time.monotonic() >= deadline:\n1508|                self._fail(\n1509|                    sink, 504, \"upstream_timeout\", \"upstream did not respond in time\"\n1510|                )\n1511|            else:\n1512|                self._fail(sink, 502, \"upstream_unavailable\", \"upstream is unavailable\")\n1513|            return\n1514|        if sanitize and resp.status == 200 and \"json\" in content_type and not encoded:\n1515|            body = sanitize_completion_body(body, schemas, self.limits)\n1516|        headers = self._response_headers(resp) + [(\"Content-Length\", str(len(body)))]\n1517|        sink.start(resp.status, headers)\n1518|        sink.write(body)\n1519|\n1520|    def _relay_stream(\n1521|        self,\n1522|        resp: http.client.HTTPResponse,\n1523|        schemas: Optional[dict[str, Any]],\n1524|        sink: ResponseSink,\n1525|        sanitize: bool,\n1526|        deadline: float | None = None,\n1527|    ) -> None:\n1528|        # Выбор доверия фиксируется до sink.start (первой записи клиенту).\n1529|        # Маркер допустим только от настроенного аутентифицированного loopback peer.\n1530|        flag = getattr(self.host, \"is_trusted_tool_streaming_enabled\", None)\n1531|        trusted = (\n1532|            sanitize\n1533|            and self.config.get(\"trusted_tool_sanitizer\") is True\n1534|            and bool(self._upstream_key)\n1535|            and self._host == \"127.0.0.1\"\n1536|            and callable(flag)\n1537|            and flag() is True\n1538|            and resp.getheader(\"X-Bridge-Tool-Sanitized\") == \"1\"\n1539|        )\n1540|        headers = [\n1541|            (k, v)\n1542|            for k, v in self._response_headers(resp)\n1543|            if k.lower() != \"content-type\"\n1544|        ]\n1545|        headers += [\n1546|            (\"Content-Type\", \"text/event-stream\"),\n1547|            (\"Cache-Control\", \"no-cache\"),\n1548|            (\"X-Accel-Buffering\", \"no\"),\n1549|        ]\n1550|        outcome = StreamOutcome(committed=True)\n1551|        sink.start(200, headers)  # Заголовки тоже фиксируют ответ; повтор уже запрещён.\n1552|        try:\n1553|            outcome = relay_sse(\n1554|                resp.readline,\n1555|                sink.write,\n1556|                tool_schemas=schemas,\n1557|                limits=self.limits,\n1558|                process=self.process_budget,\n1559|                sanitize=sanitize,\n1560|                trusted_tools=trusted,\n1561|                state=outcome,\n1562|                deadline=deadline,\n1563|            )\n1564|        except (socket.timeout, OSError, http.client.HTTPException):\n1565|            last_chunk = getattr(outcome, \"last_chunk\", None) or {}\n1566|            unfinished_set = getattr(outcome, \"unfinished_choices\", None)\n1567|            if unfinished_set is not None and len(unfinished_set) == 0:\n1568|                sink.write(b\"data: [DONE]\\n\\n\")\n1569|                return\n1570|\n1571|            unfinished = sorted(unfinished_set) if unfinished_set is not None else [0]\n1572|            sink.write(\n1573|                format_stream_error_sse(\n1574|                    message=\"upstream stream failed\",\n1575|                    code=\"upstream_stream_error\",\n1576|                    model=str(last_chunk.get(\"model\") or getattr(self, \"id\", \"\") or \"\"),\n1577|                    completion_id=last_chunk.get(\"id\"),\n1578|                    created=last_chunk.get(\"created\"),\n1579|                    choice_indices=unfinished,\n1580|                ).encode(\"utf-8\")\n1581|            )\n1582|            return\n1583|        if outcome.incomplete or outcome.overflow:\n1584|            self._log(\n1585|                f\"passthrough stream incomplete={outcome.incomplete} overflow={outcome.overflow}\"\n1586|            )","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
