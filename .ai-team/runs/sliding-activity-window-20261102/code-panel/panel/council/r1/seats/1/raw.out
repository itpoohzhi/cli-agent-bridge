{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d3","stream":{"kind":"session","id":"01a19c26-7cab-7e21-9a23-e3bd507d8ba9"},"sequence":196,"recorded_at":1780531400000387,"record_type":"event","durability":"durable","causation_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01a19c26-8220-70e1-bd44-76c6e51e4445","run_stream":{"kind":"run","id":"01a19c26-8220-70e1-bd44-76c6e51e4445"},"task_stream":{"kind":"task","id":"01a19c27-7dee-7210-813e-5facbdc7ca18"},"task_id":"01a19c27-7dee-7210-813e-5facbdc7ca18","event":{"kind":"output","task_id":"01a19c27-7dee-7210-813e-5facbdc7ca18","chunk":"Read text file `/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_stream_resilience.py`.\n(999 line(s) above)\n1000|const result=stream(model,context,{apiKey:'probe-only',maxRetries:0,signal:controller.signal,fetch:async()=>new Response(new ReadableStream({start(c){for(let i=1;i<=8;i++)timers.push(setTimeout(()=>c.enqueue(encoder.encode(heartbeat)),i*40));timers.push(setTimeout(()=>{c.enqueue(encoder.encode(terminal));c.close();},360));}}),{headers:{'content-type':'text/event-stream'}})});\n1001|async function* relevant(){for await(const e of result)if(['thinking_delta','done','error'].includes(e.type))yield e;}\n1002|const iterator=relevant(), watchdog=idleWatchdog(controller.signal,160,'LLM_STREAM_IDLE_TIMEOUT');\n1003|const started=Date.now();let seen=0,done=false;\n1004|try {\n1005| while(true){const n=await watchdog.next(iterator);if(n.done)break;if(n.value.type==='thinking_delta'){assert.equal(n.value.delta,' ');seen++;}if(n.value.type==='done')done=true;if(n.value.type==='error')throw new Error('provider error');}\n1006| const final=await result.result();\n1007| const thinking=final.content.filter(c=>c.type==='thinking').map(c=>c.thinking).join('');\n1008| const text=final.content.filter(c=>c.type==='text').map(c=>c.text).join('');\n1009| assert.equal(seen,8);assert(done);assert(Date.now()-started>160);assert.equal(thinking,' '.repeat(8));assert.equal(text,'');\n1010| console.log(JSON.stringify({heartbeats:seen,terminal:done,aborted:watchdog.signal.aborted,thinkingLength:thinking.length,textLength:text.length}));\n1011|} finally {watchdog[Symbol.dispose]();controller.abort();timers.forEach(clearTimeout);}\n1012|\"\"\".replace(\"__HEARTBEAT__\", json.dumps(heartbeat))\n1013|    proc = subprocess.run(\n1014|        [\n1015|            \"/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness\",\n1016|            \"--expose-internals\",\n1017|            \"--input-type=module\",\n1018|        ],\n1019|        input=script,\n1020|        text=True,\n1021|        capture_output=True,\n1022|        timeout=20,\n1023|        env={**os.environ, \"ELECTRON_RUN_AS_NODE\": \"1\"},\n1024|    )\n1025|    assert proc.returncode == 0, proc.stderr\n1026|    assert json.loads(proc.stdout) == {\n1027|        \"heartbeats\": 8,\n1028|        \"terminal\": True,\n1029|        \"aborted\": False,\n1030|        \"thinkingLength\": 8,\n1031|        \"textLength\": 0,\n1032|    }\n1033|\n1034|\n1035|def sse_chunk(content: str | None, finish_reason: str | None = None) -> bytes:\n1036|    delta: Delta = {} if content is None else {\"content\": content}\n1037|    chunk: Chunk = {\n1038|        \"id\": \"chatcmpl-sliding\",\n1039|        \"object\": \"chat.completion.chunk\",\n1040|        \"created\": 1,\n1041|        \"model\": \"m\",\n1042|        \"choices\": [{\"delta\": delta, \"finish_reason\": finish_reason}],\n1043|    }\n1044|    return b\"data: \" + json.dumps(chunk).encode() + b\"\\n\"\n1045|\n1046|\n1047|def paced_readline(chunks: int | None, interval_s: float) -> Callable[[int], bytes]:\n1048|    \"\"\"Построчный upstream: полезный чанк каждые `interval_s`; `chunks=None` — бесконечно.\"\"\"\n1049|\n1050|    def lines() -> Generator[bytes, None, None]:\n1051|        sent = 0\n1052|        while chunks is None or sent < chunks:\n1053|            time.sleep(interval_s)\n1054|            sent += 1\n1055|            yield sse_chunk(\"x\")\n1056|            yield b\"\\n\"\n1057|        yield sse_chunk(None, \"stop\")\n1058|        yield b\"\\n\"\n1059|        yield b\"data: [DONE]\\n\"\n1060|        yield b\"\\n\"\n1061|        while True:\n1062|            yield b\"\"\n1063|\n1064|    source = lines()\n1065|\n1066|    def readline(_limit: int) -> bytes:\n1067|        return next(source)\n1068|\n1069|    return readline\n1070|\n1071|\n1072|def test_passthrough_safety_limits_defaults_and_env() -> None:\n1073|    assert PassthroughLimits().safety_cap_s == 3600.0\n1074|    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\n1075|    assert (\n1076|        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\n1077|    )\n1078|    assert (\n1079|        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\n1080|    )\n1081|\n1082|\n1083|def test_passthrough_sliding_activity_window_extends_stream() -> None:\n1084|    # Полезные чанки идут чаще idle_timeout_s, но суммарно дольше total_timeout_s.\n1085|    limits = PassthroughLimits(\n1086|        total_timeout_s=0.5,\n1087|        idle_timeout_s=0.3,\n1088|        safety_cap_s=30.0,\n1089|        heartbeat_interval_s=30.0,\n1090|        poll_interval_s=0.01,\n1091|    )\n1092|    written: list[bytes] = []\n1093|    started = time.monotonic()\n1094|    outcome = relay_sse(\n1095|        paced_readline(12, 0.1),\n1096|        written.append,\n1097|        tool_schemas=None,\n1098|        limits=limits,\n1099|    )\n1100|    elapsed = time.monotonic() - started\n1101|    assert elapsed > limits.total_timeout_s\n1102|    assert outcome.done and not outcome.incomplete\n1103|    assert sum(1 for frame in written if b'\"content\": \"x\"' in frame) == 12\n1104|\n1105|\n1106|def test_passthrough_safety_cap_terminates_infinite_stream() -> None:\n1107|    # Апстрим активен вечно: идле не срабатывает, обрывает только аварийный потолок.\n1108|    limits = PassthroughLimits(\n1109|        total_timeout_s=0.2,\n1110|        idle_timeout_s=30.0,\n1111|        safety_cap_s=0.6,\n1112|        heartbeat_interval_s=30.0,\n1113|        poll_interval_s=0.01,\n1114|    )\n1115|    written: list[bytes] = []\n1116|    outcome = StreamOutcome()\n1117|    started = time.monotonic()\n1118|    with pytest.raises(TimeoutError, match=\"safety cap exceeded\"):\n1119|        _ = relay_sse(\n1120|            paced_readline(None, 0.05),\n1121|            written.append,\n1122|            tool_schemas=None,\n1123|            limits=limits,\n1124|            state=outcome,\n1125|        )\n1126|    elapsed = time.monotonic() - started\n1127|    assert limits.safety_cap_s <= elapsed < limits.safety_cap_s + 1.0\n1128|    assert any(b'\"content\": \"x\"' in frame for frame in written)\n1129|    assert not outcome.done\n1130|\n1131|\n1132|def test_passthrough_idle_timeout_not_reset_by_own_heartbeat() -> None:\n1133|    # Тишина upstream: свои keepalive клиенту не продлевают окно неактивности.\n1134|    limits = PassthroughLimits(\n1135|        idle_timeout_s=0.3,\n1136|        safety_cap_s=30.0,\n1137|        heartbeat_interval_s=0.05,\n1138|        poll_interval_s=0.01,\n1139|    )\n1140|    written: list[bytes] = []\n1141|    stop = threading.Event()\n1142|\n1143|    def silent(_limit: int) -> bytes:\n1144|        _ = stop.wait(30)\n1145|        return b\"\"\n1146|\n1147|    started = time.monotonic()\n1148|    try:\n1149|        with pytest.raises(TimeoutError, match=\"idle timeout exceeded\"):\n1150|            _ = relay_sse(silent, written.append, tool_schemas=None, limits=limits)\n1151|    finally:\n1152|        stop.set()\n1153|    assert time.monotonic() - started < 2.0\n1154|    assert b\": keepalive\\n\\n\" in written\n1155|\n1156|\n1157|def test_cap_terminates_real_group_term_then_kill(tmp_path: Path) -> None:\n1158|    from core.backend_adapter import TurnResult\n1159|\n1160|    clock = Clock()\n1161|    manager = TurnSessionManager(\n1162|        state_root=tmp_path,\n1163|        clock=clock,\n1164|        safety_cap_s=5,\n1165|        finish_reserve_s=0,\n1166|        watchdog_interval_s=0.01,\n1167|        cancel_grace_s=0.05,\n1168|    )\n1169|    turn, _ = manager.create_or_attach_turn(\n1170|        model=\"test\", backend=\"test\", cwd=str(tmp_path), messages=[]\n1171|    )\n1172|    proc = subprocess.Popen(\n1173|        [\n1174|            sys.executable,\n1175|            \"-c\",\n1176|            \"import signal,time; signal.signal(signal.SIGTERM, signal.SIG_IGN); print('ready',flush=True); time.sleep(60)\",\n1177|        ],\n1178|        start_new_session=True,\n1179|        stdout=subprocess.PIPE,\n1180|    )\n1181|    try:\n1182|        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n1183|        turn.bind_process(pgid=proc.pid)\n1184|        clock.now += 6\n1185|\n1186|        def runner(_turn: object) -> TurnResult:\n1187|            return TurnResult(state=\"done\", rc=proc.wait(timeout=3))\n1188|\n1189|        worker = manager.spawn_detached_execution(turn, runner)\n1190|        assert turn.done_event.wait(5)\n1191|        worker.join(timeout=1)\n1192|        assert proc.returncode == -signal.SIGKILL\n1193|        assert turn.status == \"TIMED_OUT_CAP\"\n1194|        error = turn.buffer.error\n1195|        assert error is not None\n1196|        assert error[\"code\"] == \"timed_out_cap\"\n1197|    finally:\n1198|        if proc.poll() is None:\n1199|            os.killpg(proc.pid, signal.SIGKILL)\n(more lines below)","final_result":true}}}
