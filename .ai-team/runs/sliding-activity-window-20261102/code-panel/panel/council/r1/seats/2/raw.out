tion(\"127.0.0.1\", self.port, timeout=10)\n1476:    def test_models_listing_includes_passthrough_model_for_loopback_without_hub_key(self):\n1477:        conn = http.client.HTTPConnection(\"127.0.0.1\", self.port, timeout=10)\n1493:    def test_passthrough_stream_through_hub(self):\n1511:        conn = http.client.HTTPConnection(\"127.0.0.1\", self.port, timeout=10)\n.ai-team/runs/sliding-activity-window-20261102/plans:\ntotal 8\ndrwxr-xr-x@ 3 aazhiry1  staff   96 Nov  2 14:39 .\ndrwxr-xr-x@ 7 aazhiry1  staff  224 Nov  2 15:05 ..\n-rw-r--r--@ 1 aazhiry1  staff  323 Nov  2 14:39 architect-01.json\n\nanalysis/sliding-activity-window:\ntotal 16\ndrwxr-xr-x@  3 aazhiry1  staff    96 Nov  2 14:38 .\ndrwxr-xr-x@ 21 aazhiry1  staff   672 Nov  2 14:38 ..\n-rw-r--r--@  1 aazhiry1  staff  7735 Nov  2 14:38 research-report.md\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"В ридере есть различие: до первого полезного токена окно продлевает любая непустая строка upstream, включая SSE-комментарии. Проверю этот случай отдельно и посмотрю, покрывают ли новые тесты HTTP-вотчер, который раньше обрывал соединение.\n"}}
