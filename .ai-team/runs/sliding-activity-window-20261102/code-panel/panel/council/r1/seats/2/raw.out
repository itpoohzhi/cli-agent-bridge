Y_CAP_S\", 20 if scenario == \"safety_cap\" else 100)\ntests/test_stream_resilience.py:749:        last_progress=1000.0,\ntests/test_stream_resilience.py:760:    assert cast(float, getattr(run, \"last_progress\")) == (\ntests/test_stream_resilience.py:1038:        \"id\": \"chatcmpl-sliding\",\ntests/test_stream_resilience.py:1073:    assert PassthroughLimits().safety_cap_s == 3600.0\ntests/test_stream_resilience.py:1074:    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\ntests/test_stream_resilience.py:1076:        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\ntests/test_stream_resilience.py:1079:        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\ntests/test_stream_resilience.py:1083:def test_passthrough_sliding_activity_window_extends_stream() -> None:\ntests/test_stream_resilience.py:1084:    # Полезные чанки идут чаще idle_timeout_s, но суммарно дольше total_timeout_s.\ntests/test_stream_resilience.py:1086:        total_timeout_s=0.5,\ntests/test_stream_resilience.py:1087:        idle_timeout_s=0.3,\ntests/test_stream_resilience.py:1088:        safety_cap_s=30.0,\ntests/test_stream_resilience.py:1101:    assert elapsed > limits.total_timeout_s\ntests/test_stream_resilience.py:1106:def test_passthrough_safety_cap_terminates_infinite_stream() -> None:\ntests/test_stream_resilience.py:1109:        total_timeout_s=0.2,\ntests/test_stream_resilience.py:1110:        idle_timeout_s=30.0,\ntests/test_stream_resilience.py:1111:        safety_cap_s=0.6,\ntests/test_stream_resilience.py:1127:    assert limits.safety_cap_s <= elapsed < limits.safety_cap_s + 1.0\ntests/test_stream_resilience.py:1132:def test_passthrough_idle_timeout_not_reset_by_own_heartbeat() -> None:\ntests/test_stream_resilience.py:1135:        idle_timeout_s=0.3,\ntests/test_stream_resilience.py:1136:        safety_cap_s=30.0,\ntests/test_stream_resilience.py:1164:        safety_cap_s=5,\ntotal 16\ndrwxr-xr-x@ 