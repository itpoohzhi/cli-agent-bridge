_BYTES\"\n    84\tENV_CONNECT_TIMEOUT_S = \"BRIDGE_PASSTHROUGH_CONNECT_TIMEOUT_S\"\n    85\tENV_READ_TIMEOUT_S = \"BRIDGE_PASSTHROUGH_READ_TIMEOUT_S\"\n    86\t# ADR-0020: env читает адаптер (не ядро, BND-001) и передаёт значения аргументами.\n    87\tENV_REPETITION_MAX_REPEATS = \"BRIDGE_REPETITION_MAX_REPEATS\"\n    88\tENV_REPETITION_MAX_TOKEN_LEN = \"BRIDGE_REPETITION_MAX_TOKEN_LEN\"\n    89\tENV_REPETITION_GUARD_ENABLED = \"BRIDGE_REPETITION_GUARD_ENABLED\"\n    90\tENV_INVOKE_NORMALIZATION_ENABLED = \"BRIDGE_INVOKE_NORMALIZATION_ENABLED\"\n    91\t\n    92\tDEFAULT_MAX_BODY_BYTES = 16 * 1024 * 1024\n    93\tDEFAULT_ACC_MAX_BYTES = 8 * 1024 * 1024\n    94\tDEFAULT_ACC_MAX_KEYS = 64\n    95\tDEFAULT_ACC_MAX_PROCESS_BYTES = 32 * 1024 * 1024\n  1145\t        *,\n  1146\t        limits: Optional[PassthroughLimits] = None,\n  1147\t        process_budget: Optional[ProcessBudget] = None,\n  1148\t        sanitize: Optional[bool] = None,\n  1149\t    ) -> None:\n  1150\t        super().__init__(backend_id, config, catalog_source, host)\n  1151\t        api_key_env = self.config.get(\"api_key_env\")\n  1152\t        api_key = self.config.get(\"api_key\")\n  1153\t        self._upstream_key = (\n  1154\t            os.environ.get(api_key_env) if isinstance(api_key_env, str) else \"\"\n  1155\t        ) or (api_key if isinstance(api_key, str) else \"\")\n  1156\t        self._limits = limits\n  1157\t        initial_limits = self.limits\n  1158\t        self.process_budget = process_budget or ProcessBudget(\n  1159\t            initial_limits.accumulator_max_process_bytes\n  1160\t        )\n  1161\t        self._sanitize = sanitize\n  1162\t        self._active = 0\n  1163\t        self._lock = threading.Lock()\n  1164\t        self._slots = threading.BoundedSemaphore(self.max_concurrent)\n  1165\t        base_url = self.config.get(\"base_url\")\n  1166\t        if not isinstance(base_url, str) or not re.fullmatch(\n  1167\t            r\"http://(?:127\\.0\\.0\\.1|localhost):[0-9]{1,5}/v1\", base_url\n  1168\t        ):\n  1169\t            raise ValueError(\"backend_base_url_invalid\")\n  1170\t        parts = urllib.parse.urlsplit(base_url)\n  1171\t        if parts.hostname is None or parts.port is None or not 1 <= parts.port <= 65535:\n  1172\t            raise ValueError(\"backend_base_url_invalid\")\n  1173\t        self._host = parts.hostname\n  1174\t        self._port = parts.port\n  1175\t        self._base_path = parts.path.rstrip(\"/\")\n  1176\t\n  1177\t    @property\n  1178\t    def limits(self) -> PassthroughLimits:\n  1179\t        return (\n  1180\t            self._limits if self._limits is not None else PassthroughLimits.from_env()\n  1181\t        )\n  1182\t\n  1183\t    @limits.setter\n  1184\t    def limits(self, value: Optional[PassthroughLimits]) -> None:\n  1185\t        self._limits = value\n  1186\t\n  1187\t    # -- контракт BackendAdapter ---------------------------------------------------------\n  1188\t    def validate_client_token(self, token: str) -> bool:\n  1189\t        \"\"\"Проверяет клиентский токен по собственному настроенному ключу upstream.\"\"\"\n  1190\t        if not self._upstream_key or not token:\n  1191\t            return False\n  1192\t        return hmac.compare_digest(\n  1193\t            token.encode(\"utf-8\"), self._upstream_key.encode(\"utf-8\")\n  1194\t        )\n  1195\t\n  1196\t    def get_models(self) -> list[BackendModel]:\n  1197\t        return self._catalog_models()\n  1198\t\n  1199\t    def qualify(self) -> Qualification:\n  1200\t        return Qualification(True, \"\")\n  1201\t\n  1202\t    def is_healthy(self) -> bool:\n  1203\t        return True  # stateless: процессов нет, недоступность upstream — 502/504 на запросе\n  1204\t\n  1205\t    def active_count(self) -> int:\n  1206\t        with self._lock:\n  1207\t            return self._active\n  1208\t\n  1209\t    def spawn_session(self, ctx: TurnContext) -> object:\n  1210\t        raise BackendNotSupported(\"passthrough_no_sessions\")\n  1211\t\n  1212\t    def execute_turn(\n  1213\t        self, ctx: TurnContext, sse_writer: Optional[StreamSink]\n  1214\t    ) -> TurnResult:\n  1215\t        raise BackendNotSupported(\"passthrough_raw_seam\")\n  1216\t\n  1217\t    def close_session(self, sid: str) -> None:\n  1218\t        return None\n  1219\t\n  1220\t    def shutdown(self) -> None:\n  1221\t        return None\n  1222\t\n  1223\t    # -- raw-шов -------------------------------------------------------------------------\n  1224\t    def _log(self, message: str) -> None:\n  1225\t        logger = getattr(self.host, \"_log\", None)\n  1226\t        if callable(logger):\n  1227\t            logger(message)\n  1228\t\n  1229\t    def _sanitize_enabled(self) -> bool:\n  1230\t        if self._sanitize is not None:\n  1231\t            return self._sanitize\n  1232\t        return bool(getattr(self.host, \"BRIDGE_SANITIZE_TOOL_CALLS\", True))\n  1233\t\n  1234\t    def handle(\n  1235\t        self,\n  1236\t        *,\n  1237\t        path: str,\n  1238\t        raw_body: bytes,\n  1239\t        request: Mapping[str, Any],\n  1240\t        headers: Mapping[str, str],\n  1241\t        sink: ResponseSink,\n  1242\t    ) -> None:\n  1243\t        \"\"\"Один запрос: байты тела уходят upstream без мутаций, ответ пишется в `sink`.\"\"\"\n  1244\t        deadline = time.monotonic() + self.limits.total_timeout_s\n  1245\t        queue_timeout = min(\n  1246\t            float(getattr(self.host, \"QUEUE_TIMEOUT_S\", DEFAULT_QUEUE_TIMEOUT_S)),\n  1247\t            self.limits.total_timeout_s,\n  1248\t        )\n  1249\t        if not self._slots.acquire(timeout=queue_timeout):\n  1250\t            self._fail(sink, 503, \"overloaded\", \"passthrough backend is saturated\")\n  1251\t            return\n  1252\t        with self._lock:\n  1253\t            self._active += 1\n  1254\t        conn: Optional[http.client.HTTPConnection] = None\n  1255\t        transport: list[socket.socket] = []\n  1256\t        stop = threading.Event()\n  1257\t\n  1258\t        def abort() -> None:\n  1259\t            for sock in transport:\n  1260\t                try:\n  1261\t                    sock.shutdown(socket.SHUT_RDWR)\n  1262\t                except OSError:\n  1263\t                    continue\n  1264\t\n  1265\t        streaming = threading.Event()\n/Users/aazhiry1/.local/bin/python3.14: No module named pytest\n   610\t\n   611\t    @staticmethod\n   612\t    def json(handler, payload, status=200, extra=()):\n   613\t        data = payload if isinstance(payload, bytes) else json.dumps(payload).encode(\"utf-8\")\n   614\t        handler.send_response(status)\n   615\t        handler.send_header(\"Content-Type\", \"application/json\")\n   616\t        handler.send_header(\"Content-Length\", str(len(data)))\n   617\t        for key, value in extra:\n   618\t            handler.send_header(key, value)\n   619\t        handler.end_headers()\n   620\t        handler.wfile.write(data)\n   621\t\n   622\t    @staticmethod\n   623\t    def sse(handler, body: bytes):\n   624\t        handler.send_response(200)\n   625\t        handler.send_header(\"Content-Type\", \"text/event-stream\")\n   626\t        handler.end_headers()\n   627\t        handler.wfile.write(body)\n   628\t        handler.wfile.flush()\n   629\t\n   630\t\n   631\tclass CollectSink(ResponseSink):\n   632\t    def __init__(self):\n   633\t        self.status = None\n   634\t        self.headers = []\n   635\t        self.chunks: list = []\n   636\t        self.fail_after = None\n   637\t\n   638\t    def start(self, status, headers):\n   639\t        self.status, self.headers = status, headers\n   640\t\n   641\t    def write(self, data):\n   642\t        if self.fail_after is not None and len(self.chunks) >= self.fail_after:\n   643\t            raise ClientGone()\n   644\t        self.chunks.append(data)\n   645\t\n   646\t    @property\n   647\t    def body(self) -> bytes:\n   648\t        return b\"\".join(self.chunks)\n   649\t\n   650\t    def header(self, name):\n   651\t        return next((v for k, v in self.headers if k.lower() == name.lower()), None)\n   652\t\n   653\t\n   654\tdef make_adapter(port: int, limits=None, **kw) -> PassthroughAdapter:\n   655\t    config = {\"kind\": \"passthrough\", \"base_url\": \"http://127.0.0.1:%d/v1\" % port, \"max_concurrent\": 4}\n   656\t    return PassthroughAdapter(\"codex\", config, lambda: {}, None, limits=limits or PassthroughLimits(), **kw)\n   657\t\n   658\t\n   659\tclass SeamCase(unittest.TestCase):\n   660\t    def setUp(self):\n   661\t        self.upstream = FakeUpstream()\n   662\t        self.addCleanup(self.upstream.close)\n   663\t\n   664\t    def call(self, request: dict, adapter=None, headers=None, raw=None, path=\"/v1/chat/completions\"):\n   665\t        adapter = adapter or make_adapter(self.upstream.port, sanitize=True)\n   666\t        raw = raw if raw is not None else json.dumps(request).encode(\"utf-8\")\n   667\t        sink = CollectSink()\n   668\t        adapter.handle(path=path, raw_body=raw, request=request,\n   669\t                       headers=headers or {\"Authorization\": \"Bearer upstream-key\"}, sink=sink)\n   670\t        return sink\n   671\t\n   672\t\n   673\tclass TestSeamNonStream(SeamCase):\n   674\t    def completion(self, args):\n   675\t        return {\"id\": \"x\", \"object\": \"chat.completion\", \"choices\": [{\"index\": 0, \"finish_reason\": \"tool_calls\",\n   676\t                \"message\": {\"role\": \"assistant\", \"content\": None, \"tool_calls\": [\n   677\t                    {\"id\": \"c1\", \"type\": \"function\", \"function\": {\"name\": \"subagent\", \"arguments\": json.dumps(args)}}]}}]}\n   678\t\n   679\t    def test_request_forwarded_verbatim_and_response_sanitized(self):\n   680\t        self.upstream.respond = lambda h, b: FakeUpstream.json(h, self.completion({\"prompt\": \"p\", \"provider\": \"\"}))\n   681\t        request = {\"model\": \"gpt-6.1-terra\", \"reasoning_effort\": \"xhigh\", \"tools\": TOOLS,\n   682\t                   \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}\n   683\t        raw = json.dumps(request, indent=2).encode(\"utf-8\")  # нестандартная сериализация: байты не пересобираются\n   684\t        sink = self.call(request, raw=raw)\n   685\t        sent = self.upstream.requests[0]\n   686\t        self.assertEqual(sent[\"body\"], raw)\n   687\t        self.assertEqual(sent[\"path\"], \"/v1/chat/completions\")\n   688\t        self.assertEqual(sent[\"headers\"][\"Authorization\"], \"Bearer upstream-key\")\n   689\t        self.assertEqual(sink.status, 200)\n   690\t        data = json.loads(sink.body)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"agent_message","text":"Проба подтвердила: поток из одних upstream keepalive прожил 0,436 с при `idle_timeout_s=0,1` и завершился успешно. Также socket timeout всё ещё ограничен старым `total_timeout_s`. Повторный pytest недоступен: в найденных интерпретаторах нет модуля; TCP-проверку запретила среда.\n"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nimport json, socket, time, threading\nfrom unittest.mock import patch\nfrom adapters.passthrough_adapter import PassthroughAdapter, PassthroughLimits, ResponseSink\n\ndef frame(text, finish=None):\n    return b'data: '+json.dumps({'id':'probe','choices':[{'index':0,'delta':{'content':text} if text else {},'finish_reason':finish}]}).encode()+b'\\\\n\\\\n'\na,b=socket.socketpair()\nclass Response:\n    status=200\n    def __init__(self): self.file=a.makefile('rb')\n    def getheader(self,name): return 'text/event-stream' if name=='Content-Type' else None\n    def getheaders(self): return [('Content-Type','text/event-stream')]\n    def readline(self,limit): return self.file.readline(limit)\nclass Connection:\n    def __init__(self,*args,**kwargs): self.sock=a; self.response=Response()\n    def connect(self): pass\n    def request(self,*args,**kwargs): pass\n    def getresponse(self): return self.response\n    def close(self): self.response.file.close(); self.sock.close()\nclass Sink(ResponseSink):\n    def __init__(self): self.body=b''\n    def start(self,*args): pass\n    def write(self,data): self.body+=data\n\ndef upstream():\n    try:\n        b.sendall(frame('first'))\n        time.sleep(.30)\n        b.sendall(frame('second')+frame('', 'stop')+b'data: [DONE]\\\\n\\\\n')\n    except OSError: pass\n    finally: b.close()\nlimits=PassthroughLimits(total_timeout_s=.15,idle_timeout_s=.60,read_timeout_s=1,safety_cap_s=2,poll_interval_s=.005,reader_join_timeout_s=.01)\nadapter=PassthroughAdapter('probe',{'kind':'passthrough','base_url':'http://127.0.0.1:1/v1'},lambda:{},None,limits=limits,sanitize=False)\nsink=Sink(); start=time.monotonic()\nworker=threading.Thread(target=upstream,daemon=True);worker.start()\nwith patch('adapters.passthrough_adapter.http.client.HTTPConnection',Connection):\n    adapter.handle(path='/v1/chat/completions',raw_body=b'{}',request={},headers={},sink=sink)\nprint(json.dumps({'transport':'real socketpair with HTTPConnection stub','elapsed':round(time.monotonic()-start,3),'total_timeout_s':limits.total_timeout_s,'idle_timeout_s':limits.idle_timeout_s,'first_received':b'first' in sink.body,'second_received':b'second' in sink.body,'upstream_stream_error':b'upstream_stream_error' in sink.body}))\nworker.join(timeout=1)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
