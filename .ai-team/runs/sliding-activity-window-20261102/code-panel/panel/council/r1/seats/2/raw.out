{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba adapters/passthrough_adapter.py | sed -n '630,1060p'\"","aggregated_output":"   630\t    \"\"\"Итог пробрасывания SSE (для журнала и тестов).\"\"\"\n   631\t\n   632\t    done: bool = False\n   633\t    incomplete: bool = False\n   634\t    overflow: bool = False\n   635\t    tool_calls_published: int = 0\n   636\t    committed: bool = False\n   637\t    repetition_loop: bool = False\n   638\t    last_chunk: Optional[dict[str, Any]] = None\n   639\t    unfinished_choices: Optional[set[int]] = None\n   640\t\n   641\t\n   642\tclass _TimedSseReader:\n   643\t    \"\"\"Один bounded reader; ожидание I/O не мешает heartbeat и дедлайну.\"\"\"\n   644\t\n   645\t    def __init__(\n   646\t        self,\n   647\t        readline: Callable[[int], bytes],\n   648\t        write: Callable[[bytes], None],\n   649\t        limits: PassthroughLimits,\n   650\t        deadline: float | None = None,\n   651\t    ) -> None:\n   652\t        self.limits = limits\n   653\t        self.start_time = time.monotonic()\n   654\t        # Аварийный потолок жизни стрима; `deadline` (если задан) остаётся жёстким.\n   655\t        self.safety_deadline = (\n   656\t            deadline if deadline is not None else self.start_time + limits.safety_cap_s\n   657\t        )\n   658\t        self.write = write\n   659\t        self.items: queue.Queue[bytes | Exception] = queue.Queue(\n   660\t            maxsize=limits.read_queue_max_entries\n   661\t        )\n   662\t        self.stop = threading.Event()\n   663\t        # last_input — каденс heartbeat (вход upstream или свой keepalive);\n   664\t        # last_upstream — только реальный ввод upstream, без heartbeat.\n   665\t        self.last_input = self.start_time\n   666\t        self.last_upstream = self.start_time\n   667\t        self.last_progress: float | None = None\n   668\t\n   669\t        def read() -> None:\n   670\t            try:\n   671\t                while not self.stop.is_set():\n   672\t                    line = readline(limits.max_body_bytes + 1)\n   673\t                    while not self.stop.is_set():\n   674\t                        try:\n   675\t                            self.items.put(line, timeout=limits.poll_interval_s)\n   676\t                            break\n   677\t                        except queue.Full:\n   678\t                            continue\n   679\t                    if not line:\n   680\t                        return\n   681\t            except (OSError, http.client.HTTPException, ValueError) as exc:\n   682\t                while not self.stop.is_set():\n   683\t                    try:\n   684\t                        self.items.put(exc, timeout=limits.poll_interval_s)\n   685\t                        return\n   686\t                    except queue.Full:\n   687\t                        continue\n   688\t\n   689\t        self.thread = threading.Thread(target=read, daemon=True, name=\"passthrough-sse\")\n   690\t        self.thread.start()\n   691\t\n   692\t    def readline(self, _limit: int) -> bytes:\n   693\t        while True:\n   694\t            now = time.monotonic()\n   695\t            safety_remaining = self.safety_deadline - now\n   696\t            if safety_remaining <= 0:\n   697\t                raise TimeoutError(\"upstream stream safety cap exceeded\")\n   698\t            # Скользящее окно: срок тишины отсчитывается от последней активности.\n   699\t            activity_base = (\n   700\t                self.last_progress\n   701\t                if self.last_progress is not None\n   702\t                else self.last_upstream\n   703\t            )\n   704\t            idle_remaining = activity_base + self.limits.idle_timeout_s - now\n   705\t            if idle_remaining <= 0:\n   706\t                raise TimeoutError(\"upstream stream idle timeout exceeded\")\n   707\t            remaining = min(idle_remaining, safety_remaining)\n   708\t            heartbeat_due = self.last_input + self.limits.heartbeat_interval_s - now\n   709\t            if heartbeat_due <= 0:\n   710\t                self.write(b\": keepalive\\n\\n\")\n   711\t                self.last_input = time.monotonic()\n   712\t                heartbeat_due = self.limits.heartbeat_interval_s\n   713\t            try:\n   714\t                item = self.items.get(\n   715\t                    timeout=min(remaining, heartbeat_due, self.limits.poll_interval_s)\n   716\t                )\n   717\t            except queue.Empty:\n   718\t                continue\n   719\t            if time.monotonic() >= self.safety_deadline:\n   720\t                raise TimeoutError(\"upstream stream safety cap exceeded\")\n   721\t            if isinstance(item, Exception):\n   722\t                raise item\n   723\t            if item:\n   724\t                self.last_input = self.last_upstream = time.monotonic()\n   725\t            return item\n   726\t\n   727\t    def close(self) -> None:\n   728\t        self.stop.set()\n   729\t        self.thread.join(timeout=self.limits.reader_join_timeout_s)\n   730\t\n   731\t\n   732\tdef relay_sse(\n   733\t    readline: Callable[[int], bytes],\n   734\t    write: Callable[[bytes], None],\n   735\t    *,\n   736\t    tool_schemas: Optional[dict[str, Any]],\n   737\t    limits: PassthroughLimits,\n   738\t    process: Optional[ProcessBudget] = None,\n   739\t    sanitize: bool = True,\n   740\t    trusted_tools: bool = False,\n   741\t    state: StreamOutcome | None = None,\n   742\t    deadline: float | None = None,\n   743\t) -> StreamOutcome:\n   744\t    \"\"\"Пробросить SSE-поток upstream клиенту с санитизацией `tool_calls` (AD-005).\n   745\t\n   746\t    Исходный порядок событий сохраняется; единственное изменение — вызовы choice выходят\n   747\t    одним кадром прямо перед терминальным чанком своей choice, после санитизации.\n   748\t    \"\"\"\n   749\t    reader = _TimedSseReader(\n   750\t        readline,\n   751\t        write,\n   752\t        limits,\n   753\t        deadline,\n   754\t    )\n   755\t    outcome = state if state is not None else StreamOutcome()\n   756\t    client_write = write\n   757\t\n   758\t    def write(frame: bytes) -> None:\n   759\t        \"\"\"До вызова sink: даже частичная запись запрещает повтор запроса.\"\"\"\n   760\t        outcome.committed = True\n   761\t        client_write(frame)\n   762\t\n   763\t    acc = ToolCallAccumulator(limits, process)\n   764\t    seen: set[int] = set()\n   765\t    finished: set[int] = set()\n   766\t    last_chunk: dict[str, Any] = {}\n   767\t    guards: dict[int, RepetitionGuard] = {}\n   768\t    parsers: dict[int, ToolCallParser] = {}\n   769\t    parser_content: dict[int, list[str]] = {}\n   770\t    parser_calls: dict[int, list[dict]] = {}\n   771\t\n   772\t    def guard_for(index: int) -> RepetitionGuard:\n   773\t        if index not in guards:\n   774\t            guards[index] = RepetitionGuard(\n   775\t                max_repeats=limits.repetition_max_repeats,\n   776\t                max_token_len=limits.repetition_max_token_len,\n   777\t                enabled=limits.repetition_guard_enabled,\n   778\t            )\n   779\t        return guards[index]\n   780\t\n   781\t    def repetition_error() -> StreamOutcome:\n   782\t        acc.close()\n   783\t        outcome.repetition_loop = True\n   784\t        write(\n   785\t            _error_frame(\n   786\t                last_chunk,\n   787\t                \"upstream_repetition_loop\",\n   788\t                \"upstream repetition loop detected\",\n   789\t            )\n   790\t        )\n   791\t        return outcome\n   792\t\n   793\t    def check_repetition(index: int, text: str) -> bool:\n   794\t        if not limits.repetition_guard_enabled or not text:\n   795\t            return False\n   796\t        return guard_for(index).feed(text)[1]\n   797\t\n   798\t    def parser_for(index: int) -> ToolCallParser:\n   799\t        if index not in parsers:\n   800\t            parser_content[index] = []\n   801\t            parser_calls[index] = []\n   802\t            parsers[index] = ToolCallParser(\n   803\t                parser_content[index].append,\n   804\t                parser_calls[index].append,\n   805\t                tool_schemas=tool_schemas,\n   806\t                repetition_guard_enabled=False,\n   807\t            )\n   808\t        return parsers[index]\n   809\t\n   810\t    def add_invoke_calls(index: int) -> None:\n   811\t        for call in parser_calls.get(index, ()):\n   812\t            arguments = call.get(\"arguments\")\n   813\t            acc.add(\n   814\t                index,\n   815\t                [\n   816\t                    {\n   817\t                        \"index\": acc.next_tool_index(index),\n   818\t                        \"id\": str(call.get(\"id\") or new_call_id()),\n   819\t                        \"type\": \"function\",\n   820\t                        \"function\": {\n   821\t                            \"name\": str(call.get(\"name\") or \"\"),\n   822\t                            \"arguments\": arguments\n   823\t                            if isinstance(arguments, str)\n   824\t                            else json.dumps(arguments or {}, ensure_ascii=False),\n   825\t                        },\n   826\t                    }\n   827\t                ],\n   828\t            )\n   829\t        if index in parser_calls:\n   830\t            parser_calls[index].clear()\n   831\t\n   832\t    def content_frame(base: Mapping[str, Any], index: int, text: str) -> bytes:\n   833\t        payload: dict[str, Any] = {\n   834\t            k: base[k] for k in base if k not in (\"choices\", \"usage\", \"error\")\n   835\t        }\n   836\t        payload.setdefault(\"id\", last_chunk.get(\"id\") or \"chatcmpl-passthrough\")\n   837\t        payload.setdefault(\"object\", \"chat.completion.chunk\")\n   838\t        payload.setdefault(\"created\", last_chunk.get(\"created\") or int(time.time()))\n   839\t        payload.setdefault(\"model\", last_chunk.get(\"model\") or \"\")\n   840\t        payload[\"choices\"] = [\n   841\t            {\"index\": index, \"delta\": {\"content\": text}, \"finish_reason\": None}\n   842\t        ]\n   843\t        return _data_frame(payload)\n   844\t\n   845\t    def flush_parser(index: int, base: Mapping[str, Any]) -> Optional[StreamOutcome]:\n   846\t        \"\"\"`finish()` парсера choice: удержанный content уходит перед терминалом.\"\"\"\n   847\t        if index not in parsers:\n   848\t            return None\n   849\t        parser_content[index].clear()\n   850\t        add_invoke_calls(index)\n   851\t        parsers[index].finish()\n   852\t        flushed = \"\".join(parser_content[index])\n   853\t        parser_content[index].clear()\n   854\t        if flushed:\n   855\t            if check_repetition(index, flushed):\n   856\t                return repetition_error()\n   857\t            write(content_frame(base, index, flushed))\n   858\t        add_invoke_calls(index)\n   859\t        del parsers[index]\n   860\t        return None\n   861\t\n   862\t    try:\n   863\t        for raw, data in iter_sse_events(reader.readline, limits.max_body_bytes):\n   864\t            if data is None:\n   865\t                write(raw)  # комментарий/keepalive/event без data — дословно\n   866\t                continue\n   867\t            if data.strip() == \"[DONE]\":\n   868\t                for pending_index in sorted(list(parsers)):\n   869\t                    flushed_outcome = flush_parser(pending_index, last_chunk)\n   870\t                    if flushed_outcome is not None:\n   871\t                        return flushed_outcome\n   872\t                if acc.pending_choices() or (trusted_tools and seen - finished):\n   873\t                    acc.close()  # [DONE] без finish_reason у choice с вызовами: успеха нет\n   874\t                    outcome.incomplete = True\n   875\t                    write(\n   876\t                        _error_frame(\n   877\t                            last_chunk,\n   878\t                            \"upstream_incomplete_stream\",\n   879\t                            \"upstream stream ended before finish_reason\",\n   880\t                        )\n   881\t                    )\n   882\t                    return outcome\n   883\t                outcome.done = True\n   884\t                write(raw)\n   885\t                return outcome\n   886\t            try:\n   887\t                chunk = json.loads(data)\n   888\t            except ValueError:\n   889\t                if data.strip():\n   890\t                    reader.last_progress = time.monotonic()\n   891\t                write(raw)\n   892\t                continue\n   893\t            choices = chunk.get(\"choices\") if isinstance(chunk, dict) else None\n   894\t            if isinstance(choices, list):\n   895\t                # Role/usage — служебные кадры: TTFT защищён до первого полезного токена.\n   896\t                for choice in choices:\n   897\t                    delta = choice.get(\"delta\") if isinstance(choice, dict) else None\n   898\t                    if isinstance(delta, dict) and any(\n   899\t                        delta.get(key)\n   900\t                        for key in (\n   901\t                            \"content\",\n   902\t                            \"reasoning_content\",\n   903\t                            \"reasoning\",\n   904\t                            \"reasoning_text\",\n   905\t                            \"tool_calls\",\n   906\t                            \"function_call\",\n   907\t                        )\n   908\t                    ):\n   909\t                        reader.last_progress = time.monotonic()\n   910\t                        break\n   911\t            if not isinstance(choices, list):\n   912\t                if isinstance(chunk, dict):\n   913\t                    meta = {\n   914\t                        k: chunk.get(k)\n   915\t                        for k in (\"id\", \"created\", \"model\")\n   916\t                        if chunk.get(k) is not None\n   917\t                    }\n   918\t                    if meta:\n   919\t                        outcome.last_chunk = {**(outcome.last_chunk or {}), **meta}\n   920\t                write(raw)\n   921\t                continue\n   922\t            if not sanitize:\n   923\t                outcome.last_chunk = {k: chunk.get(k) for k in (\"id\", \"created\", \"model\")}\n   924\t                for choice in choices:\n   925\t                    if isinstance(choice, dict):\n   926\t                        raw_index = choice.get(\"index\")\n   927\t                        idx = (\n   928\t                            raw_index\n   929\t                            if isinstance(raw_index, int)\n   930\t                            and not isinstance(raw_index, bool)\n   931\t                            else 0\n   932\t                        )\n   933\t                        seen.add(idx)\n   934\t                        if choice.get(\"finish_reason\"):\n   935\t                            finished.add(idx)\n   936\t                        if limits.repetition_guard_enabled:\n   937\t                            delta = choice.get(\"delta\")\n   938\t                            text_value = (\n   939\t                                delta.get(\"content\")\n   940\t                                if isinstance(delta, dict)\n   941\t                                else None\n   942\t                            )\n   943\t                            if isinstance(text_value, str) and check_repetition(\n   944\t                                idx, text_value\n   945\t                            ):\n   946\t                                return repetition_error()\n   947\t                outcome.unfinished_choices = set(seen - finished)\n   948\t                write(raw)\n   949\t                continue\n   950\t            last_chunk = {k: chunk.get(k) for k in (\"id\", \"created\", \"model\")}\n   951\t            outcome.last_chunk = last_chunk\n   952\t            modified = False\n   953\t            terminal: list[int] = []\n   954\t            terminal_content: dict[int, str] = {}\n   955\t            for choice in choices:\n   956\t                if not isinstance(choice, dict):\n   957\t                    continue\n   958\t                raw_index = choice.get(\"index\")\n   959\t                index = (\n   960\t                    raw_index\n   961\t                    if isinstance(raw_index, int) and not isinstance(raw_index, bool)\n   962\t                    else 0\n   963\t                )\n   964\t                seen.add(index)\n   965\t                delta = choice.get(\"delta\")\n   966\t                if isinstance(delta, dict) and \"tool_calls\" in delta:\n   967\t                    if trusted_tools:\n   968\t                        calls = delta[\"tool_calls\"]\n   969\t                        if isinstance(calls, list):\n   970\t                            outcome.tool_calls_published += sum(\n   971\t                                isinstance(call, dict) and bool(call.get(\"id\"))\n   972\t                                for call in calls\n   973\t                            )\n   974\t                    else:\n   975\t                        acc.add(index, delta[\"tool_calls\"])\n   976\t                        delta = {k: v for k, v in delta.items() if k != \"tool_calls\"}\n   977\t                        choice[\"delta\"] = delta\n   978\t                        modified = True\n   979\t                if isinstance(delta, dict):\n   980\t                    content_value = delta.get(\"content\")\n   981\t                    if isinstance(content_value, str) and content_value:\n   982\t                        text_out = content_value\n   983\t                        if limits.invoke_normalization_enabled:\n   984\t                            parser_content[index] = parser_content.get(index, [])\n   985\t                            parser = parser_for(index)\n   986\t                            parser_content[index].clear()\n   987\t                            parser.feed(content_value)\n   988\t                            text_out = \"\".join(parser_content[index])\n   989\t                            parser_content[index].clear()\n   990\t                            had_calls = bool(parser_calls.get(index))\n   991\t                            add_invoke_calls(index)\n   992\t                            if text_out != content_value or had_calls:\n   993\t                                delta = dict(delta)\n   994\t                                if text_out:\n   995\t                                    delta[\"content\"] = text_out\n   996\t                                else:\n   997\t                                    delta.pop(\"content\", None)\n   998\t                                choice[\"delta\"] = delta\n   999\t                                modified = True\n  1000\t                        if check_repetition(index, text_out):\n  1001\t                            return repetition_error()\n  1002\t                if choice.get(\"finish_reason\"):\n  1003\t                    finished.add(index)\n  1004\t                    terminal.append(index)\n  1005\t                    if (\n  1006\t                        isinstance(delta, dict)\n  1007\t                        and isinstance(delta.get(\"content\"), str)\n  1008\t                        and delta[\"content\"]\n  1009\t                    ):\n  1010\t                        terminal_content[index] = delta[\"content\"]\n  1011\t                        delta = {k: v for k, v in delta.items() if k != \"content\"}\n  1012\t                        choice[\"delta\"] = delta\n  1013\t                        modified = True\n  1014\t            outcome.unfinished_choices = set(seen - finished)\n  1015\t            for index in sorted(terminal):\n  1016\t                if index in terminal_content:\n  1017\t                    write(content_frame(chunk, index, terminal_content[index]))\n  1018\t                flushed_outcome = flush_parser(index, chunk)\n  1019\t                if flushed_outcome is not None:\n  1020\t                    return flushed_outcome\n  1021\t                if not acc.has_choice(index):\n  1022\t                    continue\n  1023\t                calls = sanitize_choice_calls(\n  1024\t                    acc.pop_choice(index), tool_schemas, limits\n  1025\t                )\n  1026\t                outcome.tool_calls_published += len(calls)\n  1027\t                write(\n  1028\t                    _data_frame(\n  1029\t                        {\n  1030\t                            **{\n  1031\t                                k: chunk[k]\n  1032\t                                for k in chunk\n  1033\t                                if k not in (\"choices\", \"usage\", \"error\")\n  1034\t                            },\n  1035\t                            \"choices\": [\n  1036\t                                {\n  1037\t                                    \"index\": index,\n  1038\t                                    \"delta\": {\"tool_calls\": calls},\n  1039\t                                    \"finish_reason\": None,\n  1040\t                                }\n  1041\t                            ],\n  1042\t                        }\n  1043\t                    )\n  1044\t                )\n  1045\t            if not modified:\n  1046\t                write(raw)\n  1047\t                continue\n  1048\t            only_empty = all(\n  1049\t                isinstance(c, dict)\n  1050\t                and not c.get(\"delta\")\n  1051\t                and not c.get(\"finish_reason\")\n  1052\t                for c in choices\n  1053\t            )\n  1054\t            if choices and only_empty and \"usage\" not in chunk and \"error\" not in chunk:\n  1055\t                continue  # чанк состоял только из дельт tool_calls\n  1056\t            write(_data_frame(chunk))\n  1057\t        # EOF без [DONE]: недособранное сбрасывается, незавершённые choices — ошибка.\n  1058\t        for pending_index in sorted(list(parsers)):\n  1059\t            flushed_outcome = flush_parser(pending_index, last_chunk)\n  1060\t            if flushed_outcome is not None:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_stream_resilience.py | sed -n '1000,1220p'; nl -ba tests/test_http_presend_resilience.py; git diff -- adapters/passthrough_adapter.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/test_stream_resilience.py | sed -n '1000,1220p'; nl -ba tests/test_http_presend_resilience.py; git diff -- adapters/passthrough_adapter.py\"","aggregated_output":"  1000\tconst result=stream(model,context,{apiKey:'probe-only',maxRetries:0,signal:controller.signal,fetch:async()=>new Response(new ReadableStream({start(c){for(let i=1;i<=8;i++)timers.push(setTimeout(()=>c.enqueue(encoder.encode(heartbeat)),i*40));timers.push(setTimeout(()=>{c.enqueue(encoder.encode(terminal));c.close();},360));}}),{headers:{'content-type':'text/event-stream'}})});\n  1001\tasync function* relevant(){for await(const e of result)if(['thinking_delta','done','error'].includes(e.type))yield e;}\n  1002\tconst iterator=relevant(), watchdog=idleWatchdog(controller.signal,160,'LLM_STREAM_IDLE_TIMEOUT');\n  1003\tconst started=Date.now();let seen=0,done=false;\n  1004\ttry {\n  1005\t while(true){const n=await watchdog.next(iterator);if(n.done)break;if(n.value.type==='thinking_delta'){assert.equal(n.value.delta,' ');seen++;}if(n.value.type==='done')done=true;if(n.value.type==='error')throw new Error('provider error');}\n  1006\t const final=await result.result();\n  1007\t const thinking=final.content.filter(c=>c.type==='thinking').map(c=>c.thinking).join('');\n  1008\t const text=final.content.filter(c=>c.type==='text').map(c=>c.text).join('');\n  1009\t assert.equal(seen,8);assert(done);assert(Date.now()-started>160);assert.equal(thinking,' '.repeat(8));assert.equal(text,'');\n  1010\t console.log(JSON.stringify({heartbeats:seen,terminal:done,aborted:watchdog.signal.aborted,thinkingLength:thinking.length,textLength:text.length}));\n  1011\t} finally {watchdog[Symbol.dispose]();controller.abort();timers.forEach(clearTimeout);}\n  1012\t\"\"\".replace(\"__HEARTBEAT__\", json.dumps(heartbeat))\n  1013\t    proc = subprocess.run(\n  1014\t        [\n  1015\t            \"/Applications/DeepSeek Harness.app/Contents/MacOS/DeepSeek Harness\",\n  1016\t            \"--expose-internals\",\n  1017\t            \"--input-type=module\",\n  1018\t        ],\n  1019\t        input=script,\n  1020\t        text=True,\n  1021\t        capture_output=True,\n  1022\t        timeout=20,\n  1023\t        env={**os.environ, \"ELECTRON_RUN_AS_NODE\": \"1\"},\n  1024\t    )\n  1025\t    assert proc.returncode == 0, proc.stderr\n  1026\t    assert json.loads(proc.stdout) == {\n  1027\t        \"heartbeats\": 8,\n  1028\t        \"terminal\": True,\n  1029\t        \"aborted\": False,\n  1030\t        \"thinkingLength\": 8,\n  1031\t        \"textLength\": 0,\n  1032\t    }\n  1033\t\n  1034\t\n  1035\tdef sse_chunk(content: str | None, finish_reason: str | None = None) -> bytes:\n  1036\t    delta: Delta = {} if content is None else {\"content\": content}\n  1037\t    chunk: Chunk = {\n  1038\t        \"id\": \"chatcmpl-sliding\",\n  1039\t        \"object\": \"chat.completion.chunk\",\n  1040\t        \"created\": 1,\n  1041\t        \"model\": \"m\",\n  1042\t        \"choices\": [{\"delta\": delta, \"finish_reason\": finish_reason}],\n  1043\t    }\n  1044\t    return b\"data: \" + json.dumps(chunk).encode() + b\"\\n\"\n  1045\t\n  1046\t\n  1047\tdef paced_readline(chunks: int | None, interval_s: float) -> Callable[[int], bytes]:\n  1048\t    \"\"\"Построчный upstream: полезный чанк каждые `interval_s`; `chunks=None` — бесконечно.\"\"\"\n  1049\t\n  1050\t    def lines() -> Generator[bytes, None, None]:\n  1051\t        sent = 0\n  1052\t        while chunks is None or sent < chunks:\n  1053\t            time.sleep(interval_s)\n  1054\t            sent += 1\n  1055\t            yield sse_chunk(\"x\")\n  1056\t            yield b\"\\n\"\n  1057\t        yield sse_chunk(None, \"stop\")\n  1058\t        yield b\"\\n\"\n  1059\t        yield b\"data: [DONE]\\n\"\n  1060\t        yield b\"\\n\"\n  1061\t        while True:\n  1062\t            yield b\"\"\n  1063\t\n  1064\t    source = lines()\n  1065\t\n  1066\t    def readline(_limit: int) -> bytes:\n  1067\t        return next(source)\n  1068\t\n  1069\t    return readline\n  1070\t\n  1071\t\n  1072\tdef test_passthrough_safety_limits_defaults_and_env() -> None:\n  1073\t    assert PassthroughLimits().safety_cap_s == 3600.0\n  1074\t    assert PassthroughLimits.from_env({}).safety_cap_s == 3600.0\n  1075\t    assert (\n  1076\t        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"90\"}).safety_cap_s == 90.0\n  1077\t    )\n  1078\t    assert (\n  1079\t        PassthroughLimits.from_env({\"BRIDGE_SAFETY_CAP_S\": \"-1\"}).safety_cap_s == 3600.0\n  1080\t    )\n  1081\t\n  1082\t\n  1083\tdef test_passthrough_sliding_activity_window_extends_stream() -> None:\n  1084\t    # Полезные чанки идут чаще idle_timeout_s, но суммарно дольше total_timeout_s.\n  1085\t    limits = PassthroughLimits(\n  1086\t        total_timeout_s=0.5,\n  1087\t        idle_timeout_s=0.3,\n  1088\t        safety_cap_s=30.0,\n  1089\t        heartbeat_interval_s=30.0,\n  1090\t        poll_interval_s=0.01,\n  1091\t    )\n  1092\t    written: list[bytes] = []\n  1093\t    started = time.monotonic()\n  1094\t    outcome = relay_sse(\n  1095\t        paced_readline(12, 0.1),\n  1096\t        written.append,\n  1097\t        tool_schemas=None,\n  1098\t        limits=limits,\n  1099\t    )\n  1100\t    elapsed = time.monotonic() - started\n  1101\t    assert elapsed > limits.total_timeout_s\n  1102\t    assert outcome.done and not outcome.incomplete\n  1103\t    assert sum(1 for frame in written if b'\"content\": \"x\"' in frame) == 12\n  1104\t\n  1105\t\n  1106\tdef test_passthrough_safety_cap_terminates_infinite_stream() -> None:\n  1107\t    # Апстрим активен вечно: идле не срабатывает, обрывает только аварийный потолок.\n  1108\t    limits = PassthroughLimits(\n  1109\t        total_timeout_s=0.2,\n  1110\t        idle_timeout_s=30.0,\n  1111\t        safety_cap_s=0.6,\n  1112\t        heartbeat_interval_s=30.0,\n  1113\t        poll_interval_s=0.01,\n  1114\t    )\n  1115\t    written: list[bytes] = []\n  1116\t    outcome = StreamOutcome()\n  1117\t    started = time.monotonic()\n  1118\t    with pytest.raises(TimeoutError, match=\"safety cap exceeded\"):\n  1119\t        _ = relay_sse(\n  1120\t            paced_readline(None, 0.05),\n  1121\t            written.append,\n  1122\t            tool_schemas=None,\n  1123\t            limits=limits,\n  1124\t            state=outcome,\n  1125\t        )\n  1126\t    elapsed = time.monotonic() - started\n  1127\t    assert limits.safety_cap_s <= elapsed < limits.safety_cap_s + 1.0\n  1128\t    assert any(b'\"content\": \"x\"' in frame for frame in written)\n  1129\t    assert not outcome.done\n  1130\t\n  1131\t\n  1132\tdef test_passthrough_idle_timeout_not_reset_by_own_heartbeat() -> None:\n  1133\t    # Тишина upstream: свои keepalive клиенту не продлевают окно неактивности.\n  1134\t    limits = PassthroughLimits(\n  1135\t        idle_timeout_s=0.3,\n  1136\t        safety_cap_s=30.0,\n  1137\t        heartbeat_interval_s=0.05,\n  1138\t        poll_interval_s=0.01,\n  1139\t    )\n  1140\t    written: list[bytes] = []\n  1141\t    stop = threading.Event()\n  1142\t\n  1143\t    def silent(_limit: int) -> bytes:\n  1144\t        _ = stop.wait(30)\n  1145\t        return b\"\"\n  1146\t\n  1147\t    started = time.monotonic()\n  1148\t    try:\n  1149\t        with pytest.raises(TimeoutError, match=\"idle timeout exceeded\"):\n  1150\t            _ = relay_sse(silent, written.append, tool_schemas=None, limits=limits)\n  1151\t    finally:\n  1152\t        stop.set()\n  1153\t    assert time.monotonic() - started < 2.0\n  1154\t    assert b\": keepalive\\n\\n\" in written\n  1155\t\n  1156\t\n  1157\tdef test_cap_terminates_real_group_term_then_kill(tmp_path: Path) -> None:\n  1158\t    from core.backend_adapter import TurnResult\n  1159\t\n  1160\t    clock = Clock()\n  1161\t    manager = TurnSessionManager(\n  1162\t        state_root=tmp_path,\n  1163\t        clock=clock,\n  1164\t        safety_cap_s=5,\n  1165\t        finish_reserve_s=0,\n  1166\t        watchdog_interval_s=0.01,\n  1167\t        cancel_grace_s=0.05,\n  1168\t    )\n  1169\t    turn, _ = manager.create_or_attach_turn(\n  1170\t        model=\"test\", backend=\"test\", cwd=str(tmp_path), messages=[]\n  1171\t    )\n  1172\t    proc = subprocess.Popen(\n  1173\t        [\n  1174\t            sys.executable,\n  1175\t            \"-c\",\n  1176\t            \"import signal,time; signal.signal(signal.SIGTERM, signal.SIG_IGN); print('ready',flush=True); time.sleep(60)\",\n  1177\t        ],\n  1178\t        start_new_session=True,\n  1179\t        stdout=subprocess.PIPE,\n  1180\t    )\n  1181\t    try:\n  1182\t        assert cast(io.BufferedReader, proc.stdout).readline() == b\"ready\\n\"\n  1183\t        turn.bind_process(pgid=proc.pid)\n  1184\t        clock.now += 6\n  1185\t\n  1186\t        def runner(_turn: object) -> TurnResult:\n  1187\t            return TurnResult(state=\"done\", rc=proc.wait(timeout=3))\n  1188\t\n  1189\t        worker = manager.spawn_detached_execution(turn, runner)\n  1190\t        assert turn.done_event.wait(5)\n  1191\t        worker.join(timeout=1)\n  1192\t        assert proc.returncode == -signal.SIGKILL\n  1193\t        assert turn.status == \"TIMED_OUT_CAP\"\n  1194\t        error = turn.buffer.error\n  1195\t        assert error is not None\n  1196\t        assert error[\"code\"] == \"timed_out_cap\"\n  1197\t    finally:\n  1198\t        if proc.poll() is None:\n  1199\t            os.killpg(proc.pid, signal.SIGKILL)\n  1200\t            _ = proc.wait(timeout=2)\n  1201\t\n  1202\t\n  1203\tclass TestUncertainCliTurn(RpcCase):\n  1204\t    \"\"\"Реальный RPC-эмулятор не перезапускается после неоднозначного сбоя хода.\"\"\"\n  1205\t\n  1206\t    def test_failed_cli_turn_is_dispatched_once(self) -> None:\n  1207\t        import server\n  1208\t\n  1209\t        last_ok = cast(list[float], getattr(server, \"_last_ok\"))\n  1210\t        last_ok[0] = time.monotonic()\n  1211\t        script = cast(\n  1212\t            Callable[[list[dict[str, object]]], None], getattr(self.hub, \"script\")\n  1213\t        )\n  1214\t        script(\n  1215\t            [\n  1216\t                {\"steps\": [{\"op\": \"exit\", \"rc\": 1}]},\n  1217\t                {\"steps\": [{\"op\": \"text\", \"text\": \"must not be replayed\"}]},\n  1218\t            ]\n  1219\t        )\n  1220\t        conv = cast(Callable[[str], object], getattr(self, \"conv\"))(\n     1\t\"\"\"HTTP-регрессии retry до первой клиентской записи на настоящих сокетах.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport functools\n     6\timport http.client\n     7\timport io\n     8\timport json\n     9\timport socket\n    10\timport threading\n    11\tfrom collections.abc import Callable, Generator\n    12\tfrom contextlib import contextmanager\n    13\tfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n    14\tfrom typing import cast, override\n    15\t\n    16\timport pytest\n    17\t\n    18\timport server\n    19\tfrom adapters.passthrough_adapter import PassthroughAdapter, PassthroughLimits\n    20\tfrom core.lifecycle import KeepaliveController, PreSendRetry\n    21\t\n    22\tSUCCESS = b'{\"id\":\"once\",\"choices\":[{\"message\":{\"content\":\"ok\"}}]}'\n    23\tCONTENT = b'data: {\"id\":\"once\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"first\"},\"finish_reason\":null}]}\\n\\n'\n    24\tTERMINAL = (\n    25\t    b'data: {\"id\":\"once\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\\n\\n'\n    26\t)\n    27\tDONE = b\"data: [DONE]\\n\\n\"\n    28\tWAIT_S = 5.0\n    29\tAction = Callable[[BaseHTTPRequestHandler], None]\n    30\tServePassthrough = Callable[[PassthroughAdapter, bytes, dict[str, object], str], None]\n    31\t\n    32\t\n    33\t@pytest.fixture(autouse=True)\n    34\tdef retry_settings(monkeypatch: pytest.MonkeyPatch) -> None:\n    35\t    \"\"\"Убирает случайность backoff, сохраняя настоящий retry и HTTP-транспорт.\"\"\"\n    36\t    for name, value in {\n    37\t        \"BRIDGE_MAX_RETRIES\": \"3\",\n    38\t        \"BRIDGE_RETRY_BUDGET_S\": \"60\",\n    39\t        \"BRIDGE_RETRY_BACKOFF_S\": \"0.001\",\n    40\t        \"BRIDGE_RETRY_MAX_BACKOFF_S\": \"0.001\",\n    41\t        \"BRIDGE_RETRY_CANCEL_POLL_S\": \"0.001\",\n    42\t    }.items():\n    43\t        monkeypatch.setenv(name, value)\n    44\t    monkeypatch.setattr(\n    45\t        server,\n    46\t        \"PreSendRetry\",\n    47\t        functools.partial(PreSendRetry, rng=lambda _low, high: high),\n    48\t    )\n    49\t\n    50\t\n    51\tdef json_reply(status: int, body: bytes | None = None) -> Action:\n    52\t    payload = (\n    53\t        body\n    54\t        if body is not None\n    55\t        else (\n    56\t            SUCCESS\n    57\t            if status == 200\n    58\t            else json.dumps({\"error\": {\"code\": status}}).encode()\n    59\t        )\n    60\t    )\n    61\t\n    62\t    def respond(handler: BaseHTTPRequestHandler) -> None:\n    63\t        handler.send_response(status)\n    64\t        handler.send_header(\"Content-Type\", \"application/json\")\n    65\t        handler.send_header(\"Content-Length\", str(len(payload)))\n    66\t        handler.end_headers()\n    67\t        _ = handler.wfile.write(payload)\n    68\t        handler.wfile.flush()\n    69\t\n    70\t    return respond\n    71\t\n    72\t\n    73\tdef sse_reply(body: bytes) -> Action:\n    74\t    def respond(handler: BaseHTTPRequestHandler) -> None:\n    75\t        handler.send_response(200)\n    76\t        handler.send_header(\"Content-Type\", \"text/event-stream\")\n    77\t        handler.end_headers()\n    78\t        _ = handler.wfile.write(body)\n    79\t        handler.wfile.flush()\n    80\t\n    81\t    return respond\n    82\t\n    83\t\n    84\tdef reset_reply(handler: BaseHTTPRequestHandler) -> None:\n    85\t    \"\"\"Обрывает upstream после чтения POST, до первой строки HTTP-ответа.\"\"\"\n    86\t    connection = cast(socket.socket, handler.connection)\n    87\t    connection.shutdown(socket.SHUT_RDWR)\n    88\t    connection.close()\n    89\t\n    90\t\n    91\tclass HttpStand:\n    92\t    \"\"\"Два локальных HTTP-сервера: upstream и настоящий passthrough-шов Handler.\"\"\"\n    93\t\n    94\t    def __init__(self, actions: list[Action]) -> None:\n    95\t        self.requests: list[bytes] = []\n    96\t        self.statuses: list[int] = []\n    97\t        self.emitted_at_attempt: list[int] = []\n    98\t        self.errors: list[BaseException] = []\n    99\t        self.finished: threading.Event = threading.Event()\n   100\t        outer = self\n   101\t\n   102\t        class Upstream(BaseHTTPRequestHandler):\n   103\t            @override\n   104\t            def log_message(self, format: str, *args: object) -> None:\n   105\t                return\n   106\t\n   107\t            def do_POST(self) -> None:\n   108\t                body = self.rfile.read(int(self.headers[\"Content-Length\"]))\n   109\t                outer.requests.append(body)\n   110\t                index = len(outer.requests) - 1\n   111\t                actions[min(index, len(actions) - 1)](self)\n   112\t\n   113\t        self.upstream: ThreadingHTTPServer = ThreadingHTTPServer(\n   114\t            (\"127.0.0.1\", 0), Upstream\n   115\t        )\n   116\t        self.upstream.daemon_threads = True\n   117\t        port = self.upstream.server_port\n   118\t        adapter = PassthroughAdapter(\n   119\t            \"http-retry-test\",\n   120\t            {\"base_url\": f\"http://127.0.0.1:{port}/v1\", \"kind\": \"passthrough\"},\n   121\t            dict,\n   122\t            limits=PassthroughLimits(\n   123\t                connect_timeout_s=1, read_timeout_s=1, total_timeout_s=2\n   124\t            ),\n   125\t        )\n   126\t\n   127\t        class Bridge(server.Handler):\n   128\t            @override\n   129\t            def log_message(self, fmt: str, *args: object) -> None:\n   130\t                return\n   131\t\n   132\t            @override\n   133\t            def send_response(self, code: int, message: str | None = None) -> None:\n   134\t                outer.statuses.append(code)\n   135\t                super().send_response(code, message)\n   136\t\n   137\t            @override\n   138\t            def end_headers(self) -> None:\n   139\t                outer.emitted_at_attempt.append(len(outer.requests))\n   140\t                super().end_headers()\n   141\t\n   142\t            @override\n   143\t            def do_POST(self) -> None:\n   144\t                raw = self.rfile.read(int(self.headers[\"Content-Length\"]))\n   145\t                try:\n   146\t                    request = cast(dict[str, object], json.loads(raw))\n   147\t                    serve = cast(ServePassthrough, getattr(self, \"_serve_passthrough\"))\n   148\t                    serve(adapter, raw, request, \"http-test\")\n   149\t                except BaseException as exc:\n   150\t                    outer.errors.append(exc)\n   151\t                    raise\n   152\t                finally:\n   153\t                    outer.finished.set()\n   154\t\n   155\t        self.bridge: ThreadingHTTPServer = ThreadingHTTPServer((\"127.0.0.1\", 0), Bridge)\n   156\t        self.bridge.daemon_threads = True\n   157\t        self.threads: list[threading.Thread] = [\n   158\t            threading.Thread(target=httpd.serve_forever, kwargs={\"poll_interval\": 0.01})\n   159\t            for httpd in (self.upstream, self.bridge)\n   160\t        ]\n   161\t        for thread in self.threads:\n   162\t            thread.start()\n   163\t\n   164\t    def connect(self, *, stream: bool = False) -> socket.socket:\n   165\t        body = json.dumps(\n   166\t            {\"model\": \"http-test\", \"stream\": stream, \"messages\": []}\n   167\t        ).encode()\n   168\t        sock = socket.create_connection((\"127.0.0.1\", self.bridge.server_port), WAIT_S)\n   169\t        sock.sendall(\n   170\t            b\"POST /v1/chat/completions HTTP/1.1\\r\\nHost: localhost\\r\\n\"\n   171\t            + b\"Connection: close\\r\\nContent-Type: application/json\\r\\nContent-Length: \"\n   172\t            + str(len(body)).encode()\n   173\t            + b\"\\r\\n\\r\\n\"\n   174\t            + body\n   175\t        )\n   176\t        return sock\n   177\t\n   178\t    def response(self, *, stream: bool = False) -> tuple[int, bytes]:\n   179\t        with self.connect(stream=stream) as sock:\n   180\t            received = bytearray()\n   181\t            while data := sock.recv(65536):\n   182\t                received.extend(data)\n   183\t        assert self.finished.wait(WAIT_S), \"HTTP handler не завершился\"\n   184\t        assert not self.errors\n   185\t        raw = bytes(received)\n   186\t        assert raw.count(b\"HTTP/1.1 \") == 1, raw\n   187\t\n   188\t        class ResponseSocket:\n   189\t            def makefile(self, _mode: str) -> io.BytesIO:\n   190\t                return io.BytesIO(raw)\n   191\t\n   192\t        response = http.client.HTTPResponse(\n   193\t            cast(socket.socket, cast(object, ResponseSocket()))\n   194\t        )\n   195\t        response.begin()\n   196\t        return response.status, response.read()\n   197\t\n   198\t    def close(self) -> None:\n   199\t        for httpd in (self.bridge, self.upstream):\n   200\t            httpd.shutdown()\n   201\t            httpd.server_close()\n   202\t        for thread in self.threads:\n   203\t            thread.join(timeout=WAIT_S)\n   204\t            assert not thread.is_alive()\n   205\t\n   206\t\n   207\t@contextmanager\n   208\tdef stand(actions: list[Action]) -> Generator[HttpStand]:\n   209\t    instance = HttpStand(actions)\n   210\t    try:\n   211\t        yield instance\n   212\t    finally:\n   213\t        instance.close()\n   214\t\n   215\t\n   216\t@pytest.mark.parametrize(\"stream\", [False, True])\n   217\tdef test_real_502_503_retry_before_any_client_bytes(stream: bool) -> None:\n   218\t    final = CONTENT + TERMINAL + DONE if stream else SUCCESS\n   219\t    success = sse_reply(final) if stream else json_reply(200, final)\n   220\t    with stand([json_reply(502), json_reply(503), success]) as instance:\n   221\t        status, body = instance.response(stream=stream)\n   222\t        assert (status, body) == (200, final)\n   223\t        assert len(instance.requests) == 3\n   224\t        assert len(set(instance.requests)) == 1\n   225\t        assert instance.statuses == [200]\n   226\t        assert instance.emitted_at_attempt == [3]\n   227\t\n   228\t\n   229\t@pytest.mark.parametrize(\"stream\", [False, True])\n   230\tdef test_real_reset_before_response_retries(stream: bool) -> None:\n   231\t    final = CONTENT + TERMINAL + DONE if stream else SUCCESS\n   232\t    success = sse_reply(final) if stream else json_reply(200, final)\n   233\t    with stand([reset_reply, success]) as instance:\n   234\t        assert instance.response(stream=stream) == (200, final)\n   235\t        assert len(instance.requests) == 2\n   236\t        assert instance.statuses == [200]\n   237\t        assert instance.emitted_at_attempt == [2]\n   238\t\n   239\t\n   240\t@pytest.mark.parametrize(\n   241\t    \"prefix\",\n   242\t    [\n   243\t        b\"\",\n   244\t        b\": keepalive\\n\\n\",\n   245\t        KeepaliveController.sse_data_chunk(\n   246\t            \"http-test\", completion_id=\"heartbeat\", created=1\n   247\t        ).encode(),\n   248\t        CONTENT,\n   249\t    ],\n   250\t)\n   251\tdef test_real_stream_eof_after_headers_heartbeat_or_content_never_replays(\n   252\t    prefix: bytes,\n   253\t) -> None:\n   254\t    with stand([sse_reply(prefix), sse_reply(CONTENT + TERMINAL + DONE)]) as instance:\n   255\t        status, body = instance.response(stream=True)\n   256\t        assert status == 200\n   257\t        assert body.startswith(prefix)\n   258\t        assert TERMINAL not in body\n   259\t        assert len(instance.requests) == 1\n   260\t        assert instance.statuses == [200]\n   261\t        assert instance.emitted_at_attempt == [1]\n   262\t\n   263\t\n   264\t@pytest.mark.parametrize(\"retries\", [0, 1, 3])\n   265\tdef test_real_http_retry_exhaustion_is_bounded(\n   266\t    monkeypatch: pytest.MonkeyPatch, retries: int\n   267\t) -> None:\n   268\t    monkeypatch.setenv(\"BRIDGE_MAX_RETRIES\", str(retries))\n   269\t    with stand([json_reply(503)]) as instance:\n   270\t        status, body = instance.response()\n   271\t        assert status == 503\n   272\t        assert json.loads(body)[\"error\"][\"code\"] == 503\n   273\t        assert len(instance.requests) == retries + 1\n   274\t        assert instance.statuses == [503]\n   275\t        assert instance.emitted_at_attempt == [retries + 1]\n   276\t\n   277\t\n   278\tdef test_real_http_retry_budget_does_not_start_unaffordable_retry(\n   279\t    monkeypatch: pytest.MonkeyPatch,\n   280\t) -> None:\n   281\t    monkeypatch.setenv(\"BRIDGE_RETRY_BUDGET_S\", \"0.01\")\n   282\t    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"1\")\n   283\t    monkeypatch.setenv(\"BRIDGE_RETRY_MAX_BACKOFF_S\", \"1\")\n   284\t    with stand([json_reply(502), json_reply(200)]) as instance:\n   285\t        status, body = instance.response()\n   286\t        assert status == 502\n   287\t        assert json.loads(body)[\"error\"][\"code\"] == 502\n   288\t        assert len(instance.requests) == 1\n   289\t        assert instance.statuses == [502]\n   290\t\n   291\t\n   292\tdef test_real_client_cancel_during_retry_backoff_stops_upstream_posts(\n   293\t    monkeypatch: pytest.MonkeyPatch,\n   294\t) -> None:\n   295\t    monkeypatch.setenv(\"BRIDGE_RETRY_BACKOFF_S\", \"1\")\n   296\t    monkeypatch.setenv(\"BRIDGE_RETRY_MAX_BACKOFF_S\", \"1\")\n   297\t    failed = threading.Event()\n   298\t\n   299\t    def first(handler: BaseHTTPRequestHandler) -> None:\n   300\t        json_reply(503)(handler)\n   301\t        failed.set()\n   302\t\n   303\t    with stand([first, json_reply(200)]) as instance:\n   304\t        sock = instance.connect()\n   305\t        try:\n   306\t            assert failed.wait(WAIT_S)\n   307\t        finally:\n   308\t            sock.shutdown(socket.SHUT_RDWR)\n   309\t            sock.close()\n   310\t        assert instance.finished.wait(WAIT_S)\n   311\t        assert len(instance.requests) == 1\n   312\t        assert not instance.errors\ndiff --git a/adapters/passthrough_adapter.py b/adapters/passthrough_adapter.py\nindex 2d85d19..0e703a8 100644\n--- a/adapters/passthrough_adapter.py\n+++ b/adapters/passthrough_adapter.py\n@@ -97,6 +97,7 @@ DEFAULT_CONNECT_TIMEOUT_S = 10.0\n DEFAULT_READ_TIMEOUT_S = 1800.0\n DEFAULT_IDLE_TIMEOUT_S = 300.0\n DEFAULT_TOTAL_TIMEOUT_S = 420.0\n+DEFAULT_SAFETY_CAP_S = 3600.0\n DEFAULT_QUEUE_TIMEOUT_S = (\n     900.0  # ожидание слота `max_concurrent`, если хост своего не задал\n )\n@@ -177,6 +178,7 @@ class PassthroughLimits:\n     read_timeout_s: float = DEFAULT_READ_TIMEOUT_S  # совместимость старого конструктора\n     idle_timeout_s: float = DEFAULT_IDLE_TIMEOUT_S\n     total_timeout_s: float = DEFAULT_TOTAL_TIMEOUT_S\n+    safety_cap_s: float = DEFAULT_SAFETY_CAP_S\n     heartbeat_interval_s: float = 12.0\n     poll_interval_s: float = 0.1\n     reader_join_timeout_s: float = 0.2\n@@ -225,6 +227,9 @@ class PassthroughLimits:\n             total_timeout_s=_positive_float(\n                 env, \"BRIDGE_TOTAL_TIMEOUT_S\", DEFAULT_TOTAL_TIMEOUT_S\n             ),\n+            safety_cap_s=_positive_float(\n+                env, \"BRIDGE_SAFETY_CAP_S\", DEFAULT_SAFETY_CAP_S\n+            ),\n             heartbeat_interval_s=_positive_float(\n                 env, \"BRIDGE_SSE_HEARTBEAT_INTERVAL_S\", 12.0\n             ),\n@@ -642,16 +647,23 @@ class _TimedSseReader:\n         readline: Callable[[int], bytes],\n         write: Callable[[bytes], None],\n         limits: PassthroughLimits,\n-        deadline: float,\n+        deadline: float | None = None,\n     ) -> None:\n         self.limits = limits\n-        self.deadline = deadline\n+        self.start_time = time.monotonic()\n+        # Аварийный потолок жизни стрима; `deadline` (если задан) остаётся жёстким.\n+        self.safety_deadline = (\n+            deadline if deadline is not None else self.start_time + limits.safety_cap_s\n+        )\n         self.write = write\n         self.items: queue.Queue[bytes | Exception] = queue.Queue(\n             maxsize=limits.read_queue_max_entries\n         )\n         self.stop = threading.Event()\n-        self.last_input = time.monotonic()\n+        # last_input — каденс heartbeat (вход upstream или свой keepalive);\n+        # last_upstream — только реальный ввод upstream, без heartbeat.\n+        self.last_input = self.start_time\n+        self.last_upstream = self.start_time\n         self.last_progress: float | None = None\n \n         def read() -> None:\n@@ -680,13 +692,19 @@ class _TimedSseReader:\n     def readline(self, _limit: int) -> bytes:\n         while True:\n             now = time.monotonic()\n-            remaining = self.deadline - now\n-            if self.last_progress is not None:\n-                remaining = min(\n-                    remaining, self.last_progress + self.limits.idle_timeout_s - now\n-                )\n-            if remaining <= 0:\n-                raise TimeoutError(\"upstream stream deadline exceeded\")\n+            safety_remaining = self.safety_deadline - now\n+            if safety_remaining <= 0:\n+                raise TimeoutError(\"upstream stream safety cap exceeded\")\n+            # Скользящее окно: срок тишины отсчитывается от последней активности.\n+            activity_base = (\n+                self.last_progress\n+                if self.last_progress is not None\n+                else self.last_upstream\n+            )\n+            idle_remaining = activity_base + self.limits.idle_timeout_s - now\n+            if idle_remaining <= 0:\n+                raise TimeoutError(\"upstream stream idle timeout exceeded\")\n+            remaining = min(idle_remaining, safety_remaining)\n             heartbeat_due = self.last_input + self.limits.heartbeat_interval_s - now\n             if heartbeat_due <= 0:\n                 self.write(b\": keepalive\\n\\n\")\n@@ -698,12 +716,12 @@ class _TimedSseReader:\n                 )\n             except queue.Empty:\n                 continue\n-            if time.monotonic() >= self.deadline:\n-                raise TimeoutError(\"upstream stream deadline exceeded\")\n+            if time.monotonic() >= self.safety_deadline:\n+                raise TimeoutError(\"upstream stream safety cap exceeded\")\n             if isinstance(item, Exception):\n                 raise item\n             if item:\n-                self.last_input = time.monotonic()\n+                self.last_input = self.last_upstream = time.monotonic()\n             return item\n \n     def close(self) -> None:\n@@ -732,7 +750,7 @@ def relay_sse(\n         readline,\n         write,\n         limits,\n-        deadline if deadline is not None else time.monotonic() + limits.total_timeout_s,\n+        deadline,\n     )\n     outcome = state if state is not None else StreamOutcome()\n     client_write = write\n@@ -1244,11 +1262,19 @@ class PassthroughAdapter(BackendAdapter):\n                 except OSError:\n                     continue\n \n+        streaming = threading.Event()\n+\n         def watch() -> None:\n-            while not stop.wait(\n-                min(self.limits.poll_interval_s, max(0.0, deadline - time.monotonic()))\n-            ):\n-                if time.monotonic() >= deadline or sink.client_gone():\n+            # После начала SSE срок жизни держит скользящее окно ридера (idle + safety cap).\n+            while True:\n+                interval = self.limits.poll_interval_s\n+                if not streaming.is_set():\n+                    interval = min(interval, max(0.0, deadline - time.monotonic()))\n+                if stop.wait(interval):\n+                    return\n+                if (\n+                    not streaming.is_set() and time.monotonic() >= deadline\n+                ) or sink.client_gone():\n                     abort()\n                     return\n \n@@ -1334,7 +1360,11 @@ class PassthroughAdapter(BackendAdapter):\n                         sink, 502, \"upstream_unavailable\", \"upstream is unavailable\"\n                     )\n                 return\n-            self._respond(resp, request, sink, deadline)\n+            content_type = (resp.getheader(\"Content-Type\") or \"\").lower()\n+            is_stream = resp.status == 200 and \"text/event-stream\" in content_type\n+            if is_stream:\n+                streaming.set()\n+            self._respond(resp, request, sink, None if is_stream else deadline)\n         except ClientGone:\n             self._log(\"passthrough client_gone\")\n         finally:\n","exit_code":0,"status":"completed"}}
