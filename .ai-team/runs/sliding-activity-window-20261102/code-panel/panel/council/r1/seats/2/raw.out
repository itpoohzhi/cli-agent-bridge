am total deadline exceeded\")\n  1397\t        connect_remaining = remaining\n  1398\t        if presend_deadline is not None:\n  1399\t            connect_remaining = min(remaining, presend_deadline - time.monotonic())\n  1400\t            if connect_remaining <= 0:\n  1401\t                raise PreSendTransientError(\n  1402\t                    \"upstream connect budget exhausted\", status_code=504\n  1403\t                )\n  1404\t        conn = http.client.HTTPConnection(\n  1405\t            self._host,\n  1406\t            self._port,\n  1407\t            timeout=min(self.limits.connect_timeout_s, connect_remaining),\n  1408\t        )\n  1409\t        try:\n  1410\t            conn.connect()\n  1411\t        except (ConnectionError, socket.gaierror, TimeoutError) as exc:\n  1412\t            # Запрос ещё не посылался: это транспортный отказ, безопасный для общего retry.\n  1413\t            conn.close()\n  1414\t            raise PreSendTransientError(\"upstream connect failed\") from exc\n  1415\t        except BaseException:\n  1416\t            conn.close()\n  1417\t            raise\n  1418\t        if conn.sock is not None:\n  1419\t            if on_socket is not None:\n  1420\t                on_socket(conn.sock)\n  1421\t            remaining = (\n  1422\t                self.limits.total_timeout_s\n  1423\t                if deadline is None\n  1424\t                else deadline - time.monotonic()\n  1425\t            )\n  1426\t            if remaining <= 0:\n  1427\t                conn.close()\n  1428\t                raise TimeoutError(\"upstream total deadline exceeded\")\n  1429\t            conn.sock.settimeout(min(self.limits.read_timeout_s, remaining))\n  1430\t        forwarded = {\n  1431\t            k: v\n  1432\t            for k, v in headers.items()\n  1433\t            if k.lower() not in _REQUEST_DROP\n  1434\t            and (not self._upstream_key or k.lower() != \"authorization\")\n  1435\t        }\n  1436\t        if self.