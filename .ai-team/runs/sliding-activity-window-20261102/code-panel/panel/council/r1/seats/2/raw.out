pletions',raw_body=b'{}',request={},headers={},sink=sink)\nprint(json.dumps({'transport':'real socketpair with HTTPConnection stub','elapsed':round(time.monotonic()-start,3),'total_timeout_s':limits.total_timeout_s,'idle_timeout_s':limits.idle_timeout_s,'first_received':b'first' in sink.body,'second_received':b'second' in sink.body,'upstream_stream_error':b'upstream_stream_error' in sink.body}))\nworker.join(timeout=1)\nPY\"","aggregated_output":"{\"transport\": \"real socketpair with HTTPConnection stub\", \"elapsed\": 0.152, \"total_timeout_s\": 0.15, \"idle_timeout_s\": 0.6, \"first_received\": true, \"second_received\": false, \"upstream_stream_error\": true}\n","exit_code":0,"status":"completed"}}
