# ---- Флаги новой политики (AD-005): локальный GigaRC-совместимый снимок -------------
# Stdlib-only LaunchAgent: ни SDK, ни удалённого транспорта. Старые флаги имеют
# кодовый False; stream resilience — True по брифу. Приоритет:
# env override > JSON bool из dynamic_config.json > кодовый default.


class _RuntimeFlags(NamedTuple):
    """Неизменяемый валидированный снимок флагов новой политики."""

    planner_content_streaming_enabled: bool = False
    emit_tool_trace: bool = False
    extended_timeout_enabled: bool = False
    graceful_timeout_on_partial: bool = False
    step_scoped_usage_enabled: bool = False
    stream_resilience_enabled: bool = True


_NEW_FLAG_ENV = {
    "planner_content_streaming_enabled": "AGY_PLANNER_CONTENT_STREAMING_ENABLED",
    "emit_tool_trace": "AGY_BRIDGE_EMIT_TOOL_TRACE",
    "extended_timeout_enabled": "AGY_EXTENDED_TIMEOUT_ENABLED",
    "graceful_timeout_on_partial": "AGY_GRACEFUL_TIMEOUT_ON_PARTIAL",
    "step_scoped_usage_enabled": "AGY_STEP_SCOPED_USAGE_ENABLED",
    "stream_resilience_enabled": "AGY_BRIDGE_STREAM_RESILIENCE_ENABLED",
}
_ENV_TRUE = frozenset({"1", "true", "yes", "on"})
_ENV_FALSE = frozenset({"0", "false", "no", "off"})
_COLD_FLAGS = _RuntimeFlags()
_cfg_lock = threading.Lock()
_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS
_cfg_key: tuple[int, int] | None = None
_cfg_checked_at: float | None = None
_cfg_generation: int = 0


def _parse_runtime_flags(text: str) -> _RuntimeFlags:
    """Разобрать dynamic_config.json; ValueError — файл отвергается целиком."""
    data = cast(object, json.loads(text))
    if not isinstance(data, dict):
        raise ValueError("dynamic_config: not an object")
    raw = cast("dict[str, object]", data)
    values: dict[str, bool] = {}
    for name in _RuntimeFlags._fields:
        default = getattr(_COLD_FLAGS, name)
        if name == "stream_resilience_enabled":
            default = raw.get(_NEW_FLAG_ENV[name], default)
        value = raw.get(name, default)
        if not isinstance(value, bool):
            raise ValueError("dynamic_config: %s is not boolean" % name)
        values[name] = value
    return _RuntimeFlags(**values)


def _runtime_snapshot() -> _RuntimeFlags:
    """Снимок флагов из dynamic_config.json: TTL 1.0 с, ключ версии (mtime_ns, size).

    Пока stat не изменился, JSON не разбирается (identity снимка сохраняется). Битый
    JSON или не-bool значение отвергают файл целиком: действует last-known-good,
    на холодном старте — False. Отсутствие файла — валидное состояние «все False».
    """
    global _cfg_snapshot, _cfg_key, _cfg_checked_at, _cfg_generation
    now = time.monotonic()
    with _cfg_lock:
        if _cfg_checked_at is not None and now - _cfg_checked_at < FLAG_TTL_S:
            return _cfg_snapshot
        known_key = _cfg_key
        snapshot = _cfg_snapshot
        gen = _cfg_generation
    key = known_key
    try:
        info = DYNAMIC_CONFIG_PATH.stat()
    except FileNotFoundError:
        snapshot, key = _COLD_FLAGS, None
    except OSError:
        pass  # транзиентная ошибка: остаётся last-known-good
    else:
        new_key = (info.st_mtime_ns, info.st_size)
        if new_key != known_key:
            try:
                parsed = _parse_runtime_flags(
                    DYNAMIC_CONFIG_PATH.read_text(encoding="utf-8")
                )
            except OSError:
                pass  # повторим на следующем TTL
            except ValueError:
                key = (
                    new_key  # битый файл: lastgood, без повторного разбора того же stat
                )
            else:
                snapshot, key = parsed, new_key
    with _cfg_lock:
        if _cfg_generation != gen:
            # Параллельный читатель уже записал более свежий снимок: не затираем его.
            return _cfg_snapshot
        _cfg_snapshot = snapshot
        _cfg_key = key
        _cfg_checked_at = time.monotonic()
        _cfg_generation = gen + 1
    return snapshot


def _new_flag(name: str, default: bool = False) -> bool:
    """Явный env > JSON bool > кодовый default; старые флаги выключены."""
    if name == "AGY_BRIDGE_STREAM_RESILIENCE_ENABLED":
        name = "stream_resilience_enabled"
    env = os.environ.get(_NEW_FLAG_ENV[name], "").strip().lower()
    if env in _ENV_TRUE:
        return True
    if env in _ENV_FALSE:
        return False
    return bool(getattr(_runtime_snapshot(), name, default))


AGY_BRIDGE_STREAM_RESILIENCE_ENABLED = _new_flag(
    "AGY_BRIDGE_STREAM_RESILIENCE_ENABLED", True
)


def _positive_env(name: str) -> float | None:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return None
    try:
        value = float(raw)
    except ValueError:
        return None
    if not value > 0.0 or value != value or value == float("inf"):
        return None
    return value


def _extended_timeouts() -> tuple[float, float]:
    """(idle, max) настроенные таймауты: env AGY_IDLE_TIMEOUT_S/AGY_TIMEOUT_S, иначе 1800/3600."""
    idle = (
        _positive_env("AGY_IDLE_TIMEOUT_S")
        or _positive_env("AGY_BRIDGE_IDLE_TIMEOUT")
        or EXT_IDLE_TIMEOUT_S
    )
    cap = _positive_env("AGY_TIMEOUT_S") or EXT_MAX_TIMEOUT_S
    return min(idle, cap), cap


@final
class _TimeoutPolicy:
    """Политика одной попытки при extended_timeout_enabled (AD-003)."""

    def __init__(
        self,
        t_req_start: float,
        idle_timeout_s: float,
        max_timeout_s: float,
        effective_max_timeout_s: float,
        can_start: bool = True,
    ) -> None:
        self.t_req_start = t_req_start
        self.idle_timeout_s = idle_timeout_s
        self.max_timeout_s = max_timeout_s
        self.effective_max_timeout_s = effective_max_timeout_s
                "usage": self._usage_payload(
                    out.get("usage") or {}, out.get("usage_resolved")
                ),
            }
            if out.get("conversation_id"):
                payload["conversation_id"] = out["conversation_id"]
            return payload

        def finalize_timeout(out: dict) -> None:
            """Graceful-финал timeout/idle_timeout: 200/length (идемпотентно, до run.close())."""
            state = out.get("state")
            if out.get("graceful_done") or state not in ("timeout", "idle_timeout"):
                return
            if not _new_flag("graceful_timeout_on_partial"):
                return
            # Остаток источников из terminal drain + полезный partial -> 200/length.
            retained_text, retained_reasoning = consume_retained(out)
            content = str(out.get("text") or "")
            base_reasoning = str(out.get("reasoning") or "")
            reasoning = base_reasoning + retained_reasoning + "".join(markers)
            if not (content.strip() or reasoning.strip() or retained_text.strip()):
                return  # полная тишина: прежняя ошибка 504
            content += retained_text
            content += self._graceful_notice(str(state), out.get("timeout_limit_s"))
            self._arm_flush_window(ctx)
            out["graceful_done"] = True
            _log(f"graceful-timeout state={state} mode=json")
            if not self._prepare_flush_write():
                return
            self._send(200, build_payload(out, content, reasoning, "length"))

        ctx["finalize_timeout"] = finalize_timeout
        out = self._run_once(ctx, lambda _v: True, on_tool_trace, lambda _r: True, None)
        if out.get("state") == "client_gone":
            return
        if out.get("graceful_done"):
            return
        finalize_timeout(out)  # страховка, если _run_once не вызвал hook
        if out.get("graceful_done"):
            return
        retained_reasoning = retained_cache[0][1] if retained_cache else ""
        reasoning = str(out.get("reasoning") or "") + retained_reasoning
        reasoning += "".join(markers)
        err = self._error_body(out, bool(ctx.get("stream_resilience_enabled", True)))
        if err is not None:
            self._send(err["code"], {"error": err})
            return
        self._send(
            200, build_payload(out, str(out.get("text") or ""), reasoning, "stop")
        )

    def _serve_sse(self, ctx: dict) -> None:
        self._reset_flush_window()
        try:
            self._serve_sse_body(ctx)
        finally:
            self._reset_flush_window()

    def _serve_sse_body(self, ctx: dict) -> None:
        completion_id = f"chatcmpl-agy-{uuid.uuid4().hex[:12]}"
        created = int(time.time())
        shown_model = ctx["model"]
        resilience = _new_flag("AGY_BRIDGE_STREAM_RESILIENCE_ENABLED", True)
        ctx["stream_resilience_enabled"] = resilience
        ctx["stream_committed"] = False
        disconnected = False

        def chunk(
            delta: dict,
            finish=None,
            usage: dict | None = None,
            conversation_id: str = "",
            error: dict | None = None,
        ) -> str:
            body: dict = {
                "id": completion_id,
                "object": "chat.completion.chunk",
                "created": created,
                "model": shown_model,
                "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
            }
            if usage is not None:
                body["usage"] = usage
            if conversation_id:
                body["conversation_id"] = conversation_id
            if error is not None:
                body["error"] = error
            return "data: " + json.dumps(body, ensure_ascii=False) + "\n\n"

        def emit(data: str) -> bool:
            nonlocal disconnected
            if resilience and disconnected:
                return False
            ok = self._emit(data)
            if resilience and not ok:
                disconnected = True
            return ok

        def commit() -> bool:
            nonlocal disconnected
            if disconnected:
                return False
            if ctx["stream_committed"]:
                return True
            try:
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("X-Accel-Buffering", "no")
                self.end_headers()
            except (BrokenPipeError, ConnectionResetError, OSError):
                disconnected = True
                _log("client gone before headers")
                return False
            ctx["stream_committed"] = True
            self.close_connection = True
            return emit(chunk({"role": "assistant", "content": ""}))

        # Счётчики полезной выдачи растут только после УСПЕШНОЙ записи клиенту
        # (role-chunk, keepalive и пустые/whitespace-дельты не в счёт).
        emitted_content = [0]
        emitted_reasoning_or_tool = [0]
        progress = _ToolProgress(
            str(ctx.get("turn_id") or ""), str(ctx.get("conversation_id") or "")
        )

        def on_text(value: str) -> bool:
            if resilience and not value:
                return not disconnected
            ok = commit() and emit(chunk({"content": value}))
            if ok and value.strip():
                emitted_content[0] += len(value.strip())
            return ok

        def on_reasoning(value: str) -> bool:
            # Мышление шага: Harness читает первое непустое из
            # reasoning_content|reasoning|reasoning_text — отдаём только первое.
            if resilience and not value:
                return not disconnected
            ok = commit() and emit(chunk({"reasoning_content": value}))
            if ok and value.strip():
                emitted_reasoning_or_tool[0] += 1
            return ok

        def on_tool_trace(event: dict) -> bool:
            if resilience:
                ctx["tool_activity"] = True
            # Нативный инструмент agy исполняется внутри CLI и наружу не уходит как
            # tool_call. Безопасный маркер прогресса — только при emit_tool_trace;
            # выключенный флаг — полный no-op до любого форматирования строк.
            if not _new_flag("emit_tool_trace"):
                return True
            marker = progress.marker(event, commit=False)
            if marker is None:
                return True
            ok = on_reasoning(marker)
            if ok:
                progress.commit()
            return ok

        def keepalive() -> bool:
            if resilience and not ctx["stream_committed"]:
                return not disconnected
            return emit(": keepalive\n\n")

        def finalize_timeout(out: dict) -> None:
            """Graceful-финал timeout/idle_timeout после полезной выдачи (идемпотентно).

            Один общий arbiter-досыл, один notice, один `finish_reason="length"`, один
            [DONE] — всё в одном окне T_FINAL_FLUSH_S; ошибка записи прекращает записи.
            """
            if out.get("graceful_done") or out.get("state") not in (
                "timeout",
                "idle_timeout",
            ):
                return
            if not _new_flag("graceful_timeout_on_partial"):
                return
            retained = list(out.get("retained_events") or [])
            retained_text = "".join(str(p) for k, p in retained if k == "text")
            if not (
                emitted_content[0] > 0
                or emitted_reasoning_or_tool[0] > 0
                or retained_text.strip()
            ):
                return  # полная тишина: прежняя ошибка 504
            self._arm_flush_window(ctx)
            ok = True
            for kind, payload in retained:
                if kind == "text":
                    ok = on_text(str(payload))
                elif kind == "reasoning":
                    ok = on_reasoning(str(payload))
                elif kind == "tool_trace":
                    ok = on_tool_trace(payload)
                if not ok:
                    break
            reason = str(out.get("state"))
            conv_id = str(out.get("conversation_id") or "")
            if ok:
                ok = commit() and emit(
                    chunk(
                        {
                            "content": self._graceful_notice(
                                reason, out.get("timeout_limit_s")
                            )
                        }
                    )
                )
            if ok:
                ok = emit(chunk({}, "length", conversation_id=conv_id))
            if ok:
                _ = emit("data: [DONE]\n\n")
            out["graceful_done"] = True
            _log(f"graceful-timeout state={reason} mode=sse ok={int(bool(ok))}")

        ctx["finalize_timeout"] = finalize_timeout
        if not resilience and not commit():
            return
        out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)
        if disconnected or out.get("state") == "client_gone":
            _log("client gone mid-stream, child killed")
            return
        finalize_timeout(out)  # страховка, если _run_once не вызвал hook
        if out.get("graceful_done"):
            return
        err = self._error_body(out, resilience)
        if resilience and err is not None and not ctx["stream_committed"]:
            self._send(502, {"error": err})
            self.close_connection = True
            return
        if not commit():
            return
        if err is None:
            conv_id = str(out.get("conversation_id") or "")
            if not emit(chunk({}, "stop", conversation_id=conv_id)) and resilience:
                return
            # Harness считает tok/s и % контекста только из usage в потоке
            # (dsh-llm-pi-ai toStreamChunks: usage-chunk -> session usage).
            # Шлём только при ненулевых токенах, чтобы пустой usage от agy
            # не превращался в ложные «0 tok/s / 0%».
            usage = self._usage_payload(
                out.get("usage") or {}, out.get("usage_resolved")
            )
            if usage["prompt_tokens"] or usage["completion_tokens"]:
                if (
# agy-silent-agent-fix: арбитр planner-контента (AD-001), безопасный прогресс нативных
# инструментов (AD-002), раздельные idle/max таймауты (AD-003), graceful timeout
# (AD-004) и локальный GigaRC-совместимый снимок dynamic_config.json (AD-005).
# ======================================================================================

_FLAG_ENV = {
    "planner_content_streaming_enabled": "AGY_PLANNER_CONTENT_STREAMING_ENABLED",
    "emit_tool_trace": "AGY_BRIDGE_EMIT_TOOL_TRACE",
    "extended_timeout_enabled": "AGY_EXTENDED_TIMEOUT_ENABLED",
    "graceful_timeout_on_partial": "AGY_GRACEFUL_TIMEOUT_ON_PARTIAL",
    "step_scoped_usage_enabled": "AGY_STEP_SCOPED_USAGE_ENABLED",
}
_FLAG_NAMES = tuple(_FLAG_ENV)
_NOTICE_MARK = "Превышен лимит времени хода agy"


def _clean_flags(fx: _Fixture) -> None:
    """Старые флаги берутся из файла; legacy-оракулы выполняются без новой SSE-политики."""
    fx.set_env("AGY_BRIDGE_STREAM_RESILIENCE_ENABLED", "false")
    for env in _FLAG_ENV.values():
        fx.set_env(env, None)
    for env in ("AGY_IDLE_TIMEOUT_S", "AGY_TIMEOUT_S", "AGY_BRIDGE_IDLE_TIMEOUT"):
        fx.set_env(env, None)


def _clocked(fx: _Fixture) -> _FakeClock:
    clock = _FakeClock()
    fx.patch("time", _fake_time(clock))
    return clock


def _write_cfg(fx: _Fixture, data: object, mtime_ns: int | None = None) -> None:
    text = data if isinstance(data, str) else json.dumps(data)
    _ = fx.config.write_text(_str(text), encoding="utf-8")
    if mtime_ns is not None:
        os.utime(fx.config, ns=(mtime_ns, mtime_ns))


class RuntimeConfigSnapshotTests(unittest.TestCase):
    """AD-005: локальный GigaRC-совместимый снимок, env > JSON bool > False (VER-005)."""

    def test_runtime_config_snapshot_defaults_false_without_file_or_keys(self) -> None:
        with _Fixture() as fx:
            _clean_flags(fx)
            clock = _clocked(fx)
            new_flag = _bfn("_new_flag")
            for name in _FLAG_NAMES:
                self.assertIs(new_flag(name), False, name)
            _write_cfg(fx, {"unrelated": True}, 1_000_000_000)
            clock.advance(1.1)
            for name in _FLAG_NAMES:
                self.assertIs(new_flag(name), False, name)
            self.assertEqual(_bval("FLAG_TTL_S"), 1.0)

    def test_runtime_config_snapshot_json_true_enables_each_and_all_flags(self) -> None:
        with _Fixture() as fx:
            _clean_flags(fx)
            clock = _clocked(fx)
            new_flag = _bfn("_new_flag")
            stamp = 1_000_000_000
            for name in _FLAG_NAMES:

def _sse_with(
    run_once: Callable[..., object],
    ctx: dict[str, object] | None = None,
    clock: _FakeClock | None = None,
    cost: float = 0.0,
    fail_on: int | None = None,
) -> tuple[Any, _FakeSocket, _FakeWfile, _FakeClock]:
    clock = clock or _FakeClock(5000.0)
    sock = _FakeSocket()
    wfile = _FakeWfile(clock, cost, fail_on)
    handler = _make_sse_handler(sock, wfile)
    handler._run_once = run_once
    with mock.patch.object(_bridge(), "time", _fake_time(clock)):
        handler._serve_sse(ctx if ctx is not None else {"model": "m"})
    return handler, sock, wfile, clock


def _frames_json(frames: list[str]) -> list[object]:
    parsed: list[object] = []
    for frame in frames:
        if frame.startswith("data: [DONE]"):
            parsed.append("[DONE]")
        elif frame.startswith("data: "):
            parsed.append(json.loads(frame[len("data: ") :]))
    return parsed


def _is_length(frame: object) -> bool:
    if not isinstance(frame, dict) or "choices" not in frame:
        return False
    return (
        _dict(cast("list[object]", frame["choices"])[0]).get("finish_reason")
        == "length"
    )


def _content_of(frame: object) -> str:
    if not isinstance(frame, dict) or "choices" not in frame:
        return ""
    delta = _dict(_dict(cast("list[object]", frame["choices"])[0]).get("delta") or {})
    return _str(delta.get("content") or "")


def _scenario(
    kind: str,
    on_text: Callable[[str], object],
    on_tool: Callable[[dict[str, object]], object],
    on_reasoning: Callable[[str], object],
    out: dict[str, object],
) -> None:
    if kind == "content":
        _ = on_text("часть ответа")
        out["text"] = "часть ответа"
    elif kind == "reasoning":
        _ = on_reasoning("мысль")
        out["reasoning"] = "мысль"
    elif kind == "tool":
        _ = on_tool({"name": "run_command", "duration_s": 1.0, "step_index": 4})
    elif kind == "retained":
        out["retained_events"] = [("text", "удержанный хвост")]
        out["retained_planner_text"] = "удержанный хвост"


def _timeout_out(state: str) -> dict[str, object]:
    limit = 1800.0 if state == "timeout" else 900.0
    return {
        "state": state,
        "rc": 124,
        "text": "",
        "reasoning": "",
        "usage": {},
        "result": {},
        "err": "x",
        "tool_calls": [],
        "tool_events": 0,
        "conversation_id": _CID,
        "timeout_limit_s": limit,
    }


class SilentGracefulTimeoutTests(unittest.TestCase):
    def _flags(self, fx: _Fixture, graceful: bool) -> None:
        _clean_flags(fx)
        fx.set_env(_FLAG_ENV["graceful_timeout_on_partial"], "1" if graceful else "0")
        fx.set_env(_FLAG_ENV["emit_tool_trace"], "1")

    def _sse_case(
        self, state: str, kind: str, graceful: bool
    ) -> tuple[list[object], dict[str, object]]:
        with _Fixture() as fx:
            self._flags(fx, graceful)
            holder: dict[str, object] = {}

            def run_once(
                ctx: Any, on_text: Any, on_tool: Any, on_r: Any, _k: object
            ) -> object:
                out = _timeout_out(state)
                _scenario(kind, on_text, on_tool, on_r, out)
                hook = ctx.get("finalize_timeout")
                if hook is not None and out["state"] in ("timeout", "idle_timeout"):
                    hook(out)
                holder["out"] = out
                return out

            _h, _s, wfile, _c = _sse_with(
                run_once, {"model": "m", "t_req_start": 5000.0}
            )
            return _frames_json(wfile.writes), _dict(holder["out"])

    def test_silent_graceful_timeout_sse_matrix(self) -> None:
        for state in ("timeout", "idle_timeout"):
            for kind in ("content", "reasoning", "tool", "retained", "silent"):
                for graceful in (True, False):
                    with self.subTest(state=state, kind=kind, graceful=graceful):
                        frames, _out = self._sse_case(state, kind, graceful)
                        self.assertEqual(frames[-1], "[DONE]")
                        self.assertEqual(frames.count("[DONE]"), 1)
                        errors = [
                            f for f in frames if isinstance(f, dict) and "error" in f
                        ]
                        lengths = [f for f in frames if _is_length(f)]
                        notices = [f for f in frames if _NOTICE_MARK in _content_of(f)]
                        if graceful and kind != "silent":
                            self.assertEqual(errors, [])
                            self.assertEqual(len(lengths), 1)
                            self.assertEqual(len(notices), 1)
                            notice = _content_of(notices[0])
                            self.assertIn(state, notice)
                            limit = "1800" if state == "timeout" else "900"
                            self.assertIn(limit + "s", notice)
                            self.assertEqual(
                                [f for f in frames if _content_of(f)][-1], notices[0]
                            )
                            if kind == "retained":
                                self.assertIn(
                                    "удержанный хвост",
                                    "".join(_content_of(f) for f in frames),
                                )
                            self.assertEqual(
                                sum(
                                    1
                                    for f in frames
                                    if _is_length(f) or "error" in _dict_or_empty(f)
                                ),
                                1,
                            )
                        else:
                            self.assertEqual(lengths, [])
                            self.assertEqual(notices, [])
                            self.assertEqual(len(errors), 1)
                            err = _dict(_dict(errors[0])["error"])
                            self.assertEqual(err["code"], 504)
                            self.assertEqual(err["type"], state)

    def test_silent_graceful_timeout_first_token_timeout_stays_504(self) -> None:
        with _Fixture() as fx:
            self._flags(fx, True)

            def run_once(ctx: Any, *_a: object) -> object:
                out = _timeout_out("first_token_timeout")
                hook = ctx.get("finalize_timeout")
                if hook is not None:
                    hook(out)
                return out

            _h, _s, wfile, _c = _sse_with(run_once, {"model": "m"})
            frames = _frames_json(wfile.writes)
            self.assertFalse(any(_is_length(f) for f in frames))
            errors = [f for f in frames if isinstance(f, dict) and "error" in f]
            self.assertEqual(
                _dict(_dict(errors[0])["error"])["type"], "first_token_timeout"
            )

    def test_silent_graceful_timeout_json_matrix(self) -> None:
        for state in ("timeout", "idle_timeout"):
            for kind in ("content", "reasoning", "tool", "retained", "silent"):
                for graceful in (True, False):
                    with self.subTest(state=state, kind=kind, graceful=graceful):
                        with _Fixture() as fx:
                            self._flags(fx, graceful)
                            sent: list[tuple[int, dict[str, object]]] = []

                            def run_once(
                                _ctx: object,
                                on_t: Any,
                                on_tool: Any,
                                on_r: Any,
                                _k: object,
                            ) -> object:
                                out = _timeout_out(state)
                                _scenario(kind, on_t, on_tool, on_r, out)
                                return out

                            with _Sock() as sock:
                                handler = cast(object, _make_handler(sock))
                                setattr(handler, "_run_once", run_once)
                                setattr(
                                    handler, "_send", lambda c, p: sent.append((c, p))
                                )
                                _ = _ofn(handler, "_serve_json")({"model": "m"})
                        self.assertEqual(len(sent), 1)
                        code, payload = sent[0]
                        if graceful and kind != "silent":
                            self.assertEqual(code, 200)
                            choice = _dict(cast("list[object]", payload["choices"])[0])
                            self.assertEqual(choice["finish_reason"], "length")
                            message = _dict(choice["message"])
                            content = _str(message["content"])
                            self.assertEqual(content.count(_NOTICE_MARK), 1)
                            self.assertIn(state, content)
                            if kind == "content":
                                self.assertIn("часть ответа", content)
                            if kind == "retained":
                                self.assertIn("удержанный хвост", content)
                            if kind == "reasoning":
                                self.assertEqual(message["reasoning_content"], "мысль")
                            if kind == "tool":
                                self.assertIn(
                                    "tool: run_command",
                                    _str(message["reasoning_content"]),
                                )
                        else:
                            self.assertEqual(code, 504)
                            self.assertEqual(_dict(payload["error"])["type"], state)

    def test_silent_graceful_timeout_final_flush_window_survives_expired_deadline(
        self,
    ) -> None:
        with _Fixture() as fx:
            self._flags(fx, True)
            clock = _FakeClock(9000.0)

            def run_once(
                ctx: Any, on_text: Any, on_tool: Any, on_r: Any, _k: object
            ) -> object:
                out = _timeout_out("timeout")
                _scenario("retained", on_text, on_tool, on_r, out)
                ctx["finalize_timeout"](out)
                return out

            # нативный дедлайн (1800 с) давно истёк, но запрос ещё внутри 3600 с
            ctx = {"model": "m", "t_req_start": 9000.0 - 3000.0}
            _h, sock, wfile, _c = _sse_with(run_once, ctx, clock=clock, cost=0.0)
            frames = _frames_json(wfile.writes)
            self.assertTrue(any(_is_length(f) for f in frames))
            self.assertEqual(frames[-1], "[DONE]")
            self.assertEqual(
                sock.timeouts, [5.0, 5.0, 5.0, 5.0]
            )  # суффикс+notice+length+DONE

    def test_silent_graceful_timeout_one_shared_window_for_all_final_writes(
        self,
    ) -> None:
        with _Fixture() as fx:
            self._flags(fx, True)

