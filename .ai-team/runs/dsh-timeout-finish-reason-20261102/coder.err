                _scenario("retained", on_text, on_tool, on_r, out)
                ctx["finalize_timeout"](out)
                holder.append(out)
                return out

            holder: list[dict[str, object]] = []
            # вызовы: 1 role, 2 суффикс, 3 notice (падает) -> length/DONE не пишутся
            _h, sock, wfile, _c = _sse_with(
