cfg_checked_at: float | None = None\n2950-_cfg_generation: int = 0\n2951-\n2952-\n2953:def _parse_runtime_flags(text: str) -> _RuntimeFlags:\n2954-    \"\"\"Разобрать dynamic_config.json; ValueError — файл отвергается целиком.\"\"\"\n2955-    data = cast(object, json.loads(text))\n2956-    if not isinstance(data, dict):\n2957-        raise ValueError(\"dynamic_config: not an object\")\n2958-    raw = cast(\"dict[str, object]\", data)\n2959-    values: dict[str, bool] = {}\n2960-    for name in _RuntimeFlags._fields:\n2961-        default = getattr(_COLD_FLAGS, name)\n2962:        if name == \"stream_resilience_enabled\":\n2963-            default = raw.get(_NEW_FLAG_ENV[name], default)\n2964-        value = raw.get(name, default)\n2965-        if not isinstance(value, bool):\n2966-            raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n2967-        values[name] = value\n2968-    return _RuntimeFlags(**values)\n2969-\n--\n3015-        _cfg_generation = gen + 1\n3016-    return snapshot\n3017-\n3018-\n3019-def _new_flag(name: str, default: bool = False) -> bool:\n3020-    \"\"\"Явный env > JSON bool > кодовый default; старые флаги выключены.\"\"\"\n3021-    if name == \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\":\n3022:        name = \"stream_resilience_enabled\"\n3023-    env = os.environ.get(_NEW_FLAG_ENV[name], \"\").strip().lower()\n3024-    if env in _ENV_TRUE:\n3025-        return True\n3026-    if env in _ENV_FALSE:\n3027-        return False\n3028-    return bool(getattr(_runtime_snapshot(), name, default))\n3029-\n--\n5990-            f\"{_usage_log_fields(out.get('usage_resolved'))} \"\n5991-            f\"err={_err_summary(out.get('err'))!r} {tag}\"\n5992-        )\n5993-\n5994-    def _run_once(\n5995-        self, ctx: dict, on_text, on_tool_trace, on_reasoning, keepalive\n5996-    ) -> dict:\n5997:        if \"stream_resilience_enabled\" not in ctx:\n5998:            ctx[\"stream_resilience_enabled\"] = _new_flag(\n5999-                \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True\n6000-            )\n6001-        model = ctx[\"model\"]\n6002-        effort = ctx[\"effort\"]\n6003-        tag = ctx[\"tag\"]\n6004-        t_enter = time.monotonic()\n6005-        # Бюджет запроса считается от входа HTTP-запроса, до ожидания admission.\n--\n6219-                    typed_out.get(\"delivered_reasoning\")\n6220-                ) or bool(typed_ctx.get(\"stream\") and typed_out.get(\"reasoning\"))\n6221-                delivered = bool(\n6222-                    typed_out.get(\"text\")\n6223-                    or typed_out.get(\"tool_calls\")\n6224-                    or delivered_reasoning\n6225-                )\n6226:                if ctx[\"stream_resilience_enabled\"]:\n6227-                    # Commit запрещает невидимый повтор даже при пустом out;\n6228-                    # нативные инструменты могли изменить данные без tool_calls.\n6229-                    delivered = delivered or bool(\n6230-                        ctx.get(\"stream_committed\")\n6231-                        or ctx.get(\"tool_activity\")\n6232-                        or typed_out.get(\"tool_events\")\n6233-                    )\n--\n6936-            return\n6937-        finalize_timeout(out)  # страховка, если _run_once не вызвал hook\n6938-        if out.get(\"graceful_done\"):\n6939-            return\n6940-        retained_reasoning = retained_cache[0][1] if retained_cache else \"\"\n6941-        reasoning = str(out.get(\"reasoning\") or \"\") + retained_reasoning\n6942-        reasoning += \"\".join(markers)\n6943:        err = self._error_body(out, bool(ctx.get(\"stream_resilience_enabled\", True)))\n6944-        if err is not None:\n6945-            self._send(err[\"code\"], {\"error\": err})\n6946-            return\n6947-        self._send(\n6948-            200, build_payload(out, str(out.get(\"text\") or \"\"), reasoning, \"stop\")\n6949-        )\n6950-\n--\n6956-            self._reset_flush_window()\n6957-\n6958-    def _serve_sse_body(self, ctx: dict) -> None:\n6959-        completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n6960-        created = int(time.time())\n6961-        shown_model = ctx[\"model\"]\n6962-        resilience = _new_flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True)\n6963:        ctx[\"stream_resilience_enabled\"] = resilience\n6964-        ctx[\"stream_committed\"] = False\n6965-        disconnected = False\n6966-\n6967-        def chunk(\n6968-            delta: dict,\n6969-            finish=None,\n6970-            usage: dict | None = None,\n5324-            parsed.append(json.loads(frame[len(\"data: \") :]))\n5325-    return parsed\n5326-\n5327-\n5328:def _is_length(frame: object) -> bool:\n5329-    if not isinstance(frame, dict) or \"choices\" not in frame:\n5330-        return False\n5331-    return (\n5332-        _dict(cast(\"list[object]\", frame[\"choices\"])[0]).get(\"finish_reason\")\n5333:        == \"length\"\n5334-    )\n5335-\n5336-\n5337-def _content_of(frame: object) -> str:\n--\n5502-                        code, payload = sent[0]\n5503-                        if graceful and kind != \"silent\":\n5504-                            self.assertEqual(code, 200)\n5505-                            choice = _dict(cast(\"list[object]\", payload[\"choices\"])[0])\n5506:                            self.assertEqual(choice[\"finish_reason\"], \"length\")\n5507-                            message = _dict(choice[\"message\"])\n5508-                            content = _str(message[\"content\"])\n5509-                            self.assertEqual(content.count(_NOTICE_MARK), 1)\n5510-                            self.assertIn(state, content)\n--\n5802-                _ = _ofn(handler, \"_serve_json\")(_ctx(stream=False))\n5803-            code, payload = sent[0]\n5804-            self.assertEqual(code, 200)\n5805-            choice = _dict(cast(\"list[object]\", payload[\"choices\"])[0])\n5806:            self.assertEqual(choice[\"finish_reason\"], \"length\")\n5807-            content = _str(_dict(choice[\"message\"])[\"content\"])\n5808-            self.assertTrue(content.startswith(\"Hello world\"))\n5809-            self.assertEqual(content.count(_NOTICE_MARK), 1)\n5810-        with _Fixture() as fx:  # полная тишина обоих источников -> прежний 504\n--\n5946-                self.assertIsNone(handler._flush_deadline)\n5947-                self.assertEqual(len(sent), 1)\n5948-                self.assertEqual(sent[0][0], 200)\n5949-                choice = _dict(cast(\"list[object]\", sent[0][1][\"choices\"])[0])\n5950:                self.assertEqual(choice[\"finish_reason\"], \"length\")\n5951-\n5952-    def test_silent_rw001_json_finalizes_before_run_close(self) -> None:\n5953-        order: list[str] = []\n5954-\n--\n13325-            for frame in frames\n13326-            for choice in frame[\"choices\"]\n13327-            if choice[\"finish_reason\"]\n13328-        ]\n13329:        self.assertEqual(terminals, [\"length\"])\n13330-        self.assertEqual(body.count(\"data: [DONE]\"), 1)\n13331-        self.assertFalse(any(\"error\" in frame for frame in frames))\n13332-\n13333-    def test_flag_defaults_config_and_env_precedence(self) -> None:\n","exit_code":0,"status":"completed"}}
