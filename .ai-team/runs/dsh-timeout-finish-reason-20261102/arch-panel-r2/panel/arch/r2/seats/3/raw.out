{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SPoF9mfsM1gumZ1JXgCJsZ","type":"tool_result","content":"                outcomes.append(on_tool({\"name\": \"run_command\", \"step_index\": 1}))\n                out: dict[str, object] = {\n                    \"state\": \"timeout\",\n                    \"rc\": 124,\n                    \"text\": \"\",\n                    \"usage\": {},\n                    \"conversation_id\": \"\",\n                    \"timeout_limit_s\": 1800.0,\n                }\n                hook = ctx.get(\"finalize_timeout\")\n                if hook is not None:\n                    hook(out)\n                return out\n\n            _h, _s, wfile, _c = _sse_with(run_once, fail_on=2)\n            self.assertEqual(outcomes, [False])\n            frames = _frames_json(wfile.writes)\n            self.assertFalse(any(_is_length(f) for f in frames))\n            self.assertTrue(any(isinstance(f, dict) and \"error\" in f for f in frames))\n#####\n                },\n            }\n        ]\n        upstream = io.BytesIO((\"data: \" + json.dumps(pending) + \"\\n\\n\" + body).encode())\n        downstream: list[bytes] = []\n        outcome = relay_sse(\n            upstream.readline,\n            downstream.append,\n            tool_schemas=None,\n            limits=PassthroughLimits(),\n        )\n        self.assertFalse(outcome.incomplete)\n        self.assertTrue(outcome.done)\n        self.assertNotIn(\n            b\"upstream stream ended before finish_reason\", b\"\".join(downstream)\n        )\n        self.assertIn(b'\"error\"', b\"\".join(downstream))\n\n    def test_enabled_graceful_timeout_retains_single_length_final(self) -> None:\n        with mock.patch.dict(os.environ, {\"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\": \"true\"}):\n            _, body, frames, _ = self._stream(\n                self._out(state=\"idle_timeout\", rc=124), ((\"text\", \"часть ответа\"),)\n            )\n        terminals = [\n            choice[\"finish_reason\"]\n            for frame in frames\n            for choice in frame[\"choices\"]\n            if choice[\"finish_reason\"]\n        ]\n        self.assertEqual(terminals, [\"length\"])\n        self.assertEqual(body.count(\"data: [DONE]\"), 1)\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-timeout-finish-reason-20261102/arch-panel-r2/panel/arch/r2","is_error":false}]},"parent_tool_use_id":null,"session_id":"48cdbca1-dddc-4a15-b22c-31ed4196ac2c","uuid":"d27cd43d-bf80-45f0-b6b1-885f0465a147","timestamp":"2026-11-01T23:20:31.717Z","tool_use_result":{"stdout":"                outcomes.append(on_tool({\"name\": \"run_command\", \"step_index\": 1}))\n                out: dict[str, object] = {\n                    \"state\": \"timeout\",\n                    \"rc\": 124,\n                    \"text\": \"\",\n                    \"usage\": {},\n                    \"conversation_id\": \"\",\n                    \"timeout_limit_s\": 1800.0,\n                }\n                hook = ctx.get(\"finalize_timeout\")\n                if hook is not None:\n                    hook(out)\n                return out\n\n            _h, _s, wfile, _c = _sse_with(run_once, fail_on=2)\n            self.assertEqual(outcomes, [False])\n            frames = _frames_json(wfile.writes)\n            self.assertFalse(any(_is_length(f) for f in frames))\n            self.assertTrue(any(isinstance(f, dict) and \"error\" in f for f in frames))\n#####\n                },\n            }\n        ]\n        upstream = io.BytesIO((\"data: \" + json.dumps(pending) + \"\\n\\n\" + body).encode())\n        downstream: list[bytes] = []\n        outcome = relay_sse(\n            upstream.readline,\n            downstream.append,\n            tool_schemas=None,\n            limits=PassthroughLimits(),\n        )\n        self.assertFalse(outcome.incomplete)\n        self.assertTrue(outcome.done)\n        self.assertNotIn(\n            b\"upstream stream ended before finish_reason\", b\"\".join(downstream)\n        )\n        self.assertIn(b'\"error\"', b\"\".join(downstream))\n\n    def test_enabled_graceful_timeout_retains_single_length_final(self) -> None:\n        with mock.patch.dict(os.environ, {\"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\": \"true\"}):\n            _, body, frames, _ = self._stream(\n                self._out(state=\"idle_timeout\", rc=124), ((\"text\", \"часть ответа\"),)\n            )\n        terminals = [\n            choice[\"finish_reason\"]\n            for frame in frames\n            for choice in frame[\"choices\"]\n            if choice[\"finish_reason\"]\n        ]\n        self.assertEqual(terminals, [\"length\"])\n        self.assertEqual(body.count(\"data: [DONE]\"), 1)","stderr":"\nShell cwd was reset to /Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-timeout-finish-reason-20261102/arch-panel-r2/panel/arch/r2","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SPoF9mfsM1gumZ1JXgCJsZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
