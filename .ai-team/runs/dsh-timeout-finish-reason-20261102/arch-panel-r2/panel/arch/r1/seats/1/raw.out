{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,285p' /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py; nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py | sed -n '2924,2970p;3020,3043p'; nl -ba /Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py | sed -n '13315,13395p'; rg -n 'stream_resilience_enabled|graceful_timeout' /Users/aazhiry1/work/src/cli-agent-bridge/core/backend_adapter.py /Users/aazhiry1/work/src/cli-agent-bridge/core/turn_session_manager.py /Users/aazhiry1/work/src/cli-agent-bridge/core/context_resilience.py\"","aggregated_output":"    def __call__(self) -> float:\n        return self.now\n\n    def advance(self, seconds: float) -> None:\n        self.now += seconds\n\n\nclass _TickQueue:\n    \"\"\"Очередь, у которой пустое ожидание двигает мок-часы на `timeout` секунд.\"\"\"\n\n    def __init__(self, clock: _FakeClock, empty_ticks: int, events: list) -> None:\n        self.clock = clock\n        self.empty_ticks = empty_ticks\n        self.events = list(events)\n\n    def get(self, timeout: float = 0.0) -> Any:\n        if self.empty_ticks > 0:\n            self.empty_ticks -= 1\n            self.clock.advance(float(timeout))\n            raise queue.Empty\n        if self.events:\n            return self.events.pop(0)\n        self.clock.advance(float(timeout))\n        raise queue.Empty\n\n\nclass _SpyController:\n    \"\"\"Обёртка над реальным контроллером: считает check() и on_activity().\"\"\"\n\n    def __init__(\n        self, inner: AdaptiveTimeoutController, forced: tuple | None = None\n    ) -> None:\n        self.inner = inner\n        self.forced = forced\n        self.check_calls = 0\n        self.activity: list[str] = []\n\n    def on_activity(self, kind: str = \"protocol\") -> None:\n        self.activity.append(kind)\n        self.inner.on_activity(kind)\n\n    def check(self, pgid: int | None = None) -> tuple:\n        self.check_calls += 1\n        if self.forced is not None:\n            return self.forced\n        return self.inner.check(pgid)\n\n\ndef _spawn(argv: list[str], **kwargs: Any) -> subprocess.Popen:\n    return subprocess.Popen(argv, start_new_session=True, **kwargs)\n\n\ndef _hard_kill(proc: subprocess.Popen) -> None:\n    try:\n        os.killpg(proc.pid, signal.SIGKILL)\n    except (ProcessLookupError, PermissionError, OSError):\n        pass\n    try:\n        proc.wait(timeout=5)\n    except (subprocess.TimeoutExpired, OSError):\n        pass\n\n\ndef _ps_stat(pid: int) -> str:\n    out = subprocess.run(\n        [\"ps\", \"-o\", \"stat=\", \"-p\", str(pid)],\n        capture_output=True,\n        text=True,\n        check=False,\n    )\n    return out.stdout.strip()\n\n\ndef _group_gone(pgid: int, within_s: float = 2.0) -> bool:\n    deadline = time.monotonic() + within_s\n    while time.monotonic() < deadline:\n        try:\n            os.killpg(pgid, 0)\n        except ProcessLookupError:\n            return True\n        except PermissionError:\n            pass\n        time.sleep(0.05)\n    return False\n\n\nclass _Sock:\n    \"\"\"Пара сокетов для Handler.connection: пир открыт, данных нет -> клиент «на месте».\"\"\"\n\n    a: socket.socket = cast(socket.socket, cast(object, None))\n    b: socket.socket = cast(socket.socket, cast(object, None))\n\n    def __enter__(self) -> socket.socket:\n        self.a, self.b = socket.socketpair()\n        return self.a\n\n    def __exit__(self, *_exc: Any) -> None:\n        self.a.close()\n        self.b.close()\n\n\ndef _make_handler(connection: socket.socket) -> Any:\n    handler = srv.Handler.__new__(srv.Handler)\n    handler.connection = connection\n    return handler\n\n\ndef _fake_run(\n    clock: _FakeClock, controller: Any, events: list, empty_ticks: int\n) -> SimpleNamespace:\n    return SimpleNamespace(\n        q=_TickQueue(clock, empty_ticks, events),\n        controller=controller,\n        proc=SimpleNamespace(pid=424242),\n        got_event=True,\n        started=clock(),\n        err_box=[],\n    )\n\n\ndef _fake_time(clock: _FakeClock) -> SimpleNamespace:\n    return SimpleNamespace(\n        monotonic=clock, sleep=lambda _s: None, strftime=time.strftime, time=time.time\n    )\n\n\ndef _execute_with_clock(clock: _FakeClock, run: SimpleNamespace) -> dict:\n    \"\"\"Прогнать Handler._execute на мок-часах без реальных ожиданий.\"\"\"\n    with _Sock() as sock, mock.patch.object(srv, \"time\", _fake_time(clock)):\n        handler = _make_handler(sock)\n        return handler._execute(\n            run, lambda _t: True, lambda _e: True, lambda _r: True, None\n        )\n\n\nclass IdleDetectionTests(unittest.TestCase):\n    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n    def test_idle_timeout_detected_for_sleeping_process(self) -> None:\n        proc = _spawn([\"sleep\", \"100\"])\n        try:\n            ctrl = AdaptiveTimeoutController(\n                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n            )\n            ctrl.register_pgid(proc.pid)\n            result: tuple = (False, \"\", None)\n            deadline = time.monotonic() + 2.0\n            while time.monotonic() < deadline:\n                result = ctrl.check(proc.pid)\n                if result[0]:\n                    break\n                time.sleep(0.05)\n            self.assertTrue(result[0])\n            self.assertEqual(result[1], \"idle_timeout\")\n            ctrl.close()\n        finally:\n            _hard_kill(proc)\n\n    @unittest.skipUnless(_DARWIN, \"core.watchdog рассчитан на macOS ps\")\n    def test_cpu_delta_resets_idle_timer(self) -> None:\n        proc = _spawn([sys.executable, \"-I\", \"-c\", \"while True: pass\"])\n        try:\n            ctrl = AdaptiveTimeoutController(\n                idle_timeout_s=0.2, safety_cap_s=60.0, finish_reserve_s=0.0\n            )\n            ctrl.register_pgid(proc.pid)\n            end = time.monotonic() + 0.9  # заметно больше idle_timeout_s\n            while time.monotonic() < end:\n                should_stop, reason, _m = ctrl.check(proc.pid)\n                self.assertFalse(should_stop, f\"ложный {reason}: CPU растёт\")\n                time.sleep(0.05)\n            self.assertEqual(ctrl.last_activity_kind, \"cpu_delta\")\n            ctrl.close()\n        finally:\n            _hard_kill(proc)\n\n    def test_on_activity_resets_idle_timer(self) -> None:\n        for kind in (\"text\", \"reasoning\", \"tool_trace\", \"init\"):\n            with self.subTest(kind=kind):\n                clock = _FakeClock()\n                ctrl = AdaptiveTimeoutController(\n                    idle_timeout_s=0.2,\n                    safety_cap_s=60.0,\n                    finish_reserve_s=0.0,\n                    watchdog_enabled=False,\n                    clock=clock,\n                )\n                for _ in range(5):\n                    clock.advance(0.15)\n                    ctrl.on_activity(kind)\n                    self.assertEqual(ctrl.check(), (False, \"\", None))\n                self.assertEqual(ctrl.last_activity_kind, kind)\n                clock.advance(0.25)\n                should_stop, reason, _m = ctrl.check()\n                self.assertTrue(should_stop)\n                self.assertEqual(reason, \"idle_timeout\")\n\n  2924\tclass _RuntimeFlags(NamedTuple):\n  2925\t    \"\"\"Неизменяемый валидированный снимок флагов новой политики.\"\"\"\n  2926\t\n  2927\t    planner_content_streaming_enabled: bool = False\n  2928\t    emit_tool_trace: bool = False\n  2929\t    extended_timeout_enabled: bool = False\n  2930\t    graceful_timeout_on_partial: bool = False\n  2931\t    step_scoped_usage_enabled: bool = False\n  2932\t    stream_resilience_enabled: bool = True\n  2933\t\n  2934\t\n  2935\t_NEW_FLAG_ENV = {\n  2936\t    \"planner_content_streaming_enabled\": \"AGY_PLANNER_CONTENT_STREAMING_ENABLED\",\n  2937\t    \"emit_tool_trace\": \"AGY_BRIDGE_EMIT_TOOL_TRACE\",\n  2938\t    \"extended_timeout_enabled\": \"AGY_EXTENDED_TIMEOUT_ENABLED\",\n  2939\t    \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n  2940\t    \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n  2941\t    \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n  2942\t}\n  2943\t_ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n  2944\t_ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n  2945\t_COLD_FLAGS = _RuntimeFlags()\n  2946\t_cfg_lock = threading.Lock()\n  2947\t_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS\n  2948\t_cfg_key: tuple[int, int] | None = None\n  2949\t_cfg_checked_at: float | None = None\n  2950\t_cfg_generation: int = 0\n  2951\t\n  2952\t\n  2953\tdef _parse_runtime_flags(text: str) -> _RuntimeFlags:\n  2954\t    \"\"\"Разобрать dynamic_config.json; ValueError — файл отвергается целиком.\"\"\"\n  2955\t    data = cast(object, json.loads(text))\n  2956\t    if not isinstance(data, dict):\n  2957\t        raise ValueError(\"dynamic_config: not an object\")\n  2958\t    raw = cast(\"dict[str, object]\", data)\n  2959\t    values: dict[str, bool] = {}\n  2960\t    for name in _RuntimeFlags._fields:\n  2961\t        default = getattr(_COLD_FLAGS, name)\n  2962\t        if name == \"stream_resilience_enabled\":\n  2963\t            default = raw.get(_NEW_FLAG_ENV[name], default)\n  2964\t        value = raw.get(name, default)\n  2965\t        if not isinstance(value, bool):\n  2966\t            raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n  2967\t        values[name] = value\n  2968\t    return _RuntimeFlags(**values)\n  2969\t\n  2970\t\n  3020\t    \"\"\"Явный env > JSON bool > кодовый default; старые флаги выключены.\"\"\"\n  3021\t    if name == \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\":\n  3022\t        name = \"stream_resilience_enabled\"\n  3023\t    env = os.environ.get(_NEW_FLAG_ENV[name], \"\").strip().lower()\n  3024\t    if env in _ENV_TRUE:\n  3025\t        return True\n  3026\t    if env in _ENV_FALSE:\n  3027\t        return False\n  3028\t    return bool(getattr(_runtime_snapshot(), name, default))\n  3029\t\n  3030\t\n  3031\tAGY_BRIDGE_STREAM_RESILIENCE_ENABLED = _new_flag(\n  3032\t    \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True\n  3033\t)\n  3034\t\n  3035\t\n  3036\tdef _positive_env(name: str) -> float | None:\n  3037\t    raw = os.environ.get(name, \"\").strip()\n  3038\t    if not raw:\n  3039\t        return None\n  3040\t    try:\n  3041\t        value = float(raw)\n  3042\t    except ValueError:\n  3043\t        return None\n 13315\t        )\n 13316\t        self.assertIn(b'\"error\"', b\"\".join(downstream))\n 13317\t\n 13318\t    def test_enabled_graceful_timeout_retains_single_length_final(self) -> None:\n 13319\t        with mock.patch.dict(os.environ, {\"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\": \"true\"}):\n 13320\t            _, body, frames, _ = self._stream(\n 13321\t                self._out(state=\"idle_timeout\", rc=124), ((\"text\", \"часть ответа\"),)\n 13322\t            )\n 13323\t        terminals = [\n 13324\t            choice[\"finish_reason\"]\n 13325\t            for frame in frames\n 13326\t            for choice in frame[\"choices\"]\n 13327\t            if choice[\"finish_reason\"]\n 13328\t        ]\n 13329\t        self.assertEqual(terminals, [\"length\"])\n 13330\t        self.assertEqual(body.count(\"data: [DONE]\"), 1)\n 13331\t        self.assertFalse(any(\"error\" in frame for frame in frames))\n 13332\t\n 13333\t    def test_flag_defaults_config_and_env_precedence(self) -> None:\n 13334\t        name = \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\"\n 13335\t        for raw, expected in (\n 13336\t            (\"\", False),\n 13337\t            (\"garbage\", False),\n 13338\t            (\"true\", True),\n 13339\t            (\"OFF\", False),\n 13340\t        ):\n 13341\t            with self.subTest(raw=raw), mock.patch.dict(os.environ, {name: raw}):\n 13342\t                snapshot = srv._parse_runtime_flags(\n 13343\t                    '{\"stream_resilience_enabled\":false}'\n 13344\t                )\n 13345\t                with mock.patch.object(srv, \"_runtime_snapshot\", return_value=snapshot):\n 13346\t                    self.assertIs(srv._new_flag(name, True), expected)\n 13347\t        with mock.patch.dict(os.environ, {name: \"\"}):\n 13348\t            snapshot = srv._parse_runtime_flags(\"{}\")\n 13349\t            with mock.patch.object(srv, \"_runtime_snapshot\", return_value=snapshot):\n 13350\t                self.assertTrue(srv._new_flag(name, True))\n 13351\t                self.assertFalse(srv._new_flag(\"emit_tool_trace\"))\n 13352\t\n 13353\t    def test_config_reload_keeps_lastgood_and_accepts_uppercase_alias(self) -> None:\n 13354\t        with _Fixture() as fx:\n 13355\t            fx.set_env(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", None)\n 13356\t            clock = _clocked(fx)\n 13357\t            flag = _bfn(\"_new_flag\")\n 13358\t            self.assertTrue(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13359\t            _write_cfg(fx, {\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\": False}, 1_000)\n 13360\t            clock.advance(2)\n 13361\t            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13362\t            _write_cfg(fx, '{\"stream_resilience_enabled\":\"false\"}', 2_000)\n 13363\t            clock.advance(2)\n 13364\t            self.assertFalse(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n 13365\t            _write_cfg(fx, {\"stream_resilience_enabled\": True}, 3_000)\n 13366\t            clock.advance(2)\n 13367\t            self.assertTrue(flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True))\n","exit_code":1,"status":"failed"}}
