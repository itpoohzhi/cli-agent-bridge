{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba bridges/agy-bridge/server.py | sed -n '2915,3075p;6915,7005p;7080,7170p'; nl -ba tests/test_agy_bridge_resilience.py | sed -n '3820,3860p;5370,5490p'\"","aggregated_output":"  2915\tdef _is_sqlite_reasoning_enabled() -> bool:\n  2916\t    \"\"\"Двухуровневый fail-closed выключатель SQLite-источника (REQ-011).\"\"\"\n  2917\t    return _sqlite_disabled_reason() == \"\"\n  2918\t\n  2919\t\n  2920\t# ---- Флаги новой политики (AD-005): локальный GigaRC-совместимый снимок -------------\n  2921\t# Stdlib-only LaunchAgent: ни SDK, ни удалённого транспорта. Старые флаги имеют\n  2922\t# кодовый False; stream resilience — True по брифу. Приоритет:\n  2923\t# env override > JSON из dynamic_config.json > кодовый default.\n  2924\t\n  2925\t\n  2926\tclass _RuntimeFlags(NamedTuple):\n  2927\t    \"\"\"Неизменяемый валидированный снимок флагов новой политики.\"\"\"\n  2928\t\n  2929\t    planner_content_streaming_enabled: bool = False\n  2930\t    emit_tool_trace: bool = False\n  2931\t    extended_timeout_enabled: bool = False\n  2932\t    graceful_timeout_on_partial: bool = False\n  2933\t    step_scoped_usage_enabled: bool = False\n  2934\t    stream_resilience_enabled: bool = True\n  2935\t    graceful_timeout_finish_reason: str = \"stop\"\n  2936\t\n  2937\t\n  2938\t_NEW_FLAG_ENV = {\n  2939\t    \"planner_content_streaming_enabled\": \"AGY_PLANNER_CONTENT_STREAMING_ENABLED\",\n  2940\t    \"emit_tool_trace\": \"AGY_BRIDGE_EMIT_TOOL_TRACE\",\n  2941\t    \"extended_timeout_enabled\": \"AGY_EXTENDED_TIMEOUT_ENABLED\",\n  2942\t    \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n  2943\t    \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n  2944\t    \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n  2945\t}\n  2946\t_ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n  2947\t_ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n  2948\t_COLD_FLAGS = _RuntimeFlags()\n  2949\t_cfg_lock = threading.Lock()\n  2950\t_cfg_snapshot: _RuntimeFlags = _COLD_FLAGS\n  2951\t_cfg_key: tuple[int, int] | None = None\n  2952\t_cfg_checked_at: float | None = None\n  2953\t_cfg_generation: int = 0\n  2954\t\n  2955\t\n  2956\tdef _parse_runtime_flags(text: str) -> _RuntimeFlags:\n  2957\t    \"\"\"Разобрать флаги; нестроковый finish_reason заменяется дефолтом 'stop'.\n  2958\t\n  2959\t    ValueError для не-bool флагов отвергает файл целиком.\n  2960\t    \"\"\"\n  2961\t    data = cast(object, json.loads(text))\n  2962\t    if not isinstance(data, dict):\n  2963\t        raise ValueError(\"dynamic_config: not an object\")\n  2964\t    raw = cast(\"dict[str, object]\", data)\n  2965\t    values: dict[str, bool] = {}\n  2966\t    finish_reason = _COLD_FLAGS.graceful_timeout_finish_reason\n  2967\t    for name in _RuntimeFlags._fields:\n  2968\t        default = getattr(_COLD_FLAGS, name)\n  2969\t        if name == \"stream_resilience_enabled\":\n  2970\t            default = raw.get(_NEW_FLAG_ENV[name], default)\n  2971\t        value = raw.get(name, default)\n  2972\t        if name == \"graceful_timeout_finish_reason\":\n  2973\t            finish_reason = value if isinstance(value, str) else \"stop\"\n  2974\t            continue\n  2975\t        if not isinstance(value, bool):\n  2976\t            raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n  2977\t        values[name] = value\n  2978\t    return _RuntimeFlags(**values, graceful_timeout_finish_reason=finish_reason)\n  2979\t\n  2980\t\n  2981\tdef _runtime_snapshot() -> _RuntimeFlags:\n  2982\t    \"\"\"Снимок флагов из dynamic_config.json: TTL 1.0 с, ключ версии (mtime_ns, size).\n  2983\t\n  2984\t    Пока stat не изменился, JSON не разбирается (identity снимка сохраняется). Битый\n  2985\t    JSON или не-bool флаг отвергают файл целиком: действует last-known-good,\n  2986\t    на холодном старте — кодовые дефолты. Нестроковый finish_reason заменяется\n  2987\t    на 'stop'. При отсутствии файла используются кодовые дефолты.\n  2988\t    \"\"\"\n  2989\t    global _cfg_snapshot, _cfg_key, _cfg_checked_at, _cfg_generation\n  2990\t    now = time.monotonic()\n  2991\t    with _cfg_lock:\n  2992\t        if _cfg_checked_at is not None and now - _cfg_checked_at < FLAG_TTL_S:\n  2993\t            return _cfg_snapshot\n  2994\t        known_key = _cfg_key\n  2995\t        snapshot = _cfg_snapshot\n  2996\t        gen = _cfg_generation\n  2997\t    key = known_key\n  2998\t    try:\n  2999\t        info = DYNAMIC_CONFIG_PATH.stat()\n  3000\t    except FileNotFoundError:\n  3001\t        snapshot, key = _COLD_FLAGS, None\n  3002\t    except OSError:\n  3003\t        pass  # транзиентная ошибка: остаётся last-known-good\n  3004\t    else:\n  3005\t        new_key = (info.st_mtime_ns, info.st_size)\n  3006\t        if new_key != known_key:\n  3007\t            try:\n  3008\t                parsed = _parse_runtime_flags(\n  3009\t                    DYNAMIC_CONFIG_PATH.read_text(encoding=\"utf-8\")\n  3010\t                )\n  3011\t            except OSError:\n  3012\t                pass  # повторим на следующем TTL\n  3013\t            except ValueError:\n  3014\t                key = (\n  3015\t                    new_key  # битый файл: lastgood, без повторного разбора того же stat\n  3016\t                )\n  3017\t            else:\n  3018\t                snapshot, key = parsed, new_key\n  3019\t    with _cfg_lock:\n  3020\t        if _cfg_generation != gen:\n  3021\t            # Параллельный читатель уже записал более свежий снимок: не затираем его.\n  3022\t            return _cfg_snapshot\n  3023\t        _cfg_snapshot = snapshot\n  3024\t        _cfg_key = key\n  3025\t        _cfg_checked_at = time.monotonic()\n  3026\t        _cfg_generation = gen + 1\n  3027\t    return snapshot\n  3028\t\n  3029\t\n  3030\tdef _new_flag(name: str, default: bool = False) -> bool:\n  3031\t    \"\"\"Явный env > JSON bool > кодовый default; старые флаги выключены.\"\"\"\n  3032\t    if name == \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\":\n  3033\t        name = \"stream_resilience_enabled\"\n  3034\t    env = os.environ.get(_NEW_FLAG_ENV[name], \"\").strip().lower()\n  3035\t    if env in _ENV_TRUE:\n  3036\t        return True\n  3037\t    if env in _ENV_FALSE:\n  3038\t        return False\n  3039\t    return bool(getattr(_runtime_snapshot(), name, default))\n  3040\t\n  3041\t\n  3042\tdef _graceful_finish_reason() -> str:\n  3043\t    \"\"\"Возвращает finish_reason graceful-таймаута: 'stop' или 'length'.\n  3044\t\n  3045\t    Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\n  3046\t    graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\n  3047\t    Значение 'max_tokens' нормализуется в 'length'.\n  3048\t    \"\"\"\n  3049\t    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", \"\").strip().lower()\n  3050\t    if raw_env in (\"length\", \"max_tokens\"):\n  3051\t        return \"length\"\n  3052\t    if raw_env == \"stop\":\n  3053\t        return \"stop\"\n  3054\t    snap = _runtime_snapshot()\n  3055\t    val = snap.graceful_timeout_finish_reason.strip().lower()\n  3056\t    if val in (\"length\", \"max_tokens\"):\n  3057\t        return \"length\"\n  3058\t    return \"stop\"\n  3059\t\n  3060\t\n  3061\tAGY_BRIDGE_STREAM_RESILIENCE_ENABLED = _new_flag(\n  3062\t    \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True\n  3063\t)\n  3064\t\n  3065\t\n  3066\tdef _positive_env(name: str) -> float | None:\n  3067\t    raw = os.environ.get(name, \"\").strip()\n  3068\t    if not raw:\n  3069\t        return None\n  3070\t    try:\n  3071\t        value = float(raw)\n  3072\t    except ValueError:\n  3073\t        return None\n  3074\t    if not value > 0.0 or value != value or value == float(\"inf\"):\n  3075\t        return None\n  6915\t            out: dict, content: str, reasoning: str, finish_reason: str\n  6916\t        ) -> dict:\n  6917\t            message = {\"role\": \"assistant\", \"content\": content}\n  6918\t            if reasoning:\n  6919\t                # OpenAI-совместимое поле мышления: Harness читает его из сообщения\n  6920\t                # ассистента так же, как из дельты потока.\n  6921\t                message[\"reasoning_content\"] = reasoning\n  6922\t            payload = {\n  6923\t                \"id\": f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\",\n  6924\t                \"object\": \"chat.completion\",\n  6925\t                \"created\": int(time.time()),\n  6926\t                \"model\": ctx[\"model\"],\n  6927\t                \"choices\": [\n  6928\t                    {\"index\": 0, \"message\": message, \"finish_reason\": finish_reason}\n  6929\t                ],\n  6930\t                \"usage\": self._usage_payload(\n  6931\t                    out.get(\"usage\") or {}, out.get(\"usage_resolved\")\n  6932\t                ),\n  6933\t            }\n  6934\t            if out.get(\"conversation_id\"):\n  6935\t                payload[\"conversation_id\"] = out[\"conversation_id\"]\n  6936\t            return payload\n  6937\t\n  6938\t        def finalize_timeout(out: dict) -> None:\n  6939\t            \"\"\"Graceful-финал: HTTP 200, настраиваемый finish_reason (дефолт stop).\n  6940\t\n  6941\t            Идемпотентно, до run.close().\n  6942\t            \"\"\"\n  6943\t            state = out.get(\"state\")\n  6944\t            if out.get(\"graceful_done\") or state not in (\"timeout\", \"idle_timeout\"):\n  6945\t                return\n  6946\t            if not _new_flag(\"graceful_timeout_on_partial\"):\n  6947\t                return\n  6948\t            # Остаток terminal drain + partial -> HTTP 200, finish_reason из настроек.\n  6949\t            retained_text, retained_reasoning = consume_retained(out)\n  6950\t            content = str(out.get(\"text\") or \"\")\n  6951\t            base_reasoning = str(out.get(\"reasoning\") or \"\")\n  6952\t            reasoning = base_reasoning + retained_reasoning + \"\".join(markers)\n  6953\t            if not (content.strip() or reasoning.strip() or retained_text.strip()):\n  6954\t                return  # полная тишина: прежняя ошибка 504\n  6955\t            content += retained_text\n  6956\t            content += self._graceful_notice(str(state), out.get(\"timeout_limit_s\"))\n  6957\t            self._arm_flush_window(ctx)\n  6958\t            out[\"graceful_done\"] = True\n  6959\t            _log(f\"graceful-timeout state={state} mode=json\")\n  6960\t            if not self._prepare_flush_write():\n  6961\t                return\n  6962\t            self._send(\n  6963\t                200, build_payload(out, content, reasoning, _graceful_finish_reason())\n  6964\t            )\n  6965\t\n  6966\t        ctx[\"finalize_timeout\"] = finalize_timeout\n  6967\t        out = self._run_once(ctx, lambda _v: True, on_tool_trace, lambda _r: True, None)\n  6968\t        if out.get(\"state\") == \"client_gone\":\n  6969\t            return\n  6970\t        if out.get(\"graceful_done\"):\n  6971\t            return\n  6972\t        finalize_timeout(out)  # страховка, если _run_once не вызвал hook\n  6973\t        if out.get(\"graceful_done\"):\n  6974\t            return\n  6975\t        retained_reasoning = retained_cache[0][1] if retained_cache else \"\"\n  6976\t        reasoning = str(out.get(\"reasoning\") or \"\") + retained_reasoning\n  6977\t        reasoning += \"\".join(markers)\n  6978\t        err = self._error_body(out, bool(ctx.get(\"stream_resilience_enabled\", True)))\n  6979\t        if err is not None:\n  6980\t            self._send(err[\"code\"], {\"error\": err})\n  6981\t            return\n  6982\t        self._send(\n  6983\t            200, build_payload(out, str(out.get(\"text\") or \"\"), reasoning, \"stop\")\n  6984\t        )\n  6985\t\n  6986\t    def _serve_sse(self, ctx: dict) -> None:\n  6987\t        self._reset_flush_window()\n  6988\t        try:\n  6989\t            self._serve_sse_body(ctx)\n  6990\t        finally:\n  6991\t            self._reset_flush_window()\n  6992\t\n  6993\t    def _serve_sse_body(self, ctx: dict) -> None:\n  6994\t        completion_id = f\"chatcmpl-agy-{uuid.uuid4().hex[:12]}\"\n  6995\t        created = int(time.time())\n  6996\t        shown_model = ctx[\"model\"]\n  6997\t        resilience = _new_flag(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True)\n  6998\t        ctx[\"stream_resilience_enabled\"] = resilience\n  6999\t        ctx[\"stream_committed\"] = False\n  7000\t        disconnected = False\n  7001\t\n  7002\t        def chunk(\n  7003\t            delta: dict,\n  7004\t            finish=None,\n  7005\t            usage: dict | None = None,\n  7080\t            if resilience:\n  7081\t                ctx[\"tool_activity\"] = True\n  7082\t            # Нативный инструмент agy исполняется внутри CLI и наружу не уходит как\n  7083\t            # tool_call. Безопасный маркер прогресса — только при emit_tool_trace;\n  7084\t            # выключенный флаг — полный no-op до любого форматирования строк.\n  7085\t            if not _new_flag(\"emit_tool_trace\"):\n  7086\t                return True\n  7087\t            marker = progress.marker(event, commit=False)\n  7088\t            if marker is None:\n  7089\t                return True\n  7090\t            ok = on_reasoning(marker)\n  7091\t            if ok:\n  7092\t                progress.commit()\n  7093\t            return ok\n  7094\t\n  7095\t        def keepalive() -> bool:\n  7096\t            if resilience and not ctx[\"stream_committed\"]:\n  7097\t                return not disconnected\n  7098\t            return emit(\": keepalive\\n\\n\")\n  7099\t\n  7100\t        def finalize_timeout(out: dict) -> None:\n  7101\t            \"\"\"Graceful-финал timeout/idle_timeout после полезной выдачи (идемпотентно).\n  7102\t\n  7103\t            Один arbiter-досыл, один notice, один настраиваемый finish_reason\n  7104\t            (по умолчанию \"stop\"), один\n  7105\t            [DONE] — всё в одном окне T_FINAL_FLUSH_S; ошибка записи прекращает записи.\n  7106\t            \"\"\"\n  7107\t            if out.get(\"graceful_done\") or out.get(\"state\") not in (\n  7108\t                \"timeout\",\n  7109\t                \"idle_timeout\",\n  7110\t            ):\n  7111\t                return\n  7112\t            if not _new_flag(\"graceful_timeout_on_partial\"):\n  7113\t                return\n  7114\t            retained = list(out.get(\"retained_events\") or [])\n  7115\t            retained_text = \"\".join(str(p) for k, p in retained if k == \"text\")\n  7116\t            if not (\n  7117\t                emitted_content[0] > 0\n  7118\t                or emitted_reasoning_or_tool[0] > 0\n  7119\t                or retained_text.strip()\n  7120\t            ):\n  7121\t                return  # полная тишина: прежняя ошибка 504\n  7122\t            self._arm_flush_window(ctx)\n  7123\t            ok = True\n  7124\t            for kind, payload in retained:\n  7125\t                if kind == \"text\":\n  7126\t                    ok = on_text(str(payload))\n  7127\t                elif kind == \"reasoning\":\n  7128\t                    ok = on_reasoning(str(payload))\n  7129\t                elif kind == \"tool_trace\":\n  7130\t                    ok = on_tool_trace(payload)\n  7131\t                if not ok:\n  7132\t                    break\n  7133\t            reason = str(out.get(\"state\"))\n  7134\t            conv_id = str(out.get(\"conversation_id\") or \"\")\n  7135\t            if ok:\n  7136\t                ok = commit() and emit(\n  7137\t                    chunk(\n  7138\t                        {\n  7139\t                            \"content\": self._graceful_notice(\n  7140\t                                reason, out.get(\"timeout_limit_s\")\n  7141\t                            )\n  7142\t                        }\n  7143\t                    )\n  7144\t                )\n  7145\t            if ok:\n  7146\t                ok = emit(chunk({}, _graceful_finish_reason(), conversation_id=conv_id))\n  7147\t            if ok:\n  7148\t                _ = emit(\"data: [DONE]\\n\\n\")\n  7149\t            out[\"graceful_done\"] = True\n  7150\t            _log(f\"graceful-timeout state={reason} mode=sse ok={int(bool(ok))}\")\n  7151\t\n  7152\t        ctx[\"finalize_timeout\"] = finalize_timeout\n  7153\t        if not resilience and not commit():\n  7154\t            return\n  7155\t        out = self._run_once(ctx, on_text, on_tool_trace, on_reasoning, keepalive)\n  7156\t        if disconnected or out.get(\"state\") == \"client_gone\":\n  7157\t            _log(\"client gone mid-stream, child killed\")\n  7158\t            return\n  7159\t        finalize_timeout(out)  # страховка, если _run_once не вызвал hook\n  7160\t        if out.get(\"graceful_done\"):\n  7161\t            return\n  7162\t        err = self._error_body(out, resilience)\n  7163\t        if resilience and err is not None and not ctx[\"stream_committed\"]:\n  7164\t            self._send(502, {\"error\": err})\n  7165\t            self.close_connection = True\n  7166\t            return\n  7167\t        if not commit():\n  7168\t            return\n  7169\t        if err is None:\n  7170\t            conv_id = str(out.get(\"conversation_id\") or \"\")\n  3820\t    \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n  3821\t}\n  3822\t_FLAG_NAMES = tuple(_FLAG_ENV)\n  3823\t_NOTICE_MARK = \"Превышен лимит времени хода agy\"\n  3824\t\n  3825\t\n  3826\tdef _clean_flags(fx: _Fixture) -> None:\n  3827\t    \"\"\"Старые флаги берутся из файла; legacy-оракулы выполняются без новой SSE-политики.\"\"\"\n  3828\t    fx.set_env(\"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", \"false\")\n  3829\t    fx.set_env(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", None)\n  3830\t    for env in _FLAG_ENV.values():\n  3831\t        fx.set_env(env, None)\n  3832\t    for env in (\"AGY_IDLE_TIMEOUT_S\", \"AGY_TIMEOUT_S\", \"AGY_BRIDGE_IDLE_TIMEOUT\"):\n  3833\t        fx.set_env(env, None)\n  3834\t\n  3835\t\n  3836\tdef _clocked(fx: _Fixture) -> _FakeClock:\n  3837\t    clock = _FakeClock()\n  3838\t    fx.patch(\"time\", _fake_time(clock))\n  3839\t    return clock\n  3840\t\n  3841\t\n  3842\tdef _write_cfg(fx: _Fixture, data: object, mtime_ns: int | None = None) -> None:\n  3843\t    text = data if isinstance(data, str) else json.dumps(data)\n  3844\t    _ = fx.config.write_text(_str(text), encoding=\"utf-8\")\n  3845\t    if mtime_ns is not None:\n  3846\t        os.utime(fx.config, ns=(mtime_ns, mtime_ns))\n  3847\t\n  3848\t\n  3849\tclass RuntimeConfigSnapshotTests(unittest.TestCase):\n  3850\t    \"\"\"AD-005: локальный GigaRC-совместимый снимок, env > JSON bool > False (VER-005).\"\"\"\n  3851\t\n  3852\t    def test_runtime_config_snapshot_defaults_false_without_file_or_keys(self) -> None:\n  3853\t        with _Fixture() as fx:\n  3854\t            _clean_flags(fx)\n  3855\t            clock = _clocked(fx)\n  3856\t            new_flag = _bfn(\"_new_flag\")\n  3857\t            for name in _FLAG_NAMES:\n  3858\t                self.assertIs(new_flag(name), False, name)\n  3859\t            _write_cfg(fx, {\"unrelated\": True}, 1_000_000_000)\n  3860\t            clock.advance(1.1)\n  5370\t        \"text\": \"\",\n  5371\t        \"reasoning\": \"\",\n  5372\t        \"usage\": {},\n  5373\t        \"result\": {},\n  5374\t        \"err\": \"x\",\n  5375\t        \"tool_calls\": [],\n  5376\t        \"tool_events\": 0,\n  5377\t        \"conversation_id\": _CID,\n  5378\t        \"timeout_limit_s\": limit,\n  5379\t    }\n  5380\t\n  5381\t\n  5382\tclass SilentGracefulTimeoutTests(unittest.TestCase):\n  5383\t    def _flags(self, fx: _Fixture, graceful: bool) -> None:\n  5384\t        _clean_flags(fx)\n  5385\t        fx.set_env(_FLAG_ENV[\"graceful_timeout_on_partial\"], \"1\" if graceful else \"0\")\n  5386\t        fx.set_env(_FLAG_ENV[\"emit_tool_trace\"], \"1\")\n  5387\t\n  5388\t    def _sse_case(\n  5389\t        self,\n  5390\t        state: str,\n  5391\t        kind: str,\n  5392\t        graceful: bool,\n  5393\t        *,\n  5394\t        finish_reason_env: str | None = None,\n  5395\t        config: dict[str, object] | None = None,\n  5396\t    ) -> tuple[list[object], dict[str, object]]:\n  5397\t        with _Fixture() as fx:\n  5398\t            self._flags(fx, graceful)\n  5399\t            fx.set_env(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", finish_reason_env)\n  5400\t            if config is not None:\n  5401\t                _write_cfg(fx, config)\n  5402\t            holder: dict[str, object] = {}\n  5403\t\n  5404\t            def run_once(\n  5405\t                ctx: Any, on_text: Any, on_tool: Any, on_r: Any, _k: object\n  5406\t            ) -> object:\n  5407\t                out = _timeout_out(state)\n  5408\t                _scenario(kind, on_text, on_tool, on_r, out)\n  5409\t                hook = ctx.get(\"finalize_timeout\")\n  5410\t                if hook is not None and out[\"state\"] in (\"timeout\", \"idle_timeout\"):\n  5411\t                    hook(out)\n  5412\t                holder[\"out\"] = out\n  5413\t                return out\n  5414\t\n  5415\t            _h, _s, wfile, _c = _sse_with(\n  5416\t                run_once, {\"model\": \"m\", \"t_req_start\": 5000.0}\n  5417\t            )\n  5418\t            return _frames_json(wfile.writes), _dict(holder[\"out\"])\n  5419\t\n  5420\t    def _assert_custom_finish_reason(\n  5421\t        self,\n  5422\t        expected: str,\n  5423\t        env: str | None,\n  5424\t        config_value: object,\n  5425\t    ) -> None:\n  5426\t        for state in (\"timeout\", \"idle_timeout\"):\n  5427\t            with self.subTest(state=state):\n  5428\t                frames, out = self._sse_case(\n  5429\t                    state,\n  5430\t                    \"content\",\n  5431\t                    True,\n  5432\t                    finish_reason_env=env,\n  5433\t                    config={\"graceful_timeout_finish_reason\": config_value},\n  5434\t                )\n  5435\t                terminals = [\n  5436\t                    _dict(choice)[\"finish_reason\"]\n  5437\t                    for frame in frames\n  5438\t                    if isinstance(frame, dict)\n  5439\t                    for choice in cast(\"list[object]\", frame.get(\"choices\", []))\n  5440\t                    if _dict(choice).get(\"finish_reason\") is not None\n  5441\t                ]\n  5442\t                self.assertEqual(terminals, [expected])\n  5443\t                self.assertEqual(frames[-1], \"[DONE]\")\n  5444\t                self.assertEqual(frames.count(\"[DONE]\"), 1)\n  5445\t                self.assertTrue(out.get(\"graceful_done\"))\n  5446\t                content = \"\".join(_content_of(frame) for frame in frames)\n  5447\t                self.assertIn(\"часть ответа\", content)\n  5448\t                self.assertEqual(content.count(_NOTICE_MARK), 1)\n  5449\t            with self.subTest(state=state, mode=\"json\"), _Fixture() as fx:\n  5450\t                self._flags(fx, True)\n  5451\t                fx.set_env(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", env)\n  5452\t                _write_cfg(fx, {\"graceful_timeout_finish_reason\": config_value})\n  5453\t                sent: list[tuple[int, dict[str, object]]] = []\n  5454\t                with _Sock() as sock:\n  5455\t                    handler = _make_handler(sock)\n  5456\t                    handler._run_once = lambda *_a: {\n  5457\t                        **_timeout_out(state),\n  5458\t                        \"text\": \"часть ответа\",\n  5459\t                    }\n  5460\t                    handler._send = lambda code, payload: sent.append((code, payload))\n  5461\t                    handler._serve_json({\"model\": \"m\"})\n  5462\t                self.assertEqual(len(sent), 1)\n  5463\t                self.assertEqual(sent[0][0], 200)\n  5464\t                choice = _dict(cast(\"list[object]\", sent[0][1][\"choices\"])[0])\n  5465\t                self.assertEqual(choice[\"finish_reason\"], expected)\n  5466\t                content = _str(_dict(choice[\"message\"])[\"content\"])\n  5467\t                self.assertIn(\"часть ответа\", content)\n  5468\t                self.assertEqual(content.count(_NOTICE_MARK), 1)\n  5469\t\n  5470\t    def test_silent_graceful_timeout_custom_finish_reason_env_length(self) -> None:\n  5471\t        for env in (\"length\", \"max_tokens\", \" LENGTH \"):\n  5472\t            with self.subTest(env=env):\n  5473\t                self._assert_custom_finish_reason(\"length\", env, \"stop\")\n  5474\t        self._assert_custom_finish_reason(\"stop\", \" STOP \", \"length\")\n  5475\t\n  5476\t    def test_silent_graceful_timeout_custom_finish_reason_dynamic_config(self) -> None:\n  5477\t        for value in (\"length\", \"max_tokens\", \" LENGTH \"):\n  5478\t            with self.subTest(value=value):\n  5479\t                self._assert_custom_finish_reason(\"length\", None, value)\n  5480\t\n  5481\t    def test_silent_graceful_timeout_invalid_env_falls_back_to_config_or_default(\n  5482\t        self,\n  5483\t    ) -> None:\n  5484\t        self._assert_custom_finish_reason(\"length\", \"invalid_foo\", \"length\")\n  5485\t        for value in (\"stop\", \"invalid_foo\", True, 42, None, [], {}):\n  5486\t            with self.subTest(value=value):\n  5487\t                self._assert_custom_finish_reason(\"stop\", \"invalid_foo\", value)\n  5488\t\n  5489\t    def test_silent_graceful_timeout_sse_matrix(self) -> None:\n  5490\t        for state in (\"timeout\", \"idle_timeout\"):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"Обновлённые правила приняты. Проверка парсинга подтвердила: новое строковое поле обрабатывается отдельно от bool-флагов, `stream_resilience_enabled` сохранён, JSON и SSE используют один хелпер. Завершаю сверку границ изменения и заявленного тестового покрытия.\n"}}
