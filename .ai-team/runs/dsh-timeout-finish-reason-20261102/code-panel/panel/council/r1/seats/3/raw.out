/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5725:    def test_silent_graceful_timeout_run_once_finalizes_before_close_and_never_retries(\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5776:    def test_silent_graceful_timeout_execute_drains_retained_text_before_returning(\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5785:                        _FLAG_ENV[\"graceful_timeout_on_partial\"],\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5847:    def test_silent_graceful_timeout_end_to_end_real_run_both_states_sse(self) -> None:\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5872:    def test_silent_graceful_timeout_end_to_end_real_run_json_and_silent_504(\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5891:            for name in (\"extended_timeout_enabled\", \"graceful_timeout_on_partial\"):\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:5930:        fx.set_env(_FLAG_ENV[\"graceful_timeout_on_partial\"], \"1\")\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:6202:            fx.set_env(_FLAG_ENV[\"graceful_timeout_on_partial\"], \"1\")\n/Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py:6266:            newer = flags(graceful_timeout_on_partial=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"[гейт оркестрации: активен | роль: reviewer / ВИЗИОНЕР]\n\nКанон `~/Мой диск/Context/AGENTS.md` получен до маркера конца; проектный `~/work/src/cli-agent-bridge/AGENTS.md` прочитан, `.agents/AGENTS.md` и `CLAUDE.md` отсутствуют. Применяю `teamlead-gate` в роли независимого судьи. Проверка ограничена двумя целевыми файлами и архитектурным пакетом; чужие изменения не рассматриваю.\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; cat '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-timeout-finish-reason-20261102/architecture/architecture-packet.md'; git -C '/Users/aazhiry1/work/src/cli-agent-bridge' diff -- bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat '/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/SKILL.md'; cat '/Users/aazhiry1/work/src/cli-agent-bridge/.ai-team/runs/dsh-timeout-finish-reason-20261102/architecture/architecture-packet.md'; git -C '/Users/aazhiry1/work/src/cli-agent-bridge' diff -- bridges/agy-bridge/server.py tests/test_agy_bridge_resilience.py\"","aggregated_output":"---\nname: teamlead-gate\ndescription: >-\n  Ведёт полный цикл разработки с приёмкой кода советом тимлидов: dev-цикл,\n  clean-room L1/L2/L3, панель судей (universal-panel, mode=code) до ACCEPT\n  или возврата Coder через panel-rework-summarizer (потолок 3 цикла).\n  Триггеры: «запускай разработку по скилу техлид» (default), «… техлид\n  фаст» (fast), «… техлид квалити» (quality), «тимлид-гейт», «teamlead\n  gate», «судьи совета разошлись», «пусть тимлиды договорятся». Не для\n  мелких правок.\n---\n\n# teamlead-gate — разработка с приёмкой кода советом тимлидов\n\nПрочитай `references/council.md`, когда запускаешь Шаг 4; прочитай `references/council-consensus.md`, когда после `R1` есть спор или повторный раунд; прочитай `references/coder-brief.md`, когда собираешь бриф Coder. Здесь — маршрут шагов 0–6, инварианты, стопы и DoD.\n\nНезависимые Read/Grep/ls, Edit/Write разных файлов, cp/diff/wc — одним сообщением, списком заранее (`~/Мой диск/skils/panel-backends/references/parallelism-params.md` §1).\n\n## Вопросы владельцу (аналитик / архитектор / координатор)\n\nКанон БЛОКЕР/МОЖНО ПРОДОЛЖИТЬ, «падение транспорта — не БЛОКЕР» — прочитай `references/report-vpn-formats.md` § 1, когда формулируешь вопрос владельцу.\n\n## ⭐ КРИТИЧЕСКИЙ ИНВАРИАНТ: ЗАМКНУТЫЙ ЦИКЛ ДО ACCEPT (LOOP UNTIL ACCEPT)\n\n**Замечания Совета Тимлидов исправляются СТРОГО ПО КРУГУ ДО ВЕРДИКТА ACCEPT.**\n\n1. Никакой сдачи по самоотчёту кодера: «код написан, тесты зелёные» не приёмка. Только повторный Совет вправе признать замечания закрытыми.\n2. После любых исправлений Coder оркестратор обязан повторно отправить реальный `git diff` на Совет (universal-panel, `mode=code`).\n3. Цикл: Совет (NEEDS WORK) → Coder → повторный Совет → … → ACCEPT. Потолок — 3 тимлид-цикла; сброс в `REJECT` на 2-м цикле запрещён.\n4. MR на remote до `ACCEPT` категорически запрещён. Coder работает только в локальной ветке; MR открывает оркестратор строго после ACCEPT.\n5. Фальш-старт MR цикл не останавливает: совет доводится до официального `ACCEPT`.\n6. Завершить ход после правок Coder без повторного Совета и `ACCEPT` — срыв регламента.\n\n## ⭐ ИНВАРИАНТ: ВСЕ ЗАМЕЧАНИЯ БАТЧЕМ И СОГЛАСОВАННОЕ РЕШЕНИЕ СОВЕТА\n\nКаждый судья за один проход выдаёт все замечания сразу (поштучная выдача — malformed). Итог спорных находок — согласованный леджер; оркестратор только копирует дословно и считает статусы. Summarizer — один бриф на весь леджер, без «топ-N» (прочитай `references/council.md` §3, когда проверяешь полноту и `late_miss`/`r2_late`).\n\n## Scope Fencing и circuit-breaker лимиты\n\n- **Scope Fencing:** дефект, существовавший до текущего diff и находящийся вне текущего diff, классифицируется как `[pre-existing]`, помечается non-blocking и не блокирует сдачу; сдача в этом случае — `ACCEPT_WITH_OBSERVATIONS`. Дефекты, внесённые текущим diff, блокируют сдачу как прежде.\n- **Лимит циклов:** потолок — 3 тимлид-цикла; превышение — эскалация владельцу, обход только по прямому указанию владельца (`--owner-override` в `launch_seat.py`).\n- **Лимит раундов:** исторический circuit-breaker «≤ 10 раундов» (`CIRCUIT_BREAKER_TRIGGERED`, обход только `--owner-override`) действующей нормой дебатов не является: FSM раннера жёстче — `R1 + D1 + [D2] + C1`, не более 4 раундов, `D3` запрещён (Шаг 4).\n- **Лимит брифа:** ≤ 120 KiB (122880 байт); превышение — `OVERSIZED_BRIEF`, обход только `--owner-override`.\n\n## Какой пакет включать\n\nДо Шага 0 выбери сетап из фразы (`default`; «… техлид фаст» → `fast`; «… техлид квалити» → `quality`) и запиши `setup` в `route-manifest.json`. Прочитай `references/routing-gates.md`, когда резолвишь модели до Шага 0. Нерушимое: вызов вне белого списка сетапа → `INVALID_MODEL`; пул исчерпан → `QUORUM_UNAVAILABLE`, подстановка запрещена; панель на `acp-agents` не подменять; **panel-rework-summarizer при `NEEDS WORK`/`RED FLAG` — всегда** (изолированно, слот по `~/Мой диск/Context/models.md`), координатору переводить замечания запрещено, без валидного выхода возврат Coder запрещён.\n\nСкилл-обёртка: dev-цикл — `orchestrate-coder-reviewer-summarizer` целиком; совет — `universal-panel`, `mode=code`, слоты по `~/Мой диск/Context/models.md`. Агент пул не выбирает.\n\n## MUST: бриф Coder (невалидный — не запускать)\n\nВ бриф — **ровно один** путь `~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/skills/<тип>.md` (`feature`|`bugfix`|`refactoring`|`hotfix`|`rework`; Architect — `architecture.md`; Reviewer/MR — `code-review.md`/`mr.md`). Без строки бриф невалиден. При возврате с `NEEDS WORK` (Cycle ≥ 2) тип меняется на `rework`. Прочитай `references/coder-brief.md`, когда собираешь обязательные блоки брифа (AC-оракулы, self-check с сырым выводом, анти-примеры, резюме, валидатор полей без LLM, специфика rework).\n\n## Пайплайн\n\n```text\ntask envelope → VERIFICATION SURFACE (oracle+baseline до Coder)\n → DEV-ЦИКЛ (Coder→CODE_GATE→Verifier; Reviewer пропущен) → READY_FOR_PR\n → CLEAN-ROOM (точный diff + 100% матрицы + sensitivity) → EVIDENCE опечатан\n → ПАКЕТ ПРИЁМКИ → СОВЕТ: R1 → (3/3 PASS, OPEN_BLOCKING=0, нет открытых CONFLICT → выход) | RECHECK → леджер → D1 → [D2 по спорным блокерам] → C1 (всегда настоящий раунд) → final-panel-verdict.md\n      ├─ PASS → ACCEPT → L3 → MR человеку\n      ├─ NEEDS WORK → panel-rework-summarizer → новый dev-цикл (rework)\n      └─ RED FLAG → тот же круг, кроме требования сменить ТЗ/архитектуру\n```\n\nЛимит: **до ACCEPT, потолок 3 тимлид-цикла**; повтор по тем же пунктам в REJECT не сбрасывает.\n\n## Шаг 0. Безусловная изоляция в песочницу `$WORK` с временным Git и Verification surface до Coder\n\nДо снятия `verification-surface.json` и запуска Coder сессия изолируется во временный каталог `$WORK = ~/tmp/<project-slug>/<branch-slug>--<session-id>/` с собственным Git по скиллу `~/Мой диск/skils/parallel-clones/SKILL.md` (включая проекты без Git в `<дом>`, где в `$WORK` выполняется `git init -q -b main`). Файлы `.env*` копируются в `$WORK` для прогона тестов L1/L2/L3 и **строго до базового коммита `BASE_COMMIT`** скрываются от Git через `$WORK/.git/info/exclude` (`git rm --cached -r -f --ignore-unmatch '.env*' '*/.env*' && test -z \"$(git ls-files '.env*' '*/.env*')\" || exit 1`), а рабочая ветка именуется `<type>/<JIRA-KEY>-<short-description>` (или `<type>/LOCAL-<short-description>` без Jira). Сразу после получения `ACCEPT` Совета (`verify_panel_proof.py` `exit=0`) изменения доставляются из `$WORK` в `<дом>` через **3-Way Git Merge в `$WORK`** (`source-current` от `BASE_COMMIT` -> `git merge source-current` -> разрешение конфликтов в `$WORK` -> обязательный повтор тестов после любого слияния (как с конфликтами, так и без конфликтов) -> атомарный перенос в `<дом>` без `.git`, плюс push/MR при наличии `origin`), после чего временная песочница **безусловно удаляется** (проверка доставки -> `rm -rf \"$WORK\"` -> `test ! -e \"$WORK\"` -> снятие `.ai-team/merge.lock` -> статус `removed` в `$RUN/created.tsv`).\n\nПрочитай `references/verification-integrity.md` целиком один раз здесь и выполни его раздел 1 (Шаг 2 исполняет разделы 2–8 по уже прочитанному). До Coder создай `verification-surface.json` (хеши oracle, CI/config/lock, baseline, jobs). Oracle меняет только read-only QA/verifier, не Coder. Нет слепка — `BLOCKED`.\n\n## Шаг 1. Dev-цикл\n\n**NFFC:** рабочие роли сначала нативно через `:9882`; приоритет над legacy CLI-шаблонами —\n`~/Мой диск/skils/panel-backends/references/model-invocation.md` §0 (Native-First & Fail-Closed).\nМеста Совета остаются только на `launch_seat.py` с `verify_panel_proof.py`; NFFC их не заменяет.\n\nВыполни `orchestrate-coder-reviewer-summarizer` до `READY_FOR_PR`: Reviewer пропущен (`downstream_panel=true`, `parent_skill=teamlead-gate`, `critical=false`/`final_gate_council=false`); максимум 2 итерации Coder↔CODE_GATE внутри цикла. Модели ролей — из выбранного сетапа по `~/Мой диск/Context/models.md`; Summarizer dev-пула внутри цикла не вызывать. Не дошёл до `READY_FOR_PR` — совет не запускать, эскалация человеку.\n\nПока идут Architect/Coder, готовь независимые от diff входы: прочитай `references/prepare-in-parallel.md`, когда стартует Шаг 1. Параллельные кодеры: прочитай `references/parallel-coders.md`, когда разделяешь работу на зоны (зона = Coder = worktree/клон, locks, merge-арбитраж).\n\n## Шаг 2. Независимый clean-room прогон (гейт)\n\nВыполни разделы 2–8 `references/verification-integrity.md`. Логи Coder/Reviewer/CI — заявления, не доказательство; evidence — только реальный запуск точного candidate в свежем temp-worktree/контейнере. Матрица 100%, L2 один раз на SHA+fingerprint, любая правка → новый SHA → L2 заново; `echo`/dry-run/collect-only/старый лог/targeted-subset вместо L2 — не выполнение. Пробел = пакет совета `BLOCKED`.\n\n## Шаг 3. Пакет приёмки\n\nСобери `.ai-team/runs/<run-id>/teamlead/package.md` только из первичных артефактов, без пересказа (task envelope, candidate manifest + полный diff с SHA256, `coder.json`, `execution-evidence.md` с сырым логом L2, surface/environment/traceability/manifest; `PR_DESCRIPTION.md` не класть). Прочитай `references/acceptance-package.md`, когда собираешь пакет и передаёшь его CLI-судьям (тихая обрезка = `BLOCKED_BRIEF`).\n\n## Шаг 4. Совет тимлидов\n\nПрочитай `references/council-gates.md`, когда запускаешь совет; прочитай `references/council.md`, когда собираешь раунд; прочитай `references/council-consensus.md`, когда после `R1` нужен леджер, дебаты или проверка выхода по единому инварианту. Нерушимое:\n\n- `mode.txt` = `code`; ровно 3 судьи из пула сетапа; предпочтительно majority 2/3 разных семейств (`QUORUM_FULL`). При недоборе 3 семейств действует каскад деградации под разными шляпами `QUORUM_DEGRADED_HATS` (разрешается брать любую доступную модель роли, в т.ч. одну модель трижды под разными ролевыми шляпами Скептик, Реалист, Визионер в изолированных вызовах); раунда из 2 судей и ACCEPT на двоих нет; вердикт выносится большинством 2/3 ролевых шляп; только при отсутствии хотя бы одной рабочей модели роли — `QUORUM_UNAVAILABLE`, раунд не стартует.\n- Backend gate: 4-й судья/процесс/голос, «опрос всех доступных», суд в родительской сессии, подмена нативным сабагентом/`acp-agents`, незаписанный fallback → FAIL раунда с откатом.\n- Каждый судья обеих панелей (`arch` и `code`) стартует только с одобренным brief-review своего места (fail-closed, `BLOCKED_BRIEF`); гейт `shasum == approved.sha256`.\n- Внутренний ШАГ 6 universal-panel не крутить.\n\n### Выход после `R1` — единый инвариант (`consensus-debate.md`)\n\nНормативное ядро — `~/Мой диск/skils/panel-backends/references/consensus-debate.md`, разделы «Единый инвариант выхода после R1 и RECHECK» и «Единый согласованный документ судейства (final-panel-verdict.md, разделы А–Г) и именные профили контуров»; здесь правила не дублируются. `panel-proof.json` (`verify_panel_proof.py`, `exit=0`) обязателен на каждом раунде; жеребьёвка и состав — по `~/Мой диск/Context/models.md`.\n\n- **Выход сразу после слепого `R1`** — только при `3/3 PASS`/`ACCEPT`, `OPEN_BLOCKING = 0` и отсутствии открытых `CONFLICT` (буквальное требование `CONFLICT=0` как цель агрегации отменено: конфликт формализуется статусами леджера, `council-consensus.md` §12); неблокирующие заметки идут в раздел Г `final-panel-verdict.md` без `D1`.\n- **Во всех остальных случаях** (`OPEN_BLOCKING > 0`, `CONFLICT > 0`, `< 3/3 PASS`, включая `0/3 PASS`, `≥2 RED FLAG`, `1 RED FLAG` + `1 NEEDS WORK`, `2/3 PASS` при `OPEN_BLOCKING > 0`) обязателен маршрут `R1` → `RECHECK` (`recheck-r1.md`) → `consensus-ledger.md` → `D1` → [`D2`] → `C1` → `final-panel-verdict.md` (А–Г) [+ `panel-rework-brief.json` при `NEEDS WORK`/`RED FLAG`]. Пропуск `RECHECK` и `D1` при `0/3 PASS` или `≥2 RED FLAG`, передача сырых недебатированных голосов в `panel-rework-summarizer`/Coder запрещены. Потолок D-раундов во всех сетапах: `D1` плюс один `D2` только по спорным `OPEN`-блокерам; `D3` запрещён. Досрочный выход при `OPEN = 0` пропускает только `D2`, но не `C1`: на пути дебатов `C1` всегда запускается настоящим раундом фиксации согласия; открытый `CONFLICT` на потолке — `PAUSED_OWNER` / `OWNER_PENDING`, `panel-rework-brief.json` не выпускается.\n- **После каждого прохода** (`ACCEPT`/`PASS` и `NEEDS WORK`/`RED FLAG`) выпускается `final-panel-verdict.md` (А–Г) и выводится владельцу в чат первым блоком; раздел В (`excluded_findings`) — закрытый набор для следующего прохода.\n\nИсполнитель дебатов — раннер: `python3 -I scripts/run_consensus_council.py --run-dir <RUN> --artifact-path <FILE> --setup <default|fast|quality> --stage council [--resume]`. Раннер сам вызывает `select_round_seats.py` (для `r>=2` — только с `--prior-ledger` на неизменяемый снимок леджера прошлого раунда; бриф несёт `PRIOR-LEDGER-SHA256`), запускает три `launch_seat.py` веером (все стартуют до завершения любого), извлекает `verdict.md` из `raw.out` экстрактором верификатора и заново запускает `verify_panel_proof.py` на каждый раунд; ручная сборка консенсуса вместо раннера запрещена. Коды выхода: 0 — агрегация, 1 — fail closed (подделка nonce/семейств/снятие `BLOCKER-SAFETY`/ack), 3 — `BLOCKED: QUORUM_UNAVAILABLE`, 4 — `ESCALATED`/`PAUSED_OWNER`. `PAUSED_OWNER` селектора (повтор троицы семейств при пуле 3of3, exit 3 селектора с готовым манифестом) раннер под кворум не маскирует: стоп до явного `--owner-ack-reason <TEXT>` вызывающего; сам ack записывает `select_round_seats.py --owner-ack`, раннер его не подделывает, после ack — `--resume`.\n\n### Точечная замена упавшего места (`--replace-failed-seat`)\n\nЕсли 1 из 3 мест завершилось техническим отказом транспорта, `quota_window`, `HUNG` или `malformed` (нет `COVERAGE`/`FINDINGS_COMPLETE`), 2 валидных голоса сохраняются и не перезапускаются. Заменяется только упавшее место через `launch_seat.py` (`--replace-failed-seat`, резервный слот пула по `models.md` п. 1.4/1.8). Потолок — **не более 2 технических замен мест на раунд**; далее штатный добор «пул N/3» по п. 1.8 или `QUORUM_UNAVAILABLE`.\n\n### Brief-review: `full` на `R1`, `delta_prelint` на повторных раундах\n\nНа `R1` каждого нового `artifact_hash`/цикла все 3 места проходят параллельный brief-review `run_kind: \"full\"` на 3 разных слотах пула Brief-review без возвращения. На `D<k>`, `C1` и при `--replace-failed-seat` в том же цикле и том же `artifact_hash` (у `R1` уже `APPROVE`, `sources.sha256` и общее тело чек-листа неизменны, добавлены только дословные обёртки D9) применяется детерминированный `run_kind: \"delta_prelint\"` (brief-review D9, 0 вызовов LLM).\n\n## Гейт PANEL-PROOF (Proof-of-Launch v1)\n\nКаждый судья запускается строго через `launch_seat.py`; самооценка оркестратора и субагенты сессии как судьи запрещены. Перед `ACCEPT` и MR обязателен `verify_panel_proof.py` (`exit=0`) с `panel-proof.json` (`pol-receipt/1`) `PASS`; без него — `BLOCKED: PANEL_PROOF_MISSING`. В отчёт: `PANEL PROOF: <путь panel-proof.json> sha256=<hex> verify_panel_proof exit=0`. Прочитай `references/panel-proof-gate.md`, когда проверяешь раунд.\n\n## Шаг 5. Разбор вердикта\n\nПрочитай `references/council.md` §2 и `references/council-gates.md`, когда разбираешь вердикт.\n\n- **PASS → ACCEPT:** только при валидном `panel-proof.json` PASS (`verify_panel_proof.py` `exit=0`) и строке `PANEL PROOF: …` в отчёте. PASS не перекрывает красный execution-gate. До MR — L3 (FAIL → Coder `rework` → L1 → L2 → повторная панель); MR-гейт L3: PASS | PASS_WITH_PREEXISTING | N/A. `direct_invocation: true` — Summarizer пишет `PR_DESCRIPTION.md` и отчёт; `false` — кратко координатор/one-shot.\n- **NEEDS WORK → panel-rework-summarizer → Coder:** слот по `~/Мой диск/Context/models.md` (не DeepSeek); вход — согласованный леджер (после `RECHECK` и дебатов) и `final-panel-verdict.md` (А–Г), покрытие 100% F-NNN, в instructions только согласованные blocking; при открытом `CONFLICT` — `PAUSED_OWNER`, summarizer не вызывается и `panel-rework-brief.json` не выпускается; Coder — только после PASS проверки контракта brief; повторный совет — diff-scope.\n- **RED FLAG → тот же круг**, кроме требования сменить ТЗ/архитектуру (решение человека).\n\n## Стоп-условия (поверх стопов обоих скиллов)\n\nПрочитай `references/council-gates.md` § «Стоп-условия (полный перечень)», когда проверяешь право на ACCEPT. Кратко: 3 цикла без ACCEPT → честный отчёт, продолжение только по решению владельца; нет `panel-proof.json` PASS → `BLOCKED`, ACCEPT/MR запрещены; нет read-back `processes.tsv` или cleanup через `pkill`/`killall` → `BLOCKED`; обязательный `FAIL`/`NOT_RUN`/`STALE` в матрице → `BLOCKED` даже при PASS совета (`DEFERRED_L3` до ACCEPT — не блокер); diff меняет согласованный контракт без envelope или несёт чужие KEY → не ACCEPT.\n\n## Корп-VPN упал — не стоп, поднять\n\nУпавший корп-VPN и timeout до корп-хоста — не `BLOCKED`: поднять и повторить. Прочитай `references/report-vpn-formats.md` § 2, когда корп-хост недоступен.\n\n## Границы\n\nСовет оценивает пригодность к merge; продукт глазами пользователя — `acceptance-gate` после ACCEPT. В `main`/`dev` не коммитить; merge — человек, кроме «кати» (PASS → ACCEPT → MR → CI 100% → merge с read-back). Каждый spawn — в `trace/index.json`.\n\n## Отчёт заказчику (формат)\n\nПрочитай `references/report-vpn-formats.md` § 3, когда пишешь отчёт; блок «Как совет договорился» — `references/council-consensus.md` § 11.\n\n## DoD сдачи\n\n- [ ] Цикл закрыт вердиктом `ACCEPT` повторного Совета, не самоотчётом Coder; MR открыт только после ACCEPT.\n- [ ] Каждый судья обеих панелей запущен строго через `launch_seat.py` и подтверждён `verify_panel_proof.py` (`panel-proof.json` PASS, `exit=0`); строка `PANEL PROOF: …` в отчёте.\n- [ ] Выход после `R1` — только по единому инварианту `consensus-debate.md`; `--replace-failed-seat` (≤2 на раунд) и `run_kind` brief-review (`full` на `R1`, `delta_prelint` на повторных) применены по правилам Шага 4; `final-panel-verdict.md` (А–Г) выпущен после прохода и показан владельцу первым блоком.\n- [ ] Дебаты исполнены раннером `scripts/run_consensus_council.py` (FSM `R1 → RECHECK → D1 → [D2] → C1 → AGGREGATE`, чекпоинты и `--resume`); первичный `consensus/consensus-ledger.json` (`pol-consensus/1.0`) записан, `BLOCKER-SAFETY` не снят большинством/переклассификацией, кворум 2/3 посчитан по независимым семействам, производные Markdown совпадают с JSON.\n- [ ] Clean-room evidence опечатан, матрица без обязательных `FAIL`/`NOT_RUN`/`STALE`, L3-гейт до MR закрыт.\n\n## Неснимаемые стоп-коды: `HL-ENV-01`, `C-MULT-I1..I5`, `S-HERD-I1..I5`, `H-CPU-I1..I5`, `R-BULK-I1..I5`\n\nПеред `ACCEPT` каждый судья проверяет все 21 стоп-код и самостоятельно пересчитывает численные инварианты. Прочитай `references/council-gates.md` § «Неснимаемые стоп-коды HL (полный текст)», когда проверяешь high-load кандидат: нарушение или отсутствие детерминированного теста — безусловный `BLOCKER` (`NEEDS WORK`), в техдолг не списывается.\n\n## Remote-first контракт репозитория\n\nМеняешь Git-репозиторий — прочитай и выполни `references/remote-mr-workflow.md`, когда готовишь сдачу: сначала merge MR на remote, затем fast-forward локальной target-ветки.\n\n## Связанные скиллы\n\n`orchestrate-coder-reviewer-summarizer` — dev-цикл; `universal-panel` — механика совета; `acceptance-gate` — следующий слой. Прочитай `references/routing-gates.md` § «Связанные скиллы», когда резолвишь слоты и смежные каноны.\n# Architecture Packet: dsh-timeout-finish-reason-20261102 (Revision r2)\n\n- **Run ID:** `dsh-timeout-finish-reason-20261102`\n- **Preset:** `analyst-teamlead`\n- **Stage:** Architecture (Revision r2 after Council R1 feedback F-001, F-002, F-003)\n- **Date:** 2026-11-02\n- **Status:** PROPOSED\n\n---\n\n## 1. Problem Statement & Context\nПри длительных операциях агентов в среде DeepSeek Harness (DSH), работающих через мост `bridges/agy-bridge`, срабатывание 1-часового таймаута хода (`AGY_TIMEOUT_S=3600.0`) перехватывается механизмом `graceful_timeout_on_partial`.\nЧтобы не разрывать HTTP/SSE соединение ошибкой 504, мост сохраняет частичный вывод и закрывает стрим с захардкоженным значением `finish_reason=\"length\"`.\n\nКлиент DeepSeek Harness (компонент `TurnMaxTokensItem` в `app.asar`) жестко интерпретирует `finish_reason=\"length\"` как событие `turn/end` с причиной `reason.kind=\"max-tokens\"` и отображает пользователю вводящий в заблуждение баннер:\n> *\"Output token limit reached The reply was cut off; earlier output is preserved in the conversation. Send \"continue\" to let the model resume.\"*\n\nПри этом физический лимит токенов генерации (65536) не был исчерпан (было сгенерировано <15k токенов).\n\n---\n\n## 2. Architecture Drivers & Principles\n- **AD-1 (Универсальность и независимость от вендоров):** Решение реализуется строго на слое моста `cli-agent-bridge` / `agy-bridge` без эвристик по `User-Agent` и без модификации бинарников DSH.\n- **AD-2 (Zero-Hardcode / Полная конфигурируемость):** Значение `finish_reason` при graceful-таймауте настраивается через переменную окружения `AGY_GRACEFUL_TIMEOUT_FINISH_REASON` и поле `graceful_timeout_finish_reason` в `dynamic_config.json`.\n- **AD-3 (Безопасный дефолт):** По умолчанию возвращается `finish_reason=\"stop\"`, что полностью исключает ложный алерт в DSH при сохранении диагностического префикса `[⚠️ Превышен лимит времени хода agy...]` в тексте.\n- **AD-4 (Обратная совместимость):** Полная возможность вернуть `\"length\"` установкой `AGY_GRACEFUL_TIMEOUT_FINISH_REASON=length`.\n\n---\n\n## 3. Technical Design (Устранение F-001 и F-003)\n\n### 3.1. Интеграция в `_RuntimeFlags` и stat-кэш `_runtime_snapshot()`\nВместо вызова несуществующей функции `_read_dynamic_config()` (замечание F-001), новый параметр интегрируется напрямую в существующую подсистему `_RuntimeFlags` ([server.py:2897-2970](file:///Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py#L2897-L2970)), использующую stat-кэш `(st_mtime_ns, size)` с TTL 1.0 с:\n\n1. В `_RuntimeFlags`:\n   ```python\n   class _RuntimeFlags(NamedTuple):\n       planner_content_streaming_enabled: bool = False\n       emit_tool_trace: bool = False\n       extended_timeout_enabled: bool = False\n       graceful_timeout_on_partial: bool = False\n       step_scoped_usage_enabled: bool = False\n       graceful_timeout_finish_reason: str = \"stop\"\n   ```\n2. В `_parse_runtime_flags(text)`:\n   Для поля `graceful_timeout_finish_reason` проверяется строковый тип (`isinstance(value, str)`), для остальных — boolean.\n3. Хелпер `_graceful_finish_reason()`:\n   ```python\n   def _graceful_finish_reason() -> str:\n       \"\"\"Возвращает finish_reason для graceful-завершения таймаута ('stop' или 'length').\n       \n       Приоритет:\n         1. Валидный env AGY_GRACEFUL_TIMEOUT_FINISH_REASON ('stop', 'length', 'max_tokens').\n         2. dynamic_config.json поле graceful_timeout_finish_reason.\n         3. Дефолт: 'stop'.\n       \"\"\"\n       raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", \"\").strip().lower()\n       if raw_env in (\"length\", \"max_tokens\"):\n           return \"length\"\n       if raw_env == \"stop\":\n           return \"stop\"\n       # F-003: если env не задан или содержит нераспознанное значение, читаем dynamic_config.json\n       snap = _runtime_snapshot()\n       val = snap.graceful_timeout_finish_reason.strip().lower()\n       if val in (\"length\", \"max_tokens\"):\n           return \"length\"\n       return \"stop\"\n   ```\n\n### 3.2. Точки вызова в `bridges/agy-bridge/server.py`\n1. **JSON-режим ([server.py:6868](file:///Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py#L6868)):**\n   ```python\n   self._send(200, build_payload(out, content, reasoning, _graceful_finish_reason()))\n   ```\n2. **SSE-режим ([server.py:7015](file:///Users/aazhiry1/work/src/cli-agent-bridge/bridges/agy-bridge/server.py#L7015)):**\n   ```python\n   ok = self._emit(chunk({}, _graceful_finish_reason(), conversation_id=conv_id))\n   ```\n\n### 3.3. Документирование и docstrings (Устранение F-003)\nОбновляются комментарии и описания в `bridges/agy-bridge/server.py`:\n- Строки 60-61: обновлено описание политики graceful timeout (по умолчанию `finish_reason=\"stop\"`, настраиваемо).\n- Строки 6848, 6854, 6973: замена устаревших упоминаний фиксированного `\"length\"` на параметризованный `finish_reason`.\n\n---\n\n## 4. Analysis of Blocker Classes\n1. **Границы и API-контракты:** Значение `\"stop\"` полностью валидно по спецификации OpenAI API и предотвращает ложную реакцию DSH `max-tokens`.\n2. **Безопасность:** Отсутствуют риски `NameError` благодаря опоре на валидированный `_RuntimeFlags`.\n3. **Целостность данных:** Все накопленные текстовые и reasoning данные сохраняются без потерь.\n4. **Обратная совместимость:** Поддерживается возврат на `\"length\"` через `AGY_GRACEFUL_TIMEOUT_FINISH_REASON=length`.\n5. **Ресурсный конверт:** $O(1)$ накладных расходов благодаря stat-кэшированию `_runtime_snapshot`.\n6. **Асимптотика hot-path:** N/A (cold-path).\n\n---\n\n## 5. Verification Plan (Устранение F-002)\nВ `tests/test_agy_bridge_resilience.py`:\n1. В `_clean_flags(self)` ([server.py:3823-3829](file:///Users/aazhiry1/work/src/cli-agent-bridge/tests/test_agy_bridge_resilience.py#L3823-L3829)) добавить очистку `os.environ.pop(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", None)`.\n2. Обновить хелпер `_is_length` и негативный ассерт на строке 5464 на ожидание `finish_reason == \"stop\"` при дефолтной конфигурации.\n3. Обновить 10 тестов в `SilentGracefulTimeoutTests` и `SilentCouncilCycle2Tests`:\n   - `test_silent_graceful_timeout_sse_both_states` (строка 5440) -> `\"stop\"`\n   - `test_silent_graceful_timeout_json_matrix` (строка 5502) -> `\"stop\"`\n   - `test_silent_graceful_timeout_final_flush_window_survives_expired_deadline` (строка 5541) -> `\"stop\"`\n   - `test_silent_graceful_timeout_one_shared_window_for_all_final_writes` (строка 5572) -> `\"stop\"`\n   - `test_silent_graceful_timeout_write_failure_stops_all_further_writes` (строка 5618) -> `\"stop\"`\n   - `test_silent_graceful_timeout_post_hoc_path_when_run_once_skips_the_hook` (строка 5639) -> `\"stop\"`\n   - `test_silent_graceful_timeout_end_to_end_real_run_both_states_sse` (строка 5785) -> `\"stop\"`\n   - `test_silent_graceful_timeout_end_to_end_real_run_json_and_silent_504` (строка 5802) -> `\"stop\"`\n   - `test_silent_rw001_json_window_reset_restores_timeout_hook_and_post_hoc` (строка 5946) -> `\"stop\"`\n4. Добавить новые тесты:\n   - `test_silent_graceful_timeout_custom_finish_reason_env_length`: проверка возврата `\"length\"` при `AGY_GRACEFUL_TIMEOUT_FINISH_REASON=\"length\"`.\n   - `test_silent_graceful_timeout_custom_finish_reason_dynamic_config`: проверка чтения из `dynamic_config.json`.\n   - `test_silent_graceful_timeout_invalid_env_falls_back_to_config_or_default`: проверка корректного fallback.\n5. Прогон всего тест-сьюта: `pytest tests/test_agy_bridge_resilience.py -v` (100% green).\ndiff --git a/bridges/agy-bridge/server.py b/bridges/agy-bridge/server.py\nindex 1fea7bd..3341528 100644\n--- a/bridges/agy-bridge/server.py\n+++ b/bridges/agy-bridge/server.py\n@@ -58,7 +58,9 @@ env приоритетнее файла (0/false/no/off — hard-off, 1/true/yes\n   * `extended_timeout_enabled` / `AGY_EXTENDED_TIMEOUT_ENABLED` — idle 1800 с по активности\n     stdout/transcript и потолок 3600 с (`AGY_IDLE_TIMEOUT_S`, `AGY_TIMEOUT_S`);\n   * `graceful_timeout_on_partial` / `AGY_GRACEFUL_TIMEOUT_ON_PARTIAL` — timeout и\n-    idle_timeout после частичной выдачи завершаются `finish_reason=\"length\"` вместо 504;\n+    idle_timeout после частичной выдачи завершаются настраиваемым `finish_reason`\n+    (по умолчанию \"stop\") вместо 504: `AGY_GRACEFUL_TIMEOUT_FINISH_REASON` или\n+    `graceful_timeout_finish_reason` в dynamic_config.json;\n   * `step_scoped_usage_enabled` / `AGY_STEP_SCOPED_USAGE_ENABLED` — `usage` по окну\n     последнего шага (prompt = input + cache последнего `PLANNER_RESPONSE`, completion =\n     сумма output шагов хода) вместо накопительного `result.usage`; без валидного шага —\n@@ -546,6 +548,33 @@ PROMPT_MAX_NDJSON_BYTES = _env_int(\n )\n # Минимум головы и хвоста якорного блока при пропорциональном сжатии (байты).\n PRUNE_EDGE_MIN_BYTES = _env_int(\"AGY_BRIDGE_PRUNE_EDGE_MIN_BYTES\", 512, 512, 8192)\n+# Завершённые напоминания и точные форматы снимка/уведомлений (ADR-0019).\n+SYNTHETIC_REMINDER_RE = re.compile(\n+    r\"<system-reminder>(?:(?!</?system-reminder>).)*</system-reminder>\", re.DOTALL\n+)\n+SYNTHETIC_RUNTIME_RE = re.compile(\n+    r\"Current runtime context\\. This snapshot supersedes earlier \"\n+    r\"(?:runtime-context )?snapshots\\.\"\n+    r'(?:\\n\\n?Current working directory: \"[^\"\\n]+\"\\.)?'\n+)\n+SYNTHETIC_POLICY_RE = re.compile(\n+    r'The approval policy changed from \"[^\"\\n]+\" to \"[^\"\\n]+\" '\n+    r\"\\(changed by the user\\)\\.\"\n+)\n+# Служебное уведомление DSH об одобрении/отказе инструмента — синтетика только при\n+# точном совпадении всего тела; любой иной текст `The user approved ...` — ввод\n+# человека (ADR-0019, Cycle 4 F-001).\n+SYNTHETIC_NOTICE_RE = re.compile(\n+    r\"The user (?:approved|rejected)(?: the)? (?:bash|command|tool)\"\n+    r\"(?: command| call)?(?:\\.)?\",\n+    re.IGNORECASE,\n+)\n+# Сверх этого числа реальных user текущего хода якорями остаются только\n+# первый (исходная цель) и последние ANCHOR_USER_TAIL_COUNT (ADR-0019, Cycle 5 F-005).\n+ANCHOR_USER_NO_ASSISTANT_MAX = _env_int(\n+    \"AGY_BRIDGE_ANCHOR_USER_NO_ASSISTANT_MAX\", 5, 1, 100000\n+)\n+ANCHOR_USER_TAIL_COUNT = _env_int(\"AGY_BRIDGE_ANCHOR_USER_TAIL_COUNT\", 3, 1, 100000)\n HISTORY_PRUNED_MARKER = (\n     \"[ранняя история диалога опущена мостом для соблюдения лимита контекста]\"\n )\n@@ -1972,46 +2001,179 @@ def _join_prompt_parts(parts: list[str], tail_block: str = \"\") -> str:\n     return \"\\n\\n\".join(joined).strip()\n \n \n-def _prune_prompt_blocks(\n-    blocks: list[tuple[int, str, str]], tail_block: str, limit: int\n-) -> str:\n-    \"\"\"Head-pruning структурированной истории под потолок NDJSON (ADR-0008, REQ-01).\n-\n-    Якоря не отбрасываются: системное `messages[0]`, последний блок истории\n-    с предшествующим ответом ассистента, последний блок `user` с ответом\n-    ассистента перед ним (даже за хвостом `assistant(tool_calls)`/`tool`) и\n-    `[attachments]`. Промежуточные блоки уходят от старых к новым; на месте\n-    каждого отброшенного отрезка — маркерное сообщение. Если не влезают даже\n-    якоря, середины крупных блоков вырезаются пропорционально их излишку с\n-    явным маркером; голова и хвост каждого — не короче PRUNE_EDGE_MIN_BYTES.\n+def _is_synthetic_user_block(rendered_text: str) -> bool:\n+    \"\"\"Синтетическое напоминание/снимок рантайма, а не ввод человека (ADR-0019).\n+\n+    Завершённые теги занимают всё тело без полезного текста снаружи. Уведомления\n+    распознаются по полному известному формату; совпадения префикса недостаточно.\n+    Неизвестные форматы остаются вводом человека, чтобы не потерять директиву.\n+    \"\"\"\n+    lines = rendered_text.splitlines()\n+    body = \"\\n\".join(\n+        lines[1:] if len(lines) > 1 and lines[0].startswith(\"### \") else lines\n+    ).strip()\n+    if not body:\n+        return False\n+    if (\n+        SYNTHETIC_REMINDER_RE.search(body)\n+        and not SYNTHETIC_REMINDER_RE.sub(\"\", body).strip()\n+    ):\n+        return True\n+    return any(\n+        pattern.fullmatch(body) is not None\n+        for pattern in (SYNTHETIC_RUNTIME_RE, SYNTHETIC_POLICY_RE, SYNTHETIC_NOTICE_RE)\n+    )\n+\n+\n+def _prompt_anchor_indices(blocks: list[tuple[int, str, str]]) -> set[int]:\n+    \"\"\"Индексы блоков, которые head-pruning не отбрасывает (ADR-0008, ADR-0019).\n+\n+    Якоря: системное `messages[0]`, реальные сообщения пользователя текущего хода\n+    (последний не-синтетический user и все реальные после предшествующего ему\n+    assistant), сам этот assistant, последний блок истории (assistant/tool/реальный\n+    user), ровно один последний assistant всей истории и результаты инструментов\n+    активного хода (после последнего assistant; без assistant в срезе — все).\n+    Исторические tool-результаты до последнего assistant вытесняются штатно.\n+    С числом реальных user текущего хода сверх ANCHOR_USER_NO_ASSISTANT_MAX\n+    якоря — первый (исходная цель) и последние ANCHOR_USER_TAIL_COUNT, промежуточные\n+    вытесняются head-pruning (Cycle 4 F-002). Без реальных user последний user\n+    закрепляется безусловно, даже при исторических tool-блоках (Cycle 4 F-001):\n+    крупный сжимается серединой с сохранением краёв, а не теряется.\n     \"\"\"\n     count = len(blocks)\n     anchors: set[int] = set()\n-    if count and blocks[0][0] == 0 and blocks[0][1] == \"system\":\n+    if not count:\n+        return anchors\n+    if blocks[0][0] == 0 and blocks[0][1] == \"system\":\n         anchors.add(0)\n-    if count:\n-        last = count - 1\n-        anchors.add(last)\n-        for i in range(last - 1, -1, -1):\n-            if i not in anchors and blocks[i][1] == \"assistant\":\n-                anchors.add(i)\n-                break\n+    last = count - 1\n+\n+    # Поиск реальных (не синтетических) пользовательских сообщений (ADR-0019)\n+    real_user_indices = [\n+        i\n+        for i in range(count)\n+        if blocks[i][1] == \"user\" and not _is_synthetic_user_block(blocks[i][2])\n+    ]\n+\n+    if real_user_indices:\n+        last_real_user = real_user_indices[-1]\n+        anchors.add(last_real_user)\n+        preceding_assistant_idx = next(\n+            (\n+                i\n+                for i in range(last_real_user - 1, -1, -1)\n+                if blocks[i][1] == \"assistant\"\n+            ),\n+            -1,\n+        )\n+        if preceding_assistant_idx >= 0:\n+            anchors.add(preceding_assistant_idx)\n+        turn_users = [u for u in real_user_indices if u > preceding_assistant_idx]\n+        if len(turn_users) > ANCHOR_USER_NO_ASSISTANT_MAX:\n+            # Пачка user с assistant или без: исходная цель и хвост (Cycle 5 F-005).\n+            anchors.add(turn_users[0])\n+            tail_count = min(ANCHOR_USER_TAIL_COUNT, ANCHOR_USER_NO_ASSISTANT_MAX)\n+            anchors.update(turn_users[-tail_count:])\n+        else:\n+            # Все реальные user текущего хода (после предшествующего assistant).\n+            anchors.update(turn_users)\n+    else:\n+        # Fallback: реальных user нет; последний user — носитель ввода, закрепляется\n+        # безусловно, исторические tool-блоки этому не мешают (Cycle 4 F-001).\n         last_user_idx = next(\n             (i for i in range(last, -1, -1) if blocks[i][1] == \"user\"), -1\n         )\n         if last_user_idx >= 0:\n             anchors.add(last_user_idx)\n-            preceding_assistant_idx = next(\n-                (\n-                    i\n-                    for i in range(last_user_idx - 1, -1, -1)\n-                    if blocks[i][1] == \"assistant\"\n-                ),\n-                -1,\n-            )\n-            if preceding_assistant_idx >= 0:\n-                anchors.add(preceding_assistant_idx)\n-    droppable = [i for i in range(count) if i not in anchors]\n+\n+    # Сохранение последнего блока, если это assistant или tool, либо реальный user.\n+    # Хвостовая синтетика в якоря не попадает: при дефиците бюджета она уходит\n+    # первой (секция synthetic в droppable), не вырезая реальный ввод.\n+    if blocks[last][1] in (\"assistant\", \"tool\"):\n+        anchors.add(last)\n+    elif not _is_synthetic_user_block(blocks[last][2]):\n+        anchors.add(last)\n+\n+    # Последний assistant всей истории (контекст tool calls) — ровно один: если он\n+    # уже якорь, более старые не добираются, чтобы не съедать бюджет (F-002).\n+    last_assistant = next(\n+        (i for i in range(last, -1, -1) if blocks[i][1] == \"assistant\"), -1\n+    )\n+    if last_assistant >= 0:\n+        anchors.add(last_assistant)\n+\n+    # Результаты инструментов только активного хода (после последнего assistant);\n+    # срез без assistant (`new_msgs` продолжения) — весь активный ход (F-003).\n+    anchors.update(\n+        i for i in range(last_assistant + 1, count) if blocks[i][1] == \"tool\"\n+    )\n+    return anchors\n+\n+\n+def _prompt_priority_indices(\n+    blocks: list[tuple[int, str, str]],\n+) -> tuple[set[int], set[int]]:\n+    \"\"\"Активные инструменты и защищённые блоки для сжатия (ADR-0019, Cycle 5 F-001).\n+\n+    Защищены системное `messages[0]` и якорные user текущего хода;\n+    без реальных user используется служебный ввод. Инструменты подчинены им:\n+    их тела и заголовки сокращаются до любого сжатия защищённого ввода.\n+    \"\"\"\n+    count = len(blocks)\n+    protected: set[int] = set()\n+    if count and blocks[0][0] == 0 and blocks[0][1] == \"system\":\n+        protected.add(0)\n+    users = [i for i in range(count) if blocks[i][1] == \"user\"]\n+    real_users = [i for i in users if not _is_synthetic_user_block(blocks[i][2])]\n+    carrier = real_users or users\n+    last_assistant = next(\n+        (i for i in range(count - 1, -1, -1) if blocks[i][1] == \"assistant\"), -1\n+    )\n+    preceding_assistant_idx = (\n+        next(\n+            (i for i in range(carrier[-1] - 1, -1, -1) if blocks[i][1] == \"assistant\"),\n+            -1,\n+        )\n+        if carrier\n+        else -1\n+    )\n+    turn_users = [u for u in carrier if u > preceding_assistant_idx]\n+    if turn_users:\n+        tail_count = min(ANCHOR_USER_TAIL_COUNT, ANCHOR_USER_NO_ASSISTANT_MAX)\n+        if len(turn_users) > ANCHOR_USER_NO_ASSISTANT_MAX:\n+            protected.add(turn_users[0])\n+            protected.update(turn_users[-tail_count:])\n+        else:\n+            protected.update(turn_users)\n+    active_tools = {\n+        i for i in range(last_assistant + 1, count) if blocks[i][1] == \"tool\"\n+    }\n+    return active_tools, protected\n+\n+\n+def _prune_prompt_blocks(\n+    blocks: list[tuple[int, str, str]], tail_block: str, limit: int\n+) -> str:\n+    \"\"\"Head-pruning структурированной истории под потолок NDJSON (ADR-0008, REQ-01, ADR-0019).\n+\n+    Якоря (`_prompt_anchor_indices`) и `[attachments]` не отбрасываются. Первыми\n+    уходят неякорные синтетические напоминания, затем история от старых к новым;\n+    оставшиеся блоки идут в исходном порядке, на месте каждого отброшенного\n+    отрезка — маркерное сообщение. Если не влезают даже якоря — приоритетное\n+    сжатие `_cap_prompt_parts`: сначала история и активные tool-результаты,\n+    затем их заголовки; система, носитель ввода и вложения защищены. Заголовок `### N. role`\n+    каждого оставшегося сообщения сохраняется.\n+    \"\"\"\n+    count = len(blocks)\n+    anchors = _prompt_anchor_indices(blocks)\n+    synthetic = {\n+        i\n+        for i in range(count)\n+        if blocks[i][1] == \"user\" and _is_synthetic_user_block(blocks[i][2])\n+    }\n+    droppable = [i for i in range(count) if i not in anchors and i in synthetic] + [\n+        i for i in range(count) if i not in anchors and i not in synthetic\n+    ]\n     marker_block = \"### user\\n\" + HISTORY_PRUNED_MARKER\n \n     def assemble(drop_count: int) -> list[str]:\n@@ -2042,31 +2204,23 @@ def _prune_prompt_blocks(\n     else:\n         dropped_count = len(droppable)\n         parts = assemble(dropped_count)\n+        # Позиции сообщений в `parts` по группам приоритета; маркеры пропуска и\n+        # `[attachments]` не сжимаются и не вытесняются.\n+        active_blocks, protected_blocks = _prompt_priority_indices(blocks)\n+        dropped_set = set(droppable)\n+        kept = [i for i in range(count) if i not in dropped_set]\n+        message_parts = [k for k, part in enumerate(parts) if part != marker_block]\n+        block_at = dict(zip(message_parts, kept))\n+        priority_blocks = active_blocks | protected_blocks\n+        historical = [\n+            k for k in message_parts if block_at[k] not in priority_blocks\n+        ]\n+        active = [k for k in message_parts if block_at[k] in active_blocks]\n+        protected = {k for k in message_parts if block_at[k] in protected_blocks}\n         if tail_block:\n+            protected.add(len(parts))\n             parts.append(tail_block)\n-        # Излишек делится между крупными блоками пропорционально их запасу\n-        # сверх пола (голова + маркер + хвост): ни один блок не зануляется.\n-        floor = 2 * PRUNE_EDGE_MIN_BYTES + _json_text_bytes(MIDDLE_PRUNED_MARKER)\n-        for _round in range(len(parts) + 1):\n-            excess = _ndjson_bytes(_join_prompt_parts(parts)) - limit\n-            if excess <= 0:\n-                break\n-            sizes = [_json_text_bytes(part) for part in parts]\n-            spare = [max(size - floor, 0) for size in sizes]\n-            pool = sum(spare)\n-            if not pool:\n-                break\n-            changed = False\n-            for i, room in enumerate(spare):\n-                if not room:\n-                    continue\n-                cut = min(room, -(-excess * room // pool))\n-                pruned = _middle_prune_text(parts[i], sizes[i] - cut)\n-                if pruned != parts[i]:\n-                    parts[i] = pruned\n-                    changed = True\n-            if not changed:\n-                break\n+        parts = _cap_prompt_parts(parts, historical, active, limit, protected)\n         text = _ensure_prompt_fits_ndjson(_join_prompt_parts(parts), limit)\n     final_bytes = _ndjson_bytes(text)\n     _log(\n@@ -2076,6 +2230,169 @@ def _prune_prompt_blocks(\n     return text\n \n \n+def _cap_prompt_parts(\n+    parts: list[str],\n+    historical: list[int],\n+    active: list[int],\n+    limit: int,\n+    protected: set[int] | None = None,\n+) -> list[str]:\n+    \"\"\"Приоритетное сжатие якорей под `limit` (ADR-0019, Cycle 5 F-001).\n+\n+    История и активные инструменты сначала сжимаются до пола с сохранением краёв,\n+    затем тела инструментов обнуляются раньше истории; если не влезают заголовки,\n+    сначала вытесняются инструменты, затем история. Защищённые система, носитель\n+    ввода и вложения не участвуют в этих операциях. Только если они одни превышают лимит, сжимаются их середины.\n+    \"\"\"\n+    out = list(parts)\n+    keep = protected or set()\n+    historical = [k for k in historical if k not in keep]\n+    active = [k for k in active if k not in keep]\n+    if _prompt_parts_fit(out, limit):\n+        return out\n+    out = _middle_prune_group(out, historical, limit)\n+    out = _middle_prune_group(out, active, limit)\n+    if _prompt_parts_fit(out, limit):\n+        return out\n+    capped = _cap_group_bodies(out, active, limit)\n+    if capped is not None:\n+        return capped\n+    out = _cap_group_to(out, active, 0)\n+    capped = _cap_group_bodies(out, historical, limit)\n+    if capped is not None:\n+        return capped\n+    out = _cap_group_to(out, historical, 0)\n+\n+    evictable = sorted(active) + sorted(historical)\n+    active_set = set(active) - keep\n+    marker_block = \"### user\\n\" + HISTORY_PRUNED_MARKER\n+\n+    def evict(n: int) -> tuple[list[str], list[int], list[int]]:\n+        dropped = set(evictable[:n])\n+        result: list[str] = []\n+        result_active: list[int] = []\n+        result_protected: list[int] = []\n+        for k, part in enumerate(out):\n+            if k in dropped or part == marker_block:\n+                if not result or result[-1] != marker_block:\n+                    result.append(marker_block)\n+                continue\n+            if k in active_set:\n+                result_active.append(len(result))\n+            if k in keep:\n+                result_protected.append(len(result))\n+            result.append(part)\n+        return result, result_active, result_protected\n+\n+    def fits_after(n: int) -> bool:\n+        evicted, evicted_active, _ = evict(n)\n+        return _prompt_parts_fit(_cap_group_to(evicted, evicted_active, 0), limit)\n+\n+    low, high = 1, len(evictable)\n+    if not high or not fits_after(high):\n+        # Все лишние заголовки удалены; лишь теперь режем середины защищённых.\n+        evicted, _, survivors = evict(high)\n+        evicted = _middle_prune_group(evicted, survivors, limit)\n+        if _prompt_parts_fit(evicted, limit):\n+            return evicted\n+        # Защитный рубеж для лимита меньше суммарного пола защищённых блоков.\n+        return _cap_group_bodies(evicted, survivors, limit) or _cap_group_to(\n+            evicted, survivors, 0\n+        )\n+    while low < high:\n+        mid = (low + high) // 2\n+        if fits_after(mid):\n+            high = mid\n+        else:\n+            low = mid + 1\n+    evicted, evicted_active, _ = evict(high)\n+    _log(f\"history headers evicted: {high} messages\")\n+    return _cap_group_bodies(evicted, evicted_active, limit) or evicted\n+\n+\n+def _prompt_parts_fit(parts: list[str], limit: int) -> bool:\n+    return _ndjson_bytes(_join_prompt_parts(parts)) <= limit\n+\n+\n+def _middle_prune_group(parts: list[str], group: list[int], limit: int) -> list[str]:\n+    \"\"\"Вырезать середины блоков `group` пропорционально их запасу сверх пола.\n+\n+    Пол — заголовок `### N. role`, голова и хвост тела по PRUNE_EDGE_MIN_BYTES плюс\n+    маркер: ни один блок группы не зануляется; блоки вне `group` не трогаются.\n+    \"\"\"\n+    out = list(parts)\n+    marker_bytes = _json_text_bytes(MIDDLE_PRUNED_MARKER)\n+    floors = {\n+        k: 2 * (PRUNE_EDGE_MIN_BYTES + _json_text_bytes(parts[k].partition(\"\\n\")[0]))\n+        + marker_bytes\n+        for k in group\n+    }\n+    for _round in range(len(group) + 1):\n+        excess = _ndjson_bytes(_join_prompt_parts(out)) - limit\n+        if excess <= 0:\n+            break\n+        sizes = {k: _json_text_bytes(out[k]) for k in group}\n+        spare = {k: max(size - floors[k], 0) for k, size in sizes.items()}\n+        pool = sum(spare.values())\n+        if not pool:\n+            break\n+        changed = False\n+        for k, room in spare.items():\n+            if not room:\n+                continue\n+            cut = min(room, -(-excess * room // pool))\n+            pruned = _middle_prune_text(out[k], sizes[k] - cut)\n+            if pruned != out[k]:\n+                out[k] = pruned\n+                changed = True\n+        if not changed:\n+            break\n+    return out\n+\n+\n+def _cap_group_to(parts: list[str], group: list[int], cap: int) -> list[str]:\n+    out = list(parts)\n+    for k in group:\n+        out[k] = _cap_prompt_block(parts[k], cap)\n+    return out\n+\n+\n+def _cap_group_bodies(\n+    parts: list[str], group: list[int], limit: int\n+) -> list[str] | None:\n+    \"\"\"Наибольший общий потолок блоков `group`, при котором промпт влезает в `limit`.\n+\n+    Блоки крупнее потолка сжимаются серединой тела, заголовок сохраняется; None —\n+    промпт не влезает даже при пустых телах группы.\n+    \"\"\"\n+    if not _prompt_parts_fit(_cap_group_to(parts, group, 0), limit):\n+        return None\n+    low = 0\n+    high = max((_json_text_bytes(parts[k]) for k in group), default=0)\n+    while low < high:\n+        mid = (low + high + 1) // 2\n+        if _prompt_parts_fit(_cap_group_to(parts, group, mid), limit):\n+            low = mid\n+        else:\n+            high = mid - 1\n+    return _cap_group_to(parts, group, low)\n+\n+\n+def _cap_prompt_block(block: str, cap: int) -> str:\n+    \"\"\"Сжать блок промпта до `cap` экранированных байт, не трогая заголовок `### N. role`.\"\"\"\n+    if _json_text_bytes(block) <= cap:\n+        return block\n+    header, sep, body = block.partition(\"\\n\")\n+    if not header.startswith(\"### \"):\n+        return _middle_prune_text(block, cap)\n+    if not sep:\n+        return header\n+    budget = max(cap - _json_text_bytes(header + sep), 0)\n+    pruned = _middle_prune_text(body, budget)\n+    # Пустое тело — только заголовок: без висячего перевода строки на границе блоков.\n+    return header + sep + pruned if pruned else header\n+\n+\n def _json_text_bytes(text: str) -> int:\n     \"\"\"Байты UTF-8 строки после JSON-экранирования, без обрамляющих кавычек.\"\"\"\n     return len(json.dumps(text, ensure_ascii=False).encode(\"utf-8\")) - 2\n@@ -2601,9 +2918,9 @@ def _is_sqlite_reasoning_enabled() -> bool:\n \n \n # ---- Флаги новой политики (AD-005): локальный GigaRC-совместимый снимок -------------\n-# Stdlib-only LaunchAgent: ни SDK, ни удалённого транспорта. Все пять флагов имеют\n-# строгий кодовый False (прежнее поведение до явного включения). Приоритет:\n-# env override > JSON bool из dynamic_config.json > False.\n+# Stdlib-only LaunchAgent: ни SDK, ни удалённого транспорта. Старые флаги имеют\n+# кодовый False; stream resilience — True по брифу. Приоритет:\n+# env override > JSON из dynamic_config.json > кодовый default.\n \n \n class _RuntimeFlags(NamedTuple):\n@@ -2614,6 +2931,8 @@ class _RuntimeFlags(NamedTuple):\n     extended_timeout_enabled: bool = False\n     graceful_timeout_on_partial: bool = False\n     step_scoped_usage_enabled: bool = False\n+    stream_resilience_enabled: bool = True\n+    graceful_timeout_finish_reason: str = \"stop\"\n \n \n _NEW_FLAG_ENV = {\n@@ -2622,6 +2941,7 @@ _NEW_FLAG_ENV = {\n     \"extended_timeout_enabled\": \"AGY_EXTENDED_TIMEOUT_ENABLED\",\n     \"graceful_timeout_on_partial\": \"AGY_GRACEFUL_TIMEOUT_ON_PARTIAL\",\n     \"step_scoped_usage_enabled\": \"AGY_STEP_SCOPED_USAGE_ENABLED\",\n+    \"stream_resilience_enabled\": \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\",\n }\n _ENV_TRUE = frozenset({\"1\", \"true\", \"yes\", \"on\"})\n _ENV_FALSE = frozenset({\"0\", \"false\", \"no\", \"off\"})\n@@ -2634,26 +2954,37 @@ _cfg_generation: int = 0\n \n \n def _parse_runtime_flags(text: str) -> _RuntimeFlags:\n-    \"\"\"Разобрать dynamic_config.json; ValueError — файл отвергается целиком.\"\"\"\n+    \"\"\"Разобрать флаги; нестроковый finish_reason заменяется дефолтом 'stop'.\n+\n+    ValueError для не-bool флагов отвергает файл целиком.\n+    \"\"\"\n     data = cast(object, json.loads(text))\n     if not isinstance(data, dict):\n         raise ValueError(\"dynamic_config: not an object\")\n     raw = cast(\"dict[str, object]\", data)\n     values: dict[str, bool] = {}\n+    finish_reason = _COLD_FLAGS.graceful_timeout_finish_reason\n     for name in _RuntimeFlags._fields:\n-        value = raw.get(name, False)\n+        default = getattr(_COLD_FLAGS, name)\n+        if name == \"stream_resilience_enabled\":\n+            default = raw.get(_NEW_FLAG_ENV[name], default)\n+        value = raw.get(name, default)\n+        if name == \"graceful_timeout_finish_reason\":\n+            finish_reason = value if isinstance(value, str) else \"stop\"\n+            continue\n         if not isinstance(value, bool):\n             raise ValueError(\"dynamic_config: %s is not boolean\" % name)\n         values[name] = value\n-    return _RuntimeFlags(**values)\n+    return _RuntimeFlags(**values, graceful_timeout_finish_reason=finish_reason)\n \n \n def _runtime_snapshot() -> _RuntimeFlags:\n     \"\"\"Снимок флагов из dynamic_config.json: TTL 1.0 с, ключ версии (mtime_ns, size).\n \n     Пока stat не изменился, JSON не разбирается (identity снимка сохраняется). Битый\n-    JSON или не-bool значение отвергают файл целиком: действует last-known-good,\n-    на холодном старте — False. Отсутствие файла — валидное состояние «все False».\n+    JSON или не-bool флаг отвергают файл целиком: действует last-known-good,\n+    на холодном старте — кодовые дефолты. Нестроковый finish_reason заменяется\n+    на 'stop'. При отсутствии файла используются кодовые дефолты.\n     \"\"\"\n     global _cfg_snapshot, _cfg_key, _cfg_checked_at, _cfg_generation\n     now = time.monotonic()\n@@ -2696,14 +3027,40 @@ def _runtime_snapshot() -> _RuntimeFlags:\n     return snapshot\n \n \n-def _new_flag(name: str) -> bool:\n-    \"\"\"Флаг новой политики: явный env (0/false/no/off, 1/true/yes/on) > JSON bool > False.\"\"\"\n+def _new_flag(name: str, default: bool = False) -> bool:\n+    \"\"\"Явный env > JSON bool > кодовый default; старые флаги выключены.\"\"\"\n+    if name == \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\":\n+        name = \"stream_resilience_enabled\"\n     env = os.environ.get(_NEW_FLAG_ENV[name], \"\").strip().lower()\n     if env in _ENV_TRUE:\n         return True\n     if env in _ENV_FALSE:\n         return False\n-    return bool(getattr(_runtime_snapshot(), name))\n+    return bool(getattr(_runtime_snapshot(), name, default))\n+\n+\n+def _graceful_finish_reason() -> str:\n+    \"\"\"Возвращает finish_reason graceful-таймаута: 'stop' или 'length'.\n+\n+    Приоритет: валидный AGY_GRACEFUL_TIMEOUT_FINISH_REASON, затем\n+    graceful_timeout_finish_reason из dynamic_config.json, затем 'stop'.\n+    Значение 'max_tokens' нормализуется в 'length'.\n+    \"\"\"\n+    raw_env = os.getenv(\"AGY_GRACEFUL_TIMEOUT_FINISH_REASON\", \"\").strip().lower()\n+    if raw_env in (\"length\", \"max_tokens\"):\n+        return \"length\"\n+    if raw_env == \"stop\":\n+        return \"stop\"\n+    snap = _runtime_snapshot()\n+    val = snap.graceful_timeout_finish_reason.strip().lower()\n+    if val in (\"length\", \"max_tokens\"):\n+        return \"length\"\n+    return \"stop\"\n+\n+\n+AGY_BRIDGE_STREAM_RESILIENCE_ENABLED = _new_flag(\n+    \"AGY_BRIDGE_STREAM_RESILIENCE_ENABLED\", True\n+)\n \n \n def _positive_env(name: str) -> float | None:\n@@ -5667,6 +6024,10 @@ class Handler(BaseHTTPRequestHandler):\n     def _run_once(\n         self, ctx: dict, on_text, on_tool_trace, on_reasoning, keepalive\n     ) -> dict:\n+        if \"stre