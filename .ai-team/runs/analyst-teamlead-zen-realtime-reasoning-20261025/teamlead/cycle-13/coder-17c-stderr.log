#!/usr/bin/env python3
"""opencode-zen-bridge — локальный OpenAI-совместимый мост поверх CLI `opencode run`.

Один запрос `/v1/chat/completions` = один headless-ход
`~/.opencode/bin/opencode run -m opencode/<id> --format json` с промптом через stdin
(не argv: история > ~1 МБ пробивает macOS ARG_MAX).
Ответ собирается из событий `type:"text"` (конкатенация part.text),
мышление — из событий `type:"reasoning"` (part.text и reasoningEncryptedContent),
usage — из события `type:"step_finish"` (part.tokens).

Транспорт — только stdlib. Стрим (SSE) реализован через честный потоковый вывод
дельт (text и reasoning) по мере поступления строк из `opencode run`.

Ключ авторизации берётся из OPENCODE_ZEN_BRIDGE_KEY (его подкладывает start.sh
из ~/.dsh/.env). Без ключа мост не стартует.
"""

from __future__ import annotations

import errno
import json
import os
import select
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, cast


def _run_serve_helper_cli(args: list[str]) -> int:
    """Ранний помощник serve: один лидер группы на попытку, lease и дренаж пайпов."""
    if len(args) != 6:
        return 2
    (
        attempt_id,
        port_text,
        opencode_bin,
        lease_dir_text,
        parent_pid_text,
        parent_lstart,
    ) = args
    if not attempt_id or not opencode_bin or not lease_dir_text or not parent_lstart:
        return 2
    if not port_text.isdecimal() or not parent_pid_text.isdecimal():
        return 2
    port = int(port_text)
    parent_pid = int(parent_pid_text)
    if not 1 <= port <= 65535 or parent_pid <= 0:
        return 2
    lease_dir = Path(lease_dir_text)
    stopped: dict[str, bool] = {"flag": False}

    def _on_term(_signum: int, _frame: object) -> None:
        """Отметить SIGTERM без тяжёлой работы в обработчике."""
        stopped["flag"] = True

    _ = signal.signal(signal.SIGTERM, _on_term)
    try:
        lease_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(lease_dir, 0o700)
    except OSError:
        return 2
    lease_path = lease_dir / f"lease-{attempt_id}.json"

    def _lstart_of(pid: int) -> str:
        """lstart процесса из ps; при сбое ps — epoch-секунды."""
        try:
            out = subprocess.run(
                ["ps", "-o", "lstart=", "-p", str(pid)],
                capture_output=True,
                text=True,
                timeout=2,
            )
            return out.stdout.strip() or str(int(time.time()))
        except (OSError, subprocess.SubprocessError):
            return str(int(time.time()))

    helper_lstart = _lstart_of(os.getpid())

    def _write_lease(extra: dict[str, object]) -> None:
        """Атомарно опубликовать lease помощника."""
        payload: dict[str, object] = {
            "schema_version": 1,
            "attempt_id": attempt_id,
            "owner_uid": os.getuid(),
            "parent_pid": parent_pid,
            "parent_start_ts": parent_lstart,
            "helper_pid": os.getpid(),
            "helper_lstart": helper_lstart,
            "pgid": os.getpgrp(),
            "port": port,
            "start_ts": time.time(),
            "phase": "starting",
        }
        payload.update(extra)
        tmp_path = lease_path.with_suffix(".tmp")
        try:
            _ = tmp_path.write_text(json.dumps(payload), "utf-8")
            os.replace(tmp_path, lease_path)
        except OSError:
            pass

    def _fd_ready() -> bool:
        """EOF на lifeline fd 0 виден без блокировки."""
        try:
            ready, _w, _x = select.select([0], [], [], 0)
            return bool(ready)
        except BlockingIOError:
            return False
        except (OSError, ValueError) as _gone_exc:
            if isinstance(_gone_exc, OSError) and _gone_exc.errno in (
                errno.EAGAIN,
                errno.EWOULDBLOCK,
            ):
                return False
            return True

    _write_lease({})
"""Тестовые модели вне боевого каталога моста и общие загрузчики фикстур.

Боевой каталог теперь динамический (state/zen-catalog.json или встроенный снимок
`zen_catalog.STATIC_FALLBACK_CATALOG`; в тестах — всегда снимок). Тесты общих путей кода
(нативный Google-протокол Go, CLI-вариант `#effort`, маршрутизация провайдера)
по-прежнему нуждаются в моделях с этими свойствами, поэтому подмешиваем их только
в тестовом процессе. Снимок боевого каталога — PRODUCTION_MODELS.
"""

from __future__ import annotations

import atexit
import json
import shutil
import tempfile
from pathlib import Path
from typing import Any

FIXTURES = Path(__file__).resolve().parent / "fixtures"
GO_BASE_URL = "http://127.0.0.1:10830/go/v1/v1beta"

TEST_ONLY_MODELS = {
    "gemini-4-argon-contributor": {
        "context_length": 1048576,
        "max_output": 65536,
        "supports_variant": True,
        "provider": "opencode-go",
        "base_url": GO_BASE_URL,
    },
    "muse-spark-1.3-contributor-free": {
        "context_length": 1048576,
        "max_output": 131072,
        "supports_variant": True,
    },
}

_state: dict[str, frozenset[str]] = {}


def load_json(name: str) -> Any:
    """Фикстура из tests/fixtures."""
    return json.loads((FIXTURES / name).read_text("utf-8"))


def fixture_text(name: str) -> str:
    return (FIXTURES / name).read_text("utf-8")


def install_test_models(server: Any) -> frozenset[str]:
    """Подмешать тестовые модели; вернуть снимок боевого каталога (до подмешивания).

    Заодно уводит `server.LOG_PATH` во временный каталог: тесты не должны дописывать
    в боевой `logs/bridge.log`.
    """
    if "production" not in _state:
        _state["production"] = frozenset(server.ALLOWED_MODELS)
        log_dir = tempfile.mkdtemp(prefix="zen-bridge-tests-")
        atexit.register(shutil.rmtree, log_dir, ignore_errors=True)
        server.LOG_PATH = Path(log_dir) / "bridge.log"
    for model_id, meta in TEST_ONLY_MODELS.items():
        server.ALLOWED_MODELS.setdefault(model_id, dict(meta))
    return _state["production"]
