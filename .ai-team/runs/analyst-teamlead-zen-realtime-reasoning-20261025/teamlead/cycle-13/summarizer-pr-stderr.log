#!/bin/bash
# Muse Code CLI (`muse exec` / TUI): flat Meta subscription — ТОЛЬКО через прокси-контур.
# api.meta.ai / dev.meta.ai → 127.0.0.1:10816 (proxyrack-forward.py, HTTP CONNECT, egress US);
# META_API_KEY вычищается (иначе PAYG за токен вместо flat подписки).
# Прямой вызов БЕЗ прокси из РФ = неверная маршрутизация/каталог (симптом: «только 1.2»).
# В интерактивных zsh — функция muse() в ~/.zshenv; агенты/cron/bash вызывают обёртку явно.
# Канон вызова: ~/Мой диск/skils/panel-backends/references/model-invocation.md §2d.
set -euo pipefail

REAL="${MUSE_BIN:-$HOME/.local/bin/muse}"
if [[ ! -x "$REAL" ]]; then
  echo "muse-cli: missing $REAL" >&2
  exit 127
fi

PROXY_HOST="127.0.0.1"
# Канонический HTTP CONNECT US-мост для Muse: :10816 (proxyrack-forward.py, US ProxyMarket 155.117.176.4:10000).
# Не :10830 (model_georouter отклоняет HTTP CONNECT с 400 Bad Request) и не :10815 (выделенный NL-мост Cursor).
PROXY_PORT="${MUSE_PROXY_PORT:-10816}"
if [[ "$PROXY_PORT" == "10816" ]] && ! (echo >"/dev/tcp/$PROXY_HOST/$PROXY_PORT") 2>/dev/null; then
  LOG_DIR="$HOME/Library/Logs/Factory"
  FWD_SCRIPT="$HOME/.config/factory-launch/proxyrack-forward.py"
  if [[ -f "$FWD_SCRIPT" ]]; then
    mkdir -p "$LOG_DIR"
    nohup python3 "$FWD_SCRIPT" </dev/null >>"$LOG_DIR/proxyrack-forward.log" 2>&1 &
    for _i in $(seq 1 25); do
      (echo >"/dev/tcp/$PROXY_HOST/$PROXY_PORT") 2>/dev/null && break
      sleep 0.2
    done
  fi
fi
if ! (echo >"/dev/tcp/$PROXY_HOST/$PROXY_PORT") 2>/dev/null; then
  echo "muse-cli: proxy $PROXY_HOST:$PROXY_PORT DOWN — прямой вызов запрещён (неверный каталог моделей из РФ)" >&2
  exit 42
fi

unset META_API_KEY ALL_PROXY all_proxy
export https_proxy="http://$PROXY_HOST:$PROXY_PORT" http_proxy="http://$PROXY_HOST:$PROXY_PORT"
export HTTPS_PROXY="http://$PROXY_HOST:$PROXY_PORT" HTTP_PROXY="http://$PROXY_HOST:$PROXY_PORT"
# api/dev/auth Meta не должны быть в NO_PROXY (иначе пойдут напрямую)
for v in NO_PROXY no_proxy; do
  eval "cur=\"\${$v:-}\""
  if [[ -n "$cur" ]]; then
    new="$(echo "$cur" | tr ',' '\n' | grep -viE 'meta\.ai|meta\.com' | paste -sd, -)"
    eval "export $v=\"$new\""
  fi
done

exec "$REAL" "$@"
