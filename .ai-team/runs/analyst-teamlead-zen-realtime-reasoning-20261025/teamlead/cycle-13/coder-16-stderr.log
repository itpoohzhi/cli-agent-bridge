def validate_reviewer(
    data: dict[str, Any],
    root: Path | None,
    *,
    entry_override: str | None = None,
) -> None:
    validate_common(data, "reviewer")
    require_int(data, "iteration", minimum=1)
    verdict = require_enum(data, "verdict", {"MERGE", "CHANGES_REQUESTED", "BLOCKED"})
    spec_verdict = require_enum(data, "spec_verdict", {"PASS", "FAIL", "INCONCLUSIVE"})
    quality_verdict = require_enum(
        data, "quality_verdict", {"PASS", "FAIL", "INCONCLUSIVE"}
    )
    require_string(data, "summary")
    findings = require_list(data.get("findings"), "findings")
    confirmed_blockers = 0
    for index, item in enumerate(findings):
        blocking, status = validate_finding(item, index, root)
        confirmed_blockers += int(blocking and status == "CONFIRMED")
    validate_commands(data.get("checks"), "checks")
