#!/usr/bin/env python3
"""Create or compare a repository worktree fingerprint for read-only role gates."""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import stat
import subprocess
import sys
from pathlib import Path, PurePosixPath
from typing import Any


SCHEMA_VERSION = "2.0"


def is_excluded(relative: str, patterns: list[str]) -> bool:
    normalized = relative.replace(os.sep, "/")
    for pattern in patterns:
        clean = pattern.rstrip("/")
        prefix = clean.removesuffix("/**")
        if (
            fnmatch.fnmatch(normalized, pattern)
            or normalized == prefix
            or normalized.startswith(prefix + "/")
        ):
            return True
    return False


# Служебные артефакты кэшей/инструментов/ОС: их штатно создают локальные
# прогоны (python, pytest, mypy, ruff), поэтому такие файлы не должны менять
# отпечаток worktree и валить гейт read-only ролей (RW-101).
_TOOL_ARTIFACT_DIRS = frozenset(
    {
        "__pycache__",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        ".hypothesis",
        ".tox",
        ".ipynb_checkpoints",
        "htmlcov",
    }
)
_TOOL_ARTIFACT_FILE_NAMES = frozenset({".DS_Store", "Thumbs.db", ".coverage"})
_TOOL_ARTIFACT_FILE_SUFFIXES = (".pyc", ".pyo", ".pyd")


def is_tool_artifact(relative: str) -> bool:
    """Служебный ли путь: кэш инструмента, бинарник Python или файл ОС.

    Такие артефакты не входят в отпечаток worktree: read-only роли (Reviewer,
    Architect) могут штатно запускать python/pytest, и созданный ими
    ``__pycache__`` не должен выглядеть как изменение продуктового кода.

    Содержательные ignored-файлы (например, ``.env``) этому фильтру не
    подлежат и остаются видимыми в отпечатке.

    Args:
        relative: путь относительно корня репозитория (POSIX-разделители).

    Returns:
        True, если путь относится к служебным артефактам инструментов.
    """
    parts = PurePosixPath(relative.replace(os.sep, "/")).parts
    if not parts:
        return False
    name = parts[-1]
    if any(part in _TOOL_ARTIFACT_DIRS for part in parts):
        return True
    if any(part.endswith(".egg-info") for part in parts):
        return True
    if name in _TOOL_ARTIFACT_FILE_NAMES:
        return True
    if name.endswith(_TOOL_ARTIFACT_FILE_SUFFIXES):
        return True
    return name.startswith(".coverage.")


def _ls_files(root: Path, *extra: str) -> list[str] | None:
    """Запускает ``git ls-files -z`` и возвращает список путей.

    Args:
        root: корень репозитория.
        *extra: дополнительные аргументы ``git ls-files``.

    Returns:
        Список путей (NUL-разделение снято) или None, если git вернул ошибку.
    """
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z", *extra],
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    return [
        part.decode("utf-8", errors="surrogateescape")
        for part in result.stdout.split(b"\0")
        if part
    ]


def git_files(root: Path) -> list[str] | None:
    # Untracked-файлы двух видов: обычные и ignored (например, .env).
    # Ignored тоже входят в отпечаток — иначе их правка не видна гейтам.
    # Исключение — служебные артефакты (is_tool_artifact): их штатно создают
    # read-only роли при запуске python/pytest, и они не должны валить гейт.
    # Tracked-проход не фильтруется: состав индекса — осознанное содержимое.
    names: set[str] = set()
    cached = _ls_files(root, "--cached")
    if cached is None:
        return None
    names.update(cached)
    for extra in (
        ("--others", "--exclude-standard"),
        ("--others", "--ignored", "--exclude-standard"),
    ):
        untracked = _ls_files(root, *extra)
        if untracked is None:
            return None
        names.update(name for name in untracked if not is_tool_artifact(name))
    return sorted(names)


def gitlinks(root: Path) -> dict[str, str]:
    """Закреплённые commit id gitlink-записей индекса (подмодулей).

    ``git ls-files --cached`` показывает подмодуль как путь каталога; чтобы не
    открывать каталог как файл, для режима 160000 фиксируем commit id из
    ``git ls-files -s`` (RW-102).

    Args:
        root: корень репозитория.

    Returns:
        Словарь {путь: commit id}; пустой, если gitlinks нет или git недоступен.
    """
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-s", "-z"],
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        return {}
    links: dict[str, str] = {}
    for record in result.stdout.split(b"\0"):
        if not record:
            continue
        meta, _, raw_path = record.partition(b"\t")
        fields = meta.split()
        if len(fields) != 3:
            continue
        mode, object_id, _stage = fields
        if mode == b"160000":
            path = raw_path.decode("utf-8", errors="surrogateescape")
            links[path] = object_id.decode("ascii", errors="replace")
    return links


def fallback_files(root: Path) -> list[str]:
    return sorted(
        str(path.relative_to(root))
        for path in root.rglob("*")
        if path.is_file() or path.is_symlink()
    )


def file_digest(path: Path) -> str:
    digest = hashlib.sha256()
    if path.is_symlink():
        digest.update(b"symlink\0")
        digest.update(os.readlink(path).encode("utf-8", errors="surrogateescape"))
    else:
        digest.update(b"file\0")
        # Режим доступа (включая executable-бит) — часть отпечатка.
        mode = stat.S_IMODE(path.stat().st_mode)
        digest.update(f"{mode:04o}\0".encode("ascii"))
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
    return digest.hexdigest()


def _non_regular_marker(path: Path) -> str:
    """Детерминированная пометка не-regular записи (каталог, спецфайл).

    Читать содержимое такого пути нельзя: фиксируем только тип, чтобы
    отпечаток не падал и не терял запись молча (RW-102).

    Args:
        path: путь на диске.

    Returns:
        ``"directory"``, ``"special:<octal mode>"`` или ``"unreadable"``.
    """
    try:
        mode = path.stat().st_mode
    except OSError:
        return "unreadable"
    if stat.S_ISDIR(mode):
        return "directory"
    return f"special:{stat.S_IFMT(mode):o}"


def snapshot(root: Path, excludes: list[str]) -> dict[str, Any]:
    paths = git_files(root)
    source = "git" if paths is not None else "filesystem"
    links: dict[str, str] = {}
    if paths is None:
        paths = fallback_files(root)
    else:
        links = gitlinks(root)

    manifest: dict[str, str] = {}
    for relative in paths:
        normalized = relative.replace(os.sep, "/")
        if is_excluded(normalized, excludes):
            continue
        if normalized in links:
            # gitlink (подмодуль): содержимое каталога принадлежит подмодулю,
            # фиксируем факт записи и закреплённый commit id без обхода.
            manifest[normalized] = f"gitlink:{links[normalized]}"
            continue
        target = root / relative
        if not target.exists() and not target.is_symlink():
            continue
        if not target.is_file() and not target.is_symlink():
            # Каталог/спецфайл на месте записи индекса: поведение определено
            # явно, вместо падения на попытке чтения содержимого.
            manifest[normalized] = _non_regular_marker(target)
            continue
        manifest[normalized] = file_digest(target)

    overall = hashlib.sha256()
    for relative, digest in sorted(manifest.items()):
        overall.update(relative.encode("utf-8", errors="surrogateescape"))
        overall.update(b"\0")
        overall.update(digest.encode("ascii"))
        overall.update(b"\0")
    return {
        "schema_version": SCHEMA_VERSION,
        "root": str(root),
        "source": source,
        "exclude": excludes,
        "sha256": overall.hexdigest(),
        "files": manifest,
    }


def schema_mismatch(before: dict[str, Any], after: dict[str, Any]) -> str | None:
    """Диагностика несовпадения версий схемы отпечатков, иначе None.

    Baseline, снятый другой версией алгоритма, сравнивать нельзя: иначе
    получится масса ложных CHANGED из-за смены формата дайджеста (RW-103).
    """
    before_version = before.get("schema_version")
    after_version = after.get("schema_version")
    if before_version != after_version:
        return (
            f"SCHEMA_VERSION_MISMATCH before={before_version!r} "
            f"after={after_version!r}: incompatible fingerprint schemas, "
            "re-create the baseline with --write"
        )
    return None


def compare(before: dict[str, Any], after: dict[str, Any]) -> list[str]:
    mismatch = schema_mismatch(before, after)
    if mismatch is not None:
        # Не показываем массовые CHANGED от несовместимого baseline.
        return [mismatch]
    old_files = before.get("files", {})
    new_files = after.get("files", {})
    if not isinstance(old_files, dict) or not isinstance(new_files, dict):
        return ["snapshot does not contain a valid files manifest"]
    old_set = set(old_files)
    new_set = set(new_files)
    changes = [f"ADDED {name}" for name in sorted(new_set - old_set)]
    changes += [f"REMOVED {name}" for name in sorted(old_set - new_set)]
    changes += [
        f"CHANGED {name}"
        for name in sorted(old_set & new_set)
        if old_files[name] != new_files[name]
    ]
    return changes


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--exclude", action="append", default=[])
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--write", type=Path)
    group.add_argument("--compare", type=Path)
    args = parser.parse_args()

    root = args.root.resolve()
    if not root.is_dir():
        print(f"ERROR: repository root is not a directory: {root}", file=sys.stderr)
        return 2

    excludes = args.exclude or [".git/**"]
    current = snapshot(root, excludes)

    if args.write:
        args.write.parent.mkdir(parents=True, exist_ok=True)
        args.write.write_text(
            json.dumps(current, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
        print(f"FINGERPRINT {current['sha256']} files={len(current['files'])}")
        return 0

    try:
        before = json.loads(args.compare.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"ERROR: cannot read baseline fingerprint: {exc}", file=sys.stderr)
        return 2

    mismatch = schema_mismatch(before, current)
    if mismatch is not None:
        print(f"ERROR: {mismatch}", file=sys.stderr)
        return 2

    changes = compare(before, current)
    if changes:
        print("WORKTREE_CHANGED", file=sys.stderr)
        for change in changes:
            print(change, file=sys.stderr)
        return 1
    print(f"WORKTREE_UNCHANGED {current['sha256']} files={len(current['files'])}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
