        fragment = """
#!/usr/bin/env python3
"""Validate structured handoffs for the Coder → Reviewer dev-cycle pipeline.

Summarizer исключён из dev-цикла: PR-текст собирает родитель, rework после
панели техлидов — teamlead-gate/panel-rework-summarizer. Роль ``summarizer``
поддерживается только как legacy-валидатор исторических handoff'ов.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any

from validate_role_plan import RolePlanError, validate_role_plan


class ValidationError(ValueError):
    """Raised when a handoff violates its contract."""


def require_object(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValidationError(f"{label}: expected object")
    return value


def require_list(value: Any, label: str) -> list[Any]:
    if not isinstance(value, list):
        raise ValidationError(f"{label}: expected array")
    return value


def require_string(data: dict[str, Any], key: str, *, nonempty: bool = True) -> str:
    value = data.get(key)
    if not isinstance(value, str):
        raise ValidationError(f"{key}: expected string")
    if nonempty and not value.strip():
        raise ValidationError(f"{key}: must not be empty")
    return value


def require_int(data: dict[str, Any], key: str, *, minimum: int = 0) -> int:
    value = data.get(key)
    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:
        raise ValidationError(f"{key}: expected integer >= {minimum}")
    return value


def require_enum(data: dict[str, Any], key: str, allowed: set[str]) -> str:
    value = require_string(data, key)
    if value not in allowed:
        raise ValidationError(
            f"{key}: expected one of {sorted(allowed)}, got {value!r}"
        )
    return value


def validate_common(data: dict[str, Any], role: str) -> None:
    version = require_string(data, "schema_version")
    if version not in {"1.0", "1.1"}:
        raise ValidationError("schema_version: only '1.0' or '1.1' is supported")
    if require_string(data, "role") != role:
        raise ValidationError(f"role: expected {role!r}")
    require_string(data, "task_id")
    role_plan = require_object(data.get("role_plan"), "role_plan")
    plan_path = require_string(role_plan, "path")
    safe_relative_path(plan_path, "role_plan.path")
    if "plans" not in Path(plan_path).parts or not plan_path.endswith(".json"):
        raise ValidationError("role_plan.path: expected a JSON file inside plans/")
    plan_hash = require_string(role_plan, "sha256")
    if re.fullmatch(r"[0-9a-f]{64}", plan_hash) is None:
        raise ValidationError("role_plan.sha256: expected 64 lowercase hex characters")


def validate_bound_role_plan(
    handoff: dict[str, Any], role: str, plan_path: Path
) -> None:
    """Bind a handoff to the completed plan that produced it."""
    try:
        raw = plan_path.read_bytes()
        plan = json.loads(raw.decode("utf-8"))
        if not isinstance(plan, dict):
            raise RolePlanError("plan root must be an object")
        validate_role_plan(plan, "after")
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RolePlanError) as exc:
        raise ValidationError(f"role_plan: invalid completed plan: {exc}") from exc

    if plan.get("role") != role:
        raise ValidationError(
            f"role_plan.role: expected {role!r}, got {plan.get('role')!r}"
        )
    handoff_iteration = handoff.get("iteration")
    if handoff_iteration is not None and plan.get("iteration") != handoff_iteration:
        raise ValidationError("role_plan.iteration does not match handoff iteration")

    role_plan = require_object(handoff.get("role_plan"), "role_plan")
    referenced_path = Path(require_string(role_plan, "path"))
    if referenced_path.name != plan_path.name:
        raise ValidationError("role_plan.path does not match supplied plan file")
    actual_hash = hashlib.sha256(raw).hexdigest()
    if require_string(role_plan, "sha256") != actual_hash:
        raise ValidationError("role_plan.sha256 does not match supplied plan file")

    blocked = any(step.get("status") == "BLOCKED" for step in plan["steps"])
    outcome = handoff.get("status", handoff.get("verdict", handoff.get("decision")))
    if blocked and outcome != "BLOCKED":
        raise ValidationError(
            "role_plan contains BLOCKED step but handoff is not BLOCKED"
        )


def safe_relative_path(raw: str, label: str) -> Path:
    path = Path(raw)
    if path.is_absolute() or ".." in path.parts:
        raise ValidationError(f"{label}: path must stay inside repository: {raw!r}")
    return path


def validate_commands(value: Any, label: str) -> None:
    for index, item in enumerate(require_list(value, label)):
        command = require_object(item, f"{label}[{index}]")
        require_string(command, "command")
        require_int(command, "exit_code", minimum=0)


def validate_coder(data: dict[str, Any]) -> None:
    validate_common(data, "coder")
    require_int(data, "iteration", minimum=1)
    status = require_enum(data, "status", {"DONE", "BLOCKED"})
    require_string(data, "summary")
    changed_files = require_list(data.get("changed_files"), "changed_files")
    for index, item in enumerate(changed_files):
        if not isinstance(item, str) or not item.strip():
            raise ValidationError(f"changed_files[{index}]: expected non-empty string")
        safe_relative_path(item, f"changed_files[{index}]")
    validate_commands(data.get("commands"), "commands")
    require_list(data.get("acceptance_coverage"), "acceptance_coverage")
    require_list(data.get("assumptions"), "assumptions")
    require_list(data.get("risks"), "risks")
    open_questions = require_list(data.get("open_questions"), "open_questions")
    next_role = require_enum(data, "next_role", {"reviewer", "orchestrator"})
    if status == "DONE" and next_role != "reviewer":
        raise ValidationError("DONE coder handoff must set next_role='reviewer'")
    if status == "BLOCKED" and not open_questions:
        raise ValidationError("BLOCKED coder handoff must explain open_questions")


def validate_finding(item: Any, index: int, root: Path | None) -> tuple[bool, str]:
    finding = require_object(item, f"findings[{index}]")
    finding_id = require_string(finding, "id")
    require_enum(finding, "severity", {"critical", "major", "minor"})
    require_string(finding, "category")
    blocking = finding.get("blocking")
    if not isinstance(blocking, bool):
        raise ValidationError(f"findings[{index}].blocking: expected boolean")
    status = require_enum(finding, "status", {"CONFIRMED", "INCONCLUSIVE"})
    require_string(finding, "problem")
    require_string(finding, "requested_change")

    if blocking and status != "CONFIRMED":
        raise ValidationError(f"{finding_id}: INCONCLUSIVE finding cannot block")

    if status == "CONFIRMED":
        raw_file = require_string(finding, "file")
        relative = safe_relative_path(raw_file, f"{finding_id}.file")
        require_int(finding, "line", minimum=1)
        evidence = require_string(finding, "evidence")
        if root is not None:
            target = (root / relative).resolve()
            try:
                target.relative_to(root)
            except ValueError as exc:
                raise ValidationError(f"{finding_id}: file escapes repository") from exc
            if not target.is_file():
                raise ValidationError(
                    f"{finding_id}: evidence file does not exist: {raw_file}"
                )
            content = target.read_text(encoding="utf-8", errors="replace")
            if evidence not in content:
                raise ValidationError(
                    f"{finding_id}: evidence is not present in {raw_file}"
                )
    return blocking, status


def validate_reviewer(
    data: dict[str, Any],
    root: Path | None,
    *,
    entry_override: str | None = None,
) -> None:
    validate_common(data, "reviewer")
    require_int(data, "iteration", minimum=1)
    verdict = require_enum(data, "verdict", {"MERGE", "CHANGES_REQUESTED", "BLOCKED"})
    spec_verdict = require_enum(data, "spec_verdict", {"PASS", "FAIL", "INCONCLUSIVE"})
    quality_verdict = require_enum(
        data, "quality_verdict", {"PASS", "FAIL", "INCONCLUSIVE"}
    )
    require_string(data, "summary")
    findings = require_list(data.get("findings"), "findings")
    confirmed_blockers = 0
    for index, item in enumerate(findings):
        blocking, status = validate_finding(item, index, root)
        confirmed_blockers += int(blocking and status == "CONFIRMED")
    validate_commands(data.get("checks"), "checks")
    require_list(data.get("residual_risks"), "residual_risks")
    # Summarizer удалён из dev-цикла: MERGE ведёт к Orchestrator (Verifier →
    # FINAL_GATE), 'summarizer' остаётся только legacy-ролью validate_summarizer.
    next_role = require_enum(data, "next_role", {"coder", "orchestrator"})
    # Вход прогона (entry): review-only не возвращает к Coder; неизвестное
    # значение — fail-closed. Явный --entry (из state.json) действует, даже
    # когда поля entry в handoff нет; расхождение handoff и --entry — тоже
    # fail-closed.
    handoff_entry = data.get("entry")
    if handoff_entry is not None and handoff_entry not in {"full", "review-only"}:
        raise ValidationError("entry: expected 'full' or 'review-only'")
    if entry_override is not None and entry_override not in {"full", "review-only"}:
        raise ValidationError("entry: expected 'full' or 'review-only'")
    if (
        entry_override is not None
        and handoff_entry is not None
        and entry_override != handoff_entry
    ):
        raise ValidationError(
            f"entry mismatch: handoff={handoff_entry!r}, --entry={entry_override!r}"
        )
    entry = entry_override or handoff_entry or "full"

    if verdict == "MERGE":
        if spec_verdict != "PASS" or quality_verdict != "PASS":
            raise ValidationError(
                "MERGE requires spec_verdict=PASS and quality_verdict=PASS"
            )
        if confirmed_blockers:
            raise ValidationError(
                "MERGE reviewer handoff contains confirmed blocking findings"
            )
        if next_role != "orchestrator":
            raise ValidationError(
                "MERGE reviewer handoff must set next_role='orchestrator'"
            )
    elif verdict == "CHANGES_REQUESTED":
        if spec_verdict != "FAIL" and quality_verdict != "FAIL":
            raise ValidationError("CHANGES_REQUESTED requires FAIL on spec or quality")
        if not confirmed_blockers:
            raise ValidationError(
                "CHANGES_REQUESTED requires a confirmed blocking finding"
            )
        if entry == "review-only":
            # review-only: Coder не стартует (REVIEW_CHANGES → ESCALATE,
            # findings уходят родителю) — handoff ведёт к orchestrator.
            if next_role != "orchestrator":
                raise ValidationError(
                    "CHANGES_REQUESTED on review-only must set next_role='orchestrator'"
                )
        elif next_role != "coder":
            raise ValidationError("CHANGES_REQUESTED must set next_role='coder'")
    else:
        if spec_verdict != "INCONCLUSIVE" and quality_verdict != "INCONCLUSIVE":
            raise ValidationError("BLOCKED requires INCONCLUSIVE on spec or quality")
        if next_role != "orchestrator":
            raise ValidationError(
                "BLOCKED reviewer handoff must set next_role='orchestrator'"
            )


def validate_string_list(
    data: dict[str, Any], key: str, *, nonempty: bool = False
) -> None:
    values = require_list(data.get(key), key)
    if nonempty and not values:
        raise ValidationError(f"{key}: must not be empty")
    for index, item in enumerate(values):
        if not isinstance(item, str) or not item.strip():
            raise ValidationError(f"{key}[{index}]: expected non-empty string")


def _resolve_evidence_text(
    *,
    claim_id: str,
    evidence_type: str,
    evidence_ref: str,
    root: Path | None,
    artifacts_dir: Path | None,
) -> str | None:
    """Return file text to search for evidence_span, or None if not checking on disk."""
    if root is None and artifacts_dir is None:
        return None

    relative = safe_relative_path(evidence_ref, f"{claim_id}.evidence_ref")

    if evidence_type == "file":
        if root is None:
            return None
        base = root
    elif evidence_type in {"log", "gate", "diff"}:
        # Prefer run artifacts dir; fall back to repo-relative path under root.
        if artifacts_dir is not None:
            base = artifacts_dir
        elif root is not None:
            base = root
        else:
            return None
    else:
        raise ValidationError(f"{claim_id}: unknown evidence_type {evidence_type!r}")

    target = (base / relative).resolve()
    try:
        target.relative_to(base.resolve())
    except ValueError as exc:
        raise ValidationError(
            f"{claim_id}: evidence_ref escapes base: {evidence_ref}"
        ) from exc
    if not target.is_file():
        raise ValidationError(
            f"{claim_id}: evidence file does not exist: {evidence_ref}"
        )
    return target.read_text(encoding="utf-8", errors="replace")


def validate_claim_ledger(
    data: dict[str, Any],
    *,
    root: Path | None,
    artifacts_dir: Path | None,
    require_all_grounded: bool,
) -> None:
    ledger = require_list(data.get("claim_ledger"), "claim_ledger")
    if not ledger:
        raise ValidationError("claim_ledger: must not be empty")

    changes = require_list(data.get("changes"), "changes")
    change_texts = {item.strip() for item in changes if isinstance(item, str)}
    claim_texts: set[str] = set()
    seen_ids: set[str] = set()
    ungrounded = 0

    for index, item in enumerate(ledger):
        claim = require_object(item, f"claim_ledger[{index}]")
        claim_id = require_string(claim, "claim_id")
        if claim_id in seen_ids:
            raise ValidationError(f"claim_ledger: duplicate claim_id {claim_id!r}")
        seen_ids.add(claim_id)
        text = require_string(claim, "text")
        claim_texts.add(text.strip())
        evidence_type = require_enum(
            claim, "evidence_type", {"file", "diff", "log", "gate"}
        )
        evidence_ref = require_string(claim, "evidence_ref")
        evidence_span = require_string(claim, "evidence_span")
        status = require_enum(
            claim, "status", {"GROUNDED", "UNGROUNDED", "INCONCLUSIVE"}
        )

        content = _resolve_evidence_text(
            claim_id=claim_id,
            evidence_type=evidence_type,
            evidence_ref=evidence_ref,
            root=root,
            artifacts_dir=artifacts_dir,
        )
        if content is not None:
            present = evidence_span in content
            if status == "GROUNDED" and not present:
                raise ValidationError(
                    f"{claim_id}: status=GROUNDED but evidence_span not found in {evidence_ref}"
                )
            if status == "UNGROUNDED" and present:
                raise ValidationError(
                    f"{claim_id}: status=UNGROUNDED but evidence_span is present in {evidence_ref}"
                )

        if status == "UNGROUNDED":
            ungrounded += 1

    missing = change_texts - claim_texts
    if missing:
        sample = sorted(missing)[:3]
        raise ValidationError(
            "claim_ledger: every changes[] bullet must appear as claim text; "
            f"missing e.g. {sample}"
        )

    if require_all_grounded and ungrounded:
        raise ValidationError(
            "READY_FOR_PR requires all claim_ledger statuses GROUNDED "
            f"(found {ungrounded} UNGROUNDED); use decision=REWORK"
        )
    if require_all_grounded:
        for index, item in enumerate(ledger):
            claim = require_object(item, f"claim_ledger[{index}]")
            if claim.get("status") == "INCONCLUSIVE":
                raise ValidationError(
                    f"{claim['claim_id']}: READY_FOR_PR forbids INCONCLUSIVE claims; "
                    "use REWORK or move to residual risks / follow_ups"
                )


def validate_summarizer(
    data: dict[str, Any],
    *,
    root: Path | None = None,
    artifacts_dir: Path | None = None,
) -> None:
    validate_common(data, "summarizer")
    decision = require_enum(data, "decision", {"READY_FOR_PR", "REWORK", "BLOCKED"})
    source_verdict = require_enum(
        data, "source_review_verdict", {"MERGE", "CHANGES_REQUESTED", "BLOCKED"}
    )
    require_string(data, "title")
    require_string(data, "why")
    validate_string_list(data, "changes", nonempty=True)
    test_plan = require_list(data.get("test_plan"), "test_plan")
    if not test_plan:
        raise ValidationError("test_plan: must include deterministic gate evidence")
    for index, item in enumerate(test_plan):
        check = require_object(item, f"test_plan[{index}]")
        require_string(check, "command")
        require_string(check, "result")
    validate_string_list(data, "risks")
    require_string(data, "rollback")
    validate_string_list(data, "follow_ups")
    validate_string_list(data, "evidence_files", nonempty=True)

    next_role = data.get("next_role")
    if next_role is not None:
        require_enum(data, "next_role", {"coder", "orchestrator", "final_gate"})

    # Claim ledger is mandatory for summarizer (schema 1.1 contract; also required on 1.0).
    require_all_grounded = decision == "READY_FOR_PR"
    validate_claim_ledger(
        data,
        root=root,
        artifacts_dir=artifacts_dir,
        require_all_grounded=require_all_grounded,
    )

    if decision == "READY_FOR_PR":
        if source_verdict != "MERGE":
            raise ValidationError("READY_FOR_PR requires source_review_verdict='MERGE'")
        if next_role is not None and next_role != "final_gate":
            raise ValidationError(
                "READY_FOR_PR next_role must be 'final_gate' when set"
            )
    elif decision == "REWORK":
        if source_verdict not in {"MERGE", "CHANGES_REQUESTED"}:
            raise ValidationError(
                "REWORK requires source_review_verdict MERGE or CHANGES_REQUESTED"
            )
        if next_role is not None and next_role != "coder":
            raise ValidationError("REWORK next_role must be 'coder' when set")
        rework_reason = data.get("rework_reason")
        if not isinstance(rework_reason, str) or not rework_reason.strip():
            raise ValidationError("REWORK requires non-empty rework_reason")
    else:  # BLOCKED
        if next_role is not None and next_role != "orchestrator":
            raise ValidationError("BLOCKED next_role must be 'orchestrator' when set")
        open_questions = data.get("open_questions")
        if not isinstance(open_questions, list) or not open_questions:
            raise ValidationError("BLOCKED requires non-empty open_questions")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("role", choices=("coder", "reviewer", "summarizer"))
    parser.add_argument("handoff", type=Path)
    parser.add_argument(
        "--role-plan",
        type=Path,
        required=True,
        help="Completed ROLE PLAN referenced by the handoff",
    )
    parser.add_argument(
        "--root",
        type=Path,
        help="Repository root for reviewer evidence / summarizer file claims",
    )
    parser.add_argument(
        "--artifacts-dir",
        type=Path,
        help="Run artifacts dir for summarizer diff/log/gate claim checks",
    )
    parser.add_argument(
        "--entry",
        choices=("full", "review-only"),
        default=None,
        help=(
            "Run entry from state.json (reviewer checks): review-only forbids "
            "next_role='coder' and must match handoff entry when both are set"
        ),
    )
    args = parser.parse_args(argv)

    try:
        raw = args.handoff.read_text(encoding="utf-8")
        data = require_object(json.loads(raw), "handoff")
        root = args.root.resolve() if args.root else None
        artifacts_dir = args.artifacts_dir.resolve() if args.artifacts_dir else None
        if args.role == "coder":
            validate_coder(data)
        elif args.role == "reviewer":
            validate_reviewer(data, root, entry_override=args.entry)
        else:
            validate_summarizer(data, root=root, artifacts_dir=artifacts_dir)
        validate_bound_role_plan(data, args.role, args.role_plan)
    except (OSError, json.JSONDecodeError, ValidationError) as exc:
        print(f"INVALID: {exc}", file=sys.stderr)
        return 1

    print(f"VALID: role={args.role} file={args.handoff}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

