    E['steps']['H8']={'status':'PASS' if expected and h.get('active')==0 and not new and structured and client_gone and len(exits)>=7 else 'FAIL','request_count':5,'requests_passed':sum(x.get('status')=='PASS' for x in load),'early_disconnect_ms':load[4].get('client_closed_ms'),'final_health':h,'new_opencode_processes':new,'structured_o_exit':structured,'o_exit_count':len(exits),'client_gone_logged':client_gone,'log_path':str(LOG),'log_offset_start':LOG_OFFSET,'at':NOW()}
