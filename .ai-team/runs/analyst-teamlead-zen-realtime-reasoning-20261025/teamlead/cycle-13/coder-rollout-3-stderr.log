            timer=threading.Timer(max(0,1.5-(time.monotonic()-t0)),cancel_socket);timer.start()
        r=c.getresponse();result.update(http_status=r.status,headers_ms=round((time.monotonic()-t0)*1000,3),content_type=r.getheader('Content-Type'))
        emit('headers',name=name,status=r.status,elapsed_ms=result['headers_ms'])
        if r.status!=200:
            result['error_body']=r.read().decode(errors='replace')[:1500];result['status']='FAIL';return result
        if not stream:
            body=json.loads(r.read());result['response']=body
            msg=(body.get('choices') or [{}])[0].get('message',{})
            result.update(content_chars=len(msg.get('content') or ''),reasoning_chars=len(msg.get('reasoning_content') or ''),usage=body.get('usage'))
            u=result.get('usage');result['valid_usage']=isinstance(u,dict) and all(isinstance(u.get(k),int) and u[k]>=0 for k in ('prompt_tokens','completion_tokens','total_tokens'))
            result['status']='PASS' if result['content_chars']>0 and result['valid_usage'] else 'FAIL'
        else:
