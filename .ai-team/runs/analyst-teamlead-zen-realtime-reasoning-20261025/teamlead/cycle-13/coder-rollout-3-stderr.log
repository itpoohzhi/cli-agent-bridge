                line=r.readline()
                if not line:break
                if not line.startswith(b'data:'):continue
                data=line[5:].strip();elapsed=round((time.monotonic()-t0)*1000,3)
                if data==b'[DONE]':result.update(done=True,done_ms=elapsed);break
                obj=json.loads(data);delta=((obj.get('choices') or [{}])[0]).get('delta',{})
                rc=delta.get('reasoning_content');cc=delta.get('content')
                entry={'t_ms':elapsed,'reasoning_chars':len(rc or ''),'content_chars':len(cc or '')}
                if rc:
                    if result['ttfr_ms'] is None:result['ttfr_ms']=elapsed;emit('first_reasoning',name=name,elapsed_ms=elapsed,preview=rc[:100])
                    thought.append(rc);result['reasoning_chunks_count']+=1
                if cc:
                    if result['ttft_ms'] is None:result['ttft_ms']=elapsed;emit('first_content',name=name,elapsed_ms=elapsed)
                    text.append(cc);result['content_chunks_count']+=1
                for choice in obj.get('choices',[]):
                    if choice.get('finish_reason') is not None:result['finish_reason']=choice['finish_reason'];entry['finish_reason']=choice['finish_reason'];result['finish_ms']=elapsed
                if obj.get('usage') is not None:result['usage']=obj['usage'];entry['usage']=obj['usage'];result['usage_ms']=elapsed
                result['chunks'].append(entry)
            result['reasoning_content']=''.join(thought);result['content']=''.join(text)
            result['reasoning_before_content']=result['ttfr_ms'] is not None and result['ttft_ms'] is not None and result['ttfr_ms']<result['ttft_ms']
