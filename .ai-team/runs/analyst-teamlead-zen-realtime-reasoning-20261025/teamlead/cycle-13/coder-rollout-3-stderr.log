            try:s.shutdown(socket.SHUT_RDWR)
            except OSError:pass
            try:s.close()
            except OSError:pass
        emit('client_closed',name=name,elapsed_ms=result['client_closed_ms'])
    emit('request_started',name=name,stream=stream,cancel=cancel)
    try:
        payload={'model':MODEL,'reasoning_effort':'high','stream':stream,'max_tokens':2048,'messages':[{'role':'user','content':PROMPT+'Вариант проверки: '+name}]}
        if stream:payload['stream_options']={'include_usage':True}
