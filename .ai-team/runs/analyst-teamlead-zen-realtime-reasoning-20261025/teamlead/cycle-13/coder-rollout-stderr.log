    c=http.client.HTTPConnection('127.0.0.1',9883,timeout=5)
    try:
        c.request('GET','/health');r=c.getresponse();return {'http_status':r.status,**json.loads(r.read())}
    finally:c.close()

def processes():
    raw=subprocess.run(['ps','-axo','pid=,ppid=,comm=,args='],capture_output=True,text=True,check=True,timeout=5).stdout
    out=[]
    for line in raw.splitlines():
        p=line.strip().split(None,3)
        if len(p)==4 and 'opencode' in p[2].lower() and any(x in p[3] for x in (' serve ',' run ')):
            out.append({'pid':int(p[0]),'ppid':int(p[1]),'comm':p[2],'kind':'serve' if ' serve ' in p[3] else 'run'})
    return out

def find_key():
    candidates=[]
    if os.environ.get('OPENCODE_ZEN_BRIDGE_KEY'):candidates.append(('process environment',os.environ['OPENCODE_ZEN_BRIDGE_KEY']))
    raw=subprocess.run(['launchctl','print',f'gui/{os.getuid()}/com.user.dsh-opencode-zen-bridge'],capture_output=True,text=True,timeout=5).stdout
    for m in re.finditer(r'"'^'"\\s*OPENCODE_ZEN_BRIDGE_KEY\\s*=>\\s*(.*?)\\s*"'$'"',raw,re.M):candidates.append(('LaunchAgent environment',m.group(1)))
    pp=pathlib.Path.home()/'Library/LaunchAgents/com.user.dsh-opencode-zen-bridge.plist'
    if pp.exists():
        obj=plistlib.loads(pp.read_bytes()); k=obj.get('EnvironmentVariables',{}).get('OPENCODE_ZEN_BRIDGE_KEY')
        if k:candidates.append(('LaunchAgent plist',k))
    for path in [LIVE/'start.sh',pathlib.Path('/Users/aazhiry1/.dsh/.env')]:
        if not path.exists():continue
        for line in path.read_text().splitlines():
            m=re.match(r'"'^'"\\s*(?:export\\s+)?OPENCODE_ZEN_BRIDGE_KEY\\s*=\\s*(.*?)\\s*"'$'"',line)
            if m:
                try:v=shlex.split(m.group(1),comments=True)[0]
                except (ValueError,IndexError):continue
                if '"'$'"' not in v:candidates.append((str(path),v))
    for origin,k in candidates:
        c=http.client.HTTPConnection('127.0.0.1',9883,timeout=5)
        try:
            c.request('GET','/v1/models',headers={'Authorization':'Bearer '+k})
            r=c.getresponse();r.read()
            if r.status==200:return origin,k
        finally:c.close()
    raise RuntimeError('No candidate bridge key authenticated; no secrets printed')

def monitor():
    while not STOP.wait(10):
        try:
            h=health(); snap={'at':NOW(),'probe_pid':os.getpid(),'probe_pgid':os.getpgrp(),'health':h,'steps':{k:v.get('status') for k,v in E['steps'].items()},'log_bytes':LOG.stat().st_size if LOG.exists() else 0}
            (CEL/'facts.md').write_text(json.dumps(snap,ensure_ascii=False,indent=2)+'\\n')
            emit('facts',active=h.get('active'),log_bytes=snap['log_bytes'])
        except Exception as ex:emit('facts_error',error=type(ex).__name__)

PROMPT=('Реши задачу планирования без инструментов и внешних обращений. Есть 3 независимых сервера по 10 задач/с каждый. '
        'Поток 18 задач/с, при отказе одного поток остаётся прежним. Среднее время обработки 0.08 с. '
        'Повторные запросы могут добавить 15% трафика. 1) Вычисли загрузку до и после отказа с повторами. '
        '2) По закону Литтла оцени число одновременно выполняемых запросов. 3) Сравни запас с порогом 80%. '
        '4) Предложи минимальную дополнительную ёмкость. Дай проверяемые вычисления и итог в 8-12 строках. ')

def request(name,stream=True,cancel=False):
    t0=time.monotonic(); result={'name':name,'model':MODEL,'reasoning_effort':'high','stream':stream,'cancel_requested':cancel,'started_at':NOW(),'chunks':[]}
    c=http.client.HTTPConnection('127.0.0.1',9883,timeout=150)
    timer=None;closed=threading.Event()
    def cancel_socket():
        result['client_closed_ms']=round((time.monotonic()-t0)*1000,3);closed.set()
        s=c.sock
        if s:
            try:s.shutdown(socket.SHUT_RDWR)
            except OSError:pass
            try:s.close()
            except OSError:pass
        emit('client_closed',name=name,elapsed_ms=result['client_closed_ms'])
    emit('request_started',name=name,stream=stream,cancel=cancel)
    try:
        payload={'model':MODEL,'reasoning_effort':'high','stream':stream,'max_tokens':2048,'messages':[{'role':'user','content':PROMPT+'Вариант проверки: '+name}]}
        if stream:payload['stream_options']={'include_usage':True}
        c.request('POST','/v1/chat/completions',json.dumps(payload).encode(),{'Content-Type':'application/json','Authorization':'Bearer '+KEY})
        if cancel:
            timer=threading.Timer(max(0,1.5-(time.monotonic()-t0)),cancel_socket);timer.start()
        r=c.getresponse();result.update(http_status=r.status,headers_ms=round((time.monotonic()-t0)*1000,3),content_type=r.getheader('Content-Type'))
        emit('headers',name=name,status=r.status,elapsed_ms=result['headers_ms'])
        if r.status"'!=200:
            result['"'error_body']=r.read().decode(errors='replace')[:1500];result['status']='FAIL';return result
        if not stream:
            body=json.loads(r.read());result['response']=body
            msg=(body.get('choices') or [{}])[0].get('message',{})
            result.update(content_chars=len(msg.get('content') or ''),reasoning_chars=len(msg.get('reasoning_content') or ''),usage=body.get('usage'))
            u=result.get('usage');result['valid_usage']=isinstance(u,dict) and all(isinstance(u.get(k),int) and u[k]>=0 for k in ('prompt_tokens','completion_tokens','total_tokens'))
            result['status']='PASS' if result['content_chars']>0 and result['valid_usage'] else 'FAIL'
        else:
            result.update(reasoning_chunks_count=0,content_chunks_count=0,done=False,finish_reason=None,usage=None,ttfr_ms=None,ttft_ms=None)
            thought=[];text=[]
            while True:
                if time.monotonic()-t0>240:raise TimeoutError('Probe total deadline 240s')
                line=r.readline()
                if not line:break
                if not line.startswith(b'data:'):continue
                data=line[5:].strip();elapsed=round((time.monotonic()-t0)*1000,3)
                if data==b'[DONE]':result.update(done=True,done_ms=elapsed);break
                obj=json.loads(data);delta=((obj.get('choices') or [{}])[0]).get('delta',{})
                rc=delta.get('reasoning_content');cc=delta.get('content')
                entry={'t_ms':elapsed,'reasoning_chars':len(rc or ''),'content_chars':len(cc or '')}
                if rc:
                    if result['ttfr_ms'] is None:result['ttfr_ms']=elapsed;emit('first_reasoning',name=name,elapsed_ms=elapsed,preview=rc[:100])
                    thought.append(rc);result['reasoning_chunks_count']+=1
                if cc:
                    if result['ttft_ms'] is None:result['ttft_ms']=elapsed;emit('first_content',name=name,elapsed_ms=elapsed)
                    text.append(cc);result['content_chunks_count']+=1
                for choice in obj.get('choices',[]):
                    if choice.get('finish_reason') is not None:result['finish_reason']=choice['finish_reason'];entry['finish_reason']=choice['finish_reason'];result['finish_ms']=elapsed
                if obj.get('usage') is not None:result['usage']=obj['usage'];entry['usage']=obj['usage'];result['usage_ms']=elapsed
                result['chunks'].append(entry)
            result['reasoning_content']=''.join(thought);result['content']=''.join(text)
            result['reasoning_before_content']=result['ttfr_ms'] is not None and result['ttft_ms'] is not None and result['ttfr_ms']<result['ttft_ms']
            result['live_progress_first_seconds']=result['ttfr_ms'] is not None and result['ttfr_ms']<5000
            u=result.get('usage');result['valid_usage']=isinstance(u,dict) and all(isinstance(u.get(k),int) and u[k]>=0 for k in ('prompt_tokens','completion_tokens','total_tokens'))
            result['status']='PASS' if all([result['done'],result['finish_reason'],result['valid_usage'],text,result['reasoning_chunks_count']>=2,result['reasoning_before_content'] or result['live_progress_first_seconds']]) else 'FAIL'
        return result
    except Exception as ex:
        result['status']='EXPECTED_CLIENT_DISCONNECT' if cancel and closed.is_set() else 'FAIL'
        result['error_type']=type(ex).__name__;result['error']=str(ex)[:300]
        return result
    finally:
        if timer:timer.cancel()
        c.close();result['total_ms']=round((time.monotonic()-t0)*1000,3)
        if cancel and closed.is_set():result['status']='EXPECTED_CLIENT_DISCONNECT'
        emit('request_completed',name=name,status=result.get('status'),total_ms=result['total_ms'],reasoning_chunks_count=result.get('reasoning_chunks_count'),ttfr_ms=result.get('ttfr_ms'),ttft_ms=result.get('ttft_ms'))
        (CEL/(name+'.json')).write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n')

def run():
    global KEY
    h=health();ls=subprocess.run(['lsof','-nP','-iTCP:9883','-sTCP:LISTEN'],capture_output=True,text=True,timeout=5)
    E['steps']['H2']={'status':'PASS' if h.get('ok') is True and h.get('active')==0 and ls.returncode==0 and E['restart']['rc']==0 else 'FAIL','health':h,'lsof':ls.stdout,'at':NOW()};save()
    assert E['steps']['H2']['status']=='PASS','H2 failed'
    origin,KEY=find_key();E['auth_source']=origin;E['bridge_log_offset_before_requests']=LOG_OFFSET;save()
    emit('authenticated',source=origin)
    threading.Thread(target=monitor,daemon=True).start()
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        f1=pool.submit(request,'single-sse',True);f2=pool.submit(request,'single-json',False)
        s,j=f1.result(),f2.result()
    E['single_sse']=s;E['single_json']=j
    E['steps']['H3']={'status':'PASS' if s.get('http_status')==200 else 'FAIL','headers_ms':s.get('headers_ms')}
    E['steps']['H4']={'status':'PASS' if s.get('reasoning_chunks_count',0)>=2 and (s.get('reasoning_before_content') or s.get('live_progress_first_seconds')) else 'FAIL','ttfr_ms':s.get('ttfr_ms'),'reasoning_chunks_count':s.get('reasoning_chunks_count')}
    E['steps']['H5']={'status':'PASS' if s.get('ttft_ms') is not None and s.get('content') else 'FAIL','ttft_ms':s.get('ttft_ms')}
    E['steps']['H6']={'status':'PASS' if s.get('done') and s.get('finish_reason') and s.get('valid_usage') else 'FAIL','finish_reason':s.get('finish_reason'),'usage':s.get('usage'),'done':s.get('done')}
    E['steps']['H7']={'status':j['status'],'http_status':j.get('http_status'),'total_ms':j.get('total_ms'),'usage':j.get('usage')};save()
    if s.get('http_status')==401 or j.get('http_status')==401:raise RuntimeError('Auth rejected for completion')
    E['load_baseline_health']=health();E['load_baseline_processes']=processes();save()
    barrier=threading.Barrier(5)
    def worker(i):
        barrier.wait(timeout=10)
        return request('load-'+str(i),stream=(i"'!=3),cancel=(i==4))
    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
        futs=[pool.submit(worker,i) for i in range(5)]
        load=[f.result() for f in futs]
    E['"'parallel_requests']=load;save()
    checks=[];until=time.monotonic()+75
    while True:
        h=health();p=processes();checks.append({'at':NOW(),'health':h,'opencode_processes':p})
        before={x['pid'] for x in E['preflight_opencode_processes']}
        new=[x for x in p if x['pid'] not in before]
        if h.get('active')==0 and not new:break
        if time.monotonic()>until:break
        STOP.wait(2)
    with LOG.open('rb') as f:f.seek(LOG_OFFSET);log_delta=f.read().decode(errors='replace')
    exits=[line for line in log_delta.splitlines() if 'O-EXIT/v1' in line]
    (CEL/'o-exit-lines.log').write_text('\\n'.join(exits)+'\\n')
    fields=('transport=','first_event_ms=','ttft_ms=','exit_reason=')
    structured=bool(exits) and all(all(key in line for key in fields) for line in exits)
    client_gone=any('exit_reason=client_gone' in line for line in exits)
    expected=len(load)==5 and all(x.get('status')=='PASS' for x in load[:4]) and load[4].get('status')=='EXPECTED_CLIENT_DISCONNECT'
    E['cleanup_checks']=checks;E['o_exit_lines']=exits
    E['steps']['H8']={'status':'PASS' if expected and h.get('active')==0 and not new and structured and client_gone and len(exits)>=7 else 'FAIL','request_count':5,'requests_passed':sum(x.get('status')=='PASS' for x in load),'early_disconnect_ms':load[4].get('client_closed_ms'),'final_health':h,'new_opencode_processes':new,'structured_o_exit':structured,'o_exit_count':len(exits),'client_gone_logged':client_gone,'log_path':str(LOG),'log_offset_start':LOG_OFFSET,'at':NOW()}
    E['VER-006-live-sse-heavy-path']='PASS' if all(E['steps'][f'H{i}']['status']=='PASS' for i in range(3,9)) else 'FAIL'
    E['VER-007-deployed-mirror-diff']='PASS' if all(x['diff_rc']==0 for x in E['steps']['H1']['synced']) else 'FAIL'
    E['finished_at']=NOW();E['status']='PASS' if all(x['status']=='PASS' for x in E['steps'].values()) else 'FAIL'
    E['steps']['H9']={'status':'PASS','receipt_path':str(RECEIPT),'execution_evidence_path':str(RUN/'execution-evidence.md'),'at':NOW()}
    save();report()
    emit('verification_complete',status=E['status'],steps={k:v['status'] for k,v in E['steps'].items()})
    return 0 if E['status']=='PASS' else 1

def report():
    lines=['# L3 — выкатка :9883 и тяжёлая проверка H0..H9','',f'Начало: {E[\"started_at\"]}; завершение: {E.get(\"finished_at\",NOW())}.',f'Итог: **{E[\"status\"]}**.','', '## Допуск','PANEL PROOF: '+E['panel_proof']['path']+' sha256='+E['panel_proof']['sha256']+' verify_panel_proof exit=0.','ACCEPT — существующий итоговый консенсус-леджер teamlead/final-panel-verdict.md, решение владельца 2026-10-28 02:51 MSK.','', '## H0–H9']
    for k,v in E['steps'].items():lines += [f'### {k}: {v[\"status\"]}','"'```json'"',json.dumps(v,ensure_ascii=False,indent=2),'"'```'"','']
    lines+=['## Особенности выкатки','- Указанный в брифе ключ OPENCODE_ZEN_REALTIME_REASONING_ENABLED не читается кодом. В live dynamic_config.json сохранены оба ключа; действующий REALTIME_SERVE_ENABLED=true. Репозиторный dynamic_config.json отсутствует.','- /health возвращает ok:true (не status:ok).','- Бэкап server.py и существующего теста сохранён; исходный dynamic_config.json отсутствовал.','', '## Живые запросы']
    for key in ['single_sse','single_json']:
        v=E.get(key,{});summary={k:v[k] for k in ['name','status','http_status','headers_ms','ttfr_ms','ttft_ms','reasoning_chunks_count','content_chunks_count','finish_reason','usage','done','valid_usage','total_ms'] if k in v}
        lines+=['"'```json'"',json.dumps(summary,ensure_ascii=False,indent=2),'"'```'"']
    lines+=['', '## O-EXIT/v1','"'```'"',*E.get('o_exit_lines',[]),'"'```'"','', '## Ограничения','Проверены реальные запросы к развернутому мосту, включая 5 одновременных запросов и ранний обрыв. DSH Desktop UI и существующий пользовательский чат в рамках этого брифа не проверялись. Другие модели и выключение флага на живом запросе не проверялись. Результат H0..H9 не подменяет эти проверки.','', '## Артефакты',f'Полные метрики, SSE timeline и ответы: {RECEIPT}.',f'Фоновый guarded-прогон, по одному файлу на запрос: {CEL}.','']
    (RUN/'execution-evidence.md').write_text('\\n'.join(lines))

if __name__=='__main__':
    try:rc=run()
    except BaseException as ex:
        E['status']='FAIL';E['probe_error']={'type':type(ex).__name__,'message':str(ex)[:500]};E['finished_at']=NOW();save();report();emit('fatal',error_type=type(ex).__name__,message=str(ex)[:300]);rc=1
    finally:STOP.set()
    (CEL/'probe.done').write_text(str(rc)+'\\n')
    raise SystemExit(rc)
