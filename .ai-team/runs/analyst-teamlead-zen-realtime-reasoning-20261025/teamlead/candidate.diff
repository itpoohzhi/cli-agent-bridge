+class TestHelperProcess(unittest.TestCase):
+    """RW-001/RW-005: процесс --serve-helper (errno до ветки helper, добивание группы)."""
+
+    def _helper_cmd(self, tmp: Path, bin_path: str) -> list[str]:
+        return [
+            sys.executable,
+            "-I",
+            str(Path(server.__file__).resolve()),
+            "--serve-helper",
+            "attemptH",
+            "43211",
+            bin_path,
+            str(tmp / "leases"),
