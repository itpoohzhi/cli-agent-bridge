+    def cleanup(self) -> None:
+        """Идемпотентная уборка только своей группы процессов."""
+        with self._lock:
+            if self._closed:
+                return
+            self._closed = True
+        try:
+            os.close(self.lifeline_w)
+        except OSError:
+            pass
+        _deadline = time.monotonic() + 4.0
