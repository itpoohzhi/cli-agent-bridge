+        parsed: dict[str, object] = {}
+        if raw:
+            parsed = _as_dict(_loads_object(raw.decode("utf-8", "replace")))
+        return int(resp.status), parsed
+    finally:
+        stopped.set()
+        if own_conn:
+            active_conn.close()
