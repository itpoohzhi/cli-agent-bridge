+        except (AttributeError, ValueError):
+            check_phase()
+            raise
+        if on_headers is not None:
+            on_headers(int(resp.status))
+        if skip_body:
+            active_conn.close()
+            resp.close()
+            return int(resp.status), {}
+        raw = bytearray()
+        while not resp.isclosed():
+            check_phase()
+            try:
+                chunk = resp.read1(65536)
+            except (AttributeError, ValueError):
+                check_phase()
+                raise
+            check_phase()
+            if not chunk:
+                break
+            raw.extend(chunk)
+            if len(raw) > _MAX_SERVE_HTTP_BODY_BYTES:
+                active_conn.close()
+                resp.close()
