+                        exit_logged.set()
+
+                gone = [False]
+                limiter = self.bridge.httpd.resilience.spawn_limiter
+
+                def reserve(*_args: object, **_kw: object) -> bool:
+                    if cancel:
+                        gone[0] = True
+                    else:
+                        time.sleep(0.08)
