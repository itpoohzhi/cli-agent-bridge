atus}\")\n3405:         if status != 200 or not isinstance(active.get(\"data\"), dict):\nSOURCE 3410 3442\n3410:         model_body: dict[str, object] = {\n3411:             \"providerID\": provider or \"opencode\",\n3412:             \"id\": raw_id or model,\n3413:         }\n3414:         if variant:\n3415:             model_body[\"variant\"] = variant\n3416:         status, created = _ctrl_http(\n3417:             \"POST\",\n3418:             \"/api/session\",\n3419:             {\n3420:                 \"location\": {\"directory\": str(workdir)},\n3421:                 \"model\": model_body,\n3422:                 \"permissions\": [\n3423:                     {\n3424:                         \"action\": \"*\",\n3425:                         \"resource\": \"*\",\n3426:                         \"effect\": _serve_permission_effect(),\n3427:                     }\n3428:                 ],\n3429:             },\n3430:             timeout=3.0,\n3431:         )\n3432:         if status in (401, 403):\n3433:             raise ServeSecurityError(f\"serve create HTTP {status}\")\n3434:         if status in (400, 404, 422):\n3435:             raise ServeSecurityError(f\"serve invalid request HTTP {status}\")\n3436:         created_data = created.get(\"data\")\n3437:         if (\n3438:             status != 200\n3439:             or not isinstance(created_data, dict)\n3440:             or not created_data.get(\"id\")\n3441:         ):\n3442:             raise ServeUnavailable(f\"serve create HTTP {status}\")\nSOURCE 3640 3685\n3640:                     )\n3641:                     if st not in (200, 204):\n3642:                         raise ServeSecurityError(f\"form cancel HTTP {st}\")\n3643:                     st2, _b2 = _ctrl_http(\n3644:                         \"POST\",\n3645:                         f\"/api/session/{session_id}/interrupt\",\n3646:                         None,\n3647:                         timeout=0.25,\n3648:                     )\n3649:         