"session.tool.called\",\n                \"session.tool.failed\",\n                \"session.tool.success\",\n            ):\n                done = tool_state.complete(str(mapped[1].get(\"id\") or \"\"), event_type)\n                if done is not None:\n                    result[\"native_calls\"].append(done[1])\n                    on_tool(done[1])\n            continue\n        if mapped is not None and mapped[0] == \"step_finish\":\n            for call_id in list(tool_state.tools):\n                done = tool_state.complete(call_id, event_type)\n                if done is not None:\n                    result[\"native_calls\"].append(done[1])\n                    on_tool(done[1])\n            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                usage[key] = usage.get(key, 0) + _as_int(mapped[1].get(key))\n            return True\n    return False\n\n\n1535:FIRST_TOKEN_TIMEOUT_S = float(\n1536:    os.environ.get(\"OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S\", \"60.0\")\n1582:_MAX_SERVE_QUEUE_BYTES = 16 * 1024 * 1024\n1583:_MAX_SERVE_ACCUMULATED_BYTES = 16 * 1024 * 1024\n1584:_MAX_SERVE_HTTP_BODY_BYTES = 8 * 1024 * 1024\n1662:        \"event\": \"first_event_timeout20s, no response headers and no valid execution SSE\",\n1670:        \"event\": \"first_event_timeout20s after headers, no valid execution SSE\",\n1826:def _read_dynamic_config_enabled(path: Path | None = None) -> bool:\n1853:_dynamic_config_enabled = _read_dynamic_config_enabled\n1928:    enabled = override in (\"1\", \"true\", \"yes\", \"on\") or _read_dynamic_config_enabled()\n2164:def _log(msg: str) -> None:\n2540:    def attempt_done(self, transient_failure: bool, success: bool) -> None:\n2554:    def commit(self) -> None:\n2653:    phase_socket: list[socket.socket | None],\n2663:                sock = conn.sock or phase_socket[0]\n2703:            _ = conn.sock.settimeout(timeout)\n2705:    phase_socket: list[socket.socket | None] = [None]\n2707:        active_conn, d