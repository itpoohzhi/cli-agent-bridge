7:         line_bytes = b\"\"\n3088:         while not line_bytes.endswith(b\"\\n\"):\n3089:             _check_serve_start(deadline, is_client_gone)\n3090:             if time.monotonic() >= _hs_deadline:\n3091:                 raise ServeUnavailable(\"serve helper handshake timeout\")\n3092:             _ready, _w2, _x2 = select.select(\n3093:                 [out_fd], [], [], min(0.05, max(0.0, _hs_deadline - time.monotonic()))\n3094:             )\n3095:             if not _ready:\n3096:                 continue\n3097:             chunk_b = os.read(out_fd, 1)\n3098:             if not chunk_b:\n3099:                 break\n3100:             line_bytes += chunk_b\n3101:         line = line_bytes.decode(\"utf-8\", \"replace\")\n3102:         handshake = _as_dict(_loads_object(line)) if line else {}\n3103:         serve_pid = _as_int(handshake.get(\"serve_pid\"))\n3104:         pgid = _as_int(handshake.get(\"pgid\"))\n3105:         lease.serve_pid = serve_pid\n3106:         if not serve_pid or pgid != helper.pid or helper.poll() is not None:\n3107:             raise ServeUnavailable(\"serve ownership handshake mismatch\")\n3108:         _check_serve_start(deadline, is_client_gone)\n3109:         _listener_deadline = (\n3110:             min(time.monotonic() + 3.0, deadline)\n\nRANGE 3420 3690\n3420:             for method, path in (\n3421:                 (\"POST\", f\"/api/session/{session_id}/interrupt\"),\n3422:                 (\"DELETE\", f\"/api/session/{session_id}\"),\n3423:             ):\n3424:                 try:\n3425:                     _ = _serve_http(\n3426:                         port,\n3427:                         password,\n3428:                         method,\n3429:                         path,\n3430:                         timeout=0.25,\n3431:                         deadline=cleanup_deadline,\n3432:                         skip_body=True,\n3433:                     )\n3434:                 except (OSError, http.client.HTTPException):\n34