for x in byfile[f]:\\n            line = x['range']['start']['line']+1\\n            if any(lo<=line<=hi for lo,hi in ranges[f]):\\n                assert x.get('rule') not in {'reportAny','reportExplicitAny','reportUnusedCallResult'}, x\\n    # Do not introduce Any annotations/type ignores in added code in either legacy file.\\n    for f in files[:2]:\\n        src = f.read_text().splitlines()\\n        for lo,hi in ranges[f]:\\n            for line in src[lo-1:hi]:\\n                assert not re.search(r'\\\\bAny\\\\b|type:\\\\s*ignore|pyright:\\\\s*ignore|#\\\\s*noqa|#\\\\s*fmt:\\\\s*off',line), (f,line)\\n    run(['python3','-B','-m','unittest','tests.test_catalog_mode','-v'],cwd=bridge)\\n    print('PASS VER-004: all3 lint/type; legacy changed-range format; newfile whole format; server counts',dict(counts))\\nfinally:\\n    if project is not None: project.unlink(missing_ok=True)\\nVER004\",\n        \"cwd\": \".\"\n      },\n      {\n        \"id\": \"L2-VER-001-pytest-component\",\n        \"cmd\": \"uvx pytest -q -p no:cacheprovider tests/\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      },\n      {\n        \"id\": \"L2-VER-002-unittest-discover\",\n        \"cmd\": \"python3 -m unittest discover -s tests -p 'test_*.py'\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      },\n      {\n        \"id\": \"L2-VER-003-pytest-root-import\",\n        \"cmd\": \"PYTHONPATH=. uvx pytest -q -p no:cacheprovider bridges/opencode-zen-bridge/tests/\",\n        \"cwd\": \".\"\n      },\n      {\n        \"id\": \"L2-VER-005-realtime-and-fault-oracles\",\n        \"cmd\": \"uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py tests/test_step_interruption.py tests/test_run_env.py tests/test_google_direct.py tests/test_catalog_mode.py\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      }\n    ],\n    \"L3\": {\n      \"status_pre_accept\": \"N/A_REPO_MARKERS_PLUS_POST_ACCEPT_LIVE_HEAVY_PATH\",\n      \"note\": \"Repo has no pytest heav