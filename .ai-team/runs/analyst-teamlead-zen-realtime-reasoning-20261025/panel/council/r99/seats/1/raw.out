{"type":"tool_call","subtype":"completed","call_id":"call-3e72f5fb-c02a-4066-b018-ba1ba98bb919-9\nfc_e1f95d39-36e5-9e50-b8b6-7dea1ca064fe_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":1768,"limit":40},"result":{"success":{"content":"    prompt_status: int | None\n    transient_error: bool\n\n\ndef _as_dict(value: object) -> dict[str, object]:\n    \"\"\"Объект как словарь с строковыми ключами, иначе пустой.\"\"\"\n    if isinstance(value, dict):\n        return {str(k): v for k, v in value.items()}\n    return {}\n\n\ndef _combine_surrogates(value: object) -> object:\n    \"\"\"Склеить суррогатные пары UTF-16 в строках после json.loads.\"\"\"\n    if isinstance(value, str):\n        try:\n            return value.encode(\"utf-16\", \"surrogatepass\").decode(\"utf-16\")\n        except UnicodeError as exc:\n            raise ServeProtocolError(\n                \"invalid unpaired surrogate in serve event\"\n            ) from exc\n    if isinstance(value, dict):\n        return {\n            str(_combine_surrogates(str(k))): _combine_surrogates(v)\n            for k, v in value.items()\n        }\n    if isinstance(value, list):\n        return [_combine_surrogates(v) for v in value]\n    return value\n\n\ndef _loads_object(raw: str) -> dict[str, object] | None:\n    \"\"\"JSON-объект стандартным json.loads; не-объект или битый JSON — None.\"\"\"\n    try:\n        parsed: object = cast(object, json.loads(raw))\n    except (ValueError, TypeError):\n        return None\n    if isinstance(parsed, dict):\n        combined = _combine_surrogates({str(k): v for k, v in parsed.items()})\n        return combined if isinstance(combined, dict) else None\n    return None","isEmpty":false,"exceededLimit":false,"totalLines":8171,"fileSize":357118,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"start