{"type":"tool_call","subtype":"completed","call_id":"call-3a8b7206-da9a-42a2-bd7a-2cbad94d5fad-5\nfc_56af7b4c-0bcf-9502-a2bd-23ae89b4f1c9_0","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/scripts/select_round_seats.py","offset":100,"limit":160},"result":{"success":{"content":"    \"replaced_seats\",\n    \"triplet_rule\",\n    \"hat_level\",\n    \"selector_sha256\",\n]\n\n\nclass SelectionError(ValueError):\n    \"\"\"Нарушен контракт выбора или целостность входов.\"\"\"\n\n\ndef require(condition: Any, message: str) -> None:\n    \"\"\"Отказывает по закрытому умолчанию.\"\"\"\n    if not condition:\n        raise SelectionError(message)\n\n\ndef digest(data: bytes) -> str:\n    \"\"\"SHA-256 байтов без нормализации.\"\"\"\n    return hashlib.sha256(data).hexdigest()\n\n\ndef canonical_json(value: Any) -> bytes:\n    \"\"\"Канонические байты записи журнала без перевода строки.\"\"\"\n    return json.dumps(\n        value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")\n    ).encode(\"utf-8\")\n\n\ndef selector_sha256() -> str:\n    \"\"\"Хеш именно исполняемого исходника.\"\"\"\n    return digest(Path(__file__).read_bytes())\n\n\ndef is_hex(value: Any) -> bool:\n    return isinstance(value, str) and HEX64.fullmatch(value) is not None\n\n\ndef integer(value: Any, minimum: int = 1) -> bool:\n    return type(value) is int and value >= minimum\n\n\ndef validate_round_dir(round_dir: Path) -> tuple[Path, str, int]:\n    \"\"\"Разбирает нормативный путь <RUN>/panel/<stage>/r<R>.\"\"\"\n    path = round_dir.resolve(strict=True)\n    require(path.is_dir(), \"round-dir is not a directory\")\n    require(\n        len(path.parts) >= 4\n        and path.parent.parent.name == \"panel\"\n        and path.parent.name in ALLOWED_STAGES\n        and re.fullmatch(r\"r[1-9]\\d*\", path.name),\n        \"round-dir must match <RUN>/panel/<stage>/r<R>\",\n    )\n    return path.parents[2], path.parent.name, int(path.name[1:])\n\n\ndef manifest_mode(manifest: dict[str, Any], run_dir: Path) -> str:\n    \"\"\"Схема v2 включает новые гейты; наличие журнала запрещает downgrade.\"\"\"\n    schema = manifest.get(\"schema\")\n    if schema == \"pol-manifest/2\":\n        return \"v1.1\"\n    require(schema is not None or \"schema\" not in manifest, \"unknown manifest schema\")\n    require(schema in (None, \"pol-manifest/1\"), \"unknown manifest schema\")\n    require(\n        not (run_dir / \"panel/history.jsonl\").exists(),\n        \"manifest lacks pol-manifest/2 while history.jsonl exists\",\n    )\n    return \"v1\"\n\n\ndef validate_table(table: dict[str, Any]) -> None:\n    \"\"\"Проверяет инвариант одного канонического слота на семейство в пуле.\"\"\"\n    require(table.get(\"schema\") == \"pol-transports/2\", \"expected pol-transports/2\")\n    require(is_hex(table.get(\"models_md_sha256\")), \"invalid models_md_sha256\")\n    require(\n        table.get(\"models_md_sha8\") == table[\"models_md_sha256\"][:8],\n        \"models_md_sha8 mismatch\",\n    )\n    slots, setups, aliases = (\n        table.get(\"slots\"),\n        table.get(\"setups\"),\n        table.get(\"aliases\"),\n    )\n    require(\n        isinstance(slots, dict)\n        and isinstance(setups, dict)\n        and isinstance(aliases, dict),\n        \"invalid table sections\",\n    )\n    require(set(setups) == {\"default\", \"quality\", \"fast\"}, \"invalid setups\")\n    for setup, pool in setups.items():\n        require(\n            isinstance(pool, list)\n            and len(pool) >= 3\n            and all(isinstance(s, str) and s in slots for s in pool),\n            f\"invalid pool {setup}\",\n        )\n        families = [slots[s].get(\"family\") for s in pool]\n        require(\n            all(isinstance(f, str) and f for f in families)\n            and len(set(families)) == len(pool),\n            \"duplicate family in setup\",\n        )\n        for slot in pool:\n            transports = slots[slot].get(\"transports\")\n            require(\n                isinstance(transports, list) and transports, f\"no transports: {slot}\"\n            )\n            names = [t.get(\"transport\") for t in transports]\n            require(\n                all(isinstance(t, str) and t for t in names)\n                and len(set(names)) == len(names),\n                \"invalid transports\",\n            )\n    for name, target in aliases.items():\n        require(\n            isinstance(name, str) and isinstance(target, str) and target in slots,\n            \"invalid alias\",\n        )\n        require(\n            \"/\" not in name or name.split(\"/\", 1)[0] in setups, \"unknown alias setup\"\n        )\n\n\ndef normalize_slot(name: str, setup: str, table: dict[str, Any]) -> str:\n    \"\"\"Нормализует до хеширования, с приоритетом alias сетапа.\"\"\"\n    require(setup in table[\"setups\"], \"UNKNOWN_SETUP\")\n    pool = table[\"setups\"][setup]\n    if name in pool:\n        return name\n    target = table[\"aliases\"].get(f\"{setup}/{name}\", table[\"aliases\"].get(name))\n    require(target in pool, f\"UNKNOWN_SLOT: {name} in {setup}\")\n    return target\n\n\ndef rank_slots(seed_hex: str, slots: list[str]) -> list[str]:\n    \"\"\"Полный пул, отсортированный по rank_hash и каноническому id.\"\"\"\n    return sorted(slots, key=lambda s: (digest(f\"{seed_hex}#{s}\".encode()), s))\n\n\ndef triplet_indices(n: int):\n    \"\"\"Перебор по возрастанию (i3, i2, i1).\"\"\"\n    for i3 in range(2, n):\n        for i2 in range(1, i3):\n            for i1 in range(i2):\n                yield i1, i2, i3\n\n\ndef family_set(seats: list[dict[str, Any]]) -> set[str]:\n    return {s[\"family\"] for s in seats}\n\n\ndef pairs(seats: list[dict[str, Any]]) -> set[tuple[str, int]]:\n    return {(s[\"family\"], s[\"k\"]) for s in seats}\n\n\ndef logical_rounds(rows: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:\n    \"\"\"Порядок generate с последним состоянием каждой пары (stage, round).\"\"\"\n    latest: dict[tuple[str, int], list[dict[str, Any]]] = {}\n    for row in rows:","isEmpty":false,"exceededLimit":false,"totalLines":1471,"fileSize":55007,"path":"/Users/aazhiry1/Мой диск/skils/ai-sdlc/universal/teamlead-gate/scripts/select_round_seats.py","readRange":{"startLine":100,"endLine":259},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-3a8b7206-da9a-42a2-bd7a-2cbad94d5fad-5\nfc_56af7b4c-0bcf-9502-a2bd-23ae89b4f1c9_0","startedAtMs":"1793110784885","completedAtMs":"1793110785150"},"model_call_id":"1f11edfd-1e61-49c1-8d0b-853cfea82eb4-3-car5","session_id":"19ff3711-8616-4e27-9cdc-cf417278844f","timestamp_ms":1793110785243}
