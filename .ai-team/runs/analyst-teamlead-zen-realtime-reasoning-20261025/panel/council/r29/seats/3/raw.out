{"type":"tool_call","subtype":"completed","call_id":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-7\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_5","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":810,"limit":30},"result":{"success":{"content":"PLAN_MAX_TEXT = 600        # признак 4\nPREAMBLE_MAX_CHARS = 420   # признак 5\nPREAMBLE_MAX_LINES = 6\nPREAMBLE_SHORT_CHARS = 220\n\n# Mid-stream `etype == \"error\"`: транзиентные сбои (повторяем) против детерминированных (Fail-Closed).\n_FATAL_STREAM_STATUSES = (400, 401, 403, 404, 422)\n_TRANSIENT_ERROR_MARKERS = (\n    \"econnreset\", \"etimedout\", \"timeout\", \"timed out\", \"socket hang up\", \"interrupted\", \"overloaded\",\n    \"rate limit\", \"temporarily unavailable\", \"fetch failed\", \"network\", \"connection reset\", \"broken pipe\", \"eof\",\n)\n\n\ndef _strip_interrupted(text: str) -> str:\n    \"\"\"Убрать артефакт SYNTHETIC-продолжения opencode («I was interrupted right before…»).\"\"\"\n    return _INTERRUPTED_RE.sub(\"\", text)\n\n\ndef _has_interrupted_marker(text: str) -> bool:\n    low = text.lower()\n    return any(marker in low for marker in _INTERRUPT_MARKERS)\n\n\ndef _is_forced_tool_choice(tool_choice: Any) -> bool:\n    return tool_choice == \"required\" or bool(_tool_choice_name(tool_choice))\n\n\ndef _is_ident_char(char: str) -> bool:\n    return char == \"_\" or (char.isascii() and char.isalnum())\n","isEmpty":false,"exceededLimit":false,"totalLines":6992,"fileSize":317368,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":810,"endLine":839},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-7\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_5","startedAtMs":"1793063495664","completedAtMs":"1793063495721"},"model_call_id":"554121ca-3ede-4a3f-a6c5-62d323bbe7d0-3-cafn","session_id":"64927e40-cd34-4ba8-892c-5ffed7c2791b","timestamp_ms":1793063495749}
{"type":"tool_call","subtype":"started","call_id":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-8\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_6","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5175,"limit":180}},"hookAdditionalContexts":[],"toolCallId":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-8\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_6","startedAtMs":"1793063496041"},"model_call_id":"554121ca-3ede-4a3f-a6c5-62d323bbe7d0-3-cafn","session_id":"64927e40-cd34-4ba8-892c-5ffed7c2791b","timestamp_ms":1793063496069}
{"type":"tool_call","subtype":"completed","call_id":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-8\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_6","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5175,"limit":180},"result":{"success":{"content":"                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(\"serve spawn limit reached\"))\n                return True\n            _orig_reasoning, _orig_text = on_reasoning, on_text\n\n            _prior_text = \"\".join(collected_texts)\n            _dedup_text = (\n                _PrefixDedup(_prior_text) if serve_attempts and _prior_text else None\n            )\n\n            def _text_seen(text: str, _f: Callable[[str], None] = _orig_text) -> None:\n                if _dedup_text is not None:\n                    text = _dedup_text.push(text)\n                    if not text:\n                        return\n                delivered_any[0] = True\n                _f(text)\n\n            gate = _StartupGate()\n            gate.acquire()\n            _limiter_ok = res.spawn_limiter.acquire(\n                max_wait_s=min(SPAWN_WAIT_MAX_S, attempts.remaining_s())\n            )\n            if not _limiter_ok:\n                gate.release()\n                if not force_serve:\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(\"serve spawn limiter timeout\"))\n                return True\n            attempts.note_spawn()\n            if serve_attempts and first_visible.is_set():\n                # Единая точка разделителя: ровно один на каждый повтор, любая причина.\n                on_status(\n                    f\"[мост] Повтор попытки {attempts.total_spawns}/{attempts.max_total}…\\n\"\n                )\n            serve_attempts += 1\n            try:\n                result = _serve_one_attempt(\n                    model,\n                    current_prompt,\n                    effort,\n                    workdir,\n                    _orig_reasoning,\n                    _text_seen,\n                    on_tool,\n                    attempts.deadline - TIMEOUT_S,\n                    is_client_gone=self._client_gone_check,\n                    on_status=attempt_status,\n                    thinking_enabled=thinking,\n                    deadline=attempts.deadline,\n                    on_startup_ready=gate.release,\n                    emulate_tools=emulate_tools,\n                )\n            except ServeUnavailable as exc:\n                res.serve_health.record_failure()\n                if not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve unavailable: {exc}\"))\n                return True\n            except ServeSecurityError as exc:\n                xs[\"exit_reason\"] = \"provider_fatal\"\n                self._sse_error(_error_payload(f\"serve security failure: {exc}\"))\n                return True\n            finally:\n                gate.release()\n            if \"first_event_ms\" not in xs or xs.get(\"first_event_ms\") is None:\n                xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            if \"ttft_ms\" not in xs or xs.get(\"ttft_ms\") is None:\n                xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if parser_box[0] is not None:\n                parser_box[0].finish()\n            if result.get(\"exit_reason\") == \"client_gone\":\n                xs[\"exit_reason\"] = \"client_gone\"\n                return True\n            if \"first_event_ms\" not in xs or xs.get(\"first_event_ms\") is None:\n                xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            if \"ttft_ms\" not in xs or xs.get(\"ttft_ms\") is None:\n                xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            _delivered_now = bool(\n                delivered_any[0]\n                or result.get(\"delivered\")\n                or result[\"texts\"]\n                or result[\"reasonings\"]\n                or result[\"native_calls\"]\n            )\n            if result.get(\"exit_reason\") in (\n                \"first_event_timeout\",\n                \"first_token_timeout\",\n                \"stall_timeout\",\n                \"invalid_serve_event\",\n                \"timeout\",\n            ):\n                reason = str(result[\"exit_reason\"])\n                if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n                    res.serve_health.record_failure()\n                else:\n                    attempts.attempt_done(True, False)\n                if not _delivered_now and not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(reason):\n                    _u = result[\"usage\"]\n                    _acc = self._serve_stream_usage or {}\n                    for _k in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                        _acc[_k] = int(_acc.get(_k) or 0) + int(_u.get(_k) or 0)\n                    self._serve_stream_usage = _acc\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._sse_error(_error_payload(f\"serve {reason}\"))\n                return True\n            if result.get(\"prompt_status\") is not None:\n                _ps_code = int(result[\"prompt_status\"] or 0)\n                if _ps_code == 429 or 500 <= _ps_code <= 599:\n                    attempts.attempt_done(True, False)\n                if not _delivered_now and not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(f\"prompt_status_{_ps_code}\"):\n                    continue\n                xs[\"exit_reason\"] = f\"prompt_status_{_ps_code}\"\n                self._sse_error(_error_payload(f\"serve prompt HTTP {_ps_code}\"))\n                return True\n            if result.get(\"exit_reason\") in (\"prompt_status_429\",):\n                attempts.attempt_done(True, False)\n                if attempts.allow_retry(\"prompt_status_429\"):\n                    continue\n                xs[\"exit_reason\"] = \"prompt_status_429\"\n                self._sse_error(_error_payload(\"serve prompt HTTP 429\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                if result.get(\"transient_error\"):\n                    attempts.attempt_done(True, False)\n                    _delivered_err = _delivered_now or bool(collected_texts)\n                    if not _delivered_err and not force_serve:\n                        xs[\"transport\"] = \"run\"\n                        xs[\"transport_history\"] = [\"serve\", \"run\"]\n                        return False\n                    if not _delivered_err and attempts.allow_retry(\n                        \"serve_transient_error\"\n                    ):\n                        continue\n                    # После частичной доставки: step-interruption recovery ниже по incomplete-сигналу.\n                    signal_t = _incomplete_step_signal(\n                        \"\".join(result[\"texts\"]),\n                        \"\".join(result[\"reasonings\"]),\n                        tools or [],\n                        True,\n                        int(result[\"usage\"].get(\"output\") or 0),\n                        int(result[\"usage\"].get(\"reasoning\") or 0),\n                        tool_choice=tool_choice,\n                    )\n                    if signal_t and attempts.allow_retry(\"incomplete_step\"):\n                        attempts.signal = signal_t\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _incomplete_tool_step_prompt(\n                                prompt,\n                                \"\".join(collected_texts),\n                                tools or [],\n                                tool_choice,\n                                model,\n                            ),\n                            model,\n                        )\n                        continue\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve error: {err.get('message')}\"))\n                return True\n            res.serve_health.record_success()\n            attempts.attempt_done(False, True)\n            usage_cur = result[\"usage\"]\n            usage_acc = self._serve_stream_usage or {}\n            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                usage_acc[key] = int(usage_acc.get(key) or 0) + int(","isEmpty":false,"exceededLimit":false,"totalLines":6992,"fileSize":317368,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5175,"endLine":5354},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-f94bd4b9-697a-4dce-8d5d-d05432d584b4-8\nfc_fcada0f6-bed1-92c6-804f-abc8ef8f2e5b_6","startedAtMs":"1793063496041","completedAtMs":"1793063496098"},"model_call_id":"554121ca-3ede-4a3f-a6c5-62d323bbe7d0-3-cafn","session_id":"64927e40-cd34-4ba8-892c-5ffed7c2791b","timestamp_ms":1793063496127}
