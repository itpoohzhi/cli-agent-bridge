rd = threading.Lock()\n        self._timer: threading.Timer | None = None\n\n    def acquire(self) -> None:","isEmpty":false,"exceededLimit":false,"totalLines":6992,"fileSize":317368,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1910,"endLine":1949},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-ed2f2323-7754-4766-b8fb-7c665e286f6b-19\nfc_1b6a4fd6-4c4e-9abe-9251-9d049418bac7_3","startedAtMs":"1793063514144","completedAtMs":"1793063514198"},"model_call_id":"554121ca-3ede-4a3f-a6c5-62d323bbe7d0-4-5gen","session_id":"64927e40-cd34-4ba8-892c-5ffed7c2791b","timestamp_ms":1793063514225}
