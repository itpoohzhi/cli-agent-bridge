{"type":"tool_call","subtype":"started","call_id":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-5\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_0","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":2560,"limit":80}},"hookAdditionalContexts":[],"toolCallId":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-5\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_0","startedAtMs":"1793072647474"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-1-x9ir","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072647507}
{"type":"tool_call","subtype":"completed","call_id":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-5\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_0","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":2560,"limit":80},"result":{"success":{"content":"    body: dict[str, object] | None = None,\n    timeout: float = 3.0,\n    conn: http.client.HTTPConnection | None = None,\n    on_headers: Callable[[], None] | None = None,\n    deadline: float | None = None,\n    is_client_gone: Callable[[], bool] | None = None,\n) -> tuple[int, dict[str, object]]:\n    \"\"\"Один HTTP-вызов serve с Basic-авторизацией без прокси.\"\"\"\n    own_conn = conn is None\n    active_conn = (\n        conn\n        if conn is not None\n        else http.client.HTTPConnection(\"127.0.0.1\", port, timeout=timeout)\n    )\n    if conn is not None:\n        conn.timeout = timeout\n        if conn.sock is not None:\n            _ = conn.sock.settimeout(timeout)\n\n    phase_socket: socket.socket | None = None\n\n    def check_phase() -> None:\n        \"\"\"Ограничить следующую фазу оставшимся бюджетом и проверить отмену.\"\"\"\n        if is_client_gone is not None and is_client_gone():\n            raise BrokenPipeError(errno.EPIPE, \"client gone\")\n        remaining = (\n            timeout if deadline is None else min(timeout, deadline - time.monotonic())\n        )\n        if remaining <= 0:\n            raise TimeoutError(\"serve deadline exceeded\")\n        active_conn.timeout = remaining\n        connected_socket = active_conn.sock or phase_socket\n        if connected_socket is not None:\n            _ = connected_socket.settimeout(remaining)\n\n    try:\n        check_phase()\n        payload = json.dumps(body).encode(\"utf-8\") if body is not None else None\n        auth = base64.b64encode(f\"opencode:{password}\".encode(\"utf-8\")).decode(\"ascii\")\n        headers = {\"Authorization\": f\"Basic {auth}\", \"Content-Type\": \"application/json\"}\n        active_conn.request(method, path, payload, headers)\n        # HTTP/1.0 отделяет сокет от conn после заголовков; бюджет тела остаётся обязательным.\n        phase_socket = active_conn.sock\n        check_phase()\n        resp = active_conn.getresponse()\n        if on_headers is not None:\n            on_headers()\n        raw = bytearray()\n        while not resp.isclosed():\n            check_phase()\n            chunk = resp.read1(65536)\n            if not chunk:\n                break\n            raw.extend(chunk)\n        parsed: dict[str, object] = {}\n        if raw:\n            parsed = _as_dict(_loads_object(raw.decode(\"utf-8\", \"replace\")))\n        return int(resp.status), parsed\n    finally:\n        if own_conn:\n            active_conn.close()\n\n\nclass _ServeLease:\n    \"\"\"Владение деревом helper->serve одной попытки.\"\"\"\n\n    def __init__(\n        self,\n        helper: subprocess.Popen[str],\n        serve_pid: int,\n        pgid: int,\n        lifeline_w: int,\n        lease_dir: Path,\n        attempt_id: str,\n        state_dir: str,\n        port: int = 0,\n    ) -> None:\n        self.helper = helper\n        self.serve_pid = serve_pid\n        self.pgid = pgid","isEmpty":false,"exceededLimit":false,"totalLines":7487,"fileSize":328750,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2560,"endLine":2639},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-5\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_0","startedAtMs":"1793072647474","completedAtMs":"1793072647589"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-1-x9ir","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072647620}
{"type":"tool_call","subtype":"started","call_id":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-6\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":3460,"limit":160}},"hookAdditionalContexts":[],"toolCallId":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-6\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_1","startedAtMs":"1793072647719"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-1-x9ir","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072647750}
{"type":"tool_call","subtype":"completed","call_id":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-6\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":3460,"limit":160},"result":{"success":{"content":"                continue\n            if result[\"step_closed\"] and etype in (\"reasoning\", \"text\"):\n                continue\n            if etype == \"reasoning\":\n                text_value = str(payload.get(\"reasoning_content\") or \"\")\n                if text_value:\n                    if result[\"first_token_at\"] is None:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"reasonings\"].append(text_value)\n                    last_token_at = time.monotonic()\n                    on_reasoning(text_value)\n            elif etype == \"text\":\n                text_value = str(payload.get(\"content\") or \"\")\n                if text_value:\n                    if result[\"first_token_at\"] is None:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"texts\"].append(text_value)\n                    last_token_at = time.monotonic()\n                    on_text(text_value)\n            elif etype == \"tool_event\":\n                if (\n                    etype_raw == \"session.tool.input.delta\"\n                    and result[\"first_token_at\"] is not None\n                ):\n                    last_token_at = time.monotonic()\n                tool_state.feed(payload)\n                call_id = str(payload.get(\"id\") or \"\")\n                if etype_raw in (\n                    \"session.tool.called\",\n                    \"session.tool.failed\",\n                    \"session.tool.success\",\n                ):\n                    done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                        if result[\"first_token_at\"] is None:\n                            result[\"first_token_at\"] = time.monotonic()\n                            result[\"ttft_ms\"] = int(\n                                ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                            )\n            elif etype == \"step_finish\":\n                step_key = str(\n                    _as_dict(payload).get(\"assistantMessageID\")\n                    or data_raw.get(\"assistantMessageID\")\n                    or \"\"\n                )\n                if step_key and step_key in seen_steps:\n                    continue\n                if step_key:\n                    seen_steps.add(step_key)\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n                        payload.get(key)\n                    )\n                # Завершить native вызовы без called: аргументы из input.ended.text.\n                for call_id in list(tool_state.tools):\n                    done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                if result[\"native_calls\"] or (\n                    emulate_tools and _split_tool_calls([\"\".join(result[\"texts\"])])[1]\n                ):\n                    if result[\"first_token_at\"] is None and result[\"native_calls\"]:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"terminal\"] = \"tool_calls\"\n                    break\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"transient_error\"] = _is_transient_stream_error(payload)\n                result[\"terminal\"] = \"failed\"\n                break\n            elif etype_raw == \"session.execution.succeeded\":\n                result[\"terminal\"] = \"succeeded\"\n                break\n        if (\n            not result[\"terminal\"]\n            and not result[\"exit_reason\"]\n            and time.monotonic() >= deadline\n        ):\n            result[\"exit_reason\"] = \"timeout\"\n        return result\n    finally:\n        _se = locals().get(\"stop_event\")\n        if isinstance(_se, threading.Event):\n            _se.set()\n        if sse_conn is not None:\n            if sse_conn.sock is not None:\n                try:\n                    _ = sse_conn.sock.shutdown(socket.SHUT_RDWR)\n                except OSError:\n                    pass\n            try:\n                sse_conn.close()\n            except OSError:\n                pass\n        for _th_name in (\"reader_thread\", \"prompt_thread\"):\n            _th = locals().get(_th_name)\n            if isinstance(_th, threading.Thread):\n                _th.join(timeout=0.5)\n        if session_id:\n            # Не более одной быстрой попытки interrupt/DELETE (<= 0.25 с), затем lease.cleanup().\n            try:\n                _ = _serve_http(\n                    port,\n                    password,\n                    \"POST\",\n                    f\"/api/session/{session_id}/interrupt\",\n                    None,\n                    timeout=0.25,\n                )\n            except (OSError, http.client.HTTPException):\n                pass\n            try:\n                _ = _serve_http(\n                    port,\n                    password,\n                    \"DELETE\",\n                    f\"/api/session/{session_id}\",\n                    None,\n                    timeout=0.25,\n                )\n            except (OSError, http.client.HTTPException):\n                pass\n        if control_conn[0] is not None:\n            try:\n                control_conn[0].close()\n            except OSError:\n                pass\n            control_conn[0] = None\n        if sse_conn is not None:\n            try:\n                sse_conn.close()\n            except OSError:\n                pass\n        lease.cleanup()\n\n\ndef _new_exit_state() -> dict[str, Any]:\n    return {\n        \"t0\": time.monotonic(),\n        \"mode\": \"\",\n        \"model\": \"\",\n        \"status\": 0,\n        \"exit_reason\": \"\",\n        \"attempts\": None,\n        \"tools\": 0,\n        \"out_chars\": 0,\n        \"rc\": None,","isEmpty":false,"exceededLimit":false,"totalLines":7487,"fileSize":328750,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3460,"endLine":3619},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-6\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_1","startedAtMs":"1793072647719","completedAtMs":"1793072647777"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-1-x9ir","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072647812}
