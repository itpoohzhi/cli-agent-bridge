rve_health.record_failure()\n                if not force_serve and not delivered_any[0]:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve unavailable: {exc}\"))\n                return True\n            except ServeSecurityError as exc:\n                xs[\"exit_reason\"] = \"provider_fatal\"\n                self._sse_error(_error_payload(f\"serve security failure: {exc}\"))\n                return True","isEmpty":false,"exceededLimit":false,"totalLines":7487,"fileSize":328750,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5475,"endLine":5524},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-104d5028-c8e8-4ba7-b674-82772e2c127d-9\nfc_eba6d98c-6957-9459-a277-92d74feced51_3","startedAtMs":"1793072892115","completedAtMs":"1793072892173"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-3-jsr3","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072892203}
