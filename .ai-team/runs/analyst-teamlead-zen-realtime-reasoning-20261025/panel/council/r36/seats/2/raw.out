.res.retry_budget.try_acquire_retry():\n            _log(f\"retry denied ({reason}): retry budget exhausted\")\n            return False\n        self.retries += 1\n        delay = (\n            _retry_backoff_s(self.retries, self._rng)\n            if FAIL_RETRY_BACKOFF_S > 0\n            else 0.0\n        )\n        delay = min(delay, self.remaining_s())\n        if delay > 0:\n            self._sleep(delay)\n        return not self.use_breaker or self.res.breaker.allow()\n","isEmpty":false,"exceededLimit":false,"totalLines":7487,"fileSize":328750,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2410,"endLine":2459},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-d6f3fef1-7829-4248-a616-ffa72d75950b-9\nfc_d9b6459b-536c-9474-bd0d-e40caf734f8a_4","startedAtMs":"1793072648651","completedAtMs":"1793072648717"},"model_call_id":"a6162b24-95ad-4d71-98e6-a96b41958e24-1-x9ir","session_id":"f68dc366-efaf-4231-a658-6d0a8a7b7e63","timestamp_ms":1793072648748}
