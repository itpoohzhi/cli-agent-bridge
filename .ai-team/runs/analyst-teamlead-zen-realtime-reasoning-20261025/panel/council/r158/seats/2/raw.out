/verify_panel_proof.py --round-dir .ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/panel/council/r154 --artifact-sha256 bf242262f19cce9383401e2c9988677fa6cdcb64fb5045bf8ab3cb1e44249cfc --expect-seats 3 --min-seconds 8\",\n      \"exit_code\": 0,\n      \"result\": \"PASS: stage=council round=154 seats=3; исходный receipt не изменялся\"\n    },\n    {\n      \"command\": \"git diff --check\",\n      \"exit_code\": 0\n    },\n    {\n      \"command\": \"run-guarded -- uvx --offline --from pytest==8.3.4 pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py tests/test_step_interruption.py\",\n      \"exit_code\": 0,\n      \"output\": \"~/work/cli-agent-bridge/coder-14-20261027/targeted-final.log\",\n      \"result\": \"231 passed in 321.78s; окончательная версия всех трёх target files\",\n      \"background\": true\n    }\n  ],\n  \"acceptance_coverage\": [\n    {\n      \"id\": \"RW-001\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw001_drain_text_delivered_once_with_native_tool\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/c11-default-final.log; SSE/JSON content=хвост ровно один раз, один native call, finish_reason=tool_calls\"\n    },\n    {\n      \"id\": \"RW-002\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw002_prompt_headers_use_remaining_aux; test_c11_rw002_first_sse_budget_across_real_attempts; test_c11_rw002_execution_wait_excluded_from_prompt_budget; test_c11_rw002_exhausted_before_prompt_starts_no_http; test_c11_rw002_security_control_time_debited_main_and_drain\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/c11-default-final.log; реальный HTTP prompt <2 с при остатке 1 с; _serve_one_attempt 20+20+14; запрет I/O при exhausted; модельное ожидание исключено; control debits main/drain\"\n    },\n    {\n      \"id\": \"RW-003\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw003_initial_writes_fail_closed; test_c11_rw003_status_socket_timeout_before_model_token\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/c11-default-final.log; header/role/status ошибки, mark+socket close, in_use=0; реальный сокет SO_RCVBUF=1024, штатный write timeout 5.0 с, slot release/PGID death <7.0 с\"\n    },\n    {\n      \"id\": \"RW-004\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw004_callback_error_logged_and_socket_aborted\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/c11-default-final.log; RuntimeError callback -> _mask_secrets + _log, read-back bridge.log, socket abort в finally\"\n    },\n    {\n      \"id\": \"RW-005\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw005_completed_text_preserves_reasoning_without_retry; test_c6_rw004_ac016_serve_step_interruption_matrix; tests/test_step_interruption.py\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/full-pytest-final.log; serve/run SSE/JSON с tools, tool_choice=auto, recovery=true: одна попытка, raw reasoning byte-for-byte; empty-text AC-016 сохранён\"\n    },\n    {\n      \"id\": \"RW-006\",\n      \"status\": \"PASS\",\n      \"test\": \"test_c11_rw006_name_and_id_caps_main_and_drain\",\n      \"evidence\": \"~/work/cli-agent-bridge/coder-14-20261027/c11-default-final.log; UTF-8 name/ID превышают cap до called, наблюдаемый ServeProtocolError, cleanup, 0 pending publications\"\n    }\n  ],\n  \"changes\": [\n    \"RW-001: text_cb вызывается в _drain_serve_step_usage и при emulate_tools=True. SSE ToolCallParser.finish() и JSON parser сохраняют хвост без XML/дублей наряду с одним native tool call.\",\n    \"RW-002: prompt aux.check до HTTP, остаточный deadline/timeout; _finish_prompt_aux списывает один раз при headers/execution/finally до min timestamps; первый SSE отдельно списывается после подписки, first_event_limit сохраняет исходную timeout-классификацию. Control HTTP main/drain получает aux.check/deadline/finally debit, cleanup остаётся отдельным резервом. Счётчик потребления ограничен размером доступного aux-бюджета.\",\n    \"RW-003: _LockedWfile установлен и применяет таймаут до end_headers/role. Ранние ошибки abort_socket+return без serve/run. Таймер пишет через тот же wrapper под RLock; OSError/ValueError закрывают клиентский сокет и уведомляют Handler.\",\n    \"RW-004: callback exception логируется с _mask_secrets; abort_socket гарантирован finally; рекурсия mark/abort ограничена флагом client_gone, повторный abort идемпотентен.\",\n    \"RW-005: только вход serve-классификатора очищается при непустом итоговом тексте. Исходный reasoning не меняется; при пустом тексте детектор interruption и AC-016 сохранены. Legacy run использует существующую очищенную классификационную копию.\",\n    \"RW-006: _serve_tool_state_bytes учитывает UTF-8 call_id и name; существующие checks после feed каждого tool_event main/drain сохранены и покрыты событиями до called.\"\n  ],\n  \"assumptions\": [\n    \"Выполнена назначенная внешняя роль coder-14, entry=fix-from-panel; вложенные Coder/Reviewer/панели не запускались. Передача Reviewer — следующий этап оркестратора.\",\n    \"Исходные незакоммиченные изменения и untracked файлы сохранены; test_step_interruption.py не менялся относительно входного hash handoff coder-13.\",\n    \"Команды uvx использовали уже доступные offline pytest==8.3.4, ruff==0.17.2 и basedpyright==1.40.2; новых runtime-зависимостей нет.\",\n    \"Полные pytest/unittest прогоны относятся к неизменному финальному продуктовому коду; после усиления тестового socket-оракула отдельно пройдены финальные C11 pytest и unittest и полный VER-004.\"\n  ],\n  \"risks\": [\n    \"Живой существующий рабочий слот/чат владельца и реальные провайдеры opencode не проверены: живой ~/.dsh/bridges/opencode-zen-bridge/ запрещён брифом. Бизнес-приёмка не проведена; code handoff передаётся Reviewer.\"\n  ],\n  \"open_questions\": [],\n  \"verification\": {\n    \"light\": \"VER-004 PASS; финальный targeted pytest 231 PASS; full pytest 502 PASS; full unittest 502 OK; C11 pytest/unittest 11 PASS; frozen 3/3; git diff --check PASS.\",\n    \"heavy\": null,\n    \"not_verified\": [\n      \"Живой рабочий слот/чат владельца, реальные провайдеры и бизнес-приёмка (за пределами разрешённого брифа)\"\n    ]\n  },\n  \"invariants\": {\n    \"frozen_raw_bytes\": \"PASS 3/3, равны origin/dev\",\n    \"python39_ast\": \"PASS VER-004\",\n    \"early_helper_dispatch\": \"PASS VER-004\",\n    \"catalog_test_unchanged\": \"PASS VER-004\",\n    \"before_plan_unchanged\": true,\n    \"step_interruption_input_unchanged\": true,\n    \"no_commit_push_mr\": true,\n    \"live_bridge_untouched\": true,\n    \"branch\": \"feature/zen-realtime-reasoning\",\n    \"head_commit\": \"7eda27f9d82732bab726a420e31ea2adc15c2c39\"\n  },\n  \"panel_proof\": {\n    \"path\": \".ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/receipts/council-r154-proof.json\",\n    \"sha256\": \"275e60054117978dbd95944e654320e49a133633223309b925a865a0bc608c36\",\n    \"verification_exit_code\": 0\n  },\n  \"validation_log\": \"~/work/cli-agent-bridge/coder-14-20261027/validation-final.log\",\n  \"deviations\": [\n    \"RW-002 превышает 15 строк: остаточный дедлайн prompt, единовременное списание до headers/execution, подписка до первого SSE и control I/O требуют согласованных изменений нескольких фаз одной попытки; архитектура и публичные DTO сохранены.\",\n    \"RW-003 превышает 15 строк из-за переноса существующей обёртки до заголовков/role, RLock для таймера и раннего возврата при ошибке; новых классов/слоёв/зависимостей нет.\",\n    \"Указанный в брифе hash _stream_google_sse имеет 63 hex. Сохранён подтверждённый origin/dev и handoff coder-13 полный hash 5914c9654c7345692dd55e84cfd3765e27406f63a3df85df30bc798bc1778de3.\",\n    \"Сокетный оракул использует настоящий PGID lease в cleanup; штатный downstream timeout 5.0 с не подменяется. Изолированная проверка не зависит от записи FakeServe вспомогательного record-файла.\"\n  ],\n  \"raw_outputs\": {\n    \"targ