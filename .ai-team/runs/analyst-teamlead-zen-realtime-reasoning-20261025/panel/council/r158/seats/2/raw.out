{"type":"tool_call","subtype":"completed","call_id":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-8\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_6","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":6740,"limit":120},"result":{"success":{"content":"                        collected_texts\n                        or collected_reasonings\n                        or result.get(\"native_calls\")\n                    )\n                    _delivered_err = _delivered_now or _has_model_output\n                    if not _has_model_output and attempts.allow_retry(\n                        \"serve_transient_error\"\n                    ):\n                        continue\n                    if not _delivered_err and not force_serve:\n                        xs[\"transport\"] = \"run\"\n                        xs[\"transport_history\"] = [\"serve\", \"run\"]\n                        return False\n                    # После частичной доставки: step-interruption recovery ниже по incomplete-сигналу.\n                    signal_t = _incomplete_step_signal(\n                        \"\".join(result[\"texts\"]),\n                        \"\".join(result[\"reasonings\"]),\n                        tools or [],\n                        True,\n                        int(result[\"usage\"].get(\"output\") or 0),\n                        int(result[\"usage\"].get(\"reasoning\") or 0),\n                        tool_choice=tool_choice,\n                    )\n                    if signal_t and attempts.allow_retry(\"incomplete_step\"):\n                        attempts.signal = signal_t\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _incomplete_tool_step_prompt(\n                                prompt,\n                                \"\".join(collected_texts),\n                                tools or [],\n                                tool_choice,\n                                model,\n                            ),\n                            model,\n                        )\n                        continue\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(\n                    _error_payload(\n                        f\"serve error: {_clean_err(str(err.get('message') or ''))}\"\n                    )\n                )\n                return True\n            if result.get(\"terminal\") == \"cancelled\":\n                xs[\"exit_reason\"] = \"cancelled\"\n                self._sse_error(_error_payload(\"serve session cancelled\"))\n                return True\n            res.serve_health.record_success()\n            attempts.attempt_done(False, True)\n            if emulate_tools and emitted_tools_in_attempt[0] == 0:\n                if unmapped_in_attempt:\n                    if unmapped_retries < NATIVE_RETRY_LIMIT and attempts.allow_retry(\n                        \"unmapped\"\n                    ):\n                        unmapped_retries += 1\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _unavailable_tools_prompt(\n                                current_prompt,\n                                \"\".join(result[\"texts\"]),\n                                unmapped_in_attempt,\n                                tools or [],\n                                model,\n                            ),\n                            model,\n                        )\n                        continue\n                    emit_content(\n                        f\"\\n\\n[opencode-zen-bridge: модель вызывала недоступный встроенный инструмент ({', '.join(unmapped_in_attempt)}); повторы исчерпаны]\"\n                    )\n                    return True\n                signal = _incomplete_step_signal(\n                    \"\".join(result[\"texts\"]),\n                    (\n                        _strip_interrupted(\"\".join(result[\"reasonings\"]))\n                        if \"\".join(result[\"texts\"]).strip()\n                        else \"\".join(result[\"reasonings\"])\n                    ),\n                    tools or [],\n                    False,\n                    int(usage_cur.get(\"output\") or 0),\n                    int(usage_cur.get(\"reasoning\") or 0),\n                    tool_choice=tool_choice,\n                )\n                if (\n                    signal\n                    and incomplete_retries < NATIVE_RETRY_LIMIT\n                    and attempts.allow_retry(\"incomplete_step\")\n                ):\n                    incomplete_retries += 1\n                    attempts.signal = signal\n                    current_prompt = _rewrite_tool_tags_for_model(\n                        _incomplete_tool_step_prompt(\n                            prompt,\n                            \"\".join(collected_texts),\n                            tools or [],\n                            tool_choice,\n                            model,\n                        ),\n                        model,\n                    )\n                    continue\n            return True\n\n    def _stream_google_sse(self, model: str, prompt: str, effort: str,\n                           emulate_tools: bool = False,\n                           google_input: GoogleInput | None = None) -> None:\n        \"\"\"Перевести Google SSE в OpenAI SSE, сохранив эмуляцию инструментов.\"\"\"\n        res = self._res()\n        if not self._acquire_slot(res):\n            return\n        conn = None\n        started = False\n        run_id = uuid.uuid4().hex[:8]\n        with _active_lock:\n            _active[run_id] = time.time()\n        try:\n            resp_id = f\"chatcmpl-oczen-{uuid.uuid4().hex[:12]}\"\n            created = int(time.time())\n            self.close_connection = True\n            self.send_response(200)","isEmpty":false,"exceededLimit":false,"totalLines":8827,"fileSize":384861,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":6740,"endLine":6859},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-8\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_6","startedAtMs":"1793133002167","completedAtMs":"1793133002341"},"model_call_id":"9d30be9d-896b-4b11-8660-3aae3bf58ba6-1-8avp","session_id":"5ce69240-bb77-49ac-94a0-984d9f92aacc","timestamp_ms":1793133002423}
{"type":"tool_call","subtype":"started","call_id":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-9\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_7","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":7040,"limit":120}},"hookAdditionalContexts":[],"toolCallId":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-9\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_7","startedAtMs":"1793133002346"},"model_call_id":"9d30be9d-896b-4b11-8660-3aae3bf58ba6-1-8avp","session_id":"5ce69240-bb77-49ac-94a0-984d9f92aacc","timestamp_ms":1793133002423}
{"type":"tool_call","subtype":"completed","call_id":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-9\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_7","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":7040,"limit":120},"result":{"success":{"content":"        try:\n            if not attempts.begin_attempt():\n                xs[\"exit_reason\"] = \"circuit_open\"\n                self._send(\n                    503,\n                    {\n                        \"error\": {\n                            \"message\": \"upstream circuit open\",\n                            \"type\": \"overloaded\",\n                        }\n                    },\n                )\n                return\n\n            self._downstream_client_gone = False\n\n            def _mark_downstream_gone() -> None:\n                \"\"\"Downstream-запись признала клиента ушедшим: остановить serve.\"\"\"\n                self._downstream_client_gone = True\n\n            locked_wfile = _LockedWfile(\n                raw_wfile,\n                wfile_lock,\n                sock=cast(\n                    socket.socket | None,\n                    cast(object, getattr(self, \"connection\", None)),\n                ),\n                deadline=attempts.deadline,\n                on_client_gone=_mark_downstream_gone,\n            )\n            locked_wfile.flush()\n            self.wfile = cast(io.BufferedIOBase, cast(object, locked_wfile))\n\n            # 1. Отправляются HTTP-заголовки 200 SSE\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"close\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            try:\n                self.end_headers()\n                xs[\"status\"] = 200\n                first_chunk = format_sse_chunk(\n                    resp_id, created, shown_model, {\"role\": \"assistant\", \"content\": \"\"}\n                )\n                _ = self.wfile.write(first_chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n            except (OSError, ValueError, TimeoutError, socket.timeout):\n                locked_wfile.abort_socket()\n                xs[\"exit_reason\"] = \"client_gone\"\n                return\n\n            self._first_visible = first_visible\n\n            def _initial_status() -> None:\n                \"\"\"Защитный таймер: первый видимый статус не позднее FIRST_STATUS_DELAY_S.\"\"\"\n                with wfile_lock:\n                    if first_visible.is_set():\n                        return\n                    first_visible.set()\n                    status_fired_at[0] = time.monotonic()\n                    try:\n                        _ = locked_wfile.write(\n                            format_sse_chunk(\n                                resp_id,\n                                created,\n                                shown_model,\n                                {\"reasoning_content\": STATUS_INITIAL},\n                            ).encode(\"utf-8\")\n                        )\n                        locked_wfile.flush()\n                    except (OSError, ValueError, TimeoutError, socket.timeout):\n                        locked_wfile.abort_socket()\n\n            if effort.strip().lower() not in (\"\", \"off\", \"none\"):\n                status_timer = threading.Timer(\n                    max(\n                        0.0,\n                        attempts.deadline\n                        - TIMEOUT_S\n                        + FIRST_STATUS_DELAY_S\n                        - time.monotonic(),\n                    ),\n                    _initial_status,\n                )\n                status_timer.daemon = True\n                status_timer.start()\n\n            collected_texts: list[str] = []\n            usage: dict[str, Any] = {}\n            deadline = attempts.deadline\n            tool_calls: list[dict[str, Any]] = []\n\n            # Повтор незавершённого шага: уже отданный клиенту текст (dedup_prefix) подавляется,\n            # расхождение (модель переформулировала) отдаётся целиком — текст не теряется.\n            dedup: list[_PrefixDedup | None] = [None]\n\n            def send_text(text: str) -> None:\n                chunk = format_sse_chunk(\n                    resp_id, created, shown_model, {\"content\": text}\n                )\n                first_visible.set()\n                self.wfile.write(chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n                collected_texts.append(text)  # только реально отданное клиенту\n\n            def emit_content(text: str) -> None:\n                if not text:\n                    return\n                prefix_dedup = dedup[0]\n                if prefix_dedup is not None:\n                    text = prefix_dedup.push(text)\n                    if not text:\n                        return\n                send_text(text)\n\n            dropped_blocks = [\n                0\n            ]  # вырезано нераспарсенных блоков вызова (счётчик на запрос)\n","isEmpty":false,"exceededLimit":false,"totalLines":8827,"fileSize":384861,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":7040,"endLine":7159},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-508f1199-d1ca-44fc-8179-5d6506e29c1e-9\nfc_6909dbbe-556b-9aae-9564-ca4021e0d1e5_7","startedAtMs":"1793133002346","completedAtMs":"1793133002595"},"model_call_id":"9d30be9d-896b-4b11-8660-3aae3bf58ba6-1-8avp","session_id":"5ce69240-bb77-49ac-94a0-984d9f92aacc","timestamp_ms":1793133002674}
