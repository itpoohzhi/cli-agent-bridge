4033:         prompt_send_start = time.monotonic()\n4034: \n4035:         def _prompt_worker() -> None:\n4036:             \"\"\"Доставка prompt параллельно чтению SSE.\"\"\"\n4037: \n4038:             def _on_headers(status_code: int = 200) -> None:\n4039:                 prompt_status[\"headers_at\"] = time.monotonic()\n4040:                 prompt_status[\"status\"] = status_code\n4041:                 if status_code in (401, 403):\n4042:                     prompt_status[\"security\"] = True\n4043: \n4044:             try:\n4045:                 st, _body = _serve_http(\n4046:                     port,\n4047:                     password,\n4048:                     \"POST\",\n4049:                     f\"/api/session/{session_id}/prompt\",\n4050:                     {\"text\": prompt, \"files\": [], \"delivery\": \"steer\", \"resume\": True},\n4051:                     timeout=65.0,\n4052:                     on_headers=_on_headers,\n4053:                     deadline=attempt_deadline,\n4054:                     is_client_gone=is_client_gone,\n4055:                 )\n4056:                 prompt_status[\"status\"] = st\n4057:                 if st in (401, 403):\n4058:                     prompt_status[\"security\"] = True\n4059:             except (OSError, http.client.HTTPException) as exc:\n4060:                 prompt_status[\"error\"] = str(exc)\n4061:             except ServeProtocolError as exc:\n4062:                 prompt_status[\"protocol_error\"] = str(exc)\n4063:             finally:\n4064:                 headers_at = prompt_status.get(\"headers_at\")\n4065:                 if isinstance(headers_at, (int, float)):\n4066:                     aux.debit_seconds(float(headers_at) - prompt_send_start)\n4067:                 else:\n4068:                     aux.debit_seconds(time.monotonic() - prompt_send_start)\n4069: \n4070:         prompt_thread = threading.Thread(target=_prompt_worker, daemon=True)\n4071:         prompt_thread.start()\n4072:         tool_state = _ServeToolState()\n4073:         pending_step_calls: list[dict[str, object]] = []\nLINES 6186 6200\n6186:             pass\n6187: \n6188:     def _mark_client_gone(self) -> None:\n6189:         \"\"\"Отметить уход клиента один раз и уведомить обработчик запроса.\"\"\"\n6190:         if self.client_gone:\n6191:             return\n6192:         self.client_gone = True\n6193:         if self._on_client_gone is not None:\n6194:             try:\n6195:                 self._on_client_gone()\n6196:             except Exception:\n6197:                 pass\n6198: \n6199:     def cancel_deadline_timer(self) -> None:\n6200:         \"\"\"Отменить watchdog-таймер дедлайна при штатном завершении запроса.\"\"\"\nLINES 6990 7068\n6990: \n6991:             # 1. Отправляются HTTP-заголовки 200 SSE\n6992:             self.send_response(200)\n6993:             self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n6994:             self.send_header(\"Cache-Control\", \"no-cache\")\n6995:             self.send_header(\"Connection\", \"close\")\n6996:             self.send_header(\"X-Accel-Buffering\", \"no\")\n6997:             self.end_headers()\n6998:             xs[\"status\"] = 200\n6999: \n7000:             # 2. Отправляется первый чанк\n7001:             first_chunk = format_sse_chunk(\n7002:                 resp_id, created, shown_model, {\"role\": \"assistant\", \"content\": \"\"}\n7003:             )\n7004:             self.wfile.write(first_chunk.encode(\"utf-8\"))\n7005:             self.wfile.flush()\n7006:             self._downstream_client_gone = False\n7007: \n7008:             def _mark_downstream_gone() -> None:\n7009:                 \"\"\"Downstream-запись признала клиента ушедшим: остановить serve.\"\"\"\n7010:                 self._downstream_client_gone = True\n7011: \n7012:             self.wfile = cast(\n7013:                 io.BufferedIOBase,\n7014:                 cast(\n7015:                     object,\n7016:                     _LockedWfile(\n7017:                         raw_wfile,\n7018:                         wfile_lock,\n7019:                         sock=cast(\n7020:                             socket.socket | None,\n7021:                             cast(object, getattr(self, \"connection\", None)),\n7022:                         ),\n7023:                         deadline=attempts.deadline,\n7024:                         on_client_gone=_mark_downstream_gone,\n7025:                     ),\n7026:                 ),\n7027:             )\n7028:             self._first_visible = first_visible\n7029: \n7030:             def _initial_status() -> None:\n7031:                 \"\"\"Защитный таймер: первый видимый статус не позднее FIRST_STATUS_DELAY_S.\"\"\"\n7032:                 with wfile_lock:\n7033:                     if first_visible.is_set():\n7034:                         return\n7035:                     first_visible.set()\n7036:                     status_fired_at[0] = time.monotonic()\n7037:                     try:\n7038:                         _ = raw_wfile.write(\n7039:                             format_sse_chunk(\n7040:                                 resp_id,\n7041:                                 created,\n7042:                                 shown_model,\n7043:                                 {\"reasoning_content\": STATUS_INITIAL},\n7044:                             ).encode(\"utf-8\")\n7045:                         )\n7046:                         raw_wfile.flush()\n7047:                     except (OSError, ValueError):\n7048:                         pass\n7049: \n7050:             if effort.strip().lower() not in (\"\", \"off\", \"none\"):\n7051:                 status_timer = threading.Timer(\n7052:                     max(\n7053:                         0.0,\n7054:                         attempts.deadline\n7055:                         - TIMEOUT_S\n7056:                         + FIRST_STATUS_DELAY_S\n7057:                         - time.monotonic(),\n7058:                     ),\n7059:                     _initial_status,\n7060:                 )\n7061:                 status_timer.daemon = True\n7062:                 status_timer.start()\n7063: \n7064:             collected_texts: list[str] = []\n7065:             usage: dict[str, Any] = {}\n7066:             deadline = attempts.deadline\n7067:             tool_calls: list[dict[str, Any]] = []\n7068: \nLINES 4358 4377\n4358:                         )\n4359:                     result[\"terminal\"] = \"tool_calls\"\n4360:                     break\n4361:             elif etype == \"error\":\n4362:                 result[\"error\"] = payload\n4363:                 result[\"delivered\"] = _is_delivered()\n4364:                 result[\"transient_error\"] = _is_transient_stream_error(payload)\n4365:                 result[\"terminal\"] = \"failed\"\n4366:                 break\n4367:             elif etype_raw == \"session.execution.succeeded\":\n4368:                 for pending_call in pending_step_calls:\n4369:                     result[\"native_calls\"].append(pending_call)\n4370:                     on_tool(pending_call)\n4371:                 pending_step_calls.clear()\n4372:                 result[\"terminal\"] = \"succeeded\"\n4373:                 break\n4374:         if (\n4375:             not result[\"terminal\"]\n4376:             and not result[\"exit_reason\"]\n4377:             and time.monotonic() >= deadline\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"Хеши всех трёх файлов совпали с манифестом. В исправлениях остаются пробелы: дренаж подавляет текстовые дельты при эмуляции инструментов, байтовый лимит не учитывает имена вызовов, а prompt не ограничен остатком aux-бюджета. Продолжаю проверку остальных требований и границ задачи; зелёные L2-прогоны учитываю как подтверждённый факт."}}
