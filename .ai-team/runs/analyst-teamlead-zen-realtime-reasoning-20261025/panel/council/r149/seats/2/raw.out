ansient_error\"):\n6679:                     attempts.attempt_done(True, False)\n6680:                     _has_model_output = bool(\n6681:                         collected_texts\n6682:                         or collected_reasonings\n6683:                         or result.get(\"native_calls\")\n6684:                     )\n6685:                     _delivered_err = _delivered_now or _has_model_output\n6686:                     if not _has_model_output and attempts.allow_retry(\n6687:                         \"serve_transient_error\"\n6688:                     ):\n6689:                         continue\n6690:                     if not _delivered_err and not force_serve:\n6691:                         xs[\"transport\"] = \"run\"\n6692:                         xs[\"transport_history\"] = [\"serve\", \"run\"]\n6693:                         return False\n6694:                     # После частичной доставки: step-interruption recovery ниже по incomplete-сигналу.\n6695:                     signal_t = _incomplete_step_signal(\n6696:                         \"\".join(result[\"texts\"]),\n6697:                         \"\".join(result[\"reasonings\"]),\n6698:                         tools or [],\n6699:                         True,\n6700:                         int(result[\"usage\"].get(\"output\") or 0),\n6701:                         int(result[\"usage\"].get(\"reasoning\") or 0),\n6702:                         tool_choice=tool_choice,\n6703:                     )\n6704:                     if signal_t and attempts.allow_retry(\"incomplete_step\"):\n6705:                         attempts.signal = signal_t\n6706:                         current_prompt = _rewrite_tool_tags_for_model(\n6707:                             _incomplete_tool_step_prompt(\n6708:                                 prompt,\n6709:                                 \"\".join(collected_texts),\n6710:                                 tools or [],\n6711:                                 tool_choice,\n6712:                                 model,\n6713:                             ),\n6714:                             model,\n6715:                         )\n6716:                         continue\n6717:                 xs[\"exit_reason\"] = \"upstream_failed\"\n6718:                 self._sse_error(\n6719:                     _error_payload(\n6720:                         f\"serve error: {_clean_err(str(err.get('message') or ''))}\"\n6721:                     )\n6722:                 )\n6723:                 return True\n6724:             if result.get(\"terminal\") == \"cancelled\":\n6725:                 xs[\"exit_reason\"] = \"cancelled\"\n6726:                 self._sse_error(_error_payload(\"serve session cancelled\"))\n6727:                 return True\n6728:             res.serve_health.record_success()\n6729:             attempts.attempt_done(False, True)\n6730:             if emulate_tools and emitted_tools_in_attempt[0] == 0:\n6731:                 if unmapped_in_attempt:\n6732:                     if unmapped_retries < NATIVE_RETRY_LIMIT and attempts.allow_retry(\n6733:                         \"unmapped\"\n6734:                     ):\n6735:                         unmapped_retries += 1\n6736:                         current_prompt = _rewrite_tool_tags_for_model(\n6737:                             _unavailable_tools_prompt(\n6738:                                 current_prompt,\n6739:                                 \"\".join(result[\"texts\"]),\n6740:                                 unmapped_in_attempt,\n6741:                                 tools or [],\n6742:                                 model,\n6743:                             ),\n6744:                             model,\n6745:                         )\n6746:                         continue\n6747:                     emit_content(\n6748:                         f\"\\n\\n[opencode-zen-bridge: модель вызывала недоступный встроенный инструмент ({', '.join(unmapped_in_attempt)}); повторы исчерпаны]\"\n6749:                     )\n6750:                     return True\n6751:                 signal = _incomplete_step_signal(\n6752:                     \"\".join(result[\"texts\"]),\n6753:                     \"\".join(result[\"reasonings\"]),\n6754:                     tools or [],\n6755:                     False,\n6756:                     int(usage_cur.get(\"output\") or 0),\n6757:                     int(usage_cur.get(\"reasoning\") or 0),\n6758:                     tool_choice=tool_choice,\n6759:                 )\n6760:                 if (\n6761:                     signal\n6762:                     and incomplete_retries < NATIVE_RETRY_LIMIT\n6763:                     and attempts.allow_retry(\"incomplete_step\")\n6764:                 ):\n6765:                     incomplete_retries += 1\n6766:                     attempts.signal = signal\n6767:                     current_prompt = _rewrite_tool_tags_for_model(\n6768:                         _incomplete_tool_step_prompt(\n6769:                             prompt,\n6770:                             \"\".join(collected_texts),\nLINES 8150 8195\n8150:                 for call in mapped:\n8151:                     _add_call(call)\n8152:             usage = result[\"usage\"]\n8153:             if not emulate_tools or tool_calls_all:\n8154:                 break\n8155:             if unmapped:\n8156:                 if unmapped_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n8157:                     \"unmapped\"\n8158:                 ):\n8159:                     break\n8160:                 unmapped_retries += 1\n8161:                 _prior_content = \"\\n\\n\".join(c for c in contents if c)\n8162:                 current_prompt = _rewrite_tool_tags_for_model(\n8163:                     _unavailable_tools_prompt(\n8164:                         current_prompt, content_raw, unmapped, tools or [], model\n8165:                     ),\n8166:                     model,\n8167:                 )\n8168:                 continue\n8169:             signal = _incomplete_step_signal(\n8170:                 content_raw,\n8171:                 \"\".join(reasonings),\n8172:                 tools or [],\n8173:                 False,\n8174:                 int(usage.get(\"output\") or 0),\n8175:                 int(usage.get(\"reasoning\") or 0),\n8176:                 tool_choice=tool_choice,\n8177:             )\n8178:             if not signal:\n8179:                 break\n8180:             if incomplete_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n8181:                 \"incomplete_step\"\n8182:             ):\n8183:                 break\n8184:             incomplete_retries += 1\n8185:             _prior_content = \"\\n\\n\".join(c for c in contents if c)\n8186:             current_prompt = _rewrite_tool_tags_for_model(\n8187:                 _incomplete_tool_step_prompt(\n8188:                     prompt, \"\\n\\n\".join(contents), tools or [], tool_choice, model\n8189:                 ),\n8190:                 model,\n8191:             )\n8192:         content_final = \"\\n\\n\".join(c for c in contents if c)\n8193:         if not content_final and not tool_calls_all:\n8194:             xs[\"exit_reason\"] = \"upstream_failed\"\n8195:             self._send(502, _error_payload(\"serve produced no text\"))\nTEST STEP_RECOVERY OFF 1593\nTEST STEP_RECOVERY OFF 2418\nTEST STEP_RECOVERY OFF 2445\nTEST STEP_RECOVERY OFF 2581\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"PANEL-NONCE: 2b1f09909b23b479\nARTIFACT-SHA256: bf242262f19cce9383401e2c9988677fa6cdcb64fb5045bf8ab3cb1e44249cfc\n\nОбщий канон `~/Мой диск/Context/AGENTS.md` прочитан целиком из сообщения до `<!-- КАНОН-КОНЕЦ -->`. В корне проекта `AGENTS.md`, `.agents/AGENTS.md`, `CLAUDE.md` отсутствуют. Канонические AI-SDLC `AGENTS.md` и `agents/code.md` прочитаны с диска, приложенные профильные стандарты — из пакета. Хеши всех трёх файлов кандидата совпадают с манифестом. Тесты самостоятельно не запускал.\n\n1. КОРРЕКТНОСТЬ: VERDICT=FAIL\n   WHY=Основной транспорт реализуем, но обработка событий в дренаже неполна: при эмуляции инструментов теряются текстовые дельты. Дополнительно сохранение исходного reasoning оставляет различие между классификаторами serve и run: interruption-маркер способен вызвать повтор уже завершённого ответа.\n\n   СОВЕТЫ (при FAIL):\n   - Доставлять текст из дренажа через тот же безопасный путь, который обрабатывает обычные текстовые дельты.\n   - Разделить исходный reasoning для клиента и нормализованную копию для recovery-классификации; проверить поведение с включённым `STEP_RECOVERY`.\n\n   **F-001 — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:3562`, `bridges/opencode-zen-bridge/server.py:3563`.\n   - **Правило:** RW-001; REQ-001; `feature.md`, независимая проверка полноты потокового захвата.\n   - **Evidence:** текст добавляется в `result[\"texts\"]`, но callback вызывается только при `not emulate_tools`. Дренаж после native-вызова при эмуляции работает с `emulate_tools=True`. Поэтому последовательность `tool.called → text.delta → step.ended` сохраняет текст внутри результата попытки, но не передаёт его потребителю. JSON-путь также собирает итоговый текст через переданный callback.\n   - **Исправление:** передавать текст текущего шага через соответствующий parser/callback без утечки tool-тегов и без повторной публикации.\n   - **Критерий проверки:** SSE- и JSON-оракулы указанной последовательности содержат весь обычный текст ровно один раз; SSE доставляет его до завершения апстрима.\n\n   **F-002 [sweep] — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:6751`, `bridges/opencode-zen-bridge/server.py:8171`, `bridges/opencode-zen-bridge/tests/test_realtime_reasoning.py:1593`.\n   - **Правило:** REQ-003, REQ-011; проверка радиуса изменений RW-003.\n   - **Evidence:** обе успешные serve-ветки передают в `_incomplete_step_signal` исходный reasoning. Детектор на `server.py:1062`–`1065` считает interruption-маркер признаком незавершённости независимо от готового текста ответа. Legacy-пути перед классификацией используют очищенную копию. Новый тест сохранности маркеров отключает `STEP_RECOVERY_ENABLED`, поэтому эту разницу не проверяет.\n   - **Исправление:** согласовать recovery-классификацию serve/run, сохранив исходные байты reasoning в ответе.\n   - **Критерий проверки:** при доступных tools, обычном `tool_choice`, готовом приветствии и reasoning с interruption-маркером serve/run дают одинаковое число попыток; reasoning остаётся неизменным. Проверить SSE и JSON при включённом recovery.\n   - **Происхождение:** возможная предыстория JSON-ветки требует классификации оркестратором по дельте цикла; дефект находится в изменённом задачей файле.\n\n   SUB Корректность/логика: FAIL — текст из дренажа не доставляется при эмуляции инструментов (server.py:3563; F-001).\n   SUB Корректность/граничные условия: FAIL — reasoning-маркер при готовом ответе способен инициировать лишний serve-retry (server.py:6753, server.py:8171; F-002).\n   SUB Корректность/обработка ошибок: PASS — ошибки дренажа сохраняют terminal error и не публикуют pending-вызовы (server.py:3536; clean-room VER-005).\n\n2. ПОЛНОТА: VERDICT=FAIL\n   WHY=Исправления существенны, но RW-001, RW-004, RW-005 и FU-002 закрыты не полностью. Проверка исходного reasoning проходит, однако её соседняя recovery-ветка требует дополнительного оракула.\n\n   Verify-Fixed:\n   - **RW-001 — FAIL:** reasoning, permission, form и error обработаны; текстовая ветка остаётся неполной — F-001.\n   - **RW-002 — PASS для проверяемой передачи инструментов DSH:** pending-вызов A без `step.ended` не публикуется, успешная попытка публикует B. Код и SSE/JSON-оракул согласованы.\n   - **RW-003 — PASS по сохранности байтов:** модельные маркеры сохраняются, content очищается. Радиус изменений — F-002.\n   - **RW-004 — FAIL по полной границе памяти:** аргументы учитываются, имена и идентификаторы вызовов обходят байтовый предел — F-003.\n   - **RW-005 — FAIL по полной цепочке записи:** большие модельные чанки ограничены, начальные записи обходят обёртку — F-005.\n   - **FU-001 — частично:** в traceability остались неверные описания протокола — F-009.\n   - **FU-002 — FAIL:** prompt и часть управляющего I/O не ограничены остатком общего aux-бюджета — F-004.\n\n   Поштучная сверка конверта; PASS ниже относится к представленным оракулам, а не к ещё не проведённой живой приёмке:\n   - REQ-001 — **FAIL**, F-001; AC-001 — PASS, AC-002 — PASS на штатном сокетном сценарии reasoning.\n   - REQ-002 — **PASS**; AC-003 — PASS по регрессионному набору формата.\n   - REQ-003 — **PASS по сохранению run и переключению**; AC-004 — PASS. Соответствие обязательному источнику флага рассматривается отдельно в F-008.\n   - REQ-004 — **PASS на представленных сценариях**; AC-005 — PASS.\n   - REQ-005 — **PASS по передаваемому reasoning**; AC-006 — PASS, AC-007 — PASS.\n   - REQ-006 — **PASS**; AC-008 — PASS на представленном fake-транспорте.\n   - REQ-007 — **PASS**; AC-009 — PASS, AC-010 — PASS.\n   - REQ-008 — **FAIL по полноте ограничения I/O**, F-005; AC-011 — PASS на проверенном сценарии отключения, AC-012 — INCONCLUSIVE для исходного живого случая.\n   - REQ-009 — **PASS**; AC-013 — PASS, AC-014 — PASS.\n   - REQ-010 — **PASS по parser-оракулам**; AC-015 — PASS.\n   - REQ-011 — **FAIL по совместимости recovery**, F-002; AC-016 — PASS для представленной матрицы, которая этот случай не включает.\n   - REQ-012 — **PASS на L2**; AC-017 — PASS. Реальная изоляция OpenCode остаётся предметом разрешённого L3.\n   - REQ-013 — **PASS**; AC-018 — PASS.\n   - REQ-014 — **PASS**; AC-019 — PASS.\n   - REQ-015 — **PASS по представленным проверкам очистки ошибок**; AC-020 — PASS на L2.\n   - REQ-016 — **PASS**; AC-021 — PASS.\n   - REQ-017 — **PASS**; AC-022 — PASS, AC-023 — PASS.\n   - REQ-018 — **PASS**; AC-024 — PASS, frozen-хеши подтверждены.\n   - REQ-019 — **DEFERRED_L3**; AC-025 — DEFERRED_L3, законно до ACCEPT.\n   - REQ-020 — **PASS**; AC-026 — PASS: есть поведенческий RED на `origin/dev` и GREEN кандидата.\n\n   СОВЕТЫ (при FAIL):\n   - Добавить оракулы F-001–F-005, закрывающие обнаруженные границы.\n   - Исправить неточные утверждения traceability.\n   - После исправлений повторить полный clean-room L2; живой контур проверять в установленной последовательности после ACCEPT.\n\n   **F-009 [pre-existing] — priority=non-blocking**\n   - **locations:** `.ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/teamlead/verification-traceability.md:23`, `.ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/teamlead/verification-traceability.md:32`.\n   - **Правило:** FU-001; достоверность прослеживаемости.\n   - **Evidence:** первая строка описывает `_map_serve_event` как обработчик `message.part.updated`, хотя реализован протокол `session.*`. Вторая описывает политику как `deny`, хотя default — `ask_reject`.\n   - **Исправление:** указать фактические события, default-политику и различие обработки permission в main/drain.\n   - **Критерий проверки:** каждое указанное событие и поведение однозначно сопоставляется с актуальным символом и оракулом.\n\n   SUB Полнота/покрытие AC: FAIL — штатные AC подтверждены, но обобщение на всю цепочку необоснованно (server.py:3563, server.py:4053; F-001, F-004).\n   SUB Полнота/пропущенные ветки: FAIL — не проверены текст в дренаже и recovery с сохранёнными маркерами при включённой функции (server.py:3563; test_realtime_reasoning.py:1593).\n\n3. РЕАЛИЗУЕМОСТЬ: VERDICT=FAIL\n   WHY=Зависимости доступны: OpenCode serve, loopback HTTP/SSE, прокси-ротация и in-memory DB подтверждены. Новых runtime-пакетов не требуется. Блокируют внедрение незамкнутый бюджет памяти и неполное ограничение вспомогательного I/O.\n\n   СОВЕТЫ (при FAIL):\n   - Ограничить весь удерживаемый tool state.\n   - Применять остаток aux-бюджета до начала каждого соответствующего I/O.\n   - Затем выполнить L2 и предусмотренную лестницу L3. Для локальных исправлений с оракулами ориентир — **1–2 рабочих дня**, оценка предварительная; длительность живой проверки зависит от доступности квоты и рабочего слота.\n\n   **F-003 — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:3237`, `bridges/opencode-zen-bridge/server.py:3679`, `bridges/opencode-zen-bridge/server.py:3704`.\n   - **Правило:** RW-004; `HL-ENV-01`.\n   - **Evidence:** состояние удерживает произвольные `name` и ключи `call_id`, но `_serve_tool_state_bytes` считает только `text` и `input`. Например, 128 событий с разными короткими ID и именами по 900 КиБ удержат около 112,5 МиБ имён при нулевом учтённом объёме аргументов. Каждое событие укладывается в предел SSE-строки; лимит 16 МиБ не срабатывает.\n   - **Исправление:** включить все удерживаемые строковые поля в бюджет либо задать отдельные обоснованные пределы ID/name.\n   - **Критерий проверки:** превышение совокупного размера через ID/name в main и drain даёт управляемый protocol error, cleanup и отсутствие опубликованных pending-вызовов.\n\n   **F-004 — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:3294`, `bridges/opencode-zen-bridge/server.py:3857`, `bridges/opencode-zen-bridge/server.py:3900`, `bridges/opencode-zen-bridge/server.py:4053`, `bridges/opencode-zen-bridge/server.py:4063`.\n   - **Правило:** FU-002; `R-BULK-I1`; `feature.md`, ограничения всей цепочки I/O.\n   - **Evidence:** prompt получает `deadline=attempt_deadline` и timeout 65 секунд; время списывается постфактум. Остаток aux-бюджета не ограничивает эту фазу. Получение execution-события до HTTP-заголовков позволяет ждать первый токен до 60 секунд даже при малом остатке aux. Permission/form control-вызовы также не списываются как aux-фазы; подписка учитывается до заголовков, а не до первого SSE.\n   - **Исправление:** ограничить ожидание prompt-заголовков остатком aux, своевременно завершать и списывать фазу; учесть управляющие вызовы и установленную границу готовности подписки. Модельное чтение после завершения aux-фазы учитывать отдельно.\n   - **Критерий проверки:** управляемые часы и реальные точки вызова HTTP подтверждают общий предел 54 секунды через несколько попыток; при нулевом остатке следующий I/O не начинается. Тест одного класса `_AuxIoBudget` этого не доказывает.\n\n   SUB Реализуемость/общее: FAIL — инфраструктурных блокеров нет, но заявленные ресурсные гарантии не обеспечены кодом (server.py:3679, server.py:4053; HL-ENV-01, R-BULK-I1).\n\n4. РИСКИ: VERDICT=FAIL\n   WHY=Clean-room L2 подтверждён: компонентный pytest и unittest — 491 тест, корневой suite — 894 passed/5 skipped, отдельный realtime-набор — 112 passed. VER-004 подтверждает ноль ошибок типов и сохранность frozen-функций. Эти результаты не закрывают обнаруженные ветки и обход downstream-ограничения.\n\n   СОВЕТЫ (при FAIL):\n   - Распространить ограничение записи на начальные заголовки, role-чанк и статусный таймер.\n   - Проверить освобождение ресурсов при сбое каждой начальной записи.\n   - Добавить регрессии для F-001–F-004; L3 оставить обязательным последующим этапом.\n\n   **F-005 — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:6997`, `bridges/opencode-zen-bridge/server.py:7004`, `bridges/opencode-zen-bridge/server.py:7038`, `bridges/opencode-zen-bridge/server.py:7046`.\n   - **Правило:** RW-005; `feature.md` §2, timeout на каждом шаге I/O, включая завершение.\n   - **Evidence:** заголовки и role-чанк отправляются до установки `_LockedWfile`. Таймер пишет напрямую через `raw_wfile`, удерживая общий замок, без установки собственного ограниченного timeout. Обязательной независимой отмены этой записи нет. Сокетный тест большого потока проверяет последующие записи через обёртку.\n   - **Исправление:** установить ограничение до первой записи; таймер должен использовать общий механизм ограниченной записи без повторного захвата того же замка. Обеспечить cleanup при его ошибке.\n   - **Критерий проверки:** инъекция блокировки/ошибки отдельно в отправку заголовков, role и initial-status завершается ограниченно; замок и bulkhead-слот освобождаются, группа serve остановлена.\n   - **Классификация цикла:** неполное устранение RW-005; начальные точки записи существовали ранее.\n\n   SUB Риски/безопасность: PASS — случайный пароль, allowlist env, loopback ownership и fail-closed управляющих ошибок представлены в коде и L2 (server.py:3345; REQ-012, REQ-015).\n   SUB Риски/данные: FAIL — текст текущего шага может исчезнуть из результата клиента (server.py:3563; F-001).\n   SUB Риски/прод: FAIL — обход лимита удерживаемой памяти и неполная граница downstream I/O (server.py:3679, server.py:7038; F-003, F-005).\n   SUB Риски/regression red→green: PASS — AC-026 падает поведенчески на origin/dev и проходит на кандидате (execution-evidence.md, L2-RED-sensitivity/VER-005).\n   SUB Риски/Full Suite (L2): PASS — полные независимые прогоны зелёные, включая обратный порядок (execution-evidence.md, VER-001/002/003 и AC-023).\n   SUB Риски/scope-diff: PASS — ровно три разрешённых файла, frozen-функции совпадают побайтово (candidate-manifest.json; VER-004).\n\n5. АЛЬТЕРНАТИВЫ: VERDICT=PASS\n   WHY=Короткоживущий serve с сохранённым run оправдан измеренными возможностями CLI и необходимостью менять IP на попытку. Общий демон осложняет ротацию и расширяет область отказа; прямой Zen HTTP пока не имеет доказанной схемы доступа. Исправления замечаний возможны внутри выбранного транспорта, перепроектирование не требуется.\n\n   SUB Альтернативы/общее: PASS — выбор serve+run опирается на сравнение вариантов и репозиторный прецедент; ненужного переписывания для закрытия замечаний не требуется (handoff-architect.md §4; REQ-003, REQ-013).\n\n6. СООТВЕТСТВИЕ КОНТЕКСТУ: VERDICT=FAIL\n   WHY=Границы автономного stdlib-моста сохранены; требования переносить его на Litestar/async или добавлять orjson здесь не применяю. Однако остаются прямое запрещённое подавление исключения, новый unittest-контур вопреки приложенному стандарту и локальное включение функции без требуемого каноном источника GigaRC.\n\n   СОВЕТЫ (при FAIL):\n   - Удалить бездиагностическое подавление callback-ошибки.\n   - Привести новый тестовый модуль к pytest, сохранив фактическое покрытие L2.\n   - Обеспечить управление флагом из GigaRC с default=false и оперативным отключением; согласовать способ доставки с ограничением stdlib.\n\n   **F-006 — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:6196`.\n   - **Правило:** `agents/python-standards.md` §3 и запрет №1; `agents/code.md`, «Возвраты и ошибки».\n   - **Evidence:** новый `_mark_client_gone` содержит `except Exception: pass`.\n   - **Исправление:** убрать подавление либо обработать конкретный ожидаемый сбой с диагностикой, гарантируя shutdown/cleanup независимо от результата callback.\n   - **Критерий проверки:** ошибка callback наблюдаема и не препятствует закрытию сокета и освобождению ресурсов.\n\n   **F-007 [pre-existing] — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/tests/test_realtime_reasoning.py:412`, `:882`, `:2911`, `:3328`, `:3399`, `:3659`, `:3953`, `:4080`.\n   - **Правило:** `agents/testing.md`: «Не использовать unittest.TestCase, setUp, tearDown».\n   - **Evidence:** новый тестовый модуль построен на шести прямых классах `unittest.TestCase` и двух производных от `_AttemptCase`.\n   - **Исправление:** перенести новый модуль на pytest с фикстурами и гарантированным восстановлением состояния. Сохранить legacy-проверки и полный запуск новых оракулов в L2.\n   - **Критерий проверки:** новый модуль не использует TestCase/setUp/tearDown; все его сценарии собираются и выполняются без сокращения проверок.\n\n   **F-008 [pre-existing] — priority=blocking**\n   - **locations:** `bridges/opencode-zen-bridge/server.py:1829`, `bridges/opencode-zen-bridge/server.py:1907`.\n   - **Правило:** общий канон, «Все фичи — через фичефлаги GigaRC».\n   - **Evidence:** `_read_dynamic_config_enabled` читает локальный JSON; `_select_transport` допускает включение env override и принудительным `TRANSPORT=serve`. В пакете нет связи этого состояния с удалённым GigaRC. Локальная изменяемость сама по себе требование удалённого управления не выполняет.\n   - **Исправление:** подключить источник GigaRC существующим совместимым способом; локальный файл может служить снимком, если доказаны доставка состояния и приоритет удалённого отключения.\n   - **Критерий проверки:** на том же процессе изменение удалённого флага меняет выбор новых запросов без рестарта; отсутствие/некорректность состояния сохраняет прежний путь.\n\n   Non-Goals проверены поштучно: публичная оболочка и порт сохранены; DSH/профиль/ReasoningRow не изменены; исходный reasoning сохраняется; модели и effort-каталог не меняются; другие мосты и общие конфиги не затронуты; новых runtime-зависимостей нет.\n\n   Forbidden Scope проверен поштучно: изменения ограничены разрешёнными файлами; записи секретов в diff не обнаружены; живой мост до ACCEPT не менялся; вызовов Keychain нет; прямой правки общей OpenCode DB нет; коммитов в защищённые ветки и merge нет. `VER-006`/`VER-007` законно остаются `DEFERRED_L3`; это не отдельный блокер данного Совета.\n\n   Повторный self-sweep всех 14 подкатегорий выполнен. Положительные L2-свидетельства приняты; обнаруженные ограничения не подменены отсутствием живой приёмки.\n\n   SUB Соответствие контексту/общее: FAIL — остаются прямые нарушения правил исключений, тестового контура и управления флагом (server.py:6196, server.py:1829; test_realtime_reasoning.py:412; F-006–F-008).\n\nОБЩИЙ ВЕРДИКТ: NEEDS WORK\nCOVERAGE: 14/14 подкатегорий\nFINDINGS_COMPLETE: 9"}}
