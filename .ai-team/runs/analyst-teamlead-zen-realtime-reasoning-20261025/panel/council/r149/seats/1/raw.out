{"type":"tool_call","subtype":"completed","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-3\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_0","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":3480,"limit":120},"result":{"success":{"content":"        release_event(event)\n        event_type = str(event.get(\"type\") or \"\")\n        if event_type == \"__invalid_json__\":\n            raise ServeProtocolError(\"invalid event while draining tool step\")\n        data = _as_dict(event.get(\"data\"))\n        # form.created: до верхнего sessionID-фильтра и до разбора схемы события.\n        if event_type == \"form.created\":\n            form = _as_dict(data.get(\"form\"))\n            form_session = form.get(\"sessionID\") or data.get(\"sessionID\")\n            if form_session != session_id:\n                continue\n            form_id = form.get(\"id\") or data.get(\"id\")\n            if isinstance(form_id, str) and form_id:\n                _ctrl_quiet(f\"/api/session/{session_id}/form/{form_id}/cancel\")\n            _ctrl_quiet(f\"/api/session/{session_id}/interrupt\")\n            raise ServeSecurityError(\n                \"serve requested interactive form during tool drain\"\n            )\n        ev_msg_id = data.get(\"assistantMessageID\")\n        ev_sid = data.get(\"sessionID\")\n        sid_optional = ev_sid is None and event_type in (\n            \"permission.asked\",\n            \"session.execution.failed\",\n            \"session.step.failed\",\n        )\n        if (ev_sid != session_id and not sid_optional) or (\n            assistant_message_id and ev_msg_id and ev_msg_id != assistant_message_id\n        ):\n            continue\n        mapped = _map_serve_event(event)\n        if mapped is None:\n            continue\n        mapped_kind, payload = mapped\n        if mapped_kind == \"permission\":\n            request_id = str(payload.get(\"id\") or \"\")\n            reject_failed = ctrl_http is None\n            if ctrl_http is not None:\n                try:\n                    status, _body = ctrl_http(\n                        \"POST\",\n                        f\"/api/session/{session_id}/permission/{request_id}/reply\",\n                        {\"decision\": \"reject\"},\n                    )\n                    reject_failed = status >= 300\n                except (\n                    OSError,\n                    http.client.HTTPException,\n                    ServeUnavailable,\n                    ServeClientDisconnect,\n                    ServeStartupDeadlineExceeded,\n                ):\n                    reject_failed = True\n            if reject_failed:\n                _ctrl_quiet(f\"/api/session/{session_id}/interrupt\")\n                raise ServeSecurityError(\"permission reject failed\")\n            continue\n        if mapped_kind == \"error\":\n            result[\"error\"] = payload\n            result[\"transient_error\"] = _is_transient_stream_error(payload)\n            result[\"terminal\"] = \"failed\"\n            return False\n        if mapped_kind in (\"reasoning\", \"text\"):\n            _check_bytes(mapped_kind, payload)\n            if mapped_kind == \"reasoning\":\n                text_value = str(payload.get(\"reasoning_content\") or \"\")\n                if text_value:\n                    if result[\"first_token_at\"] is None and t0:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"reasonings\"].append(text_value)\n                    if reasoning_cb is not None:\n                        reasoning_cb(text_value)\n            else:\n                text_value = str(payload.get(\"content\") or \"\")\n                if text_value:\n                    if result[\"first_token_at\"] is None and t0:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"texts\"].append(text_value)\n                    if text_cb is not None and not emulate_tools:\n                        text_cb(text_value)\n            continue\n        if mapped_kind == \"tool_event\":\n            if not assistant_message_id and ev_msg_id:\n                assistant_message_id = ev_msg_id\n            tool_state.feed(payload)\n            _check_bytes(\"tool_event\", {})\n            if event_type in (\n                \"session.tool.called\",\n                \"session.tool.failed\",\n                \"session.tool.success\",\n            ):\n                done = tool_state.complete(str(payload.get(\"id\") or \"\"), event_type)\n                if done is not None:\n                    pending.append(done[1])\n            continue\n        if mapped_kind == \"step_finish\":\n            if result[\"error\"] is not None:\n                return False\n            for call_id in list(tool_state.tools):\n                done = tool_state.complete(call_id, event_type)\n                if done is not None:\n                    pending.append(done[1])\n            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                usage[key] = usage.get(key, 0) + _as_int(payload.get(key))\n            if pending_calls is None:\n                for call in pending:\n                    result[\"native_calls\"].append(call)\n                    on_tool(call)\n            return True\n    return False\n\n\ndef _read_serve_events(\n    sse_resp: http.client.HTTPResponse,\n    events: queue.Queue[dict[str, object] | None],","isEmpty":false,"exceededLimit":false,"totalLines":8761,"fileSize":381598,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3480,"endLine":3599},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-3\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_0","startedAtMs":"1793127228177","completedAtMs":"1793127228333"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228408}
{"type":"tool_call","subtype":"started","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-4\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":3980,"limit":120}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-4\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_1","startedAtMs":"1793127228335"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228411}
{"type":"tool_call","subtype":"completed","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-4\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":3980,"limit":120},"result":{"success":{"content":"        created_data = created.get(\"data\")\n        if (\n            status != 200\n            or not isinstance(created_data, dict)\n            or not created_data.get(\"id\")\n        ):\n            raise ServeUnavailable(f\"serve create HTTP {status}\")\n        session_id = str(created_data[\"id\"])\n        if aux.exhausted():\n            raise ServeStartupDeadlineExceeded(\"aux io budget exhausted\")\n        _aux_started = aux.now_s()\n        try:\n            opened = _open_serve_events(\n                port, password, aux.deadline(attempt_deadline), is_client_gone\n            )\n        finally:\n            aux.debit_elapsed(_aux_started)\n        return opened\n\n    try:\n        sse_conn, sse_resp = _open_session()\n        events: queue.Queue[dict[str, object] | None] = queue.Queue(maxsize=4096)\n        stop_event = threading.Event()\n        queued_bytes = [0]\n        queue_bytes_lock = threading.Lock()\n        accumulated_bytes = 0\n        current_step_msg_id = \"\"\n\n        def _release_event(event: dict[str, object]) -> None:\n            \"\"\"Вернуть байтовый резерв после извлечения события из очереди.\"\"\"\n            with queue_bytes_lock:\n                queued_bytes[0] -= _as_int(event.pop(\"_raw_bytes\", 0))\n\n        if sse_conn.sock is not None:\n            # Без таймаута сокета: после первого таймаута SocketIO считает поток закрытым,\n            # а любая пауза SSE > 0.5 с превращалась бы в ложный EOF. Остановка — shutdown в finally.\n            _ = sse_conn.sock.settimeout(None)\n        if on_startup_ready is not None:\n            on_startup_ready()\n\n        reader_thread = threading.Thread(\n            target=_read_serve_events,\n            args=(\n                sse_resp,\n                events,\n                stop_event,\n                queued_bytes,\n                queue_bytes_lock,\n                _release_event,\n            ),\n            daemon=True,\n        )\n        reader_thread.start()\n        prompt_send_start = time.monotonic()\n\n        def _prompt_worker() -> None:\n            \"\"\"Доставка prompt параллельно чтению SSE.\"\"\"\n\n            def _on_headers(status_code: int = 200) -> None:\n                prompt_status[\"headers_at\"] = time.monotonic()\n                prompt_status[\"status\"] = status_code\n                if status_code in (401, 403):\n                    prompt_status[\"security\"] = True\n\n            try:\n                st, _body = _serve_http(\n                    port,\n                    password,\n                    \"POST\",\n                    f\"/api/session/{session_id}/prompt\",\n                    {\"text\": prompt, \"files\": [], \"delivery\": \"steer\", \"resume\": True},\n                    timeout=65.0,\n                    on_headers=_on_headers,\n                    deadline=attempt_deadline,\n                    is_client_gone=is_client_gone,\n                )\n                prompt_status[\"status\"] = st\n                if st in (401, 403):\n                    prompt_status[\"security\"] = True\n            except (OSError, http.client.HTTPException) as exc:\n                prompt_status[\"error\"] = str(exc)\n            except ServeProtocolError as exc:\n                prompt_status[\"protocol_error\"] = str(exc)\n            finally:\n                headers_at = prompt_status.get(\"headers_at\")\n                if isinstance(headers_at, (int, float)):\n                    aux.debit_seconds(float(headers_at) - prompt_send_start)\n                else:\n                    aux.debit_seconds(time.monotonic() - prompt_send_start)\n\n        prompt_thread = threading.Thread(target=_prompt_worker, daemon=True)\n        prompt_thread.start()\n        tool_state = _ServeToolState()\n        pending_step_calls: list[dict[str, object]] = []\n        seen_steps: set[str] = set()\n        deadline = min(\n            deadline if deadline is not None else prompt_send_start + TIMEOUT_S,\n            prompt_send_start + TIMEOUT_S,\n        )\n        status_next = max(t0 + FIRST_STATUS_DELAY_S, prompt_send_start + 0.25)\n        _status_emitted = [0]\n        last_token_at = prompt_send_start\n        while time.monotonic() < deadline:\n            if is_client_gone is not None and is_client_gone():\n                result[\"exit_reason\"] = \"client_gone\"\n                return result\n            if prompt_status.get(\"protocol_error\"):\n                result[\"exit_reason\"] = \"invalid_serve_event\"\n                return result\n            now = time.monotonic()\n            if result[\"first_event_at\"] is None and now - prompt_send_start > float(\n                FIRST_EVENT_TIMEOUT_S\n            ):\n                result[\"exit_reason\"] = \"first_event_timeout\"\n                result[\"delivered\"] = _is_delivered()\n                return result\n            if (\n                result[\"first_event_at\"] is not None\n                and result[\"first_token_at\"] is None\n                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)","isEmpty":false,"exceededLimit":false,"totalLines":8761,"fileSize":381598,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3980,"endLine":4099},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-4\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_1","startedAtMs":"1793127228335","completedAtMs":"1793127228491"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228568}
{"type":"tool_call","subtype":"started","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-5\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":4280,"limit":160}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-5\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_2","startedAtMs":"1793127228492"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228569}
{"type":"tool_call","subtype":"completed","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-5\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":4280,"limit":160},"result":{"success":{"content":"            elif etype == \"tool_event\":\n                if etype_raw == \"session.tool.input.delta\":\n                    last_token_at = time.monotonic()\n                tool_state.feed(payload)\n                accumulated_bytes = _serve_accumulated_bytes(\n                    accumulated_bytes, etype, payload, tool_state\n                )\n                call_id = str(payload.get(\"id\") or \"\")\n                if etype_raw in (\n                    \"session.tool.called\",\n                    \"session.tool.failed\",\n                    \"session.tool.success\",\n                ):\n                    done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        last_token_at = time.monotonic()\n                        pending_step_calls.append(done[1])\n                        if result[\"first_token_at\"] is None:\n                            result[\"first_token_at\"] = time.monotonic()\n                            result[\"ttft_ms\"] = int(\n                                ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                            )\n                        if emulate_tools:\n                            _acc_box = [accumulated_bytes]\n                            _ = _finish_serve_tool_step(\n                                events,\n                                session_id,\n                                data_raw.get(\"assistantMessageID\")\n                                or current_step_msg_id\n                                or None,\n                                min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\n                                tool_state,\n                                result,\n                                on_tool,\n                                _release_event,\n                                pending_calls=pending_step_calls,\n                                ctrl_http=_drain_ctrl,\n                                reasoning_cb=on_reasoning,\n                                text_cb=on_text,\n                                emulate_tools=emulate_tools,\n                                accumulated_bytes=_acc_box,\n                                t0=t0,\n                            )\n                            accumulated_bytes = _acc_box[0]\n                            break\n            elif etype == \"step_finish\":\n                step_key = str(\n                    _as_dict(payload).get(\"assistantMessageID\")\n                    or data_raw.get(\"assistantMessageID\")\n                    or \"\"\n                )\n                if step_key and step_key in seen_steps:\n                    continue\n                if step_key:\n                    seen_steps.add(step_key)\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n                        payload.get(key)\n                    )\n                # Завершить native вызовы без called: аргументы из input.ended.text.\n                for call_id in list(tool_state.tools):\n                    done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        last_token_at = time.monotonic()\n                        pending_step_calls.append(done[1])\n                # step_finish — это session.step.ended: pending публикуется один раз.\n                for pending_call in pending_step_calls:\n                    result[\"native_calls\"].append(pending_call)\n                    on_tool(pending_call)\n                pending_step_calls.clear()\n                if result[\"native_calls\"] or (\n                    emulate_tools and _split_tool_calls([\"\".join(result[\"texts\"])])[1]\n                ):\n                    if result[\"first_token_at\"] is None and result[\"native_calls\"]:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"terminal\"] = \"tool_calls\"\n                    break\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"delivered\"] = _is_delivered()\n                result[\"transient_error\"] = _is_transient_stream_error(payload)\n                result[\"terminal\"] = \"failed\"\n                break\n            elif etype_raw == \"session.execution.succeeded\":\n                for pending_call in pending_step_calls:\n                    result[\"native_calls\"].append(pending_call)\n                    on_tool(pending_call)\n                pending_step_calls.clear()\n                result[\"terminal\"] = \"succeeded\"\n                break\n        if (\n            not result[\"terminal\"]\n            and not result[\"exit_reason\"]\n            and time.monotonic() >= deadline\n        ):\n            result[\"exit_reason\"] = \"timeout\"\n        result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n        return result\n    except (ServeClientDisconnect, ServeStartupDeadlineExceeded) as exc:\n        result[\"exit_reason\"] = (\n            \"client_gone\" if isinstance(exc, ServeClientDisconnect) else \"timeout\"\n        )\n        result[\"delivered\"] = True\n        return result\n    except (OSError, http.client.HTTPException, ServeProtocolError) as exc:\n        result[\"exit_reason\"] = _serve_attempt_error_reason(\n            exc, attempt_deadline, is_client_gone, _is_delivered()\n        )\n        result[\"delivered\"] = _is_delivered() | (\n            result[\"exit_reason\"] in (\"client_gone\", \"timeout\")\n        )\n        result[\"transient_error\"] = result[\"exit_reason\"] == \"prompt_error\"\n        return result\n    finally:\n        result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n        _cleanup_serve_attempt(\n            lease,\n            port,\n            password,\n            session_id,\n            sse_conn,\n            control_conn[0],\n            stop_event,\n            reader_thread,\n            prompt_thread,\n        )\n        result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n\n\ndef _new_exit_state() -> dict[str, Any]:\n    return {\n        \"t0\": time.monotonic(),\n        \"mode\": \"\",\n        \"model\": \"\",\n        \"status\": 0,\n        \"exit_reason\": \"\",\n        \"attempts\": None,\n        \"tools\": 0,\n        \"out_chars\": 0,\n        \"rc\": None,\n        \"transport\": \"none\",\n        \"first_event_ms\": None,\n        \"ttft_ms\": None,\n        \"transport_history\": [],\n    }\n\n\ndef _log_exit(xs: dict[str, Any]) -> None:\n    \"\"\"O-EXIT/v1: одна структурная строка bridge.log на каждый выход Handler.do_POST.\"\"\"\n    attempts_obj = xs.get(\"attempts\")\n    attempts_t = attempts_obj if isinstance(attempts_obj, _RequestAttempts) else None\n    status_obj = xs.get(\"status\")\n    status = status_obj if isinstance(status_obj, int) else 0\n    reason_obj = xs.get(\"exit_reason\")\n    reason = (reason_obj if isinstance(reason_obj, str) and reason_obj else \"\") or (\n        \"ok\" if status == 200 else (f\"http_{status}\" if status else \"client_gone\")","isEmpty":false,"exceededLimit":false,"totalLines":8761,"fileSize":381598,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":4280,"endLine":4439},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-5\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_2","startedAtMs":"1793127228492","completedAtMs":"1793127228678"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228766}
{"type":"tool_call","subtype":"started","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-6\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5640,"limit":80}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-6\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_3","startedAtMs":"1793127228693"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228779}
{"type":"tool_call","subtype":"completed","call_id":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-6\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5640,"limit":80},"result":{"success":{"content":"\ndef _google_request(\n    model: str,\n    prompt: str,\n    effort: str,\n    stream: bool,\n    google_input: GoogleInput | None = None,\n):\n    \"\"\"Открыть HTTP напрямую: прокси из окружения здесь не используются.\"\"\"\n    meta = ALLOWED_MODELS[model]\n    base = urlsplit(meta[\"base_url\"].rstrip(\"/\"))\n    token, org_id = _resolve_opencode_go_auth()\n    headers = {\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"curl/8.7.1\",\n        \"x-goog-api-key\": token,\n        \"Authorization\": f\"Bearer {token}\",\n        \"x-opencode-session\": \"dsh\",\n    }\n    if org_id:\n        headers[\"x-opencode-org-id\"] = org_id\n    contents, system_instruction = (\n        google_input if google_input is not None else (None, \"\")\n    )\n    body = json.dumps(\n        _build_google_payload(\n            prompt,\n            effort,\n            int(meta.get(\"max_output\") or 65536),\n            contents,\n            system_instruction,\n        ),\n        ensure_ascii=False,\n    ).encode(\"utf-8\")\n    action = \"streamGenerateContent?alt=sse\" if stream else \"generateContent\"\n    path = f\"{base.path}/models/{quote(model, safe='')}:{action}\"\n    cls = (\n        http.client.HTTPSConnection\n        if base.scheme == \"https\"\n        else http.client.HTTPConnection\n    )\n    conn = cls(base.hostname or \"127.0.0.1\", base.port, timeout=TIMEOUT_S)\n    try:\n        conn.request(\"POST\", path, body=body, headers=headers)\n        return conn, conn.getresponse()\n    except Exception:\n        conn.close()\n        raise\n\n\ndef _execute_google_once(model: str, prompt: str, effort: str,\n                         google_input: GoogleInput | None = None) -> dict[str, Any]:\n    \"\"\"Нативный Google-ответ в том же формате, что результат CLI-прогона.\"\"\"\n    conn = None\n    run_id = uuid.uuid4().hex[:8]\n    with _active_lock:\n        _active[run_id] = time.time()\n    try:\n        conn, resp = _google_request(model, prompt, effort, False, google_input)\n        raw = resp.read().decode(\"utf-8\", errors=\"replace\")\n        if resp.status != 200:\n            return {\"rc\": 1, \"text\": \"\", \"chunks\": [], \"native_calls\": [], \"reasoning\": \"\", \"usage\": {},\n                    \"err\": f\"HTTP {resp.status}: {_clean_err(raw)}\", \"provider_status\": resp.status,\n                    \"had_output\": False, \"state\": \"provider_error\", \"finish\": \"error\"}\n        event = json.loads(raw)\n        if not isinstance(event, dict):\n            raise ValueError(\"google response is not a JSON object\")\n        candidates = event.get(\"candidates\") or []\n        cand = candidates[0] if candidates else {}\n        finish_reason = cand.get(\"finishReason\")\n        parts = (cand.get(\"content\") or {}).get(\"parts\") or []\n        texts: list[str] = []\n        thoughts: list[str] = []\n        for part in parts:\n            text = part.get(\"text\")\n            if isinstance(text, str) and text:\n                (thoughts if part.get(\"thought\") is True else texts).append(text)\n        text, reasoning = \"\".join(texts), \"\".join(thoughts)\n        truncated = False\n        while (loop_idx := _detect_repetition_loop(text)) is not None:","isEmpty":false,"exceededLimit":false,"totalLines":8761,"fileSize":381598,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5640,"endLine":5719},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-70f4e8fb-1b2f-43da-8565-96dbbbfaf82f-6\nfc_9a3bce75-323e-9529-b99a-3c429eca3662_3","startedAtMs":"1793127228693","completedAtMs":"1793127228859"},"model_call_id":"0233a586-25ac-4a42-a59f-c8b41c75029b-1-n4o0","session_id":"c1fe0275-dd40-4ac8-b885-923a206b222a","timestamp_ms":1793127228939}
