assert helper.stdout is not None\n        out_fd = helper.stdout.fileno()\n        _hs_deadline = time.monotonic() + 3.0\n        ready, _w, _x = select.select(\n            [out_fd], [], [], max(0.0, _hs_deadline - time.monotonic())\n        )\n        if not ready:\n            raise ServeUnavailable(\"serve helper handshake timeout\")\n        line_bytes = b\"\"\n        while not line_bytes.endswith(b\"\\n\"):\n            if time.monotonic() >= _hs_deadline:\n                lease.cleanup()\n                raise ServeUnavailable(\"serve helper handshake timeout\")\n            _ready, _w2, _x2 = select.select(\n                [out_fd], [], [], max(0.0, _hs_deadline - time.monotonic())\n            )\n            if not _ready:\n                lease.cleanup()\n                raise ServeUnavailable(\"serve helper handshake timeout\")\n            chunk_b = os.read(out_fd, 1)\n            if not chunk_b:\n                break\n            line_bytes += chunk_b\n        line = line_bytes.decode(\"utf-8\", \"replace\")\n        handshake = _as_dict(_loads_object(line)) if line else {}","isEmpty":false,"exceededLimit":false,"totalLines":6794,"fileSize":307751,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2488,"endLine":2567},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-c6a36ee0-033f-42b2-8914-da1f526c5862-10\nfc_9736530f-1e7b-9fc7-b317-fb03c78b690e_1","startedAtMs":"1793055521366","completedAtMs":"1793055521421"},"model_call_id":"ec202bad-6245-429f-9daa-a3ead7c823f0-3-luu7","session_id":"8ae9097d-4060-4b2c-a6c1-f1af67cf7120","timestamp_ms":1793055521451}
