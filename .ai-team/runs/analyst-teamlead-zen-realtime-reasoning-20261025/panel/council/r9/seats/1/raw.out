вый видимый статус не позднее 1.0 с даже при ожидании гейта/спавна.\n+            _model_seen = threading.Event()\n+            _orig_reasoning, _orig_text = on_reasoning, on_text\n+\n+            def _reasoning_seen(\n+                text: str, _f: Callable[[str], None] = _orig_reasoning\n+            ) -> None:\n+                _model_seen.set()\n+                _f(text)\n+\n+            _prior_text = \"\".join(collected_texts)\n+            _dedup_text = (\n+                _PrefixDedup(_prior_text) if serve_attempts and _prior_text else None\n+            )\n+\n+            def _text_seen(text: str, _f: Callable[[str], None] = _orig_text) -> None:\n+                _model_seen.set()\n+                if _dedup_text is not None:\n+                    text = _dedup_text.push(text)\n+                    if not text:\n+                        return\n+                _f(text)\n+\n+            _t0_req = attempts.deadline - TIMEOUT_S\n+\n+            def _initial_status_timer() -> None:\n+                _wait = max(0.0, _t0_req + FIRST_STATUS_DELAY_S - time.monotonic())\n+                if not _model_seen.wait(timeout=_wait) and thinking:\n+                    try:\n+                        on_status(STATUS_INITIAL)\n+                    except (OSError, ValueError):\n+                        pass\n+\n+            threading.Thread(target=_initial_status_timer, daemon=True).start()\n+            gate = _StartupGate()\n+            gate.acquire()\n+            _limiter_ok = res.spawn_limiter.acquire(\n+                max_wait_s=min(SPAWN_WAIT_MAX_S, attempts.remaining_s())\n+            )\n+            if not _limiter_ok:\n+                gate.release()\n+                if not force_serve:\n+                    return False\n+                xs[\"exit_reason\"] = \"upstream_failed\"\n+                self._sse_error(_error_payload(\"serve spawn limiter timeout\"))\n+                return True\n             attempts.note_spawn()\n             serve_attempts += 1