t)\\nfor f in files[:2]:\\n    for start, end in ranges[f]:\\n        run([*ruff,'format','--config',str(root / 'ruff.toml'),'--check','--no-cache',f'--range={start}:1-{end}:999',str(f)], cwd=root)\\nassert_frozen()\\n# Exercise actual write-mode range formatting only on a disposable copy.\\nwith tempfile.TemporaryDirectory(prefix='zen-arch6-probe-format-', dir='/tmp') as format_dir:\\n    formatted_copy = Path(format_dir) / 'server.py'\\n    formatted_copy.write_bytes(files[0].read_bytes())\\n    for start, end in ranges[files[0]]:\\n        run([*ruff,'format','--config',str(root / 'ruff.toml'),'--no-cache',f'--range={start}:1-{end}:999',str(formatted_copy)], cwd=root)\\n    assert formatted_copy.read_bytes() == files[0].read_bytes()\\n    assert_frozen(formatted_copy)\\n    assert_frozen()\\n    print('PASS write-mode frozen hashes', {name:hashlib.sha256(data[2]).hexdigest() for name,data in frozen_slices(formatted_copy.read_bytes()).items()})\\n# Full-file lint on all three. Only inherited E402 import site is excepted on server.\\nlint = subprocess.run([*ruff,'check','--config',str(root / 'ruff.toml'),'--no-cache','--output-format','json',str(files[0])], cwd=root, capture_output=True, text=True)\\nassert lint.returncode in (0,1), lint.stderr\\nfindings = json.loads(lint.stdout)\\nlines = files[0].read_text().splitlines()\\nassert all(x['code']=='E402' and lines[x['location']['row']-1].strip()=='import zen_catalog as zc' for x in findings), findings\\nassert sum(x['code']=='E402' for x in findings) <= 1\\nrun([*ruff,'check','--config',str(root / 'ruff.toml'),'--no-cache','--extend-ignore','E402',str(files[0])], cwd=root)\\nrun([*ruff,'check','--config',str(root / 'ruff.toml'),'--no-cache',str(files[1]),str(files[2])], cwd=root)\\n# Exact isolated import-root. No repo pyrightconfig mutation; JSON deleted on every exit.\\nproject = None\\ntry:\\n    with tempfile.NamedTemporaryFile(mode='w',suffix='.json',prefix='zen-arch6-probe-project-',dir='/tmp',delete=False) as tmp:\\n        project = Path(tmp.name)\\n        json.dump({'include':[str(f) for f in files], 'extraPaths':[str(bridge.resolve())]},tmp)\\n    b = subprocess.run(['uvx','--from','basedpyright==1.40.2','basedpyright','--project',str(project),'--outputjson'], cwd=bridge, capture_output=True, text=True)\\n    assert b.returncode in (0,1), b.stderr\\n    report = json.loads(b.stdout)\\n    ds = report['generalDiagnostics']\\n    assert report['summary']['errorCount']==0 and not [x for x in ds if x['severity']=='error'], ds\\n    byfile = {f: [x for x in ds if Path(x['file']).resolve()==f] for f in files}\\n    limits = {'reportExplicitAny':125,'reportAny':125,'reportUnusedCallResult':39,'reportUnknownMemberType':94,'reportUnknownVariableType':72,'reportUnknownArgumentType':55,'reportUnusedFunction':6,'reportImplicitStringConcatenation':35,'reportUnannotatedClassAttribute':105,'reportUnusedParameter':7,'reportUnnecessaryIsInstance':11,'reportUnknownParameterType':6,'reportMissingParameterType':4,'reportUnreachable':5,'reportImplicitOverride':3}\\n    warnings = lambda f: [x for x in byfile[f] if x['severity']=='warning']\\n    counts = collections.Counter(x.get('rule','') for x in warnings(files[0]))\\n    print('BASEDPYRIGHT summary',report['summary'])\\n    print('SERVER dict(counts)',dict(counts))\\n    print('SERVER warningCount',len(warnings(files[0])))\\n    assert all(n<=limits.get(rule,0) for rule,n in counts.items()), dict(counts)\\n    assert len(warnings(files[0]))<=720, len(warnings(files[0]))\\n    assert len(warnings(files[1]))<=194, len(warnings(files[1]))\\n    # New test file: zero warnings as well as zero errors, thus zero Any.\\n    assert not byfile[files[2]], byfile[files[2]]\\n    for f in files[:2]:\\n        for x in byfile[f]:\\n            line = x['range']['start']['line']+1\\n            if any(lo<=line<=hi for lo,hi in ranges[f]):\\n                assert x.get('rule') not in {'reportAny','reportExplicitAny','reportUnusedCallResult'}, x\\n    # Do not introduce Any annotations/type ignores in added code in either legacy file.\\n    for f in files[:2]:\\n        src = f.read_text().splitlines()\\n        for lo,hi in ranges[f]:\\n            for line in src[lo-1:hi]:\\n                assert not re.search(r'\\\\bAny\\\\b|type:\\\\s*ignore|pyright:\\\\s*ignore|#\\\\s*noqa|#\\\\s*fmt:\\\\s*off',line), (f,line)\\n    run(['python3','-B','-m','unittest','tests.test_catalog_mode','-v'],cwd=bridge)\\n    print('PASS VER-004: all3 lint/type; legacy changed-range format; newfile whole format; server counts',dict(counts))\\nfinally:\\n    if project is not None: project.unlink(missing_ok=True)\\nVER004\",\n        \"cwd\": \".\"\n      },\n      {\n        \"id\": \"L2-VER-001-pytest-component\",\n        \"cmd\": \"uvx pytest -q -p no:cacheprovider tests/\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      },\n      {\n        \"id\": \"L2-VER-002-unittest-discover\",\n        \"cmd\": \"python3 -m unittest discover -s tests -p 'test_*.py'\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      },\n      {\n        \"id\": \"L2-VER-003-pytest-root-import\",\n        \"cmd\": \"PYTHONPATH=. uvx pytest -q -p no:cacheprovider bridges/opencode-zen-bridge/tests/\",\n        \"cwd\": \".\"\n      },\n      {\n        \"id\": \"L2-VER-005-realtime-and-fault-oracles\",\n        \"cmd\": \"uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py tests/test_step_interruption.py tests/test_run_env.py tests/test_google_direct.py tests/test_catalog_mode.py\",\n        \"cwd\": \"bridges/opencode-zen-bridge\"\n      }\n    ],\n    \"L3\": {\n      \"status_pre_accept\": \"N/A_REPO_MARKERS_PLUS_POST_ACCEPT_LIVE_HEAVY_PATH\",\n      \"note\": \"Repo has no pytest heavy/measured markers (entire component suite runs in L2). Live runtime checks H0..H9 / VER-006/VER-007 on deployed LaunchAgent 127.0.0.1:9883 are DEFERRED_L3 until Council ACCEPT + cp sync of server.py to ~/.dsh/bridges/opencode-zen-bridge/server.py so live production bridge is not mutated before Council ACCEPT.\",\n      \"deferred_checks\": [\n        {\n          \"id\": \"VER-006-live-sse-heavy-path\",\n          \"cmd\": \"Rollout ladder H0..H9 + curl -N -sS http://127.0.0.1:9883/v1/chat/completions (deepseek-v4.1-flash-free High, stream=true, multi-turn + tools + disconnect cleanup)\",\n          \"defer_reason\": \"Requires syncing ~/.dsh/bridges/opencode-zen-bridge/server.py after Council ACCEPT\"\n        },\n        {\n          \"id\": \"VER-007-deployed-mirror-diff\",\n          \"cmd\": \"diff -u bridges/opencode-zen-bridge/server.py ~/.dsh/bridges/opencode-zen-bridge/server.py\",\n          \"defer_reason\": \"Synced post-ACCEPT after backup to ~/work/backups/\"\n        }\n      ]\n    }\n  },\n  \"acceptance_manifest_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md\",\n  \"architecture_packet_sha256\": \"88c02c37a7ca0be3d317217f23289dba07ddc681d922db207c7680a779128b6b\"\n}\nARTIFACT_END>>>\n<<<ARTIFACT .ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/teamlead/environment-manifest.json sha256=5dc27f9786133fc321f1eea8780e7dbffbecbb690c49c3a14f80863ff2de1ae7\n{\n  \"schema\": \"environment-manifest/v1\",\n  \"captured_at_utc\": \"2026-10-26T21:46:44.745635+00:00\",\n  \"run_id\": \"analyst-teamlead-zen-realtime-reasoning-20261025\",\n  \"platform\": {\n    \"system\": \"Darwin\",\n    \"release\": \"27.0.0\",\n    \"machine\": \"arm64\",\n    \"python_version\": \"3.14.7\",\n    \"python_executable\": \"/opt/homebrew/opt/python@3.14/bin/python3.14\"\n  },\n  \"tools\": {\n    \"uv\": \"uv 0.12.19 (bea138450 2026-09-24 aarch64-apple-darwin)\",\n    \"ruff\": \"ruff 0.17.2 (uvx --from ruff==0.17.2)\",\n    \"basedpyright\": \"basedpyright 1.40.2 (uvx --from basedpyright==1.40.2)\",\n    \"opencode\": \"opencode v2.1.2\",\n    \"git\": \"git version 2.54.0\"\n  },\n  \"isolation\": {\n    \"cleanroom_mode\": \"git worktree --detach at origin/dev (/tmp/cel-runs/zen-realtime