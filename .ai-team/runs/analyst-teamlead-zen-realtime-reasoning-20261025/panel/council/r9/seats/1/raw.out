6)\n    return env\n\n\ndef _is_native_opencode_bin(path: str) -> bool:","isEmpty":false,"exceededLimit":false,"totalLines":6794,"fileSize":307751,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1688,"endLine":1727},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-c6a36ee0-033f-42b2-8914-da1f526c5862-11\nfc_9736530f-1e7b-9fc7-b317-fb03c78b690e_2","startedAtMs":"1793055521579","completedAtMs":"1793055521634"},"model_call_id":"ec202bad-6245-429f-9daa-a3ead7c823f0-3-luu7","session_id":"8ae9097d-4060-4b2c-a6c1-f1af67cf7120","timestamp_ms":1793055521665}
