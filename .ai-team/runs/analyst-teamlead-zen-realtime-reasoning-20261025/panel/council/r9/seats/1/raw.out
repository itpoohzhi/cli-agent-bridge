rue(attempts.can_spawn())\n            attempts.note_spawn()\n        self.assertFalse(attempts.can_spawn())\n        self.assertTrue(callable(server._next_standalone_proxy))  # pyright: ignore[reportPrivateUsage] — причина: тест проверяет приватный/динамический API моста, тип уточнён аннотациями вокруг\n\n    def test_elf_magic_and_tool_status(self) -> None:\n        \"\"\"FU-001/FU-002: 4 случайных байта не ELF, статус tool из типа события.\"\"\"","isEmpty":false,"exceededLimit":false,"totalLines":886,"fileSize":50277,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/tests/test_realtime_reasoning.py","readRange":{"startLine":850,"endLine":874},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-c6a36ee0-033f-42b2-8914-da1f526c5862-16\nfc_9736530f-1e7b-9fc7-b317-fb03c78b690e_7","startedAtMs":"1793055523014","completedAtMs":"1793055523068"},"model_call_id":"ec202bad-6245-429f-9daa-a3ead7c823f0-3-luu7","session_id":"8ae9097d-4060-4b2c-a6c1-f1af67cf7120","timestamp_ms":1793055523098}
