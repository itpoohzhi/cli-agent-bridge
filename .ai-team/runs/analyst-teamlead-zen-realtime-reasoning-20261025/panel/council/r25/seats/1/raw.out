атывают. `timed_out` выставляется, когда `lines()`\n1135:     остановился по дедлайну (вызывающий сам останавливает процесс). Очередь ограничена `maxsize`:\nLINES 1684 1747\n1684: def _read_dynamic_config_enabled(path: Path | None = None) -> bool:\n1685:     \"\"\"Boolean REALTIME_SERVE_ENABLED из dynamic_config.json с кэшем по stat.\"\"\"\n1686:     target = DYNAMIC_CONFIG_PATH if path is None else path\n1687:     try:\n1688:         stat = target.stat()\n1689:     except OSError:\n1690:         _dynamic_config_cache.update({\"key\": None, \"value\": False, \"path\": str(target)})\n1691:         return False\n1692:     key = (stat.st_mtime_ns, stat.st_size)\n1693:     if (\n1694:         _dynamic_config_cache.get(\"path\") == str(target)\n1695:         and _dynamic_config_cache.get(\"key\") == key\n1696:     ):\n1697:         return bool(_dynamic_config_cache.get(\"value\"))\n1698:     value = False\n1699:     try:\n1700:         data = _as_dict(_loads_object(target.read_text(\"utf-8\")))\n1701:         enabled_obj = data.get(\"REALTIME_SERVE_ENABLED\")\n1702:         if isinstance(enabled_obj, bool):\n1703:             value = enabled_obj\n1704:     except OSError:\n1705:         value = False\n1706:     _dynamic_config_cache.update({\"key\": key, \"value\": value, \"path\": str(target)})\n1707:     return value\n1708: \n1709: \n1710: _dynamic_config_enabled = _read_dynamic_config_enabled\n1711: \n1712: \n1713: def _serve_permission_effect() -> str:\n1714:     \"\"\"Эффект permission из env политики: ask_reject -> ask, deny -> deny.\"\"\"\n1715:     policy = os.environ.get(\n1716:         \"OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY\", \"ask_reject\"\n1717:     ).strip()\n1718:     if policy == \"ask_reject\":\n1719:         return \"ask\"\n1720:     if policy == \"deny\":\n1721:         return \"deny\"\n1722:     raise ServeSecurityError(f\"unsupported serve permission policy: {policy}\")\n1723: \n1724: \n1725: def _serve_env(model_id: str = \"\") -> dict[str, s