lf.pgid, signal.SIGTERM)\n2457:             except OSError:\n2458:                 pass\n2459:             while time.monotonic() < _deadline:\n2460:                 if not _pid_alive(-self.pgid) and self.helper.poll() is not None:\n2461:                     break\n2462:                 time.sleep(0.05)\n2463:             if _pid_alive(-self.pgid) or self.helper.poll() is None:\n2464:                 try:\n2465:                     os.killpg(self.pgid, signal.SIGKILL)\n2466:                 except OSError:\n2467:                     pass\n2468:                 # Отдельное окно подтверждения смерти группы после SIGKILL (бюджет AC-011 <= 7 с).\n2469:                 _deadline = time.monotonic() + 2.0\n2470:                 while time.monotonic() < _deadline:\n2471:                     if not _pid_alive(-self.pgid) and self.helper.poll() is not None:\n2472:                         break\n2473:                     time.sleep(0.05)\n2474:             try:\n2475:                 _ = self.helper.wait(timeout=max(0.1, _deadline - time.monotonic()))\n2476:             except (OSError, subprocess.SubprocessError):\n2477:                 pass\n2478:         for stream in (self.helper.stdout, self.helper.stderr):\n2479:             try:\n2480:                 if stream is not None:\n2481:                     stream.close()\n2482:             except OSError:\n2483:                 pass\n2484:         if not _pid_alive(-self.pgid):\n2485:             try:\n2486:                 (self.lease_dir / f\"lease-{self.attempt_id}.json\").unlink()\n2487:             except OSError:\n2488:                 pass\n2489:             if self.port:\n2490:                 with _PORT_ALLOC_LOCK:\n2491:                     _ACTIVE_SERVE_PORTS.discard(self.port)\n2492:         if self.state_dir and Path(self.state_dir).name.startswith(\"zen-serve-state-\"):\n2493:             shutil.rmtree(self.state_dir, ignore_errors=True)\n2494: \n2495: \n2496: def _ensure_lease_dir(lease_dir: Path) -> None:\n249