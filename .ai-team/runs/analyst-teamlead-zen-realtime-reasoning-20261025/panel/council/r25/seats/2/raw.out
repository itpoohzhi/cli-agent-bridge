{"type":"tool_call","subtype":"completed","call_id":"call-393d3862-26b9-45c6-bcb1-f9f85eea8159-8\nfc_94558539-3e26-9762-b0d5-4fd44f0d49f0_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":1761,"limit":50},"result":{"success":{"content":"def _select_transport(res: _Resilience | None = None) -> str:\n    \"\"\"Выбор транспорта: serve или run по приоритетам kill-switch.\"\"\"\n    transport = os.environ.get(\"OPENCODE_ZEN_BRIDGE_TRANSPORT\", \"auto\").strip().lower()\n    override = (\n        os.environ.get(\"OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED\", \"\").strip().lower()\n    )\n    if transport == \"run\" or override in (\"0\", \"false\", \"no\", \"off\"):\n        return \"run\"\n    disable_raw = os.environ.get(\n        \"OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE\",\n        \"~/.dsh/bridges/opencode-zen-bridge/disable-serve\",\n    )\n    try:\n        if Path(disable_raw).expanduser().exists():\n            return \"run\"\n    except OSError:\n        return \"run\"\n    health = res.serve_health if res is not None else None\n    if transport == \"serve\":\n        return \"serve\"\n    if transport != \"auto\":\n        return \"run\"\n    if health is not None and health.is_degraded():\n        return \"run\"\n    enabled = override in (\"1\", \"true\", \"yes\", \"on\") or _read_dynamic_config_enabled()\n    if not enabled:\n        return \"run\"\n    return \"serve\" if _is_native_opencode_bin(OPENCODE_BIN) else \"run\"\n\n\ndef _map_serve_event(\n    event: dict[str, object],\n) -> tuple[str, dict[str, object]] | None:\n    \"\"\"Wire-событие serve v2.1.2 -> канонический кортеж legacy-пути или None для служебных.\"\"\"\n    etype_obj = event.get(\"type\")\n    etype = etype_obj if isinstance(etype_obj, str) else \"\"\n    data = _as_dict(event.get(\"data\"))\n    if etype == \"server.connected\":\n        return etype, data\n    if not data:\n        # Служебные/неизвестные события serve без данных игнорируются, а не рвут попытку.\n        if etype in (\n            \"server.heartbeat\",\n            \"integration.updated\",\n            \"session.idle\",\n            \"server.connected\",\n        ) or not etype.startswith(\"session.\"):\n            return None\n        raise ServeProtocolError(\"invalid_serve_event: data\")\n    if etype in (\"session.reasoning.delta\", \"session.text.delta\"):","isEmpty":false,"exceededLimit":false,"totalLines":6992,"fileSize":317368,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1761,"endLine":1810},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-393d3862-26b9-45c6-bcb1-f9f85eea8159-8\nfc_94558539-3e26-9762-b0d5-4fd44f0d49f0_1","startedAtMs":"1793062693940","completedAtMs":"1793062693993"},"model_call_id":"0a696763-89d8-4fcf-b324-72fe71d998e1-7-8oj0","session_id":"0ad04250-9f04-4558-8392-f9ad0bdfa799","timestamp_ms":1793062694020}
