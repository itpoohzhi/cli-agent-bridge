\" not in xs or xs.get(\"first_event_ms\") is None:\n6801:                 xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n6802:             if \"ttft_ms\" not in xs or xs.get(\"ttft_ms\") is None:\n6803:                 xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n6804:             if result.get(\"exit_reason\") == \"client_gone\":\n6805:                 xs[\"exit_reason\"] = \"client_gone\"\n6806:                 return True\n6807:             # Токены неуспешных попыток тоже учитываются (как в потоковом пути).\n6808:             for _tk in (\"input\", \"output\", \"cached\", \"reasoning\"):\n6809:                 tokens[_tk] = tokens.get(_tk, 0) + int(result[\"usage\"].get(_tk) or 0)\n6810:             _delivered_j = bool(\n6811:                 delivered_any\n6812:                 or contents\n6813:                 or reasonings_all\n6814:                 or tool_calls_all\n6815:                 or texts\n6816:                 or reasonings\n6817:                 or natives\n6818:                 or result.get(\"delivered\")\n6819:             )\n6820:             delivered_any = _delivered_j\n6821:             if result.get(\"exit_reason\") in (\n6822:                 \"first_event_timeout\",\n6823:                 \"first_token_timeout\",\n6824:                 \"stall_timeout\",\n6825:                 \"invalid_serve_event\",\n6826:                 \"timeout\",\n6827:             ):\n6828:                 reason = str(result[\"exit_reason\"])\n6829:                 if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n6830:                     res.serve_health.record_failure()\n6831:                 else:\n6832:                     attempts.attempt_done(True, False)\n6833:                 if not _delivered_j and not force_serve:\n6834:                     return False\n6835:                 if attempts.allow_retry(reason):\n6836:                     continue\n6837:                 xs[\"exit_reason\"] = reason\n6838:                 self._send(502, _error_payload(f\"serve {reason}\"))\n6839:                 return True\n6840:             if result.get(\"prompt_status\") is not None:\n6841:                 _ps_j = int(result[\"prompt_status\"] or 0)\n6842:                 if _ps_j == 429 or 500 <= _ps_j <= 599:\n6843:                     attempts.attempt_done(True, False)\n6844:                 if not _delivered_j and not force_serve:\n6845:                     return False\n6846:                 if attempts.allow_retry(f\"prompt_status_{_ps_j}\"):\n6847:                     continue\n6848:                 xs[\"exit_reason\"] = f\"prompt_status_{_ps_j}\"\n6849:                 self._send(502, _error_payload(f\"serve prompt HTTP {_ps_j}\"))\n6850:                 return True\n6851:             if result[\"error\"] is not None:\n6852:                 err = result[\"error\"]\n6853:                 if result.get(\"transient_error\"):\n6854:                     attempts.attempt_done(True, False)\n6855:                     contents.extend(texts)\n6856:                     reasonings_all.extend(reasonings)\n6857:                     if not _delivered_j and not force_serve:\n6858:                         return False\n6859:                     if not texts and attempts.allow_retry(\"serve_transient_error\"):\n6860:                         continue\n6861:                     _sig_j = _incomplete_step_signal(\n6862:                         \"\".join(texts),\n6863:                         \"\".join(reasonings),\n6864:                         tools or [],\n6865:                         True,\n6866:                         int(result[\"usage\"].get(\"output\") or 0),\n6867:                         int(result[\"usage\"].get(\"reasoning\") or 0),\n6868:                         tool_choice=tool_choice,\n6869:                     )\n6870:                     if _sig_j and attempts.allow_retry(\"incomplete_step\"):\n6871:                         current_prompt = _rewrite_tool_tags_for_model(\n6872:                             _incomplete_tool_step_prompt(\n6873:                                 prompt,\n6874:                                 \"\".join(contents),\n6875:                                 tools or [],\n6876:                                 tool_choice,\n6877:                                 model,\n6878:                             ),\n6879:                             model,\n6880:                         )\n6881:                         continue\n6882:                 xs[\"exit_reason\"] = \"upstream_failed\"\n6883:                 self._send(\n6884:                     502,\n6885:                     _error_payload(\n6886:                         f\"serve error: {_clean_err(str(err.get('message') or ''))}\"\n6887:                     ),\n6888:                 )\n6889:                 return True\n6890:             if result.get(\"terminal\") == \"cancelled\":\n6891:                 xs[\"exit_reason\"] = \"cancelled\"\n6892:                 self._send(502, _error_payload(\"serve session cancelled\"))\n6893:                 return True\n6894:             res.serve_health.record_success()\n6895:             attempts.attempt_done(False, True)\n6896:             reasonings_all.extend(reasonings)\n6897:             content_raw = \"\".join(texts)\n6898:             calls: list[dict[str, object]] = []\n6899:             content = content_raw\n6900:             if emulate_tools and content_raw:\n6901:                 parsed_texts: list[str] = []\n6902:                 parser_json = ToolCallParser(parsed_texts.append, calls.append)\n6903:                 parser_json.feed(content_raw)\n6904:                 parser_json.finish()\n6905:                 content = \"\".join(parsed_texts)\n6906:                 content, _dropped = _strip_broken_tool_blocks(content)\n6907:             if _prior_content:\n6908:                 content = _dedup_retry_text(_prior_content, content)\n6909:             if content:\n6910:                 contents.append(content)\n6911:             for call in calls:\n6912:                 _add_call(call)\n6913:             unmapped: list[str] = []\n6914:             for native in natives:\n6915:                 part = _as_dict(native.get(\"part\"))\n6916:                 mapped = _native_call_as_dsh(native, tools) if emulate_tools else []\n6917:                 if not mapped and emulate_tools and part.get(\"tool\"):\n6918:                     unmapped.append(str(part.get(\"tool\")))\n6919:                 for call in mapped:\n6920:                     _add_call(call)\n6921:             usage = result[\"usage\"]\n6922:             if not emulate_tools or tool_calls_all:\n6923:                 break\n6924:             if unmapped:\n6925:                 if unmapped_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n6926:                     \"unmapped\"\n6927:                 ):\n6928:                     break\n6929:                 unmapped_retries += 1\n6930:                 _prior_content = \"\\n\\n\".join(c for c in contents if c)\n6931:                 current_prompt = _rewrite_tool_tags_for_model(\n6932:                     _unavailable_tools_prompt(\n6933:                         current_prompt, content_raw, unmapped, tools or [], model\n6934:                     ),\n6935:                     model,\n6936:                 )\n6937:                 continue\n6938:             signal = _incomplete_step_signal(\n6939:                 content_raw,\n6940:                 \"\".join(reasonings),\n6941:                 tools or [],\n6942:                 False,\n6943:                 int(usage.get(\"output\") or 0),\n6944:                 int(usage.get(\"reasoning\") or 0),\n6945:                 tool_choice=tool_choice,\n6946:             )\n6947:             if not signal:\n6948:                 break\n6949:             if incomplete_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n6950:                 \"incomplete_step\"\n6951:             ):\n6952:                 break\n6953:             incomplete_retries += 1\n6954:             _prior_content = \"\\n\\n\".join(c for c in contents if c)\n6955:             current_prompt = _rewrite_tool_tags_for_model(\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"Восемь исправлений проверены по коду: основные изменения присутствуют, но барьер доставки prompt остаётся неполным при ошибке чтения тела после HTTP-заголовков. Также обнаружены пробелы в гарантии первого статуса и обработке частичного JSON-ответа при повторе. Независимые L2-логи подтверждают зелёный набор; живую проверку L3 учитываю как законно отложенную.\n"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py')\na=p.read_text().splitlines()\nfor lo,hi in [(2390,2480),(3484,3549),(3573,3628),(5370,5409),(5486,5534),(5596,5641),(5922,5964),(4960,5020),(6075,6099),(7040,7105)]:\n print(f'RANGE {lo}-{hi}')\n print('\\\\n'.join(f'{i}: {a[i-1]}' for i in range(lo,hi+1)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py')\na=p.read_text().splitlines()\nfor lo,hi in [(2390,2480),(3484,3549),(3573,3628),(5370,5409),(5486,5534),(5596,5641),(5922,5964),(4960,5020),(6075,6099),(7040,7105)]:\n print(f'RANGE {lo}-{hi}')\n print('\\\\n'.join(f'{i}: {a[i-1]}' for i in range(lo,hi+1)))\nPY\"","aggregated_output":"RANGE 2390-2480\n2390:         res: _Resilience,\n2391:         deadline: float,\n2392:         max_total: int | None = None,\n2393:         sleep_fn: Callable[[float], None] = time.sleep,\n2394:         rng_fn: Callable[[float, float], float] = random.uniform,\n2395:         use_breaker: bool = True,\n2396:     ) -> None:\n2397:         self.res = res\n2398:         self.deadline = deadline\n2399:         self.use_breaker = (\n2400:             use_breaker  # False: прямой Google-маршрут без `opencode run`\n2401:         )\n2402:         self.max_total = MAX_TOTAL_SPAWNS if max_total is None else max_total\n2403:         self.total_spawns = 0\n2404:         self.retries = 0\n2405:         self.signal = 0\n2406:         self.exit_reason = \"\"\n2407:         self._pending_failure = False\n2408:         self._sleep = sleep_fn\n2409:         self._rng = rng_fn\n2410:         res.retry_budget.on_request()\n2411: \n2412:     def note_spawn(self) -> None:\n2413:         self.total_spawns += 1\n2414: \n2415:     def can_spawn(self) -> bool:\n2416:         \"\"\"Можно ли ещё запускать: суммарный потолок спавнов на запрос.\"\"\"\n2417:         return (\n2418:             self.total_spawns < MAX_TOTAL_SPAWNS and self.total_spawns < self.max_total\n2419:         )\n2420: \n2421:     def remaining_s(self) -> float:\n2422:         return max(0.0, self.deadline - time.monotonic())\n2423: \n2424:     def begin_attempt(self) -> bool:\n2425:         \"\"\"Первичный запуск: потолок, deadline и Circuit Breaker (в HALF_OPEN резервирует единственную пробу).\"\"\"\n2426:         return (\n2427:             self.total_spawns < self.max_total\n2428:             and time.monotonic() < self.deadline\n2429:             and (not self.use_breaker or self.res.breaker.allow())\n2430:         )\n2431: \n2432:     def allow_retry(self, reason: str, charge_budget: bool = True) -> bool:\n2433:         \"\"\"Можно ли сделать повторный запуск: потолок, deadline, breaker, Retry Budget; затем Full Jitter пауза.\n2434: \n2435:         charge_budget=False — локальный отказ старта CLI без обращения к провайдеру («database is locked»):\n2436:         он не нагружает апстрим, ограничен FAIL_RETRY_LIMIT, MAX_TOTAL_SPAWNS и темпом запусков.\n2437:         \"\"\"\n2438:         if self.total_spawns >= self.max_total:\n2439:             _log(f\"retry denied ({reason}): MAX_TOTAL_SPAWNS={self.max_total} reached\")\n2440:             return False\n2441:         if time.monotonic() >= self.deadline:\n2442:             return False\n2443:         if self.use_breaker and self.res.breaker.is_blocking():\n2444:             _log(f\"retry denied ({reason}): upstream circuit open\")\n2445:             return False\n2446:         if charge_budget and not self.res.retry_budget.try_acquire_retry():\n2447:             _log(f\"retry denied ({reason}): retry budget exhausted\")\n2448:             return False\n2449:         self.retries += 1\n2450:         delay = (\n2451:             _retry_backoff_s(self.retries, self._rng)\n2452:             if FAIL_RETRY_BACKOFF_S > 0\n2453:             else 0.0\n2454:         )\n2455:         delay = min(delay, self.remaining_s())\n2456:         if delay > 0:\n2457:             self._sleep(delay)\n2458:         return not self.use_breaker or self.res.breaker.allow()\n2459: \n2460:     def attempt_done(self, transient_failure: bool, success: bool) -> None:\n2461:         \"\"\"Итог попытки для Circuit Breaker: успех учитывается сразу, транзиентный отказ — по итогу запроса (commit).\n2462: \n2463:         Запрос, который повтором дошёл до успеха, апстрим не «роняет»; отказ засчитывается, только\n2464:         если запрос закончился отказом. Нейтральные итоги (таймаут, детерминированный 4xx) не считаются.\n2465:         \"\"\"\n2466:         if not self.use_breaker:\n2467:             return\n2468:         if success and not transient_failure:\n2469:             self._pending_failure = False\n2470:             self.res.breaker.record_success()\n2471:         else:\n2472:             self._pending_failure = transient_failure\n2473: \n2474:     def commit(self) -> None:\n2475:         \"\"\"Итог запроса: незакрытый транзиентный отказ последней попытки -> breaker.record_failure().\"\"\"\n2476:         if self._pending_failure:\n2477:             self._pending_failure = False\n2478:             self.res.breaker.record_failure()\n2479: \n2480: \nRANGE 3484-3549\n3484:                     on_text(text_value)\n3485:             elif etype == \"tool_event\":\n3486:                 if (\n3487:                     etype_raw == \"session.tool.input.delta\"\n3488:                     and result[\"first_token_at\"] is not None\n3489:                 ):\n3490:                     last_token_at = time.monotonic()\n3491:                 tool_state.feed(payload)\n3492:                 call_id = str(payload.get(\"id\") or \"\")\n3493:                 if etype_raw in (\n3494:                     \"session.tool.called\",\n3495:                     \"session.tool.failed\",\n3496:                     \"session.tool.success\",\n3497:                 ):\n3498:                     done = tool_state.complete(call_id, etype_raw)\n3499:                     if done is not None:\n3500:                         result[\"native_calls\"].append(done[1])\n3501:                         on_tool(done[1])\n3502:                         if result[\"first_token_at\"] is None:\n3503:                             result[\"first_