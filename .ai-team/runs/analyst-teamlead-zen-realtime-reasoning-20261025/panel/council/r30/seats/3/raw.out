one during keepalive, killing proc group\")\n6265:                         _stop_proc(proc)\n6266:                         raise\n6267: \n6268:                 feed = _StdoutFeed(proc)\nRANGE 6450-6480\n6450:                 if stopped_on_error and rc < 0:\n6451:                     rc = 1  # остановили сами после ошибки провайдера: для классификации отказа — как выход CLI\n6452:                 tail = _clean_err(err_lines[-6:])\n6453:                 transient_failure = had_provider_error or (\n6454:                     not attempt_output\n6455:                     and _is_retryable_failure(rc, tail, provider_status, False)\n6456:                 )\n6457:                 attempts.attempt_done(\n6458:                     transient_failure, attempt_output and not transient_failure\n6459:                 )\n6460:                 if watchdog_state.get(\"reason\"):\n6461:                     reason_w = str(watchdog_state[\"reason\"])\n6462:                     if attempts.allow_retry(reason_w):\n6463:                         emit_synthetic(\n6464:                             f\"[мост] Повтор попытки {attempts.total_spawns + 1}/{attempts.max_total}…\\n\"\n6465:                         )\n6466:                         continue\n6467:                     xs[\"exit_reason\"] = reason_w\n6468:                     failure = {\"rc\": rc, \"tail\": \"\", \"watchdog\": reason_w}\n6469:                     break\n6470:                 if timed_out:\n6471:                     failure = {\"rc\": rc, \"tail\": \"\", \"timeout\": True}\n6472:                     break\n6473:                 if rc != 0 and not attempt_output:\n6474:                     _log(f\"stream cli failed rc={rc} stderr_tail={tail!r}\")\n6475:                     if (\n6476:                         fail_retries < FAIL_RETRY_LIMIT\n6477:                         and time.monotonic() < deadline\n6478:                         and _is_retryable_failure(\n6479:                             rc, tail, provider_status, bo