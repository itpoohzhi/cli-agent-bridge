e = None\n1074:         self._done = threading.Event()\n1075:         self._thread = threading.Thread(target=self._reader, daemon=True)\n1076:         self._thread.start()\n1077: \n1078:     def _reader(self) -> None:\n1079:         try:\n1080:             assert self._proc.stdout is not None\n1081:             for raw in self._proc.stdout:\n1082:                 try:\n1083:                     self._queue.put_nowait(raw)\n1084:                 except queue.Full:\n1085:                     self.dropped_total += 1\n1086:                     self.overflowed = True\n1087:                     _log(f\"stdout_overflow queue_max={self._queue.maxsize} dropped_total={self.dropped_total}, \"\n1088:                          \"stopping opencode run\")\n1089:                     _stop_proc(self._proc)\n1090:                     break\n1091:         except (OSError, ValueError) as exc:\n1092:             self._error = exc\n1093:         finally:\n1094:             self._done.set()  # после всех put: потребитель, увидев флаг, дочитывает остаток очереди\n1095: \n1096:     def lines(self, deadline: float, idle_s: float = 0.0,\n1097:               on_idle: Callable[[], None] | None = None) -> Iterator[str]:\n1098:         \"\"\"Строки до EOF, переполнения или дедлайна; `on_idle` вызывается, если строк нет дольше `idle_s` (0 — выкл.).\"\"\"\n1099:         last_activity = time.monotonic()\n1100:         while True:\n1101:             if self.overflowed:\n1102:                 return\n1103:             now = time.monotonic()\n1104:             if now >= deadline:\n1105:                 self.timed_out = True\n1106:                 return\n1107:             wait = deadline - now\n1108:             if idle_s > 0 and on_idle is not None:\n1109:                 wait = min(wait, max(last_activity + idle_s - now, 0.0))\n1110:             try:\n1111:                 item = self._queue.get(timeout=min(max(wait, 0.001), _STDOUT_POLL_S))\n1112:             except queue.Empty:\n1113:                 if self._done.is_set():\n1114:                     try:\n1115:                         item = self._queue.get_nowait()\n1116:                     except queue.Empty:\n1117:                         if self._error is not None:\n1118:                             raise self._error from None\n1119:                         return\n1120:                 else:\n1121:                     now = time.monotonic()\n1122:                     if idle_s > 0 and on_idle is not None and now - last_activity >= idle_s:\n1123:                         on_idle()\n1124:                         last_activity = now\n1125:                     continue\n1126:             last_activity = time.monotonic()\n1127:             if last_activity > deadline:\n1128:                 self.timed_out = True\n1129:                 return\n1130:             yield item\n1131: \n1132:     def close(self) -> None:\n1133:         \"\"\"Закрыть stdout, если читатель вышел: close() при блокированном чтении виснет на замке буфера.\"\"\"\n1134:         if self._thread.is_alive():\n1135:             return\n1136:         try:\n1137:             if self._proc.stdout is not None:\n1138:                 self._proc.stdout.close()\n1139:         except OSError:\n1140:             pass\n1141: \n1142:     def join(self, timeout: float) -> None:\n1143:         self._thread.join(timeout=timeout)\n1144: \n1145: \n1146: def _model_route(model_id: str) -> str:\n1147:     \"\"\"Полный CLI-id; старые записи без provider остаются на Zen.\"\"\"\n1148:     provider = ALLOWED_MODELS.get(model_id, {}).get(\"provider\", \"opencode\")\nFILE server.py 2240-2310\n2240:         self.res = res\n2241:         self.deadline = deadline\n2242:         self.use_breaker = (\n2243:             use_breaker  # False: прямой Google-маршрут без `opencode run`\n2244:         )\n2245:         self.max_total = MAX_TOTAL_SPAWNS if max_total is None else max_total\n2246:         self.total_spawns = 0\n2247:         self.retries = 0\n2248:         self.signal = 0\n2249:         self.exit_reason = \"\"\n2250:         self._pending_failure = False\n2251:         self._sleep = sleep_fn\n2252:         self._rng = rng_fn\n2253:         res.retry_budget.on_request()\n2254: \n2255:     def note_spawn(self) -> None:\n2256:         self.total_spawns += 1\n2257: \n2258:     def remaining_s(self) -> float:\n2259:         return max(0.0, self.deadline - time.monotonic())\n2260: \n2261:     def begin_attempt(self) -> bool:\n2262:         \"\"\"Первичный запуск: потолок, deadline и Circuit Breaker (в HALF_OPEN резервирует единственную пробу).\"\"\"\n2263:         return (\n2264:             self.total_spawns < self.max_total\n2265:             and time.monotonic() < self.deadline\n2266:             and (not self.use_breaker or self.res.breaker.allow())\n2267:         )\n2268: \n2269:     def allow_retry(self, reason: str, charge_budget: bool = True) -> bool:\n2270:         \"\"\"Можно ли сделать повторный запуск: потолок, deadline, breaker, Retry Budget; затем Full Jitter пауза.\n2271: \n2272:         charge_budget=False — локальный отказ старта CLI без обращения к провайдеру («database is locked»):\n2273:         он не нагружает апстрим, ограничен FAIL_RETRY_LIMIT, MAX_TOTAL_SPAWNS и темпом запусков.\n2274:         \"\"\"\n2275:         if self.total_spawns >= self.max_total:\n2276:             _log(f\"retry denied ({reason}): MAX_TOTAL_SPAWNS={self.max_total} reached\")\n2277:             return False\n2278:         if time.monotonic() >= self.deadline:\n2279:             return False\n2280:         if self.use_breaker and self.res.breaker.is_blocking():\n2281:             _log(f\"retry denied ({reason}): upstream circuit open\")\n2282:             return False\n2283:         if charge_budget and not self.res.retry_budget.try_acquire_retry():\n2284:             _log(f\"retry denied ({reason}): retry budget exhausted\")\n2285:             return False\n2286:         self.retries += 1\n2287:         delay = (\n2288:             _retry_backoff_s(self.retries, self._rng)\n2289:             if FAIL_RETRY_BACKOFF_S > 0\n2290:             else 0.0\n2291:         )\n2292:         delay = min(delay, self.remaining_s())\n2293:         if delay > 0:\n2294:             self._sleep(delay)\n2295:         return not self.use_breaker or self.res.breaker.allow()\n2296: \n2297:     def attempt_done(self, transient_failure: bool, success: bool) -> None:\n2298:         \"\"\"Итог попытки для Circuit Breaker: успех учитывается сразу, транзиентный отказ — по итогу запроса (commit).\n2299: \n2300:         Запрос, который повтором дошёл до успеха, апстрим не «роняет»; отказ засчитывается, только\n2301:         если запрос закончился отказом. Нейтральные итоги (таймаут, детерминированный 4xx) не считаются.\n2302:         \"\"\"\n2303:         if not self.use_breaker:\n2304:             return\n2305:         if success and not transient_failure:\n2306:             self._pending_failure = False\n2307:             self.res.breaker.record_success()\n2308:         else:\n2309:             self._pending_failure = transient_failure\n2310: \nFILE server.py 2430-2488\n2430:         serve_pid: int,\n2431:         pgid: int,\n2432:         lifeline_w: int,\n2433:         lease_dir: Path,\n2434:         attempt_id: str,\n2435:         state_dir: str,\n2436:     ) -> None:\n2437:         self.helper = helper\n2438:         self.serve_pid = serve_pid\n2439:         self.pgid = pgid\n2440:         self.lifeline_w = lifeline_w\n2441:         self.lease_dir = lease_dir\n2442:         self.attempt_id = attempt_id\n2443:         self.state_dir = state_dir\n2444:         self._closed = False\n2445:         self._lock = threading.Lock()\n2446: \n2447:     def cleanup(self) -> None:\n2448:         \"\"\"Идемпотентная уборка только своей группы процессов.\"\"\"\n2449:         with self._lock:\n2450:             if self._closed:\n2451:                 return\n2452:             self._closed = True\n2453:         try:\n2454:             os.close(self.lifeline_w)\n2455:         except OSError:\n2456:             pass\n2457:         if self.helper.poll() is None or _pid_alive(self.pgid):\n2458:             try:\n2459:                 if os.getpgid(self.pgid) == self.pgid:\n2460:                     os.killpg(self.pgid, signal.SIGTERM)\n2461:             except OSError:\n2462:                 pass\n2463:             try:\n2464:                 _ = self.helper.wait(timeout=0.5)\n2465:             except (OSError, subprocess.SubprocessError):\n2466:                 try:\n2467:                     os.killpg(self.pgid, signal.SIGKILL)\n2468:                 except OSError:\n2469:                     pass\n2470:                 try:\n2471:                     _ = self.helper.wait(timeout=0.5)\n2472:                 except (OSError, subprocess.SubprocessError):\n2473:                     pass\n2474:         for stream in (self.helper.stdout, self.helper.stderr):\n2475:             try:\n2476:                 if stream is not None:\n2477:                     stream.close()\n2478:             except OSError:\n2479:                 pass\n2480:         try:\n2481:             (self.lease_dir / f\"lease-{self.attempt_id}.json\").unlink()\n2482:         except OSError:\n2483:             pass\n2484:         if self.state_dir and Path(self.state_dir).name.startswith(\"zen-serve-state-\"):\n2485:             shutil.rmtree(self.state_dir, ignore_errors=True)\n2486: \n2487: \n2488: def _spawn_serve(\nFILE server.py 5130-5230\n5130:         attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S)\n5131:         xs[\"attempts\"] = attempts\n5132: \n5133:         resp_id = f\"chatcmpl-oczen-{uuid.uuid4().hex[:12]}\"\n5134:         created = int(time.time())\n5135:         self.close_connection = True\n5136: \n5137:         workdir = DEFAULTWORKDIR\n5138:         workdir.mkdir(parents=True, exist_ok=True)\n5139:         model_route = _model_route(model)\n5140: \n5141:         cmd, shown = _build_cmd(launcher, model, effort)\n5142:         _log(f\"stream exec model={model_route} {shown} prompt_chars={len(prompt)} cwd={workdir}\")\n5143: \n5144:         proc: subprocess.Popen[str] | None = None\n5145:         feed: _StdoutFeed | None = None\n5146:         gate: _StartupGate | None = None\n5147:         run_id = uuid.uuid4().hex[:8]\n5148: \n5149:         try:\n5150:             if not attempts.begin_attempt():\n5151:                 xs[\"exit_reason\"] = \"circuit_open\"\n5152:                 self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n5153:                 return\n5154: \n5155:             # 1. Отправляются HTTP-заголовки 200 SSE\n5156:             self.send_response(200)\n5157:             self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n5158:             self.send_header(\"Cache-Control\", \"no-cache\")\n5159:             self.send_header(\"Connection\", \"close\")\n5160:             self.send_header(\"X-Accel-Buffering\", \"no\")\n5161:             self.end_headers()\n5162:             xs[\"status\"] = 200\n5163: \n5164:             # 2. Отправляется первый чанк\n5165:             first_chunk = format_sse_chunk(\n5166:                 resp_id, created, shown_model, {\"role\": \"assistant\", \"content\": \"\"}\n5167:             )\n5168:             self.wfile.write(first_chunk.encode(\"utf-8\"))\n5169:             self.wfile.flush()\n5170: \n5171:             collected_texts: list[str] = []\n5172:             usage: dict[str, Any] = {}\n5173:             deadline = attempts.deadline\n5174:             tool_calls: list[dict[str, Any]] = []\n5175: \n5176:             # Повтор незавершённого шага: уже отданный клиенту текст (dedup_prefix) подавляется,\n5177:             # расхождение (модель переформулировала) отдаётся целиком — текст не теряется.\n5178:             dedup: list[_PrefixDedup | None] = [None]\n5179: \n5180:             def send_text(text: str) -> None:\n5181:                 chunk = format_sse_chunk(resp_id, created, shown_model, {\"content\": text})\n5182:                 self.wfile.write(chunk.encode(\"utf-8\"))\n5183:                 self.wfile.flush()\n5184:                 collected_texts.append(text)  # только реально отданное клиенту\n5185: \n5186:             def emit_content(text: str) -> None:\n5187:                 if not text:\n5188:                     return\n5189:                 prefix_dedup = dedup[0]\n5190:                 if prefix_dedup is not None:\n5191:                     text = prefix_dedup.push(text)\n5192:                     if not text:\n5193:                         return\n5194:                 send_text(text)\n5195: \n5196:             dropped_blocks = [0]  # вырезано нераспарсенных блоков вызова (счётчик на запрос)\n5197: \n5198:             def emit_parsed_content(text: str) -> None:\n5199:                 # Нераспарсенный блок ToolCallParser отдаёт одним куском: сырой тег не уходит ни в SSE, ни в повтор.\n5200:                 cleaned, dropped = _strip_broken_tool_blocks(text)\n5201:                 if dropped:\n5202:                     dropped_blocks[0] += dropped\n5203:                     _log(f\"stream dropped {dropped} unparsed tool block(s) from content\")\n5204:                 emit_content(cleaned)\n5205: \n5206:             seen_calls: set[str] = set()\n5207: \n5208:             def emit_tool_call(call: dict[str, Any]) -> None:\n5209:                 key = _call_key(call[\"name\"], call[\"arguments\"])\n5210:                 if key in seen_calls:\n5211:                     _log(f\"stream dropped duplicate tool call {call['name']}\")\n5212:                     return\n5213:                 seen_calls.add(key)\n5214:                 tc = {\n5215:                     \"index\": len(tool_calls),\n5216:                     \"id\": \"call_\" + uuid.uuid4().hex[:24],\n5217:                     \"type\": \"function\",\n5218:                     \"function\": {\"name\": call[\"name\"],\n5219:                                  \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False)},\n5220:                 }\n5221:                 tool_calls.append(tc)\n5222:                 chunk = format_sse_chunk(resp_id, created, shown_model, {\"tool_calls\": [tc]})\n5223:                 self.wfile.write(chunk.encode(\"utf-8\"))\n5224:                 self.wfile.flush()\n5225: \n5226:             with _active_lock:\n5227:                 _active[run_id] = time.time()\n5228: \n5229:             if _select_transport(res) == \"serve\":\n5230:                 xs[\"transport\"] = \"serve\"\nFILE server.py 5940-6010\n5940:             },\n5941:         )\n5942:         return True\n5943: \n5944:     def _serve_json(self, model: str, prompt: str, effort: str, emulate_tools: bool = False,\n5945:                     tools: list[dict[str, Any]] | None = None,\n5946:                     google_input: GoogleInput | None = None, reported_model: str | None = None,\n5947:                     tool_choice: Any = None) -> None:\n5948:         xs = self._exit()\n5949:         contents: list[str] = []\n5950:         reasonings: list[str] = []\n5951:         tool_calls: list[dict[str, Any]] = []\n5952:         tokens: dict[str, int] = {}\n5953:         attempt_prompt = prompt\n5954:         retries = 0  # повторов с новым промптом: встроенный инструмент / незавершённый шаг (для лога)\n5955:         unmapped_retries = 0\n5956:         incomplete_retries = 0\n5957:         incomplete_retry = False\n5958:         out: dict[str, Any] = {}\n5959:         dropped_blocks = 0  # вырезано нераспарсенных блоков вызова\n5960:         res = self._res()\n5961:         if not self._acquire_slot(res):\n5962:             return\n5963:         attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S,\n5964:                                     use_breaker=not _is_google_direct_model(model))\n5965:         xs[\"attempts\"] = attempts\n5966:         try:\n5967:             if not attempts.begin_attempt():\n5968:                 xs[\"exit_reason\"] = \"circuit_open\"\n5969:                 self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n5970:                 return\n5971:             if not _is_google_direct_model(model) and _select_transport(res) == \"serve\":\n5972:                 xs[\"transport\"] = \"serve\"\n5973:                 xs[\"transport_history\"] = [\"serve\"]\n5974:                 if self._serve_json_serve(\n5975:                     model,\n5976:                     prompt,\n5977:                     effort,\n5978:                     emulate_tools,\n5979:                     tools,\n5980:                     reported_model,\n5981:                     None,\n5982:                     res,\n5983:                     attempts,\n5984:                     xs,\n5985:                 ):\n5986:                     return\n5987:                 xs[\"transport\"] = \"run\"\n5988:                 xs[\"transport_history\"] = [\"serve\", \"run\"]\n5989:             else:\n5990:                 xs[\"transport\"] = \"google\" if _is_google_direct_model(model) else \"run\"\n5991:                 xs[\"transport_history\"] = [str(xs[\"transport\"])]\n5992:             while True:\n5993:                 if retries:\n5994:                     _log(f\"exec retry={retries} ({'incomplete tool step' if incomplete_retry else 'unmapped built-in tool'})\"\n5995:                          f\" total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n5996:                 run = Run(model, attempt_prompt, effort, DEFAULTWORKDIR,\n5997:                           tools=(tools or []) if emulate_tools else None, google_input=google_input,\n5998:                           attempts=attempts, resilience=res)\n5999:                 try:\n6000:                     out = run.execute()\n6001:                 finally:\n6002:                     run.close()\n6003: \n6004:                 if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\", \"client_gone\"):\n6005:                     xs[\"exit_reason\"] = str(out[\"state\"])\n6006:                     self._send(502, {\"error\": {\"message\": out.get(\"err\") or out[\"state\"],\n6007:                                                \"type\": \"proxy_error\", \"code\": 502}})\n6008:                     return\n6009:                 content = out[\"text\"]\n6010:                 if emulate_tools and content:\ntest_step_interruption.py:151:     finish()\ntest_step_interruption.py:152: \"\"\"\ntest_step_interruption.py:153: \ntest_step_interruption.py:154: \ntest_step_interruption.py:155: class TestStepInterruptionLive(unittest.TestCase):\ntest_step_interruption.py:156:     @classmethod\ntest_step_interruption.py:157:     def setUpClass(cls) -> None:\ntest_step_interruption.py:158:         cls.tmp = tempfile.TemporaryDirectory()\ntest_step_interruption.py:159:         fake = Path(cls.tmp.name) / \"opencode\"\ntest_step_interruption.py:160:         fake.write_text(FAKE_OPENCODE, \"utf-8\")\ntest_step_interruption.py:161:         fake.chmod(0o755)\ntest_step_interruption.py:162:         cls.saved = (server.OPENCODE_BIN, server.AUTH_KEY, server.DEFAULTWORKDIR, server.LOG_PATH)\ntest_step_interruption.py:163:         cls.env_patch = allow_child_env(\"FAKE_OC_COUNTER\", \"FAKE_OC_MODE\", \"FAKE_OC_PLAN\",\ntest_step_interruption.py:164:                                         \"FAKE_OC_PREAMBLE\", \"FAKE_OC_STATUS\", \"FAKE_OC_CALLS\", \"FAKE_OC_SWALLOW\",\ntest_step_interruption.py:165:                                         \"FAKE_OC_RAW\")\ntest_step_interruption.py:166:         cls.env_patch.start()\ntest_step_interruption.py:167:         server.OPENCODE_BIN = str(fake)\ntest_step_interruption.py:168:         server.AUTH_KEY = \"test-key\"\ntest_step_interruption.py:169:         server.DEFAULTWORKDIR = Path(cls.tmp.name) / \"ws\"\ntest_step_interruption.py:170:         server.LOG_PATH = Path(cls.tmp.name) / \"bridge.log\"\ntest_step_interruption.py:171:         with socket.socket() as s:\ntest_step_interruption.py:172:             s.bind((\"127.0.0.1\", 0))\ntest_step_interruption.py:173:             cls.port = s.getsockname()[1]\ntest_step_interruption.py:174:         cls.httpd = server.Server((\"127.0.0.1\", cls.port), server.Handler)\ntest_step_interruption.py:175:         threading.Thread(target=cls.httpd.serve_forever, daemon=True).start()\ntest_step_interruption.py:176: \ntest_step_interruption.py:177:     @classmethod\ntest_step_interruption.py:178:     def tearDownClass(cls) -> None:\ntest_step_interruption.py:179:         cls.httpd.shutdown()\ntest_step_interruption.py:180:         cls.httpd.server_close()\ntest_step_interruption.py:181:         cls.env_patch.stop()\ntest_step_interruption.py:182:         server.OPENCODE_BIN, server.AUTH_KEY, server.DEFAULTWORKDIR, server.LOG_PATH = cls.saved\ntest_step_interruption.py:183:         cls.tmp.cleanup()\ntest_step_interruption.py:184: \ntest_step_interruption.py:185:     counter: Path = Path()\ntest_step_interruption.py:186: \ntest_step_interruption.py:187:     def setUp(self) -> None:\ntest_step_interruption.py:188:         # Изоляция REQ-017: свежий бюджет повторов на каждый тест, без сброса в проде.\ntest_step_interruption.py:189:         self.httpd.resilience = server._Resilience()\ntest_step_interruption.py:190:         self.counter = Path(self.tmp.name) / f\"counter-{self.id()}\"\ntest_step_interruption.py:191:         os.environ[\"FAKE_OC_COUNTER\"] = str(self.counter)\ntest_step_interruption.py:192:         os.environ[\"FAKE_OC_PLAN\"] = PLAN\ntest_step_interruption.py:193:         os.environ[\"FAKE_OC_PREAMBLE\"] = PREAMBLE\ntest_step_interruption.py:194:         os.environ[\"FAKE_OC_STATUS\"] = STATUS_ONLY\ntest_step_interruption.py:195:         os.environ[\"FAKE_OC_CALLS\"] = CALLS\ntest_step_interruption.py:196:         os.environ[\"FAKE_OC_SWALLOW\"] = SWALLOWED_TEXT\ntest_step_interruption.py:197: \ntest_step_interruption.py:198:     def tearDown(self) -> None:\ntest_step_interruption.py:199:         for name in (\"FAKE_OC_COUNTER\", \"FAKE_OC_MODE\", \"FAKE_OC_PLAN\", \"FAKE_OC_PREAMBLE\",\ntest_step_interruption.py:200:                      \"FAKE_OC_STATUS\", \"FAKE_OC_CALLS\", \"FAKE_OC_SWALLOW\", \"FAKE_OC_RAW\"):\ntest_step_interruption.py:201:             os.environ.pop(name, None)\ntest_step_interruption.py:202: \ntest_step_interruption.py:203:     def _post(self, stream: bool, model: str = \"muse-spark-1.3-contributor-free\",\ntest_step_interruption.py:204:               messages: list[dict[str, Any]] | None = None) -> bytes:\ntest_step_interruption.py:205:         body = json.dumps({\"model\": model, \"stream\": stream,\ntest_step_interruption.py:206:                            \"messages\": messages or [{\"role\": \"user\", \"content\": \"продолжай цель\"}],\ntest_step_interruption.py:207:                            \"tools\": TOOLS}).encode()\ntest_step_interruption.py:208:         req = urllib.request.Request(f\"http://127.0.0.1:{self.port}/v1/chat/completions\", data=body,\ntest_step_interruption.py:209:                                      headers={\"Authorization\": \"Bearer test-key\",\ntest_step_interruption.py:210:                                               \"Content-Type\": \"application/json\"})\ntest_step_interruption.py:211:         with urllib.request.urlopen(req, timeout=60) as resp:\ntest_step_interruption.py:212:             return resp.read()\ntest_step_interruption.py:213: \ntest_step_interruption.py:214:     def _runs(self) -> int:\ntest_step_interruption.py:215:         return int(self.counter.read_text())\ntest_step_interruption.py:216: \ntest_step_interruption.py:217:     def _prompts(self) -> list[str]:\ntest_step_interruption.py:218:         return [json.loads(line) for line in Path(str(self.counter) + \".prompts\").read_text().splitlines()]\ntest_step_interruption.py:219: \ntest_step_interruption.py:220:     def _stream(self, model: str = \"muse-spark-1.3-contributor-free\",\ntest_step_interruption.py:221:                 messages: list[dict[str, Any]] | None = None) -> tuple[str, list[str], list[str]]:\ntest_step_interruption.py:222:         raw = self._post(stream=True, model=model, messages=messages).decode()\ntest_step_interruption.py:223:         chunks = [json.loads(line[6:]) for line in raw.splitlines() if line.startswith(\"data: {\")]\ntest_step_interruption.py:224:         content = \"\".join(c[\"choices\"][0][\"delta\"].get(\"content\") or \"\" for c in chunks)\ntest_step_interruption.py:225:         finishes = [c[\"choices\"][0][\"finish_reason\"] for c in chunks if c[\"choices\"][0].get(\"finish_reason\")]\ntest_step_interruption.py:226:         names = [tc[\"function\"][\"name\"] for c in chunks\ntest_step_interruption.py:227:                  for tc in c[\"choices\"][0][\"delta\"].get(\"tool_calls\") or []]\ntest_step_interruption.py:228:         return content, finishes, names\ntest_step_interruption.py:229: \ntest_step_interruption.py:230:     def _assert_reprompt(self) -> None:\ntest_step_interruption.py:231:         retry_prompt = self._prompts()[1]\ntest_step_interruption.py:232:         self.assertIn(PREAMBLE if os.environ[\"FAKE_OC_MODE\"] == \"econnreset\" else STATUS_ONLY.strip(),\nWORKING_RULE AGENTS.md exists False\nWORKING_RULE .agents/AGENTS.md exists False\nWORKING_RULE CLAUDE.md exists False\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"Сверка уточнила два вывода R1: потоковый ответ уже дедуплицирует одинаковые tool calls, поэтому замечание о дублях сужаю до текста и JSON-ветки; сам по себе `wait(timeout=0.5)` не доказывает утечку — блокер в отсутствии проверки завершения всей группы. Предложение убрать 60-секундный watchdog legacy отклоняю: этот порог прямо предусмотрен REQ-007."}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"PANEL-NONCE: 2ca86821366dd5ff\nARTIFACT-SHA256: 5b0d1dea0cf4996f6d744e0eb2d82176578091bad35c943dde722c09d3784df4\n\nКанон `~/Мой диск/Context/AGENTS.md` прочитан целиком в приложенном тексте до `<!-- КАНОН-КОНЕЦ -->`. В рабочей папке `AGENTS.md`, `.agents/AGENTS.md`, `CLAUDE.md` отсутствуют. Ниже `server.py` и тестовые пути относятся к `bridges/opencode-zen-bridge/`. Тесты самостоятельно не запускал.\n\nDISPUTE F-001 — класс: duplicate_of:F-026 — контр-evidence: `server.py:4848`, `5768` — тот же обход `_StartupGate` и `spawn_limiter` уже полностью описан в F-026; блокирующий дефект подтверждается.\n\nAGREE F-002 rev=1 — проверил: `server.py:2552` — после первоначального `select` цикл побайтового чтения до LF не проверяет остаток дедлайна. Нужны ограничение времени всего рукопожатия и cleanup при его истечении.\n\nAMEND F-003 — priority=blocking; locations=server.py:2609,server.py:2613; fix=После SIGTERM проверять завершение принадлежащей попытке группы в ограниченном бюджете, при необходимости эскалировать до SIGKILL; сохранять lease до подтверждения завершения — причина: `server.py:2609`, `2613` содержат одиночный сигнал с последующим удалением lease. Проверку идентичности процессов учитывать отдельно в F-039, без дублирования.\n\nDISPUTE F-004 — класс: duplicate_of:F-041 — контр-evidence: `server.py:5770` — отсутствие callback отключения клиента в JSON-попытке уже входит в F-041.\n\nDISPUTE F-005 — класс: duplicate_of:F-042 — контр-evidence: `tests/test_realtime_reasoning.py:99`, `102`, `376` — отсутствие serve-оракулов трёх watchdog уже включено в блокирующую неполноту F-042; наличие зелёного legacy-теста этого не исправляет.\n\nDISPUTE F-006 — класс: duplicate_of:F-031 — контр-evidence: `server.py:4950`, `4961`, `5981` — потеря исходного `tool_choice` уже описана в F-031.\n\nDISPUTE F-007 — класс: duplicate_of:F-042 — контр-evidence: `tests/test_step_interruption.py:159`, `167`, `188` — существующий набор использует run-фейк; необходимость эквивалентной serve-матрицы прерываний уже входит в F-042.\n\nDISPUTE F-008 — класс: duplicate_of:F-020 — контр-evidence: `server.py:1679`, `1705`, `2857` — тот же собственный JSON-парсер и повреждение surrogate pairs уже описаны в F-020.\n\nDISPUTE F-009 — класс: duplicate_of:F-029 — контр-evidence: `server.py:2879`, `2880`, `2901` — неиспользуемая классификация prompt-response и неверный барьер доставки уже входят в F-029.\n\nAMEND F-010 — priority=blocking; locations=server.py:2457,server.py:2464,server.py:2471; fix=Подтверждать завершение всей собственной группы, включая потомков после выхода helper; ограничить ожидание общим cleanup-бюджетом и сохранять диагностическое свидетельство при неуспехе — причина: `helper.wait()` проверяет только непосредственный helper; успешный выход helper не доказывает смерть оставшихся потомков. Значение `0.5` само по себе не доказывает утечку, а ResourceWarning из L2 нельзя однозначно приписать именно этой ветке вместо F-035. Неограниченное ожидание также недопустимо по feature.md и AC-011.\n\nDISPUTE F-011 — класс: duplicate_of:F-049 — контр-evidence: `server.py:1791` — разрешающий дизъюнкт `len(head) == 4` уже описан в F-049.\n\nAMEND F-012 — priority=non-blocking; locations=server.py:1339; fix=Удалить неиспользуемую константу либо задействовать её в механизме раннего статуса, сохраняющем проверку быстрого ответа — причина: отсутствие чтения `STATUS_INITIAL` является мёртвым кодом, но конкретный текст первой строки требованиями не предписан. Нарушение срока первой реакции во время setup учитывать в F-024.\n\nDISPUTE F-013 — класс: duplicate_of:F-038 — контр-evidence: `server.py:2495`, `2564`, `2565` — окно освобождённого порта и разрешение продолжить при недоказанном listener PID уже входят в F-038. Держать probe-сокет открытым без механизма передачи сокета нельзя: это помешает bind самого serve.\n\nDISPUTE F-014 — класс: invalid — контр-evidence: `server.py:2654`, `2655`, `2666`, `2678`; `tests/test_realtime_reasoning.py:114` — `feed()` сохраняет полный `input.ended.text`, а поле `delta` вообще не записывает в `text`. Утверждение о перезаписи текста каждой дельтой не соответствует реализации. Канонический `status=\"error\"` используется для передачи заблокированного native-вызова клиенту; представленная фикстура именно такая. Необходимость поддержать иной wire-вариант требует отдельного подтверждённого контракта.\n\nAMEND F-015 — priority=non-blocking; locations=server.py:2569,server.py:2570; fix=Исправить комментарий о записи stderr в лог; проверку отсутствия пароля в итоговом sink включить в F-042 — причина: `_drain_stderr` на `server.py:1028`–`1037` добавляет строки в список и не вызывает логирование. Утечка пароля этим путём не доказана. Добавлять логирование ради исправления комментария не требуется; неограниченное накопление списка отдельно покрыто F-037.\n\nDISPUTE F-016 — класс: duplicate_of:F-050 — контр-evidence: `server.py:4877`, `4884`, `5456`, `5468` — семантика request-level «первых» таймингов уже описана в F-050. Простое обнуление при fallback не является достаточным исправлением: оно уничтожит действительно первое наблюдение запроса.\n\nDISPUTE F-017 — класс: duplicate_of:F-042 — контр-evidence: `server.py:1795`; `tests/test_realtime_reasoning.py:634` — отсутствие поведенческой матрицы переключателей входит в F-042; проверка читателя JSON-флага не заменяет проверку выбора транспорта.\n\nDISPUTE F-018 — класс: duplicate_of:F-042 — контр-evidence: `tests/test_realtime_reasoning.py:442`, `443`, `445` — слабость временного оракула и отсутствие независимого upstream-end уже описаны в F-042. Выдача нескольких накопленных дельт в конце также может удовлетворить приведённым assertions.\n\nDISPUTE F-051 — класс: duplicate_of:F-019 — контр-evidence: `server.py:3018`, `3029` — тот же подтверждённый дефект отбрасывания пробельных reasoning/text-дельт.\n\nDISPUTE F-052 — класс: duplicate_of:F-038 — контр-evidence: `server.py:2495`, `2505`, `2565` — гонка выбора порта и отсутствие обязательного ownership-proof уже покрыты F-038. Предложение переводить любой readiness-401 в fallback не принимаю: оно ослабляет требуемый fail-closed; сначала нужно доказать владение слушателем.\n\nDISPUTE F-053 — класс: invalid — контр-evidence: `handoff-architect.md`, REQ-007 и AC-010 прямо требуют настраиваемый watchdog первого токена с рабочим допущением 60 секунд. Его наличие на legacy-пути соответствует задаче. F-32 сообщает длительность всего запроса, но не доказывает непрерывное отсутствие первого токена более 60 секунд. Удалять watchdog или менять согласованный порог на этом основании нельзя.\n\nDISPUTE F-054 — класс: duplicate_of:F-026 — контр-evidence: `server.py:4848`, `5768` — обход стартовых защит уже покрыт F-026. Отдельное доказательство ротации прокси включено в F-042.\n\nDISPUTE F-055 — класс: duplicate_of:F-029 — контр-evidence: `server.py:2879`, `2880`, `2965` — игнорирование результата prompt-worker уже входит в F-029.\n\nDISPUTE F-056 — класс: duplicate_of:F-033 — контр-evidence: `server.py:4843`, `4901`, `5850`, `5908` — дубли текста и отсутствие разделителей уже покрыты F-033. Уточнение: потоковые одинаковые tool calls дедуплицируются внешним `emit_tool_call` на `server.py:5208`–`5213`; утверждение об их безусловном повторном выводе в stream неверно.\n\nDISPUTE F-057 — класс: duplicate_of:F-024 — контр-evidence: `server.py:2740`, `2890`, `5298`, `5363` — отсутствие своевременной видимой реакции во время setup и ожиданий уже описано в F-024. Исправление должно также сохранить разрешённый сценарий быстрого ответа без лишней синтетики.\n\nINCONCLUSIVE F-058 — нужны реальные wire-фикстуры `integration.updated` и heartbeat с подтверждённой формой `data`. На `server.py:1830` пустой словарь действительно отвергается для всех типов, кроме `server.connected`, но F-19 подтверждает имя и время события, а не пустое `data`. Утверждение о фактическом отказе реального v2.1.2 пока не доказано; законный `D