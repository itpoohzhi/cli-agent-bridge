.prefix:\n            return text\n        self.current += text\n        current, prefix = self.current, self.prefix\n        if current.startswith(prefix):","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2297,"endLine":2336},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-4aa5a137-8f80-4215-b9a3-ebed2467b577-9\nfc_2e7e8d79-6e57-9cb5-8e08-a1b891019612_1","startedAtMs":"1793047300000","completedAtMs":"1793047300073"},"model_call_id":"881c0f4f-e0be-4bb8-914c-675285c755e9-4-01sa","session_id":"a009bddc-e2b1-4536-a5ef-b5cb2d1ba944","timestamp_ms":1793047300118}
