(text_value)\n            elif etype == \"tool_event\":\n                tool_state.feed(payload)\n                call_id = str(payload.get(\"id\") or \"\")\n                if etype_raw in (\n                    \"session.tool.called\",\n                    \"session.tool.failed\",\n                    \"session.tool.success\",\n                ):\n                    done = tool_state.complete(call_id)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                        if result[\"first_token_at\"] is None:\n                            result[\"first_token_at\"] = time.monotonic()\n            elif etype == \"step_finish\":\n                step_key = str(\n                    _as_dict(payload).get(\"assistantMessageID\")\n                    or data_raw.get(\"assistantMessageID\")\n                    or \"\"\n                )\n                if step_key and step_key in seen_steps:\n                    continue\n                if step_key:\n                    seen_steps.add(step_key)\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n                        payload.get(key)\n                    )\n                # Завершить native вызовы без called: аргументы из input.ended.text.\n                for call_id in list(tool_state.tools):\n                    done = tool_state.complete(call_id)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"terminal\"] = \"failed\"\n                break\n            elif etype_raw == \"session.execution.succeeded\":\n                result[\"terminal\"] = \"succeeded\"\n                break\n        return result\n    finally:\n        if session_id:\n            try:\n                _ = _ctrl_http(\n                    \"POST\",\n                    f\"/api/session/{session_id}/interrupt\",\n                    None,\n                    timeout=0.25,\n                )\n            except (OSError, http.client.HTTPException):\n                pass\n            try:\n                _ = _ctrl_http(\n                    \"DELETE\",","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3005,"endLine":3094},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-06fc0067-7d10-4853-9605-b10f4521d66c-3\nfc_3b452cd8-314a-901d-a9dc-51a2c5bf5e8a_3","startedAtMs":"1793047122949","completedAtMs":"1793047123259"},"model_call_id":"881c0f4f-e0be-4bb8-914c-675285c755e9-0-o16q","session_id":"a009bddc-e2b1-4536-a5ef-b5cb2d1ba944","timestamp_ms":1793047123299}
