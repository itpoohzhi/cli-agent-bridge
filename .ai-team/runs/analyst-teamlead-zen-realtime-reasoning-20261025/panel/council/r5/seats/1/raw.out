emaining_s())):\n                    gate.release()\n                    _log(\n                        \"stream spawn skipped: spawn rate limiter wait exceeds the request deadline\"\n                    )\n                    if not collected_texts and not tool_calls:\n                        failure = {\"rc\": -1, \"tail\": \"\", \"timeout\": True}\n                    break\n                try:\n                    # env на каждую попытку: ретрай получает следующий порт пула (чистый IP)\n                    proc = _spawn_with_stdin(\n                        cmd, attempt_prompt, workdir, _run_env(model)\n                    )\n                except OSError as exc:\n                    gate.release()\n                    _log(f\"stream spawn failed: {exc}\")\n                    xs[\"exit_reason\"] = \"spawn_failed\"\n                    self._sse_error(_error_payload(f\"opencode spawn failed: {exc}\"))\n                    return","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5268,"endLine":5317},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-fb5f2ffd-c014-4f39-9cba-268860b5f314-9\nfc_ea000c6c-c84a-9b22-9f90-454af17e57c8_3","startedAtMs":"1793047136470","completedAtMs":"1793047136542"},"model_call_id":"881c0f4f-e0be-4bb8-914c-675285c755e9-1-85u0","session_id":"a009bddc-e2b1-4536-a5ef-b5cb2d1ba944","timestamp_ms":1793047136590}
