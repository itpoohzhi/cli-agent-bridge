s.append(tc)\n                chunk = format_sse_chunk(resp_id, created, shown_model, {\"tool_calls\": [tc]})\n                self.wfile.write(chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n\n            with _active_lock:\n                _active[run_id] = time.time()\n\n            if _select_transport(res) == \"serve\":\n                xs[\"transport\"] = \"serve\"\n                xs[\"transport_history\"] = [\"serve\"]\n                self._serve_stream_usage = None\n                handled = self._run_serve_stream_attempts(\n                    model,","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5185,"endLine":5234},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-06fc0067-7d10-4853-9605-b10f4521d66c-5\nfc_3b452cd8-314a-901d-a9dc-51a2c5bf5e8a_5","startedAtMs":"1793047123332","completedAtMs":"1793047123401"},"model_call_id":"881c0f4f-e0be-4bb8-914c-675285c755e9-0-o16q","session_id":"a009bddc-e2b1-4536-a5ef-b5cb2d1ba944","timestamp_ms":1793047123439}
