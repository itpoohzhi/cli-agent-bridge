dict[str, int] = {}\n5953:         attempt_prompt = prompt\n5954:         retries = 0  # повторов с новым промптом: встроенный инструмент / незавершённый шаг (для лога)\n5955:         unmapped_retries = 0\n5956:         incomplete_retries = 0\n5957:         incomplete_retry = False\n5958:         out: dict[str, Any] = {}\n5959:         dropped_blocks = 0  # вырезано нераспарсенных блоков вызова\n5960:         res = self._res()\n5961:         if not self._acquire_slot(res):\n5962:             return\n5963:         attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S,\n5964:                                     use_breaker=not _is_google_direct_model(model))\n5965:         xs[\"attempts\"] = attempts\n5966:         try:\n5967:             if not attempts.begin_attempt():\n5968:                 xs[\"exit_reason\"] = \"circuit_open\"\n5969:                 self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n5970:                 return\n5971:             if not _is_google_direct_model(model) and _select_transport(res) == \"serve\":\n5972:                 xs[\"transport\"] = \"serve\"\n5973:                 xs[\"transport_history\"] = [\"serve\"]\n5974:                 if self._serve_json_serve(\n5975:                     model,\n5976:                     prompt,\n5977:                     effort,\n5978:                     emulate_tools,\n5979:                     tools,\n5980:                     reported_model,\n5981:                     None,\n5982:                     res,\n5983:                     attempts,\n5984:                     xs,\n5985:                 ):\n5986:                     return\n5987:                 xs[\"transport\"] = \"run\"\n5988:                 xs[\"transport_history\"] = [\"serve\", \"run\"]\n5989:             else:\n5990:                 xs[\"transport\"] = \"google\" if _is_google_direct_model(model) else \"run\"\n5991:                 xs[\"transport_history\"] = [str(xs[\"transport\"])]\n5992:             while True:\n5993:                 if retries:\n5994:                     _log(f\"exec retry={retries} ({'incomplete tool step' if incomplete_retry else 'unmapped built-in tool'})\"\n5995:                          f\" total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n5996:                 run = Run(model, attempt_prompt, effort, DEFAULTWORKDIR,\n5997:                           tools=(tools or []) if emulate_tools else None, google_input=google_input,\n5998:                           attempts=attempts, resilience=res)\n5999:                 try:\n6000:                     out = run.execute()\n6001:                 finally:\n6002:                     run.close()\n6003: \n6004:                 if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\", \"client_gone\"):\n\nbridges/opencode-zen-bridge/server.py:5708\n5708:             _log(f\"client gone mid-stream: {exc}\")\n5709:             xs[\"exit_reason\"] = \"client_gone\"\n5710:             if proc is not None and proc.poll() is None:\n5711:                 try:\n5712:                     proc.kill()\n5713:                 except OSError:\n5714:                     pass\n5715:         finally:\n5716:             if gate is not None:\n5717:                 gate.release()\n5718:             if proc is not None:\n5719:                 if feed is not None:\n5720:                     feed.close()\n5721:                 try:\n5722:                     if proc.stderr is not None:\n5723:                         proc.stderr.close()\n5724:                 except OSError:\n5725:                     pass\n5726:                 if proc.poll() is None:\n5727:                     try:\n5728:                         proc.kill()\n5729:                     except OSError:\n5730:                         pass\n5731:             with _active_lock:\n5732:                 _active.pop(run_id, None)\n5733:             attempts.commit()\n5734:             res.slots.release()\n5735: \n5736:     def _serve_json_serve(\n\nbridges/opencode-zen-bridge/tests/test_step_interruption.py:154\n154: \n155: class TestStepInterruptionLive(unittest.TestCase):\n156:     @classmethod\n157:     def setUpClass(cls) -> None:\n158:         cls.tmp = tempfile.TemporaryDirectory()\n159:         fake = Path(cls.tmp.name) / \"opencode\"\n160:         fake.write_text(FAKE_OPENCODE, \"utf-8\")\n161:         fake.chmod(0o755)\n162:         cls.saved = (server.OPENCODE_BIN, server.AUTH_KEY, server.DEFAULTWORKDIR, server.LOG_PATH)\n163:         cls.env_patch = allow_child_env(\"FAKE_OC_COUNTER\", \"FAKE_OC_MODE\", \"FAKE_OC_PLAN\",\n164:                                         \"FAKE_OC_PREAMBLE\", \"FAKE_OC_STATUS\", \"FAKE_OC_CALLS\", \"FAKE_OC_SWALLOW\",\n165:                                         \"FAKE_OC_RAW\")\n166:         cls.env_patch.start()\n167:         server.OPENCODE_BIN = str(fake)\n168:         server.AUTH_KEY = \"test-key\"\n169:         server.DEFAULTWORKDIR = Path(cls.tmp.name) / \"ws\"\n170:         server.LOG_PATH = Path(cls.tmp.name) / \"bridge.log\"\n171:         with socket.socket() as s:\n172:             s.bind((\"127.0.0.1\", 0))\n173:             cls.port = s.getsockname()[1]\n174:         cls.httpd = server.Server((\"127.0.0.1\", cls.port), server.Handler)\n175:         threading.Thread(target=cls.httpd.serve_forever, daemon=True).start()\n176: \n177:     @classmethod\n178:     def tearDownClass(cls) -> None:\n179:         cls.httpd.shutdown()\n180:         cls.httpd.server_close()\n181:         cls.env_patch.stop()\n182:         server.OPENCODE_BIN, server.AUTH_KEY, server.DEFAULTWORKDIR, server.LOG_PATH = cls.saved\n183:         cls.tmp.cleanup()\n184: \n185:     counter: Path = Path()\n186: \n187:     def setUp(self) -> None:\n188:         # Изоляция REQ-017: свежий бюджет повторов на каждый тест, без сброса в проде.\n189:         self.httpd.resilience = server._Resilience()\n190:         self.counter = Path(self.tmp.name) / f\"counter-{self.id()}\"\n191:         os.environ[\"FAKE_OC_COUNTER\"] = str(self.counter)\n192:         os.environ[\"FAKE_OC_PLAN\"] = PLAN\n193:         os.environ[\"FAKE_OC_PREAMBLE\"] = PREAMBLE\n194:         os.environ[\"FAKE_OC_STATUS\"] = STATUS_ONLY\n195:         os.environ[\"FAKE_OC_CALLS\"] = CALLS\n196:         os.environ[\"FAKE_OC_SWALLOW\"] = SWALLOWED_TEXT\n197: \n198:     def tearDown(self) -> None:\n199:         for name in (\"FAKE_OC_COUNTER\", \"FAKE_OC_MODE\", \"FAKE_OC_PLAN\", \"FAKE_OC_PREAMBLE\",\n200:                      \"FAKE_OC_STATUS\", \"FAKE_OC_CALLS\", \"FAKE_OC_SWALLOW\", \"FAKE_OC_RAW\"):\n201:             os.environ.pop(name, None)\n202: \n203:     def _post(self, stream: bool, model: str = \"muse-spark-1.3-contributor-free\",\n204:               messages: list[dict[str, Any]] | None = None) -> bytes:\n205:         body = json.dumps({\"model\": model, \"stream\": stream,\n206:                            \"messages\": messages or [{\"role\": \"user\", \"content\": \"продолжай цель\"}],\n207:                            \"tools\": TOOLS}).encode()\n208:         req = urllib.request.Request(f\"http://127.0.0.1:{self.port}/v1/chat/completions\", data=body,\n209:                                      headers={\"Authorization\": \"Bearer test-key\",\n210:                                               \"Content-Type\": \"application/json\"})\n211:         with urllib.request.urlopen(req, timeout=60) as resp:\n212:             return resp.read()\n213: \n214:     def _runs(self) -> int:\n215:         return int(self.counter.read_text())\n216: \n217:     def _prompts(self) -> list[str]:\n218:         return [json.loads(line) for line in Path(str(self.counter) + \".prompts\").read_text().splitlines()]\n219: \n220:     def _stream(self, model: str = \"muse-spark-1.3-contributor-free\",\n221:                 messages: list[dict[str, Any]] | None = None) -> tuple[str, list[str], list[str]]:\n222:         raw = self._post(stream=True, model=model, messages=messages).decode()\n","exit_code":0,"status":"completed"}}
