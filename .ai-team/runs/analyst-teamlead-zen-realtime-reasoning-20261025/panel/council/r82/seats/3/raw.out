hought)\n1064:             or _RAW_CALL_RE.search(text)):\n1065:         return 2\n1066:     if len(body) > INCOMPLETE_STEP_MAX_TEXT:\n1067:         return 0\n1068:     if _NO_TOOLS_RE.search(thought if thought else body) and not (\n1069:             thought and _no_tools_overridden(body, thought, names)):\n1070:         return 0\n1071:     if (len(body) <= SWALLOWED_MAX_TEXT and output_tokens > 0 and not body.endswith(\"?\") and (body or thought)\n1072:             and _swallowed_tokens(body, output_tokens, reasoning_tokens) >= SWALLOWED_TOKENS_MIN):\n1073:         return 3\n1074:     if thought and len(body) <= PLAN_MAX_TEXT:\n1075:         tail = body[-INCOMPLETE_STEP_TAIL:]\n1076:         has_plan = bool(_REASONING_TOOL_PLAN_RE.search(thought)) or (\n1077:             _mentions_request_tool(thought, names)\n1078:             and bool(_ACTION_INTENT_RE.search(thought) or _CALL_INTENT_RE.search(thought)))\n1079:         has_promise = not body or (not body.endswith(\"?\") and (\n1080:             bool(_ACTION_INTENT_RE.search(tail)) or _mentions_request_tool(tail, names)))\n1081:         if has_plan and has_promise:\n1082:             return 4\n1083:     return 5 if _is_status_preamble(body, names) else 0\n1084: \n1085: \n1086: def _is_incomplete_tool_step(text: str, reasoning: str, tools: Any,\n1087:                              had_mid_stream_error: bool = False, output_tokens: int = 0,\n1088:                              reasoning_tokens: int = 0, *, tool_choice: Any = None,\n1089:                              had_error: bool = False) -> bool:\n1090:     \"\"\"Шаг без `<tool_call>`/`<tool_invoke>` оборвался или остановился на преамбуле — нужен повтор.\n1091: \n1092:     Обёртка над `_detect_incomplete_tool_step_signal`: обычный ответ, в т.ч. «no tools», короткий итог\n1093:     и длинный итог, — False. Выключается kill-switch'ем STEP_RECOVERY_ENABLED первой же инструкцией.\n1094:     \"\"\"\n1095:     return bool(_detect_incomplete_tool_step_signal(\n1096:         text, reasoning, tools, had_mid_stream_error, output_tokens, reasoning_tokens,\n1097:         tool_choice=tool_choice, had_error=had_error))\n1098: \n1099: \nRANGE 2588 2713\n2588:         raise ServeClientDisconnect(\"client disconnected before serve spawn\")\n2589:     if deadline is not None and time.monotonic() >= deadline:\n2590:         raise ServeStartupDeadlineExceeded(\"deadline expired before serve spawn\")\n2591: \n2592: \n2593: def _watch_serve_connection(\n2594:     conn: http.client.HTTPConnection,\n2595:     deadline: float | None,\n2596:     is_client_gone: Callable[[], bool] | None,\n2597:     phase_socket: list[socket.socket | None],\n2598: ) -> threading.Event:\n2599:     \"\"\"Прервать даже капающие HTTP-заголовки по абсолютному сроку или отмене.\"\"\"\n2600:     stopped = threading.Event()\n2601: \n2602:     def watch() -> None:\n2603:         while not stopped.wait(0.01):\n2604:             if (deadline is not None and time.monotonic() >= deadline) or (\n2605:                 is_client_gone is not None and is_client_gone()\n2606:             ):\n2607:                 sock = conn.sock or phase_socket[0]\n2608:                 if sock is not None:\n2609:                     try:\n2610:                         _ = sock.shutdown(socket.SHUT_RDWR)\n2611:                     except OSError:\n2612:                         pass\n2613:                     try:\n2614:                         _ = sock.close()\n2615:                     except OSError:\n2616:                         pass\n2617:                 return\n2618: \n2619:     if deadline is not None or is_client_gone is not None:\n2620:         threading.Thread(target=watch, daemon=True).start()\n2621:     return stopped\n2622: \n2623: \n2624: def _serve_http(\n2625:     port: int,\n2626:     password: str,\n2627:     method: str,\n2628:     path: str,\n2629:     body: dict[str, object] | None = None,\n2630:     timeout: float = 3.0,\n2631:     conn: http.client.HTTPConnection | None = None,\n2632:     on_headers: Callable[[int], None] | None = None,\n2633:     deadline: float | None = None,\n2634:     is_client_gone: Callable[[], bool] | None = None,\n2635:     skip_body: bool = False,\n2636: ) -> tuple[int, dict[str, object]]:\n2637:     \"\"\"Один HTTP-вызов serve с Basic-авторизацией без прокси.\"\"\"\n2638:     own_conn = conn is None\n2639:     active_conn = (\n2640:         conn\n2641:         if conn is not None\n2642:         else http.client.HTTPConnection(\"127.0.0.1\", port, timeout=timeout)\n2643:     )\n2644:     if conn is not None:\n2645:         conn.timeout = timeout\n2646:         if conn.sock is not None:\n2647:             _ = conn.sock.settimeout(timeout)\n2648: \n2649:     phase_socket: list[socket.socket | None] = [None]\n2650:     stopped = _watch_serve_connection(\n2651:         active_conn, deadline, is_client_gone, phase_socket\n2652:     )\n2653: \n2654:     def check_phase() -> None:\n2655:         \"\"\"Ограничить следующую фазу оставшимся бюджетом и проверить отмену.\"\"\"\n2656:         if is_client_gone is not None and is_client_gone():\n2657:             raise BrokenPipeError(errno.EPIPE, \"client gone\")\n2658:         remaining = (\n2659:             timeout if deadline is None else min(timeout, deadline - time.monotonic())\n2660:         )\n2661:         if remaining <= 0:\n2662:             active_conn.close()\n2663:             raise TimeoutError(\"serve http deadline expired\")\n2664:         active_conn.timeout = remaining\n2665:         connected_socket = active_conn.sock or phase_socket[0]\n2666:         if connected_socket is not None and connected_socket.fileno() >= 0:\n2667:             _ = connected_socket.settimeout(remaining)\n2668: \n2669:     try:\n2670:         check_phase()\n2671:         payload = json.dumps(body).encode(\"utf-8\") if body is not None else None\n2672:         auth = base64.b64encode(f\"opencode:{password}\".encode(\"utf-8\")).decode(\"ascii\")\n2673:         headers = {\"Authorizatio