mer, None\n2122:         if timer is not None:\n2123:             timer.cancel()\n2124:         _STARTUP_LOCK.release()\n2125: \n2126: \n2127: _STARTUP_LOCK = threading.Lock()\n2128: STARTUP_GATE_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_STARTUP_GATE_S\", \"12\"))\n2129: STARTUP_WAIT_S = float(os.environ.get(\"OPENCODE_ZEN_BRIDGE_STARTUP_WAIT_S\", \"5.0\"))\n2130: \n2131: _started = time.time()\n2132: _active: dict[str, float] = {}\n2133: _active_lock = threading.Lock()\n2134: \n2135: _LOG_LOCK = threading.Lock()\n2136: \n2137: \n2138: def _log(msg: str) -> None:\n2139:     line = f\"{time.strftime('%Y-%m-%d %H:%M:%S')} {_mask_secrets(msg)}\"\n2140:     sys.stderr.write(line + \"\\n\")\n2141:     sys.stderr.flush()\n2142:     try:\n2143:         LOG_PATH.parent.mkdir(parents=True, exist_ok=True)\n2144:         with _LOG_LOCK, LOG_PATH.open(\"a\", encoding=\"utf-8\") as fh:\nRANGE 3348 3427\n3348:         \"exit_reason\": \"\",\n3349:         \"delivered\": False,\n3350:         \"terminal\": \"\",\n3351:         \"first_event_at\": None,\n3352:         \"first_token_at\": None,\n3353:         \"step_closed\": False,\n3354:         \"first_event_ms\": None,\n3355:         \"ttft_ms\": None,\n3356:         \"prompt_status\": None,\n3357:         \"transient_error\": False,\n3358:     }\n3359:     attempt_deadline = min(\n3360:         deadline if deadline is not None else t0 + TIMEOUT_S, t0 + TIMEOUT_S\n3361:     )\n3362:     if is_client_gone is not None and is_client_gone():\n3363:         result[\"exit_reason\"] = \"client_gone\"\n3364:         result[\"delivered\"] = True\n3365:         return result\n3366:     try:\n3367:         serve_env = _serve_env(model)\n3368:     except OSError as exc:\n3369:         raise ServeUnavailable(f\"serve env failed: {exc}\") from exc\n3370:     if proxy_url:\n3371:         serve_env[\"HTTP_PROXY\"] = proxy_url\n3372:         serve_env[\"HTTPS_PROXY\"] = proxy_url\n3373:     password = serve_env.get(\"OPENCODE_SERVER_PASSWORD\", \"\")\n3374:     attempt_id = uuid.uuid4().hex\n3375:     try:\n3376:         lease, port, _pw = _spawn_serve(\n3377:             attempt_id,\n3378:             serve_env,\n3379:             deadline=attempt_deadline,\n3380:             is_client_gone=is_client_gone,\n3381:         )\n3382:     except (ServeClientDisconnect, ServeStartupDeadlineExceeded) as exc:\n3383:         result[\"exit_reason\"] = (\n3384:             \"client_gone\" if isinstance(exc, ServeClientDisconnect) else \"timeout\"\n3385:         )\n3386:         result[\"delivered\"] = True\n3387:         return result\n3388:     session_id = \"\"\n3389:     sse_conn: http.client.HTTPConnection | None = None\n3390:     prompt_status: dict[str, object] = {}\n3391:     control_conn: list[http.client.HTTPConnection | None] = [None]\n3392:     stop_event: threading.Event | None = None\n3393:     reader_thread: threading.Thread | None = None\n3394:     prompt_thread: threading.Thread | None = None\n3395: \n3396:     def _is_delivered() -> bool:\n3397:         return bool(\n3398:             prompt_status.get(\"headers_at\")\n3399:             or result[\"first_event_at\"] is not None\n3400:             or result[\"texts\"]\n3401:             or result[\"reasonings\"]\n3402:             or result[\"native_calls\"]\n3403:         )\n3404: \n3405:     def _ctrl_http(\n3406:         method: str,\n3407:         path: str,\n3408:         body: dict[str, object] | None = None,\n3409:         timeout: float = 3.0,\n3410:         phase_deadline: float | None = None,\n3411:     ) -> tuple[int, dict[str, object]]:\n3412:         \"\"\"Управляющий вызов serve по одному keep-alive соединению.\"\"\"\n3413:         call_deadline = min(\n3414:             attempt_deadline,\n3415:             phase_deadline\n3416:             if phase_deadline is not None\n3417:             else time.monotonic() + float(timeout),\n3418:         )\n3419:         for attempt in (0, 1):\n3420:             _check_serve_start(attempt_dead