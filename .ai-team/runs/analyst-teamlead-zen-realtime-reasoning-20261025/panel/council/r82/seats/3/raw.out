nt_gone, phase_socket)\n3217: def _cleanup_serve_attempt(\n3615:             if result[\"first_event_at\"] is None and now - prompt_send_start > float(\n3818:                         if emulate_tools:\n3896:         _cleanup_serve_attempt(\n3980:         start_new_session=True,\n5353:         gate.acquire()\n5791:             cleaned = _strip_interrupted(text)\n5904:             gate.acquire()\n6000:                 if attempts.allow_retry(reason):\n6030:                     if not _delivered_err and not force_serve:\n6034:                     if not _delivered_err and attempts.allow_retry(\n6536:                 gate.acquire()\n6847:                         elif emulate_tools:\n7287:                 if attempts.allow_retry(reason):\n7328:                     if not texts and attempts.allow_retry(\"serve_transient_error\"):\n7631:                 if emulate_tools:\n7944:         if emulate_tools:\n7955:         if emulate_tools:\n","exit_code":0,"status":"completed"}}
