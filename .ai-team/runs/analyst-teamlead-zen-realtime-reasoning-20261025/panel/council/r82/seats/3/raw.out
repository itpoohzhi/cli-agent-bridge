        int(result[\"usage\"].get(\"reasoning\") or 0),\n7338:                         tool_choice=tool_choice,\n7339:                     )\n7340:                     if _sig_j and attempts.allow_retry(\"incomplete_step\"):\n7341:                         _prior_content = \"\\n\\n\".join(c for c in contents if c)\n7342:                         current_prompt = _rewrite_tool_tags_for_model(\n7343:                             _incomplete_tool_step_prompt(\n7344:                                 prompt,\n7345:                                 \"\".join(contents),\n7346:                                 tools or [],\n7347:                                 tool_choice,\n7348:                                 model,\n7349:                             ),\nRANGE 6300 6312\n6300: \n6301:         workdir = DEFAULTWORKDIR\n6302:         workdir.mkdir(parents=True, exist_ok=True)\n6303:         model_route = _model_route(model)\n6304: \n6305:         cmd, shown = _build_cmd(launcher, model, effort)\n6306:         _log(\n6307:             f\"stream exec model={model_route} {shown} prompt_chars={len(prompt)} cwd={workdir}\"\n6308:         )\n6309: \n6310:         proc: subprocess.Popen[str] | None = None\n6311:         feed: _StdoutFeed | None = None\n6312:         gate: _StartupGate | None = None\nRANGE 7104 7133\n7104:                     proc.kill()\n7105:                 except OSError:\n7106:                     pass\n7107:         finally:\n7108:             # Таймер статуса не должен писать после завершения запроса.\n7109:             first_visible.set()\n7110:             if status_timer is not None:\n7111:                 status_timer.cancel()\n7112:             with wfile_lock:\n7113:                 self.wfile = raw_wfile\n7114:             self._first_visible = None\n7115:             if gate is not None:\n7116:                 gate.release()\n7117:             if proc is not None:\n7118:                 if feed is not None:\n7119:                     feed.close()\n7120:                 try:\n7121:                     if proc.stderr is not None:\n7122:                         proc.stderr.close()\n7123:                 except OSError:\n7124:                     pass\n7125:                 if proc.poll() is None:\n7126:                     try:\n7127:                         proc.kill()\n7128:                     except OSError:\n7129:                         pass\n7130:             with _active_lock:\n7131:                 _active.pop(run_id, None)\n7132:             attempts.commit()\n7133:             res.slots.release()\nRANGE 2409 2501\n2409: class _RequestAttempts:\n2410:     \"\"\"Учёт запусков одного HTTP-запроса: потолок MAX_TOTAL_SPAWNS, общий deadline, breaker, Retry Budget, backoff.\"\"\"\n2411: \n2412:     def __init__(\n2413:         self,\n2414:         res: _Resilience,\n2415:         deadline: float,\n2416:         max_total: int | None = None,\n2417:         sleep_fn: Callable[[float], None] = time.sleep,\n2418:         rng_fn: Callable[[float, float], float] = random.uniform,\n2419:         use_breaker: bool = True,\n2420:     ) -> None:\n2421:         self.res = res\n2422:         self.deadline = deadline\n2423:         self.use_breaker = (\n2424:             use_breaker  # False: прямой Google-маршрут без `opencode run`\n2425:         )\n2426:         self.max_total = MAX_TOTAL_SPAWNS if max_total is None else max_total\n2427:         self.total_spawns = 0\n2428:         self.retries = 0\n2429:         self.signal = 0\n2430:         self.exit_reason = \"\"\n2431:         self._pending_failure = False\n2432:         self._sleep = sleep_fn\n2433:         self._rng = rng_fn\n2434:         res.retry_budget.on_request()\n2435: \n2436:     def note_spawn(self) -> None:\n2437:         self.total_spawns += 1\n2438: \n2439:     def can_spawn(self) -> bool:\n2440:         \"\"\"Можно ли ещё запускать: суммарный потолок спавнов на запрос.\"\"\"\n2441:         return (\n2442:             self.total_spawns < MAX_TOTAL_SPAWNS and self.total_spawns < self.max_total\n2443:         )\n2444: \n2445:     def remaining_s(self) -> float:\n2446:         return max(0.0, self.deadline - time.monotonic())\n2447: \n2448:     def begin_attempt(self) -> bool:\n2449:         \"\"\"Первичный запуск: потолок, deadline и Circuit Breaker (в HALF_OPEN резервирует единственную пробу).\"\"\"\n2450:         return (\n2451:             self.total_spawns < self.max_total\n2452:             and time.monotonic() < self.deadline\n2453:             and (not self.use_breaker or self.res.breaker.allow())\n2454:         )\n2455: \n2456:     def allow_retry(self, reason: str, charge_budget: bool = True) -> bool:\n2457:         \"\"\"Можно ли сделать повторный запуск: потолок, deadline, breaker, Retry Budget; затем Full Jitter пауза.\n2458: \n2459:         charge_budget=False — локальный отказ старта CLI без обращения к провайдеру («database is locked»):\n2460:         он не нагружает апстрим, ограничен FAIL_RETRY_LIMIT, MAX_TOTAL_SPAWNS и темпом запусков.\n2461:         \"\"\"\n2462:         if self.total_spawns >= self.max_total:\n2463:             _log(f\"retry denied ({reason}): MAX_TOTAL_SPAWNS={self.max_total} reached\")\n2464:             return False\n2465:         if time.monotonic() >= self.deadline:\n2466:             return False\n2467:         if self.use_breaker and self.res.breaker.is_blocking():\n2468:             _log(f\"retry denied ({reason}): upstream circuit open\")\n2469:             return False\n2470:         if charge_budget and not self.res.retry_budget.try_acquire_retry():\n2471:             _log(f\"retry denied ({reason}): retry budget exhausted\")\n2472:             return False\n2473:         self.retries += 1\n2474:         delay = (\n2475:             _retry_backoff_s(self.retries, self._rng)\n2476:             if FAIL_RETRY_BACKOFF_S > 0\n2477:             else 0.0\n2478:         )\n2479:         delay = min(delay, self.remaining_s())\n2480:         if delay > 0:\n2481:             self._sleep(delay)\n2482:         return not self.use_breaker or self.res.breaker.allow()\n2483: \n2484:     def attempt_done(self, transient_failure: bool, success: bool) -> None:\n2485:         \"\"\"Итог попытки для Circuit Breaker: успех учитывается сразу, транзиентный отказ — по итогу запроса (commit).\n2486: \n2487:         Запрос, который повтором дошёл до успеха, апстрим не «роняет»; отказ засчитывается, только\n2488:         если запрос закончился отказом. Нейтральные итоги (таймаут, детерминированный 4xx) не считаются.\n2489:         \"\"\"\n2490:         if not self.use_breaker:\n2491:             return\n2492:         if success and not transient_failure:\n2493:             self._pending_failure = False\n2494:             self.res.breaker.record_success()\n2495:         else:\n2496:             self._pending_failure = transient_failure\n2497: \n2498:     def commit(self) -> None:\n2499:         \"\"\"Итог запроса: незакрытый транзиентный отказ последней попытки -> breaker.record_failure().\"\"\"\n2500:         if self._pending_failure:\n2501:             self._pending_failure = False\n","exit_code":0,"status":"completed"}}
