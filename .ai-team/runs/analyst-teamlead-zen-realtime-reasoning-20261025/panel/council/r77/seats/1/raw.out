et(\"provider_status\"),\n                        bool(out.get(\"had_output\"))):\n                    return out\n                if not attempts.allow_retry(\"cli_failure\", charge_budget=out.get(\"provider_status\") is not None):\n                    return out\n                fail_retries += 1\n                _log(f\"exec failed rc={out.get('rc')} without output, retry {fail_retries}/{FAIL_RETRY_LIMIT} \"\n                     f\"total_spawns={attempts.total_spawns}/{attempts.max_total}: \"\n                     f\"{_clean_err(str(out.get('err') or ''), 300)!r}\")\n                self.close()","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5200,"endLine":5249},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-a5c78d13-b796-4425-8107-2d00a7159f91-1\nfc_a1bba401-b6a2-94cd-9066-c11c903e29fd_1","startedAtMs":"1793088216231","completedAtMs":"1793088216330"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-0-qiwy","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088216370}
