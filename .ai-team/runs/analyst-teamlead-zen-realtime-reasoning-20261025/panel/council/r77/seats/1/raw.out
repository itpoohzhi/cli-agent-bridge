done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        last_token_at = time.monotonic()\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                        if result[\"first_token_at\"] is None:\n                            result[\"first_token_at\"] = time.monotonic()\n                            result[\"ttft_ms\"] = int(\n                                ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                            )\n                        if emulate_tools:\n                            result[\"terminal\"] = \"tool_calls\"\n                            break\n            elif etype == \"step_finish\":\n                step_key = str(\n                    _as_dict(payload).get(\"assistantMessageID\")\n                    or data_raw.get(\"assistantMessageID\")\n                    or \"\"\n                )\n                if step_key and step_key in seen_steps:\n                    continue\n                if step_key:\n                    seen_steps.add(step_key)\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n                        payload.get(key)\n                    )\n                # Завершить native вызовы без called: аргументы из input.ended.text.\n                for call_id in list(tool_state.tools):\n                    done = tool_state.complete(call_id, etype_raw)\n                    if done is not None:\n                        last_token_at = time.monotonic()\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                if result[\"native_calls\"] or (\n                    emulate_tools and _split_tool_calls([\"\".join(result[\"texts\"])])[1]\n                ):\n                    if result[\"first_token_at\"] is None and result[\"native_calls\"]:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"terminal\"] = \"tool_calls\"\n                    break\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"delivered\"] = _is_delivered()","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3710,"endLine":3789},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-55aa5c75-7fa4-4ae5-9c19-41aa2c3552b0-9\nfc_91135a5f-84fa-9f10-aa2c-5ff2c02f78dd_3","startedAtMs":"1793088274224","completedAtMs":"1793088274320"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-1-yxjh","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088274361}
