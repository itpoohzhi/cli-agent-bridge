ent_gone)\n                if time.monotonic() >= ready_deadline:\n                    raise ServeUnavailable(f\"serve ready failed: {exc}\") from exc\n                time.sleep(0.05)\n        if status in (401, 403):\n            raise ServeSecurityError(f\"serve auth HTTP {status}\")\n        if status in (400, 404, 422):\n            raise ServeSecurityError(f\"serve invalid request HTTP {status}\")\n        if status != 200 or not isinstance(active.get(\"data\"), dict):\n            raise ServeUnavailable(f\"serve ready HTTP {status}\")\n        route = _model_route(model)\n        provider, _sep, raw_id = route.partition(\"/\")\n        variant = _variant_for(model, effort)","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3355,"endLine":3409},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-0ebf03d8-a876-49b6-9809-33b426476638-10\nfc_13c2cf7f-cbaf-9dd4-8465-eefb9b548d4e_5","startedAtMs":"1793088326540","completedAtMs":"1793088326644"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-3-16lt","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088326684}
