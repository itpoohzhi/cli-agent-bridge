\n                conn = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=timeout)\n                control_conn[0] = conn\n            try:\n                return _serve_http(\n                    port,\n                    password,\n                    method,\n                    path,\n                    body,\n                    timeout=timeout,\n                    conn=conn,\n                    deadline=attempt_deadline,\n                    is_client_gone=is_client_gone,\n                )\n            except (OSError, http.client.HTTPException):\n                try:\n                    conn.close()\n                except OSError:\n                    pass\n                control_conn[0] = None\n                if attempt:\n                    raise\n        raise ServeUnavailable(\"serve control connection failed\")\n\n    try:\n        status = 0\n        active: dict[str, object] = {}\n        ready_deadline = min(time.monotonic() + 3.0, attempt_deadline)\n        while True:\n            try:\n                status, active = _ctrl_http(\"GET\", \"/api/session/active\", timeout=3.0)\n                break\n            except (OSError, http.client.HTTPException) as exc:\n                _check_serve_start(attempt_deadline, is_client_gone)\n                if time.monotonic() >= ready_deadline:\n                    raise ServeUnavailable(f\"serve ready failed: {exc}\") from exc","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3320,"endLine":3399},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-a5c78d13-b796-4425-8107-2d00a7159f91-3\nfc_a1bba401-b6a2-94cd-9066-c11c903e29fd_3","startedAtMs":"1793088217032","completedAtMs":"1793088217132"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-0-qiwy","session_id":"7a0c2aa2-98ab-4bb5-97