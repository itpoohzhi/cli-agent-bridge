693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":3145,"endLine":3184},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-55aa5c75-7fa4-4ae5-9c19-41aa2c3552b0-8\nfc_91135a5f-84fa-9f10-aa2c-5ff2c02f78dd_2","startedAtMs":"1793088273911","completedAtMs":"1793088274219"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-1-yxjh","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088274262}
