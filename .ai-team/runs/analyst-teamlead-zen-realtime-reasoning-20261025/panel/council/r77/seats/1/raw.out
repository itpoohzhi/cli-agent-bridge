") or \"\"), 500)\n                    xs[\"exit_reason\"] = \"provider_fatal\"\n                    self._send(\n                        502,\n                        _error_payload(\n                            f\"opencode provider error after partial output (HTTP {out.get('provider_status')})\"\n                            + (f\": {tail}\" if tail else \"\"),\n                            tail,\n                        ),\n                    )\n                    return\n                if not emulate_tools or tool_calls:\n                    break\n                if unmapped:\n                    if (\n                        unmapped_retries >= NATIVE_RETRY_LIMIT\n                        or not attempts.allow_retry(\"unmapped\")\n                    ):\n                        _log(\n                            f\"unmapped built-in tools={unmapped}: retries exhausted ({unmapped_retries})\"\n                        )","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":7488,"endLine":7537},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-a5c78d13-b796-4425-8107-2d00a7159f91-2\nfc_a1bba401-b6a2-94cd-9066-c11c903e29fd_2","startedAtMs":"1793088216659","completedAtMs":"1793088216750"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-0-qiwy","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088216791}
