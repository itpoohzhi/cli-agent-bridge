watchdog_state[\"reason\"])\n                    if attempts.allow_retry(reason_w):\n                        if thinking_enabled and (attempt_reasonings or attempt_texts):\n                            emit_synthetic(\n                                f\"[мост] Повтор попытки {attempts.total_spawns + 1}/{attempts.max_total}…\\n\"\n                            )\n                        continue\n                    xs[\"exit_reason\"] = reason_w\n                    failure = {\"rc\": rc, \"tail\": \"\", \"watchdog\": reason_w}\n                    break\n                if timed_out:\n                    failure = {\"rc\": rc, \"tail\": \"\", \"timeout\": True}\n                    break\n                if rc != 0 and not attempt_output:\n                    _log(f\"stream cli failed rc={rc} stderr_tail={tail!r}\")\n                    if (\n                        fail_retries < FAIL_RETRY_LIMIT\n                        and time.monotonic() < deadline\n                        and _is_retryable_failure(\n                            rc, tail, provider_status, bool(tool_calls)","isEmpty":false,"exceededLimit":false,"totalLines":7846,"fileSize":343693,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":6740,"endLine":6799},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-a5c78d13-b796-4425-8107-2d00a7159f91-5\nfc_a1bba401-b6a2-94cd-9066-c11c903e29fd_5","startedAtMs":"1793088217462","completedAtMs":"1793088217563"},"model_call_id":"f3566fd7-8c48-46fe-ba41-12ddc2358a2f-0-qiwy","session_id":"7a0c2aa2-98ab-4bb5-97f8-6d7f4bfcc5cf","timestamp_ms":1793088217606}
