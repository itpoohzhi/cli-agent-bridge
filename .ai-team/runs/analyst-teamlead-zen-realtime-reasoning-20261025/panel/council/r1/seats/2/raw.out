one guard at final stream exit, frozen3 functions untouched.\",\n1152:      \"helper_cli_probe_source\": \"def _run_serve_helper_cli(args: list[str]) -> int:\\n    \\\"\\\"\\\"Изолированная архитектурная проба argv/импортов/RSS; не реализация Stage 3.\\\"\\\"\\\"\\n    if len(args) != 6:\\n        return 2\\n    (\\n        attempt_id,\\n        port_text,\\n        opencode_bin,\\n        lease_dir_text,\\n        parent_pid_text,\\n        parent_lstart,\\n    ) = args\\n    if not all((attempt_id, opencode_bin, lease_dir_text, parent_lstart)):\\n        return 2\\n    if not port_text.isdecimal() or not parent_pid_text.isdecimal():\\n        return 2\\n    port, parent_pid = int(port_text), int(parent_pid_text)\\n    if not 1 <= port <= 65535 or parent_pid <= 0:\\n        return 2\\n    lease_dir = Path(lease_dir_text)\\n    if not lease_dir.is_dir():\\n        return 2\\n    forbidden_accesses: list[str] = []\\n\\n    def audit(event: str, values: tuple[object, ...]) -> None:\\n        for value in values:\\n            if isinstance(value, (str, bytes)):\\n                text = str(value)\\n                if any(\\n                    p in text\\n                    for p in (\\\"zen-catalog.json\\\", \\\"bridge.log\\\", \\\"dynamic_config.json\\\")\\n                ):\\n                    forbidden_accesses.append(event + \\\":\\\" + text)\\n                    raise RuntimeError(\\\"forbidden helper path\\\")\\n\\n    sys.addaudithook(audit)\\n    serve_env = dict(os.environ)\\n    proc = subprocess.Popen(\\n        [opencode_bin, \\\"serve\\\", \\\"--hostname\\\", \\\"127.0.0.1\\\", \\\"--port\\\", str(port)],\\n        stdin=subprocess.DEVNULL,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n        start_new_session=False,\\n        close_fds=True,\\n        env=serve_env,\\n    )\\n    print(\\n        json.dumps(\\n            {\\n                \\\"serve_pid\\\": proc.pid,\\n                \\\"pgid\\\": os.getpgrp(),\\n      