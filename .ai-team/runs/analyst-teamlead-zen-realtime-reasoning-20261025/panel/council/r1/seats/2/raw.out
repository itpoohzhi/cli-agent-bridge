     ),\\n            flush=True,\\n        )\\n    finally:\\n        if proc.poll() is None:\\n            proc.kill()\\n            _ = proc.wait(timeout=3)\\n    return 0\\n\",\n1153:      \"parent_argv_contract\": \"[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), str(OPENCODE_BIN), str(lease_dir), str(os.getpid()), parent_lstart]\",\n1154:      \"parent_popen\": \"subprocess.Popen([sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), str(OPENCODE_BIN), str(lease_dir), str(os.getpid()), parent_lstart], stdin=lifeline_r, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True, close_fds=True, env=serve_env)\",\n1156:      \"entry_isolation\": \"Early isolated dispatcher in server.py: top-level only minimal stdlib imports (json, os, signal, subprocess, sys, time, Path, select/resource as needed; existing typing import retained unchanged for the frozen no-new-Any gate) and typed def _run_serve_helper_cli(args: list[str]) -> int. Immediately afterwards: if sys.argv[1:2] == [\\\"--serve-helper\\\"]: raise SystemExit(_run_serve_helper_cli(sys.argv[2:])); else: import all normal-server-only modules, including http.client, sqlite3, from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer, and after sys.path.insert(0, str(Path(__file__).resolve().parent)), static import zen_catalog as zc. Imports inside else prevent Ruff module-level E402; terminating SystemExit branch makes those names definitely assigned for the normal path in basedpyright1.40.2. No helper execution reaches reload_catalog() (original server.py:163), _DEFAULT_RESILIENCE, main/HTTP startup, LOG_PATH/DYNAMIC_CONFIG_PATH initialization, or any access to state/zen-catalog.json, logs/bridge.log, dynamic_config.json. No importlib transform, inline -c source, new module, suppressions, or frozen-slice changes.\",\n1257:          \"parent_lstart\": \"Mon Oct 26 11:02:42 2026\"