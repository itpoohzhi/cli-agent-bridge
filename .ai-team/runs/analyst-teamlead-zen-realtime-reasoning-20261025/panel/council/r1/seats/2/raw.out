(monkeypatch):\\n    bridge=W/'repo/bridges/opencode-zen-bridge'\\n    home=W/'empty-home';home.mkdir(exist_ok=True)\\n    lease=W/'leases';lease.mkdir(exist_ok=True)\\n    fake=W/'fake_serve_bin'\\n    fake.write_text('#!'+sys.executable+'\\\\n'+'''import json,os,socket,sys,time\\ns=socket.socket();s.bind((\\\"127.0.0.1\\\",int(sys.argv[-1])));s.listen(1)\\nprint(json.dumps({\\\"argv\\\":sys.argv,\\\"pid\\\":os.getpid(),\\\"pgid\\\":os.getpgrp(),\\\"OPENCODE_BIN_in_env\\\":\\\"OPENCODE_BIN\\\" in os.environ}),flush=True)\\ntime.sleep(30)\\n''');fake.chmod(0o700)\\n    spec=importlib.util.spec_from_file_location('server',bridge/'server.py')\\n    server=importlib.util.module_from_spec(spec);sys.modules['server']=server;spec.loader.exec_module(server)\\n    monkeypatch.setattr(server,'OPENCODE_BIN',str(fake))\\n    assert not (home/'.opencode/bin/opencode').exists()\\n    with socket.socket() as reserve:\\n        reserve.bind(('127.0.0.1',0));port=reserve.getsockname()[1]\\n    parent_lstart=subprocess.check_output(['ps','-p',str(os.getpid()),'-o','lstart='],text=True).strip()\\n    attempt_id='arch6-clean-room-001'\\n    argv=[sys.executable,'-I',str(Path(server.__file__).resolve()),'--serve-helper',attempt_id,str(port),str(server.OPENCODE_BIN),str(lease),str(os.getpid()),parent_lstart]\\n    serve_env={'HOME':str(home),'PATH':'/usr/bin:/bin','TMPDIR':str(W),'LANG':'en_US.UTF-8','PYTHONDONTWRITEBYTECODE':'1','OPENCODE_DB':':memory:'}\\n    lr,lw=os.pipe();p=subprocess.Popen(argv,cwd=W,stdin=lr,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True,close_fds=True,env=serve_env,text=True);os.close(lr)\\n    try:\\n        ready,_,_=select.select([p.stdout],[],[],5);assert ready\\n        line=p.stdout.readline();assert line,(p.poll(),p.stderr.read());first=json.loads(line)\\n        assert not first['loaded_forbidden'] and not first['initialized_forbidden'] and not first['forbidden_accesses']\\n        assert first['parent_pid']==os.getpid() and first['parent_lstart']==parent_lstart\\n        assert os.getpgid(first['serve_pid'])==p.pid==first['pgid']\\n        rss_kib=int(subprocess.check_output(['ps','-p',str(p.pid),'-o','rss='],text=True))\\n        assert rss_kib>0 and p.poll() is None\\n        # Confirm the fake actually owns the requested port before closing lifeline.\\n        deadline=time.monotonic()+3\\n        while True:\\n            try:\\n                with socket.create_connection(('127.0.0.1',port),timeout=0.2):break\\n            except OSError:\\n                assert time.monotonic()<deadline\\n        os.close(lw);lw=-1\\n        out,err=p.communicate(timeout=5);assert p.returncode==0,(out,err)\\n        last=json.loads(out.strip());child=json.loads(last['child_stdout'].strip())\\n        assert child['argv']==[str(fake),'serve','--hostname','127.0.0.1','--port',str(port)]\\n        assert child['pid']==first['serve_pid'] and not child['OPENCODE_BIN_in_env']\\n        assert not last['forbidden_accesses']\\n        peak=max(first['ru_maxrss_bytes'],last['ru_maxrss_bytes'])\\n        invalid=[]\\n        valid=argv[4:]\\n        cases=[[],valid[:-1],valid+['extra']]\\n        for i,val in [(0,''),(1,'0'),(1,'65536'),(1,'x'),(2,''),(3,''),(4,'0'),(4,'-1'),(5,'')]:\\n            v=valid.copy();v[i]=val;cases.append(v)\\n        for args in cases:\\n            q=subprocess.run(argv[:4]+args,cwd=W,env=serve_env,stdin=subprocess.DEVNULL,capture_output=True,text=True)\\n            assert q.returncode==2 and not q.stdout,(args,q.returncode,q.stdout)\\n            invalid.append({'args':args,'exit_code':q.returncode})\\n        result={'argv':argv,'cwd':str(W),'env':serve_env,'python':sys.version,'platform':sys.platform,'helper_pid':p.pid,'serve_pid':first['serve_pid'],'first':first,'last':last,'fake':child,'rss':{'ps_rss_kib':rss_kib,'ps_rss_bytes':rss_kib*1024,'ps_rss_mib':rss_kib/1024,'ru_maxrss_bytes':peak,'ru_maxrss_kib':peak/1024,'ru_maxrss_mib':peak/1048576,'conversion':'Darwin ru_maxrss b