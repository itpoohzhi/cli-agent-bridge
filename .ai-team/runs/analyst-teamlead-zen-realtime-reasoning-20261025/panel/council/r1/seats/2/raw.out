] = True\n  2996\t                request_id = str(payload.get(\"id\") or \"\")\n  2997\t                st, _b = _ctrl_http(\n  2998\t                    \"POST\",\n  2999\t                    f\"/api/session/{session_id}/permission/{request_id}/reply\",\n  3000\t                    {\"decision\": \"reject\"},\n  3001\t                    timeout=0.25,\n  3002\t                )\n  3003\t                if st not in (200, 204):\n  3004\t                    raise ServeSecurityError(f\"permission reply HTTP {st}\")\n  3005\t                st2, _b2 = _ctrl_http(\n  3006\t                    \"POST\",\n  3007\t                    f\"/api/session/{session_id}/interrupt\",\n  3008\t                    None,\n  3009\t                    timeout=0.25,\n  3010\t                )\n  3011\t                if st2 not in (200, 204):\n  3012\t                    raise ServeSecurityError(f\"permission interrupt HTTP {st2}\")\n  3013\t                continue\n  3014\t            if result[\"step_closed\"] and etype in (\"reasoning\", \"text\"):\n  3015\t                continue\n  3016\t            if etype == \"reasoning\":\n  3017\t                text_value = str(payload.get(\"reasoning_content\") or \"\")\n  3018\t                if text_value.strip():\n  3019\t                    if result[\"first_token_at\"] is None:\n  3020\t                        result[\"first_token_at\"] = time.monotonic()\n  3021\t                        result[\"ttft_ms\"] = int(\n  3022\t                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n  3023\t                        )\n  3024\t                    result[\"reasonings\"].append(text_value)\n  3025\t                    last_token_at = time.monotonic()\n  3026\t                    on_reasoning(text_value)\n  3027\t            elif etype == \"text\":\n  3028\t                text_value = str(payload.get(\"content\") or \"\")\n  3029\t                if text_value.strip():\n  3030\t                    if result[\"first_token_at\"] is None:\n  3031\t                        result[\"first_token_at\"] = time.monotonic()\n  3032\t                        result[\"ttft_ms\"] = int(\n  3033\t                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n  3034\t                        )\n  3035\t                    result[\"texts\"].append(text_value)\n  3036\t                    last_token_at = time.monotonic()\n  3037\t                    on_text(text_value)\n  3038\t            elif etype == \"tool_event\":\n  3039\t                tool_state.feed(payload)\n  3040\t                call_id = str(payload.get(\"id\") or \"\")\n  3041\t                if etype_raw in (\n  3042\t                    \"session.tool.called\",\n  3043\t                    \"session.tool.failed\",\n  3044\t                    \"session.tool.success\",\n  3045\t                ):\n  3046\t                    done = tool_state.complete(call_id)\n  3047\t                    if done is not None:\n  3048\t                        result[\"native_calls\"].append(done[1])\n  3049\t                        on_tool(done[1])\n  3050\t                        if result[\"first_token_at\"] is None:\n  3051\t                            result[\"first_token_at\"] = time.monotonic()\n  3052\t            elif etype == \"step_finish\":\n  3053\t                step_key = str(\n  3054\t                    _as_dict(payload).get(\"assistantMessageID\")\n  3055\t                    or data_raw.get(\"assistantMessageID\")\n  3056\t                    or \"\"\n  3057\t                )\n  3058\t                if step_key and step_key in seen_steps:\n  3059\t                    continue\n  3060\t                if step_key:\n  3061\t                    seen_steps.add(step_key)\n  3062\t                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n  3063\t                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n  3064\t                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n  3065\t                        payload.get(key)\n  3066\t                    )\n  3067\t                # Завершить native вызовы без called: аргументы из input.ended.text.\n  3068\t                for call_id in list(tool_state.tools):\n  3069\t                    done = tool_state.complete(call_id)\n  3070\t                    if done is not None:\n  3071\t                        result[\"native_calls\"].append(done[1])\n  3072\t                        on_tool(done[1])\n  3073\t            elif etype == \"error\":\n  3074\t                result[\"error\"] = payload\n  3075\t                result[\"terminal\"] = \"failed\"\n  3076\t                break\n  3077\t            elif etype_raw == \"session.execution.succeeded\":\n  3078\t                result[\"terminal\"] = \"succeeded\"\n  3079\t                break\n  3080\t        return result\n  3081\t    finally:\n  3082\t        if session_id:\n  3083\t            try:\n  3084\t                _ = _ctrl_http(\n  3085\t                    \"POST\",\n  5110\t                    tools: list[dict[str, Any]] | None = None,\n  5111\t                    google_input: GoogleInput | None = None, reported_model: str | None = None,\n  5112\t                    tool_choice: Any = None) -> None:\n  5113\t        shown_model = reported_model or model\n  5114\t        if _is_google_direct_model(model):\n  5115\t            self._stream_google_sse(model, prompt, effort, emulate_tools, google_input)\n  5116\t            return\n  5117\t        xs = self._exit()\n  5118\t        xs[\"transport\"] = \"run\"\n  5119\t        xs[\"transport_history\"] = [\"run\"]\n  5120\t        launcher = _resolve_launcher()\n  5121\t        if not os.access(launcher, os.X_OK):\n  5122\t            xs[\"exit_reason\"] = \"launcher_missing\"\n  5123\t            self._send(502, {\"error\": {\"message\": f\"opencode launcher not executable: {launcher}\",\n  5124\t                                       \"type\": \"proxy_error\", \"code\": 502}})\n  5125\t            return\n  5126\t\n  5127\t        res = self._res()\n  5128\t        if not self._acquire_slot(res):\n  5129\t            return\n  5130\t        attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S)\n  5131\t        xs[\"attempts\"] = attempts\n  5132\t\n  5133\t        resp_id = f\"chatcmpl-oczen-{uuid.uuid4().hex[:12]}\"\n  5134\t        created = int(time.time())\n  5135\t        self.close_connection = True\n  5136\t\n  5137\t        workdir = DEFAULTWORKDIR\n  5138\t        workdir.mkdir(parents=True, exist_ok=True)\n  5139\t        model_route = _model_route(model)\n  5140\t\n  5141\t        cmd, shown = _build_cmd(launcher, model, effort)\n  5142\t        _log(f\"stream exec model={model_route} {shown} prompt_chars={len(prompt)} cwd={workdir}\")\n  5143\t\n  5144\t        proc: subprocess.Popen[str] | None = None\n  5145\t        feed: _StdoutFeed | None = None\n  5146\t        gate: _StartupGate | None = None\n  5147\t        run_id = uuid.uuid4().hex[:8]\n  5148\t\n  5149\t        try:\n  5150\t            if not attempts.begin_attempt():\n  5151\t                xs[\"exit_reason\"] = \"circuit_open\"\n  5152\t                self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n  5153\t                return\n  5154\t\n  5155\t            # 1. Отправляются HTTP-заголовки 200 SSE\n  5156\t            self.send_response(200)\n  5157\t            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n  5158\t            self.send_header(\"Cache-Control\", \"no-cache\")\n  5159\t            self.send_header(\"Connection\", \"close\")\n  5160\t            self.send_header(\"X-Accel-Buffering\", \"no\")\n  5161\t            self.end_headers()\n  5162\t            xs[\"status\"] = 200\n  5163\t\n  5164\t            # 2. Отправляется первый чанк\n  5165\t            first_chunk = format_sse_chunk(\n  5166\t                resp_id, created, shown_model, {\"role\": \"assistant\", \"content\": \"\"}\n  5167\t            )\n  5168\t            self.wfile.write(first_chunk.encode(\"utf-8\"))\n  5169\t            self.wfile.flush()\n  5170\t\n  5171\t            collected_texts: list[str] = []\n  5172\t            usage: dict[str, Any] = {}\n  5173\t            deadline = attempts.deadline\n  5174\t            tool_calls: list[dict[str, Any]] = []\n  5175\t\n  5176\t            # Повтор незавершённого шага: уже отданный клиенту текст (dedup_prefix) подавляется,\n  5177\t            # расхождение (модель переформулировала) отдаётся целиком — текст не теряется.\n  5178\t            dedup: list[_PrefixDedup | None] = [None]\n  5179\t\n  5180\t            def send_text(text: str) -> None:\n  5181\t                chunk = format_sse_chunk(resp_id, created, shown_model, {\"content\": text})\n  5182\t                self.wfile.write(chunk.encode(\"utf-8\"))\n  5183\t                self.wfile.flush()\n  5184\t                collected_texts.append(text)  # только реально отданное клиенту\n  5185\t\n  5186\t            def emit_content(text: str) -> None:\n  5187\t                if not text:\n  5188\t                    return\n  5495\t                            attempt_output = True\n  5496\t                            if retries and not incomplete_retry and not attempt_texts and collected_texts:\n  5497\t                                emit_content(\"\\n\\n\")\n  5498\t                            attempt_texts.append(ttext)\n  5499\t                            if parser is not None:\n  5500\t                                parser.feed(ttext)\n  5501\t                            else:\n  5502\t                                emit_content(ttext)\n  5503\t                    elif etype == \"step_finish\":\n  5504\t                        if payload:\n  5505\t                            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n  5506\t                                usage[key] = int(usage.get(key) or 0) + int(payload.get(key) or 0)\n  5507\t                            attempt_output_tokens += int(payload.get(\"output\") or 0)\n  5508\t                            attempt_reasoning_tokens += int(payload.get(\"reasoning\") or 0)\n  5509\t                        if emulate_tools and tool_calls:\n  5510\t                            # Следующие шаги — реакция на «отклонение» (повтор вызова): не нужны.\n  5511\t                            _log(\"stream: step with tool call finished, stopping opencode run\")\n  5512\t                            _stop_proc(proc)\n  5513\t                            break\n  5514\t                    elif etype == \"error\":\n  5515\t                        _log(f\"stream provider error: HTTP {payload.get('statusCode')}: {payload.get('message')}\")\n  5516\t                        if isinstance(payload.get(\"statusCode\"), int):\n  5517\t                            provider_status = payload[\"statusCode\"]\n  5518\t                        err_lines.append(f\"HTTP {payload.get('statusCode')}: {payload.get('message')}\")\n  5519\t                        if attempt_output:\n  5520\t                            # Оборванный ответ: иначе opencode сам запустит SYNTHETIC-шаг «Continue…» —\n  5521\t                            # останавливаем сразу. Транзиентная ошибка -> повтор шага, детерминированная\n  5522\t                            # (401…) -> ошибка клиенту без повтора. Ошибка до первого токена — не трогаем:\n  5523\t                            # opencode повторит сам или выйдет, и тогда флаг не должен «залипнуть».\n  5524\t                            if _is_transient_stream_error(payload):\n  5525\t                                had_provider_error = True\n  5526\t                            else:\n  5527\t                                fatal_mid_error = True\n  5528\t                            _log(f\"stream: provider error mid-response (transient={had_provider_error}), \"\n  5529\t                                 \"stopping opencode run\")\n  5530\t                            stopped_on_error = True\n  5531\t                            _stop_proc(proc)\n  5532\t                            break\n  5533\t                        _log(\"stream: early provider error (waiting for CLI recovery)\")\n  5534\t                    elif etype == \"tool_use\":\n  5535\t                        attempt_output = True\n  5625\t                        _log(f\"stream unmapped built-in tools={unmapped}: retries exhausted ({unmapped_retries})\")\n  5626\t                        emit_content(f\"\\n\\n[opencode-zen-bridge: модель вызывала недоступный встроенный \"\n  5627\t                                     f\"инструмент ({', '.join(unmapped)}); повторы исчерпаны]\")\n  5628\t                        break\n  5629\t                    retries += 1\n  5630\t                    unmapped_retries += 1\n  5631\t                    incomplete_retry = False\n  5632\t                    _log(f\"stream unmapped built-in tools={unmapped}: re-prompt \"\n  5633\t                         f\"{unmapped_retries}/{NATIVE_RETRY_LIMIT}\")\n  5634\t                    attempt_prompt = _rewrite_tool_tags_for_model(_unavailable_tools_prompt(\n  5635\t                        attempt_prompt, \"\".join(attempt_texts), unmapped, tools or [], model), model)\n  5636\t                    continue\n  5637\t                signal = 0 if provider_status in _FATAL_HTTP else _incomplete_step_signal(\n  5638\t                    \"\".join(attempt_texts), \"\".join(attempt_reasonings), tools or [],\n  5639\t                    had_provider_error, attempt_output_tokens, attempt_reasoning_tokens,\n  5640\t                    tool_choice=tool_choice)\n  5641\t                if not signal:\n  5642\t                    break\n  5643\t                if incomplete_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\"incomplete_step\"):\n  5644\t                    _log(f\"stream incomplete tool step: retries exhausted ({incomplete_retries}) signal={signal}\")\n  5645\t                    break\n  5646\t                retries += 1\n  5647\t                incomplete_retries += 1\n  5648\t                incomplete_retry = True\n  5649\t                attempts.signal = signal\n  5650\t                _log(f\"stream incomplete tool step: re-prompt {incomplete_retries}/{NATIVE_RETRY_LIMIT} \"\n  5651\t                     f\"signal={signal} total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n  5652\t                attempt_prompt = _rewrite_tool_tags_for_model(_incomplete_tool_step_prompt(\n  5653\t                    prompt, \"\".join(collected_texts), tools or [], tool_choice, model), model)\n  5654\t\n  5655\t            if failure is not None:\n  5656\t                _log(f\"stream failed model={model} rc={failure['rc']} fail_retries={fail_retries} \"\n  5657\t                     f\"total_spawns={attempts.total_spawns}\")\n  5658\t                if failure.get(\"timeout\"):\n  5659\t                    xs[\"exit_reason\"] = \"timeout\"\n  5660\t                    self._sse_error(_error_payload(f\"opencode timed out after {TIMEOUT_S:.0f}s\"))\n2:# pyright: reportAny=false, reportPrivateUsage=false, reportUnknownArgumentType=false, reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnannotatedClassAttribute=false, reportUninitializedInstanceVariable=false, reportImplicitOverride=false, reportMissingParameterType=false, reportUnusedCallResult=false\n279:class TestLegacyWatchdogAndKillpg(unittest.TestCase):\n313:        os.environ[\"FAKE_RT_MODE\"] = \"slow\"\n321:        self.assertLessEqual(statuses[0][0], 1.0)\n378:        os.environ[\"FAKE_RT_MODE\"] = \"silent\"\n381:        old = server.FIRST_EVENT_TIMEOUT_S  # type: ignore[attr-defined]\n384:            server.FIRST_EVENT_TIMEOUT_S = 1.0  # type: ignore[attr-defined]\n385:            server.FIRST_TOKEN_TIMEOUT_S = 2.0  # type: ignore[attr-defined]\n390:            server.FIRST_EVENT_TIMEOUT_S = old  # type: ignore[attr-defined]\n391:            server.FIRST_TOKEN_TIMEOUT_S = old_tok  # type: ignore[attr-defined]\n392:        self.assertLess(elapsed, 25.0)\n397:class TestServeTransportAndFakeServe(unittest.TestCase):\n408:        server.DYNAMIC_CONFIG_PATH = self.cfg  # type: ignore[attr-defined]\n411:            server.LEASE_DIR = self.tmp / \"leases\"  # type: ignore[attr-defined]\n429:            server.DYNAMIC_CONFIG_PATH = self.saved_cfg  # type: ignore[attr-defined]\n431:            server.LEASE_DIR = self.saved_lease  # type: ignore[attr-defined]\n442:        first_reasoning_t = model_reasoning[0][0]\n443:        upstream_end_t = elapsed\n444:        self.assertLess(first_reasoning_t, upstream_end_t)\n445:        self.assertLess(model_reasoning[-1][0] - model_reasoning[0][0], 2.0)\n568:        self.assertLessEqual(statuses[0][0], 1.0)\n619:        self.assertTrue(silence or rows)\n624:        self.assertLess(elapsed, 15.0)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"Нашёл конкретные расхождения: serve обходит ограничитель стартов, отбрасывает дельты из одних пробелов и переводов строк, а некоторые ошибки запуска выходят до уборки процесса. Полный L2-прогон остаётся подтверждённым; он не проверяет эти сценарии. Завершаю сверку требований и повторный проход по рубрике.\n"}}
