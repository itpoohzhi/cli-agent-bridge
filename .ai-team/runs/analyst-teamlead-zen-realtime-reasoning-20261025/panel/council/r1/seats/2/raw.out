{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'def _serve_one_attempt|if text_value.strip|prompt_status|deadline = prompt_send_start|def _run_serve_stream_attempts|def _serve_json_serve|note_spawn|spawn_limiter|gate.acquire|def _JsonParser|class _JsonParser|class _StdoutFeed|def lines|def _drain_stderr|def _clean_err|def _strip_interrupted|def _startup_reaper|def _spawn_serve|def cleanup|class _ServeToolState|def _incomplete_step_signal|STEP_RECOVERY|tool_choice|def on_status|def on_reasoning|def on_text|session.execution.succeeded|elif etype == \\\"step_finish\\\"' bridges/opencode-zen-bridge/server.py; git status --short; ls\"","aggregated_output":"473:STEP_RECOVERY_ENABLED = os.environ.get(\"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\").strip().lower() not in (\n761:def _strip_interrupted(text: str) -> str:\n771:def _is_forced_tool_choice(tool_choice: Any) -> bool:\n772:    return tool_choice == \"required\" or bool(_tool_choice_name(tool_choice))\n851:    \"\"\"Kill-switch OPENCODE_ZEN_BRIDGE_STEP_RECOVERY (константа модуля и живое значение env).\"\"\"\n852:    return not STEP_RECOVERY_ENABLED or os.environ.get(\n853:        \"OPENCODE_ZEN_BRIDGE_STEP_RECOVERY\", \"1\").strip().lower() in (\"0\", \"false\", \"no\", \"off\")\n902:                                        reasoning_tokens: int = 0, *, tool_choice: Any = None,\n906:    1 — транзиентная ошибка посреди ответа (или принудительный tool_choice без вызова); 2 — маркер\n913:    if not names or _tool_choice_none(tool_choice):\n915:    if _is_forced_tool_choice(tool_choice):\n947:                             reasoning_tokens: int = 0, *, tool_choice: Any = None,\n952:    и длинный итог, — False. Выключается kill-switch'ем STEP_RECOVERY_ENABLED первой же инструкцией.\n956:        tool_choice=tool_choice, had_error=had_error))\n959:def _incomplete_step_signal(*args: Any, **kwargs: Any) -> int:\n967:                                 tool_choice: Any = None, model_id: str = \"\") -> str:\n976:    if tool_choice == \"required\":\n978:    elif _tool_choice_name(tool_choice):\n979:        forced = f' You MUST call the tool \"{_tool_choice_name(tool_choice)}\" now.'\n993:def _tools_tail_reminder(history: str, tools: list[dict[str, Any]], tool_choice: Any = None,\n1000:    if not tools or _tool_choice_none(tool_choice) or not (\n1006:    if tool_choice == \"required\":\n1008:    elif _tool_choice_name(tool_choice):\n1009:        forced = f' You MUST call the tool \"{_tool_choice_name(tool_choice)}\" now.'\n1028:def _drain_stderr(proc: subprocess.Popen[str], sink: list[str]) -> None:\n1057:class _StdoutFeed:\n1096:    def lines(self, deadline: float, idle_s: float = 0.0,\n1560:class _JsonParser:\n1923:def _clean_err(lines: list[str] | str, limit: int = 600) -> str:\n2218:        self.spawn_limiter = _SpawnRateLimiter(SPAWN_RATE_PER_S, SPAWN_BURST)\n2255:    def note_spawn(self) -> None:\n2447:    def cleanup(self) -> None:\n2488:def _spawn_serve(\n2577:def _startup_reaper(lease_dir: Path | None = None) -> int:\n2637:class _ServeToolState:\n2708:def _serve_one_attempt(\n2743:    prompt_status: dict[str, object] = {}\n2879:                prompt_status[\"status\"] = st\n2880:                prompt_status[\"headers_at\"] = time.monotonic()\n2882:                    prompt_status[\"security\"] = True\n2884:                prompt_status[\"error\"] = str(exc)\n2889:        deadline = prompt_send_start + TIMEOUT_S\n2901:                result[\"delivered\"] = bool(prompt_status.get(\"headers_at\"))\n2932:                        prompt_status.get(\"headers_at\") or result[\"first_event_at\"]\n2965:            if prompt_status.get(\"security\"):\n3018:                if text_value.strip():\n3029:                if text_value.strip():\n3052:            elif etype == \"step_finish\":\n3077:            elif etype_raw == \"session.execution.succeeded\":\n3342:def _tool_choice_none(tool_choice: Any) -> bool:\n3343:    \"\"\"tool_choice:\"none\" — инструменты не предлагаем вовсе.\"\"\"\n3344:    return isinstance(tool_choice, str) and tool_choice.strip().lower() == \"none\"\n3347:def _tool_choice_name(tool_choice: Any) -> str:\n3348:    \"\"\"Имя обязательного инструмента из tool_choice (\"\" — без принуждения).\"\"\"\n3349:    if not isinstance(tool_choice, dict):\n3351:    fn = _dict_or_empty(tool_choice.get(\"function\"))\n3352:    name = fn.get(\"name\") or tool_choice.get(\"name\") or \"\"\n3356:def _tools_section(tools: list[Any], tool_choice: Any, model_id: str = \"\") -> str:\n3378:    if tool_choice == \"required\":\n3381:        forced = _tool_choice_name(tool_choice)\n4491:        gate.acquire()\n4492:        if not self.res.spawn_limiter.acquire(\n4519:            self.attempts.note_spawn()\n4576:                elif etype == \"step_finish\":\n4753:    def _run_serve_stream_attempts(\n4777:        def on_status(text: str) -> None:\n4790:        def on_reasoning(text: str) -> None:\n4804:        def on_text(text: str) -> None:\n4848:            attempts.note_spawn()\n4950:                    tool_choice=None,\n5112:                    tool_choice: Any = None) -> None:\n5298:                gate.acquire()\n5299:                if not res.spawn_limiter.acquire(max_wait_s=min(SPAWN_WAIT_MAX_S, attempts.remaining_s())):\n5318:                attempts.note_spawn()\n5503:                    elif etype == \"step_finish\":\n5640:                    tool_choice=tool_choice)\n5653:                    prompt, \"\".join(collected_texts), tools or [], tool_choice, model), model)\n5736:    def _serve_json_serve(\n5744:        tool_choice: object,\n5768:            attempts.note_spawn()\n5891:                tool_choice=tool_choice,\n5902:                    prompt, \"\\n\\n\".join(contents), tools or [], tool_choice, model\n5947:                    tool_choice: Any = None) -> None:\n6068:                    int(run_usage.get(\"reasoning\") or 0), tool_choice=tool_choice)\n6081:                    prompt, \"\\n\\n\".join(c for c in contents if c), tools or [], tool_choice, model), model)\n6217:        tool_choice = req.get(\"tool_choice\")\n6218:        emulate_tools = bool(tools) and not _tool_choice_none(tool_choice)\n6229:            head.append(_tools_section(tools, tool_choice, model))\n6240:            reminder = _tools_tail_reminder(history, tools, tool_choice, model)\n6248:                             reported_model=requested_model, tool_choice=tool_choice)\n6251:                             reported_model=requested_model, tool_choice=tool_choice)\n M bridges/opencode-zen-bridge/server.py\n M bridges/opencode-zen-bridge/tests/test_step_interruption.py\n?? .ai-team/runs/analyst-teamlead-zen-realtime-reasoning-20261025/\n?? analysis/zen-realtime-reasoning/\n?? bridges/opencode-zen-bridge/tests/test_realtime_reasoning.py\nCHANGELOG.md\nLICENSE\nREADME.md\n__pycache__\nadapters\nanalysis\nbridges\ncore\ndocs\nfleet.json\nfleet_check.py\npyrightconfig.json\nreceipts\nruff.toml\nserver.py\nstart.sh\ntests\ntools\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"Применяю правила `teamlead-gate` для полного прохода. Общий канон `~/Мой диск/Context/AGENTS.md` прочитан до `<!-- КАНОН-КОНЕЦ -->`; в рабочей папке `AGENTS.md`, `.agents/AGENTS.md` и `CLAUDE.md` отсутствуют. Профильные стандарты прочитаны в приложенном пакете.\n\nL2 подтверждает зелёный полный набор, но reverse-spec отмечает непроверенные ветки serve. Сверяю их с кодом, прежде всего таймауты, повторы и освобождение ресурсов.\n"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '750,770p;1028,1145p;1920,1945p;2228,2320p;2430,2635p;2770,3115p;4832,4968p;5190,5318p;5748,5825p;5950,6005p' bridges/opencode-zen-bridge/server.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '750,770p;1028,1145p;1920,1945p;2228,2320p;2430,2635p;2770,3115p;4832,4968p;5190,5318p;5748,5825p;5950,6005p' bridges/opencode-zen-bridge/server.py\"","aggregated_output":"PREAMBLE_MAX_LINES = 6\nPREAMBLE_SHORT_CHARS = 220\n\n# Mid-stream `etype == \"error\"`: транзиентные сбои (повторяем) против детерминированных (Fail-Closed).\n_FATAL_STREAM_STATUSES = (400, 401, 403, 404, 422)\n_TRANSIENT_ERROR_MARKERS = (\n    \"econnreset\", \"etimedout\", \"timeout\", \"timed out\", \"socket hang up\", \"interrupted\", \"overloaded\",\n    \"rate limit\", \"temporarily unavailable\", \"fetch failed\", \"network\", \"connection reset\", \"broken pipe\", \"eof\",\n)\n\n\ndef _strip_interrupted(text: str) -> str:\n    \"\"\"Убрать артефакт SYNTHETIC-продолжения opencode («I was interrupted right before…»).\"\"\"\n    return _INTERRUPTED_RE.sub(\"\", text)\n\n\ndef _has_interrupted_marker(text: str) -> bool:\n    low = text.lower()\n    return any(marker in low for marker in _INTERRUPT_MARKERS)\n\n\ndef _drain_stderr(proc: subprocess.Popen[str], sink: list[str]) -> None:\n    \"\"\"Вычитать stderr дочернего процесса построчно в `sink` (до EOF).\"\"\"\n    try:\n        assert proc.stderr is not None\n        for line in proc.stderr:\n            line = line.strip()\n            if line:\n                sink.append(line)\n    except (OSError, ValueError):\n        pass\n\n\ndef _stop_proc(proc: subprocess.Popen[str]) -> None:\n    \"\"\"Остановить группу `opencode run` (SIGTERM -> SIGKILL); процесс запущен со start_new_session.\"\"\"\n    if proc.poll() is not None:\n        return\n    try:\n        os.killpg(proc.pid, signal.SIGTERM)\n        proc.wait(timeout=5)\n    except (OSError, subprocess.TimeoutExpired):\n        try:\n            os.killpg(proc.pid, signal.SIGKILL)\n        except OSError:\n            pass\n\n\n_STDOUT_POLL_S = 0.25\n\n\nclass _StdoutFeed:\n    \"\"\"Строки stdout дочернего процесса через ограниченную очередь: ожидание не блокируется навсегда.\n\n    Читатель — daemon-поток; без него `for raw in proc.stdout` не возвращает управление, пока CLI\n    молчит, и ни дедлайн, ни keepalive не срабатывают. `timed_out` выставляется, когда `lines()`\n    остановился по дедлайну (вызывающий сам останавливает процесс). Очередь ограничена `maxsize`:\n    на `queue.Full` читатель не роняет данные молча — ставит `overflowed`, считает `dropped_total`,\n    останавливает процесс (`_stop_proc`) и выходит; попытка считается неуспешной.\n    \"\"\"\n\n    def __init__(self, proc: subprocess.Popen[str], maxsize: int | None = None) -> None:\n        self._proc = proc\n        self._queue: queue.Queue[str] = queue.Queue(maxsize=STDOUT_QUEUE_MAX if maxsize is None else maxsize)\n        self.timed_out = False\n        self.overflowed = False\n        self.dropped_total = 0\n        self._error: BaseException | None = None\n        self._done = threading.Event()\n        self._thread = threading.Thread(target=self._reader, daemon=True)\n        self._thread.start()\n\n    def _reader(self) -> None:\n        try:\n            assert self._proc.stdout is not None\n            for raw in self._proc.stdout:\n                try:\n                    self._queue.put_nowait(raw)\n                except queue.Full:\n                    self.dropped_total += 1\n                    self.overflowed = True\n                    _log(f\"stdout_overflow queue_max={self._queue.maxsize} dropped_total={self.dropped_total}, \"\n                         \"stopping opencode run\")\n                    _stop_proc(self._proc)\n                    break\n        except (OSError, ValueError) as exc:\n            self._error = exc\n        finally:\n            self._done.set()  # после всех put: потребитель, увидев флаг, дочитывает остаток очереди\n\n    def lines(self, deadline: float, idle_s: float = 0.0,\n              on_idle: Callable[[], None] | None = None) -> Iterator[str]:\n        \"\"\"Строки до EOF, переполнения или дедлайна; `on_idle` вызывается, если строк нет дольше `idle_s` (0 — выкл.).\"\"\"\n        last_activity = time.monotonic()\n        while True:\n            if self.overflowed:\n                return\n            now = time.monotonic()\n            if now >= deadline:\n                self.timed_out = True\n                return\n            wait = deadline - now\n            if idle_s > 0 and on_idle is not None:\n                wait = min(wait, max(last_activity + idle_s - now, 0.0))\n            try:\n                item = self._queue.get(timeout=min(max(wait, 0.001), _STDOUT_POLL_S))\n            except queue.Empty:\n                if self._done.is_set():\n                    try:\n                        item = self._queue.get_nowait()\n                    except queue.Empty:\n                        if self._error is not None:\n                            raise self._error from None\n                        return\n                else:\n                    now = time.monotonic()\n                    if idle_s > 0 and on_idle is not None and now - last_activity >= idle_s:\n                        on_idle()\n                        last_activity = now\n                    continue\n            last_activity = time.monotonic()\n            if last_activity > deadline:\n                self.timed_out = True\n                return\n            yield item\n\n    def close(self) -> None:\n        \"\"\"Закрыть stdout, если читатель вышел: close() при блокированном чтении виснет на замке буфера.\"\"\"\n        if self._thread.is_alive():\n            return\n        try:\n            if self._proc.stdout is not None:\n                self._proc.stdout.close()\n        except OSError:\n            pass\n\n    def join(self, timeout: float) -> None:\n        self._thread.join(timeout=timeout)\n\n\n_FATAL_HTTP = {400, 401, 402, 403, 404, 422}\n\n\ndef _clean_err(lines: list[str] | str, limit: int = 600) -> str:\n    \"\"\"Хвост stderr/ошибок CLI без ANSI-раскраски и токеноподобных секретов.\"\"\"\n    text = \"\\n\".join(lines) if isinstance(lines, list) else lines\n    text = _ANSI_RE.sub(\"\", text)\n    text = \"\\n\".join(part.strip() for part in text.splitlines() if part.strip())\n    return _mask_secrets(text)[-limit:]\n\n\ndef _is_retryable_failure(rc: int | None, err_text: str, provider_status: int | None,\n                          had_output: bool) -> bool:\n    \"\"\"Прогон без какого-либо вывода и с rc != 0 — транзиторный отказ CLI (повторяем).\n\n    Не повторяем: был вывод; процесс убит нами/таймаутом (rc < 0 или None);\n    провайдер вернул детерминированный отказ (400/401/402/403/404/422).\n    \"\"\"\n    if had_output or rc is None or rc <= 0:\n        return False\n    return provider_status not in _FATAL_HTTP\n\n\ndef _error_payload(message: str, detail: str = \"\") -> dict[str, Any]:\n    \"\"\"Тело OpenAI-style ошибки (SSE-чанк `{\"error\":…}` и non-stream 502).\"\"\"\n    err: dict[str, Any] = {\"message\": message, \"type\": \"proxy_error\", \"code\": 502}\nclass _RequestAttempts:\n    \"\"\"Учёт запусков одного HTTP-запроса: потолок MAX_TOTAL_SPAWNS, общий deadline, breaker, Retry Budget, backoff.\"\"\"\n\n    def __init__(\n        self,\n        res: _Resilience,\n        deadline: float,\n        max_total: int | None = None,\n        sleep_fn: Callable[[float], None] = time.sleep,\n        rng_fn: Callable[[float, float], float] = random.uniform,\n        use_breaker: bool = True,\n    ) -> None:\n        self.res = res\n        self.deadline = deadline\n        self.use_breaker = (\n            use_breaker  # False: прямой Google-маршрут без `opencode run`\n        )\n        self.max_total = MAX_TOTAL_SPAWNS if max_total is None else max_total\n        self.total_spawns = 0\n        self.retries = 0\n        self.signal = 0\n        self.exit_reason = \"\"\n        self._pending_failure = False\n        self._sleep = sleep_fn\n        self._rng = rng_fn\n        res.retry_budget.on_request()\n\n    def note_spawn(self) -> None:\n        self.total_spawns += 1\n\n    def remaining_s(self) -> float:\n        return max(0.0, self.deadline - time.monotonic())\n\n    def begin_attempt(self) -> bool:\n        \"\"\"Первичный запуск: потолок, deadline и Circuit Breaker (в HALF_OPEN резервирует единственную пробу).\"\"\"\n        return (\n            self.total_spawns < self.max_total\n            and time.monotonic() < self.deadline\n            and (not self.use_breaker or self.res.breaker.allow())\n        )\n\n    def allow_retry(self, reason: str, charge_budget: bool = True) -> bool:\n        \"\"\"Можно ли сделать повторный запуск: потолок, deadline, breaker, Retry Budget; затем Full Jitter пауза.\n\n        charge_budget=False — локальный отказ старта CLI без обращения к провайдеру («database is locked»):\n        он не нагружает апстрим, ограничен FAIL_RETRY_LIMIT, MAX_TOTAL_SPAWNS и темпом запусков.\n        \"\"\"\n        if self.total_spawns >= self.max_total:\n            _log(f\"retry denied ({reason}): MAX_TOTAL_SPAWNS={self.max_total} reached\")\n            return False\n        if time.monotonic() >= self.deadline:\n            return False\n        if self.use_breaker and self.res.breaker.is_blocking():\n            _log(f\"retry denied ({reason}): upstream circuit open\")\n            return False\n        if charge_budget and not self.res.retry_budget.try_acquire_retry():\n            _log(f\"retry denied ({reason}): retry budget exhausted\")\n            return False\n        self.retries += 1\n        delay = (\n            _retry_backoff_s(self.retries, self._rng)\n            if FAIL_RETRY_BACKOFF_S > 0\n            else 0.0\n        )\n        delay = min(delay, self.remaining_s())\n        if delay > 0:\n            self._sleep(delay)\n        return not self.use_breaker or self.res.breaker.allow()\n\n    def attempt_done(self, transient_failure: bool, success: bool) -> None:\n        \"\"\"Итог попытки для Circuit Breaker: успех учитывается сразу, транзиентный отказ — по итогу запроса (commit).\n\n        Запрос, который повтором дошёл до успеха, апстрим не «роняет»; отказ засчитывается, только\n        если запрос закончился отказом. Нейтральные итоги (таймаут, детерминированный 4xx) не считаются.\n        \"\"\"\n        if not self.use_breaker:\n            return\n        if success and not transient_failure:\n            self._pending_failure = False\n            self.res.breaker.record_success()\n        else:\n            self._pending_failure = transient_failure\n\n    def commit(self) -> None:\n        \"\"\"Итог запроса: незакрытый транзиентный отказ последней попытки -> breaker.record_failure().\"\"\"\n        if self._pending_failure:\n            self._pending_failure = False\n            self.res.breaker.record_failure()\n\n\nclass _PrefixDedup:\n    \"\"\"dedup_prefix повторной попытки SSE: уже отданный клиенту префикс подавляется, расхождение — отдаётся целиком.\n\n        serve_pid: int,\n        pgid: int,\n        lifeline_w: int,\n        lease_dir: Path,\n        attempt_id: str,\n        state_dir: str,\n    ) -> None:\n        self.helper = helper\n        self.serve_pid = serve_pid\n        self.pgid = pgid\n        self.lifeline_w = lifeline_w\n        self.lease_dir = lease_dir\n        self.attempt_id = attempt_id\n        self.state_dir = state_dir\n        self._closed = False\n        self._lock = threading.Lock()\n\n    def cleanup(self) -> None:\n        \"\"\"Идемпотентная уборка только своей группы процессов.\"\"\"\n        with self._lock:\n            if self._closed:\n                return\n            self._closed = True\n        try:\n            os.close(self.lifeline_w)\n        except OSError:\n            pass\n        if self.helper.poll() is None or _pid_alive(self.pgid):\n            try:\n                if os.getpgid(self.pgid) == self.pgid:\n                    os.killpg(self.pgid, signal.SIGTERM)\n            except OSError:\n                pass\n            try:\n                _ = self.helper.wait(timeout=0.5)\n            except (OSError, subprocess.SubprocessError):\n                try:\n                    os.killpg(self.pgid, signal.SIGKILL)\n                except OSError:\n                    pass\n                try:\n                    _ = self.helper.wait(timeout=0.5)\n                except (OSError, subprocess.SubprocessError):\n                    pass\n        for stream in (self.helper.stdout, self.helper.stderr):\n            try:\n                if stream is not None:\n                    stream.close()\n            except OSError:\n                pass\n        try:\n            (self.lease_dir / f\"lease-{self.attempt_id}.json\").unlink()\n        except OSError:\n            pass\n        if self.state_dir and Path(self.state_dir).name.startswith(\"zen-serve-state-\"):\n            shutil.rmtree(self.state_dir, ignore_errors=True)\n\n\ndef _spawn_serve(\n    attempt_id: str, serve_env: dict[str, str]\n) -> tuple[_ServeLease, int, str]:\n    \"\"\"Запуск helper->serve, проверка слушателя и рукопожатия.\"\"\"\n    lease_dir = Path(LEASE_DIR)\n    lease_dir.mkdir(parents=True, exist_ok=True)\n    port = 0\n    for candidate in range(20000 + (os.getpid() % 20000), 60000):\n        probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n        try:\n            probe.bind((\"127.0.0.1\", candidate))\n            port = candidate\n            break\n        except OSError:\n            continue\n        finally:\n            probe.close()\n    if not port:\n        raise ServeUnavailable(\"no free serve port\")\n    password = serve_env.get(\"OPENCODE_SERVER_PASSWORD\", \"\")\n    lifeline_r, lifeline_w = os.pipe()\n    try:\n        helper: subprocess.Popen[str] = subprocess.Popen(\n            [\n                sys.executable,\n                \"-I\",\n                str(Path(__file__).resolve()),\n                \"--serve-helper\",\n                attempt_id,\n                str(port),\n                str(OPENCODE_BIN),\n                str(lease_dir),\n                str(os.getpid()),\n                _parent_lstart(),\n            ],\n            stdin=lifeline_r,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            start_new_session=True,\n            close_fds=True,\n            env=serve_env,\n            text=True,\n        )\n    finally:\n        try:\n            os.close(lifeline_r)\n        except OSError:\n            pass\n    lease = _ServeLease(\n        helper,\n        0,\n        helper.pid,\n        lifeline_w,\n        lease_dir,\n        attempt_id,\n        serve_env.get(\"XDG_STATE_HOME\", \"\"),\n    )\n    try:\n        assert helper.stdout is not None\n        out_fd = helper.stdout.fileno()\n        ready, _w, _x = select.select([out_fd], [], [], 3.0)\n        if not ready:\n            raise ServeUnavailable(\"serve handshake timeout\")\n        line_bytes = b\"\"\n        while not line_bytes.endswith(b\"\\n\"):\n            chunk_b = os.read(out_fd, 1)\n            if not chunk_b:\n                break\n            line_bytes += chunk_b\n        line = line_bytes.decode(\"utf-8\", \"replace\")\n        handshake = _as_dict(_loads_object(line)) if line else {}\n        serve_pid = _as_int(handshake.get(\"serve_pid\"))\n        pgid = _as_int(handshake.get(\"pgid\"))\n        lease.serve_pid = serve_pid\n        if not serve_pid or pgid != helper.pid or helper.poll() is not None:\n            raise ServeUnavailable(\"serve ownership handshake mismatch\")\n        listener_pid = _lsof_listener_pid(port)\n        if listener_pid is not None and (\n            listener_pid != serve_pid or os.getpgid(listener_pid) != pgid\n        ):\n            raise ServeUnavailable(\"foreign listener on serve port\")\n        # stderr помощника дренируется в лог, stdout после рукопожатия молчит.\n        threading.Thread(target=_drain_stderr, args=(helper, []), daemon=True).start()\n        return lease, port, password\n    except (OSError, ValueError, subprocess.SubprocessError) as exc:\n        lease.cleanup()\n        raise ServeUnavailable(str(exc)) from exc\n\n\ndef _startup_reaper(lease_dir: Path | None = None) -> int:\n    \"\"\"Убрать осиротевшие lease мёртвого родителя при старте моста.\"\"\"\n    target = Path(LEASE_DIR) if lease_dir is None else lease_dir\n    removed = 0\n    try:\n        files = list(target.glob(\"lease-*.json\"))\n    except OSError:\n        return 0\n    for path in files:\n        try:\n            data = _as_dict(_loads_object(path.read_text(\"utf-8\")))\n            parent_pid = _as_int(data.get(\"parent_pid\"))\n            helper_pid = _as_int(data.get(\"helper_pid\"))\n            pgid = _as_int(data.get(\"pgid\"))\n        except (OSError, ValueError, TypeError):\n            continue\n        parent_alive = parent_pid > 0 and _pid_alive(parent_pid)\n        if parent_alive:\n            continue\n        if helper_pid > 0 and pgid == helper_pid and _pid_alive(helper_pid):\n            try:\n                cmd = subprocess.run(\n                    [\"ps\", \"-ww\", \"-o\", \"command=\", \"-p\", str(helper_pid)],\n                    capture_output=True,\n                    text=True,\n                    timeout=2,\n                ).stdout\n            except (OSError, subprocess.SubprocessError):\n                cmd = \"\"\n            if \"--serve-helper\" not in cmd:\n                continue\n            try:\n                os.killpg(pgid, signal.SIGTERM)\n            except OSError:\n                pass\n        try:\n            path.unlink()\n            removed += 1\n        except OSError:\n            pass\n    return removed\n\n\ndef _pid_alive(pid: int) -> bool:\n    \"\"\"Жив ли процесс.\"\"\"\n    try:\n        os.kill(pid, 0)\n        return True\n    except OSError:\n        return False\n\n\nclass _ToolItem(TypedDict):\n    \"\"\"Накопленный native вызов serve.\"\"\"\n\n    name: str\n    text: str\n    input: dict[str, object] | None\n\n        raise ServeUnavailable(\"serve control connection failed\")\n\n    try:\n        status = 0\n        active: dict[str, object] = {}\n        ready_deadline = time.monotonic() + 3.0\n        while True:\n            try:\n                status, active = _ctrl_http(\"GET\", \"/api/session/active\", timeout=3.0)\n                break\n            except (OSError, http.client.HTTPException) as exc:\n                if time.monotonic() >= ready_deadline:\n                    raise ServeUnavailable(f\"serve ready failed: {exc}\") from exc\n                time.sleep(0.05)\n        if status in (401, 403):\n            raise ServeSecurityError(f\"serve auth HTTP {status}\")\n        if status in (400, 404, 422):\n            raise ServeSecurityError(f\"serve invalid request HTTP {status}\")\n        if status != 200 or not isinstance(active.get(\"data\"), dict):\n            raise ServeUnavailable(f\"serve ready HTTP {status}\")\n        route = _model_route(model)\n        provider, _sep, raw_id = route.partition(\"/\")\n        variant = _variant_for(model, effort)\n        model_body: dict[str, object] = {\n            \"providerID\": provider or \"opencode\",\n            \"id\": raw_id or model,\n        }\n        if variant:\n            model_body[\"variant\"] = variant\n        status, created = _ctrl_http(\n            \"POST\",\n            \"/api/session\",\n            {\n                \"location\": {\"directory\": str(workdir)},\n                \"model\": model_body,\n                \"permissions\": [\n                    {\n                        \"action\": \"*\",\n                        \"resource\": \"*\",\n                        \"effect\": _serve_permission_effect(),\n                    }\n                ],\n            },\n            timeout=3.0,\n        )\n        if status in (401, 403):\n            raise ServeSecurityError(f\"serve create HTTP {status}\")\n        if status in (400, 404, 422):\n            raise ServeSecurityError(f\"serve invalid request HTTP {status}\")\n        created_data = created.get(\"data\")\n        if (\n            status != 200\n            or not isinstance(created_data, dict)\n            or not created_data.get(\"id\")\n        ):\n            raise ServeUnavailable(f\"serve create HTTP {status}\")\n        session_id = str(created_data[\"id\"])\n        sse_conn = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=5)\n        auth = base64.b64encode(f\"opencode:{password}\".encode(\"utf-8\")).decode(\"ascii\")\n        sse_conn.request(\n            \"GET\",\n            \"/api/event\",\n            None,\n            {\"Authorization\": f\"Basic {auth}\", \"Accept\": \"text/event-stream\"},\n        )\n        sse_resp = sse_conn.getresponse()\n        if sse_resp.status in (401, 403):\n            raise ServeSecurityError(f\"serve event HTTP {sse_resp.status}\")\n        if sse_resp.status in (400, 404, 422):\n            raise ServeSecurityError(f\"serve event HTTP {sse_resp.status}\")\n        if sse_resp.status != 200:\n            raise ServeUnavailable(f\"serve event HTTP {sse_resp.status}\")\n        events: queue.Queue[dict[str, object] | None] = queue.Queue(maxsize=4096)\n\n        def _reader() -> None:\n            \"\"\"Читатель SSE в очередь событий.\"\"\"\n            try:\n                while True:\n                    line = sse_resp.readline()\n                    if not line:\n                        break\n                    text_line = line.decode(\"utf-8\", \"replace\").strip()\n                    if not text_line.startswith(\"data:\"):\n                        continue\n                    payload = text_line[5:].strip()\n                    if not payload or payload == \"[DONE]\":\n                        continue\n                    obj = _loads_object(payload)\n                    if isinstance(obj, dict):\n                        events.put(_as_dict(obj))\n            except (OSError, ValueError):\n                pass\n            finally:\n                events.put(None)\n\n        threading.Thread(target=_reader, daemon=True).start()\n        prompt_send_start = time.monotonic()\n\n        def _prompt_worker() -> None:\n            \"\"\"Доставка prompt параллельно чтению SSE.\"\"\"\n            try:\n                st, _body = _serve_http(\n                    port,\n                    password,\n                    \"POST\",\n                    f\"/api/session/{session_id}/prompt\",\n                    {\"text\": prompt, \"files\": [], \"delivery\": \"steer\", \"resume\": True},\n                    timeout=65.0,\n                )\n                prompt_status[\"status\"] = st\n                prompt_status[\"headers_at\"] = time.monotonic()\n                if st in (401, 403):\n                    prompt_status[\"security\"] = True\n            except (OSError, http.client.HTTPException) as exc:\n                prompt_status[\"error\"] = str(exc)\n\n        threading.Thread(target=_prompt_worker, daemon=True).start()\n        tool_state = _ServeToolState()\n        seen_steps: set[str] = set()\n        deadline = prompt_send_start + TIMEOUT_S\n        status_next = max(t0 + FIRST_STATUS_DELAY_S, prompt_send_start + 0.25)\n        last_token_at = prompt_send_start\n        while time.monotonic() < deadline:\n            if is_client_gone is not None and is_client_gone():\n                result[\"exit_reason\"] = \"client_gone\"\n                return result\n            now = time.monotonic()\n            if result[\"first_event_at\"] is None and now - prompt_send_start > float(\n                FIRST_EVENT_TIMEOUT_S\n            ):\n                result[\"exit_reason\"] = \"first_event_timeout\"\n                result[\"delivered\"] = bool(prompt_status.get(\"headers_at\"))\n                return result\n            if (\n                result[\"first_event_at\"] is not None\n                and result[\"first_token_at\"] is None\n                and now - prompt_send_start > float(FIRST_TOKEN_TIMEOUT_S)\n            ):\n                result[\"exit_reason\"] = \"first_token_timeout\"\n                result[\"delivered\"] = True\n                return result\n            if result[\"first_token_at\"] is not None and now - last_token_at > float(\n                STALL_TIMEOUT_S\n            ):\n                result[\"exit_reason\"] = \"stall_timeout\"\n                result[\"delivered\"] = True\n                return result\n            if thinking_enabled and on_status is not None and now >= status_next:\n                if result[\"first_token_at\"] is None:\n                    on_status(STATUS_WAITING)\n                    status_next = now + STATUS_WAITING_INTERVAL_S\n                elif now - last_token_at >= float(STALL_HEARTBEAT_INTERVAL_S):\n                    on_status(STATUS_CONTINUATION)\n                    status_next = now + float(STALL_HEARTBEAT_INTERVAL_S)\n            try:\n                event = events.get(timeout=0.05)\n            except queue.Empty:\n                continue\n            if event is None:\n                if not result[\"terminal\"]:\n                    result[\"exit_reason\"] = \"invalid_serve_event\"\n                    result[\"delivered\"] = bool(\n                        prompt_status.get(\"headers_at\") or result[\"first_event_at\"]\n                    )\n                break\n            etype_raw = str(event.get(\"type\") or \"\")\n            data_raw = _as_dict(event.get(\"data\"))\n            # form.created: безопасность до любой проверки title/fields/схемы.\n            if etype_raw == \"form.created\":\n                form = _as_dict(data_raw.get(\"form\"))\n                form_session = form.get(\"sessionID\")\n                form_id = form.get(\"id\")\n                if form_session == session_id and isinstance(form_id, str) and form_id:\n                    result[\"step_closed\"] = True\n                    st, _b = _ctrl_http(\n                        \"POST\",\n                        f\"/api/session/{session_id}/form/{form_id}/cancel\",\n                        None,\n                        timeout=0.25,\n                    )\n                    if st not in (200, 204):\n                        raise ServeSecurityError(f\"form cancel HTTP {st}\")\n                    st2, _b2 = _ctrl_http(\n                        \"POST\",\n                        f\"/api/session/{session_id}/interrupt\",\n                        None,\n                        timeout=0.25,\n                    )\n                    if st2 not in (200, 204):\n                        raise ServeSecurityError(f\"form interrupt HTTP {st2}\")\n                    result[\"terminal\"] = \"cancelled\"\n                    break\n                if form_session == session_id:\n                    raise ServeSecurityError(\"form.created without id\")\n                continue\n            if prompt_status.get(\"security\"):\n                raise ServeSecurityError(\"serve prompt auth failed\")\n            try:\n                etype, payload = _map_serve_event(event)\n            except ServeProtocolError:\n                result[\"exit_reason\"] = \"invalid_serve_event\"\n                result[\"delivered\"] = True\n                return result\n            event_session = (\n                payload.get(\"sessionID\") if isinstance(payload, dict) else None\n            )\n            if etype_raw not in (\"server.connected\",) and event_session not in (\n                None,\n                session_id,\n            ):\n                continue\n            is_execution = etype_raw in (\n                \"session.execution.started\",\n                \"session.step.started\",\n                \"session.reasoning.started\",\n                \"session.reasoning.delta\",\n                \"session.text.delta\",\n                \"session.step.ended\",\n            ) or etype in (\"reasoning\", \"text\", \"step_finish\")\n            if is_execution and result[\"first_event_at\"] is None:\n                result[\"first_event_at\"] = time.monotonic()\n                result[\"first_event_ms\"] = int(\n                    ((result[\"first_event_at\"] or 0.0) - t0) * 1000\n                )\n            if etype == \"permission\":\n                result[\"step_closed\"] = True\n                request_id = str(payload.get(\"id\") or \"\")\n                st, _b = _ctrl_http(\n                    \"POST\",\n                    f\"/api/session/{session_id}/permission/{request_id}/reply\",\n                    {\"decision\": \"reject\"},\n                    timeout=0.25,\n                )\n                if st not in (200, 204):\n                    raise ServeSecurityError(f\"permission reply HTTP {st}\")\n                st2, _b2 = _ctrl_http(\n                    \"POST\",\n                    f\"/api/session/{session_id}/interrupt\",\n                    None,\n                    timeout=0.25,\n                )\n                if st2 not in (200, 204):\n                    raise ServeSecurityError(f\"permission interrupt HTTP {st2}\")\n                continue\n            if result[\"step_closed\"] and etype in (\"reasoning\", \"text\"):\n                continue\n            if etype == \"reasoning\":\n                text_value = str(payload.get(\"reasoning_content\") or \"\")\n                if text_value.strip():\n                    if result[\"first_token_at\"] is None:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"reasonings\"].append(text_value)\n                    last_token_at = time.monotonic()\n                    on_reasoning(text_value)\n            elif etype == \"text\":\n                text_value = str(payload.get(\"content\") or \"\")\n                if text_value.strip():\n                    if result[\"first_token_at\"] is None:\n                        result[\"first_token_at\"] = time.monotonic()\n                        result[\"ttft_ms\"] = int(\n                            ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n                        )\n                    result[\"texts\"].append(text_value)\n                    last_token_at = time.monotonic()\n                    on_text(text_value)\n            elif etype == \"tool_event\":\n                tool_state.feed(payload)\n                call_id = str(payload.get(\"id\") or \"\")\n                if etype_raw in (\n                    \"session.tool.called\",\n                    \"session.tool.failed\",\n                    \"session.tool.success\",\n                ):\n                    done = tool_state.complete(call_id)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n                        if result[\"first_token_at\"] is None:\n                            result[\"first_token_at\"] = time.monotonic()\n            elif etype == \"step_finish\":\n                step_key = str(\n                    _as_dict(payload).get(\"assistantMessageID\")\n                    or data_raw.get(\"assistantMessageID\")\n                    or \"\"\n                )\n                if step_key and step_key in seen_steps:\n                    continue\n                if step_key:\n                    seen_steps.add(step_key)\n                # payload шага после _map не несёт assistantMessageID: ключ из data_raw выше.\n                for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                    result[\"usage\"][key] = result[\"usage\"].get(key, 0) + _as_int(\n                        payload.get(key)\n                    )\n                # Завершить native вызовы без called: аргументы из input.ended.text.\n                for call_id in list(tool_state.tools):\n                    done = tool_state.complete(call_id)\n                    if done is not None:\n                        result[\"native_calls\"].append(done[1])\n                        on_tool(done[1])\n            elif etype == \"error\":\n                result[\"error\"] = payload\n                result[\"terminal\"] = \"failed\"\n                break\n            elif etype_raw == \"session.execution.succeeded\":\n                result[\"terminal\"] = \"succeeded\"\n                break\n        return result\n    finally:\n        if session_id:\n            try:\n                _ = _ctrl_http(\n                    \"POST\",\n                    f\"/api/session/{session_id}/interrupt\",\n                    None,\n                    timeout=0.25,\n                )\n            except (OSError, http.client.HTTPException):\n                pass\n            try:\n                _ = _ctrl_http(\n                    \"DELETE\",\n                    f\"/api/session/{session_id}\",\n                    None,\n                    timeout=0.25,\n                )\n            except (OSError, http.client.HTTPException):\n                pass\n        if control_conn[0] is not None:\n            try:\n                control_conn[0].close()\n            except OSError:\n                pass\n            control_conn[0] = None\n        if sse_conn is not None:\n            try:\n                sse_conn.close()\n            except OSError:\n                pass\n        lease.cleanup()\n\n\ndef _new_exit_state() -> dict[str, Any]:\n            == \"serve\"\n        )\n        current_prompt = prompt\n        serve_attempts = 0\n        unmapped_retries = 0\n        incomplete_retries = 0\n        while True:\n            unmapped_in_attempt.clear()\n            emitted_tools_in_attempt[0] = 0\n            if parser_box[0] is not None:\n                parser_box[0].finish()\n            parser_box[0] = (\n                ToolCallParser(emit_parsed_content, on_parsed_tool)\n                if emulate_tools\n                else None\n            )\n            attempts.note_spawn()\n            serve_attempts += 1\n            try:\n                result = _serve_one_attempt(\n                    model,\n                    current_prompt,\n                    effort,\n                    workdir,\n                    on_reasoning,\n                    on_text,\n                    on_tool,\n                    attempts.deadline - TIMEOUT_S,\n                    is_client_gone=self._client_gone_check,\n                    on_status=on_status,\n                    thinking_enabled=thinking,\n                )\n            except ServeUnavailable as exc:\n                res.serve_health.record_failure()\n                if not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve unavailable: {exc}\"))\n                return True\n            except ServeSecurityError as exc:\n                xs[\"exit_reason\"] = \"provider_fatal\"\n                self._sse_error(_error_payload(f\"serve security failure: {exc}\"))\n                return True\n            xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if parser_box[0] is not None:\n                parser_box[0].finish()\n            if result.get(\"exit_reason\") == \"client_gone\":\n                xs[\"exit_reason\"] = \"client_gone\"\n                return True\n            xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if result.get(\"exit_reason\") in (\n                \"first_event_timeout\",\n                \"first_token_timeout\",\n                \"stall_timeout\",\n                \"invalid_serve_event\",\n            ):\n                reason = str(result[\"exit_reason\"])\n                if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n                    res.serve_health.record_failure()\n                else:\n                    attempts.attempt_done(True, False)\n                if not result.get(\"delivered\") and not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(reason):\n                    on_status(\n                        f\"[мост] Повтор попытки {attempts.total_spawns + 1}/{attempts.max_total}…\\n\"\n                    )\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._sse_error(_error_payload(f\"serve {reason}\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve error: {err.get('message')}\"))\n                return True\n            res.serve_health.record_success()\n            usage_cur = result[\"usage\"]\n            usage_acc = self._serve_stream_usage or {}\n            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                usage_acc[key] = int(usage_acc.get(key) or 0) + int(\n                    usage_cur.get(key) or 0\n                )\n            self._serve_stream_usage = usage_acc\n            if emulate_tools and emitted_tools_in_attempt[0] == 0:\n                if unmapped_in_attempt:\n                    if unmapped_retries < NATIVE_RETRY_LIMIT and attempts.allow_retry(\n                        \"unmapped\"\n                    ):\n                        unmapped_retries += 1\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _unavailable_tools_prompt(\n                                current_prompt,\n                                \"\".join(result[\"texts\"]),\n                                unmapped_in_attempt,\n                                tools or [],\n                                model,\n                            ),\n                            model,\n                        )\n                        continue\n                    emit_content(\n                        f\"\\n\\n[opencode-zen-bridge: модель вызывала недоступный встроенный инструмент ({', '.join(unmapped_in_attempt)}); повторы исчерпаны]\"\n                    )\n                    return True\n                signal = _incomplete_step_signal(\n                    \"\".join(result[\"texts\"]),\n                    \"\".join(result[\"reasonings\"]),\n                    tools or [],\n                    False,\n                    int(usage_cur.get(\"output\") or 0),\n                    int(usage_cur.get(\"reasoning\") or 0),\n                    tool_choice=None,\n                )\n                if (\n                    signal\n                    and incomplete_retries < NATIVE_RETRY_LIMIT\n                    and attempts.allow_retry(\"incomplete_step\")\n                ):\n                    incomplete_retries += 1\n                    attempts.signal = signal\n                    current_prompt = _rewrite_tool_tags_for_model(\n                        _incomplete_tool_step_prompt(\n                            prompt, \"\".join(collected_texts), tools or [], None, model\n                        ),\n                        model,\n                    )\n                    continue\n            return True\n\n    def _stream_google_sse(self, model: str, prompt: str, effort: str,\n                if prefix_dedup is not None:\n                    text = prefix_dedup.push(text)\n                    if not text:\n                        return\n                send_text(text)\n\n            dropped_blocks = [0]  # вырезано нераспарсенных блоков вызова (счётчик на запрос)\n\n            def emit_parsed_content(text: str) -> None:\n                # Нераспарсенный блок ToolCallParser отдаёт одним куском: сырой тег не уходит ни в SSE, ни в повтор.\n                cleaned, dropped = _strip_broken_tool_blocks(text)\n                if dropped:\n                    dropped_blocks[0] += dropped\n                    _log(f\"stream dropped {dropped} unparsed tool block(s) from content\")\n                emit_content(cleaned)\n\n            seen_calls: set[str] = set()\n\n            def emit_tool_call(call: dict[str, Any]) -> None:\n                key = _call_key(call[\"name\"], call[\"arguments\"])\n                if key in seen_calls:\n                    _log(f\"stream dropped duplicate tool call {call['name']}\")\n                    return\n                seen_calls.add(key)\n                tc = {\n                    \"index\": len(tool_calls),\n                    \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                    \"type\": \"function\",\n                    \"function\": {\"name\": call[\"name\"],\n                                 \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False)},\n                }\n                tool_calls.append(tc)\n                chunk = format_sse_chunk(resp_id, created, shown_model, {\"tool_calls\": [tc]})\n                self.wfile.write(chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n\n            with _active_lock:\n                _active[run_id] = time.time()\n\n            if _select_transport(res) == \"serve\":\n                xs[\"transport\"] = \"serve\"\n                xs[\"transport_history\"] = [\"serve\"]\n                self._serve_stream_usage = None\n                handled = self._run_serve_stream_attempts(\n                    model,\n                    prompt,\n                    effort,\n                    emulate_tools,\n                    tools,\n                    resp_id,\n                    created,\n                    shown_model,\n                    emit_content,\n                    emit_parsed_content,\n                    emit_tool_call,\n                    attempts,\n                    res,\n                    xs,\n                    collected_texts,\n                )\n                if handled:\n                    if xs.get(\"exit_reason\"):\n                        return\n                    serve_usage = self._serve_stream_usage or {}\n                    for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                        if serve_usage.get(key):\n                            usage[key] = int(usage.get(key) or 0) + serve_usage[key]\n                    full_text_s = \"\".join(collected_texts)\n                    final_s = format_sse_chunk(\n                        resp_id,\n                        created,\n                        shown_model,\n                        {},\n                        finish_reason=\"tool_calls\" if tool_calls else \"stop\",\n                        usage=_build_openai_usage(\n                            int(usage.get(\"input\") or 0) or _estimate_tokens(prompt),\n                            int(usage.get(\"output\") or 0)\n                            or _estimate_tokens(full_text_s),\n                            int(usage.get(\"cached\") or 0),\n                            int(usage.get(\"reasoning\") or 0),\n                        ),\n                    )\n                    _ = self.wfile.write(final_s.encode(\"utf-8\"))\n                    _ = self.wfile.write(b\"data: [DONE]\\n\\n\")\n                    self.wfile.flush()\n                    xs.update(\n                        exit_reason=\"ok\",\n                        tools=len(tool_calls),\n                        out_chars=len(full_text_s),\n                        rc=0,\n                    )\n                    return\n                xs[\"transport\"] = \"run\"\n\n            attempt_prompt = prompt\n            retries = 0  # повторов с новым промптом: встроенный инструмент / незавершённый шаг (для лога)\n            unmapped_retries = 0\n            incomplete_retries = 0\n            fail_retries = 0\n            incomplete_retry = False\n            failure: dict[str, Any] | None = None\n            while True:\n                # 3. Запускается proc (повтор — встроенный инструмент без DSH-двойника,\n                #    незавершённый шаг или транзиторный отказ CLI без вывода) под потолком MAX_TOTAL_SPAWNS\n                if attempts.total_spawns:\n                    _log(f\"stream exec retry={retries} fail_retries={fail_retries} model={model_route} \"\n                         f\"prompt_chars={len(attempt_prompt)} total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n                gate = _StartupGate()\n                gate.acquire()\n                if not res.spawn_limiter.acquire(max_wait_s=min(SPAWN_WAIT_MAX_S, attempts.remaining_s())):\n                    gate.release()\n                    _log(\n                        \"stream spawn skipped: spawn rate limiter wait exceeds the request deadline\"\n                    )\n                    if not collected_texts and not tool_calls:\n                        failure = {\"rc\": -1, \"tail\": \"\", \"timeout\": True}\n                    break\n                try:\n                    # env на каждую попытку: ретрай получает следующий порт пула (чистый IP)\n                    proc = _spawn_with_stdin(\n                        cmd, attempt_prompt, workdir, _run_env(model)\n                    )\n                except OSError as exc:\n                    gate.release()\n                    _log(f\"stream spawn failed: {exc}\")\n                    xs[\"exit_reason\"] = \"spawn_failed\"\n                    self._sse_error(_error_payload(f\"opencode spawn failed: {exc}\"))\n                    return\n                attempts.note_spawn()\n    ) -> bool:\n        \"\"\"JSON через serve; True — ответ отправлен, False — fallback на run.\"\"\"\n        thinking = effort.strip().lower() not in (\"\", \"off\", \"none\")\n        force_serve = (\n            os.environ.get(\"OPENCODE_ZEN_BRIDGE_TRANSPORT\", \"\").strip().lower()\n            == \"serve\"\n        )\n        workdir = DEFAULTWORKDIR\n        workdir.mkdir(parents=True, exist_ok=True)\n        current_prompt = prompt\n        contents: list[str] = []\n        reasonings_all: list[str] = []\n        tool_calls_all: list[dict[str, object]] = []\n        tokens: dict[str, int] = {}\n        unmapped_retries = 0\n        incomplete_retries = 0\n        while True:\n            reasonings: list[str] = []\n            texts: list[str] = []\n            natives: list[dict[str, object]] = []\n            attempts.note_spawn()\n            try:\n                result = _serve_one_attempt(\n                    model,\n                    current_prompt,\n                    effort,\n                    workdir,\n                    reasonings.append,\n                    texts.append,\n                    natives.append,\n                    attempts.deadline - TIMEOUT_S,\n                    on_status=lambda _t: None,\n                    thinking_enabled=thinking,\n                )\n            except ServeUnavailable as exc:\n                res.serve_health.record_failure()\n                if not force_serve:\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._send(502, _error_payload(f\"serve unavailable: {exc}\"))\n                return True\n            except ServeSecurityError as exc:\n                xs[\"exit_reason\"] = \"provider_fatal\"\n                self._send(502, _error_payload(f\"serve security failure: {exc}\"))\n                return True\n            xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if result.get(\"exit_reason\") in (\n                \"first_event_timeout\",\n                \"first_token_timeout\",\n                \"stall_timeout\",\n                \"invalid_serve_event\",\n            ):\n                reason = str(result[\"exit_reason\"])\n                if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n                    res.serve_health.record_failure()\n                else:\n                    attempts.attempt_done(True, False)\n                if not result.get(\"delivered\") and not force_serve:\n                    return False\n                if attempts.allow_retry(reason):\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._send(502, _error_payload(f\"serve {reason}\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._send(502, _error_payload(f\"serve error: {err.get('message')}\"))\n                return True\n            res.serve_health.record_success()\n            reasonings_all.extend(reasonings)\n            content_raw = \"\".join(texts)\n            calls: list[dict[str, object]] = []\n            content = content_raw\n            if emulate_tools and content_raw:\n                parsed_texts: list[str] = []\n                parser_json = ToolCallParser(parsed_texts.append, calls.append)\n        reasonings: list[str] = []\n        tool_calls: list[dict[str, Any]] = []\n        tokens: dict[str, int] = {}\n        attempt_prompt = prompt\n        retries = 0  # повторов с новым промптом: встроенный инструмент / незавершённый шаг (для лога)\n        unmapped_retries = 0\n        incomplete_retries = 0\n        incomplete_retry = False\n        out: dict[str, Any] = {}\n        dropped_blocks = 0  # вырезано нераспарсенных блоков вызова\n        res = self._res()\n        if not self._acquire_slot(res):\n            return\n        attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S,\n                                    use_breaker=not _is_google_direct_model(model))\n        xs[\"attempts\"] = attempts\n        try:\n            if not attempts.begin_attempt():\n                xs[\"exit_reason\"] = \"circuit_open\"\n                self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n                return\n            if not _is_google_direct_model(model) and _select_transport(res) == \"serve\":\n                xs[\"transport\"] = \"serve\"\n                xs[\"transport_history\"] = [\"serve\"]\n                if self._serve_json_serve(\n                    model,\n                    prompt,\n                    effort,\n                    emulate_tools,\n                    tools,\n                    reported_model,\n                    None,\n                    res,\n                    attempts,\n                    xs,\n                ):\n                    return\n                xs[\"transport\"] = \"run\"\n                xs[\"transport_history\"] = [\"serve\", \"run\"]\n            else:\n                xs[\"transport\"] = \"google\" if _is_google_direct_model(model) else \"run\"\n                xs[\"transport_history\"] = [str(xs[\"transport\"])]\n            while True:\n                if retries:\n                    _log(f\"exec retry={retries} ({'incomplete tool step' if incomplete_retry else 'unmapped built-in tool'})\"\n                         f\" total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n                run = Run(model, attempt_prompt, effort, DEFAULTWORKDIR,\n                          tools=(tools or []) if emulate_tools else None, google_input=google_input,\n                          attempts=attempts, resilience=res)\n                try:\n                    out = run.execute()\n                finally:\n                    run.close()\n\n                if out.get(\"state\") in (\"launcher_missing\", \"spawn_failed\", \"client_gone\"):\n                    xs[\"exit_reason\"] = str(out[\"state\"])\n","exit_code":0,"status":"completed"}}
