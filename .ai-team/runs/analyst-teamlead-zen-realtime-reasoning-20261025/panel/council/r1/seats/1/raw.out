           )\n            except ServeUnavailable as exc:\n                res.serve_health.record_failure()\n                if not force_serve:\n                    return False","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5736,"endLine":5785},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-7\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_4","startedAtMs":"1793044752137","completedAtMs":"1793044752204"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044752242}
