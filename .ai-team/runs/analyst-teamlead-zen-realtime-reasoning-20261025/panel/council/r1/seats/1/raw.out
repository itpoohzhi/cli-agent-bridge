eturn \"serve\" if _is_native_opencode_bin(OPENCODE_BIN) else \"run\"\n\n\ndef _map_serve_event(event: dict[str, object]) -> tuple[str, dict[str, object]]:\n    \"\"\"Wire-событие serve v2.1.2 -> канонический кортеж legacy-пути.\"\"\"","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1777,"endLine":1826},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-3\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_0","startedAtMs":"1793044751217","completedAtMs":"1793044751297"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044751339}
