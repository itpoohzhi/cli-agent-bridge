     elif esc in mapping:\n                parts.append(mapping[esc])\n            else:\n                raise ValueError(\"escape\")","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":1635,"endLine":1684},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-b2c83134-de10-4504-bc0b-6395265927ba-12\nfc_9fb0ac0b-7102-95d0-a118-3b7d0c99b907_2","startedAtMs":"1793044826583","completedAtMs":"1793044826654"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-3-fha7","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044826700}
