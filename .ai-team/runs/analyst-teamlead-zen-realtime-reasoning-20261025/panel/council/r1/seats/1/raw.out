{"type":"tool_call","subtype":"completed","call_id":"call-006185a1-27b6-4812-af62-15f88e01049d-4\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_1","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":2577,"limit":120},"result":{"success":{"content":"def _startup_reaper(lease_dir: Path | None = None) -> int:\n    \"\"\"Убрать осиротевшие lease мёртвого родителя при старте моста.\"\"\"\n    target = Path(LEASE_DIR) if lease_dir is None else lease_dir\n    removed = 0\n    try:\n        files = list(target.glob(\"lease-*.json\"))\n    except OSError:\n        return 0\n    for path in files:\n        try:\n            data = _as_dict(_loads_object(path.read_text(\"utf-8\")))\n            parent_pid = _as_int(data.get(\"parent_pid\"))\n            helper_pid = _as_int(data.get(\"helper_pid\"))\n            pgid = _as_int(data.get(\"pgid\"))\n        except (OSError, ValueError, TypeError):\n            continue\n        parent_alive = parent_pid > 0 and _pid_alive(parent_pid)\n        if parent_alive:\n            continue\n        if helper_pid > 0 and pgid == helper_pid and _pid_alive(helper_pid):\n            try:\n                cmd = subprocess.run(\n                    [\"ps\", \"-ww\", \"-o\", \"command=\", \"-p\", str(helper_pid)],\n                    capture_output=True,\n                    text=True,\n                    timeout=2,\n                ).stdout\n            except (OSError, subprocess.SubprocessError):\n                cmd = \"\"\n            if \"--serve-helper\" not in cmd:\n                continue\n            try:\n                os.killpg(pgid, signal.SIGTERM)\n            except OSError:\n                pass\n        try:\n            path.unlink()\n            removed += 1\n        except OSError:\n            pass\n    return removed\n\n\ndef _pid_alive(pid: int) -> bool:\n    \"\"\"Жив ли процесс.\"\"\"\n    try:\n        os.kill(pid, 0)\n        return True\n    except OSError:\n        return False\n\n\nclass _ToolItem(TypedDict):\n    \"\"\"Накопленный native вызов serve.\"\"\"\n\n    name: str\n    text: str\n    input: dict[str, object] | None\n\n\nclass _ServeToolState:\n    \"\"\"Накопление native tool lifecycle serve до полного ввода.\"\"\"\n\n    def __init__(self) -> None:\n        self.tools: dict[str, _ToolItem] = {}\n        self.emitted: set[str] = set()\n\n    def feed(self, data: dict[str, object]) -> None:\n        \"\"\"Запомнить фрагмент native вызова.\"\"\"\n        call_id = str(data.get(\"id\") or \"\")\n        if not call_id:\n            return\n        item = self.tools.setdefault(call_id, {\"name\": \"\", \"text\": \"\", \"input\": None})\n        name = data.get(\"name\")\n        if isinstance(name, str) and name:\n            item[\"name\"] = name\n        text_value = data.get(\"text\")\n        if isinstance(text_value, str):\n            item[\"text\"] = text_value\n        input_value = data.get(\"input\")\n        if isinstance(input_value, dict):\n            item[\"input\"] = _as_dict(input_value)\n\n    def complete(self, call_id: str) -> tuple[str, dict[str, object]] | None:\n        \"\"\"Готовый вызов из called.input или input.ended.text.\"\"\"\n        if call_id in self.emitted:\n            return None\n        item = self.tools.get(call_id)\n        if item is None or not item[\"name\"]:\n            return None\n        args = item[\"input\"]\n        if not isinstance(args, dict):\n            text_value = item[\"text\"]\n            try:\n                parsed: object = json.loads(text_value) if text_value else None\n            except ValueError:\n                return None\n            if not isinstance(parsed, dict):\n                return None\n            args = _as_dict(parsed)\n        self.emitted.add(call_id)\n        return \"tool_use\", {\n            \"part\": {\"tool\": item[\"name\"], \"state\": {\"input\": args, \"status\": \"error\"}},\n            \"call_id\": call_id,\n        }\n\n\ndef _native_call_as_dsh(\n    payload: dict[str, object], tools: list[dict[str, object]] | None\n) -> list[dict[str, object]]:\n    \"\"\"Native serve-вызов в DSH-вызов по имени или известному алиасу.\"\"\"\n    part = _as_dict(payload.get(\"part\"))\n    state = _as_dict(part.get(\"state\"))\n    tool = part.get(\"tool\")\n    if not isinstance(tool, str) or not tool:\n        return []\n    args = _as_dict(state.get(\"input\"))\n    names: list[str] = []\n    for item in tools or []:\n        fn_obj = item.get(\"function\")","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2577,"endLine":2696},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-4\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_1","startedAtMs":"1793044751475","completedAtMs":"1793044751556"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044751609}
{"type":"tool_call","subtype":"started","call_id":"call-006185a1-27b6-4812-af62-15f88e01049d-5\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5120,"limit":180}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-5\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_2","startedAtMs":"1793044751643"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044751693}
{"type":"tool_call","subtype":"completed","call_id":"call-006185a1-27b6-4812-af62-15f88e01049d-5\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_2","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":5120,"limit":180},"result":{"success":{"content":"        launcher = _resolve_launcher()\n        if not os.access(launcher, os.X_OK):\n            xs[\"exit_reason\"] = \"launcher_missing\"\n            self._send(502, {\"error\": {\"message\": f\"opencode launcher not executable: {launcher}\",\n                                       \"type\": \"proxy_error\", \"code\": 502}})\n            return\n\n        res = self._res()\n        if not self._acquire_slot(res):\n            return\n        attempts = _RequestAttempts(res, time.monotonic() + TIMEOUT_S)\n        xs[\"attempts\"] = attempts\n\n        resp_id = f\"chatcmpl-oczen-{uuid.uuid4().hex[:12]}\"\n        created = int(time.time())\n        self.close_connection = True\n\n        workdir = DEFAULTWORKDIR\n        workdir.mkdir(parents=True, exist_ok=True)\n        model_route = _model_route(model)\n\n        cmd, shown = _build_cmd(launcher, model, effort)\n        _log(f\"stream exec model={model_route} {shown} prompt_chars={len(prompt)} cwd={workdir}\")\n\n        proc: subprocess.Popen[str] | None = None\n        feed: _StdoutFeed | None = None\n        gate: _StartupGate | None = None\n        run_id = uuid.uuid4().hex[:8]\n\n        try:\n            if not attempts.begin_attempt():\n                xs[\"exit_reason\"] = \"circuit_open\"\n                self._send(503, {\"error\": {\"message\": \"upstream circuit open\", \"type\": \"overloaded\"}})\n                return\n\n            # 1. Отправляются HTTP-заголовки 200 SSE\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream; charset=utf-8\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"close\")\n            self.send_header(\"X-Accel-Buffering\", \"no\")\n            self.end_headers()\n            xs[\"status\"] = 200\n\n            # 2. Отправляется первый чанк\n            first_chunk = format_sse_chunk(\n                resp_id, created, shown_model, {\"role\": \"assistant\", \"content\": \"\"}\n            )\n            self.wfile.write(first_chunk.encode(\"utf-8\"))\n            self.wfile.flush()\n\n            collected_texts: list[str] = []\n            usage: dict[str, Any] = {}\n            deadline = attempts.deadline\n            tool_calls: list[dict[str, Any]] = []\n\n            # Повтор незавершённого шага: уже отданный клиенту текст (dedup_prefix) подавляется,\n            # расхождение (модель переформулировала) отдаётся целиком — текст не теряется.\n            dedup: list[_PrefixDedup | None] = [None]\n\n            def send_text(text: str) -> None:\n                chunk = format_sse_chunk(resp_id, created, shown_model, {\"content\": text})\n                self.wfile.write(chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n                collected_texts.append(text)  # только реально отданное клиенту\n\n            def emit_content(text: str) -> None:\n                if not text:\n                    return\n                prefix_dedup = dedup[0]\n                if prefix_dedup is not None:\n                    text = prefix_dedup.push(text)\n                    if not text:\n                        return\n                send_text(text)\n\n            dropped_blocks = [0]  # вырезано нераспарсенных блоков вызова (счётчик на запрос)\n\n            def emit_parsed_content(text: str) -> None:\n                # Нераспарсенный блок ToolCallParser отдаёт одним куском: сырой тег не уходит ни в SSE, ни в повтор.\n                cleaned, dropped = _strip_broken_tool_blocks(text)\n                if dropped:\n                    dropped_blocks[0] += dropped\n                    _log(f\"stream dropped {dropped} unparsed tool block(s) from content\")\n                emit_content(cleaned)\n\n            seen_calls: set[str] = set()\n\n            def emit_tool_call(call: dict[str, Any]) -> None:\n                key = _call_key(call[\"name\"], call[\"arguments\"])\n                if key in seen_calls:\n                    _log(f\"stream dropped duplicate tool call {call['name']}\")\n                    return\n                seen_calls.add(key)\n                tc = {\n                    \"index\": len(tool_calls),\n                    \"id\": \"call_\" + uuid.uuid4().hex[:24],\n                    \"type\": \"function\",\n                    \"function\": {\"name\": call[\"name\"],\n                                 \"arguments\": json.dumps(call[\"arguments\"], ensure_ascii=False)},\n                }\n                tool_calls.append(tc)\n                chunk = format_sse_chunk(resp_id, created, shown_model, {\"tool_calls\": [tc]})\n                self.wfile.write(chunk.encode(\"utf-8\"))\n                self.wfile.flush()\n\n            with _active_lock:\n                _active[run_id] = time.time()\n\n            if _select_transport(res) == \"serve\":\n                xs[\"transport\"] = \"serve\"\n                xs[\"transport_history\"] = [\"serve\"]\n                self._serve_stream_usage = None\n                handled = self._run_serve_stream_attempts(\n                    model,\n                    prompt,\n                    effort,\n                    emulate_tools,\n                    tools,\n                    resp_id,\n                    created,\n                    shown_model,\n                    emit_content,\n                    emit_parsed_content,\n                    emit_tool_call,\n                    attempts,\n                    res,\n                    xs,\n                    collected_texts,\n                )\n                if handled:\n                    if xs.get(\"exit_reason\"):\n                        return\n                    serve_usage = self._serve_stream_usage or {}\n                    for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                        if serve_usage.get(key):\n                            usage[key] = int(usage.get(key) or 0) + serve_usage[key]\n                    full_text_s = \"\".join(collected_texts)\n                    final_s = format_sse_chunk(\n                        resp_id,\n                        created,\n                        shown_model,\n                        {},\n                        finish_reason=\"tool_calls\" if tool_calls else \"stop\",\n                        usage=_build_openai_usage(\n                            int(usage.get(\"input\") or 0) or _estimate_tokens(prompt),\n                            int(usage.get(\"output\") or 0)\n                            or _estimate_tokens(full_text_s),\n                            int(usage.get(\"cached\") or 0),\n                            int(usage.get(\"reasoning\") or 0),\n                        ),\n                    )\n                    _ = self.wfile.write(final_s.encode(\"utf-8\"))\n                    _ = self.wfile.write(b\"data: [DONE]\\n\\n\")\n                    self.wfile.flush()\n                    xs.update(\n                        exit_reason=\"ok\",\n                        tools=len(tool_calls),\n                        out_chars=len(full_text_s),\n                        rc=0,\n                    )\n                    return\n                xs[\"transport\"] = \"run\"\n\n            attempt_prompt = prompt\n            retries = 0  # повторов с новым промптом: встроенный инструмент / незавершённый шаг (для лога)\n            unmapped_retries = 0\n            incomplete_retries = 0\n            fail_retries = 0\n            incomplete_retry = False\n            failure: dict[str, Any] | None = None\n            while True:\n                # 3. Запускается proc (повтор — встроенный инструмент без DSH-двойника,\n                #    незавершённый шаг или транзиторный отказ CLI без вывода) под потолком MAX_TOTAL_SPAWNS\n                if attempts.total_spawns:\n                    _log(f\"stream exec retry={retries} fail_retries={fail_retries} model={model_route} \"\n                         f\"prompt_chars={len(attempt_prompt)} total_spawns={attempts.total_spawns}/{attempts.max_total}\")\n                gate = _StartupGate()\n                gate.acquire()\n                if not res.spawn_limiter.acquire(max_wait_s=min(SPAWN_WAIT_MAX_S, attempts.remaining_s())):","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":5120,"endLine":5299},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-5\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_2","startedAtMs":"1793044751643","completedAtMs":"1793044751725"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044751768}
{"type":"tool_call","subtype":"started","call_id":"call-006185a1-27b6-4812-af62-15f88e01049d-6\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":4820,"limit":160}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-6\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_3","startedAtMs":"1793044751811"},"model_call_id":"83eaffa8-544d-4e2a-b603-69b0b69dfa9f-1-sq9r","session_id":"ca9adcc0-f87e-42e4-a020-0dba1429619f","timestamp_ms":1793044751853}
{"type":"tool_call","subtype":"completed","call_id":"call-006185a1-27b6-4812-af62-15f88e01049d-6\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_3","tool_call":{"readToolCall":{"args":{"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","offset":4820,"limit":160},"result":{"success":{"content":"                unmapped_in_attempt.append(str(part.get(\"tool\")))\n            for call in mapped:\n                emitted_tools_in_attempt[0] += 1\n                emit_tool_call(call)\n\n        def on_parsed_tool(call: dict[str, object]) -> None:\n            \"\"\"Вызов из текста модели: учесть в счётчике эмиссии попытки.\"\"\"\n            emitted_tools_in_attempt[0] += 1\n            emit_tool_call(call)\n\n        force_serve = (\n            os.environ.get(\"OPENCODE_ZEN_BRIDGE_TRANSPORT\", \"\").strip().lower()\n            == \"serve\"\n        )\n        current_prompt = prompt\n        serve_attempts = 0\n        unmapped_retries = 0\n        incomplete_retries = 0\n        while True:\n            unmapped_in_attempt.clear()\n            emitted_tools_in_attempt[0] = 0\n            if parser_box[0] is not None:\n                parser_box[0].finish()\n            parser_box[0] = (\n                ToolCallParser(emit_parsed_content, on_parsed_tool)\n                if emulate_tools\n                else None\n            )\n            attempts.note_spawn()\n            serve_attempts += 1\n            try:\n                result = _serve_one_attempt(\n                    model,\n                    current_prompt,\n                    effort,\n                    workdir,\n                    on_reasoning,\n                    on_text,\n                    on_tool,\n                    attempts.deadline - TIMEOUT_S,\n                    is_client_gone=self._client_gone_check,\n                    on_status=on_status,\n                    thinking_enabled=thinking,\n                )\n            except ServeUnavailable as exc:\n                res.serve_health.record_failure()\n                if not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve unavailable: {exc}\"))\n                return True\n            except ServeSecurityError as exc:\n                xs[\"exit_reason\"] = \"provider_fatal\"\n                self._sse_error(_error_payload(f\"serve security failure: {exc}\"))\n                return True\n            xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if parser_box[0] is not None:\n                parser_box[0].finish()\n            if result.get(\"exit_reason\") == \"client_gone\":\n                xs[\"exit_reason\"] = \"client_gone\"\n                return True\n            xs[\"first_event_ms\"] = result[\"first_event_ms\"]\n            xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n            if result.get(\"exit_reason\") in (\n                \"first_event_timeout\",\n                \"first_token_timeout\",\n                \"stall_timeout\",\n                \"invalid_serve_event\",\n            ):\n                reason = str(result[\"exit_reason\"])\n                if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n                    res.serve_health.record_failure()\n                else:\n                    attempts.attempt_done(True, False)\n                if not result.get(\"delivered\") and not force_serve:\n                    xs[\"transport\"] = \"run\"\n                    xs[\"transport_history\"] = [\"serve\", \"run\"]\n                    return False\n                if attempts.allow_retry(reason):\n                    on_status(\n                        f\"[мост] Повтор попытки {attempts.total_spawns + 1}/{attempts.max_total}…\\n\"\n                    )\n                    continue\n                xs[\"exit_reason\"] = reason\n                self._sse_error(_error_payload(f\"serve {reason}\"))\n                return True\n            if result[\"error\"] is not None:\n                err = result[\"error\"]\n                xs[\"exit_reason\"] = \"upstream_failed\"\n                self._sse_error(_error_payload(f\"serve error: {err.get('message')}\"))\n                return True\n            res.serve_health.record_success()\n            usage_cur = result[\"usage\"]\n            usage_acc = self._serve_stream_usage or {}\n            for key in (\"input\", \"output\", \"cached\", \"reasoning\"):\n                usage_acc[key] = int(usage_acc.get(key) or 0) + int(\n                    usage_cur.get(key) or 0\n                )\n            self._serve_stream_usage = usage_acc\n            if emulate_tools and emitted_tools_in_attempt[0] == 0:\n                if unmapped_in_attempt:\n                    if unmapped_retries < NATIVE_RETRY_LIMIT and attempts.allow_retry(\n                        \"unmapped\"\n                    ):\n                        unmapped_retries += 1\n                        current_prompt = _rewrite_tool_tags_for_model(\n                            _unavailable_tools_prompt(\n                                current_prompt,\n                                \"\".join(result[\"texts\"]),\n                                unmapped_in_attempt,\n                                tools or [],\n                                model,\n                            ),\n                            model,\n                        )\n                        continue\n                    emit_content(\n                        f\"\\n\\n[opencode-zen-bridge: модель вызывала недоступный встроенный инструмент ({', '.join(unmapped_in_attempt)}); повторы исчерпаны]\"\n                    )\n                    return True\n                signal = _incomplete_step_signal(\n                    \"\".join(result[\"texts\"]),\n                    \"\".join(result[\"reasonings\"]),\n                    tools or [],\n                    False,\n                    int(usage_cur.get(\"output\") or 0),\n                    int(usage_cur.get(\"reasoning\") or 0),\n                    tool_choice=None,\n                )\n                if (\n                    signal\n                    and incomplete_retries < NATIVE_RETRY_LIMIT\n                    and attempts.allow_retry(\"incomplete_step\")\n                ):\n                    incomplete_retries += 1\n                    attempts.signal = signal\n                    current_prompt = _rewrite_tool_tags_for_model(\n                        _incomplete_tool_step_prompt(\n                            prompt, \"\".join(collected_texts), tools or [], None, model\n                        ),\n                        model,\n                    )\n                    continue\n            return True\n\n    def _stream_google_sse(self, model: str, prompt: str, effort: str,\n                           emulate_tools: bool = False,\n                           google_input: GoogleInput | None = None) -> None:\n        \"\"\"Перевести Google SSE в OpenAI SSE, сохранив эмуляцию инструментов.\"\"\"\n        res = self._res()\n        if not self._acquire_slot(res):\n            return\n        conn = None\n        started = False\n        run_id = uuid.uuid4().hex[:8]\n        with _active_lock:\n            _active[run_id] = time.time()","isEmpty":false,"exceededLimit":false,"totalLines":6288,"fileSize":285650,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":4820,"endLine":4979},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-006185a1-27b6-4812-af62-15f88e01049d-6\nfc_86e12d1f-f4e7-9bc7-8c18-5210247eb4fc_3","startedAtMs":"1793044751811","completedAtMs":"179