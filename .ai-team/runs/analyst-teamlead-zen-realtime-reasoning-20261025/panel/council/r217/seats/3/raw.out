 или смене\n462:   архитектуры.\n463: \n464: ### R2-дебаты и early-exit\n465: \nSERVER_SHA256 54c607d7d346bf79c29104de4cfcaa4712b9ec8fb638dbdae1a4adf530e19b88\nSERVER 3286 3305\n3286:     state = _as_dict(part.get(\"state\"))\n3287:     tool = part.get(\"tool\")\n3288:     if not isinstance(tool, str) or not tool:\n3289:         return []\n3290:     args = _as_dict(state.get(\"input\"))\n3291:     return _native_to_tool_calls(tool, args, list(tools or []))\n3292: \n3293: \n3294: def _open_serve_events(\n3295:     port: int,\n3296:     password: str,\n3297:     deadline: float,\n3298:     is_client_gone: Callable[[], bool] | None,\n3299: ) -> tuple[http.client.HTTPConnection, http.client.HTTPResponse]:\n3300:     \"\"\"Открыть подписку с общим дедлайном, прерывая даже капающие заголовки.\"\"\"\n3301:     _check_serve_start(deadline, is_client_gone)\n3302:     sub_deadline = min(deadline, time.monotonic() + float(FIRST_EVENT_TIMEOUT_S))\n3303:     conn = http.client.HTTPConnection(\n3304:         \"127.0.0.1\",\n3305:         port,\nSERVER 3745 3765\n3745:         result,\n3746:         on_tool,\n3747:         release_event,\n3748:         pending_calls=pending_calls,\n3749:         ctrl_http=ctrl_http,\n3750:         reasoning_cb=reasoning_cb,\n3751:         text_cb=text_cb,\n3752:         emulate_tools=emulate_tools,\n3753:         accumulated_bytes=accumulated_bytes,\n3754:         t0=t0,\n3755:     )\n3756:     if result[\"error\"] is not None:\n3757:         return False\n3758:     if not step_confirmed:\n3759:         raise ServeProtocolError(\"incomplete tool step without step.ended\")\n3760:     if pending_calls is not None:\n3761:         for call in pending_calls:\n3762:             result[\"native_calls\"].append(call)\n3763:             on_tool(call)\n3764:     result[\"terminal\"] = \"tool_calls\"\n3765:     result[\"step_closed\"] = True\nSERVER 4225 4252\n4225:             if etype_raw == \"form.created\":\n4226:                 form = _as_dict(data_raw.get(\"form\"))\n4227:                 form_session = form.get(\"sessionID\")\n4228:                 form_id = form.get(\"id\")\n4229:                 if form_session == session_id and isinstance(form_id, str) and form_id:\n4230:                     result[\"step_closed\"] = True\n4231:                     st, _b = _ctrl_http(\n4232:                         \"POST\",\n4233:                         f\"/api/session/{session_id}/form/{form_id}/cancel\",\n4234:                         None,\n4235:                         timeout=0.25,\n4236:                     )\n4237:                     if st not in (200, 204):\n4238:                         raise ServeSecurityError(f\"form cancel HTTP {st}\")\n4239:                     st2, _b2 = _ctrl_http(\n4240:                         \"POST\",\n4241:                         f\"/api/session/{session_id}/interrupt\",\n4242:                         None,\n4243:                         timeout=0.25,\n4244:                     )\n4245:                     if st2 not in (200, 204):\n4246:                         raise ServeSecurityError(f\"form interrupt HTTP {st2}\")\n4247:                     result[\"terminal\"] = \"cancelled\"\n4248:                     break\n4249:                 if form_session == session_id:\n4250:                     raise ServeSecurityError(\"form.created without id\")\n4251:                 continue\n4252:             if prompt_status.get(\"security\"):\nSERVER 4280 4310\n4280:                 result[\"first_event_at\"] = time.monotonic()\n4281:                 _finish_prompt_aux(time.monotonic())\n4282:                 result[\"first_event_ms\"] = int(\n4283:                     ((result[\"first_event_at\"] or 0.0) - t0) * 1000\n4284:                 )\n4285:             if etype == \"permission\":\n4286:                 result[\"step_closed\"] = True\n4287:                 request_id = str(payload.get(\"id\") or \"\")\n4288:                 st, _b = _ctrl_http(\n4289:                     \"POST\",\n4290:                     f\"/api/session/{session_id}/permission/{request_id}/reply\",\n4291:                     {\"decision\": \"reject\"},\n4292:                     timeout=0.25,\n4293:                 )\n4294:                 if st not in (200, 204):\n4295:                     raise ServeSecurityError(f\"permission reply HTTP {st}\")\n4296:                 st2, _b2 = _ctrl_http(\n4297:                     \"POST\",\n4298:                     f\"/api/session/{session_id}/interrupt\",\n4299:                     None,\n4300:                     timeout=0.25,\n4301:                 )\n4302:                 if st2 not in (200, 204):\n4303:                     raise ServeSecurityError(f\"permission interrupt HTTP {st2}\")\n4304:                 continue\n4305:             if result[\"step_closed\"] and etype in (\"reasoning\", \"text\"):\n4306:                 continue\n4307:             accumulated_bytes = _serve_accumulated_bytes(\n4308:                 accumulated_bytes, etype, payload, tool_state\n4309:             )\n4310:             if etype == \"reasoning\":\nSERVER 4350 4374\n4350:                             result[\"first_token_at\"] = time.monotonic()\n4351:                             result[\"ttft_ms\"] = int(\n4352:                                 ((result[\"first_token_at\"] or 0.0) - t0) * 1000\n4353:                             )\n4354:                         if emulate_tools:\n4355:                             _acc_box = [accumulated_bytes]\n4356:                             _ = _finish_serve_tool_step(\n4357:                                 events,\n4358:                                 session_id,\n4359:                                 data_raw.get(\"assistantMessageID\")\n4360:                                 or current_step_msg_id\n4361:                                 or None,\n4362:                                 min(deadline, time.monotonic() + _STEP_DRAIN_WINDOW_S),\n4363:                                 tool_state,\n4364:                                 result,\n4365:                                 on_tool,\n4366:                                 _release_event,\n4367:                                 pending_calls=pending_step_calls,\n4368:                                 ctrl_http=_drain_ctrl,\n4369:                                 reasoning_cb=on_reasoning,\n4370:                                 text_cb=on_text,\n4371:                                 emulate_tools=emulate_tools,\n4372:                                 accumulated_bytes=_acc_box,\n4373:                                 t0=t0,\n4374:                             )\nSERVER 4430 4475\n4430:         ):\n4431:             result[\"exit_reason\"] = \"timeout\"\n4432:         result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n4433:         return result\n4434:     except (ServeClientDisconnect, ServeStartupDeadlineExceeded) as exc:\n4435:         result[\"exit_reason\"] = (\n4436:             \"client_gone\" if isinstance(exc, ServeClientDisconnect) else \"timeout\"\n4437:         )\n4438:         result[\"delivered\"] = True\n4439:         return result\n4440:     except (OSError, http.client.HTTPException, ServeProtocolError) as exc:\n4441:         result[\"exit_reason\"] = _serve_attempt_error_reason(\n4442:             exc, attempt_deadline, is_client_gone, _is_delivered()\n4443:         )\n4444:         result[\"delivered\"] = _is_delivered() | (\n4445:             result[\"exit_reason\"] in (\"client_gone\", \"timeout\")\n4446:         )\n4447:         result[\"transient_error\"] = result[\"exit_reason\"] == \"prompt_error\"\n4448:         return result\n4449:     finally:\n4450:         if subscribe_wait_started is not None:\n4451:             aux.debit_elapsed(subscribe_wait_started)\n4452:         result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n4453:         _cleanup_serve_attempt(\n4454:             lease,\n4455:             port,\n4456:             password,\n4457:             session_id,\n4458:             sse_conn,\n4459:             control_conn[0],\n4460:             stop_event,\n4461:             reader_thread,\n4462:             prompt_thread,\n4463:         )\n4464:         result[\"delivered\"] = result[\"delivered\"] | _is_delivered()\n4465: \n4466: \n4467: def _new_exit_state() -> dict[str, Any]:\n4468:     return {\n4469:         \"t0\": time.monotonic(),\n4470:         \"mode\": \"\",\n4471:         \"model\": \"\",\n4472:         \"status\": 0,\n4473:         \"exit_reason\": \"\",\n4474:         \"attempts\": None,\n4475:         \"tools\": 0,\nSERVER 5850 5884\n5850:         \"\"\"\n5851:         owns_attempts = self.attempts is None\n5852:         if self.attempts is None:\n5853:             self.attempts = _RequestAttempts(self.res, time.monotonic() + TIMEOUT_S,\n5854:                                              use_breaker=not _is_google_direct_model(self.model_id))\n5855:         attempts = self.attempts\n5856:         fail_retries = 0\n5857:         try:\n5858:             while True:\n5859:                 out = self._execute_once()\n5860:                 if out.get(\"state\") in (\n5861:                     \"first_event_timeout\",\n5862:                     \"first_token_timeout\",\n5863:                     \"stall_timeout\",\n5864:                 ):\n5865:                     if attempts.can_spawn() and attempts.allow_retry(\n5866:                         str(out.get(\"state\"))\n5867:                     ):\n5868:                         self.close()\n5869:                         continue\n5870:                     return out\n5871:                 if fail_retries >= FAIL_RETRY_LIMIT or not _is_retryable_failure(\n5872:                         out.get(\"rc\"), str(out.get(\"err\") or \"\"), out.get(\"provider_status\"),\n5873:                         bool(out.get(\"had_output\"))):\n5874:                     return out\n5875:                 if not attempts.allow_retry(\"cli_failure\", charge_budget=out.get(\"provider_status\") is not None):\n5876:                     return out\n5877:                 fail_retries += 1\n5878:                 _log(f\"exec failed rc={out.get('rc')} without output, retry {fail_retries}/{FAIL_RETRY_LIMIT} \"\n5879:                      f\"total_spawns={attempts.total_spawns}/{attempts.max_total}: \"\n5880:                      f\"{_clean_err(str(out.get('err') or ''), 300)!r}\")\n5881:                 self.close()\n5882:         finally:\n5883:             if owns_attempts:\n5884:                 attempts.commit()\nSERVER 8060 8135\n8060:                 xs[\"ttft_ms\"] = result[\"ttft_ms\"]\n8061:             if result.get(\"exit_reason\") == \"client_gone\":\n8062:                 attempts.attempt_done(False, False)\n8063:                 xs[\"exit_reason\"] = \"client_gone\"\n8064:                 return True\n8065:             if result.get(\"exit_reason\") == \"timeout\":\n8066:                 attempts.attempt_done(False, False)\n8067:                 xs[\"exit_reason\"] = \"timeout\"\n8068:                 self._send(502, _error_payload(\"opencode timeout\"))\n8069:                 return True\n8070:             # Токены неуспешных попыток тоже учитываются (как в потоковом пути).\n8071:             for _tk in (\"input\", \"output\", \"cached\", \"reasoning\"):\n8072:                 tokens[_tk] = tokens.get(_tk, 0) + int(result[\"usage\"].get(_tk) or 0)\n8073:             _delivered_j = bool(\n8074:                 delivered_any\n8075:                 or contents\n8076:                 or reasonings_all\n8077:                 or tool_calls_all\n8078:                 or texts\n8079:                 or reasonings\n8080:                 or natives\n8081:                 or result.get(\"delivered\")\n8082:             )\n8083:             delivered_any = _delivered_j\n8084:             if result.get(\"exit_reason\") in (\n8085:                 \"first_event_timeout\",\n8086:                 \"first_token_timeout\",\n8087:                 \"stall_timeout\",\n8088:                 \"invalid_serve_event\",\n8089:                 \"prompt_error\",\n8090:                 \"eof_before_step_finish\",\n8091:             ):\n8092:                 reason = str(result[\"exit_reason\"])\n8093:                 if reason in (\"first_event_timeout\", \"invalid_serve_event\"):\n8094:                     res.serve_health.record_failure()\n8095:                 else:\n8096:                     attempts.attempt_done(True, False)\n8097:                 if not _delivered_j and not force_serve:\n8098:                     return False\n8099:                 if attempts.allow_retry(reason):\n8100:                     continue\n8101:                 xs[\"exit_reason\"] = reason\n8102:                 self._send(502, _error_payload(f\"serve {reason}\"))\n8103:                 return True\n8104:             if result.get(\"prompt_status\") is not None:\n8105:                 _ps_j = int(result[\"prompt_status\"] or 0)\n8106:                 if _ps_j == 429 or 500 <= _ps_j <= 599:\n8107:                     attempts.attempt_done(True, False)\n8108:                 if not _delivered_j and not force_serve:\n8109:                     return False\n8110:                 if attempts.allow_retry(f\"prompt_status_{_ps_j}\"):\n8111:                     continue\n8112:                 xs[\"exit_reason\"] = f\"prompt_status_{_ps_j}\"\n8113:                 self._send(502, _error_payload(f\"serve prompt HTTP {_ps_j}\"))\n8114:                 return True\n8115:             if result[\"error\"] is not None:\n8116:                 err = result[\"error\"]\n8117:                 if result.get(\"transient_error\"):\n8118:                     attempts.attempt_done(True, False)\n8119:                     partial_content = \"\".join(texts)\n8120:                     if emulate_tools and partial_content:\n8121:                         partial_texts: list[str] = []\n8122:                         partial_calls: list[dict[str, object]] = []\n8123:                         partial_parser = ToolCallParser(\n8124:                             partial_texts.append, partial_calls.append\n8125:                         )\n8126:                         partial_parser.feed(partial_content)\n8127:                         partial_parser.finish()\n8128:                         partial_content, _partial_dropped = _strip_broken_tool_blocks(\n8129:                             \"\".join(partial_texts)\n8130:                         )\n8131:                     if _prior_content:\n8132:                         partial_content = _dedup_retry_text(\n8133:                             _prior_content, partial_content\n8134:                         )\n8135:                     if partial_content:\nSERVER 8174 8194\n8174:                         f\"serve error: {_clean_err(str(err.get('message') or ''))}\"\n8175:                     ),\n8176:                 )\n8177:                 return True\n8178:             if result.get(\"terminal\") == \"cancelled\":\n8179:                 xs[\"exit_reason\"] = \"cancelled\"\n8180:                 self._send(502, _error_payload(\"serve session cancelled\"))\n8181:                 return True\n8182:             res.serve_health.record_success()\n8183:             attempts.attempt_done(False, True)\n8184:             reasonings_all.extend(reasonings)\n8185:             content_raw = \"\".join(texts)\n8186:             calls: list[dict[str, object]] = []\n8187:             content = content_raw\n8188:             if emulate_tools and content_raw:\n8189:                 parsed_texts: list[str] = []\n8190:                 parser_json = ToolCallParser(parsed_texts.append, calls.append)\n8191:                 parser_json.feed(content_raw)\n8192:                 parser_json.finish()\n8193:                 content = \"\".join(parsed_texts)\n8194:                 content, _dropped = _strip_broken_tool_blocks(content)\nSERVER 8210 8272\n8210:                 part = _as_dict(native.get(\"part\"))\n8211:                 mapped = _native_call_as_dsh(native, tools) if emulate_tools else []\n8212:                 if not mapped and emulate_tools and part.get(\"tool\"):\n8213:                     unmapped.append(str(part.get(\"tool\")))\n8214:                 for call in mapped:\n8215:                     _add_call(call)\n8216:             usage = result[\"usage\"]\n8217:             if not emulate_tools or tool_calls_all:\n8218:                 break\n8219:             if unmapped:\n8220:                 if unmapped_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n8221:                     \"unmapped\"\n8222:                 ):\n8223:                     break\n8224:                 unmapped_retries += 1\n8225:                 _prior_content = \"\\n\\n\".join(c for c in contents if c)\n8226:                 current_prompt = _rewrite_tool_tags_for_model(\n8227:                     _unavailable_tools_prompt(\n8228:                         current_prompt, content_raw, unmapped, tools or [], model\n8229:                     ),\n8230:                     model,\n8231:                 )\n8232:                 continue\n8233:             signal = _incomplete_step_signal(\n8234:                 content_raw,\n8235:                 _strip_interrupted(\"\".join(reasonings))\n8236:                 if content_raw.strip()\n8237:                 else \"\".join(reasonings),\n8238:                 tools or [],\n8239:                 False,\n8240:                 int(usage.get(\"output\") or 0),\n8241:                 int(usage.get(\"reasoning\") or 0),\n8242:                 tool_choice=tool_choice,\n8243:             )\n8244:             if not signal:\n8245:                 break\n8246:             if incomplete_retries >= NATIVE_RETRY_LIMIT or not attempts.allow_retry(\n8247:                 \"incomplete_step\"\n8248:             ):\n8249:                 break\n8250:             incomplete_retries += 1\n8251:             _prior_content = \"\\n\\n\".join(c for c in contents if c)\n8252:             current_prompt = _rewrite_tool_tags_for_model(\n8253:                 _incomplete_tool_step_prompt(\n8254:                     prompt, \"\\n\\n\".join(contents), tools or [], tool_choice, model\n8255:                 ),\n8256:                 model,\n8257:             )\n8258:         content_final = \"\\n\\n\".join(c for c in contents if c)\n8259:         if not content_final and not tool_calls_all:\n8260:             xs[\"exit_reason\"] = \"upstream_failed\"\n8261:             self._send(502, _error_payload(\"serve produced no text\"))\n8262:             return True\n8263:         for i, tc_item in enumerate(tool_calls_all):\n8264:             tc_item[\"index\"] = i\n8265:         msg: dict[str, object] = {\"role\": \"assistant\", \"content\": content_final}\n8266:         if reasonings_all:\n8267:             msg[\"reasoning_content\"] = \"\".join(reasonings_all)\n8268:         finish = \"stop\"\n8269:         if tool_calls_all:\n8270:             msg[\"tool_calls\"] = tool_calls_all\n8271:             finish = \"tool_calls\"\n8272:         if self._client_gone_check():\nSERVER 8510 8535\n8510:                     break\n8511:                 if unmapped:\n8512:                     if (\n8513:                         unmapped_retries >= NATIVE_RETRY_LIMIT\n8514:                         or not attempts.allow_retry(\"unmapped\")\n8515:                     ):\n8516:                         _log(\n8517:                             f\"unmapped built-in tools={unmapped}: retries exhausted ({unmapped_retries})\"\n8518:                         )\n8519:                         contents.append(\n8520:                             f\"[opencode-zen-bridge: модель вызывала недоступный встроенный \"\n8521:                             f\"инструмент ({', '.join(unmapped)}); повторы исчерпаны]\"\n8522:                         )\n8523:                         break\n8524:                     retries += 1\n8525:                     unmapped_retries += 1\n8526:                     incomplete_retry = False\n8527:                     _log(\n8528:                         f\"unmapped built-in tools={unmapped}: re-prompt {unmapped_retries}/{NATIVE_RETRY_LIMIT}\"\n8529:                     )\n8530:                     attempt_prompt = _rewrite_tool_tags_for_model(\n8531:                         _unavailable_tools_prompt(attempt_prompt, out[\"text\"], unmapped, tools or [], model), model)\n8532:                     continue\n8533:                 run_usage = out.get(\"usage\") or {}\n8534:                 signal = (\n8535:                     0\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"PANEL-NONCE: 8fd6a2b18c54d45d\nARTIFACT-SHA256: 1b2f1af3c71f0f56d62d0b42049fe3c03d1f41ab2bd9615a979d3a7ba2d4652f\n\nОбщий канон `~/Мой диск/Context/AGENTS.md` прочитан целиком до `<!-- КАНОН-КОНЕЦ -->` в предоставленном тексте. В корне репозитория проверено отсутствие `AGENTS.md`, `.agents/AGENTS.md`, `CLAUDE.md`. SHA-256 прочитанного `server.py` совпадает с кандидатом. Тесты не запускались.\n\nAMEND F-001 — priority=blocking; locations=bridges/opencode-zen-bridge/server.py:4231,bridges/opencode-zen-bridge/server.py:4239,bridges/opencode-zen-bridge/server.py:4288,bridges/opencode-zen-bridge/server.py:4296,bridges/opencode-zen-bridge/server.py:4440,bridges/opencode-zen-bridge/server.py:4447; fix=переводить сетевые отказы reject/cancel/interrupt в терминальный ServeSecurityError, сохранив cleanup и отдельную классификацию client_gone/deadline. ARG: skeptic/D1 «дефекты в изменённом задачей файле остаются blocking». Проверил: управляющие вызовы на перечисленных строках не перехватывают сетевые исключения; общий обработчик устанавливает повторяемый `prompt_error`. Cleanup останавливает группу, но не устраняет нарушение политики fail-closed. Прочитанный `council.md:456–459` прямо требует blocking для пропущенного дефекта в изменённом файле задачи; прежняя ссылка на строки 452–455 применяла исключение для кода вне скоупа.\n\nAMEND F-002 — priority=blocking; locations=bridges/opencode-zen-bridge/server.py:5868,bridges/opencode-zen-bridge/server.py:5869,bridges/opencode-zen-bridge/server.py:8099,bridges/opencode-zen-bridge/server.py:8100,bridges/opencode-zen-bridge/server.py:8110,bridges/opencode-zen-bridge/server.py:8111,bridges/opencode-zen-bridge/server.py:8184; fix=сохранять reasoning и нормализованный текст перед JSON-retry, применять предусмотренную prefix-dedup и учитывать usage всех legacy-попыток; неподтверждённые native calls не публиковать. ARG: skeptic/D1 «Serve JSON уже суммирует usage перед этими ветвями; потеря usage относится к внутренним повторам legacy Run.execute». Проверил: serve суммирует usage на `server.py:8071`, однако `continue` предшествует сохранению reasoning/text; `Run.execute` возвращает только последнюю попытку. Уточнение коллеги принимаю, оснований считать потерю данных устранённой нет. Приоритет определяется `council.md:456–459`, а не возрастом дефекта.\n\nAMEND F-003 — priority=blocking; locations=bridges/opencode-zen-bridge/server.py:1581,bridges/opencode-zen-bridge/server.py:3594,bridges/opencode-zen-bridge/server.py:3759,bridges/opencode-zen-bridge/server.py:4362; fix=ожидать step.ended в пределах общего deadline и watchdog паузы, учитывая активность событий и удерживая pending calls до подтверждения. ARG: skeptic/D1 «Это функциональное ограничение полноты, а не предложение архитектурной переделки». Проверил: `server.py:4362` передаёт абсолютный срок `now + 1.0`; поступающие события его не продлевают, отсутствие завершения к этому сроку вызывает ошибку на `:3759`. Активный шаг с calls в моменты 0, 0.3, 0.6, 0.9, 1.2 секунды и step.ended в 1.3 секунды отвергается при исправном потоке. По `council.md:456–459` это blocking в изменённом файле.\n\nAMEND F-004 — priority=blocking; locations=bridges/opencode-zen-bridge/server.py:8219,bridges/opencode-zen-bridge/server.py:8223,bridges/opencode-zen-bridge/server.py:8259,bridges/opencode-zen-bridge/server.py:8261,bridges/opencode-zen-bridge/server.py:8519; fix=при исчерпании unmapped-recovery в serve JSON формировать согласованное legacy-уведомление и finish_reason=stop, сохраняя общий бюджет запусков. ARG: skeptic/D1 «Эквивалентность AC-017 на этой ветви нарушена». Проверил: serve выполняет `break` на `:8223` и при отсутствии текста возвращает 502 на `:8261`; legacy добавляет уведомление на `:8519`. Успешный recovery-тест не проверяет этот исход. Исключение для неизменённых строк не отменяет правило `council.md:456–459` о дефекте в изменённом файле задачи.\n\n1. КОРРЕКТНОСТЬ: VERDICT=FAIL  \n   WHY=RW-001..RW-006 принимаются как исправленные. Однако F-001, F-002 и F-004 подтверждаются актуальным потоком управления: управляющий отказ допускает повтор, JSON-retry теряет частичный результат, unmapped-exhaustion расходится с legacy. Совпадение хеша исключает объяснение устаревшей копией кода.  \n   СОВЕТЫ (при FAIL): выполнить исправления F-001, F-002, F-004; проверить fault injection управляющих вызовов, точные reasoning/text/usage через повтор и сравнительные исходы serve/run × SSE/JSON.\n\n2. ПОЛНОТА: VERDICT=FAIL  \n   WHY=Назначенные шесть исправлений имеют оракулы и подтверждённое исполнение L2. Полнота сложного инструментального шага ограничена F-003; ветви F-002/F-004 не закрываются успешными recovery-сценариями. FU-001 закрыт частично: согласованный F-005 об устаревших именах тестов остаётся non-blocking.  \n   СОВЕТЫ (при FAIL): добавить детерминированный активный шаг длительностью более секунды; проверить EOF, stall и deadline без публикации pending calls; дополнить проверки сохранности JSON-результатов и исчерпания каждого retry-ограничителя; исправить ссылки F-005.\n\n3. РЕАЛИЗУЕМОСТЬ: VERDICT=PASS  \n   WHY=Короткоживущий serve осуществим в заявленном локальном масштабе: stdlib, изолированная БД `:memory:`, bulkhead, ротация прокси и сохранённый run. Стратегическая ценность существенна для отзывчивости — настоящие дельты устраняют ограничение CLI с выдачей в конце шага. Отдельный процесс на попытку ограничивает дальнейший рост нагрузки, но соответствует текущему конверту. Найденные дефекты допускают локальные исправления.\n\n4. РИСКИ: VERDICT=FAIL  \n   WHY=Независимый L2 подтверждает 502 pytest, 502 unittest, обратный порядок, корневой suite и статические проверки; RED AC-026 поведенческий. Эти свидетельства сохраняют силу, но не опровергают F-001..F-003. При усложнении запросов секундное окно создаёт повторные генерации, а JSON теряет полученные данные. VER-006/VER-007 законно DEFERRED_L3 и причиной FAIL не являются.  \n   СОВЕТЫ 