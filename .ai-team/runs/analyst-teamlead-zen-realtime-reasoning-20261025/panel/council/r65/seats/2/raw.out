on=True,\n        ).start()\n        return lease, port, password\n    except BaseException as exc:\n        if lease is not None:\n            lease.cleanup()\n        else:\n            _discard_spawn_leftovers(port, lifeline_w, state_dir)\n        if isinstance(exc, ServeUnavailable):\n            raise\n        if isinstance(exc, (OSError, ValueError, subprocess.SubprocessError)):\n            raise ServeUnavailable(f\"serve spawn os error: {exc}\") from exc\n        raise","isEmpty":false,"exceededLimit":false,"totalLines":7543,"fileSize":331716,"path":"/Users/aazhiry1/tmp/cli-agent-bridge/zen-realtime-reasoning/bridges/opencode-zen-bridge/server.py","readRange":{"startLine":2810,"endLine":2859},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-28d3f5d3-0abe-4289-875f-28fca9be3bca-12\nfc_3dbed85f-05cb-9004-9867-ee816128959b_2","startedAtMs":"1793077186655","completedAtMs":"1793077186712"},"model_call_id":"f6c954e9-8aca-4bcf-b27d-f232502e971c-1-ladq","session_id":"aa8d4c8a-f45d-4857-b1e9-ed834f0f5baa","timestamp_ms":1793077186740}
