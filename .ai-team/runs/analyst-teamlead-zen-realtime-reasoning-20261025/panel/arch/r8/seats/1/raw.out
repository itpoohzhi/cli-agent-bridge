unts)\\n    assert len(warnings(files[0]))<=720, len(warnings(files[0]))\\n    assert len(warnings(files[1]))<=194, len(warnings(files[1]))\\n    # New test file: zero warnings as well as zero errors, thus zero Any.\\n    assert not byfile[files[2]], byfile[files[2]]\\n    for f in files[:2]:\\n        for x in byfile[f]:\\n            line = x['range']['start']['line']+1\\n            if any(lo<=line<=hi for lo,hi in ranges[f]):\\n                assert x.get('rule') not in {'reportAny','reportExplicitAny','reportUnusedCallResult'}, x\\n    # Do not introduce Any annotations/type ignores in added code in either legacy file.\\n    for f in files[:2]:\\n        src = f.read_text().splitlines()\\n        for lo,hi in ranges[f]:\\n            for line in src[lo-1:hi]:\\n                assert not re.search(r'\\\\bAny\\\\b|type:\\\\s*ignore|pyright:\\\\s*ignore|#\\\\s*noqa|#\\\\s*fmt:\\\\s*off',line), (f,line)\\n    print('PASS VER-004: all3 lint/type; legacy changed-range format; newfile whole format; server counts',dict(counts))\\nfinally:\\n    if project is not None: project.unlink(missing_ok=True)\\nVER004\",\n+      \"expected\": \"exit0 only after Stage3. Ruff==0.17.2 full newfile format, legacy changed hunks exclusively --range={start}:1-{end}:999 (closed inclusive syntax). Before and after formatter: reject ANY old/new hunk intersection with raw AST lineno..end_lineno of def _run_env/_stream_google_sse/_execute_google_once, including zero-count deletions/insertions within slices. Literal _run_env sha256=1c51b28fcb83fcc0f4d8b5204c858e11ab5ac975bfe40dca4a0bf61978008e31; both Google functions zero byte diff versus origin/dev and fixed EVD-075 hashes; expected hashes never derived from edited source. All3 full lint/type per existing warning_policy, only inherited exact server E402 if static import remains, no new E402/suppressions. Preserve CATALOG_SOURCE = \\\"static\\\" + typed _set_catalog_source globals helper and importlib.import_module(\\\"zen_catalog\\\")/pr