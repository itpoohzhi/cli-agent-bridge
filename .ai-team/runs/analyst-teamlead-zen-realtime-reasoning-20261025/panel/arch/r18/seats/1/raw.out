tdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=False, close_fds=True, env=serve_env)\",\n      \"validation_contract\": \"args=sys.argv[2:] must have len(args)==6; parse attempt_id, port_text, opencode_bin, lease_dir_text, parent_pid_text, parent_lstart. Before any spawn or state I/O: reject length mismatch; require nonempty attempt_id/opencode_bin/lease_dir_text/parent_lstart, decimal integers port_text/parent_pid_text, 1<=int(port_text)<=65535 and int(parent_pid_text)>0. Convert lease_dir=Path(lease_dir_text) and parent_pid=int(parent_pid_text); use only the passed isolated lease directory. opencode_bin is the parent-resolved str(OPENCODE_BIN) after configuration/in-process monkeypatch, never a module constant read by helper. serve_env is the already sanitized parent environment, copied without OPENCODE_BIN; do not add OPENCODE_BIN or widen any OPENCODE_*/FAKE_* whitelist. Child stdout/stderr PIPEs must be continuously drained/forwarded by the bounded single-thread helper loop to helper stderr; helper stdout remains reserved for handshake, parent keeps exactly two drain lanes per slot. Drain-ready pipes concurrently with fd0 EOF/TERM and child poll, bounded per-tick work, no child pipe wait delaying EOF. Preserve lease/handshake/listener ownership and terminal_quiescence invariants.\",\n      \"entry_isolation\": \"Early isolated dispatcher in server.py: top-level only minimal stdlib imports (json, os, signal, subprocess, sys, time, Path, select/resource as needed; existing typing import retained unchanged for the frozen no-new-Any gate) and typed def _run_serve_helper_cli(args: list[str]) -> int. Immediately afterwards: if sys.argv[1:2] == [\\\"--serve-helper\\\"]: raise SystemExit(_run_serve_helper_cli(sys.argv[2:])); else: import all normal-server-only modules, including http.client, sqlite3, from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer, and after sys.path.insert(0, str(Path(__file__).resolve().parent)), static import zen_catalog as zc. Imports inside else prevent Ruff module-level E402; terminating SystemExit branch makes those names definitely assigned for the normal path in basedpyright1.40.2. No helper execution reaches reload_catalog() (original server.py:163), _DEFAULT_RESILIENCE, main/HTTP startup, LOG_PATH/DYNAMIC_CONFIG_PATH initialization, or any access to state/zen-catalog.json, logs/bridge.log, dynamic_config.json. No importlib transform, inline -c source, new module, suppressions, or frozen-slice changes.\",\n      \"helper_cli_probe_source\": \"def _run_serve_helper_cli(args: list[str]) -> int:\\n    \\\"\\\"\\\"Изолированная архитектурная проба argv/импортов/RSS; не реализация Stage 3.\\\"\\\"\\\"\\n    if len(args) != 6:\\n        return 2\\n    (\\n        attempt_id,\\n        port_text,\\n        opencode_bin,\\n        lease_dir_text,\\n        parent_pid_text,\\n        parent_lstart,\\n    ) = args\\n    if not all((attempt_id, opencode_bin, lease_dir_text, parent_lstart)):\\n        return 2\\n    if not port_text.isdecimal() or not parent_pid_text.isdecimal():\\n        return 2\\n    port, parent_pid = int(port_text), int(parent_pid_text)\\n    if not 1 <= port <= 65535 or parent_pid <= 0:\\n        return 2\\n    lease_dir = Path(lease_dir_text)\\n    if not lease_dir.is_dir():\\n        return 2\\n    forbidden_accesses: list[str] = []\\n\\n    def audit(event: str, values: tuple[object, ...]) -> None:\\n        for value in values:\\n            if isinstance(value, (str, bytes)):\\n                text = str(value)\\n                if any(\\n                    p in text\\n                    for p in (\\\"zen-catalog.json\\\", \\\"bridge.log\\\", \\\"dynamic_config.json\\\")\\n                ):\\n                    forbidden_accesses.append(event + \\\":\\\" + text)\\n                    raise RuntimeError(\\\"forbidden helper path\\\")\\n\\n    sys.addaudithook(audit)\\n    serve_env = dict(os.environ)\\n    proc = subprocess.Popen(\\n        [opencode_bin, \\\"serve\\\", \\\"--hostname\\\", \\\"127.0.0.1\\\", \\\"--port\\\", str(port)],\\n        stdin=subprocess.DEVNULL,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n        start_new_session=False,\\n        close_fds=True,\\n        env=serve_env,\\n    )\\n    print(\\n        json.dumps(\\n            {\\n                \\\"serve_pid\\\": proc.pid,\\n                \\\"pgid\\\": os.getpgrp(),\\n                \\\"helper_pid\\\": os.getpid(),\\n                \\\"parent_pid\\\": parent_pid,\\n                \\\"parent_lstart\\\": parent_lstart,\\n                \\\"attempt_id\\\": attempt_id,\\n                \\\"lease_dir\\\": str(lease_dir),\\n                \\\"loaded_forbidden\\\": [\\n                    n\\n                    for n in (\\\"sqlite3\\\", \\\"http.client\\\", \\\"http.server\\\", \\\"zen_catalog\\\")\\n                    if n in sys.modules\\n                ],\\n                \\\"initialized_forbidden\\\": [\\n                    n\\n                    for n in (\\n                        \\\"reload_catalog\\\",\\n                        \\\"_DEFAULT_RESILIENCE\\\",\\n                        \\\"LOG_PATH\\\",\\n                        \\\"DYNAMIC_CONFIG_PATH\\\",\\n                    )\\n                    if n in globals()\\n                ],\\n                \\\"forbidden_accesses\\\": forbidden_accesses,\\n                \\\"ru_maxrss_bytes\\\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\\n                \\\"python\\\": sys.version,\\n            }\\n        ),\\n        flush=True,\\n    )\\n    try:\\n        while proc.poll() is None:\\n            readable, _, _ = select.select([0], [], [], 0.05)\\n            if readable and not os.read(0, 1):\\n                proc.terminate()\\n                break\\n        child_out, child_err = proc.communicate(timeout=3)\\n        print(\\n            json.dumps(\\n                {\\n                    \\\"child_stdout\\\": child_out.decode() if child_out else \\\"\\\",\\n                    \\\"child_stderr\\\": child_err.decode() if child_err else \\\"\\\",\\n                    \\\"child_returncode\\\": proc.returncode,\\n                    \\\"forbidden_accesses\\\": forbidden_accesses,\\n                    \\\"ru_maxrss_bytes\\\": resource.getrusage(\\n                        resource.RUSAGE_SELF\\n                    ).ru_maxrss,\\n                }\\n            ),\\n            flush=True,\\n        )\\n    finally:\\n        if proc.poll() is None:\\n            proc.kill()\\n            _ = proc.wait(timeout=3)\\n    return 0\\n\",\n      \"candidate_patch_from_origin_dev\": \"diff --git a/bridges/opencode-zen-bridge/server.py b/bridges/opencode-zen-bridge/server.py\\nindex 667b990..f836d59 100755\\n--- a/bridges/opencode-zen-bridge/server.py\\n+++ b/bridges/opencode-zen-bridge/server.py\\n@@ -17,27 +17,143 @@ usage — из события `type:\\\"step_finish\\\"` (part.tokens).\\n \\n from __future__ import annotations\\n \\n-import hmac\\n-import http.client\\n import json\\n import os\\n-import queue\\n-import random\\n-import re\\n-import shlex\\n-import shutil\\n import signal\\n-import sqlite3\\n+import resource\\n+import select\\n import subprocess\\n import sys\\n-import threading\\n import time\\n-import uuid\\n-from collections.abc import Callable, Iterable, Iterator\\n-from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n from pathlib import Path\\n from typing import Any, cast\\n-from urllib.parse import quote, urlsplit\\n+\\n+\\n+def _run_serve_helper_cli(args: list[str]) -> int:\\n+    \\\"\\\"\\\"Изолированная архитектурная проба argv/импортов/RSS; не реализация Stage 3.\\\"\\\"\\\"\\n+    if len(args) != 6:\\n+        return 2\\n+    (\\n+        attempt_id,\\n+        port_text,\\n+        opencode_bin,\\n+        lease_dir_text,\\n+        parent_pid_text,\\n+        parent_lstart,\\n+    ) = args\\n+    if not all((attempt_id, opencode_bin, lease_dir_text,