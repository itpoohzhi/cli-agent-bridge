       ],\\n+                \\\"initialized_forbidden\\\": [\\n+                    n\\n+                    for n in (\\n+                        \\\"reload_catalog\\\",\\n+                        \\\"_DEFAULT_RESILIENCE\\\",\\n+                        \\\"LOG_PATH\\\",\\n+                        \\\"DYNAMIC_CONFIG_PATH\\\",\\n+                    )\\n+                    if n in globals()\\n+                ],\\n+                \\\"forbidden_accesses\\\": forbidden_accesses,\\n+                \\\"ru_maxrss_bytes\\\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\\n+                \\\"python\\\": sys.version,\\n+            }\\n+        ),\\n+        flush=True,\\n+    )\\n+    try:\\n+        while proc.poll() is None:\\n+            readable, _, _ = select.select([0], [], [], 0.05)\\n+            if readable and not os.read(0, 1):\\n+                proc.terminate()\\n+                break\\n+        child_out, child_err = proc.communicate(timeout=3)\\n+        print(\\n+            json.dumps(\\n+                {\\n+                    \\\"child_stdout\\\": child_out.decode() if child_out else \\\"\\\",\\n+                    \\\"child_stderr\\\": child_err.decode() if child_err else \\\"\\\",\\n+                    \\\"child_returncode\\\": proc.returncode,\\n+                    \\\"forbidden_accesses\\\": forbidden_accesses,\\n+                    \\\"ru_maxrss_bytes\\\": resource.getrusage(\\n+                        resource.RUSAGE_SELF\\n+                    ).ru_maxrss,\\n+                }\\n+            ),\\n+            flush=True,\\n+        )\\n+    finally:\\n+        if proc.poll() is None:\\n+            proc.kill()\\n+            _ = proc.wait(timeout=3)\\n+    return 0\\n+\\n+\\n+if sys.argv[1:2] == [\\\"--serve-helper\\\"]:\\n+    raise SystemExit(_run_serve_helper_cli(sys.argv[2:]))\\n+else:\\n+    import hmac\\n+    import queue\\n+    import random\\n+    import re\\n+    import shlex\\n+    import shutil\\n+    import threading\