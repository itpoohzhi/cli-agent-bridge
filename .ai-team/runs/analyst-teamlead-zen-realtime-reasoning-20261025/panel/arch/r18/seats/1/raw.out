argv\\\":sys.argv,\\\"pid\\\":os.getpid(),\\\"pgid\\\":os.getpgrp(),\\\"OPENCODE_BIN_in_env\\\":\\\"OPENCODE_BIN\\\" in os.environ}),flush=True)\\ntime.sleep(30)\\n''');fake.chmod(0o700)\\n    spec=importlib.util.spec_from_file_location('server',bridge/'server.py')\\n    server=importlib.util.module_from_spec(spec);sys.modules['server']=server;spec.loader.exec_module(server)\\n    monkeypatch.setattr(server,'OPENCODE_BIN',str(fake))\\n    assert not (home/'.opencode/bin/opencode').exists()\\n    with socket.socket() as reserve:\\n        reserve.bind(('127.0.0.1',0));port=reserve.getsockname()[1]\\n    parent_lstart=subprocess.check_output(['ps','-p',str(os.getpid()),'-o','lstart='],text=True).strip()\\n    attempt_id='arch6-clean-room-001'\\n    argv=[sys.executable,'-I',str(Path(server.__file__).resolve()),'--serve-helper',attempt_id,str(port),str(server.OPENCODE_BIN),str(lease),str(os.getpid()),parent_lstart]\\n    serve_env={'HOME':str(home),'PATH':'/usr/bin:/bin','TMPDIR':str(W),'LANG':'en_US.UTF-8','PYTHONDONTWRITEBYTECODE':'1','OPENCODE_DB':':memory:'}\\n    lr,lw=os.pipe();p=subprocess.Popen(argv,cwd=W,stdin=lr,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True,close_fds=True,env=serve_env,text=True);os.close(lr)\\n    try:\\n        ready,_,_=select.select([p.stdout],[],[],5);assert ready\\n        line=p.stdout.readline();assert line,(p.poll(),p.stderr.read());first=json.loads(line)\\n        assert not first['loaded_forbidden'] and not first['initialized_forbidden'] and not first['forbidden_accesses']\\n        assert first['parent_pid']==os.getpid() and first['parent_lstart']==parent_lstart\\n        assert os.getpgid(first['serve_pid'])==p.pid==first['pgid']\\n        rss_kib=int(subprocess.check_output(['ps','-p',str(p.pid),'-o','rss='],text=True))\\n        assert rss_kib>0 and p.poll() is None\\n        # Confirm the fake actually owns the requested port before closing lifeline.\\n        deadline=time.monotonic()+3\\n        while 