ализация Stage 3.\\\"\\\"\\\"\\n    if len(args) != 6:\\n        return 2\\n    (\\n        attempt_id,\\n        port_text,\\n        opencode_bin,\\n        lease_dir_text,\\n        parent_pid_text,\\n        parent_lstart,\\n    ) = args\\n    if not all((attempt_id, opencode_bin, lease_dir_text, parent_lstart)):\\n        return 2\\n    if not port_text.isdecimal() or not parent_pid_text.isdecimal():\\n        return 2\\n    port, parent_pid = int(port_text), int(parent_pid_text)\\n    if not 1 <= port <= 65535 or parent_pid <= 0:\\n        return 2\\n    lease_dir = Path(lease_dir_text)\\n    if not lease_dir.is_dir():\\n        return 2\\n    forbidden_accesses: list[str] = []\\n\\n    def audit(event: str, values: tuple[object, ...]) -> None:\\n        for value in values:\\n            if isinstance(value, (str, bytes)):\\n                text = str(value)\\n                if any(\\n                    p in text\\n                    for p in (\\\"zen-catalog.json\\\", \\\"bridge.log\\\", \\\"dynamic_config.json\\\")\\n                ):\\n                    forbidden_accesses.append(event + \\\":\\\" + text)\\n                    raise RuntimeError(\\\"forbidden helper path\\\")\\n\\n    sys.addaudithook(audit)\\n    serve_env = dict(os.environ)\\n    proc = subprocess.Popen(\\n        [opencode_bin, \\\"serve\\\", \\\"--hostname\\\", \\\"127.0.0.1\\\", \\\"--port\\\", str(port)],\\n        stdin=subprocess.DEVNULL,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n        start_new_session=False,\\n        close_fds=True,\\n        env=serve_env,\\n    )\\n    print(\\n        json.dumps(\\n            {\\n                \\\"serve_pid\\\": proc.pid,\\n                \\\"pgid\\\": os.getpgrp(),\\n                \\\"helper_pid\\\": os.getpid(),\\n                \\\"parent_pid\\\": parent_pid,\\n                \\\"parent_lstart\\\": parent_lstart,\\n                \\\"attempt_id\\\": attempt_id,\\n                \\\"lease_dir\\\": str(lease_dir),\\n                \\\"loaded_forbidden\\\": [\\n                    n\\n                    for n in (\\\"sqlite3\\\", \\\"http.client\\\", \\\"http.server\\\", \\\"zen_catalog\\\")\\n                    if n in sys.modules\\n                ],\\n                \\\"initialized_forbidden\\\": [\\n                    n\\n                    for n in (\\n                        \\\"reload_catalog\\\",\\n                        \\\"_DEFAULT_RESILIENCE\\\",\\n                        \\\"LOG_PATH\\\",\\n                        \\\"DYNAMIC_CONFIG_PATH\\\",\\n                    )\\n                    if n in globals()\\n                ],\\n                \\\"forbidden_accesses\\\": forbidden_accesses,\\n                \\\"ru_maxrss_bytes\\\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\\n                \\\"python\\\": sys.version,\\n            }\\n        ),\\n        flush=True,\\n    )\\n    try:\\n        while proc.poll() is None:\\n            readable, _, _ = select.select([0], [], [], 0.05)\\n            if readable and not os.read(0, 1):\\n                proc.terminate()\\n                break\\n        child_out, child_err = proc.communicate(timeout=3)\\n        print(\\n            json.dumps(\\n                {\\n                    \\\"child_stdout\\\": child_out.decode() if child_out else \\\"\\\",\\n                    \\\"child_stderr\\\": child_err.decode() if child_err else \\\"\\\",\\n                    \\\"child_returncode\\\": proc.returncode,\\n                    \\\"forbidden_accesses\\\": forbidden_accesses,\\n                    \\\"ru_maxrss_bytes\\\": resource.getrusage(\\n                        resource.RUSAGE_SELF\\n                    ).ru_maxrss,\\n                }\\n            ),\\n            flush=True,\\n        )\\n    finally:\\n        if proc.poll() is None:\\n            proc.kill()\\n            _ = proc.wait(timeout=3)\\n    return 0\\n\",\n      \"parent_argv_contract\": \"[sys.executable, \