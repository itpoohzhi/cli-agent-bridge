nce — отдельный rollout шаг после clean-room, не требование доступа к ~/.dsh в VER.\",\n      \"status\": \"ASSUMED\",\n      \"evidence_ids\": [\n        \"EVD-034\",\n        \"EVD-058\",\n        \"EVD-059\"\n      ]\n    }\n  ],\n  \"drivers\": [\n    \"RC-1: run CLI буферизует reasoning до ended (F-17/F-18)\",\n    \"RC-2: многоэтапные deadline и очистка вместо 780–856 с тишины\",\n    \"RC-3: DSH видимость по непустому reasoning_content и завершённому абзацу\",\n    \"REQ-002/003: стабильный OpenAI контракт и 17 legacy test modules\",\n    \"REQ-012/013/015: запрет built-ins, per-spawn proxy env rotation (не доказанная Zen IP ротация), безопасные secrets/loopback ownership\"\n  ],\n  \"verification_surface\": [\n    {\n      \"id\": \"VER-001\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-005\",\n        \"REQ-009\",\n        \"REQ-010\",\n        \"REQ-011\",\n        \"REQ-013\",\n        \"REQ-014\",\n        \"REQ-017\",\n        \"REQ-018\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/\",\n      \"expected\": \"exit 0; 0 failed во всех существующих 17 модулях + dedicated suite; 3 baseline tests исправлены, production cap=3\",\n      \"environment\": \"Чистый clone/worktree, cwd=repo_root (кроме явного cd), Python>=3.11, uvx с pytest; ruff=0.17.2/basedpyright=1.40.2 для frozen strict VER-004. Изолированный verifier runner не монтирует home владельца/его ~/.dsh; live-only optional root tests skip. Без изменения HOME в пользовательской сессии, без обращений к production, сети Zen и без rollout. Temp fake CLI/HTTP/workdir создаёт runner в своём sandbox.\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-002\",\n      \"requirement_ids\": [\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-011\",\n        \"REQ-017\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"cd bridges/opencode-zen-bridge && python3 -m unittest discover -s tests -p \\\"test_*.py\\\"\",\n      \"expected\": \"exit 0; 0 failures/errors, запуск из bridge cwd (не из repo root), все новые tests используют unittest.TestCase или stdlib-compatible helper\",\n      \"environment\": \"Чистый clone/worktree, cwd=repo_root (кроме явного cd), Python>=3.11, uvx с pytest; ruff=0.17.2/basedpyright=1.40.2 для frozen strict VER-004. Изолированный verifier runner не монтирует home владельца/его ~/.dsh; live-only optional root tests skip. Без изменения HOME в пользовательской сессии, без обращений к production, сети Zen и без rollout. Temp fake CLI/HTTP/workdir создаёт runner в своём sandbox.\",\n      \"owner\": \"verifier\",\n      \"baseline\": {\n        \"evidence_id\": \"EVD-070\",\n        \"cwd\": \"bridges/opencode-zen-bridge\",\n        \"tests\": 378,\n        \"elapsed_s\": 122.956,\n        \"import_errors\": 0,\n        \"failures\": 3,\n        \"status\": \"BASELINE_RED; target full green after allowed3test fixes\"\n      }\n    },\n    {\n      \"id\": \"VER-003\",\n      \"requirement_ids\": [\n        \"REQ-002\",\n        \"REQ-018\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"PYTHONPATH=. uvx pytest -q -p no:cacheprovider tests/\",\n      \"expected\": \"exit 0; root cross-bridge regression без живых owner ресурсов; environment-specific skips разрешены только унаследованные\",\n      \"environment\": \"Чистый clone/worktree, cwd=repo_root (кроме явного cd), Python>=3.11, uvx с pytest; ruff=0.17.2/basedpyright=1.40.2 для frozen strict VER-004. Изолированный verifier runner не монтирует home владельца/его ~/.dsh; live-only optional root tests skip. Без изменения HOME в пользовательской сессии, без обращений к production, сети Zen и без rollout. Temp fake CLI/HTTP/workdir создаёт runner в своём sandbox.\",\n      \"owner\": \"verifier\"\n    },\n    {\n      \"id\": \"VER-004\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-017\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"python3 - <<'VER004'\\nimport ast, collections, hashlib, json, re, subprocess, tempfile\\nfrom pathlib import Path\\nroot = Path.cwd().resolve()\\nbridge = root / 'bridges/opencode-zen-bridge'\\nfiles = [bridge/'server.py', bridge/'tests/test_step_interruption.py', bridge/'tests/test_realtime_reasoning.py']\\nassert all(f.is_file() for f in files), 'all three target files must exist after Stage3'\\nruff = ['uvx','--from','ruff==0.17.2','ruff']\\ndef run(args, **kw):\\n    return subprocess.run(args, check=True, **kw)\\ndef changed_ranges(file):\\n    rel = str(file.relative_to(root))\\n    diff = subprocess.check_output(['git','diff','--no-ext-diff','--no-color','-U0','origin/dev','--',rel], cwd=root, text=True)\\n    # NEW tracked files must be added before final verification; --no-index alternative below covers untracked newfile.\\n    result = []\\n    for line in diff.splitlines():\\n        m = re.match(r'^@@ -\\\\d+(?:,\\\\d+)? \\\\+(\\\\d+)(?:,(\\\\d+))? @@', line)\\n        if m:\\n            start = int(m.group(1)); count = int(m.group(2) or '1')\\n            if count: result.append((start, start + count - 1))\\n    return result\\n\\n# Raw-byte contract: frozen expected digests originate in EVD-075, never candidate.\\nFROZEN = {\\n    '_run_env': '1c51b28fcb83fcc0f4d8b5204c858e11ab5ac975bfe40dca4a0bf61978008e31',\\n    '_stream_google_sse': '5914c9654c7345692dd55e84cfd3765e27406f63a3df85df30bc798bc1778de3',\\n    '_execute_google_once': '88d794cc42be4878e8ab35b00e4668c427929db2dfd0f2bb4b717a63fd0c70d6',\\n}\\nbaseline_raw = subprocess.check_output(['git','show','origin/dev:bridges/opencode-zen-bridge/server.py'], cwd=root)\\ndef frozen_slices(raw):\\n    lines = raw.splitlines(keepends=True)\\n    nodes = {n.name:n for n in ast.walk(ast.parse(raw)) if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name in FROZEN}\\n    assert set(nodes)==set(FROZEN)\\n    return {name:(node.lineno,node.end_lineno,b''.join(lines[node.lineno-1:node.end_lineno])) for name,node in nodes.items()}\\nbaseline_slices = frozen_slices(baseline_raw)\\ndef assert_frozen(candidate=files[0]):\\n    candidate_slices = frozen_slices(candidate.read_bytes())\\n    for name, expected in FROZEN.items():\\n        assert hashlib.sha256(baseline_slices[name][2]).hexdigest()==expected, ('frozen origin/dev changed',name)\\n        assert hashlib.sha256(candidate_slices[name][2]).hexdigest()==expected, ('immutable slice changed',name)\\n        assert candidate_slices[name][2]==baseline_slices[name][2], ('nonzero raw Google/_run_env diff',name)\\n    return candidate_slices\\ncandidate_slices = assert_frozen()\\nserver_diff = subprocess.check_output(['git','diff','--no-ext-diff','--no-color','-U0','origin/dev','--',str(files[0].relative_to(root))],cwd=root,text=True)\\nfor line in server_diff.splitlines():\\n    match = re.match(r'^@@ -(\\\\d+)(?:,(\\\\d+))? \\\\+(\\\\d+)(?:,(\\\\d+))? @@',line)\\n    if not match: continue\\n    old_start,old_count,new_start,new_count = int(match[1]),int(match[2] or '1'),int(match[3]),int(match[4] or '1')\\n    for start,count,table in [(old_start,old_count,baseline_slices),(new_start,new_count,candidate_slices)]:\\n        for name,(lo,hi,_) in table.items():\\n            # Zero-count insert/delete anchors represent the boundary after start.\\n            overlaps = (start<=hi and start+count-1>=lo) if count else (lo<=start<hi)\\n            assert not overlaps, ('VER-004 frozen-range hunk intersection',name,line)\\n# Public module constant/read API remains intact; compatibility test file is frozen.\\ntree = ast.parse(files[0].read_bytes())\\nassignments = [n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CATALOG_SOURCE' for t in n.targets)]\\nassert len(assignments)==1 and isinstance(assignments[0].value,ast.Constant) and assignments[0].value.value=='static'\\nassert any(isinstance(n,ast.FunctionDef) and n.name=='_set_catalog_source' for n in tree.body)\\nassert any(isinstance(n,ast.Import) and any(a.name=='zen_catalog' and a.asname=='zc' for a in n.names) for n in tree.body)\\nassert not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='import_module' and n.args and isinstance(n.args[0],ast.Constant) and n.args[0].value=='zen_catalog' for n in ast.walk(tree))\\nassert any(isinstance(n,ast.FunctionDef) and n.name=='_run_serve_helper_cli' for n in tree.body), 'helper code must be lint/type checked in server.py'\\nassert '--serve-helper' in files[0].read_text(), 'typed CLI dispatch required before main()'\\nassert not any(isinstance(n,ast.Global) and 'CATALOG_SOURCE' in n.names for n in ast.walk(tree))\\nrun(['git','diff','--exit-code','origin/dev','--','bridges/opencode-zen-bridge/tests/test_catalog_mode.py'],cwd=root)\\n\\nranges = {f: changed_ranges(f) for f in files[:2]}\\n# New file checked as a whole even before git add. Range gate never formats frozen legacy slices.\\nrun([*ruff,'format','--check','--no-cache',str(files[2])], cwd=root)\\nfor f in files[:2]:\\n    for start, end in ranges[f]:\\n        run([*ruff,'format','--check','--no-cache',f'--range={start}:1-{end}:999',str(f)], cwd=root)\\nassert_frozen()\\n# Exercise actual write-mode range formatting only on a disposable copy.\\nwith tempfile.TemporaryDirectory(prefix='zen-arch5-probe-format-', dir='/tmp') as format_dir:\\n    formatted_copy = Path(format_dir) / 'server.py'\\n    formatted_copy.write_bytes(files[0].read_bytes())\\n    for start, end in ranges[files[0]]:\\n        run([*ruff,'format','--no-cache',f'--range={start}:1-{end}:999',str(formatted_copy)], cwd=root)\\n    assert_frozen(formatted_copy)\\n    print('PASS write-mode frozen hashes', {name:hashlib.sha256(data[2]).hexdigest() for name,data in frozen_slices(formatted_copy.read_bytes()).items()})\\n# Full-file lint on all three. Only inherited E402 import site is excepted on server.\\nlint = subprocess.run([*ruff,'check','--no-cache','--output-format','json',str(files[0])], cwd=root, capture_output=True, text=True)\\nassert lint.returncode in (0,1), lint.stderr\\nfindings = json.loads(lint.stdout)\\nlines = files[0].read_text().splitlines()\\nassert all(x['code']=='E402' and lines[x['location']['row']-1].strip()=='import zen_catalog as zc' for x in findings), findings\\nassert sum(x['code']=='E402' for x in findings) <= 1\\nrun([*ruff,'check','--no-cache','--extend-ignore','E402',str(files[0])], cwd=root)\\nrun([*ruff,'check','--no-cache',str(files[1]),str(files[2])], cwd=root)\\n# Exact isolated import-root. No repo pyrightconfig mutation; JSON deleted on every exit.\\nproject = None\\ntry:\\n    with tempfile.NamedTemporaryFile(mode='w',suffix='.json',prefix='zen-ver004-',dir='/tmp',delete=False) as tmp:\\n        project = Path(tmp.name)\\n        json.dump({'include':[str(f) for f in files], 'extraPaths':[str(bridge.resolve())]},tmp)\\n    b = subprocess.run(['uvx','--from','basedpyright==1.40.2','basedpyright','--project',str(project),'--outputjson'], cwd=bridge, capture_output=True, text=True)\\n    assert b.returncode in (0,1), b.stderr\\n    report = json.loads(b.stdout)\\n    ds = report['generalDiagnostics']\\n    assert report['summary']['errorCount']==0 and not [x for x in ds if x['severity']=='error'], ds\\n    byfile = {f: [x for x in ds if Path(x['file']).resolve()==f] for f in files}\\n    limits = {'reportExplicitAny':125,'reportAny':125,'reportUnusedCallResult':39,'reportUnknownMemberType':94,'reportUnknownVariableType':72,'reportUnknownArgumentType':55,'reportUnusedFunction':6,'reportImplicitStringConcatenation':35,'reportUnannotatedClassAttribute':105,'reportUnusedParameter':7,'reportUnnecessaryIsInstance':11,'reportUnknownParameterType':6,'reportMissingParameterType':4,'reportUnreachable':5,'reportImplicitOverride':3}\\n    warnings = lambda f: [x for x in byfile[f] if x['severity']=='warning']\\n    counts = collections.Counter(x.get('rule','') for x in warnings(files[0]))\\n    print('BASEDPYRIGHT summary',report['summary'])\\n    print('SERVER dict(counts)',dict(counts))\\n    print('SERVER warningCount',len(warnings(files[0])))\\n    assert all(n<=limits.get(rule,0) for rule,n in counts.items()), dict(counts)\\n    assert len(warnings(files[0]))<=720, len(warnings(files[0]))\\n    assert len(warnings(files[1]))<=194, len(warnings(files[1]))\\n    # New test file: zero warnings as well as zero errors, thus zero Any.\\n    assert not byfile[files[2]], byfile[files[2]]\\n    for f in files[:2]:\\n        for x in byfile[f]:\\n            line = x['range']['start']['line']+1\\n            if any(lo<=line<=hi for lo,hi in ranges[f]):\\n                assert x.get('rule') not in {'reportAny','reportExplicitAny','reportUnusedCallResult'}, x\\n    # Do not introduce Any annotations/type ignores in added code in either legacy file.\\n    for f in files[:2]:\\n        src = f.read_text().splitlines()\\n        for lo,hi in ranges[f]:\\n            for line in src[lo-1:hi]:\\n                assert not re.search(r'\\\\bAny\\\\b|type:\\\\s*ignore|pyright:\\\\s*ignore|#\\\\s*noqa|#\\\\s*fmt:\\\\s*off',line), (f,line)\\n    run(['python3','-B','-m','unittest','tests.test_catalog_mode','-v'],cwd=bridge)\\n    print('PASS VER-004: all3 lint/type; legacy changed-range format; newfile whole format; server counts',dict(counts))\\nfinally:\\n    if project is not None: project.unlink(missing_ok=True)\\nVER004\",\n      \"expected\": \"exit0 after Stage3 all3. Ruff==0.17.2 newfile whole format and legacy closed --range={start}:1-{end}:999 --check only on candidate; then actual ruff format --no-cache --range={start}:1-{end}:999 for every changed server hunk on tempfile.TemporaryDirectory copy and assert_frozen(formatted_copy). Reject old/new hunks overlapping any frozen function (including zero-count interior insert/delete anchors); literal three raw SHA-256 and zero-byte difference to origin/dev before and after. Expanded-range mutation into any frozen function MUST FAIL literal hash guard (EVD-075). Static import zen_catalog as zc at original server.py:67 retained as sole inherited E402. CATALOG_SOURCE = \\\"static\\\", typed _set_catalog_source(source: str) -> None uses globals()[\\\"CATALOG_SOURCE\\\"], two explicit proc is not None guards before .returncode; full in-module typed helper CLI --serve-helper dispatch before main/HTTP and after imports, no inline source/new module/new E402. All3 full lint/type, errorCount0, printed dict(counts), all(n<=limits.get(rule,0)) with reportAny<=125, existing other/total ceilings unchanged; changed ranges no reportAny/reportExplicitAny/reportUnusedCallResult or new Any/ignores. Catalog8/8 unchanged. EVD-076 server-only:564warnings/errors0/reportAny125; EVD-077 full exact block on local typed CLI skeleton+synthetic newfile observed exit0 (all3warnings726=564+162+0). Future actual Stage3 tests/code/VER-005/H0..H9 NOT_RUN; no evidence inflation.\",\n      \"environment\": \"Чистый clone/worktree, cwd=repo_root (кроме явного cd), Python>=3.11, uvx с pytest; ruff=0.17.2/basedpyright=1.40.2 для frozen strict VER-004. Изолированный verifier runner не монтирует home владельца/его ~/.dsh; live-only optional root tests skip. Без изменения HOME в пользовательской сессии, без обращений к production, сети Zen и без rollout. Temp fake CLI/HTTP/workdir создаёт runner в своём sandbox. Run command from repo_root; invokes basedpyright with cwd=absolute bridge and exact temporary include+extraPaths, never root pyrightconfig. origin/dev must exist locally (no implicit fetch); missing ref is FAIL, not empty-range bypass. Delete temporary project in finally.\",\n      \"owner\": \"verifier\",\n      \"baseline_transition\": {\n        \"old\": \"v2 full-file ruff format changes3216diff lines/frozen hash; root pyright80 errors wrong imports; server564+step162 warnings, server3type errors in isolated config,1E402.\",\n        \"new\": \"All3 target errorCount0. EVD-076 static import zen_catalog as zc preserved at original:67; isolated server-only summary564warnings,reportAny125/ExplicitAny125. Public CATALOG_SOURCE=\\\"static\\\" and typed _set_catalog_source(source: str)->None writes globals()[\\\"CATALOG_SOURCE\\\"]; two proc is not None guards. CLI helper in server.py after imports and __main__ dispatch before main(), zero new E402/Any. EVD-077 full exact block exit0 on real-layout copy with typed helper skeleton and docstring-only newfile (all3warnings726); catalog8/8. Closed Ruff ranges and actual write-mode formatting on temp candidate copy preserve all3 frozen literal hashes; old/new hunk intersections rejected. Existing Any125/per-rule/total720+194 and no suppressions unchanged. This is isolated feasibility, actual Stage3 all3 still NOT_RUN.\",\n        \"owner\": \"Stage3 Coder in exactly three-file allowlist; future independent Verifier runs exact command on actual implementation; architecture EVD-075..078 are isolated feasibility evidence only, no rollout or product changes.\"\n      },\n      \"warning_policy\": {\n        \"baseline\": {\n          \"server_total\": 564,\n          \"step_total\": 162,\n          \"new_test\": \"NOT_PRESENT\"\n        },\n        \"server_total_max\": 720,\n        \"step_total_max\": 194,\n        \"new_test_total_max\": 0,\n        \"new_changed_code\": {\n          \"reportAny\": 0,\n          \"reportExplicitAny\": 0,\n          \"reportUnusedCallResult\": 0\n        },\n        \"rationale\": \"Server nonAny allowance+156 upper total and targeted per-rule ceilings for strict unknown/narrowing/unannotated members; step allowance+32 for isolated fresh resilience assertions. Explicit no-new-Any and no-unused-call-result in changed code; new tests zero diagnostics. Unlisted server rules0. Total cap remains even if per-rule sum greater. This is proposed architecture budget delta for a3, not silently frozen v2 ceiling; no type/lint suppression.\"\n      },\n      \"empirical_evidence_ids\": [\n        \"EVD-075\",\n        \"EVD-076\"\n      ]\n    },\n    {\n      \"id\": \"VER-005\",\n      \"requirement_ids\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-004\",\n        \"REQ-005\",\n        \"REQ-006\",\n        \"REQ-007\",\n        \"REQ-008\",\n        \"REQ-009\",\n        \"REQ-010\",\n        \"REQ-011\",\n        \"REQ-012\",\n        \"REQ-013\",\n        \"REQ-014\",\n        \"REQ-015\",\n        \"REQ-016\",\n        \"REQ-017\",\n        \"REQ-019\",\n        \"REQ-020\"\n      ],\n      \"kind\": \"command\",\n      \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py\",\n      \"expected\": \"exit0, both independent GroupA and GroupB. All prior v2/v3 oracles retained except explicitly superseded isolation/format/warning choices. GroupA no FakeServe; GroupB six frozen fixture families with nested form paths, complete JSON args fallback, reject/cancel+interrupt and zeroStep2; secret sentinels all3env branches; in-memory DB/auth;1lsof then persistent lanes; crash helper+startup reaper; fallback table counter oracle;15s stall heartbeat; 46keys/24gates; immutable raw function hashes; thread/FD/aux math. NOT_RUN Stage2. AC-026 / VER-005 / Clean-Room L2: tests/test_realtime_reasoning.py создаёт tmp_path / \\\"dynamic_config.json\\\" с {\\\"REALTIME_SERVE_ENABLED\\\":true}; monkeypatch.setattr(server, \\\"DYNAMIC_CONFIG_PATH\\\", cfg_path, raising=False). При переносе только этого testfile на непропатченный origin/dev нет AttributeError: реально POST /v1/chat/completions, RED именно на поведенческих realtime chunk intervals (чтение socket до upstream release), GREEN на новом коде. Та же Server instance: атомарно false в cfg_path ->следующий запрос run без restart; true ->serve при test eligibility override/native, deletion/invalid JSON/nonbool/unreadable ->false; unchanged (st_mtime_ns,st_size) ->нет reopen. Новый cfg stat key для переключения обеспечивается и проверяется тестом, без sleep-предположений. Existing378 tests не создают JSON и остаются run. Runtime результаты NOT_RUN. Entire normal Keep-Alive path(permission/form/reply/interrupt/DELETE),including50controls:exactly1 lsof/successful spawn and1retained control TCP. Separate explicit control-socket reconnect scenario permits only2nd lsof<=0.35s outside reply0.25s/cleanupAPI0.20s; spies distinguish the scenarios; urgent control disconnect is fail-closed,never lsof wait.3forced lsof timeouts ->3ServeHealth failures->DEGRADED,nextauto has0serve/helper/lsof Popen. Check listener_pid==serve_pid and pgid==helper_proc.pid; count lifeline2ends during setup/one parent end thereafter,all0afterfinally; parentFD<=128,allprocess344design,55admittedthreads,19systemprocesspeak; probes1/slot. H3 measures actual RSS/FD/thread/ports and rejects excess without raising limits. For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event. Normal p99<=180 goal measured separately; three60s firsttoken faultprofile+aux51.6<=231.6,>=100sample batch nearest-rank criterion. Universal TIMEOUT1800 unchanged. Exact waiting template \\\"[мост] Ожидание первого токена…\\\\n\\\", no (10 с). New topology/form/formatter/type oracles are designed,NOT_RUN until Stage3. RW-001: listener чужой PID в той же/иной группе -> 0 байт Authorization/пароля/prompt и 0 сигналов чужому PGID; точный отрицательный оракул process_resource_oracle.listener_takeover_negative. RW-002: For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event. FU-004: Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\",\n      \"environment\": \"Чистый clone/worktree, cwd=repo_root (кроме явного cd), Python>=3.11, uvx с pytest; ruff=0.17.2/basedpyright=1.40.2 для frozen strict VER-004. Изолированный verifier runner не монтирует home владельца/его ~/.dsh; live-only optional root tests skip. Без изменения HOME в пользовательской сессии, без обращений к production, сети Zen и без rollout. Temp fake CLI/HTTP/workdir создаёт runner в своём sandbox.\",\n      \"owner\": \"verifier\",\n      \"groups\": {\n        \"A\": {\n          \"name\": \"RC-2/RC-3 watchdog & killpg\",\n          \"stage\": \"3a\",\n          \"test_class\": \"TestLegacyWatchdogAndKillpg\",\n          \"command\": \"cd bridges/opencode-zen-bridge && python3 -m unittest tests.test_realtime_reasoning.TestLegacyWatchdogAndKillpg -v\",\n          \"dependencies\": \"FakeCLI only; never instantiate FakeServe; independent legacy supervisor/status/cap3/O-EXIT/baseline errors tests. Stdlib discover executes class.\",\n          \"status\": \"NOT_RUN\"\n        },\n        \"B\": {\n          \"name\": \"Serve transport & FakeServe\",\n          \"stage\": \"3b\",\n          \"test_class\": \"TestServeTransportAndFakeServe\",\n          \"command\": \"cd bridges/opencode-zen-bridge && python3 -m unittest tests.test_realtime_reasoning.TestServeTransportAndFakeServe -v\",\n          \"dependencies\": \"Frozen six-family fixtures; transport/env/listener/crash/fallback/health+normal resource oracles. Group A PASS precondition; failures identify own group immediately. AC-026 / VER-005 / Clean-Room L2: tests/test_realtime_reasoning.py создаёт tmp_path / \\\"dynamic_config.json\\\" с {\\\"REALTIME_SERVE_ENABLED\\\":true}; monkeypatch.setattr(server, \\\"DYNAMIC_CONFIG_PATH\\\", cfg_path, raising=False). При переносе только этого testfile на непропатченный origin/dev нет AttributeError: реально POST /v1/chat/completions, RED именно на поведенческих realtime chunk intervals (чтение socket до upstream release), GREEN на новом коде. Та же Server instance: атомарно false в cfg_path ->следующий запрос run без restart; true ->serve при test eligibility override/native, deletion/invalid JSON/nonbool/unreadable ->false; unchanged (st_mtime_ns,st_size) ->нет reopen. Новый cfg stat key для переключения обеспечивается и проверяется тестом, без sleep-предположений. Existing378 tests не создают JSON и остаются run. Runtime результаты NOT_RUN.\",\n          \"status\": \"NOT_RUN\"\n        }\n      },\n      \"immutable_google_slices\": {\n        \"source\": \"git show origin/dev:bridges/opencode-zen-bridge/server.py\",\n        \"symbols\": [\n          \"_stream_google_sse\",\n          \"_execute_google_once\"\n        ],\n        \"method\": \"ast FunctionDef/AsyncFunctionDef lineno..end_lineno inclusive over raw bytes splitlines(keepends=True), including terminal LF; compare byte-identical with baseline for each function, not AST-equivalence; current frozen _run_env literal digest also mandatory.\",\n        \"sha256\": {\n          \"_stream_google_sse\": \"5914c9654c7345692dd55e84cfd3765e27406f63a3df85df30bc798bc1778de3\",\n          \"_execute_google_once\": \"88d794cc42be4878e8ab35b00e4668c427929db2dfd0f2bb4b717a63fd0c70d6\"\n        },\n        \"verification\": \"VER-004 executable raw-byte/hash+old/new hunk guard also mandatory; EVD-075 proves0byte source diff and three independent negative mutations on temporary copy. Stage3 full gate NOT_RUN.\"\n      },\n      \"orphan_oracles\": \"VER-005 GroupB inject parent SIGKILL (1) immediately after helper Popen before helper entry/lease, (2) immediately after serve Popen before serve_pid publication, (3) after atomic lease before handshake, (4) after handshake before lsof/READY, (5) during prompt. Same helper→serve group; EOF never lost, helper watcher active before READY. Include TERM-ignoring descendant and terminal_quiescence order (all writers stopped ->owned root removal ->lease unlink ->final same-group KILL; no imagined helper finally after self-KILL). Assert listener_pid==serve_pid and pgid==child_pgid,0 owned helper/serve/descendants/lease/temp roots,0 foreign signals/deletions including PID/PGID reuse. Separately kill/disable helper, restart bridge with retained lease ->safe startup reaper; this is recovery scenario, not immediate EOF success.50 normal cancellation cycles return all counters/FD/thread/pipe counts to0; lifeline_w closed every exit. Stage3/H0/H9 remain NOT_RUN.\",\n      \"process_resource_oracle\": {\n        \"topology\": \"One tree only: server.py parent -> helper_proc -> serve_proc; no direct parent Popen(opencode serve). Each attempt spends one common _RequestAttempts token and spawn-rate admission (cap3), paired helper is bounded auxiliary, not a free model attempt. Unified limiter+startup gate deadline<=5.0s; fresh _serve_env(model_id) calls immutable _run_env once and rotates proxy once. Parent reserves127.0.0.1:0 until just before helper spawn; creates lifeline_r,lifeline_w=os.pipe(), close_fds=True. helper_proc=Popen([sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...],stdin=lifeline_r,stdout=PIPE,stderr=PIPE,start_new_session=True,close_fds=True,env=serve_env); child_pgid=helper_proc.pid and os.getpgid(helper_proc.pid)==child_pgid. Parent closes lifeline_r after Popen even on exceptions; lifeline_w never inherited by helper/serve and is closed in parent finally. Helper installs TERM handler and arms EOF monitoring on stdin fd0 BEFORE serve Popen; already-latched EOF causes cleanup without spawn. Helper immediately atomically creates /tmp/opencode-zen-bridge-leases/lease-<attempt_id>.json with helper_pid,helper_lstart,pgid=child_pgid,port,start_ts,parent identity,temp ownership. It launches serve_proc=Popen([OPENCODE_BIN,\\\"serve\\\",\\\"--hostname\\\",\\\"127.0.0.1\\\",\\\"--port\\\",str(port)],stdin=DEVNULL,start_new_session=False,close_fds=True,env=serve_env,stdout=sys.stderr,stderr=sys.stderr). Thus os.getpgid(serve_proc.pid)==child_pgid: helper and serve+descendants share ONE group. Helper atomically/fsync publishes serve_pid and serve_lstart in lease BEFORE stdout handshake JSON {\\\"serve_pid\\\":...,\\\"pgid\\\":...}, before lsof/READY/Auth/prompt. Parent gets exact serve_pid/child_pgid from handshake; port-only identity never sufficient. EOF immediately after either Popen is latched throughout publish/handshake; bounded EOF loop<=0.25s runs before readiness and during prompt. Standard XDG_DATA_HOME/auth preserved, OPENCODE_DB=\\\":memory:\\\" on all3 env branches; sanitized serve_env, no prompt/password in argv/stdin/lease. Port race consumes common token and retries only after full cleanup within original ready<=3s; all lsof/identity probes included. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\",\n        \"resources\": {\n          \"process_tree\": \"Exactly1bridge parent ->at most6 helper_proc ->at most6 serve_proc, each pair same child_pgid=helper_proc.pid; <=6 transient bounded lsof/ps identity probes, at most1/slot (no overlap),peak19 processes including bridge. One model attempt token creates one helper/serve pair; MAX_TOTAL_SPAWNS=3 counts pairs/actual serve launches, never free retries; probes auxiliary bounded and accounted. Serve start_new_session=False, helper=True; no alternate process topology.\",\n          \"parent_threads\": 55,\n          \"thread_formula\": \"Parent admitted bound55=1accept+18handlers(6active+12waiters)+6supervisor/setup+6SSE readers+6prompt delivery workers+12helper stdout/stderr drains+6parent bookkeeping. Helper EOF/TERM/serve poll uses one single-thread main loop per slot, no helper watcher threads;<=6 helper processes. serve logs route to helper stderr, stdout reserved for one handshake; parent still accounts2drains/slot. At most6 auxiliary identity/lsof/ps probes total,1per slot,serial nonoverlap with reconnect/cleanup, executed on existing supervisor/helper loops. Peak system processes1bridge+6helper+6serve+6probe=19. Reaper startup-only, no request overlap. Rejected unadmitted ThreadingHTTPServer handlers may be transient:55 is admitted bound; H3 must measure rejection peaks, not claim arbitrary flood defense.\",\n          \"fd\": {\n            \"parent_baseline\": 36,\n            \"admitted_client_sockets\": 18,\n            \"serve_http_lanes\": 18,\n            \"stdout_stderr_drains\": 12,\n            \"reserved_port_sockets\": 6,\n            \"lsof_capture_pipes\": 6,\n            \"parent_watchdog_pipes\": 6,\n            \"open_lease_files\": 6,\n            \"parent_upper_bound\": 114,\n            \"configured_envelope\": 128,\n            \"aggregate_estimate\": \"Steady parent108 plus transient6lifeline read ends=114<=envelope128. Systemwide conservative128+6serve*20+6helper*8+6probe*8=344descriptors; probe=lsof OR ps identity,at most1/slot,no overlap. Helper per-process8 upper design includes std0/1/2,one transient lease file/atomic temp,DEVNULL/child-launch descriptors and select bookkeeping; measure H3 each process and transient peaks,do not claim aggregate<256.\",\n            \"lifeline_definition\": \"6 parent lifeline_w write ends; transient parent lifeline_r read end closed immediately after Popen. During setup read+write momentarily add<=6FD; terminal no leaks. helper stdin fd0 is lifeline_r, never inherits write end.\",\n            \"transient_lifeline_read_ends\": 6\n          },\n          \"rss\": {\n            \"unit\": \"MiB\",\n            \"serve_idle_observed\": 156.8,\n            \"serve_evidence\": \"EVD-071 owner-supplied idle, not6parallel peak\",\n            \"helper_estimate\": 12.0,\n            \"pair_estimate\": 168.8,\n            \"probe_peak_estimate\": 8.0,\n            \"combined_with_probe_estimate\": 176.8,\n            \"per_slot_ceiling\": 192,\n            \"per_slot_headroom_estimate\": 15.2,\n            \"shared_ceiling\": 1152,\n            \"parent_ceiling\": 256,\n            \"full_design_ceiling\": 1408,\n            \"H3_full_sum_max\": 1638.4,\n            \"status\": \"DESIGN_ESTIMATES; helper/probe and loaded serve NOT_MEASURED; H3 six live slots sums bridge/helper/serve/probe RSS,blocked enable on breach\"\n          },\n          \"cleanup\": \"lifeline_w closed in parent finally; child_pgid covers helper/serve/descendants; helper EOF single-thread and terminal_quiescence as crash_recovery; all resources in H3\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ],\n          \"helper_cli_contract\": \"Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\"\n        },\n        \"C_MULT_I5\": \"Entire normal Keep-Alive path(permission/form/reply/interrupt/DELETE),including50controls:exactly1 lsof/successful spawn and1retained control TCP. Separate explicit control-socket reconnect scenario permits only2nd lsof<=0.35s outside reply0.25s/cleanupAPI0.20s; spies distinguish the scenarios; urgent control disconnect is fail-closed,never lsof wait.3forced lsof timeouts ->3ServeHealth failures->DEGRADED,nextauto has0serve/helper/lsof Popen. Check listener_pid==serve_pid and pgid==helper_proc.pid; count lifeline2ends during setup/one parent end thereafter,all0afterfinally; parentFD<=128,allprocess344design,55admittedthreads,19systemprocesspeak; probes1/slot. H3 measures actual RSS/FD/thread/ports and rejects excess without raising limits.\",\n        \"counter_branches\": \"Normal p99<=180 goal measured separately; three60s firsttoken faultprofile+aux51.6<=231.6,>=100sample batch nearest-rank criterion. Universal TIMEOUT1800 unchanged.\",\n        \"form_cancel\": \"For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event.\",\n        \"status_waiting\": \"[мост] Ожидание первого токена…\\n\",\n        \"listener_takeover_negative\": {\n          \"status\": \"NOT_RUN; frozen future Stage3 oracle\",\n          \"cases\": [\n            \"listener is foreign PID in same child_pgid\",\n            \"listener is foreign PID in different PGID\"\n          ],\n          \"proof_before_auth\": \"listener_pid == serve_pid AND os.getpgid(listener_pid) == child_pgid AND helper_proc.poll() is None; exactly one lsof <=0.35s inside ready<=3.0s\",\n          \"expected\": \"Both cases:0 bytes Authorization/password/prompt and0 signals to foreign PGID; listener_pid!=serve_pid fails closed even when os.getpgid(listener_pid)==child_pgid. Cleanup signals only the confirmed own child_pgid and covers helper+serve+descendants. A different foreign PGID is never signalled; mere same-group membership is never sufficient proof to send credentials.\",\n          \"helper_cli\": \"Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\"\n        }\n      }\n    }\n  ],\n  \"decisions\": [\n    {\n      \"id\": \"AD-001\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как получить настоящие reasoning/text delta и сохранить обратимый legacy-путь?\",\n      \"choice\": \"Option C/A1: один ephemeral serve v2.1.2 на попытку; canonical source для SSE/JSON. В auto run fallback только до HTTP-заголовков ответа POST /prompt И до первого валидного события исполнения текущей сессии; после барьера никакого silent run fallback.\",\n      \"alternatives\": [\n        \"A2: общий daemon экономит холодный старт, но объединяет failure domain и child env; самостоятельная ротация egress внутри georouter не доказана ни для A1, ни для A2 (F-15/F-27).\",\n        \"B: прямой HTTP Zen — меньше ресурсов, но 429 F-24/F-25 и нет подтверждённого client context; не выбирается без PoC.\",\n        \"L: только run watchdog/status — минимален, но не устраняет RC-1.\",\n        \"OPENCODE_DB=:memory: selected (EVD-071120.7ms/156.8MiB/0.db), preserves standard read-only auth.json; empty XDG_DATA_HOME137.9ms/203.5MiB breaks opencode-go auth unless explicitly passed read-only. Shared DB + _StartupGate rejected: shared mutation/locks violate frozen scope; no automatic fallback to that option.\",\n        \"--port 0 + stdout port announcement considered: child picks own port but stable versioned stdout announcement not evidenced; would require new bounded parser/ownership proof. Choose parent-reserved ephemeral port + one lsof + persistent lanes; port race remains fail-closed with cap3.\",\n        \"Two independent deliveries3a then3b considered per analyst§4. Stage3a: RC-2/RC-3 watchdog/status/killpg, baseline tests/O-EXIT/VER004 debt; Stage3b: serve behind selector. Chosen one feature branch and eventual MR to meet owner request «реалтайм размышления... доводи дело до мра», but implementation/verification staged3a→3b and Group A must pass without FakeServe. Separate future MR for3a possible only by owner scope decision; no new delivery promised here.\",\n        \"opencode serve --stdio ([F-30], EVD-078): help confirms flag; observed as internal child IPC of opencode run, but no public external framing/message contract or OpenAPI v2.1.2 mapping is evidenced for it. Treat as undocumented internal CLI IPC, not a verified external SSE API; accepting it would require new framing/flow-control/permission/ownership evidence and parser, not scope justified by this delta. Keep selected Option C/A1 HTTP+SSE: actual reasoning/text deltas and HTTP lifecycle verified [F-17]..[F-22], schemas frozen EVD-062/073. No assertion that merely --stdio is broken; flag availability alone is insufficient.\"\n      ],\n      \"drivers\": [\n        \"REQ-001\",\n        \"REQ-002\",\n        \"REQ-003\",\n        \"REQ-012\",\n        \"REQ-013 / AC-018: per-spawn _next_standalone_proxy/env rotation; loopback georouter bypasses child HTTP_PROXY via NO_PROXY, не гарантия смены Zen egress IP\",\n        \"REQ-014\",\n        \"F-19/F-20: 109 ms server start, 127/114 ms delta medians\"\n      ],\n      \"consequences\": [\n        \"Дополнительные SSE/control sockets и lifecycle; предел активных детей не увеличивается.\",\n        \"run-откат теряет realtime; это видимая деградация, не доказательство REQ-001.\",\n        \"Откат флага/режима без миграций; публичная форма ответов неизменна.\",\n        \"Per-attempt in-memory SQLite via OPENCODE_DB=:memory:, standard XDG_DATA_HOME preserves auth; isolated owned zen-serve-state-* dirs/lease removed after kill/reap. No shared DB opens/writes.\",\n        \"Кодовый дефолт REALTIME_SERVE_ENABLED=false. Локальный runtime dynamic_config.json — stdlib-аналог dynamic_config.py/GigaRC автономного моста без внешних зависимостей: H0 отсутствие файла или boolean false удерживает run; H7 атомарно включает true только после успешных H3 (6 параллельных слотов RSS/FD с OPENCODE_DB=\\\":memory:\\\") и H6 (живая permission/tool изоляция на кандидате). Без исключений из канона или human waiver; без новых env-переменных для самого фичефлага REALTIME_SERVE_ENABLED через dynamic_config.json и без правок start.sh/LaunchAgent; никакой записи dynamic_config.json в git. Новые диагностические/override env-переменные этого пакета: OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED, OPENCODE_ZEN_BRIDGE_TRANSPORT, OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY, OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE и watchdog overrides OPENCODE_ZEN_BRIDGE_FIRST_EVENT_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S (AD-003). Сам рабочий фичефлаг REALTIME_SERVE_ENABLED переключается boolean в dynamic_config.json без новой env для переключения и без правки start.sh/LaunchAgent; кодовый default=false, включение H7 только после H3/H6.\"\n      ],\n      \"approval_required\": false,\n      \"evidence_ids\": [\n        \"EVD-015\",\n        \"EVD-017\",\n        \"EVD-018\",\n        \"EVD-019\",\n        \"EVD-020\",\n        \"EVD-021\",\n        \"EVD-022\",\n        \"EVD-024\",\n        \"EVD-025\",\n        \"EVD-040\",\n        \"EVD-050\",\n        \"EVD-051\",\n        \"EVD-062\",\n        \"EVD-063\",\n        \"EVD-064\",\n        \"EVD-070\",\n        \"EVD-071\",\n        \"EVD-072\",\n        \"EVD-073\",\n        \"EVD-074\",\n        \"EVD-075\",\n        \"EVD-076\",\n        \"EVD-077\",\n        \"EVD-078\"\n      ],\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py\",\n        \"expected\": \"exit 0; dedicated negative/boundary/fake-transport assertions, плюс VER-001/002 green без расширения потолков\"\n      },\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ],\n      \"details\": {\n        \"configuration\": {\n          \"OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED\": {\n            \"default\": false,\n            \"purpose\": \"Новый диагностический env override пакета: явные 0/false/no/off принудительно run; 1/true включают auto serve при native OPENCODE_BIN, не обходя security/disable/health guards. Без override используется boolean REALTIME_SERVE_ENABLED из DYNAMIC_CONFIG_PATH с кодовым default=false. Для рабочего переключения фичефлага env не требуется; start.sh/LaunchAgent заморожены.\"\n          },\n          \"OPENCODE_ZEN_BRIDGE_TRANSPORT\": {\n            \"values\": [\n              \"auto\",\n              \"serve\",\n              \"run\"\n            ],\n            \"default\": \"auto\",\n            \"precedence\": \"1) TRANSPORT=run OR новый диагностический env override OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED в {0,false,no,off} OR disable-serve по OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE OR открытый sticky TTL _ServeHealth ->строго run. Явный env/run guard раньше stat/serve allocations; файл и health до subprocess. 2) TRANSPORT=serve ->serve, даже при кодовом default=false, но не обходит пункт1/security; ошибки явные, без silent run fallback. 3) TRANSPORT=auto ->serve iff runtime boolean REALTIME_SERVE_ENABLED=true (либо env=1/true) AND OPENCODE_BIN подтверждён native opencode (не текстовый #! fake, кроме явного test-only override). Иначе прежний run --format json. Невалидный TRANSPORT ->config error.\"\n          },\n          \"OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY\": {\n            \"values\": [\n              \"ask_reject\",\n              \"deny\"\n            ],\n            \"default\": \"ask_reject\",\n            \"purpose\": \"Одна policy на attempt; ask_reject сохраняет tool schemas, немедленно отвечает decision=reject. deny выбирается env до запуска для отдельного H6, без пересборки. Нет автоматического deny↔ask_reject переключения ни до, ни после prompt; unsupported policy/capability -> fail-closed.\"\n          },\n          \"OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE\": {\n            \"default\": \"~/.dsh/bridges/opencode-zen-bridge/disable-serve\",\n            \"purpose\": \"Путь expanduser/resolve при конфигурации, без создания каталога. На входе нового запроса O(1) os.path.exists(); файл есть -> run без serve UUID/password/queue/thread/Popen/probes. Ошибка проверки пути -> безопасно run с redacted reason. Создание/удаление файла меняет выбор следующего запроса без рестарта; active leases завершаются или явно отменяются, без дублирования текущего prompt.\"\n          },\n          \"SERVE_READY_TIMEOUT_S\": 3.0,\n          \"SERVE_SESSION_SETUP_TIMEOUT_S\": 2.0,\n          \"feature_flag_context\": \"Кодовый дефолт REALTIME_SERVE_ENABLED=false. Локальный runtime dynamic_config.json — stdlib-аналог dynamic_config.py/GigaRC автономного моста без внешних зависимостей: H0 отсутствие файла или boolean false удерживает run; H7 атомарно включает true только после успешных H3 (6 параллельных слотов RSS/FD с OPENCODE_DB=\\\":memory:\\\") и H6 (живая permission/tool изоляция на кандидате). Без исключений из канона или human waiver; без новых env-переменных для самого фичефлага REALTIME_SERVE_ENABLED через dynamic_config.json и без правок start.sh/LaunchAgent; никакой записи dynamic_config.json в git. Новые диагностические/override env-переменные этого пакета: OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED, OPENCODE_ZEN_BRIDGE_TRANSPORT, OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY, OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE и watchdog overrides OPENCODE_ZEN_BRIDGE_FIRST_EVENT_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S (AD-003). Сам рабочий фичефлаг REALTIME_SERVE_ENABLED переключается boolean в dynamic_config.json без новой env для переключения и без правки start.sh/LaunchAgent; кодовый default=false, включение H7 только после H3/H6.\",\n          \"DYNAMIC_CONFIG_PATH\": {\n            \"value\": \"Path(__file__).resolve().parent / \\\"dynamic_config.json\\\"\",\n            \"key\": \"REALTIME_SERVE_ENABLED\",\n            \"type\": \"bool\",\n            \"default\": false,\n            \"reload\": \"На каждый новый запрос os.stat O(1), кэш по (st_mtime_ns, st_size), с учётом identity DYNAMIC_CONFIG_PATH для изолированных тестов. При неизменной паре без переоткрытия/JSON parsing; смена пары перечитывает bounded локальный JSON и публикует boolean snapshot под lock. Удаление, ошибка stat/read, битый JSON, неверный root или небулево значение ->false немедленно, без stale true. Ошибки чтения/валидации дают diagnostic warning без содержимого файла/секретов; повторяющийся warning ограничен, чтение ошибки можно повторить на следующем запросе. Не нужен restart Server/LaunchAgent.\",\n            \"write\": \"Только rollout operator: tempfile в том же каталоге, mode0600, JSON boolean, os.replace атомарно; только после H3/H6 на H7. Локальный production файл ~/.dsh/bridges/opencode-zen-bridge/dynamic_config.json вне git; Architect его не создаёт.\"\n          }\n        },\n        \"auto_fake_compatibility\": \"В git-клоне bridges/opencode-zen-bridge/dynamic_config.json отсутствует и не коммитится; default=false гарантирует прежний run для всех378 fake-CLI baseline tests REQ-003/AC-004, без опоры на shebang/имя теста/FAKE_OC_MODE. При explicit enabled auto дополнительно cached executable path+mtime_ns+size/first bytes: shebang/text ->run без --help/--version/serve subprocess; native opencode ->serve. Явный test-only eligibility override допустим только fixtures; force serve для FakeServe сохраняет первый kill-switch приоритет и stdin=DEVNULL. Explicit env false/run ->zero serve UUID/password/queue/threads/probes/Popen до file stat; default=false selector допускает только O(1) config stat, без serve allocations. При смене executable cache key старые capability/health инвалидируются.\",\n        \"spawn\": \"One tree only: server.py parent -> helper_proc -> serve_proc; no direct parent Popen(opencode serve). Each attempt spends one common _RequestAttempts token and spawn-rate admission (cap3), paired helper is bounded auxiliary, not a free model attempt. Unified limiter+startup gate deadline<=5.0s; fresh _serve_env(model_id) calls immutable _run_env once and rotates proxy once. Parent reserves127.0.0.1:0 until just before helper spawn; creates lifeline_r,lifeline_w=os.pipe(), close_fds=True. helper_proc=Popen([sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...],stdin=lifeline_r,stdout=PIPE,stderr=PIPE,start_new_session=True,close_fds=True,env=serve_env); child_pgid=helper_proc.pid and os.getpgid(helper_proc.pid)==child_pgid. Parent closes lifeline_r after Popen even on exceptions; lifeline_w never inherited by helper/serve and is closed in parent finally. Helper installs TERM handler and arms EOF monitoring on stdin fd0 BEFORE serve Popen; already-latched EOF causes cleanup without spawn. Helper immediately atomically creates /tmp/opencode-zen-bridge-leases/lease-<attempt_id>.json with helper_pid,helper_lstart,pgid=child_pgid,port,start_ts,parent identity,temp ownership. It launches serve_proc=Popen([OPENCODE_BIN,\\\"serve\\\",\\\"--hostname\\\",\\\"127.0.0.1\\\",\\\"--port\\\",str(port)],stdin=DEVNULL,start_new_session=False,close_fds=True,env=serve_env,stdout=sys.stderr,stderr=sys.stderr). Thus os.getpgid(serve_proc.pid)==child_pgid: helper and serve+descendants share ONE group. Helper atomically/fsync publishes serve_pid and serve_lstart in lease BEFORE stdout handshake JSON {\\\"serve_pid\\\":...,\\\"pgid\\\":...}, before lsof/READY/Auth/prompt. Parent gets exact serve_pid/child_pgid from handshake; port-only identity never sufficient. EOF immediately after either Popen is latched throughout publish/handshake; bounded EOF loop<=0.25s runs before readiness and during prompt. Standard XDG_DATA_HOME/auth preserved, OPENCODE_DB=\\\":memory:\\\" on all3 env branches; sanitized serve_env, no prompt/password in argv/stdin/lease. Port race consumes common token and retries only after full cleanup within original ready<=3s; all lsof/identity probes included. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\",\n        \"startup\": \"SERVE_READY_TIMEOUT_S=3.0s (ready_budget_s=3.0): после owner proof лёгкий authenticated GET /api/session/active, HTTP200 + $.data object map of active sessions (empty={}); не качать 281KB /openapi.json на каждом spawn. Control I/O slices<=.25s, всего<=3 readiness TCP probes, remaining request deadline/cancel всегда проверяются. Child EOF/no listener/incompatible protocol -> ServeUnavailable. Пароль secrets per spawn в OPENCODE_SERVER_PASSWORD ПОСЛЕ whitelist, Basic opencode:<password>, никогда в argv/URL/log. stdout/stderr bounded drain+redact. HTTP на loopback напрямую без proxy/redirects. Readiness не устанавливает first_event_ms и не сбрасывает first_event/token часы.\",\n        \"fallback_barrier\": \"State machine: ADMISSION -> SPAWN/OWNER/READY -> CREATE/SUBSCRIBE -> PROMPT_SENDING -> DELIVERED -> TERMINAL -> CLEANUP. Auto ServeUnavailable на старте/create/subscribe или до получения HTTP response headers POST /api/session/{id}/prompt допускает один budgeted run fallback, ТОЛЬКО если не было валидного события исполнения созданной session после начала отправки prompt, нет model/tool output, auth/security failure, cancel или deadline. Перед run полностью close/join/killpg/reap старую attempt, удалить temp data; новый Popen требует тот же retry token/Full Jitter/attempt ceiling<=3. С первого response header POST /prompt (любой status) ИЛИ первого session execution event после prompt delivery лачится DELIVERED=true; silent fallback и переключение на run для текущего запроса запрещены, включая отсутствие response body и headers-pending+SSE-started. Prompt POST исполняется daemon worker параллельно SSE; до header/события ожидание ограничено остатком first_event20s/first_token60s и total deadline. Даже до headers неизвестная доставка может дать повторную генерацию: допустимость этой границы явно задана текущим brief RW-001, это НЕ exactly-once; старый PGID должен быть убран до fallback, built-ins никогда allow. После barrier watchdog может выполнить только явный общий retry того же транспорта с retry-status/cleanup/cap, не скрытый run fallback. HTTP401/403/auth/permission/capability-security denial -> fail-closed без fallback/auto policy switching на любой фазе. Authoritative phase/event/counter table: fallback_decision_table. first_event20 preheader/noevent ->budgeted fallback_to_run; after anyheader ->explicit serve_retry. Error headers latch barrier before HTTP classification.\",\n        \"session_flow\": \"После listener proof/readiness и подтверждения safe permission capability POST /api/session по session_wire.create; затем GET /api/event с HTTP200 text/event-stream и reader armed ДО отправки первого байта тела prompt. На create + subscribe один SERVE_SESSION_SETUP_TIMEOUT_S=2.0s, не включая model generation или ожидание POST /prompt response. Передать полный prompt в JSON body через единственный daemon delivery worker, одновременно читать SSE в owned reader; supervisor/SSE writer не ждут блокирующий POST и остаются cancel-aware. Один POST /prompt с delivery=steer,resume=true; transport HTTP headers/ошибки передаются supervisor как control events. First-event/token часы якорятся на prompt_send_start, не на HTTP ready/создание сессии. Filter data.sessionID==created_sid; реальные v2 события не содержат executionID, поэтому использовать own per-attempt session + prompt-send generation latch, event id дедуп и assistantMessageID step key, не выдумывать executionID. server.connected/session.created/global updates/pre-prompt events не считаются first execution. Terminal success/failed независим от text end; EOF без terminal -> protocol failure. step.ended с готовым DSH tool call -> остановить дальнейшее исполнение/cleanup. Include nested form.created.data.form.sessionID filtering before flat session filter. Mandatory reject/cancel then interrupt single_turn_control; never wait on prompt POST, never stream Step2.\",\n        \"tool_policy\": \"Default OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY=ask_reject: _serve_env(model_id) вызывает _run_env(model_id) ровно один раз, копирует/merge scoped OPENCODE_CONFIG_CONTENT permission={\\\"*\\\":\\\"ask\\\"} с сохранением provider/options/OPENCODE_MODELS_PATH, session permissions=[{action:\\\"*\\\",resource:\\\"*\\\",effect:\\\"ask\\\"}]. _run_env(model_id) оставить ПОБАЙТОВО неизменным, tests/test_run_env.py не менять. На wire permission.asked (логическая группа session.permission.requested) немедленно POST /api/session/{id}/permission/{data.id}/reply {decision:\\\"reject\\\"}; никогда allow/once/always. Reply через bounded control lane, не ожидает completion prompt POST, HTTP budget<=.25s и cancel/deadline; failure -> явный security error+cleanup, без деградации в разрешение. Env=deny выставляет config permission={\\\"*\\\":\\\"deny\\\"} и session effect=deny, без пересборки; если всё же пришёл ask, только reject. Неподдержанная policy/отсутствие safe permission capability -> fail-closed. Нет автоматического deny↔ask_reject switching даже до prompt: разница позиций R1 закрыта явным выбором безопасного селектора. После принятия prompt 401/403 никогда не дают run fallback. EVD-050 + F-08 объясняют Zen403 с deny; FakeServe проверяет оба режима и byte hash _run_env, реальную Zen совместимость/запрещённую запись доказывает только H6. _run_env does NOT sanitize every branch; _serve_env must apply serve_env_sanitization to all3 branches. Mandatory form.created→cancel and reject/cancel→immediate interrupt single_turn_control; JSON args fallback input.ended.data.text when called absent; no second-step output.\",\n        \"event_contract\": {\n          \"shape\": \"Iterator canonical tuples для обоих потребителей; object/TypedDict validation. Public OpenAI unchanged; legacy parser остаётся для run. Полные wire fixtures ниже frozen v2.1.2, metadata id/created synthetic, field paths подтверждены EVD-062/EVD-063.\",\n          \"session.reasoning.delta\": \"$.data.delta -> (reasoning,{reasoning_content:delta}); delta bytes only, ended не повторяет full text. Если native encrypted metadata есть в started/ended, сохранять существующим reasoning_details mapping без повторной text delta.\",\n          \"session.text.delta\": \"$.data.delta -> (text,{content:delta}) -> тот же ToolCallParser.feed/emit_content.\",\n          \"session.step.ended\": \"$.data.tokens input/output/reasoning + $.data.tokens.cache.read -> canonical input/output/reasoning/cached; один учёт по $.data.assistantMessageID, terminal не удваивает usage.\",\n          \"session.tool.*\": \"Actual input.started(name), input.delta, input.ended(text), called(input,executed), progress(metadata), success/failed. Correlate data.sessionID+assistantMessageID+id; accumulate tool name/input, normalize tool_use part{tool,state{input,status}}+call_id. permission.asked отправляет decision=reject немедленно по отдельному control lane. Никакого встроенного allow или выполнения bridge-side. On input.ended save $.data.text and parse JSON as object with runtime validation. Prefer called.data.input if present and valid; if called absent before failed/step.ended use completed input.ended.text, including streaming→failed. Never emit partial JSON; dedup by sessionID/assistantMessageID/call id. Both paths give identical mapped DSH tool_calls. Invalid JSON follows existing incomplete/unmapped recovery, not invented empty args.\",\n          \"session.step.failed / session.execution.failed\": \"$.data.error {type,message,status?,response?,retryAfterMs?} ->canonical error{statusCode,message}: statusCode=$.data.error.status если integer100..599; иначе explicit known type mapping provider.free-limit429/auth401/permission denial403, unknown null. Terminal independent, one cause not counted twice.\",\n          \"session.execution.succeeded\": \"terminal success metadata, не text/reasoning; гарантированно дренировать уже полученный step.ended перед финальным usage.\",\n          \"other\": \"first_event latch только валидный execution/step/reasoning started текущей session после prompt; валидные current-session model delta также доказывают начало исполнения. server.connected, HTTPready, session.created, чужие session/control/comments/status не latch и не model token. form.created session lookup is nested data.form.sessionID; shared flat filter must special-case this valid envelope before discard.\",\n          \"payload_validation\": \"Проверять exact field paths/types и mandatory sessionID до emit. Текущая schema shape mismatch -> invalid_serve_event (не пустая полезная delta), отдельный ServeHealth; permission capability mismatch ->security fail-closed. Incremental UTF8/CRLF/multiline SSE/comments/fragment boundaries, byte budgets как прежде. Никакого Coder-discovered protocol или aliases, которых нет в frozen source. Coder и FakeServe используют frozen expected независимо; мутации delta path/token/permission должны краснить тест даже если adapter и mock согласованно ошибочны. For form.created safety action with nested own sessionID+nonempty id MUST precede other schema validation; see form.created / form.cancelled policy; never delay cancel for missing root title.\",\n          \"frozen_v2_1_2_fixtures\": {\n            \"session.reasoning.delta\": {\n              \"wire\": {\n                \"id\": \"evt_fixture_1\",\n                \"created\": 1792957431001,\n                \"type\": \"session.reasoning.delta\",\n                \"data\": {\n                  \"sessionID\": \"ses_fixture_1\",\n                  \"assistantMessageID\": \"msg_fixture_1\",\n                  \"ordinal\": 0,\n                  \"delta\": \"Мысль без LF\"\n                }\n              },\n              \"field_paths\": {\n                \"session_id\": \"$.data.sessionID\",\n                \"step_key\": \"$.data.assistantMessageID\",\n                \"ordinal\": \"$.data.ordinal\",\n                \"delta\": \"$.data.delta\"\n              },\n              \"canonical\": {\n                \"etype\": \"reasoning\",\n                \"payload\": {\n                  \"reasoning_content\": \"Мысль без LF\"\n                }\n              }\n            },\n            \"session.text.delta\": {\n              \"wire\": {\n                \"id\": \"evt_fixture_2\",\n                \"created\": 1792957431002,\n                \"type\": \"session.text.delta\",\n                \"data\": {\n                  \"sessionID\": \"ses_fixture_1\",\n                  \"assistantMessageID\": \"msg_fixture_1\",\n                  \"ordinal\": 1,\n                  \"delta\": \"Ответ\\n\"\n                }\n              },\n              \"field_paths\": {\n                \"delta\": \"$.data.delta\",\n                \"session_id\": \"$.data.sessionID\"\n              },\n              \"canonical\": {\n                \"etype\": \"text\",\n                \"payload\": {\n                  \"content\": \"Ответ\\n\"\n                }\n              }\n            },\n            \"session.step.ended\": {\n              \"wire\": {\n                \"id\": \"evt_fixture_3\",\n                \"created\": 1792957431003,\n                \"type\": \"session.step.ended\",\n                \"data\": {\n                  \"sessionID\": \"ses_fixture_1\",\n                  \"assistantMessageID\": \"msg_fixture_1\",\n                  \"finish\": \"stop\",\n                  \"cost\": 0,\n                  \"tokens\": {\n                    \"input\": 17,\n                    \"output\": 9,\n                    \"reasoning\": 4,\n                    \"cache\": {\n                      \"read\": 3,\n                      \"write\": 2\n                    }\n                  }\n                }\n              },\n              \"field_paths\": {\n                \"tokens\": \"$.data.tokens\",\n                \"dedup_step_key\": \"$.data.assistantMessageID\",\n                \"cached\": \"$.data.tokens.cache.read\"\n              },\n              \"canonical\": {\n                \"etype\": \"step_finish\",\n                \"payload\": {\n                  \"input\": 17,\n                  \"output\": 9,\n                  \"cached\": 3,\n                  \"reasoning\": 4\n                }\n              },\n              \"note\": \"Реальный v2 wire cache:{read,write}; cached=cache.read в legacy canonical tuple. cache.write не суммировать с cached read. Canonical input/output/reasoning копировать по существующей семантике; считать раз по assistantMessageID. Отсутствие required tokens/cache/read — invalid_serve_event, не нули.\"\n            },\n            \"session.permission.requested / session.tool.*\": {\n              \"wire_event_name\": \"permission.asked\",\n              \"logical_family\": \"session.permission.requested\",\n              \"wire\": {\n                \"id\": \"evt_fixture_4\",\n                \"created\": 1792957431004,\n                \"type\": \"permission.asked\",\n                \"data\": {\n                  \"id\": \"per_fixture_1\",\n                  \"sessionID\": \"ses_fixture_1\",\n                  \"action\": \"bash\",\n                  \"resources\": [\n                    \"*\"\n                  ],\n                  \"source\": {\n                    \"type\": \"tool\",\n                    \"messageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\"\n                  }\n                }\n              },\n              \"field_paths\": {\n                \"session_id\": \"$.data.sessionID\",\n                \"request_id\": \"$.data.id\",\n                \"tool_call_id\": \"$.data.source.id\",\n                \"action\": \"$.data.action\",\n                \"resources\": \"$.data.resources\"\n              },\n              \"reply\": {\n                \"method\": \"POST\",\n                \"path\": \"/api/session/ses_fixture_1/permission/per_fixture_1/reply\",\n                \"body\": {\n                  \"decision\": \"reject\"\n                },\n                \"success_status\": 204\n              },\n              \"tool_lifecycle\": [\n                {\n                  \"id\": \"evt_fixture_5\",\n                  \"created\": 1792957431005,\n                  \"type\": \"session.tool.input.started\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"assistantMessageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\",\n                    \"name\": \"bash\"\n                  }\n                },\n                {\n                  \"id\": \"evt_fixture_6\",\n                  \"created\": 1792957431006,\n                  \"type\": \"session.tool.input.delta\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"assistantMessageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\",\n                    \"delta\": \"{\\\"command\\\":\\\"printf probe\\\"}\"\n                  }\n                },\n                {\n                  \"id\": \"evt_fixture_7\",\n                  \"created\": 1792957431007,\n                  \"type\": \"session.tool.input.ended\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"assistantMessageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\",\n                    \"text\": \"{\\\"command\\\":\\\"printf probe\\\"}\"\n                  }\n                },\n                {\n                  \"id\": \"evt_fixture_8\",\n                  \"created\": 1792957431008,\n                  \"type\": \"session.tool.called\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"assistantMessageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\",\n                    \"input\": {\n                      \"command\": \"printf probe\"\n                    },\n                    \"executed\": false\n                  }\n                },\n                {\n                  \"id\": \"evt_fixture_9\",\n                  \"created\": 1792957431009,\n                  \"type\": \"session.tool.failed\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"assistantMessageID\": \"msg_fixture_1\",\n                    \"id\": \"call_fixture_1\",\n                    \"error\": {\n                      \"type\": \"permission.rejected\",\n                      \"message\": \"Rejected by bridge policy\"\n                    },\n                    \"executed\": false\n                  }\n                },\n                {\n                  \"id\": \"evt_fixture_10\",\n                  \"created\": 1792957431010,\n                  \"type\": \"permission.replied\",\n                  \"data\": {\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"requestID\": \"per_fixture_1\",\n                    \"reply\": \"reject\"\n                  }\n                }\n              ],\n              \"canonical\": {\n                \"etype\": \"tool_use\",\n                \"payload\": {\n                  \"part\": {\n                    \"tool\": \"bash\",\n                    \"state\": {\n                      \"input\": {\n                        \"command\": \"printf probe\"\n                      },\n                      \"status\": \"error\"\n                    }\n                  },\n                  \"call_id\": \"call_fixture_1\"\n                }\n              },\n              \"note\": \"Family label из brief — не имя wire event. В бинарнике нет session.permission.requested или session.tool.started: actual names permission.asked и session.tool.input.started/called/progress/success/failed. Имя tool копить из input.started; canonical payload emit после complete input/called, не исполнять по частичному JSON. Lifecycle updates не создают повторный DSH tool_call; own denied event не является model progress. Указанный failed message — синтетическое fixture значение типа error, не заявление о захваченном live отказе.\"\n            },\n            \"session.execution.failed\": {\n              \"wire\": {\n                \"id\": \"evt_fixture_11\",\n                \"created\": 1792957431011,\n                \"type\": \"session.execution.failed\",\n                \"data\": {\n                  \"sessionID\": \"ses_fixture_1\",\n                  \"error\": {\n                    \"type\": \"provider.free-limit\",\n                    \"message\": \"Free usage limit reached\"\n                  }\n                }\n              },\n              \"field_paths\": {\n                \"error\": \"$.data.error\",\n                \"message\": \"$.data.error.message\",\n                \"error_type\": \"$.data.error.type\",\n                \"statusCode\": \"$.data.error.status if present integer100..599, else explicit type mapping\"\n              },\n              \"canonical\": {\n                \"etype\": \"error\",\n                \"payload\": {\n                  \"statusCode\": 429,\n                  \"message\": \"Free usage limit reached\"\n                }\n              },\n              \"note\": \"provider.free-limit ->429; provider.auth/permission denial ->fatal401/403; неизвестный type сохраняется как явная ошибка с statusCode=null, не выдумывать retryability. step.failed + execution.failed одной cause дедуп без потери terminal. Numeric wire key status, not statusCode/data.statusCode; source Session.StructuredError. Missing numeric status allowed as in captured free-limit event.\"\n            },\n            \"form.created / form.cancelled\": {\n              \"wire\": {\n                \"id\": \"evt_fixture_form_1\",\n                \"created\": 1792957431012,\n                \"type\": \"form.created\",\n                \"data\": {\n                  \"form\": {\n                    \"id\": \"frm_fixture_1\",\n                    \"sessionID\": \"ses_fixture_1\",\n                    \"title\": \"Question\",\n                    \"fields\": [\n                      {\n                        \"key\": \"answer\",\n                        \"type\": \"string\",\n                        \"title\": \"Question\",\n                        \"required\": true\n                      }\n                    ]\n                  }\n                }\n              },\n              \"field_paths\": {\n                \"session_id\": \"$.data.form.sessionID\",\n                \"form_id\": \"$.data.form.id\",\n                \"info\": \"$.data.form\",\n                \"state\": \"Form.State=pending; Form.Info has no state field\"\n              },\n              \"cancel\": {\n                \"method\": \"POST\",\n                \"path\": \"/api/session/ses_fixture_1/form/frm_fixture_1/cancel\",\n                \"body\": null,\n                \"success\": \"HTTP2xx empty success; protocol preflight freezes exact success response from used endpoint schema; no fabricated reply/body\"\n              },\n              \"cancelled_wire\": {\n                \"id\": \"evt_fixture_form_2\",\n                \"created\": 1792957431013,\n                \"type\": \"form.cancelled\",\n                \"data\": {\n                  \"id\": \"frm_fixture_1\",\n                  \"sessionID\": \"ses_fixture_1\"\n                }\n              },\n              \"state_schema\": {\n                \"pending\": {\n                  \"status\": \"pending\"\n                },\n                \"answered\": {\n                  \"status\": \"answered\",\n                  \"answer\": {}\n                },\n                \"cancelled\": {\n                  \"status\": \"cancelled\",\n                  \"message\": \"optional string\"\n                }\n              },\n              \"canonical\": {\n                \"etype\": \"control_only\",\n                \"emit_model_text\": false,\n                \"actions\": [\n                  \"suppress Step2 immediately\",\n                  \"cancel via control<=0.25s\",\n                  \"interrupt own session\",\n                  \"return accumulated mapped tool_calls or existing recovery\"\n                ]\n              },\n              \"negative_mutations\": [\n                \"flatten form.sessionID to data.sessionID or missing/invalid nested sessionID/id ->immediate fail-closed attempt,0foreigncancel,own-group kill<=1.2s,no watchdog wait\",\n                \"own nested sessionID+nonempty id but missing title ->cancel<=0.25s BEFORE other validation,interrupt<=0.10s,normal cancellation,ServeHealth0,UpstreamBreaker0,Step2output0\",\n                \"own nested sessionID+nonempty id but malformed/missing fields ->cancel first<=0.25s,then schema diagnostic/fail-closed as applicable; never wait watchdog or send answer\",\n                \"foreign valid nested sessionID ->ignore,0foreigncancel\",\n                \"form.cancelled wrong id/session ->not own success\",\n                \"cancel endpoint failure or broken control ->immediate fail-closed+finally killpg(child_pgid)<=1.2s,never allow/answer/Step2\"\n              ],\n              \"provenance\": \"EVD-073 source schema; synthetic ids/titles/empty fields, not observed runtime cancellation\",\n              \"safety_order\": \"For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event.\"\n            }\n          },\n          \"fixture_provenance\": {\n            \"source\": \"EVD-062: read-only embedded schemas/API v2.1.2; EVD-063: analyst PoC script+failure envelope\",\n            \"binary_sha256\": \"b6dc81ec33e062a443e9d3eb1033e42f5d3e16acc4409970320cd26b9a215d0c\",\n            \"examples\": \"Six source-schema families; synthetic ids/timestamps/texts, Form.Info wrapper verified EVD-073; no live tool success asserted.\",\n            \"immutable_oracle\": \"В Stage3 fixture literals копируются в tests/test_realtime_reasoning.py; до adapter expectations сверить fixture canonical SHA256 с пакетным fingerprint. Менять fixture по реализации запрещено.\"\n          },\n          \"frozen_fixture_sha256\": \"991445656b459e1a7c50b353d5bf4915a18319d964cabd2f92726e915b708e4c\",\n          \"form.created / form.cancelled\": \"For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event.\",\n          \"fixture_digest_serialization\": \"pairs = {name: {\\\"wire\\\": fixture[\\\"wire\\\"], \\\"canonical\\\": fixture[\\\"canonical\\\"]} for name, fixture in frozen_v2_1_2_fixtures.items()}; frozen_fixture_sha256 = hashlib.sha256(json.dumps(pairs, sort_keys=True, separators=(\\\",\\\", \\\":\\\")).encode(\\\"utf-8\\\")).hexdigest(). Default ensure_ascii=True; UTF-8; no trailing LF; no field_paths/notes/negative_mutations/safety_order in pairs.\",\n          \"fixture_digest_revision_a3\": \"Historical a3 amended editorial negative_mutations/safety_order only, leaving wire/canonical unchanged. v5 supersedes the old full-fixture digest serialization with separate protocol-pair and metadata digests; source title remains required.\",\n          \"safety_order\": \"For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event.\",\n          \"frozen_fixture_metadata_sha256\": \"4b8972a47238ed700c615b2f236e95a9397897404a6cd78ecd5723c0668356e4\",\n          \"fixture_metadata_digest_serialization\": \"metadata = {\\\"fixtures\\\": {name: {key: fixture[key] for key in (\\\"negative_mutations\\\", \\\"safety_order\\\") if key in fixture} for name, fixture in frozen_v2_1_2_fixtures.items()}, \\\"safety_order\\\": safety_order}; frozen_fixture_metadata_sha256 = hashlib.sha256(json.dumps(metadata, sort_keys=True, separators=(\\\",\\\", \\\":\\\")).encode(\\\"utf-8\\\")).hexdigest(). Default ensure_ascii=True; UTF-8; no trailing LF.\"\n        },\n        \"non_stream\": \"serve используется и stream=False через общий source; Run копит чистые model reasoning/text/native/usage как сейчас. Synthetic [мост] статусы — только SSE presentation, в JSON reasoning_content не добавляются. Google direct dispatch остаётся первым и не создаёт serve/новые timers.\",\n        \"listener_ownership\": {\n          \"protocol\": [\n            \"Parent reserves127.0.0.1:0 and launches only stdlib helper in new session. helper_proc.pid=child_pgid; helper launches serve_proc with start_new_session=False in that same group. Lease records helper and serve separately, raw pid aliases forbidden.\",\n            \"Helper publishes serve_pid/serve_lstart/pgid atomically before JSON handshake {\\\"serve_pid\\\":...,\\\"pgid\\\":...}; parent validates helper_proc.pid==child_pgid==os.getpgid(helper_proc.pid), handshake/lease match before any lsof/READY/Auth.\",\n            \"SPAWN→READY: exactly1 lsof -nP -a -iTCP:<port> -sTCP:LISTEN -Fp,timeout<=0.35s. Require single listener_pid==serve_pid AND os.getpgid(listener_pid)==child_pgid AND helper_proc.poll() is None. Mismatch/ambiguous/timeout:0secret bytes,ServeHealth+1 once, cleanup own group only.\",\n            \"Retain3 HTTP/1.1 Keep-Alive lanes(control,SSE,prompt), loopback direct,no redirects/proxy. Before EACH authenticated Keep-Alive request require helper_proc.poll() is None; helper exits immediately with serve termination code/signal after owned cleanup when serve_proc exits. Never use helper_pid as listener or ambiguous proc.poll().\",\n            \"For entire normal permission/form/reply/interrupt/DELETE path:1lsof total per successful spawn, including50 control operations; never extra lsof or reconnect in <=0.25s reply/<=0.20s final API cleanup.\",\n            \"Only separate explicit control-socket reconnect may perform second lsof/proof<=0.35s, against same serve_pid/child_pgid/live helper/lease BEFORE Authorization; outside0.25s/0.20s budgets, no sent-request retry or prompt replay. Urgent pending control on broken socket fails closed immediately; SSE/prompt disconnect closes attempt.\",\n            \"On helper death close all lanes/fail-closed; no Auth to replacement listener. Foreign PID/PGID never signalled. Parent cleanup closes lifeline_w then TERM→KILL child_pgid, including live descendants even if serve exited. lsof/identity probe own bounded lifecycle; cleanup never reconnects.\"\n          ],\n          \"owner_probe_timeout_s\": 0.35,\n          \"reconnect_budget_s\": 0.35,\n          \"ready_deadline_includes\": \"lsof+keepalive setup+GET active and cache-miss protocol projection all within3.0s; repeated port attempt does not reset it.\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ]\n        },\n        \"protocol_compatibility\": {\n          \"version\": \"2.1.2\",\n          \"cache_key\": [\n            \"resolved executable path\",\n            \"mtime_ns\",\n            \"size\"\n          ],\n          \"handshake\": \"On changed executable stat key invalidate cache and revalidate owned child /api/info version+pid and bounded /openapi.json<=512KiB inside ready3s. app version2.1.2 is reference, NOT equality-only reject gate. Permit changed binary version/mtime iff canonical required-endpoints/schema/event projection hash equals validated reference projection. API info.version0.0.1 distinct. Required projection includes Model.Ref,Permission.Ruleset,PromptInput,TokenUsage/StructuredError,Form.Info/State and six fixture families + all used methods/path parameter schemas. No permission endpoint ->security fail-closed; benign other projection mismatch ->ServeUnavailable before prompt.\",\n          \"invalidation\": \"mtime/size/path invalidate capability cache, not permanent ban. Same projection hash after recheck keeps serve, differing used schema routes new auto to run with explicit diagnostic reason. No accept-by-version-string alone; reference normalized projection freeze in first provider-free Stage3 preflight before enable. Arbitrary old raw hash is not a projection hash; never invent a digest.\",\n          \"fixture_source_evidence_ids\": [\n            \"EVD-062\",\n            \"EVD-063\"\n          ],\n          \"cache_ownership\": \"Per-Server bounded capability record (only executable key/version/schema hashes/projection, no password/session/prompt). Один fill-owner на binary key; конкурентные fills ждут только remaining own ready3s без блокировки writer, owner cancellation снимает in-flight; никаких live sockets/passwords в cache. Это setup capability metadata, не ControlPlane/Snapshot polling.\",\n          \"projection_freeze\": \"VER-005 independent expected fixtures anchor required field semantics; first provider-free preflight records normalized projection SHA256 from verified2.1.2 endpoint response; subsequent binary keys compare that immutable in-process reference. If no verified reference exists, exact fixture projection validation is mandatory before recording reference. New binary alone cannot self-certify expected schema. No new repo config/artifact outside allowlist.\",\n          \"telemetry\": \"REQ-016/AC-021 explicitly authorize transport,first_event_ms,ttft_ms in O-EXIT/v1. Preserve existing keys/types and one-exit cardinality; no incompatible rename. Fallback reason and transport-history details may be adjacent bounded redacted BRIDGE-TRANSPORT/v1 diagnostic correlated by existing request id, so strict O-EXIT parsers remain valid. Log selected transport=serve|run and reason for stat/schema/degraded/disable fallback; /health unchanged.\"\n        },\n        \"admission\": \"Один monotonic pre_spawn_deadline=now+min(5.0,remaining_request) охватывает _SpawnRateLimiter и _StartupGate. Сначала получить rate token с timeout=remaining_admission; gate может ждать только остаток этого же окна и fail-open по legacy, без добавочных5s; timeout rate token -> не spawn. Hold gate<=12s не является отдельным pre-spawn wait; release при готовности собственного child/EOF/finally, HTTP ready по-прежнему не событие модели. Cancel poll<=.25s, каждый Popen включая fallback/race учитывается _RequestAttempts<=3; token не обходить.\",\n        \"session_wire\": {\n          \"schema\": \"opencode serve v2.1.2, EVD-062/EVD-063; paths и JSON properties заморожены до Coder\",\n          \"create\": {\n            \"method\": \"POST\",\n            \"path\": \"/api/session\",\n            \"headers\": {\n              \"Content-Type\": \"application/json\",\n              \"Authorization\": \"Basic <ephemeral runtime secret, never stored>\"\n            },\n            \"body\": {\n              \"location\": {\n                \"directory\": \"<existing absolute request workdir>\"\n              },\n              \"model\": {\n                \"providerID\": \"opencode\",\n                \"id\": \"deepseek-v4.1-flash-free\",\n                \"variant\": \"high\"\n              },\n              \"permissions\": [\n                {\n                  \"action\": \"*\",\n                  \"resource\": \"*\",\n                  \"effect\": \"ask\"\n                }\n              ]\n            },\n            \"success_status\": 200,\n            \"response_id_path\": \"$.data.id\",\n            \"permission_variant\": \"Для policy=deny тот же ruleset с effect=deny; ask_reject effect=ask + немедленный decision=reject. В API permissions — ARRAY rules, не config object {\\\"*\\\":\\\"ask\\\"}.\",\n            \"model_mapping\": \"Тот же resolved provider/model#variant: отделить providerID и id; #high -> model.variant=\\\"high\\\"; effort off/none -> variant отсутствует, не #off. --thinking относится к CLI presentation; HTTP thinking задаётся существующим resolved variant без несуществующего поля thinking.\"\n          },\n          \"subscribe\": {\n            \"method\": \"GET\",\n            \"path\": \"/api/event\",\n            \"headers\": {\n              \"Accept\": \"text/event-stream\"\n            },\n            \"success_status\": 200,\n            \"body\": \"SSE data JSON envelope {id,created,type,data}; subscribe armed до prompt body, filter data.sessionID\"\n          },\n          \"prompt\": {\n            \"method\": \"POST\",\n            \"path\": \"/api/session/{id}/prompt\",\n            \"body\": {\n              \"text\": \"<full unchanged prompt>\",\n              \"files\": [],\n              \"delivery\": \"steer\",\n              \"resume\": true\n            },\n            \"success_status\": 200,\n            \"response\": \"$.data is Session.Inbox.User; $.data.id is inbox/message id, durable admission, не model completion\",\n            \"delivery\": \"steer/queue — admission boundary, НЕ флаг неблокирующего HTTP. Для единственного fresh session input выбран steer; один POST, worker может блокироваться на headers/body параллельно чтению SSE. Не вызывать generate, resume повторно или повторный prompt при задержке ответа.\",\n            \"budget\": \"Не session_setup2s. От prompt_send_start ограничен оставшимися first_event20s/first_token60s/общим TIMEOUT1800; при продвижении session событий supervisor не отменяет HTTP только потому, что истёк first_event, но total/cancel/terminal закрывают сокет. Response body не нужен для продолжения чтения событий после headers.\"\n          },\n          \"permission_reply\": {\n            \"method\": \"POST\",\n            \"path\": \"/api/session/{id}/permission/{requestID}/reply\",\n            \"body\": {\n              \"decision\": \"reject\"\n            },\n            \"success_status\": 204,\n            \"request_id_path\": \"$.data.id of permission.asked; session path id=$.data.sessionID\",\n            \"note\": \"Wire key decision, не reply; permission.replied notification содержит reply=reject. Никогда once/always/allow.\",\n            \"after_reply\": \"Immediately interrupt own session; barrier latched before reply; Step2 suppressed.\"\n          },\n          \"cleanup\": {\n            \"interrupt\": \"POST /api/session/{id}/interrupt\",\n            \"delete\": \"DELETE /api/session/{id}\",\n            \"aggregate_api_budget_s\": 0.2,\n            \"connection_policy\": \"Use existing proven Keep-Alive control only; no lsof/reconnect. If unavailable skip API, kill owned PGID; do not add0.35s reconnect into0.20s API budget.\",\n            \"interrupt_each_s\": 0.09,\n            \"delete_each_s\": 0.09,\n            \"scheduling_margin_s\": 0.02\n          },\n          \"readiness\": {\n            \"method\": \"GET\",\n            \"path\": \"/api/session/active\",\n            \"success_status\": 200,\n            \"response_example\": {\n              \"data\": {}\n            },\n            \"schema\": \"$.data is record keyed by sessionID, not an array; source byte offset114978382\",\n            \"budget\": \"part of ready_budget_s=3.0, not first_event; owner proof before auth\"\n          },\n          \"version_probe\": {\n            \"method\": \"GET\",\n            \"path\": \"/api/info\",\n            \"response_example\": {\n              \"version\": \"2.1.2\",\n              \"pid\": \"<actual serve_pid integer,never helper_pid>\"\n            },\n            \"note\": \"Пример pid placeholder только в документации, wire integer; owner PGID проверяется до Auth независимо от self-reported pid. appversion2.1.2 отличается от OpenAPI.info.version0.0.1. Once per executable stat key, withinready3s. If /api/info pid is checked it must equal handshake serve_pid (not helper_proc.pid),group remains child_pgid=helper_proc.pid.\"\n          },\n          \"form_cancel\": {\n            \"method\": \"POST\",\n            \"path\": \"/api/session/{id}/form/{formID}/cancel\",\n            \"body\": null,\n            \"form_id_path\": \"$.data.form.id\",\n            \"session_id_path\": \"$.data.form.sessionID\",\n            \"timeout_s\": 0.25,\n            \"on_error\": \"fail-closed+kill own PGID; never reply/answer to question\"\n          }\n        },\n        \"data_isolation\": {\n          \"selected\": \"env[\\\"OPENCODE_DB\\\"] = \\\":memory:\\\" for every serve spawn; never use shared opencode.db/opencode-next.db. EVD-071 calibrates ready3.0s with120.7ms,156.8MiB<=256MiB and0 open SQLite files.\",\n          \"XDG_DATA_HOME\": \"Preserve effective standard XDG_DATA_HOME from trusted base env (unset retains HOME default). Do not overwrite with empty directory: opencode-go/* must read standard opencode/auth.json. Shared auth file is read-only input; do not write/copy/log credentials. No readonly bind mount/symlink changes to owner filesystem.\",\n          \"state_and_workdir\": \"Allocate one owned tempfile.mkdtemp(prefix=\\\"zen-serve-state-\\\") per attempt, with state/ and tmp/ subdirectories. Set XDG_STATE_HOME and TMPDIR to those paths. Popen cwd may use owned dir, but POST session location.directory remains existing request workdir; no silent change to tool-relative paths. Parent lease records exact temp root.\",\n          \"catalog_and_auth\": \"Preserve OPENCODE_MODELS_PATH, generated OPENCODE_CONFIG/OPENCODE_CONFIG_CONTENT and provider settings from exactly one _run_env call, sanitized below on all3 branches; auth.json remains visible for glm-5.1,kimi-k2.5,minimax-m2.5,minimax-m2.7 via opencode-go/*. Provider-free accessibility is not proof of valid live provider credential (H3/H6).\",\n          \"alternatives\": {\n            \"empty_XDG_DATA_HOME\": \"Rejected for default: loses auth.json despite preserving models. If explicitly isolated later, read-only auth propagation must be separately verified without shared DB access.\",\n            \"shared_DB_plus_StartupGate\": \"Rejected: violates no shared DB mutation/lock boundary; cannot use as fallback without owner scope approval.\"\n          },\n          \"ownership\": \"Lease + normal parent finally removes own zen-serve-state-* only after same-group kill/reap/readers closed; parent-dead helper terminal_quiescence is explicit exception: stop/recheck every residual writer before owned root removal,unlink lease last,final self-including group KILL. No deletion by unquiesced children/no ignore_errors; failed deletion retains lease for safe startup reaper. cleanup<=1.2s design target; Stage3/H3/H9 actual proof required.\",\n          \"preflight\": \"EVD-071 covers GET /api/session/active; /api/info version+pid readback NOT supplied. Before freeze-to-Coder execution gate, Stage3 first provider-free preflight rechecks both /api/info and /api/session/active on chosen env, startup<=3s/RSS/files/auth visibility; no Zen quota. H3 actual provider auth/parallel RSS remain NOT_RUN.\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ]\n        },\n        \"typing\": \"Decode wire JSON as object with isinstance narrowing/TypedDict; new code no Any/casts-to-Any/type-ignore. VER-004 uses isolated bridge cwd + temporary include/extraPaths: all3 errorCount==0, new test0diagnostics, server Any<=125each/nonAny per-rule and total<=720, step<=194; changed legacy code0reportAny/reportExplicitAny/reportUnusedCallResult. Preserve public module attribute server.CATALOG_SOURCE and HTTP catalog_source: module-level CATALOG_SOURCE = \\\"static\\\", never rename it or external test references. Replace reload_catalog global CATALOG_SOURCE/reassignment with typed def _set_catalog_source(source: str) -> None: globals()[\\\"CATALOG_SOURCE\\\"] = source; keep only _catalog_mtime/_catalog_ids in reload_catalog global declaration. Preserve existing static import zen_catalog as zc at original server.py:67 (the sole inherited E402 site); guard proc is not None before both final stream .returncode reads. EVD-076 observed errorCount0 without # type: ignore; tests/test_catalog_mode.py:64,93 unchanged,8tests PASS on copy. coder_target_files remains exactly3; no config/dependency/new module. Full all3 Stage3 gate NOT_RUN. Ruff==0.17.2 legacy ranges use only --range={start}:1-{end}:999; reject any old/new diff hunk intersecting _run_env/_stream_google_sse/_execute_google_once and check their literal raw hashes before and after formatter. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv. EVD-076 static-import server warningCount564/reportAny125, EVD-077 full local block exit0 with catalog8/8; source init→static transition is probe-only. Actual Stage3 NOT_RUN. Write-mode range formatting must run on disposable candidate copy and assert_frozen(copy), never write product during architecture probe.\",\n        \"transport_health\": {\n          \"owner\": \"_ServeHealth per Server, key=(resolved executable,mtime_ns,size), lock/monotonic; состояние отдельно от model _UpstreamBreaker\",\n          \"consecutive_failure_threshold\": 3,\n          \"degrade_ttl_s\": 120.0,\n          \"degraded_transport\": \"run для новых auto requests\",\n          \"counted_failures\": [\n            \"first_event_timeout на serve после prompt и HTTP readiness, без валидных событий исполнения\",\n            \"invalid_serve_event / incompatible schema projection / malformed required v2 fields\",\n            \"serve SSE EOF без terminal; first_token_timeout только при доказанной protocol/capability причине, иначе model failure\",\n            \"listener_ownership failure/ambiguous PID/PGID mismatch/lsof timeout, once per attempt\",\n            \"serve spawn/ready/create/subscribe local transport failure; reconnect ownership timeout; schema mismatch\"\n          ],\n          \"not_counted\": \"Реальные provider errors (429/free-limit,5xx,provider network), explicit auth/permission/security failure, client_gone, slot rejection и transient child DB errors не маскировать transport failure. Если валидные execution events пришли, но model token нет, first_token_timeout сохраняет обычную provider classification при отсутствии доказанного protocol defect.\",\n          \"state_machine\": \"HEALTHY consecutive0..2; третий законченный protocol-specific failure -> DEGRADED(until=now+120), последующие auto requests run без serve probe/Popen. Это НЕ повтор/переключение текущего DELIVERED prompt: транспорт текущего запроса закреплён, silent replay запрещён. В DEGRADED skipped requests не продлевают TTL. При TTL expiry ровно один HALF_OPEN serve probe request (другие auto requests run); только валидный terminal success со schema-valid source очищает consecutive/degraded. Failed protocol probe -> новый TTL120. Provider failure не объявлять protocol success/failure. Neutral cancel освобождает probe, не продлевает TTL. Force serve допускает диагностику только при закрытом sticky TTL, не обходя security/kill-switch/cap3. Открытый sticky TTL применяется до explicit serve согласно configuration precedence: force serve не обходит TTL; HALF_OPEN admission после expiry остаётся прежним.\",\n          \"breaker_isolation\": \"Protocol-specific failure никогда не вызывает _UpstreamBreaker.failure/commit pending model failure. Provider failures сохраняют общий breaker threshold5/cooldown jitter/HALF_OPEN1. Нейтральный transport-only финальный запрос освобождает model probe lease после cleanup; success/failure не выдумывать. _RetryBudget и MAX_TOTAL_SPAWNS остаются общими даже для protocol retry/fallback.\",\n          \"telemetry\": \"REQ-016/AC-021 explicitly authorize transport,first_event_ms,ttft_ms in O-EXIT/v1. Preserve existing keys/types and one-exit cardinality; no incompatible rename. Fallback reason and transport-history details may be adjacent bounded redacted BRIDGE-TRANSPORT/v1 diagnostic correlated by existing request id, so strict O-EXIT parsers remain valid. Log selected transport=serve|run and reason for stat/schema/degraded/disable fallback; /health unchanged.\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ]\n        },\n        \"immutable_run_env\": {\n          \"symbol\": \"bridges/opencode-zen-bridge/server.py:_run_env\",\n          \"source_slice\": \"ast FunctionDef.lineno..end_lineno inclusive, raw file bytes splitlines(keepends=True), includes terminal LF\",\n          \"sha256\": \"1c51b28fcb83fcc0f4d8b5204c858e11ab5ac975bfe40dca4a0bf61978008e31\",\n          \"test_run_env_sha256\": \"d3d0baf57f7ccae7dd7846ab98d3da43c588a35e7f076fabe074c1212f232e05\",\n          \"start_sh_sha256\": \"5430e529627b3a705da4be7641a6d079408e3cf85b6ad3333330e34cb08c190c\",\n          \"verification\": \"VER-005 compare literal hashes from frozen packet; _serve_env wrapper only, never recalculate expected from edited implementation\"\n        },\n        \"serve_env_sanitization\": {\n          \"source\": \"Call immutable _run_env(model_id) exactly once, then build NEW env dictionary from exact allowlist on ALL branches standalone/base_url opencode-go/static; never env=dict(os.environ) passthrough.\",\n          \"allowlist\": [\n            \"PATH\",\n            \"HOME\",\n            \"USER\",\n            \"LOGNAME\",\n            \"SHELL\",\n            \"LANG\",\n            \"LC_ALL\",\n            \"LC_CTYPE\",\n            \"TZ\",\n            \"TERM\",\n            \"COLORTERM\",\n            \"HTTP_PROXY\",\n            \"HTTPS_PROXY\",\n            \"ALL_PROXY\",\n            \"NO_PROXY\",\n            \"http_proxy\",\n            \"https_proxy\",\n            \"all_proxy\",\n            \"no_proxy\",\n            \"SSL_CERT_FILE\",\n            \"SSL_CERT_DIR\",\n            \"NODE_EXTRA_CA_CERTS\",\n            \"XDG_DATA_HOME\",\n            \"XDG_CONFIG_HOME\",\n            \"OPENCODE_CONFIG\",\n            \"OPENCODE_CONFIG_CONTENT\",\n            \"OPENCODE_MODELS_PATH\"\n          ],\n          \"removal\": \"Deny always OPENCODE_ZEN_BRIDGE_*, arbitrary parent vars (SECRET_SENTINEL included) and unrelated *_API_KEY/*_TOKEN/*_SECRET. No broad OPENCODE_* or FAKE_* wildcard; only literal routing/config keys above. Tests inject explicit fake transport dependency, no production exception for secret sentinel. OPENCODE_DB/XDG_STATE_HOME/TMPDIR and server password are NOT inherited; generated after filter.\",\n          \"compatibility\": \"Proxy credentials only in explicitly required _run_env-selected HTTP(S)/ALL_PROXY values, redacted end-to-end. Config JSON from trusted _run_env retains required provider/options and selected permissions; no merging arbitrary parent secret keys. Standard auth file accessible by preserved HOME/XDG_DATA_HOME; unrelated API keys never child env.\",\n          \"overrides\": \"Then set OPENCODE_DB=:memory:, owned XDG_STATE_HOME/TMPDIR, merge scoped permission policy, and generate fresh OPENCODE_SERVER_PASSWORD last. Child-only secret, never argv/log/lease. Keep models/config on opencode-go and static branches.\",\n          \"tests\": \"VER-005 GroupB parameterizes standalone, opencode-go/base_url, CATALOG_MODE=static; sentinels absent, route config/models/auth paths preserved, password fresh, common DB untouched, _run_env literal hash unchanged.\"\n        },\n        \"single_turn_control\": {\n          \"trigger\": \"permission.asked on own session or form.created.data.form.sessionID on own session. Immediately latch step_closed/output barrier BEFORE sending any control reply; retain accumulated raw/tool arguments and suppress every later-step text/reasoning.\",\n          \"order\": [\n            \"Do not wait for pending prompt HTTP response or step.ended. Snapshot already received complete tool args/call ids; continue only bounded same-step argument finalization, never wait for Step2.\",\n            \"For own form nested sessionID+nonempty id: cancel on idle Keep-Alive control lane<=0.25s BEFORE title/fields/schema checks; permission reply decision=reject same0.25s. Missing form title still normal cancellation,0ServeHealth increment, no watchdog wait. Missing id/sessionID or any control failure ->fail-closed+own group kill<=1.2s. Never lsof/reconnect on this hot path.\",\n            \"Immediately POST /api/session/{id}/interrupt (<=0.10s) after rejection/cancellation; single-turn guard suppresses Step2 even if server races interrupt. On any control error fail-closed and group kill.\",\n            \"If mapped complete native call available, return it exactly once to DSH with finish_reason=tool_calls; otherwise apply existing _incomplete_step_signal/unmapped-tool recovery under same cap3/retry budgets. Preserve raw model data/provenance.\",\n            \"Final cleanup DELETE/close/kill/reap. Avoid duplicate interrupt if already succeeded; cancellation notifications never release Step2 barrier.\"\n          ],\n          \"latency\": \"permission/form first reply<=0.25s; immediate subsequent interrupt<=0.10s is distinct control cost within model-execution phase. Final cleanup API aggregate<=0.20s; no new lsof. Only own session/PGID.\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ]\n        },\n        \"crash_recovery\": {\n          \"registry\": \"/tmp/opencode-zen-bridge-leases/; owner-UID directory mode0700, lease files0600, no symlinks (lstat + O_NOFOLLOW where supported), atomic replace and fsync before prompt admission. No name-wide scanning outside registry.\",\n          \"lease_fields\": [\n            \"schema_version\",\n            \"attempt_id\",\n            \"owner_uid\",\n            \"bridge_instance_id\",\n            \"parent_pid\",\n            \"parent_start_ts\",\n            \"helper_pid\",\n            \"helper_lstart\",\n            \"serve_pid\",\n            \"serve_lstart\",\n            \"pgid\",\n            \"port\",\n            \"start_ts\",\n            \"binary_realpath\",\n            \"binary_marker=opencode serve\",\n            \"temp_root\",\n            \"temp_root_inode\",\n            \"phase\"\n          ],\n          \"creation\": \"Parent reserved ownership manifest contains attempt/temp inode before helper Popen; helper immediately creates/updates lease-<attempt_id>.json with helper_pid,helper_lstart,pgid=helper_pid,port,start_ts. Install SIGTERM handler/EOF watcher first; if parent already died EOF is latched, do not launch serve. serve_proc=Popen(...,stdin=DEVNULL,start_new_session=False,env=serve_env) in same child_pgid; atomic fsync+replace adds serve_pid and serve_lstart BEFORE stdout handshake {\\\"serve_pid\\\":...,\\\"pgid\\\":...}, then parent lsof/READY/Auth. Check EOF before serve Popen, immediately after it, before/after lease publication/handshake and in <=0.25s monitor loop. No gap depends on parent surviving to publish child identity; helper owns serve Popen->lease publication. helper_proc denotes parent Popen object only; serve_proc denotes helper Popen object only. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\",\n          \"parent_death\": \"EOF on helper stdin lifeline_r (parent closes lifeline_w or SIGKILL at ANY point including helper Popen->helper entry, serve Popen->lease write, handshake->READY, active prompt) triggers immediate own-group shutdown; never wait first-event/token/watchdog. helper SIGTERM handler latches shutdown without recursively exiting, so os.killpg(child_pgid,SIGTERM) reaches serve/descendants while helper remains to reap/clean. Grace<=0.50s; normal parent alive escalates os.killpg(child_pgid,SIGKILL) and performs post-kill cleanup outside group. For parent-dead helper escalation, use explicit terminal_quiescence below: never claim a finally after SIGKILL-to-self. Parent identity checks are additional diagnostics, EOF is primary death signal; live parent is never time-killed. Serve exit immediately triggers same cleanup and helper terminates with same serve exit code/signal (not a healthy lingering helper); poll guard checks helper_proc only.\",\n          \"startup_reaper\": \"Before bridge accepts any traffic, even disabled serve: inspect only valid owner-UID leases. Matching live parent PID+parent_start_ts ->skip. Dead parent: validate helper_pid/helper_lstart/pgid and/or serve_pid/serve_lstart using exact uid,pgid,binary path/command/port; helper command is sys.executable -I <resolved server.py> --serve-helper <attempt_id> <port> ... with exact early argv-position attempt marker and untruncated ps -ww, never opencode listener. When serve still exists require os.getpgid(serve_pid)==stored child_pgid; pid reuse/mismatched lstart/foreign UID/PGID/no manifest/symlink ->no signal, redacted quarantine. While a verified group anchor exists recheck before TERM/KILL; do not infer ownership merely from port/name. Reap/remove only recorded own inode-safe temp root after group absent; reserved manifests with no helper/serve may clean only their proven owned root. No name-wide kill or scanning outside registry.\",\n          \"directory_cleanup\": \"Parent-alive cleanup verifies helper+serve/group gone before rmtree; parent-dead helper uses terminal_quiescence (all residual writers stopped, helper owns PGID, root/inode/UID verified) before final self-including KILL. This narrowly defined terminal path is the only cleanup-before-group-absence path; no deletion while unquiesced child can recreate files. Only recorded zen-serve-state-* local root resolved under tempfile.gettempdir, correct uid+inode/no symlink. Foreign roots never removed; no ignore_errors; failed cleanup retains manifest for startup reaper.\",\n          \"finally\": \"Parent finally always closes lifeline_w, closes lanes, TERM→KILL same child_pgid, reaps helper_proc; helper owns reaping serve_proc. Join both stdout/stderr drain threads, SSE/prompt/supervisor/bookkeeping within aggregate cleanup<=1.2s. Outside-group parent removes root then lease only after group absent. Parent-dead helper follows terminal_quiescence before final self-KILL. Atomic per-lease lock/idempotence coordinates helper/parent/reaper; never signal reused foreign PGID. Normal50cancel counters remain zero.\",\n          \"tests\": \"VER-005 GroupB inject parent SIGKILL (1) immediately after helper Popen before helper entry/lease, (2) immediately after serve Popen before serve_pid publication, (3) after atomic lease before handshake, (4) after handshake before lsof/READY, (5) during prompt. Same helper→serve group; EOF never lost, helper watcher active before READY. Include TERM-ignoring descendant and terminal_quiescence order (all writers stopped ->owned root removal ->lease unlink ->final same-group KILL; no imagined helper finally after self-KILL). Assert listener_pid==serve_pid and pgid==child_pgid,0 owned helper/serve/descendants/lease/temp roots,0 foreign signals/deletions including PID/PGID reuse. Separately kill/disable helper, restart bridge with retained lease ->safe startup reaper; this is recovery scenario, not immediate EOF success.50 normal cancellation cycles return all counters/FD/thread/pipe counts to0; lifeline_w closed every exit. Stage3/H0/H9 remain NOT_RUN.\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ],\n          \"terminal_quiescence\": {\n            \"reason\": \"SIGKILL to -child_pgid includes helper itself: no post-SIGKILL helper code or implicit finally can clean files.\",\n            \"normal_parent_alive\": \"Parent closes lifeline_w, TERM child_pgid, waits<=0.50s, then KILL child_pgid if needed; after verified group absence parent reaps helper and removes owned temp root then lease. Parent is outside child_pgid.\",\n            \"parent_dead_single_fault\": \"Helper handles own TERM, reaps cooperative serve; if residual group members ignore TERM, snapshot only child_pgid members by PID/UID/lstart, SIGSTOP each residual member except helper, recheck all group members stopped and repeat to close fork race. No other process/group is touched. Helper remains live group/session leader, preventing PGID reuse. Once all potential writers are quiescent, remove only recorded owned inode-safe temp root and unlink lease as LAST filesystem operation, then final syscall os.killpg(child_pgid,SIGKILL) kills helper and all stopped descendants; no code after it. If no residual members, remove owned files then exit preserving serve termination code. This is cleanup-before-self-KILL, not impossible cleanup-after-self-KILL.\",\n            \"failure_policy\": \"Quiescence/identity/deletion failure never reported cleanup success: retain lease, redacted error, group kill for safety and startup reaper completes retained-manifest cleanup. Fault-injection must prove zero roots on successful cleanup and fail the gate on any retained lease/root; budgets cannot be raised or failure ignored.\",\n            \"budget\": \"EOF detection<=0.25s; TERM grace<=0.50s; residual identity/stop/reap/root+lease cleanup<=0.45s; total<=1.20s target. No API0.20s cost after parent death. Extra ps identity snapshots run serially on existing helper main loop, at most1 per-slot auxiliary probe, never overlap that slot lsof; resource accounting includes them.\",\n            \"scope\": \"Single parent-death fault; helper failure is independent startup-reaper scenario and never proof of immediate EOF-path success; H0/H9/Stage3 actual timing NOT_RUN.\"\n          }\n        },\n        \"fallback_decision_table\": {\n          \"columns\": [\n            \"phase\",\n            \"event\",\n            \"DELIVERED\",\n            \"action\",\n            \"ServeHealth_failure_increment\",\n            \"UpstreamBreaker_failure_increment\"\n          ],\n          \"rows\": [\n            {\n              \"phase\": \"SPAWN/READY/CREATE/SUBSCRIBE\",\n              \"event\": \"local spawn/ready/setup failure\",\n              \"DELIVERED\": \"false\",\n              \"action\": \"fallback_to_run\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"SPAWN→READY\",\n              \"event\": \"ownership failure/timeout\",\n              \"DELIVERED\": \"false\",\n              \"action\": \"fallback_to_run\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"PROMPT_SENDING\",\n              \"event\": \"first_event_timeout20s, no response headers and no valid execution SSE\",\n              \"DELIVERED\": \"false\",\n              \"action\": \"fallback_to_run\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"DELIVERED\",\n              \"event\": \"first_event_timeout20s after headers, no valid execution SSE\",\n              \"DELIVERED\": \"true\",\n              \"action\": \"serve_retry\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"DELIVERED\",\n              \"event\": \"first_token_timeout/stall with valid protocol and model silence\",\n              \"DELIVERED\": \"true\",\n              \"action\": \"serve_retry\",\n              \"ServeHealth_failure_increment\": 0,\n              \"UpstreamBreaker_failure_increment\": 1\n            },\n            {\n              \"phase\": \"DELIVERED\",\n              \"event\": \"first_token_timeout with proven protocol/capability defect (non-security); valid protocol model silence is the separate preceding row\",\n              \"DELIVERED\": \"true\",\n              \"action\": \"serve_retry\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"ANY\",\n              \"event\": \"HTTP401/403 or permission/form/capability-security failure\",\n              \"DELIVERED\": \"any\",\n              \"action\": \"fail_closed\",\n              \"ServeHealth_failure_increment\": 0,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"ANY\",\n              \"event\": \"HTTP400/404/422 invalid request\",\n              \"DELIVERED\": \"any\",\n              \"action\": \"fail_closed\",\n              \"ServeHealth_failure_increment\": 0,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"PRE_PROMPT\",\n              \"event\": \"HTTP5xx local readiness/create/subscribe endpoint\",\n              \"DELIVERED\": \"false\",\n              \"action\": \"fallback_to_run\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"PROMPT_RESPONSE\",\n              \"event\": \"HTTP429/provider5xx; headers received latch delivery\",\n              \"DELIVERED\": \"true\",\n              \"action\": \"serve_retry\",\n              \"ServeHealth_failure_increment\": 0,\n              \"UpstreamBreaker_failure_increment\": 1\n            },\n            {\n              \"phase\": \"DELIVERED\",\n              \"event\": \"invalid SSE/EOF without terminal proven protocol-only\",\n              \"DELIVERED\": \"true\",\n              \"action\": \"serve_retry\",\n              \"ServeHealth_failure_increment\": 1,\n              \"UpstreamBreaker_failure_increment\": 0\n            },\n            {\n              \"phase\": \"ANY\",\n              \"event\": \"client cancel/deadline/budget exhausted\",\n              \"DELIVERED\": \"any\",\n              \"action\": \"fail_closed\",\n              \"ServeHealth_failure_increment\": 0,\n              \"UpstreamBreaker_failure_increment\": 0\n            }\n          ],\n          \"rules\": \"In auto fallback_to_run only before both barriers and before model/tool output, at most1 fallback after complete cleanup; force serve turns fallback_to_run into explicit failure. serve_retry means explicit admitted same-transport retry after cleanup/status, common cap3/retrytoken/FullJitter and remaining deadlines. If no budget ->fail_closed. Any response headers (including4xx/5xx) latch delivery before status classification. Upstream provider failure committed by existing per-request pending semantics once per cause, not per duplicate step/execution event. Security errors neutral to both health counters but fail-closed. lsof failure counter once per failed attempt;3 ->DEGRADED120s, next auto run without probes. Invalid protocol endpoint signature/security never bypassed by fallback. first_token_timeout branches are mutually exclusive: proven non-security protocol/capability defect ServeHealth+1/UpstreamBreaker0; valid protocol/model silence ServeHealth0/UpstreamBreaker+1. Count exactly once per cause; security capability failures keep fail_closed neutral counters. Delivery barrier/cap3/retry budget unchanged.\"\n        },\n        \"cleanup\": \"Parent normal/emergency finally: latch no-more-output/spawn, bounded own-session APIs<=0.20s on already proven Keep-Alive only, close all lanes and lifeline_w (always finally), os.killpg(child_pgid,SIGTERM),grace<=0.50s,then os.killpg(child_pgid,SIGKILL) for whole shared helper+serve+descendant group even if serve exited. Parent reaps helper_proc, helper reaps serve_proc; total remainder<=0.50s includes joins+owned root then lease removal; aggregate<=1.20s. Parent death bypasses finally ->helper EOF plus terminal_quiescence, startup reaper for retained manifests; no new group/ambiguous proc. EVD-055 justifies killing descendants after leader exit.\",\n        \"resource_accounting\": {\n          \"process_tree\": \"Exactly1bridge parent ->at most6 helper_proc ->at most6 serve_proc, each pair same child_pgid=helper_proc.pid; <=6 transient bounded lsof/ps identity probes, at most1/slot (no overlap),peak19 processes including bridge. One model attempt token creates one helper/serve pair; MAX_TOTAL_SPAWNS=3 counts pairs/actual serve launches, never free retries; probes auxiliary bounded and accounted. Serve start_new_session=False, helper=True; no alternate process topology.\",\n          \"parent_threads\": 55,\n          \"thread_formula\": \"Parent admitted bound55=1accept+18handlers(6active+12waiters)+6supervisor/setup+6SSE readers+6prompt delivery workers+12helper stdout/stderr drains+6parent bookkeeping. Helper EOF/TERM/serve poll uses one single-thread main loop per slot, no helper watcher threads;<=6 helper processes. serve logs route to helper stderr, stdout reserved for one handshake; parent still accounts2drains/slot. At most6 auxiliary identity/lsof/ps probes total,1per slot,serial nonoverlap with reconnect/cleanup, executed on existing supervisor/helper loops. Peak system processes1bridge+6helper+6serve+6probe=19. Reaper startup-only, no request overlap. Rejected unadmitted ThreadingHTTPServer handlers may be transient:55 is admitted bound; H3 must measure rejection peaks, not claim arbitrary flood defense.\",\n          \"fd\": {\n            \"parent_baseline\": 36,\n            \"admitted_client_sockets\": 18,\n            \"serve_http_lanes\": 18,\n            \"stdout_stderr_drains\": 12,\n            \"reserved_port_sockets\": 6,\n            \"lsof_capture_pipes\": 6,\n            \"parent_watchdog_pipes\": 6,\n            \"open_lease_files\": 6,\n            \"parent_upper_bound\": 114,\n            \"configured_envelope\": 128,\n            \"aggregate_estimate\": \"Steady parent108 plus transient6lifeline read ends=114<=envelope128. Systemwide conservative128+6serve*20+6helper*8+6probe*8=344descriptors; probe=lsof OR ps identity,at most1/slot,no overlap. Helper per-process8 upper design includes std0/1/2,one transient lease file/atomic temp,DEVNULL/child-launch descriptors and select bookkeeping; measure H3 each process and transient peaks,do not claim aggregate<256.\",\n            \"lifeline_definition\": \"6 parent lifeline_w write ends; transient parent lifeline_r read end closed immediately after Popen. During setup read+write momentarily add<=6FD; terminal no leaks. helper stdin fd0 is lifeline_r, never inherits write end.\",\n            \"transient_lifeline_read_ends\": 6\n          },\n          \"rss\": {\n            \"unit\": \"MiB\",\n            \"serve_idle_observed\": 156.8,\n            \"serve_evidence\": \"EVD-071 owner-supplied idle, not6parallel peak\",\n            \"helper_estimate\": 12.0,\n            \"pair_estimate\": 168.8,\n            \"probe_peak_estimate\": 8.0,\n            \"combined_with_probe_estimate\": 176.8,\n            \"per_slot_ceiling\": 192,\n            \"per_slot_headroom_estimate\": 15.2,\n            \"shared_ceiling\": 1152,\n            \"parent_ceiling\": 256,\n            \"full_design_ceiling\": 1408,\n            \"H3_full_sum_max\": 1638.4,\n            \"status\": \"DESIGN_ESTIMATES; helper/probe and loaded serve NOT_MEASURED; H3 six live slots sums bridge/helper/serve/probe RSS,blocked enable on breach\"\n          },\n          \"cleanup\": \"lifeline_w closed in parent finally; child_pgid covers helper/serve/descendants; helper EOF single-thread and terminal_quiescence as crash_recovery; all resources in H3\",\n          \"verification_ids\": [\n            \"VER-005\"\n          ],\n          \"helper_cli_contract\": \"Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv.\"\n        }\n      }\n    },\n    {\n      \"id\": \"AD-002\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как дать DSH видимость <1 s без изменения быстрых reasoning-ответов?\",\n      \"choice\": \"Один SSE-writer с grace=0.30 s и отдельными status delta, завершающимися newline; модельные дельты не дополняются переводами строк.\",\n      \"alternatives\": [\n        \"Безусловный status t=0 — надёжен для Think, но ломает точное Simple greeting. и добавляет синтетику в быстрый ответ.\",\n        \"Пустой keepalive/HTTP comment — не включает blockIsVisible и не обновляет collapsed preview (F-36/37).\",\n        \"Вставлять newline в каждую model delta — превью чаще, но нарушает AC-006 и журнал.\"\n      ],\n      \"drivers\": [\n        \"REQ-004\",\n        \"REQ-005\",\n        \"AC-005\",\n        \"AC-006\",\n        \"EVD-051\"\n      ],\n      \"consequences\": [\n        \"Первый status появляется только на медленном старте. Реальные delta с естественными абзацами обновляют collapsed summary.\",\n        \"Non-thinking/off запросы не получают искусственного thinking; проверяется отдельно.\",\n        \"DSH хранит bridge statuses в reasoning; replay их игнорирует, как весь reasoning_content.\"\n      ],\n      \"approval_required\": false,\n      \"evidence_ids\": [\n        \"EVD-007\",\n        \"EVD-036\",\n        \"EVD-037\",\n        \"EVD-038\",\n        \"EVD-039\",\n        \"EVD-051\"\n      ],\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py\",\n        \"expected\": \"exit 0; dedicated negative/boundary/fake-transport assertions, плюс VER-001/002 green без расширения потолков\"\n      },\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ],\n      \"details\": {\n        \"timer_anchor\": \"t_sse_open — flush первого role chunk. FIRST_STATUS_DELAY_S=0.30; тик writer <=0.05..0.10 s. Background setup/adapter НЕ блокирует writer на gate.acquire, rate wait, connect, POST prompt или join. Ровно один поток пишет self.wfile; worker передаёт события через bounded queue. Никаких независимых Timer-writers в wfile.\",\n        \"eligibility\": \"Только non-Google SSE с effective thinking/reasoning включённым (effort непустой; default high считается включённым). Явные off/none из _map_effort исключают synthetic reasoning даже при долгом запуске. Это явное сужение AC-005: оно относится к thinking-enabled DSH, а fast-answer/off сохраняет текущий contract. Модельные reasoning, если пришли от upstream, не выдумывать/не подменять.\",\n        \"initial\": \"На t>=0.30 при отсутствии уже ОТПРАВЛЕННОЙ непустой real reasoning_content/content delta и незавершённом запросе отправить {reasoning_content:\\\"[мост] Подключение к модели…\\\\n\\\"} с реальным LF, flush. Пробелы и empty keepalive не считаются real progress. При доступной real delta в том же тике сначала обработать очередь, затем проверить grace: fast fake <50ms не получает prefix. Если real text пришёл раньше grace, initial status не нужен — ответ уже видим. Если real reasoning пришёл раньше grace, Think видим без synthetic prefix; отсутствие LF в быстром Simple greeting. не даёт права мутировать текст.\",\n        \"lifecycle\": \"Before first real token eligible quiet request gets first status after grace0.30s, then [мост] Ожидание первого токена… with LF every5.0s. After useful model token, STALL_HEARTBEAT_INTERVAL_S=15.0: when upstream silent>=15.0s, MUST emit [мост] Ожидание продолжения… +LF and repeat every15.0s while stalled, including pause after very first token. Progress resets heartbeat schedule only from model clock; normal127ms delta never gets heartbeat. Synthetic statuses never reset first-event/first-token/stall watchdog clocks or had_output/usage. Single writer, leading LF separator synthetic provenance.\",\n        \"retry\": \"При действительно принятом retry ровно одна отдельная delta [мост] Повтор попытки 2/3… + LF, далее 3/3. Писать до ожидания backoff после retry admission, не при отказе бюджета. Даже после model reasoning статус не конкатенируется в model bytes. Raw model reasonings всех попыток не дедуплицировать; обычный content prefix dedup остаётся. Synthetic status никогда не участвует в _incomplete_tool_step_prompt, model had_output, usage или accumulated raw reasoning. Перед synthetic status применять status_separator: ведущий LF только в synthetic delta после незавершённой model строки, никогда не в model bytes; статус не входит в watchdog/usage/prompt.\",\n        \"pure_reasoning\": \"Склейка model-origin delta равна upstream model bytes после унаследованной очистки известных interrupted artifacts; не добавлять LF для preview, пробелы и UTF-8 не переписывать. _strip_interrupted должен оставаться chunk-boundary-safe: распознанный interrupted marker удерживается/удаляется инкрементально, partial prefix не протекает; обычный текст не нормализуется. В тестах удалять synthetic delta по provenance/expected list, а не слепо вырезать любую модельную строку [мост]. Перед synthetic status применять status_separator: ведущий LF только в synthetic delta после незавершённой model строки, никогда не в model bytes; статус не входит в watchdog/usage/prompt.\",\n        \"regression\": \"test_interrupted_artifact_removed_from_reasoning_stream: быстрая последовательность marker + Simple greeting. -> exactly Simple greeting., один run, zero status. В JSON тоже exactly. Slow FakeServe: first status <=1.0 s при заблокированном upstream; visible(text.strip) true, latestCompletedParagraphFirstLine получает завершённый LF. Natural reasoning LF обновляет collapsed row, bytes неизменны.\",\n        \"replay\": \"_render_turn/_messages_to_prompt (server.py:1848-1888) по-прежнему игнорируют assistant.reasoning_content/reasoning_details. Ни bridge status, ни сырые reasonings не добавляются в повторный prompt. Остаточный межпровайдерский replay в DSH при ручной смене модели описан RISK-011; current bridge ignore не доказывает безопасность чужого provider.\",\n        \"status_separator\": \"Перед любой synthetic [мост] delta, если ранее выданный модельный reasoning chunk не оканчивался LF и текущая видимая строка не завершена, prefix=\\\"\\n\\\"; результат \\\"\\n[мост] ...\\n\\\". Весь prefix/status/trailing LF имеет synthetic provenance, отдельно от immutable model deltas. Если LF уже есть или модельного reasoning ещё не было, status начинается \\\"[мост]\\\" без добавочного LF. Единственный writer отслеживает line boundary; быстрый Simple greeting. до grace вообще не вызывает status helper. Фильтрация synthetic по provenance сохраняет AC-006 байт-в-байт и модельную строку, буквально начинающуюся [мост].\",\n        \"STALL_HEARTBEAT_INTERVAL_S\": 15.0\n      }\n    },\n    {\n      \"id\": \"AD-003\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как ограничить тишину, быстро отменить запрос и не оставить дочерние процессы?\",\n      \"choice\": \"Единый monotonic supervisor обоих транспортов с разными clocks first-event/first-token/stall, отменой на всех ожиданиях и идемпотентным group cleanup.\",\n      \"alternatives\": [\n        \"Только TIMEOUT_S=1800 — сохраняет многоминутный инцидент RC-2.\",\n        \"Watchdog stdout.read/15 s keepalive без socket-check — пропускает зависание после стартового события и поздно видит disconnect.\",\n        \"Убивать только leader proc.kill — оставляет serve/grandchildren и забытые sockets.\"\n      ],\n      \"drivers\": [\n        \"REQ-006\",\n        \"REQ-007\",\n        \"REQ-008\",\n        \"REQ-009\",\n        \"REQ-016\",\n        \"T-LIFE/v1\"\n      ],\n      \"consequences\": [\n        \"Несколько инъектируемых clocks/state, строгий единый writer и owned worker.\",\n        \"Ретраи после частичного вывода могут повторить reasoning; граница отмечается status.\",\n        \"Новые timeout exits транзиентные, budgets/потолки не расширяются.\"\n      ],\n      \"approval_required\": false,\n      \"evidence_ids\": [\n        \"EVD-009\",\n        \"EVD-010\",\n        \"EVD-011\",\n        \"EVD-014\",\n        \"EVD-030\",\n        \"EVD-033\",\n        \"EVD-055\",\n        \"EVD-061\"\n      ],\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py\",\n        \"expected\": \"exit 0; dedicated negative/boundary/fake-transport assertions, плюс VER-001/002 green без расширения потолков\"\n      },\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ],\n      \"details\": {\n        \"thresholds\": {\n          \"FIRST_EVENT_TIMEOUT_S\": 20.0,\n          \"FIRST_TOKEN_TIMEOUT_S\": 60.0,\n          \"STALL_TIMEOUT_S\": 60.0,\n          \"env_prefix\": \"OPENCODE_ZEN_BRIDGE_\",\n          \"validation\": \"положительное finite число; недопустимое -> ошибка старта, не бесконечный timeout\",\n          \"env_classification\": \"Новые диагностические/override env-переменные этого пакета: OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED, OPENCODE_ZEN_BRIDGE_TRANSPORT, OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY, OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE и watchdog overrides OPENCODE_ZEN_BRIDGE_FIRST_EVENT_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S (AD-003). Сам рабочий фичефлаг REALTIME_SERVE_ENABLED переключается boolean в dynamic_config.json без новой env для переключения и без правки start.sh/LaunchAgent; кодовый default=false, включение H7 только после H3/H6.\"\n        },\n        \"clocks\": \"Общий request deadline TIMEOUT_S=1800 якорится на request t0 и не сбрасывается. Local pre-spawn admission<=5.0s, SERVE_READY_TIMEOUT_S=3.0 и create+subscribe<=2.0 имеют отдельные часы до prompt. Для serve first_event20.0 и first_token60.0 начинаются в prompt_send_start перед первым байтом POST /prompt; first_event удовлетворяется только первым валидным SSE событием исполнения created session после этого момента (session.execution.started/session.step.started/session.reasoning.started, либо валидная текущая model delta). HTTP readiness/headers, server.connected/session.created, чужие/global updates, comments, bridge statuses не гасят first_event и не ставят first_event_ms. Headers POST устанавливают только delivered barrier. Для legacy сохраняется first valid run event/step_start от attempt_start перед startup. first_token — только non-whitespace model reasoning/text или полезный model tool intent; started/control/encrypted-only/reject notification не токен. stall стартует после first_token и обновляется полезными model delta/tool progress; empty ping/status не продлевают. first_event_ms и ttft_ms в O-EXIT относительно request t0, timeout ожидания serve first_event относительно prompt_send_start. При accepted prompt + zero session SSE ->first_event_timeout20s +cleanup<=1.2s, <=22s, не ожидание60s.\",\n        \"disconnect\": \"На каждой итерации/ожидании <=0.25 s проверять cancel flag и client socket select + recv(MSG_PEEK|MSG_DONTWAIT): EOF/ECONNRESET -> client_gone без чтения данных и без переключения wfile в nonblocking. Реальная bounded empty OpenAI keepalive каждые <=2.0 s тишины страхует разрыв, который TCP ещё не сигнализировал; write deadline <=0.5 s, без write на отдельном потоке. Poll, status, write и cleanup не блокируют supervisor на 15/5 s. Суммарное обнаружение контролируемого FIN/RST <=5.0 s. Полное исчезновение сети без FIN нельзя доказать одним MSG_PEEK — bounded write/OS transport timeout и fault injection отдельно, не обещать физически невозможный мгновенный детект blackhole.\",\n        \"cleanup\": \"T-LIFE: после cancel/terminal/watchdog/error/overflow/tool step/success в одном finally: запретить новый prompt/spawn; serve interrupt и DELETE с общим cleanup API ceiling 0.20 s (каждый <=0.10 s, ошибки не блокируют kill); close SSE/control sockets для разблокировки reader; SIGTERM сохранённому own PGID даже если proc.poll уже завершён; grace<=0.50 s, затем SIGKILL тому же PGID при наличии; reap leader и join owned readers/writer <=0.50 s суммарно. Запрет blanket pkill, чужих PID и повторного сигнала переиспользованному PGID после подтверждённого cleanup. cleanup идемпотентен и защищён lock; kill также descendant при leader exit (EVD-055). Target watchdog+2 s и disconnect detect<=5 s + cleanup<=2 s, итог orphan-free<=7 s; не сохранять старые wait(15)+join(5)+kill-parent. После child kill/reap обязателен finally verified removal of owned zen-serve-state-* root (XDG_STATE_HOME/TMPDIR), preserve standard XDG_DATA_HOME; закрыть также daemon prompt delivery socket и join его в том же aggregate cleanup<=1.2s. Interrupt/delete только после ownership proof, никогда чужому listener. Fast API interrupt/delete each0.09s plus0.02 scheduling margin aggregate0.20; no lsof/reconnect. Parent closes lifeline_w in finally; killpg(child_pgid) covers helper_proc+serve_proc+descendants in same group. Parent reaps helper_proc, helper reaps serve_proc. Normal join and root/lease deletion share remaining0.50s; parent-dead helper terminal_quiescence before final self-KILL and startup reaper are specified in AD-001.crash_recovery.\",\n        \"retry\": \"Watchdog first_event/first_token/stall -> bounded common retry after full cleanup, _RequestAttempts/MAX_TOTAL_SPAWNS3/FAIL_RETRY_LIMIT/_RetryBudget/Full Jitter как ранее. Но serve-specific no-session-event/invalid_serve_event/EOF классифицируются _ServeHealth и НЕ _UpstreamBreaker; общие provider failures по-прежнему model breaker. При DELIVERED silent run fallback запрещён: retry текущего запроса остаётся явным на закреплённом транспорте, health TTL влияет только на последующие auto requests. Legacy watchdog сохраняет provider semantics. client_gone/fatal4xx/auth/permission ->no retry/fallback. HALF_OPEN owner token жив до завершения/cleanup, cooldown не допускает второй probe; neutral transport failure/cancel освобождает probe без fake provider success/failure. Slot один на запрос, release once; cancel-aware waits<=.25s; Full Jitter capped remaining. Decision table AD-001.fallback_decision_table is authoritative for phases/counter effects, including first_event before/after headers.\",\n        \"telemetry\": \"_new_exit_state устанавливает transport=none, first_event_ms=null, ttft_ms=null до любого early exit. _log_exit на КАЖДОМ do_POST exit ровно один O-EXIT/v1 с transport(run|serve|google|none), first_event_ms и ttft_ms относительно request t0 (без status/keepalive), exit_reason и общими total_spawns/retries; attempt-local timings отдельно для диагностики. Путь с fallback показывает last transport и transport_history=[serve,run], секретов/промпта/endpoint password нет. Новый primary exit_reason не перетирается generic timeout; финальная успешная retry даёт ok + attempt exit history. Все 4 timeout/client codes проверяются на stream и JSON, including exits до попытки. HTTP readiness НЕ first_event_ms: поле null до valid SSE execution current session после prompt_send_start. transport_history фиксирует отказ serve/TTL run или probe без secrets и phantom Popen; отдельный reason для protocol/model/security. early HTTP headers не ставят ни first_event_ms, ни ttft_ms.\"\n      }\n    },\n    {\n      \"id\": \"AD-004\",\n      \"status\": \"APPROVED\",\n      \"kind\": \"two-way\",\n      \"question\": \"Как сохранить инструменты/recovery на мелких дельтах и исправить baseline без ослабления защиты?\",\n      \"choice\": \"Переиспользовать инкрементальный ToolCallParser и существующий recovery, обеспечить canonical native payload; исправить только несовместимые тестовые ожидания и изоляцию.\",\n      \"alternatives\": [\n        \"Копить всё до ended — легче parser/recovery, но вновь ломает realtime RC-1.\",\n        \"Новый regex-parser на каждом delta — теряет разрезанные теги/JSON/UTF-8 и дублирует контракт.\",\n        \"Поднять MAX_TOTAL_SPAWNS до 4 или отключить RetryBudget — скрывает baseline mismatch и нарушает REQ-009.\"\n      ],\n      \"drivers\": [\n        \"REQ-010\",\n        \"REQ-011\",\n        \"REQ-017\",\n        \"AC-015\",\n        \"AC-016\",\n        \"F-47/F-48/F-49\"\n      ],\n      \"consequences\": [\n        \"Минимальное изменение тестов без изменения production limits.\",\n        \"Parser history/open block требует bounded memory; overflow — явный отказ, не silent drop.\",\n        \"Перенос interrupted/step-failure проверок на fake v2 снижает риск transport-specific regressions.\"\n      ],\n      \"approval_required\": false,\n      \"evidence_ids\": [\n        \"EVD-006\",\n        \"EVD-043\",\n        \"EVD-045\",\n        \"EVD-047\",\n        \"EVD-048\",\n        \"EVD-049\",\n        \"EVD-051\",\n        \"EVD-057\"\n      ],\n      \"confirmation\": {\n        \"kind\": \"test\",\n        \"command\": \"cd bridges/opencode-zen-bridge && uvx pytest -q -p no:cacheprovider tests/test_realtime_reasoning.py\",\n        \"expected\": \"exit 0; dedicated negative/boundary/fake-transport assertions, плюс VER-001/002 green без расширения потолков\"\n      },\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ],\n      \"details\": {\n        \"parser\": \"Каждый session.text.delta -> тот же parser.feed без промежуточного whole-step buffer. Outside genuine tool blocks удерживается только pending opener prefix <=max(len(<tool_call>),len(<tool_invoke>))-1=12 chars плюс нужный существующему code-context lookahead; open block удерживается до валидного close, JSON close внутри строки не закрывает блок. Genuine/unparsed/incomplete tool tags не попадают в delta.content: callbacks через _strip_broken_tool_blocks и chunk-safe finish; существующие намеренно цитированные теги в Markdown остаются документационным текстом по текущим parser fixtures (не выполнять их). Инвариант по всем split points и single-character chunks. Open-block/total-output/frame bounds проверяются отдельно, overflow -> explicit error+cleanup.\",\n        \"step\": \"Accumulated raw text/reasoning/native + step.ended tokens -> _is_incomplete_tool_step/_incomplete_step_signal и _is_transient_stream_error. При step.ended с готовым вызовом немедленно завершить upstream, finish_reason=tool_calls; не пропускать SYNTHETIC Continue. Error до первого model output допускает bounded recovery upstream как legacy; поздняя transient error прерывает attempt, fatal 400/401/403/404/422 без retry. Bridge status не изменяет attempt_output/first_token/had_error. _strip_interrupted и _strip_broken_tool_blocks работают независимо от границ delta. Native called.data.input absent: input.ended.data.text parsed once as complete JSON supplies tool arguments even streaming→failed. permission reject/form cancel latch single-turn barrier BEFORE control; immediately interrupt and return mapped tools or existing recovery, never Step2 output.\",\n        \"baseline_tests\": \"В TestStepInterruptionLive.setUp заменить self.httpd.resilience на новый _Resilience (либо новый _RetryBudget с инъектируемыми часами + reset breaker/limiter), только когда прошлый request завершён, тесты класса последовательны. Ничего не сбрасывать в prod. В двух unmapped_retries_do_not_exhaust_incomplete_budget_{json,stream} оставить текущую fixture: первые 2 попытки unmapped, третья status/promise, 4-я запрещена. Ожидать runs==3, отсутствие tool_calls, finish_reason=stop, status/prelude ровно один раз; не ждать job_output/bash с несуществующего 4-го spawn. Добавить отдельный reachable<=3 сценарий unmapped -> incomplete -> calls и/или unit-oracle независимости счётчиков. Test_unmapped_then_error_stops_proc_json ожидает 2 и не зависит от предыдущих токенов бюджета. Все 17 legacy modules плюс новые tests green; production MAX_TOTAL_SPAWNS=3 не меняется.\",\n        \"red_green\": \"Сначала dedicated tests на текущем коде: реальный socket read до release upstream Event, slow initial status, watchdog/cleanup и native delta split. Зафиксировать red (не import error), после Stage 3 green в VER-005 и полном VER-001/002. Stage 2 тестовый код не пишет и зелёное выполнение этой будущей поверхности не заявляет. AC-026 / VER-005 / Clean-Room L2: tests/test_realtime_reasoning.py создаёт tmp_path / \\\"dynamic_config.json\\\" с {\\\"REALTIME_SERVE_ENABLED\\\":true}; monkeypatch.setattr(server, \\\"DYNAMIC_CONFIG_PATH\\\", cfg_path, raising=False). При переносе только этого testfile на непропатченный origin/dev нет AttributeError: реально POST /v1/chat/completions, RED именно на поведенческих realtime chunk intervals (чтение socket до upstream release), GREEN на новом коде. Та же Server instance: атомарно false в cfg_path ->следующий запрос run без restart; true ->serve при test eligibility override/native, deletion/invalid JSON/nonbool/unreadable ->false; unchanged (st_mtime_ns,st_size) ->нет reopen. Новый cfg stat key для переключения обеспечивается и проверяется тестом, без sleep-предположений. Existing378 tests не создают JSON и остаются run. Runtime результаты NOT_RUN.\"\n      }\n    }\n  ],\n  \"quality_scenarios\": [\n    {\n      \"id\": \"QA-001\",\n      \"quality\": \"performance\",\n      \"source\": \"DSH client\",\n      \"stimulus\": \"upstream выпускает каждые150ms 10 reasoning delta и держит stream open\",\n      \"environment\": \"здоровый FakeServe/локальный socket\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"writer flush до upstream terminal\",\n      \"response_measure\": \"10 чанков получены до release Event; interarrival<500ms; bridge delay<=250ms\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-002\",\n      \"quality\": \"usability\",\n      \"source\": \"DSH thinking-enabled client\",\n      \"stimulus\": \"cold start молчит/ждёт gate\",\n      \"environment\": \"медленный upstream\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"grace status с LF, потом lifecycle status\",\n      \"response_measure\": \"first visible<=1.0s, grace=.30s, без статусов на fast fake и off\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-003\",\n      \"quality\": \"compatibility\",\n      \"source\": \"legacy fake CLI\",\n      \"stimulus\": \"fake script игнорирует argv и блокируется на stdin.read\",\n      \"environment\": \"auto с кодовым default=false; runtime dynamic_config.json=true после H7/H3/H6 + native eligibility; explicit env disabled/run/disable-file/TTL ->run\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"один run без serve probe, reasoning exact Simple greeting.\",\n      \"response_measure\": \"all17 modules green; runs==1, no synthetic prefix для fast fixture\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\",\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-004\",\n      \"quality\": \"reliability\",\n      \"source\": \"upstream\",\n      \"stimulus\": \"no event/no token/stall\",\n      \"environment\": \"управляемые clocks/Events и hard silence\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"watchdog classification+bounded retry\",\n      \"response_measure\": \"20/60/60 config, scaled tests, timeout+2s cleanup и spawns<=3\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-005\",\n      \"quality\": \"reliability\",\n      \"source\": \"DSH Stop/FIN\",\n      \"stimulus\": \"отключение при gate/read/prompt/дельтах\",\n      \"environment\": \"активные children/grandchildren\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"cancel->close->killpg->reap\",\n      \"response_measure\": \"detect<=5s, orphan-free<=7s, slots/readers/sockets0\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-006\",\n      \"quality\": \"security\",\n      \"source\": \"модель/враждебный upstream\",\n      \"stimulus\": \"native tools пытаются писать файл или запросить allow\",\n      \"environment\": \"serve loopback с listener owner proof, default ask_reject или explicit deny\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"никогда allow, native event -> DSH tool tuple\",\n      \"response_measure\": \"fake permission requests reject; false flag no secret allocation; live H6 отдельно\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-007\",\n      \"quality\": \"operability\",\n      \"source\": \"оператор\",\n      \"stimulus\": \"любая terminal/early exit/успешный retry\",\n      \"environment\": \"SSE или JSON, valid/malformed request\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"одна O-EXIT/v1 строка без secrets\",\n      \"response_measure\": \"transport/first_event_ms/ttft_ms/exit_reason присутствуют; null не подделывается0\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-008\",\n      \"quality\": \"testability\",\n      \"source\": \"clean-room verifier\",\n      \"stimulus\": \"clone не содержит ~/.dsh и новый transport fake\",\n      \"environment\": \"Python>=3.11 stdlib tests\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"каждый VER полностью воспроизводим\",\n      \"response_measure\": \"VER001..005 exit0 после Stage3, без owner home и Zen calls\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-002\",\n        \"VER-003\",\n        \"VER-004\",\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    },\n    {\n      \"id\": \"QA-009\",\n      \"quality\": \"cost\",\n      \"source\": \"6 parallel requests\",\n      \"stimulus\": \"103KB prompt и fragmented output\",\n      \"environment\": \"design envelope single-process\",\n      \"artifact\": \"bridges/opencode-zen-bridge/server.py\",\n      \"response\": \"resource manager bounds and overload\",\n      \"response_measure\": \"Design:1*256+6*192=1408<=1638.4 MiB. H3 измеряет parent+6*child actual RSS и отсутствие database is locked на103KB×6×3; без H3 runtime PASS отсутствует.\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ],\n      \"analyst_qa_ref\": \"analysis/zen-realtime-reasoning/handoff-qa.md (QA IDs там отдельный исходный namespace)\"\n    }\n  ],\n  \"boundaries\": [\n    {\n      \"id\": \"BND-001\",\n      \"component\": \"Handler._stream_sse / Handler._serve_json\",\n      \"responsibility\": \"OpenAI framing/один SSE writer; display-status только stream; _serve_json сохраняет model output без synthetic status\",\n      \"allowed_dependencies\": [\n        \"common canonical source\",\n        \"pure tool/recovery helpers\",\n        \"per-Server resource manager\"\n      ],\n      \"forbidden_dependencies\": [\n        \"DSH bundle/config writes\",\n        \"raw serve events в public ответе\",\n        \"новые Google behavior\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"BND-002\",\n      \"component\": \"managed serve/run source + per-Server resource manager\",\n      \"responsibility\": \"Transport selection, listener PID/PGID proof до Auth/prompt, fresh _serve_env/proxy и OPENCODE_DB=:memory:, standard read-only auth data and owned state/temp dirs, bounded HTTP/SSE/delivery leases, canonical wire adapter и cleanup\",\n      \"allowed_dependencies\": [\n        \"stdlib http.client/socket/subprocess/queue/threading/secrets\",\n        \"_run_env/_RequestAttempts/_StartupGate\",\n        \"pure event adapter\"\n      ],\n      \"forbidden_dependencies\": [\n        \"wfile/client content writes\",\n        \"внешние Python dependencies\",\n        \"shared daemon/общий opencode config/db writes\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"BND-003\",\n      \"component\": \"ToolCallParser / recovery / normalize boundary\",\n      \"responsibility\": \"Чистое инкрементальное преобразование text/native/events и interruption-safe accumulated reasoning\",\n      \"allowed_dependencies\": [\n        \"compiled regex/stdlib json\",\n        \"tools клиента и primitive event payload\"\n      ],\n      \"forbidden_dependencies\": [\n        \"network/process access\",\n        \"global retry resets\",\n        \"модификация model bytes для UI\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"BND-004\",\n      \"component\": \"_Resilience/_RequestAttempts\",\n      \"responsibility\": \"Общий process bulkhead/rate/retry budget/model breaker; отдельно _ServeHealth для protocol-specific failures, per-request cap/deadline и prompt delivered barrier\",\n      \"allowed_dependencies\": [\n        \"injected monotonic/RNG\",\n        \"locks\"\n      ],\n      \"forbidden_dependencies\": [\n        \"new independent transport retry budget\",\n        \"production budget reset between requests\",\n        \"cross-provider fallback\"\n      ],\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    }\n  ],\n  \"contract_deltas\": [\n    {\n      \"id\": \"CD-001\",\n      \"type\": \"behavior\",\n      \"producer\": \"bridge SSE presentation\",\n      \"consumer\": \"DSH OpenAI completion reader\",\n      \"change\": \"Grace=.30s synthetic [мост] status delta с LF для thinking-enabled slow/retry lifecycle; fast/off/JSON не получают prefix. Разрешено текущим Brief AD-002 и REQ-004/005. Mandatory eligible stall heartbeat threshold=interval15.0s even after first token; pre-token heartbeat5.0s; reasoning provenance and leading LF unchanged.\",\n      \"compatibility\": \"OpenAI chunk shape/finish/usage unchanged; no unconditional t0 status; user fast exact reasoning equality preserved. REQ004 scoped to thinking-enabled, real content раньше grace уже видим.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"CD-002\",\n      \"type\": \"behavior\",\n      \"producer\": \"transport supervisor\",\n      \"consumer\": \"OpenAI caller and O-EXIT logs\",\n      \"change\": \"Конечные first_event/first_token/stall deadlines и fast cancellation с error той же формы; telemetry fields и exit reasons по REQ006..009/016. Для нового enabled serve path byte-bound explicit overflow, без silent loss.\",\n      \"compatibility\": \"Endpoints/status/error schema и Google path unchanged; многоминутная тишина намеренно прекращается; kill-switch отключает новый serve, watchdog/status для legacy остаются исправлением RC2/RC3.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-003\",\n        \"VER-005\"\n      ]\n    }\n  ],\n  \"views\": [\n    {\n      \"id\": \"VIEW-001\",\n      \"type\": \"context\",\n      \"question\": \"Кто общается с мостом и какая граница остаётся внешней?\",\n      \"artifact_ref\": \"architecture/architecture-packet.json#scope + boundaries BND-001; F-35\"\n    },\n    {\n      \"id\": \"VIEW-002\",\n      \"type\": \"container\",\n      \"question\": \"Какие processes/sockets являются изолированным failure domain?\",\n      \"artifact_ref\": \"architecture/architecture-packet.json#AD-001.details.spawn/session_flow + high_load_envelope.operational_profile\"\n    },\n    {\n      \"id\": \"VIEW-003\",\n      \"type\": \"dynamic\",\n      \"question\": \"Как status/watchdog продолжают работать во время setup/retry/молчания?\",\n      \"artifact_ref\": \"architecture/architecture-packet.json#AD-002/003.details + resilience_gates.dependency_failure_matrix\"\n    },\n    {\n      \"id\": \"VIEW-004\",\n      \"type\": \"dfd\",\n      \"question\": \"Где проходят auth/secret/tool-action trust boundaries?\",\n      \"artifact_ref\": \"architecture/architecture-packet.json#threat_model + AD-001.details.tool_policy/fallback_barrier\"\n    }\n  ],\n  \"risks\": [\n    {\n      \"id\": \"RISK-001\",\n      \"scenario\": \"deny удаляет tool schema, Zen403 или ask непреднамеренно исполняет tool\",\n      \"probability\": \"high\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Default ask_reject в отдельном _serve_env поверх byte-identical _run_env; wire permission.asked ->decision=reject немедленно, never once/always/allow. Env deny поддержан без пересборки, без automatic policy fallback. 401/403/нет safe endpoint fail-closed; FakeServe обе policy, реальный H6 обязателен.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-002\",\n      \"scenario\": \"Proxy env не означает фактическую per-request clean IP ротацию через loopback georouter\",\n      \"probability\": \"medium\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Сохранять per-spawn _next_standalone_proxy env через неизменный _run_env; AC-018 проверяет последовательность записей пула. baseURL=http://127.0.0.1:10830/v1 georouter обходит child HTTP_PROXY по NO_PROXY (F-15/F-27); новый child не доказывает новую Zen IP. Shared daemon не выбирать ради failure isolation, не ради недоказанной egress ротации; конфиг georouter вне scope.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-003\",\n      \"scenario\": \"6 serve на sqlite2.27GB/192MiB оценке создают lock/memory spike\",\n      \"probability\": \"medium\",\n      \"impact\": \"high\",\n      \"mitigation\": \"OPENCODE_DB=:memory:, standard XDG_DATA_HOME/auth preserved, owned state/temp finally+crash reaper; EVD-071 zero common DB opens. H3 actual parent+all6serve/pairedhelpers/lsof<=1638.4MiB and zero locks on103KB×6×3; real auth not proven by provider-free access. disable-file retained on FAIL, no slot/retry increases.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-004\",\n      \"scenario\": \"Fast fake probe увеличит run counter или блокируется stdin\",\n      \"probability\": \"high\",\n      \"impact\": \"high\",\n      \"mitigation\": \"При отсутствующем runtime config default=false ->run для378baseline. При enabled auto shebang ->one run без subprocess probes. Force serve stdinDEVNULL, ready<=3.0s/cancel-aware; первый kill-switch/TTL guard обязателен. Executable cache path+mtime_ns+size; config cache mtime_ns+size, invalid/missing boolean ->false с redacted warning. Exact counter regressions сохранены.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-005\",\n      \"scenario\": \"Расщеплённые marker/tool/UTF8 или ended duplicate искажают reasoning/usage\",\n      \"probability\": \"medium\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Canonical delta-only assembler, incremental scrubber, all split points, step-id dedup/native-call-id dedup; end barrier independent terminal.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-006\",\n      \"scenario\": \"Корректный early-error upstream сам восстанавливается, но bridge status пометит had_output\",\n      \"probability\": \"medium\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Status provenance отдельно от model counters, no had_output/clock reset; exact legacy early_error tests + FakeServe variant.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-007\",\n      \"scenario\": \"Квота Zen/103KB TTFT/DSH rendering пока не проверены\",\n      \"probability\": \"high\",\n      \"impact\": \"high\",\n      \"mitigation\": \"F23 observation может устареть; не утверждать текущую квоту, H0..H9 live acceptance после rollout. FakeSuite не заменяет UI/реальный egress.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-008\",\n      \"scenario\": \"Полный lint/type gate красный до изменения\",\n      \"probability\": \"high\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Decode wire JSON as object with isinstance narrowing/TypedDict; new code no Any/casts-to-Any/type-ignore. VER-004 uses isolated bridge cwd + temporary include/extraPaths: all3 errorCount==0, new test0diagnostics, server Any<=125each/nonAny per-rule and total<=720, step<=194; changed legacy code0reportAny/reportExplicitAny/reportUnusedCallResult. Preserve public module attribute server.CATALOG_SOURCE and HTTP catalog_source: module-level CATALOG_SOURCE = \\\"static\\\", never rename it or external test references. Replace reload_catalog global CATALOG_SOURCE/reassignment with typed def _set_catalog_source(source: str) -> None: globals()[\\\"CATALOG_SOURCE\\\"] = source; keep only _catalog_mtime/_catalog_ids in reload_catalog global declaration. Preserve existing static import zen_catalog as zc at original server.py:67 (the sole inherited E402 site); guard proc is not None before both final stream .returncode reads. EVD-076 observed errorCount0 without # type: ignore; tests/test_catalog_mode.py:64,93 unchanged,8tests PASS on copy. coder_target_files remains exactly3; no config/dependency/new module. Full all3 Stage3 gate NOT_RUN. Ruff==0.17.2 legacy ranges use only --range={start}:1-{end}:999; reject any old/new diff hunk intersecting _run_env/_stream_google_sse/_execute_google_once and check their literal raw hashes before and after formatter. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv. EVD-076 static-import server warningCount564/reportAny125, EVD-077 full local block exit0 with catalog8/8; source init→static transition is probe-only. Actual Stage3 NOT_RUN. Write-mode range formatting must run on disposable candidate copy and assert_frozen(copy), never write product during architecture probe.\",\n      \"verification_ids\": [\n        \"VER-004\"\n      ]\n    },\n    {\n      \"id\": \"RISK-009\",\n      \"scenario\": \"Prompt POST timeout уже после принятия способен удвоить generation при silent fallback\",\n      \"probability\": \"medium\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Текущий brief RW-001 выбирает HTTP response headers / первый current-session execution event как delivered barrier, вместо R1 начала POST. До headers и без события ServeUnavailable может fallback после полного kill/reap старого PGID; remote generation могла уже начаться, exactly-once не обещать. После barrier silent run запрещён; только явный same-transport retry+status/cap, no builtin execution. Source disagreement записан в panel_resolution_choices.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-010\",\n      \"scenario\": \"SIGTERM/leader exit оставляет descendant, старый cleanup ждёт15+5с\",\n      \"probability\": \"high\",\n      \"impact\": \"high\",\n      \"mitigation\": \"Normal cleanup<=1.2s; SIGKILL/kickstart-k outside finally protected by parent-pipe helper + safe startup lease reaper. Persist child identity before prompt; validate owner/ps start-time/PGID/cmd/inode and foreign-process negative tests. H0/H9 actual orphan sweep NOT_RUN.\",\n      \"verification_ids\": [\n        \"VER-001\",\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-011\",\n      \"scenario\": \"Статусы [мост] сохраняются DSH и при ручном переключении модели могут попасть reasoning_content другого provider (F-33/F-38/F-39)\",\n      \"probability\": \"medium\",\n      \"impact\": \"medium\",\n      \"mitigation\": \"Принятый остаточный риск: current bridge игнорирует весь replay reasoning, но чужой provider этого не обязан делать. Короткие статусы только grace/реальное ожидание не чаще5s и один на retry, no secrets/prompt text. Не менять DSH/provider контракты; уменьшить объём синтетики. Fake replay проверяет только этот мост, cross-provider H4 наблюдение не заменяет гарантии.\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    },\n    {\n      \"id\": \"RISK-012\",\n      \"scenario\": \"Serve SSE/protocol деградация ошибочно открывает общий model breaker и блокирует рабочий run\",\n      \"probability\": \"high\",\n      \"impact\": \"high\",\n      \"mitigation\": \"_ServeHealth threshold3/TTL120/one recovery probe для новых auto requests, protocol failure не _UpstreamBreaker. Current accepted prompt не переигрывать скрыто. Fake5requests + expiry/probe/version-change cases; настоящие provider429/5xx сохраняют model breaker.\",\n      \"verification_ids\": [\n        \"VER-005\"\n      ]\n    }\n  ],\n  \"threat_model\": {\n    \"required\": true,\n    \"assets\": [\n      \"промпт и история владельца\",\n      \"ключ моста, пароль serve и proxy credentials\",\n      \"локальные файлы и процессы\",\n      \"квота Zen и ресурсы станции\"\n    ],\n    \"trust_boundaries\": [\n      \"DSH -> bridge OpenAI HTTP (auth без изменений)\",\n      \"bridge -> одноразовый loopback serve Basic Auth\",\n      \"serve -> georouter/Zen через унаследованный per-spawn env\",\n      \"модель -> запрос инструмента: исполнение только в DSH\"\n    ],\n    \"threats\": [\n      {\n        \"id\": \"THREAT-001\",\n        \"scenario\": \"Подмена локального serve listener и утечка пароля/промпта или сигнал чужому процессу\",\n        \"mitigation\": \"Родитель резервирует 127.0.0.1:0 и запускает только helper_proc с argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...], start_new_session=True; child_pgid=helper_proc.pid. Helper устанавливает EOF/TERM надзор до spawn, атомарно публикует lease и запускает serve_proc с start_new_session=False в той же группе child_pgid; публикует serve_pid/serve_lstart до handshake/READY. --serve-helper <attempt_id> находится в первых аргументах ps -ww argv. До отправки любых Authorization/пароля или prompt обязательны одновременно listener_pid == serve_pid, os.getpgid(listener_pid) == child_pgid и helper_proc.poll() is None; ровно один lsof с бюджетом <=0.35s внутри общего ready<=3.0s. На mismatch/timeout/неоднозначность 0 байт Authorization/пароля/prompt, fail-closed, retry только внутри исходного ready/cap3 после cleanup. Cleanup os.killpg(child_pgid, SIGTERM→SIGKILL) охватывает подтверждённые собственные helper + serve + потомков, с lifeline/reap/root+lease cleanup по crash_recovery; чужой PID в той же или иной группе получает 0 байт пароля и 0 сигналов чужому PGID. Секреты только sanitized env, без argv/lease/log; no redirects/proxy. Normal Keep-Alive control path не вызывает повторный lsof; отдельный explicit reconnect имеет собственный proof, как listener_ownership.\",\n        \"verification_ids\": [\n          \"VER-005\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-002\",\n        \"scenario\": \"Исполнение builtin tools или Step2 до отмены формы/отказа инструмента DSH\",\n        \"mitigation\": \"Default OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY=ask_reject; _serve_env вызывает неизменный _run_env ровно один раз и sanitizes все3 ветки, permission={\\\"*\\\":\\\"ask\\\"}, session effect=ask; никогда allow/once/always. permission.asked своей сессии ->single-turn barrier, decision=reject<=0.25s, затем interrupt<=0.10s, не ждать prompt completion. deny selectable до attempt, никогда auto-switch/разрешение или silent run fallback после delivered; unsupported capability/policy ->fail-closed. For form.created first inspect nested data.form object: if data.form.sessionID==active_session_id and data.form.id is a nonempty string, latch single-turn/Step2 barrier and IMMEDIATELY send POST /api/session/{id}/form/{formID}/cancel on retained control lane<=0.25s, then interrupt<=0.10s, BEFORE validating title/fields/metadata or emitting invalid_serve_event. EVD-073 source Form.Info requires id,sessionID,title,fields (only root metadata optional; field-level title/required optional). Missing root title is a schema discrepancy but safety cancel is authoritative: successful cancel+interrupt completes normal cancelled attempt with ServeHealth+0/UpstreamBreaker+0, no watchdog60s wait and no Step2. This does not relabel source title optional. Missing/invalid id or sessionID ->immediate fail-closed(no foreign cancel); cancel failure/control disconnect ->immediate fail-closed; parent finally killpg(child_pgid) completes<=1.2s, no watchdog wait. Valid foreign nested sessionID ignored with0foreigncontrol. form.cancelled.data.id/sessionID settles only same owned form; not model token or first-event. Полный single_turn_control.order авторитетен: raw tool args/input.ended fallback сохраняются, готовый mapped call возвращается ровно один раз finish_reason=tool_calls, иначе существующее recovery в cap3; никакого Step2. _run_env, tests/test_run_env.py побайтно неизменны. EVD-050 + [F-08] обосновывают выбор ask_reject; FakeServe не доказывает живую Zen-совместимость или запрет записи, это H6 NOT_RUN.\",\n        \"verification_ids\": [\n          \"VER-005\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-003\",\n        \"scenario\": \"Unrestricted parent env утекает в serve или proxy creds в ошибку\",\n        \"mitigation\": \"_run_env only standalone branch whitelists; opencode-go/static inherit parent env baseline. New _serve_env filters exact allowlist on ALL3 branches before generated password/DB/state values, preserving only required routing/catalog/proxy/auth paths. OPENCODE_ZEN_BRIDGE_* and arbitrary API_KEY/TOKEN/SECRET sentinels absent; config/log/lease redacted. See AD-001.serve_env_sanitization; VER-005 branch matrix. _run_env remains byte-identical.\",\n        \"verification_ids\": [\n          \"VER-005\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-004\",\n        \"scenario\": \"SSE из чужой session или reconnect replay приводит к чужому выводу/повтору инструмента\",\n        \"mitigation\": \"Filter exact data.sessionID и own prompt-send generation boundary; session v2 не даёт executionID, не ожидать выдуманного поля. subscribe armed before prompt, no transparent reconnect/replay after delivered; event id + assistantMessageID step/call id dedup; no foreign/raw events in public stream.\",\n        \"verification_ids\": [\n          \"VER-005\"\n        ]\n      },\n      {\n        \"id\": \"THREAT-005\",\n        \"scenario\": \"Отмена клиента/oversized frame держит процессы и позволяет resource exhaustion\",\n        \"mitigation\": \"bounded byte queue/frame/output and slots/waiters, finite per-operation deadlines, own PGID forced cleanup, zero orphan tests; output overflow не дропается молча. Crash leases + parent-pipe helper + startup reaper with uid/pid/pgid/start_ts/command/inode verification; no foreign signals/name-wide cleanup.\",\n        \"verification_ids\": [\n          \"VER-005\"\n        ]\n      }\n    ]\n  },\n  \"evolution\": {\n    \"compatibility\": \"Existing public endpoints/schema/Google unchanged; run fallback retained. OPENCODE_DB=:memory: и standard auth/models/config сохранены. Кодовый default=false и отсутствие runtime JSON в git гарантируют378baseline по run; native auto включается атомарным runtime true только на H7 после H3/H6, без start.sh/restart и без новых env-переменных для самого фичефлага; диагностические/override env пакета перечислены отдельно в AD-001/AD-003.\",\n    \"migration\": \"No product DB migration. serve child SQLite memory only; never read/write/migrate shared opencode.db/opencode-next.db. Owned zen-serve-state-* dirs and UID registry leases are transient control state removed normally/following crash-safe reaper. Standard XDG_DATA_HOME/auth.json kept read-only.\",\n    \"rollout\": \"Все H0..H9 NOT_RUN, external a5/r9 ACCEPT+panel proof и независимые VER gates обязательны; Architect не выполняет rollout. H0 BLOCKING до sync/restart: проверить текущий env не force serve/true, отсутствие production dynamic_config.json либо boolean false; при прежнем enabled состоянии атомарно записать false, проверить read-back; дополнительный disable-serve разрешён. Снять старые PID/start/lease identity. H4 sync/read-back server.py hash; H5 launchctl kickstart с config absent/false: сразу dark run без окна serve; startup reaper0 старых собственных serve/helper/temp roots, чужие процессы untouched. На отдельном кандидате test-local dynamic_config.json=true и отдельный disable-file path: provider-free info/active, H3 реальные6parallel RSS/FD+OPENCODE_DB=:memory:, H6 live permission/tool isolation, Stage3a/A затем3b/B. На production до H7 run. H7 ТОЛЬКО после PASS H3 и H6: при env auto без explicit false и закрытом TTL подготовить tempfile в ~/.dsh/bridges/opencode-zen-bridge/,0600, записать {\\\"REALTIME_SERVE_ENABLED\\\":true}, os.replace в dynamic_config.json; убедиться дополнительный disable-serve отсутствует. Следующий native auto запрос на :9883 использует serve без правки start.sh и без повторного рестарта LaunchAgent. H8 повторяет живые проверки рабочего чата, H9 проверяет runtime false/true и disable-file same PID, отдельно kickstart-k crash recovery. Никакой выдачи design/NOT_RUN за runtime PASS. H4 uses ONLY cp bridges/opencode-zen-bridge/server.py ~/.dsh/bridges/opencode-zen-bridge/server.py, then SHA-256 read-back. Never rsync --delete or directory sync. Preserve live dynamic_config.json and disable-serve byte-for-byte (or their recorded absence) from H0 snapshot AFTER any intentional H0 false-write; H0/H4 read back existence/bytes/mode after cp. H5 restarts only after that preservation check; no copy/delete/overwrite of either runtime file. Default=false and true only H7 after H3/H6, no new owner waiver required.\",\n    \"rollback\": \"Runtime kill-switch без рестарта: атомарно tempfile+os.replace mode0600 записать {\\\"REALTIME_SERVE_ENABLED\\\":false} в ~/.dsh/bridges/opencode-zen-bridge/dynamic_config.json; либо удалить файл (default=false), либо создать disable-serve. Следующий auto запрос run без serve probes/allocations. Цель selector overhead <1мс проверяется VER-005/H9; это не измеренная гарантия задержки файловой записи/планировщика. Существующий explicit env=true имеет заданный override приоритет: в таком диагностическом процессе использовать disable-file для безусловного runtime rollback; production H0/H7 требуют auto без override. Env false/no/off/0 или TRANSPORT=run также force run, но изменение env живого процесса требует restart. In-flight leases drain/cancel, DELIVERED prompt не повторяется на run. H9 проверяет same PID, transport_history и повторные/параллельные вызовы; kickstart-k отдельно с config false/absent и identity-verified owned reaper. Stage2 ничего не деплоит. Все H0..H9 NOT_RUN.\",\n    \"feature_flag\": \"Кодовый дефолт REALTIME_SERVE_ENABLED=false. Локальный runtime dynamic_config.json — stdlib-аналог dynamic_config.py/GigaRC автономного моста без внешних зависимостей: H0 отсутствие файла или boolean false удерживает run; H7 атомарно включает true только после успешных H3 (6 параллельных слотов RSS/FD с OPENCODE_DB=\\\":memory:\\\") и H6 (живая permission/tool изоляция на кандидате). Без исключений из канона или human waiver; без новых env-переменных для самого фичефлага REALTIME_SERVE_ENABLED через dynamic_config.json и без правок start.sh/LaunchAgent; никакой записи dynamic_config.json в git. Новые диагностические/override env-переменные этого пакета: OPENCODE_ZEN_BRIDGE_REALTIME_SERVE_ENABLED, OPENCODE_ZEN_BRIDGE_TRANSPORT, OPENCODE_ZEN_BRIDGE_SERVE_PERMISSION_POLICY, OPENCODE_ZEN_BRIDGE_SERVE_DISABLE_FILE и watchdog overrides OPENCODE_ZEN_BRIDGE_FIRST_EVENT_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_FIRST_TOKEN_TIMEOUT_S, OPENCODE_ZEN_BRIDGE_STALL_TIMEOUT_S (AD-003). Сам рабочий фичефлаг REALTIME_SERVE_ENABLED переключается boolean в dynamic_config.json без новой env для переключения и без правки start.sh/LaunchAgent; кодовый default=false, включение H7 только после H3/H6.\",\n    \"H3_rollout_gate\": {\n      \"status\": \"NOT_RUN\",\n      \"scenario\": \"6 parallel реальных рабочих prompt около103KB +7th overload,3повтора; изолированный candidate перед production sync и повтор на боевом после safety допуска\",\n      \"memory_unit\": \"MiB\",\n      \"memory_inequality\": \"actual_parent_RSS + sum(RSS_serve + RSS_python3_I_helper + RSS_bounded_lsof_or_ps_probe_peak over M=6) <=0.80*2048=1638.4MiB; fixed192MiB combined/slot. Serve idle156.8+helper~12+probe~8=176.8MiB estimate only; no omitted helper/probe/load overhead.\",\n      \"database_gate\": \"OPENCODE_DB=:memory:,0 shared SQLite opens/writes (lsof + disk identity snapshot);0database is locked/SQLITE_BUSY across6parallel×3; valid opencode-go auth without false401 tested separately from provider-free readiness.\",\n      \"other_evidence\": \"Реальные RSS/FD/CPU/TTFT каждого запроса, parent/child peaks, все owned temp dirs удалены, zero orphan PGID; design child192MiB не подставлять вместо замера Include lsof one per spawn, helper/watchdog PIDs,18 admitted handler threads (6active+12waiters), consistent12 drains, observed FD/thread peaks and transport diagnostics. /api/info+active provider-free first; measured ready120.7ms is baseline not guarantee. Same tree helper_proc(new session leader)->serve_proc(same child_pgid). Record<=19total processes,55admitted parent threads,transient parentFD<=128 and344aggregate design; helper EOF single-thread and both lifeline ends accounted. Exceedance fails H3,not waiver.\",\n      \"on_fail\": \"Rollout enable запрещён: runtime config остаётся absent/false (и дополнительный disable-file остаётся, если поставлен). Не повышать slots6/12/retrycap3 и не менять shared env/config/DB.\"\n    },\n    \"H0_precondition\": {\n      \"status\": \"NOT_RUN\",\n      \"blocking\": true,\n      \"ordered_steps\": [\n        \"verify production TRANSPORT=auto and no explicit enabled env override\",\n        \"verify dynamic_config.json absent or boolean REALTIME_SERVE_ENABLED=false; if enabled atomically write false0600 and read-back before sync/restart\",\n        \"optional additional disable-serve; preserve recorded safety state\",\n        \"H0 snapshot exact bytes/hash/existence/mode of dynamic_config.json and disable-serve after intentional safety false-write; H4/H0 read-back same state after copying ONLY server.py.\",\n        \"capture old PID/start/leases\",\n        \"H4 sync candidate bytes/read-back hash\",\n        \"H5 kickstart-k in dark run; reaper0 previous own serve/helper/temp roots\",\n        \"candidate H3 six parallel RSS/FD memoryDB and H6 permission/tool isolation PASS before H7\",\n        \"H7 atomic tempfile+os.replace0600 runtime true; remove optional disable-file only at this enable gate; no start.sh change/restart\"\n      ],\n      \"owner\": \"rollout operator; not Architect\"\n    },\n    \"H9_crash_recovery_gate\": {\n      \"status\": \"NOT_RUN\",\n      \"scenario\": \"Same live bridge PID: atomic runtime config false ->run, true ->serve при native+healthy, file deletion ->run; disable-serve дополнительно always run. Подтвердить selector overhead<1мс фактом, не обещанием. Отдельно parent hard kill/kickstart-k с active serve и последующий startup reaper:0 собственных orphan serve/helper/temp roots, чужие PID/PGID untouched.\"\n    },\n    \"H4_H5_sync_contract\": {\n      \"status\": \"NOT_RUN\",\n      \"copy_command\": \"cp bridges/opencode-zen-bridge/server.py ~/.dsh/bridges/opencode-zen-bridge/server.py\",\n      \"forbidden\": [\n        \"rsync --delete\",\n        \"directory-wide sync\",\n        \"copy/delete/overwrite live dynamic_config.json\",\n        \"copy/delete/overwrite disable-serve\"\n      ],\n      \"preservation_gate\": \"H4 uses ONLY cp bridges/opencode-zen-bridge/server.py ~/.dsh/bridges/opencode-zen-bridge/server.py, then SHA-256 read-back. Never rsync --delete or directory sync. Preserve live dynamic_config.json and disable-serve byte-for-byte (or their recorded absence) from H0 snapshot AFTER any intentional H0 false-write; H0/H4 read back existence/bytes/mode after cp. H5 restarts only after that preservation check; no copy/delete/overwrite of either runtime file. Default=false and true only H7 after H3/H6, no new owner waiver required.\",\n      \"H5\": \"launchctl kickstart only after H0/H4 copied server hash and both runtime file preservation checks; false/dark until H7\"\n    }\n  },\n  \"approval\": {\n    \"status\": \"NOT_REQUIRED\",\n    \"decision_ids\": [],\n    \"approved_by\": null,\n    \"evidence_ref\": null,\n    \"rationale\": \"FU-007 закрыт без исключений из канона: кодовый дефолт REALTIME_SERVE_ENABLED переведён в false, а включение на :9883 выполняется через локальный runtime dynamic_config.json (stat mtime_ns кэш без рестарта и без правки start.sh) строго на шаге H7 после прохождения H3/H6. Все AD обратимы (two-way); status=APPROVED означает валидированный архитектурный пакет-кандидат для Архитектурного Совета a5 (r9), а не вердикт Совета.\"\n  },\n  \"independent_review\": {\n    \"required\": false,\n    \"status\": \"NOT_REQUIRED\",\n    \"reviewer\": null,\n    \"evidence_ref\": null,\n    \"rationale\": \"S2 schema NOT_REQUIRED is unchanged; downstream external a5/r9 Council/proof mandatory. Author issues no Council PASS. a4 NEEDS_WORK is input history; revision v5 is internally ready for external re-review only.\"\n  },\n  \"open_questions\": [\n    {\n      \"id\": \"Q-001\",\n      \"question\": \"OPEN08/09: Каковы measured RSS/CPU/SQLite contention/actual TTFT и proxy egress на103KB/6parallel?\",\n      \"blocking\": false,\n      \"disposition\": \"Не блокирует Stage2 contract; H1/H2/H3 блокируют runtime enabling до доказательства design budgets.\"\n    },\n    {\n      \"id\": \"Q-002\",\n      \"question\": \"H6: совместимы ли с реальным Zen default ask_reject и optional env=deny при гарантированном builtin rejection?\",\n      \"blocking\": false,\n      \"disposition\": \"Default выбран, автопереключения нет. FakeServe обе policy не доказывает live H6; неизвестная safe capability fail-closed, до H6 боевой disable-file не снимать.\"\n    },\n    {\n      \"id\": \"Q-003\",\n      \"class\": \"continuable\",\n      \"decision_required_human\": false,\n      \"question\": \"FU-007 закрыт compliant flag delta: кодовый default=false плюс локальный runtime dynamic_config.json; human waiver не нужен.\",\n      \"owner\": \"owner/orchestrator\",\n      \"blocks\": \"Нет блокера policy; H3/H6/H7 и независимый a3 review остаются обязательны.\",\n      \"evidence_ids\": [\n        \"EVD-074\"\n      ],\n      \"blocking\": false,\n      \"source_id\": \"FU-007/a2\",\n      \"status\": \"RESOLVED\",\n      \"disposition\": \"По явной финализации architect-cycle-3b; runtime проверки NOT_RUN.\"\n    }\n  ],\n  \"protected_paths\": [\n    \".ai-team/\",\n    \"analysis/zen-realtime-reasoning/\"\n  ],\n  \"materialization\": [],\n  \"deferred\": [\n    \"Живая приёмка H0..H9 и синхронизация ~/.dsh выполняются только rollout-этапом после clean-room verifier и downstream panel.\",\n    \"OPEN-05/16: прямой Zen HTTP и другие CLI форматы не исследуются заново; текущая реализация использует подтверждённый v2 SSE.\",\n    \"Измеренные CPU/RSS/FD и реальный proxy egress на 103 KB/6 parallel — обязательный rollout gate, не доказанный Stage 2 факт.\",\n    \"ADR-0005: оформить docs/adr/0005-zen-serve-realtime-reasoning.md и обновить docs/adr/INDEX.md отдельной задачей вне замороженного handoff-architect.md §10. Текущий Read-Only Product Gate разрешает только3 run JSON, поэтому materialization=[] и ADR/product docs здесь не создаются.\"\n  ],\n  \"verification_policy\": {\n    \"surface_frozen\": true,\n    \"verification_implementation_owner\": \"Stage 3 Coder пишет tests/test_realtime_reasoning.py; Stage L2 Verifier независимо запускает каждый VER с 0 failed; тесты не считаются выполненными Stage 2\",\n    \"REQ-019_clean_room\": \"VER-005 проверяет digest/rollout-manifest helper на двух временных fake files внутри sandbox, не ~/.dsh. Реальная синхронизация REQ-019 проверяется только H0 после отдельного rollout; невозможно подтвердить факт deploy чистым unit-тестом.\",\n    \"timing\": \"FakeClock/RNG и Event-oracles для invariants; socket arrival/CPU реальные измерения отдельными measured/heavy unittest TestCase внутри dedicated suite (stdlib-discover тоже исполняет их). Тест timing держит upstream Event закрытым до чтения 10 дельт, deadline<500ms для interarrival и<=250ms bridge overhead; timeout helper аварийно освобождает Event, чтобы assertion failure не зависала. Не подменять arrival resp.read().\",\n    \"order\": \"Dedicated suite запускает selected TestStepInterruptionLive tests минимум в двух противоположных фиксированных порядках в subprocess/новых Server, включая error после budget tests; без случайных seed/dependency.\",\n    \"wire_fixture\": \"Six frozen source-schema families, canonical digest serialization explicit; five original family literals retained and nested form family added, adversarial mutations independent adapter/FakeServe.\",\n    \"strict_typing\": \"Decode wire JSON as object with isinstance narrowing/TypedDict; new code no Any/casts-to-Any/type-ignore. VER-004 uses isolated bridge cwd + temporary include/extraPaths: all3 errorCount==0, new test0diagnostics, server Any<=125each/nonAny per-rule and total<=720, step<=194; changed legacy code0reportAny/reportExplicitAny/reportUnusedCallResult. Preserve public module attribute server.CATALOG_SOURCE and HTTP catalog_source: module-level CATALOG_SOURCE = \\\"static\\\", never rename it or external test references. Replace reload_catalog global CATALOG_SOURCE/reassignment with typed def _set_catalog_source(source: str) -> None: globals()[\\\"CATALOG_SOURCE\\\"] = source; keep only _catalog_mtime/_catalog_ids in reload_catalog global declaration. Preserve existing static import zen_catalog as zc at original server.py:67 (the sole inherited E402 site); guard proc is not None before both final stream .returncode reads. EVD-076 observed errorCount0 without # type: ignore; tests/test_catalog_mode.py:64,93 unchanged,8tests PASS on copy. coder_target_files remains exactly3; no config/dependency/new module. Full all3 Stage3 gate NOT_RUN. Ruff==0.17.2 legacy ranges use only --range={start}:1-{end}:999; reject any old/new diff hunk intersecting _run_env/_stream_google_sse/_execute_google_once and check their literal raw hashes before and after formatter. Helper argv=[sys.executable, \\\"-I\\\", str(Path(__file__).resolve()), \\\"--serve-helper\\\", attempt_id, str(port), ...]; start_new_session=True, child_pgid=helper_proc.pid. CLI dispatcher is inside if __name__ == \\\"__main__\\\": after existing import zen_catalog as zc and before main()/HTTP startup; all typed _run_serve_helper_cli(...) code resides directly in server.py, checked by Ruff/basedpyright with zero new Any/E402. No inline -c source, no new helper module. --serve-helper <attempt_id> follows script path at the front of ps argv, before port/other parameters; reaper verifies exact script realpath, argv position, full untruncated ps -ww command, attempt_id, UID/PID/lstart/PGID and manifest. Never put password or prompt in argv. EVD-076 static-import server warningCount564/reportAny125, EVD-077 full local block exit0 with catalog8/8; source init→static transition is probe-only. Actual Stage3 NOT_RUN. Write-mode range formatting must run on disposable candidate copy and assert_frozen(copy), never write product during architecture probe.\"\n  },\n  \"high_load_envelope\": {\n    \"schema\": \"HL-ENV/v1\",\n    \"ssot\": \"~/Мой диск/skils/ai-sdlc/python/aisdlc-gcge/agents/architecture.md §3.0/7.2\",\n    \"field_count\": 46,\n    \"units\": \"SSoT §3.0: memory MiB; times s, CPU cores, rates req/s or conn/s, connections/descriptors/tokens; векторы d и s по канону.\",\n    \"required_hl_env_fields\": {\n      \"P_steady\": 1,\n      \"P_hpa_max\": 1,\n      \"maxSurge_pct\": 0.0,\n      \"maxSurge_abs\": 0,\n      \"maxUnavailable_pct\": 0.0,\n      \"maxUnavailable_abs\": 0,\n      \"P_terminating_overlap\": 0,\n      \"P_live\": 1,\n      \"P_avail_min\": 1,\n      \"W\": 1,\n      \"N_proc\": 1,\n      \"N_proc_steady\": 1,\n      \"N_proc_avail_min\": 1,\n      \"CPU_limit_per_pod\": 2.0,\n      \"κ_skew\": 1.0,\n      \"u_bg_worker\": 0.02,\n      \"U_pod_sidecars\": 0.25,\n      \"Mem_limit_per_pod\": 2048,\n      \"Mem_rss_worker_max\": 256,\n      \"Mem_shared_max\": 1152,\n      \"RPS_peak\": 0.2,\n      \"A_max\": 3,\n      \"SLA_p99_s\": 180.0,\n      \"N_entities_max\": 64,\n      \"Limit_dep_share[d]\": {\n        \"georouter\": 80,\n        \"opencode_local_db\": 10\n      },\n      \"Limit_dep_rps[d]\": {\n        \"opencode_spawn\": 1.0\n      },\n      \"W_fetchers[d]\": {\n        \"opencode_spawn\": 0\n      },\n      \"J_init_s[d]\": {\n        \"opencode_spawn\": 12.0\n      },\n      \"J_pod_s[d]\": {\n        \"opencode_spawn\": 12.0\n      },\n      \"T_poll_s[d]\": {\n        \"opencode_spawn\": 15.0\n      },\n      \"K_calls[d]\": {\n        \"opencode_spawn\": 0\n      },\n      \"T_base_s[d]\": {\n        \"opencode_spawn\": 0.5\n      },\n      \"T_cap_s[d]\": {\n        \"opencode_spawn\": 2.0\n      },\n      \"Max_stale_age_s[c]\": {\n        \"stateless_bridge\": 0.0\n      },\n      \"Min_healthy_ratio\": 1.0,\n      \"B_retry_max\": 6,\n      \"min_reserve_retry_rps\": 0.05,\n      \"FD_worker\": 128,\n      \"ulimit_n\": 65536,\n      \"λ_new_conn_per_pod(s)\": {\n        \"node_ephemeral\": 3.6,\n        \"shared_snat\": 1.8\n      },\n      \"C_active_in_scope(s)\": {\n        \"node_ephemeral\": 30,\n        \"shared_snat\": 12\n      },\n      \"N_pods_in_scope(s)\": {\n        \"node_ephemeral\": 1,\n        \"shared_snat\": 1\n      },\n      \"Port_range_size(s)\": {\n        \"node_ephemeral\": 16384,\n        \"shared_snat\": 16384\n      },\n      \"T_hold_s(s)\": {\n        \"node_ephemeral\": 60.0,\n        \"shared_snat\": 60.0\n      },\n      \"SNAT_ips_count(s)\": {\n        \"node_ephemeral\": 1,\n        \"shared_snat\": 1\n      },\n      \"HOTPATH_MODULES\": [\n        \"bridges/opencode-zen-bridge/server.py\"\n      ]\n    },\n    \"field_sources\": {\n      \"P_steady\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"P_hpa_max\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"maxSurge_pct\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"maxSurge_abs\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"maxUnavailable_pct\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"maxUnavailable_abs\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"P_terminating_overlap\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"P_live\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"P_avail_min\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"W\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"N_proc\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"N_proc_steady\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"N_proc_avail_min\": \"F-12/F-34; один локальный ThreadingHTTPServer/LaunchAgent, без HPA/rolling deployment; derived поля рассчитаны при single-process; план rollout без overlap.\",\n      \"CPU_limit_per_pod\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"κ_skew\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"u_bg_worker\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"U_pod_sidecars\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"Mem_limit_per_pod\": \"handoff-architect §7 design budget2048MiB, normalized per SSoT§3.0/RW-011; host limit not measured, H3 mandatory.\",\n      \"Mem_rss_worker_max\": \"F-29 parent baseline22MiB; design bound256MiB; H3 actual_parent_RSS_max measured in MiB.\",\n      \"Mem_shared_max\": \"1152MiB=6*192MiB COMBINED serve+helper+transient lsof/ps slot ceiling; EVD-071 idle serve156.8MiB +estimated python3 -I helper12MiB+probe8MiB=176.8MiB,nominal15.2MiB headroom. Helper/probe/load not measured. H3 full parent+6serve+6helper+probe peaks<=1638.4MiB mandatory; no increased limits.\",\n      \"RPS_peak\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"A_max\": \"F-11/server.py:287-314; max spawns=3, retry tokens=6, refill=.05/s, backoff=.5/2s.\",\n      \"SLA_p99_s\": \"180s normal-mode design goal from analyst envelope; degraded first-token failure profile3*60+51.6=231.6s separate explicit acceptance, not guaranteed180s or universal generation limit. See operational_profile.p99_criteria; actual measurements NOT_RUN.\",\n      \"N_entities_max\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"Limit_dep_share[d]\": \"F-26 georouter 80 direct slots; opencode_local_db=10 — design logical-child share из handoff, НЕ доказанный sqlite pool/max_connections; H3 проверяет фактическую contention и ≤6 children.\",\n      \"Limit_dep_rps[d]\": \"F-11/server.py:309-314 — локально установленный spawn limiter 1/s, НЕ квота Zen/SQLite vendor. Запросы не являются pollers; не подставлять это число как upstream RPS quota.\",\n      \"W_fetchers[d]\": \"F-12/F-14 и граф BND: новый source per-request, Control Plane/Snapshot poller не добавляется; 0 фоновых fetchers и 0 background calls. SSE keepalive не backend polling.\",\n      \"J_init_s[d]\": \"F-10/F-04: 12s startup gate и 15s legacy keepalive как inherited nominal fields, фактических pollers=0. Новая client liveness cadence≤2s описана AD-003 и не backend poll.\",\n      \"J_pod_s[d]\": \"F-10/F-04: 12s startup gate и 15s legacy keepalive как inherited nominal fields, фактических pollers=0. Новая client liveness cadence≤2s описана AD-003 и не backend poll.\",\n      \"T_poll_s[d]\": \"F-10/F-04: 12s startup gate и 15s legacy keepalive как inherited nominal fields, фактических pollers=0. Новая client liveness cadence≤2s описана AD-003 и не backend poll.\",\n      \"K_calls[d]\": \"F-12/F-14 и граф BND: новый source per-request, Control Plane/Snapshot poller не добавляется; 0 фоновых fetchers и 0 background calls. SSE keepalive не backend polling.\",\n      \"T_base_s[d]\": \"F-11/server.py:287-314; max spawns=3, retry tokens=6, refill=.05/s, backoff=.5/2s.\",\n      \"T_cap_s[d]\": \"F-11/server.py:287-314; max spawns=3, retry tokens=6, refill=.05/s, backoff=.5/2s.\",\n      \"Max_stale_age_s[c]\": \"Stateless transport; новый Snapshot/secret TTL cache не создаётся. process-local capability boolean по stat не хранит secrets/model output и инвалидируется при mtime/size смене.\",\n      \"Min_healthy_ratio\": \"analysis/zen-realtime-reasoning/handoff-architect.md §7; оценка design envelope, не измеренный host limit/SLA; OPEN-08/09/11; перепроверить H1/H2/H3.\",\n      \"B_retry_max\": \"F-11/server.py:287-314; max spawns=3, retry tokens=6, refill=.05/s, backoff=.5/2s.\",\n      \"min_reserve_retry_rps\": \"F-11/server.py:287-314; max spawns=3, retry tokens=6, refill=.05/s, backoff=.5/2s.\",\n      \"FD_worker\": \"Design parent ceiling128;steady108=36baseline+18clients+18HTTP+12helperdrains+6reserve+6probe pipes+6lifeline_w+6leasehandles;transient6lifeline_r=>114<=128.6serve/6helper/6bounded lsof-or-ps probes separate FD,system344estimate. H3 per-process/transient peaks mandatory.\",\n      \"ulimit_n\": \"F-29 launchctl soft maxfiles=65536; не переносить значение вчерашнего reference packet=4096 как текущий факт.\",\n      \"λ_new_conn_per_pod(s)\": \"AD-001: <=3 readiness connects including reusable control, +1 SSE +1 prompt delivery +1 egress =6 per attempt; node<=6*.2*3=3.6conn/s; active<=5*6=30 incl client+3HTTP+egress. sharedSNAT1.8/active12 estimate unchanged; H3 validate.\",\n      \"C_active_in_scope(s)\": \"AD-001: <=3 readiness connects including reusable control, +1 SSE +1 prompt delivery +1 egress =6 per attempt; node<=6*.2*3=3.6conn/s; active<=5*6=30 incl client+3HTTP+egress. sharedSNAT1.8/active12 estimate unchanged; H3 validate.\",\n      \"N_pods_in_scope(s)\": \"handoff-architect §7 локальный host (49152..65535 inclusive=16384); topology/SNAT=1 и TIME_WAIT=60s — design assumptions, внешний shared-SNAT capacity неизвестен; H3/rollout подтвердить.\",\n      \"Port_range_size(s)\": \"handoff-architect §7 локальный host (49152..65535 inclusive=16384); topology/SNAT=1 и TIME_WAIT=60s — design assumptions, внешний shared-SNAT capacity неизвестен; H3/rollout подтвердить.\",\n      \"T_hold_s(s)\": \"handoff-architect §7 локальный host (49152..65535 inclusive=16384); topology/SNAT=1 и TIME_WAIT=60s — design assumptions, внешний shared-SNAT capacity неизвестен; H3/rollout подтвердить.\",\n      \"SNAT_ips_count(s)\": \"handoff-architect §7 локальный host (49152..65535 inclusive=16384); topology/SNAT=1 и TIME_WAIT=60s — design assumptions, внешний shared-SNAT capacity неизвестен; H3/rollout подтвердить.\",\n      \"HOTPATH_MODULES\": \"HOTPATH_MODULES: текущий server.py, read-only symbol graph BND-001..004; новые проектные modules не нужны.\"\n    },\n    \"operational_profile\": {\n      \"model_event_rate_per_s_per_active\": 10,\n      \"active_child_max\": 6,\n      \"code_default_max_concurrent\": 2,\n      \"deployed_max_concurrent\": 6,\n      \"max_waiters_effective\": \"min(configured MAX_SLOT_WAITERS, 2*effective MAX_CONCURRENT) в общей _SlotBulkhead admission; code-default2/4, deploy6/12. Deployment6/12 unchanged, configured waiters variable не повышать.\",\n      \"server_resource_manager\": \"один per-Server owner для bounded process/socket leases, после старта процесса, без parent live sockets before child exec\",\n      \"threads_per_worker_upper_bound\": 55,\n      \"thread_accounting\": \"Parent admitted bound55=1accept+18handlers(6active+12waiters)+6supervisor/setup+6SSE readers+6prompt delivery workers+12helper stdout/stderr drains+6parent bookkeeping. Helper EOF/TERM/serve poll uses one single-thread main loop per slot, no helper watcher threads;<=6 helper processes. serve logs route to helper stderr, stdout reserved for one handshake; parent still accounts2drains/slot. At most6 auxiliary identity/lsof/ps probes total,1per slot,serial nonoverlap with reconnect/cleanup, executed on existing supervisor/helper loops. Peak system processes1bridge+6helper+6serve+6probe=19. Reaper startup-only, no request overlap. Rejected unadmitted ThreadingHTTPServer handlers may be transient:55 is admitted bound; H3 must measure rejection peaks, not claim arbitrary flood defense.\",\n      \"stdout_queue_max_events\": 4096,\n      \"new_transport_queue_max_bytes\": 1048576,\n      \"new_transport_max_sse_frame_bytes\": 1048576,\n      \"new_transport_accumulated_output_budget_bytes\": 8388608,\n      \"byte_limits_policy\": \"Только новый enabled transport, суммарный parent queue/raw/parser/dedup/visible output budget на request контролируется; превышение -> прежняя error shape + explicit output_overflow и cleanup, не молчаливое drop. Не вводить новый запрет на размер accepted prompt и не менять legacy limits. При нагрузке/длинном reasoning H3 измерить Python overhead и CPU.\",\n      \"first_status_delay_s\": 0.3,\n      \"status_heartbeat_s\": 5.0,\n      \"first_event_timeout_s\": 20,\n      \"first_token_timeout_s\": 60,\n      \"stall_timeout_s\": 60,\n      \"client_detect_s\": 5,\n      \"client_probe_interval_s\": 0.25,\n      \"client_keepalive_s\": 2,\n      \"client_write_timeout_s\": 0.5,\n      \"cleanup_budget_s\": 1.2,\n      \"ready_budget_s\": 3.0,\n      \"session_setup_budget_s\": 2.0,\n      \"slot_wait_s\": 15,\n      \"spawn_rate_per_s\": 1,\n      \"spawn_burst\": 1,\n      \"total_deadline_s\": 1800,\n      \"estimate_status\": \"Design only: EVD-071 serve idle156.8MiB + python3 -I helper~12MiB=168.8MiB; auxiliary probe estimated8MiB ->176.8MiB under fixed192MiB/slot.6*192+parent256=1408<=1638.4MiB; H3 actual full process RSS sum<=1638.4MiB mandatory, no unmeasured live PASS. Parent FD114<=128,admitted threads55,peak19processes. Normalp99<=180/degraded<=231.6 with >=100samples unchanged.\",\n      \"pre_spawn_admission_budget_s\": 5.0,\n      \"admission_policy\": \"_StartupGate + _SpawnRateLimiter делят один<=5.0s deadline на attempt; никакой суммы независимых5+5. Spawn token hard, gate wait fail-open только в остатке.\",\n      \"session_setup_scope\": \"POST /api/session + GET /api/event subscription armed<=2.0s до prompt; POST /prompt worker waits по first_event20/first_token60,total1800 и concurrent SSE, не по session_setup.\",\n      \"first_event_anchor\": \"serve prompt_send_start; first valid current-session execution SSE only; HTTPready/headers/control ignored; O-EXIT first_event_ms measured from request t0\",\n      \"data_isolation\": \"OPENCODE_DB=:memory:; preserve standard XDG_DATA_HOME/auth; owned zen-serve-state-* state/tmp with finally+crash reaper.\",\n      \"serve_health\": {\n        \"threshold\": 3,\n        \"ttl_s\": 120.0,\n        \"scope\": \"per Server/binary key, new auto requests; no model breaker protocol failures\"\n      },\n      \"http_sockets_per_serve_max\": 3,\n      \"fd_accounting\": {\n        \"parent_baseline\": 36,\n        \"admitted_client_sockets\": 18,\n        \"serve_http_lanes\": 18,\n        \"stdout_stderr_drains\": 12,\n        \"reserved_port_sockets\": 6,\n        \"lsof_capture_pipes\": 6,\n        \"parent_watchdog_pipes\": 6,\n        \"open_lease_files\": 6,\n        \"parent_upper_bound\": 114,\n        \"configured_envelope\": 128,\n        \"aggregate_estimate\": \"Steady parent108 plus transient6lifeline read ends=114<=envelope128. Systemwide conservative128+6serve*20+6helper*8+6probe*8=344descriptors; probe=lsof OR ps identity,at most1/slot,no overlap. Helper per-process8 upper design includes std0/1/2,one transient lease file/atomic temp,DEVNULL/child-launch descriptors and select bookkeeping; measure H3 each process and transient peaks,do not claim aggregate<256.\",\n        \"lifeline_definition\": \"6 parent lifeline_w write ends; transient parent lifeline_r read end closed immediately after Popen. During setup read+write momentarily add<=6FD; terminal no leaks. helper stdin fd0 is lifeline_r, never inherits write end.\",\n        \"transient_lifeline_read_ends\": 6\n      },\n      \"process_accounting\": \"Exactly1bridge parent ->at most6 helper_proc ->at most6 serve_proc, each pair same child_pgid=helper_proc.pid; <=6 transient bounded lsof/ps identity probes, at most1/slot (no overlap),peak19 processes including bridge. One model attempt token creates one helper/serve pair; MAX_TOTAL_SPAWNS=3 counts pairs/actual serve launches, never free retries; probes auxiliary bounded and accounted. Serve start_new_session=False, helper=True; no alternate process topology.\",\n      \"p99_criteria\": {\n        \"status\": \"DESIGN_TARGET_NOT_MEASURED\",\n        \"normal\": \"At declared0.2req/s, admitted6active/12waiters, healthy single attempt: empirical end-to-end completion p99<=180.0s including slot/admission/setup/cleanup; H1/H2/H3 record sample count and nearest-rank p99, never infer p99 from3samples.\",\n        \"degraded\": \"Bounded synthetic failure-to-first-token profile with three60s watchdog attempts: elapsed<=231.6s (=3*60+51.6 aux), not <=180.0s. Fault-injection batch>=100eligible requests reports nearest-rank p99<=231.6s and cap3; retry budget may stop earlier. First-event-only failure profile3*20+51.6=111.6s. Healthy actual generation+post-token stalls remain under total1800s,231.6 is not universal completion guarantee.\",\n        \"rollout\": \"Both normal p99 target and degraded-profile budget must be measured independently; no runtime SLA claim from arithmetic. If normal p99>180 or degraded synthetic p99>231.6, keep disabled and return evidence, do not increase caps/timeouts.\"\n      },\n      \"stall_heartbeat_interval_s\": 15.0,\n      \"rss_accounting\": {\n        \"unit\": \"MiB\",\n        \"serve_idle_observed\": 156.8,\n        \"serve_evidence\": \"EVD-071 owner-supplied idle, not6parallel peak\",\n        \"helper_estimate\": 12.0,\n        \"pair_estimate\": 168.8,\n        \"probe_peak_estimate\": 8.0,\n        \"combined_with_probe_estimate\": 176.8,\n        \"per_slot_ceiling\": 192,\n        \"per_slot_headroom_estimate\": 15.2,\n        \"shared_ceiling\": 1152,\n        \"parent_ceiling\": 256,\n        \"full_design_ceiling\": 1408,\n        \"H3_full_sum_max\": 1638.4,\n        \"status\": \"DESIGN_ESTIMATES; helper/probe and loaded serve NOT_MEASURED; H3 six live slots sums bridge/helper/serve/probe RSS,blocked enable on breach\"\n      }\n    },\n    \"memory_closure_check\": {\n      \"status\": \"PASS\",\n      \"unit\": \"MiB\",\n      \"lhs_mib\": 1408,\n      \"rhs_mib\": 1638.4,\n      \"substitution\": \"W*Mem_rss_worker_max+Mem_shared_max=1*256+1152=1408 <=0.80*2048=1638.4 MiB\",\n      \"evidence_level\": \"design